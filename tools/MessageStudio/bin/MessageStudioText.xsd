<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="nintendo:msgstudio"
	elementFormDefault="qualified"
	targetNamespace="nintendo:msgstudio"
>
	<xsd:include schemaLocation="MessageStudioTypes.xsd" />

	<!-- comments -->
	<xsd:annotation>
		<xsd:appinfo>http://www.nintendo.co.jp/</xsd:appinfo>
		<xsd:documentation>
			This xsd file defines structure of the XML file generated by
			Nintendo Message Studio.
		</xsd:documentation>
	</xsd:annotation>

	<!-- document element -->
	<xsd:element name="MessageStudioText">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element type="TextRowType" name="TextRow" minOccurs="0" maxOccurs="unbounded" />
			</xsd:sequence>
			<xsd:attribute name = "Format" type="MessageTextFormat" use="required" />
		</xsd:complexType>
	</xsd:element>

	<!-- valid file type -->
	<xsd:simpleType name="MessageTextFormat">
		<xsd:restriction base="xsd:float" >
			<xsd:enumeration value="0.7" />
			<xsd:enumeration value="0.9" />
			<xsd:enumeration value="1.0" />
			<xsd:enumeration value="1.1" />
			<xsd:enumeration value="1.2" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- text row type -->
	<xsd:complexType name="TextRowType">
		<xsd:sequence>
			<xsd:element type="LanguageCellType" name="LanguageCell" minOccurs="0" maxOccurs="unbounded" />
			<xsd:element type="CommentCellType" name="CommentCell" minOccurs="0" maxOccurs="unbounded" />
			<xsd:element type="AttributeCellType" name="AttributeCell" minOccurs="0" maxOccurs="unbounded" />
			<xsd:element type="ExtraCellType" name="ExtraCell" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
		<xsd:attribute name="Label"	type="xsd:string" use="required" />
		<xsd:attribute name="Type"	type="TextStatusType" use="optional" />		<!-- OBSOLETE : for compatibility with v1.0 -->
		<xsd:attribute name="Category" type="GuidType" use="optional" />
		<xsd:attribute name="Style"	type="xsd:string" use="optional" />
	</xsd:complexType>

	<!-- language cells (original, or translated texts) -->
	<xsd:complexType name="LanguageCellType" >
		<xsd:sequence>
			<xsd:element name="Text" type="xsd:string" />
			<xsd:element name="TextModifiedBy" type="ModifiedInfo" />
			<xsd:element name="Status" type="InnerCellState" minOccurs="0" />
			<xsd:element name="StatusModifiedBy" type="ModifiedInfo" minOccurs="0" />
			<xsd:element name="Review" type="ReviewState" minOccurs="0" />
			<xsd:element name="ReviewModifiedBy" type="ModifiedInfo" minOccurs="0" />
			<xsd:element name="CompletedAt" type="xsd:dateTime" minOccurs="0" />
			<xsd:element name="ReviewedAt" type="xsd:dateTime" minOccurs="0" />
			
			<!-- new in 1.2 -->
			<xsd:element name="TextHistory" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="OldText" type="xsd:string" />
						<xsd:element name="OldTextModifiedBy" type="ModifiedInfo" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			
		</xsd:sequence>
		<xsd:attribute name="Language" type="xsd:string" use="required" />
	</xsd:complexType>

	<!-- comment cell -->
	<xsd:complexType name="CommentCellType">
		<xsd:sequence>
			<xsd:element name="Comment" type="xsd:string" />
			<xsd:element name="CommentModifiedBy" type="ModifiedInfo" />
		</xsd:sequence>
		<xsd:attribute name="Language" type="xsd:string" use="required" />
	</xsd:complexType>

	<!-- attribute cells -->
	<xsd:complexType name="AttributeCellType" >
		<xsd:sequence>
			<xsd:element name="Text" type="xsd:string" />
			<xsd:element name="TextModifiedBy" type="ModifiedInfo" />
		</xsd:sequence>
		<xsd:attribute name="Name" type="xsd:string" use="required" />
	</xsd:complexType>
	
	<!-- extra cell (new in format 0.9) -->
	<xsd:complexType name="ExtraCellType">
		<xsd:sequence>
			<xsd:element name="CellData" type="xsd:string" />
			<xsd:element name="CellModifiedBy" type="ModifiedInfo" />
		</xsd:sequence>
		<xsd:attribute name="DataHolder" type="GuidType" />
	</xsd:complexType>
	
	<!-- who edited the content of the cell? -->
	<xsd:complexType name="ModifiedInfo">
		<xsd:attribute name="User"	type="ModifedString" use="required" />
		<xsd:attribute name="Time"	type="xsd:dateTime" use="required" />
	</xsd:complexType>

	<!-- OBSOLETE : for compatibility with v1.0 -->
	<xsd:simpleType name = "TextStatusType">
		<xsd:restriction base="xsd:string" >
			<xsd:pattern value="TextItem" />
			<xsd:pattern value="NotUsed" />
			<xsd:pattern value="Graphics" />
			<xsd:pattern value="Embedded" />
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>

<!-- end of XML schema -->
