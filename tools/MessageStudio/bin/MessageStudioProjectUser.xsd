<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="nintendo:msgstudio"
    elementFormDefault="qualified"
	targetNamespace="nintendo:msgstudio"
>
	<xsd:include schemaLocation="MessageStudioTypes.xsd" />

	<!-- comments -->
	<xsd:annotation>
		<xsd:appinfo>http://www.nintendo.co.jp/</xsd:appinfo>
		<xsd:documentation>
			This xsd file defines structure of the XML file generated by
			Nintendo Message Studio.
		</xsd:documentation>
	</xsd:annotation>

	<!-- document element -->
	<xsd:element name="MessageStudioProjectUserSettings">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="UserInfo" type="UserInfoType" />
				<xsd:element name="TeamManagement" type="TeamManagementType" minOccurs="0" maxOccurs="1" />
				<xsd:element name="TreeExpand" type="TreeExpandType" />
				<xsd:element name="ExtOptions" type="ExtraOptionCollectionType" />
				<xsd:element name="BuildInfo" type="BuildInfoType" minOccurs="0" maxOccurs="1" />
				<xsd:element name="ToolStripPositions" type="ToolStripPositionsType" minOccurs="0" maxOccurs="1" />
				<xsd:element name="ChildWindowPositions" type="xsd:base64Binary" minOccurs="0" maxOccurs="1" />
				<xsd:element name="CommitCommentLog" type="CommitCommentLogType" minOccurs="0" maxOccurs="1" />
			</xsd:sequence>
			<xsd:attribute name = "Format" type="ProjectOptionFormat" use="required" />
		</xsd:complexType>
	</xsd:element>

	<!-- valid file format version -->
	<xsd:simpleType name="ProjectOptionFormat">
		<xsd:restriction base="xsd:float" >
			<xsd:pattern value="0.7" />
			<xsd:pattern value="0.9" />
			<xsd:pattern value="0.92" />
			<xsd:pattern value="1.0" />
			<xsd:pattern value="1.1" />
			<xsd:pattern value="1.2" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- user information -->
	<xsd:complexType name="UserInfoType" >
		<xsd:attribute name="Name" type="xsd:string" use="required" />
		<xsd:attribute name="Host" type="xsd:string" use="required" />
		<xsd:attribute name="Physical" type="MacAddressType" use="required" />
		<xsd:attribute name="Role" type="xsd:string" use="optional" />
	</xsd:complexType>

	<!-- team management system -->
	<xsd:complexType name="TeamManagementType">
		<xsd:sequence>
			<xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
		</xsd:sequence>
		<xsd:attribute name="System" type="GuidType" use="required" />
	</xsd:complexType>
	
	<!-- tree view nodes expansion of the Project Explorer -->
	<xsd:complexType name="TreeExpandType">
		<xsd:sequence>
			<xsd:element name="Expand" type="xsd:string" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
		<xsd:attribute name="Root" type="CsBoolean" use="required" />
	</xsd:complexType>

	<!-- extra user option data from plugins -->
	<xsd:complexType name="ExtraOptionCollectionType">
		<xsd:sequence>
			<xsd:element name="ExtraOption" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
					</xsd:sequence>
					<xsd:attribute name="DataHolder" use="required" type="GuidType" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<!-- build information -->
	<xsd:complexType name="BuildInfoType">
		<xsd:sequence>
			<xsd:element name="ContentInfo" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:attribute name="ContentPath" use="required" type="xsd:string" />
					<xsd:attribute name="TimeStamp" use="required" type="xsd:dateTime" />
					<xsd:attribute name="TimeStampTicks" use="required" type="xsd:long" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="BuildType"	type="xsd:string"   use="required" />
		<xsd:attribute name="StartTime"	type="xsd:dateTime" use="required" />
		<xsd:attribute name="StartTimeTicks" type="xsd:long" use="required" />
		<xsd:attribute name="EndTime" type="xsd:dateTime" use="required" />	
		<xsd:attribute name="EndTimeTicks" type="xsd:long" use="required" />
	</xsd:complexType>
	
	<!-- positions of tool strip bars -->
	<xsd:complexType name="ToolStripPositionsType">
		<xsd:sequence>
			<xsd:element name="Container" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="ToolStrip" minOccurs="0" maxOccurs="unbounded">
							<xsd:complexType>
								<!-- plugin GUID. this should be empty value when this element is main tool bar or main menu bar. -->
								<xsd:attribute name="Key" type="GuidType" use="required" />
								<!-- name of the strip.  this is required XML attribute, but it will be ignored if this element is main tool bar or main menu bar. -->
								<xsd:attribute name="Name" type="xsd:string" use="required" />
								<!-- position information -->
								<xsd:attribute name="RowIndex" type="xsd:int" use="required" />
								<xsd:attribute name="x" type="xsd:int" use="required" />
								<xsd:attribute name="y" type="xsd:int" use="required" />
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
					<xsd:attribute name="Name" type="xsd:string" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	
	<!-- Since : format ver 1.2 -->
	<xsd:complexType name = "CommitCommentLogType">
		<xsd:sequence>
			<xsd:element name="Comment" type="xsd:string" minOccurs="0" maxOccurs="10" />
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>

<!-- end of XML schema -->
