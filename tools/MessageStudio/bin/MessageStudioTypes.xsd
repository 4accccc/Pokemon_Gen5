<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="nintendo:msgstudio"
	elementFormDefault="qualified"
	targetNamespace="nintendo:msgstudio"
>

	<!-- comments -->
	<xsd:annotation>
		<xsd:appinfo>http://www.nintendo.co.jp/</xsd:appinfo>
		<xsd:documentation>
			This XSD file will be included other XSD files.
		</xsd:documentation>
	</xsd:annotation>

	<!-- boolean string for .NET framework -->
	<xsd:simpleType name = "CsBoolean" >
		<xsd:restriction base="xsd:string" >
			<xsd:pattern value="[Tt]rue" />
			<xsd:pattern value="[Ff]alse" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- multilingual string-->
	<xsd:complexType name="MultilingualString">
		<xsd:all>
			<xsd:element name="Japanese"	type="xsd:string" minOccurs="0" maxOccurs="1" />
			<xsd:element name="US_English"	type="xsd:string" minOccurs="0" maxOccurs="1" />
		</xsd:all>
		<xsd:attribute name="DefaultString" type="xsd:string" use="optional" />
	</xsd:complexType>

	<!-- languages that MessageStudio supports -->
	<xsd:simpleType name="DispLanguageType">
		<xsd:restriction base="xsd:string" >
			<xsd:enumeration value="Japanese" />
			<xsd:enumeration value="US_English" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- Global Unique IDentifier -->
	<xsd:simpleType name="GuidType" >
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- cell status type -->
	<xsd:simpleType name="InnerCellState">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="NotYet" />
			<xsd:enumeration value="Editing" />
			<xsd:enumeration value="Completed" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- cell status type -->
	<xsd:simpleType name="ViewCellState">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="NotYet" />
			<xsd:enumeration value="Editing" />
			<xsd:enumeration value="SourceEditing" />
			<xsd:enumeration value="ReadyToTranslate" />
			<xsd:enumeration value="RereadyToTranslate" />
			<xsd:enumeration value="Completed" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- review state type -->
	<xsd:simpleType name="ReviewState">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="NotYet" />
			<xsd:enumeration value="ReviewRequested" />
			<xsd:enumeration value="ReviewRejected" />
			<xsd:enumeration value="ReviewConfirmed" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- cell status type -->
	<xsd:simpleType name="CellColor">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="#[0-9a-fA-F]{8}" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- MAC (Media Access Control ) address -->
	<xsd:simpleType name="MacAddressType">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[0-9a-fA-F]{12}" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- modified infomation -->
	<xsd:simpleType name="ModifedString">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="\S*" />
		</xsd:restriction>
	</xsd:simpleType>

</xsd:schema>

<!-- end of XML schema -->
