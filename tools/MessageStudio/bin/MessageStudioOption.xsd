<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="nintendo:msgstudio"
	elementFormDefault="qualified"
	targetNamespace="nintendo:msgstudio"
>
	<xsd:include schemaLocation="MessageStudioTypes.xsd" />

	<!-- comments -->
	<xsd:annotation>
		<xsd:appinfo>http://www.nintendo.co.jp/</xsd:appinfo>
		<xsd:documentation>
			This xsd file defines structure of the XML file generated by
			Nintendo Message Studio.
		</xsd:documentation>
	</xsd:annotation>

	<!-- document element -->
	<xsd:element name="MessageStudioOptions">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name = "AppDispLanguage"	type = "DispLanguageType" minOccurs="0" />
				<xsd:element name = "RecentlyProjects"	type = "RecentlyProjectType" />
				<xsd:element name = "CellStateColors"	type = "CellStateColorType" />
				<xsd:element name = "WindowPos"			type = "WindowPosType" />
				<xsd:element name = "ConfirmQuestion"	type = "ConfirmType" />
				<xsd:element name = "IntegratedHelpViewer"	type = "CsBoolean" minOccurs="0" maxOccurs="1" />
			</xsd:sequence>
			<xsd:attribute name="Format" type="OptionFormat" use="required" />
		</xsd:complexType>
	</xsd:element>
	
	<!-- valid file type -->
	<xsd:simpleType name="OptionFormat">
		<xsd:restriction base="xsd:float" >
			<xsd:enumeration value="1.1" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- recently projects -->
	<xsd:complexType name = "RecentlyProjectType">
		<xsd:sequence>
			<!-- NOTE : maxOccurs attribute must be synchronized with the program. -->
			<xsd:element name = "RecentProject" type="xsd:string" minOccurs="0" maxOccurs="5" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name = "CellStateColorType">
		<xsd:sequence>
			<xsd:element name = "CellStateColor" minOccurs="0" maxOccurs="unbounded" >
				<xsd:complexType>
					<xsd:attribute name="State"		type="ViewCellState" use="required" />
					<xsd:attribute name="Color"		type="CellColor" use="required" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	
	<!-- initial window position and window state -->
	<xsd:complexType name = "WindowPosType">
		<xsd:choice>
			<xsd:element name="Default" />
			<xsd:element name="Absolete">
				<xsd:complexType>
					<xsd:attribute name="Left" type="xsd:integer" />
					<xsd:attribute name="Top" type="xsd:integer" />
					<xsd:attribute name="Width" type="xsd:integer" />
					<xsd:attribute name="Height" type="xsd:integer" />
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Maximized" />
		</xsd:choice>
	</xsd:complexType>
	
	<!-- confirm -->
	<xsd:complexType name = "ConfirmType">
		<xsd:sequence>
			<xsd:element name="NeverShowAgain" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:attribute name="Message" type="xsd:string" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	
</xsd:schema>

<!-- end of XML schema -->
