<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="nintendo:msgstudio"
	elementFormDefault="qualified"
	targetNamespace="nintendo:msgstudio"
>
	<xsd:include schemaLocation="MessageStudioTypes.xsd" />

	<!-- comments -->
	<xsd:annotation>
		<xsd:appinfo>http://www.nintendo.co.jp/</xsd:appinfo>
		<xsd:documentation>
			This xsd file defines structure of the XML file generated by
			Nintendo Message Studio.
		</xsd:documentation>
	</xsd:annotation>
	
	<!-- document element -->
	<xsd:element name="MessageStudioProject">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="PluginInfo">
					<xsd:complexType>
						<xsd:attribute name="PluginDir" type="xsd:string" use="required" />
						<xsd:attribute name="Recursive" type="CsBoolean" use="required" />
					</xsd:complexType>
				</xsd:element>
				<xsd:element name = "Contents" type="ProjectContentList" />
				<xsd:element name = "Properties" type = "PropertyList" />
				<xsd:element name = "Language" type="LanguageType" />
				<xsd:element name = "Fonts" type="FontCollectionType" />
				<xsd:element name = "Styles" type="StyleCollectionType" />
				<xsd:element name = "Colors" type="ColorCollectionType" />
				<xsd:element name = "TagGroups" type="TagGroupCollectionType"  />
				<xsd:element name = "Attributes" type="AttributeCollectionType" />
				<xsd:element name = "Dictionaries" type="DictionariesType" />
				<xsd:element name = "BuildSettings" type="BuildSettingCollectionType" />
				<xsd:element name = "Roles" type="RoleCollectionType" />
				<xsd:element name = "ExtraSettings" type="ExtDataCollection" />
			</xsd:sequence>
			<xsd:attribute name = "Format" type="ProjectFormat" use="required" />
		</xsd:complexType>
	</xsd:element>
	
	<!-- valid file type -->
	<xsd:simpleType name="ProjectFormat">
		<xsd:restriction base="xsd:float" >
			<xsd:enumeration value="0.92" />
			<xsd:enumeration value="0.93" />
			<xsd:enumeration value="0.94" />
			<xsd:enumeration value="1.0" />
			<xsd:enumeration value="1.01" />
			<xsd:enumeration value="1.02" />
			<xsd:enumeration value="1.03" />
			<xsd:enumeration value="1.1" />
			<xsd:enumeration value="1.2" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- list of the contents -->
	<xsd:complexType name = "ProjectContentList" >
		<xsd:sequence>
			<xsd:element name = "Meta" type = "ContentMetaType" minOccurs="0" maxOccurs="unbounded" />
			<xsd:element name = "Directory" type="ContentDirectoryType" minOccurs="0" maxOccurs="unbounded" />
			<xsd:element name = "ContentItem" type="ContentItemType" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name = "ContentDirectoryType">
		<xsd:sequence>
			<xsd:element name = "Meta" type = "ContentMetaType" minOccurs="0" maxOccurs="unbounded" />
			<xsd:element name = "Directory" type="ContentDirectoryType" minOccurs="0" maxOccurs="unbounded" />
			<xsd:element name = "ContentItem" type="ContentItemType" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
		<xsd:attribute name = "Name" type = "xsd:string" use = "required" />
	</xsd:complexType>

	<xsd:complexType name = "ContentItemType">
		<xsd:sequence>
			<xsd:element name = "Meta" type = "ContentMetaType" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
		<xsd:attribute name = "Name" type = "xsd:string" use = "required" />
	</xsd:complexType>

	<xsd:complexType name = "ContentMetaType" mixed="true">
		<xsd:attribute name = "Key" type = "GuidType" use = "required" />
	</xsd:complexType>

	<!-- property items -->
	<xsd:complexType name="PropertyList">
		<xsd:sequence>
			<!-- build events -->
			<xsd:element name="PreBuildEvent" type="xsd:string" />
			<xsd:element name="PostBuildEvent" type="xsd:string" />
			
			<!-- team settings -->
			<xsd:element name="TeamSettings">
				<xsd:complexType>
					<xsd:attribute name="AutoUpdate" type="CsBoolean" />
					<xsd:attribute name="AutoCommit" type="CsBoolean" />
					<xsd:attribute name="AutoCloseOnAutoUpdate" type="CsBoolean" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<!-- language -->
	<xsd:complexType name="LanguageType" >
		<xsd:sequence>
			<xsd:element name="Language" type="LanguageType" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
		<xsd:attribute name="LanguageName" type="xsd:string" use="required" />
		<xsd:attribute name="OutputBinary" type="CsBoolean" use="required" />
		<xsd:attribute name="ReviewEnabled" type="CsBoolean" use="required" />
		<xsd:attribute name="RubyWarning" type="CsBoolean" use="required" />
		<xsd:attribute name="SpellEnabled" type="CsBoolean" use="required" />
		<xsd:attribute name="Dictionary" type="DictionaryType" use="required" />
	</xsd:complexType>

	<!-- dictionaries -->
	<xsd:simpleType name="DictionaryType">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="en_US" />
			<xsd:pattern value="en_GB" />
			<xsd:pattern value="de_DE_neu" />
			<xsd:pattern value="fr_FR" />
			<xsd:pattern value="es_ES" />
			<xsd:pattern value="nl_NL" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- font collection -->
	<xsd:complexType name="FontCollectionType" >
		<xsd:sequence>
			<xsd:element name="FontSetting" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
					</xsd:sequence>
					<xsd:attribute name="FontName" type="xsd:string" use="required" />
					<xsd:attribute name="Loader" type="GuidType" use="required" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	
	<!-- style collection -->
	<xsd:complexType name="StyleCollectionType" >
		<xsd:sequence>
			<!-- style class defnition -->
			<xsd:element name="StyleClass" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:sequence>
						<!-- default style -->
						<xsd:element name="Default">
							<xsd:complexType>
								<xsd:group ref="StyleInfoElementBlock" />
								<xsd:attributeGroup ref="StyleInfoAttributeBlock" />
							</xsd:complexType>
						</xsd:element>
						<!-- specialized style -->
						<xsd:element name="Substitute" minOccurs="0" maxOccurs="unbounded">
							<xsd:complexType>
								<xsd:group ref="StyleInfoElementBlock" />
								<xsd:attributeGroup ref="StyleInfoAttributeBlock" />
								<xsd:attribute name="Language" type="xsd:string" use="required" />
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
					<xsd:attribute name="StyleName" type="xsd:string" use="required" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<!-- style information -->
	<xsd:group name="StyleInfoElementBlock">
		<xsd:sequence>
			<xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
		</xsd:sequence>
	</xsd:group>
	<xsd:attributeGroup name="StyleInfoAttributeBlock">
		<xsd:attribute name="RenderMode" type="GuidType" use="optional" />
		<xsd:attribute name="RegionWidth" type="xsd:integer" use="required" />
		<xsd:attribute name="LineNum" type="xsd:integer" use="required" />
		<xsd:attribute name="FontName" type="xsd:string" use="required" />
		<xsd:attribute name="ColorName" type="xsd:string" use="optional" />
		<xsd:attribute name="BackColor" type="xsd:string" use="optional" />
	</xsd:attributeGroup>

	<!-- tag group collection -->
	<xsd:complexType name="TagGroupCollectionType" >
		<xsd:sequence>
			<!-- tag group information -->
			<xsd:element name="TagGroup" minOccurs="0" maxOccurs="unbounded" >
				<xsd:complexType>
					<xsd:sequence>
						<!-- multilingual infomation -->
						<xsd:element name="MultilingualName" type="MultilingualString" minOccurs="0" maxOccurs="1" />
						<!-- tag information -->
						<xsd:element name="Tag" type="TagType" minOccurs="0" maxOccurs="unbounded" />
					</xsd:sequence>
					<xsd:attribute name="GroupName" type="xsd:string" use="required" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<!-- Tag -->
	<xsd:complexType name="TagType" >
		<xsd:sequence>
			<!-- multilingual infomation -->
			<xsd:element name="MultilingualName" type="MultilingualString" minOccurs="0" maxOccurs="1" />
			<xsd:element name="Comment" type="MultilingualString" />
			<xsd:element name="Parameter" type="ParameterElement" minOccurs="0" maxOccurs="unbounded" />
			<!-- default parameter of the tag -->
			<xsd:element name="Default">
				<xsd:complexType>
					<xsd:choice>
						<xsd:element name="WidthInfo" type="WidthInfoType" />		<!-- OBSOLETE : compatibility with v1.0 -->
						<xsd:element name="WidthCalcInfo" type="WidthCalcInfoType" />
					</xsd:choice>
				</xsd:complexType>
			</xsd:element>
			<!-- language specialized parameters -->
			<xsd:element name="Substitute" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:choice>
						<xsd:element name="WidthInfo" type="WidthInfoType" />		<!-- OBSOLETE : compatibility with v1.0 -->
						<xsd:element name="WidthCalcInfo" type="WidthCalcInfoType" />
					</xsd:choice>
					<xsd:attribute name="Language" type="xsd:string" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="TagName" type="xsd:string" use="required" />
		<xsd:attribute name="HasInside" type="CsBoolean" use="required" />
		<xsd:attribute name="CompareError" type="CompareErrorType" use="required" />
	</xsd:complexType>

	<!-- tag width (OBSOLETE : compatibility with v1.0) -->
	<xsd:complexType name="WidthInfoType">
		<xsd:attribute name="Value" use="required" type="xsd:integer"/>
		<xsd:attribute name="Unit" use="required" type="WidthUnitType" />
	</xsd:complexType>
	<xsd:simpleType name="WidthUnitType">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="Pixel" />
			<xsd:pattern value="CharNum" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- tag width for v1.1 -->
	<xsd:complexType name="WidthCalcInfoType">
		<!-- will be omitted if HasInside attribute of TagType is true  -->
		<xsd:sequence>
			<xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
		</xsd:sequence>
		<xsd:attribute name="Calculator" use="optional" type="GuidType" />
	</xsd:complexType>
	
	<!-- attributes -->
	<xsd:complexType name="AttributeCollectionType" >
		<xsd:sequence>
			<xsd:element name="Attribute" type="AttributeElement" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
	</xsd:complexType>

	<!-- extra-words -->
	<xsd:complexType name="DictionariesType" >
		<xsd:sequence>
			<xsd:element name = "Dictionary" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name = "ExtraWord" type = "xsd:string" minOccurs = "0" maxOccurs = "unbounded" />
					</xsd:sequence>
					<xsd:attribute name = "Name" type="DictionaryType" use="required" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<!-- colors -->
	<xsd:complexType name="ColorCollectionType" >
		<xsd:sequence>
			<xsd:element name="Color" type="ColorElement" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
	</xsd:complexType>

	<!-- builder settings -->
	<xsd:complexType name="BuildSettingCollectionType">
		<xsd:sequence>
			<xsd:element name="BuildSetting" minOccurs="0" maxOccurs="unbounded" >
				<xsd:complexType>
					<xsd:sequence>
						<xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
					</xsd:sequence>
					<xsd:attribute name="Builder" type="GuidType" use="required"  />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<!-- roles -->
	<xsd:complexType name="RoleCollectionType" >
		<xsd:sequence>
			<xsd:element name="Administrator">
				<xsd:complexType>
					<xsd:attribute name="Password" type="xsd:base64Binary" use="optional" />
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="RestrictedRole" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="Forbidden" type="ForbiddenType" minOccurs="0" maxOccurs="unbounded" />
					</xsd:sequence>
					<xsd:attribute name="Name" type="xsd:string" use="required" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<!-- This element will be written if the operation is not allowed. -->
	<xsd:complexType name="ForbiddenType">
		<xsd:sequence>
			<xsd:element name="Subkey" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:attribute name="Name" type="xsd:string" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
		<!-- equals to IPermissionPlugin.PermissionIdentifier -->
		<xsd:attribute name="Permission" type="GuidType" />
	</xsd:complexType>

	<!-- parameter information -->
	<xsd:complexType name="ParameterElement" >
	<xsd:sequence>
		<xsd:element name="UserMaxValue" minOccurs="0" maxOccurs="1" />
		<xsd:element name="UserMinValue" minOccurs="0" maxOccurs="1" />
		<!-- multilingual infomation -->
		<xsd:element name="MultilingualName" type="MultilingualString" minOccurs="0" maxOccurs="1" />
		<xsd:element name="ListItem" minOccurs="0" maxOccurs="unbounded">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="MultilingualName" type="MultilingualString" minOccurs="0" maxOccurs="1" />
			</xsd:sequence>
		  <xsd:attribute name="Name" type="xsd:string" use="required" />
		</xsd:complexType>
	  </xsd:element>
	</xsd:sequence>
		<xsd:attribute name="Name" type="xsd:string" use="required" />
		<xsd:attribute name="Type" type="ParameterType" use="required" />
	<xsd:attribute name="Default" type="xsd:string" use="required" />
	<xsd:attribute name="LimitEnabled" type="CsBoolean" use="optional" />
	<xsd:attribute name="LimitType" type="ParameterLimitType" use="optional" />
  </xsd:complexType>

	<!-- tag comparison error mode -->
	<xsd:simpleType name="CompareErrorType">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="Strict" />
			<xsd:pattern value="Warning" />
			<xsd:pattern value="Ignore" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- parameter types -->
	<xsd:simpleType name="ParameterType" >
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="UInt(8|16|32)" />
			<xsd:pattern value="Int(8|16|32)" />
			<xsd:pattern value="Float" />
			<xsd:pattern value="Double" />
			<xsd:pattern value="String" />
			<xsd:pattern value="List" />
		</xsd:restriction>
	</xsd:simpleType>
	
	<!-- parameter limit types -->
	<xsd:simpleType name="ParameterLimitType" >
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="None" />
			<xsd:pattern value="UserLimit" />
			<xsd:pattern value="Fixed" />
		</xsd:restriction>
	</xsd:simpleType>

	<!-- attribute information -->
	<xsd:complexType name="AttributeElement" >
		<xsd:sequence>
			<xsd:element name="UserMaxValue" minOccurs="0" maxOccurs="1" />
			<xsd:element name="UserMinValue" minOccurs="0" maxOccurs="1" />
			<xsd:element name="MultilingualName" type="MultilingualString" minOccurs="0" maxOccurs="1" />
			<xsd:element name="MultilingualComment" type="MultilingualString" minOccurs="0" maxOccurs="1" />
			<xsd:element name="Item" type="AttributeItemType" minOccurs="0" maxOccurs="unbounded" />
		</xsd:sequence>
		<xsd:attribute name="Name" type="xsd:string" use="required" />
		<xsd:attribute name="Type" type="ParameterType" use="required" />
		<xsd:attribute name="Comment" type="xsd:string" use="optional" />		<!-- OBSOLETE. compatibility with v0.93 -->
		<xsd:attribute name="Default" type="xsd:string" use="required" />
		<xsd:attribute name="OutputBinary" type="CsBoolean" use="optional" />	<!-- OBSOLETE. compatibility with v1.00 -->
		<xsd:attribute name="LimitEnabled" type="CsBoolean" use="optional" />
	</xsd:complexType>

	<!-- color information -->
	<xsd:complexType name="ColorElement" >
		<xsd:attribute name="Name" type="xsd:string" use="required" />
		<xsd:attribute name="R" type="xsd:unsignedByte" use="required" />
		<xsd:attribute name="G" type="xsd:unsignedByte" use="required" />
		<xsd:attribute name="B" type="xsd:unsignedByte" use="required" />
		<xsd:attribute name="A" type="xsd:unsignedByte" use="required" />
	</xsd:complexType>

	<!-- parameter item information -->
	<xsd:complexType name="AttributeItemType" >
		<xsd:sequence>
			<xsd:element name="MultilingualName" type="MultilingualString" minOccurs="0" maxOccurs="1" />
		</xsd:sequence>
		<xsd:attribute name="Name" type="xsd:string" use="required" />
		<xsd:attribute name="DisplayName" type="xsd:string" use="optional" />
	</xsd:complexType>

	<!-- extra data from plugin interface -->
	<xsd:complexType name="ExtDataCollection">
		<xsd:sequence>
			<xsd:element name="ExtData" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
					</xsd:sequence>
					<xsd:attribute name="DataHolder" type="GuidType" />
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

</xsd:schema>

<!-- end of XML schema -->
