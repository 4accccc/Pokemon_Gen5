//======================================================================
//======================================================================
//  命令シンボル宣言
//======================================================================

  //スクリプトコマンドテーブル開始
  INIT_OVERLAY_CMD( pokewood )

  DEF_CMD( EvCmdPokewoodRec,                    EV_SEQ_PKWD_REC )     // ポケウッド　再生
  DEF_CMD( EvCmdPokewoodShow,                   EV_SEQ_PKWD_SHOW )    // ポケウッド　撮影
  DEF_CMD( EvCmdPokewoodSelectScenario,         EV_SEQ_PKWD_SELECT_SCENARIO )    // ポケウッド　台本
  DEF_CMD( EvCmdPokewoodSelectMovie,            EV_SEQ_PKWD_SELECT_MOVIE )
  DEF_CMD( EvCmdPokewoodSaveMovie,              EV_SEQ_PKWD_SAVE_MOVIE )    //映画をセーブ

  DEF_CMD( EvCmdPokewoodSetScenarioName,        EV_SEQ_PKWD_SET_SCENARIO_NAME )
  DEF_CMD( EvCmdPokewoodGetScenarioStatus,      EV_SEQ_PKWD_GET_SCENARIO_STATUS )
  DEF_CMD( EvCmdPokewoodSetScenarioStatus,      EV_SEQ_PKWD_SET_SCENARIO_STATUS )
  DEF_CMD( EvCmdPokewoodGetMoviesCount,         EV_SEQ_PKWD_GET_MOVIE_COUNT )
  DEF_CMD( EvCmdPokewoodCheckMovieEnable,       EV_SEQ_PKWD_CHECK_MOVIE_ENABLE )
  DEF_CMD( EvCmdPokewoodGetMovieValue,          EV_SEQ_PKWD_GET_MOVIE_VALUE )

  DEF_CMD( EvCmdPokewoodSystemStart,            EV_SEQ_PKWD_SYSTEM_START )
  DEF_CMD( EvCmdPokewoodSystemEnd,              EV_SEQ_PKWD_SYSTEM_END )
  DEF_CMD( EvCmdPKWDSelectPokemon,              EV_SEQ_PKWD_SELECT_POKEMON )
  DEF_CMD( EvCmdPKWDSetJoinMypoke,              EV_SEQ_PKWD_SET_JOIN_MYPOKE ) // 手持ちポケモンでポケウッドに参加するか？
  DEF_CMD( EvCmdPokewoodCheckNewScenario,       EV_SEQ_PKWD_CHECK_NEW_SCENARIO )
  DEF_CMD( EvCmdPokewoodCheckNewStarRank,       EV_SEQ_PKWD_CHECK_NEW_STAR_RANK )
  DEF_CMD( EvCmdPokewoodIsShowedMovie,          EV_SEQ_PKWD_IS_SHOWED_MOVIE )
  DEF_CMD( EvCmdPokewoodIsRentalPokeMovie,      EV_SEQ_PKWD_IS_RENTAL_POKE_MOVIE )
  DEF_CMD( EvCmdPokewoodSetStudioMMdl,          EV_SEQ_PKWD_SET_STUDIO_MMDL )
  DEF_CMD( EvCmdPokewoodGetDirectorType,        EV_SEQ_PKWD_GET_DIRECTOR_TYPE )
  DEF_CMD( EvCmdPokewoodCheckAllSuccess,        EV_SEQ_PKWD_CHECK_ALL_SUCCESS )
  DEF_CMD( EvCmdPokewoodRecordMonitor,          EV_SEQ_PKWD_RECORD_MONITOR )
  
  // ご褒美アイテム
  DEF_CMD( EvCmdPokewoodGetBonusItem,          EV_SEQ_PKWD_GET_BONUS_ITEM )

  END_CMD
  //スクリプトコマンドテーブル終了
