//-------------------------------------
///	モデル管理
//=====================================
typedef enum
{
  MODELID_DRAGON,
  MODELID_MOVE_DRAGON,
  MODELID_MAX,
}MODELID;


//リソースID
enum
{
  MODEL_RESID_DRAGON,         // 自機ドラゴン
  MODEL_RESID_MOVE_DRAGON,    // 自機ドラゴン移動データ
  MODEL_RESID_DRAGON_ICA,         // 自機ドラゴン(アニメーション)
  MODEL_RESID_MOVE_DRAGON_ICA,    // 自機ドラゴン移動データ(アニメーション)
  MODEL_RESID_MAX,
};

//リソースデータ
static const GFL_G3D_UTIL_RES sc_g3d_util_res[MODEL_RESID_MAX] =
{
  // MODEL_RESID_DRAGON->自機ドラゴン
  {
    ARCID_GYM_DRAGON,
    NARC_gym_dragon_hero_dra_nsbmd,
    GFL_G3D_UTIL_RESARC,
  },
  // MODEL_RESID_MOVE_DRAGON->自機ドラゴン移動データ
  {
    ARCID_GYM_DRAGON,
    NARC_gym_dragon_hero_dra_move_nsbmd,
    GFL_G3D_UTIL_RESARC,
  },
  //MODEL_RESID_DRAGON_ICA->自機ドラゴン(アニメーション)
  {
    ARCID_GYM_DRAGON,
    NARC_gym_dragon_hero_dra_nsbca,
    GFL_G3D_UTIL_RESARC
  },
    //MODEL_RESID_MOVE_DRAGON_ICA->自機ドラゴン移動データ(アニメーション)
  {
    ARCID_GYM_DRAGON,
    NARC_gym_dragon_hero_dra_move_nsbca, 
    GFL_G3D_UTIL_RESARC
  },
};

// アニメ設定
