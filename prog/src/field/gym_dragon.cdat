    MODEL_RESID_DRAGON, 	//モデルリソースID
		0, 							        //モデルデータID(リソース内部INDEX)
		MODEL_RESID_DRAGON, 	//テクスチャリソースID
		sc_g3d_dragon_anm,			    //アニメテーブル(複数指定のため)
		ANIMEID_DRAGON_MAX,	        //アニメリソース数
