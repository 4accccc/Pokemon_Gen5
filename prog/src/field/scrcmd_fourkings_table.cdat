  //スクリプトコマンドテーブル開始
  INIT_OVERLAY_CMD( fourkings )

  // 四天王関連
  DEF_CMD( EvCmdFourKings_RailOff, EV_SEQ_FOURKINGS_RAIL_OFF )
  DEF_CMD( EvCmdFourKings_SetCameraParam, EV_SEQ_FOURKINGS_SET_TOP_CAMERA )
  DEF_CMD( EvCmdFourKings_SetSoundSystem, EV_SEQ_FOURKINGS_SET_SOUND_SYSTEM )

  // 悪
  DEF_CMD( EvCmdFourKings_Evil_Fire, EV_SEQ_FOURKINGS_EVIL_FIRE )
  DEF_CMD( EvCmdFourKings_Evil_Claw, EV_SEQ_FOURKINGS_EVIL_CLAW )

  // エスパー
  DEF_CMD( EvCmdFourKings_Esp_Stairs, EV_SEQ_FOURKINGS_ESP_STAIRS )
  DEF_CMD( EvCmdFourKings_Esp_Flower, EV_SEQ_FOURKINGS_ESP_FLOWER )
  DEF_CMD( EvCmdFourKings_Esp_Cube, EV_SEQ_FOURKINGS_ESP_CUBE )
  DEF_CMD( EvCmdFourKings_Esp_Cattleya, EV_SEQ_FOURKINGS_ESP_CATTLEYA )

  // ゴースト
  DEF_CMD( EvCmdFourKings_Ghost_Mist, EV_SEQ_FOURKINGS_GHOST_MIST )
  DEF_CMD( EvCmdFourKings_Ghost_Fire, EV_SEQ_FOURKINGS_GHOST_FIRE )
  DEF_CMD( EvCmdFourKings_Ghost_BookFall, EV_SEQ_FOURKINGS_GHOST_BOOK_FALL )
  DEF_CMD( EvCmdFourKings_Ghost_Lamp, EV_SEQ_FOURKINGS_GHOST_LAMP )

  // 格闘
  DEF_CMD( EvCmdFourKings_Fight_Door, EV_SEQ_FOURKINGS_FIGHT_DOOR )
  DEF_CMD( EvCmdFourKings_Fight_Stairs, EV_SEQ_FOURKINGS_FIGHT_STAIRS )
  DEF_CMD( EvCmdFourKings_Fight_Light, EV_SEQ_FOURKINGS_FIGHT_LIGHT )
  DEF_CMD( EvCmdFourKings_Fight_Stage, EV_SEQ_FOURKINGS_FIGHT_STAGE )
  
  END_CMD
  //スクリプトコマンドテーブル終了
