  //スクリプトコマンドテーブル開始
  INIT_OVERLAY_CMD( wbt )

  //WBT関連
  DEF_CMD( EvCmdWBTSystemStart,       EV_SEQ_WBT_SYSTEM_START )
  DEF_CMD( EvCmdWBTSystemEnd,         EV_SEQ_WBT_SYSTEM_END )
  DEF_CMD( EvCmdWBTSystemSetStage,    EV_SEQ_WBT_SYSTEM_SET_STAGE )
  DEF_CMD( EvCmdWBTShowTornamentList, EV_SEQ_WBT_SHOW_TOURLIST )
  DEF_CMD( EvCmdWBTCheckBattleRule,   EV_SEQ_WBT_CHECK_BATTLE_RULE )
  DEF_CMD( EvCmdWBTSetBattleRule,     EV_SEQ_WBT_SET_BATTLE_RULE )
  DEF_CMD( EvCmdWBTGetBattleRule,     EV_SEQ_WBT_GET_BATTLE_RULE )
  DEF_CMD( EvCmdWBTSetTournamentType, EV_SEQ_WBT_SET_TOURNAMENT_TYPE )
  DEF_CMD( EvCmdWBTGetTournamentType, EV_SEQ_WBT_GET_TOURNAMENT_TYPE )
  DEF_CMD( EvCmdWBTGetDownLoadCount,  EV_SEQ_WBT_GET_DL_COUNT )
  DEF_CMD( EvCmdWBTGetDownLoadName,   EV_SEQ_WBT_GET_DL_NAME )
  DEF_CMD( EvCmdWBTSelectDLData,      EV_SEQ_WBT_SELECT_DL_DATA )
  DEF_CMD( EvCmdWBTSetDLNumber,       EV_SEQ_WBT_SET_DL_NUMBER )
  DEF_CMD( EvCmdWBTGetDLNumber,       EV_SEQ_WBT_SET_DL_NUMBER )
  DEF_CMD( EvCmdWBTSelectPokemon,     EV_SEQ_WBT_SELECT_POKEMON )
  DEF_CMD( EvCmdWBTGetEnemyMMdlCode,  EV_SEQ_WBT_GET_ENEMY_MMDL_CODE )
  DEF_CMD( EvCmdWBTTrainerMsg,        EV_SEQ_WBT_TRAINER_MSG )
  DEF_CMD( EvCmdWBTTrainerBattle,     EV_SEQ_WBT_TRAINER_BATTLE )
  DEF_CMD( EvCmdWBTAnnounce,          EV_SEQ_WBT_ANNOUNCE )
  DEF_CMD( EvCmdWBTSetTournamentName, EV_SEQ_WBT_SET_TOURNAMENT_NAME )
  DEF_CMD( EvCmdWBTSetEnemyName,      EV_SEQ_WBT_SET_ENEMY_NAME )
  DEF_CMD( EvCmdWBTGetVictoryCount,   EV_SEQ_WBT_GET_VICTORY_COUNT )
  DEF_CMD( EvCmdWBTGMKVisionInit,     EV_SEQ_WBT_GMK_VISION_INIT )
  DEF_CMD( EvCmdWBTGMKVisionChange,   EV_SEQ_WBT_GMK_VISION_CHANGE )
  DEF_CMD( EvCmdWBTGMKEffectStart,    EV_SEQ_WBT_GMK_EFFECT_START )
  DEF_CMD( EvCmdWBTGMKWinEffectStart, EV_SEQ_WBT_GMK_WIN_EFFECT_START )
  
  END_CMD
  //スクリプトコマンドテーブル終了
