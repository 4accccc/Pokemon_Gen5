		<target japanese="デフォルト" english="default" endian="big" encoding="Shift_JIS" letter-list-encoding="Shift_JIS" header-file-encoding="Shift_JIS" language="JPN">
			<struct name="JMSMesgEntry" id="" message="mesgOffset">
			</struct>
			<entry sort="id" id-block="no" flowlabel-block="no"/>
			<header divide="no" id-prefix="JMS_" query-prefix="JMS_QUERY_" flownode-prefix="JMS_FLOWNODE_" id="" struct="" query=""/>
		</target>
	</output>


	<lock>
		<operation add_message="no" header_setting="no" tag_setting="no" output_setting="no" display="no" sort="no" flowchart_window="no"/>
	</lock>


	<row id="ZKN_COMMENT_01_000_000">
		<language name="JPN"> </language>
		<language name="JPN_KANJI"> </language>
	</row>

	<row id="ZKN_COMMENT_01_001_000">
		<language name="JPN">うまれてから　しばらくの　あいだは
せなかの　タネから　えいようを
もらって　おおきく　そだつ。</language>
		<language name="JPN_KANJI">生まれてから　しばらくの　あいだは
背中の　タネから　栄養をもらって
大きく　育つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_002_000">
		<language name="JPN">せなかの　つぼみが　ふくらみだすと
あまい　においが　ただよいはじめる。
たいりんの　はなが　さく　まえぶれ。</language>
		<language name="JPN_KANJI">背中の　つぼみが　膨らみだすと
甘い　においが　漂いはじめる。
大輪の　花が　咲く　前触れ。</language>
	</row>

	<row id="ZKN_COMMENT_01_003_000">
		<language name="JPN">あめの　ふった　よくじつは　せなかの
はなの　かおりが　つよまる。かおりに
さそわれ　ポケモンが　あつまる。</language>
		<language name="JPN_KANJI">雨の降った　翌日は
背中の　花の　香りが　強まる。
香りに　誘われ　ポケモンが　集まる。</language>
	</row>

	<row id="ZKN_COMMENT_01_004_000">
		<language name="JPN">ヒトカゲの　しっぽの　ほのおは
いのちの　ともしび。げんきな　ときは
ほのおも　ちからづよく　もえあがる。</language>
		<language name="JPN_KANJI">ヒトカゲの　しっぽの　炎は
命の　ともしび。元気な　ときは
炎も　力強く　燃え上がる。</language>
	</row>

	<row id="ZKN_COMMENT_01_005_000">
		<language name="JPN">リザードが　くらす　いわやまを
よなかに　みあげると　しっぽの
ほのおが　ほしのように　みえる。</language>
		<language name="JPN_KANJI">リザードが　暮らす　岩山を
夜中に　見上げると
しっぽの　炎が　星のように　見える。</language>
	</row>

	<row id="ZKN_COMMENT_01_006_000">
		<language name="JPN">くるしい　たたかいを　けいけんした
リザードンほど　ほのおの　おんどが
たかくなると　いわれている。</language>
		<language name="JPN_KANJI">苦しい　戦いを　経験した
リザードンほど　炎の　温度が
高くなると　言われている。</language>
	</row>

	<row id="ZKN_COMMENT_01_007_000">
		<language name="JPN">こうらに　とじこもり　みを　まもる。
あいての　すきを　みのがさず
みずを　ふきだして　はんげきする。</language>
		<language name="JPN_KANJI">甲羅に　閉じこもり　身を守る。
相手の　すきを　見逃さず
水を　吹き出して　反撃する。</language>
	</row>

	<row id="ZKN_COMMENT_01_008_000">
		<language name="JPN">いちまんねんの　じゅみょうを　もつと
いわれている。ふさふさの　しっぽは
ながいきの　シンボルとして　にんき。</language>
		<language name="JPN_KANJI">１万年の　寿命を　持つと
言われている。ふさふさの　しっぽは
長生きの　シンボルとして人気。</language>
	</row>

	<row id="ZKN_COMMENT_01_009_000">
		<language name="JPN">こうらの　ロケットほうから　ふきだす
すいりゅうは　ぶあつい　てっぱんも
いっぱつで　つらぬく　はかいりょく。</language>
		<language name="JPN_KANJI">甲羅の　ロケット砲から　吹き出す
水流は　分厚い　鉄板も
一発で　貫く　破壊力。</language>
	</row>

	<row id="ZKN_COMMENT_01_010_000">
		<language name="JPN">あかい　しょっかくから　においを
だして　てきを　おいはらう。
だっぴを　くりかえし　おおきくなる。</language>
		<language name="JPN_KANJI">赤い　触角から　においを出して
敵を　追い払う。
脱皮を　繰り返し　大きくなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_011_000">
		<language name="JPN">こうてつのように　かたい　カラで
やわらかい　なかみを　まもっている。
しんかするまで　じっと　たえている。</language>
		<language name="JPN_KANJI">鋼鉄のように　硬い　殻で
やわらかい　中身を　守っている。
進化するまで　じっと　耐えている。</language>
	</row>

	<row id="ZKN_COMMENT_01_012_000">
		<language name="JPN">はなの　ミツが　だいこうぶつ。
わずかな　かふんで　はなばたけの
ばしょを　さがしだすことが　できる。</language>
		<language name="JPN_KANJI">花の　ミツが　大好物。
わずかな　花粉で　花畑の
場所を　探し出すことが　できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_013_000">
		<language name="JPN">まいにち　じぶんと　おなじ　おもさの
はっぱを　たべる。あたまの　ハリで
おそってきた　てきを　げきたい。</language>
		<language name="JPN_KANJI">毎日　自分と　同じ　重さの
葉っぱを　食べる。頭の　針で
襲ってきた　敵を　撃退。</language>
	</row>

	<row id="ZKN_COMMENT_01_014_000">
		<language name="JPN">てんてきに　みつからないように
はっぱの　うらや　えだの　すきまに
かくれて　しんかの　ときを　まつ。</language>
		<language name="JPN_KANJI">天敵に　見つからないように
葉っぱの　裏や　枝の　すきまに
隠れて　進化の　ときを　待つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_015_000">
		<language name="JPN">こうそくで　とびまわり　どくバリで
こうげきしたあと　すぐに　とびさる
せんぽうが　とくいわざだ。</language>
		<language name="JPN_KANJI">高速で　飛びまわり　毒針で
攻撃したあと　すぐに　飛び去る
戦法が　得意技だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_016_000">
		<language name="JPN">たたかいを　このまない　おとなしい
せいかくだが　へたに　てを　だすと
きょうれつに　はんげきされるぞ。</language>
		<language name="JPN_KANJI">戦いを　好まない　大人しい
性格だが　下手に　手を　出すと
強烈に　反撃されるぞ。</language>
	</row>

	<row id="ZKN_COMMENT_01_017_000">
		<language name="JPN">ひろい　なわばりを　とびまわりながら
えものを　さがす。はったつした
あしの　ツメで　えものを　しとめる。</language>
		<language name="JPN_KANJI">広い　縄張りを　飛び回りながら
獲物を　探す。発達した
足の　ツメで　獲物を　しとめる。</language>
	</row>

	<row id="ZKN_COMMENT_01_018_000">
		<language name="JPN">ピジョットが　ちからいっぱい
はばたくと　たいぼくも　しなるほどの
きょうふうを　まきおこす。</language>
		<language name="JPN_KANJI">ピジョットが　力いっぱい
羽ばたくと　大木も　しなるほどの
強風を　巻き起こす。</language>
	</row>

	<row id="ZKN_COMMENT_01_019_000">
		<language name="JPN">１にちじゅう　エサを　さがしている。
キバは　しぬまで　のびつづけるので
かたいものを　かじって　けずる。</language>
		<language name="JPN_KANJI">１日中　エサを　探している。
キバは　死ぬまで　伸び続けるので
硬いものを　かじって　削る。</language>
	</row>

	<row id="ZKN_COMMENT_01_020_000">
		<language name="JPN">いがいと　きょうぼうな　ポケモン。
ながく　のびた　キバは　ぶあつい　
コンクリートも　かんたんに　けずる。</language>
		<language name="JPN_KANJI">意外と　凶暴な　ポケモン。
長く　伸びた　キバは　分厚い　
コンクリートも　簡単に　削る。</language>
	</row>

	<row id="ZKN_COMMENT_01_021_000">
		<language name="JPN">ちいさな　つばさを　いそがしく
はばたかせて　とぶ。くさむらにいる
えものを　くちばしで　さがしだす。</language>
		<language name="JPN_KANJI">小さな　翼を　忙しく
羽ばたかせて　飛ぶ。草むらにいる
獲物を　クチバシで　探し出す。</language>
	</row>

	<row id="ZKN_COMMENT_01_022_000">
		<language name="JPN">おおきな　つばさで　１にちじゅう
とびまわる　たいりょくの　もちぬし。
するどい　くちばしで　たたかう。</language>
		<language name="JPN_KANJI">大きな　翼で　１日中
飛び回る　体力の　持ち主。
鋭い　クチバシで　戦う。</language>
	</row>

	<row id="ZKN_COMMENT_01_023_000">
		<language name="JPN">おとを　まったく　たてずに　くさちの
なかを　すすむ。ゆだんしている
えものに　はいごから　おそいかかる。</language>
		<language name="JPN_KANJI">音を　まったく　立てずに　草地の
中を　進む。油断している獲物に
背後から　襲いかかる。</language>
	</row>

	<row id="ZKN_COMMENT_01_024_000">
		<language name="JPN">おなかの　もようで　てきを　いかく。
もように　おびえて　うごけなくなった
すきに　からだで　しめつける。</language>
		<language name="JPN_KANJI">お腹の　模様で　敵を　威嚇。
模様に　おびえて　動けなくなった
すきに　体で　絞めつける。</language>
	</row>

	<row id="ZKN_COMMENT_01_025_000">
		<language name="JPN">よわった　なかまの　ピカチュウに
でんきをながし　ショックをあたえて
げんきを　わけることも　ある。</language>
		<language name="JPN_KANJI">弱った　仲間の　ピカチュウに
電気を流し　ショックを与えて
元気を　分けることも　ある。</language>
	</row>

	<row id="ZKN_COMMENT_01_026_000">
		<language name="JPN">しっぽが　アースの　やくめをはたして
でんきを　じめんに　にがすので
じぶんじしんは　しびれたりしない。</language>
		<language name="JPN_KANJI">しっぽが　アースの　役目をはたして
電気を　地面に　逃がすので
自分自身は　しびれたりしない。</language>
	</row>

	<row id="ZKN_COMMENT_01_027_000">
		<language name="JPN">ふかいあなを　ほって　せいかつ。
きけんが　せまると　からだを　まるめ
てきの　こうげきを　じっと　たえる。</language>
		<language name="JPN_KANJI">深い穴を　掘って　生活。
危険が　迫ると　体を　丸め
敵の　攻撃を　じっと　耐える。</language>
	</row>

	<row id="ZKN_COMMENT_01_028_000">
		<language name="JPN">トゲは　ひふが　かたくなったもの。
からだを　まるめて　トゲトゲを
さすように　あいてを　こうげきする。</language>
		<language name="JPN_KANJI">トゲは　皮膚が　硬くなったもの。
体を　丸めて　トゲトゲを
刺すように　相手を　攻撃する。</language>
	</row>

	<row id="ZKN_COMMENT_01_029_000">
		<language name="JPN">たたかいを　このまない　せいかく。
どくバリから　ぶんぴつされる　どくは
ひとしずくでも　いのちとりだ。</language>
		<language name="JPN_KANJI">戦いを　好まない　性格。
毒針から　分泌される　毒は
一滴でも　命取りだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_030_000">
		<language name="JPN">きけんを　かんじると　ぜんしんの
トゲを　さかだてる。ニドリーノに
くらべて　トゲの　そだちが　おそい。</language>
		<language name="JPN_KANJI">危険を　感じると　全身のトゲを
逆立てる。ニドリーノに　比べて
トゲの　育ちが　遅い。</language>
	</row>

	<row id="ZKN_COMMENT_01_031_000">
		<language name="JPN">よろいのように　かたい　ウロコが
ぜんしんを　つつむ。すあなの
こどもを　いのちがけで　まもる。</language>
		<language name="JPN_KANJI">よろいのように　硬い　ウロコが
全身を　包む。
巣穴の　子供を　命がけで　守る。</language>
	</row>

	<row id="ZKN_COMMENT_01_032_000">
		<language name="JPN">くさむらの　うえに　みみだけ　だして
まわりの　けはいを　さぐる。
もうどくの　ツノで　みを　まもる。</language>
		<language name="JPN_KANJI">草むらの　上に　耳だけ　出して
まわりの　気配を　探る。
猛毒の　ツノで　身を　守る。</language>
	</row>

	<row id="ZKN_COMMENT_01_033_000">
		<language name="JPN">きしょうが　あらい　ポケモン。
あいてに　つきさした　しょうげきで
ツノから　もうどくが　にじみでる。</language>
		<language name="JPN_KANJI">気性が　荒い　ポケモン。
相手に　突き刺した　衝撃で
ツノから　猛毒が　にじみ出る。</language>
	</row>

	<row id="ZKN_COMMENT_01_034_000">
		<language name="JPN">しっぽの　いちげきは　でんちゅうを
まるで　マッチぼうのように
まっぷたつに　へしおってしまう。</language>
		<language name="JPN_KANJI">しっぽの　一撃は　電柱を
まるで　マッチ棒のように
真っ二つに　へし折ってしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_035_000">
		<language name="JPN">まんげつの　よる　どこから　ともなく
あつまり　ピッピたちは　おどりだす。
つきのひかりを　あびて　うかぶのだ。</language>
		<language name="JPN_KANJI">満月の　夜　どこから　ともなく
集まり　ピッピたちは　踊りだす。
月の光を　浴びて　浮かぶのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_036_000">
		<language name="JPN">１キロさきに　おちた　はりの　おとも
きこえるほど　みみが　いいので
ふだんは　しずかな　ところに　いる。</language>
		<language name="JPN_KANJI">１キロ先に　落ちた　針の　音も
きこえるほど　耳が　いいので
普段は　静かな　ところに　いる。</language>
	</row>

	<row id="ZKN_COMMENT_01_037_000">
		<language name="JPN">６ほんの　しっぽは　そだつごとに
けなみが　よくなり　うつくしくなる。
だきしめると　ほんのり　あたたかい。</language>
		<language name="JPN_KANJI">６本の　しっぽは　育つごとに
毛並みが　よくなり　美しくなる。
抱きしめると　ほんのり　暖かい。</language>
	</row>

	<row id="ZKN_COMMENT_01_038_000">
		<language name="JPN">９ほんの　ながい　しっぽ　それぞれに
じんつうりきが　こめられており
１０００ねん　いきることが　できる。</language>
		<language name="JPN_KANJI">９本の　長い　しっぽ　それぞれに
神通力が　こめられており
１０００年　生きることが　できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_039_000">
		<language name="JPN">つぶらな　ひとみを　みつめていると
ねむらずには　いられないほどの
ここちよい　うたを　うたいはじめる。</language>
		<language name="JPN_KANJI">つぶらな　ひとみを　みつめていると
眠らずには　いられないほどの
心地よい　歌を　歌いはじめる。</language>
	</row>

	<row id="ZKN_COMMENT_01_040_000">
		<language name="JPN">きめこまやかな　たいもうは
てざわりが　よすぎて　うっかり
さわると　はなれられなくなる。</language>
		<language name="JPN_KANJI">きめこまやかな　体毛は
手触りが　よすぎて　うっかり
触ると　離れられなくなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_041_000">
		<language name="JPN">ちょうおんぱを　だして　まわりの
ようすを　たしかめながら　とぶので
りょうめが　なくても　だいじょうぶ。</language>
		<language name="JPN_KANJI">超音波を　だして　周りの
様子を　確かめながら　飛ぶので
両目が　なくても　大丈夫。</language>
	</row>

	<row id="ZKN_COMMENT_01_042_000">
		<language name="JPN">まよなか　かっぱつに　とびまわり
ねらいをつけた　えものに　キバを
さし　しぬほど　ちを　すいまくる。</language>
		<language name="JPN_KANJI">真夜中　活発に　飛び回り
ねらいをつけた　獲物に　キバを
刺し　死ぬほど　血を　吸いまくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_043_000">
		<language name="JPN">ひるまは　ねっこの　あしを　じめんに
うめて　うごかないことが　おおい。
よる　あるきまわって　タネを　まく。</language>
		<language name="JPN_KANJI">昼間は　根っこの　足を　地面に
埋めて　動かないことが　多い。
夜　歩き回って　タネを　まく。</language>
	</row>

	<row id="ZKN_COMMENT_01_044_000">
		<language name="JPN">くちから　たれている　ミツは
２キロ　はなれていても　はなが
まがるほど　もうれつに　くさい。</language>
		<language name="JPN_KANJI">口から　たれている　ミツは
２キロ　離れていても　鼻が
まがるほど　猛烈に　くさい。</language>
	</row>

	<row id="ZKN_COMMENT_01_045_000">
		<language name="JPN">はなびらの　おおきさは　せかいいち。
ひどい　アレルギーを　ひきおこす
どくかふんを　ばらまいて　あるく。</language>
		<language name="JPN_KANJI">花びらの　大きさは　世界一。
ひどい　アレルギーを　引き起こす
毒花粉を　ばらまいて　歩く。</language>
	</row>

	<row id="ZKN_COMMENT_01_046_000">
		<language name="JPN">とうちゅうかそうと　よばれる
キノコを　せなかに　はやしている。
パラスと　ともに　おおきく　そだつ。</language>
		<language name="JPN_KANJI">冬虫夏草と　呼ばれる
キノコを　背中に　生やしている。
パラスと　ともに　大きく　育つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_047_000">
		<language name="JPN">からだよりも　おおきな　キノコが
パラセクトを　あやつっている。
どくの　ほうしを　ばらまく。</language>
		<language name="JPN_KANJI">体よりも　大きな　キノコが
パラセクトを　操っている。
毒の　胞子を　ばらまく。</language>
	</row>

	<row id="ZKN_COMMENT_01_048_000">
		<language name="JPN">ちいさな　めが　たくさん　あつまって
おおきな　めに　なっている。
よるになると　あかりに　あつまる。</language>
		<language name="JPN_KANJI">小さな　目が　たくさん　集まって
大きな　目に　なっている。
夜になると　明かりに　集まる。</language>
	</row>

	<row id="ZKN_COMMENT_01_049_000">
		<language name="JPN">はばたいて　りんぷんを　まきちらす。
りんぷんが　からだに　つくと　どくの
せいぶんが　ひふに　しみこんでくる。</language>
		<language name="JPN_KANJI">羽ばたいて　りんぷんを　まき散らす。
りんぷんが　体に　つくと　毒の
成分が　皮膚に　染み込んでくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_050_000">
		<language name="JPN">ちちゅうで　くらしている　ポケモン。
くらい　ちかに　いるため
あかるい　たいようが　にがて。</language>
		<language name="JPN_KANJI">地中で　暮らしている　ポケモン。
暗い　地下に　いるため
明るい　太陽が　苦手。</language>
	</row>

	<row id="ZKN_COMMENT_01_051_000">
		<language name="JPN">３つの　あたまが　たがいちがいに
うごいて　どんなに　かたい　ちそうも
ちか１００キロまで　ほりすすむ。</language>
		<language name="JPN_KANJI">３つの　頭が　互い違いに　動いて
どんなに　硬い　地層も
地下１００キロまで　掘り進む。</language>
	</row>

	<row id="ZKN_COMMENT_01_052_000">
		<language name="JPN">よなかに　こうどうする　しゅうせい。
きらきら　ひかるものを　みつけると
まけないくらい　ひとみが　かがやく。</language>
		<language name="JPN_KANJI">夜中に　行動する　習性。
キラキラ　光るものを　見つけると
負けないくらい　ひとみが　輝く。</language>
	</row>

	<row id="ZKN_COMMENT_01_053_000">
		<language name="JPN">きぐらいが　たかい　ポケモン。
マニアの　あいだでは　ひたいの
ほうせきの　サイズが　わだいになる。</language>
		<language name="JPN_KANJI">気位が　高い　ポケモン。
マニアの　あいだでは　額の
宝石の　サイズが　話題になる。</language>
	</row>

	<row id="ZKN_COMMENT_01_054_000">
		<language name="JPN">ずつうで　ふだん　ねむっている
のうさいぼうが　しげき　されると
ふしぎな　ちからが　つかえる。</language>
		<language name="JPN_KANJI">頭痛で　普段　眠っている
脳細胞が　刺激　されると
不思議な　力が　使える。</language>
	</row>

	<row id="ZKN_COMMENT_01_055_000">
		<language name="JPN">ひたいが　あやしく　かがやくとき
ゴルダックは　もてる　ちからを
１００パーセント　はっき　できる。</language>
		<language name="JPN_KANJI">額が　あやしく　輝くとき
ゴルダックは　持てる　力を
１００パーセント　発揮できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_056_000">
		<language name="JPN">きのうえで　せいかつしている。
むれの　１ぴきが　おこりはじめると
ぜんいんが　いみもなく　あばれだす。</language>
		<language name="JPN_KANJI">木の上で　生活している。
群れの　１匹が　怒り出すと
全員が　意味もなく　暴れだす。</language>
	</row>

	<row id="ZKN_COMMENT_01_057_000">
		<language name="JPN">しせんが　あっただけで　おこり
にげだしたら　また　おこり
たたきのめしても　まだ　おこる。</language>
		<language name="JPN_KANJI">視線が　合っただけで　怒り
逃げ出したら　また　怒り
たたきのめしても　まだ　怒る。</language>
	</row>

	<row id="ZKN_COMMENT_01_058_000">
		<language name="JPN">トレーナーに　とても　ちゅうじつで
うっかり　ちかづくと　はげしく
ほえたて　まちのそとに　おいはらう。</language>
		<language name="JPN_KANJI">トレーナーに　とても　忠実で
うっかり　近づくと　激しく
ほえたて　街の外に　追い払う。</language>
	</row>

	<row id="ZKN_COMMENT_01_059_000">
		<language name="JPN">いっちゅうやで　１００００キロの
きょりを　かけぬける　すがたは
おおくの　ひとを　みりょうしてきた。</language>
		<language name="JPN_KANJI">一昼夜で　１００００キロの
距離を　駆けぬける　姿は
多くの　人を　魅了してきた。</language>
	</row>

	<row id="ZKN_COMMENT_01_060_000">
		<language name="JPN">ないぞうが　すけて　みえるほど
ひふが　うすい。はえたばかりの
あしは　あるくことが　にがて。</language>
		<language name="JPN_KANJI">内臓が　透けて　見えるほど
皮膚が　薄い。生えたばかりの
足は　歩くことが　苦手。</language>
	</row>

	<row id="ZKN_COMMENT_01_061_000">
		<language name="JPN">おなかの　うずまきは　びみょうに
うねっているので　みつめていると
だんだん　ねむくなってしまう。</language>
		<language name="JPN_KANJI">お腹の　渦巻きは　微妙に
うねっているので　見つめていると
だんだん　眠くなってしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_062_000">
		<language name="JPN">きょうじんな　きんにくを　もつ。
たいへいようを　やすむことなく
およぎつづけることが　できるのだ。</language>
		<language name="JPN_KANJI">強じんな　筋肉を　持つ。
太平洋を　休むことなく
泳ぎ続けることが　できるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_063_000">
		<language name="JPN">ちょうのうりょくを　つかったあとは
のうみそが　つかれてしまうので
１にちに　１８じかんも　ねむるのだ。</language>
		<language name="JPN_KANJI">超能力を　使った後は
脳みそが　疲れてしまうので
１日に　１８時間も　眠るのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_064_000">
		<language name="JPN">ぎんのスプーンを　みつめて
せいしんを　とういつ　していると
はっさんする　アルファは　がふえる。</language>
		<language name="JPN_KANJI">銀のスプーンを　見つめて
精神を　統一　していると
発散する　アルファ波　が増える。</language>
	</row>

	<row id="ZKN_COMMENT_01_065_000">
		<language name="JPN">りょうてに　もつ　スプーンは
フーディンの　ちょうのうりょくで
うみだしたモノと　いわれている。</language>
		<language name="JPN_KANJI">両手に　持つ　スプーンは
フーディンの　超能力で
生み出したモノと　言われている。</language>
	</row>

	<row id="ZKN_COMMENT_01_066_000">
		<language name="JPN">こがらな　からだだけど　ちからもち。
イシツブテなら　なんびきも　まとめて
かるがると　もちあげ　なげとばす。</language>
		<language name="JPN_KANJI">小柄な　体だけど　力持ち。
イシツブテなら　何匹も　まとめて
軽々と　持ち上げ　投げ飛ばす。</language>
	</row>

	<row id="ZKN_COMMENT_01_067_000">
		<language name="JPN">からだを　きたえるために　よろこんで
おもい　にもつを　はこぶので
ひとのかわりに　ちからしごとをする。</language>
		<language name="JPN_KANJI">体を　鍛えるために　喜んで
重い　荷物を　運ぶので
人の代わりに　力仕事をする。</language>
	</row>

	<row id="ZKN_COMMENT_01_068_000">
		<language name="JPN">４ほんの　ちからづよい　うでは
めにも　とまらぬ　はやさで
パンチや　チョップを　たたきこむ。</language>
		<language name="JPN_KANJI">４本の　力強い　腕は
目にも　止まらぬ　速さで
パンチや　チョップを　たたき込む。</language>
	</row>

	<row id="ZKN_COMMENT_01_069_000">
		<language name="JPN">こうおん　たしつの　とちを　このむ。
ツルを　のばして　えものを　とらえる
ときの　うごきは　とても　すばやい。</language>
		<language name="JPN_KANJI">高温　多湿の　土地を　好む。
ツルを　伸ばして　獲物を　捕らえる
ときの　動きは　とても　素早い。</language>
	</row>

	<row id="ZKN_COMMENT_01_070_000">
		<language name="JPN">しょくぶつに　そっくりな　ポケモン。
ゆだんして　ちかよってきた　えものに
どくのこなを　あびせて　つかまえる。</language>
		<language name="JPN_KANJI">植物に　そっくりな　ポケモン。
油断して　近寄って来た　獲物に
毒の粉を　あびせて　捕まえる。</language>
	</row>

	<row id="ZKN_COMMENT_01_071_000">
		<language name="JPN">ミツのような　かおりの　えきたいを
くちに　ためているが　それは
なんでも　とかす　ようかいえきだ。</language>
		<language name="JPN_KANJI">ミツのような　香りの　液体を
口に　ためているが　それは
なんでも　溶かす　溶解液だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_072_000">
		<language name="JPN">からだの　ほとんどが　みずなので
なみに　ながされ　すなはまに
うちあげられると　ひからびてしまう。</language>
		<language name="JPN_KANJI">体の　ほとんどが　水なので
波に　流され　砂浜に
打ち上げられると　干からびてしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_073_000">
		<language name="JPN">８０ぽんの　しょくしゅを　のばして
どくの　ほういもうを　つくりだす。
つかまると　にげるのは　むずかしい。</language>
		<language name="JPN_KANJI">８０本の　触手を　伸ばして
毒の　包囲網を　作り出す。
捕まると　逃げるのは　難しい。</language>
	</row>

	<row id="ZKN_COMMENT_01_074_000">
		<language name="JPN">じっとしていると　いしころ　にしか
みえないので　つい　ふみつけると
げんこつを　ふりまわして　おこる。</language>
		<language name="JPN_KANJI">ジッとしていると　石ころ　にしか
見えないので　つい　踏みつけると
ゲンコツを　振りまわして　怒る。</language>
	</row>

	<row id="ZKN_COMMENT_01_075_000">
		<language name="JPN">やまみちを　ころがって　いどう。
いきおいが　ついてくると　どんな
ポケモンでも　とめるのは　たいへん。</language>
		<language name="JPN_KANJI">山道を　転がって　移動。
勢いが　ついてくると　どんな
ポケモンでも　止めるのは　大変。</language>
	</row>

	<row id="ZKN_COMMENT_01_076_000">
		<language name="JPN">がんせきの　ような　かたい　からだは
ダイナマイトでも　きずつかない。
１ねんに　１どだけ　だっぴする。</language>
		<language name="JPN_KANJI">岩石の　ような　硬い　体は
ダイナマイトでも　傷つかない。
１年に　１度だけ　脱皮する。</language>
	</row>

	<row id="ZKN_COMMENT_01_077_000">
		<language name="JPN">うまれたばかりでは　たつのがやっと。
だが　はしるほどに　あしこしは
きたえられて　そくどが　ましていく。</language>
		<language name="JPN_KANJI">生まれたばかりでは　立つのがやっと。
だが　走るほどに　足腰は
鍛えられて　速度が　増していく。</language>
	</row>

	<row id="ZKN_COMMENT_01_078_000">
		<language name="JPN">ぜんりょくで　かけぬけるとき
もえる　たてがみが　きらめいて
よりいっそう　うつくしく　みえる。</language>
		<language name="JPN_KANJI">全力で　駆け抜けるとき
燃える　たてがみが　きらめいて
より一層　美しく　見える。</language>
	</row>

	<row id="ZKN_COMMENT_01_079_000">
		<language name="JPN">うごきは　のろいが　しっぽを　つかう
つりが　とくい。どんかんなので
しっぽを　かまれても　いたくない。</language>
		<language name="JPN_KANJI">動きは　ノロいが　しっぽを　使う
釣りが　得意。鈍感なので
しっぽを　かまれても　痛くない。</language>
	</row>

	<row id="ZKN_COMMENT_01_080_000">
		<language name="JPN">ぼんやりしている　ヤドランだが
シェルダーが　つよく　しっぽを
かむとき　なにかが　ひらめくらしい。</language>
		<language name="JPN_KANJI">ぼんやりしている　ヤドランだが
シェルダーが　強く　しっぽを
かむとき　なにかが　ひらめくらしい。</language>
	</row>

	<row id="ZKN_COMMENT_01_081_000">
		<language name="JPN">さゆうにある　ユニットから　だす
でんじはで　じゅうりょくを
さえぎって　そらに　うかぶのだ。</language>
		<language name="JPN_KANJI">左右にある　ユニットから　だす
電磁波で　重力を
さえぎって　空に　浮かぶのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_082_000">
		<language name="JPN">３びきの　コイルが　つながって
つよくなった　でんじはは　まわりの　
すいぶんを　かんそう　させるほど。</language>
		<language name="JPN_KANJI">３匹の　コイルが　つながって
強くなった　電磁波は　周りの　
水分を　乾燥　させるほど。</language>
	</row>

	<row id="ZKN_COMMENT_01_083_000">
		<language name="JPN">クキが　なくなると　いきていけない。
だから　クキを　ねらう　あいてとは
いのちがけで　たたかうのだ。</language>
		<language name="JPN_KANJI">クキが　なくなると　生きていけない。
だから　クキを　ねらう　相手とは
命がけで　戦うのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_084_000">
		<language name="JPN">２つの　あたまの　のうみそは
テレパシーのような　ちからで
きもちを　つうじあわせているらしい。</language>
		<language name="JPN_KANJI">２つの　頭の　脳みそは
テレパシーのような　力で
気持ちを　通じ合わせているらしい。</language>
	</row>

	<row id="ZKN_COMMENT_01_085_000">
		<language name="JPN">しんかのときに　ドードーの　あたまの
どちらかが　ぶんれつした　ちんしゅ。
じそく６０キロいじょうで　はしる。</language>
		<language name="JPN_KANJI">進化のときに　ドードーの　頭の
どちらかが　分裂した　珍種。
時速６０キロ以上で　走る。</language>
	</row>

	<row id="ZKN_COMMENT_01_086_000">
		<language name="JPN">さむくなるほど　げんきになって
こおりの　うかぶ　つめたい　うみを
うれしそうに　およぎまわる。</language>
		<language name="JPN_KANJI">寒くなるほど　元気になって
氷の　浮かぶ　冷たい　海を
うれしそうに　泳ぎまわる。</language>
	</row>

	<row id="ZKN_COMMENT_01_087_000">
		<language name="JPN">りゅうせんけいの　からだは　みずの
ていこうも　すくなく　８ノットの
スピードで　つめたい　うみをおよぐ。</language>
		<language name="JPN_KANJI">流線型の　体は　水の
抵抗も　少なく　８ノットの
スピードで　冷たい　海を泳ぐ。</language>
	</row>

	<row id="ZKN_COMMENT_01_088_000">
		<language name="JPN">ヘドロが　ポケモンに　なった。
きたない　ばしょに　あつまって
からだの　ばいきんを　ふやしていく。</language>
		<language name="JPN_KANJI">ヘドロが　ポケモンに　なった。
汚い　場所に　集まって
体の　ばい菌を　増やしていく。</language>
	</row>

	<row id="ZKN_COMMENT_01_089_000">
		<language name="JPN">とっても　くさい！　からだの
せいぶんは　もうどくで　ベトベトンが
とおると　どんな　くさきも　かれる。</language>
		<language name="JPN_KANJI">とっても　くさい！　体の
成分は　猛毒で　ベトベトンが
通ると　どんな　草木も　枯れる。</language>
	</row>

	<row id="ZKN_COMMENT_01_090_000">
		<language name="JPN">２まいの　カラを　あけしめすることで
うしろむきに　およぐ。どんなときでも
おおきな　ベロは　だしっぱなし。</language>
		<language name="JPN_KANJI">２枚の　殻を　開け閉めすることで
後ろ向きに　泳ぐ。どんなときでも
大きな　ベロは　出しっぱなし。</language>
	</row>

	<row id="ZKN_COMMENT_01_091_000">
		<language name="JPN">カラを　しっかりと　とじて　みを
まもりながら　トゲを　とばして
てきを　げきたいする　せんぽう。</language>
		<language name="JPN_KANJI">殻を　しっかりと　閉じて　身を
守りながら　トゲを　飛ばして
敵を　撃退する　戦法。</language>
	</row>

	<row id="ZKN_COMMENT_01_092_000">
		<language name="JPN">ガスから　うまれた　せいめいたい。
どくをふくんだ　ガスの　からだに
つつまれると　だれでも　きぜつする。</language>
		<language name="JPN_KANJI">ガスから　生まれた　生命体。
毒を含んだ　ガスの　体に
包まれると　だれでも　気絶する。</language>
	</row>

	<row id="ZKN_COMMENT_01_093_000">
		<language name="JPN">くらやみにまぎれ　ガスのてを　のばし
ひとのかたを　たたくのが　すき。
さわられると　ふるえが　とまらない。</language>
		<language name="JPN_KANJI">くらやみにまぎれ　ガスの手を　伸ばし
人の肩を　たたくのが　好き。
触られると　震えが　止まらない。</language>
	</row>

	<row id="ZKN_COMMENT_01_094_000">
		<language name="JPN">くらやみに　うかぶ　えがおの
しょうたいは　ひとに　のろいを
かけて　よろこぶ　ゲンガーだ。</language>
		<language name="JPN_KANJI">くらやみに　浮かぶ　笑顔の
正体は　人に　のろいを
かけて　喜ぶ　ゲンガーだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_095_000">
		<language name="JPN">おおきな　くちを　あけて
たくさんの　つちを　のみこみながら
ながい　トンネルを　つくっていく。</language>
		<language name="JPN_KANJI">大きな　口を　あけて
たくさんの　土を　飲みこみながら
長い　トンネルを　つくっていく。</language>
	</row>

	<row id="ZKN_COMMENT_01_096_000">
		<language name="JPN">つきでた　はなを　ひくひくさせると
みている　ユメが　わかるという。
だいこうぶつは　たのしい　ユメだ。</language>
		<language name="JPN_KANJI">突き出た　鼻を　ひくひくさせると
見ている　夢が　わかるという。
大好物は　楽しい　夢だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_097_000">
		<language name="JPN">ふりこを　めのまえで　ゆらされると
たったいま　めざめたばかりの　ひとも
３びょうごには　ねむってしまう。</language>
		<language name="JPN_KANJI">振り子を　目の前で　ゆらされると
たった今　目覚めたばかりの　人も
３秒後には　眠ってしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_098_000">
		<language name="JPN">すなはまに　あなを　ほって　くらす。
ハサミは　たたかいで　とれても
また　はえてきて　もとどおり。</language>
		<language name="JPN_KANJI">砂浜に　穴を　掘って　暮らす。
ハサミは　戦いで　取れても
また　生えてきて　元通り。</language>
	</row>

	<row id="ZKN_COMMENT_01_099_000">
		<language name="JPN">おおきいほうの　ハサミの　パワーは
１まんばりき。しかし　おもすぎるため
ねらいを　つけることが　にがてだ。</language>
		<language name="JPN_KANJI">大きいほうの　ハサミの　パワーは
１万馬力。しかし　重すぎるため
ねらいを　つけることが　苦手だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_100_000">
		<language name="JPN">モンスターボールに　そっくり。
まちがって　さわると　かんでんしたり
ときには　ばくはつするので　きけん。</language>
		<language name="JPN_KANJI">モンスターボールに　そっくり。
間違って　触ると　感電したり
ときには　爆発するので　危険。</language>
	</row>

	<row id="ZKN_COMMENT_01_101_000">
		<language name="JPN">でんきエネルギーを　ためすぎて
ぱんぱんに　ふくらんだ　マルマインが
かぜに　ながされてくることが　ある。</language>
		<language name="JPN_KANJI">電気エネルギーを　ためすぎて
ぱんぱんに　膨らんだ　マルマインが
風に　流されてくることが　ある。</language>
	</row>

	<row id="ZKN_COMMENT_01_102_000">
		<language name="JPN">テレパシーで　かいわをしているため
タマタマを　ひきはなそうとしても
すぐに　あつまって　６ぴきになる。</language>
		<language name="JPN_KANJI">テレパシーで　会話をしているため
タマタマを　引き離そうとしても
すぐに　集まって　６匹になる。</language>
	</row>

	<row id="ZKN_COMMENT_01_103_000">
		<language name="JPN">あるく　ねったいうりんと　よばれる。
おおきくなった　あたまの　ひとつが
じめんに　おちると　タマタマになる。</language>
		<language name="JPN_KANJI">歩く　熱帯雨林と　呼ばれる。
大きくなった　頭の　ひとつが
地面に　落ちると　タマタマになる。</language>
	</row>

	<row id="ZKN_COMMENT_01_104_000">
		<language name="JPN">しにわかれた　ははおやを　おもいだし
ないてしまうとき　あたまに　かぶった
ホネが　からからと　おとを　たてる。</language>
		<language name="JPN_KANJI">死に別れた　母親を　思い出し
泣いてしまうとき　頭に　かぶった
ホネが　からからと　音を　立てる。</language>
	</row>

	<row id="ZKN_COMMENT_01_105_000">
		<language name="JPN">うまれたときから　いつも　もっている
ホネを　じざいに　つかいこなす。
せいかくは　きょうぼうだ。</language>
		<language name="JPN_KANJI">生まれたときから　いつも　持っている
ホネを　自在に　使いこなす。
性格は　凶暴だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_106_000">
		<language name="JPN">あしが　２ばいの　ながさに　のびる。
はじめて　たたかう　あいては
その　まあいの　ひろさに　おどろく。</language>
		<language name="JPN_KANJI">足が　２倍の　長さに　伸びる。
はじめて　戦う　相手は
その　間合いの　広さに　驚く。</language>
	</row>

	<row id="ZKN_COMMENT_01_107_000">
		<language name="JPN">うでを　ねじりながら　くりだす
パンチは　コンクリートも　ふんさい。
３ぷん　たたかうと　ひとやすみする。</language>
		<language name="JPN_KANJI">腕を　ねじりながら　繰り出す
パンチは　コンクリートも　粉砕。
３分　戦うと　ひとやすみする。</language>
	</row>

	<row id="ZKN_COMMENT_01_108_000">
		<language name="JPN">ながい　ベロは　だえきまみれで
なめられると　ぴりぴり　しびれる。
ベロが　のびると　しっぽが　ちぢむ。</language>
		<language name="JPN_KANJI">長い　ベロは　だえきまみれで
なめられると　ぴりぴり　しびれる。
ベロが　伸びると　しっぽが　縮む。</language>
	</row>

	<row id="ZKN_COMMENT_01_109_000">
		<language name="JPN">うすい　バルーンじょうの　からだに
もうどくの　ガスが　つまっているので
ときどき　だいばくはつを　おこす。</language>
		<language name="JPN_KANJI">薄い　バルーン状の　体に
猛毒の　ガスが　詰まっているので
ときどき　大爆発を　起こす。</language>
	</row>

	<row id="ZKN_COMMENT_01_110_000">
		<language name="JPN">ゴミからでる　どくガスを　すいこみ
たいないで　まぜあわて　さらに
きょうれつな　においを　まきちらす。</language>
		<language name="JPN_KANJI">ゴミからでる　毒ガスを　吸いこみ
体内で　混ぜ合わせ　さらに
強烈な　臭いを　まきちらす。</language>
	</row>

	<row id="ZKN_COMMENT_01_111_000">
		<language name="JPN">なんでも　たいあたりで　こわせる
ちからもちだが　あたまが　わるいので
ひとのしごとを　てつだうのは　むり。</language>
		<language name="JPN_KANJI">なんでも　体当たりで　壊せる
力持ちだが　頭が　悪いので
人の仕事を　手伝うのは　無理。</language>
	</row>

	<row id="ZKN_COMMENT_01_112_000">
		<language name="JPN">うしろあしだけで　たつようになり
まえあしが　じゆうになって　ちのうが
はったつしたが　ものわすればかりだ。</language>
		<language name="JPN_KANJI">後ろ足だけで　立つようになり
前足が　自由になって
知能が　発達したが　物忘ればかりだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_113_000">
		<language name="JPN">きずついた　ポケモンや　ひとがいると
えいようまんてんの　タマゴをうみ
わけあたえる　やさしい　ポケモン。</language>
		<language name="JPN_KANJI">傷ついた　ポケモンや　人がいると
栄養満点の　タマゴを生み
分け与える　優しい　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_114_000">
		<language name="JPN">たくさんの　うごめく　ツルに
おおわれて　しょうたいふめい。
あおいツルは　いっしょう　のびる。</language>
		<language name="JPN_KANJI">たくさんの　うごめく　ツルに
被われて　正体不明。
青いツルは　一生　伸びる。</language>
	</row>

	<row id="ZKN_COMMENT_01_115_000">
		<language name="JPN">おなかの　ふくろで　こそだてをする。
あんぜんな　ときだけ　こどもを
ふくろから　だして　あそばせる。</language>
		<language name="JPN_KANJI">お腹の　袋で　子育てをする。
安全な　ときだけ　子供を
袋から　出して　遊ばせる。</language>
	</row>

	<row id="ZKN_COMMENT_01_116_000">
		<language name="JPN">サンゴの　かげに　すみかを　つくる。
きけんを　かんじると　くちから
まっくろい　スミを　はいて　にげる。</language>
		<language name="JPN_KANJI">サンゴの　陰に　住処を　作る。
危険を　感じると　口から
真っ黒い　墨を　吐いて　逃げる。</language>
	</row>

	<row id="ZKN_COMMENT_01_117_000">
		<language name="JPN">トゲが　てきから　みを　まもる。
ひれや　ホネが　かんぽうやくの
ざいりょうとして　ちょうほうされる。</language>
		<language name="JPN_KANJI">トゲが　敵から　身を　守る。
ヒレや　ホネが　漢方薬の
材料として　重宝される。</language>
	</row>

	<row id="ZKN_COMMENT_01_118_000">
		<language name="JPN">きれいな　ひれを　たなびかせ
およぐ　すがたは　とても　かれいだが
ツノの　ひとつきは　きょうりょく。</language>
		<language name="JPN_KANJI">きれいな　ヒレを　たなびかせ
泳ぐ　姿は　とても　華麗だが
ツノの　一突きは　強力。</language>
	</row>

	<row id="ZKN_COMMENT_01_119_000">
		<language name="JPN">あきになると　プロポーズのため
からだに　あぶらが　のってきて
とても　きれいないろに　へんかする。</language>
		<language name="JPN_KANJI">秋になると　プロポーズのため
体に　脂が　のってきて
とても　きれいな色に　変化する。</language>
	</row>

	<row id="ZKN_COMMENT_01_120_000">
		<language name="JPN">あかい　コアが　あるかぎり
からだは　ちぎれても　いっしゅんで
もとどおりに　じこさいせい　できる。</language>
		<language name="JPN_KANJI">赤い　コアが　あるかぎり
体は　ちぎれても　一瞬で
元通りに　自己再生　できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_121_000">
		<language name="JPN">なないろに　かがやく　コアから
うちゅうに　むけて　でんぱを　だし
なにかしらの　こうしんを　している。</language>
		<language name="JPN_KANJI">七色に　輝く　コアから
宇宙に　向けて　電波を　だし
なにかしらの　交信を　している。</language>
	</row>

	<row id="ZKN_COMMENT_01_122_000">
		<language name="JPN">ゆびさきを　こまかく　ふるわせて
くうきちゅうの　ぶんしの　うごきを
とめて　みえないかべを　つくるのだ。</language>
		<language name="JPN_KANJI">指先を　細かく　ふるわせて
空気中の　分子の　動きを
止めて　見えない壁を　作るのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_123_000">
		<language name="JPN">りょうての　するどい　カマは
かたいものを　きればきるほど
さらに　きれあじを　ましていく。</language>
		<language name="JPN_KANJI">両手の　鋭い　カマは
硬いものを　切れば切るほど
さらに　切れ味を　増していく。</language>
	</row>

	<row id="ZKN_COMMENT_01_124_000">
		<language name="JPN">なきごえは　まるで　にんげんの
ことばのように　きこえるが
いみは　まったく　りかいできない。</language>
		<language name="JPN_KANJI">鳴き声は　まるで　人間の
言葉のように　聞こえるが
意味は　まったく　理解できない。</language>
	</row>

	<row id="ZKN_COMMENT_01_125_000">
		<language name="JPN">エレブーに　カミナリを　ためこませ
いつでも　つかえるように　する
けんきゅうが　すすめられている。</language>
		<language name="JPN_KANJI">エレブーに　雷を　貯めこませ
いつでも　使えるように　する
研究が　進められている。</language>
	</row>

	<row id="ZKN_COMMENT_01_126_000">
		<language name="JPN">しゃくねつの　ほのおを　ふきだすと
からだの　まわりに　かげろうが　でき
ブーバーの　すがたが　ぼやける。</language>
		<language name="JPN_KANJI">しゃく熱の　炎を　吹きだすと
体の　周りに　陽炎が　でき
ブーバーの　姿が　ぼやける。</language>
	</row>

	<row id="ZKN_COMMENT_01_127_000">
		<language name="JPN">パワフルな　ツノを　ふりまわす。
２ほんの　ツノで　はさんだ　えものは
ちぎれるまで　ぜったい　はなさない。</language>
		<language name="JPN_KANJI">パワフルな　ツノを　ふりまわす。
２本の　ツノで　挟んだ　獲物は
ちぎれるまで　絶対　離さない。</language>
	</row>

	<row id="ZKN_COMMENT_01_128_000">
		<language name="JPN">えものに　ねらいを　さだめると
いっちょくせんに　とっしんする。
あらっぽい　せいかくで　ゆうめい。</language>
		<language name="JPN_KANJI">獲物に　ねらいを　定めると
一直線に　突進する。
荒っぽい　性格で　有名。</language>
	</row>

	<row id="ZKN_COMMENT_01_129_000">
		<language name="JPN">ながねん　いきた　コイキングは
はねるだけで　やまをも　こえるが
わざのいりょくは　よわいまま。</language>
		<language name="JPN_KANJI">長年　生きた　コイキングは
跳ねるだけで　山をも　越えるが
技の威力は　弱いまま。</language>
	</row>

	<row id="ZKN_COMMENT_01_130_000">
		<language name="JPN">いちど　あばれだした　ギャラドスは
あらしが　ふきすさんでいようとも
どんなものでも　やきつくしてしまう。</language>
		<language name="JPN_KANJI">一度　暴れだした　ギャラドスは
あらしが　吹きすさんでいようとも
どんなものでも　焼きつくしてしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_131_000">
		<language name="JPN">にんげんの　ことばを　りかいする
たかい　ちのうを　もっているため
ぜつめつの　きけんに　ひんしている。</language>
		<language name="JPN_KANJI">人間の　言葉を　理解する
高い　知能を　持っているため
絶滅の　危険に　ひんしている。</language>
	</row>

	<row id="ZKN_COMMENT_01_132_000">
		<language name="JPN">ぜんしんの　さいぼうを　くみかえて
みたもの　そっくりに　へんしんするが
ちからが　ぬけると　もとにもどる。</language>
		<language name="JPN_KANJI">全身の　細胞を　組み換えて
みたもの　そっくりに　変身するが
力が　抜けると　元に戻る。</language>
	</row>

	<row id="ZKN_COMMENT_01_133_000">
		<language name="JPN">ふあんていな　いでんしの　おかげで
さまざまな　しんかの　かのうせいを
ひめている　とくしゅな　ポケモン。</language>
		<language name="JPN_KANJI">不安定な　遺伝子の　おかげで
さまざまな　進化の　可能性を
秘めている　特殊な　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_134_000">
		<language name="JPN">からだの　さいぼうの　つくりが
みずの　ぶんしに　にているため
みずに　とけると　みえなくなる。</language>
		<language name="JPN_KANJI">体の　細胞の　つくりが
水の　分子に　似ているため
水に　溶けると　みえなくなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_135_000">
		<language name="JPN">たいないに　でんきを　ためることで
さかだてた　ぜんしんの　たいもうを
ミサイルのように　つぎつぎ　とばす。</language>
		<language name="JPN_KANJI">体内に　電気を　ためることで
逆立てた　全身の　体毛を
ミサイルのように　次々　飛ばす。</language>
	</row>

	<row id="ZKN_COMMENT_01_136_000">
		<language name="JPN">すいこんだ　くうきを　たいないの
ほのおぶくろに　おくりこみ
１７００どの　ほのおにして　ふく。</language>
		<language name="JPN_KANJI">吸いこんだ　空気を　体内の
炎袋に　送りこみ
１７００度の　炎にして　吹く。</language>
	</row>

	<row id="ZKN_COMMENT_01_137_000">
		<language name="JPN">さいこうの　かがくりょくで
うみだされた　じんこうの　ポケモン。
でんしくうかんを　いどうできる。</language>
		<language name="JPN_KANJI">最高の　科学力で
生み出された　人工の　ポケモン。
電子空間を　移動できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_138_000">
		<language name="JPN">げんだいの　すぐれた　かがくりょくで
かせきから　ふっかつした　ポケモン。
こだいの　うみを　およいでいた。</language>
		<language name="JPN_KANJI">現代の　優れた　科学力で
化石から　復活した　ポケモン。
古代の　海を　泳いでいた。</language>
	</row>

	<row id="ZKN_COMMENT_01_139_000">
		<language name="JPN">らせんじょうの　カラが　おおきく
なりすぎたことが　げんいんで
ぜつめつしたと　かんがえられている。</language>
		<language name="JPN_KANJI">らせん状の　殻が　大きく
なりすぎたことが　原因で
絶滅したと　考えられている。</language>
	</row>

	<row id="ZKN_COMMENT_01_140_000">
		<language name="JPN">３おくねんまえの　すなはまで
くらしていたと　かんがえられている。
かたい　カラが　みを　まもる。</language>
		<language name="JPN_KANJI">３億年前の　砂浜で
暮らしていたと　考えられている。
硬い　殻が　身を　守る。</language>
	</row>

	<row id="ZKN_COMMENT_01_141_000">
		<language name="JPN">えものが　りくじょうせいかつを
はじめたため　カブトプスも　りくに
あがったと　かんがえられている。</language>
		<language name="JPN_KANJI">獲物が　陸上生活を　はじめたため
カブトプスも　陸に　上がったと
考えられている。</language>
	</row>

	<row id="ZKN_COMMENT_01_142_000">
		<language name="JPN">きょうりゅうじだいの　おおぞらを
とびまわっていた　ポケモン。
のこぎりのような　キバを　もつ。</language>
		<language name="JPN_KANJI">恐竜時代の　大空を
飛び回っていた　ポケモン。
ノコギリのような　キバを　持つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_143_000">
		<language name="JPN">まんぷくになると　ゆびすら
うごかすのが　めんどうに　なるので
おなかに　のっても　だいじょうぶ。</language>
		<language name="JPN_KANJI">満腹になると　指すら
動かすのが　面倒に　なるので
お腹に　乗っても　大丈夫。</language>
	</row>

	<row id="ZKN_COMMENT_01_144_000">
		<language name="JPN">でんせつの　とりポケモン。
くうきちゅうの　すいぶんを　こおらせ
ふぶきを　つくりだすことが　できる。</language>
		<language name="JPN_KANJI">伝説の　とりポケモン。
空気中の　水分を　凍らせ
吹雪を　作り出すことが　できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_145_000">
		<language name="JPN">かみなりぐもの　なかに　いると
いわれる　でんせつの　ポケモン。
カミナリを　じざいに　あやつる。</language>
		<language name="JPN_KANJI">雷雲の　中に　いると
言われる　伝説の　ポケモン。
雷を　自在に　操る。</language>
	</row>

	<row id="ZKN_COMMENT_01_146_000">
		<language name="JPN">でんせつの　とりポケモンの　１ぴき。
ファイヤーが　すがたを　みせると
はるが　おとずれると　いわれている。</language>
		<language name="JPN_KANJI">伝説の　とりポケモンの　１匹。
ファイヤーが　姿を　見せると
春が　訪れると　言われている。</language>
	</row>

	<row id="ZKN_COMMENT_01_147_000">
		<language name="JPN">もくげきしゃが　すくないために
まぼろしのポケモンと　よばれていた。
だっぴした　かわが　みつかっている。</language>
		<language name="JPN_KANJI">目撃者が　少ないために
幻のポケモンと　呼ばれていた。
脱皮した　皮が　見つかっている。</language>
	</row>

	<row id="ZKN_COMMENT_01_148_000">
		<language name="JPN">ぜんしんが　オーラに　つつまれるとき
まわりの　てんきが　いっぺんする。
うみや　みずうみに　すむという。</language>
		<language name="JPN_KANJI">全身が　オーラに　包まれるとき
まわりの　天気が　一変する。
海や　湖に　住むという。</language>
	</row>

	<row id="ZKN_COMMENT_01_149_000">
		<language name="JPN">ひろい　うみの　どこかに　すみかが
あると　いわれている。なんぱした
ふねを　りくまで　みちびいてくれる。</language>
		<language name="JPN_KANJI">広い　海の　どこかに　住処が
あると　言われている。難破した
船を　陸まで　導いてくれる。</language>
	</row>

	<row id="ZKN_COMMENT_01_150_000">
		<language name="JPN">ミュウの　いでんしを　くみかえて
うみだされた。ポケモンで　いちばん
きょうぼうな　こころを　もつという。</language>
		<language name="JPN_KANJI">ミュウの　遺伝子を　組み替えて
生み出された。ポケモンで　一番
凶暴な　心を　持つという。</language>
	</row>

	<row id="ZKN_COMMENT_01_151_000">
		<language name="JPN">あらゆる　わざを　つかうため
ポケモンの　せんぞと　かんがえる
がくしゃが　たくさん　いる。</language>
		<language name="JPN_KANJI">あらゆる　技を　使うため
ポケモンの　先祖と　考える
学者が　たくさん　いる。</language>
	</row>

	<row id="ZKN_COMMENT_01_152_000">
		<language name="JPN">あたまの　はっぱで　まわりの
おんどや　しつどを　さぐる。
ひざしを　あびることが　だいすき。</language>
		<language name="JPN_KANJI">頭の　葉っぱで　まわりの
温度や　湿度を　探る。
日差しを　浴びることが　大好き。</language>
	</row>

	<row id="ZKN_COMMENT_01_153_000">
		<language name="JPN">くびまわりの　つぼみから　におう
スパイシーな　かおりは
かいだ　ひとを　げんきに　させる。</language>
		<language name="JPN_KANJI">首回りの　つぼみから　におう
スパイシーな　香りは
かいだ　人を　元気に　させる。</language>
	</row>

	<row id="ZKN_COMMENT_01_154_000">
		<language name="JPN">メガニウムが　はきだす　いきには
かれた　くさばなを　よみがえらせる
ふしぎな　ちからが　ひめられている。</language>
		<language name="JPN_KANJI">メガニウムが　吐き出す　息には
枯れた　草花を　よみがえらせる
不思議な　力が　秘められている。</language>
	</row>

	<row id="ZKN_COMMENT_01_155_000">
		<language name="JPN">おくびょうな　せいかく。
おどろくと　せなかの　ほのおが
いちだんと　つよく　もえあがる。</language>
		<language name="JPN_KANJI">おくびょうな　性格。
驚くと　背中の　炎が
一段と　強く　燃え上がる。</language>
	</row>

	<row id="ZKN_COMMENT_01_156_000">
		<language name="JPN">ほのおの　ねつで　あいてを　いかく。
たたかう　たいせいになると
ほのおの　いきおいが　ます。</language>
		<language name="JPN_KANJI">炎の　熱で　相手を　威嚇。
戦う　体勢になると
炎の　勢いが　増す。</language>
	</row>

	<row id="ZKN_COMMENT_01_157_000">
		<language name="JPN">ほのおの　ばくふうで　こうげき。
しゃくねつの　ほのおで　かげろうを
つくりだし　すがたを　かくす。</language>
		<language name="JPN_KANJI">炎の　爆風で　攻撃。
しゃく熱の　炎で　陽炎を
作り出し　姿を　隠す。</language>
	</row>

	<row id="ZKN_COMMENT_01_158_000">
		<language name="JPN">はったつした　あごを　もち
なんにでも　かみつく　しゅうせい。
トレーナーも　ちゅういが　ひつよう。</language>
		<language name="JPN_KANJI">発達した　アゴを　持ち
なんにでも　かみつく　習性。
トレーナーも　注意が　必要。</language>
	</row>

	<row id="ZKN_COMMENT_01_159_000">
		<language name="JPN">いちど　かみつくと　キバが
ぬけるまで　ぜったいに　はなさない。
ぬけた　キバは　すぐに　はえてくる。</language>
		<language name="JPN_KANJI">一度　かみつくと　キバが
抜けるまで　絶対に　離さない。
抜けた　キバは　すぐに　生えてくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_160_000">
		<language name="JPN">ふだんは　ゆっくりとした　うごきだが
えものに　かみつくときは
めにも　とまらない　スピードだ。</language>
		<language name="JPN_KANJI">普段は　ゆっくりとした　動きだが
獲物に　かみつくときは
目にも　止まらない　スピードだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_161_000">
		<language name="JPN">とても　しんけいしつな　せいかく。
とおくまで　みわたせるように
しっぽを　つかって　せのびをする。</language>
		<language name="JPN_KANJI">とても　神経質な　性格。
遠くまで　見渡せるように
しっぽを　使って　背伸びをする。</language>
	</row>

	<row id="ZKN_COMMENT_01_162_000">
		<language name="JPN">ははおやは　ほそながい　からだで
こどもを　つつみこみ　ねむらせる。
はやい　うごきで　てきを　おいこむ。</language>
		<language name="JPN_KANJI">母親は　細長い　体で
子供を　包み込み　眠らせる。
早い　動きで　敵を　追い込む。</language>
	</row>

	<row id="ZKN_COMMENT_01_163_000">
		<language name="JPN">せいかくに　ときを　つげることから
せかいの　ことわりを　わきまえた
ちえのかみさま　とする　くにもある。</language>
		<language name="JPN_KANJI">正確に　時を　告げることから
世界の　ことわりを　わきまえた
知恵の神様　とする　国もある。</language>
	</row>

	<row id="ZKN_COMMENT_01_164_000">
		<language name="JPN">とくしゅな　つくりの　りょうめは
わずかな　ひかりさえ　あれば
くらやみでも　ひるのように　みえる。</language>
		<language name="JPN_KANJI">特殊な　作りの　両目は
わずかな　光さえ　あれば
くらやみでも　昼のように　見える。</language>
	</row>

	<row id="ZKN_COMMENT_01_165_000">
		<language name="JPN">むれを　つくらないと　ふあんで
うごけなくなるほど　おくびょう。
においで　きもちを　つたえあう。</language>
		<language name="JPN_KANJI">群れを　作らないと　不安で
動けなくなるほど　おくびょう。
においで　気持ちを　伝え合う。</language>
	</row>

	<row id="ZKN_COMMENT_01_166_000">
		<language name="JPN">ほしあかりを　エネルギーにする。
よぞらの　ほしの　かずが　ふえると
せなかの　もようが　おおきくなる。</language>
		<language name="JPN_KANJI">星明りを　エネルギーにする。
夜空の　星の　数が　増えると
背中の　模様が　大きくなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_167_000">
		<language name="JPN">ほそくて　じょうぶな　いとを
はりめぐらして　わなを　しかける。
えものが　かかるまで　じっと　まつ。</language>
		<language name="JPN_KANJI">細くて　丈夫な　糸を
張り巡らして　ワナを　仕掛ける。
獲物が　かかるまで　じっと　待つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_168_000">
		<language name="JPN">えものの　からだに　いとを　つけて
わざと　にがす。いとを　たどれば
なかまごと　つかまえられるからだ。</language>
		<language name="JPN_KANJI">獲物の　体に　糸を　つけて
わざと　逃がす。糸を　たどれば
仲間ごと　捕まえられるからだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_169_000">
		<language name="JPN">４まいに　ふえた　はねを　つかい
さらに　はやく　しずかに　とんで
えものに　きづかれず　しのびよる。</language>
		<language name="JPN_KANJI">４枚に　増えた　羽を　使い
さらに　速く　静かに　飛んで
獲物に　気づかれず　忍びよる。</language>
	</row>

	<row id="ZKN_COMMENT_01_170_000">
		<language name="JPN">プラスと　マイナスの　でんきを
しょくしゅの　さきから　ながす。
てきを　かんでんさせてしまうのだ。</language>
		<language name="JPN_KANJI">プラスと　マイナスの　電気を
触手の　先から　流す。
敵を　感電させてしまうのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_171_000">
		<language name="JPN">しんかいを　およぐ　ランターンの
あかりは　すいめんまで　とどく。
しんかいのほし　と　よばれている。</language>
		<language name="JPN_KANJI">深海を　泳ぐ　ランターンの
明かりは　水面まで　届く。
深海の星　と　呼ばれている。</language>
	</row>

	<row id="ZKN_COMMENT_01_172_000">
		<language name="JPN">ほほの　でんきぶくろは　ちいさく
ちょっとでも　でんきが　あふれると
じぶんじしんが　しびれてしまう。</language>
		<language name="JPN_KANJI">ほほの　電気袋は　小さく
ちょっとでも　電気が　あふれると
自分自身が　しびれてしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_173_000">
		<language name="JPN">ピィを　よく　みかける　ばしょは
ながれぼしが　おちた　ばしょと
じもとでは　うわさ　されている。</language>
		<language name="JPN_KANJI">ピィを　よく　みかける　場所は
流れ星が　落ちた　場所と
地元では　うわさ　されている。</language>
	</row>

	<row id="ZKN_COMMENT_01_174_000">
		<language name="JPN">ほんのり　あまい　かおりが　して
よく　はずむ　やわらかい　からだは
いちど　はずみだすと　とまらない。</language>
		<language name="JPN_KANJI">ほんのり　甘い　香りが　して
よく　弾む　柔らかい　体は
一度　弾みだすと　止まらない。</language>
	</row>

	<row id="ZKN_COMMENT_01_175_000">
		<language name="JPN">みんなの　かんじた　やさしさや
うれしさを　しあわせに　かえている。
カラのなかは　しあわせ　ばかりだ。</language>
		<language name="JPN_KANJI">みんなの　感じた　優しさや
うれしさを　幸せに　変えている。
殻の中は　幸せ　ばかりだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_176_000">
		<language name="JPN">しあわせを　わけあたえるため
こころやさしい　ひとを　さがしもとめ
せかいじゅうを　とびまわっている。</language>
		<language name="JPN_KANJI">幸せを　分け与えるため
心優しい　人を　捜し求め
世界中を　飛び回っている。</language>
	</row>

	<row id="ZKN_COMMENT_01_177_000">
		<language name="JPN">サボテンの　つぼみや　トゲを
きように　よけながら　ついばむ。
とびはねるようにして　いどうする。</language>
		<language name="JPN_KANJI">サボテンの　つぼみや　トゲを
器用に　避けながら　ついばむ。
飛び跳ねるようにして　移動する。</language>
	</row>

	<row id="ZKN_COMMENT_01_178_000">
		<language name="JPN">かこと　みらいを　みとおせる。
まいにち　たいようの　うごきを
みつづけている　ふしぎな　ポケモン。</language>
		<language name="JPN_KANJI">過去と　未来を　見通せる。
毎日　太陽の　動きを　見続けている
不思議な　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_179_000">
		<language name="JPN">さむくなり　せいでんきが　たまると
たいもうが　２ばいに　ふくれあがり
しっぽの　さきが　ほんのり　ひかる。</language>
		<language name="JPN_KANJI">寒くなり　静電気が　たまると
体毛が　２倍に　ふくれあがり
しっぽの　先が　ほんのり　光る。</language>
	</row>

	<row id="ZKN_COMMENT_01_180_000">
		<language name="JPN">うぶげすら　はえなくなった　ぶぶんの
ひふは　ゴムのように　でんきを　
さえぎるので　じぶんは　しびれない。</language>
		<language name="JPN_KANJI">産毛すら　はえなくなった　部分の
皮膚は　ゴムのように　電気を　
さえぎるので　自分は　しびれない。</language>
	</row>

	<row id="ZKN_COMMENT_01_181_000">
		<language name="JPN">しっぽの　さきは　まぶしく　ひかり
とおく　はなれた　がいこくまで
とどき　うみのみちしるべ　となる。</language>
		<language name="JPN_KANJI">しっぽの　先は　まぶしく　光り
遠く　離れた　外国まで
届き　海の道標　となる。</language>
	</row>

	<row id="ZKN_COMMENT_01_182_000">
		<language name="JPN">おおあめの　きせつが　おわると
あたたかい　ひざしに　さそわれた
キレイハナが　おどりはじめる。</language>
		<language name="JPN_KANJI">大雨の　季節が　終わると
暖かい　日差しに　誘われた
キレイハナが　踊りはじめる。</language>
	</row>

	<row id="ZKN_COMMENT_01_183_000">
		<language name="JPN">あぶらが　つまっている　しっぽが
うきぶくろの　かわりと　なるので
ながれの　はやい　かわも　へいき。</language>
		<language name="JPN_KANJI">脂が　詰まっている　しっぽが
浮き袋の　代わりと　なるので
流れの　速い　川も　平気。</language>
	</row>

	<row id="ZKN_COMMENT_01_184_000">
		<language name="JPN">ながい　みみは　すぐれた　センサー。
みずのなかの　おとを　ききわけて
なにが　うごいているのか　わかる。</language>
		<language name="JPN_KANJI">長い　耳は　優れた　センサー。
水の中の　音を　ききわけて
なにが　動いているのか　わかる。</language>
	</row>

	<row id="ZKN_COMMENT_01_185_000">
		<language name="JPN">こうげき　されないように　ひたすら
きのまねをしているが　みずはにがてで
あめになると　どこかに　にげだす。</language>
		<language name="JPN_KANJI">攻撃　されないように　ひたすら
木のマネをしているが　水は苦手で
雨になると　どこかに　逃げ出す。</language>
	</row>

	<row id="ZKN_COMMENT_01_186_000">
		<language name="JPN">ニョロトノを　リーダーに　グループが
つくられる。ニョロトノの　なきごえが
ニョロモたちを　したがわせる。</language>
		<language name="JPN_KANJI">ニョロトノを　リーダーに　グループが
作られる。ニョロトノの　鳴き声が
ニョロモたちを　従わせる。</language>
	</row>

	<row id="ZKN_COMMENT_01_187_000">
		<language name="JPN">かぜに　ながされて　ただよう。
のやまに　ハネッコが　あつまりだすと
はるが　おとずれると　いわれている。</language>
		<language name="JPN_KANJI">風に　流されて　漂う。
野山に　ハネッコが　集まりだすと
春が　訪れると　言われている。</language>
	</row>

	<row id="ZKN_COMMENT_01_188_000">
		<language name="JPN">きおんが　たかくなると　はなひらく。
そらに　うかんで　ひざしを
いっぱい　あびようとする。</language>
		<language name="JPN_KANJI">気温が　高くなると　花開く。
空に　浮かんで　日差しを
いっぱい　浴びようとする。</language>
	</row>

	<row id="ZKN_COMMENT_01_189_000">
		<language name="JPN">きせつふうに　ながされて
せかいを　いっしゅうしてしまう。
とちゅうで　わたほうしを　ばらまく。</language>
		<language name="JPN_KANJI">季節風に　流されて
世界を　１周してしまう。
途中で　綿胞子を　ばらまく。</language>
	</row>

	<row id="ZKN_COMMENT_01_190_000">
		<language name="JPN">てよりも　じゆうじざいに　うごく
しっぽを　たくみに　あやつりながら
たかい　きのうえで　くらしている。</language>
		<language name="JPN_KANJI">手よりも　自由自在に　動く
しっぽを　巧みに　操りながら
高い　木の上で　暮らしている。</language>
	</row>

	<row id="ZKN_COMMENT_01_191_000">
		<language name="JPN">ある　あさ　とつぜん　ふってくる。
よわいのを　しっており　しんかまで
ひたすら　えいようを　ためこむ。</language>
		<language name="JPN_KANJI">ある　朝　突然　降ってくる。
弱いのを　知っており　進化まで
ひたすら　栄養を　ためこむ。</language>
	</row>

	<row id="ZKN_COMMENT_01_192_000">
		<language name="JPN">あびた　ひざしを　エネルギーに
へんかん　するため　ひるまは　ずっと
たいようの　ほうを　むいている。</language>
		<language name="JPN_KANJI">浴びた　日差しを　エネルギーに
変換　するため　昼間は　ずっと
太陽の　方を　向いている。</language>
	</row>

	<row id="ZKN_COMMENT_01_193_000">
		<language name="JPN">こうそくで　はばたくことで
くうちゅうを　じゆうじざいに　とぶ。
きゅうていし　だって　へっちゃら。</language>
		<language name="JPN_KANJI">高速で　羽ばたくことで
空中を　自由自在に　飛ぶ。
急停止　だって　へっちゃら。</language>
	</row>

	<row id="ZKN_COMMENT_01_194_000">
		<language name="JPN">ちじょうを　あるくときは　ひふが
かんそう　しないように　どくの
ねんまくで　からだを　おおっている。</language>
		<language name="JPN_KANJI">地上を　歩くときは　皮膚が
乾燥　しないように　毒の　粘膜で
体を　おおっている。</language>
	</row>

	<row id="ZKN_COMMENT_01_195_000">
		<language name="JPN">ふなぞこや　かわのいわに　あたまを
ぶつけまくっても　きにせず　きままに
およいでいる　のんきな　ポケモン。</language>
		<language name="JPN_KANJI">船底や　川の岩に　頭を
ぶつけまくっても　気にせず　気ままに
泳いでいる　のんきな　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_196_000">
		<language name="JPN">ぜんしんの　こまやかな　たいもうで
くうきの　ながれを　かんじて　てきの
かんがえや　てんこうを　よそくする。</language>
		<language name="JPN_KANJI">全身の　細やかな　体毛で
空気の　流れを　感じて　敵の
考えや　天候を　予測する。</language>
	</row>

	<row id="ZKN_COMMENT_01_197_000">
		<language name="JPN">つきの　はどうを　あびると
ぜんしんの　わっかもようが　ひかり
ふしぎな　ちからに　あふれるのだ。</language>
		<language name="JPN_KANJI">月の　波動を　浴びると
全身の　輪っか模様が　光り
不思議な　力に　あふれるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_198_000">
		<language name="JPN">ヤミカラスを　みかけて　ふよういに
あとを　つけていくと　まよわされ
やまみちに　おいてけぼりに　される。</language>
		<language name="JPN_KANJI">ヤミカラスを　見かけて　不用意に
後を　つけていくと　迷わされ
山道に　置いてけぼりに　される。</language>
	</row>

	<row id="ZKN_COMMENT_01_199_000">
		<language name="JPN">シェルダーに　かまれたことによって
ノーベルしょうを　じゅしょうした
かがくしゃなみの　ちのうを　えた。</language>
		<language name="JPN_KANJI">シェルダーに　かまれたことによって
ノーベル賞を　受賞した　科学者並の
知能を　得た。</language>
	</row>

	<row id="ZKN_COMMENT_01_200_000">
		<language name="JPN">まよなか　ひとを　おどろかせては
こわがるこころを　あつめて　じぶんの
エネルギーに　している　ポケモン。</language>
		<language name="JPN_KANJI">真夜中　人を　驚かせては
怖がる心を　集めて　自分の
エネルギーに　している　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_201_000">
		<language name="JPN">１ぴきで　いても　なにも　おきないが
２ひき　いじょうで　ならぶと
なにかの　ちからが　めばえるという。</language>
		<language name="JPN_KANJI">１匹で　いても　なにも　起きないが
２匹　以上で　並ぶと
なにかの　力が　芽生えるという。</language>
	</row>

	<row id="ZKN_COMMENT_01_202_000">
		<language name="JPN">くろい　しっぽを　ひっしになって
かくすのは　しっぽに　ひみつがある
しょうこだと　かんぐられている。</language>
		<language name="JPN_KANJI">黒い　しっぽを　必死になって
隠すのは　しっぽに　秘密がある
証拠だと　勘ぐられている。</language>
	</row>

	<row id="ZKN_COMMENT_01_203_000">
		<language name="JPN">しっぽの　あたまにも　ちいさな
のうがあり　うしろを　むいたままでも
ほんのうで　たたかうことが　できる。</language>
		<language name="JPN_KANJI">しっぽの　頭にも　小さな
脳があり　後ろを　向いたままでも
本能で　戦うことが　できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_204_000">
		<language name="JPN">きのみに　そっくり。まちがわれて
とりポケモンに　つつかれてしまうが
かたい　カラで　まもられている。</language>
		<language name="JPN_KANJI">木の実に　そっくり。間違われて
とりポケモンに　つつかれてしまうが
硬い　殻で　守られている。</language>
	</row>

	<row id="ZKN_COMMENT_01_205_000">
		<language name="JPN">こうてつの　カラで　まもられている。
すきまから　めだまが　のぞいているが
なかみの　しょうたいは　なぞのまま。</language>
		<language name="JPN_KANJI">鋼鉄の　殻で　守られている。
すきまから　目玉が　のぞいているが
中身の　正体は　ナゾのまま。</language>
	</row>

	<row id="ZKN_COMMENT_01_206_000">
		<language name="JPN">くらいばしょに　めいろを　つくる。
だれかに　みられると　しっぽで
じめんを　ほって　にげようとする。</language>
		<language name="JPN_KANJI">暗い場所に　迷路を　つくる。
だれかに　みられると　しっぽで
地面を　掘って　逃げようとする。</language>
	</row>

	<row id="ZKN_COMMENT_01_207_000">
		<language name="JPN">ねらった　えものに　はりついて
おどろきとまどっている　あいだに
しっぽの　トゲを　さしこんでくる。</language>
		<language name="JPN_KANJI">ねらった　獲物に　はりついて
驚き戸惑っている　あいだに
しっぽの　トゲを　刺しこんでくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_208_000">
		<language name="JPN">つちと　いっしょに　のみこんだ
はがねが　からだを　へんかさせて
ダイヤモンドより　かたくなった。</language>
		<language name="JPN_KANJI">土と　一緒に　飲みこんだ
鋼が　体を　変化させて
ダイヤモンドより　固くなった。</language>
	</row>

	<row id="ZKN_COMMENT_01_209_000">
		<language name="JPN">ちいさな　ポケモンが　にげだすほどの
こわいかおが　ぎゃくに　かわいいと
じょせいに　にんきの　ポケモン。</language>
		<language name="JPN_KANJI">小さな　ポケモンが　逃げ出すほどの
怖い顔が　逆に　かわいいと
女性に　人気の　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_210_000">
		<language name="JPN">かおに　にあわず　おくびょう。
しかし　ひとたび　おこりはじめると
おおきな　キバで　はんげきする。</language>
		<language name="JPN_KANJI">顔に　似合わず　おくびょう。
しかし　ひとたび　怒りはじめると
大きな　キバで　反撃する。</language>
	</row>

	<row id="ZKN_COMMENT_01_211_000">
		<language name="JPN">ぜんしんの　どくバリを
しほうはっぽうに　うちだす。
まるい　からだは　およぎが　にがて。</language>
		<language name="JPN_KANJI">全身の　毒針を
四方八方に　撃ち出す。
丸い　体は　泳ぎが　苦手。</language>
	</row>

	<row id="ZKN_COMMENT_01_212_000">
		<language name="JPN">めだまもようの　ついた　はさみを
ふりあげて　いかくする　だけでなく
そのまま　ふりおろすので　きけんだ。</language>
		<language name="JPN_KANJI">目玉模様の　ついた　ハサミを
振り上げて　威嚇する　だけでなく
そのまま　振り下ろすので　危険だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_213_000">
		<language name="JPN">ツボのような　こうらの　なかに
ためこんだ　きのみは　いつのまか
ドロドロの　ジュースに　かわる。</language>
		<language name="JPN_KANJI">ツボのような　甲羅の　中に
ためこんだ　きのみは　いつのまか
ドロドロの　ジュースに　変わる。</language>
	</row>

	<row id="ZKN_COMMENT_01_214_000">
		<language name="JPN">どんなに　おもい　あいてでも
じまんの　ツノを　つかい　じめんごと
とおくまで　ほうりなげてしまう。</language>
		<language name="JPN_KANJI">どんなに　重い　相手でも
自慢の　ツノを　使い　地面ごと
遠くまで　放り投げてしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_215_000">
		<language name="JPN">ずるがしこい　ポケモンで　ゆびに
かくした　ながい　ツメを　いきなり
のばして　あいてを　ひるませる。</language>
		<language name="JPN_KANJI">ずるがしこい　ポケモンで　指に
隠した　長い　ツメを　いきなり
伸ばして　相手を　ひるませる。</language>
	</row>

	<row id="ZKN_COMMENT_01_216_000">
		<language name="JPN">あまい　ミツを　てのひらに
しみこませて　いつも　なめている。
ヒメグマによって　あじが　ちがう。</language>
		<language name="JPN_KANJI">甘い　ミツを　手のひらに
染み込ませて　いつも　なめている。
ヒメグマによって　味が　違う。</language>
	</row>

	<row id="ZKN_COMMENT_01_217_000">
		<language name="JPN">なわばりにある　おいしい　きのみや
くだものの　なる　き　には
ツメで　きずあとを　つける。</language>
		<language name="JPN_KANJI">縄張りにある　おいしい　木の実や
果物の　なる　木　には
ツメで　傷跡を　つける。</language>
	</row>

	<row id="ZKN_COMMENT_01_218_000">
		<language name="JPN">ようがんで　できた　からだを　もつ。
たえず　うごいていないと　からだが
ひえて　かたまってしまうのだ。</language>
		<language name="JPN_KANJI">溶岩で　できた　体を　持つ。
絶えず　動いていないと　体が
冷えて　固まってしまうのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_219_000">
		<language name="JPN">たいおんは　やく１まんど。
マグマが　かたまって　できた　カラの
すきまから　ほのおを　ふきだす。</language>
		<language name="JPN_KANJI">体温は　約１万度。
マグマが　固まって　できた　殻の
すきまから　炎を　吹き出す。</language>
	</row>

	<row id="ZKN_COMMENT_01_220_000">
		<language name="JPN">はなさきを　こすりあわせ　じめんを
ほりながら　エサを　さがしている。
たまに　おんせんを　ほりあてる。</language>
		<language name="JPN_KANJI">鼻先を　こすりあわせ　地面を
掘りながら　エサを　探している。
たまに　温泉を　掘り当てる。</language>
	</row>

	<row id="ZKN_COMMENT_01_221_000">
		<language name="JPN">きゅうかくに　すぐれ　こおっている
じめんの　したに　うもれた
キノコだって　さがしだすのだ。</language>
		<language name="JPN_KANJI">きゅう覚に　優れ　凍っている
地面の　下に　埋もれた
キノコだって　探しだすのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_222_000">
		<language name="JPN">みなみの　きれいな　うみをこのむ。
よごれた　うみだと　サンゴの　えだは
いろがくすみ　ボロボロになるのだ。</language>
		<language name="JPN_KANJI">南の　きれいな　海を好む。
汚れた　海だと　サンゴの　枝は
色がくすみ　ボロボロになるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_223_000">
		<language name="JPN">くちから　ふきだす　すいりゅうは
１００メートルさきで　うごく
えものに　だって　めいちゅうする。</language>
		<language name="JPN_KANJI">口から　吹きだす　水流は
１００メートル先で　動く
獲物に　だって　命中する。</language>
	</row>

	<row id="ZKN_COMMENT_01_224_000">
		<language name="JPN">あなに　はいりたがる　せいしつで
いわあなや　ツボを　このみ　そこから
スミを　ふきだして　こうげきする。</language>
		<language name="JPN_KANJI">穴に　入りたがる　性質で
岩穴や　ツボを　好み　そこから
スミを　吹きだして　攻撃する。</language>
	</row>

	<row id="ZKN_COMMENT_01_225_000">
		<language name="JPN">１にちじゅう　エサを　はこぶ。
やまで　そうなんした　ひとがいると
エサを　わけあたえ　たすけている。</language>
		<language name="JPN_KANJI">１日中　エサを　運ぶ。
山で　遭難した　人がいると
エサを　わけあたえ　助けている。</language>
	</row>

	<row id="ZKN_COMMENT_01_226_000">
		<language name="JPN">およいで　スピードが　のってくると
なみのうえに　とびだし　そのまま
１００メートルも　かっくう　する。</language>
		<language name="JPN_KANJI">泳いで　スピードが　のってくると
波の上に　飛びだし　そのまま
１００メートルも　滑空　する。</language>
	</row>

	<row id="ZKN_COMMENT_01_227_000">
		<language name="JPN">がんじょうで　おもそうな　てつの
からだだが　うすくて　かるいので
じそく３００キロで　とべる。</language>
		<language name="JPN_KANJI">頑丈で　重そうな　鉄の
体だが　薄くて　軽いので
時速３００キロで　とべる。</language>
	</row>

	<row id="ZKN_COMMENT_01_228_000">
		<language name="JPN">さまざまな　なきごえを　つかいわけ
なかまと　コミュニケーションしながら
かりを　おこなう　かしこさをもつ。</language>
		<language name="JPN_KANJI">様々な　鳴き声を　使い分け
仲間と　コミュニケーションしながら
狩りを　おこなう　賢さを持つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_229_000">
		<language name="JPN">おこったときに　くちから　ふきだす
ほのおには　どくそも　まじっていて
やけどになると　いつまでも　うずく。</language>
		<language name="JPN_KANJI">怒ったときに　口から　吹き出す
炎には　毒素も　混じっていて
やけどになると　いつまでも　うずく。</language>
	</row>

	<row id="ZKN_COMMENT_01_230_000">
		<language name="JPN">かいていどうくつに　すんでいる。
キングドラが　みうごきすると
きょだいな　うずしおが　うまれる。</language>
		<language name="JPN_KANJI">海底洞くつに　住んでいる。
キングドラが　身動きすると
巨大な　渦潮が　生まれる。</language>
	</row>

	<row id="ZKN_COMMENT_01_231_000">
		<language name="JPN">からだは　ちいさいが　ちからもち。
おとなの　ひとを　かるがると
せなかに　のせて　あるいてしまう。</language>
		<language name="JPN_KANJI">体は　小さいが　力持ち。
大人の　人を　軽々と
背中に　乗せて　歩いてしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_232_000">
		<language name="JPN">からだを　まるめて　かいてんしながら
とっしんする　こうげき。いちげきで
みんかを　ばらばらに　ふきとばす。</language>
		<language name="JPN_KANJI">体を　丸めて　回転しながら
突進する　攻撃。一撃で　民家を
バラバラに　吹き飛ばす。</language>
	</row>

	<row id="ZKN_COMMENT_01_233_000">
		<language name="JPN">わくせい　かいはつが　できるように
バージョンアップ　されたのだが
まだまだ　むずかしかった　ようだ。</language>
		<language name="JPN_KANJI">惑星　開発が　できるように
バージョンアップ　されたのだが
まだまだ　難しかった　ようだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_234_000">
		<language name="JPN">ツノを　みつめていると　わっかの
ちゅうしんに　すいこまれそうな
ふしぎな　きぶんに　なってしまう。</language>
		<language name="JPN_KANJI">ツノを　見つめていると　輪っかの
中心に　吸い込まれそうな
不思議な　気分に　なってしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_235_000">
		<language name="JPN">しっぽを　ふでのように　つかって
なわばりに　マークを　えがく。
その　しゅるいは　５０００いじょう。</language>
		<language name="JPN_KANJI">しっぽを　筆のように　使って
縄張りを　マークで　描く。
その　種類は　５０００以上。</language>
	</row>

	<row id="ZKN_COMMENT_01_236_000">
		<language name="JPN">けんかっぱやいことで　ゆうめい。
じぶんよりも　おおきな　あいてに
いどみかかるので　きずが　たえない。</language>
		<language name="JPN_KANJI">ケンカっぱやいことで　有名。
自分よりも　大きな　相手に
挑みかかるので　傷が　絶えない。</language>
	</row>

	<row id="ZKN_COMMENT_01_237_000">
		<language name="JPN">コマのように　かいてんしながら
たたかう。えんしんりょくの　パワーで
はかいりょくは　１０ばいだ。</language>
		<language name="JPN_KANJI">コマのように　回転しながら　戦う。
遠心力の　パワーで
破壊力は　１０倍だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_238_000">
		<language name="JPN">なんでも　くちびるで　ふれてみて
たしかめる。すきな　ものも　きらいな
ものも　くちびるが　おぼえている。</language>
		<language name="JPN_KANJI">なんでも　唇で　触れてみて
確かめる。好きな　物も　嫌いな　物も
唇が　覚えている。</language>
	</row>

	<row id="ZKN_COMMENT_01_239_000">
		<language name="JPN">りょううでを　ぐるぐる　まわして
でんきを　はっせい　させると
ツノのあいだが　あおじろく　ひかる。</language>
		<language name="JPN_KANJI">両腕を　ぐるぐる　まわして
電気を　発生させると
ツノのあいだが　青白く　光る。</language>
	</row>

	<row id="ZKN_COMMENT_01_240_000">
		<language name="JPN">こがらだが　たいおんは　６００ど。
いきを　すったり　はいたりするたび　
くちと　はなから　ひのこが　もれる。</language>
		<language name="JPN_KANJI">小柄だが　体温は　６００度。
息を　吸ったり　吐いたりするたび　
口と　鼻から　火の粉が　漏れる。</language>
	</row>

	<row id="ZKN_COMMENT_01_241_000">
		<language name="JPN">ミルタンクの　ミルクを　のんで
そだった　こどもは　けんこうで
たくましい　おとなに　なるという。</language>
		<language name="JPN_KANJI">ミルタンクの　ミルクを　飲んで
育った　子供は　健康で
たくましい　大人に　なるという。</language>
	</row>

	<row id="ZKN_COMMENT_01_242_000">
		<language name="JPN">ハピナスの　うむ　タマゴには
しあわせが　つまっていて　ひとくち
たべると　だれでも　えがおになれる。</language>
		<language name="JPN_KANJI">ハピナスの　生む　タマゴには
幸せが　つまっていて　ひとくち
食べると　だれでも　笑顔になれる。</language>
	</row>

	<row id="ZKN_COMMENT_01_243_000">
		<language name="JPN">カミナリと　ともに　おちてきたと
いわれている。せなかの　あまぐもから
カミナリを　うちだすことが　できる。</language>
		<language name="JPN_KANJI">雷と　ともに　落ちてきたと
言われている。背中の　雨雲から
雷を　撃ち出すことが　できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_244_000">
		<language name="JPN">エンテイが　ほえると
せかいの　どこかの　かざんが
ふんかすると　いわれている。</language>
		<language name="JPN_KANJI">エンテイが　ほえると
世界の　どこかの　火山が
噴火すると　言われている。</language>
	</row>

	<row id="ZKN_COMMENT_01_245_000">
		<language name="JPN">せかいじゅうを　かけめぐり
よごれた　みずを　きよめている。
きたかぜと　ともに　はしりさる。</language>
		<language name="JPN_KANJI">世界中を　駆け巡り
汚れた　水を　清めている。
北風と　ともに　走り去る。</language>
	</row>

	<row id="ZKN_COMMENT_01_246_000">
		<language name="JPN">ちてい　おくふかくで　うまれる。
まわりの　つちを　たいらげると
ちじょうに　あらわれ　サナギになる。</language>
		<language name="JPN_KANJI">地底　奥深くで　生まれる。
周りの　土を　たいらげると
地上に　現われ　サナギになる。</language>
	</row>

	<row id="ZKN_COMMENT_01_247_000">
		<language name="JPN">たいないで　あっしゅく　させた
ガスを　いきおいよく　ふんしゅつさせ
とんで　あばれまわる　サナギだ。</language>
		<language name="JPN_KANJI">体内で　圧縮　させた
ガスを　勢いよく　噴出させ
飛んで　暴れまわる　サナギだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_248_000">
		<language name="JPN">じひびきを　ならしながら　あるくと
おおきな　やまでさえ　くずれ
まわりの　ちけいは　かわってしまう。</language>
		<language name="JPN_KANJI">地響きを　鳴らしながら　歩くと
大きな　山でさえ　崩れ
周りの　地形は　変わってしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_249_000">
		<language name="JPN">ふかい　かいこうの　そこで　ねむる。
ルギアが　はばたくと　４０にち
あらしが　つづくと　いわれている。</language>
		<language name="JPN_KANJI">深い　海溝の　底で　眠る。
ルギアが　羽ばたくと　４０日
あらしが　続くと　言われている。</language>
	</row>

	<row id="ZKN_COMMENT_01_250_000">
		<language name="JPN">なないろの　つばさを　もつ。
ホウオウを　みた　ものは　えいえんの
しあわせが　やくそくされるという。</language>
		<language name="JPN_KANJI">七色の　翼を　持つ。
ホウオウを　見た　者は
永遠の　幸せが　約束されるという。</language>
	</row>

	<row id="ZKN_COMMENT_01_251_000">
		<language name="JPN">じかんを　こえる　ちからを　つかう。
へいわな　じだいにだけ
すがたを　みせると　いわれている。</language>
		<language name="JPN_KANJI">時間を　越える　力を　使う。
平和な　時代にだけ
姿を　見せると　言われている。</language>
	</row>

	<row id="ZKN_COMMENT_01_252_000">
		<language name="JPN">あしの　うらには　ちいさな　トゲが
たくさん　ついているので　かべや
てんじょうを　あるくことが　できる。</language>
		<language name="JPN_KANJI">足の　裏には　小さな　トゲが
たくさん　ついているので
壁や　天井を　歩くことが　できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_253_000">
		<language name="JPN">みつりんに　せいそくする。
えだから　えだへ　とびうつりながら
いどうして　えものに　せっきんする。</language>
		<language name="JPN_KANJI">密林に　生息する。
枝から　枝へ　飛び移りながら
移動して　獲物に　接近する。</language>
	</row>

	<row id="ZKN_COMMENT_01_254_000">
		<language name="JPN">うでに　はえた　はっぱは　たいぼくも
すっぱり　きりたおす　きれあじ。
みつりんの　たたかいでは　むてき。</language>
		<language name="JPN_KANJI">腕に　生えた　葉っぱは　大木も
スッパリ　切り倒す　切れ味。
密林の　戦いでは　無敵。</language>
	</row>

	<row id="ZKN_COMMENT_01_255_000">
		<language name="JPN">たいないで　ほのおが　もえているので
だきしめると　とても　あたたかい。
１０００どの　ひのたまを　とばす。</language>
		<language name="JPN_KANJI">体内で　炎が　燃えているので
抱きしめると　とても　温かい。
１０００度の　火の玉を　飛ばす。</language>
	</row>

	<row id="ZKN_COMMENT_01_256_000">
		<language name="JPN">１びょうかんに　キックを　１０ぱつ
くりだす　あしわざの　もちぬし。
するどい　なきごえで　いかくする。</language>
		<language name="JPN_KANJI">１秒間に　キックを　１０発
繰り出す　足技の　持ち主。
鋭い　鳴き声で　威嚇する。</language>
	</row>

	<row id="ZKN_COMMENT_01_257_000">
		<language name="JPN">てくびから　ふきだした　ほのおで
こぶしを　つつみこんだ　パンチは
あいてを　くろこげに　してしまう。</language>
		<language name="JPN_KANJI">手首から　吹き出した　炎で
こぶしを　包み込んだ　パンチは
相手を　黒コゲに　してしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_258_000">
		<language name="JPN">あたまの　ひれで　みずの　ながれを
かんじて　まわりの　ようすを　しる。
いわを　もちあげる　ちからもち。</language>
		<language name="JPN_KANJI">頭の　ヒレで　水の　流れを
感じて　まわりの　様子を　知る。
岩を　持ち上げる　力持ち。</language>
	</row>

	<row id="ZKN_COMMENT_01_259_000">
		<language name="JPN">ぬかるんだ　あしばでも　しっかり
あるける　じょうぶな　あしこし。
どろに　からだを　うめて　ねむる。</language>
		<language name="JPN_KANJI">ぬかるんだ　足場でも　しっかり
歩ける　丈夫な　足腰。
泥に　体を　埋めて　眠る。</language>
	</row>

	<row id="ZKN_COMMENT_01_260_000">
		<language name="JPN">おおがたせんを　ひっぱって　およぐ
パワーの　もちぬし。ふとい　うでの
ひとふりで　あいてを　たたきのめす。</language>
		<language name="JPN_KANJI">大型船を　引っ張って　泳ぐ
パワーの　持ち主。太い　腕の
一振りで　相手を　たたきのめす。</language>
	</row>

	<row id="ZKN_COMMENT_01_261_000">
		<language name="JPN">しつこい　せいかくの　ポケモン。
めをつけた　えものが　ヘトヘトに
つかれるまで　おいかけまわす。</language>
		<language name="JPN_KANJI">しつこい　性格の　ポケモン。
目をつけた　獲物が　ヘトヘトに
疲れるまで　追いかけ回す。</language>
	</row>

	<row id="ZKN_COMMENT_01_262_000">
		<language name="JPN">むれで　えものを　おいつめる。
すぐれた　トレーナーの　めいれいには
ぜったいに　さからわない。</language>
		<language name="JPN_KANJI">群れで　獲物を　追いつめる。
優れた　トレーナーの　命令には
絶対に　逆らわない。</language>
	</row>

	<row id="ZKN_COMMENT_01_263_000">
		<language name="JPN">ジグザグに　あるいて　くさかげや
じめんに　うまっている　たからものを
みつけるのが　とくいな　ポケモン。</language>
		<language name="JPN_KANJI">ジグザグに　歩いて　草陰や
地面に　埋まっている　宝物を
見つけるのが　得意な　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_264_000">
		<language name="JPN">じそく１００キロで　えものに
おそいかかるが　まっすぐにしか
はしれないので　しっぱいも　おおい。</language>
		<language name="JPN_KANJI">時速１００キロで　獲物に
襲いかかるが　真っ直ぐにしか
走れないので　失敗も　多い。</language>
	</row>

	<row id="ZKN_COMMENT_01_265_000">
		<language name="JPN">とりポケモンに　よく　ねらわれるが
おしりの　トゲから　どくをだし
ひっしになって　ていこうする。</language>
		<language name="JPN_KANJI">とりポケモンに　よく　ねらわれるが
おしりの　トゲから　毒を出し
必死になって　抵抗する。</language>
	</row>

	<row id="ZKN_COMMENT_01_266_000">
		<language name="JPN">いとを　きのえだに　まきつけている。
いとについた　あまみずを　のみながら
しんかの　ときを　まっている。</language>
		<language name="JPN_KANJI">糸を　木の枝に　巻きつけている。
糸についた　雨水を　飲みながら
進化の　ときを　待っている。</language>
	</row>

	<row id="ZKN_COMMENT_01_267_000">
		<language name="JPN">みために　よらず　こうげきてきで
かふんあつめの　じゃまを　すると
ほそながい　くちを　つきさしてくる。</language>
		<language name="JPN_KANJI">見た目に　よらず　攻撃的で
花粉集めの　邪魔を　すると
細長い　口を　突き刺してくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_268_000">
		<language name="JPN">マユに　こもっている　あいだに
うけた　こうげきは　しんかしても
わすれずに　かならず　しかえしする。</language>
		<language name="JPN_KANJI">マユに　こもっている　あいだに
受けた　攻撃は　進化しても
忘れずに　かならず　仕返しする。</language>
	</row>

	<row id="ZKN_COMMENT_01_269_000">
		<language name="JPN">はばたくたびに　どくのこなが　まう。
よるの　あいだに　がいろじゅの
はっぱを　くいちらかすことも　ある。</language>
		<language name="JPN_KANJI">羽ばたくたびに　毒の粉が　舞う。
夜の　あいだ　街路樹の　葉っぱを
食い散らかすことも　ある。</language>
	</row>

	<row id="ZKN_COMMENT_01_270_000">
		<language name="JPN">みずくさに　そっくりな　ポケモン。
およげない　ポケモンを　はっぱに
のせて　むこうぎしまで　はこぶ。</language>
		<language name="JPN_KANJI">水草に　そっくりな　ポケモン。
泳げない　ポケモンを　葉っぱに
乗せて　向こう岸まで　運ぶ。</language>
	</row>

	<row id="ZKN_COMMENT_01_271_000">
		<language name="JPN">つりびとを　みつけると
すいちゅうから　つりいとを　ひっぱり
ジャマして　よろこぶ　いたずらもの。</language>
		<language name="JPN_KANJI">釣り人を　見つけると
水中から　釣り糸を　引っ張り
ジャマして　喜ぶ　いたずらもの。</language>
	</row>

	<row id="ZKN_COMMENT_01_272_000">
		<language name="JPN">ようきな　おんがくを　きくと
からだじゅうに　ちからが　みなぎり
おどらずには　いられなくなるのだ。</language>
		<language name="JPN_KANJI">陽気な　音楽を　聴くと
体中に　力が　みなぎり
踊らずには　いられなくなるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_273_000">
		<language name="JPN">えだに　ぶらさがっていると
きのみに　そっくり。ついばもうとした
ポケモンを　おどろかせて　よろこぶ。</language>
		<language name="JPN_KANJI">枝に　ぶらさがっていると
木の実に　そっくり。ついばもうとした
ポケモンを　驚かせて　喜ぶ。</language>
	</row>

	<row id="ZKN_COMMENT_01_274_000">
		<language name="JPN">コノハナが　かなでる　くさぶえの
ねいろは　ひとを　ふあんにさせる。
もりの　おくに　すんでいる。</language>
		<language name="JPN_KANJI">コノハナが　奏でる　草笛の　音色は
人を　不安にさせる。
森の　奥に　住んでいる。</language>
	</row>

	<row id="ZKN_COMMENT_01_275_000">
		<language name="JPN">はっぱの　うちわを　あおぐと
ふうそく３０メートルの　とっぷうが
まきおこり　みんかを　ふきとばす。</language>
		<language name="JPN_KANJI">葉っぱの　ウチワを　あおぐと
風速３０メートルの　突風が
巻き起こり　民家を　吹き飛ばす。</language>
	</row>

	<row id="ZKN_COMMENT_01_276_000">
		<language name="JPN">つよい　あいてにも　ゆうかんに
たちむかう　こんじょうの　もちぬし。
あたたかい　とちを　めざして　とぶ。</language>
		<language name="JPN_KANJI">強い　相手にも　勇敢に
立ち向かう　根性の　持ち主。
暖かい　土地を　目指して　飛ぶ。</language>
	</row>

	<row id="ZKN_COMMENT_01_277_000">
		<language name="JPN">じょうくうを　せんかいしながら
えものを　さがし　まっさかさまに
きゅうこうかして　つかまえる。</language>
		<language name="JPN_KANJI">上空を　旋回しながら
獲物を　探し　真っ逆さまに
急降下して　捕まえる。</language>
	</row>

	<row id="ZKN_COMMENT_01_278_000">
		<language name="JPN">きりたった　がけに　すを　つくり
うみかぜを　りようして　ひろいそらを
じょうしょうし　かっくう　するのだ。</language>
		<language name="JPN_KANJI">きりたった　がけに　巣を　作り
海風を　利用して　広い空を
上昇し　滑空　するのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_279_000">
		<language name="JPN">かいめん　すれすれを　とんで
おおきな　くちばしで　かいすいごと
エサを　すくいとって　はこぶのだ。</language>
		<language name="JPN_KANJI">海面　すれすれを　飛んで
大きな　くちばしで　海水ごと
エサを　すくいとって　運ぶのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_280_000">
		<language name="JPN">あかいツノで　ひとや　ポケモンの
あたたかな　きもちを　キャッチすると
ぜんしんが　ほのかに　あつくなる。</language>
		<language name="JPN_KANJI">赤いツノで　人や　ポケモンの
温かな　気持ちを　キャッチすると
全身が　ほのかに　熱くなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_281_000">
		<language name="JPN">トレーナーが　よろこぶと
キルリアに　エネルギーが　みちあふれ
たのしそうに　くるくると　おどる。</language>
		<language name="JPN_KANJI">トレーナーが　喜ぶと
キルリアに　エネルギーが　満ちあふれ
楽しそうに　くるくると　踊る。</language>
	</row>

	<row id="ZKN_COMMENT_01_282_000">
		<language name="JPN">トレーナーを　まもるためなら
サイコパワーを　つかいきり　ちいさな
ブラックホールを　つくりだす。</language>
		<language name="JPN_KANJI">トレーナーを　守るためなら
サイコパワーを　使いきり　小さな
ブラックホールを　作り出す。</language>
	</row>

	<row id="ZKN_COMMENT_01_283_000">
		<language name="JPN">すいめんを　すべるように　あるく。
あたまの　さきから　あまい　においを
だして　えものを　さそう。</language>
		<language name="JPN_KANJI">水面を　滑るように　歩く。
頭の　先から　甘い　においを
出して　獲物を　誘う。</language>
	</row>

	<row id="ZKN_COMMENT_01_284_000">
		<language name="JPN">めだまもようの　しょっかくを　もつ。
４まいの　はねで　うかびあがり
ぜんごさゆうに　うごくことができる。</language>
		<language name="JPN_KANJI">目玉模様の　触角を　持つ。
４枚の　ハネで　浮かび上がり
前後左右に　動くことができる。</language>
	</row>

	<row id="ZKN_COMMENT_01_285_000">
		<language name="JPN">あたまの　てっぺんから　どくほうしを
ふきだす。ほうしを　すいこむと
からだの　ふしぶしが　いたくなる。</language>
		<language name="JPN_KANJI">頭の　てっぺんから　毒胞子を
吹き出す。胞子を　吸い込むと
体の　節々が　痛くなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_286_000">
		<language name="JPN">みじかい　うでは　パンチを　だすとき
ぐーんと　のびる。プロボクサー
かおまけの　テクニックを　もつ。</language>
		<language name="JPN_KANJI">短い　腕は　パンチを　出すとき
グーンと　伸びる。プロボクサー
顔負けの　テクニックを　持つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_287_000">
		<language name="JPN">１にちに　はっぱを　３まいも
たべれば　まんぞくで　それいがいは
２０じかんも　ねむっている。</language>
		<language name="JPN_KANJI">１日に　はっぱを　３枚も
食べれば　満足で　それ以外は
２０時間も　眠っている。</language>
	</row>

	<row id="ZKN_COMMENT_01_288_000">
		<language name="JPN">しんぞうの　こどうが　はやく
ぜんしんの　ちが　たぎっているため
１びょうも　じっと　していられない。</language>
		<language name="JPN_KANJI">心臓の　鼓動が　速く
全身の　血が　たぎっているため
１秒も　じっと　していられない。</language>
	</row>

	<row id="ZKN_COMMENT_01_289_000">
		<language name="JPN">ねころがったまま　せいかつ　する。
まわりに　たべる　くさが　なくなると
ようやく　ねがえりをして　うごく。</language>
		<language name="JPN_KANJI">寝転がったまま　生活　する。
周りに　食べる　草が　なくなると
ようやく　寝返りをして　動く。</language>
	</row>

	<row id="ZKN_COMMENT_01_290_000">
		<language name="JPN">じめんの　したで　せいちょうする。
ほとんど　みえない　めの　かわりに
しょっかくで　ようすを　さぐる。</language>
		<language name="JPN_KANJI">地面の　下で　成長する。
ほとんど　見えない　目の　代わりに
触角で　様子を　探る。</language>
	</row>

	<row id="ZKN_COMMENT_01_291_000">
		<language name="JPN">あまりに　こうそくで　うごくため
すがたが　みえなくなる　ことがある。
じゅえきに　あつまってくる。</language>
		<language name="JPN_KANJI">あまりに　高速で　動くため
姿が　見えなくなる　ことがある。
樹液に　集まってくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_292_000">
		<language name="JPN">ぬけがらが　たましいを　やどした。
せなかの　すきまから　のぞきこむと
たましいを　すわれてしまうらしい。</language>
		<language name="JPN_KANJI">抜け殻が　魂を　宿した。
背中の　すきまから　のぞき込むと
魂を　吸われてしまうらしい。</language>
	</row>

	<row id="ZKN_COMMENT_01_293_000">
		<language name="JPN">ふだんは　ささやくような　なきごえ。
ふあんになると　ジェットきと　おなじ
おんりょうで　なきつづける。</language>
		<language name="JPN_KANJI">普段は　ささやくような　鳴き声。
不安になると　ジェット機と　同じ
音量で　鳴き続ける。</language>
	</row>

	<row id="ZKN_COMMENT_01_294_000">
		<language name="JPN">おおごえの　しょうげきはで
トラックを　ひっくりかえしてしまう。
あしを　ふみならして　パワーアップ。</language>
		<language name="JPN_KANJI">大声の　衝撃波で
トラックを　ひっくりかえしてしまう。
足を　踏みならして　パワーアップ。</language>
	</row>

	<row id="ZKN_COMMENT_01_295_000">
		<language name="JPN">バクオングの　とおぼえは　１０キロ
さきまで　とどく。からだじゅうの
あなから　さまざまな　おとを　だす。</language>
		<language name="JPN_KANJI">バグオングの　とおぼえは　１０キロ
先まで　届く。体中の　穴から
様々な　音を　出す。</language>
	</row>

	<row id="ZKN_COMMENT_01_296_000">
		<language name="JPN">ふとい　きのみきに　ぶつかって
からだを　きたえる。すみかの　そばは
へしおられた　きが　たくさんある。</language>
		<language name="JPN_KANJI">太い　木の幹に　ぶつかって
体を　鍛える。住処の　そばは
へし折られた　木が　たくさんある。</language>
	</row>

	<row id="ZKN_COMMENT_01_297_000">
		<language name="JPN">からだの　おおきな　ポケモンたちと
ちからくらべをすることが　だいすき。
はりてで　トラックを　ふっとばす。</language>
		<language name="JPN_KANJI">体の　大きな　ポケモンたちと
力比べをすることが　大好き。
張り手で　トラックを　ぶっ飛ばす。</language>
	</row>

	<row id="ZKN_COMMENT_01_298_000">
		<language name="JPN">えいようが　つまった　おおきな
しっぽを　ふりまわして　じぶんより
てごわい　あいてにも　たちむかう。</language>
		<language name="JPN_KANJI">栄養が　詰まった　大きな
しっぽを　振り回して　自分より
手強い　相手にも　たちむかう。</language>
	</row>

	<row id="ZKN_COMMENT_01_299_000">
		<language name="JPN">いつも　きたを　むいている
じしゃくの　はなで　まわりの　てつを
ひきよせて　まもりを　かためるのだ。</language>
		<language name="JPN_KANJI">いつも　北を　向いている
磁石の　鼻で　周りの　鉄を
引き寄せて　守りを　固めるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_300_000">
		<language name="JPN">じぶんの　シッポを　おいかけて
あそんでいると　めを　まわすといった
かわいらしい　いちめんを　みせる。</language>
		<language name="JPN_KANJI">自分の　シッポを　追いかけて
遊んでいると　目を　回すといった
可愛らしい　一面を　みせる。</language>
	</row>

	<row id="ZKN_COMMENT_01_301_000">
		<language name="JPN">きまった　すみかを　もたないのは
いごこちが　よく　きれいな　ばしょを
さがして　ねどこに　しているから。</language>
		<language name="JPN_KANJI">決まった　すみかを　持たないのは
居心地が　よく　きれいな　場所を
探して　寝床に　しているから。</language>
	</row>

	<row id="ZKN_COMMENT_01_302_000">
		<language name="JPN">どうくつの　くらやみに　ひそむ。
ほうせきを　たべているうちに
めが　ほうせきに　なってしまった。</language>
		<language name="JPN_KANJI">洞くつの　くらやみに　潜む。
宝石を　食べているうちに
目が　宝石に　なってしまった。</language>
	</row>

	<row id="ZKN_COMMENT_01_303_000">
		<language name="JPN">ツノが　へんけいして　できた
おおあごが　あたまに　ついている。
てっこつを　かみきってしまう。</language>
		<language name="JPN_KANJI">ツノが　変形して　できた
大アゴが　頭に　ついている。
鉄骨を　かみきってしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_304_000">
		<language name="JPN">はがねの　からだを　つくるために
てっこうせきを　たべている。ときどき
レールも　たべてしまう　こまりもの。</language>
		<language name="JPN_KANJI">鋼の　体を　つくるために
鉄鉱石を　食べている。ときどき
レールも　食べてしまう　困りもの。</language>
	</row>

	<row id="ZKN_COMMENT_01_305_000">
		<language name="JPN">なわばり　あらそいのため　コドラが
はがねのからだを　ぶつけあうと
もじどおり　ひばなが　とびちるのだ。</language>
		<language name="JPN_KANJI">縄張り　争いのため　コドラが
鋼の体を　ぶつけあうと
文字通り　火花が　飛び散るのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_306_000">
		<language name="JPN">やまを　まるごと　なわばりに　する。
キズが　おおい　ボスコドラほど
たたかっているので　あなどれない。</language>
		<language name="JPN_KANJI">山を　まるごと　縄張りに　する。
キズが　多い　ボスコドラほど
戦っているので　侮れない。</language>
	</row>

	<row id="ZKN_COMMENT_01_307_000">
		<language name="JPN">いつもは　やまおくで　しゅぎょう。
めいそうをして　せいしんりょくを
たかめると　からだが　うかびあがる。</language>
		<language name="JPN_KANJI">いつもは　山奥で　修行。
めいそうをして　精神力を　高めると
体が　浮かび上がる。</language>
	</row>

	<row id="ZKN_COMMENT_01_308_000">
		<language name="JPN">なにも　たべずに　ただひたすらに
せいしんを　とぎすませると
あいてのオーラが　みえるようになる。</language>
		<language name="JPN_KANJI">なにも　食べずに　ただひたすらに
精神を　研ぎ澄ませると
相手のオーラが　見えるようになる。</language>
	</row>

	<row id="ZKN_COMMENT_01_309_000">
		<language name="JPN">たいもうに　ためた　でんきを　つかい
きんにくを　しげきすることで
しゅんぱつりょくを　たかめる。</language>
		<language name="JPN_KANJI">体毛に　ためた　電気を　使い
筋肉を　刺激することで
瞬発力を　高める。</language>
	</row>

	<row id="ZKN_COMMENT_01_310_000">
		<language name="JPN">たてがみから　ほうでんしている。
ずじょうに　かみなりぐもを　つくり
いなずまを　おとして　こうげきする。</language>
		<language name="JPN_KANJI">たてがみから　放電している。
頭上に　雷雲を　作り
稲妻を　落として　攻撃する。</language>
	</row>

	<row id="ZKN_COMMENT_01_311_000">
		<language name="JPN">ひばなの　ボンボンを　つくって
なかまを　おうえんする。
でんちゅうから　でんきを　すいとる。</language>
		<language name="JPN_KANJI">火花の　ボンボンを　作って
仲間を　応援する。
電柱から　電気を　吸い取る。</language>
	</row>

	<row id="ZKN_COMMENT_01_312_000">
		<language name="JPN">なかまを　おうえんする　しゅうせい。
まけそうになると　からだから　だす
ひばなの　かずが　どんどん　ふえる。</language>
		<language name="JPN_KANJI">仲間を　応援する　習性。
負けそうになると　体から　出す
火花の　数が　どんどん　増える。</language>
	</row>

	<row id="ZKN_COMMENT_01_313_000">
		<language name="JPN">よるになると　おしりを　ひからせ
なかまと　かいわする。イルミーゼの
だす　あまい　かおりが　だいすき。</language>
		<language name="JPN_KANJI">夜になると　おしりを　光らせ
仲間と　会話する。イルミーゼの
出す　甘い　香りが　大好き。</language>
	</row>

	<row id="ZKN_COMMENT_01_314_000">
		<language name="JPN">あまい　かおりで　バルビートを
ゆうどうして　よぞらに
ひかりの　サインを　えがく。</language>
		<language name="JPN_KANJI">甘い　香りで　バルビートを
誘導して　夜空に
光の　サインを　描く。</language>
	</row>

	<row id="ZKN_COMMENT_01_315_000">
		<language name="JPN">みぎてと　ひだりてで　２しゅるいの
どくを　つかいわけて　こうげきする。
かおりが　つよいほど　げんきだ。</language>
		<language name="JPN_KANJI">右手と　左手で　２種類の
毒を　使いわけて　攻撃する。
香りが　強いほど　元気だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_316_000">
		<language name="JPN">からだの　ほとんどが　いぶくろ。
きょうりょくな　いえきで　のみこんだ
ものを　たちまち　しょうかする。</language>
		<language name="JPN_KANJI">体の　ほとんどが　胃袋。
強力な　胃液で　飲み込んだ　ものを
たちまち　消化する。</language>
	</row>

	<row id="ZKN_COMMENT_01_317_000">
		<language name="JPN">なんでも　まるのみしてしまう。
けあなから　もうどくの　たいえきを
ぶんぴつして　てきに　あびせかける。</language>
		<language name="JPN_KANJI">なんでも　まるのみしてしまう。
毛穴から　猛毒の　体液を
分泌して　敵に　浴びせかける。</language>
	</row>

	<row id="ZKN_COMMENT_01_318_000">
		<language name="JPN">なわばりに　はいってきた　あいてを
しゅうだんで　こうげき。するどい
キバは　ボートの　そこも　かみきる。</language>
		<language name="JPN_KANJI">縄張りに　入って来た　相手を
集団で　攻撃。鋭い　キバは
ボートの　底も　かみきる。</language>
	</row>

	<row id="ZKN_COMMENT_01_319_000">
		<language name="JPN">てっぱんも　かみちぎる　キバを　もち
およぐ　そくどは　じそく１２０キロ。
べつめいは　うみのギャング。</language>
		<language name="JPN_KANJI">鉄板も　かみちぎる　キバを　持ち
泳ぐ　速度は　時速１２０キロ。
別名は　海のギャング。</language>
	</row>

	<row id="ZKN_COMMENT_01_320_000">
		<language name="JPN">まいにち　１トンの　エサをたべる。
はなから　ためこんだ　かいすいを
いきおいよく　ふきだして　あそぶ。</language>
		<language name="JPN_KANJI">毎日　１トンの　エサを食べる。
鼻から　ためこんだ　海水を
勢いよく　吹きだして　遊ぶ。</language>
	</row>

	<row id="ZKN_COMMENT_01_321_000">
		<language name="JPN">おおきな　からだを　なみのうえで
ジャンプさせ　しょうげきを　うみだし
あいてを　きぜつ　させることがある。</language>
		<language name="JPN_KANJI">大きな　体を　波の上で
ジャンプさせ　衝撃を　生みだし
相手を　気絶　させることがある。</language>
	</row>

	<row id="ZKN_COMMENT_01_322_000">
		<language name="JPN">１２００どの　マグマを　たいないに
ためこんでいる。ほのおの　わざを
つかうと　コブは　ちいさく　しぼむ。</language>
		<language name="JPN_KANJI">１２００度の　マグマを　体内に
ためこんでいる。炎の　技を
使うと　コブは　小さく　しぼむ。</language>
	</row>

	<row id="ZKN_COMMENT_01_323_000">
		<language name="JPN">せなかの　コブの　かざんは
１０ねんごとに　だいふんか　するが
はげしく　おこっても　ふんかする。</language>
		<language name="JPN_KANJI">背中の　コブの　火山は
１０年ごとに　大噴火　するが
激しく　怒っても　噴火する。</language>
	</row>

	<row id="ZKN_COMMENT_01_324_000">
		<language name="JPN">こうらの　なかで　せきたんを　もやし
エネルギーに　している。ピンチの
ときは　くろい　ススを　ふきだす。</language>
		<language name="JPN_KANJI">甲羅の　中で　石炭を　燃やし
エネルギーに　している。ピンチの
ときは　黒い　ススを　吹き出す。</language>
	</row>

	<row id="ZKN_COMMENT_01_325_000">
		<language name="JPN">シッポを　バネがわりに　して
とびはねることで　しんぞうを
うごかしているので　とまると　しぬ。</language>
		<language name="JPN_KANJI">シッポを　バネがわりに　して
飛び跳ねることで　心臓を
動かしているので　止まると　死ぬ。</language>
	</row>

	<row id="ZKN_COMMENT_01_326_000">
		<language name="JPN">くろしんじゅで　サイコパワーを
つよめ　きみょうな　ステップで
あいての　こころを　あやつるぞ。</language>
		<language name="JPN_KANJI">黒真珠で　サイコパワーを
強め　奇妙な　ステップで
相手の　心を　操るぞ。</language>
	</row>

	<row id="ZKN_COMMENT_01_327_000">
		<language name="JPN">おなじ　ブチもようの　パッチールは
いない。フラフラした　あしどりで
あいての　ねらいを　はずす。</language>
		<language name="JPN_KANJI">同じ　ブチ模様の　パッチールは
いない。フラフラした　足取りで
相手の　ねらいを　外す。</language>
	</row>

	<row id="ZKN_COMMENT_01_328_000">
		<language name="JPN">ぜったいに　だっしゅつ　ふかのうな
すりばちじょうの　すあなを　つくって
えものが　おちてくるのを　まつ。</language>
		<language name="JPN_KANJI">絶対に　脱出　不可能な
すりばち状の　巣穴を　つくって
獲物が　落ちてくるのを　待つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_329_000">
		<language name="JPN">２まいの　ハネを　こうそくで
しんどうさせて　だす　ちょうおんぱは
はげしい　ずつうを　ひきおこす。</language>
		<language name="JPN_KANJI">２枚の　ハネを　高速で
振動させて　だす　超音波は
激しい　頭痛を　ひきおこす。</language>
	</row>

	<row id="ZKN_COMMENT_01_330_000">
		<language name="JPN">さばくのせいれい　と　よばれる。
はばたくことで　まきおこした
すなあらしの　なかに　かくれている。</language>
		<language name="JPN_KANJI">砂漠の精霊　と　呼ばれる。
はばたくことで　巻き起こした
砂あらしの　中に　隠れている。</language>
	</row>

	<row id="ZKN_COMMENT_01_331_000">
		<language name="JPN">さばくに　せいそく。たいないに
すいぶんを　ためることで　みずを
のまずに　３０にちかん　いきられる。</language>
		<language name="JPN_KANJI">砂漠に　生息。体内に
水分を　ためることで　水を　飲まずに
３０日間　生きられる。</language>
	</row>

	<row id="ZKN_COMMENT_01_332_000">
		<language name="JPN">よるになると　かつどうを　はじめる。
さばくの　あつさに　つかれはてた
えものを　みつけだし　とらえるのだ。</language>
		<language name="JPN_KANJI">夜になると　活動を　はじめる。
砂漠の　暑さに　疲れ果てた
獲物を　見つけ出し　捕らえるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_333_000">
		<language name="JPN">ひとの　あたまの　うえに
ちょこんと　のって　ぼうしのように
ふるまうのが　なぜか　だいすき。</language>
		<language name="JPN_KANJI">人の　頭の　上に
ちょこんと　乗って　帽子のように
ふるまうのが　なぜか　大好き。</language>
	</row>

	<row id="ZKN_COMMENT_01_334_000">
		<language name="JPN">はれたひ　わたぐもに　まぎれながら
おおぞらを　じゆうに　とびまわり
うつくしい　ソプラノで　うたう。</language>
		<language name="JPN_KANJI">晴れた日　綿雲に　まぎれながら
大空を　自由に　飛びまわり
美しい　ソプラノで　歌う。</language>
	</row>

	<row id="ZKN_COMMENT_01_335_000">
		<language name="JPN">ハブネークとは　いんねんの　あいだ。
であうと　すかさず　まえあしの
ツメを　ひろげて　いかくするのだ。</language>
		<language name="JPN_KANJI">ハブネークとは　因縁の　あいだ。
であうと　すかさず　前足の
ツメを　広げて　威嚇するのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_336_000">
		<language name="JPN">シッポの　かたなは　いつも　いわで
といでいるので　きれあじ　ばつぐん。
ザングースとは　いんねんの　あいだ。</language>
		<language name="JPN_KANJI">シッポの　刀は　いつも　岩で
研いでいるので　切れ味　ばつぐん。
ザングースとは　因縁の　あいだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_337_000">
		<language name="JPN">つきの　みちかけと　パワーの
ぞうげんが　かんけい　しているらしく
まんげつの　よる　かっぱつになる。</language>
		<language name="JPN_KANJI">月の　満ち欠けと　パワーの
増減が　関係　しているらしく
満月の　夜　活発になる。</language>
	</row>

	<row id="ZKN_COMMENT_01_338_000">
		<language name="JPN">たいようエネルギーが　パワーの
みなもと　なので　ひるまは　つよい。
かいてんすると　からだが　ひかる。</language>
		<language name="JPN_KANJI">太陽エネルギーが　パワーの
源　なので　昼間は　強い。
回転すると　体が　光る。</language>
	</row>

	<row id="ZKN_COMMENT_01_339_000">
		<language name="JPN">ぬるぬるの　からだは　つかみにくい。
ある　ちほうでは　どろが　かたまって
ドジョッチが　うまれたと　いわれる。</language>
		<language name="JPN_KANJI">ぬるぬるの　体は　つかみにくい。
ある　地方では　泥が　固まって
ドジョッチが　生まれたと　言われる。</language>
	</row>

	<row id="ZKN_COMMENT_01_340_000">
		<language name="JPN">なわばりいしきが　とても　つよく
がいてきが　ちかづくと　はげしく
じめんを　ゆらして　おそいかかる。</language>
		<language name="JPN_KANJI">縄張り意識が　とても　強く
外敵が　近づくと　激しく
地面を　揺らして　襲いかかる。</language>
	</row>

	<row id="ZKN_COMMENT_01_341_000">
		<language name="JPN">どんなに　みずが　よごれた
かわでも　てきおうして　ふえていく
タフな　せいめいりょくの　もちぬし。</language>
		<language name="JPN_KANJI">どんなに　水が　汚れた
川でも　適応して　増えていく
タフな　生命力の　持ち主。</language>
	</row>

	<row id="ZKN_COMMENT_01_342_000">
		<language name="JPN">こうせんてきな　ポケモンで　じぶんの
なわばりから　あらゆる　ポケモンを
ハサミで　つまんで　なげとばすぞ！</language>
		<language name="JPN_KANJI">好戦的な　ポケモンで　自分の
縄張りから　あらゆる　ポケモンを
ハサミで　つまんで　投げ飛ばすぞ！</language>
	</row>

	<row id="ZKN_COMMENT_01_343_000">
		<language name="JPN">こだいの　いせきから　はっけん。
かいてん　しながら　いどうして
なかまを　みつけ　むれを　なす。</language>
		<language name="JPN_KANJI">古代の　遺跡から　発見。
回転　しながら　移動して
仲間を　みつけ　群れを　なす。</language>
	</row>

	<row id="ZKN_COMMENT_01_344_000">
		<language name="JPN">２まんねんまえの　こだいじんが
つくった　ドロにんぎょうから
うまれたらしい　ナゾの　ポケモン。</language>
		<language name="JPN_KANJI">２万年前の　古代人が
つくった　ドロ人形から
生まれたらしい　ナゾの　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_345_000">
		<language name="JPN">およそ　１おくねんまえの　かいていで
くらしていた　こだいの　ポケモン。
かがくの　ちからで　ふっかつした。</language>
		<language name="JPN_KANJI">およそ　１億年前の　海底で
暮らしていた　古代の　ポケモン。
科学の　力で　復活した。</language>
	</row>

	<row id="ZKN_COMMENT_01_346_000">
		<language name="JPN">あたたかい　うみの　あさせに　いる。
しおが　ひくと　すなはまに　もぐった
えものを　ほりだして　たべる。</language>
		<language name="JPN_KANJI">暖かい　海の　浅瀬に　いる。
潮が　引くと　砂浜に　潜った
獲物を　掘り出して　食べる。</language>
	</row>

	<row id="ZKN_COMMENT_01_347_000">
		<language name="JPN">かせきから　ふっかつした　ポケモンの
せんぞの　いっしゅ。うみで　くらし
ツメで　えものを　つかまえる。</language>
		<language name="JPN_KANJI">化石から　復活した　ポケモンの
先祖の　一種。海で　暮らし
ツメで　獲物を　捕まえる。</language>
	</row>

	<row id="ZKN_COMMENT_01_348_000">
		<language name="JPN">しんかして　ちじょうで　くらすように
なった。ぜんしんが　がんじょうな
よろいに　おおわれている。</language>
		<language name="JPN_KANJI">進化して　地上で　暮らすように
なった。全身が　頑丈な
よろいに　おおわれている。</language>
	</row>

	<row id="ZKN_COMMENT_01_349_000">
		<language name="JPN">みすぼらしく　みにくい　ポケモンだが
しぶとい　せいめいりょくを　もち
わずかな　みずだけでも　いきのびる。</language>
		<language name="JPN_KANJI">みすぼらしく　醜い　ポケモンだが
しぶとい　生命力を　持ち
わずかな　水だけでも　生き延びる。</language>
	</row>

	<row id="ZKN_COMMENT_01_350_000">
		<language name="JPN">にじいろと　いわれる　きれいな
ウロコは　みるほうこうを　かえると
さまざまな　いろに　へんかする。</language>
		<language name="JPN_KANJI">にじ色と　言われる　きれいな
ウロコは　見る方向を　変えると
様々な　色に　変化する。</language>
	</row>

	<row id="ZKN_COMMENT_01_351_000">
		<language name="JPN">きおんや　しつどが　さいぼうに
えいきょう　するため　てんきによって
すがたが　かわってしまう　ポケモン。</language>
		<language name="JPN_KANJI">気温や　湿度が　細胞に
影響　するため　天気によって
姿が　変わってしまう　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_352_000">
		<language name="JPN">からだの　いろを　じゆうに　かえる
のうりょくを　もつ。おなかにある
ギザギザもよう　だけは　かわらない。</language>
		<language name="JPN_KANJI">体の　色を　自由に　変える
能力を　持つ。お腹にある
ギザギザ模様　だけは　変わらない。</language>
	</row>

	<row id="ZKN_COMMENT_01_353_000">
		<language name="JPN">だれかが　だれかを　うらむ
くらく　かなしい　きもちを
すいとって　じわじわ　つよくなる。</language>
		<language name="JPN_KANJI">だれかが　だれかを　恨む
暗く　哀しい　気持ちを
吸い取って　じわじわ　強くなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_354_000">
		<language name="JPN">すてられた　ヌイグルミに　うらみが
たまって　ポケモンに　なった。
じぶんをすてた　こどもを　さがすぞ。</language>
		<language name="JPN_KANJI">捨てられた　ヌイグルミに　恨みが
たまって　ポケモンに　なった。
自分を捨てた　こどもを　探すぞ。</language>
	</row>

	<row id="ZKN_COMMENT_01_355_000">
		<language name="JPN">こどもの　なきごえが　だいすきで
ぶあつい　かべも　とおりぬけて
わるいこを　おどろかせ　なかせる。</language>
		<language name="JPN_KANJI">子供の　泣き声が　大好きで
分厚い　壁も　通り抜けて
悪い子を　驚かせ　泣かせる。</language>
	</row>

	<row id="ZKN_COMMENT_01_356_000">
		<language name="JPN">さまよっている　ひとだまを　みつけ
からっぽの　たいないに　すいこむ。
すいこまれて　どうなるかは　なぞ。</language>
		<language name="JPN_KANJI">さ迷っている　人魂を　見つけ
からっぽの　体内に　吸い込む。
吸い込まれて　どうなるかは　ナゾ。</language>
	</row>

	<row id="ZKN_COMMENT_01_357_000">
		<language name="JPN">おおきな　はっぱで　そらをとんで
こどもたちに　だいにんきの　くびに
できる　あまい　くだものを　くばる。</language>
		<language name="JPN_KANJI">大きな　はっぱで　空を飛んで
こどもたちに　大人気の　首に
できる　甘い　くだものを　配る。</language>
	</row>

	<row id="ZKN_COMMENT_01_358_000">
		<language name="JPN">なきごえは　からだの　くうどうで
ひびきあって　きれいな　ねいろになり
てきをおどろかせ　おいはらっていた。</language>
		<language name="JPN_KANJI">鳴き声は　体の　空洞で
響き合って　きれいな　音色になり
敵を驚かせ　追い払っていた。</language>
	</row>

	<row id="ZKN_COMMENT_01_359_000">
		<language name="JPN">ツノで　さっちした　わざわいを
ひとに　しらせようとして
やまおくから　すがたを　あらわす。</language>
		<language name="JPN_KANJI">ツノで　察知した　災いを
人に　知らせようとして
山奥から　姿を　表す。</language>
	</row>

	<row id="ZKN_COMMENT_01_360_000">
		<language name="JPN">なかまたちと　おしくらまんじゅうを
やることで　がまんづよく　そだつ。
あまい　くだものが　だいこうぶつ。</language>
		<language name="JPN_KANJI">仲間たちと　おしくらまんじゅうを
やることで　我慢強く　育つ。
甘い　果物が　大好物。</language>
	</row>

	<row id="ZKN_COMMENT_01_361_000">
		<language name="JPN">おおきな　はっぱの　したに
すうひきの　ユキワラシが　あつまり
なかよく　くらしているという。</language>
		<language name="JPN_KANJI">大きな　葉っぱの　下に
数匹の　ユキワラシが　集まり
仲良く　暮らしているという。</language>
	</row>

	<row id="ZKN_COMMENT_01_362_000">
		<language name="JPN">くうきちゅうの　すいぶんを
いっしゅんで　こおらせることで
えものが　にげられないように　する。</language>
		<language name="JPN_KANJI">空気中の　水分を
一瞬で　凍らせることで
獲物が　逃げられないように　する。</language>
	</row>

	<row id="ZKN_COMMENT_01_363_000">
		<language name="JPN">まだ　じょうずに　およげず
ころがったほうが　はやく　うごける。
うれしいと　みんなで　てをたたく。</language>
		<language name="JPN_KANJI">まだ　上手に　泳げず
転がったほうが　速く　動ける。
うれしいと　みんなで　手をたたく。</language>
	</row>

	<row id="ZKN_COMMENT_01_364_000">
		<language name="JPN">まるければ　モンスターボールでも
タマザラシでも　はなのうえに　のせて
じゆうじざいに　くるくる　まわすぞ。</language>
		<language name="JPN_KANJI">丸ければ　モンスターボールでも
タマザラシでも　鼻の上に　乗せて
自由自在に　くるくる　回すぞ。</language>
	</row>

	<row id="ZKN_COMMENT_01_365_000">
		<language name="JPN">ぶあつい　しぼうは　さむさ　いがいに
てきの　こうげきも　よせつけない。
じまんのキバで　こおりを　くだくぞ。</language>
		<language name="JPN_KANJI">分厚い　脂肪は　寒さ　以外に
敵の　こうげきも　よせつけない。
自慢のキバで　氷を　砕くぞ。</language>
	</row>

	<row id="ZKN_COMMENT_01_366_000">
		<language name="JPN">いっしょうに　１こだけ　つくる
しんじゅは　サイコパワーを
ぞうふくする　さようが　あるという。</language>
		<language name="JPN_KANJI">一生に　１個だけ　作る
真珠は　サイコパワーを
増幅する　作用が　あるという。</language>
	</row>

	<row id="ZKN_COMMENT_01_367_000">
		<language name="JPN">しんかいに　せいそくする　ポケモン。
こざかなの　かたちをした　しっぽで
えものを　おびきよせ　つかまえる。</language>
		<language name="JPN_KANJI">深海に　生息する　ポケモン。
小魚の　形をした　しっぽで
獲物を　誘き寄せ　捕まえる。</language>
	</row>

	<row id="ZKN_COMMENT_01_368_000">
		<language name="JPN">うみの　そこで　くらしているが
はるになると　からだの　ピンクいろが
なぜか　あざやかに　いろづく。</language>
		<language name="JPN_KANJI">海の　底で　暮らしているが
春になると　体の　ピンク色が
なぜか　鮮やかに　色づく。</language>
	</row>

	<row id="ZKN_COMMENT_01_369_000">
		<language name="JPN">しんかいちょうさで　はっけんされた
めずらしい　ポケモン。１おくねんの
あいだ　すがたが　かわっていない。</language>
		<language name="JPN_KANJI">深海調査で　発見された
珍しい　ポケモン。１億年の　あいだ
姿が　変わっていない。</language>
	</row>

	<row id="ZKN_COMMENT_01_370_000">
		<language name="JPN">あたたかい　うみに　せいそくする。
ラブカスを　みつけた　カップルは
えいえんの　あいが　つづくという。</language>
		<language name="JPN_KANJI">暖かい　海に　生息する。
ラブカスを　見つけた　カップルは
永遠の　愛が　続くという。</language>
	</row>

	<row id="ZKN_COMMENT_01_371_000">
		<language name="JPN">おおぞらを　とぶことを　ゆめみて
まいにち　とぶ　れんしゅうのために
がけから　とびおりている。</language>
		<language name="JPN_KANJI">大空を　飛ぶことを　夢見て
毎日　飛ぶ　練習のために
ガケから　飛び降りている。</language>
	</row>

	<row id="ZKN_COMMENT_01_372_000">
		<language name="JPN">かたい　カラの　なかでは　さいぼうが
へんかを　はじめている。しんかする
しゅんかんに　カラが　はがれおちる。</language>
		<language name="JPN_KANJI">硬い　殻の　中では　細胞が
変化を　始めている。進化する
瞬間に　殻が　はがれ落ちる。</language>
	</row>

	<row id="ZKN_COMMENT_01_373_000">
		<language name="JPN">そらを　とぶことを　ねがいつづけた
けっか　からだの　さいぼうが
へんかして　つばさが　はえてきた。</language>
		<language name="JPN_KANJI">空を　飛ぶことを　願い続けた　結果
体の　細胞が　変化して
翼が　生えてきた。</language>
	</row>

	<row id="ZKN_COMMENT_01_374_000">
		<language name="JPN">さいぼう　すべてが　じしゃくで
からだから　じりょくを　はっしんし
なかまと　かいわ　している。</language>
		<language name="JPN_KANJI">細胞　すべてが　磁石で
体から　磁力を　発信し
仲間と　会話　している。</language>
	</row>

	<row id="ZKN_COMMENT_01_375_000">
		<language name="JPN">２ひきの　ダンバルが　がったいした。
２つの　のうみそが　れんけつしたので
サイコパワーは　より　つよくなった。</language>
		<language name="JPN_KANJI">２匹の　ダンバルが　合体した。
２つの　脳みそが　連結したので
サイコパワーは　より　強くなった。</language>
	</row>

	<row id="ZKN_COMMENT_01_376_000">
		<language name="JPN">４つの　のうみそが　つらなり
スーパーコンピューターより　すごい
けいさんで　あいてを　ぶんせきする。</language>
		<language name="JPN_KANJI">４つの　脳みそが　連なり
スーパーコンピューターより　すごい
計算で　相手を　分析する。</language>
	</row>

	<row id="ZKN_COMMENT_01_377_000">
		<language name="JPN">ぜんしんが　いわで　できている。
たたかいで　からだが　かけても
いわを　くっつけて　なおしてしまう。</language>
		<language name="JPN_KANJI">全身が　岩で　できている。
戦いで　体が　欠けても
岩を　くっつけて　治してしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_378_000">
		<language name="JPN">ひょうがきに　できた　こおりで
からだが　つくられている。マイナス
２００どの　れいきを　あやつる。</language>
		<language name="JPN_KANJI">氷河期に　できた　氷で
体が　作られている。
マイナス２００度の　冷気を　操る。</language>
	</row>

	<row id="ZKN_COMMENT_01_379_000">
		<language name="JPN">なんまんねんも　ちかの　あつりょくで
きたえられた　きんぞくの　ボディは
きずひとつ　つかない。</language>
		<language name="JPN_KANJI">何万年も　地下の　圧力で
鍛えられた　金属の　ボディは
傷ひとつ　つかない。</language>
	</row>

	<row id="ZKN_COMMENT_01_380_000">
		<language name="JPN">ひかりを　くっせつさせる　うもうで
ぜんしんを　つつみこみ　すがたを
みえなくする　のうりょくを　もつ。</language>
		<language name="JPN_KANJI">光を　屈折させる　羽毛で
全身を　包み込み　姿を
見えなくする　能力を　持つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_381_000">
		<language name="JPN">たかい　ちのうを　もつ　ポケモン。
うでを　おりたたんで　とべば
ジェットきを　おいこす　スピードだ。</language>
		<language name="JPN_KANJI">高い　知能を　持つ　ポケモン。
腕を　折りたたんで　飛べば
ジェット機を　追い越す　スピードだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_382_000">
		<language name="JPN">おおあめを　ふらせる　のうりょくで
うみを　ひろげたと　いわれている。
かいこうの　そこで　ねむっていた。</language>
		<language name="JPN_KANJI">大雨を　降らせる　能力で
海を　広げたと　言われている。
海溝の　底で　眠っていた。</language>
	</row>

	<row id="ZKN_COMMENT_01_383_000">
		<language name="JPN">おおむかし　カイオーガとの　しとうの
すえに　ちかマグマの　なかで
ねむっていた　ポケモン。</language>
		<language name="JPN_KANJI">大昔　カイオーガと　死闘の　末に
地下マグマの　中で
眠っていた　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_384_000">
		<language name="JPN">くもより　はるかうえの　オゾンそうに
せいそくしているため　ちじょうから
すがたを　みることは　できない。</language>
		<language name="JPN_KANJI">雲より　はるか上の　オゾン層に
生息しているため　地上から
姿を　見ることは　できない。</language>
	</row>

	<row id="ZKN_COMMENT_01_385_000">
		<language name="JPN">１０００ねんかんで　７にちだけ
めを　さまし　どんな　ねがいごとでも
かなえる　ちからを　つかうという。</language>
		<language name="JPN_KANJI">１０００年間で　７日だけ
目を　覚まし　どんな　願い事でも
かなえる　力を　使うという。</language>
	</row>

	<row id="ZKN_COMMENT_01_386_000">
		<language name="JPN">いんせきに　ふちゃくしていた
うちゅうウイルスの　ＤＮＡが
へんいして　うまれた　ポケモン。</language>
		<language name="JPN_KANJI">いん石に　付着していた
宇宙ウイルスの　ＤＮＡが
変異して　生まれた　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_387_000">
		<language name="JPN">つちで　できた　せなかの　こうらを
さわって　ほどよく　しめっていたなら
その　ナエトルは　とても　げんきだ。</language>
		<language name="JPN_KANJI">土で　できた　背中の　甲羅を
触って　ほどよく　湿っていたなら
その　ナエトルは　とても　元気だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_388_000">
		<language name="JPN">きれいな　みずが　わきでる　ばしょを
しっていて　なかまの　ポケモンを
せなかに　のせて　そこまで　はこぶ。</language>
		<language name="JPN_KANJI">きれいな　水が　わき出る　場所を
知っていて　仲間の　ポケモンを
背中に　乗せて　そこまで　運ぶ。</language>
	</row>

	<row id="ZKN_COMMENT_01_389_000">
		<language name="JPN">ドダイトスの　せなかで　うまれて
ドダイトスの　せなかで　いっしょうを
まっとうする　ポケモンも　いる。</language>
		<language name="JPN_KANJI">ドダイトスの　背中で　生まれて
ドダイトスの　背中で　一生を
全うする　ポケモンも　いる。</language>
	</row>

	<row id="ZKN_COMMENT_01_390_000">
		<language name="JPN">とても　みがるな　ポケモン。
まわりが　もえないように　おしりの
ほのおを　けしてから　ねむる。</language>
		<language name="JPN_KANJI">とても　身軽な　ポケモン。
まわりが　燃えないように　おしりの
炎を　消してから　眠る。</language>
	</row>

	<row id="ZKN_COMMENT_01_391_000">
		<language name="JPN">しっぽの　ほのおの　いきおいを
うまく　コントロールして　じぶんの
とくいな　まあいで　たたかうのだ。</language>
		<language name="JPN_KANJI">しっぽの　炎の　勢いを
うまく　コントロールして
自分の　得意な　間合いで　戦うのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_392_000">
		<language name="JPN">てあしに　ほのおを　まとった
どくとくの　かくとうわざを　つかい
どんな　あいてにも　たちむかう。</language>
		<language name="JPN_KANJI">手足に　炎を　まとった
独特の　格闘わざを　使い
どんな　相手にも　立ち向かう。</language>
	</row>

	<row id="ZKN_COMMENT_01_393_000">
		<language name="JPN">あるくのは　にがてで　こけたりするが
ポッチャマの　プライドは　たかく
きにせず　どうどうと　むねを　はる。</language>
		<language name="JPN_KANJI">歩くのは　苦手で　こけたりするが
ポッチャマの　プライドは　高く
気にせず　堂々と　胸を　はる。</language>
	</row>

	<row id="ZKN_COMMENT_01_394_000">
		<language name="JPN">どの　ポッタイシも　じぶんが
いちばん　えらいと　かんがえるため
むれを　つくることは　ふかのうだ。</language>
		<language name="JPN_KANJI">どの　ポッタイシも　自分が
一番　偉いと　考えるため
群れを　作ることは　不可能だ。</language>
	</row>

	<row id="ZKN_COMMENT_01_395_000">
		<language name="JPN">プライドを　きずつける　ものは
りゅうひょうをも　せつだんする
つばさで　まっぷたつに　する。</language>
		<language name="JPN_KANJI">プライドを　傷つける　者は
流氷をも　切断する　翼で
真っ二つに　する。</language>
	</row>

	<row id="ZKN_COMMENT_01_396_000">
		<language name="JPN">むれを　つくることで　１ぴきでの
よわさを　カバーしあっているが
むれが　おおきくなると　もめだす。</language>
		<language name="JPN_KANJI">群れを　作ることで　１匹での
弱さを　カバーし合っているが
群れが　大きくなると　もめだす。</language>
	</row>

	<row id="ZKN_COMMENT_01_397_000">
		<language name="JPN">じぶんの　よわさを　わきまえており
いつも　むれで　くらしている。
いっぴきになると　やかましく　なく。</language>
		<language name="JPN_KANJI">自分の　弱さを　わきまえており
いつも　群れで　暮らしている。
１匹になると　やかましく　鳴く。</language>
	</row>

	<row id="ZKN_COMMENT_01_398_000">
		<language name="JPN">じぶんの　からだが　きずつこうとも
こうげきを　やめなくなった。
とさかの　かたちを　きにしている。</language>
		<language name="JPN_KANJI">自分の　体が　傷つこうとも
攻撃を　やめなくなった。
トサカの　形を　気にしている。</language>
	</row>

	<row id="ZKN_COMMENT_01_399_000">
		<language name="JPN">ビッパと　コラッタの　まえば
どちらが　のびるのが　はやいのか
くらべたところ　ひきわけ　だった。</language>
		<language name="JPN_KANJI">ビッパと　コラッタの　前歯
どちらが　伸びるのが　早いのか
比べたところ　引き分け　だった。</language>
	</row>

	<row id="ZKN_COMMENT_01_400_000">
		<language name="JPN">ビーダルが　ダムを　つくった
かわは　はんらん　することがないので
ちかくの　ひとから　かんしゃされる。</language>
		<language name="JPN_KANJI">ビーダルが　ダムを　作った
川は　はんらん　することがないので
近くの　人から　感謝される。</language>
	</row>

	<row id="ZKN_COMMENT_01_401_000">
		<language name="JPN">あしが　みじかく　こけそうになるたび
かたい　しょっかくが　こすれあって
もっきんのような　おとが　ひびく。</language>
		<language name="JPN_KANJI">足が　短く　こけそうになるたび
硬い　触角が　こすれあって
木琴のような　音が　響く。</language>
	</row>

	<row id="ZKN_COMMENT_01_402_000">
		<language name="JPN">へんげんじざいの　なきごえを
きそいあわせる　なきくらべ　という
あそびを　たのしむ　むらがある。</language>
		<language name="JPN_KANJI">変幻自在の　鳴き声を
競い合わせる　鳴き比べ　という
遊びを　楽しむ　村がある。</language>
	</row>

	<row id="ZKN_COMMENT_01_403_000">
		<language name="JPN">からだを　うごかすたびに　きんにくが
のびちぢみして　でんきが　うまれる。
ピンチになると　からだが　かがやく。</language>
		<language name="JPN_KANJI">体を　動かすたびに　筋肉が
伸び縮みして　電気が　生まれる。
ピンチになると　体が　輝く。</language>
	</row>

	<row id="ZKN_COMMENT_01_404_000">
		<language name="JPN">するどい　ツメの　さきには　つよい
でんきが　ながれており　ほんのすこし
かするだけで　あいてをきぜつさせる。</language>
		<language name="JPN_KANJI">鋭い　ツメの　先には　強い　電気が
流れており　ほんの少し　かするだけで
相手を気絶させる。</language>
	</row>

	<row id="ZKN_COMMENT_01_405_000">
		<language name="JPN">かべのむこうも　みえる　ちからで
にげた　えものを　おいつめるほかにも
まいごの　こどもを　さがしたりする。</language>
		<language name="JPN_KANJI">壁の向こうも　見える　力で
逃げた　獲物を　追いつめるほかにも
迷子の　子供を　捜したりする。</language>
	</row>

	<row id="ZKN_COMMENT_01_406_000">
		<language name="JPN">まわりの　おんどへんかに　びんかん。
あたたかくなると　つぼみが　ひらき
どくをふくんだ　かふんを　ばらまく。</language>
		<language name="JPN_KANJI">周りの　温度変化に　敏感。
暖かくなると　つぼみが　開き
毒を含んだ　花粉を　ばらまく。</language>
	</row>

	<row id="ZKN_COMMENT_01_407_000">
		<language name="JPN">あまい　かおりで　えものを　さそい
りょううでの　どくのムチを　つかって
さしたり　しめたりして　しとめる。</language>
		<language name="JPN_KANJI">甘い　香りで　獲物を　誘い
両腕の　毒のムチを　使って
刺したり　締めたりして　仕留める。</language>
	</row>

	<row id="ZKN_COMMENT_01_408_000">
		<language name="JPN">およそ　１おくねんまえの　ポケモン。
ジャングルで　うまれそだち　じゃまな
じゅもくは　ずつきで　へしおった。</language>
		<language name="JPN_KANJI">およそ　１億年前の　ポケモン。
ジャングルで　生まれ育ち　邪魔な
樹木は　頭突きで　へしおった。</language>
	</row>

	<row id="ZKN_COMMENT_01_409_000">
		<language name="JPN">あたまを　はげしく　ぶつけあっても
ずがいこつは　あつさ　３０センチも
あるので　きぜつ　したりしない。</language>
		<language name="JPN_KANJI">頭を　激しく　ぶつけ合っても
頭がい骨は　厚さ　３０センチも
あるので　気絶　したりしない。</language>
	</row>

	<row id="ZKN_COMMENT_01_410_000">
		<language name="JPN">ばつぐんの　ぼうぎょりょくを　もつ。
そのため　とくに　あらそうこともなく
くさや　きのみを　たべて　すごす。</language>
		<language name="JPN_KANJI">抜群の　防御力を　持つ。
そのため　特に　争うこともなく
草や　木の実を　食べて　過ごす。</language>
	</row>

	<row id="ZKN_COMMENT_01_411_000">
		<language name="JPN">よこいちれつに　ならぶと　どんな
ポケモンでも　とっぱ　できない。
そうやって　こどもを　まもっていた。</language>
		<language name="JPN_KANJI">横一列に　並ぶと　どんな
ポケモンでも　突破　できない。
そうやって　子供を　守っていた。</language>
	</row>

	<row id="ZKN_COMMENT_01_412_000">
		<language name="JPN">からだをつつむ　ざいりょうが　ない
ばしょで　うまれても　ミノムッチは
いつのまにか　ミノを　まとっている。</language>
		<language name="JPN_KANJI">体を包む　材料が　ない　場所で
生まれても　ミノムッチは
いつのまにか　ミノを　まとっている。</language>
	</row>

	<row id="ZKN_COMMENT_01_413_000">
		<language name="JPN">しんかするとき　まわりにある
ざいりょうを　からだに　とりこむため
おおくの　バリエーションが　ある。</language>
		<language name="JPN_KANJI">進化するとき　まわりにある
材料を　体に　取り込むため
多くの　バリエーションが　ある。</language>
	</row>

	<row id="ZKN_COMMENT_01_414_000">
		<language name="JPN">はなのミツが　だいすきだが
じぶんでは　あつめず　ミツハニーから
よこどり　ばかりを　かんがえている。</language>
		<language name="JPN_KANJI">花のミツが　大好きだが
自分では　集めず　ミツハニーから
横取り　ばかりを　考えている。</language>
	</row>

	<row id="ZKN_COMMENT_01_415_000">
		<language name="JPN">３びきセットの　ポケモン。
ねむるとき　ミツハニーが　１００ひき
あつまり　おおきな　すをつくる。</language>
		<language name="JPN_KANJI">３匹セットの　ポケモン。
眠るとき　ミツハニーが　１００匹
集まり　大きな　巣をつくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_416_000">
		<language name="JPN">どうたいは　こどもたちの　すあな。
いろんな　フェロモンを　だして
こどもたちを　じゆうに　あやつる。</language>
		<language name="JPN_KANJI">胴体は　こどもたちの　巣穴。
いろんな　フェロモンを　だして
こどもたちを　自由に　操る。</language>
	</row>

	<row id="ZKN_COMMENT_01_417_000">
		<language name="JPN">たまった　でんきを　わけあたえようと
ほほぶくろを　こすりあわせる
パチリスを　みかけることも　ある。</language>
		<language name="JPN_KANJI">たまった　電気を　分け与えようと
ほほ袋を　こすり合わせる
パチリスを　見かけることも　ある。</language>
	</row>

	<row id="ZKN_COMMENT_01_418_000">
		<language name="JPN">くびの　うきぶくろを　ふくらませ
すいめんから　かおを　だして
あたりの　ようすを　うかがっている。</language>
		<language name="JPN_KANJI">首の　浮き袋を　ふくらませ
水面から　顔を　だして
辺りの　様子を　うかがっている。</language>
	</row>

	<row id="ZKN_COMMENT_01_419_000">
		<language name="JPN">りょうしまちに　おおく　くらし
おぼれた　ひとを　たすけたり
とった　えものを　はこんでいる。</language>
		<language name="JPN_KANJI">漁師町に　多く　暮らし
おぼれた　人を　助けたり
捕った　獲物を　運んでいる。</language>
	</row>

	<row id="ZKN_COMMENT_01_420_000">
		<language name="JPN">ちいさな　たまには　えいようが
つまっているだけでなく　おいしいので
ムックルに　ついばまれたりする。</language>
		<language name="JPN_KANJI">小さな　玉には　栄養が
つまっているだけでなく　おいしいので
ムックルに　ついばまれたりする。</language>
	</row>

	<row id="ZKN_COMMENT_01_421_000">
		<language name="JPN">つよい　ひざしを　かんじとると
とざしていた　はなびらを　ひろげ
ぜんしんで　にっこうを　あびる。</language>
		<language name="JPN_KANJI">強い　日差しを　感じとると
閉ざしていた　花びらを　広げ
全身で　日光を　浴びる。</language>
	</row>

	<row id="ZKN_COMMENT_01_422_000">
		<language name="JPN">やわらかい　からだを　つよくおすと
むらさきいろの　なぞの　えきたいが
にじみでるので　ようちゅうい。</language>
		<language name="JPN_KANJI">やわらかい　体を　強く押すと
紫色の　ナゾの　液体が
にじみ出るので　要注意。</language>
	</row>

	<row id="ZKN_COMMENT_01_423_000">
		<language name="JPN">むかしは　じょうぶな　カラで
せなか　ぜんたいを　おおっていた。
さいぼうに　その　なごりが　ある。</language>
		<language name="JPN_KANJI">昔は　丈夫な　殻で
背中　全体を　おおっていた。
細胞に　その　名残が　ある。</language>
	</row>

	<row id="ZKN_COMMENT_01_424_000">
		<language name="JPN">２ほんに　わかれた　しっぽは
いろんなことが　きように　できるので
ほとんど　てを　つかわなくなった。</language>
		<language name="JPN_KANJI">２本に　分かれた　しっぽは
いろんなことが　器用に　できるので
ほとんど　手を　使わなくなった。</language>
	</row>

	<row id="ZKN_COMMENT_01_425_000">
		<language name="JPN">たましいの　みちしるべと　いわれる。
フワンテを　もっていた　こどもは
とつぜん　きえて　いなくなる。</language>
		<language name="JPN_KANJI">魂の　道標と　いわれる。
フワンテを　持っていた　こどもは
突然　消えて　いなくなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_426_000">
		<language name="JPN">ひとや　ポケモンを　はこぶ。
ただし　かぜに　ながされてしまうので
いきさきを　きめられない。</language>
		<language name="JPN_KANJI">人や　ポケモンを　運ぶ。
ただし　風に　流されてしまうので
行き先を　決められない。</language>
	</row>

	<row id="ZKN_COMMENT_01_427_000">
		<language name="JPN">まるめている　みみを　いきおいよく
のばして　じめんを　たたくと
じぶんでも　おどろくほど　はねるぞ。</language>
		<language name="JPN_KANJI">丸めている　耳を　勢いよく
伸ばして　地面を　たたくと
自分でも　驚くほど　跳ねるぞ。</language>
	</row>

	<row id="ZKN_COMMENT_01_428_000">
		<language name="JPN">けいかいしんが　とても　つよい。
きけんを　かんじると　かろやかに
とびはねて　はしりさってしまう。</language>
		<language name="JPN_KANJI">警戒心が　とても　強い。
危険を　感じると　軽やかに
飛び跳ねて　走り去ってしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_429_000">
		<language name="JPN">じゅもんのような　なきごえだが
まれに　あいてを　しあわせにする
こうかも　ひめているという。</language>
		<language name="JPN_KANJI">じゅもんのような　鳴き声だが
まれに　相手を　幸せにする
効果も　秘めているという。</language>
	</row>

	<row id="ZKN_COMMENT_01_430_000">
		<language name="JPN">ドンカラスが　ひくいこえで　なくと
すぐさま　ヤミカラスが　あつまるため
よるをまねくもの　とも　いわれる。</language>
		<language name="JPN_KANJI">ドンカラスが　低い声で　鳴くと
すぐさま　ヤミカラスが　集まるため
夜を招くもの　とも　言われる。</language>
	</row>

	<row id="ZKN_COMMENT_01_431_000">
		<language name="JPN">トレーナーが　エサを　くれないと
はなのあなに　ツメをひっかける
ひどい　いちめんを　ひめている。</language>
		<language name="JPN_KANJI">トレーナーが　エサを　くれないと
鼻の穴に　ツメをひっかける
ひどい　一面を　秘めている。</language>
	</row>

	<row id="ZKN_COMMENT_01_432_000">
		<language name="JPN">どうたいを　しっぽで　しばりつけて
じぶんを　おおきく　みせている。
めがあうと　いつまでも　にらみあう。</language>
		<language name="JPN_KANJI">胴体を　しっぽで　縛りつけて
自分を　大きく　見せている。
目が合うと　いつまでも　にらみ合う。</language>
	</row>

	<row id="ZKN_COMMENT_01_433_000">
		<language name="JPN">とびはねると　くちのなかにある
たまが　あちこちに　はんしゃして
すずのような　ねいろと　なる。</language>
		<language name="JPN_KANJI">跳びはねると　口の中にある
玉が　あちこちに　反射して
鈴のような　音色と　なる。</language>
	</row>

	<row id="ZKN_COMMENT_01_434_000">
		<language name="JPN">おしりからとばす　くさい　しるの
においは　はんけい２キロに　ひろがり
まわりの　ポケモンは　いなくなる。</language>
		<language name="JPN_KANJI">おしりから飛ばす　くさい　汁の
においは　半径２キロに　広がり
まわりの　ポケモンは　いなくなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_435_000">
		<language name="JPN">しっぽの　さきから　ひどい　においの
えきたいを　とばして　こうげきするが
うえから　ねらわれると　とまどう。</language>
		<language name="JPN_KANJI">しっぽの　先から　ひどい　においの
液体を　飛ばして　攻撃するが
上から　ねらわれると　とまどう。</language>
	</row>

	<row id="ZKN_COMMENT_01_436_000">
		<language name="JPN">ふるい　おはかから　みつかる。
せなかの　もようには　しんぴてきな
ちからが　やどっていると　いわれる。</language>
		<language name="JPN_KANJI">古い　お墓から　みつかる。
背中の　模様には　神秘的な
力が　宿っていると　いわれる。</language>
	</row>

	<row id="ZKN_COMMENT_01_437_000">
		<language name="JPN">あまぐもを　よべる　ポケモンとして
おおむかしから　まつられていた。
ときどき　じめんに　うめられている。</language>
		<language name="JPN_KANJI">雨雲を　呼べる　ポケモンとして
大昔から　まつられていた。
ときどき　地面に　埋められている。</language>
	</row>

	<row id="ZKN_COMMENT_01_438_000">
		<language name="JPN">かんそうした　くうきを　このむ。
すいぶんを　ちょうせつ　するときに
だす　みずが　なみだに　みえる。</language>
		<language name="JPN_KANJI">乾燥した　空気を　好む。
水分を　調節　するときに
出す　水が　涙に　見える。</language>
	</row>

	<row id="ZKN_COMMENT_01_439_000">
		<language name="JPN">めにみえる　あいての　かおや
うごきの　モノマネを　することで
どんな　きもちか　わかろうとする。</language>
		<language name="JPN_KANJI">目に見える　相手の　顔や
動きの　モノマネを　することで
どんな　気持ちか　わかろうとする。</language>
	</row>

	<row id="ZKN_COMMENT_01_440_000">
		<language name="JPN">ちいさないしを　かかえるのが　すき。
あいての　あしもとを　あるきまわって
ついつい　ころばすことも　ある。</language>
		<language name="JPN_KANJI">小さな　石を　抱えるのが　好き。
相手の　足元を　歩き回って
ついつい　転ばすことも　ある。</language>
	</row>

	<row id="ZKN_COMMENT_01_441_000">
		<language name="JPN">ベロは　にんげんのものに　そっくり。
そのため　にんげんの　はなすことばを
じょうずに　まねることが　できる。</language>
		<language name="JPN_KANJI">ベロは　人間のものに　そっくり。
そのため　人間の　話す言葉を
上手に　真似ることが　できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_442_000">
		<language name="JPN">いつも　わるさばかり　していたら
ふしぎな　じゅつで　ほんたいを
かなめいしに　しばりつけられた。</language>
		<language name="JPN_KANJI">いつも　悪さばかり　していたら
不思議な　術で　本体を
要石に　縛りつけられた。</language>
	</row>

	<row id="ZKN_COMMENT_01_443_000">
		<language name="JPN">おおぐちを　つかった　こうげきは
いりょく　じゅうぶんだが　まだ
うまくたたかえず　じぶんもきずつく。</language>
		<language name="JPN_KANJI">大口を　使った　攻撃は
威力　十分だが
まだ　うまく戦えず　自分も傷つく。</language>
	</row>

	<row id="ZKN_COMMENT_01_444_000">
		<language name="JPN">ひかりかがやく　ものが　だいすきで
どうくつの　なかで　みつけた
たからを　じぶんのすに　ためこむ。</language>
		<language name="JPN_KANJI">光り輝く　ものが　大好きで
洞くつの　中で　見つけた
宝を　自分の巣に　ため込む。</language>
	</row>

	<row id="ZKN_COMMENT_01_445_000">
		<language name="JPN">こうそくで　かけぬけると　つばさは
くうきの　やいばを　うみだし
まわりのきは　せつだん　されている。</language>
		<language name="JPN_KANJI">高速で　駆け抜けると　翼は
空気の　刃を　生み出し
まわりの木は　切断　されている。</language>
	</row>

	<row id="ZKN_COMMENT_01_446_000">
		<language name="JPN">ひっしに　エサを　たべているうちに
からだの　けのしたに　かくしていた
エサのことを　わすれてしまうのだ。</language>
		<language name="JPN_KANJI">必死に　エサを　食べているうちに
体の　毛の下に　隠していた
エサのことを　忘れてしまうのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_447_000">
		<language name="JPN">かんじょうで　かたちが　かわる
はどうを　だしあって　なかまどうし
コミュニケーションを　とっている。</language>
		<language name="JPN_KANJI">感情で　形が　変わる
波動を　だしあって　仲間同士
コミュニケーションを　とっている。</language>
	</row>

	<row id="ZKN_COMMENT_01_448_000">
		<language name="JPN">あらゆる　ものが　だす　はどうを
よみとることで　１キロさきに　いる
あいての　きもちも　りかいできる。</language>
		<language name="JPN_KANJI">あらゆる　ものが　だす　波動を
読みとることで　１キロ先に　いる
相手の　気持ちも　理解できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_449_000">
		<language name="JPN">はなの　あなを　ぴたりと　とじてから
すなのなかを　あるくように　すすむ。
１０ぴきていどの　むれで　くらす。</language>
		<language name="JPN_KANJI">鼻の　穴を　ピタリと　閉じてから
砂の中を　歩くように　進む。
１０匹程度の　群れで　暮らす。</language>
	</row>

	<row id="ZKN_COMMENT_01_450_000">
		<language name="JPN">いがいと　おこりっぽい　ポケモンで
くちを　おおきく　あけることで
まわりに　つよさを　アピールする。</language>
		<language name="JPN_KANJI">意外と　怒りっぽい　ポケモンで
口を　大きく　開けることで
まわりに　強さを　アピールする。</language>
	</row>

	<row id="ZKN_COMMENT_01_451_000">
		<language name="JPN">かんそうした　とちに　くらし
いちねんかん　なにも　たべずに
えものを　まちぶせ　できる。</language>
		<language name="JPN_KANJI">乾燥した　土地に　暮らし
一年間　なにも　食べずに
獲物を　待ちぶせ　できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_452_000">
		<language name="JPN">じまんの　パワーで　あいてを
ばらばらに　できるのに　さらに
もうどくで　とどめを　さすのだ。</language>
		<language name="JPN_KANJI">自慢の　パワーで　相手を
ばらばらに　できるのに　さらに
猛毒で　とどめを　刺すのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_453_000">
		<language name="JPN">どくぶくろを　ふくらませて　ならし
あたりに　ぶきみな　おとが　ひびかせ
あいてが　ひるむと　どくづきをする。</language>
		<language name="JPN_KANJI">毒袋を　ふくらませて　鳴らし
辺りに　不気味な　音が　響かせ
相手が　ひるむと　どくづきをする。</language>
	</row>

	<row id="ZKN_COMMENT_01_454_000">
		<language name="JPN">ドクロッグが　たたかいの　まえに
のどを　ならすのは　どくぶくろに
ためこんだ　どくを　ねりこむためだ。</language>
		<language name="JPN_KANJI">ドクロッグが　戦いの　前に
のどを　鳴らすのは　毒袋に
ためこんだ　毒を　練りこむためだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_455_000">
		<language name="JPN">しょくしゅで　きのえだに　まきつき
だえきの　あまい　かおりで　えものが
さそわれてくるのを　まっている。</language>
		<language name="JPN_KANJI">触手で　木の枝に　巻きつき
だ液の　甘い　香りで　獲物が
誘われてくるのを　待っている。</language>
	</row>

	<row id="ZKN_COMMENT_01_456_000">
		<language name="JPN">からだの　よこがわにある　ラインは
たいようのひかりを　ためておける。
よるになると　あざやかに　かがやく。</language>
		<language name="JPN_KANJI">体の　横側にある　ラインは
太陽の光を　ためておける。
夜になると　鮮やかに　輝く。</language>
	</row>

	<row id="ZKN_COMMENT_01_457_000">
		<language name="JPN">ながい　ひれを　あしのように
つかって　かいていを　はっている。
ランターンと　えものを　とりあう。</language>
		<language name="JPN_KANJI">長い　ヒレを　足のように
使って　海底を　はっている。
ランターンと　獲物を　取り合う。</language>
	</row>

	<row id="ZKN_COMMENT_01_458_000">
		<language name="JPN">せなかの　もようは　ちいきによって
ことなっている。テッポウオの　むれに
まざって　およぐことが　おおい。</language>
		<language name="JPN_KANJI">背中の　模様は　地域によって
異なっている。テッポウオの　群れに
混ざって　泳ぐことが　多い。</language>
	</row>

	<row id="ZKN_COMMENT_01_459_000">
		<language name="JPN">にんげんに　きょうみが　あるのか
ゆきやまで　あしあとを　みつけると
そのまわりに　あつまってくる。</language>
		<language name="JPN_KANJI">人間に　興味が　あるのか
雪山で　足跡を　見つけると
そのまわりに　集まって来る。</language>
	</row>

	<row id="ZKN_COMMENT_01_460_000">
		<language name="JPN">ゆきのはなが　さくころ　どこからか
すがたを　あらわし　はながちると
また　どこかに　すがたを　かくす。</language>
		<language name="JPN_KANJI">雪の花が　咲くころ　どこからか
姿を　現し　花が散ると
また　どこかに　姿を　隠す。</language>
	</row>

	<row id="ZKN_COMMENT_01_461_000">
		<language name="JPN">ツメで　いしに　サインをのこし
コミュニケーションを　とりながら
れいけいプレイで　てきを　おいこむ。</language>
		<language name="JPN_KANJI">ツメで　石に　サインを残し
コミュニケーションを　とりながら
連携プレイで　敵を　追いこむ。</language>
	</row>

	<row id="ZKN_COMMENT_01_462_000">
		<language name="JPN">つよすぎる　じりょくを　だして
ジバコイルどうし　ひきよせあって
まったく　うごけなくなったりする。</language>
		<language name="JPN_KANJI">強すぎる　磁力を　だして
ジバコイル同士　引き寄せあって
まったく　動けなくなったりする。</language>
	</row>

	<row id="ZKN_COMMENT_01_463_000">
		<language name="JPN">だえきには　どんな　ものを　とかす
せいぶんが　たっぷり　ふくまれており
なめられると　いつまでも　しびれる。</language>
		<language name="JPN_KANJI">だえきには　どんな　物を　溶かす
成分が　たっぷり　含まれており
なめられると　いつまでも　しびれる。</language>
	</row>

	<row id="ZKN_COMMENT_01_464_000">
		<language name="JPN">きんにくを　ちからを　こめて
しゅんかんてきに　ふくらませることで
てにした　いしを　ふんしゅつできる。</language>
		<language name="JPN_KANJI">筋肉を　力を　込めて
瞬間的に　膨らませることで
手にした　石を　噴出できる。</language>
	</row>

	<row id="ZKN_COMMENT_01_465_000">
		<language name="JPN">うでを　たべられても　へっちゃら。
さいせいのうりょくが　たかいので
あっ　というまに　もとどおりになる。</language>
		<language name="JPN_KANJI">腕を　食べられても　へっちゃら。
再生能力が　高いので
あっ　というまに　元通りになる。</language>
	</row>

	<row id="ZKN_COMMENT_01_466_000">
		<language name="JPN">あいてに　シッポのさきを　おしつけ
しゅんじに　２まんボルト　いじょうの
こうあつ　でんりゅうを　おくりこむ。</language>
		<language name="JPN_KANJI">相手に　シッポの先を　押しつけ
瞬時に　２万ボルト　以上の
高圧　電流を　送りこむ。</language>
	</row>

	<row id="ZKN_COMMENT_01_467_000">
		<language name="JPN">うでのさきから　せっし２０００どの
ひのたまを　うちだすとき　からだは
ねつのため　ほのかに　しろくなる。</language>
		<language name="JPN_KANJI">腕の先から　摂氏２０００度の
火の玉を　撃ちだすとき　体は
熱のため　ほのかに　白くなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_468_000">
		<language name="JPN">おたがいの　そんざいを　みとめあい
むだに　あらそわない　ひとのために
さまざまな　めぐみを　わけあたえる。</language>
		<language name="JPN_KANJI">お互いの　存在を　認め合い
無駄に　争わない　人のために
様々な　恵みを　分け与える。</language>
	</row>

	<row id="ZKN_COMMENT_01_469_000">
		<language name="JPN">こうそくで　とんで　すれちがった
あいての　くびを　いっしゅんで
かみちぎる　たたかいかたを　このむ。</language>
		<language name="JPN_KANJI">高速で　飛んで　すれ違った
相手の　首を　一瞬で
かみちぎる　戦い方を　好む。</language>
	</row>

	<row id="ZKN_COMMENT_01_470_000">
		<language name="JPN">しょくぶつの　ような　さいぼうになり
たいないで　こうごうせいを　して
きれいな　くうきを　つくりだせる。</language>
		<language name="JPN_KANJI">植物の　ような　細胞になり
体内で　光合成を　して
きれいな　空気を　つくりだせる。</language>
	</row>

	<row id="ZKN_COMMENT_01_471_000">
		<language name="JPN">たいおんを　さげることで　ぜんしんの
たいもうを　こおらせて　するどく
とがった　ハリのようにして　とばす。</language>
		<language name="JPN_KANJI">体温を　さげることで　全身の
体毛を　凍らせて　鋭く
とがった　ハリのようにして　飛ばす。</language>
	</row>

	<row id="ZKN_COMMENT_01_472_000">
		<language name="JPN">おとをたてずに　そらを　まい
えものに　ちかづくと　いっしゅんで
きゅうしょを　ひとつき　するぞ！</language>
		<language name="JPN_KANJI">音をたてずに　空を　舞い
獲物に　近づくと　一瞬で
急所を　一突き　するぞ！</language>
	</row>

	<row id="ZKN_COMMENT_01_473_000">
		<language name="JPN">ひょうがきの　おわりに　きおんが
たかくなると　おおくの　マンムーが
すがたを　けしたと　いわれている。</language>
		<language name="JPN_KANJI">氷河期の　終わりに　気温が
高くなると　多くの　マンムーが
姿を　消したと　いわれている。</language>
	</row>

	<row id="ZKN_COMMENT_01_474_000">
		<language name="JPN">いじげんでも　かつやく　できるよう
プログラムを　しゅうせい　したが
ねらいどおりには　いかなかった。</language>
		<language name="JPN_KANJI">異次元でも　活躍　できるよう
プログラムを　修正　したが
ねらい通りには　いかなかった。</language>
	</row>

	<row id="ZKN_COMMENT_01_475_000">
		<language name="JPN">だれかを　まもろうと　したとき
ひじをのばし　かたなのように
へんか　させて　はげしく　たたかう。</language>
		<language name="JPN_KANJI">だれかを　守ろうと　したとき
ひじを伸ばし　刀のように
変化　させて　激しく　戦う。</language>
	</row>

	<row id="ZKN_COMMENT_01_476_000">
		<language name="JPN">チビノーズと　よばれる　３つの
ユニットを　じりょくを　つかって
じゆうじざいに　あやつっている。</language>
		<language name="JPN_KANJI">チビノーズと　呼ばれる　３つの
ユニットを　磁力を　使って
自由自在に　操っている。</language>
	</row>

	<row id="ZKN_COMMENT_01_477_000">
		<language name="JPN">だんりょくのある　からだの　なかに
いきばのない　たましいを　とりこんで
あのよに　つれていくと　いわれる。</language>
		<language name="JPN_KANJI">弾力のある　体の　中に
行き場のない　魂を　取り込んで
あの世に　連れていくと　言われる。</language>
	</row>

	<row id="ZKN_COMMENT_01_478_000">
		<language name="JPN">マイナス５０どの　いきを　ふきかけ
こおらせた　えものを　ひみつの
ばしょに　かざっていると　いわれる。</language>
		<language name="JPN_KANJI">マイナス５０度の　息を　吹きかけ
凍らせた　獲物を　秘密の
場所に　飾っていると　言われる。</language>
	</row>

	<row id="ZKN_COMMENT_01_479_000">
		<language name="JPN">でんきのような　からだは　いちぶの
きかいに　はいりこむことが　できる。
そして　そのからだで　いたずらする。</language>
		<language name="JPN_KANJI">電気のような　体は　一部の
機械に　入り込むことが　できる。
そして　その体で　いたずらする。</language>
	</row>

	<row id="ZKN_COMMENT_01_480_000">
		<language name="JPN">ユクシーが　とびまわったことで
ひとびとに　ものごとを　かいけつする
ちえ　というものが　うまれた。</language>
		<language name="JPN_KANJI">ユクシーが　飛び回ったことで
人々に　物事を　解決する
知恵　というものが　生まれた。</language>
	</row>

	<row id="ZKN_COMMENT_01_481_000">
		<language name="JPN">エムリットが　とびまわったことで
ひとびとに　いきるときの　よろこび
かなしみ　というものが　うまれた。</language>
		<language name="JPN_KANJI">エムリットが　飛び回ったことで
人々に　生きるときの　喜び
悲しみ　というものが　生まれた。</language>
	</row>

	<row id="ZKN_COMMENT_01_482_000">
		<language name="JPN">アグノムが　とびまわったことで
ひとびとに　なにかを　するための
けつい　というものが　うまれた。</language>
		<language name="JPN_KANJI">アグノムが　飛び回ったことで
人々に　なにかを　するための
決意　というものが　生まれた。</language>
	</row>

	<row id="ZKN_COMMENT_01_483_000">
		<language name="JPN">ディアルガの　しんぞうが　うごくと
じかんは　ながれていくと　されている
シンオウの　でんせつ　ポケモン。</language>
		<language name="JPN_KANJI">ディアルガの　心臓が　動くと
時間は　流れていくと　されている。
シンオウの　伝説　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_484_000">
		<language name="JPN">パルキアが　こきゅうを　するたびに
くうかんは　あんていすると　される
シンオウの　でんせつの　ポケモン。</language>
		<language name="JPN_KANJI">パルキアが　呼吸を　するたびに
空間は　安定すると　される。
シンオウの　伝説の　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_485_000">
		<language name="JPN">がんじょうな　はがねの　からだだが
じぶんが　はっする　こうねつの　ため
ところどころ　とけてしまっている。</language>
		<language name="JPN_KANJI">頑丈な　鋼の　体だが
自分が　発する　高熱の　ため
ところどころ　溶けてしまっている。</language>
	</row>

	<row id="ZKN_COMMENT_01_486_000">
		<language name="JPN">とくしゅな　ひょうざんや　がんせき
マグマから　じぶんの　すがたに　にた
ポケモンを　つくったと　いわれる。</language>
		<language name="JPN_KANJI">特殊な　氷山や　岩石　マグマから
自分の　姿に　似た　ポケモンを
つくったと　言われる。</language>
	</row>

	<row id="ZKN_COMMENT_01_487_000">
		<language name="JPN">あばれもの　ゆえ　おいだされたが
やぶれたせかいと　いわれる　ばしょで
しずかに　もとのせかいを　みていた。</language>
		<language name="JPN_KANJI">暴れ者　ゆえ　追い出されたが
破れた世界と　言われる　場所で
静かに　元の世界を　見ていた。</language>
	</row>

	<row id="ZKN_COMMENT_01_488_000">
		<language name="JPN">みかづきに　ちかい　よるほど
しっぽから　のびる　オーロラは
ながく　うつくしくなる。</language>
		<language name="JPN_KANJI">三日月に　近い　夜ほど
しっぽから　伸びる　オーロラは
長く　美しくなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_489_000">
		<language name="JPN">あたたかい　うみを　ただよっている。
どんな　とおくに　ながされても
うまれた　ばしょに　かならずもどる。</language>
		<language name="JPN_KANJI">暖かい　海を　漂っている。
どんな　遠くに　流されても
生まれた　場所に　かならず戻る。</language>
	</row>

	<row id="ZKN_COMMENT_01_490_000">
		<language name="JPN">うまれたときから　そなわっている
ふしぎな　ちからを　つかうと　どんな
ポケモンとも　こころが　かよいあう。</language>
		<language name="JPN_KANJI">生まれたときから　備わっている
不思議な　力を　使うと　どんな
ポケモンとも　心が　通い合う。</language>
	</row>

	<row id="ZKN_COMMENT_01_491_000">
		<language name="JPN">じぶんを　まもるために　まわりの
ひとや　ポケモンに　あくむをみせるが
ダークライに　わるぎは　ないのだ。</language>
		<language name="JPN_KANJI">自分を　守るために　まわりの
人や　ポケモンに　悪夢を見せるが
ダークライに　悪気は　ないのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_492_000">
		<language name="JPN">ひとに　やさしく　だきしめられ　
ありがとうの　きもちを　かんじると
ぜんしんの　はなが　ひらきだす。</language>
		<language name="JPN_KANJI">人に　優しく　抱きしめられ
ありがとうの　気持ちを　感じると
全身の　花が　開きだす。</language>
	</row>

	<row id="ZKN_COMMENT_01_493_000">
		<language name="JPN">なにも　ない　ばしょに　あった
タマゴのなかから　すがたを　あらわし
せかいを　うみだしたと　されている。</language>
		<language name="JPN_KANJI">なにも　ない　場所に　あった
タマゴの中から　姿を　現し
世界を　生み出したと　されている。</language>
	</row>

	<row id="ZKN_COMMENT_01_494_000">
		<language name="JPN">ビクティニが　むげんに　うみだす
エネルギーを　わけあたえてもらうと
ぜんしんに　パワーが　あふれだす。</language>
		<language name="JPN_KANJI">ビクティニが　無限に　生みだす
エネルギーを　わけあたえてもらうと
全身に　パワーが　あふれだす。</language>
	</row>

	<row id="ZKN_COMMENT_01_495_000">
		<language name="JPN">たいようの　ひかりを　あびると
いつもよりも　すばやく　うごける。
てよりも　ツルを　うまくつかう。</language>
		<language name="JPN_KANJI">太陽の　光を　浴びると
いつもよりも　すばやく　動ける。
手よりも　ツルを　うまく使う。</language>
	</row>

	<row id="ZKN_COMMENT_01_496_000">
		<language name="JPN">からだが　よごれると　はっぱで
こうごうせいが　できなくなるので
いつも　せいけつに　している。</language>
		<language name="JPN_KANJI">体が　汚れると　はっぱで
光合成が　できなくなるので
いつも　清潔に　している。</language>
	</row>

	<row id="ZKN_COMMENT_01_497_000">
		<language name="JPN">ジャローダの　けだかい　ひとみで
いすくめられても　へいきな　つよい
あいてにだけ　ほんきを　だす。</language>
		<language name="JPN_KANJI">ジャローダの　気高い　ひとみで
射すくめられても　平気な　強い
相手にだけ　本気を　だす。</language>
	</row>

	<row id="ZKN_COMMENT_01_498_000">
		<language name="JPN">やいた　きのみを　たべるのが
だいすきだが　こうふんしすぎて
ときどき　まっくろこげに　しちゃう。</language>
		<language name="JPN_KANJI">焼いた　きのみを　食べるのが
大好きだが　興奮しすぎて
ときどき　真っ黒焦げに　しちゃう。</language>
	</row>

	<row id="ZKN_COMMENT_01_499_000">
		<language name="JPN">たべるほどに　もやすものが　ふえて
いぶくろないの　ほのおが　つよまり
パワーも　どんどん　あふれだすのだ。</language>
		<language name="JPN_KANJI">食べるほどに　燃やすものが　増えて
胃袋内の　炎が　強まり
パワーも　どんどん　あふれだすのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_500_000">
		<language name="JPN">ヒゲの　ほのおが　もえあがるのは
きあいが　はいった　あかし。
かずおおくの　わざを　つかいこなす。</language>
		<language name="JPN_KANJI">ヒゲの　炎が　燃えあがるのは
気合が　はいった　証。
数多くの　技を　使いこなす。</language>
	</row>

	<row id="ZKN_COMMENT_01_501_000">
		<language name="JPN">おなかに　できる　ホタチは
たたかうとき　だけでなく　かたい
きのみを　わるときにも　つかう。</language>
		<language name="JPN_KANJI">おなかに　できる　ホタチは
戦うとき　だけでなく　固い
きのみを　割るときにも　使う。</language>
	</row>

	<row id="ZKN_COMMENT_01_502_000">
		<language name="JPN">きびしい　しゅぎょうの　すえ
フタチマルごとに　ことなる　かたの
ホタチさばきを　しゅうとく　する。</language>
		<language name="JPN_KANJI">厳しい　修行の　すえ
フタチマルごとに　異なる　型の
ホタチさばきを　習得する。</language>
	</row>

	<row id="ZKN_COMMENT_01_503_000">
		<language name="JPN">てきが　まばたきする　あいだに
まえあしに　ついた　アシガタナで
あいてを　きりつけ　もとにもどせる。</language>
		<language name="JPN_KANJI">敵が　瞬きする　あいだに
前足に　ついた　アシガタナで
相手を　切りつけ　元に戻せる。</language>
	</row>

	<row id="ZKN_COMMENT_01_504_000">
		<language name="JPN">けいかいしんが　つよく　かならず
いっぴきは　みはりを　しているのだが
うしろからの　てきには　きづかない。</language>
		<language name="JPN_KANJI">警戒心が　強く　必ず
一匹は　見張りを　しているのだが
後ろからの　敵には　気づかない。</language>
	</row>

	<row id="ZKN_COMMENT_01_505_000">
		<language name="JPN">たいないの　はっこうぶっしつで
めだまや　からだを　ひからせ
おそってきた　てきを　ひるませる。</language>
		<language name="JPN_KANJI">体内の　発行物質で
目玉や　体を　光らせ
襲ってきた　敵を　ひるませる。</language>
	</row>

	<row id="ZKN_COMMENT_01_506_000">
		<language name="JPN">ゆうもうな　ポケモンだが　あいての
つよさを　たしかめて　たたかいを
さける　かしこさも　あわせもつ。</language>
		<language name="JPN_KANJI">勇猛な　ポケモンだが　相手の
強さを　確かめて　戦いを
避ける　賢さも　併せ持つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_507_000">
		<language name="JPN">トレーナーを　たすけながら
ほかの　ポケモンの　せわもする
とても　ちゅうじつな　ポケモン。</language>
		<language name="JPN_KANJI">トレーナーを　助けながら
他の　ポケモンの　世話もする
とても　忠実な　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_508_000">
		<language name="JPN">ながい　たいもうに　つつまれると
ふゆやまでも　ひとばん　へいきなほど
あたたかく　とても　ここちよい。</language>
		<language name="JPN_KANJI">長い　体毛に　包まれると
冬山でも　一晩　平気なほど
暖かく　とても　心地よい。</language>
	</row>

	<row id="ZKN_COMMENT_01_509_000">
		<language name="JPN">かわいらしい　しぐさで　ゆだんさせ
だいじな　ものを　ぬすむのは　ひとの
こまった　ようすを　みたいから。</language>
		<language name="JPN_KANJI">かわいらしい　仕草で　油断させ
大事な　ものを　盗むのは　人の
困った　様子を　みたいから。</language>
	</row>

	<row id="ZKN_COMMENT_01_510_000">
		<language name="JPN">うつくしい　スタイルは　ぜんしんの
はったつした　きんにくの　おかげ。
おともたてずに　よるを　かけぬける。</language>
		<language name="JPN_KANJI">美しい　スタイルは　全身の
発達した　筋肉の　おかげ。
音もたてずに　夜を　駆けぬける。</language>
	</row>

	<row id="ZKN_COMMENT_01_511_000">
		<language name="JPN">きのみを　さがすのが　じょうずで
あちこちで　あつめて　なかまに　
わけあたえる　やさしさを　もつ。</language>
		<language name="JPN_KANJI">きのみを　探すのが　上手で
あちこちで　集めて　仲間に
わけあたえる　優しさを　もつ。</language>
	</row>

	<row id="ZKN_COMMENT_01_512_000">
		<language name="JPN">トゲのついた　しっぽを　ふりまわし
たたきつけて　あいてを　こうげき。
あたまの　はっぱは　とても　にがい。</language>
		<language name="JPN_KANJI">トゲのついた　しっぽを　振り回し
たたきつけて　相手を　攻撃。
頭の　はっぱは　とても　苦い。</language>
	</row>

	<row id="ZKN_COMMENT_01_513_000">
		<language name="JPN">ちのうが　たかく　きのみは
やいてから　たべる　しゅうせい。
ひとの　てつだいを　このんでいる。</language>
		<language name="JPN_KANJI">知能が　高く　きのみは
焼いてから　食べる　しゅうせい。
人の　手伝いを　好んでいる。</language>
	</row>

	<row id="ZKN_COMMENT_01_514_000">
		<language name="JPN">こうふんすると　あたまや　しっぽから
ひのこが　まいあがって　あつくなる。
なぜか　あまいものが　だいこうぶつ。</language>
		<language name="JPN_KANJI">興奮すると　頭や　しっぽから
火の粉が　舞いあがって　熱くなる。
なぜか　甘いものが　大好物。</language>
	</row>

	<row id="ZKN_COMMENT_01_515_000">
		<language name="JPN">あたまのふさに　ためこんだ　みずは
えいよう　たっぷり。しっぽをつかって
その　みずを　くさきに　かけている。</language>
		<language name="JPN_KANJI">頭の房に　ためこんだ　水は
栄養　たっぷり。しっぽを使って
その　水を　草木に　かけている。</language>
	</row>

	<row id="ZKN_COMMENT_01_516_000">
		<language name="JPN">みずが　きれいな　ばしょを　このむ。
あたまに　ためこんだ　みずがへると
しっぽから　すいあげて　ほきゅう。</language>
		<language name="JPN_KANJI">水が　きれいな　場所を　好む。
頭に　ためこんだ　水が減ると
しっぽから　吸いあげて　補給。</language>
	</row>

	<row id="ZKN_COMMENT_01_517_000">
		<language name="JPN">わるい　ゆめに　うなされている
ポケモンや　ひとの　まえに　あらわれ
そのゆめを　たべてしまう　ポケモン。</language>
		<language name="JPN_KANJI">悪い　夢に　うなされている
ポケモンや　人の　前に　現われ
その夢を　食べてしまう　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_518_000">
		<language name="JPN">おでこから　でる　ゆめのけむりは
たべた　ゆめの　ないようによって
さまざまな　いろに　かわるのだ。</language>
		<language name="JPN_KANJI">おでこから　でる　ゆめのけむりは
食べた　夢の　内容によって
さまざまな　色に　変わるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_519_000">
		<language name="JPN">とても　わすれっぽい　ポケモンで
トレーナーに　めいれい　されたのに
あたらしい　めいれいを　まっている。</language>
		<language name="JPN_KANJI">とても　忘れっぽい　ポケモンで
トレーナーに　命令　されたのに
新しい　命令を　待っている。</language>
	</row>

	<row id="ZKN_COMMENT_01_520_000">
		<language name="JPN">せかいの　どこに　いても
じぶんの　すの　ばしょは　わかるので
トレーナーとも　はぐれたりしない。</language>
		<language name="JPN_KANJI">世界の　どこに　いても
自分の　巣の　場所は　わかるので
トレーナーとも　はぐれたりしない。</language>
	</row>

	<row id="ZKN_COMMENT_01_521_000">
		<language name="JPN">あたまの　かざりを　ゆらして
いかく　してくる　オスだが
とぶのは　メスよりも　へただ。</language>
		<language name="JPN_KANJI">頭の　飾りを　揺らして
いかく　してくる　オスだが
飛ぶのは　メスよりも　へただ。</language>
	</row>

	<row id="ZKN_COMMENT_01_522_000">
		<language name="JPN">ほうでんすると　たてがみが　ひかる。
たてがみが　かがやく　かいすうや
リズムで　なかまと　かいわしている。</language>
		<language name="JPN_KANJI">放電すると　たてがみが　光る。
たてがみが　輝く　回数や
リズムで　仲間と　会話している。</language>
	</row>

	<row id="ZKN_COMMENT_01_523_000">
		<language name="JPN">はげしい　きしょうの　もちぬし。
あらぶると　たてがみから　かみなりを
しほうはっぽうに　ほうでんする。</language>
		<language name="JPN_KANJI">激しい　気性の　持ち主。
荒ぶると　たてがみから　雷を
四方八方に　放電する。</language>
	</row>

	<row id="ZKN_COMMENT_01_524_000">
		<language name="JPN">ろっかくけいの　あなは　みみ。
おとの　なるほうに　あるいていく
しゅうせいを　もっている。</language>
		<language name="JPN_KANJI">六角形の　穴は　耳。
音の　なるほうに　歩いていく
習性を　持っている。</language>
	</row>

	<row id="ZKN_COMMENT_01_525_000">
		<language name="JPN">げんきだと　コアが　とびだしてくる。
からだの　むきを　かえることなく
ぜんごさゆうに　すばやく　うごける。</language>
		<language name="JPN_KANJI">元気だと　コアが　飛びだしてくる。
体の　向きを　変えることなく
戦後左右に　すばやく　動ける。</language>
	</row>

	<row id="ZKN_COMMENT_01_526_000">
		<language name="JPN">とりこんだ　たいようこうせんを
エネルギーコアで　はんのう　させて
ひかりのたまとして　うちだしてくる。</language>
		<language name="JPN_KANJI">取りこんだ　太陽光線を
エネルギーコアで　反応　させて
光の玉として　撃ちだしてくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_527_000">
		<language name="JPN">コロモリの　はなを　くっつけた
からだに　ハートがたの　あとがつくと
いいことが　おこると　いわれている。</language>
		<language name="JPN_KANJI">コロモリの　鼻を　くっつけた
体に　ハート型の　跡がつくと
いいことが　起こると　いわれている。</language>
	</row>

	<row id="ZKN_COMMENT_01_528_000">
		<language name="JPN">コンクリートも　こわせるほどの
つよい　ちょうおんぱを　だすとき
しっぽが　はげしく　ふるえる。</language>
		<language name="JPN_KANJI">コンクリートも　壊せるほどの
強い　超音波を　だすとき
しっぽが　激しく　震える。</language>
	</row>

	<row id="ZKN_COMMENT_01_529_000">
		<language name="JPN">からだを　スピンさせることで
じそく５０キロの　スピードのまま
まっすぐ　じめんを　ほりすすむ。</language>
		<language name="JPN_KANJI">体を　スピンさせることで
時速５０キロの　スピードのまま
まっすぐ　地面を　掘り進む。</language>
	</row>

	<row id="ZKN_COMMENT_01_530_000">
		<language name="JPN">はがねになった　ツメと　あたまで
ドリルを　つくり　どんなに
ぶあつい　てっぱんも　つらぬく。</language>
		<language name="JPN_KANJI">鋼になった　ツメと　頭で
ドリルを　つくり　どんなに
分厚い　鉄板も　貫く。</language>
	</row>

	<row id="ZKN_COMMENT_01_531_000">
		<language name="JPN">みみの　しょっかくで　あいての
たいちょうや　タマゴから　ポケモンが
いつ　でてくるのかも　わかるのだ。</language>
		<language name="JPN_KANJI">耳の　触覚で　相手の
体調や　タマゴから　ポケモンが
いつ　でてくるのかも　わかるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_532_000">
		<language name="JPN">つねに　かくざいを　もちあるき
どぼくこうじを　てつだう。そだつと
おおきな　かくざいに　もちかえる。</language>
		<language name="JPN_KANJI">常に　角材を　持ち歩き
土木工事を　手伝う。育つと
大きな　角材に　持ち替える。</language>
	</row>

	<row id="ZKN_COMMENT_01_533_000">
		<language name="JPN">きたえあげた　きんにくの　もちぬし。
てっこつを　たくみに　あやつって
いっけんやを　かいたい　してくれる。</language>
		<language name="JPN_KANJI">鍛えあげた　筋肉の　持ち主。
鉄骨を　たくみに　操って
一軒家を　解体してくれる。</language>
	</row>

	<row id="ZKN_COMMENT_01_534_000">
		<language name="JPN">ちからに　たよらず　えんしんりょくを
うまく　いかして　コンクリートを
ふりまわす　わざを　つかいこなせる。</language>
		<language name="JPN_KANJI">力に　頼らず　遠心力を
うまく　活かして　コンクリートを
振り回せ　技を　使いこなせる。</language>
	</row>

	<row id="ZKN_COMMENT_01_535_000">
		<language name="JPN">ほほの　しんどうまくを　ふるわせ
ひとには　きこえない　おんぱを　だし
なかまたちに　きけんを　つたえる。</language>
		<language name="JPN_KANJI">ほほの　振動膜を　震わせ
人には　きこえない　音波を　だし
仲間たちに　危険を　伝える。</language>
	</row>

	<row id="ZKN_COMMENT_01_536_000">
		<language name="JPN">すいちゅうと　りくちで　くらしつつ
ながく　ねばねばする　ベロをつかって
あいての　うごきを　ふうじこめる。</language>
		<language name="JPN_KANJI">水中と　陸地で　暮らしつつ
長く　ねばねばする　ベロを使って
相手の　動きを　封じこめる。</language>
	</row>

	<row id="ZKN_COMMENT_01_537_000">
		<language name="JPN">コブに　ちからを　いれることで
バイブレーションが　はっせいして
パンチの　いりょくが　アップする。</language>
		<language name="JPN_KANJI">コブに　力を　いれることで
バイブレーションが　発生して
パンチの　威力が　アップする。</language>
	</row>

	<row id="ZKN_COMMENT_01_538_000">
		<language name="JPN">じぶんより　おおきな　あいてと
であうと　むしょうに　なげたくなる。
つよくなると　おびを　とりかえる。</language>
		<language name="JPN_KANJI">自分より　大きな　相手と
出会うと　無性に　投げたくなる。
強くなると　帯を　取り替える。</language>
	</row>

	<row id="ZKN_COMMENT_01_539_000">
		<language name="JPN">さいきょうの　からてチョップを
もとめて　やまおくに　こもって
ねむることなく　しゅぎょうする。</language>
		<language name="JPN_KANJI">最強の　からてチョップを
求めて　山奥に　こもって
眠ることなく　修行する。</language>
	</row>

	<row id="ZKN_COMMENT_01_540_000">
		<language name="JPN">はっぱから　ふくを　つくるので
ファッションデザイナーから
マスコットとして　にんきがある。</language>
		<language name="JPN_KANJI">はっぱから　服を　つくるので
ファッションデザイナーから
マスコットとして　人気がある。</language>
	</row>

	<row id="ZKN_COMMENT_01_541_000">
		<language name="JPN">うすぐらく　じめじめした　ばしょを
このみ　じぶんの　まわりにある
おちばを　たべて　いちにち　すごす。</language>
		<language name="JPN_KANJI">薄暗く　じめじめした　場所を
好み　自分の　周りにある
落ち葉を　食べて　一日　過ごす。</language>
	</row>

	<row id="ZKN_COMMENT_01_542_000">
		<language name="JPN">おさない　ポケモンを　みつけると
くちから　だす　ねんちゃくいとで
はっぱの　ふくを　ぬってあげる。</language>
		<language name="JPN_KANJI">幼い　ポケモンを　みつけると
口から　だす　粘着糸で
はっぱの　服を　縫ってあげる。</language>
	</row>

	<row id="ZKN_COMMENT_01_543_000">
		<language name="JPN">あたまと　しっぽの　しょっかくで
くうきのゆれを　かんじとり　えものの
いちや　ようすを　はあくしている。</language>
		<language name="JPN_KANJI">頭と　しっぽの　触覚で
空気の揺れを　感じ取り　獲物の
位置や　様子を　把握している。</language>
	</row>

	<row id="ZKN_COMMENT_01_544_000">
		<language name="JPN">じっとして　しんかの　エネルギーを
ためているが　てきが　ちかづくと
どくのトゲを　さすため　うごきだす。</language>
		<language name="JPN_KANJI">じっとして　進化の　エネルギーを
ためているが　敵が　近づくと
毒のトゲを　刺すため　動きだす。</language>
	</row>

	<row id="ZKN_COMMENT_01_545_000">
		<language name="JPN">えものを　くびのツメで　はさみこみ
みうごきを　とれなくしてから
もうどくを　あたえ　とどめを　さす。</language>
		<language name="JPN_KANJI">獲物を　首のツメで　挟みこみ
身動きを　とれなくしてから
猛毒を　与え　とどめを　刺す。</language>
	</row>

	<row id="ZKN_COMMENT_01_546_000">
		<language name="JPN">しゅうだんで　いると　おちつくのか
なかまを　みつけると　くっついて
いつのまにか　くものように　なる。</language>
		<language name="JPN_KANJI">集団で　いると　落ち着くのか
仲間を　みつけると　くっついて
いつのまにか　雲のように　なる。</language>
	</row>

	<row id="ZKN_COMMENT_01_547_000">
		<language name="JPN">つむじかぜと　ともに　あらわれて
いえのなかの　かぐを　うごかしたり
わたを　のこす　いたずらをする。</language>
		<language name="JPN_KANJI">つむじかぜと　ともに　現われて
家の　中の　家具を　動かしたり
綿を　残す　いたずらをする。</language>
	</row>

	<row id="ZKN_COMMENT_01_548_000">
		<language name="JPN">ぬけおちても　すぐに　はえてくる
あたまの　はっぱは　とても　にがいが
かじれば　すぐ　げんきに　なれる。</language>
		<language name="JPN_KANJI">抜け落ちても　すぐに　生えてくる
頭の　はっぱは　とても　苦いが
かじれば　すぐ　元気に　なれる。</language>
	</row>

	<row id="ZKN_COMMENT_01_549_000">
		<language name="JPN">あたまの　はなかざりから　はっする
かおりを　かぐと　リラックスできるが
ていれが　とても　むずかしい。</language>
		<language name="JPN_KANJI">頭の　花飾りから　発する
香りを　かぐと　リラックスできるが
手入れが　とても　難しい。</language>
	</row>

	<row id="ZKN_COMMENT_01_550_000">
		<language name="JPN">とても　らんぼうで　いつも　あかと
あおの　バスラオは　あらそっている。
たべると　いがいと　おいしいらしい。</language>
		<language name="JPN_KANJI">とても　乱暴で　いつも　あかと
あおの　バスラオは　争っている。
食べると　意外と　おいしいらしい。</language>
	</row>

	<row id="ZKN_COMMENT_01_551_000">
		<language name="JPN">たいおんを　さげないように
さばくの　あつい　すなに　もぐり
かくれながら　せいかつ　している。</language>
		<language name="JPN_KANJI">体温を　さげないように
砂漠の　熱い　砂に　潜り
隠れながら　生活　している。</language>
	</row>

	<row id="ZKN_COMMENT_01_552_000">
		<language name="JPN">うすい　まくで　おおわれている
りょうめは　まよなかでも　みえる。
すうひきの　むれで　くらしている。</language>
		<language name="JPN_KANJI">薄い　膜で　被われている
両目は　真夜中でも　みえる。
数匹の　群れで　暮らしている。</language>
	</row>

	<row id="ZKN_COMMENT_01_553_000">
		<language name="JPN">とても　きょうぼうな　ポケモン。
めのまえで　うごくものは　すべて
おそいかかり　かみくだこうとする。</language>
		<language name="JPN_KANJI">とても　凶暴な　ポケモン。
目の前で　動くものは　すべて
襲いかかり　かみくだこうとする。</language>
	</row>

	<row id="ZKN_COMMENT_01_554_000">
		<language name="JPN">ねるときは　てあしを　ひっこめ
たいないで　もえている　６００どの
ほのおも　ちいさくなり　おちつくよ。</language>
		<language name="JPN_KANJI">寝るときは　手足を　ひっこめ
体内で　燃えている　６００度の
炎も　小さくなり　落ち着くよ。</language>
	</row>

	<row id="ZKN_COMMENT_01_555_000">
		<language name="JPN">はげしい　たたかいで　きずつくと
いわのように　かたまり　もっこうして
こころを　とぎすませるのだ。</language>
		<language name="JPN_KANJI">激しい　戦いで　傷つくと
岩のように　固まり　黙考して
心を　研ぎ澄ませるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_556_000">
		<language name="JPN">リズミカルに　からだを　ゆすると
マラカスに　にた　おとが　なりひびき
おどろいた　ポケモンは　にげだす。</language>
		<language name="JPN_KANJI">リズミカルに　体を　揺すると
マラカスに　似た　音が　鳴り響き
驚いた　ポケモンは　逃げだす。</language>
	</row>

	<row id="ZKN_COMMENT_01_557_000">
		<language name="JPN">てごろな　サイズの　いしが　あると
くちから　えきたいを　ぶんぴつして
なかに　はいるための　あなをあける。</language>
		<language name="JPN_KANJI">てごろな　サイズの　石が　あると
口から　液体を　分泌して
中に　入るための　穴をあける。</language>
	</row>

	<row id="ZKN_COMMENT_01_558_000">
		<language name="JPN">いい　いわが　とれる　ばしょを
テリトリーに　したがる。せなかの
いわを　こわされると　おいだされる。</language>
		<language name="JPN_KANJI">いい　岩が　採れる　場所を
テリトリーに　したがる。背中の
岩を　壊されると　追いだされる。</language>
	</row>

	<row id="ZKN_COMMENT_01_559_000">
		<language name="JPN">がんじょうな　ずがいこつが　じまん。
いきなり　ずつきを　かましてくるが
おもさで　じぶんも　フラフラしてる。</language>
		<language name="JPN_KANJI">頑丈な　ずがいこつが　自慢。
いきなり　頭突きを　かましてくるが
重さで　自分も　フラフラしてる。</language>
	</row>

	<row id="ZKN_COMMENT_01_560_000">
		<language name="JPN">だっぴした　かわを　ずりあげて
ダメージを　へらしつつ　キック！
とさかが　おおきいほど　えらそうだ。</language>
		<language name="JPN_KANJI">脱皮した　皮を　ずりあげて
ダメージを　　減らしつつ　キック！
とさかが　大きいほど　偉そうだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_561_000">
		<language name="JPN">こだいとしの　まもりがみ。
いつも　おなじルートを　じゅんかいし
しんにゅうしゃを　みはっていた。</language>
		<language name="JPN_KANJI">古代都市の　守り神。
いつも　同じルートを　巡回し
侵入者を　見張っていた。</language>
	</row>

	<row id="ZKN_COMMENT_01_562_000">
		<language name="JPN">おはかに　まいそうされた　ひとの
たましいが　ポケモンに　へんかした。
しぬまえの　きおくが　のこっている。</language>
		<language name="JPN_KANJI">お墓に　埋葬された　人の
魂が　ポケモンに　変化した。
死ぬ前の　記憶が　残っている。</language>
	</row>

	<row id="ZKN_COMMENT_01_563_000">
		<language name="JPN">ほんものの　かんおけと　まちがえ
ちかよってきた　はかドロボウを
からだの　なかに　とじこめてしまう。</language>
		<language name="JPN_KANJI">本物の　かんおけと　間違え
近寄ってきた　墓ドロボウを
体の　中に　閉じこめてしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_564_000">
		<language name="JPN">カセキから　ふっかつした　ポケモン。
たっしゃに　およいで　ふかさ
１０００メートルまで　もぐっていた。</language>
		<language name="JPN_KANJI">化石から　復活した　ポケモン。
達者に　泳いで　深さ
１０００メートルまで　潜っていた。</language>
	</row>

	<row id="ZKN_COMMENT_01_565_000">
		<language name="JPN">はったつした　まえあしで　あいてを
ひっぱたき　きぜつさせると　カラや
ホネまで　まるごと　かみくだいた。</language>
		<language name="JPN_KANJI">発達した　前足で　相手を
ひっぱたき　気絶させると　カラや
ホネまで　まるごと　かみくだいた。</language>
	</row>

	<row id="ZKN_COMMENT_01_566_000">
		<language name="JPN">こだいの　かせきから　ふっかつした。
きのうえで　くらしているが　とべず
えだから　えだを　とびうつっていた。</language>
		<language name="JPN_KANJI">古代の　化石から　復活した。
木の上で　暮らしているが　飛べず
枝から　枝を　飛び移っていた。</language>
	</row>

	<row id="ZKN_COMMENT_01_567_000">
		<language name="JPN">とぶよりも　はしるほうが　とくいで
じそく４０キロで　かけぬけた
いきおいで　おおぞらに　はばたく。</language>
		<language name="JPN_KANJI">飛ぶよりも　走るほうが　得意で
時速４０キロで　駆けぬけた
勢いで　大空に　羽ばたく。</language>
	</row>

	<row id="ZKN_COMMENT_01_568_000">
		<language name="JPN">さらなる　ゴミを　もとめて
ポイすてをする　ひとを　つけまわす。
いつも　どくガスを　はきだしている。</language>
		<language name="JPN_KANJI">さらなる　ゴミを　求めて
ポイ捨てをする　人を　つけまわす。
いつも　毒ガスを　吐きだしている。</language>
	</row>

	<row id="ZKN_COMMENT_01_569_000">
		<language name="JPN">ゴミを　すいとっては　たいないで
あたらしい　しゅるいの　どくガスや
どくの　えきたいを　うみだしている。</language>
		<language name="JPN_KANJI">ゴミを　吸いとっては　体内で
新しい　種類の　毒ガスや
毒の　液体を　生みだしている。</language>
	</row>

	<row id="ZKN_COMMENT_01_570_000">
		<language name="JPN">あいてそっくりに　ばけているように
みせかけ　だましたり　おどろかして
そのすきに　にげだすことが　おおい。</language>
		<language name="JPN_KANJI">相手そっくりに　化けているように
みせかけ　だましたり　驚かして
そのすきに　逃げだすことが　多い。</language>
	</row>

	<row id="ZKN_COMMENT_01_571_000">
		<language name="JPN">ゾロアークを　とらえようとした
ひとを　マボロシの　けしきのなかに
とじこめ　こらしめた　といわれる。</language>
		<language name="JPN_KANJI">ゾロアークを　捕らえようとした
人を　マボロシの　景色の中に
閉じこめ　こらしめた　といわれる。</language>
	</row>

	<row id="ZKN_COMMENT_01_572_000">
		<language name="JPN">おたがいの　シッポで　あいてを
とことん　きれいに　してあげるのが
チラーミィどうしの　あいさつ。</language>
		<language name="JPN_KANJI">お互いの　シッポで　相手を
とことん　きれいに　してあげるのが
チラーミィ同士の　あいさつ。</language>
	</row>

	<row id="ZKN_COMMENT_01_573_000">
		<language name="JPN">チラチーノの　からだは　とくべつな
あぶらで　おおわれており　パンチなど
あいての　こうげきを　うけながす。</language>
		<language name="JPN_KANJI">チラチーノの　体は　特別な
脂で　被われており　パンチなど
相手の　攻撃を　受け流す。</language>
	</row>

	<row id="ZKN_COMMENT_01_574_000">
		<language name="JPN">なんでも　じっと　みつめている。
かんさつに　むちゅうに　なってしまい
こうげきに　きづかないことも　ある。</language>
		<language name="JPN_KANJI">なんでも　じっと　みつめている。
観察に　夢中に　なってしまい
攻撃に　きづかないことも　ある。</language>
	</row>

	<row id="ZKN_COMMENT_01_575_000">
		<language name="JPN">ほしあかりが　かがやく　よるに
ねている　こどもたちを　あやつって
あそぶ　はなしが　おおく　のこる。</language>
		<language name="JPN_KANJI">星明かりが　輝く　夜に
寝ている　こどもたちを　操って
遊ぶ　話が　多く　残る。</language>
	</row>

	<row id="ZKN_COMMENT_01_576_000">
		<language name="JPN">ほしの　うごきから　みらいを　よむ。
トレーナーの　じゅみょうを　しった
ゴチルゼルは　さけび　かなしむ。</language>
		<language name="JPN_KANJI">星の　動きから　未来を　読む。
トレーナーの　寿命を　知った
ゴチルゼルは　叫び　悲しむ。</language>
	</row>

	<row id="ZKN_COMMENT_01_577_000">
		<language name="JPN">からだが　とくしゅな　えきたいに
つつまれているので　どんな　きびしい
じょうきょうでも　へいきなのだ。</language>
		<language name="JPN_KANJI">体が　特殊な　液体に
包まれているので　どんな　厳しい
状況でも　平気なのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_578_000">
		<language name="JPN">ぶんれつした　２つの　のうみそで
おなじことを　かんがえると　だせる
サイコパワーは　さいこうと　なる。</language>
		<language name="JPN_KANJI">分裂した　２つの　脳みそで
同じことを　考えると　だせる
サイコパワーは　最高と　なる。</language>
	</row>

	<row id="ZKN_COMMENT_01_579_000">
		<language name="JPN">はっきした　サイコパワーを　つかい
とくしゅな　えきたいで　つくられた
うでを　あやつり　いわを　くだく。</language>
		<language name="JPN_KANJI">発揮した　サイコパワーを　使い
特殊な　液体で　つくられた
腕を　操り　岩を　砕く。</language>
	</row>

	<row id="ZKN_COMMENT_01_580_000">
		<language name="JPN">とぶよりも　およぐのが　とくいで
すいちゅうに　もぐっては　だいすきな
みずゴケを　うれしそうに　たべる。</language>
		<language name="JPN_KANJI">飛ぶよりも　泳ぐのが　得意で
水中に　潜っては　大好きな
水ゴケを　うれしそうに　食べる。</language>
	</row>

	<row id="ZKN_COMMENT_01_581_000">
		<language name="JPN">ゆうがな　みかけに　よらず
つばさで　ちからづよく　はばたき　
すうせんキロ　とびつづけられる。</language>
		<language name="JPN_KANJI">優雅な　みかけに　よらず
翼で　力強く　羽ばたき　
数千キロ　飛び続けられる。</language>
	</row>

	<row id="ZKN_COMMENT_01_582_000">
		<language name="JPN">あさひを　あびた　つららから
うまれたと　されている　ポケモン。
マイナス５０どの　いきを　はく。</language>
		<language name="JPN_KANJI">朝日を　浴びた　氷柱から
生まれたと　されている　ポケモン。
マイナス５０度の　息を　吐く。</language>
	</row>

	<row id="ZKN_COMMENT_01_583_000">
		<language name="JPN">あたりの　くうきを　ひやして
こおりの　つぶを　はっせい　させて
てきの　からだを　こおりつかせる。</language>
		<language name="JPN_KANJI">辺りの　空気を　冷やして
氷の　粒を　発生　させて
敵の　体を　氷つかせる。</language>
	</row>

	<row id="ZKN_COMMENT_01_584_000">
		<language name="JPN">たいりょうの　みずを　のみこんで
からだのなかで　ゆきぐもに　かえる。
おこると　もうふぶきを　まきおこす。</language>
		<language name="JPN_KANJI">大量の　水を　飲みこんで
体の中で　雪雲に　変える。
怒ると　猛吹雪を　まきおこす。</language>
	</row>

	<row id="ZKN_COMMENT_01_585_000">
		<language name="JPN">きせつが　かわったとき　だけでなく
きおんや　しつどに　よっても
からだのいろは　すこし　へんかする。</language>
		<language name="JPN_KANJI">季節が　変わったとき　だけでなく
気温や　湿度に　よっても
体の色は　少し　変化する。</language>
	</row>

	<row id="ZKN_COMMENT_01_586_000">
		<language name="JPN">きせつの　うつりかわりと　ともに
すみかを　かえるので　メブキジカが
はるをはこぶと　いう　ひともいる。</language>
		<language name="JPN_KANJI">季節の　移り変わりと　ともに
すみかを　変えるので　メブキジカが
春を運ぶと　いう　人もいる。</language>
	</row>

	<row id="ZKN_COMMENT_01_587_000">
		<language name="JPN">まくを　ひろげて　そらを　とびつつ
ほほの　でんきぶくろに　ためこんだ
でんきで　あいてを　かんでんさせる。</language>
		<language name="JPN_KANJI">膜を　広げて　空を　飛びつつ
ほほの　電気袋に　ためこんだ
電気で　相手を　感電させる。</language>
	</row>

	<row id="ZKN_COMMENT_01_588_000">
		<language name="JPN">チョボマキを　おそっているときに
でんきエネルギーを　あびると
なぜだか　しんか　してしまうのだ。</language>
		<language name="JPN_KANJI">チョボマキを　襲っているときに
電気エネルギーを　浴びると
なぜだか　進化　してしまうのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_589_000">
		<language name="JPN">チョボマキから　うばった　カラで
からだを　おおい　ガードしながら
２ほんの　ヤリで　つついてくる。</language>
		<language name="JPN_KANJI">チョボマキから　奪った　カラで
体を　覆い　ガードしながら
２本の　ヤリで　突いてくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_590_000">
		<language name="JPN">モンスターボール　そっくりの
もようで　ポケモンを　さそいこみ
どくのほうしを　ふきかけてくる。</language>
		<language name="JPN_KANJI">モンスターボール　そっくりの
模様で　ポケモンを　誘いこみ
毒の胞子を　吹きかけてくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_591_000">
		<language name="JPN">りょうての　かさを　うごかし
えものを　さそう　ダンスを　おどる。
じめじめした　ばしょを　このむ。</language>
		<language name="JPN_KANJI">両手の　かさを　動かし
獲物を　誘う　ダンスを　踊る。
じめじめした　場所を　好む。</language>
	</row>

	<row id="ZKN_COMMENT_01_592_000">
		<language name="JPN">ベールの　ような　てあしを　まきつけ
しびれさせると　８０００メートルの
しんかいに　つれこんで　ころすのだ。</language>
		<language name="JPN_KANJI">ベールの　ような　手足を　巻きつけ
しびれさせると　８０００メートルの
深海に　連れこんで　殺すのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_593_000">
		<language name="JPN">からだの　ほとんどが　かいすい。
かいていには　ブルンゲルが　しずめた
ふねで　できた　しろが　あるという。</language>
		<language name="JPN_KANJI">体の　ほとんどが　海水。
海底には　ブルンゲルが　沈めた
船で　できた　城が　あるという。</language>
	</row>

	<row id="ZKN_COMMENT_01_594_000">
		<language name="JPN">きずついたり　よわった　ポケモンを
ヒレで　やさしく　かかえながら
とくしゅな　ねんまくで　なおすのだ。</language>
		<language name="JPN_KANJI">傷ついたり　弱った　ポケモンを
ヒレで　優しく　抱えながら
特殊な　粘膜で　治すのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_595_000">
		<language name="JPN">じぶんでは　でんきを　つくれないので
ほかの　おおきな　ポケモンに
とりつき　せいでんきを　すいとる。</language>
		<language name="JPN_KANJI">自分では　電気を　つくれないので
他の　大きな　ポケモンに
とりつき　静電気を　吸いとる。</language>
	</row>

	<row id="ZKN_COMMENT_01_596_000">
		<language name="JPN">でんきを　おびた　いとで　つくる
バリアは　あいてを　しびれさせるので
まもるだけでなく　ぶきにもなる。</language>
		<language name="JPN_KANJI">電気を　帯びた　糸で　つくる
バリアは　相手を　しびれさせるので
守るだけでなく　武器にもなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_597_000">
		<language name="JPN">ほらあなの　てんじょうに　つきささり
いわの　てつぶんを　すいとる。
きけんがせまると　トゲを　うちだす。</language>
		<language name="JPN_KANJI">洞穴の　天井に　突きささり
岩の　鉄分を　吸いとる。
危険がせまると　トゲを　撃ちだす。</language>
	</row>

	<row id="ZKN_COMMENT_01_598_000">
		<language name="JPN">３ぼんの　しょくしゅを　たたきつけ
さらに　トゲを　とばして　あいてを
あとかたのこらず　ふんさいする。</language>
		<language name="JPN_KANJI">３本の　触手を　たたきつけ
さらに　トゲを　飛ばして　相手を
跡形残らず　粉砕する。</language>
	</row>

	<row id="ZKN_COMMENT_01_599_000">
		<language name="JPN">かならず　きまった　くみあわせの
２つの　からだを　かいてん　させて
エネルギーを　うみだしている。</language>
		<language name="JPN_KANJI">必ず　決まった　組み合わせの
２つの　体を　回転　させて
エネルギーを　生みだしている。</language>
	</row>

	<row id="ZKN_COMMENT_01_600_000">
		<language name="JPN">ちびギアと　でかギアに　わかれた。
こうげきのため　とばした　ちびギアが
もどってこないと　しんでしまう。</language>
		<language name="JPN_KANJI">ちびギアと　でかギアに　わかれた。
攻撃のため　飛ばした　ちびギアが
戻ってこないと　死んでしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_601_000">
		<language name="JPN">ちびギアを　こうそくかいてん　させ
あかいコアに　ためた　エネルギーを
ちびギアに　こめて　いっきにはなつ。</language>
		<language name="JPN_KANJI">ちびギアを　高速回転　させ
あかいコアに　ためた　エネルギーを
ちびギアに　こめて　一気に放つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_602_000">
		<language name="JPN">よわい　でんきしか　だせないので
たくさんの　シビシラスで　あつまり
きょうりょくな　でんきを　はなつ。</language>
		<language name="JPN_KANJI">弱い　電気しか　だせないので
たくさんの　シビシラスで　集まり
強力な　電気を　放つ。</language>
	</row>

	<row id="ZKN_COMMENT_01_603_000">
		<language name="JPN">あいてに　まきつき　まるい
はんてんから　でんきを　ながして
しびれたところを　まるかじりする。</language>
		<language name="JPN_KANJI">相手に　巻きつき　丸い
はん点から　電気を　流して
しびれたところを　まるかじりする。</language>
	</row>

	<row id="ZKN_COMMENT_01_604_000">
		<language name="JPN">きゅうばんに　なっている　くちで
はりついて　キバを　さしこみ
きょうりょくな　でんきを　ながす。</language>
		<language name="JPN_KANJI">吸盤に　なっている　口で
はりついて　キバを　刺しこみ
強力な　電気を　流す。</language>
	</row>

	<row id="ZKN_COMMENT_01_605_000">
		<language name="JPN">５０ねんまえ　ＵＦＯが
ついらくしたと　うわさされる
さばくから　やってきたと　いわれる。</language>
		<language name="JPN_KANJI">５０年前　ＵＦＯが
墜落したと　うわさされる
砂漠から　やってきたと　いわれる。</language>
	</row>

	<row id="ZKN_COMMENT_01_606_000">
		<language name="JPN">ゆびさきを　てんめつ　させて
かいわするらしいが　その　パターンは
まだ　かいどく　できていない。</language>
		<language name="JPN_KANJI">指先を　点滅　させて
会話するらしいが　その　パターンは
まだ　解読　できていない。</language>
	</row>

	<row id="ZKN_COMMENT_01_607_000">
		<language name="JPN">ふだん　ほのおは　きえているが
ひとや　ポケモンの　せいめいりょくを
すいとると　ほのおは　きらめく。</language>
		<language name="JPN_KANJI">普段　炎は　消えているが
人や　ポケモンの　生命力を
吸いとると　炎は　きらめく。</language>
	</row>

	<row id="ZKN_COMMENT_01_608_000">
		<language name="JPN">たましいを　すいとり　ひをともす。
ひとが　しぬのを　まつため
びょういんを　うろつくようになった。</language>
		<language name="JPN_KANJI">魂を　吸いとり　火を灯す。
人が　死ぬのを　待つため
病院を　うろつくようになった。</language>
	</row>

	<row id="ZKN_COMMENT_01_609_000">
		<language name="JPN">あやしげな　ほのおで　もやされた
たましいは　いきばを　なくし
この　よを　えいえんに　さまよう。</language>
		<language name="JPN_KANJI">怪しげな　炎で　燃やされた
魂は　行き場を　なくし
この　世を　永遠に　さまよう。</language>
	</row>

	<row id="ZKN_COMMENT_01_610_000">
		<language name="JPN">おおきな　キバは　まだ　もろく
おれたりするが　はえかわるごとに
かたく　じょうぶに　なっていく。</language>
		<language name="JPN_KANJI">大きな　キバは　まだ　もろく
折れたりするが　生え変わるごとに
硬く　丈夫に　なっていく。</language>
	</row>

	<row id="ZKN_COMMENT_01_611_000">
		<language name="JPN">キバは　にどと　はえかわらないので
たたかいおわると　かわらの　いわを
つかって　たんねんに　みがきあげる。</language>
		<language name="JPN_KANJI">キバは　二度と　生え変わらないので
戦い終わると　川原の　岩を
使って　丹念に　磨きあげる。</language>
	</row>

	<row id="ZKN_COMMENT_01_612_000">
		<language name="JPN">キバの　はかいりょくは　ばつぐん。
ふとくかたい　こうてつの　はしらも
いとも　かんたんに　きりさけるのだ。</language>
		<language name="JPN_KANJI">キバの　破壊力は　抜群。
太く硬い　鋼鉄の　柱も
いとも　簡単に　切りさけるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_613_000">
		<language name="JPN">はなみずは　けんこうの　バロメータ。
ちょうしが　いいと　ねばりづよくなり
こおりの　わざの　いりょくも　ます。</language>
		<language name="JPN_KANJI">鼻水は　健康の　バロメータ。
調子が　いいと　粘り強くなり
氷の　技の　威力も　増す。</language>
	</row>

	<row id="ZKN_COMMENT_01_614_000">
		<language name="JPN">きたの　つめたい　うみを　このむ。
くちから　はきだした　いきをこおらせ
うみのうえに　みちをつくり　あるく。</language>
		<language name="JPN_KANJI">北の　冷たい　海を　好む。
口から　吐きだした　息を凍らせ
海の上に　道をつくり　歩く。</language>
	</row>

	<row id="ZKN_COMMENT_01_615_000">
		<language name="JPN">こおりの　けっしょうで　できた
くさりをつかい　えものを　からめとり
マイナス１００どに　こおらせる。</language>
		<language name="JPN_KANJI">氷の　結晶で　できた
鎖を使い　獲物を　絡め取り
マイナス１００度に　凍らせる。</language>
	</row>

	<row id="ZKN_COMMENT_01_616_000">
		<language name="JPN">カブルモと　いっしょに　いるときに
でんきてきな　しげきを　うけると
おたがいの　からだが　しんかする。</language>
		<language name="JPN_KANJI">カブルモと　一緒に　いるときに
電気的な　刺激を　受けると
お互いの　体が　進化する。</language>
	</row>

	<row id="ZKN_COMMENT_01_617_000">
		<language name="JPN">からだが　かんそうすると　よわるので
ねんまくで　おおって　まもりつつ
どくえきを　とばして　たたかう。</language>
		<language name="JPN_KANJI">体が　乾燥すると　弱るので
粘膜で　覆って　守りつつ
毒液を　飛ばして　戦う。</language>
	</row>

	<row id="ZKN_COMMENT_01_618_000">
		<language name="JPN">あいてが　しびれてくれないときは
よそうがいの　すばやさで　からだを
くねらせ　とびはね　にげるのだ。</language>
		<language name="JPN_KANJI">相手が　しびれてくれないときは
予想外の　すばやさで　体を
くねらせ　飛び跳ね　逃げるのだ。</language>
	</row>

	<row id="ZKN_COMMENT_01_619_000">
		<language name="JPN">わざをくりだす　スピードが　じまん。
たとえ　パワーは　ひくくても
てかずの　おおさで　カバーする。</language>
		<language name="JPN_KANJI">技を繰りだす　スピードが　自慢。
たとえ　パワーは　低くても
手数の　多さで　カバーする。</language>
	</row>

	<row id="ZKN_COMMENT_01_620_000">
		<language name="JPN">りょうての　たいもうを　ムチのように
つかいこなし　れんぞくこうげきを
はじめると　だれにも　とめられない。</language>
		<language name="JPN_KANJI">両手の　体毛を　ムチのように
使いこなし　連続攻撃を
はじめると　だれにも　止められない。</language>
	</row>

	<row id="ZKN_COMMENT_01_621_000">
		<language name="JPN">ドリュウズや　イワークが　ほった
せまい　トンネルを　はしりまわって
するどいツメで　えものを　とらえる。</language>
		<language name="JPN_KANJI">ドリュウズや　イワークが　掘った
狭い　トンネルを　走りまわって
するどいツメで　獲物を　捕らえる。</language>
	</row>

	<row id="ZKN_COMMENT_01_622_000">
		<language name="JPN">こだいの　かがくりょくに　よって
ねんどから　つくられた　ポケモン。
すうせんねん　うごきつづける。</language>
		<language name="JPN_KANJI">古代の　科学力に　よって
粘土から　つくられた　ポケモン。
数千年　動き続ける。</language>
	</row>

	<row id="ZKN_COMMENT_01_623_000">
		<language name="JPN">ポケモンや　ひとを　まもるために
こだいじんに　よって　うみだされた。
なぞの　エネルギーで　かつどうする。</language>
		<language name="JPN_KANJI">ポケモンや　人を　守るために
古代人に　よって　生みだされた。
なぞの　エネルギーで　活動する。</language>
	</row>

	<row id="ZKN_COMMENT_01_624_000">
		<language name="JPN">じぶんが　きずついても　きにせず
しゅうだんで　ぜんしんの　はものを
くいこませ　あいてを　こうげきする。</language>
		<language name="JPN_KANJI">自分が　傷ついても　気にせず
集団で　全身の　刃物を
食いこませ　相手を　攻撃する。</language>
	</row>

	<row id="ZKN_COMMENT_01_625_000">
		<language name="JPN">すうひきの　コマタナを　たたかわせ
きずつき　うごけなくなった　えものを
まっぷたつにする　こわい　ポケモン。</language>
		<language name="JPN_KANJI">数匹の　コマタナを　戦わせ
傷つき　動けなくなった　獲物を
まっぷたつにする　怖い　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_626_000">
		<language name="JPN">みさかいなく　とっしん　しており
かれらの　テリトリーに　はいると
れっしゃでも　ふきとばされてしまう。</language>
		<language name="JPN_KANJI">見境なく　突進　しており
かれらの　テリトリーに　はいると
列車でも　吹き飛ばされてしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_627_000">
		<language name="JPN">おおきな　あいてに　たちむかうのは
ゆうかん　ではなく　むぼうだから。
でも　そうして　きたえ　つよくなる。</language>
		<language name="JPN_KANJI">大きな　相手に　立ち向かうのは
勇敢　ではなく　無謀だから。
でも　そうして　鍛え　強くなる。</language>
	</row>

	<row id="ZKN_COMMENT_01_628_000">
		<language name="JPN">なかまの　ためなら　どれだけ
きずつこうとも　たたかいを　やめない
ゆうかんな　おおぞらの　せんし。</language>
		<language name="JPN_KANJI">仲間の　ためなら　どれだけ
傷つこうとも　戦いを　やめない
勇敢な　大空の　戦士。</language>
	</row>

	<row id="ZKN_COMMENT_01_629_000">
		<language name="JPN">つばさは　ちいさく　まだ　とべない。
バルジーナが　あつめてきた
ガイコツで　おしりを　まもっている。</language>
		<language name="JPN_KANJI">翼は　小さく　まだ　飛べない。
バルジーナが　集めてきた
ガイコツで　おしりを　守っている。</language>
	</row>

	<row id="ZKN_COMMENT_01_630_000">
		<language name="JPN">おおぞらで　えんをえがきつつ　とび
えものを　みつけると　おそいかかって
すまで　かるがると　はこんでいく。</language>
		<language name="JPN_KANJI">大空で　円を描きつつ　飛び
獲物を　みつけると　襲いかかって
巣まで　軽々と　運んでいく。</language>
	</row>

	<row id="ZKN_COMMENT_01_631_000">
		<language name="JPN">しっぽから　とりこんだ　くうきを
ほのおにかえて　ベロのように　つかい
アイアントを　とかして　たべるぞ。</language>
		<language name="JPN_KANJI">しっぽから　取りこんだ　空気を
炎に変えて　ベロのように　使い
アイアントを　溶かして　食べるぞ。</language>
	</row>

	<row id="ZKN_COMMENT_01_632_000">
		<language name="JPN">てんてきの　クイタランに　たいして
みんなで　やくわりぶんたん　しながら　
はんげきして　すから　おいはらう。</language>
		<language name="JPN_KANJI">天敵の　クイタランに　対して
みんなで　役割分担　しながら　
反撃して　巣から　追い払う。</language>
	</row>

	<row id="ZKN_COMMENT_01_633_000">
		<language name="JPN">まわりの　ようすが　わからないので
てあたりしだいに　ぶつかっては
うごくものに　かみつき　たべまくる。</language>
		<language name="JPN_KANJI">周りの　様子が　わからないので
手当り次第に　ぶつかっては
動くものに　かみつき　食べまくる。</language>
	</row>

	<row id="ZKN_COMMENT_01_634_000">
		<language name="JPN">２つの　あたまは　なかが　わるく
あいてより　おおく　たべることで
しゅどうけんを　にぎろうと　する。</language>
		<language name="JPN_KANJI">２つの　頭は　仲が　悪く
相手より　多く　食べることで
主導権を　握ろうと　する。</language>
	</row>

	<row id="ZKN_COMMENT_01_635_000">
		<language name="JPN">うごく　ものに　はんのうして
おそいかかり　３つの　あたまで
くらいつくす　おそろしい　ポケモン。</language>
		<language name="JPN_KANJI">動く　ものに　反応して
襲いかかり　３つの　頭で
食らい尽くす　恐ろしい　ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_636_000">
		<language name="JPN">たいようから　うまれたと　いわれる。
しんかするとき　ツノから　ふきだした
ほのおで　ぜんしんを　つつみこむ。</language>
		<language name="JPN_KANJI">太陽から　生まれたと　いわれる。
進化するとき　ツノから　吹きだした
炎で　全身を　包みこむ。</language>
	</row>

	<row id="ZKN_COMMENT_01_637_000">
		<language name="JPN">たいようの　けしんと　される。
さむさが　きびしい　ふゆに　あらわれ
ふるえる　ポケモンたちを　すくった。</language>
		<language name="JPN_KANJI">太陽の　化身と　される。
寒さが　厳しい　冬に　現われ
震える　ポケモンたちを　救った。</language>
	</row>

	<row id="ZKN_COMMENT_01_638_000">
		<language name="JPN">はがねの　こころと　からだを　もつ。
ひとが　ポケモンを　きずつけたとき
なかまとともに　ひとを　こらしめた。</language>
		<language name="JPN_KANJI">鋼の　心と　体を　持つ。
人が　ポケモンを　傷つけたとき
仲間とともに　人を　こらしめた。</language>
	</row>

	<row id="ZKN_COMMENT_01_639_000">
		<language name="JPN">でんせつで　かたられる　ポケモン。
ポケモンを　まもるため　じまんの
パワーで　しろを　こわした。</language>
		<language name="JPN_KANJI">伝説で　語られる　ポケモン。
ポケモンを　守るため　自慢の
パワーで　城を　壊した。</language>
	</row>

	<row id="ZKN_COMMENT_01_640_000">
		<language name="JPN">すばやい　みのこなしで　あいてを
ほんろうして　ポケモンを　まもると
でんせつで　つたえられている。</language>
		<language name="JPN_KANJI">すばやい　身のこなしで　相手を
ほんろうして　ポケモンを　守ると
伝説で　伝えられている。</language>
	</row>

	<row id="ZKN_COMMENT_01_641_000">
		<language name="JPN">しほうはっぽうを　とびまわる。
このときに　だす　かぜは　つよすぎて
どんなものでも　ふきとばしてしまう。</language>
		<language name="JPN_KANJI">四方八方を　飛びまわる。
このときに　だす　風は　強すぎて
どんなものでも　吹きとばしてしまう。</language>
	</row>

	<row id="ZKN_COMMENT_01_642_000">
		<language name="JPN">おおぞらを　とびまわりながら
あちこちに　カミナリを　おとして
やまかじを　おこすので　きらわれる。</language>
		<language name="JPN_KANJI">大空を　飛びまわりながら
あちこちに　カミナリを　落として
山火事を　起こすので　嫌われる。</language>
	</row>

	<row id="ZKN_COMMENT_01_643_000">
		<language name="JPN">ほのおで　せかいを　もやしつくせる
でんせつの　ポケモン。しんじつの
せかいを　きずく　ひとを　たすける。</language>
		<language name="JPN_KANJI">炎で　世界を　燃やし尽くせる
伝説の　ポケモン。真実の
世界を　築く　人を　たすける。</language>
	</row>

	<row id="ZKN_COMMENT_01_644_000">
		<language name="JPN">いなずまで　せかいを　やきつくせる
でんせつの　ポケモン。りそうの
せかいを　つくる　ひとを　ほさする。</language>
		<language name="JPN_KANJI">稲妻で　世界を　焼き尽くせる
伝説の　ポケモン。理想の
世界を　つくる　人を　補佐する。</language>
	</row>

	<row id="ZKN_COMMENT_01_645_000">
		<language name="JPN">かぜや　かみなりを　とりこみ　かえた
エネルギーが　つちに　えいようを
あたえて　だいちを　ゆたかに　する。</language>
		<language name="JPN_KANJI">風や　雷を　取りこみ　変えた
エネルギーが　土に　栄養を
与えて　大地を　豊かに　する。</language>
	</row>

	<row id="ZKN_COMMENT_01_646_000">
		<language name="JPN">うしなった　からだを　しんじつと
りそうで　うめてくれる　えいゆうを
まつ　こおりの　でんせつポケモン。</language>
		<language name="JPN_KANJI">失った　体を　真実と
理想で　埋めてくれる　英雄を
待つ　氷の　伝説ポケモン。</language>
	</row>

	<row id="ZKN_COMMENT_01_647_000">
		<language name="JPN">かくごを　きめることで　ぜんしんに
ちからが　みなぎって　すばやくなり
とびはねると　ざんぞうが　みえる。</language>
		<language name="JPN_KANJI">覚悟を　決めることで　全身に
力が　みなぎって　すばやくなり
飛び跳ねると　残像が　みえる。</language>
	</row>

	<row id="ZKN_COMMENT_01_648_000">
		<language name="JPN">メロエッタの　かなでる　せんりつは
まわりの　ポケモンを　よろこばせたり
かなしませるほどの　パワーがある。</language>
		<language name="JPN_KANJI">メロエッタの　奏でる　旋律は
周りの　ポケモンを　喜ばせたり
悲しませるほどの　パワーがある。</language>
	</row>

	<row id="ZKN_COMMENT_01_649_000">
		<language name="JPN">３おくねんまえに　いた　ポケモン。
プラズマだんに　かいぞう　され
せなかに　ほうだいを　つけられた。</language>
		<language name="JPN_KANJI">３億年前に　いた　ポケモン。
プラズマ団に　改造　され
背中に　砲台を　つけられた。</language>
	</row>

	<row id="ZKN_COMMENT_01_650_000">
		<language name="JPN"> </language>
		<language name="JPN_KANJI"> </language>
	</row>

	<row id="ZKN_COMMENT_01_201_001">
		<language name="JPN">１ぴきで　いても　なにも　おきないが
２ひき　いじょうで　ならぶと
なにかの　ちからが　めばえるという。</language>
		<language name="JPN_KANJI">１匹で　いても　なにも　起きないが
２匹　以上で　並ぶと
なにかの　力が　芽生えるという。</language>
	</row>

	<row id="ZKN_COMMENT_01_201_002">
