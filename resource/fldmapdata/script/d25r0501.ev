  .text

  .include  "scr_seq_def.h"
  .include  "msg_d25r0501.h"
  .include  "d25r0501.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_d25r0501_item_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_d25r0501:
//  _END

/**************************************************************/
/*  アイテム入手（幽霊少女イベント）                          */
/**************************************************************/
EVENT_START   ev_d25r0501_item_01

  _TALK_START_SE_PLAY()

  //==================================//
  //モンスターボール非表示
  _FLAG_SET( FV_D25R0501_ITEM_01 )
  //幽霊少女表示
  _FLAG_RESET( FV_D25_GIRL2_01 )
  //==================================//

  //モンスターボール非表示
  _OBJ_DEL( D25R0501_ITEM_01 )

  //アニメ：主人公アイテム入手 【仮】アニメは仮です
  //_OBJ_ANIME( MMDL_ID_PLAYER, anm_itemget )

  //アイテム（みかづきのはね）入手    //【仮】アイテムは仮です
  _ITEM_EVENT_KEYWAIT( ITEM_MASUTAABOORU, 1 )

  //_OBJ_ANIME_WAIT()   //アニメ再生待ち

  //女の子出現
  _OBJ_ADD( D25R0501_GIRL2_01 )

  _TIME_WAIT ( 8 )

  //幽霊少女：……その　みかづきのはね
  _BALLOONWIN_OBJMSG_POS( msg_d25r0501_girl2_01, D25R0501_GIRL2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：主人公アイテム入手
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT ( 16 )

  //女の子を非表示
  _OBJ_DEL( D25R0501_GIRL2_01 )

  //========================================//
  //幽霊少女非表示
  _FLAG_SET( FV_D25_GIRL2_01 )
  //POSイベント進行
  $WK_SCENE_H05_POKE488 = 1
  //========================================//

EVENT_END


//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//主人公：アイテムゲット
//--------------------------------------------------------------------
_ANIME_LABEL  anm_itemget
  _ANIME_DATA AC_HERO_ITEMGET,1
  _ANIME_DATA ACMD_END,0


