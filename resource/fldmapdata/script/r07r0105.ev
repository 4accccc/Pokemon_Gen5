
//======================================================================
//                r07r0105.ev
//
//    スクリプトファイル：r07r0105用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_r07r0105.h"
  .include  "r07r0105.h"

  //@author fujimura_souichirou（鐘スクリプトにカップルイベント用の追記／エムリットイベント）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_r07r0105
_EVENT_DATA   ev_bg_r07r0105_bell
_EVENT_DATA   ev_pos_r07r0105_sppoke2_01
_EVENT_DATA   ev_r07r0105_sppoke2_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_r07r0105

  //エムリットを呼び出した状態でゾーンチェンジした場合、再度POSイベントから
  IF FLAG_OFF( FV_R07R0105_SPPOKE2_01 ) && $WK_SCENE_R07R0105_SPPOKE2_01 == 2 THEN

    //==================================//
    //エムリット非表示
    _FLAG_SET( FV_R07R0105_SPPOKE2_01 )
    //POS再配置
    $WK_SCENE_R07R0105_SPPOKE2_01 = 1
    //==================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/* タワーオブヘブン鐘                                         */
/**************************************************************/
EVENT_START   ev_bg_r07r0105_bell
{
  //プレイヤーネームを格納
  _PLAYER_NAME( 0 )

  //鐘を鳴らしますか？
  _PLAINWIN_MSG_DOWN( msg_r07r0105_chime_01 )
  _TALK_START_SE_PLAY()

  //はい・いいえ質問
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == 0 THEN
    
    IF FLAG_OFF( FE_FMISSION_EV_TOH_CLEAR ) THEN
      //フェスミッション　鐘を鳴らしたビーコン送信リクエスト
      _FMISSION_LOG_ACTION( FMISSION_LOG_ACT_TOWER_OF_HEAVEN )
      _FLAG_SET( FE_FMISSION_EV_TOH_CLEAR )
    ENDIF

    //BGMを押さえる
    _BGM_VOLUME_DOWN( 64, BGM_FADE_SHORT )
    _SE_PLAY( SEQ_SE_FLD_151 )

    //トレーナーは鐘を鳴らした
    _PLAINWIN_MSG_DOWN ( msg_r07r0105_chime_02  )

    DEFINE_LOCAL  BM_ANIME_ID1

    //鐘のアニメを作成
    _BMODEL_ANIME_CREATE( BM_ANIME_ID1, SCR_BMID_EVENT, 16, 7 )
    _BMODEL_ANIME_SET( BM_ANIME_ID1, 0 )
    _BMODEL_ANIME_WAIT ( BM_ANIME_ID1 )

    //鐘アニメ破棄
    _BMODEL_ANIME_DELETE( BM_ANIME_ID1 )

    _SE_WAIT()

    //BGMを戻す
    _BGM_VOLUME_RECOVER( BGM_FADE_MIDDLE )

    //鳴り響いた
    _PLAINWIN_MSG_DOWN ( msg_r07r0105_chime_03  )
    _LAST_KEYWAIT()
    _PLAINWIN_CLOSE()

    //カップルから依頼を受けている（途中のトレーナーを全て倒した）
    IF $WK_SCENE_C14R0301_BOY4_01 == 5 THEN

      //========================================//
      //イベント進行
      $WK_SCENE_C14R0301_BOY4_01 = 6
      //========================================//

    ENDIF

  ELSE

    _PLAINWIN_MSG_DOWN ( msg_r07r0105_chime_04  )
    _LAST_KEYWAIT()
    _PLAINWIN_CLOSE() 

  ENDIF
}
EVENT_END

/**************************************************************/
/*  POS：エムリット登場                                       */
/**************************************************************/
EVENT_START   ev_pos_r07r0105_sppoke2_01

  //システム：ふしぎな　けはいが　する……！
  _SYSWIN_MSG( msg_r07r0105_sppoke2_01, POS_DOWN )

  //あたりを調べる？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい

    _MSGWIN_CLOSE()

    //==================================//
    //エムリット表示
    _FLAG_RESET( FV_R07R0105_SPPOKE2_01 )
    //POSイベント進行
    $WK_SCENE_R07R0105_SPPOKE2_01 = 2
    //==================================//

    _TIME_WAIT ( 30 )  //間

    //エムリット：きょううん！
    _VOICE_PLAY( MONSNO_481, 0 ) 
    _PLAINWIN_MSG_DOWN( msg_r07r0105_sppoke2_02 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _PLAINWIN_CLOSE()

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

    //エムリット出現
    _OBJ_ADD( R07R0105_SPPOKE2_01 )

    //エムリット登場座標にジャンプ
    _OBJ_POS_CHANGE( R07R0105_SPPOKE2_01, 24, 9, 26, DIR_LEFT )

    //エムリット停止座標まで移動
    $LCW_POSZ += 2
    _OBJ_TRANS( R07R0105_SPPOKE2_01, LCW_POSX, 5, LCW_POSZ, 8*6 )

    //エムリット再配置（↑のコマンドだと接地しないので）
    _OBJ_POS_CHANGE( R07R0105_SPPOKE2_01, LCW_POSX, 5, LCW_POSZ, DIR_LEFT )

    //アニメ：エムリット振り向き
    _OBJ_ANIME( R07R0105_SPPOKE2_01, anm_common_turn_u )
    _TIME_WAIT( 8 )
    //プレイヤーの向きを取得
    _PLAYER_DIR_GET( LWK_DIR ) 
    //主人公が上を向いていない場合は上を向かせる
    IF $LWK_DIR != DIR_DOWN THEN
      //アニメ：主人公振り向き
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
    ENDIF
    _OBJ_ANIME_WAIT()

    _TIME_WAIT( 16 )

  ELSE    //いいえ
  
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

/**************************************************************/
/*  エムリット：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
/**************************************************************/
EVENT_START   ev_r07r0105_sppoke2_01

  _TALK_START_SE_PLAY()

  //エムリット：きょううん！
  _VOICE_PLAY( MONSNO_481, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_r07r0105_sppoke2_02, POS_DOWN )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  // Lv.60 エムリット
  _WILD_BTL_SET_LEGEND( MONSNO_481, 65 )

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //エムリット非表示
    _FLAG_SET( FV_R07R0105_SPPOKE2_01 )
    //POSイベント進行
    $WK_SCENE_R07R0105_SPPOKE2_01 = 3
    //==================================//
    _OBJ_DEL( R07R0105_SPPOKE2_01 )   //エムリットを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //エムリットを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合

    //==================================//
    //エムリットを捕獲した
    _FLAG_SET( FE_R07R0105_SPPOKE2_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

    //システム：エムリットは
    _SYSWIN_MSG( msg_r07r0105_sppoke2_03, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDSWITCH

EVENT_END


//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0


