  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c08r0101.h"
  .include  "c08r0101.h"
  .include  "skill_teach_scr_def.h"
  .include  "c08.h" //予約スクリプト用
  .include  "c08_def.h" //予約スクリプト用

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------
//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c08r0101_swleader7_01
_EVENT_DATA    ev_c08r0101_poke42_01
_EVENT_DATA    ev_scene_c08r0101_legend_01
_EVENT_DATA    ev_zone_c08r0101
_EVENT_DATA    ev_init_c08r0101
_EVENT_DATA_END

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c08r0101

//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c08r0101

  //イベント起動中ならキバコの配置を変更
  IF $WK_SCENE_C08R0101 == 1 THEN
    _OBJ_POS_CHANGE( C08R0101_POKE42_01, 14, 0, 10, DIR_LEFT )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*   SCENE_CHANGE：ジムクリア後イベント                                */
/**************************************************************/
EVENT_START   ev_scene_c08r0101_legend_01
  
  //アニメ：主人公シャガの前に移動
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_to_swleader8 )
  _TIME_WAIT(8*4)
  _OBJ_ANIME( C08R0101_SWLEADER7_01,anm_swleader8_look_player )
  _OBJ_ANIME_WAIT()
  
  //シャガ：では話そう
	_BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_01 , C08R0101_SWLEADER7_01 , POS_DEFAULT)
	_MSGWIN_CLOSE()
  
  //シャガWB分岐：２年前のことだ
	_BALLOONWIN_OBJMSG_WB( msg_c08_swleader7_02w , msg_c08_swleader7_02b , C08R0101_SWLEADER7_01 , POS_DEFAULT)
	_MSGWIN_CLOSE()
	
  //シャガWB分岐：なぜ分かたれたか
  _BALLOONWIN_OBJMSG_WB( msg_c08_swleader7_03w , msg_c08_swleader7_03b , C08R0101_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //アニメ：シャガ左を向く
  _OBJ_ANIME( C08R0101_SWLEADER7_01, anm_staystep_l)
  _OBJ_ANIME_WAIT()
  
  //シャガ：実は
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_04 , C08R0101_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //アニメ：シャガ下を向く
  _OBJ_ANIME( C08R0101_SWLEADER7_01, anm_staystep_r)
  _OBJ_ANIME_WAIT()
  
  //シャガ：ああ　遺伝子の
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_05 , C08R0101_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //【仮】飛行機の効果音
  _SE_PLAY( SEQ_SE_KOUKA_H )
  
  //========================================//
  //C08の曲を無音状態にセット
  _FLAG_SET( SYS_FLAG_BGM_C08_SILENT )
  //========================================//
  
  //BGMを変更
  //_START_EVENT_BGM_SILENT( 20 )
  _BGM_NOW_MAP_RECOVER()
  
  //プレーンギザウィン：ぶぅん
  _GIZAPLAINWIN_MSG_POS( msg_c08_event_01, POS_DOWN )
  
  //画面を揺らすデモを入れる
  _SHAKE_CAMERA(0,1,3,6,0,0,0,0)
  _OBJ_ANIME_WAIT()
  _SE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( C08R0101_SWLEADER7_01, anm_common_hatena)
  _OBJ_ANIME_WAIT()
  
  //シャガ：なにごと　だ？
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_06 , C08R0101_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //アニメ：シャガ退場・主人公退室準備
  _OBJ_ANIME( C08R0101_SWLEADER7_01, anm_swleader8_bye)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_bye_01)
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  //シャガ動作モデル非表示
  _OBJ_DEL(C08R0101_SWLEADER7_01)
  _SE_WAIT()
  
  //アニメ：主人公シャガの前に移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 9, 14, FORCE_TYPE_NOT, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  
  //========================================//
  //C08R0101伝説解説イベント終了
  $WK_SCENE_C08R0101 = 2
  //C08R0101シャガ非表示
  _FLAG_SET( FV_C08R0101_SWLEADER7_01 )
  //C08シャガ表示
  _FLAG_RESET( FV_C08_SWLEADER7_01 )
  //C08プラズマ団襲来イベント開始
  $WK_SCENE_C08_SWPLAZMA = 1
  //========================================//
  
  //予約スクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_C08_PLAZMA_COMMING_01 )
  
  //C08マップチェンジ（バージョンによって位置を分岐）
  {
   DEFINE_LOCAL LCWK_VERSION
   _GET_ROM_VERSION( LCWK_VERSION )
   
   IF $LCWK_VERSION == VERSION_B2 THEN
    _MAP_CHANGE( ZONE_ID_C08, 418, 162, DIR_DOWN )
   ELSE
    _MAP_CHANGE( ZONE_ID_C08, 418, 164, DIR_DOWN )
   ENDIF
  }
  
EVENT_END

//--------------------------------------------------------------------
//	主人公：シャガに隣接
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_to_swleader8
	_ANIME_DATA	AC_WALK_U_8F,3
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_U_8F,2
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	シャガ：主人公と向き合う
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader8_look_player
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：退場（１）
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_bye_01
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_D_8F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	シャガ：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader8_bye
	_ANIME_DATA	AC_WALK_D_4F,2
	_ANIME_DATA	AC_WALK_R_4F,1
	_ANIME_DATA	AC_WALK_D_4F,3
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*   C08R0101：シャガ一言メッセージ                                */
/**************************************************************/
EVENT_START   ev_c08r0101_swleader7_01

	//ゲームクリアしていたらドラゴン技教え
	IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
		_TALK_OBJ_START()
		_GLOBAL_CALL	SCRID_WAZA_TEACHER_DRAGON
	ELSE
	//未クリア
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08r0101_leader8a_07 )
	ENDIF

EVENT_END

/**************************************************************/
/*   C08R0101：キバコ一言メッセージ                                */
/**************************************************************/
EVENT_START   ev_c08r0101_poke42_01
  _EASY_TALK_POKEVOICE( MONSNO_541, msg_c08_poke43_01 )
EVENT_END

