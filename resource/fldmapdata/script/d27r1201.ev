//--------------------------------------------------------------------
_ANIME_LABEL	anm_rival_hate
	_ANIME_DATA	AC_STAY_WALK_U_4F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	プラズマ団01：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swplazma_bye_01
  _ANIME_DATA	AC_WALK_L_4F,1
  _ANIME_DATA	AC_WALK_D_4F,3
  _ANIME_DATA	AC_WALK_R_4F,1
  _ANIME_DATA	AC_WALK_D_4F,2
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	プラズマ団01：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swplazma_bye_02
  _ANIME_DATA	AC_WALK_R_4F,1
  _ANIME_DATA	AC_WALK_D_4F,4
  _ANIME_DATA	AC_WALK_L_4F,1
  _ANIME_DATA	AC_WALK_D_4F,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	ライバル：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_rival_bye_01
  _ANIME_DATA	AC_WALK_D_4F,3
  _ANIME_DATA	ACMD_END,0

/************************************************************/
/*				  BG：パスワード				*/
/************************************************************/
EVENT_START ev_bg_d27r1201_pass_01
{
  _TALK_START_SE_PLAY()
  //カードキー未所持
  IF FLAG_OFF( FE_D27_CARDKEY_01 ) THEN
    
    //カードキーがひつよう　そうだ
    _SYSWIN_MSG( msg_d27r1201_pass_01 , POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  //カードキー所持・未開放
  ELSIF $WK_SCENE_D27R1201_BARRIER_01 == 0 THEN
  
    //デバッグ用
    _HIDE_SHIP_PASSWORD_ID_GET( LOCALWORK10 )
    _DEBUG_PRINT_WK( LOCALWORK10 )
    
    //起動SE
    _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_01 )
    _SE_WAIT()
    
    //パスワードを入れますか？
    _SYSWIN_MSG( msg_d27r1201_pass_02 , POS_DOWN )
    _YES_NO_WIN( SCWK_ANSWER )
    
    //はい
    IF $SCWK_ANSWER == SCR_YES THEN
      _MSGWIN_CLOSE()
    
      //パスワード返り値
      DEFINE_LOCAL  LCW_PASSRESULT
      
      _HIDE_SHIP_PASSWORD_INPUT( LCW_PASSRESULT )
      
      //正解
      IF $LCW_PASSRESULT == TRUE THEN
        
        //正解SE
        _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_02 )

        //バリアが解除された！
        _SYSWIN_MSG( msg_d27r1201_switch_01 , POS_DOWN )
        _SE_WAIT()
        _AB_KEYWAIT_MARK()
        _MSGWIN_CLOSE()
        
        
        //バリア解除処理
        _HIDE_SHIP_BOW_GATE_OFF( 0 )
        _TIME_WAIT(8)
        _HIDE_SHIP_BOW_GATE_OFF( 1 )
        _TIME_WAIT(8)
        _HIDE_SHIP_BOW_GATE_OFF( 2 )
        _TIME_WAIT(8)
        _HIDE_SHIP_BOW_GATE_OFF( 3 )
        
        //すべてのバリアが解除され
        _SYSWIN_MSG( msg_d27r1201_switch_02 , POS_DOWN )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
        
        //========================================//
        //バリアーPOS無効
        $WK_SCENE_D27R1201_BARRIER_01 = 1
        //パスワード終了
        _FLAG_SET(FE_D27_PASSOPEN_01)
        //========================================//
      
      //不正解
      ELSE

        //不正解SE
        _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_03 )
        _SE_WAIT()
      
        _SYSWIN_MSG( msg_d27r1201_pass_03 , POS_DOWN )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
      ENDIF
    
    //いいえ
    ELSE
    _MSGWIN_CLOSE()
    
      
    ENDIF
  
  //パスワード開放後
  ELSE
    //すべてのバリアが解除され
    _SYSWIN_MSG( msg_d27r1201_switch_02 , POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
}
EVENT_END


/************************************************************/
/*					バリア演出				*/
/************************************************************/
EVENT_START ev_pos_d27r1201_barrier_01
  
  //アニメ：「！」
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_01 )
  _OBJ_ANIME_WAIT()
  
  //ビリビリSE再生
  _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_08 )
  
  //アニメ：下方向に移動
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_02 )
  _OBJ_ANIME_WAIT()
  
  _SE_WAIT()
  
  
EVENT_END

//--------------------------------------------------------------------
//	主人公：上を向いて「！」
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_barrier_01
  _ANIME_DATA	AC_DIR_U,1
  _ANIME_DATA	AC_MARK_GYOE,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：バリアーに弾かれる
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_barrier_02
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA	AC_STAY_WALK_U_4F,2
  _ANIME_DATA	AC_WALK_D_4F,2
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA	ACMD_END,0

/************************************************************/
/*					CALL：勝敗チェック				*/
/************************************************************/
ev_battle_check:	
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    
    //手持ちが0匹だったら
    _GET_PARTY_POKE_COUNT( SCWK_TEMP0, POKECOUNT_MODE_BATTLE_ENABLE )
    IF $SCWK_TEMP0 == 0 THEN
      _TEMOTI_POKEMON_KAIFUKU() //回復処理
    ENDIF
    
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET
