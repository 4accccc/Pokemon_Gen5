  .text

  .include  "scr_seq_def.h"
  .include  "msg_d27r1201.h"
  //.include  "d27r1201.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_pos_d27r1201_barrier_01
_EVENT_DATA    ev_bg_d27r1201_pass_01
_EVENT_DATA    ev_zone_d27r1201
_EVENT_DATA    ev_init_d27r1201
_EVENT_DATA    ev_recover_d27r1201
_EVENT_DATA_END

/************************************************************/
/*					ZONE_CHANGE_LABEL 						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r1201
  //
INIT_EVENT_END
/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r1201

  // ゲート状態設定
  _CALL sub_gate_set

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r1201

  // ゲート状態設定
  _CALL sub_gate_set

INIT_EVENT_END

// ゲート(バリアー)の状態をフラグを見て設定
sub_gate_set:
{
//パスワード解除済みならゲートを開放
  IF $WK_SCENE_D27R1201_BARRIER_01 == 1 THEN
    _HIDE_SHIP_GATE_SET( 0, 1 )
    _HIDE_SHIP_GATE_SET( 1, 1 )
    _HIDE_SHIP_GATE_SET( 2, 1 )
    _HIDE_SHIP_GATE_SET( 3, 1 )
  ENDIF
}
_RET


/************************************************************/
/*				  BG：パスワード				*/
/************************************************************/
EVENT_START ev_bg_d27r1201_pass_01
{
  _TALK_START_SE_PLAY()
  //カードキー未所持
  IF FLAG_OFF( FE_D27_CARDKEY_01 ) THEN
    
    //カードキーがひつよう　そうだ
    _SYSWIN_MSG( msg_d27r1201_pass_01 , POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  //カードキー所持・未開放
  ELSIF $WK_SCENE_D27R1201_BARRIER_01 == 0 THEN
  
    //【仮】デバッグ用
    _HIDE_SHIP_PASSWORD_ID_GET( LOCALWORK15 )
    _DEBUG_PRINT_WK( LOCALWORK15 )
    
    //パスワードを入れますか？
    _SYSWIN_MSG( msg_d27r1201_pass_02 , POS_DOWN )
    _YES_NO_WIN( SCWK_ANSWER )
    
    //はい
    IF $SCWK_ANSWER == SCR_YES THEN
      _MSGWIN_CLOSE()
    
      //パスワード返り値
      DEFINE_LOCAL  LCW_PASSRESULT
      
      _HIDE_SHIP_PASSWORD_INPUT( LCW_PASSRESULT )
      
      //正解
      IF $LCW_PASSRESULT == TRUE THEN
        
        //バリアが解除された！
        _SYSWIN_MSG( msg_d27r1201_switch_01 , POS_DOWN )
        _AB_KEYWAIT_MARK()
        _MSGWIN_CLOSE()
        
        
        //バリア解除処理
        _HIDE_SHIP_BOW_GATE_OFF( 3 )
        _TIME_WAIT(8)
        _HIDE_SHIP_BOW_GATE_OFF( 2 )
        _TIME_WAIT(8)
        _HIDE_SHIP_BOW_GATE_OFF( 1 )
        _TIME_WAIT(8)
        _HIDE_SHIP_BOW_GATE_OFF( 0 )
        
        //すべてのバリアが解除され
        _SYSWIN_MSG( msg_d27r1201_switch_02 , POS_DOWN )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
        
        //========================================//
        //バリアーPOS無効
        $WK_SCENE_D27R1201_BARRIER_01 = 1
        //パスワード終了
        _FLAG_SET(FE_D27_PASSOPEN_01)
        //========================================//
      
      //不正解
      ELSE
        _SYSWIN_MSG( msg_d27r1201_pass_03 , POS_DOWN )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
      ENDIF
      
    ENDIF
  
  //パスワード開放後
  ELSE
    //すべてのバリアが解除され
    _SYSWIN_MSG( msg_d27r1201_switch_02 , POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
}
EVENT_END


/************************************************************/
/*					バリア演出				*/
/************************************************************/
EVENT_START ev_pos_d27r1201_barrier_01
  
  //アニメ：「！」
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_01 )
  _OBJ_ANIME_WAIT()
  
  //ビリビリSE再生
  _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_08 )
  
  //アニメ：下方向に移動
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_02 )
  _OBJ_ANIME_WAIT()
  
  _SE_WAIT()
  
  
EVENT_END

//--------------------------------------------------------------------
//	主人公：上を向いて「！」
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_barrier_01
  _ANIME_DATA	AC_DIR_U,1
  _ANIME_DATA	AC_MARK_GYOE,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：バリアーに弾かれる
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_barrier_02
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA	AC_STAY_WALK_U_4F,2
  _ANIME_DATA	AC_WALK_D_4F,2
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA	ACMD_END,0

