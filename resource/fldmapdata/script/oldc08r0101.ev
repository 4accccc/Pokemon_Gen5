  .text

  .include  "scr_seq_def.h"
  .include  "msg_oldc08r0101.h"
  .include  "oldc08r0101.h"
  
  .include  "c08.h"
  .include  "c08_def.h"

//@author Suginaka Katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_reserve_oldc08r0101_event_01
_EVENT_DATA_END


/**************************************************************/
/*			過去イベント	アロエ・アーティ・ヤーコン		  */
/**************************************************************/
EVENT_START		ev_reserve_oldc08r0101_event_01

	//暗転復帰
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//カメラ操作　ちょっと上のほうを初期位置にする
	_CAMERA_MOVE( 9694,0,970636,622592,344064,622592,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_on )
	_OBJ_ANIME_WAIT()

	//旧アイリス出現
	_OBJ_ADD_EX( 10,9,DIR_LEFT,MMDL_ID_EVENTOBJ_00,OLD_LEADER8W,MV_DMY )

	_MAP_FADE_BLACK_IN()

	//カメラ操作　デフォ位置に移動
	_CAMERA_RECV_MOVE( 60 ) //一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_MAP_FADE_END_CHECK()

	//アイリス　小躍り
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_leader8w_act_01 )
	_OBJ_ANIME_WAIT()

	//アイリス：やったー！
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8w_01 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//シャガ：さすがだね
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_01 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アイリス：で　おじーちゃん
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8w_02 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//シャガ：うむ　むかしを　おもいだしてね
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_02 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//アイリス：うん！
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8w_03 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//シャガ　下を向く
	_OBJ_ANIME( OLDC08R0101_OLD_LEADER8B, anm_stay_d )
	_OBJ_ANIME_WAIT()

	//シャガ：うむ　おどろいたよ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_03 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アイリス　その場を跳ねる
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_jump_l )
	_OBJ_ANIME_WAIT()
	
	//アイリス：うん！　イッシュ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8w_04 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//シャガ　アイリスのほうをむく
	_OBJ_ANIME( OLDC08R0101_OLD_LEADER8B, anm_stay_r )
	_OBJ_ANIME_WAIT()
	
	//シャガ：わたしには　そんな
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_04 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アイリス：アデクの
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8w_05 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//シャガ：Ｎに　やぶれ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_05 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アイリス：アデクさん
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8w_06 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//シャガ：その　きもちを
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_06 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	
	//シャガ：チャンピオンに　なったのだ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_07 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	_MSGWIN_CLOSE()

	_OBJ_ANIME( OLDC08R0101_OLD_LEADER8B, anm_leader8b_act_01 )
	_OBJ_ANIME_WAIT()

	_OBJ_ANIME( OLDC08R0101_OLD_LEADER8B, anm_leader8b_act_02 )
	_OBJ_ANIME_WAIT()

	//アイリス　！マーク
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_gyoe )
	_OBJ_ANIME_WAIT()
	
	//アイリス：これ　あたらしい
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8w_07 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//アイリス　その場で回転⇒モデル削除⇒新モデルで追加
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_leader8w_act_02 )
	_OBJ_ANIME_WAIT()
	_OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
	_OBJ_ADD_EX( 10,9,DIR_LEFT,MMDL_ID_EVENTOBJ_00,OLD_SWCHAMPION,MV_DMY )
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_leader8w_act_02 )
	_OBJ_ANIME_WAIT()

	//アイリス：うわー！
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_swchampion_01 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//シャガ：だいじ　なのは
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_08 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	
	//シャガ：わたしたちの　おさない
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_09 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アイリス；おじーちゃんは
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_swchampion_02 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	
	//アイリス　その場一回転
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_leader8w_act_03 )
	_OBJ_ANIME_WAIT()
	
	//アイリス：あたしね　きめてるの
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_swchampion_03 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//シャガ：うむ！
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader8b_10 , OLDC08R0101_OLD_LEADER8B, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//暗転
	_CAMERA_MOVE( 9694,0,970636,622592,344064,622592,30 )
	
	//画面暗転処理
	_MAP_FADE_BLACK_OUT_SLOW()
	_MAP_FADE_END_CHECK()
	
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	
	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_C08_LINK_EVENT_RET )

	_CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
	_CAMERA_END()		//カメラ操作終了

	//マップチェンジ
	_MAP_CHANGE_NO_FADE( ZONE_ID_C08, 418, 0, 170, DIR_UP )


EVENT_END

