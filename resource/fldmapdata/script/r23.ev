
//======================================================================
//                r23.ev
//
//    スクリプトファイル：r23用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_r23.h"
  .include  "r23.h"

  //@author fujimura_souichirou（アグノムイベント）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_r23
_EVENT_DATA   ev_pos_r23_sppoke3_01
_EVENT_DATA   ev_r23_sppoke3_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_r23

  //アグノムを呼び出した状態でゾーンチェンジした場合、再度POSイベントから
  IF FLAG_OFF( FV_R23_SPPOKE3_01 ) && $WK_SCENE_R23_SPPOKE3_01 == 2 THEN

    //==================================//
    //アグノム非表示
    _FLAG_SET( FV_R23_SPPOKE3_01 )
    //POS再配置
    $WK_SCENE_R23_SPPOKE3_01 = 1
    //==================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  POS：アグノム登場                                         */
/**************************************************************/
EVENT_START   ev_pos_r23_sppoke3_01

  //システム：ふしぎな　けはいが　する……！
  _SYSWIN_MSG( msg_r23_sppoke3_01, POS_DOWN )

  //あたりを調べる？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい

    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //==================================//
    //アグノム表示
    _FLAG_RESET( FV_R23_SPPOKE3_01 )
    //POSイベント進行
    $WK_SCENE_R23_SPPOKE3_01 = 2
    //==================================//

    //プレイヤーの向きを取得
    _PLAYER_DIR_GET( LWK_DIR ) 

    //主人公が左を向いていない場合は左を向かせる
    IF $LWK_DIR != DIR_LEFT THEN
      //アニメ：主人公振り向き
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
      _OBJ_ANIME_WAIT()
    ENDIF

    _TIME_WAIT ( 30 )  //間

    //アグノム：きゅううん！
    _VOICE_PLAY( MONSNO_482, 0 ) 
    _PLAINWIN_MSG_UP( msg_r23_sppoke3_02 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _PLAINWIN_CLOSE()

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

    //アグノム出現
    _OBJ_ADD( R23_SPPOKE3_01 )

    //アグノム登場座標にジャンプ
    _OBJ_POS_CHANGE( R23_SPPOKE3_01, 575, 8, 90, DIR_RIGHT )

    //アグノム停止座標まで移動
    $LCW_POSX -= 2
    _OBJ_TRANS( R23_SPPOKE3_01, LCW_POSX, 6, LCW_POSZ, 8*4 )

    //アグノム再配置（↑のコマンドだと接地しないので）
    _OBJ_POS_CHANGE( R23_SPPOKE3_01, LCW_POSX, 6, LCW_POSZ, DIR_LEFT )

    //アニメ：アグノム振り向き
    _OBJ_ANIME( R23_SPPOKE3_01, anm_common_turn_d )
    _OBJ_ANIME_WAIT()

    _TIME_WAIT( 16 )

  ELSE    //いいえ

    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

/**************************************************************/
/*  アグノム：話しかけ（戦闘／倒した場合は殿堂入り後復帰）    */
/**************************************************************/
EVENT_START   ev_r23_sppoke3_01

  _TALK_START_SE_PLAY()

  //アグノム：きょううん！
  _VOICE_PLAY( MONSNO_482, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_r23_sppoke3_02, POS_DOWN )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  // Lv.60 アグノム
  _WILD_BTL_SET_LEGEND( MONSNO_482, 65 )

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //アグノム非表示
    _FLAG_SET( FV_R23_SPPOKE3_01 )
    //POSイベント進行
    $WK_SCENE_R23_SPPOKE3_01 = 3
    //==================================//
    _OBJ_DEL( R23_SPPOKE3_01 )   //アグノムを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //アグノムを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合

    //==================================//
    //アグノムを捕獲した
    _FLAG_SET( FE_R23_SPPOKE3_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

    //システム：アグノムは
    _SYSWIN_MSG( msg_r23_sppoke3_03, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDSWITCH

EVENT_END


//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0



