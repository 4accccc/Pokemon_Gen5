
//======================================================================
//                r09r0101.ev
//
//    スクリプトファイル：r09r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_r09r0101.h"
  .include  "r09r0101.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_init_r09r0101
_EVENT_DATA   ev_r09r0101_boy2_01
_EVENT_DATA   ev_r09r0101_woman2_01
_EVENT_DATA   ev_r09r0101_man3_01
_EVENT_DATA   ev_pos_r09r0101_man3_01
_EVENT_DATA_END

//主人公座標取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_r09r0101

  //ゲームクリア前ならば、出入り口前にストッパー配置
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    //出入り口前に男性を再配置
    _OBJ_POS_CHANGE( R09R0101_MAN3_01, 3, 0, 8, DIR_RIGHT )

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  男の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_r09r0101_boy2_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r09r0101_boy2_01 )
EVENT_END

/**************************************************************/
/*  女性：話しかけ                                             */
/**************************************************************/
EVENT_START   ev_r09r0101_woman2_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r09r0101_woman2_01 )
EVENT_END

/**************************************************************/
/*  ストッパー：話しかけ（クリアまで）                        */
/**************************************************************/
EVENT_START   ev_r09r0101_man3_01

  //ゲームクリア前か
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    //男性:シリンダーブリッジ　だがな
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r09r0101_man3_01 )

  ELSE

    //男性:ちょうさの　けっか▽
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r09r0101_man3_03 )

  ENDIF

EVENT_END

/**************************************************************/
/*  POS：ストッパーイベント（クリアまで）                     */
/**************************************************************/
EVENT_START   ev_pos_r09r0101_man3_01

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

  //主人公の位置で振り向き分岐
  IF $LCW_POSZ == 7 THEN
    //アニメ：主人公とストッパー向かい合う
    _OBJ_ANIME( R09R0101_MAN3_01, anm_stopper_gyoe_up )
    _TIME_WAIT( 40 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
    _OBJ_ANIME_WAIT()

  ELSIF $LCW_POSZ == 9 THEN
    //アニメ：主人公とストッパー向かい合う
    _OBJ_ANIME( R09R0101_MAN3_01, anm_stopper_gyoe_down )
    _TIME_WAIT( 40 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
    _OBJ_ANIME_WAIT()

  ENDIF

  //男性:シリンダーブリッジ　だがな
  _BALLOONWIN_OBJMSG_POS( msg_r09r0101_man3_02, R09R0101_MAN3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：主人公一歩下がり、ストッパー上を向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( R09R0101_MAN3_01, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

EVENT_END

//--------------------------------------------------------------------
//	ストッパー隣接：z7
//--------------------------------------------------------------------
_ANIME_LABEL	anm_stopper_gyoe_up
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	ストッパー隣接：z7
//--------------------------------------------------------------------
_ANIME_LABEL	anm_stopper_gyoe_down
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0


//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：左に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_r
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0


