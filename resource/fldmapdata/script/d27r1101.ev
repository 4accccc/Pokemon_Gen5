	_TALK_START_SE_PLAY()
	_BALLOONWIN_TALKOBJ_MSG( msg_d27r1101_swplazmam2_03_01)
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

EVENT_END

/************************************************************/
/*					話しかけ：プラズマ団員03_03  						*/
/************************************************************/
EVENT_START	ev_d27r1101_swplazmam_03_03

  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r1101_swplazmam3_03_01 )

EVENT_END

/************************************************************/
/*					話しかけ：プラズマ団員03_04  						*/
