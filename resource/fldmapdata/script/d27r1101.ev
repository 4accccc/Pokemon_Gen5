//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_d27r1101_swrival_01
_EVENT_DATA    ev_d27r1101_swplazmam_03_01
_EVENT_DATA    ev_d27r1101_swplazmam_03_02
_EVENT_DATA    ev_d27r1101_swplazmam_03_03
_EVENT_DATA    ev_d27r1101_swplazmam_03_04
_EVENT_DATA    ev_init_d27r1101
_EVENT_DATA    ev_recover_d27r1101
_EVENT_DATA    ev_zone_d27r1101
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*					ZONE_CHANGE_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r1101

  // 出口位置変更
  _CALL sub_exit_change

INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r1101

  // 出口位置変更
  _CALL sub_exit_change

INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r1101

  // 出口位置変更
  _CALL sub_exit_change

INIT_EVENT_END


// バージョン別で出口位置変更
sub_exit_change:
{
  DEFINE_LOCAL  version   // ROMバージョン

  // ROMバージョン取得
  _GET_ROM_VERSION( version )

  // B2クリア前
  IF $version == VERSION_B2  THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R1101_D27R1201_EXIT01, 0, 0, 0 )
  
  // W2クリア後
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R1101_D27R0201_EXIT01, 0, 0, 0 ) 
  ENDIF
}
_RET

/************************************************************/
/*					話しかけ：ライバル  						*/
/************************************************************/
EVENT_START	ev_d27r1101_swrival_01
  
  _RIVAL_NAME(1)
  _PLAYER_NAME(0)
  
  //乗船三回目
  IF FLAG_OFF( FE_D27R0101_SWRIVAL_3RD_TALK ) THEN
    //主人公名代入
    _PLAYER_NAME( 0 )
    //ライバル名代入
    _RIVAL_NAME( 1 )
    _TALK_OBJ_START()
    
    //ライバル：先に行け！
    _BALLOONWIN_OBJMSG_POS( msg_d27r1101_swrival_03_01 , D27R1101_SWRIVAL_01 ,POS_DEFAULT )
    
    //主人公方向取得
    _PLAYER_DIR_GET( LWK_DIR )
    
    //話しかけ方向で処理を分岐
    IF $LWK_DIR == DIR_LEFT THEN
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
    ELSE
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()
      
      //アニメ：ライバル右に向きなおす
      _OBJ_ANIME( D27R1101_SWRIVAL_01, anm_staystep_r )
      _OBJ_ANIME_WAIT()
    ENDIF
    
    //========================================//
    //搭乗三回目初回会話終了
    _FLAG_SET( FE_D27R0101_SWRIVAL_3RD_TALK )
    //========================================//
    
  //乗船三回目（二回目話しかけ）
  ELSE
    //主人公名代入
    _PLAYER_NAME( 0 )
    //ライバル名代入
    _RIVAL_NAME( 1 )
    _TALK_START_SE_PLAY()
    
    //オマエら！
    _BALLOONWIN_OBJMSG_POS( msg_d27r1101_swrival_03_02 , D27R1101_SWRIVAL_01 ,POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  ENDIF

EVENT_END

/************************************************************/
/*					話しかけ：プラズマ団員03_01  						*/
/************************************************************/
EVENT_START	ev_d27r1101_swplazmam_03_01
	
	_TALK_START_SE_PLAY()
	_BALLOONWIN_TALKOBJ_MSG( msg_d27r1101_swplazmam1_03_01)
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

EVENT_END

/************************************************************/
/*					話しかけ：プラズマ団員03_02  						*/
