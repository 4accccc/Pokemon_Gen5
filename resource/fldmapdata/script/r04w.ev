//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_r04w
_EVENT_DATA   ev_pos_r04w_swboss_02
_EVENT_DATA   ev_r04w_workman_01
_EVENT_DATA   ev_r04w_swboss_01
_EVENT_DATA   ev_r04w_bigrock_01
_EVENT_DATA   ev_bg_r04w_sign1_01
_EVENT_DATA   ev_bg_r04w_sign3_01
_EVENT_DATA   ev_bg_r04w_sign4_01
_EVENT_DATA   ev_bg_r04w_sign4_02
_EVENT_DATA   ev_r04w_poke628_01
_EVENT_DATA		ev_r04w_man2_01
_EVENT_DATA   ev_r04w_mountain_01
_EVENT_DATA   ev_r04w_woman2_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL LCW_POSX
DEFINE_LOCAL LCW_POSZ

//曜日取得変数
DEFINE_LOCAL LWK_WEEKCK


/************************************************************/
/*  ZONE_CHANGE_SCRIPT                                      */
/************************************************************/
INIT_EVENT_START  ev_zone_r04w

  //曜日を取得
  _GET_WEEK( LWK_WEEKCK )

  //月曜日ならば、ウォーグルが出現（１週間に１匹のみ）
  IF $LWK_WEEKCK == RTC_WEEK_MONDAY && FLAG_OFF( TMFLG_R04_POKE_567_633_MEET ) THEN

    //==================================//
    //ウォーグル表示
    _FLAG_RESET( FV_R04_POKE_567_633_01 )
    //==================================//

  //それ以外の曜日は非表示に
  ELSE

    //==================================//
    //ウォーグル表示
    _FLAG_SET( FV_R04_POKE_567_633_01 )
    //==================================//

  ENDIF

  //イベント進行状態を見てライブキャスターの状態をセット
  IF $WK_SCENE_D02R0101_SWLEADER1 == 0 && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //==================================//
    //ローカルライブキャスター・チェレン通話状態を変更
    _PERSON_STATE_SET_CHELEN( CHELEN_STATE_YAGURUMA )
    //==================================//
    
  ELSIF $WK_SCENE_D02R0101_SWLEADER1 != 0 && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //==================================//
    //ローカルライブキャスター・チェレン通話状態を変更
    _PERSON_STATE_SET_CHELEN( CHELEN_STATE_GYM )
    //==================================//
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*	R04		POS：アクロマと会話								  */
/**************************************************************/
EVENT_START  ev_pos_r04w_swboss_02
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  //主人公方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //一番左のグリッド
  IF $LCW_POSX == 407 THEN
    _OBJ_ANIME( R04W_SWBOSS_01, anm_swboss_commeing_x407_01 )
    _OBJ_ANIME_WAIT()
    
    _OBJ_ANIME( R04W_SWBOSS_01, anm_swboss_commeing_x407_02 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_swboss_guide_x407 )
    _OBJ_ANIME_WAIT()
  //真ん中のグリッド
  ELSIF $LCW_POSX == 405 THEN
    _OBJ_ANIME_AUTO( R04W_SWBOSS_01, 406,577, FORCE_TYPE_NOT, 8, DIR_LR )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( R04W_SWBOSS_01, anm_staystep_l )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    _OBJ_ANIME_WAIT()
  
  //いっこ右
  ELSIF $LCW_POSX == 406 THEN
    _OBJ_ANIME( R04W_SWBOSS_01, anm_swboss_commeing_x406_01 )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( R04W_SWBOSS_01, anm_staystep_l )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_swboss_guide_x406 )
    _OBJ_ANIME_WAIT()
  ELSE
    $LCW_POSZ -= 1
    _OBJ_ANIME_AUTO( R04W_SWBOSS_01, LCW_POSX,LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( R04W_SWBOSS_01, anm_staystep_d )
    _OBJ_ANIME_WAIT()
    
    _OBJ_ANIME_AUTO( R04W_SWBOSS_01, 406,577, FORCE_TYPE_ALL, 8, DIR_LR )
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 405,577, FORCE_TYPE_ALL, 8, DIR_UD )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( R04W_SWBOSS_01, anm_staystep_l )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //アクロマ：まってましたよ！
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_01, R04W_SWBOSS_01, POS_DEFAULT )
  //アクロマ：これはいわではなく
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_02, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アクロマ上を見る
  _OBJ_ANIME( R04W_SWBOSS_01, anm_staystep_u)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //アクロママシーン起動：SE再生・アクロマ芝居
  _SE_PLAY( SEQ_SE_SHINKA_W025  )
  _OBJ_ANIME( R04W_SWBOSS_01, anm_swboss_act)
  _OBJ_ANIME_WAIT()
  _SE_WAIT()
  
  //アニメ：イワパレス目が覚める
  _OBJ_ANIME( R04W_BIGROCK_01, anm_poke50_hatena)
  _OBJ_ANIME( R04W_BIGROCK_03, anm_poke50_gyoe)
  _OBJ_ANIME( R04W_BIGROCK_04, anm_staystep_d)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( R04W_BIGROCK_02, anm_poke50_gyoe)
  _OBJ_ANIME( R04W_BIGROCK_05, anm_staystep_d)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( R04W_BIGROCK_06, anm_poke50_gyoe)
  _OBJ_ANIME( R04W_BIGROCK_08, anm_staystep_d)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( R04W_BIGROCK_07, anm_staystep_d)
  _OBJ_ANIME_WAIT()

  //アニメ：イワパレス退場
  _OBJ_ANIME( R04W_BIGROCK_08, anm_poke50_bye_z580)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( R04W_BIGROCK_06, anm_poke50_bye_z581)
  _OBJ_ANIME( R04W_BIGROCK_01, anm_poke50_bye_z581)
  _OBJ_ANIME( R04W_BIGROCK_02, anm_poke50_bye_z581)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( R04W_BIGROCK_05, anm_poke50_bye_z581)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( R04W_BIGROCK_03, anm_poke50_bye_z581)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( R04W_BIGROCK_04, anm_poke50_bye_z581)
  _OBJ_ANIME( R04W_BIGROCK_07, anm_poke50_bye_z581)
  _OBJ_ANIME_WAIT()
  
  //アクロマ：……イワパレス
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_03, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アクロマテーマ曲再生
  _START_EVENT_BGM( SEQ_BGM_E_ACHROMA )
  
  //アニメ：アクロマ主人公の方を向く
  _OBJ_ANIME( R04W_SWBOSS_01, anm_staystep_l )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //アクロマ：プラズマ団はいいました
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_04, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アクロマ演技
  _OBJ_ANIME( R04W_SWBOSS_01, anm_swboss_act )
  _OBJ_ANIME_WAIT()
  
  //アクロマ：なまえは？
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_08, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //トレーナー戦
  _TRAINER_BTL_SET( TRID_SWBOSS_1_01, 0 )
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
  
  //アクロマ：なるほど！
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_11, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //どうぐ入手処理：いのちのたま
	_ITEM_EVENT_KEYWAIT(ITEM_TAURIN, 1)
	
	//アクロマ：くやしい！
	_PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_12, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //アクロマ退場
  _OBJ_ANIME_AUTO( R04W_SWBOSS_01, 406,563, FORCE_TYPE_ALL, 8, DIR_LR )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //イベント曲終了
  _END_EVENT_BGM()
  
  _OBJ_DEL( R04W_SWBOSS_01 )
  _OBJ_DEL( R04W_BIGROCK_01 )
  _OBJ_DEL( R04W_BIGROCK_02 )
  _OBJ_DEL( R04W_BIGROCK_03 )
  _OBJ_DEL( R04W_BIGROCK_04 )
  _OBJ_DEL( R04W_BIGROCK_05 )
  _OBJ_DEL( R04W_BIGROCK_06 )
  _OBJ_DEL( R04W_BIGROCK_07 )
  _OBJ_DEL( R04W_BIGROCK_08 )
  
  //==================================//
  
  //R04アクロマイベント終了
  $WK_SCENE_R04_SWBOSS = 3
  //R04アクロマ非表示
  _FLAG_SET( FV_R04_SWBOSS_01 )
  //R04おおきな岩非表示
  _FLAG_SET( FV_R04_BIGROCK_01 )
  //R04作業員表示
  _FLAG_RESET( FV_R04_WORKMAN_01 )
  
  //==================================//
  
EVENT_END

