  .text

  .include  "scr_seq_def.h"
  .include  "msg_r04w.h"
  .include  "r04w.h"
  
  //@author Mizuguchi_Mai
  //@author fujimura_souichirou（イベント移植／ウォーグルイベント）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_r04w
_EVENT_DATA   ev_pos_r04w_oldman1_02
_EVENT_DATA   ev_pos_r04w_swboss_02
_EVENT_DATA   ev_r04w_oldman1_01
_EVENT_DATA   ev_r04w_swboss_01
_EVENT_DATA   ev_r04w_bigrock_01
_EVENT_DATA   ev_bg_r04w_sign1_01
_EVENT_DATA   ev_bg_r04w_sign3_01
_EVENT_DATA   ev_bg_r04w_sign4_01
_EVENT_DATA   ev_bg_r04w_sign4_02
_EVENT_DATA   ev_r04w_poke628_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL LCW_POSX
DEFINE_LOCAL LCW_POSZ

//曜日取得変数
DEFINE_LOCAL LWK_WEEKCK


/************************************************************/
/*  ZONE_CHANGE_SCRIPT                                      */
/************************************************************/
INIT_EVENT_START  ev_zone_r04w

  //曜日を取得
  _GET_WEEK( LWK_WEEKCK )

  //月曜日ならば、ウォーグルが出現（１週間に１匹のみ）
  IF $LWK_WEEKCK == RTC_WEEK_MONDAY && FLAG_OFF( TMFLG_R04_POKE_567_633_MEET ) THEN

    //==================================//
    //ウォーグル表示
    _FLAG_RESET( FV_R04_POKE_567_633_01 )
    //==================================//

  //それ以外の曜日は非表示に
  ELSE

    //==================================//
    //ウォーグル表示
    _FLAG_SET( FV_R04_POKE_567_633_01 )
    //==================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  POS：かいりき入手                                         */
/**************************************************************/
EVENT_START  ev_pos_r04w_oldman1_02

  //アニメ：「！」
  _OBJ_ANIME( R04W_OLDMAN1_01, anm_common_gyoe  )
  _OBJ_ANIME_WAIT()

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
  $LCW_POSZ -= 1
  //アニメ：じいさん接近
  _OBJ_ANIME_AUTO( R04W_OLDMAN1_01, LCW_POSX,LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //じいさん：おい！トレーナー
  _BALLOONWIN_OBJMSG_POS( msg_r04w_stop_01, R04W_OLDMAN1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //じいさん：おせないけどな
  _BALLOONWIN_OBJMSG_POS( msg_r04w_stop_02, R04W_OLDMAN1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：もといた位置に戻る
  _OBJ_ANIME_AUTO( R04W_OLDMAN1_01, 403, 579, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //==================================//
  //R04のPOS無効
  $WK_SCENE_R04_POKE = 1
  //==================================//

EVENT_END

/**************************************************************/
/*  POS：アクロマと会話                                       */
/**************************************************************/
EVENT_START  ev_pos_r04w_swboss_02

  /*
  //カメラ移動
  _CAMERA_START()   //カメラ操作開始
  _CAMERA_PURGE()   //カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,28213248,0,38240256,24 )
  _CAMERA_WAIT_MOVE() //カメラ移動待ち
  */

  //アクロマ：まってましたよ！
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_01, R04W_SWBOSS_01, POS_DEFAULT )
  //アクロマ：これは
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_02, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：アクロマ上を見る
  _OBJ_ANIME( R04W_SWBOSS_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //アクロマ：ほら　めをさましました
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_03, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：アクロマ下を見る
  _OBJ_ANIME( R04W_SWBOSS_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  /*
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (24)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  */

  //==================================//
  //R04アクロマのPOS無効
  $WK_SCENE_R04_SWBOSS = 2
  //==================================//

EVENT_END

/**************************************************************/
/*  おじいさん：話しかけ                                      */
/**************************************************************/
EVENT_START  ev_r04w_oldman1_01

  //アクロマイベント終了後
  IF $WK_SCENE_R04_SWBOSS == 3 THEN
     _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r04w_stop_03 )
  //それ以外
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r04w_stop_02 )
  ENDIF

EVENT_END

/**************************************************************/
/*  アクロマ：話しかけ                                        */
/**************************************************************/
EVENT_START  ev_r04w_swboss_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r04w_swboss_04 )
EVENT_END

/**************************************************************/
/*  擬態イワパレス：話しかけ（戦闘）                          */
/**************************************************************/
EVENT_START  ev_r04w_bigrock_01

  //アクロマイベント起動中
  IF $WK_SCENE_R04_SWBOSS == 2 THEN
    //イワパレス・アクロマ戦をコール
    _CALL ev_vs_r04w_swboss
  //アクロマイベント以外
  ELSE
    _TALK_START_SE_PLAY()
    _PLAYER_NAME( 0 )
    _SYSWIN_MSG( msg_r04w_rock_01, POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF

EVENT_END

ev_vs_r04w_swboss:

  _TALK_START_SE_PLAY()

  //イワパレス：ぱれっしゅ！
  _VOICE_PLAY( MONSNO_569, 0 )
  _PLAINWIN_MSG_DOWN( msg_r04w_rock_02 )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //【仮】イワパレス戦をセット（レベルが仮）
  _WILD_BTL_SET_TALK( MONSNO_569, 30 )
  _WILD_LOSE_CHECK( SCWK_ANSWER )

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

  //勝利チェック
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    //大きな岩動作モデル削除
    _OBJ_DEL( R04W_BIGROCK_01 )
    _OBJ_DEL( R04W_BIGROCK_02 )
    _OBJ_DEL( R04W_BIGROCK_03 )
    _OBJ_DEL( R04W_BIGROCK_04 )
    _OBJ_DEL( R04W_BIGROCK_05 )
    _OBJ_DEL( R04W_BIGROCK_06 )
    _OBJ_DEL( R04W_BIGROCK_07 )
    _OBJ_DEL( R04W_BIGROCK_08 )

    //アクロマ隣接
    IF $LCW_POSX == 407 THEN
      $LCW_POSX -= 1
      _OBJ_POS_CHANGE( R04W_SWBOSS_01, LCW_POSX, 0, LCW_POSZ, DIR_RIGHT )
    ELSE
      $LCW_POSX += 1
      _OBJ_POS_CHANGE( R04W_SWBOSS_01, LCW_POSX, 0, LCW_POSZ, DIR_LEFT )
    ENDIF

    _WILD_WIN()
  ELSE
    _WILD_LOSE()
  ENDIF

  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

  //アニメ：主人公アクロマの方を向く
  IF $LCW_POSX == 407 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  ENDIF
  _OBJ_ANIME_WAIT()

  //【仮】リトライのリストに追加する必要あり。岩澤さんに報告
  _WILD_RETRY_CHECK( SCWK_ANSWER )

  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_WIN THEN
  //勝利した場合
    _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_05, R04W_SWBOSS_01, POS_DEFAULT )
  CASE SCR_WILD_BTL_RET_ESCAPE THEN
  //逃げた場合
    _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_07, R04W_SWBOSS_01, POS_DEFAULT )
  CASE SCR_WILD_BTL_RET_CAPTURE THEN
  //捕まえた場合
    _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_06, R04W_SWBOSS_01, POS_DEFAULT )
  ENDSWITCH

  //アクロマ：なまえは？
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_08, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //システムメッセージ：回復させた
  _PLAYER_NAME( 0 )
  _SYSWIN_MSG( msg_r04w_swboss_09, POS_DEFAULT )
  _SE_PLAY( SEQ_SE_RECOVERY )
  //回復処理
  _TEMOTI_POKEMON_KAIFUKU()

  _SE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //アクロマ：それでは
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_10, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //トレーナー戦
  _TRAINER_BTL_SET( TRID_SWBOSS_1_01, 0 )
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF

  //アクロマ：なるほど！
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_11, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //どうぐ入手処理：いのちのたま
	_ITEM_EVENT_KEYWAIT(ITEM_INOTINOTAMA, 1)

  //アクロマ：くやしい！
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_r04w_swboss_12, R04W_SWBOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

  _OBJ_ANIME_AUTO( R04W_SWBOSS_01, LCW_POSX, 559, FORCE_TYPE_NOT, 8, DIR_LR )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( R04W_SWBOSS_01 )

  //==================================//
  //R04アクロマイベント終了
  $WK_SCENE_R04_SWBOSS = 3
  //R04アクロマ非表示
  _FLAG_SET( FV_R04_SWBOSS_01 )
  //R04おおきな岩非表示
  _FLAG_SET( FV_R04_BIGROCK_01 )
  //==================================//

_RET

/**************************************************************/
/*  道路掲示板                                                */
/**************************************************************/
EVENT_START  ev_bg_r04w_sign1_01
  _EASY_BGWIN_MSG( msg_r04w_sign1_01, TYPE_ROAD )
EVENT_END

/**************************************************************/
/*  お得な掲示板                                              */
/**************************************************************/
EVENT_START  ev_bg_r04w_sign3_01
  _EASY_BGWIN_MSG( msg_r04w_sign3_01, TYPE_INFO )
  _FLAG_SET( MDL_FLAG_BOARD_R04_03 )
EVENT_END

/**************************************************************/
/*  施設掲示板01                                              */
/**************************************************************/
EVENT_START  ev_bg_r04w_sign4_01
  _EASY_BGWIN_MSG( msg_r04w_sign4_01, TYPE_POST )
EVENT_END

/**************************************************************/
/*  施設掲示板02                                              */
/**************************************************************/
EVENT_START  ev_bg_r04w_sign4_02
  _EASY_BGWIN_MSG( msg_r04w_sign4_02, TYPE_POST )
EVENT_END

/**************************************************************/
/*  ウォーグル：話しかけ（戦闘／毎週月曜日に出現）            */
/**************************************************************/
EVENT_START   ev_r04w_poke628_01

  _TALK_START_SE_PLAY()

  //ウォーグル：わっわっわっわ！！
  _VOICE_PLAY( MONSNO_567, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_r04w_poke628_01, POS_DOWN )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  //戦闘開始
  {
    DEFINE_LOCAL LWK_BTL_FLAG
    $LWK_BTL_FLAG = SCR_WILD_BTL_FLAG_WILD_TALK   //野生話しかけ戦闘メッセージ
    $LWK_BTL_FLAG |= SCR_WILD_BTL_FLAG_SPEABI3    //第３特性指定
    _WILD_BTL_SET_EX( MONSNO_567, 20, LWK_BTL_FLAG )   //Lv.20 ウォーグル
  }

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //ウォーグル非表示
    _FLAG_SET( FV_R04_POKE_567_633_01 )
    //フラグON
    _FLAG_SET( TMFLG_R04_POKE_567_633_MEET )
    //==================================//
    _OBJ_DEL( R04W_POKE628_01 )   //ウォーグルを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //ウォーグルを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //倒した場合、あるいは逃げた場合

    //システム：ウォーグルは
    _SYSWIN_MSG( msg_r04w_poke628_02, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDSWITCH

EVENT_END


