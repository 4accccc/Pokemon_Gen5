
//======================================================================
//                r07r0102.ev
//
//    スクリプトファイル：r07r0102用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_r07r0102.h"
  .include  "r07r0102.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_init_r07r0102
_EVENT_DATA   ev_r07r0102_woman3_01
_EVENT_DATA_END

//主人公の座標、方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/************************************************************/
/*  FIELD_INIT_SCRIPT                                       */
/************************************************************/
INIT_EVENT_START  ev_init_r07r0102

  //保育士に勝利していた場合、ユニットを再配置
  IF $WK_SCENE_C14R0301_BOY4_01 >= 3 && FLAG_OFF( FV_R07R0102_WOMAN3_01 ) THEN

    _OBJ_POS_CHANGE( R07R0102_WOMAN3_01, 14, 0, 7, DIR_DOWN )

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  保育士：話しかけ（カップルの鐘イベント）                  */
/**************************************************************/
EVENT_START   ev_r07r0102_woman3_01

  _TALK_OBJ_START()

  //バトル前
  IF $WK_SCENE_C14R0301_BOY4_01 == 2 THEN

    //保育士：いまの　あたし　むてき　よ！
    _BALLOONWIN_TALKOBJ_MSG( msg_r07r0101_woman3_01 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_CHILDCARE_08, 0 )

    //結果チェック
    _CALL ev_battle_check

    //保育士：どうして……　どうしてなの？▼
    _BALLOONWIN_TALKOBJ_MSG( msg_r07r0101_woman3_02 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //========================================//
    //イベント進行
    $WK_SCENE_C14R0301_BOY4_01 = 3
    //========================================//

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
    //アニメ：保育士移動
    IF $LCW_POSX == 14 && $LCW_POSZ == 7 THEN
      _OBJ_ANIME_AUTO( R07R0102_WOMAN3_01, 14, 9, FORCE_TYPE_NPC, 8, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( R07R0102_WOMAN3_01, anm_staystep_u )
      _OBJ_ANIME_WAIT()
    ELSE
      _OBJ_ANIME_AUTO( R07R0102_WOMAN3_01, 14, 7, FORCE_TYPE_NPC, 8, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( R07R0102_WOMAN3_01, anm_staystep_d )
      _OBJ_ANIME_WAIT()
    ENDIF

  //バトル後
  ELSIF $WK_SCENE_C14R0301_BOY4_01 >= 3 THEN

    //保育士：どうして……　どうしてなの？▼
    _BALLOONWIN_TALKOBJ_MSG( msg_r07r0101_woman3_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

ev_battle_check:
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET


//--------------------------------------------------------------------
//☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL  anm_staystep_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0


