/************************************************************/
/*						ふとっちょ				*/
/************************************************************/
EVENT_START	ev_h05_man3_02

  //クレセリアと戦闘後か？
  IF FLAG_ON( FE_H05_POKE488_BTL_01 ) && $LOCALWORK10 == 0 THEN
  
  	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_h05_oldwoman1_01 )
  
  //まだ戦闘前
  ELSE
  
  	//消える少女イベント起動後か？
  	IF FLAG_ON( FE_H05_LOOK_WANDERGIRL ) THEN
  	
  		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_h05_oldwoman1_02 )
  	
  	ELSE
  	
  		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_h05_oldwoman1_01 )
  	
  	ENDIF
  
  ENDIF

EVENT_END
