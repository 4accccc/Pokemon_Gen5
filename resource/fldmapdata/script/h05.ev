//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_h05
_EVENT_DATA   ev_h05_middleman1_01
_EVENT_DATA   ev_h05_man3_01
_EVENT_DATA   ev_pos_h05_poke488_01
_EVENT_DATA   ev_h05_poke488_01
_EVENT_DATA	ev_init_h05
_EVENT_DATA	ev_h05_man3_02
_EVENT_DATA	ev_pos_h05_wandergirl
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_h05

  //クレセリアを呼び出した状態でゾーンチェンジした場合、再度POSイベントから
  IF FLAG_OFF( FV_H05_POKE488 ) && $WK_SCENE_H05_POKE488 == 2 THEN

    //==================================//
    //クレセリア非表示
    _FLAG_SET( FV_H05_POKE488 )
    //POS再配置
    $WK_SCENE_H05_POKE488 = 1
    //==================================//

  ENDIF

  _FLAG_SET( FV_H05_WANDERGIRL )
  $WK_SCENE_H05_GIRL = 0

  //クレセリアとのイベント前の場合・消える少女イベント
  IF FLAG_OFF( FE_H05_POKE488_BTL_01 ) THEN
  
  	//20％の確率で
  	_GET_RND( SCWK_ANSWER, 100 )
  	_DEBUG_PRINT_WK( SCWK_ANSWER )
  	IF $SCWK_ANSWER < 20 THEN
		//消える少女みたフラグをリセット
  		_FLAG_RESET( FE_H05_LOOK_WANDERGIRL )
		//消える少女を表示
		_FLAG_RESET( FV_H05_WANDERGIRL )
		//POSイベントを有効
		$WK_SCENE_H05_GIRL = 1
  	ENDIF
  
  ENDIF

INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START	ev_init_h05
	//少女出現位置の隣からハイリンクに行き来したとき、少女に話しかけられてしまう問題の対処
	
	//少女が表示されているなら、チェック処理へ
	IF FLAG_OFF( FV_H05_WANDERGIRL ) THEN
		_CALL	ev_wandergirl_pos_chk
	ENDIF
	
INIT_EVENT_END

ev_wandergirl_pos_chk:
	{
	DEFINE_LOCAL	lwk_pos_x
	DEFINE_LOCAL	lwk_pos_z
	
	_PLAYER_POS_GET( lwk_pos_x, lwk_pos_z )	//自機の位置取得
	
	//自機の位置が少女出現位置と隣接しているなら、イベントを無効にする処理へ
	IF $lwk_pos_x == 147 && $lwk_pos_z == 36 THEN
		//少女の左隣り
		_CALL	ev_wandergirl_off
	ELSIF $lwk_pos_x == 148 && $lwk_pos_z == 35 THEN
		//少女の上隣り
		_CALL	ev_wandergirl_off
	ELSIF $lwk_pos_x == 149 && $lwk_pos_z == 36 THEN
		//少女の右隣り
		_CALL	ev_wandergirl_off
	ENDIF
	
	}
_RET

ev_wandergirl_off:
	//消える少女を削除し、イベントを無効にします
	_OBJ_DEL( H05_GIRL2_01 )
	_FLAG_SET( FV_H05_WANDERGIRL )
	$WK_SCENE_H05_GIRL = 0
_RET


/************************************************************/
/*  コイキング購入                                          */
/************************************************************/
EVENT_START   ev_h05_middleman1_01

  //購入済みかチェック
  IF FLAG_OFF( FE_H05_BUY_POKE ) THEN
  //ポケモン購入処理へジャンプ
    _CALL ev_buy_poke
  //購入済み
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h05_middleman_08 )
  ENDIF
EVENT_END


//ポケモン購入処理
ev_buy_poke:
  _TALK_OBJ_START()

  //男性だった場合
  _BALLOONWIN_OBJMSG_MF( msg_h05_middleman_01, msg_h05_middleman_02, H05_MIDDLEMAN1_01, POS_DOWN )

  //所持金の表示
  _GOLD_WIN_OPEN( MENU_X1, MENU_Y1 )

  //ポケモン購入しない？
  DEFINE_LOCAL SCWK_ANSWER01
  _YES_NO_WIN( SCWK_ANSWER01 )

  //回答により分岐
  IF $SCWK_ANSWER01 == SCR_YES THEN

    //手持ちポケモンをカウント&所持金をチェックして回答を分岐する
    {

    //手持ちポケモンのカウント
    DEFINE_LOCAL LWK_POKE_COUNT
    _GET_PARTY_POKE_COUNT ( LWK_POKE_COUNT, POKECOUNT_MODE_TOTAL )

    //所持金のチェック
    DEFINE_LOCAL LWK_GOLD_CHK
    _CHECK_GOLD( LWK_GOLD_CHK, 500 )

    //所持金が足りない
    IF $LWK_GOLD_CHK == 0 THEN
      _GOLD_WIN_CLOSE()

      _BALLOONWIN_OBJMSG_POS( msg_h05_middleman_05, H05_MIDDLEMAN1_01, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()

    //手持ちがいっぱいなら
    ELSIF $LWK_POKE_COUNT == 6 THEN
      _GOLD_WIN_CLOSE()

      _BALLOONWIN_OBJMSG_POS( msg_h05_middleman_06, H05_MIDDLEMAN1_01, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()

    //500円があって手持ちに空きがあれば持ちタイプに合わせてポケモンを渡す	
    ELSE
      //購入可能であれば先に表示していたウインドウを閉じる
      _BALLOONWIN_CLOSE()

      //プレイヤーネームを格納
      _PLAYER_NAME( 0 )

      //ME再生
      _ME_PLAY( SEQ_ME_POKEGET )

      //所持金を減らして表示ウィンドウから減算
      _SUBTRACT_GOLD( 500 )
      _GOLD_WIN_UPDATE()
      //プレイヤー名はコイキングを買った！
      _SYSWIN_MSG( msg_h05_middleman_03, POS_DOWN )

      //ウィンドウを閉じる
      _ME_WAIT()
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()
      _GOLD_WIN_CLOSE()

      //コイキングを入手
      _ADD_POKEMON_TO_PARTY( SCWK_ANSWER, MONSNO_129, 0, 5 )

      //コイキングの素早さの個体値をMAXに操作
      _SET_PARTY_POKE_PARAM( LWK_POKE_COUNT, SCR_POKEPARA_AGI_RND, 31 )

      //名前をつけますか？
      _SYSWIN_MSG( msg_h05_middleman_04, POS_DOWN )
      DEFINE_LOCAL NAME_YESNO01
      _YES_NO_WIN( NAME_YESNO01 )
      _SYSWIN_CLOSE()

      //名づけるか分岐
      IF $NAME_YESNO01 == 0 THEN
        //はい

        //名前入力結果が格納されるローカル変数を定義
        DEFINE_LOCAL SCWK_NAMEINPUT

        //名前入力画面呼び出し
        _PARTY_POKE_NAME_INPUT( SCWK_NAMEINPUT, LWK_POKE_COUNT,TRUE )

      ELSE
        //いいえの場合はスキップ
      ENDIF

      //会話終了
      _BALLOONWIN_OBJMSG_POS( msg_h05_middleman_08, H05_MIDDLEMAN1_01, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()

      //======================================//
      //コイキング購入イベント終了
      _FLAG_SET( FE_H05_BUY_POKE )
      //======================================//

    ENDIF
    }

  //いらない場合
  ELSE
    _GOLD_WIN_CLOSE()

    _BALLOONWIN_OBJMSG_POS( msg_h05_middleman_07, H05_MIDDLEMAN1_01, POS_DOWN )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()

  ENDIF

_RET

/**************************************************************/
/*  太った兄さん：話しかけ（橋マニアイベント）                */
/**************************************************************/
EVENT_START   ev_h05_man3_01

  _TALK_OBJ_START()

  //おいしい水を渡す前
  IF $WK_SCENE_BRIDGE_MANIA_01 == 4 THEN

    //太った兄さん：のどが　かわいた……▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h05_bridge_01 )

    //アイテム「おいしいみず」をあげる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //かばんの中の「おいしいみず」を減らす
      _SUB_ITEM( ITEM_OISIIMIZU, 1, SCWK_ANSWER )

      //おいしいみずがある
      IF $SCWK_ANSWER == TRUE THEN

        _MSGWIN_CLOSE()

        //SE再生
        _SE_PLAY( SEQ_SE_ARDEMO_01 )
        _SE_WAIT()

        //太った兄さん：げんき　でてきたー！　ありがとう▼
        _BALLOONWIN_TALKOBJ_MSG( msg_h05_bridge_02 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

		_PLAYER_DIR_GET( SCWK_ANSWER )
		
		IF $SCWK_ANSWER == DIR_LEFT THEN
			_OBJ_ANIME( H05_MAN3_01, anm_man3_leave1 )
		ELSE
			_OBJ_ANIME( H05_MAN3_01, anm_man3_leave2 )
		ENDIF

		_TIME_WAIT( 20 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_ou )
		_OBJ_ANIME_WAIT()

		_OBJ_DEL( H05_MAN3_01 )

        //========================================//
        //イベント進行
        $WK_SCENE_BRIDGE_MANIA_01 = 5
        //ワンダーブリッジの橋マニア非表示
        _FLAG_SET( FV_H05_BRIDGE_MANIA_01 )
        //マリンチューブの橋マニア表示
        _FLAG_RESET( FV_H06_BRIDGE_MANIA_01 )
        //========================================//

      //おいしいみずが無い
      ELSE

        //太った兄さん：でも　おいしいみず　ないよね……
        _BALLOONWIN_TALKOBJ_MSG( msg_h05_bridge_03 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //太った兄さん：おいしいみずが　ないと……
      _BALLOONWIN_TALKOBJ_MSG( msg_h05_bridge_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //おいしい水を渡した後
  ELSIF $WK_SCENE_BRIDGE_MANIA_01 == 5 THEN

    //太った兄さん：げんき　でてきたー！　ありがとう▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h05_bridge_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

 //--------------------------------------------------------------------
//	●橋マニア：退場演出
//--------------------------------------------------------------------
_ANIME_LABEL	anm_man3_leave1
  _ANIME_DATA	AC_STAY_WALK_D_4F,4
  _ANIME_DATA	AC_WALK_D_4F,1
  _ANIME_DATA	AC_WALK_R_4F,5
  _ANIME_DATA	AC_WALK_R_2F,8
  _ANIME_DATA	ACMD_END,0
 
_ANIME_LABEL	anm_man3_leave2
  _ANIME_DATA	AC_STAY_WALK_R_4F,4
  _ANIME_DATA	AC_WALK_R_4F,5
  _ANIME_DATA	AC_WALK_R_2F,8
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_ou
  _ANIME_DATA	AC_DIR_R,1
  _ANIME_DATA	ACMD_END,0


/**************************************************************/
/*  POS：クレセリア登場                                       */
/**************************************************************/
EVENT_START   ev_pos_h05_poke488_01

  //システム：みかづきのはねが　かがやきだした！
  _SYSWIN_MSG( msg_h05_poke1_01, POS_DOWN )

  //「みかづきのはね」をかざす？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい

    _MSGWIN_CLOSE()

    //==================================//
    //クレセリア表示
    _FLAG_RESET( FV_H05_POKE488 )
    //POSイベント進行
    $WK_SCENE_H05_POKE488 = 2
    //==================================//

    //アニメ：主人公手を掲げる
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_itemget )
    _OBJ_ANIME_WAIT()

    _TIME_WAIT ( 30 )  //間

    //クレセリア：るなーん
    _VOICE_PLAY( MONSNO_488, 0 ) 
    _PLAINWIN_MSG_UP( msg_h05_poke1_02 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _PLAINWIN_CLOSE()

    //アニメ：主人公振り向き
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

    //クレセリア出現
    _OBJ_ADD( H05_POKE488_01 )

    //クレセリア登場座標にジャンプ
    _OBJ_POS_CHANGE( H05_POKE488_01, 110, 2, 14, DIR_RIGHT )

    //クレセリア停止座標まで移動
    $LCW_POSX += 2
    _OBJ_TRANS( H05_POKE488_01, LCW_POSX, 0, LCW_POSZ, 8*8 )

    //クレセリア再配置（↑のコマンドだと接地しないので）
    _OBJ_POS_CHANGE( H05_POKE488_01, LCW_POSX, 0, LCW_POSZ, DIR_LEFT )

    //アニメ：クレセリア振り向き
    _OBJ_ANIME( H05_POKE488_01, anm_common_turn_l )
    _OBJ_ANIME_WAIT()

    //アニメ：主人公振り向き
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
    _OBJ_ANIME_WAIT()

    _TIME_WAIT( 16 )

  ELSE    //いいえ

    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

/**************************************************************/
/*  クレセリア：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
/**************************************************************/
EVENT_START   ev_h05_poke488_01

  //========================================//
  _FLAG_SET( FE_H05_POKE488_BTL_01 )
  $LOCALWORK10 = 1
  //========================================//

  _TALK_OBJ_START()

  //クレセリア：るなーん
  _VOICE_PLAY( MONSNO_488, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_h05_poke1_02, POS_DOWN )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  // Lv.68 クレセリア
  _WILD_BTL_SET_LEGEND( MONSNO_488, 68 )

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //クレセリア非表示
    _FLAG_SET( FV_H05_POKE488 )
    //POSイベント進行
    $WK_SCENE_H05_POKE488 = 3
    //==================================//
    _OBJ_DEL( H05_POKE488_01 )   //クレセリアを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //クレセリアを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合
    //==================================//
    //クレセリアを捕獲した
    _FLAG_SET( FE_H05_POKE488_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

  ENDSWITCH

  //クレセリアを捕獲できなかった場合の分岐
  IF FLAG_OFF( FE_H05_POKE488_GET_01 ) THEN

    //システム：クレセリアは
    _SYSWIN_MSG( msg_h05_poke1_03, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDIF

EVENT_END


