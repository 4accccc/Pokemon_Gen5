/************************************************************/
/*						消える少女							*/
/************************************************************/
EVENT_START	ev_pos_h05_wandergirl
	//少女：消える
	_OBJ_ANIME( H05_GIRL2_01, anm_girl_vanish )
	_OBJ_ANIME_WAIT()
	
	//少女を削除
	_OBJ_DEL( H05_GIRL2_01 )
	
	//ふとっちょ：！マーク
	_OBJ_ANIME( H05_MAN3_02, anm_man3_look )
	_OBJ_ANIME_WAIT()
	
	//はわわわ
	_BALLOONWIN_OBJMSG_POS( msg_h05_oldwoman1_02, H05_MAN3_02, POS_DEFAULT )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
	//========================================//
	//POS無効
	$WK_SCENE_H05_GIRL = 2
	
	//消える少女の表示フラグをセット
	_FLAG_SET( FV_H05_WANDERGIRL )
	
	//消える少女を見た
	_FLAG_SET( FE_H05_LOOK_WANDERGIRL )
	//========================================//
	
EVENT_END

