  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_r08r0101.h"
  .include  "r08r0101.h"
  .include  "skill_teach_scr_def.h"     //for SCRID_SKILL_LEARN

  //@author suginaka_katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_r08r0101     //ゾーンチェンジスクリプト
_EVENT_DATA   ev_scene_r08r0101   //シーンスクリプト
_EVENT_DATA   ev_r08r0101_oldman1_01
_EVENT_DATA_END

/**************************************************************/
/*            SCENE_SCRIPT                               */
/**************************************************************/
EVENT_START ev_scene_r08r0101

EVENT_END

/**************************************************************/
/*            ZONE_CHANGE_SCRIPT                               */
/**************************************************************/
INIT_EVENT_START ev_zone_r08r0101

INIT_EVENT_END

/************************************************************/
/*	OLDMAN：ケルディオ語りイベント					*/
/************************************************************/
EVENT_START	ev_r08r0101_oldman1_01

  //チェックのための変数定義
  DEFINE_LOCAL LWK_PARTY_NUM
  DEFINE_LOCAL LWK_COUNT_NUM
  DEFINE_LOCAL LWK_MONS_NO
  DEFINE_LOCAL LWK_FORM_NO
  DEFINE_LOCAL LWK_CHECK_RESULT
  
  //手持ちの数をチェックする
  _GET_PARTY_POKE_COUNT ( LWK_PARTY_NUM , POKECOUNT_MODE_TOTAL)
  
  //手持ち分だけケルディオのチェックを行う
  WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM
    
    //指定POSの種族をチェック
    _GET_PARTY_POKE_MONSNO( LWK_MONS_NO, LWK_COUNT_NUM )
    //指定POSのFORMNOをチェック
    _GET_PARTY_POKE_FORMNO( LWK_FORM_NO, LWK_COUNT_NUM )
    
    //条件
    IF $LWK_MONS_NO == MONSNO_KERUDHIO THEN
    
      IF $LWK_FORM_NO == 1 THEN
        
         IF $LWK_CHECK_RESULT <= 1 THEN
         
            $LWK_CHECK_RESULT = 2
         
         ENDIF
      
      ELSE
      
         IF $LWK_CHECK_RESULT <= 1 THEN
         
            $LWK_CHECK_RESULT = 1
         
         ENDIF
      
      ENDIF
    
    ENDIF
    
    _DEBUG_PRINT_WK( LWK_FORM_NO )
    
    //カウントアップ
    $LWK_COUNT_NUM +=1
  
  ENDWHILE
  
  _DEBUG_PRINT_WK(LWK_CHECK_RESULT)
  
  SWITCH $LWK_CHECK_RESULT
  CASE 0 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r08r0101_guide_01 )
  CASE 1 THEN
    _TALK_OBJ_START()
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_r08r0101_guide_02, POS_DEFAULT )
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_r08r0101_guide_04, POS_DEFAULT )
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_r08r0101_guide_05, POS_DEFAULT )
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_r08r0101_guide_06, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  CASE 2 THEN
    _TALK_OBJ_START()
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_r08r0101_guide_03, POS_DEFAULT )
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_r08r0101_guide_04, POS_DEFAULT )
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_r08r0101_guide_05, POS_DEFAULT )
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_r08r0101_guide_06, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDSWITCH

EVENT_END


