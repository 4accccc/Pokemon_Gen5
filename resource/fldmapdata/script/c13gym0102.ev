  .text

  .include  "scr_seq_def.h"
  .include  "msg_c13gym0102.h"
  .include  "c13gym0102.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_c13gym0102
_EVENT_DATA   ev_init_c13gym0102
_EVENT_DATA   ev_c13gym0102_swleader2_01    // ジムリーダー
_EVENT_DATA   ev_c13gym0102_heads_01      // スキンヘッド
_EVENT_DATA   ev_c13gym0102_guitarw_01    // ギター
_EVENT_DATA   ev_c13gym0102_sunglasses_01
_EVENT_DATA   ev_pos_c13gym0102_pokewood
_EVENT_DATA_END


//------------------------------注意--------------------------------//
// ローカルワークを使用しています。
// 
// LOCALWORK0⇒ドラムISS
// LOCALWORK1⇒ギターISS
// LOCALWORK2⇒ボーカルISS
//------------------------------------------------------------------//


DEFINE_LOCAL  LWK_TR_ID
DEFINE_LOCAL  LWK_MSG_ID_START
DEFINE_LOCAL  LWK_MSG_ID_AFTER
DEFINE_LOCAL  LWK_MSG_ID_NG

/************************************************************/
/*					ジムギミック初期化						*/
/*          ZONE_CHANGE_LABEL             */
/************************************************************/
INIT_EVENT_START  ev_zone_c13gym0102

  // ISSフラグ制御
  // LOCALWORK0とLOCALWORK1を
  // プログラムで参照し、ISSスイッチをOFFにするか決めている
  // LOCALWORKを1にすると、それに対応したISSスイッチがOFFになる
  // ※ここを編集するときは、ev_zone_c13gym0101も同じ様に編集する

	//バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_02 )

	IF $SCWK_TEMP0 == 0 THEN
    // ジムクリア前

    // ジムトレーナー1
    IF FLAG_ON(FE_C13GYM_TRBTL1) THEN

      $LOCALWORK0 = 1
    ELSE
      $LOCALWORK0 = 0
    ENDIF

    // ジムトレーナー2
    IF FLAG_ON(FE_C13GYM_TRBTL2) THEN

      $LOCALWORK1 = 1
    ELSE
      $LOCALWORK1 = 0
    ENDIF

  ELSE
    // ジムクリアしているなら
    // ISSは全てリセット
		$LOCALWORK0 = 0
		$LOCALWORK1 = 0
  ENDIF

  // イベントがらみ
  // ホミカが消えているときは、ISS全てリセット
  IF FLAG_ON(FV_C13GYM0102_SWLEADER2) THEN
		$LOCALWORK0 = 1
		$LOCALWORK1 = 1
		$LOCALWORK2 = 1
  ENDIF


INIT_EVENT_END

/************************************************************/
/*					ジムギミック初期化						*/
/*          FIELD_INIT_LABEL              */
/************************************************************/
INIT_EVENT_START  ev_init_c13gym0102
{
    IF $LOCALWORK0 == 1 THEN
      // ISSスイッチOFF
      // ⇒プログラムで処理

      // アニメポーズOFF
      //_GYM_POISON_ISS_OBJ_STOP( C13GYM0102_HEADS_01 )
    ENDIF

    IF $LOCALWORK1 == 1 THEN
      // ISSスイッチOFF
      // ⇒プログラムで処理

      // アニメポーズOFF
      _GYM_POISON_ISS_OBJ_STOP( C13GYM0102_GUITARW_01 )
    ENDIF
}
INIT_EVENT_END

/************************************************************/
/*			ジムリーダー戦のスクリプトイベント				*/
/************************************************************/
EVENT_START	ev_c13gym0102_swleader2_01
{

  // ジムトレーナー全員のフラグがたっていない
  IF $LOCALWORK0 == 0 || $LOCALWORK1 == 0 THEN
    {
      _TALK_START_TURN_NOT()

      // まわりの　おとが　おおきすぎて
      _PLAYER_NAME( 0 )
      _PLAINWIN_MSG_DOWN( msg_c13gym0102_swleader2_ng )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
    }
  ELSE
    {
      _TALK_OBJ_START()

          // ISSスイッチOFF
          _CALL sub_iss_off_vocal

      //バッジフラグ取得
      _GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_02 )
      //ジムバッジフラグで分岐
      IF $SCWK_TEMP0 == 0 THEN
        // ジムリーダー戦イベント
        _CALL		ev_leader2_btl
      ELSE
        // 話す前にISSをOFFにする
        {
          // スピーカーアニメOFF
          _GYM_POISON_ANM_STOP(0)
          _GYM_POISON_ANM_STOP(1)
          _GYM_POISON_ANM_STOP(2)
        }

        //ゲームクリア前なら
        IF FLAG_OFF( SYS_FLAG_GAME_CLEAR )  THEN
          //ホミカ『クリアまえメッセージ』
          _BALLOONWIN_OBJMSG( msg_c13gym0102_swleader_06 , C13GYM0102_SWLEADER2_01 )
          _LAST_KEYWAIT()
          _BALLOONWIN_CLOSE()
        //ゲームクリア後なら
        ELSE
          //ホミカ『クリア後メッセージ』
          _BALLOONWIN_OBJMSG( msg_c13gym0102_swleader_07 , C13GYM0102_SWLEADER2_01 )
          _LAST_KEYWAIT()
          _BALLOONWIN_CLOSE()
        ENDIF
      ENDIF

    }
  ENDIF

}
EVENT_END

//ジムリーダー戦
ev_leader2_btl:
{
	//ホミカが喋る　
	_BALLOONWIN_TALKOBJ_MSG( msg_c13gym0102_swleader2_01 )
	_BALLOONWIN_CLOSE()

	//トレーナー戦呼び出し
	_TRAINER_BTL_SET( TRID_SWLEADER2_01, 0 )
	
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
			_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF

  //バトルが終了するとすぐにISSをOFFにする
  {
    // ISSスイッチOFF
    _CALL sub_iss_off_vocal

    // スピーカーアニメOFF
    _GYM_POISON_ANM_STOP(0)
    _GYM_POISON_ANM_STOP(1)
    _GYM_POISON_ANM_STOP(2)
  }
		
	//リーダー：戦闘後メッセージ→続けてバッジ入手へ
	//ホミカが喋る　
	_BALLOONWIN_TALKOBJ_MSG( msg_c13gym0102_swleader_02 )
	_BALLOONWIN_CLOSE()

  //リーダー戦勝利時の情報登録
  _SET_GYM_VICTORY_INFO( BADGE_ID_02 )
	//バッジ入手処理
	_SET_BADGE_FLAG( BADGE_ID_02 )		//バッジフラグon
	_PLAYER_NAME( 0 )
	
	{
	
	//バッジ入手演出再生
	_ME_PLAY( SEQ_ME_BADGE )
	
	//性別が格納されるローカル変数を定義
	DEFINE_LOCAL SCWK_SEX
	_GET_MY_SEX(SCWK_SEX)
	
	//男性だった場合
	IF $SCWK_SEX == PM_MALE THEN
		_CALL_FLD3D_CUTIN( FLDCIID_GYM02 )
	//女性だった場合
	ELSE
		_CALL_FLD3D_CUTIN( FLDCIID_GYM02F )
	ENDIF
	
	//ME待ち
	_ME_WAIT()
		
	}
	
	//～～はトキシックバッジを入手した！
	_SYSWIN_MSG( msg_c13gym0102_swleader_03 , POS_DEFAULT )
	_SYSWIN_CLOSE()

	//バッジの説明
	//技マシンをあげる
	_BALLOONWIN_TALKOBJ_MSG( msg_c13gym0102_swleader_04)
	_BALLOONWIN_CLOSE()

	//わざマシン入手処理　「ベノムショック」
	_ITEM_EVENT_KEYWAIT( ITEM_WAZAMASIN09, 1 )

	//リーダー：わざマシンの解説
	_BALLOONWIN_TALKOBJ_MSG( msg_c13gym0102_swleader_05 )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()
	
	//================================================//
	
	//ジムトレーナーのフラグOFF
	_TRAINER_FLAG_SET( TRID_HEADS_06 )
	_TRAINER_FLAG_SET( TRID_GUITARW_01 )
	
	//ポケウッドイベント開始
	$WK_SCENE_C13GYM0102 = 1

	//================================================//
	//電光掲示板フラグセット
	//【仮】
	// C13GYMのフラグがないのでC02GYMのものを仮で使っている
	_FLAG_SET( SYS_FLAG_ELBOARD_C02GYMWIN )

	//================================================//

}
_RET


/************************************************************/
/*			ジムトレーナー戦のスクリプトイベント				*/
/************************************************************/
EVENT_START	ev_c13gym0102_heads_01
{
  _TALK_OBJ_START()

  //トレーナーID設定
  $LWK_TR_ID = TRID_HEADS_06

  IF FLAG_ON(FE_C13GYM_TRBTL1) THEN
    // メッセージ
    _CALL sub_trainer_talk_after

    // ISSスイッチOFFにする
    _CALL sub_iss_off_drum

  ELSE
    // 戦闘呼び出し
    _CALL sub_trainer_battle

    // 勝敗チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )

	  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()

      // ISSスイッチOFF
      _CALL sub_iss_off_drum

      // 戦闘処理フラグON
      _FLAG_SET( FE_C13GYM_TRBTL1 )
    ELSE
      _TRAINER_LOSE()
    ENDIF

    //トレーナーフラグセット
    _TRAINER_FLAG_SET( LWK_TR_ID )
  ENDIF
}
EVENT_END

/************************************************************/
/*			ジムトレーナー戦のスクリプトイベント			*/
/************************************************************/
EVENT_START	ev_c13gym0102_guitarw_01
{
  _TALK_OBJ_START()

  //トレーナーID設定
  $LWK_TR_ID = TRID_GUITARW_01

  IF FLAG_ON(FE_C13GYM_TRBTL2) THEN
    // メッセージ
    _CALL sub_trainer_talk_after

    // ISSスイッチOFFにする
    _CALL sub_iss_off_guitar

  ELSE
    // 戦闘呼び出し
    _CALL sub_trainer_battle

    // 勝敗チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )

	  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()

      // ISSスイッチOFF
      _CALL sub_iss_off_guitar

      // 戦闘処理フラグON
      _FLAG_SET( FE_C13GYM_TRBTL2 )
    ELSE
      _TRAINER_LOSE()
    ENDIF

    //トレーナーフラグセット
    _TRAINER_FLAG_SET( LWK_TR_ID )
  ENDIF
}
EVENT_END

// ボーカルISSスイッチOFF
sub_iss_off_vocal:
	//再生状態かチェック
	_ISS_SWITCH_CHECK( SCWK_ANSWER,3 )

	//演奏している
  IF $SCWK_ANSWER == TRUE THEN
	  //ISSスイッチをオフに
	  _ISS_SWITCH_OFF( 3 )

    // フラグON
    $LOCALWORK2 = 1
  ENDIF
_RET

// ドラムISSスイッチOFF
sub_iss_off_drum:
	//再生状態かチェック
	_ISS_SWITCH_CHECK( SCWK_ANSWER,1 )

	//演奏している
  IF $SCWK_ANSWER == TRUE THEN
	  //ISSスイッチをオフに
	  _ISS_SWITCH_OFF( 1 )

    // アニメポーズOFF
    //_GYM_POISON_ISS_OBJ_STOP( C13GYM0102_HEADS_01 )

    // フラグON
    $LOCALWORK0 = 1
  ENDIF
_RET

// ギターISSスイッチOFF
sub_iss_off_guitar:
	//再生状態かチェック
	_ISS_SWITCH_CHECK( SCWK_ANSWER,2 )

	//演奏している
  IF $SCWK_ANSWER == TRUE THEN
	  //ISSスイッチをオフに
	  _ISS_SWITCH_OFF( 2 )

    // アニメポーズOFF
    _GYM_POISON_ISS_OBJ_STOP( C13GYM0102_GUITARW_01 )

    // フラグON
    $LOCALWORK1 = 1
  ENDIF
_RET

//戦闘後メッセージ：通常トレーナー
sub_trainer_talk_after:
  //メッセージを取得
  _TRAINER_TALK_TYPE_GET(  LWK_MSG_ID_START, LWK_MSG_ID_AFTER, LWK_MSG_ID_NG )
  _TRAINER_MSG_SET(  LWK_TR_ID, LWK_MSG_ID_AFTER, SCWK_TARGET_OBJID )
  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()
_RET

//戦闘呼び出し
sub_trainer_battle:
  //_TRAINER_BGM_SET( LWK_TR_ID ) //視線曲セット
  _TRAINER_TALK_TYPE_GET( LWK_MSG_ID_START, LWK_MSG_ID_AFTER, LWK_MSG_ID_NG )
  _TRAINER_MSG_SET( LWK_TR_ID, LWK_MSG_ID_START, SCWK_TARGET_OBJID )
  _BALLOONWIN_CLOSE()
  
  //戦闘呼び出し
  _TRAINER_BTL_SET( LWK_TR_ID, 0 )
_RET

/**************************************************************/
/*		C13GYM0102	SUNGLASSES	一言メッセージ				  */
/**************************************************************/
EVENT_START		ev_c13gym0102_sunglasses_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c13gym0102_sunglasses_01 )
EVENT_END

/**************************************************************/
/*		C13GYM0102	ポケウッドPOSイベント					  */
/**************************************************************/
EVENT_START		ev_pos_c13gym0102_pokewood

	//座標用の変数を定義
	DEFINE_LOCAL	LWK_POSX
	DEFINE_LOCAL	LWK_POSZ
	
	//プレイヤーの座標取得
	_PLAYER_POS_GET( LWK_POSX, LWK_POSZ )

	_OBJ_POS_CHANGE( C13GYM0102_SUNGLASSES_01, 13, 0, 6, DIR_LEFT )

	//サングラス：プレイヤーに近づいてくる
	//X座標が３の場合
	IF $LWK_POSX == 3 THEN
	
		_OBJ_ANIME( C13GYM0102_SUNGLASSES_01, anm_sunglasses_come_x3 )
	
	//X座標が４の場合
	ELSE
	
		_OBJ_ANIME( C13GYM0102_SUNGLASSES_01, anm_sunglasses_come_x4 )
	
	ENDIF
	
	_OBJ_ANIME_WAIT()
	
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
	_OBJ_ANIME_WAIT()
	
	//ヘイ　あなた！
	_BALLOONWIN_OBJMSG( msg_c13gym0102_sunglasses_02 , C13GYM0102_SUNGLASSES_01 )
	_MSGWIN_CLOSE()
	
	//サングラス：退場
	//X座標が３の場合
	IF $LWK_POSX == 3 THEN
	
		_OBJ_ANIME( C13GYM0102_SUNGLASSES_01, anm_sunglasses_leave_x3 )
		_TIME_WAIT( 10 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
	
	//X座標が４の場合
	ELSE
	
		_OBJ_ANIME( C13GYM0102_SUNGLASSES_01, anm_sunglasses_leave_x4 )
		_TIME_WAIT( 10 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
	
	ENDIF
	
	//ホミカ：プレイヤーに近づく
	//X座標が３の場合
	IF $LWK_POSX == 3 THEN
		_TIME_WAIT( 30 )
		_OBJ_ANIME( C13GYM0102_SWLEADER2_01, anm_swleader2_come_x3 )
	
	//X座標が４の場合
	ELSE
		_TIME_WAIT( 30 )
		_OBJ_ANIME( C13GYM0102_SWLEADER2_01, anm_swleader2_come_x4 )
	
	ENDIF
	
	_OBJ_ANIME_WAIT()
	
	//プレイヤー：ホミカのほうを向く
	//X座標が３の場合
	IF $LWK_POSX == 3 THEN
	
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
	
	//X座標が４の場合
	ELSE
	
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_l )
	
	ENDIF
	
	_OBJ_ANIME_WAIT()
	
	//なに？　あんた　ポケウッドに　いくわけ？
	_BALLOONWIN_OBJMSG( msg_c13gym0102_swleader_07 , C13GYM0102_SWLEADER2_01 )
	_MSGWIN_CLOSE()
	
	//ホミカ：退場
	//X座標が３の場合
	IF $LWK_POSX == 3 THEN
	
		_OBJ_ANIME( C13GYM0102_SWLEADER2_01, anm_swleader2_leave_x3 )
	
	//X座標が４の場合
	ELSE
	
		_OBJ_ANIME( C13GYM0102_SWLEADER2_01, anm_swleader2_leave_x4 )
		_TIME_WAIT( 20 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
		
	ENDIF
	
	_OBJ_ANIME_WAIT()

	//ホミカ・サングラスのOBJ削除
	_OBJ_DEL( C13GYM0102_SUNGLASSES_01 )
	_OBJ_DEL( C13GYM0102_SWLEADER2_01 )

	//========================================/
	
	//ポケウッドイベント終了
	$WK_SCENE_C13GYM0102 = 2
	
	//ホミカとサングラスを非表示にする
	_FLAG_SET(FV_C13GYM0102_SWLEADER2)
	_FLAG_SET(FV_C13GYM0102_SUNGLASSES)

	//ポケウッドゲート前ＯＢＪのバニシュフラグをセット
	_FLAG_SET(FV_C13_SUNGLASSES)
	
	//ライブキャスターイベント起動
	$WK_SCENE_C13 = 3

	//========================================/

EVENT_END

