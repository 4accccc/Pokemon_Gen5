
//======================================================================
//                c12r0402.ev
//
//    スクリプトファイル：c12r0402用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c12r0402.h"
  .include  "c12r0402.h"
  .include  "pair_scr_def.h"
  
  //@author Mizuguchi_Mai
  //@author fujimura_souichirou
  //@author suginaka_katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c12r0402_woman2_01
_EVENT_DATA    ev_c12r0402_boy1_01
_EVENT_DATA_END


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
//ev_zone_c12r0402:
//  _END

/**************************************************************/
/*  女性：話しかけ                                            */
/**************************************************************/
EVENT_START   ev_c12r0402_woman2_01

IF FLAG_ON( SYS_FLAG_PAIR ) THEN

	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0402_woman2_00 )

ELSE

  _TALK_OBJ_START()

  //アイテム入手前か
  IF FLAG_OFF( FE_C12R0402_ITEMGET_01 ) THEN

    //ジムバッジ入手後か
    IF $WK_SCENE_C12GYM_OPEN >= 3 THEN

      //女性：おっ！　もう　ジムバッジを
      _BALLOONWIN_TALKOBJ_MSG( msg_c12r0402_woman2_02 )
      _MSGWIN_CLOSE()

      //アイテム入手：ハイパーボール
      _ITEM_EVENT_KEYWAIT( ITEM_HAIPAABOORU, 1 )

      //女性：ハイパーボールは
      _BALLOONWIN_TALKOBJ_MSG( msg_c12r0402_woman2_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //========================================/
      //アイテム入手フラグセット
      _FLAG_SET( FE_C12R0402_ITEMGET_01 )
      //========================================/

    ELSE

      //女性：となりまちに　いくのも
      _BALLOONWIN_TALKOBJ_MSG( msg_c12r0402_woman2_01 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //アイテム入手済みの場合
  ELSE

    //女性：ハイパーボールは
    _BALLOONWIN_TALKOBJ_MSG( msg_c12r0402_woman2_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

ENDIF

EVENT_END

/**************************************************************/
/*  男の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c12r0402_boy1_01

IF FLAG_ON( SYS_FLAG_PAIR ) THEN

  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0402_boy1_01 )

ELSE

  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0402_boy1_02 )

ENDIF

EVENT_END


