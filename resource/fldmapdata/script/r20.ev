//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_r20
{
  //季節チェック
  DEFINE_LOCAL SCWK_SEASON
  _GET_SEASON_ID( SCWK_SEASON )
  
  //秋以外
  IF $SCWK_SEASON != PMSEASON_AUTUMN THEN
    _FLAG_SET( FV_R20_RANGER_01 )
  //秋
  ELSE
    _FLAG_RESET( FV_R20_RANGER_01 )
  ENDIF
  
  IF $WK_SCENE_R20 == 3 THEN
    _SXY_MOVE_NPC_POS( R20_SWRIVAL_01, DIR_DOWN , 162, -3, 668 )
  ENDIF
}
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_r20
  

INIT_EVENT_END

/**************************************************************/
/*POS：山男ストッパー                                */
/**************************************************************/
EVENT_START   ev_pos_r20_mountman_01
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  IF $LCW_POSZ == 644 THEN
    _OBJ_ANIME( R20_MOUNTMAN_01, anm_mountain_look_pl_z644 )
    _TIME_WAIT(16)
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    _OBJ_ANIME_WAIT()
  ELSIF $LCW_POSZ == 646 THEN
    _OBJ_ANIME( R20_MOUNTMAN_01, anm_mountain_look_pl_z646 )
    _TIME_WAIT(16)
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //メッセージ：おいおい！
  _BALLOONWIN_OBJMSG_POS( msg_r20_mountman_02, R20_MOUNTMAN_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公1歩戻る・山男もとの位置に戻る
  IF $LCW_POSZ != 645 THEN
    _OBJ_ANIME( R20_MOUNTMAN_01, anm_staystep_l )
  ENDIF
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
  _OBJ_ANIME_WAIT()
  
EVENT_END

//--------------------------------------------------------------------
//	山男隣接：z644
//--------------------------------------------------------------------
_ANIME_LABEL	anm_mountain_look_pl_z644
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	山男隣接：z644
//--------------------------------------------------------------------
_ANIME_LABEL	anm_mountain_look_pl_z646
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0


/**************************************************************/
/*POS：山男ストッパー/ノーマルジムクリア後                     */
/**************************************************************/
EVENT_START   ev_pos_r20_mountman_02
  
  //アニメ：山男「！」
  _OBJ_ANIME( R20_MOUNTMAN_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  IF $LCW_POSZ == 644 THEN
    _OBJ_ANIME( R20_MOUNTMAN_01, anm_mountain_topl_z644 )
    _OBJ_ANIME_WAIT()
  ELSIF $LCW_POSZ == 646 THEN
    _OBJ_ANIME( R20_MOUNTMAN_01, anm_mountain_topl_z646 )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //メッセージ：おおそれは
  _BALLOONWIN_OBJMSG_POS( msg_r20_mountman_03, R20_MOUNTMAN_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //戦闘処理
  _TRAINER_BTL_SET( TRID_MOUNT_14, 0 )
  
    //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
  
  //メッセージ：まいった
  _BALLOONWIN_OBJMSG_POS( msg_r20_mountman_04, R20_MOUNTMAN_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //==================================//
  //R20 POS無効
  $WK_SCENE_R20 = 2
  //==================================//
EVENT_END

//--------------------------------------------------------------------
//	山男隣接：z644
//--------------------------------------------------------------------
_ANIME_LABEL	anm_mountain_topl_z644
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	山男隣接：z646
//--------------------------------------------------------------------
_ANIME_LABEL	anm_mountain_topl_z646
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*POS：山男ストッパーはなしかけ                     */
/**************************************************************/
EVENT_START   ev_r20_mountman_01
  IF  $WK_SCENE_R20 >= 2 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r20_mountman_04 )
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r20_mountman_01 )
  ENDIF
EVENT_END


/**************************************************************/
/*POS：長い草イベント                     */
/**************************************************************/
EVENT_START   ev_pos_r20_swrival_01

  //主人公・ライバル名格納
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )

  //メッセージ：プレイヤー名！
  _PLAINWIN_MSG_DOWN( msg_r20_swrival_01 )
  _MSGWIN_CLOSE()
  
  //ライバル・チェレン配置変更
  _OBJ_POS_CHANGE( R20_SWRIVAL_01 , 160, -1, 650, DIR_DOWN )
  _OBJ_POS_CHANGE( R20_SWLEADER1_01 , 161, -1, 650, DIR_DOWN )

  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //チェレン専用曲再生
  _START_EVENT_BGM( SEQ_BGM_E_CHEREN )
  
  //アニメ：ライバル隣接
  _OBJ_ANIME_AUTO( R20_SWLEADER1_01, 161, 658, FORCE_TYPE_ALL, 8, DIR_LR)
  _TIME_WAIT( 4 )
  _OBJ_ANIME_AUTO( R20_SWRIVAL_01, 160, 658, FORCE_TYPE_ALL, 8, DIR_LR)
  _TIME_WAIT( 8 )
  
  //主人公振り向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  IF $LCW_POSX != 161 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 161, 660, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //主人公・ライバル名格納
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //チェレン：二人とも見て！
  _BALLOONWIN_OBJMSG_POS( msg_r20_swleader1_01, R20_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公隣接
  _OBJ_ANIME( R20_SWLEADER1_01, anm_swleader1_commeing )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME( R20_SWRIVAL_01, anm_swrival_commeing )
  _OBJ_ANIME_WAIT()
  
  //アニメ：長い草へ
  _OBJ_ANIME( R20_SWLEADER1_01, anm_swleader1_look_kusa)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( R20_SWRIVAL_01, anm_player_look_kusa)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_look_kusa)
  _OBJ_ANIME_WAIT()
  
  //チェレン：いろのこい
  _BALLOONWIN_OBJMSG_POS( msg_r20_swleader1_02, R20_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレンと向き合う
  _OBJ_ANIME( R20_SWLEADER1_01, anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //チェレン：つぎに
  _BALLOONWIN_OBJMSG_POS( msg_r20_swleader1_03, R20_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公に隣接
  _OBJ_ANIME( R20_SWLEADER1_01, anm_walk_u)
  _OBJ_ANIME_WAIT()
  
  //オレンのみ入手処理
  _ITEM_EVENT_KEYWAIT(ITEM_MOMONNOMI, 3)
  
  //アニメ：ライバルに隣接
  _OBJ_ANIME( R20_SWLEADER1_01, anm_swleader1_to_rival)
  _OBJ_ANIME_WAIT()
  
  //主人公・ライバル名格納
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //チェレン：ライバルにも！
  _BALLOONWIN_OBJMSG_POS( msg_r20_swleader1_04, R20_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //チェレン：じゃ　ふたりとも
  _BALLOONWIN_OBJMSG_POS( msg_r20_swleader1_05, R20_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン退場
  _OBJ_ANIME_AUTO( R20_SWLEADER1_01, 161, 653, FORCE_TYPE_NPC, 8, DIR_LR)
  _TIME_WAIT( 16 )
  _OBJ_ANIME( R20_SWRIVAL_01, anm_staystep_u)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //イベント曲終了
  _END_EVENT_BGM()
  
  //ライバル：へぇ
  _BALLOONWIN_OBJMSG_POS( msg_r20_swrival_02, R20_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公と向き合う
  _OBJ_ANIME( R20_SWRIVAL_01, anm_staystep_r)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l)
  _OBJ_ANIME_WAIT()
  
  //ライバル：きめた！
  _BALLOONWIN_OBJMSG_POS( msg_r20_swrival_03, R20_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル移動
  _OBJ_ANIME_AUTO( R20_SWRIVAL_01, 162, 668, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //チェレン動作モデル非表示
  _OBJ_DEL( R20_SWLEADER1_01 )
	
  //==================================//
  //POS無効
  $WK_SCENE_R20 = 3
  //チェレン非表示
  _FLAG_SET( FV_R20_SWLEADER1_01 )
  //==================================//
  
EVENT_END

