  _ANIME_DATA	AC_STAY_WALK_U_8F,1
  _ANIME_DATA	ACMD_END,0

/**************************************************************/
/*  ライバル：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_r20_swrival_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r20_swrival_04 )
EVENT_END

/**************************************************************/
/*  SWPLAZMAW：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_r20_swplazmaw_01
  
  _TALK_OBJ_START()

  //==================================//
  //ライバル表示
  _FLAG_RESET( FV_R20_SWRIVAL_01 )
  //==================================//
  
  //ライバル動作モデル生成
  _OBJ_ADD( R20_SWRIVAL_01 )
  
  //ライバル位置移動
  _OBJ_POS_CHANGE( R20_SWRIVAL_01, 155, 2, 654, DIR_DOWN )
  
  
  //PLAZMAW：しつこい！
  _BALLOONWIN_OBJMSG_POS( msg_r20_swplazmaw_01, R20_SWPLAZMAW_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //戦闘処理
  _TRAINER_BTL_SET( TRID_SWPLAZMAW_13, 0 )
  
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
  
  //PLAZMAW：よく考えたら
  _BALLOONWIN_OBJMSG_POS( msg_r20_swplazmaw_02, R20_SWPLAZMAW_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //主人公方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //アニメ：PLAZMAW退場
  IF $LWK_DIR != DIR_DOWN  THEN
    _OBJ_ANIME_AUTO( R20_SWPLAZMAW_01, 155, 653, FORCE_TYPE_NPC, 4, DIR_LR)
  ELSE
    _OBJ_ANIME_AUTO( R20_SWPLAZMAW_01, 156, 653, FORCE_TYPE_NPC, 4, DIR_LR)
  ENDIF
  
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //アニメ：ライバル隣接
  
  IF $LWK_DIR == DIR_DOWN THEN
    _OBJ_ANIME_AUTO( R20_SWRIVAL_01, 156, 666, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r)
    _OBJ_ANIME( R20_SWRIVAL_01, anm_staystep_l)
    _OBJ_ANIME_WAIT()
  ELSIF $LWK_DIR == DIR_LEFT THEN
    _OBJ_ANIME_AUTO( R20_SWRIVAL_01, 155, 667, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l)
    _OBJ_ANIME( R20_SWRIVAL_01, anm_staystep_r)
    _OBJ_ANIME_WAIT()
  ELSIF $LWK_DIR == DIR_UP THEN
    _OBJ_ANIME_AUTO( R20_SWRIVAL_01, 156, 668, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r)
    _OBJ_ANIME( R20_SWRIVAL_01, anm_staystep_l)
    _OBJ_ANIME_WAIT()
  ELSIF $LWK_DIR == DIR_RIGHT THEN
    _OBJ_ANIME_AUTO( R20_SWRIVAL_01, 155, 667, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r)
    _OBJ_ANIME( R20_SWRIVAL_01, anm_staystep_l)
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //主人公・ライバル名格納
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //ライバル：……オレも
  _BALLOONWIN_OBJMSG_POS( msg_r20_swrival_05, R20_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  _OBJ_ANIME_AUTO( R20_SWRIVAL_01, 155, 654, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //ライバル・SWPLAZMAWの動作モデル削除
  _OBJ_DEL( R20_SWRIVAL_01 )
  _OBJ_DEL( R20_SWPLAZMAW_01 )
  
  //==================================//
  //ライバル非表示
  _FLAG_SET( FV_R20_SWRIVAL_01 )
  //SWPLAZMAW非表示
  _FLAG_SET( FV_R20_SWPLAZMA_01 )

  //ホミカ・父を表示
  _FLAG_RESET(FV_C13_SWLEADER2_MEET)
  //ホミカ・父イベント開始
  $WK_SCENE_C13 = 6
  
  //==================================//
  
EVENT_END

