
//======================================================================
//                c05gym0201.ev
//
//    スクリプトファイル：c05gym0201用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c05gym0201.h"
  .include  "c05gym0201.h"
  .include  "c05gym0101_def.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c05gym0201_startlift_01
_EVENT_DATA    ev_reserve_c05gym0201_gymback_01
_EVENT_DATA    ev_reserve_c05gym0201_gymback_02
_EVENT_DATA    ev_bg_c05gym0201_statue_01
_EVENT_DATA    ev_c05gym0201_informationw_01
_EVENT_DATA_END

//------------------------！注意！------------------------------//
//																//
//		LOCALWORK0をジムギミックの制御に使用			//
//		ゾーン内での使用を禁止します							//
//    LOCALWORK0 ⇒ ヤーコンリフトか判別用
//																//
//--------------------------------------------------------------//

/************************************************************/
/*			ジムフロアから戻ってくる演出					*/
/************************************************************/
EVENT_START	ev_reserve_c05gym0201_gymback_01
  //リフトと自機の位置をセット( 0 = 通常)
  _GYM_GROUND_ENT_SET_ENTER_POS(0)
  //マップブラックイン
	_MAP_FADE_BLACK_IN_SLOW()
	//ジムからリフトが戻ってくる演出（引数0 = 上昇アニメ）
	_GYM_GROUND_ENT_EXIT_LIFT( 0 )
  //マップフェード待ち
	_MAP_FADE_END_CHECK()

EVENT_END

/************************************************************/
/*			ジムフロアから戻ってくる演出(ヤーコンリフト)	*/
/************************************************************/
EVENT_START	ev_reserve_c05gym0201_gymback_02

  // ヤーコンの位置変更
  //_OBJ_POS_CHANGE( C05GYM0201_LEADER5_01, 7, 0, 4, DIR_DOWN )
  _OBJ_ADD_EX( 7, 4, DIR_DOWN, MMDL_ID_EVENTOBJ_00, SWLEADER5, MV_DMY )

  //リフトと自機の位置をセット( 1 = ヤーコンリフト専用)
  _GYM_GROUND_ENT_SET_ENTER_POS(1)
  //マップブラックイン
	_MAP_FADE_BLACK_IN_SLOW()

  //マップフェード待ち
	_MAP_FADE_END_CHECK()

	//ジムからリフトが戻ってくる演出（引数2 = ヤーコンリフト専用）
	_GYM_GROUND_ENT_EXIT_LIFT( 2 )

  // ヤーコンリフトフラグON
  $LOCALWORK0 = 1
	
	//ヤーコン・プレイヤー：向き合う
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_l )
	_TIME_WAIT( 20 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
	
	_OBJ_ANIME_WAIT()
	
	//いい　ステージには　いい　ダンサーが　たいせつ　なんだ
	_BALLOONWIN_OBJMSG( msg_c05gym0201_swleader5_01 , MMDL_ID_EVENTOBJ_00 )
	_MSGWIN_CLOSE()
	
	//ヤーコン、画面外に移動
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swleader5_leave )
	_TIME_WAIT( 20 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
	
	_OBJ_ANIME_WAIT()
	
	//動作モデル削除
	_OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

EVENT_END

/************************************************************/
/*			ジムフロアへ降りるリフトのスイッチ				*/
/************************************************************/
EVENT_START	ev_c05gym0201_startlift_01
	_PLAYER_DIR_GET( SCWK_ANSWER )	//主人公の向き情報を取得

  {
    _DEBUG_PRINT_WK(LOCALWORK0)
  }

	//スイッチの下側から話しかけた場合はリフト起動
  // かつ ヤーコンリフトではない
	IF $SCWK_ANSWER == DIR_UP && $LOCALWORK0 == 0 THEN
		_SE_PLAY( SEQ_SE_FLD_61 )		//スイッチＳＥを再生
		_SE_WAIT()

	  //マップブラックアウト
    _MAP_FADE_BLACK_OUT_SLOW()

		//リフトを下降させる（1 = 下降アニメ）
		_GYM_GROUND_ENT_EXIT_LIFT( 1 )
		
		_MAP_FADE_END_CHECK()

		//予約スクリプト マップチェンジ後、リフトが降りるスクリプトを起動する
		_RESERVE_SCRIPT( SCRID_RESERVE_C05GYM0101_GYMSTART_01 )

		//マップチェンジ
		_MAP_CHANGE_NO_FADE( ZONE_ID_C05GYM0101, 12, 0, 87, DIR_UP )

	ENDIF

EVENT_END

/************************************************************/
/*							石像							*/
/************************************************************/
EVENT_START	ev_bg_c05gym0201_statue_01
	_TALK_START_SE_PLAY()


	_PLAYER_NAME( 0 )		//主人公名取得

	//バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_05 )
	//ジムバッジフラグによって分岐
	IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前なら
		_PLAINWIN_MSG_DOWN( msg_c05gym0201_statue_01 )

	ELSE
		//バッジ入手後
    _PLAINWIN_MSG_DOWN( msg_c05gym0201_statue_02  )

	ENDIF

	_LAST_KEYWAIT()
	_PLAINWIN_CLOSE()

EVENT_END

/**************************************************************/
/* 						受付								  */
/**************************************************************/
EVENT_START		ev_c05gym0201_informationw_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03r0501_infomationw_01 )
EVENT_END

//--------------------------------------------------------------------
//	◆ヤーコン：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader5_leave
	_ANIME_DATA	AC_WALK_D_8F,10
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_staystep_u
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_d
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_l
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_r
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
