/*                  モニュメント2                             */
/**************************************************************/
EVENT_START   ev_pos_d26r0101_badge_check_02
{
  //ジムバッジを取得している場合のみ起動
  _SE_PLAY( SEQ_SE_SW_BCG_01 )
  _BGATE_START_MONUMENT( 1 )
  $WK_SCENE_D26R0101_GATE_02 = 2
}
EVENT_END

