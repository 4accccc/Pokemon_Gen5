/*                  モニュメント5                             */
/**************************************************************/
EVENT_START   ev_pos_d26r0101_badge_check_05
{
  //ジムバッジを取得している場合のみ起動
  _SE_PLAY( SEQ_SE_SW_BCG_01 )
  _BGATE_START_MONUMENT( 4 )
  $WK_SCENE_D26R0101_GATE_05 = 2
}
EVENT_END

/**************************************************************/
/*                  モニュメント6                             */
/**************************************************************/
EVENT_START   ev_pos_d26r0101_badge_check_06
{
  //ジムバッジを取得している場合のみ起動
  _SE_PLAY( SEQ_SE_SW_BCG_01 )
  _BGATE_START_MONUMENT( 5 )
  $WK_SCENE_D26R0101_GATE_06 = 2
}
EVENT_END

/**************************************************************/
/*                  モニュメント7                             */
/**************************************************************/
EVENT_START   ev_pos_d26r0101_badge_check_07
{
  //ジムバッジを取得している場合のみ起動
  _SE_PLAY( SEQ_SE_SW_BCG_01 )
  _BGATE_START_MONUMENT( 6 )
  $WK_SCENE_D26R0101_GATE_07 = 2
}
EVENT_END

/**************************************************************/
/*                  モニュメント8                             */
/**************************************************************/
EVENT_START   ev_pos_d26r0101_badge_check_08
{
  //ジムバッジを取得している場合のみ起動
  _SE_PLAY( SEQ_SE_SW_BCG_01 )
  _BGATE_START_MONUMENT( 7 )
  $WK_SCENE_D26R0101_GATE_08 = 2
}
EVENT_END

/**************************************************************/
/*                  門                                        */
/**************************************************************/
EVENT_START   ev_pos_d26r0101_open_gate
{
  IF $LOCALWORK0 == TRUE THEN
    DEFINE_LOCAL  LWK_X
    DEFINE_LOCAL  LWK_Y

    // 現在の場所を取得
    _OBJ_POS_GET( MMDL_ID_PLAYER ,LWK_X ,LWK_Y )

    // カメラ移動
    _CALL move_camera_start

    // すでに中央にいるとき以外は、中央まで歩かせる
    IF (($LWK_X != 31) || ($LWK_Y != 40)) THEN
      // オブジェクトの移動待ち
      _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 31, 40, FORCE_TYPE_NOT, 8, DIR_LR)
      _OBJ_ANIME_WAIT()

      // 上に向くアニメーション再生
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
      _OBJ_ANIME_WAIT()
    ENDIF 

    // カメラ移動待ち
    _CAMERA_WAIT_MOVE()

    // 門が開くイベント起動
    _BGATE_OPEN_GATE()

    // カメラを戻す
    _CALL move_camera_end
    
    // イベントを今後起動しないように設定
    $WK_SCENE_D26R0101_GATE_09 = 2

  ELSE
    // ※※ ↓↓ストーリーの流れ上絶対にここは通らないはずです↓↓ ※※
    // 一歩戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_down )
    _OBJ_ANIME_WAIT()
    // ※※ ↑↑ストーリーの流れ上絶対にここは通らないはずです↑↑ ※※
  ENDIF
}
EVENT_END


/************************************************************/
/*				カメラ操作				*/
/************************************************************/
move_camera_start:
{
  _CAMERA_START()       // カメラ操作開始
  _CAMERA_PURGE()		    // カメラのバインドを解く

  _CAMERA_MOVE(8920,0,1626112,2064384,393311,2322432,40 )
}
_RET

move_camera_end:
{
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _CAMERA_DEF_MOVE( 30 )
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _CAMERA_BIND()        // カメラバインド
  _CAMERA_END()         // カメラ操作終了
}
_RET

//--------------------------------------------------------------------
// 上に向く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_set_up_dir
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
// 下に移動
//--------------------------------------------------------------------
_ANIME_LABEL	anm_move_down
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA AC_DIR_D,1
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

