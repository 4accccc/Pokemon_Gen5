/**************************************************************/
/*                  門                                        */
/**************************************************************/
EVENT_START   ev_pos_d26r0101_open_gate
{
  IF $LOCALWORK0 == TRUE THEN
    DEFINE_LOCAL  LWK_X
    DEFINE_LOCAL  LWK_Y

    // 現在の場所を取得
    _OBJ_POS_GET( MMDL_ID_PLAYER ,LWK_X ,LWK_Y )

    // すでに中央にいるとき以外は、中央まで歩かせる
    IF (($LWK_X != 31) || ($LWK_Y != 44)) THEN
      // オブジェクトの移動待ち
      _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 31, 44, FORCE_TYPE_NOT, 8, DIR_LR)
      _OBJ_ANIME_WAIT()

      // 上に向くアニメーション再生
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
      _OBJ_ANIME_WAIT()
    ENDIF 

    // カメラ操作
    _CALL move_camera_start

    // 門が開くイベント起動
    _BGATE_OPEN_GATE()

    // カメラを戻す
    _CALL move_camera_end
    
    // イベントを今後起動しないように設定
    $WK_SCENE_D26R0101_GATE_09 = 2

    // 到着フラグをセット
    _FLAG_SET( SYS_FLAG_ARRIVE_D26R0101 )

  ELSE
    // ※※ ↓↓ストーリーの流れ上絶対にここは通らないはずです↓↓ ※※
    // 一歩戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_down )
    _OBJ_ANIME_WAIT()
    // ※※ ↑↑ストーリーの流れ上絶対にここは通らないはずです↑↑ ※※
  ENDIF
}
EVENT_END

/************************************************************/
/*                      カメラ操作                          */
/************************************************************/
move_camera_start:
{
  _CAMERA_START()       // カメラ操作開始
  _CAMERA_PURGE()       // カメラのバインドを解く

  // カメラ移動はギミックで操作している
}
_RET

move_camera_end:
{
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _CAMERA_DEF_MOVE( 30 )
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _CAMERA_BIND()        // カメラバインド
  _CAMERA_END()         // カメラ操作終了
}
_RET

/**************************************************************/
/*  POS：Nイベント                                            */
/**************************************************************/
EVENT_START   ev_pos_d26r0101_boss_01

  //アニメ：主人公移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 80, 50, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 16 )  //間

  //アニメ：Ｎ移動
  _OBJ_ANIME_AUTO( D26R0101_BOSS_01, 80, 47, FORCE_TYPE_NPC, 14, DIR_UD )
  _OBJ_ANIME_WAIT()

  //Ｎ：……きたね▼
  _BALLOONWIN_OBJMSG_POS( msg_d26r0101_boss_01, D26R0101_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：Ｎゲート方向を見る
  _OBJ_ANIME( D26R0101_BOSS_01, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  //Ｎ：この　チャンピオンロードの
  _BALLOONWIN_OBJMSG_POS( msg_d26r0101_boss_02, D26R0101_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：Ｎ主人公を見る
  _OBJ_ANIME( D26R0101_BOSS_01, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //Ｎ：ポケモンしょうぶ　とは
  _BALLOONWIN_OBJMSG_POS( msg_d26r0101_boss_03, D26R0101_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：Ｎ首ふり
  _OBJ_ANIME( D26R0101_BOSS_01, anm_n_act1 )
  _OBJ_ANIME_WAIT()

  //アニメ：Ｎ主人公に接近
  _OBJ_ANIME( D26R0101_BOSS_01, anm_walk_d )
  _OBJ_ANIME_WAIT()

  //Ｎ：ポケモンしょうぶ　とは！▼
  _BALLOONWIN_OBJMSG_POS( msg_d26r0101_boss_04, D26R0101_BOSS_01, POS_DEFAULT )

  //Ｎ：これが　ボクの　トモダチ（バージョンでセリフが異なる）
  _BALLOONWIN_OBJMSG_WB( msg_d26r0101_boss_05w, msg_d26r0101_boss_05b, D26R0101_BOSS_01, POS_DEFAULT )

  //手持ちにＮポケモンがいる場合は特殊セリフ
  _CALL ev_n_poke_call_01

  //Ｎ：これを　もっていきたまえ！▼
  _BALLOONWIN_OBJMSG_POS( msg_d26r0101_boss_07, D26R0101_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：Ｎ主人公に接近
  _OBJ_ANIME( D26R0101_BOSS_01, anm_walk_d )
  _OBJ_ANIME_WAIT()

  //秘伝マシン「たきのぼり」入手
  _ITEM_EVENT_KEYWAIT( ITEM_HIDENMASIN05, 1 )

  //Ｎ：キミと　キミの　ポケモンなら！▼（バージョンでセリフが異なる）
  _BALLOONWIN_OBJMSG_WB( msg_d26r0101_boss_08w, msg_d26r0101_boss_08b, D26R0101_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：Ｎ退場
  _OBJ_ANIME_AUTO( D26R0101_BOSS_01, 81, 56, FORCE_TYPE_NPC, 8, DIR_LR )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( D26R0101_BOSS_01 )

  //========================================//
  //Ｎを非表示
  _FLAG_SET( FV_D26R0101_BOSS )
  //POSイベント進行
  $WK_SCENE_D26R0101_BOSS = 1
  //ローカルライブキャスター・ライバル通話状態を変更（C09到達まで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_D26 )
  //D10R0501ライバル非表示（2012.01.11 水口追加）
  _FLAG_SET( FV_D10R0501_SWRIVAL_01 )
  //========================================//

EVENT_END


//Ｎポケモン所持チェック
ev_n_poke_call_01:

//手持ちにＮポケモンが要るか用変数定義
DEFINE_LOCAL LWK_PARTY_NUM    //手持ちポケモンの数
DEFINE_LOCAL LWK_COUNT_NUM    //WHILE文のカウンタ
DEFINE_LOCAL LWK_RET_MONSNO   //ナンバーチェックの帰り値
DEFINE_LOCAL LWK_N_POKE       //Ｎポケモンの有無

//手持ちのポケモンの数を確認（タマゴのポケモンは除外）
_GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_NOT_EGG )

//手持ちのポケモンの中にＮポケモンがいるか確認（繰り返し処理）
WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

	//Ｎポケモンかどうかチェック
	_GET_PARTY_POKE_PARAM( LWK_N_POKE, LWK_COUNT_NUM, SCR_POKEPARA_N_POKE )
	
	//Ｎポケだった場合
	IF $LWK_N_POKE == TRUE THEN
	
		//指定POSのポケモンのNOを取得
		_GET_PARTY_POKE_MONSNO( LWK_RET_MONSNO, LWK_COUNT_NUM )
	
		_MONS_NAME( 0, LWK_RET_MONSNO )
	
		//========================================/
		
		$LWK_N_POKE = 1
		
		//========================================/
	
	ENDIF

    //カウント
    $LWK_COUNT_NUM += 1

  ENDWHILE

//手持ちに条件を満たしたポケモンがいた場合
IF $LWK_N_POKE == 1 THEN

	//Ｎ：キミは……▼
	_BALLOONWIN_OBJMSG_POS( msg_d26r0101_boss_06, D26R0101_BOSS_01, POS_DEFAULT )

ENDIF

_RET


