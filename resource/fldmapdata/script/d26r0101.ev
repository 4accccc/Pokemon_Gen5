  .text

  .include  "scr_seq_def.h"
  .include  "msg_d26r0101.h"
  //.include  "d26r0101.h"

//------------------------------注意--------------------------------//
// シーンワークをプログラム側で参照しています。
// 
// WK_SCENE_D26R0101_GATE_01~8⇒像の起動フラグ
// WK_SCENE_D26R0101_GATE_09⇒門の起動用フラグ
// LOCALWORK0               ⇒バッジの入手状態（TRUEのときバッジ全入手）
//
//------------------------------------------------------------------/

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		 ev_zone_d26r0101
_EVENT_DATA    ev_pos_d26r0101_badge_check_01
_EVENT_DATA    ev_pos_d26r0101_badge_check_02
_EVENT_DATA    ev_pos_d26r0101_badge_check_03
_EVENT_DATA    ev_pos_d26r0101_badge_check_04
_EVENT_DATA    ev_pos_d26r0101_badge_check_05
_EVENT_DATA    ev_pos_d26r0101_badge_check_06
_EVENT_DATA    ev_pos_d26r0101_badge_check_07
_EVENT_DATA    ev_pos_d26r0101_badge_check_08
_EVENT_DATA    ev_pos_d26r0101_open_gate
_EVENT_DATA_END


/************************************************************/
/*					ジムギミック初期化						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d26r0101
{
  // ジムバッジの取得状態によって、起動できるモニュメントを変更する
  DEFINE_LOCAL  LWK_BADGE_GET
  DEFINE_LOCAL  LWK_ALL_BADGE_GET

  // 門起動用ワーク初期化(バッジチェックを一つでも未入手の時は開けない)
  $LWK_ALL_BADGE_GET = TRUE

  // バッジ1
  _GET_BADGE_FLAG( LWK_BADGE_GET, BADGE_ID_01 )
  IF ($LWK_BADGE_GET == TRUE) && ($WK_SCENE_D26R0101_GATE_01 == 0) THEN
    $WK_SCENE_D26R0101_GATE_01 = 1
  ELSE
    $LWK_ALL_BADGE_GET = FALSE
  ENDIF
 
  // バッジ2
  _GET_BADGE_FLAG( LWK_BADGE_GET, BADGE_ID_02 )
  IF ($LWK_BADGE_GET == TRUE) && ($WK_SCENE_D26R0101_GATE_02 == 0) THEN
    $WK_SCENE_D26R0101_GATE_02 = 1
  ELSE
    $LWK_ALL_BADGE_GET = FALSE
  ENDIF
 
  // バッジ3
  _GET_BADGE_FLAG( LWK_BADGE_GET, BADGE_ID_03 )
  IF ($LWK_BADGE_GET == TRUE) && ($WK_SCENE_D26R0101_GATE_03 == 0) THEN
    $WK_SCENE_D26R0101_GATE_03 = 1
  ELSE
    $LWK_ALL_BADGE_GET = FALSE
  ENDIF
 
  // バッジ4
  _GET_BADGE_FLAG( LWK_BADGE_GET, BADGE_ID_04 )
  IF ($LWK_BADGE_GET == TRUE) && ($WK_SCENE_D26R0101_GATE_04 == 0) THEN
    $WK_SCENE_D26R0101_GATE_04 = 1
  ELSE
    $LWK_ALL_BADGE_GET = FALSE
  ENDIF
 
  // バッジ5
  _GET_BADGE_FLAG( LWK_BADGE_GET, BADGE_ID_05 )
  IF ($LWK_BADGE_GET == TRUE) && ($WK_SCENE_D26R0101_GATE_05 == 0) THEN
    $WK_SCENE_D26R0101_GATE_05 = 1
  ELSE
    $LWK_ALL_BADGE_GET = FALSE
  ENDIF
 
  // バッジ6
  _GET_BADGE_FLAG( LWK_BADGE_GET, BADGE_ID_06 )
  IF ($LWK_BADGE_GET == TRUE) && ($WK_SCENE_D26R0101_GATE_06 == 0) THEN
    $WK_SCENE_D26R0101_GATE_06 = 1
  ELSE
    $LWK_ALL_BADGE_GET = FALSE
  ENDIF
 
  // バッジ7
  _GET_BADGE_FLAG( LWK_BADGE_GET, BADGE_ID_07 )
  IF ($LWK_BADGE_GET == TRUE) && ($WK_SCENE_D26R0101_GATE_07 == 0) THEN
    $WK_SCENE_D26R0101_GATE_07 = 1
  ELSE
    $LWK_ALL_BADGE_GET = FALSE
  ENDIF
 
  // バッジ8
  _GET_BADGE_FLAG( LWK_BADGE_GET, BADGE_ID_08 )
  IF ($LWK_BADGE_GET == TRUE) && ($WK_SCENE_D26R0101_GATE_08 == 0) THEN
    $WK_SCENE_D26R0101_GATE_08 = 1
  ELSE
    $LWK_ALL_BADGE_GET = FALSE
  ENDIF

   
  // 未起動の場合はかならず、起動可の状態にする
  // (門から戻すもしくは、門を開くを実行するため)
  IF $WK_SCENE_D26R0101_GATE_09 == 0 THEN
    $WK_SCENE_D26R0101_GATE_09 = 1
  ENDIF
    
  // バッジの取得状態を保存しておく
  $LOCALWORK0 = $LWK_ALL_BADGE_GET

}
INIT_EVENT_END

/**************************************************************/
/*                  モニュメント1                             */
/**************************************************************/
EVENT_START   ev_pos_d26r0101_badge_check_01
{
  //ジムバッジを取得している場合のみ起動
  _SE_PLAY( SEQ_SE_SW_BCG_01 )
  _BGATE_START_MONUMENT( 0 )
  $WK_SCENE_D26R0101_GATE_01 = 2
}
EVENT_END

