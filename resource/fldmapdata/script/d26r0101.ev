  // 確認メッセージ表示
  _SYSWIN_MSG( msg_d26r0101_badge_check_01, POS_DOWN )
  _LAST_KEYWAIT()
  _SYSWIN_CLOSE()

  $WK_SCENE_D26R0101_GATE_01 = 2
}
EVENT_END

