  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_d12.h"
  .include  "d12.h"
  .include  "c03p13_def.h"    //for reserve
  
  //@author suginaka_katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_d12_pilot_01
_EVENT_DATA    ev_d12_backpackerm_01
_EVENT_DATA    ev_d12_babyboy1_01
_EVENT_DATA    ev_d12_oldwoman1_01
_EVENT_DATA    ev_d12_sunglasses_01
_EVENT_DATA    ev_d12_woman2_01
_EVENT_DATA    ev_d12_policeman_01
_EVENT_DATA    ev_d12_bg_board_01
_EVENT_DATA    ev_d12_bg_board_02
_EVENT_DATA    ev_d12_bg_board_03
_EVENT_DATA    ev_reserve_d12
_EVENT_DATA    ev_zone_d12
_EVENT_DATA    ev_scene_d12
_EVENT_DATA_END

DEFINE_LOCAL	LWK_PARTY_NUM
DEFINE_LOCAL	LWK_RET_MONSNO
DEFINE_LOCAL	LWK_COUNT_NUM
DEFINE_LOCAL	LWK_ZUKAN

//LOCALWORK15を使用　0＝ビクティニ手持ちなし　1＝手持ちにいる
//LOCALWORK10を使用　0＝なし　1＝手持ちにいる　2＝捕獲した　3＝みた

/************************************************************/
/*		ゾーンチェンジ                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d12

//アララギイベントをまだ見ていない場合
IF $WK_SCENE_D12 == 0 THEN
	
	//フキヨセシティにいったことがある
	IF $WK_SCENE_C06HAKASE >= 1 THEN

		//手持ちのポケモンの数を確認（タマゴのポケモンは除外）
		_GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_NOT_EGG )

		//手持ちのポケモンの中にビクティニがいるか確認（繰り返し処理）
		WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

			//指定POSのポケモンのNOを取得
			_GET_PARTY_POKE_MONSNO( LWK_RET_MONSNO, LWK_COUNT_NUM )

			//ビクティニがいるかチェックする
			IF $LWK_RET_MONSNO == 494 THEN
				$LOCALWORK10 = 1
			ENDIF

			_DEBUG_PRINT_WK(LWK_RET_MONSNO)

			//カウント
			$LWK_COUNT_NUM += 1

		ENDWHILE

		//ビクティニが手持ちにいる場合
		IF $LOCALWORK10 == 1 THEN
			
			//========================================/
			
			//イベント起動
			$WK_SCENE_D12 = 1
			
			//========================================/
		//ビクティニが手持ちにはいない場合
		ELSE
			
			//捕獲済みかチェック
			_GET_ZUKAN_FLAG( ZUKANCTRL_MODE_GET, MONSNO_BIKUTHINI, LWK_ZUKAN )
			
			//捕獲済みの場合
			IF $LWK_ZUKAN == TRUE THEN
			
				//========================================/
				
				//イベント起動＆捕獲条件の値を代入
				$WK_SCENE_D12 = 1
				$LOCALWORK10 = 2
			
				//========================================/
			
			//捕獲していない場合
			ELSE

				//みたかチェック
				_GET_ZUKAN_FLAG( ZUKANCTRL_MODE_SEE, MONSNO_BIKUTHINI, LWK_ZUKAN )
			
				//すでにみている場合
				IF $LWK_ZUKAN == TRUE THEN

					//========================================/
					
					//イベント起動＆みた条件の値を代入
					$WK_SCENE_D12 = 1
					$LOCALWORK10 = 3
			
					//========================================/

				ENDIF
			
			ENDIF
		
		ENDIF
		
	ENDIF

ENDIF

INIT_EVENT_END

/************************************************************/
/*		シーンチェンジ                             */
/************************************************************/
EVENT_START   ev_scene_d12

	_PLACE_NAME_DISPLAY()

	_TIME_WAIT( 70 )

	//博士表示
	_OBJ_ADD_EX( 308,747,DIR_LEFT,MMDL_ID_EVENTOBJ_00,HAKASE2,MV_DMY )

	//博士歩く
	_OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 299, 747, FORCE_TYPE_NOT, 8, DIR_LR )
	_OBJ_ANIME_WAIT()
	
	//博士：！マーク後　お互い近づく
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_gyoe )
	_OBJ_ANIME_WAIT()
	
	_START_EVENT_BGM( SEQ_BGM_E_DOCTOR )	//博士イベントBGM開始
	
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_hakase2_01 )
	_OBJ_ANIME_WAIT()
	
	SWITCH $LOCALWORK10
	CASE 1 THEN	//手持ちにいる
		_BALLOONWIN_OBJMSG_POS( msg_d12_hakase2_01 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	CASE 2 THEN	//捕獲している
		_BALLOONWIN_OBJMSG_POS( msg_d12_hakase2_02 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	CASE 3 THEN	//みている
		_BALLOONWIN_OBJMSG_POS( msg_d12_hakase2_03 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	ENDSWITCH
	_MSGWIN_CLOSE()

	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_r_16f )
	_OBJ_ANIME_WAIT()
	
	_TIME_WAIT( 30 )
	
	_BALLOONWIN_OBJMSG_POS( msg_d12_hakase2_04 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()

	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_l )
	_OBJ_ANIME_WAIT()

	_BALLOONWIN_OBJMSG_POS( msg_d12_hakase2_05 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//博士退場
	_OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 298, 762, FORCE_TYPE_NOT, 8, DIR_UD )
	_TIME_WAIT( 20 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_d )
	_OBJ_ANIME_WAIT()

	_END_EVENT_BGM()	//博士イベントBGM終了

	//博士OBJ削除
	_OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
	
	//========================================/
	
	//アララギイベント終了
	$WK_SCENE_D12 = 2
	
	//========================================/

EVENT_END

//--------------------------------------------------------------------
//	☆博士：専用アニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_hakase2_01
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_WALK_L_8F,2
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*				船から下りたところ                                */
/************************************************************/
EVENT_START	ev_reserve_d12

	//マップ遷移ブラックイン
	_MAP_FADE_BLACK_IN()
	_MAP_FADE_END_CHECK()

	IF $WK_SCENE_D12 != 1 THEN 
		_PLACE_NAME_DISPLAY()	//地名表示演出
	ENDIF

	//自機一歩移動
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
	_OBJ_ANIME_WAIT()

EVENT_END

/**************************************************************/
/*  D12 pilot_01			                      			  */
/**************************************************************/
EVENT_START   ev_d12_pilot_01
  _TALK_OBJ_START()
  //もどる？
  _BALLOONWIN_TALKOBJ_MSG(msg_d12_mariner_01)
	_YES_NO_WIN( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_YES THEN
    //もどるで
  	_BALLOONWIN_TALKOBJ_MSG(msg_d12_mariner_02)
    _BALLOONWIN_CLOSE()
    //船長移動
    _OBJ_ANIME( D12_PILOT_01, anm_walk_l )
    _TIME_WAIT( 8 )
    //自機移動
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
    //スクリプトリザーブ
    _RESERVE_SCRIPT( SCRID_RESERVE_C03P13 )
    //マップジャンプ
    {
      _MAP_FADE_BLACK_OUT()
		  _MAP_FADE_END_CHECK()
		  _SE_PLAY( SEQ_SE_VDEMO_02 )
      _RAIL_MAP_CHANGE_NO_FADE( ZONE_ID_C03P13, 0, 2, 11, DIR_RIGHT )
      _SE_WAIT()
    }
	ELSE
    //またね
    _BALLOONWIN_TALKOBJ_MSG(msg_d12_mariner_03)
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
	ENDIF
EVENT_END

/**************************************************************/
/*  D12 backpackerm_01			                      */
/**************************************************************/
EVENT_START   ev_d12_backpackerm_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_d12_visitor01_01 )
EVENT_END

/**************************************************************/
/*  D12 babyboy1_01			                      */
/**************************************************************/
EVENT_START   ev_d12_babyboy1_01

    DEFINE_LOCAL sex
    _GET_MY_SEX( sex )
    IF $sex == PM_MALE THEN
      //おにいちゃん　やっつけた
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d12_visitor02_01 )
    ELSE
      //おねえちゃん　やっつけた
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d12_visitor02_02 )
    ENDIF
    
EVENT_END

/**************************************************************/
/*  D12 oldwoman1_01			                      */
/**************************************************************/
EVENT_START   ev_d12_oldwoman1_01
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d12_visitor03_01 )
EVENT_END

/**************************************************************/
/*  D12 sunglasses_01			                      */
/**************************************************************/
EVENT_START   ev_d12_sunglasses_01

//手持ちのポケモンの数を確認（タマゴのポケモンは除外）
_GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_NOT_EGG )

//手持ちのポケモンの中にビクティニがいるか確認（繰り返し処理）
WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

	//指定POSのポケモンのNOを取得
	_GET_PARTY_POKE_MONSNO( LWK_RET_MONSNO, LWK_COUNT_NUM )

	//ビクティニがいるかチェックする
	IF $LWK_RET_MONSNO == 494 THEN
		$LOCALWORK15 = 1
	ENDIF

	_DEBUG_PRINT_WK(LWK_RET_MONSNO)

	//カウント
	$LWK_COUNT_NUM += 1

ENDWHILE

//ビクティニが手持ちにいる場合
IF $LOCALWORK15 == 1 THEN
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_d12_visitor04_02 )
ELSE
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_d12_visitor04_01 )
ENDIF

EVENT_END

/**************************************************************/
/*  D12 woman2_01			                      */
/**************************************************************/
EVENT_START   ev_d12_woman2_01
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d12_visitor05_01 )
EVENT_END

/**************************************************************/
/*  D12 policeman_01			                      */
/**************************************************************/
EVENT_START   ev_d12_policeman_01
    //プラズマだんの　やつら
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d12_police01_01 )
EVENT_END

/**************************************************************/
/*  D12 bg_board_01			                      */
