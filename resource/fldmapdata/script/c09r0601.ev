
//======================================================================
//                c09r0601.ev
//
//    スクリプトファイル：c09r0601用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0601.h"
  .include  "c09r0601.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA     ev_reserve_c09r0601_swchampion_01
_EVENT_DATA_END


/**************************************************************/
/*  入室時発動イベント：殿堂入り処理                          */
/**************************************************************/
EVENT_START   ev_reserve_c09r0601_swchampion_01

  //アニメ：主人公一歩上へ
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_c09r0601_walk_up_01 )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 8 )

  //プレイヤーネームを格納
  _PLAYER_NAME( 0 )

  //初回話しかけかチェック
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
    //初回会話
    //アイリス：ここはね
    _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_01, C09R0601_SWCHAMPION_01 )
    _MSGWIN_CLOSE()

  ELSE
    //２回目以降
    //アイリス：また　きたね▼
    _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_02, C09R0601_SWCHAMPION_01 )
    _MSGWIN_CLOSE()

  ENDIF

  //アニメ：主人公とチャンピオンマシンの前へ
  _OBJ_ANIME( C09R0601_SWCHAMPION_01, anm_c09r0601_walk_up_02 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_c09r0601_walk_up_02 )
  _OBJ_ANIME_WAIT()

  //カメラ：マシン中心に
  _CAMERA_START()   //カメラ操作開始
  _CAMERA_PURGE()   //カメラのバインドを解く
  _CAMERA_MOVE( 9688, 0, 970752, 557056, 131103, 294912, 32 )

  //アニメ：チャンピオンふりむく
  _OBJ_ANIME( C09R0601_SWCHAMPION_01, anm_c09r0601_champion_look_player )
  _OBJ_ANIME_WAIT()

  _CAMERA_WAIT_MOVE()   //カメラ移動待ち

  //性別が格納されるローカル変数を定義
  DEFINE_LOCAL SCWK_SEX
  _GET_MY_SEX( SCWK_SEX )

  //男性だった場合
  IF $SCWK_SEX == PM_MALE THEN

    //アイリス：それでは　おにーちゃん！▼
    _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_03, C09R0601_SWCHAMPION_01 )
    _BALLOONWIN_CLOSE()

  //女性だった場合
  ELSE

    //アイリス：それでは　おねーちゃん！▼
    _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_04, C09R0601_SWCHAMPION_01 )
    _BALLOONWIN_CLOSE()

  ENDIF

  //アニメ：チャンピオン、マシンを見る
  _OBJ_ANIME( C09R0601_SWCHAMPION_01, anm_c09r0601_champion_look_up )
  _OBJ_ANIME_WAIT()

  //アイリス：この　マシンに　きろく　します！！
  _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_05, C09R0601_SWCHAMPION_01 )
  _BALLOONWIN_CLOSE()

  //殿堂入りアニメイベント
  _DENDOU_ANIME()

  //カメラ処理終了
  _CAMERA_END()
  
  //ワンアンドオンリー（手持ち一匹）メダル処理
  {
  
  _CHECK_MEDAL_GET( LOCALWORK14, MDLID_LONELY_CHAMPION )
  _GET_PARTY_POKE_COUNT( LOCALWORK15, POKECOUNT_MODE_TOTAL )
  
  IF $LOCALWORK14 == FALSE && $LOCALWORK15 == 1  THEN 
    //メダル入手条件達成
    _SET_MEDAL_ACHIVE( MDLID_LONELY_CHAMPION )
  ENDIF
  
  }

  //ゲームクリア前後で分岐【仮】
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    //殿堂入り処理（初）
    _GOTO_GAMECLEAR_DEMO( 0 )

  ELSE

    //殿堂入り処理（２回目以降）
    _GOTO_GAMECLEAR_DEMO( 1 )

  ENDIF

EVENT_END


//--------------------------------------------------------------------
//主人公：一歩上へ進む
//--------------------------------------------------------------------
_ANIME_LABEL  anm_c09r0601_walk_up_01
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//でんどういり：マシンの前に移動
//--------------------------------------------------------------
_ANIME_LABEL  anm_c09r0601_walk_up_02
  _ANIME_DATA AC_WALK_U_8F,12
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//でんどういり：チャンピオン主人公を見る
//--------------------------------------------------------------
_ANIME_LABEL  anm_c09r0601_champion_look_player
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//でんどういり：マシンを見る
//--------------------------------------------------------------
_ANIME_LABEL  anm_c09r0601_champion_look_up
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0


