
//======================================================================
//                c09r0601.ev
//
//    スクリプトファイル：c09r0601用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0601.h"
  .include  "c09r0601.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori//スクリプト修正・演出調整

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA     ev_reserve_c09r0601_swchampion_01
_EVENT_DATA_END


/**************************************************************/
/*  入室時発動イベント：殿堂入り処理                          */
/**************************************************************/
EVENT_START   ev_reserve_c09r0601_swchampion_01

  //アニメ：主人公一歩上へ
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 8 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  //アイリス配置
  _OBJ_ADD_EX( 8, 19, DIR_UP, MMDL_ID_EVENTOBJ_00, SWCHAMPION, MV_DMY )
  _SE_WAIT()

  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_player_front )
  _OBJ_ANIME_WAIT()

  //プレイヤーネームを格納
  _PLAYER_NAME( 0 )

  //初回話しかけかチェック
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
    //初回会話
    //アイリス：ここはね
    _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_01, MMDL_ID_EVENTOBJ_00 )
    _MSGWIN_CLOSE()

  ELSE
    //２回目以降
    //アイリス：また　きたね▼
    _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_02, MMDL_ID_EVENTOBJ_00 )
    _MSGWIN_CLOSE()

  ENDIF

  //アニメ：主人公とチャンピオンマシンの前へ
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_dendou_front_swchampion )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dendou_front_player )
  _OBJ_ANIME_WAIT()

  //カメラ：マシン中心に
  _CAMERA_START()   //カメラ操作開始
  _CAMERA_PURGE()   //カメラのバインドを解く
  _CAMERA_MOVE( 9688, 0, 970752, 557056, 131103, 294912, 20 )
  _CAMERA_WAIT_MOVE()   //カメラ移動待ち

  //性別が格納されるローカル変数を定義
  DEFINE_LOCAL SCWK_SEX
  _GET_MY_SEX( SCWK_SEX )

  //アイリス・主人公向かい合う
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_l )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //男性だった場合
  IF $SCWK_SEX == PM_MALE THEN

    //アイリス：それでは　おにーちゃん！▼
    _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_03, MMDL_ID_EVENTOBJ_00 )
    _BALLOONWIN_CLOSE()

  //女性だった場合
  ELSE

    //アイリス：それでは　おねーちゃん！▼
    _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_04, MMDL_ID_EVENTOBJ_00 )
    _BALLOONWIN_CLOSE()

  ENDIF

  //アニメ：チャンピオン、マシンを見る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //アイリス：この　マシンに　きろく　します！！
  _BALLOONWIN_OBJMSG( msg_c09r0601_swchampion_05, MMDL_ID_EVENTOBJ_00 )
  _BALLOONWIN_CLOSE()

  //殿堂入りアニメイベント
  _DENDOU_ANIME()

  //カメラ処理終了
  _CAMERA_END()
  
  //ワンアンドオンリー（手持ち一匹）メダル処理
  {
  
  _CHECK_MEDAL_GET( LOCALWORK14, MDLID_LONELY_CHAMPION )
  _GET_PARTY_POKE_COUNT( LOCALWORK15, POKECOUNT_MODE_TOTAL )
  
  IF $LOCALWORK14 == FALSE && $LOCALWORK15 == 1  THEN 
    //メダル入手条件達成
    _SET_MEDAL_ACHIVE( MDLID_LONELY_CHAMPION )
  ENDIF
  
  }
  
  //殿堂入りヒントメダル取得
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_NORMAL )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_HONOO )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_MIZU )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_DENKI )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_KUSA )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_KOORI )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_KAKUTOU )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_DOKU )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_JIMEN )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_HIKOU )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_ESPER )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_MUSHI )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_IWA )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_GHOST )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_DRAGON )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_AKU )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CHAMPION_HAGANE )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_LONELY_CHAMPION )

  //ゲームクリア前後で分岐
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    // チャンピオンロードのスクリプトでMAP_FADE_BLACK_INを呼んでいるため
    // ここでBLACK_OUTを呼んで対にする
    _MAP_FADE_BLACK_OUT()
    _MAP_FADE_END_CHECK()

    //殿堂入り処理（初）
    _GOTO_GAMECLEAR_DEMO( 0 )

  ELSE

    // チャンピオンロードのスクリプトでMAP_FADE_BLACK_INを呼んでいるため
    // ここでBLACK_OUTを呼んで対にする
    _MAP_FADE_BLACK_OUT()
    _MAP_FADE_END_CHECK()

    //殿堂入り処理（２回目以降）
    _GOTO_GAMECLEAR_DEMO( 1 )

  ENDIF

EVENT_END

//--------------------------------------------------------------
//でんどういり：マシンの前に移動
//--------------------------------------------------------------
_ANIME_LABEL  anm_walk_player_front
	_ANIME_DATA AC_WALK_R_8F,1
	_ANIME_DATA AC_WALK_U_8F,3
	_ANIME_DATA AC_WALK_L_8F,1
	_ANIME_DATA AC_STAY_WALK_D_8F,1
	_ANIME_DATA ACMD_END,0

_ANIME_LABEL	anm_dendou_front_player
	_ANIME_DATA	AC_WALK_U_8F,13
	_ANIME_DATA	ACMD_END,0
	
_ANIME_LABEL	anm_dendou_front_swchampion
	_ANIME_DATA	AC_WALK_U_8F,11
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：下に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_d
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：上に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_u
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

