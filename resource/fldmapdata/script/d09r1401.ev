
//======================================================================
//                d09r1401.ev
//
//    スクリプトファイル：d09r1401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d09r1401.h"
  .include  "d09r1401.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_pos_d09r1401_swrival_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL LCW_POSX
DEFINE_LOCAL LCW_POSZ


/**************************************************************/
/*  POS：ライバル戦                                           */
/**************************************************************/
EVENT_START   ev_pos_d09r1401_swrival_01

  //プライヤー名代入
  _PLAYER_NAME( 0 )
  //ライバル名代入
  _RIVAL_NAME( 1 )

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ )

   //フィールド上にライバル配置
  _OBJ_ADD_EX( 22, 12, DIR_UP, MMDL_ID_EVENTOBJ_00, SWRIVAL, MV_DMY )
  _SE_PLAY( SEQ_SE_KAIDAN )  //階段SE再生
  _SE_WAIT()  //SE待ち

  //ライバル曲再生
  _START_EVENT_BGM( SEQ_BGM_E_HUE )

  //ライバル：まてよ！▼
  _PLAINWIN_MSG_DOWN( msg_d09r1401_swrival_01 )
  _PLAINWIN_CLOSE()

  //アニメ：主人公振り向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  $LCW_POSX += 2
  //アニメ：ライバル接近
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()

  //ライバル：ポケモンリーグに　むかってるよな▽
  _BALLOONWIN_OBJMSG_POS( msg_d09r1401_swrival_02, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //ライバル戦呼び出し　最初の３匹によって分岐
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_16, 0 )
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_17, 0 )
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_18, 0 )
  ENDIF

  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF

  _TIME_WAIT( 8 )

  //アニメ：ライバル別方向を向く
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  //ライバル：……《主人公》！
  _BALLOONWIN_OBJMSG_POS( msg_d09r1401_swrival_03, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ライバル接近
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_l )
  _OBJ_ANIME_WAIT()

  //わざマシン２４（10まんボルト）入手
  _ITEM_EVENT_NOWAIT( ITEM_WAZAMASIN24, 1 )

  //ライバル：オレじしん　これから　どうするか
  _BALLOONWIN_OBJMSG_POS( msg_d09r1401_swrival_04, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ライバル退場
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 22, 12, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _SE_PLAY( SEQ_SE_KAIDAN )  //階段SE再生
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )  //ライバル動作モデル削除
  _SE_WAIT()  //SE待ち

  //ライバル曲停止
  _END_EVENT_BGM()

  //========================================//
  //POS無効
  $WK_SCENE_D09R1401_SWRIVAL_01 = 1
  //ローカルライブキャスター・ライバル通話状態を変更（ポケモンリーグ到達まで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_PLASMAHOME_1 )
  //========================================//

EVENT_END


//--------------------------------------------------------------------
//☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL  anm_staystep_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_d
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_walk_u
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_walk_r
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_walk_l
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0


