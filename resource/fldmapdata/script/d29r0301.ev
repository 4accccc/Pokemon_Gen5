_EVENT_DATA		ev_d29r0301_d29r0101_workman2_01
_EVENT_DATA		ev_d29r0301_d29r0101_workman2_02
_EVENT_DATA		ev_d29r0301_workman2_01
_EVENT_DATA		ev_d29r0301_workman2_01a
_EVENT_DATA		ev_d29r0301_workman2_02
_EVENT_DATA		ev_d29r0301_workman2_02a
_EVENT_DATA		ev_reserve_d29r0301_recover
_EVENT_DATA_END

/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_d29r0301:
//  _END

/**************************************************************/
/*			トロッコおじさん								  */
/**************************************************************/
EVENT_START		ev_d29r0301_d29r0101_workman2_01


	_TALK_OBJ_START()
	
	//この　トロッコに　のるかい
	_BALLOONWIN_TALKOBJ_MSG( msg_d29r0301_workman2_01 )

	//はい・いいえ分岐
	_YES_NO_WIN( SCWK_ANSWER )
	
	//はいの場合
	IF $SCWK_ANSWER == SCR_YES THEN
	
		_BALLOONWIN_TALKOBJ_MSG( msg_d29r0301_workman2_02 )
		_MSGWIN_CLOSE()
		
		//暗転処理
		_MAP_FADE_BLACK_OUT_SLOW()
		_OBJ_ANIME( D29R0301_WORKMAN2_03, anm_stay_u )
		_MAP_FADE_END_CHECK()
		_OBJ_ANIME_WAIT()
		
		//ガタゴトSE再生
		_SE_PLAY(SEQ_SE_SW_YACONROAD_01)
		_SE_WAIT()
		
		//フラグセット
		//========================================/
		
		_FLAG_SET(FV_D29R0301_WORKMAN2_03)
		_FLAG_RESET(FV_D29R0101_WORKMAN2_03)
		
		//========================================/
		
		//予約スクリプト
		_RESERVE_SCRIPT( SCRID_RESERVE_D29R0101_RECOVER )

		//マップチェンジ
		_MAP_CHANGE_NO_FADE( ZONE_ID_D29R0101, 16, 0, 7, DIR_DOWN )
		
	//いいえの場合
	ELSE
	
		_BALLOONWIN_TALKOBJ_MSG( msg_d29r0301_workman2_03 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	
	ENDIF

EVENT_END

