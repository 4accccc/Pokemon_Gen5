	ENDIF

EVENT_END


/**************************************************************/
/*			トロッコおじさん	同ゾーン内					  */
/**************************************************************/
EVENT_START		ev_d29r0301_workman2_01

	_TALK_OBJ_START()
	
	//この　トロッコに　のるかい
	_BALLOONWIN_TALKOBJ_MSG( msg_d29r0301_workman2_01 )

	//はい・いいえ分岐
	_YES_NO_WIN( SCWK_ANSWER )
	
	//はいの場合
	IF $SCWK_ANSWER == SCR_YES THEN
	
		_BALLOONWIN_TALKOBJ_MSG( msg_d29r0301_workman2_02 )
		_MSGWIN_CLOSE()
		
		//暗転
		_BLACK_OUT()
		_OBJ_ANIME( D29R0301_WORKMAN2_01, anm_stay_r )
		_DISP_FADE_END_CHECK()
		_OBJ_ANIME_WAIT()
		
		//ガタゴトSE再生
		_SE_PLAY(SEQ_SE_SW_YACONROAD_01)
		_SE_WAIT()
		
		//フラグセット
		//========================================/
		
		_FLAG_SET(FV_D29R0301_WORKMAN2_01)
		_FLAG_RESET(FV_D29R0301_WORKMAN2_01A)
		
		//========================================/
		
		_OBJ_DEL( D29R0301_WORKMAN2_01 )
		_OBJ_ADD( D29R0301_WORKMAN2_01A )
		
		//マップチェンジ
		_OBJ_POS_CHANGE( MMDL_ID_PLAYER, 26, 0, 73, DIR_LEFT )
		
		_TIME_WAIT( 60 )

		//暗転復帰
		_BLACK_IN()
		_DISP_FADE_END_CHECK()
	
	//いいえの場合
	ELSE
	
		_BALLOONWIN_TALKOBJ_MSG( msg_d29r0301_workman2_03 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	
	ENDIF

EVENT_END

