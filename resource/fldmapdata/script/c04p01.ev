_EVENT_DATA		ev_c04p01_girl4_01
_EVENT_DATA_END

/************************************************************/
/*  ZONE CHANGE                                             */
/************************************************************/
INIT_EVENT_START  ev_zone_c04p01

  //進行状況によってジムギミックを初期化
  //クリア時
  IF FLAG_ON( FE_C04GYM0101_CLEAR ) THEN
    //================================================//
    //ゾーンBGM変更フラグをリセット
    _FLAG_RESET( SYS_FLAG_BGM_C04GYM0101_SHOW )
    //================================================//

  ENDIF

  // 観覧車
  {
    DEFINE_LOCAL lwk_date
    DEFINE_LOCAL i_npc_obj

    // LCC隠しキャラとのデートがあるかチェック
    _PERSON_STATE_CHECK_SECRET_DATE( lwk_date )

    //曜日を取得
    _GET_WEEK( SCWK_ANSWER )
    SWITCH $SCWK_ANSWER
    CASE RTC_WEEK_TUESDAY THEN
      $i_npc_obj = SWRIVAL // 火曜はライバル
    CASE RTC_WEEK_WEDNESDAY THEN
      $i_npc_obj = SWBELL // 水曜日はベル
    CASE RTC_WEEK_FRIDAY THEN
      $i_npc_obj = BOSS // 金曜日はN
    CASE RTC_WEEK_SATURDAY THEN
      $i_npc_obj = SWLEADER1 // 土曜日はチェレン
    ENDSWITCH

    // LCC隠しキャラとデート有りなら
    //  111024追加 落し物イベントでも観覧車で処理する
    IF $lwk_date != 0 THEN
      _GET_MY_SEX( SCWK_ANSWER )
      IF $SCWK_ANSWER == PM_MALE THEN
        $OBJCHRWORK0 = SWIDOLW
      ELSE
        $OBJCHRWORK0 = SWIDOLM
      ENDIF
      // 見た目を保存しておく
      $WK_OTHER_AMUSEMENT_PARTNER = SCR_AMUSEMENT_PARTNER_LCC

    // NPCキャラOBJコードが設定されている かつ 
    // タイムフラグがOFFだったら（イベントをやっていないなら）
    // かつ　シナリオクリア後
    ELSIF $i_npc_obj > 0 && FLAG_OFF( TMFLG_AMUSEMENT_NPC ) && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
      $OBJCHRWORK0 = $i_npc_obj
      // 見た目を保存しておく
      $WK_OTHER_AMUSEMENT_PARTNER = SCR_AMUSEMENT_PARTNER_NPC
      
    ELSE
    // それ以外
    // WBの時と同じ処理
    {
      //観覧車トレーナーの見た目を決定
      DEFINE_LOCAL  i_wheel_trainer
      DEFINE_LOCAL  i_season

      _GET_SEASON_ID( i_season )
      IF $WK_OTHER_WHEEL_SEASON != $i_season THEN
      //もし季節が異なっていたら、タイムフラグをリセット
      _FLAG_RESET( TMFLG_AMUSEMENT_TR_BTL )
      ENDIF

      _GET_WHEEL_TRAINER_ENTRY_ID( i_wheel_trainer )
      _GET_WHEEL_TRAINER_OBJ_ID( i_wheel_trainer, SCWK_ANSWER )
      $OBJCHRWORK0 = $SCWK_ANSWER

      //今の季節を憶えておく
      $WK_OTHER_WHEEL_SEASON = $i_season

      // 見た目を保存しておく
      $WK_OTHER_AMUSEMENT_PARTNER = SCR_AMUSEMENT_PARTNER_DEFAULT
    }
    ENDIF
  }

  {
  //クリア後ライブキャスターステータス設定
  
  //変数を定義
  DEFINE_LOCAL LCWK_NOW_WEEK
  
  //曜日を取得
  _GET_WEEK( LCWK_NOW_WEEK )
  
  //ライバル出現状態（火曜）
  IF $LCWK_NOW_WEEK == RTC_WEEK_TUESDAY  && FLAG_OFF( TMFLG_AMUSEMENT_NPC ) && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //ローカルライブキャスター・ライバル通話状態を変更
    _PERSON_STATE_SET_RIVAL( RIVAL_STATE_PARK )
  //ベル出現状態（水曜）
  ELSIF $LCWK_NOW_WEEK == RTC_WEEK_WEDNESDAY  && FLAG_OFF( TMFLG_AMUSEMENT_NPC ) && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //ローカルライブキャスター・ベル通話状態を変更
    _PERSON_STATE_SET_BELL( BELL_STATE_PARK )
  //チェレン出現状態（土曜）
  ELSIF $LCWK_NOW_WEEK == RTC_WEEK_SATURDAY  && FLAG_OFF( TMFLG_AMUSEMENT_NPC ) && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //ローカルライブキャスター・チェレン通話状態を変更
    _PERSON_STATE_SET_CHELEN( CHELEN_STATE_PARK )
  ENDIF
  
  //ライバル出現条件を満たしていないならばイベント進行状態に合わせてセット
  IF $LCWK_NOW_WEEK != RTC_WEEK_TUESDAY && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //ローカルライブキャスター・ライバル通話状態を変更
    //サザナミ戦前
    IF FLAG_OFF( FE_T04_SWRIVAL_WIN_01 ) && FLAG_OFF( FE_C05R0501_RIVAL_BTL_END ) THEN
      _PERSON_STATE_SET_RIVAL( RIVAL_STATE_T04 )
    //ポケモンハウス戦前
    ELSIF FLAG_ON( FE_T04_SWRIVAL_WIN_01 ) && FLAG_OFF( FE_C05R0501_RIVAL_BTL_END ) THEN
      _PERSON_STATE_SET_RIVAL( RIVAL_STATE_PLASMAHOME_1 )
    //ポケモンハウス戦後
    ELSIF FLAG_ON( FE_T04_SWRIVAL_WIN_01 ) && FLAG_ON( FE_C05R0501_RIVAL_BTL_END ) THEN
      _PERSON_STATE_SET_RIVAL( RIVAL_STATE_PLASMAHOME_2 )
    ENDIF
  
  ENDIF
  
  //ベル出現条件を満たしていないならばセット
  IF $LCWK_NOW_WEEK != RTC_WEEK_WEDNESDAY && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //ローカルライブキャスター・ベル通話状態を変更
    _PERSON_STATE_SET_BELL( BELL_STATE_HOME )
  ENDIF
  
  //チェレン出現条件を満たしていないならばイベント進行状態に合わせてセット
  IF $LCWK_NOW_WEEK != RTC_WEEK_SATURDAY && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //ローカルライブキャスター・チェレン通話状態を変更
    //ヤグルマの森未クリア
    IF $WK_SCENE_D02R0101_SWLEADER1 == 0  THEN
      _PERSON_STATE_SET_CHELEN( CHELEN_STATE_YAGURUMA )
    //ヤグルマの李クリア後
    ELSIF $WK_SCENE_D02R0101_SWLEADER1 == 1  THEN
      _PERSON_STATE_SET_CHELEN( CHELEN_STATE_GYM )
    ENDIF
    
  ENDIF
  
  }

INIT_EVENT_END


/************************************************************/
/*  ジム看板                                                */
/************************************************************/
EVENT_START   ev_bg_c04p01_sign_01
  _EASY_BGWIN_MSG( msg_c04p01_gymsign_01, TYPE_POST )
EVENT_END

/************************************************************/
/*  ジム看板                                                */
