EVENT_START   ev_bg_c04p01_sign_02
  _EASY_BGWIN_MSG( msg_c04p01_sign1_01, TYPE_POST )
EVENT_END

/**************************************************************/
/*		落し物イベント										  */
/**************************************************************/
EVENT_START		ev_c04p01_tvt_ev_01

	_TALK_START_SE_PLAY()

	DEFINE_LOCAL	LWK_SEX
	
	_GET_MY_SEX(LWK_SEX)

	//アイテム入手処理
	_OBJ_DEL(C04P01_TVT_EV_01)
	
	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_ITEM_EVENT_FIELD(ITEM_WASUREMONO_1,1)
	CASE PM_FEMALE THEN
		_ITEM_EVENT_FIELD(ITEM_WASUREMONO,1)
	ENDSWITCH

	//TVT着信音を再生
	_ME_PLAY( SEQ_ME_CALL )
	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolw_01, POS_DOWN )
	CASE PM_FEMALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolm_01, POS_DOWN )
	ENDSWITCH
	_ME_WAIT()
	
	_PLAYER_NAME(0)
	
	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolw_02, POS_DOWN )
	CASE PM_FEMALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolm_02, POS_DOWN )
	ENDSWITCH
	_MSGWIN_CLOSE()
	
	//ライブキャスター起動
	_MAP_FADE_BLACK_OUT()
	_MAP_FADE_END_CHECK()
	
	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_CALL_TVT_DEMO_REVERSE( 2 )
	CASE PM_FEMALE THEN
		_CALL_TVT_DEMO_REVERSE( 3 )
	ENDSWITCH
	_MAP_FADE_BLACK_IN()
	_MAP_FADE_END_CHECK()

  //隠しキャラに電話できるようにする
	_PERSON_TVT_CALL_SET_SECRET()

	//========================================/
	
	_FLAG_SET(FV_C04P01_ITEM_01)

	//全てのＰＯＳイベントを無効にする
	$WK_SCENE_C04_LOCALTVT = 1
	$WK_SCENE_C05_LOCALTVT = 1
	$WK_SCENE_C06_LOCALTVT = 1
	$WK_SCENE_T03_LOCALTVT = 1
	$WK_SCENE_T04_LOCALTVT = 1
	$WK_SCENE_T07_LOCALTVT = 1
	$WK_SCENE_R05_LOCALTVT = 1
	$WK_SCENE_R06_LOCALTVT = 1
	$WK_SCENE_R07_LOCALTVT = 1
	$WK_SCENE_R09_LOCALTVT = 1
	$WK_SCENE_R11_LOCALTVT = 1
	$WK_SCENE_R12_LOCALTVT = 1
	$WK_SCENE_R13_LOCALTVT = 1
	$WK_SCENE_R14_LOCALTVT = 1
	$WK_SCENE_R16_LOCALTVT = 1

	//========================================/


EVENT_END

