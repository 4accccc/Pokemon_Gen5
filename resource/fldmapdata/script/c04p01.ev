_EVENT_DATA    ev_bg_c04p01_sign_01
_EVENT_DATA		ev_zone_c04p01
_EVENT_DATA_END

/************************************************************/
/*					ZONE CHANGE						*/
/************************************************************/
INIT_EVENT_START	ev_zone_c04p01

	//進行状況によってジムギミックを初期化
	//クリア時
	IF FLAG_ON( FE_C04GYM0101_CLEAR ) THEN
		
		//================================================//
		//ゾーンBGM変更フラグをリセット
		_FLAG_RESET( SYS_FLAG_BGM_C04GYM0101_SHOW )
		//================================================//
	ENDIF
	
INIT_EVENT_END


/************************************************************/
/*						ジム看板							*/
/************************************************************/
EVENT_START	ev_bg_c04p01_sign_01
