
//======================================================================
//                c04p01.ev
//
//    スクリプトファイル：c04p01用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c04p01.h"
  .include  "c04p01.h"

  //@author fujimura_souichirou(ライモンラリー)

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_bg_c04p01_sign_01
_EVENT_DATA   ev_zone_c04p01
_EVENT_DATA   ev_c04p01_clown_01
_EVENT_DATA_END

/************************************************************/
/*  ZONE CHANGE                                             */
/************************************************************/
INIT_EVENT_START  ev_zone_c04p01

  //進行状況によってジムギミックを初期化
  //クリア時
  IF FLAG_ON( FE_C04GYM0101_CLEAR ) THEN
    //================================================//
    //ゾーンBGM変更フラグをリセット
    _FLAG_RESET( SYS_FLAG_BGM_C04GYM0101_SHOW )
    //================================================//

  ENDIF

  // 観覧車
  {
    DEFINE_LOCAL lwk_date
    DEFINE_LOCAL i_npc_obj

    // LCC隠しキャラとのデートがあるかチェック
    _PERSON_STATE_CHECK_SECRET_DATE( lwk_date )

    //曜日を取得
    _GET_WEEK( SCWK_ANSWER )
    SWITCH $SCWK_ANSWER
    CASE RTC_WEEK_TUESDAY THEN
      $i_npc_obj = SWRIVAL // 火曜はライバル
    CASE RTC_WEEK_WEDNESDAY THEN
      $i_npc_obj = SWBELL // 水曜日はベル
    CASE RTC_WEEK_FRIDAY THEN
      $i_npc_obj = BOSS // 金曜日はN
    CASE RTC_WEEK_SATURDAY THEN
      $i_npc_obj = SWLEADER1 // 土曜日はチェレン
    ENDSWITCH

    // LCC隠しキャラとデート有りなら
    IF $lwk_date != 0 THEN
      _GET_MY_SEX( SCWK_ANSWER )
      IF $SCWK_ANSWER == PM_MALE THEN
        $OBJCHRWORK0 = SWIDOLW
      ELSE
        $OBJCHRWORK0 = SWIDOLM
      ENDIF
      // 見た目を保存しておく
      $WK_OTHER_AMUSEMENT_PARTNER = SCR_AMUSEMENT_PARTNER_LCC

    // NPCキャラOBJコードが設定されている かつ 
    // タイムフラグがOFFだったら（イベントをやっていないなら）
    // かつ　シナリオクリア後
    ELSIF $i_npc_obj > 0 && FLAG_OFF( TMFLG_AMUSEMENT_NPC ) && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
      $OBJCHRWORK0 = $i_npc_obj
      // 見た目を保存しておく
      $WK_OTHER_AMUSEMENT_PARTNER = SCR_AMUSEMENT_PARTNER_NPC
    ELSE
    // それ以外
    // WBの時と同じ処理
    {
      //観覧車トレーナーの見た目を決定
      DEFINE_LOCAL  i_wheel_trainer
      DEFINE_LOCAL  i_season

      _GET_SEASON_ID( i_season )
      IF $WK_OTHER_WHEEL_SEASON != $i_season THEN
      //もし季節が異なっていたら、タイムフラグをリセット
      _FLAG_RESET( TMFLG_AMUSEMENT_TR_BTL )
      ENDIF

      _GET_WHEEL_TRAINER_ENTRY_ID( i_wheel_trainer )
      _GET_WHEEL_TRAINER_OBJ_ID( i_wheel_trainer, SCWK_ANSWER )
      $OBJCHRWORK0 = $SCWK_ANSWER

      //今の季節を憶えておく
      $WK_OTHER_WHEEL_SEASON = $i_season

      // 見た目を保存しておく
      $WK_OTHER_AMUSEMENT_PARTNER = SCR_AMUSEMENT_PARTNER_DEFAULT
    }
    ENDIF
  }

INIT_EVENT_END


/************************************************************/
/*  ジム看板                                                */
/************************************************************/
EVENT_START   ev_bg_c04p01_sign_01
  _EASY_BGWIN_MSG( msg_c04p01_gymsign_01, TYPE_POST )
EVENT_END

/************************************************************/
/*  クラウン１（ライモンラリー）                            */
/************************************************************/
EVENT_START   ev_c04p01_clown_01

  _TALK_OBJ_START()
  //ライモンラリー・かんらんしゃ通過（1回のみ）
  IF $WK_SCENE_C04_RALLY != 7 && FLAG_OFF( FE_C04_RALLYPOINT_05 )THEN
    _SE_PLAY( SEQ_SE_FLD_41 ) //正解SE
    _BALLOONWIN_TALKOBJ_MSG( msg_c04p01_rally_01 )

    //========================================//
    //クリア後メッセージ表示終了
    _FLAG_SET( FE_C04_RALLYPOINT_05 )
    //========================================//
    //C04イベント進行
    $WK_SCENE_C04_RALLY += 1
    //========================================//

    _SE_WAIT()
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE
    //以降のメッセージ
    _BALLOONWIN_TALKOBJ_MSG( msg_c04p01_rally_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END


