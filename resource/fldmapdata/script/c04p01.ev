_EVENT_DATA		ev_c04p01_tvt_ev_01
_EVENT_DATA		ev_c04p01_glasses_01
_EVENT_DATA_END

/************************************************************/
/*  ZONE CHANGE                                             */
/************************************************************/
INIT_EVENT_START  ev_zone_c04p01

  //進行状況によってジムギミックを初期化
  //クリア時
  IF FLAG_ON( FE_C04GYM0101_CLEAR ) THEN
    //================================================//
    //ゾーンBGM変更フラグをリセット
    _FLAG_RESET( SYS_FLAG_BGM_C04GYM0101_SHOW )
    //================================================//

  ENDIF

  // 観覧車
  {
    DEFINE_LOCAL lwk_date
    DEFINE_LOCAL i_npc_obj

    // LCC隠しキャラとのデートがあるかチェック
    _PERSON_STATE_CHECK_SECRET_DATE( lwk_date )

	//観覧車前イベント起動用
	IF $lwk_date == SCR_PERSON_SECRET_DATE_GIVE THEN
	
		_FLAG_RESET(FV_C04P01_IDOL_01)
	
		_GET_MY_SEX( SCWK_ANSWER )
		IF $SCWK_ANSWER == PM_MALE THEN
			$OBJCHRWORK10 = SWIDOLW
		ELSE
			$OBJCHRWORK10 = SWIDOLM
		ENDIF
	
	ENDIF
	
    //曜日を取得
    _GET_WEEK( SCWK_ANSWER )
    SWITCH $SCWK_ANSWER
    CASE RTC_WEEK_TUESDAY THEN
      $i_npc_obj = SWRIVAL // 火曜はライバル
    CASE RTC_WEEK_WEDNESDAY THEN
      $i_npc_obj = SWBELL // 水曜日はベル
    CASE RTC_WEEK_FRIDAY THEN
      $i_npc_obj = BOSS // 金曜日はN
    CASE RTC_WEEK_SATURDAY THEN
      $i_npc_obj = SWLEADER1 // 土曜日はチェレン
    ENDSWITCH

    // LCC隠しキャラとデート有りなら
    IF $lwk_date != 0 && $lwk_date != SCR_PERSON_SECRET_DATE_GIVE THEN
      _GET_MY_SEX( SCWK_ANSWER )
      IF $SCWK_ANSWER == PM_MALE THEN
        $OBJCHRWORK0 = SWIDOLW
      ELSE
        $OBJCHRWORK0 = SWIDOLM
      ENDIF
      // 見た目を保存しておく
      $WK_OTHER_AMUSEMENT_PARTNER = SCR_AMUSEMENT_PARTNER_LCC

    // NPCキャラOBJコードが設定されている かつ 
    // タイムフラグがOFFだったら（イベントをやっていないなら）
    // かつ　シナリオクリア後
    ELSIF $i_npc_obj > 0 && FLAG_OFF( TMFLG_AMUSEMENT_NPC ) && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
      $OBJCHRWORK0 = $i_npc_obj
      // 見た目を保存しておく
      $WK_OTHER_AMUSEMENT_PARTNER = SCR_AMUSEMENT_PARTNER_NPC
      
    ELSE
    // それ以外
    // WBの時と同じ処理
    {
      //観覧車トレーナーの見た目を決定
      DEFINE_LOCAL  i_wheel_trainer
      DEFINE_LOCAL  i_season

      _GET_SEASON_ID( i_season )
      IF $WK_OTHER_WHEEL_SEASON != $i_season THEN
      //もし季節が異なっていたら、タイムフラグをリセット
      _FLAG_RESET( TMFLG_AMUSEMENT_TR_BTL )
      ENDIF

      _GET_WHEEL_TRAINER_ENTRY_ID( i_wheel_trainer )
      _GET_WHEEL_TRAINER_OBJ_ID( i_wheel_trainer, SCWK_ANSWER )
      $OBJCHRWORK0 = $SCWK_ANSWER

      //今の季節を憶えておく
      $WK_OTHER_WHEEL_SEASON = $i_season

      // 見た目を保存しておく
      $WK_OTHER_AMUSEMENT_PARTNER = SCR_AMUSEMENT_PARTNER_DEFAULT
    }
    ENDIF
  }

INIT_EVENT_END


/************************************************************/
/*  ジム看板                                                */
/************************************************************/
EVENT_START   ev_bg_c04p01_sign_01
  _EASY_BGWIN_MSG( msg_c04p01_gymsign_01, TYPE_POST )
EVENT_END

/************************************************************/
/*  ジム看板                                                */
/************************************************************/
EVENT_START   ev_bg_c04p01_sign_02
  _EASY_BGWIN_MSG( msg_c04p01_sign1_01, TYPE_POST )
EVENT_END


/************************************************************/
/*  クラウン１（ライモンラリー）                            */
/************************************************************/
EVENT_START   ev_c04p01_clown_01

  _TALK_OBJ_START()
  //ライモンラリー・かんらんしゃ通過（1回のみ）
  IF $WK_SCENE_C04_RALLY != 7 && FLAG_OFF( FE_C04_RALLYPOINT_05 )THEN
    _SE_PLAY( SEQ_SE_FLD_41 ) //正解SE
    _BALLOONWIN_TALKOBJ_MSG( msg_c04p01_rally_01 )

    //========================================//
    //クリア後メッセージ表示終了
    _FLAG_SET( FE_C04_RALLYPOINT_05 )
    //========================================//
    //C04イベント進行
    $WK_SCENE_C04_RALLY += 1
    //========================================//

    _SE_WAIT()
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE
    //以降のメッセージ
    _BALLOONWIN_TALKOBJ_MSG( msg_c04p01_rally_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

/**************************************************************/
/*		落し物イベント										  */
/**************************************************************/
EVENT_START		ev_c04p01_tvt_ev_01

	_TALK_START_SE_PLAY()

	//アイテム入手処理
	_OBJ_DEL(C04P01_TVT_EV_01)
	_ITEM_EVENT_FIELD(ITEM_RAIBUKYASUTAA_1,1)

	DEFINE_LOCAL	LWK_SEX
	
	_GET_MY_SEX(LWK_SEX)

	//TVT着信音を再生
	_ME_PLAY( SEQ_ME_CALL )
	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolw_01, POS_DOWN )
	CASE PM_FEMALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolm_01, POS_DOWN )
	ENDSWITCH
	_ME_WAIT()
	
	_PLAYER_NAME(0)
	
	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolw_02, POS_DOWN )
	CASE PM_FEMALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolm_02, POS_DOWN )
	ENDSWITCH
	_MSGWIN_CLOSE()
	
	//ライブキャスター起動
	_MAP_FADE_BLACK_OUT()
	_MAP_FADE_END_CHECK()
	
	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_CALL_TVT_DEMO_REVERSE( 2 )
	CASE PM_FEMALE THEN
		_CALL_TVT_DEMO_REVERSE( 3 )
	ENDSWITCH
	_MAP_FADE_BLACK_IN()
	_MAP_FADE_END_CHECK()

	//========================================/
	
	_FLAG_SET(FV_C04P01_ITEM_01)

	//全てのＰＯＳイベントを無効にする
	$WK_SCENE_C04_LOCALTVT = 1
	$WK_SCENE_C05_LOCALTVT = 1
	$WK_SCENE_C06_LOCALTVT = 1
	$WK_SCENE_T03_LOCALTVT = 1
	$WK_SCENE_T04_LOCALTVT = 1
	$WK_SCENE_T07_LOCALTVT = 1
	$WK_SCENE_R05_LOCALTVT = 1
	$WK_SCENE_R06_LOCALTVT = 1
	$WK_SCENE_R07_LOCALTVT = 1
	$WK_SCENE_R09_LOCALTVT = 1
	$WK_SCENE_R11_LOCALTVT = 1
	$WK_SCENE_R12_LOCALTVT = 1
	$WK_SCENE_R13_LOCALTVT = 1
	$WK_SCENE_R14_LOCALTVT = 1
	$WK_SCENE_R16_LOCALTVT = 1

	//========================================/


EVENT_END

/**************************************************************/
/*		C04P01	IDOL										  */
/**************************************************************/
EVENT_START		ev_c04p01_idol_01

	_TALK_OBJ_START()
	
	//プレイヤー名を格納する
	_PLAYER_NAME(0)
	
	//わっ　わたし　ちがい　ますから！
	_BALLOONWIN_OBJMSG_MF( msg_c04p01_swidolw_02_01, msg_c04p01_swidolm_02_01, C04P01_IDOL_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_GET_MY_SEX(LWK_SEX)
	
	//～～は　？？？？？に
	_SE_PLAY(SEQ_SE_ARDEMO_01)

	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolw_02_02, POS_DOWN )
	CASE PM_FEMALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolm_02_02, POS_DOWN )
	ENDSWITCH
	_SYSWIN_CLOSE()
	_SE_WAIT()
	
	//アイテムを減らす
	_SUB_ITEM( ITEM_RAIBUKYASUTAA_1,1,SCWK_ANSWER )
	
	//ありがとう
	_BALLOONWIN_OBJMSG_MF( msg_c04p01_swidolw_02_03, msg_c04p01_swidolm_02_03, C04P01_IDOL_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolw_02_04, POS_DOWN )
	CASE PM_FEMALE THEN
		_SYSWIN_MSG( msg_c04p01_swidolm_02_04, POS_DOWN )
	ENDSWITCH
	_SYSWIN_CLOSE()

	//ありがとう
	_BALLOONWIN_OBJMSG_MF( msg_c04p01_swidolw_02_05, msg_c04p01_swidolm_02_05, C04P01_IDOL_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	_PLAYER_DIR_GET( SCWK_ANSWER )

	SWITCH $SCWK_ANSWER
	CASE DIR_UP THEN
		_OBJ_ANIME( C04P01_IDOL_01, anm_idol_leave2 )
	DEFAULT
		_OBJ_ANIME( C04P01_IDOL_01, anm_idol_leave1 )
	ENDSWITCH
	_TIME_WAIT( 20 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_d )
	_OBJ_ANIME_WAIT()
	
	_OBJ_DEL( C04P01_IDOL_01 )
	
	_PERSON_STATE_SET_SECRET_DATE_END()
	
	//========================================/
	
	_FLAG_SET(FV_C04P01_IDOL_01)
	
	//========================================/

EVENT_END

//--------------------------------------------------------------------
//☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL  anm_dir_u
  _ANIME_DATA AC_DIR_U,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_dir_d
  _ANIME_DATA AC_DIR_D,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_dir_l
  _ANIME_DATA AC_DIR_L,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_dir_r
  _ANIME_DATA AC_DIR_R,1
  _ANIME_DATA ACMD_END,0
 
_ANIME_LABEL	anm_idol_leave1
	_ANIME_DATA	AC_WALK_D_8F,2
	_ANIME_DATA	AC_WALK_L_8F,8
	_ANIME_DATA	ACMD_END,0
	
_ANIME_LABEL	anm_idol_leave2
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_D_8F,2
	_ANIME_DATA	AC_WALK_L_8F,8
	_ANIME_DATA	ACMD_END,0

