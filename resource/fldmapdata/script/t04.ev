	_ANIME_DATA	AC_MARK_HATENA,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*		SAGE7：海底遺跡サブイベント							  */
/**************************************************************/
EVENT_START		ev_t04_sage7_01
_TALK_OBJ_START()

SWITCH $WK_OTHER_D20_ARRIVE
CASE 0 THEN	//七賢人登場前
	//異常処理・本来行かない
	_DEBUG_PRINT_WK(WK_OTHER_D20_ARRIVE)
CASE 1 THEN	//解読イベント後・海底遺跡にまだ入っていない。
	//ねんのため　つたえておくが
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_03 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
CASE 2 THEN	//海底遺跡に入った。
	//ゲーチスさまの　しょもつに
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_04 )
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_10 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
CASE 3 THEN	//2階層到達
	//しょもつには　たしか　こう　しるされていた
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_05 )
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_10 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
CASE 4 THEN	//3階層到達
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_09 )
	//たみの　あらそいを　おさめ
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_06 )
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_10 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	//========================================/
	//会話済みにする
	$WK_OTHER_D20_ARRIVE = 5
	//========================================/
CASE 5 THEN	//3階層到達で七賢人と会話済
	//たみの　あらそいを　おさめ
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_06 )
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_10 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
CASE 6 THEN	//4階層到達
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_09 )
	//おうは　みらいを　よみ
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_07 )
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_10 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	//========================================/
	//会話済みにする
	$WK_OTHER_D20_ARRIVE = 7
	//========================================/
CASE 7 THEN	//4階層到達で七賢人と会話済
	//おうは　みらいを　よみ
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_07 )
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_10 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
CASE 8 THEN	//こだいのおうかん入手
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_09 )
	//けんとうの　つかない
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_08 )
	_MSGWIN_CLOSE()
	
	_ITEM_EVENT_KEYWAIT( ITEM_OOKINASINZYU, 1 )
	
	_BALLOONWIN_TALKOBJ_MSG( msg_t04_sage7_end_11 )
	_MSGWIN_CLOSE()
	
	//自機座標取得
	_PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

	//アニメ：七賢人退場
	IF $LCW_POSZ == 300  THEN
		//主人公をよけて歩く
		_OBJ_ANIME_AUTO( T04_SAGE7_01, 752, 296, FORCE_TYPE_NPC, 8, DIR_LR )
	ELSE
		_OBJ_ANIME_AUTO( T04_SAGE7_01, 753, 296, FORCE_TYPE_NPC, 8, DIR_UD )
	ENDIF

	_TIME_WAIT( 24 )

	//アニメ：主人公見送り
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
	_OBJ_ANIME_WAIT()

	_SE_PLAY( SEQ_SE_KAIDAN )   //階段SE再生
	_OBJ_DEL( T04_SAGE7_01 )  //ライバル動作モデル削除
	_SE_WAIT()  //SE待ち
	
	//========================================/
	//七賢人のバニシュフラグセット
	_FLAG_SET(FV_T04_SAGE7_01)
	//========================================/

ENDSWITCH

EVENT_END
