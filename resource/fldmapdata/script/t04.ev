  //@author Mizuguchi_Mai
  //@author fujimura_souichirou（ライバル戦のトレーナーデータ差し替え・クリア後イベント）
  //@author suginaka_katsunori//海底遺跡イベント・スクリプト修正

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_bg_t04_sign1_01
_EVENT_DATA		ev_bg_t04_sign1_02
_EVENT_DATA		ev_zone_t04
_EVENT_DATA		ev_pos_t04_swrival_01
_EVENT_DATA		ev_t04_man3_01
_EVENT_DATA		ev_t04_trainerm_01
_EVENT_DATA		ev_t04_maid_01
_EVENT_DATA		ev_t04_ambrella_01
_EVENT_DATA		ev_t04_babygirl1_01
_EVENT_DATA   ev_t04_swrival_01
_EVENT_DATA		ev_t04_sage7_01
_EVENT_DATA		ev_pos_t04_localtvt_01
_EVENT_DATA		ev_t04_workman2_01
_EVENT_DATA		ev_bg_t04_sign4_01
_EVENT_DATA		ev_t04_trainerw_01
_EVENT_DATA    ev_recover_t04
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//バージョン取得
DEFINE_LOCAL LCWK_VERSION

/************************************************************/
/*		CALL：特殊接続                             */
/************************************************************/
ev_exit_change:

  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //バージョンごとに異なる接続を配置
  
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_T04_D24R1201_EXIT01, 707, -4, 299 )
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_T04_D24R0601_EXIT01, 707, -4, 299 )
  ENDIF

_RET

/************************************************************/
/*					ZONE_CHANGE_SCRIPT						*/
/************************************************************/
INIT_EVENT_START	ev_zone_t04
  
  _CALL ev_exit_change
	
	_FLAG_SET( FV_T04_SUMMER )
{
	//季節チェック
	DEFINE_LOCAL SCWK_SEASON
	_GET_SEASON_ID( SCWK_SEASON )
	
	//出現確率を割り振る変数定義
	DEFINE_LOCAL LWK_RANDNUM
	DEFINE_LOCAL LWK_RANDWORD
	
	//夏だったら住民を表示
	IF $SCWK_SEASON == PMSEASON_SUMMER THEN
		_FLAG_RESET( FV_T04_SUMMER )
	ENDIF
	
	//シロナの別荘イベント設定
	
	IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
  	
  	//シロナとの初回戦闘が終わっていない
  	IF $WK_SCENE_T04R0301 == 1  || $WK_SCENE_T04R0301 == 2  THEN
  		
  		//初期状態で全員非表示
  		_FLAG_SET( FV_T04R0301_BIGFOUR4_01 )
  		_FLAG_SET( FV_T04R0301_BIGFOUR1_01 )
  		_FLAG_SET( FV_T04R0301_SWLEADER6_01 )
  		_FLAG_SET( FV_T04R0301_SWLEADER4_01 )
  		_FLAG_SET( FV_T04R0301_SWLEADER2_01 )
  		
  		//シロナを表示
  		_FLAG_RESET( FV_T04R0301_SHIRONA_01 )
  		
  	//シロナとの初回戦闘終了済み
  	ELSIF $WK_SCENE_T04R0301 == 3 THEN
  	
  		//春で今日の設定をまだ行っていない
  		IF $SCWK_SEASON == PMSEASON_SPRING && FLAG_OFF( TMFLG_T04R0401_TALKSET ) THEN
  			
  			//初期状態で全員非表示
  			_FLAG_SET( FV_T04R0301_SHIRONA_01 )
  			_FLAG_SET( FV_T04R0301_BIGFOUR4_01 )
  			_FLAG_SET( FV_T04R0301_BIGFOUR1_01 )
  			_FLAG_SET( FV_T04R0301_SWLEADER6_01 )
  			_FLAG_SET( FV_T04R0301_SWLEADER4_01 )
  			_FLAG_SET( FV_T04R0301_SWLEADER2_01 )
  			
  			//***シロナを表示
  			_FLAG_RESET( FV_T04R0301_SHIRONA_01 )
  			//***シロナの本日のセリフを設定
  			_GET_RND( LWK_RANDWORD,2 )
  			$WK_OTHER_T04R0301_SHIRONA = $LWK_RANDWORD
  			
  			//***カトレアを75%の確率で表示する
  			_GET_RND( LWK_RANDNUM,4 )
  			IF $LWK_RANDNUM <= 2 THEN
  				_FLAG_RESET( FV_T04R0301_BIGFOUR4_01 )
  				
  				//カトレアの本日のセリフを設定
  				_GET_RND( LWK_RANDWORD,5 )
  				$WK_OTHER_T04R0301_BIGFOUR4 = $LWK_RANDWORD
  				
  			//3ははずれで非表示
  			ELSE
  				_FLAG_SET( FV_T04R0301_BIGFOUR4_01 )
  			ENDIF
  			
  			//***シキミを50%の確率で表示する
  			_GET_RND( LWK_RANDNUM,2 )
  			IF $LWK_RANDNUM == 1 THEN
  				_FLAG_RESET( FV_T04R0301_BIGFOUR1_01 )
  				
  				//シキミの本日のセリフを設定
  				_GET_RND( LWK_RANDWORD,5 )
  				$WK_OTHER_T04R0301_BIGFOUR1 = $LWK_RANDWORD
  				
  			//0ははずれで非表示
  			ELSE
  				_FLAG_SET( FV_T04R0301_BIGFOUR1_01 )
  			ENDIF
  			
  			//==================================//
  					
  			//本日の設定は終了
  			_FLAG_SET ( TMFLG_T04R0401_TALKSET )
  			
  			//==================================//
  		
  		//夏で今日の設定をまだ行っていない
  		ELSIF  $SCWK_SEASON == PMSEASON_SUMMER && FLAG_OFF( TMFLG_T04R0401_TALKSET ) THEN
  			
  			//初期状態で全員非表示
  			_FLAG_SET( FV_T04R0301_SHIRONA_01 )
  			_FLAG_SET( FV_T04R0301_BIGFOUR4_01 )
  			_FLAG_SET( FV_T04R0301_BIGFOUR1_01 )
  			_FLAG_SET( FV_T04R0301_SWLEADER6_01 )
  			_FLAG_SET( FV_T04R0301_SWLEADER4_01 )
  			_FLAG_SET( FV_T04R0301_SWLEADER2_01 )
  			
  			//***シロナの本日のセリフを設定
  			_GET_RND( LWK_RANDWORD,5 )
  			$WK_OTHER_T04R0301_SHIRONA = $LWK_RANDWORD
  			_FLAG_RESET( FV_T04R0301_SHIRONA_01 )
  			
  			//***フウロを75%の確率で表示する
  			_GET_RND( LWK_RANDNUM,4 )
  			_DEBUG_PRINT_WK( LWK_RANDNUM )
  			IF $LWK_RANDNUM <= 2 THEN
  				_FLAG_RESET( FV_T04R0301_SWLEADER6_01 )
  				
  				//フウロの本日のセリフを設定
  				_GET_RND( LWK_RANDWORD,5 )
  				$WK_OTHER_T04R0301_SWLEADER6 = $LWK_RANDWORD
  				
  			//3ははずれで非表示
  			ELSE
  				_FLAG_SET( FV_T04R0301_SWLEADER6_01 )
  			ENDIF
  			
  			//***カミツレを50%の確率で表示する
  			_GET_RND( LWK_RANDNUM,2 )
  			_DEBUG_PRINT_WK( LWK_RANDNUM )
  			IF $LWK_RANDNUM == 1 THEN
  				_FLAG_RESET( FV_T04R0301_SWLEADER4_01 )
  				
  				//カミツレの本日のセリフを設定
  				_GET_RND( LWK_RANDWORD,5 )
  				$WK_OTHER_T04R0301_SWLEADER4 = $LWK_RANDWORD
  				
  			//0ははずれで非表示
  			ELSE
  				_FLAG_SET( FV_T04R0301_SWLEADER4_01 )
  			ENDIF
  			
  			//***アロエを25%の確率で表示する
  			_GET_RND( LWK_RANDNUM,4 )
  			_DEBUG_PRINT_WK( LWK_RANDNUM )
  			IF $LWK_RANDNUM == 3 THEN
  				_FLAG_RESET( FV_T04R0301_SWLEADER2_01 )
  				
  				//アロエの本日のセリフを設定
  				_GET_RND( LWK_RANDWORD,5 )
  				$WK_OTHER_T04R0301_SWLEADER2 = $LWK_RANDWORD
  				
  			//0ははずれで非表示
  			ELSE
  				_FLAG_SET( FV_T04R0301_SWLEADER2_01 )
  			ENDIF
  			
  			//==================================//
  					
  			//本日の設定は終了
  			_FLAG_SET ( TMFLG_T04R0401_TALKSET )
  			
  			//==================================//

  		//秋・冬（全員非表示）
  		ELSIF  $SCWK_SEASON == PMSEASON_AUTUMN || $SCWK_SEASON == PMSEASON_WINTER THEN
  			_FLAG_SET( FV_T04R0301_SHIRONA_01 )
  			_FLAG_SET( FV_T04R0301_BIGFOUR4_01 )
  			_FLAG_SET( FV_T04R0301_BIGFOUR1_01 )
  			_FLAG_SET( FV_T04R0301_SWLEADER6_01 )
  			_FLAG_SET( FV_T04R0301_SWLEADER4_01 )
  			_FLAG_SET( FV_T04R0301_SWLEADER2_01 )

  		ENDIF
  	
  	ENDIF
  
  //クリア前
  ELSE
    
    _FLAG_SET( FV_T04R0301_SHIRONA_01 )
    _FLAG_SET( FV_T04R0301_BIGFOUR4_01 )
    _FLAG_SET( FV_T04R0301_BIGFOUR1_01 )
    _FLAG_SET( FV_T04R0301_SWLEADER6_01 )
    _FLAG_SET( FV_T04R0301_SWLEADER4_01 )
    _FLAG_SET( FV_T04R0301_SWLEADER2_01 )
    
  ENDIF

  //クリア後、ライバルを再配置（なおかつイベントクリア前なら）
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) && FLAG_OFF( FE_T04_SWRIVAL_WIN_01 ) THEN

    //==================================//
    //ライバルを表示
    _FLAG_RESET ( FV_T04_SWRIVAL_01 )
    //==================================//
    
    //==================================//
    //ライバルのライブキャスターの状態を変更
    _PERSON_STATE_SET_RIVAL( RIVAL_STATE_T04 )
    //==================================//

  ENDIF
  

}
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_t04

  _CALL ev_exit_change

INIT_EVENT_END

/**************************************************************/
/*  POS：ライバル戦＋七賢人海底遺跡イベント                   */
/**************************************************************/
EVENT_START   ev_pos_t04_swrival_01

  //プライヤー名代入
  _PLAYER_NAME( 0 )
  //ライバル名代入
  _RIVAL_NAME( 1 )

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
   //フィールド上にライバル配置
  _OBJ_ADD_EX( LCW_POSX, 307, DIR_DOWN, MMDL_ID_EVENTOBJ_00, SWRIVAL, MV_DMY )
  
  //ライバル曲再生
  _START_EVENT_BGM( SEQ_BGM_E_HUE )
  
  //ライバル：待てよ！
  _PLAINWIN_MSG_DOWN( msg_t04_swrival_01 )
  
  //アニメ：主人公振り向く
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  _PLAINWIN_CLOSE()
    
  $LCW_POSZ += 2
  //アニメ：ライバル接近
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ライバル：どれだけ
  _BALLOONWIN_OBJMSG_POS( msg_t04_swrival_02,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //ライバル戦呼び出し　最初の３匹によって分岐
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_10, 0 )
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_11, 0 )
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_12, 0 )
  ENDIF
  
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
  
  //ライバル：なるほど
  _BALLOONWIN_OBJMSG_POS( msg_t04_swrival_03,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル別方向を向く
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ライバル：まっ　プラズマ団のあいては
  _BALLOONWIN_OBJMSG_POS( msg_t04_swrival_04,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル向きなおす
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ライバル：というわけで
  _BALLOONWIN_OBJMSG_POS( msg_t04_swrival_05,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  IF $LCW_POSX > 752  THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_swrival_bye_753 )
  //一番左の座標のケース
  ELSE
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_swrival_bye_751 )
  ENDIF
  
  _TIME_WAIT( 12 )
  
  //アニメ：主人公見送り
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //ライバル動作モデル削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  //SE待ち
  _SE_WAIT()
  
  //ライバル曲停止
	_END_EVENT_BGM()
  
  //========================================//
  //T04POS無効
  $WK_SCENE_T04 = 1
  //ローカルライブキャスター・ライバル通話状態を変更（T03マルチバトルまで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_T03 )
  //========================================//

EVENT_END

//--------------------------------------------------------------------
//	ライバル：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swrival_bye_751
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_U_8F,5
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	ライバル：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swrival_bye_753
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_U_8F,5
	_ANIME_DATA	ACMD_END,0
  

/**************************************************************/
/*		ライブキャスターイベント					  */
/**************************************************************/
EVENT_START		ev_pos_t04_localtvt_01
	
	//TVT着信音を再生
	_ME_PLAY( SEQ_ME_CALL )
	_SYSWIN_MSG( msg_t04_tvt_01, POS_DOWN )
	_ME_WAIT()

	_PLAYER_NAME(0)
	_SYSWIN_MSG( msg_t04_tvt_02, POS_DOWN )
	_MSGWIN_CLOSE()
	
	//ライブキャスター起動
	
	//ライブキャスター起動
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()
  _CALL_TVT_DEMO( 7 )
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()
  
	//========================================/
	
	//ライブキャスターイベント終了
	$WK_SCENE_T04_D20_TVT = 2
	
	//========================================/
	
	
EVENT_END

