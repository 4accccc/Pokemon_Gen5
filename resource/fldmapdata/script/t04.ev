	_EASY_BGWIN_MSG( msg_t04_sign4_01, TYPE_POST)	//簡易メッセージＢＧ用
EVENT_END


/**************************************************************/
/*  ライバル：話しかけ（クリア後に出現）                      */
/**************************************************************/
EVENT_START   ev_t04_swrival_01

  _TALK_OBJ_START()

  //プレイヤー名代入
  _PLAYER_NAME( 0 )

  //ライバル名代入
  _RIVAL_NAME( 1 )

  //アイテム受け取り済みか
  IF FLAG_OFF( FE_T04_ITEMGET_01 ) THEN

    //ライバル：…………なんだよ▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_01 )
    _MSGWIN_CLOSE()

    //秘伝マシン06「ダイビング」入手
    _ITEM_EVENT_KEYWAIT( ITEM_HIDENMASIN06, 1 )

    //========================================//
    //アイテム入手フラグON
    _FLAG_SET( FE_T04_ITEMGET_01 )
    //========================================//
    
    //プライヤー名代入
    _PLAYER_NAME( 0 )
    //ライバル名代入
    _RIVAL_NAME( 1 )

    //ライバル：それは　ダイビング▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_02 )

    //ライバル：でさ　オマエ
    _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_03 )

    //ライバルと戦う？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //ライバル：かつのは　オレたち　だぜ！▼
      _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_04 )
      _MSGWIN_CLOSE()

      //ライバル戦呼び出し　最初の３匹によって分岐
      IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
        //初期３匹で草タイプを選択
        _TRAINER_BTL_SET( TRID_SWRIVAL_19, 0 )
      ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
        //初期３匹で炎タイプを選択
        _TRAINER_BTL_SET( TRID_SWRIVAL_20, 0 )
      ELSE
        //初期３匹で水タイプを選択
        _TRAINER_BTL_SET( TRID_SWRIVAL_21, 0 )
      ENDIF

      //結果チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()
      ELSE
        _TRAINER_LOSE()
      ENDIF

      //プライヤー名代入
      _PLAYER_NAME( 0 )
      //ライバル名代入
      _RIVAL_NAME( 1 )

      //ライバル：……ったく▼
      _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_06 )
      _MSGWIN_CLOSE()

      //自機座標取得
      _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

      //アニメ：ライバル退場
      IF $LCW_POSZ == 300  THEN
        //主人公をよけて歩く
        _OBJ_ANIME_AUTO( T04_SWRIVAL_01, 752, 296, FORCE_TYPE_NPC, 8, DIR_LR )
      ELSE
        _OBJ_ANIME_AUTO( T04_SWRIVAL_01, 753, 296, FORCE_TYPE_NPC, 8, DIR_UD )
      ENDIF

      _TIME_WAIT( 24 )

      //アニメ：主人公見送り
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
      _OBJ_ANIME_WAIT()

      _SE_PLAY( SEQ_SE_KAIDAN )   //階段SE再生
      _OBJ_DEL( T04_SWRIVAL_01 )  //ライバル動作モデル削除
      _SE_WAIT()  //SE待ち

      //==================================//
      //ライバルに勝利した（イベント終了）
      _FLAG_SET ( FE_T04_SWRIVAL_WIN_01 )
      //ライバルを非表示
      _FLAG_SET ( FV_T04_SWRIVAL_01 )
      //ホドモエ・ポケモンハウスのライバルを表示
      _FLAG_RESET ( FV_C05R0501_SWRIVAL_01 )
      //ローカルライブキャスター・ライバル通話状態を変更（C05R0501戦闘前）
      _PERSON_STATE_SET_RIVAL( RIVAL_STATE_PLASMAHOME_1 )
      //==================================//

      _CALL ev_sage7

    ELSE
      
      //プライヤー名代入
      _PLAYER_NAME( 0 )
      //ライバル名代入
      _RIVAL_NAME( 1 )

      //ライバル：……ッチ
      _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_05 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //会話２回目以降
  ELSE
    
    //プライヤー名代入
    _PLAYER_NAME( 0 )
    //ライバル名代入
    _RIVAL_NAME( 1 )

    //ライバル：でさ　オマエ
    _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_03 )

    //ライバルと戦う？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //ライバル：かつのは　オレたち　だぜ！▼
      _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_04 )
      _MSGWIN_CLOSE()

      //ライバル戦呼び出し　最初の３匹によって分岐
      IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
        //初期３匹で草タイプを選択
        _TRAINER_BTL_SET( TRID_SWRIVAL_19, 0 )
      ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
        //初期３匹で炎タイプを選択
        _TRAINER_BTL_SET( TRID_SWRIVAL_20, 0 )
      ELSE
        //初期３匹で水タイプを選択
        _TRAINER_BTL_SET( TRID_SWRIVAL_21, 0 )
      ENDIF

      //結果チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()
      ELSE
        _TRAINER_LOSE()
      ENDIF

      //プライヤー名代入
      _PLAYER_NAME( 0 )
      //ライバル名代入
      _RIVAL_NAME( 1 )

      //ライバル：……ったく▼
      _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_06 )
      _MSGWIN_CLOSE()

      //自機座標取得
      _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

      //アニメ：ライバル退場
      IF $LCW_POSZ == 300  THEN
        //主人公をよけて歩く
        _OBJ_ANIME_AUTO( T04_SWRIVAL_01, 752, 296, FORCE_TYPE_NPC, 8, DIR_LR )
      ELSE
        _OBJ_ANIME_AUTO( T04_SWRIVAL_01, 753, 296, FORCE_TYPE_NPC, 8, DIR_UD )
      ENDIF

      _TIME_WAIT( 24 )

      //アニメ：主人公見送り
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
      _OBJ_ANIME_WAIT()

      _SE_PLAY( SEQ_SE_KAIDAN )   //階段SE再生
      _OBJ_DEL( T04_SWRIVAL_01 )  //ライバル動作モデル削除
      _SE_WAIT()  //SE待ち

      //==================================//
      //ライバルに勝利した（イベント終了）
      _FLAG_SET ( FE_T04_SWRIVAL_WIN_01 )
      //ライバルを非表示
      _FLAG_SET ( FV_T04_SWRIVAL_01 )
      //ホドモエ・ポケモンハウスのライバルを表示
      _FLAG_RESET ( FV_C05R0501_SWRIVAL_01 )
      //ローカルライブキャスター・ライバル通話状態を変更（C05R0501戦闘前）
      _PERSON_STATE_SET_RIVAL( RIVAL_STATE_PLASMAHOME_1 )
      //==================================//
		
      _CALL ev_sage7
		
    ELSE
      
      //プライヤー名代入
      _PLAYER_NAME( 0 )
      //ライバル名代入
      _RIVAL_NAME( 1 )

      //ライバル：……ッチ
      _BALLOONWIN_TALKOBJ_MSG( msg_t04_swrival_end_05 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

EVENT_END

ev_sage7:

		//2011.09.23	海底遺跡イベント追加
		
		//========================================/
		_FLAG_RESET(FV_T04_SAGE7_01)
		//========================================/
		
		_OBJ_ADD( T04_SAGE7_01 )
		
		//七賢人移動
		_OBJ_POS_CHANGE( T04_SAGE7_01, 764, -5, 304, DIR_LEFT )

		//自機座標取得
		_PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

		//座標格納の変数を定義
		DEFINE_LOCAL	LWK_OBJ_POSX
		DEFINE_LOCAL	LWK_OBJ_POSZ

		//七賢人：プレイヤーに隣接する
		SWITCH $LCW_POSX
		CASE 752 THEN
			$LWK_OBJ_POSX = 753
			$LWK_OBJ_POSZ = 301
		CASE 753 THEN
			
			$LWK_OBJ_POSX = 753
			
			IF $LCW_POSZ == 302 THEN
				$LWK_OBJ_POSZ = 303
			ELSE
				$LWK_OBJ_POSZ = 301
			ENDIF
			
		CASE 754 THEN
			$LWK_OBJ_POSX = 753
			$LWK_OBJ_POSZ = 301
		ENDSWITCH
		
		_OBJ_ANIME_AUTO( T04_SAGE7_01, LWK_OBJ_POSX, LWK_OBJ_POSZ, FORCE_TYPE_NPC, 8, DIR_LR )
		_OBJ_ANIME_WAIT()

		_OBJ_ANIME( MMDL_ID_PLAYER, anm_common_gyoe )
		_OBJ_ANIME_WAIT()
		
		//座標に合わせてプレイヤー：七賢人のほうを向く
		SWITCH $LCW_POSX
		CASE 752 THEN
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
			_OBJ_ANIME( T04_SAGE7_01, anm_staystep_l )
		CASE 753 THEN
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
			_OBJ_ANIME( T04_SAGE7_01, anm_staystep_u )
		CASE 754 THEN
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
			_OBJ_ANIME( T04_SAGE7_01, anm_staystep_r )
		ENDSWITCH
		
		_OBJ_ANIME_WAIT()
		
		_BALLOONWIN_OBJMSG_POS( msg_t04_sage7_end_01 , T04_SAGE7_01, POS_DEFAULT )
		_MSGWIN_CLOSE()
		
		_PLAYER_NAME(0)
		
		_SYSWIN_MSG( msg_t04_sage7_end_02, POS_DOWN )
		_AB_KEYWAIT_MARK()
		_SYSWIN_CLOSE()
		
		_BALLOONWIN_OBJMSG_POS( msg_t04_sage7_end_03 , T04_SAGE7_01, POS_DEFAULT )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
		
		//========================================/
		$WK_OTHER_D20_ARRIVE = 1
		//========================================/


_RET


