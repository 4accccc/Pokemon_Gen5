//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_bg_t04_sign1_01
_EVENT_DATA		ev_bg_t04_sign1_02
_EVENT_DATA		ev_zone_t04
_EVENT_DATA		ev_pos_t04_swrival_01
_EVENT_DATA		ev_t04_man3_01
_EVENT_DATA		ev_t04_trainerm_01
_EVENT_DATA		ev_t04_maid_01
_EVENT_DATA		ev_t04_ambrella_01
_EVENT_DATA		ev_t04_babygirl1_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*					ZONE_CHANGE_SCRIPT						*/
/************************************************************/
INIT_EVENT_START	ev_zone_t04
	
	_FLAG_SET( FV_T04_SUMMER )
{
	//季節チェック
	DEFINE_LOCAL SCWK_SEASON
	_GET_SEASON_ID( SCWK_SEASON )
	
	//出現確率を割り振る変数定義
	DEFINE_LOCAL LWK_RANDNUM
	DEFINE_LOCAL LWK_RANDWORD
	
	//夏だったら住民を表示
	IF $SCWK_SEASON == PMSEASON_SUMMER THEN
		_FLAG_RESET( FV_T04_SUMMER )
	ENDIF
	
	//シロナの別荘イベント設定
	//【仮】出現条件をクリア後に変更
	
	//シロナとの初回戦闘が終わっていない
	IF $WK_SCENE_T04R0401 == 0 || $WK_SCENE_T04R0401 == 1 THEN
		
		//初期状態で全員非表示
		_FLAG_SET( FV_T04R0401_BIGFOUR4_01 )
		_FLAG_SET( FV_T04R0401_BIGFOUR1_01 )
		_FLAG_SET( FV_T04R0401_LEADER8W_01 )
		_FLAG_SET( FV_T04R0401_LEADER6_01 )
		_FLAG_SET( FV_T04R0401_LEADER4_01 )
		_FLAG_SET( FV_T04R0401_LEADER2_01 )
		
		//シロナを表示
		_FLAG_RESET( FV_T04R0401_SHIRONA_01 )
		
	//シロナとの初回戦闘終了済み
	ELSIF $WK_SCENE_T04R0401 == 2 THEN
	
		//春で今日の設定をまだ行っていない
		IF $SCWK_SEASON == PMSEASON_SPRING && FLAG_OFF( TMFLG_T04R0401_TALKSET ) THEN
			
			//初期状態で全員非表示
			_FLAG_SET( FV_T04R0401_SHIRONA_01 )
			_FLAG_SET( FV_T04R0401_BIGFOUR4_01 )
			_FLAG_SET( FV_T04R0401_BIGFOUR1_01 )
			_FLAG_SET( FV_T04R0401_LEADER8W_01 )
			_FLAG_SET( FV_T04R0401_LEADER6_01 )
			_FLAG_SET( FV_T04R0401_LEADER4_01 )
			_FLAG_SET( FV_T04R0401_LEADER2_01 )
			
			//***シロナを表示
			_FLAG_RESET( FV_T04R0401_SHIRONA_01 )
			//***シロナの本日のセリフを設定
			_GET_RND( LWK_RANDWORD,2 )
			$WK_OTHER_T04R0401_SHIRONA = $LWK_RANDWORD
			
			//***カトレアを75%の確率で表示する
			_GET_RND( LWK_RANDNUM,4 )
			IF $LWK_RANDNUM <= 2 THEN
				_FLAG_RESET( FV_T04R0401_BIGFOUR4_01 )
				
				//カトレアの本日のセリフを設定
				_GET_RND( LWK_RANDWORD,5 )
				$WK_OTHER_T04R0401_BIGFOUR4 = $LWK_RANDWORD
				
			//3ははずれで非表示
			ELSE
				_FLAG_SET( FV_T04R0401_BIGFOUR4_01 )
			ENDIF
			
			//***シキミを50%の確率で表示する
			_GET_RND( LWK_RANDNUM,2 )
			IF $LWK_RANDNUM == 1 THEN
				_FLAG_RESET( FV_T04R0401_BIGFOUR1_01 )
				
				//シキミの本日のセリフを設定
				_GET_RND( LWK_RANDWORD,5 )
				$WK_OTHER_T04R0401_BIGFOUR1 = $LWK_RANDWORD
				
			//0ははずれで非表示
			ELSE
				_FLAG_SET( FV_T04R0401_BIGFOUR1_01 )
			ENDIF
			
			//==================================//
					
			//本日の設定は終了
			_FLAG_SET ( TMFLG_T04R0401_TALKSET )
			
			//==================================//
		
		//夏で今日の設定をまだ行っていない
		ELSIF  $SCWK_SEASON == PMSEASON_SUMMER && FLAG_OFF( TMFLG_T04R0401_TALKSET ) THEN
			
			//初期状態で全員非表示
			_FLAG_SET( FV_T04R0401_SHIRONA_01 )
			_FLAG_SET( FV_T04R0401_BIGFOUR4_01 )
			_FLAG_SET( FV_T04R0401_BIGFOUR1_01 )
			_FLAG_SET( FV_T04R0401_LEADER8W_01 )
			_FLAG_SET( FV_T04R0401_LEADER6_01 )
			_FLAG_SET( FV_T04R0401_LEADER4_01 )
			_FLAG_SET( FV_T04R0401_LEADER2_01 )
			
			//***シロナの本日のセリフを設定
			_GET_RND( LWK_RANDWORD,5 )
			$WK_OTHER_T04R0401_SHIRONA = $LWK_RANDWORD
			_FLAG_RESET( FV_T04R0401_SHIRONA_01 )
			
			//***アイリスを75%の確率で表示する
			_GET_RND( LWK_RANDNUM,4 )
			_DEBUG_PRINT_WK( LWK_RANDNUM )
			IF $LWK_RANDNUM <= 2 THEN
				_FLAG_RESET( FV_T04R0401_LEADER8W_01 )
				
				//アイリスの本日のセリフを設定
				_GET_RND( LWK_RANDWORD,5 )
				$WK_OTHER_T04R0401_LEADER8W = $LWK_RANDWORD
				
			//3ははずれで非表示
			ELSE
				_FLAG_SET( FV_T04R0401_LEADER8W_01 )
			ENDIF
			
			//***フウロを75%の確率で表示する
			_GET_RND( LWK_RANDNUM,4 )
			_DEBUG_PRINT_WK( LWK_RANDNUM )
			IF $LWK_RANDNUM <= 2 THEN
				_FLAG_RESET( FV_T04R0401_LEADER6_01 )
				
				//フウロの本日のセリフを設定
				_GET_RND( LWK_RANDWORD,5 )
				$WK_OTHER_T04R0401_LEADER6 = $LWK_RANDWORD
				
			//3ははずれで非表示
			ELSE
				_FLAG_SET( FV_T04R0401_LEADER6_01 )
			ENDIF
			
			//***カミツレを50%の確率で表示する
			_GET_RND( LWK_RANDNUM,2 )
			_DEBUG_PRINT_WK( LWK_RANDNUM )
			IF $LWK_RANDNUM == 1 THEN
				_FLAG_RESET( FV_T04R0401_LEADER4_01 )
				
				//カミツレの本日のセリフを設定
				_GET_RND( LWK_RANDWORD,5 )
				$WK_OTHER_T04R0401_LEADER4 = $LWK_RANDWORD
				
			//0ははずれで非表示
			ELSE
				_FLAG_SET( FV_T04R0401_LEADER4_01 )
			ENDIF
			
			//***アロエを25%の確率で表示する
			_GET_RND( LWK_RANDNUM,4 )
			_DEBUG_PRINT_WK( LWK_RANDNUM )
			IF $LWK_RANDNUM == 3 THEN
				_FLAG_RESET( FV_T04R0401_LEADER2_01 )
				
				//アロエの本日のセリフを設定
				_GET_RND( LWK_RANDWORD,5 )
				$WK_OTHER_T04R0401_LEADER2 = $LWK_RANDWORD
				
			//0ははずれで非表示
			ELSE
				_FLAG_SET( FV_T04R0401_LEADER2_01 )
			ENDIF
			
			//==================================//
					
			//本日の設定は終了
			_FLAG_SET ( TMFLG_T04R0401_TALKSET )
			
			//==================================//

		//秋・冬（全員非表示）
		ELSIF  $SCWK_SEASON == PMSEASON_AUTUMN || $SCWK_SEASON == PMSEASON_WINTER THEN
			_FLAG_SET( FV_T04R0401_SHIRONA_01 )
			_FLAG_SET( FV_T04R0401_BIGFOUR4_01 )
			_FLAG_SET( FV_T04R0401_BIGFOUR1_01 )
			_FLAG_SET( FV_T04R0401_LEADER8W_01 )
			_FLAG_SET( FV_T04R0401_LEADER6_01 )
			_FLAG_SET( FV_T04R0401_LEADER4_01 )
			_FLAG_SET( FV_T04R0401_LEADER2_01 )

		ENDIF
	
	ENDIF

}
INIT_EVENT_END

/**************************************************************/
/*			POS：ライバル戦									  */
/**************************************************************/
EVENT_START		ev_pos_t04_swrival_01

  //プライヤー名代入
  _PLAYER_NAME( 0 )
  //ライバル名代入
  _RIVAL_NAME( 1 )

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
   //フィールド上にライバル配置
  _OBJ_ADD_EX( LCW_POSX, 307, DIR_DOWN, MMDL_ID_EVENTOBJ_00, SWRIVAL, MV_DMY )
  
  //【仮】ライバル曲再生（曲が仮）
  _START_EVENT_BGM( SEQ_BGM_E_RIVAL )
  
  //ライバル：待てよ！
  _PLAINWIN_MSG_DOWN( msg_t04_swrival_01 )
  
  //アニメ：主人公振り向く
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  _PLAINWIN_CLOSE()
    
  $LCW_POSZ += 2
  //アニメ：ライバル接近
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ライバル：どれだけ
  _BALLOONWIN_OBJMSG_POS( msg_t04_swrival_02,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //【仮】（ラベルが仮）ライバル戦呼び出し　最初の３匹によって分岐
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_04, 0 )
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_05, 0 )
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_06, 0 )
  ENDIF
  
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
  
  //ライバル：なるほど
  _BALLOONWIN_OBJMSG_POS( msg_t04_swrival_03,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル別方向を向く
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ライバル：まっ　プラズマ団のあいては
  _BALLOONWIN_OBJMSG_POS( msg_t04_swrival_04,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル向きなおす
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ライバル：というわけで
  _BALLOONWIN_OBJMSG_POS( msg_t04_swrival_05,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  IF $LCW_POSX > 752  THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_swrival_bye_753 )
  //一番左の座標のケース
  ELSE
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_swrival_bye_751 )
  ENDIF
  
  _TIME_WAIT( 12 )
  
  //アニメ：主人公見送り
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //ライバル動作モデル削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  //SE待ち
  _SE_WAIT()
  
  //ライバル曲停止
	_END_EVENT_BGM()
  
  //========================================//
  //T04POS無効
  $WK_SCENE_T04 = 1
  //========================================//

EVENT_END

//--------------------------------------------------------------------
//	ライバル：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swrival_bye_751
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_U_8F,4
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	ライバル：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swrival_bye_753
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_U_8F,4
	_ANIME_DATA	ACMD_END,0
  


