  ENDIF

EVENT_END

/************************************************************/
/*					バリア解除スイッチ（４）				*/
/************************************************************/
EVENT_START	ev_pos_d27r0201_switch_04

  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_04 = 1
  //=====================================

  //SE再生
  _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_04  )
  //メッセージ：スイッチを踏んだ！
