  _ANIME_DATA	AC_WALK_L_4F,1
  _ANIME_DATA	AC_WALK_D_4F,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	ライバル：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_rival_bye_01
  _ANIME_DATA	AC_WALK_D_4F,3
  _ANIME_DATA	ACMD_END,0


/************************************************************/
/*					バリア解除スイッチ（１）				*/
/************************************************************/
EVENT_START	ev_pos_d27r0201_switch_01
  
  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_01 = 1
  //=====================================
  
  //SE再生
  _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_04  )
  //メッセージ：スイッチを踏んだ！
  _PLAINWIN_MSG_DOWN( msg_d27r0201_switch_01 )
  
  IF $WK_SCENE_D27_SWITCH_01 == 1 && $WK_SCENE_D27_SWITCH_02 == 1 && $WK_SCENE_D27_SWITCH_03 == 1 && $WK_SCENE_D27_SWITCH_04 == 1 THEN
    _AB_KEYWAIT_MARK()
  ELSE
    _LAST_KEYWAIT()
  ENDIF
  
  _MSGWIN_CLOSE()
  _SE_WAIT()
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BOW_BUTTON_OFF( 0 )
  //ゲート解除演出
  _HIDE_SHIP_BOW_GATE_OFF( 0 )

  //メッセージ：バリアが解除された！
  IF $WK_SCENE_D27_SWITCH_01 == 1 && $WK_SCENE_D27_SWITCH_02 == 1 && $WK_SCENE_D27_SWITCH_03 == 1 && $WK_SCENE_D27_SWITCH_04 == 1 THEN
    _PLAINWIN_MSG_DOWN( msg_d27r0201_switch_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF

EVENT_END

/************************************************************/
/*					バリア解除スイッチ（２）				*/
/************************************************************/
EVENT_START	ev_pos_d27r0201_switch_02

  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_02 = 1
  //=====================================

  //SE再生
  _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_04  )
  //メッセージ：スイッチを踏んだ！
  _PLAINWIN_MSG_DOWN( msg_d27r0201_switch_01 )
  
  IF $WK_SCENE_D27_SWITCH_01 == 1 && $WK_SCENE_D27_SWITCH_02 == 1 && $WK_SCENE_D27_SWITCH_03 == 1 && $WK_SCENE_D27_SWITCH_04 == 1 THEN
    _AB_KEYWAIT_MARK()
  ELSE
    _LAST_KEYWAIT()
  ENDIF
  
  _MSGWIN_CLOSE()
  _SE_WAIT()
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BOW_BUTTON_OFF( 1 )
  //ゲート解除演出
  _HIDE_SHIP_BOW_GATE_OFF( 1 )

  //メッセージ：バリアが解除された！
  IF $WK_SCENE_D27_SWITCH_01 == 1 && $WK_SCENE_D27_SWITCH_02 == 1 && $WK_SCENE_D27_SWITCH_03 == 1 && $WK_SCENE_D27_SWITCH_04 == 1 THEN
    _PLAINWIN_MSG_DOWN( msg_d27r0201_switch_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF

EVENT_END

