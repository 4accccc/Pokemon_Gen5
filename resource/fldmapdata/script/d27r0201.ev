//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_pos_d27r0201_barrier_01
_EVENT_DATA    ev_zone_d27r0201
_EVENT_DATA    ev_init_d27r0201
_EVENT_DATA    ev_pos_d27r0201_switch_01
_EVENT_DATA    ev_pos_d27r0201_switch_02
_EVENT_DATA    ev_pos_d27r0201_switch_03
_EVENT_DATA    ev_pos_d27r0201_switch_04
_EVENT_DATA    ev_recover_d27r0201
_EVENT_DATA    ev_reserve_d27r0201_rival_01

_EVENT_DATA_END

/************************************************************/
/*					ZONE_CHANGE_LABEL 						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r0201
  
  _CALL ev_exit_change
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r0201

  _CALL sub_gate_set

INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r0201

  _CALL sub_gate_set
  _CALL ev_exit_change

INIT_EVENT_END

/************************************************************/
/*		CALL：特殊接続                             */
/************************************************************/
ev_exit_change:

  //D10プラズマフリゲート起動中
  IF FLAG_ON( FE_D10_PLAZMA_FRIGATE_01 ) THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0201_D27R0101_EXIT01, 0, 0, 0 )
  //プラズマフリゲートいない
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0201_D27R1101_EXIT01, 0, 0, 0 )
  ENDIF

_RET

// ゲート(バリアー)の状態をフラグを見て設定
sub_gate_set:
{
  //スイッチ（１）の見栄えを分岐
  IF $WK_SCENE_D27_SWITCH_01 == 0 THEN
    _HIDE_SHIP_BOW_BUTTON_SET( 0, 0 )
  ELSE
    _HIDE_SHIP_BOW_BUTTON_SET( 0, 1 )
  ENDIF
  
  //スイッチ（２）の見栄えを分岐
  IF $WK_SCENE_D27_SWITCH_02 == 0 THEN
    _HIDE_SHIP_BOW_BUTTON_SET( 1, 0 )
  ELSE
    _HIDE_SHIP_BOW_BUTTON_SET( 1, 1 )
  ENDIF
  
  //スイッチ（３）の見栄えを分岐
  IF $WK_SCENE_D27_SWITCH_03 == 0 THEN
    _HIDE_SHIP_BOW_BUTTON_SET( 2, 0 )
  ELSE
    _HIDE_SHIP_BOW_BUTTON_SET( 2, 1 )
  ENDIF
  
  //スイッチ（４）の見栄えを分岐
  IF $WK_SCENE_D27_SWITCH_04 == 0 THEN
    _HIDE_SHIP_BOW_BUTTON_SET( 3, 0 )
  ELSE
    _HIDE_SHIP_BOW_BUTTON_SET( 3, 1 )
  ENDIF
}
_RET

/************************************************************/
/*					RESERVE：ライバル解説イベント				*/
/************************************************************/
EVENT_START	ev_reserve_d27r0201_rival_01
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //アニメ：主人公中央へ
  _OBJ_ANIME( D27R0201_SWRIVAL_01 , anm_rival_to_swplazma )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 11, 12, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //プラズマ団：なんだ？おまえら
  _BALLOONWIN_OBJMSG_POS( msg_d27r0201_swplazmam1_02_01 , D27R0201_SWPLAZMAM_01 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバルその場歩き
  _OBJ_ANIME( D27R0201_SWRIVAL_01 , anm_rival_hate )
  _OBJ_ANIME_WAIT()
  
  //ライバル：いいから オマエらの
  _BALLOONWIN_OBJMSG_POS( msg_d27r0201_swrival_02_03 , D27R0201_SWRIVAL_01 ,POS_DR )
  _MSGWIN_CLOSE()
  
  //マルチバトル
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_28, TRID_SWPLAZMAM_38, TRID_SWPLAZMAW_14 ) 
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_29, TRID_SWPLAZMAM_38, TRID_SWPLAZMAW_14  ) 
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_30, TRID_SWPLAZMAM_38, TRID_SWPLAZMAW_14 ) 
  ENDIF
  
  _CALL ev_battle_check
  
  //プラズマ団：やばい！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0201_swplazmam1_02_02 , D27R0201_SWPLAZMAM_01 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //プラズマ団：仲間に知らせなきゃ！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0201_swplazmaw1_02_01 , D27R0201_SWPLAZMAW_01 ,POS_UL )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団員向き合う
  _OBJ_ANIME( D27R0201_SWPLAZMAM_01 , anm_staystep_l )
  _OBJ_ANIME( D27R0201_SWPLAZMAW_01 , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //アニメ：プラズマ団員退場
  _OBJ_ANIME( D27R0201_SWPLAZMAM_01 ,anm_swplazma_bye_02 )
  _OBJ_ANIME( D27R0201_SWPLAZMAW_01 ,anm_swplazma_bye_01 )
  _TIME_WAIT( 6 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME( D27R0201_SWRIVAL_01 , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //動作モデル削除
  _OBJ_DEL( D27R0201_SWPLAZMAM_01 )
  _OBJ_DEL( D27R0201_SWPLAZMAW_01 )
  
  _SE_WAIT()
  
  //ライバル：チッ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0201_swrival_02_04 , D27R0201_SWRIVAL_01 ,POS_DR )
  _MSGWIN_CLOSE()
  
  //アニメ：二人とも上を見る
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  _OBJ_ANIME( D27R0201_SWRIVAL_01 , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ライバル：……バリアだ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0201_swrival_02_01 , D27R0201_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公とライバル向き合う
  _OBJ_ANIME( D27R0201_SWRIVAL_01 , anm_staystep_l)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r)
  _OBJ_ANIME_WAIT()
  
  //ライバル：ということはだ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0201_swrival_02_02 , D27R0201_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( D27R0201_SWRIVAL_01 , anm_rival_bye_01)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  //動作モデル削除
  _OBJ_DEL( D27R0201_SWRIVAL_01 )
  
  _SE_WAIT()
  
  //========================================//
  //ライバルを非表示
  _FLAG_SET( FV_D27R0201_SWRIVAL_01 )
  //D27R0701のSCENE_CHANGEを起動
  $WK_SCENE_D27R0701_PLAZMAM_01 = 1
  //D27R0501のSCENE_CHANGEを起動
  $WK_SCENE_D27R0501_SWSAGE7_01 = 1
  //========================================//
  //D27R0101のPOSを無効に
  $WK_SCENE_D27R0101_SECONDB_01 = 3
  //D27R0101のライバルを非表示
  _FLAG_SET( FV_D27R0101_SWRIVAL_01 )
  //========================================//

EVENT_END

