_EVENT_DATA    ev_c12r0201_fighterm_01
_EVENT_DATA    ev_c12r0201_woman3_01
_EVENT_DATA_END


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
//ev_zone_c12r0201:
//  _END

/**************************************************************/
/*  ライバルの父：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_c12r0201_fighterm_01

  //ゲームクリア後か
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //ライバル父：おさないころに　うしなった　ものを
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0201_fighterm_02 )

  ELSE
    //ライバル父：むすこはね
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0201_fighterm_01 )

  ENDIF

EVENT_END

/**************************************************************/
/*  ライバルの母：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_c12r0201_woman3_01

  //主人公名代入
  _PLAYER_NAME( 0 )
  //ライバル名代入
  _RIVAL_NAME( 1 )

  _TALK_OBJ_START()
  //ライバル母：主人公くん▼（主人公が女の子の場合は台詞が変わる）
  _BALLOONWIN_OBJMSG_MF( msg_c12r0201_woman3_01, msg_c12r0201_woman3_02, C12R0201_WOMAN3_01, POS_DOWN )

EVENT_END


