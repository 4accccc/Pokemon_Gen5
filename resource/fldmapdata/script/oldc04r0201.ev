  .text

  .include  "scr_seq_def.h"
  .include  "msg_oldc04r0201.h"
  .include  "oldc04r0201.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA	ev_reserve_oldc04r0201_event_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_oldc04r0201:
//  _END

/**************************************************************/
/*			過去イベント	ミュージカルオーナー		  */
/**************************************************************/
EVENT_START		ev_reserve_oldc04r0201_event_01

	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//カメラ操作　ちょっと上のほうを初期位置にする
	_CAMERA_MOVE( 9688,0,970752,950272,380928,1015808,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_on )
	_OBJ_ANIME_WAIT()

	_MAP_FADE_BLACK_IN()

	//カメラ操作　デフォ位置に移動
	_CAMERA_RECV_MOVE(60)	//カメラ復帰移動
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_MAP_FADE_END_CHECK()
	
	//旧主人公名を代入
	_DATACONV_SET_NAME(DATACONV_ID_SYSTEM,0)
	
	//……それにしても
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_01 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//一歩歩く
	_OBJ_ANIME( OLDC04R0201_OLD_GENTLEMAN_01, anm_walk_d )
	_OBJ_ANIME_WAIT()
	
	//グッズケースを　あけると
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_02 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//踊る１
	_OBJ_ANIME( OLDC04R0201_OLD_GENTLEMAN_01, anm_dance_01 )
	_OBJ_ANIME_WAIT()
	
	//あたまに　にあう
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_03 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()

	//踊る２
	_OBJ_ANIME( OLDC04R0201_OLD_GENTLEMAN_01, anm_dance_02 )
	_OBJ_ANIME_WAIT()
	
	//キュートな　ブルーのかみどめを
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_04 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()

	//踊る３
	_OBJ_ANIME( OLDC04R0201_OLD_GENTLEMAN_01, anm_dance_03 )
	_OBJ_ANIME_WAIT()
	
	//しかくいメガネは　エレガント
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_05 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()

	//踊る４
	_OBJ_ANIME( OLDC04R0201_OLD_GENTLEMAN_01, anm_dance_04 )
	_OBJ_ANIME_WAIT()
	
	//マラカス　マラカス
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_06 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()

	//踊る５
	_OBJ_ANIME( OLDC04R0201_OLD_GENTLEMAN_01, anm_dance_05 )
	_OBJ_ANIME_WAIT()
	
	//こしに　まいた
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_07 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()

	//踊る６
	_OBJ_ANIME( OLDC04R0201_OLD_GENTLEMAN_01, anm_dance_06 )
	_OBJ_ANIME_WAIT()
	
	//グッズの　よこじまネクタイ
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_08 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )
	
	//きめました！
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_09 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )

	//もどって　こなければ
	_BALLOONWIN_OBJMSG_POS( msg_oldc04r0201_old_champion_10 ,OLDC04R0201_OLD_GENTLEMAN_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()

	//踊る７
	_OBJ_ANIME( OLDC04R0201_OLD_GENTLEMAN_01, anm_dance_07 )

	_CAMERA_MOVE( 9688,0,970752,950272,380928,1015808,30 )

	//画面暗転処理
	//_MAP_FADE_BLACK_OUT()
	//_MAP_FADE_END_CHECK()
	
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	_OBJ_ANIME_WAIT()
	
	//予約スクリプト
	//_RESERVE_SCRIPT( SCRID_RESERVE_C01GYM0101_LINK_EVENT_RET )

	_CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
	_CAMERA_END()		//カメラ操作終了

	//_MAP_FADE_BLACK_IN()
	//_MAP_FADE_END_CHECK()

	//マップチェンジ
	_MAP_CHANGE( ZONE_ID_C04R0201, 14, 15 , DIR_UP )

EVENT_END

