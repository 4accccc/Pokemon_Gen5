  .text

  .include  "scr_seq_def.h"
  .include  "msg_oldt06r0101.h"
  .include  "oldt06r0101.h"
  
  .include  "c07gym0101.h" //C07GYM0101への遷移参照用
  .include  "c07gym0101_def.h" //C07GYM0101への遷移参照用

//@author Suginaka Katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_reserve_oldt06r0101_event_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_oldt06r0101:
//  _END

/**************************************************************/
/*			過去イベント	アデク・ハチク・レンブ			  */
/**************************************************************/
EVENT_START		ev_reserve_oldt06r0101_event_01

	//暗転復帰
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//カメラ操作　ちょっと上のほうを初期位置にする
	_CAMERA_MOVE( 9694,0,970514,425984,380935,229376,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_on )
	_OBJ_ANIME_WAIT()

	_MAP_FADE_BLACK_IN()

	//カメラ操作　デフォ位置に移動
	_CAMERA_RECV_MOVE( 60 ) //一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_MAP_FADE_END_CHECK()

	//サブウィン
	_SUBWIN_MSG( msg_oldc01r0501_old_champion_01 , 8 , 5 , 1 )
	_TIME_WAIT( 25 )
	_SUBWIN_MSG( msg_oldc01r0501_old_leader7_01 , 19 , 14 , 2 )
	_TIME_WAIT( 25 )
	_SUBWIN_CLOSE( 1 )
	_TIME_WAIT( 10 )
	_SUBWIN_CLOSE( 2 )
	_TIME_WAIT( 40 )
	_SUBWIN_MSG( msg_oldc01r0501_old_champion_02 , 8 , 5 , 3 )
	_TIME_WAIT( 25 )
	_SUBWIN_MSG( msg_oldc01r0501_old_leader7_02 , 19 , 14 , 4 )
	_TIME_WAIT( 25 )
	_SUBWIN_CLOSE( 3 )
	_TIME_WAIT( 10 )
	_SUBWIN_CLOSE( 4 )
	_TIME_WAIT( 40 )
	_SUBWIN_MSG( msg_oldc01r0501_old_champion_03 , 8 , 5 , 5 )
	_TIME_WAIT( 40 )
	_SUBWIN_CLOSE( 5 )
	_TIME_WAIT( 50 )

	//ししょうッ！！
	_GIZAPLAINWIN_MSG_POS( msg_oldc01r0501_old_bigfour3_01, POS_DEFAULT )
	_GIZAPLAINWIN_CLOSE()

	//アデク　下を向く・数フレーム後にハチクも下を向く
	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_dir_d )
	_TIME_WAIT( 10 )
	_OBJ_ANIME( OLDT06R0101_OLD_LEADER7_01, anm_dir_d )
	_OBJ_ANIME_WAIT()
	
	//レンブ　走ってくる　数フレーム後！マークの後　ハチクの隣へ　アデクは右を向く
	_OBJ_ANIME( OLDT06R0101_OLD_BIGFOUR3_01, anm_bigfour3_move_01 )
	
	//アデク：げんき　だな
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_champion_04 , OLDT06R0101_OLD_CHAMPION_01, POS_DEFAULT )

	_OBJ_ANIME_WAIT()	
	_MSGWIN_CLOSE()
	
	_TIME_WAIT( 20 )

	_OBJ_ANIME( OLDT06R0101_OLD_BIGFOUR3_01, anm_bigfour3_move_02 )
	_TIME_WAIT( 20 )
	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_dir_r )
	_OBJ_ANIME_WAIT()

	//レンブ：おお　きいたぞ！
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_bigfour3_02 , OLDT06R0101_OLD_BIGFOUR3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ハチク：うむ！
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader7_03 , OLDT06R0101_OLD_LEADER7_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//レンブ・ハチク　アデクのほうを向く
	_OBJ_ANIME( OLDT06R0101_OLD_BIGFOUR3_01, anm_dir_l )
	_TIME_WAIT( 10 )
	_OBJ_ANIME( OLDT06R0101_OLD_LEADER7_01, anm_dir_l )
	_OBJ_ANIME_WAIT()
	
	//アデク：じぶんで　こたえを　みつけよ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_champion_05 , OLDT06R0101_OLD_CHAMPION_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ハチク　中央へ移動　後を向いたまま
	_OBJ_ANIME( OLDT06R0101_OLD_LEADER7_01, anm_leader7_move_01 )
	_OBJ_ANIME_WAIT()

	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_dir_u )
	_OBJ_ANIME( OLDT06R0101_OLD_BIGFOUR3_01, anm_dir_u )
	_OBJ_ANIME_WAIT()

	//ハチク　でだ　わたしが
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader7_04 , OLDT06R0101_OLD_LEADER7_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//レンブ　１歩前へ
	_OBJ_ANIME( OLDT06R0101_OLD_BIGFOUR3_01, anm_walk_u )
	_OBJ_ANIME_WAIT()
	
	//レンブ：おお！　なるほどな
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_bigfour3_03 , OLDT06R0101_OLD_BIGFOUR3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//レンブ　アデクのほうへ向く
	_OBJ_ANIME( OLDT06R0101_OLD_BIGFOUR3_01, anm_dir_l )
	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_dir_r )
	_OBJ_ANIME_WAIT()
	
	//アデク：レンブよ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_champion_06 , OLDT06R0101_OLD_CHAMPION_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ハチク　前を向く
	_OBJ_ANIME( OLDT06R0101_OLD_LEADER7_01, anm_stay_d )
	_OBJ_ANIME_WAIT()
	
	//ハチク：だいじょうぶ　です
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader7_05 , OLDT06R0101_OLD_LEADER7_01, POS_DEFAULT )
	
	//ハチク　後を向く
	_OBJ_ANIME( OLDT06R0101_OLD_LEADER7_01, anm_stay_u )
	_OBJ_ANIME_WAIT()
	
	//ハチク：わかかったのだ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader7_06 , OLDT06R0101_OLD_LEADER7_01, POS_DEFAULT )

	//ハチク　前を向く
	_OBJ_ANIME( OLDT06R0101_OLD_LEADER7_01, anm_stay_d )
	_OBJ_ANIME_WAIT()
	
	//ハチク：そう　えんじることで
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader7_07 , OLDT06R0101_OLD_LEADER7_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//レンブ：わかるきが　する
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_bigfour3_04 , OLDT06R0101_OLD_BIGFOUR3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アデク　ゆっくり１歩左へ移動　向き直る
	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_champion_move_01 )
	_OBJ_ANIME_WAIT()

	//ハチク　アデクのほうを向く	
	_OBJ_ANIME( OLDT06R0101_OLD_LEADER7_01, anm_dir_l )
	_OBJ_ANIME_WAIT()
	
	//アデク：それでだ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_champion_07 , OLDT06R0101_OLD_CHAMPION_01, POS_DEFAULT )
	
	//アデク　反対を向く
	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_stay_l )
	_OBJ_ANIME_WAIT()
	
	//アデク：われわれこそ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_champion_08 , OLDT06R0101_OLD_CHAMPION_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//レンブ：まあ　そりゃ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_bigfour3_05 , OLDT06R0101_OLD_BIGFOUR3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アデク　向き直る
	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_stay_r )
	_OBJ_ANIME_WAIT()
	
	//アデク：でしいり　してきたときと
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_champion_09 , OLDT06R0101_OLD_CHAMPION_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//レンブ：じぶんが　つよければ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_bigfour3_06 , OLDT06R0101_OLD_BIGFOUR3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//レンブ　一歩移動
	_OBJ_ANIME( OLDT06R0101_OLD_BIGFOUR3_01, anm_bigfour3_move_03 )
	_OBJ_ANIME_WAIT()
	
	//ハチク：では　じぶんが
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader7_08 , OLDT06R0101_OLD_LEADER7_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ハチク　ステージをおりて上を向く　アデク下を向く
	_OBJ_ANIME( OLDT06R0101_OLD_LEADER7_01, anm_leader7_move_02 )
	_TIME_WAIT( 15 )
	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_dir_d )
	_OBJ_ANIME_WAIT()
	
	//アデク：たすかる
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_champion_10 , OLDT06R0101_OLD_CHAMPION_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アデク・レンブ　向き合う
	_OBJ_ANIME( OLDT06R0101_OLD_BIGFOUR3_01, anm_stay_l )
	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_stay_r )
	_OBJ_ANIME_WAIT()
	
	//アデク：つよさ　とは！
	_GIZAWIN_OBJMSG_POS( msg_oldc01r0501_old_champion_11 , OLDT06R0101_OLD_CHAMPION_01, POS_DEFAULT )
	_GIZAWIN_CLOSE()

	_TIME_WAIT( 20 )
	
	//レンブ：ポケモン　とは！
	_GIZAWIN_OBJMSG_POS( msg_oldc01r0501_old_bigfour3_07 , OLDT06R0101_OLD_BIGFOUR3_01, POS_DEFAULT )
	_GIZAWIN_CLOSE()
	
	//アデク・レンブ　１歩前へ
	_OBJ_ANIME( OLDT06R0101_OLD_BIGFOUR3_01, anm_walk_4l )
	_OBJ_ANIME( OLDT06R0101_OLD_CHAMPION_01, anm_walk_4r )
	_OBJ_ANIME_WAIT()
	
	//暗転
	_CAMERA_MOVE( 9694,0,970514,425984,380935,229376,30 )
	
	
	//画面暗転処理
	_MAP_FADE_BLACK_OUT_SLOW()
	_MAP_FADE_END_CHECK()
	
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	
	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_C07GYM0101_LINK_RET )

	_CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
	_CAMERA_END()		//カメラ操作終了

	//マップチェンジ
	_MAP_CHANGE_NO_FADE( ZONE_ID_C07GYM0101, 17, 0, 15, DIR_UP )
	

EVENT_END

