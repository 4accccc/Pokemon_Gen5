  //@author fujimura_souichirou（ヤマジタウンへ行くまで、エースメダル見せイベント、カーゴサービス）
  //@author suginaka_katsunori //スクリプト調整・NPC配置・タイプ見せイベント作成
  //@author Mizuguchi_Mai（マップチェンジ）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_c06r0201_waitress_01
_EVENT_DATA   ev_c06r0201_veteranw_01
_EVENT_DATA   ev_c06r0201_swleader6_01
_EVENT_DATA   ev_c06r0201_hakase2_01
_EVENT_DATA   ev_c06r0201_pilot_01
_EVENT_DATA   ev_c06r0201_informationw_01
_EVENT_DATA	ev_c06r0201_workman1_01
_EVENT_DATA	ev_c06r0201_workman2_01
_EVENT_DATA	ev_c06r0201_poke19_01
_EVENT_DATA	ev_c06r0201_workman3_01
_EVENT_DATA    ev_reserve_c06r0201_end
_EVENT_DATA_END

//アイテムチェック用変数
DEFINE_LOCAL  LWK_ITEM_CHK
//行き先選択用変数
DEFINE_LOCAL  LWK_NUM_SELECT

DEFINE_LOCAL	LWK_PARTY_NUM		//手持ちポケモンの数
DEFINE_LOCAL	LWK_COUNT_NUM		//WHILE文のカウンタ
DEFINE_LOCAL	LWK_TYPE1			//１番目のタイプ格納
DEFINE_LOCAL	LWK_TYPE2			//２番目のタイプ格納
DEFINE_LOCAL	LWK_RET_MONSNO		//ポケモン種族名を格納
DEFINE_LOCAL	LWK_EV_CHK		//指定タイプがいるか・いないか

/************************************************************/
/*		飛行機降りた後のリザーブ						*/
/************************************************************/
EVENT_START	ev_reserve_c06r0201_end

	//暗転復帰
	_MAP_FADE_BLACK_IN()
	_MAP_FADE_END_CHECK()
	
	//地名表示
	_PLACE_NAME_DISPLAY()
	
EVENT_END

/**************************************************************/
/*  ウェイトレスのハートスイーツとハートのウロコ交換イベント
/**************************************************************/
EVENT_START		ev_c06r0201_waitress_01
	
	DEFINE_LOCAL LWK_DAY
	DEFINE_LOCAL LWK_MONTH
	DEFINE_LOCAL LWK_ITEM_NUM
	DEFINE_LOCAL LWK_BAG_CHK
	DEFINE_LOCAL LWK_ITEM_SUB_CHK
	DEFINE_LOCAL LWK_SWEETS
	
	_GET_DATE(LWK_MONTH,LWK_DAY)
	_GET_ITEM_NUM( ITEM_HAATOSUIITU, LWK_ITEM_NUM )
	_ADD_ITEM_CHK(ITEM_HAATONOUROKO,1,LWK_BAG_CHK)
	_ITEM_NAME( 0, ITEM_HAATONOUROKO )
	
	_TALK_OBJ_START()
	_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_01,C06R0201_WAITRESS_01)

	//特別な日なら５個交換
	IF $LWK_MONTH == 2 || $LWK_MONTH == 3 THEN
	
		IF $LWK_DAY == 14 THEN
			$LWK_SWEETS = 5
		ELSE
			$LWK_SWEETS = 10
		ENDIF
	
	ELSE
		$LWK_SWEETS = 10
	ENDIF

	_DEBUG_PRINT_WK(LWK_SWEETS)
	_DEBUG_PRINT_WK(LWK_ITEM_NUM)
	
	IF $LWK_ITEM_NUM > $LWK_SWEETS THEN
	
		IF $LWK_MONTH == 2 || $LWK_MONTH == 3 THEN
		
			IF $LWK_DAY == 14 THEN
				_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_03,C06R0201_WAITRESS_01)
				_CALL	ev_spday_item_get
			ELSE
				_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_02,C06R0201_WAITRESS_01)
				_CALL	ev_item_get
			ENDIF
		
		ELSE
			_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_02,C06R0201_WAITRESS_01)
			_CALL	ev_item_get
		ENDIF
		
	ELSE
		_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_04,C06R0201_WAITRESS_01)
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	ENDIF
	
EVENT_END

ev_item_get:
	
	_YES_NO_WIN(SCWK_ANSWER)
	
	IF $SCWK_ANSWER == SCR_YES THEN
		IF $LWK_BAG_CHK == 0 THEN 
			_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_06,C06R0201_WAITRESS_01)
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		ELSE
			_OBJ_ANIME( C06R0201_WAITRESS_01, anm_common_onpu )
			_OBJ_ANIME_WAIT()

			_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_05,C06R0201_WAITRESS_01)
			_MSGWIN_CLOSE()
			
			_SYSWIN_MSG(msg_c06r0201_exchange_sys_01,POS_DEFAULT )
			_MSGWIN_CLOSE()
			_ITEM_EVENT_SUCCESS_NOWAIT(ITEM_HAATONOUROKO,1)
			
			//ハートスイーツ減産処理
			_SUB_ITEM( ITEM_HAATOSUIITU,10,LWK_ITEM_SUB_CHK )
		ENDIF
	ELSE
		_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_07,C06R0201_WAITRESS_01)
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	ENDIF
_RET

ev_spday_item_get:

	_YES_NO_WIN(SCWK_ANSWER)
	
	IF $SCWK_ANSWER == SCR_YES THEN
		IF $LWK_BAG_CHK == 0 THEN 
			_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_06,C06R0201_WAITRESS_01)
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		ELSE
			_OBJ_ANIME( C06R0201_WAITRESS_01, anm_common_onpu )
			_OBJ_ANIME_WAIT()
		
			_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_05,C06R0201_WAITRESS_01)
			_MSGWIN_CLOSE()
			
			_SYSWIN_MSG(msg_c06r0201_exchange_sys_01,POS_DEFAULT )
			_MSGWIN_CLOSE()
			_ITEM_EVENT_SUCCESS_NOWAIT(ITEM_HAATONOUROKO,1)
			
			//ハートスイーツ減産処理
			_SUB_ITEM( ITEM_HAATOSUIITU,5,LWK_ITEM_SUB_CHK )
		ENDIF
	ELSE
		_BALLOONWIN_OBJMSG(msg_c06r0201_waitress_07,C06R0201_WAITRESS_01)
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	ENDIF


_RET

/**************************************************************/
/*  c06r0201_veteranw_01　アイテム入手イベント*/
/**************************************************************/
EVENT_START   ev_c06r0201_veteranw_01
	//どうぐ入手処理：するどいクチバシ
	_EASY_TALK_ITEM_EVENT( ITEM_SURUDOIKUTIBASI, 1, FE_C06R0101_ITEMGET_01, msg_c06r0201_veteranw_01, msg_c06r0201_veteranw_02, msg_c06r0201_veteranw_02)

EVENT_END

/************************************************************/
/*  フウロ話しかけ（ヤマジタウンへ ）                       */
/************************************************************/
EVENT_START   ev_c06r0201_swleader6_01
{

  //バッジフラグ取得
  _GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_06 )

  //イベント進行状況確認
  IF $WK_SCENE_C06HAKASE <= 3 && $SCWK_TEMP0 == 1 THEN    //博士と合流していない

    _TALK_OBJ_START()
    //フウロ：タワーオブヘブンは
    _BALLOONWIN_OBJMSG( msg_c06r0201_swleader6_01, C06R0201_SWLEADER6_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSIF $WK_SCENE_C06HAKASE == 4 THEN   //博士と合流している

    _TALK_OBJ_START()
    //初めて話しかけたか
    IF FLAG_OFF( FE_C06R0201_SWLEADER6_01 ) THEN
      //フウロ：はかせの　ちょうさも
      _BALLOONWIN_OBJMSG( msg_c06r0201_swleader6_02, C06R0201_SWLEADER6_01 )

      //========================================//
      //２度目以降から下のセリフに
      _FLAG_SET( FE_C06R0201_SWLEADER6_01 )
      //========================================//

    ELSE
      //フウロ：ね　ひこうきに　のる？
      _BALLOONWIN_OBJMSG( msg_c06r0201_swleader6_05, C06R0201_SWLEADER6_01 )

    ENDIF

    _YES_NO_WIN( SCWK_ANSWER )

    //飛行機に乗る？
    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //フウロ：じゃ　いきましょ！
      _BALLOONWIN_OBJMSG( msg_c06r0201_swleader6_03, C06R0201_SWLEADER6_01 )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      _OBJ_ANIME( C06R0201_HAKASE2_01, anm_common_turn_l )
      _OBJ_ANIME_WAIT()

      //アララギ：もくてきは　ソウリュウシティ！
      _BALLOONWIN_OBJMSG( msg_c06r0201_hakase2_01, C06R0201_HAKASE2_01 )
      _MSGWIN_CLOSE()

      //========================================//
      //ベル表示
      _FLAG_RESET( FV_C06R0201_SWBELL_01 )
      //========================================//
      
      //階段SE
      _SE_PLAY( SEQ_SE_KAIDAN )
      
      _OBJ_ADD( C06R0201_SWBELL_01 )  //ベル登場
      _SE_WAIT()

      //アニメ：ベル移動
      _OBJ_ANIME_AUTO( C06R0201_SWBELL_01, 18, 21, FORCE_TYPE_NPC, 4, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( C06R0201_SWBELL_01, anm_common_turn_u )
      //アニメ：主人公振り向き
      
      _PLAYER_DIR_GET(SCWK_ANSWER)
      SWITCH $SCWK_ANSWER
      CASE DIR_UP THEN
      	_OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
      CASE DIR_RIGHT THEN
      	_OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
      	_OBJ_ANIME( C06R0201_SWLEADER6_01, anm_common_turn_d )
      ENDSWITCH

      _OBJ_ANIME( C06R0201_HAKASE2_01, anm_common_turn_d )
      _OBJ_ANIME_WAIT()

      //ベル：はあ　はあ▼
      _BALLOONWIN_OBJMSG( msg_c06r0201_swbell_01, C06R0201_SWBELL_01 )
      _MSGWIN_CLOSE()

      //アララギ：あら！？　ベルったら▼
      _BALLOONWIN_OBJMSG_POS( msg_c06r0201_hakase2_02, C06R0201_HAKASE2_01, POS_UP )
      _MSGWIN_CLOSE()

      //フウロ：うふふ
      _BALLOONWIN_OBJMSG_POS( msg_c06r0201_swleader6_06, C06R0201_SWLEADER6_01, POS_UP )
      _MSGWIN_CLOSE()

        //ヤマジタウンへ
        _CALL ev_map_change_t07_hakase

      //========================================//
      //暗転中にフウロ、博士、ベルを非表示
      _FLAG_SET( FV_C06R0201_SWLEADER6_01 )
      _FLAG_SET( FV_C06R0201_HAKASE2_01 )
      _FLAG_SET( FV_C06R0201_SWBELL_01 )
      
      //電気石の洞穴のベルを非表示
      _FLAG_SET( FV_D06R0201_SWBELL_01 )
      
      //C06GYM0101フウロ表示
      _FLAG_RESET( FV_C06GYM0101_LEADER6_01 )
      
      //========================================//
	 $WK_SCENE_T07 = 1 //イベント発生
      //========================================//
      
    //いいえ
    ELSE

      //フウロ：りょうかい！
      _BALLOONWIN_OBJMSG( msg_c06r0201_swleader6_04, C06R0201_SWLEADER6_01 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

}
EVENT_END

/************************************************************/
/*  アララギ娘：話しかけ（ヤマジタウンへ）                        */
/************************************************************/
EVENT_START   ev_c06r0201_hakase2_01

  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG( msg_c06r0201_hakase2_03, C06R0201_HAKASE2_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/************************************************************/
/*  パイロット：話しかけ（メダル見せイベント）              */
/************************************************************/
EVENT_START   ev_c06r0201_pilot_01
{
  _TALK_OBJ_START()

  //メダル取得変数
  DEFINE_LOCAL  LWK_MEDAL_CHC
  //『エースパイロット』のメダルを持っているか
  _CHECK_MEDAL_GET( LWK_MEDAL_CHC, MDLID_SORAWOTOBU )

  //『エースパイロット』のメダルを持っていない＋初回会話
  IF $LWK_MEDAL_CHC == FALSE THEN

    //初回会話か
    IF FLAG_OFF( FE_C06R0201_PILOT_TALK ) THEN

      //パイロット：メダルを　もっていないのかい！？▼
      _BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_pilot_01 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //========================================//
      //フラグON
      _FLAG_SET( FE_C06R0201_PILOT_TALK )
      //========================================//

    ELSE

      //パイロット：ぜひ　ぼくに　みせに　きてね
      _BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_pilot_02 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSIF $LWK_MEDAL_CHC == TRUE THEN

    //『エースパイロット』のメダルを持っている＋ほめられていない
    IF FLAG_OFF( FE_C06R0201_PILOT_CLEAR ) THEN

      //パイロット：メダルを　もっているんだね！？▼
      _BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_pilot_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //========================================//
      //フラグON
      _FLAG_SET( FE_C06R0201_PILOT_CLEAR )
      //========================================//

    ELSE

      //パイロット：キミの　ポケモンに　カンパイ！▼
      _BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_pilot_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF
}
EVENT_END

/************************************************************/
/*  受付嬢：話しかけ（カーゴサービス）                      */
/************************************************************/
EVENT_START   ev_c06r0201_informationw_01

  _TALK_OBJ_START()

  //飛行機に乗れない状態（t07到達前）
  IF $WK_SCENE_T07 == 0 THEN

      //受付嬢：ジムリーダー　しだい　なんです
      _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_01, C06R0201_INFORMATIONW_01, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

  //飛行機に乗れる状態（t07到達後）
  ELSE

    //バッグのアイテムチェック（きょかしょうはあるか）
    _ITEM_CHK( ITEM_KYOKASYOU, 1, LWK_ITEM_CHK )

    //「きょかしょう」を持っない
    IF $LWK_ITEM_CHK == FALSE THEN

      //受付嬢：ヤマジタウンに　いかれますか？
      _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_02, C06R0201_INFORMATIONW_01, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )

      IF $SCWK_ANSWER == SCR_YES THEN   //はい

        //受付嬢：ひこうきに　のって　おまちください▼
        _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_03, C06R0201_INFORMATIONW_01, POS_DOWN )
        _MSGWIN_CLOSE()

        //ヤマジタウンへ
        _CALL ev_map_change_t07

      ELSE    //いいえ

        //受付嬢：いつでも　ごりよう　ください！
        _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_04, C06R0201_INFORMATIONW_01, POS_DOWN )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    //「きょかしょう」を持っている（保護区に行ったことが無い）
    ELSIF $LWK_ITEM_CHK == TRUE && FLAG_OFF( FE_D35R0101_AREA_01 ) THEN

      //受付嬢：フキヨセ　カーゴ　サービス　です▼
      _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_05, C06R0201_INFORMATIONW_01, POS_DOWN )
      _MSGWIN_CLOSE()

      //アニメ：受付嬢「！」
      _OBJ_ANIME( C06R0201_INFORMATIONW_01, anm_common_gyoe )
      _OBJ_ANIME_WAIT()

      //受付嬢：あ……！　それは　きょかしょう！
      _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_06, C06R0201_INFORMATIONW_01, POS_DOWN )

      //保護区に行く？
      _YES_NO_WIN( SCWK_ANSWER )

      IF $SCWK_ANSWER == SCR_YES THEN   //はい

        //==================================//
        //保護区へ行ったフラグON
        _FLAG_SET( FE_D35R0101_AREA_01 )
        //==================================//

        //受付嬢：ひこうきに　のって　おまちください▼
        _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_03, C06R0201_INFORMATIONW_01, POS_DOWN )
        _MSGWIN_CLOSE()

        //保護区へ
        _CALL ev_map_change_d35r0101

      ELSE    //いいえ

        //受付嬢：いつでも　ごりよう　ください！
        _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_04, C06R0201_INFORMATIONW_01, POS_DOWN )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    //「きょかしょう」を持っていて、なおかつ保護区にも行ったことがある
    ELSE

      //受付嬢：こんかいは　どちらに　いかれますか？
      _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_07, C06R0201_INFORMATIONW_01, POS_DOWN )

      //カーゴ行き先選択画面作成
      _BMPMENU_INIT_RIGHT( MENU_X2, MENU_Y2, 0, 1, LWK_NUM_SELECT )

      _BMPMENU_MAKE_LIST( msg_c06r0201_select_01, 0 ) //ヤマジタウン
      _BMPMENU_MAKE_LIST( msg_c06r0201_select_02, 1 ) //しぜんほごく
      _BMPMENU_MAKE_LIST( msg_c06r0201_select_03, 2 ) //やめる

      _BMPMENU_START()

      //「ヤマジタウン」を選択
      IF $LWK_NUM_SELECT == 0 THEN

        //受付嬢：ひこうきに　のって　おまちください▼
        _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_03, C06R0201_INFORMATIONW_01, POS_DOWN )
        _MSGWIN_CLOSE()

        //ヤマジタウンへ
        _CALL ev_map_change_t07

      //「ヤマジタウン」を選択
      ELSIF $LWK_NUM_SELECT == 1 THEN

        //受付嬢：ひこうきに　のって　おまちください▼
        _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_03, C06R0201_INFORMATIONW_01, POS_DOWN )
        _MSGWIN_CLOSE()

        //保護区へ
        _CALL ev_map_change_d35r0101

      //やめる（キャンセル）
      ELSE

        //受付嬢：いつでも　ごりよう　ください！
        _BALLOONWIN_OBJMSG_POS( msg_c06r0201_infomationw_04, C06R0201_INFORMATIONW_01, POS_DOWN )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ENDIF

  ENDIF

EVENT_END

//フキヨセカーゴ・ヤマジタウンへ（アララギイベント専用）
ev_map_change_t07_hakase:

  //３Ｄデモコール
  _DEMO_FADEOUT_BLACK_CALL_SINGLE()
  _CALL_3D_DEMO( DEMO3D_ID_PLANE_TAKE_OFF_FUKIYOSE )

  //リザーブスクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_T07_END )

  //マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_T07, 617, -5, 305, DIR_LEFT )
  
_RET


//フキヨセカーゴ・ヤマジタウンへ
ev_map_change_t07:

  //３Ｄデモコール
  _DEMO_FADEOUT_BLACK_CALL_SINGLE()
  _CALL_3D_DEMO( DEMO3D_ID_PLANE_TAKE_OFF_FUKIYOSE )

  //リザーブスクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_T07_END )

  //マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_T07, 616, -5, 305, DIR_DOWN )
  
_RET

//フキヨセカーゴ・保護区へへ
ev_map_change_d35r0101:

  //３Ｄデモコール
  _DEMO_FADEOUT_BLACK_CALL_SINGLE()
  _CALL_3D_DEMO( DEMO3D_ID_PLANE_TAKE_OFF_FUKIYOSE )

  //リザーブスクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_D35R0101_END )

  //d34保護区までジャンプ
  _MAP_CHANGE_NO_FADE( ZONE_ID_D35R0101, 21 , 0, 31, DIR_UP )

_RET

//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_gyoe
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL	anm_common_onpu
	_ANIME_DATA	AC_MARK_ONPU,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*	WORKMAN	一言メッセージ							*/
/************************************************************/
EVENT_START	ev_c06r0201_workman1_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_workman1_01 )
EVENT_END

/************************************************************/
/*	WORKMAN2	一言メッセージ							*/
/************************************************************/
EVENT_START	ev_c06r0201_workman2_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_workman2_01 )
EVENT_END

/************************************************************/
/*	POKE19	一言メッセージ							*/
/************************************************************/
EVENT_START	ev_c06r0201_poke19_01
	_EASY_TALK_POKEVOICE( MONSNO_533, msg_c06r0201_poke_01 )
EVENT_END

/************************************************************/
/*	WORKMAN3	エスパー/ひこうポケモン　サブイベント		*/
/************************************************************/
EVENT_START	ev_c06r0201_workman3_01

_TALK_OBJ_START()

//イベント後か前か？
IF FLAG_OFF( FE_C06R0201_ITEMGET_01 ) THEN

	//おっ　きみ！　ひこうタイプか　エスパータイプの
	_BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_workman3_01 )

	_CALL ev_poketype_chk
	
	//指定タイプがいたか？
	IF $LWK_EV_CHK == 1 THEN
	
		//あっ！　●●●●が　いるね！
		_BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_workman3_02 )
		_MSGWIN_CLOSE()
		
		//暗転
		_BLACK_OUT_SLOW()
		_DISP_FADE_END_CHECK()

		_TIME_WAIT( 45 ) 

		//暗転復帰
		_BLACK_IN_SLOW()
		_DISP_FADE_END_CHECK()
	
		//サンキュー！
		_BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_workman3_03 )
		_MSGWIN_CLOSE()
		
		//ネットボール×５　入手
		_ITEM_EVENT_KEYWAIT( ITEM_NETTOBOORU, 5 )

		//ポケモンが　いてくれる
		_BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_workman3_04 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()

		//========================================//
		
		//イベント終了
		_FLAG_SET( FE_C06R0201_ITEMGET_01 )
		
		//========================================//
	
	//いなかった場合
	ELSE
	
		//そっかー
		_BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_workman3_05 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
		
	ENDIF


//イベント後の場合
ELSE

	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c06r0201_workman3_04 )

ENDIF

EVENT_END

ev_poketype_chk:

//ＰＯＳ値に０を代入
$LWK_COUNT_NUM = 0

//手持ちのポケモンの数を確認（ひんし、タマゴのポケモンは除外）
_GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_BATTLE_ENABLE )

//手持ちのポケモン数分繰り返す
WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

	//指定POSのポケモンのタイプを取得
	_GET_TEMOTI_POKE_TYPE( LWK_TYPE1, LWK_TYPE2, LWK_COUNT_NUM )

	//エスパータイプ・ひこうタイプの場合
	IF $LWK_TYPE1 == POKETYPE_ESPER || $LWK_TYPE1 == POKETYPE_HIKOU || $LWK_TYPE2 == POKETYPE_ESPER || $LWK_TYPE2 == POKETYPE_HIKOU  THEN
	
		//指定POSのポケモンのNOを取得
		_GET_PARTY_POKE_MONSNO( LWK_RET_MONSNO, LWK_COUNT_NUM )
	
		_MONS_NAME( 0, LWK_RET_MONSNO )

		$LWK_EV_CHK = 1
	
	ENDIF

	//カウント
	$LWK_COUNT_NUM += 1

ENDWHILE

_RET
