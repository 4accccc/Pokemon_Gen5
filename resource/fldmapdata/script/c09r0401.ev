
//======================================================================
//                c09r0401.ev
//
//    スクリプトファイル：c09r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0401.h"
  .include  "c09r0401.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_c09r0401
_EVENT_DATA   ev_init_c09r0401
_EVENT_DATA   ev_recover_c09r0401
_EVENT_DATA   ev_c09r0401_bigfour4_01
_EVENT_DATA   ev_pos_c09r0401_enter_01
_EVENT_DATA   ev_pos_c09r0401_enter_02
_EVENT_DATA   ev_pos_c09r0401_warp_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//                                                                  //
//  LOCALWORK0 をギミックの制御に使用しています。                   //
//    0 = 階段下のPOSイベント有効                                   //
//  LOCALWORK1 をギミックの制御に使用しています。                   //
//    0 = 階段上のPOSイベント有効                                   //
//  LOCALWORK10 をギミックの制御に使用しています。マップ内使用禁止  //
//    555 = POSイベント有効                                         //
//                                                                  //
//------------------------------------------------------------------//


/************************************************************/
/*  ZONE_CHANGE_LABEL                                       */
/************************************************************/
INIT_EVENT_START  ev_zone_c09r0401

  //四天王（エスパー）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
    $LOCALWORK10 = 555
  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_c09r0401

  // 環境音再生
  _FOURKINGS_ESP_INIT()

  //頂上のPOSを踏んでいない時の処理
  //カトレアを花の場所まで移動
  IF $LOCALWORK1 == 0 THEN
    _OBJ_POS_CHANGE( C09R0401_BIGFOUR4_01, 15, 15, 7, DIR_DOWN )
  ENDIF

  //四天王（エスパー）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN

    //配置モデルのアニメをループ再生
    _BMODEL_DIRECT_ANIME_SET_LOOP( SCR_BMID_WARP, 18, 5 )

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_RECOVER_LABEL                                     */
/************************************************************/
INIT_EVENT_START  ev_recover_c09r0401

  // 環境音再生
  _FOURKINGS_ESP_INIT()

  //主人公が頂上にいるときの処理
  IF $LOCALWORK1 == 1 THEN
    //レールOFF
    _FOURKINGS_RAIL_OFF( 4 )
    //カメラ設定を変更
    _FOURKINGS_SET_TOP_CAMERA( 4 )

  ELSE
    //頂上のPOSを踏んでいない時の処理
    //カトレアを花の場所まで移動
    _OBJ_POS_CHANGE( C09R0401_BIGFOUR4_01, 15, 15, 7, DIR_DOWN )
  ENDIF

  //四天王（エスパー）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN

    //配置モデルのアニメをループ再生
    _BMODEL_DIRECT_ANIME_SET_LOOP( SCR_BMID_WARP, 18, 5 )

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  四天王（エスパー）                                      */
/************************************************************/
EVENT_START   ev_c09r0401_bigfour4_01

  _TALK_OBJ_START()

  //ゲームクリア前後で分岐
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    //========ゲームクリア前===============

    //戦闘済みかで分岐
    IF FLAG_OFF( SYS_FLAG_BIGFOUR_ESPWIN ) THEN

      //戦闘前---------------------------------------------------

      //カトレア：あらわれたのは　アタクシ▼
      _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_01, C09R0401_BIGFOUR4_01, POS_UP )
      _MSGWIN_CLOSE()

      //========================================//
      //戦闘終了後にワープのアニメを再生させるため、マップ構築前に勝利フラグをたてておく
      //負けた場合はC09でリセットされるので問題なし
      //四天王（カトレア）勝利フラグをセット
      _FLAG_SET( SYS_FLAG_BIGFOUR_ESPWIN )
      //ワープPOSイベント有効
      $LOCALWORK10 = 555
      //========================================//

    {
      //難易度取得ワーク定義
      DEFINE_LOCAL  LCW_DIFFICULTY
      
      //現在の難易度を取得
      _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
      
      //トレーナー戦呼び出し
      
      //むずかしい
      IF $LCW_DIFFICULTY == 2 THEN
        _TRAINER_BTL_SET( TRID_BIGFOUR4_03, 0 )
      
      //ふつう・かんたん
      ELSE
        _TRAINER_BTL_SET( TRID_BIGFOUR4_01, 0 )
      ENDIF

    }
    
      //敗戦チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
      ELSE
        _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
      ENDIF

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //カトレア：してんのう　ぜんいんに　かったのね▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_04, C09R0401_BIGFOUR4_01, POS_UP )

      ELSE
        //それ以外なら通常メッセージを表示
        //カトレア：まだ　てあわせ　していない
        _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_02, C09R0401_BIGFOUR4_01, POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ELSE

      //戦闘後---------------------------------------------------

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //カトレア：してんのう　ぜんいんに　かったのね▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_04, C09R0401_BIGFOUR4_01, POS_UP )

      ELSE
        //戦闘後メッセージ
        //カトレア：しょうはいも　だいじ　だけれども
        _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_03, C09R0401_BIGFOUR4_01, POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSE

    //========ゲームクリア後===============

    //戦闘済みかで分岐
    IF FLAG_OFF( SYS_FLAG_BIGFOUR_ESPWIN ) THEN

      //戦闘前---------------------------------------------------

      //カトレア：さらに　みがきあげた　つよさと
      _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_05, C09R0401_BIGFOUR4_01, POS_UP )
      _MSGWIN_CLOSE()

      //========================================//
      //戦闘終了後にワープのアニメを再生させるため、マップ構築前に勝利フラグをたてておく
      //負けた場合はC09でリセットされるので問題なし
      //四天王（カトレア）勝利フラグをセット
      _FLAG_SET( SYS_FLAG_BIGFOUR_ESPWIN )
      //ワープPOSイベント有効
      $LOCALWORK10 = 555
      //========================================//

    {
      //難易度取得ワーク定義
      DEFINE_LOCAL  LCW_DIFFICULTY
      
      //現在の難易度を取得
      _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
      
      //トレーナー戦呼び出し
      
      //むずかしい
      IF $LCW_DIFFICULTY == 2 THEN
        _TRAINER_BTL_SET( TRID_BIGFOUR4_04, 0 )
      
      //ふつう・かんたん
      ELSE
        _TRAINER_BTL_SET( TRID_BIGFOUR4_02, 0 )
      ENDIF

    }

      //敗戦チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
      ELSE
        _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
      ENDIF

      //戦闘後メッセージ
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示

        //カトレア：いくだけでは　いみは　ないわ……▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_08, C09R0401_BIGFOUR4_01, POS_UP )

      ELSE
        //それ以外なら通常メッセージを表示

        //カトレア：トレーナーの　こころえ　たしなみを▽
        _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_06, C09R0401_BIGFOUR4_01, POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      ELSE

      //戦闘後---------------------------------------------------

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //カトレア：いくだけでは　いみは　ないわ……▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_08, C09R0401_BIGFOUR4_01, POS_UP )

      ELSE
        //戦闘後メッセージ
        //カトレア：アナタと　おてあわせ　すると
        _BALLOONWIN_OBJMSG_POS( msg_c09r0401_bigfour4_07, C09R0401_BIGFOUR4_01, POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

EVENT_END

/************************************************************/
/*  階段下のposイベント                                     */
/************************************************************/
EVENT_START   ev_pos_c09r0401_enter_01

  //======================================
  //演出開始
  //--------------------------------------

  _TIME_WAIT( 10 )

  //階段表示演出
  _FOURKINGS_ESP_STAIRS( 0 )
  _SE_PLAY( SEQ_SE_SW_CATTLEYA_01 )    // キラキラした水が流れる音

  _TIME_WAIT( 40 )

  //--------------------------------------
  //演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

EVENT_END

/************************************************************/
/*  階段上のposイベント                                     */
/************************************************************/
EVENT_START   ev_pos_c09r0401_enter_02

  //レールOFF
  _FOURKINGS_RAIL_OFF( 4 )

  //カメラ設定を変更
  _FOURKINGS_SET_TOP_CAMERA( 4 )

  //======================================
  //演出開始
  //--------------------------------------

  _TIME_WAIT( 5 )

  //階段消滅
  _FOURKINGS_ESP_STAIRS( 1 )

  _TIME_WAIT( 40 )

  //花のアニメ開始
  _FOURKINGS_ESP_FLOWER()
  _SE_PLAY( SEQ_SE_SW_CATTLEYA_02 )    // 花が開いた後、飛び散る音

  _TIME_WAIT( 30 )

  //キューブ再生
  _FOURKINGS_ESP_CUBE()

  _TIME_WAIT( 30 )

  //カトレア降りてくる
  //第２引数 = 降りるスピード
  //1が遅い ～ 増やすと早くなる
  _FOURKINGS_ESP_CATTLEYA( C09R0401_BIGFOUR4_01, 15 )

  _TIME_WAIT( 60 )

  //--------------------------------------
  //演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

EVENT_END

/************************************************************/
/*  ワープ（出口用）                                        */
/************************************************************/
EVENT_START   ev_pos_c09r0401_warp_01

  //マップチェンジ
  _MAP_CHANGE_WARP( ZONE_ID_C09P01, 31, 48, DIR_UP )

EVENT_END


