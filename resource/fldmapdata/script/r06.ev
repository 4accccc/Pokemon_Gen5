	_ANIME_DATA	ACMD_END,0


/**************************************************************/
/*  POS：コバルオン遭遇イベント */
/**************************************************************/
EVENT_START   ev_pos_r06_legend_meet_01

  //========================================//
  //R06七賢人ロット表示
  _FLAG_RESET( FV_R06_SAGE6_01 )
  //R06事情通の老人表示
  _FLAG_RESET( FV_R06_OLDMAN1_01 )
  //========================================//
  
  // コバルオンOBJ生成
  _OBJ_ADD_EX( 110, 353, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE4_STEP, MV_DMY )
  
  //？？？：こふおおおーーっ！
  _VOICE_PLAY( MONSNO_645, 0 )
  _GIZAPLAINWIN_MSG_POS( msg_r06_poke4_01, POS_UP )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()
  
  //アニメ：主人公「！」
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
   //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  /*
  //主人公中央に移動
  IF $LCW_POSX != 103 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 103, 365, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  _TIME_WAIT( 15 )
  */
  
  // 移動ポケモンアニメ作成
  _EV_MOVEPOKE_CREATE( MMDL_ID_EVENTOBJ_00 )
  
  // 登場アニメ
  _EV_MOVEPOKE_START_ANIME( SCR_EV_MOVEPOKE_ANIME_KOBARUON_IN )
  
  //SE再生
  _SE_PLAY( SEQ_SE_SW_KOBALON_01 )
  
  //アニメ・SE再生待ち
  _EV_MOVEPOKE_CHECK_ANIME_END()
  _SE_WAIT()
  
  _TIME_WAIT( 30 )
  
  //コバルオン：こふおおおーっ！
  _BALLOONWIN_OBJMSG_POS( msg_r06_poke4_01,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _VOICE_PLAY( MONSNO_645, 0 )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  _TIME_WAIT( 12 )
  
  // 退場アニメ
  _EV_MOVEPOKE_START_ANIME( SCR_EV_MOVEPOKE_ANIME_KOBARUON_OUT )
  
  //SE再生
  _SE_PLAY( SEQ_SE_SW_KOBALON_02 )
  
  _EV_MOVEPOKE_CHECK_ANIME_END()
  _SE_WAIT()

  // 移動ポケモンアニメ破棄
  _EV_MOVEPOKE_DELETE()

  // コバルオンOBJ削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  //七賢人動作OBJ生成
  _OBJ_ADD( R06_SAGE6_01 )
  //事情通老人OBJ生成
  _OBJ_ADD( R06_OLDMAN1_01 )
  
   //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //事情通老人・配置箇所変更
  _OBJ_POS_CHANGE( R06_OLDMAN1_01, 102, 0, 372, DIR_UP )
  
  _TIME_WAIT( 30 )
  
  $LCW_POSZ += 2
  //アニメ：ロット接近
  _OBJ_ANIME_AUTO( R06_SAGE6_01, 103, 367, FORCE_TYPE_NPC, 16, DIR_UD)
  _TIME_WAIT(8)
  //アニメ：事情通老人接近
  _OBJ_ANIME_AUTO( R06_OLDMAN1_01, 102, 367, FORCE_TYPE_NPC, 16, DIR_UD)
  _TIME_WAIT(30)
  
  //アニメ：主人公振り向く
  IF $LCW_POSX == 102 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_look_sage_x102 )
  ELSIF $LCW_POSX == 104 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_look_sage_x104 )
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //ロット：いまのポケモンは…！
  _BALLOONWIN_OBJMSG_POS( msg_r06_sage6_01,R06_SAGE6_01, POS_DR ) 
  _MSGWIN_CLOSE()
  
  //事情通：でんせつの
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_01,R06_OLDMAN1_01, POS_DL ) 
  _MSGWIN_CLOSE()
  
  //ロット：おお！
  _BALLOONWIN_OBJMSG_POS( msg_r06_sage6_02,R06_SAGE6_01, POS_DR ) 
  _MSGWIN_CLOSE()
  
  //事情通：コバルオン
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_02,R06_OLDMAN1_01, POS_DL ) 
  
  //事情通：ひとが　たたかいを
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_03,R06_OLDMAN1_01, POS_DL ) 
  _MSGWIN_CLOSE()
  
  //アニメ：事情通「？」
  _OBJ_ANIME( R06_OLDMAN1_01 , anm_common_hatena )
  _OBJ_ANIME_WAIT()
  
  //事情通：…しかしなぜ
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_04,R06_OLDMAN1_01, POS_DL ) 
  
  //事情通：2年前
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_05,R06_OLDMAN1_01, POS_DL ) 
  _MSGWIN_CLOSE()
  
  //ロット：ぐぬぬ
  _BALLOONWIN_OBJMSG_POS( msg_r06_sage6_03,R06_SAGE6_01, POS_DR ) 
  _MSGWIN_CLOSE()
  
  //アニメ：ロット一歩前に出る
  _OBJ_ANIME( R06_SAGE6_01 , anm_walk_u )
  _OBJ_ANIME_WAIT()
  
  //ロット：コバルオンがおまえの
  _BALLOONWIN_OBJMSG_POS( msg_r06_sage6_04,R06_SAGE6_01, POS_DR ) 
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //========================================//
  //R06七賢人ロット非表示
  _FLAG_SET( FV_R06_SAGE6_01 )
  //R06コバルオン遭遇イベントPOS無効
  $WK_SCENE_R06_LEGEND_MEET = 2
  //========================================//

EVENT_END

