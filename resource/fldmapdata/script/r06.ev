//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/**************************************************************/
/*  POS：季節研究所誘導イベント */
/**************************************************************/
EVENT_START   ev_pos_r06_swleader1_01
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //アニメ：チェレン接近
  SWITCH $LCW_POSZ
  CASE 371 THEN
    _OBJ_ANIME( R06_SWLEADER1_01, anm_swleader_come_z371 )
  CASE 372 THEN
    _OBJ_ANIME( R06_SWLEADER1_01, anm_swleader_come_z372 )
  CASE 374 THEN
    _OBJ_ANIME( R06_SWLEADER1_01, anm_swleader_come_z374 )
  CASE 375 THEN
    _OBJ_ANIME( R06_SWLEADER1_01, anm_swleader_come_z375 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_l )
  ENDSWITCH
  _OBJ_ANIME_WAIT()
  
  //チェレン：あっ　ちょっと
  _BALLOONWIN_OBJMSG_POS( msg_r06_swleader1_01,R06_SWLEADER1_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン退場
  _OBJ_ANIME_AUTO( R06_SWLEADER1_01, 135, 370, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 135, 371, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  {
  //ドア生成
  DEFINE_LOCAL	DOOR_ANIME_ID
  _BMODEL_ANIME_CREATE( DOOR_ANIME_ID, SCR_BMID_DOOR, 135, 369 )
	_BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_OPEN )
	_BMODEL_ANIME_WAIT( DOOR_ANIME_ID )
	}
	//アニメ：チェレン中へ
	_OBJ_ANIME( R06_SWLEADER1_01, anm_walk_u )
	_OBJ_ANIME_WAIT()
	
	//階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //チェレン動作モデル削除
  _OBJ_DEL( R06_SWLEADER1_01 )
  
  //アニメ：主人公も退場
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_to_up2 )
	_OBJ_ANIME_WAIT()
  
  //========================================//
  //R06季節研究所誘導POS無効
  $WK_SCENE_R06_SWLEADER1 = 2
  //R06チェレン非表示
  _FLAG_SET( FV_R06_SWLEADER1_01 )
  //========================================//
  
  //予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_R06R0101_SWLEADER1_01 )
	
	//C12PC0101マップチェンジ
	_MAP_CHANGE( ZONE_ID_R06R0101, 6, 9, DIR_UP )
EVENT_END

//--------------------------------------------------------------------
//	チェレン：接近z371
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader_come_z371
  _ANIME_DATA	AC_WALK_U_8F,2
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
