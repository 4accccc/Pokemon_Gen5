//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_to_up2
	_ANIME_DATA	AC_WALK_U_8F,2
	_ANIME_DATA	ACMD_END,0


/**************************************************************/
/*  POS：コバルオン遭遇イベント */
/**************************************************************/
EVENT_START   ev_pos_r06_legend_meet_01

  //========================================//
  //R06七賢人ロット表示
  _FLAG_RESET( FV_R06_SAGE6_01 )
  //R06事情通の老人表示
  _FLAG_RESET( FV_R06_OLDMAN1_01 )
  //========================================//
  
   //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //フィールド上にコバルオン配置
  _OBJ_ADD_EX( LCW_POSX, 355, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE4, MV_DMY )
  
  //アニメ：コバルオン接近
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, LCW_POSX, 363, FORCE_TYPE_NPC, 8, DIR_UD)
  //アニメ：主人公「！」
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //コバルオン：こふおおおーっ！
  _BALLOONWIN_OBJMSG_POS( msg_r06_poke4_01,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _VOICE_PLAY( MONSNO_645, 0 )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //アニメ：コバルオン退場
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 114, 363, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //コバルオン動作OBJ削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  //七賢人動作OBJ生成
  _OBJ_ADD( R06_SAGE6_01 )
  //事情通老人OBJ生成
  _OBJ_ADD( R06_OLDMAN1_01 )
  
   //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  IF $LCW_POSX == 103 THEN
    $LCW_POSX -= 1
  ENDIF
  
  //事情通老人・配置箇所変更
  _OBJ_POS_CHANGE( R06_OLDMAN1_01, LCW_POSX, 0, 372, DIR_UP )
  
  $LCW_POSZ += 2
  //アニメ：ロット接近
  _OBJ_ANIME_AUTO( R06_SAGE6_01, 103, LCW_POSZ, FORCE_TYPE_NPC, 16, DIR_UD)
  _TIME_WAIT(8)
  //アニメ：事情通老人接近
  _OBJ_ANIME_AUTO( R06_OLDMAN1_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 16, DIR_UD)
  _TIME_WAIT(16)
  //アニメ：主人公振り向く
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ロット：いまのポケモンは…！
  _BALLOONWIN_OBJMSG_POS( msg_r06_sage6_01,R06_SAGE6_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //事情通：でんせつの
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_01,R06_OLDMAN1_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //ロット：おお！
  _BALLOONWIN_OBJMSG_POS( msg_r06_sage6_02,R06_SAGE6_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //事情通：コバルオン
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_02,R06_OLDMAN1_01, POS_DEFAULT ) 
  
  //事情通：ひとが　たたかいを
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_03,R06_OLDMAN1_01, POS_DEFAULT ) 
  
  //事情通：…しかしなぜ
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_04,R06_OLDMAN1_01, POS_DEFAULT ) 
  
  //事情通：2年前
  _BALLOONWIN_OBJMSG_POS( msg_r06_oldman1_05,R06_OLDMAN1_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //ロット：ぐぬぬ
  _BALLOONWIN_OBJMSG_POS( msg_r06_sage6_03,R06_SAGE6_01, POS_DEFAULT ) 
  
  //ロット：コバルオンがおまえの
  _BALLOONWIN_OBJMSG_POS( msg_r06_sage6_04,R06_SAGE6_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //========================================//
  //R06七賢人ロット非表示
  _FLAG_SET( FV_R06_SAGE6_01 )
  //R06コバルオン遭遇イベントPOS無効
  $WK_SCENE_R06_LEGEND_MEET = 2
  //========================================//

EVENT_END

