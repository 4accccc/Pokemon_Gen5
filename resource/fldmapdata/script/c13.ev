/************************************************************/
/*	C13	ホミカ・父ＰＯＳイベント２					*/
/************************************************************/
EVENT_START	ev_pos_c13_swleader2_meet_02

	//カメラ移動
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//対象物とカメラのバインドを解く
	//カメラ操作
	_CAMERA_MOVE( 9688,0,970752,15826944,0,43941888,20 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	
	
	//……あの　えいが
	_BALLOONWIN_OBJMSG_POS( msg_c13_swleader2_07 ,C13_SWLEADER2_01 ,POS_DL )
	_MSGWIN_CLOSE()

	//アニメ：……マーク
	_OBJ_ANIME( C13_PILOT_01, anm_common_tenten )
	_OBJ_ANIME_WAIT()

	//……みたのですか
	_BALLOONWIN_OBJMSG_POS( msg_c13_pilot_03 ,C13_PILOT_01 ,POS_DR )
	_MSGWIN_CLOSE()

	//ほら！　きを　おとさない！
	_BALLOONWIN_OBJMSG_POS( msg_c13_swleader2_08 ,C13_SWLEADER2_01 ,POS_DL )
	_MSGWIN_CLOSE()

	//アニメ：左を向く・！マーク
	_OBJ_ANIME( C13_SWLEADER2_01, anm_staystep_l )
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME( C13_SWLEADER2_01, anm_common_gyoe )
	_OBJ_ANIME_WAIT()

	//自機座標取得
	_PLAYER_POS_GET( LWK_POSX, LWK_POSZ )

	//Ｚ座標で分岐
	SWITCH $LWK_POSZ
	CASE 669 THEN
		$LWK_POSZ = 670
	CASE 670 THEN
		$LWK_POSX = 240
	CASE 671 THEN
		$LWK_POSZ = 670
	ENDSWITCH
	
	//アニメ：プレイヤーの前へくる
	_OBJ_ANIME_AUTO( C13_SWLEADER2_01, LWK_POSX, LWK_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
	_OBJ_ANIME_WAIT()
	
	//自機座標取得
	_PLAYER_POS_GET( LWK_POSX, LWK_POSZ )

	//Ｚ座標で分岐
	SWITCH $LWK_POSZ
	CASE 669 THEN
		_OBJ_ANIME( C13_SWLEADER2_01, anm_staystep_u )
		_TIME_WAIT( 8 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
		_OBJ_ANIME_WAIT()
	CASE 670 THEN
		//アニメなし
	CASE 671 THEN
		_OBJ_ANIME( C13_SWLEADER2_01, anm_staystep_d )
		_TIME_WAIT( 8 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
		_OBJ_ANIME_WAIT()
	ENDSWITCH

	//ライバル名代入
	_RIVAL_NAME(1)
	
	//プラズマだんを　おいはらったって！
	_BALLOONWIN_OBJMSG_POS( msg_c13_swleader2_09 ,C13_SWLEADER2_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()

	//自機座標取得
	_PLAYER_POS_GET( LWK_POSX, LWK_POSZ )

	//Ｚ座標で分岐
	SWITCH $LWK_POSZ
	CASE 669 THEN
		$LWK_POSZ = 670
	CASE 670 THEN
		$LWK_POSZ = 669
	CASE 671 THEN
		$LWK_POSZ = 670
	ENDSWITCH

	//アニメ：ホミカ退場
	_OBJ_ANIME_AUTO( C13_SWLEADER2_01, 228, LWK_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
	_TIME_WAIT( 12 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	_OBJ_ANIME_WAIT()

	_OBJ_DEL( C13_SWLEADER2_01 )

	//よし！　わたしは
	_BALLOONWIN_OBJMSG_POS( msg_c13_pilot_04 ,C13_PILOT_01 ,POS_DR )
	_MSGWIN_CLOSE()

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
	_OBJ_ANIME_AUTO( C13_PILOT_01, 242, 669, FORCE_TYPE_NPC, 8, DIR_LR )
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME( C13_PILOT_01, anm_walk_u )
	_OBJ_ANIME_WAIT()
	_SE_PLAY( SEQ_SE_KAIDAN )
	_OBJ_DEL( C13_PILOT_01 )
	_SE_WAIT()
	
	 //自機にカメラを戻す
	_CAMERA_DEF_MOVE (20)
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	_CAMERA_BIND()		//カメラバインド
	_CAMERA_END()		//カメラ操作終了

	//========================================//
	
	//ホミカ・父のバニシュフラグをセット
	_FLAG_SET(FV_C13_SWLEADER2_MEET)
	
	//ジムのホミカ表示
	_FLAG_RESET( FV_C13GYM0102_SWLEADER2ISS )
	
	//ホミカ・父イベント終了
	$WK_SCENE_C13 = 8

	//C13船舶所にライバルと船長を表示
	_FLAG_RESET(FV_C13R0401_SWRIVAL)
	_FLAG_RESET(FV_C13R0401_PILOT)

	//========================================//

EVENT_END
 