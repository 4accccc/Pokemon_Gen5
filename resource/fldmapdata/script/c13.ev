//座標取得用の変数を定義
DEFINE_LOCAL	LWK_POSX
DEFINE_LOCAL	LWK_POSZ

/************************************************************/
/*					ZONE_CHANGE_LABEL				*/
/************************************************************/
INIT_EVENT_START	ev_zone_c13

  //ネオプラズマ団イベント起動後なら
  IF $WK_SCENE_C13 == 5 THEN
  	
  	_SXY_MOVE_NPC_POS( C13_SWRIVAL_01, DIR_RIGHT, 240, 0, 671 )
  	_SXY_MOVE_NPC_POS( C13_SWLEADER2_02, DIR_RIGHT, 240, 0, 669 )
  	_SXY_MOVE_NPC_POS( C13_SWPLAZMAM_01, DIR_LEFT, 240, 0, 670 )
  	_SXY_MOVE_NPC_POS( C13_SWPLAZMAM_02, DIR_LEFT, 241, 0, 671 )
  	_SXY_MOVE_NPC_POS( C13_SWPLAZMAW_01, DIR_LEFT, 241, 0, 669 )
 
  ELSIF $WK_SCENE_C13 == 7 THEN
  
  	_SXY_MOVE_NPC_POS( C13_SWLEADER2_01, DIR_RIGHT, 241, 0, 670 )
  	_SXY_MOVE_NPC_POS( C13_PILOT_01, DIR_LEFT, 243, 0, 670 )
  
  ENDIF

INIT_EVENT_END


/************************************************************/
/*  FIELD_INIT_SCRIPT                                       */
/************************************************************/
INIT_EVENT_START ev_init_c13

  //ネオプラズマ団イベント起動後なら
  IF $WK_SCENE_C13 == 5 THEN
  	_OBJ_POS_CHANGE( C13_SWRIVAL_01, 240, 0, 671, DIR_RIGHT )
  	_OBJ_POS_CHANGE( C13_SWLEADER2_02, 240, 0, 669, DIR_RIGHT )
  	_OBJ_POS_CHANGE( C13_SWPLAZMAM_01, 240, 0, 670, DIR_LEFT )
  	_OBJ_POS_CHANGE( C13_SWPLAZMAM_02, 241, 0, 671, DIR_LEFT )
  	_OBJ_POS_CHANGE( C13_SWPLAZMAW_01, 241, 0, 669, DIR_LEFT )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*			ホミカとの出会いイベント						  */
/**************************************************************/
EVENT_START		ev_pos_c13_swleader2_meet_01

	//カメラ移動
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//対象物とカメラのバインドを解く
	
	//カメラ操作
	_CAMERA_MOVE( 9688,0,970752,13795328,0,42696704,45 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	
	
	//ホミカ父：ホミカよ　ちちを　とめないでおくれ
	_BALLOONWIN_OBJMSG( msg_c13_pilot_01 , C13_PILOT_01 )
	_MSGWIN_CLOSE()
	
	//ホミカ：父を追いかけるように隣接する
	_OBJ_ANIME( C13_SWLEADER2_01, anm_walk_r )
	_OBJ_ANIME_WAIT()
	
	//ホミカ：あのね！　アンタ　せんちょう　でしょ？
	_BALLOONWIN_OBJMSG_POS( msg_c13_swleader2_01 , C13_SWLEADER2_01 , POS_DL )
	_MSGWIN_CLOSE()
	
	//ホミカ父：ホミカと向き合う
	_OBJ_ANIME( C13_PILOT_01, anm_staystep_l )
	_OBJ_ANIME_WAIT()
	
	//ホミカ父：いとしの　むすめよ
	_BALLOONWIN_OBJMSG( msg_c13_pilot_02 , C13_PILOT_01 )
	_MSGWIN_CLOSE()
	
	//ホミカ父：ポケウッド会場の方へ去っていく
	_OBJ_ANIME( C13_PILOT_01, anm_pilot_leave )
	_OBJ_ANIME_WAIT()
	
	//ホミカ父のOBJ削除
	_OBJ_DEL( C13_PILOT_01 )
	
	//ホミカ：地団駄（ちょっと表現難しい）
	//_OBJ_ANIME( C13_SWLEADER2_01, anm_swleader2_stamp )
	//_OBJ_ANIME_WAIT()
	
	//ホミカ：あー　もう！！　バカ！
	_BALLOONWIN_OBJMSG_POS( msg_c13_swleader2_02 , C13_SWLEADER2_01 , POS_DL )
	_MSGWIN_CLOSE()
	
	//ホミカ：ジムの方へ去っていく
	_OBJ_ANIME( C13_SWLEADER2_01, anm_swleader2_leave )
	_OBJ_ANIME_WAIT()
	
	//ホミカのOBJ削除
	_OBJ_DEL( C13_SWLEADER2_01 )	
  
	 //自機にカメラを戻す
	_CAMERA_DEF_MOVE (45)
	 
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	_CAMERA_BIND()		//カメラバインド
	_CAMERA_END()		//カメラ操作終了

	//========================================/
	
	//ホミカとの出会いイベント終了
	$WK_SCENE_C13 = 2
	
	//ホミカとホミカ父を非表示
	_FLAG_SET(FV_C13_SWLEADER2_MEET)
	
	//到着フラグセット
	_FLAG_SET( SYS_FLAG_ARRIVE_C13 )
	
	//========================================/

EVENT_END

