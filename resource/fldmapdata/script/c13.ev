/************************************************************/
/*  FIELD_INIT_SCRIPT                                       */
/************************************************************/
INIT_EVENT_START ev_init_c13

  //ネオプラズマ団イベント起動後なら
  IF $WK_SCENE_C13 == 6 THEN
    _OBJ_POS_CHANGE( C13_SWRIVAL_01, 239, 0, 671, DIR_RIGHT )
  ENDIF

INIT_EVENT_END


/**************************************************************/
/*			ホミカとの出会いイベント						  */
/**************************************************************/
EVENT_START		ev_pos_c13_swleader2_meet_01

	//カメラ移動
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//対象物とカメラのバインドを解く
	
	//カメラ操作
	_CAMERA_MOVE( 9688,0,970752,13795328,0,42696704,45 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	
	
	//ホミカ父：ホミカよ　ちちを　とめないでおくれ
	_BALLOONWIN_OBJMSG( msg_c13_pilot_01 , C13_PILOT_01 )
	_MSGWIN_CLOSE()
	
	//ホミカ：父を追いかけるように隣接する
	_OBJ_ANIME( C13_SWLEADER2_01, anm_walk_r )
	_OBJ_ANIME_WAIT()
	
	//ホミカ：あのね！　アンタ　せんちょう　でしょ？
	_BALLOONWIN_OBJMSG( msg_c13_swleader2_01 , C13_SWLEADER2_01 )
	_MSGWIN_CLOSE()
	
	//ホミカ父：ホミカと向き合う
	_OBJ_ANIME( C13_PILOT_01, anm_staystep_l )
	_OBJ_ANIME_WAIT()
	
	//ホミカ父：いとしの　むすめよ
	_BALLOONWIN_OBJMSG( msg_c13_pilot_02 , C13_PILOT_01 )
	_MSGWIN_CLOSE()
	
	//ホミカ父：ポケウッド会場の方へ去っていく
	_OBJ_ANIME( C13_PILOT_01, anm_pilot_leave )
	_OBJ_ANIME_WAIT()
	
	//ホミカ父のOBJ削除
	_OBJ_DEL( C13_PILOT_01 )
	
	//ホミカ：地団駄（ちょっと表現難しい）
	//_OBJ_ANIME( C13_SWLEADER2_01, anm_swleader2_stamp )
	//_OBJ_ANIME_WAIT()
	
	//ホミカ：あー　もう！！　バカ！
	_BALLOONWIN_OBJMSG( msg_c13_swleader2_02 , C13_SWLEADER2_01 )
	_MSGWIN_CLOSE()
	
	//ホミカ：ジムの方へ去っていく
	_OBJ_ANIME( C13_SWLEADER2_01, anm_swleader2_leave )
	_OBJ_ANIME_WAIT()
	
	//ホミカのOBJ削除
	_OBJ_DEL( C13_SWLEADER2_01 )	
  
	 //自機にカメラを戻す
	_CAMERA_DEF_MOVE (45)
	 
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	_CAMERA_BIND()		//カメラバインド
	_CAMERA_END()		//カメラ操作終了

	//========================================/
	
	//ホミカとの出会いイベント終了
	$WK_SCENE_C13 = 1
	
	//ホミカとホミカ父を非表示
	_FLAG_SET(FV_C13_SWLEADER2_MEET)
	
	//========================================/

EVENT_END

