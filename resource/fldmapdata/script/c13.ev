EVENT_END

/**************************************************************/
/*  C13 SUNGLASSES：ストッパーメッセージ                      */
/**************************************************************/
EVENT_START   ev_c13_sunglasses_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c13_stop_01 )
EVENT_END

/**************************************************************/
/*			ポケウッドのストッパー					  */
/**************************************************************/
EVENT_START		ev_pos_c13_sunglasses_stop
	
	//座標取得
	_PLAYER_POS_GET( LWK_POSX, LWK_POSZ )

	//座標による分岐
	SWITCH $LWK_POSX
	CASE 215 THEN
		_OBJ_ANIME( C13_SUNGLASSES_01, anm_sunglasses_stop_x215 )
		_OBJ_ANIME_WAIT()
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
	CASE 216 THEN
		_OBJ_ANIME( C13_SUNGLASSES_01, anm_sunglasses_stop_x216 )
		_OBJ_ANIME_WAIT()
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
	CASE 218 THEN
		_OBJ_ANIME( C13_SUNGLASSES_01, anm_sunglasses_stop_x218 )
		_OBJ_ANIME_WAIT()
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	CASE 219 THEN
		_OBJ_ANIME( C13_SUNGLASSES_01, anm_sunglasses_stop_x219 )
		_OBJ_ANIME_WAIT()
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	ENDSWITCH
	_OBJ_ANIME_WAIT()

	//サングラス：このさきは　みわくの　ワンダーランド
	_BALLOONWIN_OBJMSG( msg_c13_stop_02 , C13_SUNGLASSES_01 )
	_MSGWIN_CLOSE()
	
	//プレイヤーバックする
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_d )
	_OBJ_ANIME_WAIT()
	
	//座標による分岐
	SWITCH $LWK_POSX
	CASE 215 THEN
		_OBJ_ANIME( C13_SUNGLASSES_01, anm_sunglasses_back_x215 )
	CASE 216,218 THEN
		_OBJ_ANIME( C13_SUNGLASSES_01, anm_dir_d )
	CASE 219 THEN
		_OBJ_ANIME( C13_SUNGLASSES_01, anm_sunglasses_back_x219 )
	ENDSWITCH
	_OBJ_ANIME_WAIT()

EVENT_END

//--------------------------------------------------------------------
//	◆サングラス：ストッパーアニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_sunglasses_stop_x215
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0
	
_ANIME_LABEL	anm_sunglasses_stop_x216
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
	
_ANIME_LABEL	anm_sunglasses_stop_x218
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
	
_ANIME_LABEL	anm_sunglasses_stop_x219
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
_ANIME_LABEL	anm_sunglasses_back_x215
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_sunglasses_back_x219
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*		C13	ライブキャスターイベント						  */
/**************************************************************/
EVENT_START		ev_pos_c13_livecaster
	
	//TVT着信音を再生
	_ME_PLAY( SEQ_ME_CALL )
	_SYSWIN_MSG( msg_c13_tvt_01, POS_DOWN )
	_ME_WAIT()

	_PLAYER_NAME(0)
	_SYSWIN_MSG( msg_c13_tvt_02, POS_DOWN )
	_MSGWIN_CLOSE()
	
	//ライブキャスター起動
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()
  _CALL_TVT_DEMO( 1 )
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()
	
	//========================================/
	
	//ライブキャスターイベント終了
	$WK_SCENE_C13 = 1
	
	//========================================/
	
EVENT_END

/**************************************************************/
/*		C13	ネオプラズマ団イベント					  */
/**************************************************************/
EVENT_START		ev_pos_c13_swplazma

	_CALL	ev_swplazma

EVENT_END

ev_swplazma:
	
	_START_EVENT_BGM( SEQ_BGM_E_PLASMA )
	
	//ホミカ：あんたら……　もしかして
	_BALLOONWIN_OBJMSG( msg_c13_swleader2_03 , C13_SWLEADER2_02 )
	_MSGWIN_CLOSE()
	
	//ネオプラズマ団男：そうとも！
	_BALLOONWIN_OBJMSG( msg_c13_swplazmam1_01 , C13_SWPLAZMAM_01 )
	_MSGWIN_CLOSE()

	//ライバル：一歩前へ出る
	_OBJ_ANIME( C13_SWRIVAL_01, anm_walk_r )
	_OBJ_ANIME_WAIT()

	//ライバル名代入
	_RIVAL_NAME( 1 )

	//ライバル：プラズマだん　ふっかつ？
	_BALLOONWIN_OBJMSG( msg_c13_swrival_01 , C13_SWRIVAL_01 )
	_MSGWIN_CLOSE()
	
	//ネオプラズマ団男：ぼくじょう　では
	_BALLOONWIN_OBJMSG( msg_c13_swplazmam2_01 , C13_SWPLAZMAM_02 )
	_MSGWIN_CLOSE()
	
	//ネオプラズマ団女：ここじゃ　からまれるし
	_BALLOONWIN_OBJMSG( msg_c13_swplazmaw_01 , C13_SWPLAZMAW_01 )
	_MSGWIN_CLOSE()
	
	//ネオプラズマ団男：まあ　いいさ
	_BALLOONWIN_OBJMSG( msg_c13_swplazmam1_02 , C13_SWPLAZMAM_01 )
	_MSGWIN_CLOSE()
	
	//プラズマ団：一歩前へ
	_OBJ_ANIME( C13_SWPLAZMAM_01, anm_walk_l )
	_TIME_WAIT( 8 )
	_OBJ_ANIME( C13_SWPLAZMAM_02, anm_walk_l )
	_OBJ_ANIME( C13_SWPLAZMAW_01, anm_walk_l )
	_OBJ_ANIME_WAIT()
	
	_TIME_WAIT( 20 )
	
	//ライバル：一歩前へ出る
	_OBJ_ANIME( C13_SWRIVAL_01, anm_walk_r )
	_OBJ_ANIME( C13_SWLEADER2_02, anm_walk_r )
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME( C13_SWRIVAL_01, anm_swrival_anime )
	_OBJ_ANIME_WAIT()
	
	//ライバル：ボコボコに　されるのは
	_BALLOONWIN_OBJMSG( msg_c13_swrival_02 , C13_SWRIVAL_01 )
	_MSGWIN_CLOSE()
	
	_END_EVENT_BGM()
	
	//========================================/
	
	//ネオプラズマ団イベント終了
	$WK_SCENE_C13 = 5
	
	//========================================/

_RET

/**************************************************************/
/*		C13 SWLEADER2	分岐メッセージ						  */
/**************************************************************/
EVENT_START		ev_c13_swleader2_02

	//ネオプラズマ団ＰＯＳイベント中か？
	IF $WK_SCENE_C13 == 5 THEN
		//プレイヤーの名前をセット
		_PLAYER_NAME( 0 )
		
		_TALK_OBJ_START()
		
		_BALLOONWIN_TALKOBJ_MSG( msg_c13_swleader2_04 )
		_AB_KEYWAIT_MARK()
		_MSGWIN_CLOSE()

		_OBJ_ANIME( C13_SWLEADER2_02, anm_staystep_r )
		_OBJ_ANIME_WAIT()

	ELSE
		_TALK_START_TURN_NOT()
		
		_OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 239, 670, FORCE_TYPE_NOT, 8, DIR_UD )
		_OBJ_ANIME_WAIT()
		
		_CALL	ev_swplazma
	ENDIF

EVENT_END

/**************************************************************/
/*		C13	SWRIVAL		分岐メッセージ				  */
/**************************************************************/
EVENT_START		ev_c13_swrival_01

	//ネオプラズマ団ＰＯＳイベント中か？
	IF $WK_SCENE_C13 == 5 THEN
		//プレイヤーの名前をセット
		_PLAYER_NAME( 0 )
		
		//ライバル名代入
		_RIVAL_NAME( 1 )
		
		_TALK_START_TURN_NOT()
		_BALLOONWIN_TALKOBJ_MSG( msg_c13_swrival_03 )
		_AB_KEYWAIT_MARK()
		_MSGWIN_CLOSE()
		
	ELSE
		
		_TALK_START_TURN_NOT()
		
		DEFINE_LOCAL	LWK_DIR
	
		_PLAYER_DIR_GET( LWK_DIR )
		SWITCH $LWK_DIR
		CASE DIR_RIGHT THEN
			_OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 239, 670, FORCE_TYPE_NOT, 8, DIR_UD )
		CASE DIR_DOWN THEN
			_OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 239, 670, FORCE_TYPE_NOT, 8, DIR_LR )
		ENDSWITCH
		_OBJ_ANIME_WAIT()

		_CALL	ev_swplazma

	ENDIF

EVENT_END

/**************************************************************/
/*		C13	SWPLAZMAM	分岐メッセージ					  */
/**************************************************************/
EVENT_START		ev_c13_swplazmam_01
_TALK_OBJ_START()

	//ネオプラズマ団男：どうする？　オレと　たたかうかい？
	_BALLOONWIN_TALKOBJ_MSG( msg_c13_swplazmam1_03 )
	
	//はい/いいえ選択
	_YES_NO_WIN( SCWK_ANSWER )
	
	//はいの場合
	IF $SCWK_ANSWER == SCR_YES THEN
		
		_TRAINER_BGM_SET( TRID_SWPLAZMAW_12 )
		
		//ネオプラズマ団男：オマエの　ポケモン
		_BALLOONWIN_TALKOBJ_MSG( msg_c13_swplazmam1_04 )
		_MSGWIN_CLOSE()
		
		//戦闘開始
		_TRAINER_BTL_SET(TRID_SWPLAZMAM_34,0)
		
		//敗戦チェック
		_TRAINER_LOSE_CHECK( SCWK_ANSWER )
		
		IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()	//勝利処理へ
		ELSE
			_TRAINER_LOSE()	//敗北処理へ
		ENDIF
		
		//ホミカ・ライバルの向きを右向きに直す
		_OBJ_ANIME( C13_SWRIVAL_01, anm_dir_r )
		_OBJ_ANIME( C13_SWLEADER2_02, anm_dir_r )
		_OBJ_ANIME_WAIT()
		
		//ネオプラズマ団男：一歩後ずさり
		_OBJ_ANIME( C13_SWPLAZMAM_01, anm_swplazmam_back )
		_TIME_WAIT( 8 )
		_OBJ_ANIME( C13_SWPLAZMAM_02, anm_swplazmam_back )
		_OBJ_ANIME( C13_SWPLAZMAW_01, anm_swplazmam_back )
		_OBJ_ANIME_WAIT()
		
		//ネオプラズマ団男：まさか！　こんな　こどもたちに
		_BALLOONWIN_TALKOBJ_MSG( msg_c13_swplazmam1_06 )
		_MSGWIN_CLOSE()
		
		//ネオプラズマ団Ｒ２０へ
		_OBJ_ANIME( C13_SWPLAZMAM_01, anm_swplazma_dotuku )
		_OBJ_ANIME_WAIT()

		_OBJ_ANIME( C13_SWPLAZMAM_01, anm_swplazma_dotuku1 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_doke )
		_OBJ_ANIME_WAIT()
		
		_OBJ_ANIME_AUTO( C13_SWPLAZMAM_01, 228, 670, FORCE_TYPE_NPC, 4, DIR_LR )
		_OBJ_ANIME_AUTO( C13_SWPLAZMAW_01, 228, 670, FORCE_TYPE_NPC, 4, DIR_UD )
		_TIME_WAIT( 4 )
		_OBJ_ANIME_AUTO( C13_SWPLAZMAM_02, 228, 670, FORCE_TYPE_NPC, 4, DIR_UD )
		_TIME_WAIT( 16 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
		_OBJ_ANIME( C13_SWLEADER2_02, anm_staystep_l )
		_OBJ_ANIME( C13_SWRIVAL_01, anm_staystep_l )
		_OBJ_ANIME_WAIT()
		
		//ネオプラズマ団一同のOBJ削除
		_OBJ_DEL( C13_SWPLAZMAM_01 )
		_OBJ_DEL( C13_SWPLAZMAW_01 )
		_OBJ_DEL( C13_SWPLAZMAM_02 )
		
		//ライバル：一歩前へ出る
		_OBJ_ANIME( C13_SWRIVAL_01, anm_walk_l )
		_OBJ_ANIME_WAIT()
		
		//ライバル名代入
		_RIVAL_NAME( 1 )
		
		//ライバル：チッ！
		_BALLOONWIN_OBJMSG( msg_c13_swrival_04 , C13_SWRIVAL_01 )
		_MSGWIN_CLOSE()
		
		//ホミカ：てわけして探すよ！
		_BALLOONWIN_OBJMSG( msg_c13_swleader2_05 , C13_SWLEADER2_02 )
		_MSGWIN_CLOSE()
		
		//ホミカ：画面左に移動するが、途中で振り返る
		_OBJ_ANIME( C13_SWLEADER2_02, anm_swleader2_leave2 )
		_OBJ_ANIME_WAIT()
		_OBJ_ANIME_AUTO( C13_SWLEADER2_02, 237, 669, FORCE_TYPE_NOT, 8, DIR_UD )
		_OBJ_ANIME_WAIT()
		
		//ホミカ：……まけていたら　たいせつな
		_BALLOONWIN_OBJMSG( msg_c13_swleader2_06 , C13_SWLEADER2_02 )
		_MSGWIN_CLOSE()
		
		//どうぐ入手：ひでんマシン１
		_ITEM_EVENT_KEYWAIT( ITEM_HIDENMASIN01, 1 )
		
		//ホミカ：R20の方へ去る
		_OBJ_ANIME_AUTO( C13_SWLEADER2_02, 228, 669, FORCE_TYPE_NOT, 4, DIR_LR )
		_OBJ_ANIME_WAIT()
		
		//ホミカのOBJ削除
		_OBJ_DEL( C13_SWLEADER2_02 )
		
		//ライバル：プレイヤーに隣接する
		_OBJ_ANIME_AUTO( C13_SWRIVAL_01, 238, 670, FORCE_TYPE_NOT, 8, DIR_UD )
		_OBJ_ANIME_WAIT()
		_OBJ_ANIME( C13_SWRIVAL_01, anm_staystep_u )
		_TIME_WAIT( 8 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
		_OBJ_ANIME_WAIT()
		
		//ライバル名代入
		_RIVAL_NAME( 1 )
		
		//ライバル：それ……　ひでんマシン
		_BALLOONWIN_OBJMSG( msg_c13_swrival_05 , C13_SWRIVAL_01 )
		_MSGWIN_CLOSE()
	
		//ライバル：２０番道路へ
		_OBJ_ANIME_AUTO( C13_SWRIVAL_01, 228, 670, FORCE_TYPE_NOT, 4, DIR_LR )
		_TIME_WAIT( 8 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
		_OBJ_ANIME_WAIT()

		//ライバルのOBJ削除
		_OBJ_DEL( C13_SWRIVAL_01 )
		_SE_WAIT()
		
		//========================================/
		
		//ネオプラズマ団イベント終了
		$WK_SCENE_C13 = 6
		
		//イベントOBJのバニシュフラグをセット
		_FLAG_SET(FV_C13_SWPLAZMA)
		
		//どくジムにホミカ表示
		//_FLAG_RESET(FV_C13GYM0102_SWLEADER2)
	  
	  //以下の処理は水口が追加（2012.01.11）
		//R20ライバル非表示
		_FLAG_RESET( FV_R20_SWRIVAL_01 )
		//R20プラズマ団表示
		_FLAG_RESET( FV_R20_SWPLAZMA_01 )
		//R20_BGM変更
		_FLAG_SET( SYS_FLAG_BGM_R20_PLAZMA )
		
		//R20イベント進行
		$WK_SCENE_R20 = 5
	
		//========================================/
	
	//いいえの場合
	ELSE

		//ネオプラズマ団男：そうそう　オレたちに　さからうなよ
		_BALLOONWIN_TALKOBJ_MSG( msg_c13_swplazmam1_05 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()

	ENDIF

EVENT_END
	
