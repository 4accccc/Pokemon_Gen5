
//======================================================================
//                c16.ev
//
//    スクリプトファイル：c16用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c16.h"
  .include  "c16.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c16
_EVENT_DATA    ev_init_c16
_EVENT_DATA    ev_scene_c16_tutorial_01
_EVENT_DATA    ev_recover_c16
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c16
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c16

  //イベント進行で配置を分岐
  IF $WK_SCENE_C16_TUTORIAL_01 == 1 THEN
    _OBJ_POS_CHANGE( C16_SWRIVAL_01, 0, 0, 0, DIR_DOWN )
  ENDIF
  
  // 出口位置変更
  _CALL ev_c16_exit_change

INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_c16

  // 出口位置変更
  _CALL ev_c16_exit_change

INIT_EVENT_END

// バージョン別で出口位置変更
ev_c16_exit_change:

  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )

  // B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C16_R04W_EXIT01, 0, 0, 0 ) 
  // W2
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C16_R04_EXIT01, 0, 0, 0 ) 
  ENDIF
  
_RET

/**************************************************************/
/*			SCENE_CHANGE：【仮】誘導イベント					  */
/**************************************************************/
EVENT_START		ev_scene_c16_tutorial_01

  _BALLOONWIN_OBJMSG_POS( msg_c16_swrival_04,C16_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //==================================//
  //C16誘導イベント終了
  $WK_SCENE_C16_TUTORIAL_01 = 2
  //C16ライバル非表示
  _FLAG_SET( FV_C16_SWRIVAL_01 )
  //==================================//
  
  
EVENT_END