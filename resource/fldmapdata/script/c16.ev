EVENT_END


/**************************************************************/
/*            パレード                                       */
/**************************************************************/
EVENT_START ev_scene_c16_parade
{
  DEFINE_LOCAL  LWK_OBJID_REC1
  DEFINE_LOCAL  LWK_OBJID_REC2
  DEFINE_LOCAL  LWK_OBJID_REC3
  DEFINE_LOCAL  LWK_OBJID_REC4
  DEFINE_LOCAL  LWK_RET
  DEFINE_LOCAL  LWK_INDEX
  DEFINE_LOCAL  LWK_OBJID_SHOP
  DEFINE_LOCAL  LWK_TMP

  _GET_OBJID( LWK_OBJID_REC1, LWK_RET, 14, 0, 71 )
  _GET_OBJID( LWK_OBJID_REC2, LWK_RET, 16, 0, 71 )
  _GET_OBJID( LWK_OBJID_REC3, LWK_RET, 13, 0, 72 )
  _GET_OBJID( LWK_OBJID_REC4, LWK_RET, 17, 0, 72 )

  $LWK_INDEX  = 0
  WHILE $LWK_INDEX < 8

    //騒音ON
    _RESORT_SET_MY_DATA( RESORT_MY_PARAM_NOISE_REQ, TRUE )

    //お店まで歩く
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_parade_next_shop )
    _OBJ_ANIME( LWK_OBJID_REC1, anm_walk_parade_next_shop )
    _OBJ_ANIME( LWK_OBJID_REC2, anm_walk_parade_next_shop )
    _OBJ_ANIME( LWK_OBJID_REC3, anm_walk_parade_next_shop )
    _OBJ_ANIME( LWK_OBJID_REC4, anm_walk_parade_next_shop )
	  _OBJ_ANIME_WAIT()

    //お店があったら
    $LWK_TMP  = $LWK_INDEX
    $LWK_TMP  += RESORT_GET_PARAM_CHECK_RESIDENT_00
    _RESORT_GET_DATA( LWK_TMP, LWK_RET )
    IF $LWK_RET == TRUE THEN

      //右か左を向く
      IF $LWK_INDEX == 0 || $LWK_INDEX == 2 || $LWK_INDEX == 4 || $LWK_INDEX == 6 THEN
	      _OBJ_ANIME( MMDL_ID_PLAYER, anm_first_dir_right )
      ELSE
	      _OBJ_ANIME( MMDL_ID_PLAYER, anm_first_dir_left )
      ENDIF
	    _OBJ_ANIME_WAIT()

      //お店のOBJID取得
      $LWK_TMP  = $LWK_INDEX
      $LWK_TMP  += RESORT_GET_PARAM_OBJID_RESIDENT_00
      _RESORT_GET_DATA( LWK_TMP, LWK_OBJID_SHOP )

      //騒音OFF
      _RESORT_SET_MY_DATA( RESORT_MY_PARAM_NOISE_REQ, FALSE )

      //台詞
      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 0 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 1 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 2 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 3 )
	    _BALLOONWIN_OBJMSG_POS( msg_c16_parade_01, LWK_OBJID_SHOP, POS_DOWN )
	    _BALLOONWIN_CLOSE()

      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 0 )
      _RESORT_SET_WORD( RESORT_WORD_MEET_YEAR, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 1 )
      _RESORT_SET_WORD( RESORT_WORD_MEET_MONTH, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 2 )
      _RESORT_SET_WORD( RESORT_WORD_MEET_DAY, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 3 )
      _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 4 )
      _RESORT_SET_WORD( RESORT_WORD_SHOP_LV, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 5 )
	    _SYSWIN_MSG( msg_c16_parade_02_a, POS_DOWN )

      _SE_PLAY( SEQ_SE_SW_JA_01 )
      _SE_PLAY( SEQ_SE_SW_JA_02 )
	    _SYSWIN_MSG( msg_c16_parade_02_b, POS_DOWN )
	    _SE_WAIT()
	    _AB_KEYWAIT_MARK()
      _SYSWIN_CLOSE()

    ENDIF

    $LWK_INDEX += 1

  ENDWHILE  
  
  //騒音ON
  _RESORT_SET_MY_DATA( RESORT_MY_PARAM_NOISE_REQ, TRUE )

  //出口まで歩く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_parade_end )
  _OBJ_ANIME( LWK_OBJID_REC1, anm_walk_parade_end )
  _OBJ_ANIME( LWK_OBJID_REC2, anm_walk_parade_end )
  _OBJ_ANIME( LWK_OBJID_REC3, anm_walk_parade_end )
  _OBJ_ANIME( LWK_OBJID_REC4, anm_walk_parade_end )
	_OBJ_ANIME_WAIT()

  
	//フェードアウト
	_BLACK_OUT()
	_DISP_FADE_END_CHECK()

  //位置変更
  _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 15, 0, 37, DIR_DOWN )
  _OBJ_POS_CHANGE( LWK_OBJID_REC1, 14, 0, 36, DIR_DOWN )
  _OBJ_POS_CHANGE( LWK_OBJID_REC2, 16, 0, 36, DIR_DOWN )
  _OBJ_POS_CHANGE( LWK_OBJID_REC3, 13, 0, 35, DIR_DOWN )
  _OBJ_POS_CHANGE( LWK_OBJID_REC4, 17, 0, 35, DIR_DOWN )

  //お店の人、全員したをみる
  $LWK_INDEX  = 0
  WHILE $LWK_INDEX < 8
    $LWK_TMP  = $LWK_INDEX
    $LWK_TMP  += RESORT_GET_PARAM_OBJID_RESIDENT_00
    _RESORT_GET_DATA( LWK_TMP, LWK_OBJID_SHOP )
    _OBJ_ANIME( LWK_OBJID_SHOP, anm_first_dir_down )
  ENDWHILE
  _OBJ_ANIME_WAIT()

  //街カメラへ
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
	_CAMERA_MOVE( RESORT_CAM_CITY_PITCH,RESORT_CAM_CITY_YAW,RESORT_CAM_CITY_DIST,RESORT_CAM_CITY_X,RESORT_CAM_CITY_Y,RESORT_CAM_CITY_Z,1 )
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	//フェードイン
	_BLACK_IN()
	_DISP_FADE_END_CHECK()

  //騒音OFF
  _RESORT_SET_MY_DATA( RESORT_MY_PARAM_NOISE_REQ, FALSE )

  //自分情報
  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_CITY_LV, RESORT_WORD_PARAM_NONE, 0, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 2 )

  _AB_WAIT()

  _SE_PLAY( SEQ_SE_SW_JA_01 )
  _SE_PLAY( SEQ_SE_SW_JA_02 )
	_SYSWIN_MSG( msg_c16_parade_03, POS_UP )
	_SE_WAIT()
	_AB_KEYWAIT_MARK()
  _SYSWIN_CLOSE()

  //フェード
  _MAP_FADE_WHITE_OUT_SLOW()
  _MAP_FADE_END_CHECK()

  _RESORT_END_EFFECT( RESORT_EFFECT_PARADE )

  _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MODE_REMOVE, RESORT_PEOPLE_TYPE_SECRETARY, 0 )
  _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MODE_REMOVE, RESORT_PEOPLE_TYPE_SECRETARY, 1 )
  _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MODE_REMOVE, RESORT_PEOPLE_TYPE_SECRETARY, 2 )
  _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MODE_REMOVE, RESORT_PEOPLE_TYPE_SECRETARY, 3 )

  $WK_SCENE_C16_PARADE  = 2
  _FLAG_RESET( SYS_FLAG_BGM_C16_PARADE )

  _MAP_CHANGE_NO_FADE( ZONE_ID_C16R0101, 8, 0, 8, DIR_DOWN )

  _MAP_FADE_WHITE_IN_SLOW()
  _MAP_FADE_END_CHECK()
}
EVENT_END

