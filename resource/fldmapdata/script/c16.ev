//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c16
_EVENT_DATA    ev_init_c16
_EVENT_DATA    ev_pos_c16_tutorial_01
_EVENT_DATA    ev_c16_secretary_01_tutorial
_EVENT_DATA    ev_c16_secretary_02_tutorial
_EVENT_DATA    ev_reserve_c16_tutorial
_EVENT_DATA    ev_recover_c16
_EVENT_DATA    ev_resort_board_room
_EVENT_DATA    ev_resort_board_city_front
_EVENT_DATA    ev_resort_board_city_back
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c16
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c16

  DEFINE_LOCAL LWK_RET

  // 出口位置変更
  _CALL ev_c16_exit_change

  //ご褒美イベントがあったらフラグをたてる
  _RESORT_GET_MY_DATA( RESORT_MY_PARAM_EV_PRIZE, LWK_RET )
  IF $LWK_RET != RESORT_CITYPRIZE_TYPE_NONE THEN
    $WK_SCENE_C16R0101_PRIZE  = 1
  ENDIF

  // 初回イベントのオーナーと秘書位置変更
  SWITCH $WK_SCENE_C16_TUTORIAL_SEQ
  CASE 1 THEN
    _OBJ_DEL(C16_OWNER_01)
    _OBJ_POS_CHANGE( C16_SECRETARY_01, 15, 0, 70, DIR_DOWN )
    _OBJ_POS_CHANGE( C16_SECRETARY_02, 14, 0, 70, DIR_DOWN )
    _OBJ_DEL(C16_SECRETARY_03)
    _OBJ_DEL(C16_SECRETARY_04)
  CASE 2 THEN
    _OBJ_DEL(C16_OWNER_01)
    _OBJ_POS_CHANGE( C16_SECRETARY_01, 15, 0, 70, DIR_DOWN )
    _OBJ_POS_CHANGE( C16_SECRETARY_02, 14, 0, 70, DIR_DOWN )
    _OBJ_DEL(C16_SECRETARY_03)
    _OBJ_DEL(C16_SECRETARY_04)
  CASE 3 THEN
    _OBJ_DEL(C16_OWNER_01)
    _OBJ_POS_CHANGE( C16_SECRETARY_01, 15, 0, 70, DIR_DOWN )
    _OBJ_POS_CHANGE( C16_SECRETARY_02, 14, 0, 70, DIR_DOWN )
    _OBJ_DEL(C16_SECRETARY_03)
    _OBJ_DEL(C16_SECRETARY_04)
  CASE 4 THEN
    _OBJ_DEL(C16_OWNER_01)
    _OBJ_POS_CHANGE( C16_SECRETARY_01, 15, 0, 70, DIR_DOWN )
    _OBJ_POS_CHANGE( C16_SECRETARY_02, 14, 0, 70, DIR_DOWN )
    _OBJ_DEL(C16_SECRETARY_03)
    _OBJ_DEL(C16_SECRETARY_04)
  CASE 5 THEN
    _OBJ_DEL(C16_OWNER_01)
    _OBJ_POS_CHANGE( C16_SECRETARY_01, 15, 0, 70, DIR_DOWN )
    _OBJ_POS_CHANGE( C16_SECRETARY_02, 14, 0, 70, DIR_DOWN )
    _OBJ_DEL(C16_SECRETARY_03)
    _OBJ_DEL(C16_SECRETARY_04)
  CASE 6 THEN
    _OBJ_DEL(C16_OWNER_01)
    _OBJ_DEL(C16_SECRETARY_01)
    _OBJ_DEL(C16_SECRETARY_02)
    _OBJ_DEL(C16_SECRETARY_03)
    _OBJ_DEL(C16_SECRETARY_04)
  ENDSWITCH

INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_c16

  // 出口位置変更
  _CALL ev_c16_exit_change

INIT_EVENT_END

// バージョン別で出口位置変更
ev_c16_exit_change:

  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )

  // B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C16_R04W_EXIT01, 0, 0, 0 ) 
  // W2
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C16_R04_EXIT01, 0, 0, 0 ) 
  ENDIF
  
_RET

/**************************************************************/
/*			誘導イベント					                                */
/**************************************************************/
EVENT_START		ev_pos_c16_tutorial_01
{
	//うーんこまったな
	_BALLOONWIN_OBJMSG( msg_c16_owner_01, C16_OWNER_01 )
	_MSGWIN_CLOSE()

	//オーナー：！マーク
	_TIME_WAIT( 16 )
	_OBJ_ANIME( C16_OWNER_01, anm_mark_gyoe )

  //秘書下をむく
	_OBJ_ANIME( C16_SECRETARY_03, anm_first_dir_down )
	_OBJ_ANIME( C16_SECRETARY_04, anm_first_dir_down )
	_OBJ_ANIME_WAIT()

  //ちょっときみきみ
	_BALLOONWIN_OBJMSG( msg_c16_owner_01_00, C16_OWNER_01 )
	_MSGWIN_CLOSE()

  //プレイヤー：！マーク
	_TIME_WAIT( 16 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_mark_gyoe )
	_OBJ_ANIME_WAIT()

  //プレイヤーこさせる
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 15, 72, FORCE_TYPE_NOT, 8, DIR_LR )
	_OBJ_ANIME_WAIT()

	_BALLOONWIN_OBJMSG( msg_c16_owner_02, C16_OWNER_01 )

  //はいいいえ
  {
    DEFINE_LOCAL LWK_YESNO
    DEFINE_LOCAL LWK_LOOP

    $LWK_LOOP = TRUE
    WHILE $LWK_LOOP == TRUE
      _YES_NO_WIN( LWK_YESNO )
      IF $LWK_YESNO == SCR_YES THEN
	      _BALLOONWIN_OBJMSG( msg_c16_owner_03_yes, C16_OWNER_01 )
        $LWK_LOOP = FALSE
      ELSE
	      _BALLOONWIN_OBJMSG( msg_c16_owner_03_no, C16_OWNER_01 )
      ENDIF
    ENDWHILE
  }
  _MSGWIN_CLOSE()

  //口癖入力
  _RESORT_INPUT_AUTHERPHRASE( FALSE )

	_BALLOONWIN_OBJMSG( msg_c16_owner_04, C16_OWNER_01 )
	_MSGWIN_CLOSE()

  //感謝入力
  _RESORT_INPUT_AUTHERTHANKS( FALSE )


  _RESORT_SET_WORD( RESORT_WORD_OWNER_PHRASE, RESORT_WORD_PARAM_NONE, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_OWNER_THANKS, RESORT_WORD_PARAM_NONE, 0, 1 )
	_BALLOONWIN_OBJMSG( msg_c16_owner_05, C16_OWNER_01 )
	_MSGWIN_CLOSE()

	//秘書３：！マーク
	_TIME_WAIT( 16 )
	_OBJ_ANIME( C16_SECRETARY_03, anm_mark_gyoe )
	_OBJ_ANIME_WAIT()

  //左向く
	_OBJ_ANIME( C16_SECRETARY_03, anm_first_dir_left )
  _OBJ_ANIME_WAIT()

  //だんな様時間が
	_BALLOONWIN_OBJMSG( msg_c16_secretary3_01, C16_SECRETARY_03 )
	_MSGWIN_CLOSE()

  //右向く
	_OBJ_ANIME( C16_OWNER_01, anm_first_dir_right )
  _OBJ_ANIME_WAIT()

  //おっとそうだった
	_BALLOONWIN_OBJMSG( msg_c16_owner_06, C16_OWNER_01 )
	_MSGWIN_CLOSE()

	//オーナー：上向く
	_OBJ_ANIME( C16_OWNER_01, anm_first_dir_up )
	_OBJ_ANIME_WAIT()

  //オーナー：頼んだよ
	_BALLOONWIN_OBJMSG( msg_c16_owner_07, C16_OWNER_01 )
	_MSGWIN_CLOSE()

  //わかりました
	_BALLOONWIN_OBJMSG( msg_c16_secretary_01, C16_SECRETARY_01 )
	_MSGWIN_CLOSE()


  //オーナーたち去る
	_OBJ_ANIME( C16_OWNER_01, anm_first_owner_goaway_01 )
  _OBJ_ANIME( C16_SECRETARY_03, anm_first_sec03_goaway )
  _OBJ_ANIME( C16_SECRETARY_04, anm_first_sec04_goaway )
	_OBJ_ANIME_WAIT()
  _OBJ_DEL( C16_OWNER_01 )
  _OBJ_DEL( C16_SECRETARY_03 )
  _OBJ_DEL( C16_SECRETARY_04 )

  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()

  //秘書前に
  _OBJ_ANIME( C16_SECRETARY_01, anm_first_sec01_come )
  _OBJ_ANIME( C16_SECRETARY_02, anm_first_sec02_come )
	_OBJ_ANIME_WAIT()

  //始めまして
	_BALLOONWIN_OBJMSG( msg_c16_secretary_02, C16_SECRETARY_01 )
	_MSGWIN_CLOSE()

  //自分の呼び名入力
  _RESORT_INPUT_AUTHERNAME( FALSE )

  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
	_BALLOONWIN_OBJMSG( msg_c16_secretary_03, C16_SECRETARY_01 )
	_MSGWIN_CLOSE()

  //==================================//
  //C16強制チュートリアル終了
  $WK_SCENE_C16_TUTORIAL_01 = 1

  //次からは案内チュートリアル開始
  $WK_SCENE_C16_TUTORIAL_SEQ = 1
  //==================================//
} 
EVENT_END

//--------------------------------------------------------------------
//！マーク
//--------------------------------------------------------------------
_ANIME_LABEL	anm_mark_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//下向き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_dir_down
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//右向き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_dir_right
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//左向き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_dir_left
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//上向き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_dir_up
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//秘書３：去る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_sec03_goaway
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_D_8F,9
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//秘書４：去る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_sec04_goaway
	_ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA AC_WAIT_8F, 1
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_D_8F,9
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//オーナー：去る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_owner_goaway_01
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_D_8F,9
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//秘書１：くる
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_sec01_come
	_ANIME_DATA	AC_WALK_D_8F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//秘書２：くる
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_sec02_come
	_ANIME_DATA	AC_WALK_D_8F,2
	_ANIME_DATA	ACMD_END,0


/**************************************************************/
/*			チュートリアル用秘書１			                          */
/**************************************************************/
EVENT_START	ev_c16_secretary_01_tutorial
{
	_TALK_OBJ_START()

  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )

  //チュートリアルのシーケンスにより話すことが違う
  SWITCH $WK_SCENE_C16_TUTORIAL_SEQ
  CASE 0 THEN //通常ここにはこない。念のため会話して終了
	  _BALLOONWIN_OBJMSG( msg_c16_secretary_04, C16_SECRETARY_01 )
	  _MSGWIN_CLOSE()

  CASE 1 THEN //話しかけチュートリアル開始
	  _BALLOONWIN_OBJMSG( msg_c16_secretary_05, C16_SECRETARY_01 )
	  _MSGWIN_CLOSE()

    //招待する人を追加
    _RESORT_SET_PRESET_PEOPLE( RESORT_PEOPLE_TYPE_PROXY, RESORT_PRESET_TUTORIAL_01 )

    //招待チュートリアル開始へ
    //==================================//
    $WK_SCENE_C16_TUTORIAL_SEQ  = 2
    //==================================//

  CASE 2 THEN //招待チュートリアル中
	  _BALLOONWIN_OBJMSG( msg_c16_secretary_06, C16_SECRETARY_01 )
	  _MSGWIN_CLOSE()

  CASE 3 THEN //招待シュートリアル終了
	  _BALLOONWIN_OBJMSG( msg_c16_secretary_07, C16_SECRETARY_01 )
	  _MSGWIN_CLOSE()

    //案内する人を追加
    _RESORT_SET_PRESET_PEOPLE( RESORT_PEOPLE_TYPE_PROXY, RESORT_PRESET_TUTORIAL_02 )
    //案内チュートリアル開始
    //==================================//
    $WK_SCENE_C16_TUTORIAL_SEQ  = 4
    //==================================//
  CASE 4 THEN //案内チュートリアル中
	  _BALLOONWIN_OBJMSG( msg_c16_secretary_08, C16_SECRETARY_01 )
	  _MSGWIN_CLOSE()

  CASE 5 THEN //案内チュートリアル完了  //ここにはこない
	  _BALLOONWIN_OBJMSG( msg_c16_secretary_04, C16_SECRETARY_01 )
	  _MSGWIN_CLOSE()
  DEFAULT
  ENDSWITCH
}
EVENT_END

//--------------------------------------------------------------------
//秘書１：室内へ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_sec01_inroom
  _ANIME_DATA AC_WAIT_8F,2
	_ANIME_DATA	AC_WALK_L_8F,5
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//秘書２：室内へ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_first_sec02_inroom
	_ANIME_DATA	AC_WALK_L_8F,4
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*			チュートリアル用秘書２					                      */
/**************************************************************/
EVENT_START	ev_c16_secretary_02_tutorial
{
	_TALK_OBJ_START()

  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )

  //チュートリアルのシーケンスにより話すことが違う
  SWITCH $WK_SCENE_C16_TUTORIAL_SEQ
  CASE 0 THEN //通常ここにはこない。念のため会話して終了
	  _BALLOONWIN_OBJMSG( msg_c16_secretary2_01, C16_SECRETARY_02 )
	  _MSGWIN_CLOSE()

  CASE 1 THEN
	  _BALLOONWIN_OBJMSG( msg_c16_secretary2_01, C16_SECRETARY_02 )
	  _MSGWIN_CLOSE()

  CASE 2 THEN
	  _BALLOONWIN_OBJMSG( msg_c16_secretary2_02, C16_SECRETARY_02 )
	  _MSGWIN_CLOSE()

  CASE 3 THEN
	  _BALLOONWIN_OBJMSG( msg_c16_secretary2_03, C16_SECRETARY_02 )
	  _MSGWIN_CLOSE()

  CASE 4 THEN
	  _BALLOONWIN_OBJMSG( msg_c16_secretary2_04, C16_SECRETARY_02 )
	  _MSGWIN_CLOSE()

  CASE 5 THEN
	  _BALLOONWIN_OBJMSG( msg_c16_secretary2_05, C16_SECRETARY_02 )
	  _MSGWIN_CLOSE()
  ENDSWITCH
}
EVENT_END

/**************************************************************/
/*			リザーブ：チュートリアル		                          */
/**************************************************************/
EVENT_START	ev_reserve_c16_tutorial
{
	  _OBJ_ANIME( C16_SECRETARY_01, anm_first_dir_down )
    _OBJ_ANIME_WAIT()

    _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )

	  _BALLOONWIN_OBJMSG( msg_c16_secretary_09, C16_SECRETARY_01 )
	  _MSGWIN_CLOSE()

    //歩いて去っていく
    _OBJ_ANIME( C16_SECRETARY_02, anm_first_sec02_inroom )
	  _OBJ_ANIME( C16_SECRETARY_01, anm_first_sec01_inroom )
    _OBJ_ANIME_WAIT()

    _OBJ_DEL( C16_SECRETARY_02 )

    //階段SE再生
    _SE_PLAY( SEQ_SE_KAIDAN )
    _SE_WAIT()

    _OBJ_DEL( C16_SECRETARY_01 )


    //秘書を追加
    _RESORT_SET_PRESET_PEOPLE( RESORT_PEOPLE_TYPE_SECRETARY, RESORT_PRESET_SECRETARY_01 )
    _RESORT_SET_PRESET_PEOPLE( RESORT_PEOPLE_TYPE_SECRETARY, RESORT_PRESET_SECRETARY_02 )

    //チュートリアル完全終了
    //==================================//
    $WK_SCENE_C16_TUTORIAL_SEQ  = 6

    _RESORT_SET_MY_DATA( RESORT_MY_PARAM_IS_TUTORIAL, FALSE )
    //==================================//
}
EVENT_END

/**************************************************************/
/*            事務所看板                                       */
/**************************************************************/
EVENT_START ev_resort_board_room
{
  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 1 )
  _EASY_BGWIN_MSG( msg_c16_kanban_01, TYPE_POST )
}
EVENT_END

/**************************************************************/
/*            街看板、前                                       */
/**************************************************************/
EVENT_START ev_resort_board_city_front
{
  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
  _EASY_BGWIN_MSG( msg_c16_kanban_02, TYPE_POST )
}
EVENT_END

/**************************************************************/
/*            街看板、後                                       */
/**************************************************************/
EVENT_START ev_resort_board_city_back
{
  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
  _EASY_BGWIN_MSG( msg_c16_kanban_02, TYPE_POST )
}
EVENT_END
