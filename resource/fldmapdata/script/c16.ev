  .text

  .include  "scr_seq_def.h"
  .include  "msg_c16.h"
  .include  "c16.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c16
_EVENT_DATA    ev_init_c16
_EVENT_DATA    ev_scene_c16_tutorial_01
_EVENT_DATA_END


/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c16
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c16

  //イベント進行で配置を分岐
  IF $WK_SCENE_C16_TUTORIAL_01 == 1 THEN
    _OBJ_POS_CHANGE( C16_SWRIVAL_01, 0, 0, 0, DIR_DOWN )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*			SCENE_CHANGE：【仮】誘導イベント					  */
/**************************************************************/
EVENT_START		ev_scene_c16_tutorial_01

  _BALLOONWIN_OBJMSG_POS( msg_c16_swrival_04,C16_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //==================================//
  //C16誘導イベント終了
  $WK_SCENE_C16_TUTORIAL_01 = 2
  //C16ライバル非表示
  _FLAG_SET( FV_C16_SWRIVAL_01 )
  //==================================//
  
  
EVENT_END