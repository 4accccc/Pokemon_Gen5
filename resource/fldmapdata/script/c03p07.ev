_EVENT_DATA   ev_bg_c03p07_gymsign_01
_EVENT_DATA   ev_c03p07_sunglasses_01
_EVENT_DATA   ev_c03p07_informationw_01
_EVENT_DATA   ev_scene_c03p07_cgear_01
_EVENT_DATA_END

/**************************************************************/
/*  C03P07  ジムストッパー                                    */
/**************************************************************/
EVENT_START   ev_c03p07_sunglasses_01
  
  //話しかけが初回
  IF $WK_SCENE_C03GYM_STOPPER == 0 THEN
  
    _TALK_OBJ_START()
    //カメラ移動
    _CAMERA_START()   //カメラ操作開始
    _CAMERA_PURGE()   //カメラのバインドを解く
    _CAMERA_MOVE( 6917,0,835584,1540096,0,3178496,40 )
    _CAMERA_WAIT_MOVE()	//カメラ移動待ち
    
    //ダンペイ：ジムリーダなんですけど
    _BALLOONWIN_OBJMSG_POS( msg_c03p07_glasses_01, C03P07_SUNGLASSES_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //【仮】フィールド上にアイリス配置（指定指定が仮）
    _OBJ_ADD_EX( 20, 20, DIR_DOWN, MMDL_ID_EVENTOBJ_00, SWCHAMPION, MV_DMY )
    
    //？？？：あれ？
    _PLAINWIN_MSG_UP( msg_c03p07_swchampion_01 )
    _MSGWIN_CLOSE()
    
    //アニメ：アイリス隣接
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swchampion_comming )
    _OBJ_ANIME( C03P07_SUNGLASSES_01, anm_pl_gyoe_up )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_pl_gyoe_up )
    _OBJ_ANIME_WAIT()
    
    //ダンペイ：おー！アイリスさん
    _BALLOONWIN_OBJMSG_POS( msg_c03p07_glasses_02, C03P07_SUNGLASSES_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アイリス：ふうん
    _BALLOONWIN_OBJMSG_POS( msg_c03p07_swchampion_02, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    
     //アイリス：きみは…
    _BALLOONWIN_OBJMSG_POS( msg_c03p07_swchampion_03, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    
    //アイリス：うーん
    _BALLOONWIN_OBJMSG_POS( msg_c03p07_swchampion_04, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    
    //【仮】ウィンドウ閉じタイミングを松宮さんにご相談する
    _MSGWIN_CLOSE()
    
    //アニメ：アイリス「！」
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_common_gyoe )
    _OBJ_ANIME_WAIT()
    
    //アイリス：あそこかも
    _BALLOONWIN_OBJMSG_POS( msg_c03p07_swchampion_05, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：アイリス退場
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swchampion_bye )
    _TIME_WAIT(40)
    _OBJ_ANIME( C03P07_SUNGLASSES_01, anm_staystep_d )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    _OBJ_ANIME_WAIT()
    
    //アイリスOBJ消す
    _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
    
    //アニメ：サングラスと主人公向き合う
    _OBJ_ANIME( C03P07_SUNGLASSES_01, anm_staystep_l )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    _OBJ_ANIME_WAIT()
    
    //ダンペイ：やれやれ
    _BALLOONWIN_OBJMSG_POS( msg_c03p07_glasses_03, C03P07_SUNGLASSES_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //自機にカメラを戻す
    _CAMERA_DEF_MOVE (40)
    //カメラ待ち
    _CAMERA_WAIT_MOVE()
    _CAMERA_BIND()    //カメラバインド　主人公位置をカメラが追従するようになります
    _CAMERA_END()   //カメラ操作終了
    
    //==================================//
    //初回会話終わり・C03POS起動
    $WK_SCENE_C03GYM_STOPPER = 1
    //C03のアイリス表示
    _FLAG_RESET( FV_C03_SWCHAMPION_01 )
    //==================================//
  //二回目以降
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03p07_glasses_03 )
  ENDIF

EVENT_END

/**************************************************************/
/*   SCENE_CHANGE：Cギア入手イベント                                    */
/**************************************************************/
EVENT_START   ev_scene_c03p07_cgear_01

  //カメラ移動
  _CAMERA_START()   //カメラ操作開始
  _CAMERA_PURGE()   //カメラのバインドを解く
  _CAMERA_MOVE( 6917,0,835584,1540096,0,3178496,40 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち

  _OBJ_ANIME( C03P07_MACOMO_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME_AUTO( C03P07_MACOMO_01, 22,48, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  
   //マコモ：やっほー
  _BALLOONWIN_OBJMSG_POS( msg_c03p07_inventor_01, C03P07_MACOMO_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：「!」
  _OBJ_ANIME( C03P07_MACOMO_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //マコモ：いきなり
  _BALLOONWIN_OBJMSG_POS( msg_c03p07_inventor_02, C03P07_MACOMO_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //Ｃギア入手処理をコール
  _CALL	ev_cgear_get
  
  //マコモ：くわしいことは
  _BALLOONWIN_OBJMSG_POS( msg_c03p07_inventor_05, C03P07_MACOMO_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：マコモ退場
  _OBJ_ANIME_AUTO( C03P07_MACOMO_01, 13,48, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  
  
  //マコモOBJ削除
  _OBJ_DEL( C03P07_MACOMO_01 )
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (40)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()    //カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()   //カメラ操作終了
  
  //==================================//
  
  //C03のPOS無効
  $WK_SCENE_C03P07_CGEAR_01 = 2
  //C03P07_POS有効
  $WK_SCENE_C03P08_FESGUIDE_01 = 1
  
  //C03P07のマコモ非表示
  _FLAG_SET( FV_C03P07_MACOMO_01 )
  //C03R1103のマコモ表示
  _FLAG_RESET( FV_C03R1103_MACOMO_01 )
  
  //==================================//
	
EVENT_END

//Ｃギア入手処理
ev_cgear_get:
	//Ｃギアを手に入れた！
	_ME_PLAY( SEQ_ME_KEYITEM )
	_PLAYER_NAME( 0 )
	_SYSWIN_MSG( msg_c03p07_cgear_01, POS_DOWN )
	_ME_WAIT()
	_AB_KEYWAIT_MARK()

	//Ｃギアの電源ON/OFF選択
	_PUT_CGEAR_COMMENT( TRUE )		//注意書きを表示
	{
	DEFINE_LOCAL lwk_loop
	WHILE $lwk_loop != 555
	
		//Cギアの電源をONにしますか？
		_SYSWIN_MSG( msg_c03p07_cgear_02, POS_DOWN )
		_BMPMENU_INIT_RIGHT( MENU_X1, 13, 0, 1, SCWK_ANSWER )
		_BMPMENU_MAKE_LIST( msg_c03p07_cgear_03, 0 )	//はい
		_BMPMENU_MAKE_LIST( msg_c03p07_cgear_04, 1 )	//いいえ
		_BMPMENU_START()

		IF $SCWK_ANSWER == 0 THEN
			//はい選択
			_PUT_CGEAR_COMMENT( FALSE )		//注意書きを非表示
			
			//本体設定が通信可能な状態かチェック
			_GET_AVAILABLE_WIRELESS( SCWK_TEMP0 )
			IF $SCWK_TEMP0 == TRUE THEN
				//通信可能

				//質問メッセージのウインドウを消す
				_MSGWIN_CLOSE()
				
				//Cギア起動ＳＥ
				_SE_PLAY( SEQ_SE_DECIDE3 )
				_CGEAR_ON_DEMO( TRUE )		//Ｃギア画面をアクティブで起動
				_SE_WAIT()
				
				//ほら！Ｃギアが起動したでしょ！
				_BALLOONWIN_OBJMSG_POS( msg_c03p07_inventor_03 , C03P07_MACOMO_01, POS_DEFAULT )

			ELSE
				//通信不可（TWL本体設定により無線通信がOFFになっている状態）
				
				//DS本体設定により通信できません
				_SYSWIN_MSG( msg_c03p07_cgear_06, POS_DOWN )
				_MSGWIN_CLOSE()
				
				_CGEAR_ON_DEMO( FALSE )		//Ｃギア画面をパッシブで起動
				
				//Ｃギアの画面があらわれたでしょ？
				_BALLOONWIN_OBJMSG_POS( msg_c03p07_inventor_04 , C03P07_MACOMO_01, POS_DEFAULT )
				
			ENDIF
			
			//ループから抜ける
			$lwk_loop = 555
			
		ELSE
			//いいえ選択なら再確認メッセージ
			//通信機能がオフになりますがよろしいですか？
			_SYSWIN_MSG( msg_c03p07_cgear_05, POS_DOWN )
			_BMPMENU_INIT_RIGHT( MENU_X1, 13, 0, 1, SCWK_ANSWER )
			_BMPMENU_MAKE_LIST( msg_c03p07_cgear_03, 0 )	//はい
			_BMPMENU_MAKE_LIST( msg_c03p07_cgear_04, 1 )	//いいえ
			_BMPMENU_START()
			
			IF $SCWK_ANSWER == SCR_YES THEN
				//はい選択なら通信オフで先へ進む
				_MSGWIN_CLOSE()
				
				_PUT_CGEAR_COMMENT( FALSE )		//注意書きを非表示
				
				_CGEAR_ON_DEMO( FALSE )		//Ｃギア画面をパッシブで起動
				
				//Ｃギアの画面があらわれたでしょ？
				_BALLOONWIN_OBJMSG_POS( msg_c03p07_inventor_04 , C03P07_MACOMO_01, POS_DEFAULT )
				
				//ループから抜ける
				$lwk_loop = 555
				
			ENDIF
			
		
		ENDIF
	
	ENDWHILE
	}
_RET

/**************************************************************/
/*  受付嬢：はなしかけ（ヒウン名所巡りイベント）              */
/**************************************************************/
EVENT_START   ev_c03p07_informationw_01

  _TALK_OBJ_START()

  //名所巡りイベント前の場合
  IF $WK_SCENE_C03_RALLY_01 == 0 THEN

    //受付嬢：イベント開始前
    _BALLOONWIN_TALKOBJ_MSG( msg_c03p07_sightseeing_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //名所巡りイベント中の場合
  ELSIF $WK_SCENE_C03_RALLY_01 >= 1 && $WK_SCENE_C03_RALLY_01 <= 5 THEN

    //このトレーナーと戦った？
    IF FLAG_OFF( FE_C03_RALLYPOINT_05 )THEN

      //受付嬢：トレーナー戦前
      _BALLOONWIN_TALKOBJ_MSG( msg_c03p07_sightseeing_02 )
      _AB_KEYWAIT()
      _MSGWIN_CLOSE()

      //トレーナー戦呼び出し
      _TRAINER_BTL_SET( TRID_PILOT_1_01, 0 )

      //結果チェック
      _CALL ev_battle_check

      //受付嬢：トレーナー戦後
      _BALLOONWIN_TALKOBJ_MSG( msg_c03p07_sightseeing_03 )
      _AB_KEYWAIT()
      _MSGWIN_CLOSE()

      //名所ご褒美受け取り【仮】アイテムは仮です
      _ITEM_EVENT_KEYWAIT( ITEM_KIZUGUSURI, 1 )

      //========================================//
      //トレーナー戦勝利
      _FLAG_SET( FE_C03_RALLYPOINT_05 )
      //========================================//
      //C03イベント進行
      $WK_SCENE_C03_RALLY_01 += 1
      //========================================//

      //戦闘後、全てのポイントをめぐっていた場合
      IF $WK_SCENE_C03_RALLY_01 == 6 THEN
        //受付嬢：評価前台詞
        _BALLOONWIN_TALKOBJ_MSG( msg_c03p07_sightseeing_05 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ELSE
        //受付嬢：イベントクリア前
        _BALLOONWIN_TALKOBJ_MSG( msg_c03p07_sightseeing_04 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE  //戦闘済み

      //受付嬢：イベントクリア前
      _BALLOONWIN_TALKOBJ_MSG( msg_c03p07_sightseeing_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //全てのポイントをめぐっていた場合
  ELSIF $WK_SCENE_C03_RALLY_01 == 6 THEN

    //受付嬢：評価前台詞
    _BALLOONWIN_TALKOBJ_MSG( msg_c03p07_sightseeing_05 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //名所巡りイベント後の場合
  ELSIF $WK_SCENE_C03_RALLY_01 == 7 THEN

    //受付嬢：イベントクリア後メッセージ
    _BALLOONWIN_TALKOBJ_MSG( msg_c03p07_sightseeing_06 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

ev_battle_check:
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET


