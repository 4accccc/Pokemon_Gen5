
//======================================================================
//                c04r0401.ev
//
//    スクリプトファイル：c04r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c04r0401.h"
  .include  "c04r0401.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c04r0401_clown_01
_EVENT_DATA_END


/************************************************************/
/*            クラウン１（ライモンラリー）                  */
/************************************************************/
EVENT_START ev_c04r0401_clown_01

  _TALK_OBJ_START()
  //ライモンラリー・リトルコート通過（1回のみ）
  IF $WK_SCENE_C04_RALLY != 7 && FLAG_OFF( FE_C04_RALLYPOINT_04 )THEN
    _SE_PLAY( SEQ_SE_FLD_41 ) //正解SE
    _BALLOONWIN_TALKOBJ_MSG( msg_c04r0401_rally_01 )

    //========================================//
    //クリア後メッセージ表示終了
    _FLAG_SET( FE_C04_RALLYPOINT_04 )
    //========================================//
    //C04イベント進行
    $WK_SCENE_C04_RALLY += 1
    //========================================//

    _SE_WAIT()
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE
    //以降のメッセージ
    _BALLOONWIN_TALKOBJ_MSG( msg_c04r0401_rally_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END


