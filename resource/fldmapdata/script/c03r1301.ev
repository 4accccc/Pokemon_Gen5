  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//  ボディガードその場歩き（下）
//--------------------------------------------------------------
_ANIME_LABEL  anm_c03r1301_sunglasses_stey_step_down
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

