//  ボディチェック（右-02）
//--------------------------------------------------------------
_ANIME_LABEL  anm_sunglasses_check_right_02
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_L_8F,2
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//  ボディチェック（左-01）
//--------------------------------------------------------------
_ANIME_LABEL  anm_sunglasses_check_left_01
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_L_8F,2
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA AC_STAY_WALK_R_8F,4
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//  ボディチェック（左-02）
//--------------------------------------------------------------
_ANIME_LABEL  anm_sunglasses_check_left_02
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_R_8F,2
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//  ボディチェック（下-01）
//--------------------------------------------------------------
_ANIME_LABEL  anm_sunglasses_check_down_01
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_WALK_D_8F,2
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_STAY_WALK_U_8F,4
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//  ボディチェック（下-02）
//--------------------------------------------------------------
_ANIME_LABEL  anm_sunglasses_check_down_02
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_U_8F,2
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
