/**************************************************************/
/*  お坊ちゃま：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_c03r1301_boy4_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03r1301_boy4_01 )
EVENT_END

