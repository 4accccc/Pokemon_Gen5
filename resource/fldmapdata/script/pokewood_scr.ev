  .text

  .include  "scr_seq_def.h"
  .include  "msg_pokewood_scr.h"
  .include  "pokewood_scr_def.h"

  .include  "c15r0101.h"
  .include  "c15r0201.h"
  .include  "c15r0301.h"

  .include  "pkwd_scr_define.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_pokewood_rec
_EVENT_DATA   ev_pokewood_show
_EVENT_DATA   ev_pokewood_monitor
_EVENT_DATA   ev_zone_pkwd_entrance
_EVENT_DATA   ev_init_pkwd_entrance
_EVENT_DATA   ev_init_pkwd_theater
_EVENT_DATA   ev_pos_pkwd_theater_owner_appear
_EVENT_DATA   ev_pos_pkwd_entrance_tutorial_stopper
_EVENT_DATA   ev_reserve_pkwd_entrance_tutorial
_EVENT_DATA   ev_pkwd_tutorial_pwowner_01
_EVENT_DATA   ev_pkwd_tutorial_sunglasses_02
_EVENT_DATA   ev_pkwd_tutorial_hachiku_01
_EVENT_DATA_END

//==============================================================================
//
/*
  C15R0301:シアターでのローカルワーク使途
    LOCALWORK0  1のとき初上映でのオーナー出現イベント発生
    LOCALWORK1  上記イベントでの上映データ位置を記録

  C15R0201:撮影スタジオエントランスでのローカルワーク使途
    LOCALWORK0  1のときチュートリアルイベントでのストッパー発生
*/
//==============================================================================

//==============================================================================
//
//    初期化スクリプト
//
//==============================================================================
/**************************************************************/
//  zone_change_label
/**************************************************************/
INIT_EVENT_START   ev_zone_pkwd_entrance
  _FLAG_SET( FV_PKWD_STAFF01 )    //出演者・監督非表示
  _FLAG_RESET( FV_PKWD_STAFF02 )  //スタッフ表示
  //チュートリアルモード時の制御
  IF FLAG_ON( SYS_FLAG_POKEWOOD_TUTORIAL ) THEN
    _FLAG_RESET( FV_PKWD_STAFF_TUTORIAL01 )
    _FLAG_RESET( FV_PKWD_STAFF_TUTORIAL02 )
  ELSE
    _FLAG_SET( FV_PKWD_STAFF_TUTORIAL01 )
    _FLAG_SET( FV_PKWD_STAFF_TUTORIAL02 )
  ENDIF
INIT_EVENT_END

/**************************************************************/
//  field_init_label
/**************************************************************/
INIT_EVENT_START  ev_init_pkwd_entrance
  IF FLAG_ON( SYS_FLAG_POKEWOOD_TUTORIAL ) THEN
    $LOCALWORK0 = 1
  ELSE
    $LOCALWORK0 = 0
  ENDIF
INIT_EVENT_END

INIT_EVENT_START  ev_init_pkwd_theater
INIT_EVENT_END

//==============================================================================
//
//  ポケウッド  撮影スタジオ
//
//==============================================================================
DEFINE_LOCAL  LWK_PKWD_SEQ
DEFINE_LOCAL  LWK_PKWD_MENU
DEFINE_LOCAL  LWK_PKWD_SCENARIO
DEFINE_LOCAL  LWK_PKWD_REC_LOOP
DEFINE_LOCAL  LWK_PKWD_REC_POS
DEFINE_LOCAL  LWK_PKWD_DIRECTOR

DEFINE_LOCAL  LWK_PKWD_REC_COUNT
DEFINE_LOCAL  LWK_HEROX
DEFINE_LOCAL  LWK_HEROZ


/**************************************************************/
//    ポケウッド：撮影所受付
/**************************************************************/
EVENT_START ev_pokewood_rec

  _PKWD_SYSTEM_START()

  $LWK_PKWD_SEQ = PKWD_REC_SEQ_FIRST_MENU

  _TALK_OBJ_START()

  //ようこそ！
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_01, SCWK_TARGET_OBJID, POS_DOWN )

  //スターランクが上がったかどうか
  _PKWD_CHECK_NEW_STAR_RANK( SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    //「ヘイ！最近キミは役者らしいイイかおになってきたねー」
    _PLAYER_NAME( 0 )
    _BALLOONWIN_OBJMSG_POS( msg_pw_studio_14, SCWK_TARGET_OBJID, POS_DOWN )
    _ME_PLAY(	SEQ_ME_KEYITEM )  //仮：
    _ME_WAIT()
    _AB_KEYWAIT_MARK()
  ENDIF

  //新着シナリオチェック：それにあわせてメッセージ
  _CALL ev_pkwd_check_new_scenario


  WHILE $LWK_PKWD_SEQ != PKWD_REC_SEQ_END

    SWITCH $LWK_PKWD_SEQ
    CASE PKWD_REC_SEQ_FIRST_MENU      THEN
      _CALL ev_pkwd_rec_first_menu

    CASE PKWD_REC_SEQ_SELECT_SCENARIO THEN
      IF FLAG_ON( SYS_FLAG_POKEWOOD_TUTORIAL ) THEN
        $LWK_PKWD_SCENARIO = 0  //「ハチクマン1」を指定する
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_SELECT_POKE
      ELSE
        _CALL ev_pkwd_rec_select_scenario
      ENDIF

    CASE PKWD_REC_SEQ_SELECT_POKE     THEN
      _CALL ev_pkwd_rec_select_poke

    CASE PKWD_REC_SEQ_POKELIST        THEN
      _CALL ev_pkwd_rec_pokelist

    CASE PKWD_REC_SEQ_SHOOTING        THEN
      _REPORT_EVENT_CALL( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_REPORT_OK THEN
        //JA履歴への対応：ポケウッドで映画を撮った
        _RESORT_SET_RECORD( RESORT_RECORD_ID_POKEWOOD )
        _CALL ev_pkwd_rec_go_studio
        _CALL ev_pkwd_rec_studio
        _CALL ev_pkwd_rec_exit_studio
      ELSE
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
      ENDIF

    CASE PKWD_REC_SEQ_AFTER           THEN
      _CALL ev_pkwd_after_rec

    CASE PKWD_REC_SEQ_ASK_GO_THEATER  THEN
      IF FLAG_ON( SYS_FLAG_POKEWOOD_TUTORIAL ) THEN
        //強制的にここからシアター前イベント→シアター内のイベントへ
        _CALL ev_pkwd_tutorial_go_theater
        //チュートリアルモードのフラグをOFFにする
        _FLAG_RESET( SYS_FLAG_POKEWOOD_TUTORIAL )
        //メダルヒント開示：すべての映画を撮った
        _SET_MEDAL_HINT_ACHIEVE( MDLID_PKWD_SERIES_ALL )
        //メダルヒント開示：興行収入が一定以上
        _SET_MEDAL_HINT_ACHIEVE( MDLID_PKWD_BOXOFFICE )
        //メダルヒント開示：初めてストレンジエンドをとった
        _SET_MEDAL_HINT_ACHIEVE( MDLID_PKWD_STRANGE_FIRST )
        //イベント全体終了へ
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_END
      ELSE
        _CALL ev_pkwd_rec_ask_go_theater
      ENDIF

    CASE PKWD_REC_SEQ_GOODBYE         THEN
      //「銀幕はいつだって君を待ってるぜ！」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_11, SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //シーケンス終了
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_END

    DEFAULT
      //なにか問題があった場合、とりあえず終了させる
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_END
    ENDSWITCH

  ENDWHILE

  _PKWD_SYSTEM_END()

EVENT_END


/**************************************************************/
//  スタジオ内イベント
/**************************************************************/
ev_pkwd_rec_studio:

  //
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_enter_mat )
  _OBJ_ANIME_WAIT()


  $LWK_PKWD_REC_LOOP = TRUE

  WHILE $LWK_PKWD_REC_LOOP == TRUE

    //監督のセリフ：撮影開始
    $SCWK_ANSWER = msg_pw_director_01
    _CALL sub_director_talk
    _MSGWIN_CLOSE()

    //ここで撮影アプリ呼び出し
    _PKWD_REC( LWK_PKWD_REC_POS, LWK_PKWD_SCENARIO, SCWK_ANSWER )

    _DEBUG_PRINT_WK( SCWK_ANSWER )
    IF $SCWK_ANSWER == FALSE THEN
      //監督のセリフ：もう一度撮影するか？
      $SCWK_ANSWER = msg_pw_studio_23
      _CALL sub_director_talk
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER != SCR_YES THEN
        //→「いいえ」：もう一度（なにも変更していない）
      ELSE
        //→「はい」：シーケンス終了へ
        _MSGWIN_CLOSE()
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
        //このループを抜ける
        $LWK_PKWD_REC_LOOP = FALSE
      ENDIF
    ELSE
      //監督のセリフ：撮影完了
      $SCWK_ANSWER = msg_pw_director_06
      _CALL sub_director_talk
      _MSGWIN_CLOSE()
      //シーケンス：撮影後処理（セーブ）へ
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_AFTER
      //このループを抜ける
      $LWK_PKWD_REC_LOOP = FALSE
    ENDIF
  ENDWHILE

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_exit_studio )
  _OBJ_ANIME_WAIT()

  //撮影所エントランス、受付の人の目の前に移動
  _MAP_CHANGE( ZONE_ID_C15R0201, 14, 11, DIR_DOWN )

_RET

_ANIME_LABEL anm_player_enter_mat
  _ANIME_DATA AC_WALK_U_8F, 6
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_player_exit_studio
  _ANIME_DATA AC_WALK_D_8F, 6
  _ANIME_DATA ACMD_END, 0

sub_director_talk:
  _PKWD_GET_DIRECTOR_TYPE( LWK_PKWD_SCENARIO, LWK_PKWD_DIRECTOR )
  $SCWK_ANSWER += $LWK_PKWD_DIRECTOR
  _BALLOONWIN_OBJMSG_POS( SCWK_ANSWER, C15R0101_WKOBJCODE01, POS_DOWN )
_RET

/**************************************************************/
//  撮影後 撮影エントランス
/**************************************************************/
ev_pkwd_after_rec:
  $SCWK_TARGET_OBJID = C15R0201_SUNGLASSES_01

  //公開するかどうかの処理フロー
  _CALL ev_pkwd_rec_save

  IF $SCWK_ANSWER == TRUE THEN
    //→公開する（セーブした）：シアターに移動するか訪ねる
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_ASK_GO_THEATER
  ELSE
    //→公開しない（セーブしなかった）：終了
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDIF

_RET

/**************************************************************/
/**************************************************************/
ev_pkwd_rec_first_menu:
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_03, SCWK_TARGET_OBJID, POS_DOWN )
  _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_PKWD_MENU )
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_01, 0 )  //ちょうせんする
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_02, 1 )  //せつめいをきく
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_03, 2 )  //やめる

  _BMPMENU_START()
  SWITCH $LWK_PKWD_MENU
  CASE 0 THEN
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_SELECT_SCENARIO

  CASE 1 THEN
    //説明
    _BALLOONWIN_OBJMSG_POS( msg_pw_studio_04, SCWK_TARGET_OBJID, POS_DOWN )
    _MSGWIN_CLOSE()

  DEFAULT
    //じゃあ、また
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDSWITCH

_RET


/**************************************************************/
/**************************************************************/
ev_pkwd_rec_select_scenario:
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_07, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()
  $LWK_PKWD_SCENARIO = SCR_PKWD_SCENARIO_MAX
  //台本選択アプリを呼び出し
  _PKWD_SELECT_SCENARIO( LWK_PKWD_SCENARIO )

  _DEBUG_PRINT_WK( LWK_PKWD_SCENARIO )
  IF $LWK_PKWD_SCENARIO >= SCR_PKWD_SCENARIO_MAX THEN
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
    _RET
  ENDIF

  //シーケンス：出演ポケモン選択へ
  $LWK_PKWD_SEQ = PKWD_REC_SEQ_SELECT_POKE
_RET


/**************************************************************/
/**************************************************************/
ev_pkwd_rec_select_poke:
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_08, SCWK_TARGET_OBJID, POS_DOWN )
  _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_PKWD_MENU )
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_05, 0 ) //レンタルポケモン
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_04, 1 ) //自分のポケモン
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_03, 2 ) //やめる
  _BMPMENU_START()

  SWITCH $LWK_PKWD_MENU
  CASE 0 THEN
    //「OK!この作品にぴったりのポケモンを手配しとくぜ！」
    _BALLOONWIN_OBJMSG_POS( msg_pw_studio_10, SCWK_TARGET_OBJID, POS_DOWN )
    _MSGWIN_CLOSE()
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_SHOOTING
    _PKWD_SET_JOIN_MYPOKE( FALSE )	// レンタルポケモンで参加
  CASE 1 THEN
    _PKWD_GET_SCENARIO_STATUS( SCR_PKWD_SCENARIO_SUCCESS_FLAG, LWK_PKWD_SCENARIO, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_POKELIST
      _PKWD_SET_JOIN_MYPOKE( TRUE )	// 自分の手持ちポケモンをだす
    ELSE
      //「SORRY！」出れない旨のメッセージ
      _PLAYER_NAME( 0 )
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_15, SCWK_TARGET_OBJID, POS_DOWN )
    ENDIF
  DEFAULT
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDSWITCH
  
_RET

/**************************************************************/
// ポケウッド：ポケモンリスト呼び出し
/**************************************************************/
ev_pkwd_rec_pokelist:
  //「OK!OK!じゃあ作品に出演するポケモンを決めてくれ！」
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_09, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()
  _PKWD_SELECT_POKEMON( SCWK_ANSWER )
  IF $SCWK_ANSWER ==FALSE THEN
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
    _RET
  ENDIF
  $LWK_PKWD_SEQ = PKWD_REC_SEQ_SHOOTING

_RET

/**************************************************************/
//  スタジオへの入室処理
/**************************************************************/
ev_pkwd_rec_go_studio:
  //フェスミッション強制終了処理
  _FMISSION_END_FORCE()

  //「OK!じゃあ撮影を始めようか！」
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_12, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()

  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  SWITCH $LWK_HEROX
  CASE 12 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_studio1 )
  CASE 13 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_studio2 )
  CASE 14 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_studio3 )
  ENDSWITCH
  _OBJ_ANIME_WAIT()

  //ここで監督・共演者のOBJを設定
  _PKWD_SET_STUDIO_MMDL( LWK_PKWD_SCENARIO, OBJCHRWORK0, OBJCHRWORK1 )
  _FLAG_RESET( FV_PKWD_STAFF01 )  //出演者・監督　表示
  _FLAG_SET( FV_PKWD_STAFF02 )    //スタッフ非表示
  _FLAG_SET( FV_PKWD_STAFF_TUTORIAL01 ) //チュートリアル時のハチク非表示
  _MAP_CHANGE( ZONE_ID_C15R0101, 15, 16, DIR_UP )

_RET

_ANIME_LABEL  anm_player_go_studio1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_R_8F,2
  _ANIME_DATA AC_WALK_U_8F,2
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_studio2
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_WALK_U_8F,2
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_studio3
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

/**************************************************************/
//  スタジオからの退出処理
/**************************************************************/
ev_pkwd_rec_exit_studio:
  _FLAG_SET( FV_PKWD_STAFF01 )    //出演者・監督非表示
  _FLAG_RESET( FV_PKWD_STAFF02 )  //スタッフ表示

  _OBJ_ANIME( C15R0201_SUNGLASSES_01, anm_producer_turn_to_player )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_talk_to_producer )
  _OBJ_ANIME_WAIT()
_RET

_ANIME_LABEL  anm_producer_turn_to_player
  _ANIME_DATA AC_STAY_WALK_R_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_player_talk_to_producer
  _ANIME_DATA AC_WALK_D_8F, 1
  _ANIME_DATA AC_STAY_WALK_L_8F, 1
  _ANIME_DATA ACMD_END, 0


/**************************************************************/
// ポケウッド：映画を公開するか
/**************************************************************/
ev_pkwd_rec_save:
{
  DEFINE_LOCAL  LWK_PKWD_SUBSEQ
  DEFINE_LOCAL  LWK_PKWD_SUBSEQ_RESULT

  $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_PLAY
  $LWK_PKWD_SUBSEQ_RESULT = FALSE

  WHILE $LWK_PKWD_SUBSEQ != PKWD_REC_SUBSEQ_END

    SWITCH $LWK_PKWD_SUBSEQ
    CASE PKWD_REC_SUBSEQ_ASK_PLAY THEN
      //「やー撮影お疲れ！」「シアターで公開するかい？」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_13, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER != SCR_YES THEN
        //→「いいえ」
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_NOT_PLAY
      ELSE
        //→「はい」
        _PKWD_GET_MOVIE_COUNT( LWK_PKWD_REC_COUNT )
        IF $LWK_PKWD_REC_COUNT == SCR_PKWD_MOVIE_MAX THEN
          //→上映データが一杯！
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_DELETE
        ELSE
          //→上映データに空きがある
          //空きを探してその位置に書き込む
          _CALL ev_pkwd_get_empty_pos
          _MSGWIN_CLOSE()
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_REC
        ENDIF
      ENDIF

    CASE PKWD_REC_SUBSEQ_ASK_NOT_PLAY THEN
      //「本当に公開しなくてもかまわないか？」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_17, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_YES THEN
        //→「はい」
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_END
        $LWK_PKWD_SUBSEQ_RESULT = FALSE
      ELSE
        //→「いいえ」
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_PLAY
      ENDIF

    CASE PKWD_REC_SUBSEQ_ASK_DELETE THEN
      //「WAO!今公開中のスクリーンが一杯だぜ！」「終了させるか？」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_05, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_YES THEN
        //→「はい」
        //「OK!じゃあ公開を終了する作品を決めてくれ！」
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_06, SCWK_TARGET_OBJID, POS_DOWN )
        _MSGWIN_CLOSE()
        //上映選択へ
        _PKWD_SELECT_MOVIE( SCR_PKWD_SELECT_MODE_DELETE, LWK_PKWD_REC_POS )
        IF $LWK_PKWD_REC_POS == SCR_PKWD_MOVIE_MAX THEN
          //→キャンセル
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_NOT_PLAY
        ELSE
          //→どれかを選択
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_REC
        ENDIF
      ELSE
        //→「いいえ」
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_NOT_PLAY
      ENDIF

    CASE PKWD_REC_SUBSEQ_REC THEN
      //仮：セーブ中警告
      _SYSWIN_MSG_ALLPUT( msg_pw_system_01, POS_DOWN )
      //セーブ処理を呼び出し
      _DEBUG_PRINT_WK( LWK_PKWD_REC_POS )
      _PKWD_SAVE_MOVIE( LWK_PKWD_REC_POS )
      _MSGWIN_CLOSE()
      _SE_PLAY( SEQ_SE_SAVE )
      $LWK_PKWD_SUBSEQ_RESULT = TRUE
      $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_END

    DEFAULT
      //万が一の場合に無限ループを防ぐためのコード
      $LWK_PKWD_SUBSEQ_RESULT = FALSE
      $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_END
    ENDSWITCH
  ENDWHILE

  $SCWK_ANSWER = $LWK_PKWD_SUBSEQ_RESULT
}
_RET

/**************************************************************/
//  ポケウッド撮影：  撮影後シアターに移動するか？
/**************************************************************/
ev_pkwd_rec_ask_go_theater:
  //「出来が気になるだろ?今すぐシアターに行くかい？」
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_18, SCWK_TARGET_OBJID, POS_DOWN )
  _YES_NO_WIN( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_YES THEN
    //→「はい」
    _MSGWIN_CLOSE()
    //シアターへ異動する
    _MAP_CHANGE( ZONE_ID_C15R0301, 9, 11, DIR_UP )
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_END
  ELSE
    //→「いいえ」
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDIF
_RET

//--------------------------------------------------------------
//  録画データが入っていない場所を探す
//--------------------------------------------------------------
ev_pkwd_get_empty_pos:
  $LWK_PKWD_REC_POS = 0
  _PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    _RET
  ENDIF
  $LWK_PKWD_REC_POS = 1
  _PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    _RET
  ENDIF
  $LWK_PKWD_REC_POS = 2
  _PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    _RET
  ENDIF
  $LWK_PKWD_REC_POS = 3
  _PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    _RET
  ENDIF
  $LWK_PKWD_REC_POS = SCR_PKWD_MOVIE_MAX
  _RET
  
//--------------------------------------------------------------
//  新着台本チェック
//--------------------------------------------------------------
ev_pkwd_check_new_scenario:
{
  DEFINE_LOCAL  LWK_PKWD_ADDMSG_TYPE

  $LWK_PKWD_SCENARIO = 0
  WHILE $LWK_PKWD_SCENARIO < SCR_PKWD_SCENARIO_MAX
    _PKWD_CHECK_NEW_SCENARIO( LWK_PKWD_SCENARIO, LWK_PKWD_ADDMSG_TYPE, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _PLAYER_NAME( 0 )
      _PKWD_SET_SCENARIO_NAME( 1, LWK_PKWD_SCENARIO )  //シナリオ名セット
      SWITCH $LWK_PKWD_ADDMSG_TYPE
      CASE SCR_PKWD_ADDMSG_GOOD_END THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_02, SCWK_TARGET_OBJID, POS_DOWN )
      CASE SCR_PKWD_ADDMSG_GAMECLEAR THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_22, SCWK_TARGET_OBJID, POS_DOWN )
      CASE SCR_PKWD_ADDMSG_STARRANK THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_20, SCWK_TARGET_OBJID, POS_DOWN )
      CASE SCR_PKWD_ADDMSG_PROFITS THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_19, SCWK_TARGET_OBJID, POS_DOWN )
      CASE SCR_PKWD_ADDMSG_ALL_GOOD_END THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_21, SCWK_TARGET_OBJID, POS_DOWN )
      ENDSWITCH
    ENDIF
    $LWK_PKWD_SCENARIO += 1
  ENDWHILE

}
_RET
//==============================================================================
//  ポケウッド　チュートリアル関連
//==============================================================================
/**************************************************************/
//  撮影所エントランス：チュートリアル開始
/**************************************************************/
EVENT_START ev_reserve_pkwd_entrance_tutorial

  _TIME_WAIT( 10 )

  _OBJ_ANIME( C15R0201_SUNGLASSES_02, anm_dir_up )
  _PLAYER_NAME( 0 )
  //「ヘイ！ボス！　～さんをお連れしました！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_01, C15R0201_SUNGLASSES_02, POS_DOWN )
  _MSGWIN_CLOSE()

  //オーナー、プレイヤーのほうを向く
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_dir_down )
  //プレイヤー前に進む
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_up )
  _OBJ_ANIME_WAIT()
  //「ハローハロー！　～～出演して欲しいのさ！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_02, C15R0201_PWOWNER_01, POS_DOWN )
  _MSGWIN_CLOSE()
  //「イエス！ボス！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_03, C15R0201_SUNGLASSES_02, POS_DOWN )
  _MSGWIN_CLOSE()
  //「だから頼むよー　～～
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_04, C15R0201_PWOWNER_01, POS_DOWN )
  //オーナー上を向く
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_dir_up )
  _OBJ_ANIME_WAIT()
  //「オーイ！　ハチクくーん！！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_04_1, C15R0201_PWOWNER_01, POS_DOWN )
  _MSGWIN_CLOSE()
  //ハチク:OBJ出現
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  _OBJ_ADD_EX( 14, 11, DIR_DOWN, MMDL_ID_EVENTOBJ_00, LEADER7, MV_DMY )
  //ハチク:近寄る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_hachiku_approach )
  _OBJ_ANIME_WAIT()
  //オーナー：ハチクを見る
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_dir_right )
  _OBJ_ANIME_WAIT()

  //「ハチクだ……よろしくたのむ……
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_05, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  //オーナー：プレイヤーを見る
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_dir_down )
  _OBJ_ANIME_WAIT()
  //「ハチクくんはね～
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_06, C15R0201_PWOWNER_01, POS_DOWN )
  _MSGWIN_CLOSE()
  //「いい　目だ……競演が楽しみだな……
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_07, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  //ハチク:去る、OBJ削除
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_hachiku_leave )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  //「んー！あいかわらずクール
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_08, C15R0201_PWOWNER_01, POS_DOWN )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

_ANIME_LABEL  anm_player_up
  _ANIME_DATA AC_WALK_U_8F, 3
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_hachiku_approach
  _ANIME_DATA AC_WALK_D_8F, 1
  _ANIME_DATA AC_WALK_R_8F, 1
  _ANIME_DATA AC_WALK_D_8F, 4
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_hachiku_leave
  _ANIME_DATA AC_WALK_U_8F, 4
  _ANIME_DATA AC_WALK_L_8F, 1
  _ANIME_DATA AC_WALK_U_8F, 1
  _ANIME_DATA ACMD_END, 0


/**************************************************************/
//  チュートリアル中POSイベント：撮影所外に出さないためのストッパー
/**************************************************************/
EVENT_START   ev_pos_pkwd_entrance_tutorial_stopper
  _OBJ_ANIME( C15R0201_SUNGLASSES_02, anm_dir_right )
  _OBJ_ANIME_WAIT()
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_10, C15R0201_SUNGLASSES_02, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_back )
  _OBJ_ANIME_WAIT()
EVENT_END

_ANIME_LABEL anm_player_back
  _ANIME_DATA AC_WALK_U_8F, 1
  _ANIME_DATA ACMD_END, 0

/**************************************************************/
//  チュートリアル中の固定キャラ：撮影エントランスのオーナー
/**************************************************************/
EVENT_START ev_pkwd_tutorial_pwowner_01
  _PLAYER_NAME( 0 )
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_pw_tutorial_09 )
EVENT_END

/**************************************************************/
//  チュートリアル中の固定キャラ：撮影エントランスの手下その２
/**************************************************************/
EVENT_START ev_pkwd_tutorial_sunglasses_02
  _PLAYER_NAME( 0 )
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_pw_tutorial_10 )
EVENT_END

/**************************************************************/
//  チュートリアル中の固定キャラ：撮影スタジオのハチク
/**************************************************************/
EVENT_START ev_pkwd_tutorial_hachiku_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_pw_tutorial_17 )
EVENT_END


/**************************************************************/
//  チュートリアル：撮影完了フロー
/**************************************************************/
ev_pkwd_tutorial_go_theater:

//シーン：撮影所エントランス

  //オーナー、プレイヤーに近付く
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_powner_approach_to_player )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_down )
  _OBJ_ANIME_WAIT()

  //「いやー！さつえいお疲れ！～～シアターにレッツゴー！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_11, C15R0201_PWOWNER_01, POS_DOWN )
  _MSGWIN_CLOSE()

  //コマンドでフェードアウト
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()

  //フェード無しマップ遷移でシアター前に移動
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  _MAP_CHANGE_NO_FADE( ZONE_ID_C15, 45, 0, 21, DIR_UP )

//シーン：シアター前

  _OBJ_ADD_EX( 44, 21, DIR_UP, MMDL_ID_EVENTOBJ_00, PWOWNER, MV_DMY )
  //コマンドでフェードイン
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()


  //「さあ！シアターに着いたよ！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_12, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  //一緒にシアターに入場
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_enter_theater )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_enter_theater )
  _OBJ_ANIME_WAIT()

  //コマンドでフェードアウト
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  //フェード無しマップ遷移で//シアター内へ移動
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  _MAP_CHANGE_NO_FADE( ZONE_ID_C15R0301, 15, 0, 31, DIR_UP )

//シーン：シアター内部

  _OBJ_ADD_EX( 14, 31, DIR_UP, MMDL_ID_EVENTOBJ_00, PWOWNER, MV_DMY )
  //コマンドでフェードイン
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()

  //「ホラホラ！　～ちゃんが出演した作品が公開してるよ！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_13, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  //一緒に受付に向かう
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_approach_reception )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_approach_reception )
  _OBJ_ANIME_WAIT()
  // 手下出現：
  _OBJ_ADD_EX( 15, 21, DIR_UP, MMDL_ID_EVENTOBJ_01, SUNGLASSES, MV_DMY )
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_01, anm_sunglasses_appear )
  _OBJ_ANIME_WAIT()

  //「ボス！そろそろお時間が…
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_14, MMDL_ID_EVENTOBJ_01, POS_DOWN )
  _MSGWIN_CLOSE()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_down )
  _OBJ_ANIME_WAIT()
  //「ん……わかった……
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_15, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_dir_right )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_left )
  _OBJ_ANIME_WAIT()
  //「ごめんね！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_16, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  //オーナー退場
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_pwowner_disappear )
  //プレイヤー下向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_down )
  //ちょっと間をおいて
  _TIME_WAIT( 12 )
  //手下退場
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_01, anm_sunglasses_disappear )
  _OBJ_ANIME_WAIT()
  //オーナー・手下削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  _OBJ_DEL( MMDL_ID_EVENTOBJ_01 )
_RET

_ANIME_LABEL  anm_powner_approach_to_player
  _ANIME_DATA AC_WALK_U_8F, 3
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_enter_theater
  _ANIME_DATA AC_WALK_U_8F, 3
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_approach_reception
  _ANIME_DATA AC_WALK_U_8F,16
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_sunglasses_appear
  _ANIME_DATA AC_WALK_U_8F, 3
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_pwowner_disappear
  _ANIME_DATA AC_WALK_D_8F, 8
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_sunglasses_disappear
  _ANIME_DATA AC_WALK_D_8F, 5
  _ANIME_DATA ACMD_END, 0



//==============================================================================
//
//
//    ポケウッドシアター  上映受付
//
//
//==============================================================================
/**************************************************************/
//    ポケウッド：上映受付
/**************************************************************/

DEFINE_LOCAL  LWK_PKWD_SHOW_SEQ
DEFINE_LOCAL  LWK_PKWD_SHOW_MENU
DEFINE_LOCAL  LWK_PKWD_SHOW_LOOP
DEFINE_LOCAL  LWK_PKWD_SHOW_REC_POS
DEFINE_LOCAL  LWK_PKWD_SHOW_REC_COUNT

EVENT_START ev_pokewood_show

  _TALK_OBJ_START()

  _PKWD_SYSTEM_START()

  $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_FIRST_MENU

  WHILE $LWK_PKWD_SHOW_SEQ != PKWD_SHOW_SEQ_END

    SWITCH $LWK_PKWD_SHOW_SEQ
    CASE PKWD_SHOW_SEQ_GOODBYE      THEN
      //「それでは　またのお越しをお待ちしております」
      _BALLOONWIN_OBJMSG_POS( msg_pw_theater_06, SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_END

    CASE PKWD_SHOW_SEQ_FIRST_MENU   THEN
      _CALL ev_pkwd_show_first_menu

    CASE PKWD_SHOW_SEQ_SELECT_MOVIE THEN
      _CALL ev_pkwd_show_select_movie

    CASE PKWD_SHOW_SEQ_WATCH_MOVIE  THEN
      _CALL ev_pkwd_show_watch_movie

    CASE PKWD_SHOW_SEQ_AFTER        THEN
      _CALL ev_pkwd_show_after

    DEFAULT
      $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_END

    ENDSWITCH

  ENDWHILE

  _PKWD_SYSTEM_END()

EVENT_END


/**************************************************************/
//  選択メニュー
/**************************************************************/
ev_pkwd_show_first_menu:

  $LWK_PKWD_SHOW_LOOP = TRUE

  WHILE $LWK_PKWD_SHOW_LOOP == TRUE
    _BALLOONWIN_OBJMSG_POS( msg_pw_theater_01, SCWK_TARGET_OBJID, POS_DOWN )
    _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_PKWD_SHOW_MENU )
    _BMPMENU_MAKE_LIST( msg_pw_theater_menu_06, 0 )  //えいがをみる
    _BMPMENU_MAKE_LIST( msg_pw_theater_menu_07, 1 )  //せつめいをきく
    _BMPMENU_MAKE_LIST( msg_pw_theater_menu_08, 2 )  //やめる
    _BMPMENU_START()

    SWITCH $LWK_PKWD_SHOW_MENU
    CASE 0 THEN
      _PKWD_GET_MOVIE_COUNT( LWK_PKWD_SHOW_REC_COUNT )
      IF $LWK_PKWD_SHOW_REC_COUNT == 0 THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_theater_04, SCWK_TARGET_OBJID, POS_DOWN )
        $LWK_PKWD_SHOW_LOOP = FALSE
        $LWK_PKWD_SHOW_SEQ  = PKWD_SHOW_SEQ_GOODBYE
      ELSE
        $LWK_PKWD_SHOW_LOOP = FALSE
        $LWK_PKWD_SHOW_SEQ  = PKWD_SHOW_SEQ_SELECT_MOVIE
      ENDIF

    CASE 1 THEN
      _BALLOONWIN_OBJMSG_POS( msg_pw_theater_02, SCWK_TARGET_OBJID, POS_DOWN )

    DEFAULT
      $LWK_PKWD_SHOW_LOOP = FALSE
      $LWK_PKWD_SHOW_SEQ  = PKWD_SHOW_SEQ_GOODBYE

    ENDSWITCH
  ENDWHILE
_RET

/**************************************************************/
//
/**************************************************************/
ev_pkwd_show_select_movie:
  //「それでは　ご覧になりたい作品を選んでください」
  _BALLOONWIN_OBJMSG_POS( msg_pw_theater_03, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()
  //上映選択へ
  _PKWD_SELECT_MOVIE( SCR_PKWD_SELECT_MODE_NORMAL, LWK_PKWD_SHOW_REC_POS )

  _DEBUG_PRINT_WK( LWK_PKWD_SHOW_REC_POS )
  IF $LWK_PKWD_SHOW_REC_POS == SCR_PKWD_MOVIE_MAX THEN
    //「それでは　またのお越しをお待ちしております」
    $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_GOODBYE
  ELSE
    //映画鑑賞へ
    $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_WATCH_MOVIE
  ENDIF
_RET


/**************************************************************/
//
/**************************************************************/
DEFINE_LOCAL  LWK_BM_DOOR_ID

ev_pkwd_show_watch_movie:
  //フェスミッション強制終了処理
  _FMISSION_END_FORCE()
  
  //「それでは　まもなく上映です」
  _BALLOONWIN_OBJMSG_POS( msg_pw_theater_05, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()

  //スクリーンに入る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_door )
  _OBJ_ANIME_WAIT()

  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  $LWK_HEROZ -= 1
  _BMODEL_ANIME_CREATE( LWK_BM_DOOR_ID, SCR_BMID_DOOR, LWK_HEROX, LWK_HEROZ )
  _BMODEL_ANIME_SET( LWK_BM_DOOR_ID, SCR_BMANM_DOOR_OPEN )
  _BMODEL_ANIME_WAIT( LWK_BM_DOOR_ID )

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_in_theater )
  _OBJ_ANIME_WAIT()

  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()

  _BMODEL_ANIME_DELETE( LWK_BM_DOOR_ID )

  _PKWD_SHOW( LWK_PKWD_SHOW_REC_POS, SCWK_ANSWER )

  //========================================================
  //スターランクによりファンの表示を変更
  _PKWD_GET_STAR_RANK( SCWK_ANSWER )
  _DEBUG_PRINT_WK( SCWK_ANSWER )
  // スラーランク0
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_0 && FLAG_ON( FV_C15R0301_BONUS_0 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_0 )
    _OBJ_ADD( C15R0301_BACKPACKERM_01 )
  ENDIF
  // スラーランク1
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_1 && FLAG_ON( FV_C15R0301_BONUS_1 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_1 )
    _OBJ_ADD( C15R0301_WOMAN2_01 )
    _OBJ_ADD( C15R0301_MAN3_01 )
    _OBJ_ADD( C15R0301_MUSICIANW_01 )
  ENDIF
  // スラーランク2
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_2 && FLAG_ON( FV_C15R0301_BONUS_2 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_2 )
    _OBJ_ADD( C15R0301_POLICEMAN_01 )
    _OBJ_ADD( C15R0301_WOMAN2_03 )
    _OBJ_ADD( C15R0301_BABYBOY2_01 )
    _OBJ_ADD( C15R0301_NURSE_01 )
  ENDIF
  // スラーランク3
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_3 && FLAG_ON( FV_C15R0301_BONUS_3 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_3 )
    _OBJ_ADD( C15R0301_TRAINERM_01 )
    _OBJ_ADD( C15R0301_WOMAN2_02 )
    _OBJ_ADD( C15R0301_MAN3_02 )
    _OBJ_ADD( C15R0301_OLDWOMAN1_01 )
    _OBJ_ADD( C15R0301_MAN3_03 )
    _OBJ_ADD( C15R0301_TENNISW_01 )
  ENDIF
  // スラーランク4
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_4 && FLAG_ON( FV_C15R0301_BONUS_4 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_4 )
    _OBJ_ADD( C15R0301_MAN3_04 )
    _OBJ_ADD( C15R0301_WOMAN2_04 )
    _OBJ_ADD( C15R0301_BABYBOY1_01 )
    _OBJ_ADD( C15R0301_WOMAN2_05 )
    _OBJ_ADD( C15R0301_MAN3_05 )
    _OBJ_ADD( C15R0301_WOMAN2_06 )
    _OBJ_ADD( C15R0301_HAKAIM_01 )
    _OBJ_ADD( C15R0301_SWPLAZMAW_01 )
  ENDIF

  $LOCALWORK2 = $LWK_PKWD_SHOW_REC_POS
  $LOCALWORK5 = 0   // 道具もらえるようにする
  $LOCALWORK6 = 0   // 道具もらえるようにする
  $LOCALWORK7 = 0   // 道具もらえるようにする
  $LOCALWORK8 = 0   // 道具もらえるようにする
  $LOCALWORK9 = 0   // 道具もらえるようにする
  $LOCALWORK10 = 0   // 道具もらえるようにする
  $LOCALWORK11 = 0   // 道具もらえるようにする
  $LOCALWORK12 = 0   // 道具もらえるようにする
  $LOCALWORK13 = 0   // 道具もらえるようにする
  $LOCALWORK14 = 0   // 道具もらえるようにする
  $LOCALWORK15 = 0   // 道具もらえるようにする
  //========================================================


  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  //閉まるアニメの1フレーム目で止めておく
  _BMODEL_ANIME_CREATE( LWK_BM_DOOR_ID, SCR_BMID_DOOR, LWK_HEROX, LWK_HEROZ )
  _BMODEL_ANIME_SET( LWK_BM_DOOR_ID, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_STOP( LWK_BM_DOOR_ID )

  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()

  //スクリーンから出てくる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_out_theater )
  _OBJ_ANIME_WAIT()

  //アニメ再開
  _BMODEL_ANIME_SET( LWK_BM_DOOR_ID, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_WAIT( LWK_BM_DOOR_ID )

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_to_reception )
  _OBJ_ANIME_WAIT()


  $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_AFTER
_RET

_ANIME_LABEL  anm_player_go_door
  _ANIME_DATA AC_WALK_R_8F, 6
  _ANIME_DATA AC_WALK_U_8F, 2
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_in_theater
  _ANIME_DATA AC_WALK_U_8F, 1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_out_theater
  _ANIME_DATA AC_WALK_D_8F, 1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_to_reception
  _ANIME_DATA AC_WALK_D_8F, 2
  _ANIME_DATA AC_WALK_L_8F, 6
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0


/**************************************************************/
//  上映後の処理
/**************************************************************/
ev_pkwd_show_after:
  _PKWD_GET_MOVIE_VALUE( LWK_PKWD_SHOW_REC_POS, SCWK_ANSWER )
  _DEBUG_PRINT_WK( SCWK_ANSWER )
  _PLAYER_NAME( 0 )
  SWITCH $SCWK_ANSWER
  CASE SCR_PKWD_RESULT_GOOD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_theater_09, SCWK_TARGET_OBJID, POS_DOWN )
  CASE SCR_PKWD_RESULT_BAD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_theater_07, SCWK_TARGET_OBJID, POS_DOWN )
  CASE SCR_PKWD_RESULT_STRANGE_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_theater_08, SCWK_TARGET_OBJID, POS_DOWN )
  ENDSWITCH

  
  //上映済みかチェック（このコマンドで上映済みフラグをONにしているので注意）
  _PKWD_IS_SHOWED_MOVIE( LWK_PKWD_SHOW_REC_POS, SCWK_ANSWER  )
  IF $SCWK_ANSWER == FALSE THEN
    //オーナー登場POSイベント設定
    $LOCALWORK0 = 1
    $LOCALWORK1 = $LWK_PKWD_SHOW_REC_POS
  ELSE
    //オーナー登場POSイベント解除（念のため）
    $LOCALWORK0 = 0
  ENDIF
    $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_GOODBYE
_RET

//==============================================================================
//
//  ポケウッドシアター  オーナー出現イベント
//
//==============================================================================
EVENT_START ev_pos_pkwd_theater_owner_appear
  _CALL ev_pkwd_show_owner_judge

  //オーナー登場POSイベント解除
  $LOCALWORK0 = 0
EVENT_END


/**************************************************************/
//
//
//  オーナーの評価イベント本体
//
//  param[in] LOCALWORK1  上映データの場所
//
//  _OBJ_ADD_EXで動作モデルを生成しているので限界数に注意
//
//
/**************************************************************/
ev_pkwd_show_owner_judge:

  //オーナー出現
  _OBJ_ADD_EX( 15, 31, DIR_UP, MMDL_ID_EVENTOBJ_00, PWOWNER, MV_DMY )
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()

  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_bikkuri )
  _OBJ_ANIME_WAIT()

  //「いやあーちょっと！！～ちゃん！
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_01, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()

  //プレイヤーの位置によりアニメ分岐
  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  SWITCH $LWK_HEROX
  CASE 14 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_appear1 )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_turn_right )
    _OBJ_ANIME_WAIT()
  CASE 15 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_appear2 )
    _OBJ_ANIME_WAIT()
  CASE 16 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_appear3 )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_turn_left )
    _OBJ_ANIME_WAIT()
  ENDSWITCH

  //オーナーから評価メッセージ
  _PLAYER_NAME( 0 )
  _PKWD_GET_MOVIE_VALUE( LOCALWORK1, SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_PKWD_RESULT_GOOD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_04, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  CASE SCR_PKWD_RESULT_BAD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_02, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  CASE SCR_PKWD_RESULT_STRANGE_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_03, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ENDSWITCH

  //出演ポケモンはレンタルか？
  _PKWD_IS_RENTAL_POKE_MOVIE( LOCALWORK1, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    //→手持ちの場合、手持ちポケモンスターランク変化を示唆する
    //「んーそうねー～～ちゃんのポケモンにも何か変化がありそうだね
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_05, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ENDIF
  //「じゃーね！
  _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_06, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()

  //オーナー去っていく
  //プレイヤーの位置によりアニメ分岐
  SWITCH $LWK_HEROX
  CASE 14, 16 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_disappear1 )
  CASE 15 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_disappear2 )
  ENDSWITCH
  _OBJ_ANIME_WAIT()
  //オーナーOBJ削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

_RET

_ANIME_LABEL  anm_owner_bikkuri
  _ANIME_DATA AC_MARK_GYOE, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_owner_appear1
  _ANIME_DATA AC_WALK_U_8F, 5
  _ANIME_DATA AC_STAY_WALK_L_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_owner_appear2
  _ANIME_DATA AC_WALK_U_8F, 4
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_owner_appear3
  _ANIME_DATA AC_WALK_U_8F, 5
  _ANIME_DATA AC_STAY_WALK_R_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_player_turn_right
  _ANIME_DATA AC_STAY_WALK_R_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_player_turn_left
  _ANIME_DATA AC_STAY_WALK_L_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_owner_disappear1
  _ANIME_DATA AC_WALK_U_8F, 9
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_owner_disappear2
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_U_8F, 9
  _ANIME_DATA ACMD_END, 0

//==============================================================================
//
//  上映成績記録モニター
//
//==============================================================================
EVENT_START   ev_pokewood_monitor
{
  DEFINE_LOCAL  flag_total

  // 上映して観たことのある総数を取得
  _PKWD_GET_FLAG_TOTAL( SCR_PKWD_SCENARIO_THEATERGO_FLAG, flag_total )

  // 一度もないなら記録がないのでSKIP
  IF $flag_total > 0 THEN
    _TALK_START_SE_PLAY()
    _PKWD_RECORD_MONITOR( SCWK_ANSWER )

  ELSE
    // 「ただいま こちらの モニターは ちょうせいちゅう です・・・」
    _SYSWIN_MSG( msg_pw__monitor_01, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()
  ENDIF
}
EVENT_END



