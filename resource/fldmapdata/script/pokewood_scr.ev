//                pokewood_scr.ev
//
//    スクリプトファイル：ポケウッド用
//
//    @author tamada GAMEFREAK inc.
//    @date   2011.07.05
//
//==============================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_pokewood_scr.h"
  .include  "pokewood_scr_def.h"

  .include  "c15r0101.h"
  .include  "c15r0201.h"
  .include  "c15r0301.h"

  .include  "pkwd_scr_define.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_pokewood_rec
_EVENT_DATA   ev_pokewood_show
_EVENT_DATA   ev_pokewood_monitor
_EVENT_DATA   ev_zone_pokewood_studio_entrance
_EVENT_DATA_END

//==============================================================================
//
//    初期化スクリプト
//
//==============================================================================
/**************************************************************/
//  zone_change_label
/**************************************************************/
INIT_EVENT_START   ev_zone_pokewood_studio_entrance
  _FLAG_SET( FV_PKWD_STAFF01 )    //出演者・監督非表示
  _FLAG_RESET( FV_PKWD_STAFF02 )  //スタッフ表示
INIT_EVENT_END



//==============================================================================
//
//  ポケウッド  撮影スタジオ
//
//==============================================================================
DEFINE_LOCAL  LWK_PKWD_SEQ
DEFINE_LOCAL  LWK_PKWD_MENU
DEFINE_LOCAL  LWK_PKWD_SCENARIO
DEFINE_LOCAL  LWK_PKWD_REC_POS

DEFINE_LOCAL  LWK_PKWD_REC_COUNT

/**************************************************************/
//    ポケウッド：撮影所受付
/**************************************************************/
EVENT_START ev_pokewood_rec

  _PKWD_SYSTEM_START()

  $LWK_PKWD_SEQ = PKWD_REC_SEQ_FIRST_MENU

  _TALK_OBJ_START()

  //ようこそ！
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_01, SCWK_TARGET_OBJID, POS_DOWN )

  //スターランクが上がったかどうか
  _PKWD_CHECK_NEW_STAR_RANK( SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    //「ヘイ！最近キミは役者らしいイイかおになってきたねー」
    _PLAYER_NAME( 0 )
    _BALLOONWIN_OBJMSG_POS( msg_pw_studio_14, SCWK_TARGET_OBJID, POS_DOWN )
  ENDIF

  //新着シナリオチェック：それにあわせてメッセージ
  _CALL ev_pkwd_check_new_scenario


  WHILE $LWK_PKWD_SEQ != PKWD_REC_SEQ_END

    SWITCH $LWK_PKWD_SEQ
    CASE PKWD_REC_SEQ_FIRST_MENU      THEN
      _CALL ev_pkwd_rec_first_menu

    CASE PKWD_REC_SEQ_SELECT_SCENARIO THEN
      _CALL ev_pkwd_rec_select_scenario

    CASE PKWD_REC_SEQ_SELECT_POKE     THEN
      _CALL ev_pkwd_rec_select_poke

    CASE PKWD_REC_SEQ_SHOOTING        THEN
      _MSGWIN_CLOSE()
      _REPORT_EVENT_CALL( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_REPORT_OK THEN
        _CALL ev_pkwd_rec_go_studio
        _CALL ev_pkwd_rec_studio
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_AFTER
      ELSE
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
      ENDIF

    CASE PKWD_REC_SEQ_AFTER           THEN
      _CALL ev_pkwd_after_rec

    CASE PKWD_REC_SEQ_POKELIST        THEN
      _CALL ev_pkwd_rec_pokelist

    CASE PKWD_REC_SEQ_GOODBYE         THEN
      //「銀幕はいつだって君を待ってるぜ！」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_11, SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //シーケンス終了
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_END

    DEFAULT
      //なにか問題があった場合、とりあえず終了させる
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_END
    ENDSWITCH

  ENDWHILE

  _PKWD_SYSTEM_END()

EVENT_END


/**************************************************************/
/**************************************************************/
ev_pkwd_rec_studio:
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_enter_mat )
  _OBJ_ANIME_WAIT()

  //仮：ここで監督のセリフがある
  //_PKWD_GET_DIRECTOR_TYPE( SCWK_ANSWER )
  $SCWK_ANSWER = 0
  SWITCH $SCWK_ANSWER
  CASE 0 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_01, C15R0101_WKOBJCODE01, POS_DOWN )
  CASE 1 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_02, C15R0101_WKOBJCODE01, POS_DOWN )
  CASE 2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_03, C15R0101_WKOBJCODE01, POS_DOWN )
  CASE 3 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_04, C15R0101_WKOBJCODE01, POS_DOWN )
  CASE 4 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_05, C15R0101_WKOBJCODE01, POS_DOWN )
  ENDSWITCH
  _MSGWIN_CLOSE()

  //ここで撮影アプリ呼び出し
  _PKWD_REC( LWK_PKWD_REC_POS, LWK_PKWD_SCENARIO, SCWK_ANSWER )

  //仮：ここで監督のセリフがある
  //_PKWD_GET_DIRECTOR_TYPE( SCWK_ANSWER )
  $SCWK_ANSWER = 0
  SWITCH $SCWK_ANSWER
  CASE 0 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_01, C15R0101_WKOBJCODE01, POS_DOWN )
  CASE 1 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_02, C15R0101_WKOBJCODE01, POS_DOWN )
  CASE 2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_03, C15R0101_WKOBJCODE01, POS_DOWN )
  CASE 3 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_04, C15R0101_WKOBJCODE01, POS_DOWN )
  CASE 4 THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_director_05, C15R0101_WKOBJCODE01, POS_DOWN )
  ENDSWITCH
  _MSGWIN_CLOSE()

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_exit_studio )
  _OBJ_ANIME_WAIT()
  _MAP_CHANGE( ZONE_ID_C15R0201, 14, 11, DIR_RIGHT )
_RET

_ANIME_LABEL anm_player_enter_mat
  _ANIME_DATA AC_WALK_U_8F, 6
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_player_exit_studio
  _ANIME_DATA AC_WALK_D_8F, 6
  _ANIME_DATA ACMD_END, 0

/**************************************************************/
//  撮影後
/**************************************************************/
ev_pkwd_after_rec:
  _FLAG_SET( FV_PKWD_STAFF01 )    //出演者・監督非表示
  _FLAG_RESET( FV_PKWD_STAFF02 )  //スタッフ表示

  $SCWK_TARGET_OBJID = C15R0201_POKEWOOD_REC

  _OBJ_ANIME( SCWK_TARGET_OBJID, anm_producer_turn_to_player )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_talk_to_producer )
  _OBJ_ANIME_WAIT()

  //公開するかどうかの処理フロー
  _CALL ev_pkwd_rec_save

  IF $SCWK_ANSWER == TRUE THEN

    //シアターへ異動する
    _MAP_CHANGE( ZONE_ID_C15R0301, 9, 11, DIR_UP )
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_END

  ELSE
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE

  ENDIF
_RET

_ANIME_LABEL  anm_producer_turn_to_player
  _ANIME_DATA AC_STAY_WALK_R_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_player_talk_to_producer
  _ANIME_DATA AC_WALK_D_8F, 1
  _ANIME_DATA AC_WALK_L_8F, 1
  _ANIME_DATA ACMD_END, 0

/**************************************************************/
/**************************************************************/
ev_pkwd_rec_first_menu:
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_03, SCWK_TARGET_OBJID, POS_DOWN )
  _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_PKWD_MENU )
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_01, 0 )  //ちょうせんする
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_02, 1 )  //せつめいをきく
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_03, 2 )  //やめる

  _BMPMENU_START()
  SWITCH $LWK_PKWD_MENU
  CASE 0 THEN
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_SELECT_SCENARIO

  CASE 1 THEN
    //説明
    _BALLOONWIN_OBJMSG_POS( msg_pw_studio_04, SCWK_TARGET_OBJID, POS_DOWN )
    _MSGWIN_CLOSE()

  DEFAULT
    //じゃあ、また
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDSWITCH

_RET


/**************************************************************/
/**************************************************************/
ev_pkwd_rec_select_scenario:
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_07, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()
  $LWK_PKWD_SCENARIO = SCR_PKWD_SCENARIO_MAX
  //台本選択アプリを呼び出し
  _PKWD_SELECT_SCENARIO( LWK_PKWD_SCENARIO )

  _DEBUG_PRINT_WK( LWK_PKWD_SCENARIO )
  IF $LWK_PKWD_SCENARIO >= SCR_PKWD_SCENARIO_MAX THEN
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
    _RET
  ENDIF

  //シーケンス：出演ポケモン選択へ
  $LWK_PKWD_SEQ = PKWD_REC_SEQ_SELECT_POKE
_RET


/**************************************************************/
/**************************************************************/
ev_pkwd_rec_select_poke:
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_08, SCWK_TARGET_OBJID, POS_DOWN )
  _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_PKWD_MENU )
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_05, 0 ) //レンタルポケモン
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_04, 1 ) //自分のポケモン
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_03, 2 ) //やめる
  _BMPMENU_START()

  SWITCH $LWK_PKWD_MENU
  CASE 0 THEN
    //「OK!この作品にぴったりのポケモンを手配しとくぜ！」
    _BALLOONWIN_OBJMSG_POS( msg_pw_studio_10, SCWK_TARGET_OBJID, POS_DOWN )
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_SHOOTING
    _PKWD_SET_JOIN_MYPOKE( FALSE )	// レンタルポケモンで参加
  CASE 1 THEN
    _PKWD_GET_SCENARIO_STATUS( SCR_PKWD_SCENARIO_SUCCESS_FLAG, LWK_PKWD_SCENARIO, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_POKELIST
      _PKWD_SET_JOIN_MYPOKE( TRUE )	// 自分の手持ちポケモンをだす
    ELSE
      //「SORRY！」出れない旨のメッセージ
      _PLAYER_NAME( 0 )
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_15, SCWK_TARGET_OBJID, POS_DOWN )
    ENDIF
  DEFAULT
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDSWITCH
  
_RET

/**************************************************************/
/**************************************************************/
ev_pkwd_rec_go_studio:
  //「OK!じゃあ撮影を始めようか！」
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_12, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()

  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 14, 12, FALSE, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_studio )
  _OBJ_ANIME_WAIT()

  //仮：ここで監督・共演者のOBJを設定
  _PKWD_SET_STUDIO_MMDL( LWK_PKWD_SCENARIO, OBJCHRWORK0, OBJCHRWORK1 )
  _FLAG_RESET( FV_PKWD_STAFF01 )  //出演者・監督　表示
  _FLAG_SET( FV_PKWD_STAFF02 )    //スタッフ非表示
  _MAP_CHANGE( ZONE_ID_C15R0101, 15, 16, DIR_UP )

_RET

_ANIME_LABEL  anm_player_go_studio
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

/**************************************************************/
// ポケウッド：映画を公開するか
/**************************************************************/
ev_pkwd_rec_save:
{
  DEFINE_LOCAL  LWK_PKWD_SUBSEQ
  DEFINE_LOCAL  LWK_PKWD_SUBSEQ_RESULT

  //_PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )

  $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_PLAY
  WHILE $LWK_PKWD_SUBSEQ != PKWD_REC_SUBSEQ_END

    SWITCH $LWK_PKWD_SUBSEQ
    CASE PKWD_REC_SUBSEQ_ASK_PLAY THEN
      //「やー撮影お疲れ！」「シアターで公開するかい？」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_13, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_YES THEN
        _PKWD_GET_MOVIE_COUNT( LWK_PKWD_REC_COUNT )
        IF $LWK_PKWD_REC_COUNT == SCR_PKWD_MOVIE_MAX THEN
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_DELETE
        ELSE
          //空きを探してその位置に書き込む
          _CALL ev_pkwd_get_empty_pos
          _MSGWIN_CLOSE()
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_REC
        ENDIF
      ELSE
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_NOT_PLAY
      ENDIF

    CASE PKWD_REC_SUBSEQ_ASK_NOT_PLAY THEN
      //「本当に公開しなくてもかまわないか？」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_17, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_YES THEN
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_END
        $LWK_PKWD_SUBSEQ_RESULT = FALSE
      ELSE
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_PLAY
      ENDIF

    CASE PKWD_REC_SUBSEQ_ASK_DELETE THEN
      //「WAO!今公開中のスクリーンが一杯だぜ！」「終了させるか？」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_05, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_YES THEN
        //「OK!じゃあ公開を終了する作品を決めてくれ！」
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_06, SCWK_TARGET_OBJID, POS_DOWN )
        _MSGWIN_CLOSE()
        //上映選択へ
        _PKWD_SELECT_MOVIE( SCR_PKWD_SELECT_MODE_DELETE, LWK_PKWD_REC_POS )

        IF $LWK_PKWD_REC_POS == SCR_PKWD_MOVIE_MAX THEN
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_NOT_PLAY
        ELSE
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_REC
        ENDIF
      ELSE
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_NOT_PLAY
      ENDIF

    CASE PKWD_REC_SUBSEQ_REC THEN
      //_MSGWIN_CLOSE()
      //セーブ中警告
      _SYSWIN_MSG_ALLPUT( msg_pw_system_01, POS_DOWN )
      //仮：セーブ処理を呼び出し
      _DEBUG_PRINT_WK( LWK_PKWD_REC_POS )
      _PKWD_SAVE_MOVIE( LWK_PKWD_REC_POS )
      _MSGWIN_CLOSE()
      _SE_PLAY( SEQ_SE_SAVE )
      $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_GO

    CASE PKWD_REC_SUBSEQ_ASK_GO THEN
      //「出来が気になるだろ?今すぐシアターに行くかい？」
      _PLAYER_NAME( 0 )
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_18, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_YES THEN
        _MSGWIN_CLOSE()
        //暗転～シアター受付前にジャンプ
        $LWK_PKWD_SUBSEQ_RESULT = TRUE
      ELSE
        $LWK_PKWD_SUBSEQ_RESULT = FALSE
      ENDIF
      $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_END

    DEFAULT
      $LWK_PKWD_SUBSEQ_RESULT = FALSE
    ENDSWITCH
  ENDWHILE

  $SCWK_ANSWER = $LWK_PKWD_SUBSEQ_RESULT
}
_RET

/**************************************************************/
// ポケウッド：ポケモンリスト呼び出し
/**************************************************************/
ev_pkwd_rec_pokelist:
  //「OK!OK!じゃあ作品に出演するポケモンを決めてくれ！」
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_09, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()
  _PKWD_SELECT_POKEMON( SCWK_ANSWER )
  IF $SCWK_ANSWER ==FALSE THEN
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
    _RET
  ENDIF
  $LWK_PKWD_SEQ = PKWD_REC_SEQ_SHOOTING

_RET

//--------------------------------------------------------------
//  録画データが入っていない場所を探す
//--------------------------------------------------------------
ev_pkwd_get_empty_pos:
  $LWK_PKWD_REC_POS = 0
  _PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    _RET
  ENDIF
  $LWK_PKWD_REC_POS = 1
  _PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    _RET
  ENDIF
  $LWK_PKWD_REC_POS = 2
  _PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    _RET
  ENDIF
  $LWK_PKWD_REC_POS = 3
  _PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    _RET
  ENDIF
  $LWK_PKWD_REC_POS = SCR_PKWD_MOVIE_MAX
  _RET
  
//--------------------------------------------------------------
//  新着台本チェック
//--------------------------------------------------------------
ev_pkwd_check_new_scenario:
{
  DEFINE_LOCAL  LWK_PKWD_ADDMSG_TYPE

  $LWK_PKWD_SCENARIO = 0
  WHILE $LWK_PKWD_SCENARIO < SCR_PKWD_SCENARIO_MAX
    _PKWD_CHECK_NEW_SCENARIO( LWK_PKWD_SCENARIO, LWK_PKWD_ADDMSG_TYPE, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _PLAYER_NAME( 0 )
      _PKWD_SET_SCENARIO_NAME( 1, LWK_PKWD_SCENARIO )  //シナリオ名セット
      SWITCH $LWK_PKWD_ADDMSG_TYPE
      CASE SCR_PKWD_ADDMSG_GOOD_END THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_02, SCWK_TARGET_OBJID, POS_DOWN ) //仮
      CASE SCR_PKWD_ADDMSG_GAMECLEAR THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_02, SCWK_TARGET_OBJID, POS_DOWN ) //仮
      CASE SCR_PKWD_ADDMSG_STARRANK THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_02, SCWK_TARGET_OBJID, POS_DOWN ) //仮
      CASE SCR_PKWD_ADDMSG_PROFITS THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_02, SCWK_TARGET_OBJID, POS_DOWN ) //仮
      CASE SCR_PKWD_ADDMSG_ALL_GOOD_END THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_02, SCWK_TARGET_OBJID, POS_DOWN ) //仮
      ENDSWITCH
    ENDIF
    $LWK_PKWD_SCENARIO += 1
  ENDWHILE

}
_RET

//==============================================================================
//
//    ポケウッド  シアター
//
//==============================================================================
/**************************************************************/
//    ポケウッド：上映受付
/**************************************************************/

DEFINE_LOCAL  LWK_PKWD_SHOW_SEQ
DEFINE_LOCAL  LWK_PKWD_SHOW_MENU
DEFINE_LOCAL  LWK_PKWD_SHOW_LOOP
DEFINE_LOCAL  LWK_PKWD_SHOW_REC_POS
DEFINE_LOCAL  LWK_PKWD_SHOW_REC_COUNT
DEFINE_LOCAL  LWK_PKWD_SHOW_NEW_RELEASED

EVENT_START ev_pokewood_show

  _TALK_OBJ_START()

  _PKWD_SYSTEM_START()

  $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_FIRST_MENU

  WHILE $LWK_PKWD_SHOW_SEQ != PKWD_SHOW_SEQ_END

    SWITCH $LWK_PKWD_SHOW_SEQ
    CASE PKWD_SHOW_SEQ_GOODBYE      THEN
      //「それでは　またのお越しをお待ちしております」
      _BALLOONWIN_OBJMSG_POS( msg_pw_theater_06, SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_END

    CASE PKWD_SHOW_SEQ_FIRST_MENU   THEN
      _CALL ev_pkwd_show_first_menu

    CASE PKWD_SHOW_SEQ_SELECT_MOVIE THEN
      _CALL ev_pkwd_show_select_movie

    CASE PKWD_SHOW_SEQ_WATCH_MOVIE  THEN
      _CALL ev_pkwd_show_watch_movie

    CASE PKWD_SHOW_SEQ_AFTER        THEN
      _CALL ev_pkwd_show_after
      //_PKWD_IS_NEWLY_RELEASED_MOVIE( LWK_PKWD_SHOW_REC_POS, SCWK_ANSWER )
      IF $LWK_PKWD_SHOW_NEW_RELEASED == TRUE THEN
        $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_JUDGE_NPC
      ELSE
        $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_GOODBYE
      ENDIF

    CASE PKWD_SHOW_SEQ_JUDGE_NPC    THEN
      _CALL ev_pkwd_show_judge_npc
      $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_END

    DEFAULT
      $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_END

    ENDSWITCH

  ENDWHILE

  _PKWD_SYSTEM_END()

EVENT_END


/**************************************************************/
//  選択メニュー
/**************************************************************/
ev_pkwd_show_first_menu:

  $LWK_PKWD_SHOW_LOOP = TRUE

  WHILE $LWK_PKWD_SHOW_LOOP == TRUE
    _BALLOONWIN_OBJMSG_POS( msg_pw_theater_01, SCWK_TARGET_OBJID, POS_DOWN )
    _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_PKWD_SHOW_MENU )
    _BMPMENU_MAKE_LIST( msg_pw_theater_menu_06, 0 )  //えいがをみる
    _BMPMENU_MAKE_LIST( msg_pw_theater_menu_07, 1 )  //せつめいをきく
    _BMPMENU_MAKE_LIST( msg_pw_theater_menu_08, 2 )  //やめる
    _BMPMENU_START()

    SWITCH $LWK_PKWD_SHOW_MENU
    CASE 0 THEN
      _PKWD_GET_MOVIE_COUNT( LWK_PKWD_SHOW_REC_COUNT )
      IF $LWK_PKWD_SHOW_REC_COUNT == 0 THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_theater_04, SCWK_TARGET_OBJID, POS_DOWN )
        $LWK_PKWD_SHOW_LOOP = FALSE
        $LWK_PKWD_SHOW_SEQ  = PKWD_SHOW_SEQ_GOODBYE
      ELSE
        $LWK_PKWD_SHOW_LOOP = FALSE
        $LWK_PKWD_SHOW_SEQ  = PKWD_SHOW_SEQ_SELECT_MOVIE
      ENDIF

    CASE 1 THEN
      _BALLOONWIN_OBJMSG_POS( msg_pw_theater_02, SCWK_TARGET_OBJID, POS_DOWN )

    DEFAULT
      $LWK_PKWD_SHOW_LOOP = FALSE
      $LWK_PKWD_SHOW_SEQ  = PKWD_SHOW_SEQ_GOODBYE

    ENDSWITCH
  ENDWHILE
_RET

/**************************************************************/
//
/**************************************************************/
ev_pkwd_show_select_movie:
  //「それでは　ご覧になりたい作品を選んでください」
  _BALLOONWIN_OBJMSG_POS( msg_pw_theater_03, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()
  //上映選択へ
  _PKWD_SELECT_MOVIE( SCR_PKWD_SELECT_MODE_NORMAL, LWK_PKWD_SHOW_REC_POS )

  IF $LWK_PKWD_SHOW_REC_POS == SCR_PKWD_MOVIE_MAX THEN
    //「それでは　またのお越しをお待ちしております」
    $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_GOODBYE
  ELSE
    //映画鑑賞へ
    $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_WATCH_MOVIE
  ENDIF
_RET


/**************************************************************/
//
/**************************************************************/
ev_pkwd_show_watch_movie:
  //「それでは　まもなく上映です」
  _BALLOONWIN_OBJMSG_POS( msg_pw_theater_05, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()

  //スクリーンに入る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_in_theater )
  _OBJ_ANIME_WAIT()

  _PKWD_IS_NEWLY_RELEASED_MOVIE( LWK_PKWD_SHOW_REC_POS, LWK_PKWD_SHOW_NEW_RELEASED )
  //上映呼び出し
  _PKWD_SHOW( LWK_PKWD_SHOW_REC_POS )

  //スクリーンから出てくる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_out_theater )
  _OBJ_ANIME_WAIT()

  $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_AFTER
_RET

_ANIME_LABEL  anm_player_go_in_theater
  _ANIME_DATA AC_WALK_R_8F, 6
  _ANIME_DATA AC_WALK_U_8F, 3
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_out_theater
  _ANIME_DATA AC_WALK_D_8F, 3
  _ANIME_DATA AC_WALK_L_8F, 6
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0


/**************************************************************/
//
/**************************************************************/
ev_pkwd_show_after:
  _PKWD_GET_MOVIE_VALUE( LWK_PKWD_SHOW_REC_POS, SCWK_ANSWER )
  _DEBUG_PRINT_WK( SCWK_ANSWER )
  //評価が決まっていないため暫定
  SWITCH $SCWK_ANSWER
  CASE SCR_PKWD_RESULT_GOOD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_theater_07, SCWK_TARGET_OBJID, POS_DOWN )
  CASE SCR_PKWD_RESULT_BAD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_theater_08, SCWK_TARGET_OBJID, POS_DOWN )
  CASE SCR_PKWD_RESULT_STRANGE_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_theater_09, SCWK_TARGET_OBJID, POS_DOWN )
  ENDSWITCH

_RET

/**************************************************************/
//
/**************************************************************/
ev_pkwd_show_judge_npc:
//仮
  _OBJ_ADD_EX( 14, 18, DIR_UP, MMDL_ID_EVENTOBJ_00, DANPEI, MV_DMY )
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_commentator_appear )
  _OBJ_ANIME_WAIT()
  _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_01, MMDL_ID_EVENTOBJ_00, POS_DOWN )

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_turn_right )
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_commentator_close )
  _OBJ_ANIME_WAIT()

  _PKWD_GET_MOVIE_VALUE( LWK_PKWD_SHOW_REC_POS, SCWK_ANSWER )
  _PLAYER_NAME( 0 )
  SWITCH $SCWK_ANSWER
  CASE SCR_PKWD_RESULT_GOOD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_04, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  CASE SCR_PKWD_RESULT_BAD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_02, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  CASE SCR_PKWD_RESULT_STRANGE_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_03, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ENDSWITCH

  _PKWD_IS_RENTAL_POKE_MOVIE( LWK_PKWD_SHOW_REC_POS, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_05, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ENDIF
  _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_06, MMDL_ID_EVENTOBJ_00, POS_DOWN )

  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_commentator_disappear )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

_RET

_ANIME_LABEL  anm_commentator_appear
  _ANIME_DATA AC_WALK_U_8F, 7
  _ANIME_DATA AC_MARK_GYOE, 1
  _ANIME_DATA AC_STAY_WALK_L_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_commentator_close
  _ANIME_DATA AC_WALK_L_16F, 4
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_player_turn_right
  _ANIME_DATA AC_STAY_WALK_R_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_commentator_disappear
  _ANIME_DATA AC_WALK_D_8F, 9
  _ANIME_DATA ACMD_END, 0

//==============================================================================
//
//  上映成績記録モニター
//
//==============================================================================
EVENT_START   ev_pokewood_monitor
EVENT_END



