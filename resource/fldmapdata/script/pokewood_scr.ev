  .text

  .include  "scr_seq_def.h"
  .include  "msg_pokewood_scr.h"
  .include  "pokewood_scr_def.h"

  .include  "c15r0101.h"
  .include  "c15r0201.h"
  //.include  "c15r0301.h"

  .include  "pkwd_scr_define.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_pkwd_entrance
_EVENT_DATA   ev_init_pkwd_entrance
_EVENT_DATA   ev_pokewood_rec
_EVENT_DATA   ev_pos_pkwd_entrance_tutorial_stopper
_EVENT_DATA   ev_reserve_pkwd_entrance_tutorial
_EVENT_DATA   ev_pkwd_tutorial_pwowner_01
_EVENT_DATA   ev_pkwd_tutorial_pwstaff_02
_EVENT_DATA   ev_pkwd_tutorial_hachiku_01
_EVENT_DATA_END

//==============================================================================
//
/*
  C15R0301:シアターでのローカルワーク使途
    LOCALWORK0  1のとき初上映でのオーナー出現イベント発生
    LOCALWORK1  上記イベントでの上映データ位置を記録

  C15R0201:撮影スタジオエントランスでのローカルワーク使途
    LOCALWORK0  1のときチュートリアルイベントでのストッパー発生
*/
//==============================================================================

//==============================================================================
//
//    初期化スクリプト
//
//==============================================================================
/**************************************************************/
//  zone_change_label
/**************************************************************/
INIT_EVENT_START   ev_zone_pkwd_entrance
  _FLAG_SET( FV_PKWD_STAFF01 )    //出演者・監督非表示
  _FLAG_RESET( FV_PKWD_STAFF02 )  //スタッフ表示
  //チュートリアルモード時の制御
  IF FLAG_ON( SYS_FLAG_POKEWOOD_TUTORIAL ) THEN
    _FLAG_RESET( FV_PKWD_STAFF_TUTORIAL01 )
    _FLAG_RESET( FV_PKWD_STAFF_TUTORIAL02 )
  ELSE
    _FLAG_SET( FV_PKWD_STAFF_TUTORIAL01 )
    _FLAG_SET( FV_PKWD_STAFF_TUTORIAL02 )
  ENDIF
INIT_EVENT_END

/**************************************************************/
//  field_init_label
/**************************************************************/
INIT_EVENT_START  ev_init_pkwd_entrance
  IF FLAG_ON( SYS_FLAG_POKEWOOD_TUTORIAL ) THEN
    $LOCALWORK0 = 1
  ELSE
    $LOCALWORK0 = 0
  ENDIF

  //ガードマンどかす
  IF FLAG_ON( FE_C15R0401_GUARDMAN ) THEN
    _OBJ_POS_CHANGE( C15R0201_POLICEMAN_02, 2, 3, 7, DIR_RIGHT )
  ENDIF

INIT_EVENT_END

//==============================================================================
//
//  ポケウッド  撮影スタジオ
//
//==============================================================================
DEFINE_LOCAL  LWK_PKWD_SEQ
DEFINE_LOCAL  LWK_PKWD_MENU
DEFINE_LOCAL  LWK_PKWD_SCENARIO
DEFINE_LOCAL  LWK_PKWD_REC_LOOP
DEFINE_LOCAL  LWK_PKWD_REC_POS
DEFINE_LOCAL  LWK_PKWD_DIRECTOR

DEFINE_LOCAL  LWK_PKWD_REC_COUNT
DEFINE_LOCAL  LWK_HEROX
DEFINE_LOCAL  LWK_HEROZ


/**************************************************************/
//    ポケウッド：撮影所受付
/**************************************************************/
EVENT_START ev_pokewood_rec

  _PKWD_SYSTEM_START()

  $LWK_PKWD_SEQ = PKWD_REC_SEQ_FIRST_MENU

  _TALK_OBJ_START()

  //ようこそ！
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_01, SCWK_TARGET_OBJID, POS_DOWN )

  //スターランクが上がったかどうか
  _PKWD_CHECK_NEW_STAR_RANK( SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    //「ヘイ！最近キミは役者らしいイイかおになってきたねー」
    _PLAYER_NAME( 0 )
    _BALLOONWIN_OBJMSG_POS( msg_pw_studio_14, SCWK_TARGET_OBJID, POS_DOWN )
    _ME_PLAY(	SEQ_ME_KEYITEM )  //仮：
    _ME_WAIT()
    _AB_KEYWAIT_MARK()
  ENDIF

  //新着シナリオチェック：それにあわせてメッセージ
  _CALL ev_pkwd_check_new_scenario


  WHILE $LWK_PKWD_SEQ != PKWD_REC_SEQ_END

    SWITCH $LWK_PKWD_SEQ
    CASE PKWD_REC_SEQ_FIRST_MENU      THEN
      _CALL ev_pkwd_rec_first_menu

    CASE PKWD_REC_SEQ_SELECT_SCENARIO THEN
      IF FLAG_ON( SYS_FLAG_POKEWOOD_TUTORIAL ) THEN
        $LWK_PKWD_SCENARIO = 0  //「ハチクマン1」を指定する
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_SELECT_POKE
      ELSE
        _CALL ev_pkwd_rec_select_scenario
      ENDIF

    CASE PKWD_REC_SEQ_SELECT_POKE     THEN
      _CALL ev_pkwd_rec_select_poke

    CASE PKWD_REC_SEQ_POKELIST        THEN
      _CALL ev_pkwd_rec_pokelist

    CASE PKWD_REC_SEQ_SHOOTING        THEN
      _REPORT_EVENT_CALL( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_REPORT_OK THEN
        //JA履歴への対応：ポケウッドで映画を撮った
        _RESORT_SET_RECORD( RESORT_RECORD_ID_POKEWOOD )
	//すれちがいログで「●●撮影中」と告知
	_BEACON_SET_REQ_POKEWOOD_FILMING( LWK_PKWD_SCENARIO )
        _CALL ev_pkwd_rec_go_studio
        _CALL ev_pkwd_rec_studio
        _CALL ev_pkwd_rec_exit_studio
      ELSE
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
      ENDIF

    CASE PKWD_REC_SEQ_AFTER           THEN
      _CALL ev_pkwd_after_rec

    CASE PKWD_REC_SEQ_ASK_GO_THEATER  THEN
      IF FLAG_ON( SYS_FLAG_POKEWOOD_TUTORIAL ) THEN
        //強制的にここからシアター前イベント→シアター内のイベントへ
        _CALL ev_pkwd_tutorial_go_theater
        //チュートリアルモードのフラグをOFFにする
        _FLAG_RESET( SYS_FLAG_POKEWOOD_TUTORIAL )
        //メダルヒント開示：すべての映画を撮った
        _SET_MEDAL_HINT_ACHIEVE( MDLID_PKWD_SERIES_ALL )
        //メダルヒント開示：興行収入が一定以上
        _SET_MEDAL_HINT_ACHIEVE( MDLID_PKWD_BOXOFFICE )
        //メダルヒント開示：初めてストレンジエンドをとった
        _SET_MEDAL_HINT_ACHIEVE( MDLID_PKWD_STRANGE_FIRST )
        //イベント全体終了へ
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_END
      ELSE
        _CALL ev_pkwd_rec_ask_go_theater
      ENDIF

    CASE PKWD_REC_SEQ_GOODBYE         THEN
      //「銀幕はいつだって君を待ってるぜ！」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_11, SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //シーケンス終了
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_END

    DEFAULT
      //なにか問題があった場合、とりあえず終了させる
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_END
    ENDSWITCH

  ENDWHILE

  _PKWD_SYSTEM_END()

EVENT_END


/**************************************************************/
//  スタジオ内イベント
/**************************************************************/
ev_pkwd_rec_studio:

  //
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_enter_mat )
  _OBJ_ANIME_WAIT()


  $LWK_PKWD_REC_LOOP = TRUE

  WHILE $LWK_PKWD_REC_LOOP == TRUE

    //監督のセリフ：撮影開始
    $SCWK_ANSWER = msg_pw_director_01
    _CALL sub_director_talk
    _MSGWIN_CLOSE()

    //ここで撮影アプリ呼び出し
    _PKWD_REC( LWK_PKWD_REC_POS, LWK_PKWD_SCENARIO, SCWK_ANSWER )

    _DEBUG_PRINT_WK( SCWK_ANSWER )
    IF $SCWK_ANSWER == FALSE THEN
      //監督のセリフ：もう一度撮影するか？
      $SCWK_ANSWER = msg_pw_studio_23
      _CALL sub_director_talk
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER != SCR_YES THEN
        //→「いいえ」：もう一度（なにも変更していない）
      ELSE
        //→「はい」：シーケンス終了へ
        _MSGWIN_CLOSE()
        $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
        //このループを抜ける
        $LWK_PKWD_REC_LOOP = FALSE
      ENDIF
    ELSE
      //監督のセリフ：撮影完了
      $SCWK_ANSWER = msg_pw_director_06
      _CALL sub_director_talk
      _MSGWIN_CLOSE()
      //シーケンス：撮影後処理（セーブ）へ
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_AFTER
      //このループを抜ける
      $LWK_PKWD_REC_LOOP = FALSE
    ENDIF
  ENDWHILE

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_exit_studio )
  _OBJ_ANIME_WAIT()

  //撮影所エントランス、受付の人の目の前に移動
  _MAP_CHANGE( ZONE_ID_C15R0201, 14, 11, DIR_DOWN )

_RET

_ANIME_LABEL anm_player_enter_mat
  _ANIME_DATA AC_WALK_U_8F, 6
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_player_exit_studio
  _ANIME_DATA AC_WALK_D_8F, 6
  _ANIME_DATA ACMD_END, 0

sub_director_talk:
  _PKWD_GET_DIRECTOR_TYPE( LWK_PKWD_SCENARIO, LWK_PKWD_DIRECTOR )
  $SCWK_ANSWER += $LWK_PKWD_DIRECTOR
  _BALLOONWIN_OBJMSG_POS( SCWK_ANSWER, C15R0101_WKOBJCODE01, POS_DOWN )
_RET

/**************************************************************/
//  撮影後 撮影エントランス
/**************************************************************/
ev_pkwd_after_rec:
  $SCWK_TARGET_OBJID = C15R0201_PWSTAFF_01

  //公開するかどうかの処理フロー
  _CALL ev_pkwd_rec_save

  IF $SCWK_ANSWER == TRUE THEN
    //→公開する（セーブした）：シアターに移動するか訪ねる
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_ASK_GO_THEATER
  ELSE
    //→公開しない（セーブしなかった）：終了
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDIF

_RET

/**************************************************************/
/**************************************************************/
ev_pkwd_rec_first_menu:
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_03, SCWK_TARGET_OBJID, POS_DOWN )
  _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_PKWD_MENU )
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_01, 0 )  //ちょうせんする
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_02, 1 )  //せつめいをきく
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_03, 2 )  //やめる

  _BMPMENU_START()
  SWITCH $LWK_PKWD_MENU
  CASE 0 THEN
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_SELECT_SCENARIO

  CASE 1 THEN
    //説明
    _BALLOONWIN_OBJMSG_POS( msg_pw_studio_04, SCWK_TARGET_OBJID, POS_DOWN )
    _MSGWIN_CLOSE()

  DEFAULT
    //じゃあ、また
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDSWITCH

_RET


/**************************************************************/
/**************************************************************/
ev_pkwd_rec_select_scenario:
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_07, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()
  $LWK_PKWD_SCENARIO = SCR_PKWD_SCENARIO_MAX
  //台本選択アプリを呼び出し
  _PKWD_SELECT_SCENARIO( LWK_PKWD_SCENARIO )

  _DEBUG_PRINT_WK( LWK_PKWD_SCENARIO )
  IF $LWK_PKWD_SCENARIO >= SCR_PKWD_SCENARIO_MAX THEN
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
    _RET
  ENDIF

  //シーケンス：出演ポケモン選択へ
  $LWK_PKWD_SEQ = PKWD_REC_SEQ_SELECT_POKE
_RET


/**************************************************************/
/**************************************************************/
ev_pkwd_rec_select_poke:
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_08, SCWK_TARGET_OBJID, POS_DOWN )
  _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_PKWD_MENU )
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_05, 0 ) //レンタルポケモン
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_04, 1 ) //自分のポケモン
  _BMPMENU_MAKE_LIST( msg_pw_studio_sel_03, 2 ) //やめる
  _BMPMENU_START()

  SWITCH $LWK_PKWD_MENU
  CASE 0 THEN
    //「OK!この作品にぴったりのポケモンを手配しとくぜ！」
    _BALLOONWIN_OBJMSG_POS( msg_pw_studio_10, SCWK_TARGET_OBJID, POS_DOWN )
    _MSGWIN_CLOSE()
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_SHOOTING
    _PKWD_SET_JOIN_MYPOKE( FALSE )	// レンタルポケモンで参加
  CASE 1 THEN
    _PKWD_GET_SCENARIO_STATUS( SCR_PKWD_SCENARIO_SUCCESS_FLAG, LWK_PKWD_SCENARIO, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      $LWK_PKWD_SEQ = PKWD_REC_SEQ_POKELIST
      _PKWD_SET_JOIN_MYPOKE( TRUE )	// 自分の手持ちポケモンをだす
    ELSE
      //「SORRY！」出れない旨のメッセージ
      _PLAYER_NAME( 0 )
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_15, SCWK_TARGET_OBJID, POS_DOWN )
    ENDIF
  DEFAULT
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDSWITCH
  
_RET

/**************************************************************/
// ポケウッド：ポケモンリスト呼び出し
/**************************************************************/
ev_pkwd_rec_pokelist:
  //「OK!OK!じゃあ作品に出演するポケモンを決めてくれ！」
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_09, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()
  _PKWD_SELECT_POKEMON( SCWK_ANSWER )
  IF $SCWK_ANSWER ==FALSE THEN
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
    _RET
  ENDIF
  $LWK_PKWD_SEQ = PKWD_REC_SEQ_SHOOTING

_RET

/**************************************************************/
//  スタジオへの入室処理
/**************************************************************/
ev_pkwd_rec_go_studio:
  //フェスミッション強制終了処理
  _FMISSION_END_FORCE()

  //「OK!じゃあ撮影を始めようか！」
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_12, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()

  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  SWITCH $LWK_HEROX
  CASE 12 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_studio1 )
  CASE 13 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_studio2 )
  CASE 14 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_studio3 )
  ENDSWITCH
  _OBJ_ANIME_WAIT()

  //ここで監督・共演者のOBJを設定
  _PKWD_SET_STUDIO_MMDL( LWK_PKWD_SCENARIO, OBJCHRWORK0, OBJCHRWORK1 )
  _FLAG_RESET( FV_PKWD_STAFF01 )  //出演者・監督　表示
  _FLAG_SET( FV_PKWD_STAFF02 )    //スタッフ非表示
  _FLAG_SET( FV_PKWD_STAFF_TUTORIAL01 ) //チュートリアル時のハチク非表示
  _MAP_CHANGE( ZONE_ID_C15R0101, 15, 16, DIR_UP )

_RET

_ANIME_LABEL  anm_player_go_studio1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_R_8F,2
  _ANIME_DATA AC_WALK_U_8F,2
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_studio2
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_WALK_U_8F,2
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_studio3
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

/**************************************************************/
//  スタジオからの退出処理
/**************************************************************/
ev_pkwd_rec_exit_studio:
  _FLAG_SET( FV_PKWD_STAFF01 )    //出演者・監督非表示
  _FLAG_RESET( FV_PKWD_STAFF02 )  //スタッフ表示

  _OBJ_ANIME( C15R0201_PWSTAFF_01, anm_producer_turn_to_player )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_talk_to_producer )
  _OBJ_ANIME_WAIT()
_RET

_ANIME_LABEL  anm_producer_turn_to_player
  _ANIME_DATA AC_STAY_WALK_R_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_player_talk_to_producer
  _ANIME_DATA AC_WALK_D_8F, 1
  _ANIME_DATA AC_STAY_WALK_L_8F, 1
  _ANIME_DATA ACMD_END, 0


/**************************************************************/
// ポケウッド：映画を公開するか
/**************************************************************/
ev_pkwd_rec_save:
{
  DEFINE_LOCAL  LWK_PKWD_SUBSEQ
  DEFINE_LOCAL  LWK_PKWD_SUBSEQ_RESULT

  $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_PLAY
  $LWK_PKWD_SUBSEQ_RESULT = FALSE

  WHILE $LWK_PKWD_SUBSEQ != PKWD_REC_SUBSEQ_END

    SWITCH $LWK_PKWD_SUBSEQ
    CASE PKWD_REC_SUBSEQ_ASK_PLAY THEN
      //「やー撮影お疲れ！」「シアターで公開するかい？」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_13, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER != SCR_YES THEN
        //→「いいえ」
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_NOT_PLAY
      ELSE
        //→「はい」
        _PKWD_GET_MOVIE_COUNT( LWK_PKWD_REC_COUNT )
        IF $LWK_PKWD_REC_COUNT == SCR_PKWD_MOVIE_MAX THEN
          //→上映データが一杯！
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_DELETE
        ELSE
          //→上映データに空きがある
          //空きを探してその位置に書き込む
          _CALL ev_pkwd_get_empty_pos
          _MSGWIN_CLOSE()
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_REC
        ENDIF
      ENDIF

    CASE PKWD_REC_SUBSEQ_ASK_NOT_PLAY THEN
      //「本当に公開しなくてもかまわないか？」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_17, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_YES THEN
        //→「はい」
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_END
        $LWK_PKWD_SUBSEQ_RESULT = FALSE
      ELSE
        //→「いいえ」
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_PLAY
      ENDIF

    CASE PKWD_REC_SUBSEQ_ASK_DELETE THEN
      //「WAO!今公開中のスクリーンが一杯だぜ！」「終了させるか？」
      _BALLOONWIN_OBJMSG_POS( msg_pw_studio_05, SCWK_TARGET_OBJID, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_YES THEN
        //→「はい」
        //「OK!じゃあ公開を終了する作品を決めてくれ！」
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_06, SCWK_TARGET_OBJID, POS_DOWN )
        _MSGWIN_CLOSE()
        //上映選択へ
        _PKWD_SELECT_MOVIE( SCR_PKWD_SELECT_MODE_DELETE, LWK_PKWD_REC_POS )
        IF $LWK_PKWD_REC_POS == SCR_PKWD_MOVIE_MAX THEN
          //→キャンセル
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_NOT_PLAY
        ELSE
          //→どれかを選択
          $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_REC
        ENDIF
      ELSE
        //→「いいえ」
        $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_ASK_NOT_PLAY
      ENDIF

    CASE PKWD_REC_SUBSEQ_REC THEN
      //仮：セーブ中警告
      _SYSWIN_MSG_ALLPUT( msg_pw_system_01, POS_DOWN )
      //セーブ処理を呼び出し
      _DEBUG_PRINT_WK( LWK_PKWD_REC_POS )
      _PKWD_SAVE_MOVIE( LWK_PKWD_REC_POS )
      _MSGWIN_CLOSE()
      _SE_PLAY( SEQ_SE_SAVE )
      $LWK_PKWD_SUBSEQ_RESULT = TRUE
      $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_END

    DEFAULT
      //万が一の場合に無限ループを防ぐためのコード
      $LWK_PKWD_SUBSEQ_RESULT = FALSE
      $LWK_PKWD_SUBSEQ = PKWD_REC_SUBSEQ_END
    ENDSWITCH
  ENDWHILE

  $SCWK_ANSWER = $LWK_PKWD_SUBSEQ_RESULT
}
_RET

/**************************************************************/
//  ポケウッド撮影：  撮影後シアターに移動するか？
/**************************************************************/
ev_pkwd_rec_ask_go_theater:
  //「出来が気になるだろ?今すぐシアターに行くかい？」
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_pw_studio_18, SCWK_TARGET_OBJID, POS_DOWN )
  _YES_NO_WIN( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_YES THEN
    //→「はい」
    _MSGWIN_CLOSE()
    //シアターへ異動する
    _MAP_CHANGE( ZONE_ID_C15R0301, 9, 11, DIR_UP )
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_END
  ELSE
    //→「いいえ」
    $LWK_PKWD_SEQ = PKWD_REC_SEQ_GOODBYE
  ENDIF
_RET

//--------------------------------------------------------------
//  録画データが入っていない場所を探す
//--------------------------------------------------------------
ev_pkwd_get_empty_pos:
  $LWK_PKWD_REC_POS = 0

  WHILE $LWK_PKWD_REC_POS < SCR_PKWD_MOVIE_MAX
    _PKWD_CHECK_MOVIE_ENABLE( LWK_PKWD_REC_POS, SCWK_ANSWER )
    IF $SCWK_ANSWER == FALSE THEN
      _RET
    ENDIF
    $LWK_PKWD_REC_POS += 1
  ENDWHILE

_RET
  
//--------------------------------------------------------------
//  新着台本チェック
//--------------------------------------------------------------
ev_pkwd_check_new_scenario:
{
  DEFINE_LOCAL  LWK_PKWD_ADDMSG_TYPE

  $LWK_PKWD_SCENARIO = 0
  WHILE $LWK_PKWD_SCENARIO < SCR_PKWD_SCENARIO_MAX
    _PKWD_CHECK_NEW_SCENARIO( LWK_PKWD_SCENARIO, LWK_PKWD_ADDMSG_TYPE, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _PLAYER_NAME( 0 )
      _PKWD_SET_SCENARIO_NAME( 1, LWK_PKWD_SCENARIO )  //シナリオ名セット
      SWITCH $LWK_PKWD_ADDMSG_TYPE
      CASE SCR_PKWD_ADDMSG_GOOD_END THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_02, SCWK_TARGET_OBJID, POS_DOWN )
      CASE SCR_PKWD_ADDMSG_GAMECLEAR THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_22, SCWK_TARGET_OBJID, POS_DOWN )
      CASE SCR_PKWD_ADDMSG_STARRANK THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_20, SCWK_TARGET_OBJID, POS_DOWN )
      CASE SCR_PKWD_ADDMSG_PROFITS THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_19, SCWK_TARGET_OBJID, POS_DOWN )
      CASE SCR_PKWD_ADDMSG_ALL_GOOD_END THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_studio_21, SCWK_TARGET_OBJID, POS_DOWN )
      ENDSWITCH
    ENDIF
    $LWK_PKWD_SCENARIO += 1
  ENDWHILE

}
_RET
//==============================================================================
//  ポケウッド　チュートリアル関連
//==============================================================================
/**************************************************************/
//  撮影所エントランス：チュートリアル開始
/**************************************************************/
EVENT_START ev_reserve_pkwd_entrance_tutorial

  _TIME_WAIT( 10 )

  _OBJ_ANIME( C15R0201_PWSTAFF_02, anm_dir_up )
  _PLAYER_NAME( 0 )
  //「ヘイ！ボス！　～さんをお連れしました！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_01, C15R0201_PWSTAFF_02, POS_DOWN )
  _MSGWIN_CLOSE()

  //オーナー、プレイヤーのほうを向く
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_dir_down )
  //プレイヤー前に進む
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_up )
  _OBJ_ANIME_WAIT()
  //「ハローハロー！　～～出演して欲しいのさ！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_02, C15R0201_PWOWNER_01, POS_DOWN )
  _MSGWIN_CLOSE()
  //「イエス！ボス！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_03, C15R0201_PWSTAFF_02, POS_DOWN )
  _MSGWIN_CLOSE()
  //「だから頼むよー　～～
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_04, C15R0201_PWOWNER_01, POS_DOWN )
  //オーナー上を向く
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_dir_up )
  _OBJ_ANIME_WAIT()
  //「オーイ！　ハチクくーん！！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_04_1, C15R0201_PWOWNER_01, POS_DOWN )
  _MSGWIN_CLOSE()
  //ハチク:OBJ出現
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  _OBJ_ADD_EX( 14, 11, DIR_DOWN, MMDL_ID_EVENTOBJ_00, LEADER7, MV_DMY )
  //ハチク:近寄る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_hachiku_approach )
  _OBJ_ANIME_WAIT()
  //オーナー：ハチクを見る
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_dir_right )
  _OBJ_ANIME_WAIT()

  //「ハチクだ……よろしくたのむ……
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_05, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  //オーナー：プレイヤーを見る
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_dir_down )
  _OBJ_ANIME_WAIT()
  //「ハチクくんはね～
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_06, C15R0201_PWOWNER_01, POS_DOWN )
  _MSGWIN_CLOSE()
  //「いい　目だ……競演が楽しみだな……
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_07, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  //ハチク:去る、OBJ削除
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_hachiku_leave )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  //「んー！あいかわらずクール
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_08, C15R0201_PWOWNER_01, POS_DOWN )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

_ANIME_LABEL  anm_player_up
  _ANIME_DATA AC_WALK_U_8F, 3
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_hachiku_approach
  _ANIME_DATA AC_WALK_D_8F, 1
  _ANIME_DATA AC_WALK_R_8F, 1
  _ANIME_DATA AC_WALK_D_8F, 4
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_hachiku_leave
  _ANIME_DATA AC_WALK_U_8F, 4
  _ANIME_DATA AC_WALK_L_8F, 1
  _ANIME_DATA AC_WALK_U_8F, 1
  _ANIME_DATA ACMD_END, 0


/**************************************************************/
//  チュートリアル中POSイベント：撮影所外に出さないためのストッパー
/**************************************************************/
EVENT_START   ev_pos_pkwd_entrance_tutorial_stopper
  _OBJ_ANIME( C15R0201_PWSTAFF_02, anm_dir_right )
  _OBJ_ANIME_WAIT()
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_10, C15R0201_PWSTAFF_02, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_back )
  _OBJ_ANIME_WAIT()
EVENT_END

_ANIME_LABEL anm_player_back
  _ANIME_DATA AC_WALK_U_8F, 1
  _ANIME_DATA ACMD_END, 0

/**************************************************************/
//  チュートリアル中の固定キャラ：撮影エントランスのオーナー
/**************************************************************/
EVENT_START ev_pkwd_tutorial_pwowner_01
  _PLAYER_NAME( 0 )
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_pw_tutorial_rec_09 )
EVENT_END

/**************************************************************/
//  チュートリアル中の固定キャラ：撮影エントランスの手下その２
/**************************************************************/
EVENT_START ev_pkwd_tutorial_pwstaff_02
  _PLAYER_NAME( 0 )
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_pw_tutorial_rec_10 )
EVENT_END

/**************************************************************/
//  チュートリアル中の固定キャラ：撮影スタジオのハチク
/**************************************************************/
EVENT_START ev_pkwd_tutorial_hachiku_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_pw_tutorial_rec_17 )
EVENT_END


/**************************************************************/
//  チュートリアル：撮影完了フロー
/**************************************************************/
ev_pkwd_tutorial_go_theater:

//シーン：撮影所エントランス

  //オーナー、プレイヤーに近付く
  _OBJ_ANIME( C15R0201_PWOWNER_01, anm_powner_approach_to_player )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_down )
  _OBJ_ANIME_WAIT()

  //「いやー！さつえいお疲れ！～～シアターにレッツゴー！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_rec_11, C15R0201_PWOWNER_01, POS_DOWN )
  _MSGWIN_CLOSE()

_RET

_ANIME_LABEL  anm_powner_approach_to_player
  _ANIME_DATA AC_WALK_U_8F, 3
  _ANIME_DATA ACMD_END, 0


//==============================================================================
//
//  アニメ共通リソース定義
//
//==============================================================================
_ANIME_LABEL  anm_dir_up
  _ANIME_DATA AC_STAY_WALK_U_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_dir_down
  _ANIME_DATA AC_STAY_WALK_D_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_dir_left
  _ANIME_DATA AC_STAY_WALK_L_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_dir_right
  _ANIME_DATA AC_STAY_WALK_R_8F, 1
  _ANIME_DATA ACMD_END, 0

