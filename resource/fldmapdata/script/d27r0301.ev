
//======================================================================
//                d27r0301.ev
//
//    スクリプトファイル：d27r0301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d27r0301.h"
  .include  "d27r0301.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_pos_d27r0301_warp_01
_EVENT_DATA    ev_zone_d27r0301
_EVENT_DATA    ev_init_d27r0301
_EVENT_DATA    ev_recover_d27r0301
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//																	//
//	特殊な接続に LOCALWORK15 を使用ししています。     //
//	同マップ内の使用を禁止します。									//
//------------------------------------------------------------------//

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*		CALL：特殊接続                             */
/************************************************************/
ev_exit_change:

  //D10プラズマフリゲート起動中
  IF FLAG_ON( FE_D10_PLAZMA_FRIGATE_01 ) THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0301_D27R0101_EXIT01, 23, 0, 1 )
  //プラズマフリゲートいない
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0301_D27R1101_EXIT01, 23, 0, 1 )
  ENDIF

_RET

/************************************************************/
/*					ZONE_CHANGE_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r0301

  _CALL ev_exit_change
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r0301
  
  //

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r0301

  _CALL ev_exit_change

INIT_EVENT_END

/************************************************************/
/*					特殊接続				*/
/************************************************************/
EVENT_START	ev_pos_d27r0301_warp_01
  
  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //バージョンごとに異なるマップに移動
  
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _MAP_CHANGE_WARP( ZONE_ID_D27R1001, 15, 21, LWK_DIR )
  //W2
  ELSE
    _MAP_CHANGE_WARP( ZONE_ID_D27R1301, 15, 21, LWK_DIR )
  ENDIF
  
EVENT_END

