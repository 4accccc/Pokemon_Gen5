EVENT_START   ev_bg_r03_board_02
	_EASY_BGWIN_MSG(msg_r03_sign4_01 , TYPE_POST)
EVENT_END


/**************************************************************/
/*看板03                                                     */
/**************************************************************/
EVENT_START   ev_bg_r03_board_03
	_EASY_BGWIN_MSG(msg_r03_sign3_01 , TYPE_INFO)
EVENT_END
