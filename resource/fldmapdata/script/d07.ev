
//======================================================================
//                d07.ev
//
//    スクリプトファイル：d07用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_d07.h"
  .include  "d07.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_bg_d07_board_01
_EVENT_DATA		ev_d07_bigfour3_01
_EVENT_DATA		ev_pos_d07_bigfour3_ev
_EVENT_DATA_END


/**************************************************************/
/*            FLAG_CHANGE_LABEL                               */
/**************************************************************/
//ev_d07_flag_change:
//  _END

/**************************************************************/
/*看板01                                                      */
/**************************************************************/
EVENT_START  ev_bg_d07_board_01
	_EASY_BGWIN_MSG(msg_d07_sign1_01 , TYPE_POST)
EVENT_END

/**************************************************************/
/*		D07		BIGFOUR3									  */
/**************************************************************/
EVENT_START		ev_d07_bigfour3_01

//ゲームクリア前なら
IF FLAG_OFF( SYS_FLAG_GAME_CLEAR )  THEN

	//おまえは……　なかなか
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_d07_bigfour_01 )

	//========================================//
	_FLAG_SET(FE_D07_BIGFOUR3_TALK)
	//========================================//

//ゲームクリア後なら
ELSE

	_TALK_OBJ_START()
	
	//主人公向き取得
	_PLAYER_DIR_GET( SCWK_ANSWER )
	
	//プレイヤー名格納
	_PLAYER_NAME(0)
	
	//きみは……
	_BALLOONWIN_TALKOBJ_MSG( msg_d07_bigfour_02 )
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()

	_OBJ_ANIME( D07_BIGFOUR3_01, anm_walk_d16 )
	_TIME_WAIT( 10 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_d )
	_OBJ_ANIME_WAIT()

	//そうだな……
	_BALLOONWIN_TALKOBJ_MSG( msg_d07_bigfour_03 )
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()
	
	SWITCH $SCWK_ANSWER
	CASE DIR_LEFT THEN
		_OBJ_ANIME( D07_BIGFOUR3_01, anm_come_r )
	CASE DIR_RIGHT THEN
		_OBJ_ANIME( D07_BIGFOUR3_01, anm_come_l )
	ENDSWITCH

	_OBJ_ANIME_WAIT()

	//では　ポケモンリーグにて
	_BALLOONWIN_TALKOBJ_MSG( msg_d07_bigfour_04 )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( D07_BIGFOUR3_01, anm_dir_d )
	_OBJ_ANIME_WAIT()
	
	SWITCH $SCWK_ANSWER
	CASE DIR_LEFT THEN
		_OBJ_HIGH_JUMP( D07_BIGFOUR3_01, 143, 0, 206 )
	CASE DIR_RIGHT THEN
		_OBJ_HIGH_JUMP( D07_BIGFOUR3_01, 141, 0, 206 )
	ENDSWITCH

	_OBJ_ANIME( D07_BIGFOUR3_01, anm_leave )
	_OBJ_ANIME_WAIT()

	_OBJ_DEL( D07_BIGFOUR3_01 )

	//========================================/
	
	//レンブのバニシュフラグセット
	_FLAG_SET(FV_D07_BIGFOUR3_01)
	
	//ＰＯＳイベント終了
	$WK_SCENE_D07 = 1
	
	//========================================/

ENDIF

EVENT_END

/**************************************************************/
/*		D07		BIGFOUR3	POS								  */
/**************************************************************/
EVENT_START		ev_pos_d07_bigfour3_ev

//ゲームクリア前なら
IF FLAG_OFF( SYS_FLAG_GAME_CLEAR )  THEN

	//レンブ：ギョエ
	_OBJ_ANIME( D07_BIGFOUR3_01, anm_gyoe )
	_OBJ_ANIME_WAIT()
	
	//レンブ・主人公：向かい合う
	_OBJ_ANIME( D07_BIGFOUR3_01, anm_stay_d )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_u )
	_OBJ_ANIME_WAIT()

	//おまえは……　なかなか
	_BALLOONWIN_OBJMSG_POS( msg_d07_bigfour_01 , D07_BIGFOUR3_01, POS_DEFAULT )
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()
	
	//主人公後退する
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
	_OBJ_ANIME_WAIT()

	//========================================//
	_FLAG_SET(FE_D07_BIGFOUR3_TALK)
	//========================================//

//ゲームクリア後なら
ELSE

	//レンブ：ギョエ
	_OBJ_ANIME( D07_BIGFOUR3_01, anm_gyoe )
	_OBJ_ANIME_WAIT()
	
	//レンブ・主人公：向かい合う
	_OBJ_ANIME( D07_BIGFOUR3_01, anm_stay_d )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_u )
	_OBJ_ANIME_WAIT()

	//プレイヤー名格納
	_PLAYER_NAME(0)
	
	//きみは……
	_BALLOONWIN_OBJMSG_POS( msg_d07_bigfour_02 , D07_BIGFOUR3_01, POS_DEFAULT )
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()

	_OBJ_ANIME( D07_BIGFOUR3_01, anm_bigfour3_walk )
	_TIME_WAIT( 10 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_r )
	_OBJ_ANIME_WAIT()

	//そうだな……
	_BALLOONWIN_OBJMSG_POS( msg_d07_bigfour_03 , D07_BIGFOUR3_01, POS_DEFAULT )
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( D07_BIGFOUR3_01, anm_stay_l )
	_OBJ_ANIME_WAIT()

	//では　ポケモンリーグにて
	_BALLOONWIN_OBJMSG_POS( msg_d07_bigfour_04 , D07_BIGFOUR3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( D07_BIGFOUR3_01, anm_dir_d )
	_OBJ_ANIME_WAIT()
	
	_OBJ_HIGH_JUMP( D07_BIGFOUR3_01, 143, 0, 206 )

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_d )
	_OBJ_ANIME( D07_BIGFOUR3_01, anm_leave )
	_OBJ_ANIME_WAIT()

	_OBJ_DEL( D07_BIGFOUR3_01 )

	//========================================/
	
	//レンブのバニシュフラグセット
	_FLAG_SET(FV_D07_BIGFOUR3_01)
	
	//ＰＯＳイベント終了
	$WK_SCENE_D07 = 1
	
	//========================================/

ENDIF

EVENT_END

//--------------------------------------------------------------------
//	★レンブ：専用アニメ
//--------------------------------------------------------------------
