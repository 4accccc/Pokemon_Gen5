_EVENT_DATA    ev_bg_c06_sign1_01
_EVENT_DATA    ev_bg_c06_sign2_01
_EVENT_DATA    ev_bg_c06_sign3_01
_EVENT_DATA    ev_c06_monsterball_01
_EVENT_DATA    ev_pos_c06_hakase_01
_EVENT_DATA    ev_scene_c06_swleader6_01
_EVENT_DATA    ev_zone_c06
_EVENT_DATA    ev_init_c06
_EVENT_DATA    ev_c06_swleader6_01
_EVENT_DATA    ev_reserve_c06_link_event_ret
_EVENT_DATA	ev_c06_boy3_01
_EVENT_DATA	ev_c06_girl2_01
_EVENT_DATA	ev_c06_pilot_01
_EVENT_DATA	ev_c06_rangerw_01
_EVENT_DATA	ev_c06_workman_01
_EVENT_DATA	ev_c06_woman1_01
_EVENT_DATA	ev_c06_workman_01wb
_EVENT_DATA	ev_c06_backpackerw_01
_EVENT_DATA	ev_c06_woman1a_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//------------------------------注意--------------------------------//
//                                                                  //
//  LOCALWORK15をリンクイベントで使用。
//                                                                  //
//------------------------------------------------------------------//

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c06
{
  //データコンバートフラグチェック
  _DATACONV_GET_FLAG( DATACONV_FLAG_BADGE_06, LOCALWORK15 )

  //【仮】C06到着イベント終了でヤマジタウン到着でリンクイベント起動
  IF $LOCALWORK15 == 1 && $WK_SYS_LINK_EVENT_02 == 0 && $WK_SCENE_T07 >= 1 THEN
    //========================================//
    //C06フウロ表示
    _FLAG_RESET( FV_C06_SWLEADER6_01 )
    //========================================//
  ENDIF
}
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c06
  //C06到着イベント終了でリンクイベント起動ならフウロを移動
  IF $LOCALWORK15 == 1 && $WK_SYS_LINK_EVENT_02 == 0 && $WK_SCENE_T07 >= 1 THEN
    _OBJ_POS_CHANGE( C06_SWLEADER6_01, 77, 0, 269, DIR_DOWN)
  ENDIF
INIT_EVENT_END

/**************************************************************/
/*  C06 看板のイベントスクリプト1                             */
/**************************************************************/
EVENT_START   ev_bg_c06_sign1_01
  _EASY_BGWIN_MSG(msg_c06_sign1_01,TYPE_TOWN)
EVENT_END

/**************************************************************/
/*  C06 看板のイベントスクリプト2                             */
/**************************************************************/
EVENT_START   ev_bg_c06_sign2_01
  _EASY_BGWIN_MSG(msg_c06_sign2_01,TYPE_POST)
EVENT_END

/**************************************************************/
/*  C06 看板のイベントスクリプト3                             */
/**************************************************************/
EVENT_START   ev_bg_c06_sign3_01
  _EASY_BGWIN_MSG(msg_c06_gymsign_01,TYPE_POST)
EVENT_END

/**************************************************************/
/*  C06 BOY2とGIRL1のつばめがえし入手イベントスクリプト       */
/**************************************************************/
EVENT_START   ev_c06_monsterball_01

  _TALK_START_SE_PLAY()

  //===============フラグ操作===============//
  //男の子、女の子、コアルヒー表示
  _FLAG_RESET( FV_C06_GIRLBOY_01 )
  //===============フラグ操作===============//
  _OBJ_ADD( C06_BOY2_01 )
  _OBJ_ADD( C06_BABYGIRL1_01 )
  _OBJ_ADD( C06_POKE40_01 )

  //アイテム入手処理
  _OBJ_DEL( C06_MONSTERBALL_01 )
  _ITEM_EVENT_FIELD_KEYWAIT( ITEM_WAZAMASIN40, 1 )
  _FLAG_SET( FV_C06_MONSTERBALL )
  _FLAG_SET( FE_C06_ITEMGET_1 )

  //主人公が初年と少女に気づく
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

  //男の子と女の子とコアルヒーがやってくる
  _OBJ_ANIME( C06_BOY2_01, anm_c06_boy2_01_come_01 )
  _OBJ_ANIME( C06_BABYGIRL1_01, anm_c06_babygirl1_01_come_01 )
  _OBJ_ANIME( C06_POKE40_01, anm_c06_poke40_01_come_01 )

  //男の子：あー！　ぼくらの
  _BALLOONWIN_OBJMSG_POS( msg_c06_boy2_01, C06_BOY2_01, POS_UR )
  _MSGWIN_CLOSE()
  _OBJ_ANIME_WAIT()

  //女の子：みつけたわね！！▼
  _BALLOONWIN_OBJMSG_POS( msg_c06_babygirl_01, C06_BABYGIRL1_01, POS_DR )
  _MSGWIN_CLOSE()

  //間をつくる
  _TIME_WAIT( 32 )

  //男の子：なんてね▼
  _BALLOONWIN_OBJMSG_MF( msg_c06_boy2_02, msg_c06_boy2_03, C06_BOY2_01, POS_UP )
  _MSGWIN_CLOSE()

  //女の子：つばめがえしは　かならず
  _BALLOONWIN_OBJMSG_POS( msg_c06_babygirl_02, C06_BABYGIRL1_01, POS_DR )
  _MSGWIN_CLOSE()

  //コアルヒー：ぐわ！
  _VOICE_PLAY( MONSNO_609, 0 )
  _BALLOONWIN_OBJMSG_POS( msg_c06_poke40_01, C06_POKE40_01, POS_UP )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //間をつくる
  _TIME_WAIT( 8 )

  //男の子：じゃあね！　バイバイ！！▼
  _BALLOONWIN_OBJMSG_POS( msg_c06_boy2_04, C06_BOY2_01, POS_UR )
  _MSGWIN_CLOSE()

  //男の子と女の子とコアルヒーが帰っていく
  _OBJ_ANIME( C06_BOY2_01, anm_c06_boy2_01_back_01 )
  _OBJ_ANIME( C06_BABYGIRL1_01, anm_c06_babygirl1_01_back_01 )
  _OBJ_ANIME( C06_POKE40_01, anm_c06_poke40_01_back_01 )
  _OBJ_ANIME_WAIT()

  _OBJ_DEL( C06_BOY2_01 )
  _OBJ_DEL( C06_BABYGIRL1_01 )
  _OBJ_DEL( C06_POKE40_01 )

  //===============フラグ操作===============//
  //男の子、女の子、コアルヒー非表示
  _FLAG_SET( FV_C06_GIRLBOY_01 )
  //===============フラグ操作===============//

EVENT_END

/**************************************************************/
/*  POS：博士イベント01                                       */
/**************************************************************/
EVENT_START   ev_pos_c06_hakase_01

  //==================================//
  //POSイベント進行
  $WK_SCENE_C06HAKASE = 1
  //==================================//

  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  //アニメ：アララギ博士登場
  _OBJ_ANIME_AUTO( C06_HAKASE2_01, LCW_POSX, 297, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //アニメ：アララギ「！」
  _OBJ_ANIME( C06_HAKASE2_01, anm_hakase2_guide01 )
  _OBJ_ANIME_WAIT()

  _START_EVENT_BGM( SEQ_BGM_E_DOCTOR )

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  //アニメ：アララギ博士隣接
  $LCW_POSZ -= 1
  _OBJ_ANIME_AUTO( C06_HAKASE2_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //主人公名代入
  _PLAYER_NAME( 0 )
  //アララギ：はーい！
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_01, C06_HAKASE2_01, POS_DEFAULT )

  //アララギ：やっと　ライブキャスターを　つかわず
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_02, C06_HAKASE2_01, POS_DEFAULT )

  //アララギ：わたしの　おねがいを　きいて
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_03, C06_HAKASE2_01, POS_DEFAULT )

  //主人公名代入
  _PLAYER_NAME( 0 )
  //捕獲ポケモン変数
  DEFINE_LOCAL LWK_ZUKAN
  //見つけたポケモン数をチェック
  _GET_ZUKAN_COUNT ( ZUKANCTRL_MODE_SEE, LWK_ZUKAN )
  //見つけたポケモン数を代入
  _NUMBER( 1, LWK_ZUKAN, 3 )
  //アララギ：主人公　がいままでに
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_04, C06_HAKASE2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アイテム入手：マスターボール入手
  _ITEM_EVENT_KEYWAIT( ITEM_MASUTAABOORU, 1 )

  //アララギ：マスターボールの説明
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_05, C06_HAKASE2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：アララギ振り向き
  _OBJ_ANIME( C06_HAKASE2_01, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  //アララギ：しかし　ポケモンの　ぶんぷって
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_06, C06_HAKASE2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //軽く間
  _TIME_WAIT( 30 )

  //？？？：アララギはかせーッ！！（フウロのメッセージのみ）
  _PLAINWIN_MSG_UP( msg_c06_swleader6_01 )
  _MSGWIN_CLOSE()

  //アニメ：アララギ振り向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gyoe )
  _OBJ_ANIME_WAIT()

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  //アニメ：フウロ登場
  IF $LCW_POSX == 100 && $LCW_POSZ == 301 THEN
    _OBJ_ANIME_AUTO( C06_SWLEADER6_01, 101, 300, FORCE_TYPE_NPC, 8, DIR_LR )  //主人公が柵側の場合は指定位置
    _TIME_WAIT( 80 )
    _OBJ_ANIME( C06_HAKASE2_01, anm_common_turn_u )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( C06_SWLEADER6_01, anm_common_turn_l )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( C06_HAKASE2_01, anm_common_turn_r )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
    _OBJ_ANIME_WAIT()
  ELSE
    $LCW_POSZ -= 1
    $LCW_POSX -= 1
    _OBJ_ANIME_AUTO( C06_SWLEADER6_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR )
    _TIME_WAIT( 80 )
    _OBJ_ANIME( C06_HAKASE2_01, anm_common_turn_u )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( C06_SWLEADER6_01, anm_common_turn_r )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( C06_HAKASE2_01, anm_common_turn_l )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
    _OBJ_ANIME_WAIT()
  ENDIF

  //アララギ：あら！　フウロじゃない！
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_08, C06_HAKASE2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：アララギ振り向き
  _OBJ_ANIME( C06_HAKASE2_01, anm_common_turn_d )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
  _OBJ_ANIME_WAIT()

  //アララギ：こちらは　フウロ！
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_09, C06_HAKASE2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //フウロ：あら！　じゃないですよ▼
  _BALLOONWIN_OBJMSG_POS( msg_c06_swleader6_02, C06_SWLEADER6_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：アララギ振り向き
  _OBJ_ANIME( C06_HAKASE2_01, anm_common_turn_l )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  //主人公名代入
  _PLAYER_NAME( 0 )
  //アララギ：あはは！　そうだったわね
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_10, C06_HAKASE2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：アララギ振り向き
  _OBJ_ANIME( C06_HAKASE2_01, anm_common_turn_d )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
  _OBJ_ANIME_WAIT()

  //アララギ：
  _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_10a, C06_HAKASE2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  //アニメ：博士タワーオブヘブンへ歩く
  _OBJ_ANIME_AUTO( C06_HAKASE2_01, 109, 297, FORCE_TYPE_NPC, 8, DIR_UD )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( C06_SWLEADER6_01, anm_common_turn_u )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( C06_HAKASE2_01 )

  _END_EVENT_BGM()

  //フウロ：もう！
  _BALLOONWIN_OBJMSG_POS( msg_c06_swleader6_03, C06_SWLEADER6_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _TIME_WAIT( 15 )

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  //フウロ：接近
  $LCW_POSZ -= 1
  _OBJ_ANIME_AUTO( C06_SWLEADER6_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C06_SWLEADER6_01, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //フウロ：さてと　アナタ▼
  _BALLOONWIN_OBJMSG_POS( msg_c06_swleader6_04, C06_SWLEADER6_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //フウロ退場
  _OBJ_ANIME_AUTO( C06_SWLEADER6_01, 90, 297, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( C06_SWLEADER6_01 )
  
  //========================================//
  //フウロ、アララギを非表示
  _FLAG_SET( FV_C06_SWLEADER6_01 )
  _FLAG_SET( FV_C06_HAKASE2_01 )
  //ローカルライブキャスター・アララギ通話状態を変更（R07R0101 && C06GYMクリアまで）
  _PERSON_STATE_SET_DOCTOR( DOCTOR_STATE_TOWEROFHEAVEN )
  //========================================//


EVENT_END


/************************************************************/
/*        SCENE_CHANGE：ジムリーダーイベント                */
/************************************************************/
EVENT_START   ev_scene_c06_swleader6_01

  //アニメ：主人公移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 78, 271, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()

  //========================================//
  //フウロと博士再表示
  _FLAG_RESET( FV_C06_SWLEADER6_01 )
  _FLAG_RESET( FV_C06_HAKASE2_01 )
  //========================================//
  _OBJ_ADD( C06_SWLEADER6_01 )
  _OBJ_ADD( C06_HAKASE2_01 )

  //階段SE
  _SE_PLAY( SEQ_SE_KAIDAN ) 
  _SE_WAIT()
  
  //フウロと博士再配置（表示）
  _OBJ_POS_CHANGE( C06_SWLEADER6_01, 78, 0, 268, DIR_DOWN )
  _OBJ_POS_CHANGE( C06_HAKASE2_01, 84, 0, 279, DIR_UP )

  _TIME_WAIT( 15 )
  

  //アニメ：フウロ移動
  _OBJ_ANIME_AUTO( C06_SWLEADER6_01, 78, 270, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()

  //アニメ：主人公振り向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
  _OBJ_ANIME_WAIT()

  //フウロ：さて！
  _BALLOONWIN_OBJMSG_POS( msg_c06_swleader6_05, C06_SWLEADER6_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //タワーオブヘブンへ向かった？
  IF $WK_SCENE_C06HAKASE == 3 THEN

    //アニメ：博士登場
    _OBJ_ANIME( C06_HAKASE2_01, anm_hakase2_come_01 )
    _OBJ_ANIME_WAIT()

    //アニメ：主人公とフウロ振り向き
    _OBJ_ANIME( C06_SWLEADER6_01, anm_common_turn_r )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
    _OBJ_ANIME_WAIT()

    //主人公名代入
    _PLAYER_NAME( 0 )
    //アララギ：はーい！▼
    _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_11, C06_HAKASE2_01, POS_DEFAULT )

    //アララギ：それに　ソウリュウシティに
    _BALLOONWIN_OBJMSG_POS( msg_c06_hakase2_12, C06_HAKASE2_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //アニメ：博士退場
    _OBJ_ANIME( C06_HAKASE2_01, anm_hakase2_back_01 )
    _OBJ_ANIME_WAIT()

    //フウロ：あっ　まってよ　はかせ！
    _BALLOONWIN_OBJMSG_POS( msg_c06_swleader6_07, C06_SWLEADER6_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //アニメ：主人公とフウロ向き合う
    _OBJ_ANIME( C06_SWLEADER6_01, anm_common_turn_d )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
    _OBJ_ANIME_WAIT()

    //フウロ：じゃ　アナタも　きてね！　▼
    _BALLOONWIN_OBJMSG_POS( msg_c06_swleader6_08, C06_SWLEADER6_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //========================================//
    //カーゴサービスのフウロと博士表示
    _FLAG_RESET( FV_C06R0201_SWLEADER6_01 )
    _FLAG_RESET( FV_C06R0201_HAKASE2_01 )
    //ローカルライブキャスター・アララギ通話状態を変更（T07到着まで）
    _PERSON_STATE_SET_DOCTOR( DOCTOR_STATE_CARGOSERVICE )
    //========================================//

  ELSE
    //フウロ：まだ　タワーオブヘブンを
    _BALLOONWIN_OBJMSG_POS( msg_c06_swleader6_06, C06_SWLEADER6_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //========================================//
    //カーゴサービスのフウロのみ表示
    _FLAG_RESET( FV_C06R0201_SWLEADER6_01 )
    //========================================//

  ENDIF
  //アニメ：フウロ退場
  _OBJ_ANIME( C06_SWLEADER6_01, anm_swleader6_back_01 )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

  _OBJ_DEL( C06_SWLEADER6_01 )
  _OBJ_DEL( C06_HAKASE2_01 )

  //========================================//
  //フウロ、アララギを非表示
  _FLAG_SET( FV_C06_SWLEADER6_01 )
  _FLAG_SET( FV_C06_HAKASE2_01 )
  //C06GYM0101フウロ非表示
  _FLAG_SET( FV_C06GYM0101_LEADER6_01 )
  //========================================//
  //POSイベント進行
  $WK_SCENE_C06GYM = 2
  $WK_SCENE_C06HAKASE += 1
  //ローカルライブキャスター・ライバル通話状態を変更（D24R0301,D24R0901ベル連れ歩きまで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_R06_2 )
  //========================================//

EVENT_END

/************************************************************/
/*       話しかけ：SWLEADER6                */
/************************************************************/
EVENT_START   ev_c06_swleader6_01
  
  _TALK_OBJ_START()
  _BALLOONWIN_TALKOBJ_MSG( msg_c06_memory_01 )
  _MSGWIN_CLOSE()
  
  _MAP_FADE_BLACK_OUT_SLOW()
  //過去イベント・サザナミ起動
  _RESERVE_SCRIPT( SCRID_RESERVE_OLDT04R0301_EVENT_01 )
  _MAP_FADE_END_CHECK()
  //マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_OLDT04R0301, 6, 0, 5, DIR_DOWN )
  
EVENT_END

/************************************************************/
/*       RESERVE：リンクイベント終了                */
/************************************************************/
EVENT_START   ev_reserve_c06_link_event_ret
  
  //画面暗転処理
	_MAP_FADE_BLACK_IN()
	_MAP_FADE_END_CHECK()
  
  //アニメ：フウロ退場
  _OBJ_ANIME( C06_SWLEADER6_01, anm_swleader6_return )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _TIME_WAIT( 8 )
  
  //フウロ動作モデル削除
  _OBJ_DEL( C06_SWLEADER6_01 )
  
  _SE_WAIT()
  
  //========================================//
  //リンクイベント終了
  $WK_SYS_LINK_EVENT_02 = 1
  //C06フウロ非表示
  _FLAG_SET( FV_C06_SWLEADER6_01 )
  //========================================//
  
EVENT_END

/************************************************************/
/*	BOY3		一言メッセージ							*/
