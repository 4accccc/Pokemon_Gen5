//c06_boy2_01 : 帰っていく                     
//--------------------------------------------------------------------
_ANIME_LABEL	anm_c06_boy2_01_back_01
	_ANIME_DATA	AC_WALK_R_8F,7
	_ANIME_DATA	ACMD_END,0
	
