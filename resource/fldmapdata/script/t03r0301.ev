  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_t03r0301.h"
  //.include  "t03r0301.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_t03r0301
_EVENT_DATA    ev_t03r0301_woman2_01
_EVENT_DATA_END


//時間変数
DEFINE_LOCAL  LWK_TIMEZONE

/************************************************************/
/*  ZONE_CHANGE_SCRIPT                                      */
/************************************************************/
INIT_EVENT_START  ev_zone_t03r0301

  //現在の時間帯を取得
  _GET_TIMEZONE( LWK_TIMEZONE )

  //夜の場合は住人を表示
  IF $LWK_TIMEZONE == TIMEZONE_NIGHT || $LWK_TIMEZONE == TIMEZONE_MIDNIGHT THEN

    //========================================//
    //住人表示
    _FLAG_RESET( FV_T03_MORNING_PEOPLE_01 )
    //========================================//

  //昼の場合は住人を非表示
  ELSE

    //========================================//
    //住人非表示
    _FLAG_SET( FV_T03_MORNING_PEOPLE_01 )
    //========================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  女性：話しかけ（昼も夜もいる）                            */
/**************************************************************/
EVENT_START   ev_t03r0301_woman2_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t03_woman2_01 )
EVENT_END


