  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c03gym0101.h"
  .include  "c03gym0101.h"
  .include  "../gimmick/gym_insect/gym_insect_local_def.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------
//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA ev_prog_c03gym0101_gate_in
_EVENT_DATA ev_prog_c03gym0101_gate_out
_EVENT_DATA ev_prog_c03gym0101_gate_out_4x
_EVENT_DATA ev_prog_c03gym0101_gate_out_1c
_EVENT_DATA ev_prog_c03gym0101_gate_out_3d
_EVENT_DATA ev_pos_c03gym0101_gate_3b
_EVENT_DATA ev_c03gym0101_trainer_gate_3b
_EVENT_DATA ev_c03gym0101_sunglasses_01  //サングラス
_EVENT_DATA ev_bg_c03gym0101_statue_01  //石像
_EVENT_DATA_END

//==============================================================
///プログラム呼び出し
//==============================================================

/***************************************************************/
/*
  ゲートイン/アウト
*/
/***************************************************************/
//
EVENT_START ev_prog_c03gym0101_gate_in
{
  DEFINE_LOCAL  i_player_dir

	//自機方向取得
	_PLAYER_DIR_GET( i_player_dir )

  //吸い込みアニメ開始
  _GYM_INSECT_VACUUM_ANM()

  SWITCH $i_player_dir
  CASE DIR_UP THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gatein_u )
  CASE DIR_LEFT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gatein_l )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gatein_r )
  ENDSWITCH
  _OBJ_ANIME_WAIT()
  //自機隠す
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_vanish_on )
  _OBJ_ANIME_WAIT()

//  _CAMERA_START()		//カメラ操作開始
//	_CAMERA_PURGE()		//カメラのバインドを解く
}
EVENT_END

EVENT_START ev_prog_c03gym0101_gate_out
{
  DEFINE_LOCAL  i_gate_id
  DEFINE_LOCAL  i_player_dir

  $i_gate_id = $SCWK_PARAM0
	
  //自機方向取得
  $i_player_dir = $SCWK_PARAM1
 
  //自機表示
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_vanish_off )
  _OBJ_ANIME_WAIT()

  SWITCH $i_player_dir
  CASE DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gateout_d )
  CASE DIR_LEFT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gateout_l )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gateout_r )
  ENDSWITCH
  _SE_PLAY( SEQ_SE_GYM_M03 ) //飛び出す音
  _OBJ_ANIME_WAIT()

//	_CAMERA_BIND()	//カメラのバインドを復活
//  _CAMERA_END()		//カメラ操作開始

}
EVENT_END

EVENT_START ev_prog_c03gym0101_gate_out_4x
{
  DEFINE_LOCAL  i_gate_id
  DEFINE_LOCAL  i_player_dir

  $i_gate_id = $SCWK_PARAM0
  
  //ジムリーダー部屋に移動
  IF $i_gate_id == GATE_ID_3D_4A THEN
    _MAP_CHANGE_NO_FADE( ZONE_ID_C03GYM0201, 15, -1, 20, DIR_UP )
  ELSE
    _MAP_CHANGE_NO_FADE( ZONE_ID_C03GYM0201, 9, -1, 13, DIR_UP )
  ENDIF

  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()
  
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gateout_4x )
  _OBJ_ANIME_WAIT()
}
EVENT_END

EVENT_START ev_prog_c03gym0101_gate_out_1c
{
  //自機表示
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_vanish_off )
  _OBJ_ANIME_WAIT()
  
  IF FLAG_OFF(FE_C03GYM0101_COCCON_01) THEN
    _SE_PLAY( SEQ_SE_GYM_M04 ) //繭が破れる音
    _GYM_INSECT_COCCON_OPEN( COCCON_ID_1C )
    _SE_WAIT()
    _SE_PLAY( SEQ_SE_GYM_M04 ) //繭が破れる音
    _SE_WAIT()
    _SE_PLAY( SEQ_SE_GYM_M05 ) //繭が破れる音
    _TIME_WAIT(COCCON_OPEN_ANM_WAIT)
	  _FLAG_SET( FE_C03GYM0101_COCCON_01 )
  ENDIF

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gateout_map_change )
  _OBJ_ANIME_WAIT()
}
EVENT_END

EVENT_START ev_prog_c03gym0101_gate_out_3d
{
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gateout_map_change )
  _OBJ_ANIME_WAIT()
}
EVENT_END


//--------------------------------------------------------------
//ゲートインアニメ
//--------------------------------------------------------------
_ANIME_LABEL  anm_player_gatein_u
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA AC_STAY_WALK_U_2F,2
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA AC_ANM_PAUSE_ON,1
  _ANIME_DATA AC_WALK_U_2F,2
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA AC_ANM_PAUSE_OFF,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gatein_l
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA AC_STAY_WALK_L_2F,2
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA AC_ANM_PAUSE_ON,1
  _ANIME_DATA AC_WALK_L_2F,2
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA AC_ANM_PAUSE_OFF,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gatein_r
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA AC_STAY_WALK_R_2F,2
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA AC_ANM_PAUSE_ON,1
  _ANIME_DATA AC_WALK_R_2F,2
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA AC_ANM_PAUSE_OFF,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gateout_d
  _ANIME_DATA AC_JUMP_D_2G_16F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gateout_l
  _ANIME_DATA AC_JUMP_L_2G_16F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gateout_r
  _ANIME_DATA AC_JUMP_R_2G_16F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL anm_player_gateout_4x
  _ANIME_DATA AC_JUMP_U_1G_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gateout_map_change
  _ANIME_DATA AC_VANISH_OFF,1
  _ANIME_DATA AC_JUMP_D_2G_16F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//主人公表示非表示アニメ
//--------------------------------------------------------------
_ANIME_LABEL  anm_player_vanish_on
  _ANIME_DATA AC_VANISH_ON,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_vanish_off
  _ANIME_DATA AC_VANISH_OFF,1
  _ANIME_DATA ACMD_END,0

//==============================================================
///イベント呼び出し
//==============================================================

/***************************************************************/
/*
  ゲート3B POSイベント
*/
/***************************************************************/
EVENT_START ev_pos_c03gym0101_gate_3b
{
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gate_3b_turn_u )
  _OBJ_ANIME_WAIT()
  
  _SE_PLAY( SEQ_SE_GYM_M04 ) //繭が揺れる音
  _GYM_INSECT_COCCON_OPEN( COCCON_ID_3B )
  _SE_WAIT()
  _SE_PLAY( SEQ_SE_GYM_M04 ) //繭が破れる音
  _SE_WAIT()
  _SE_PLAY( SEQ_SE_GYM_M05 ) //繭が破れる音
  _TIME_WAIT(COCCON_OPEN_ANM_WAIT)
  _FLAG_SET( FE_C03GYM0101_COCCON_02 )

  //視線曲を再生
	_TRAINER_BGM_SET( TRID_JUGGLING_11 )
	//トレーナー：主人公前へ
	_OBJ_ANIME( C03R0101_TRAINER_GATE_3B, anm_trainer_gate_3b_walk_d )
	_OBJ_ANIME_WAIT()

	//トレーナー：戦闘前メッセージ
	_BALLOONWIN_OBJMSG( msg_c03gym0101_trainer_gate_3b_01 , C03R0101_TRAINER_GATE_3B )
	_BALLOONWIN_CLOSE()

	//トレーナー戦呼び出し
	_TRAINER_BTL_SET( TRID_JUGGLING_11, 0 )
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
		_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
  	_FLAG_RESET( FE_C03GYM0101_COCCON_02 )
		_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF

	//トレーナー：戦闘後メッセージ
	_BALLOONWIN_OBJMSG( msg_c03gym0101_trainer_gate_3b_02 , C03R0101_TRAINER_GATE_3B )
	_BALLOONWIN_CLOSE()

	//トレーナー：退く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gate_3b_move_r )
	_OBJ_ANIME( C03R0101_TRAINER_GATE_3B, anm_trainer_gate_3b_move )
	_OBJ_ANIME_WAIT()

  //トレーナー戦終了
  $WK_SCENE_C03GYM0101_GATE_3B = 1
}
EVENT_END

_ANIME_LABEL  anm_player_gate_3b_turn_u
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gate_3b_move_r
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_trainer_gate_3b_walk_d
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_trainer_gate_3b_move
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_L_8F,2
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0


/***************************************************************/
/*
  ゲート3B トレーナー戦後イベント
*/
/***************************************************************/
EVENT_START ev_c03gym0101_trainer_gate_3b
{
  _TALK_OBJ_START()
	//トレーナー：戦闘後メッセージ
	_BALLOONWIN_OBJMSG( msg_c03gym0101_trainer_gate_3b_03 , C03R0101_TRAINER_GATE_3B )
  _LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()
}
EVENT_END

/************************************************************/
/*				サングラスのスクリプトイベント				*/
/************************************************************/
EVENT_START	ev_c03gym0101_sunglasses_01

	IF $WK_SCENE_C03GYM0101 == 0 THEN
	
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03gym0101_glasses_stop_01 )
		
	ELSE
		
		_TALK_OBJ_START()
		
		//バッジフラグ取得
		_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_03 )

		//バッジフラグで分岐
		IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前の処理

			//アイテム入手フラグで分岐
			IF FLAG_OFF( FE_C03GYM_ITEM ) THEN
				//アイテム未入手なら、おいしいみず入手イベント
				_BALLOONWIN_TALKOBJ_MSG( msg_c03gym0101_glasses_01 )
				_BALLOONWIN_CLOSE()
				_ITEM_EVENT_KEYWAIT( ITEM_OISIIMIZU, 1 )
				_BALLOONWIN_TALKOBJ_MSG( msg_c03gym0101_glasses_02 )
				_LAST_KEYWAIT()
				_BALLOONWIN_CLOSE()

				_FLAG_SET( FE_C03GYM_ITEM )			//アイテム入手フラグをセット

			ELSE
				//入手済みならメッセージのみ
				_BALLOONWIN_TALKOBJ_MSG( msg_c03gym0101_glasses_02 )
				_LAST_KEYWAIT()
				_BALLOONWIN_CLOSE()
			ENDIF

		ELSE
			//バッジ入手後の処理

			//さすがっすよ！
			_BALLOONWIN_TALKOBJ_MSG( msg_c03gym0101_glasses_03 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()

		ENDIF
	
	ENDIF

EVENT_END

/************************************************************/
/*				石像のスクリプトイベント					*/
/************************************************************/
EVENT_START	ev_bg_c03gym0101_statue_01
_TALK_START_SE_PLAY()
	//ジムバッジを持っているのかを判定
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_03 )

	//ジムバッジを取得していない場合
	IF $SCWK_TEMP0 == 0 THEN
		_PLAYER_NAME( 0 )
		_PLAINWIN_MSG_DOWN( msg_c03gym0101_statue_01 )
	
	//ジムバッジを取得している場合
	ELSE
		//【仮】C04プラズマ団イベント発生前（メッセージ分岐条件がBW版）
		IF $WK_SCENE_C04 == 0 THEN
		
			_PLAYER_NAME( 0 )
			_PLAINWIN_MSG_DOWN( msg_c03gym0101_statue_02 )
			
		//C04プラズマ団イベント後
		ELSE
		
			_PLAYER_NAME( 0 )
			_PLAINWIN_MSG_DOWN( msg_c03gym0101_statue_03 )
		
		ENDIF
		
	ENDIF
	
	_LAST_KEYWAIT()	
	_PLAINWIN_CLOSE()
	
EVENT_END
