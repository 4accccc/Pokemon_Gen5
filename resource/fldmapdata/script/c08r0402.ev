  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c08r0402.h"
  .include  "c08r0402.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c08r0402_man3_01
_EVENT_DATA    ev_c08r0402_poke37_01
_EVENT_DATA    ev_c08r0402_poke37_02
_EVENT_DATA    ev_c08r0402_poke37_03
_EVENT_DATA    ev_c08r0402_poke37_04
_EVENT_DATA    ev_c08r0402_poke37_05
_EVENT_DATA_END

//ポケモン選択変数一式
DEFINE_LOCAL LWK_POKE_SELECT
DEFINE_LOCAL LWK_POKE_SELECT_CHK
DEFINE_LOCAL LWK_MONSNO
DEFINE_LOCAL LWK_EGG_CHK

//主人公方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL LCW_POSX
DEFINE_LOCAL LCW_POSZ


/**************************************************************/
/*  男性：話しかけ（オタマロ見せイベント）                    */
/**************************************************************/
EVENT_START   ev_c08r0402_man3_01

  _TALK_OBJ_START()

  //イベントクリア済みか
  IF FLAG_OFF( FE_C08R0402_MAN3_01 ) THEN

    //男性：ぼくは　オタマロを　だれよりも
    _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_01 )

    //オタマロを見せる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //男性：ありがとう！
      _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_02 )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      //手持ちのポケモンを選択する
      _SELECT_TEMOTI_POKE( LWK_POKE_SELECT_CHK, LWK_POKE_SELECT, 0 )

      IF $LWK_POKE_SELECT_CHK == TRUE THEN

        //選んだポケモンのナンバーを取得する
        _GET_PARTY_POKE_MONSNO( LWK_MONSNO, LWK_POKE_SELECT )
        //指定POSのポケモンはタマゴか（タマゴすけチェック追加：2012.03.05　水口）
        _CHECK_TEMOTI_EGG( LWK_EGG_CHK, LWK_POKE_SELECT )

        //選択したポケモンは「オタマロ」か
        IF $LWK_MONSNO == 535 && $LWK_EGG_CHK == FALSE THEN

          //男性：ナイスな　ボイスを　カモン！！
          _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_05 )
          _AB_KEYWAIT_MARK()
          _MSGWIN_CLOSE()

          //合唱イベントへジャンプ
          _CALL ev_c08r0402_me_call_01

          //男性：いや～……　すばらしい
          _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_06 )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()

          //========================================//
          //イベントクリアフラグON
          _FLAG_SET( FE_C08R0402_MAN3_01 )
          //========================================//

        //選んだポケモンは「オタマロ」ではない
        ELSE

          //男性：そのコは　オタマロじゃないよね
          _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_04 )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()

        ENDIF

      ELSE    //キャンセル

        //男性：そっか……　しかたがない……▼
        _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_03 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //男性：そっか……　しかたがない……▼
      _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //イベントクリア後（２回目以降）
  ELSE

    //男性：ナイスな　ボイスを　きくのかい？
    _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_07 )

    //オタマロを見せる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //男性：ありがとう！
      _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_02 )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      //手持ちのポケモンを選択する
      _SELECT_TEMOTI_POKE( LWK_POKE_SELECT_CHK, LWK_POKE_SELECT, 0 )

      IF $LWK_POKE_SELECT_CHK == TRUE THEN

        //選んだポケモンのナンバーを取得する
        _GET_PARTY_POKE_MONSNO( LWK_MONSNO, LWK_POKE_SELECT )
        //指定POSのポケモンはタマゴか（タマゴすけチェック追加：2012.03.05　水口）
        _CHECK_TEMOTI_EGG( LWK_EGG_CHK, LWK_POKE_SELECT )

        //選択したポケモンは「オタマロ」か
        IF $LWK_MONSNO == 535 && $LWK_EGG_CHK == FALSE THEN

          //男性：レッツ！　ハーモニー！！！
          _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_08 )
          _AB_KEYWAIT_MARK()
          _MSGWIN_CLOSE()

          //合唱イベントへジャンプ
          _CALL ev_c08r0402_me_call_01

          //男性：いや～……　ほんとうに
          _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_09 )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()

          //========================================//
          //イベントクリアフラグON
          _FLAG_SET( FE_C08R0402_MAN3_01 )
          //========================================//

        //選んだポケモンは「オタマロ」ではない
        ELSE

          //男性：そのコは　オタマロじゃないよね
          _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_04 )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()

        ENDIF

      ELSE    //キャンセル

        //男性：そっか……　しかたがない……▼
        _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_03 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //男性：そっか……　しかたがない……▼
      _BALLOONWIN_TALKOBJ_MSG( msg_c08r0402_man3_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

EVENT_END


//オタマロ合唱イベント
ev_c08r0402_me_call_01:

  //BGM停止
  //_START_EVENT_BGM( SEQ_BGM_SILENCE_FIELD )

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  //アニメ：主人公とマニア振り向き
  _OBJ_ANIME( C08R0402_MAN3_01, anm_common_turn_u )
  _TIME_WAIT( 3 )
  IF $LCW_POSX == 9 && $LCW_POSZ == 13 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 10, 12, FORCE_TYPE_NPC, 8, DIR_LR ) 
    _OBJ_ANIME_WAIT()
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
    _OBJ_ANIME_WAIT()
  ENDIF

  _TIME_WAIT( 8 )

  //暗転
  _BLACK_OUT_SLOW()
  _DISP_FADE_END_CHECK()

  //オタマロ01～05整列（再配置）
  _OBJ_POS_CHANGE( C08R0402_POKE37_01, 7, 0, 9, DIR_DOWN )
  _OBJ_POS_CHANGE( C08R0402_POKE37_02, 8, 0, 9, DIR_DOWN )
  _OBJ_POS_CHANGE( C08R0402_POKE37_03, 9, 0, 9, DIR_DOWN )
  _OBJ_POS_CHANGE( C08R0402_POKE37_04, 10, 0, 9, DIR_DOWN )
  _OBJ_POS_CHANGE( C08R0402_POKE37_05, 11, 0, 9, DIR_DOWN )

  //オタマロ06配置
  _OBJ_ADD_EX( 12, 9, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE37, MV_DMY )

  //暗転復帰
  _BLACK_IN_SLOW()
  _DISP_FADE_END_CHECK()

  _TIME_WAIT( 16 )

  //オタマロの歌
  _ME_PLAY( SEQ_ME_OTAMARO )
  _ME_WAIT()

  _TIME_WAIT( 8 )

  //暗転
  _BLACK_OUT_SLOW()
  _DISP_FADE_END_CHECK()

  //オタマロ01～05元いた場所へ
  _OBJ_POS_CHANGE( C08R0402_POKE37_01, 13, 0, 10, DIR_LEFT )
  _OBJ_POS_CHANGE( C08R0402_POKE37_02, 14, 0, 5, DIR_LEFT )
  _OBJ_POS_CHANGE( C08R0402_POKE37_03, 8, 0, 7, DIR_DOWN )
  _OBJ_POS_CHANGE( C08R0402_POKE37_04, 8, 0, 12, DIR_UP )
  _OBJ_POS_CHANGE( C08R0402_POKE37_05, 6, 0, 11, DIR_UP )

  //オタマロ06削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

  //暗転復帰
  _BLACK_IN_SLOW()
  _DISP_FADE_END_CHECK()

  _TIME_WAIT( 32 )

  //アニメ：主人公とマニア振り向き
  _OBJ_ANIME( C08R0402_MAN3_01, anm_common_turn_r )
  _TIME_WAIT( 3 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

_RET


/**************************************************************/
/*  オタマロ01：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_c08r0402_poke37_01
  _EASY_TALK_POKEVOICE( MONSNO_586, msg_c08r0402_poke37_01_01 )
EVENT_END

/**************************************************************/
/*  オタマロ02：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_c08r0402_poke37_02
  _EASY_TALK_POKEVOICE( MONSNO_586, msg_c08r0402_poke37_02_01 )
EVENT_END

/**************************************************************/
/*  オタマロ03：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_c08r0402_poke37_03
  _EASY_TALK_POKEVOICE( MONSNO_586, msg_c08r0402_poke37_03_01 )
EVENT_END

/**************************************************************/
/*  オタマロ04：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_c08r0402_poke37_04
  _EASY_TALK_POKEVOICE( MONSNO_586, msg_c08r0402_poke37_04_01 )
EVENT_END

/**************************************************************/
/*  オタマロ05：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_c08r0402_poke37_05
  _EASY_TALK_POKEVOICE( MONSNO_586, msg_c08r0402_poke37_05_01 )
EVENT_END


//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

