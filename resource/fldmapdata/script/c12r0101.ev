  .text

  .include  "scr_seq_def.h"
  .include  "msg_c12r0101.h"
  .include  "c12r0101.h"
  .include  "pair_scr_def.h"
  .include  "c12.h"
  .include  "c12_def.h"
  
  //@author Mizuguchi_Mai
  //@author suginaka_katsunori//調整

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c12r0101
_EVENT_DATA    ev_init_c12r0101
_EVENT_DATA    ev_pos_c12r0101_startevents
_EVENT_DATA    ev_c12r0101_swmama_01
_EVENT_DATA    ev_c12r0101_swbell_01
_EVENT_DATA    ev_bg_c12r0101_wii_01
_EVENT_DATA    ev_bg_c12r0101_bed_01
_EVENT_DATA    ev_bg_c12r0101_pc_01
_EVENT_DATA    ev_bg_c12r0101_prize1_01
_EVENT_DATA    ev_bg_c12r0101_prize2_01
_EVENT_DATA    ev_c12r0101_trorhy1_01
_EVENT_DATA    ev_c12r0101_trorhy2_01
_EVENT_DATA    ev_c12r0101_trorhy3_01
_EVENT_DATA    ev_bg_c12r0101_souvenir_01
_EVENT_DATA    ev_bg_c12r0101_souvenir_02
_EVENT_DATA    ev_pos_c12r0101_gameclear
_EVENT_DATA	ev_reserve_c12r0101_event_01
_EVENT_DATA    ev_recover_c12r0101
_EVENT_DATA_END

//ママのPOSイベントで使用
DEFINE_LOCAL	ans_yes

//------------------------！注意！------------------------------//
//																//
//		LOCALWORK11を回復判定ワークに使用			//
//		LOCALWORK12をランダムセリフに使用			//
//		ゾーン内での使用を禁止します							//
//																//
//--------------------------------------------------------------//

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c12r0101
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c12r0101

  //ベル滞在中はOBJ配置を変更
  IF $WK_SCENE_R19 >= 1 && FLAG_OFF( C12R0101_SWBELL_01 ) THEN
    _OBJ_POS_CHANGE( C12R0101_SWMAMA_01, 4, 0, 5, DIR_RIGHT )
  
  //ゲーム開始後イベント
  ELSIF $WK_SCENE_C12R0101 == 1 && FLAG_OFF( FV_C12R0101_SWMAMA )  THEN
    _OBJ_POS_CHANGE( C12R0101_SWMAMA_01, 4, 0, 5, DIR_DOWN )
  ENDIF
  
  // 表彰状のBGイベントを移動
  _CALL set_prize_bg

INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_recover_c12r0101

  // 表彰状のBGイベントを移動
  _CALL set_prize_bg

INIT_EVENT_END

set_prize_bg:

  IF FLAG_OFF( FV_C12R0101_PRIZE1_01 ) THEN
    _SXY_MOVE_BG_EVENT(BG_C12R0101_PRIZE1,11,0,1)
  ENDIF
  IF FLAG_OFF( FV_C12R0101_PRIZE2_01 ) THEN
    _SXY_MOVE_BG_EVENT(BG_C12R0101_PRIZE2,12,0,1)
  ENDIF

_RET

/************************************************************/
/*	リザーブ：オープニング用							*/
/************************************************************/
EVENT_START	ev_reserve_c12r0101_event_01

	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//カメラ操作　ちょっと上のほうを初期位置にする
	_CAMERA_MOVE( 9688,0,970752,360448,0,688128,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_MAP_FADE_BLACK_IN()
	_MAP_FADE_END_CHECK()

	//階段SE再生
	_SE_PLAY( SEQ_SE_KAIDAN )

	//ママ表示
	//========================================//
	_FLAG_RESET( FV_C12R0101_SWMAMA )
	//========================================//
	_OBJ_ADD( C12R0101_SWMAMA_01 )
	_SE_WAIT()

	_OBJ_ANIME_AUTO( C12R0101_SWMAMA_01, 5, 8, FORCE_TYPE_NOT, 8, DIR_UD )
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME( C12R0101_SWMAMA_01, anm_staystep_r )
	_OBJ_ANIME_WAIT()

	//メッセージ：ただいま！
	_PLAYER_NAME( 0 )
	_BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_01, C12R0101_SWMAMA_01, POS_UP )
	_MSGWIN_CLOSE()

	_CAMERA_RECV_MOVE(40)	//カメラ復帰移動
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	//カメラ処理終了
	_CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
	_CAMERA_END()		//カメラ操作終了

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
	_OBJ_ANIME_WAIT()

EVENT_END


/************************************************************/
/*					POS：ママ登場					*/
/************************************************************/
EVENT_START ev_pos_c12r0101_startevents

  //アニメ：ママ隣接
  _OBJ_ANIME_AUTO( C12R0101_SWMAMA_01, 9, 8, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //メッセージ：アララギはかせって
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_02, C12R0101_SWMAMA_01, POS_UP )
  
  //メッセージ：自分のパートナーがほしい？
  _PLAYER_NAME( 0 ) //プレイヤー名を反映
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_03,C12R0101_SWMAMA_01, POS_UP )
  _YES_NO_WIN( SCWK_ANSWER )

  //いいえなら再質問
  IF $SCWK_ANSWER == SCR_NO THEN
    //いいえの処理
    
    //再質問にyesと答えるまでループ
    $ans_yes = SCR_NO

    WHILE $ans_yes == SCR_NO
      _MSGWIN_CLOSE()
      //アニメ：１歩後ずさる
      _OBJ_ANIME( C12R0101_SWMAMA_01, anm_common_gyoe )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( C12R0101_SWMAMA_01, anm_c12r0101_mama_backstep_01 )
      _OBJ_ANIME_WAIT()
      
      //メッセージ：ええーちょっとおどろき
     _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_05,C12R0101_SWMAMA_01, POS_UP )
     _MSGWIN_CLOSE()
     
     //アニメ：もとの位置に戻る
     _OBJ_ANIME( C12R0101_SWMAMA_01, anm_c12r0101_mama_backstep_02 )
     _OBJ_ANIME_WAIT()
     
     //メッセージ：もういちど
     _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_04,C12R0101_SWMAMA_01, POS_UP )
     _YES_NO_WIN( ans_yes )
   ENDWHILE
  ENDIF

  //はいを選択した
  //メッセージ：よし　だい１ステップクリア
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_06,C12R0101_SWMAMA_01, POS_UP )
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はいの場合
  IF $SCWK_ANSWER == SCR_YES THEN
  	//さすが！
  	_BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_08,C12R0101_SWMAMA_01, POS_UP )
  ELSE
  	//そっか…
  	_BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_09,C12R0101_SWMAMA_01, POS_UP )
  ENDIF

  //メッセージ：またまた質問です
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_10,C12R0101_SWMAMA_01, POS_UP )
  _YES_NO_WIN( SCWK_ANSWER )

  //いいえなら再質問
  IF $SCWK_ANSWER == SCR_NO THEN
    //いいえの処理
    
    //再質問にyesと答えるまでループ
    $ans_yes = SCR_NO

    WHILE $ans_yes == SCR_NO
     //メッセージ：ママがききたいのは
     _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_12,C12R0101_SWMAMA_01, POS_UP )
     _YES_NO_WIN( ans_yes )
   ENDWHILE
  ENDIF
  
  //よし！だい２ステップクリア！
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_11,C12R0101_SWMAMA_01, POS_UP )
  
  //ライブキャスターを既に使用している場合
  IF FLAG_ON( FH_01 ) THEN

  	//メッセージ：プレイヤー！あなたの　やるべきことが　きまったわ
  	_PLAYER_NAME( 0 ) //プレイヤー名を反映
  	_BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_13,C12R0101_SWMAMA_01, POS_UP )
  	_AB_KEYWAIT_MARK()
  	_MSGWIN_CLOSE()
  
  //ライブキャスターをまだ使用していない場合
  ELSE

  	//メッセージ：プレイヤー！あなたの　やるべきことが　きまったわ
  	_PLAYER_NAME( 0 ) //プレイヤー名を反映
  	_BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_14,C12R0101_SWMAMA_01, POS_UP )
  	_YES_NO_WIN( SCWK_ANSWER )
  	
  	//はいの場合
  	IF $SCWK_ANSWER == SCR_YES THEN 
  	
  		_BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_07,C12R0101_SWMAMA_01, POS_UP )
 	 	_AB_KEYWAIT_MARK()
  		_MSGWIN_CLOSE()
  	
  	//いいえの場合
  	ELSE
  	
  		_BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_15,C12R0101_SWMAMA_01, POS_UP )
 	 	_AB_KEYWAIT_MARK()
  		_MSGWIN_CLOSE()
  		
  	ENDIF

  ENDIF

  //アニメ：通れるように移動
  _OBJ_ANIME_AUTO( C12R0101_SWMAMA_01, 8, 7, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12R0101_SWMAMA_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //========================================//
  //POSイベント無効
  $WK_SCENE_C12R0101 = 1
  
  _PERSON_TVT_CALL_SET_MOTHER()
  
  //========================================//

EVENT_END

/************************************************************/
/*					SCENE_CHANGE：アララギ父登場					*/
/************************************************************/
EVENT_START ev_pos_c12r0101_gameclear
  
  //主人公名格納
  _PLAYER_NAME( 0 )
  
  //アニメ：ママ「！」
  _OBJ_ANIME( C12R0101_SWMAMA_01, anm_common_gyoe)
  _OBJ_ANIME_WAIT()
  
  //アニメ：ママ隣接
  _OBJ_ANIME_AUTO( C12R0101_SWMAMA_01, 9, 8, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //ママ：おかえり！
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_end_01, C12R0101_SWMAMA_01, POS_DEFAULT )
  
  //ママ：なんだか
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_end_02, C12R0101_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公・ママ部屋中央に移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 5, 6, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_AUTO( C12R0101_SWMAMA_01, 4, 6, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //アニメ：主人公・ママ玄関を見る
  _OBJ_ANIME( C12R0101_SWMAMA_01, anm_staystep_d)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //フィールド上にアララギ父配置
  _OBJ_ADD_EX( 5, 10, DIR_UP, MMDL_ID_EVENTOBJ_00, HAKASE1, MV_DMY )
  _SE_WAIT()
  
  //博士BGMスタート
  _START_EVENT_BGM(SEQ_BGM_E_DOCTOR2)
  
  //アララギ父：おお！おまえさんが
  _BALLOONWIN_OBJMSG_POS( msg_d08_hakase1_01, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アララギ父隣接
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 5, 8, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ママ：そうですけれど
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_end_03, C12R0101_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アララギ父：そんなに
  _BALLOONWIN_OBJMSG_POS( msg_d08_hakase1_02, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アララギ父：プレイヤー名！　殿堂入りを記念して
  _BALLOONWIN_OBJMSG_POS( msg_d08_hakase1_03, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アララギ父隣接
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 5, 7, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //------------全国図鑑入手------------//
  
  _ME_PLAY( SEQ_ME_KEYITEM )
  _PLAYER_NAME( 0 )
  _SYSWIN_MSG( msg_d08_hakase1_04, POS_DEFAULT )		//図鑑がパワーアップした
  _ME_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //全国図鑑入手フラグをセット
  _SET_ZENKOKU_ZUKAN_FLAG()
  //------------------------------------//
  
  //アニメ：アララギ父戻る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_c12r0101_hakase2_backstep_01)
  _OBJ_ANIME_WAIT()
  
  //アララギ父：どこが
  _BALLOONWIN_OBJMSG_POS( msg_d08_hakase1_05, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ママ：へえ！
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_end_04, C12R0101_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アララギ父：ははは
  _BALLOONWIN_OBJMSG_POS( msg_d08_hakase1_06, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  
  //アララギ父：おまえさん！
  _BALLOONWIN_OBJMSG_POS( msg_d08_hakase1_07, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アララギ父出口へ
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 5, 10, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //アララギ父動作モデル削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  _SE_WAIT()
  
  //BGM終了
  _END_EVENT_BGM()
  
  //アニメ：主人公・ママ向き合う
  _OBJ_ANIME( C12R0101_SWMAMA_01, anm_staystep_r)
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l)
  _OBJ_ANIME_WAIT()
  
  //ママ：いっちゃった
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_end_05, C12R0101_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _ITEM_EVENT_KEYWAIT( ITEM_GENKINOKATAMARI, 2 )
	
  //ママ：なにをしても
  _BALLOONWIN_OBJMSG_POS( msg_c12r0101_swmama_end_06, C12R0101_SWMAMA_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //========================================//
  //POSイベント無効
  $WK_SCENE_C12R0101 = 3

  //c12:ヒオウギシティにライバルと妹をセット
  _FLAG_RESET( FV_C12_SWRIVAL )
  _FLAG_RESET( FV_C12_SWRIVAL_SISTER )
  $WK_SCENE_SPPOKE_EVENT_01 = 1

  //========================================//

EVENT_END

/************************************************************/
/*					ママ会話					*/
/************************************************************/
EVENT_START ev_c12r0101_swmama_01

  //クリア後
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swmama_end_06 )
  
  ELSIF FLAG_ON( SYS_FLAG_PAIR ) THEN
  
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swmama_rival_01 )
  
  //まだベルイベントを終えていない
  ELSIF $WK_SCENE_C12_WHITE_MEET < 2 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swmama_07 )
  
  //高台でベルと会った後
  ELSE
    //ママの回復イベントへ
    _CALL		ev_everyday
  ENDIF
  
EVENT_END

//ママの回復イベント
ev_everyday:

  _TALK_OBJ_START()
  //回復済みなら一言メッセージ
  IF $LOCALWORK15 == 999 THEN
    _PLAYER_NAME( 0 )
    
    _CALL	ev_rndmes
    
    //ランダムでメッセージ分岐（５パターン）
    _BALLOONWIN_TALKOBJ_MSG( SCWK_TEMP0 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
_RET
  ENDIF

  //上記の条件に当てはまらなければ回復イベント開始
   //ポケモンは元気？
  _PLAYER_NAME( 0 )
  _BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swmama_cure_01 )
  _MSGWIN_CLOSE()

  _CALL	ev_kaifuku		//回復処理

  _GET_RND( LOCALWORK10, 5 )

  _CALL	ev_rndmes

  _BALLOONWIN_TALKOBJ_MSG( SCWK_TEMP0 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

_RET


//回復処理
ev_kaifuku:
  //暗転して手持ちポケモンを回復
  _BLACK_OUT()
  _DISP_FADE_END_CHECK()
  _TEMOTI_POKEMON_KAIFUKU()		//回復処理
  _ME_PLAY( SEQ_ME_ASA )
  _ME_WAIT()
  _BLACK_IN()
  _DISP_FADE_END_CHECK()

  //回復済みチェック用にローカルワークに値を代入
  $LOCALWORK15 = 999

  //レコードをカウント（自宅休憩回数）
  _ADD_RECORD( RECID_RECOVERY_HOME, 1 )

_RET

//ランダムメッセージ処理
ev_rndmes:

  //ランダムでメッセージ分岐（５パターン）
  _PLAYER_NAME( 0 )
  SWITCH $LOCALWORK10
  CASE 0 THEN
	$SCWK_TEMP0 = msg_c12r0101_swmama_cure_02
  CASE 1 THEN
	$SCWK_TEMP0 = msg_c12r0101_swmama_cure_03
  CASE 2 THEN
	$SCWK_TEMP0 = msg_c12r0101_swmama_cure_04
  CASE 3 THEN
	$SCWK_TEMP0 = msg_c12r0101_swmama_cure_05
  CASE 4 THEN
	$SCWK_TEMP0 = msg_c12r0101_swmama_cure_06
  ENDSWITCH

_RET

/************************************************************/
/*					ベル会話					*/
/************************************************************/
EVENT_START ev_c12r0101_swbell_01
	
	//クリア後の場合
	IF $WK_SCENE_SPPOKE_EVENT_01 == 1 THEN
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swbell_end_01 )
	//ＵＭＡイベント開始
	ELSIF $WK_SCENE_SPPOKE_EVENT_01 == 4 THEN
		_CALL ev_bell_rnd
	//それ以外
	ELSE
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_white_01 )
	ENDIF

EVENT_END

ev_bell_rnd:

_GET_RND(SCWK_ANSWER,5)
SWITCH $SCWK_ANSWER
CASE 0 THEN
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swbell_end_02 )
CASE 1 THEN
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swbell_end_03 )
CASE 2 THEN
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swbell_end_04 )
CASE 3 THEN
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swbell_end_05 )
CASE 4 THEN
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0101_swbell_end_06 )
ENDSWITCH

_RET

/************************************************************/
/*					BG：WII					*/
/************************************************************/
EVENT_START ev_bg_c12r0101_wii_01
  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_c12r0101_game_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
EVENT_END

/************************************************************/
/*					BG：bed					*/
/************************************************************/
EVENT_START ev_bg_c12r0101_bed_01
  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_c12r0101_bed_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
EVENT_END

/************************************************************/
/*					BG：pc					*/
/************************************************************/
EVENT_START ev_bg_c12r0101_pc_01
  _PLAYER_NAME( 0 )
  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_c12r0101_pc_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
EVENT_END

/************************************************************/
/*						表彰状（地方）						*/
/************************************************************/
EVENT_START   ev_bg_c12r0101_prize1_01
	_TALK_START_SE_PLAY()
	
	//イッシュ図鑑完成の賞状だ！
	_PLAINWIN_MSG_DOWN( msg_c12r0101_award1_01 )
	_MSGWIN_CLOSE()
	
	_CALL_ZUKAN_AWARD( SCR_ZUKAN_AWARD_CHIHOU, 1 )
	
EVENT_END


/************************************************************/
/*						表彰状（全国）						*/
/************************************************************/
EVENT_START   ev_bg_c12r0101_prize2_01
	_TALK_START_SE_PLAY()
	
	//イッシュ図鑑完成の賞状だ！
	_PLAINWIN_MSG_DOWN( msg_c12r0101_award2_01 )
	_MSGWIN_CLOSE()
	
	_CALL_ZUKAN_AWARD( SCR_ZUKAN_AWARD_ZENKOKU, 1 )
	
EVENT_END


