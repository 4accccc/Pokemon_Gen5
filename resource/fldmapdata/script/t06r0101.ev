  .text

  .include  "scr_seq_def.h"
  .include  "msg_t06r0101.h"
  .include  "t06r0101.h"

  //@author Mizuguchi_Mai
  //@author fujimura_souichirou（クリア後イベント）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_t06r0101
_EVENT_DATA    ev_init_t06r0101
_EVENT_DATA    ev_scene_t06r0101_champion_01
_EVENT_DATA    ev_t06r0101_champion_01
_EVENT_DATA    ev_t06r0101_girl3_01
_EVENT_DATA    ev_t06r0101_boy3_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//無限ダンジョンの状態を取得する用変数
DEFINE_LOCAL  LWK_DUNGEON_STATUS


/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_t06r0101
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_t06r0101
	//イベントの値によって人物のの初期位置を変更する
  IF $WK_SCENE_T06R0101 == 0 THEN
    _OBJ_POS_CHANGE( T06R0101_CHAMPION_01, 6, 0, 11, DIR_UP )
  ENDIF
INIT_EVENT_END

/************************************************************/
/*					CHENE_CHANGE：子どもと対戦						*/
/************************************************************/
EVENT_START ev_scene_t06r0101_champion_01
 
  //アニメ：アテグと主人公入室
  _OBJ_ANIME( T06R0101_CHAMPION_01, anm_champion_goto_children )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_goto_children )
  _OBJ_ANIME_WAIT()

  //アニメ：子どもたち下を向く
  _OBJ_ANIME( T06R0101_BOY3_01, anm_childoren_look_pl )
  _OBJ_ANIME( T06R0101_GIRL3_01, anm_childoren_look_pl )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：あっ！
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_girl3_01,T06R0101_GIRL3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：えー！
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_boy3_01,T06R0101_BOY3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：おう！
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_01,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公とアデク向き合う
  _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：というわけで
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_02,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公とアテグ上を向く・BOY3隣接
  _OBJ_ANIME_AUTO( T06R0101_BOY3_01, 6, 9, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_u )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：ぼくの　ポケモンの
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_boy3_02,T06R0101_BOY3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //戦闘処理
  _TRAINER_BTL_SET( TRID_SCHOOLB_11, 0 )
  _CALL ev_battle_check
  
  //アニメ：BOY3定位置に戻る
  _OBJ_ANIME( T06R0101_BOY3_01, anm_boy3_back )
  
  //メッセージ：ポケモンのさてつぎは
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_03,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  _OBJ_ANIME_WAIT()
  
  //メッセージ：はーい！
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_girl3_02,T06R0101_GIRL3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：その前に
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_04,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公のほうを向く
	_OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_l )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //【仮】回復処理（メッセージが必要かも）
  _SE_PLAY( SEQ_SE_RECOVERY )
  _SE_WAIT()
	//回復処理
	_TEMOTI_POKEMON_KAIFUKU()
	
	//アニメ：GIRL3と主人公向き合う
	_OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_u )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
	_OBJ_ANIME_AUTO( T06R0101_GIRL3_01, 6, 9, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //メッセージ：あたしは　ポケモンに
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_girl3_03,T06R0101_GIRL3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //戦闘処理
  _TRAINER_BTL_SET( TRID_SCHOOLG_09, 0 )
  _CALL ev_battle_check
  
  //メッセージ：こころおどる
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_05,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_l )
  _OBJ_ANIME( T06R0101_GIRL3_01, anm_girl3_back )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：どうだ
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_06,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：でもね
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_girl3_04,T06R0101_GIRL3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：よければ
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_10,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //オレンのみ入手処理
	_ITEM_EVENT_KEYWAIT(ITEM_ORENNOMI, 5)
	
	//メッセージ：であうはずの
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_11,T06R0101_CHAMPION_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //========================================//
  //SCENE_CHANGE無効
  $WK_SCENE_T06R0101 = 1
  
  //T06のSCENE_CHANGE有効（メダルおやじ導入イベント）
  $WK_SCENE_T06 = 5
  
  //T06のメダルおやじを表示
	_FLAG_RESET( FV_T06_SUNGLASSES_01 )
	
  //========================================//
  
EVENT_END

//戦闘チェック
ev_battle_check:
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
_RET

//--------------------------------------------------------------------
//	チャンピオン：入室
//--------------------------------------------------------------------
_ANIME_LABEL	anm_champion_goto_children
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：入室
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_goto_children
  _ANIME_DATA	AC_WALK_U_8F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	子ども：主人公に気がつく
//--------------------------------------------------------------------
_ANIME_LABEL	anm_childoren_look_pl
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	BOY3：定位置に戻る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_boy3_back
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	GIRL3：定位置に戻る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_girl3_back
  _ANIME_DATA	AC_WALK_L_8F,1
  _ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*  アデク：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_t06r0101_champion_01

  //無限ダンジョンの進行具合で台詞が分岐
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  //クリア後ならセリフを分岐
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN

    //アデク戦前
    IF FLAG_OFF( FE_T06R0101_CHAMPION_WIN_01 ) THEN

      //イベントへ
      _CALL ev_mugenboss_01

    //アデク戦後（バンジロウ対戦前）
    ELSIF FLAG_ON( FE_T06R0101_CHAMPION_WIN_01 ) && $LWK_DUNGEON_STATUS <= 9 THEN

      _TALK_OBJ_START()
      //アデク：わが　まご　ながら
      _BALLOONWIN_OBJMSG_WB( msg_t06r0101_champion_end_10w, msg_t06r0101_champion_end_10b, T06R0101_CHAMPION_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    //バンジロウ対戦後
    ELSIF $LWK_DUNGEON_STATUS >= 10 THEN

      _TALK_OBJ_START()
      //アデク：おまえさんが
      _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_11, T06R0101_CHAMPION_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //クリア前
  ELSE

    _GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_01 )

    //ヒオウギジムバッジを入手していない
    IF $SCWK_TEMP0 == 0 THEN
      //アデク：それが　たびの　よさ　だな
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t06r0101_champion_11 )

    //ジムバッジ入手後
    ELSE
      //アデク：ちからを　ひきだせたけっかだな
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t06r0101_champion_12 )

    ENDIF

  ENDIF

EVENT_END

//アデク戦＆無限ダンジョンボス
ev_mugenboss_01:

  _TALK_OBJ_START()

  //WBT登場前
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN    //【仮】クリアフラグで分岐中
    //アデク：イッシュちほうで　さいきょうの
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_01, T06R0101_CHAMPION_01, POS_DEFAULT )

  //WBT登場後
  ELSE
    //アデク：かれらにも　トレーナーの　すごみを
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_02, T06R0101_CHAMPION_01, POS_DEFAULT )

  ENDIF

  //アデクと戦う？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい

    //アデク：こころが　おどる！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_03, T06R0101_CHAMPION_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_CHAMPION_01, 0 )

    //結果チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()
    ELSE
      _TRAINER_LOSE()
    ENDIF

    //アデク：さすがだな
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_05, T06R0101_CHAMPION_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    _TIME_WAIT( 16 )

    //階段SE再生
    _SE_PLAY( SEQ_SE_KAIDAN )

    //SE待ち
    _SE_WAIT()

     //フィールド上にバンジロウ配置
    _OBJ_ADD_EX( 6, 12, DIR_UP, MMDL_ID_EVENTOBJ_00, MUGENBOSS, MV_DMY )

    //プレイヤーの向きを取得
    _PLAYER_DIR_GET( LWK_DIR ) 
    //主人公が上を向いていなかった場合、アデク振り向き
    IF $LWK_DIR != DIR_UP THEN
      //アニメ：アデク振り向き
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_d )
    ENDIF

    //アニメ：バンジロウ登場
    _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 6, FORCE_TYPE_NPC, 4, DIR_UD )
    _OBJ_ANIME_WAIT()

    //バンジロウ：じーちゃん！▼（バージョンでセリフが異なる）
    _BALLOONWIN_OBJMSG_WB( msg_t06r0101_mugenboss_end_01w, msg_t06r0101_mugenboss_end_01b, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
    //主人公移動
    IF $LCW_POSX == 6 && $LCW_POSZ == 2 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 5, 3, FORCE_TYPE_NPC, 8, DIR_LR )
      _OBJ_ANIME_WAIT()
    ELSE
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    ENDIF
    _OBJ_ANIME_WAIT()

    //アデク：バンジロウでは　ないか！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_06, T06R0101_CHAMPION_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //バンジロウ：おーい！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_02, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
    //バンジロウ、主人公に接近
    IF $LCW_POSX == 6 && $LCW_POSZ == 4 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 5, FORCE_TYPE_NPC, 8, DIR_UD )
    ELSIF $LCW_POSX == 7 && $LCW_POSZ == 3 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 7, 5, FORCE_TYPE_NPC, 8, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_u )
    ELSIF $LCW_POSX == 5 && $LCW_POSZ == 3 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 5, 5, FORCE_TYPE_NPC, 8, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_u )
    ENDIF
    _OBJ_ANIME_WAIT()

    //アニメ：バンジロウ「？」
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_common_hatena )
    _OBJ_ANIME_WAIT()

    //バンジロウ：で　だれ　こいつ？▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_03, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //プレイヤーネームを格納
    _PLAYER_NAME( 0 )

    //性別が格納されるローカル変数を定義
    DEFINE_LOCAL SCWK_SEX
    _GET_MY_SEX( SCWK_SEX )

    //男性だった場合
    IF $SCWK_SEX == PM_MALE THEN

      //アデク：かれの　なまえは
      _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_07, T06R0101_CHAMPION_01, POS_DEFAULT )
      _MSGWIN_CLOSE()

    //女性だった場合
    ELSE

      //アデク：かのじょの　なまえは
      _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_08, T06R0101_CHAMPION_01, POS_DEFAULT )
      _MSGWIN_CLOSE()

    ENDIF

    //バンジロウ：やっぱりか！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_04, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //アデク：どうだ？　バンジロウ
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_09, T06R0101_CHAMPION_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //バンジロウ：ダメだ！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_05, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )

    //バンジロウ：じぶんの　ポケモンたちと！▼（バージョンでセリフが異なる）
    _BALLOONWIN_OBJMSG_WB( msg_t06r0101_mugenboss_end_06w, msg_t06r0101_mugenboss_end_06b, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )

    //プレイヤーネームを格納
    _PLAYER_NAME( 0 )
    //バンジロウ：じゃな！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_07, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
    //アニメ：バンジロウ退場
    IF $LCW_POSX == 6 && $LCW_POSZ == 4 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 12, FORCE_TYPE_NPC, 4, DIR_UD )
    ELSE
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 6, FORCE_TYPE_NPC, 4, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 12, FORCE_TYPE_NPC, 4, DIR_UD )
    ENDIF
    _OBJ_ANIME_WAIT()
    _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
    _SE_PLAY( SEQ_SE_KAIDAN )    //階段SE再生
    _SE_WAIT()    //SE待ち

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
    //主人公とアデク向き合う
    IF $LCW_POSX == 6 && $LCW_POSZ == 4 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    ELSIF $LCW_POSX == 7 && $LCW_POSZ == 3 THEN
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_r )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    ELSIF $LCW_POSX == 5 && $LCW_POSZ == 3 THEN
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_l )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    ENDIF
    _OBJ_ANIME_WAIT()

    //アデク：わが　まご　ながら
    _BALLOONWIN_OBJMSG_WB( msg_t06r0101_champion_end_10w, msg_t06r0101_champion_end_10b, T06R0101_CHAMPION_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //========================================//
    //アデク（クリア後）に勝利した
    _FLAG_SET( FE_T06R0101_CHAMPION_WIN_01 )
    //========================================//

  ELSE

    //アデク：ふむう……
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_04, T06R0101_CHAMPION_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

_RET

/**************************************************************/
/* BOY3はなしかけ                                         */
/**************************************************************/
EVENT_START   ev_t06r0101_girl3_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t06r0101_girl3_05 )
EVENT_END


/**************************************************************/
/* GIRL3はなしかけ                                         */
/**************************************************************/
EVENT_START   ev_t06r0101_boy3_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t06r0101_boy3_03 )
EVENT_END


