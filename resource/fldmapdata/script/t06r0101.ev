
//======================================================================
//                t06r0101.ev
//
//    スクリプトファイル：t06r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_t06r0101.h"
  .include  "t06r0101.h"

  //@author Mizuguchi_Mai（初回・バンジロウ話しかけ）
  //@author fujimura_souichirou（バンジロウ登場）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_t06r0101
_EVENT_DATA    ev_init_t06r0101
_EVENT_DATA    ev_scene_t06r0101_champion_01
_EVENT_DATA    ev_t06r0101_champion_01
_EVENT_DATA    ev_t06r0101_girl3_01
_EVENT_DATA    ev_t06r0101_boy3_01
_EVENT_DATA    ev_t06r0101_mugenboss_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//無限ダンジョンの状態を取得する用変数
DEFINE_LOCAL  LWK_DUNGEON_STATUS


/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_t06r0101
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_t06r0101
	//イベントの値によって人物のの初期位置を変更する
  IF $WK_SCENE_T06R0101 == 0 THEN
    _OBJ_POS_CHANGE( T06R0101_CHAMPION_01, 6, 0, 11, DIR_UP )
  ENDIF
INIT_EVENT_END

/************************************************************/
/*					CHENE_CHANGE：子どもと対戦						*/
/************************************************************/
EVENT_START ev_scene_t06r0101_champion_01
 
  //アニメ：アテグと主人公入室
  _OBJ_ANIME( T06R0101_CHAMPION_01, anm_champion_goto_children )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_goto_children )
  _OBJ_ANIME_WAIT()

  //アニメ：子どもたち下を向く
  _OBJ_ANIME( T06R0101_BOY3_01, anm_childoren_look_pl )
  _OBJ_ANIME( T06R0101_GIRL3_01, anm_childoren_look_pl )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：あっ！
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_girl3_01,T06R0101_GIRL3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：えー！
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_boy3_01,T06R0101_BOY3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：おう！
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_01,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公とアデク向き合う
  _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：というわけで
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_02,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公とアテグ上を向く・BOY3隣接
  _OBJ_ANIME_AUTO( T06R0101_BOY3_01, 6, 9, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_u )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：ぼくの　ポケモンの
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_boy3_02,T06R0101_BOY3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //戦闘処理
  //最初の３匹によって分岐
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_BTL_SET( TRID_SCHOOLB_11, 0 )
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_BTL_SET( TRID_SCHOOLB_17, 0 )
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_BTL_SET( TRID_SCHOOLB_18, 0 )
  ENDIF
  _CALL ev_battle_check
  
  //アニメ：BOY3定位置に戻る
  _OBJ_ANIME( T06R0101_BOY3_01, anm_boy3_back )
  
  //メッセージ：ポケモンのさてつぎは
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_03,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  _OBJ_ANIME_WAIT()
  
  //メッセージ：はーい！
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_girl3_02,T06R0101_GIRL3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：その前に
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_04,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公のほうを向く
	_OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_l )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //回復処理
  _SE_PLAY( SEQ_SE_RECOVERY )
  _SE_WAIT()
	//回復処理
	_TEMOTI_POKEMON_KAIFUKU()
	
	//アニメ：GIRL3と主人公向き合う
	_OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_u )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
	_OBJ_ANIME_AUTO( T06R0101_GIRL3_01, 6, 9, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //メッセージ：あいしょうが
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_girl3_03,T06R0101_GIRL3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //戦闘処理
  //最初の３匹によって分岐
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_BTL_SET( TRID_SCHOOLG_09, 0 )
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_BTL_SET( TRID_SCHOOLG_15, 0 )
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_BTL_SET( TRID_SCHOOLG_16, 0 )
  ENDIF
  _CALL ev_battle_check
  
  //メッセージ：こころおどる
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_05,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME( T06R0101_GIRL3_01, anm_girl3_back )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：どうだ
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_06,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：でもね
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_girl3_04,T06R0101_GIRL3_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //瀕死・タマゴを除くポケモンの先頭を選択
  DEFINE_LOCAL LWK_FRONT
  _GET_PARTY_FRONT_POKEMON  ( LWK_FRONT , POKECOUNT_MODE_BATTLE_ENABLE )
  //先頭ポケモンの名前を取得
  _TEMOTI_MONS_NAME  (  1 , LWK_FRONT  )
  
  //メッセージ：では　がんばった
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_10,T06R0101_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //回復処理
  _SE_PLAY( SEQ_SE_RECOVERY )
  _SE_WAIT()
	//回復処理
	_TEMOTI_POKEMON_KAIFUKU()
	
	//メッセージ：であうはずの
  _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_11,T06R0101_CHAMPION_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //========================================//
  //SCENE_CHANGE無効
  $WK_SCENE_T06R0101 = 1
  
  //T06のSCENE_CHANGE有効（メダルおやじ導入イベント）
  $WK_SCENE_T06 = 5
  
  //T06のメダルおやじを表示
	_FLAG_RESET( FV_T06_SUNGLASSES_01 )
	
	//R19のきのみPOS有効
  $WK_SCENE_R19 = 3
	
  //========================================//
  
EVENT_END

//戦闘チェック
ev_battle_check:
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
_RET

//--------------------------------------------------------------------
//	チャンピオン：入室
//--------------------------------------------------------------------
_ANIME_LABEL	anm_champion_goto_children
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：入室
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_goto_children
  _ANIME_DATA	AC_WALK_U_8F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	子ども：主人公に気がつく
//--------------------------------------------------------------------
_ANIME_LABEL	anm_childoren_look_pl
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	BOY3：定位置に戻る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_boy3_back
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	GIRL3：定位置に戻る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_girl3_back
  _ANIME_DATA	AC_WALK_L_8F,1
  _ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*  アデク：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_t06r0101_champion_01

  //無限ダンジョンの進行具合で台詞が分岐
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  //クリア後ならセリフを分岐
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN

    //アデク戦前
    IF FLAG_OFF( FE_T06R0101_CHAMPION_WIN_01 ) THEN

      //イベントへ
      _CALL ev_mugenboss_01

    //アデク戦後（バンジロウ対戦前）
    ELSIF FLAG_ON( FE_T06R0101_CHAMPION_WIN_01 ) && $LWK_DUNGEON_STATUS <= 9 THEN

      _TALK_OBJ_START()
      //アデク：わが　まご　ながら
      _BALLOONWIN_OBJMSG_WB( msg_t06r0101_champion_end_10w, msg_t06r0101_champion_end_10b, T06R0101_CHAMPION_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    //バンジロウ対戦後
    ELSIF $LWK_DUNGEON_STATUS >= 10 THEN

      _TALK_OBJ_START()
      //アデク：おまえさんが
      _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_11, T06R0101_CHAMPION_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF
  
  ELSE
{
    
    _GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_01 )
    
    //バッジ数カウント
     DEFINE_LOCAL  LCW_BADGE_COUNT
    //バッジ数
    _GET_BADGE_COUNT( LCW_BADGE_COUNT )
    
    //ヒオウギジムバッジを入手していない
    IF $SCWK_TEMP0 == 0 THEN
      //アデク：それが　たびの　よさ　だな
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t06r0101_champion_11 )
    
    //タチワキシティバッジ入手後
    ELSIF $LCW_BADGE_COUNT > 1 THEN
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t06r0101_champion_13 )
      
    //ヒオウギジムバッジ入手後
    ELSE
      //アデク：ちからを　ひきだせたけっかだな
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t06r0101_champion_12 )

    ENDIF
}
  ENDIF

EVENT_END

//アデク戦＆無限ダンジョンボス
ev_mugenboss_01:

_TALK_OBJ_START()
{
  _WBT_GET_TRAINER_FLAG( 19, LOCALWORK15 )
  
  //WBT登場後
  IF $LOCALWORK15 == TRUE THEN
    //アデク：かれらにも　トレーナーの　すごみを
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_02, T06R0101_CHAMPION_01, POS_DEFAULT )
  //WBT登場前
  ELSE
    //アデク：イッシュちほうで　さいきょうの
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_01, T06R0101_CHAMPION_01, POS_DEFAULT )

  ENDIF
}
  //アデクと戦う？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい
    
    _MSGWIN_CLOSE()
    
    //プレイヤーの向きを取得
    _PLAYER_DIR_GET( LWK_DIR )
    
    IF $LWK_DIR != DIR_UP THEN
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_d )
      _OBJ_ANIME_WAIT()
    ENDIF
  
    //アニメ：アデク演技
    _OBJ_ANIME( T06R0101_CHAMPION_01, anm_champion_act_01 )
    _OBJ_ANIME_WAIT()
    
    _TIME_WAIT( 8 )
    
    IF $LWK_DIR == DIR_DOWN THEN
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_u )
      _OBJ_ANIME_WAIT()
    ELSIF $LWK_DIR == DIR_LEFT THEN
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_r )
      _OBJ_ANIME_WAIT()
    ELSIF $LWK_DIR == DIR_RIGHT THEN
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_l )
      _OBJ_ANIME_WAIT()
    ENDIF

    //アデク：こころが　おどる！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_03, T06R0101_CHAMPION_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_CHAMPION_01, 0 )

    //結果チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()
    ELSE
      _TRAINER_LOSE()
    ENDIF

    //アデク：さすがだな
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_05, T06R0101_CHAMPION_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    _TIME_WAIT( 16 )

    //階段SE再生
    _SE_PLAY( SEQ_SE_KAIDAN )
    
    //フィールド上にバンジロウ配置
    _OBJ_ADD_EX( 6, 12, DIR_UP, MMDL_ID_EVENTOBJ_00, MUGENBOSS, MV_DMY )

    //SE待ち
    _SE_WAIT()

    //プレイヤーの向きを取得
    _PLAYER_DIR_GET( LWK_DIR ) 
    //主人公が上を向いていなかった場合、アデク振り向き
    IF $LWK_DIR != DIR_UP THEN
      //アニメ：アデク振り向き
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_d )
    ENDIF

    //アニメ：バンジロウ登場
    _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 6, FORCE_TYPE_NPC, 4, DIR_UD )
    _OBJ_ANIME_WAIT()
    
    {
    DEFINE_LOCAL  LCW_VERSION
    //プレイヤーの向きを取得
    _PLAYER_DIR_GET( LWK_DIR )
    _GET_ROM_VERSION( LCW_VERSION )
    
    //バンジロウ：じーちゃん！▼（バージョン・向きでセリフと表示方法が異なる）
    IF $LWK_DIR != DIR_UP && $LCW_VERSION == VERSION_B2 THEN
      _PLAINWIN_MSG_DOWN( msg_t06r0101_mugenboss_end_01b )
    ELSIF $LWK_DIR != DIR_UP && $LCW_VERSION == VERSION_W2 THEN
      _PLAINWIN_MSG_DOWN( msg_t06r0101_mugenboss_end_01w )
    ELSE
      _BALLOONWIN_OBJMSG_WB( msg_t06r0101_mugenboss_end_01w, msg_t06r0101_mugenboss_end_01b, MMDL_ID_EVENTOBJ_00, POS_DL )
    ENDIF
    _MSGWIN_CLOSE()
    
    }
    
    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
    //主人公移動
    IF $LCW_POSX == 6 && $LCW_POSZ == 2 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 5, 3, FORCE_TYPE_NPC, 8, DIR_LR )
      _OBJ_ANIME_WAIT()
    ELSE
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    ENDIF
    _OBJ_ANIME_WAIT()
    
    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
    
    //アデク：バンジロウでは　ないか！▼
    IF $LCW_POSX == 5 && $LCW_POSZ == 3 THEN
      _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_06, T06R0101_CHAMPION_01, POS_UR )
    ELSE
      _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_06, T06R0101_CHAMPION_01, POS_UL )
    ENDIF
    _MSGWIN_CLOSE()
    
    //バンジロウ：おーい！▼
    IF $LWK_DIR != DIR_UP THEN
      _PLAINWIN_MSG_DOWN( msg_t06r0101_mugenboss_end_02 )
    ELSE
      _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_02, MMDL_ID_EVENTOBJ_00, POS_DL )
    ENDIF
    _MSGWIN_CLOSE()

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
    //バンジロウ、主人公に接近
    IF $LCW_POSX == 6 && $LCW_POSZ == 4 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 5, FORCE_TYPE_NPC, 8, DIR_UD )
    ELSIF $LCW_POSX == 7 && $LCW_POSZ == 3 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 7, 5, FORCE_TYPE_NPC, 8, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_u )
    ELSIF $LCW_POSX == 5 && $LCW_POSZ == 3 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 5, 5, FORCE_TYPE_NPC, 8, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_u )
    ENDIF
    _OBJ_ANIME_WAIT()

    //アニメ：バンジロウ「？」
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_common_hatena )
    _OBJ_ANIME_WAIT()

    //バンジロウ：で　だれ　こいつ？▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_03, MMDL_ID_EVENTOBJ_00, POS_DL )
    _MSGWIN_CLOSE()

    //プレイヤーネームを格納
    _PLAYER_NAME( 0 )

    //性別が格納されるローカル変数を定義
    DEFINE_LOCAL SCWK_SEX
    _GET_MY_SEX( SCWK_SEX )

    //男性だった場合
    IF $SCWK_SEX == PM_MALE THEN
      
      //アデク：かれの　なまえは
      IF $LCW_POSX == 5 && $LCW_POSZ == 3 THEN
        _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_07, T06R0101_CHAMPION_01, POS_UR )
      ELSE
        _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_07, T06R0101_CHAMPION_01, POS_UL )
      ENDIF

    //女性だった場合
    ELSE

      //アデク：かのじょの　なまえは
      IF $LCW_POSX == 5 && $LCW_POSZ == 3 THEN
        _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_08, T06R0101_CHAMPION_01, POS_UR )
      ELSE
        _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_08, T06R0101_CHAMPION_01, POS_UL )
      ENDIF

    ENDIF
    
    _MSGWIN_CLOSE()

    //バンジロウ：やっぱりか！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_04, MMDL_ID_EVENTOBJ_00, POS_DL )
    _MSGWIN_CLOSE()

    //アデク：どうだ？　バンジロウ
    IF $LCW_POSX == 5 && $LCW_POSZ == 3 THEN
      _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_09, T06R0101_CHAMPION_01, POS_UR )
    ELSE
      _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_09, T06R0101_CHAMPION_01, POS_UL )
    ENDIF
    _MSGWIN_CLOSE()

    //バンジロウ：ダメだ！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_05, MMDL_ID_EVENTOBJ_00, POS_DL )

    //バンジロウ：じぶんの　ポケモンたちと！▼（バージョンでセリフが異なる）
    _BALLOONWIN_OBJMSG_WB( msg_t06r0101_mugenboss_end_06w, msg_t06r0101_mugenboss_end_06b, MMDL_ID_EVENTOBJ_00, POS_DL )

    //プレイヤーネームを格納
    _PLAYER_NAME( 0 )
    //バンジロウ：じゃな！▼
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_07, MMDL_ID_EVENTOBJ_00, POS_DL )
    _MSGWIN_CLOSE()

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
    //アニメ：バンジロウ退場
    IF $LCW_POSX == 6 && $LCW_POSZ == 4 THEN
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 12, FORCE_TYPE_NPC, 4, DIR_UD )
    ELSE
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 6, FORCE_TYPE_NPC, 4, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 12, FORCE_TYPE_NPC, 4, DIR_UD )
    ENDIF
    _OBJ_ANIME_WAIT()
    
    _SE_PLAY( SEQ_SE_KAIDAN )    //階段SE再生
    _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
    _SE_WAIT()    //SE待ち

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
    //主人公とアデク向き合う
    IF $LCW_POSX == 6 && $LCW_POSZ == 4 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    ELSIF $LCW_POSX == 7 && $LCW_POSZ == 3 THEN
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_r )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    ELSIF $LCW_POSX == 5 && $LCW_POSZ == 3 THEN
      _OBJ_ANIME( T06R0101_CHAMPION_01, anm_staystep_l )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    ENDIF
    _OBJ_ANIME_WAIT()

    //アデク：わが　まご　ながら
    IF $LCW_POSX == 5 && $LCW_POSZ == 3 THEN
      _BALLOONWIN_OBJMSG_WB( msg_t06r0101_champion_end_10w, msg_t06r0101_champion_end_10b, T06R0101_CHAMPION_01, POS_UR )
    ELSE
      _BALLOONWIN_OBJMSG_WB( msg_t06r0101_champion_end_10w, msg_t06r0101_champion_end_10b, T06R0101_CHAMPION_01, POS_UL )
    ENDIF
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //========================================//
    //アデク（クリア後）に勝利した
    _FLAG_SET( FE_T06R0101_CHAMPION_WIN_01 )
    //無限ダンジョンストッパー解除
    _FLAG_SET( FV_D31D32_MUGEN_STOPPER )
    //========================================//
    
  ELSE

    //アデク：ふむう……
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_champion_end_04, T06R0101_CHAMPION_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

_RET

/**************************************************************/
/* バンジロウ：話しかけ                                         */
/**************************************************************/
EVENT_START   ev_t06r0101_mugenboss_01
{
  _TALK_OBJ_START()
  
  //プレイヤー名代入
  _PLAYER_NAME( 0 )
  
  DEFINE_LOCAL  LCW_VERSION
  DEFINE_LOCAL  LCW_PT_RESURT
  
  //WB分岐：よお！やくそくだったな
  _BALLOONWIN_OBJMSG_WB( msg_t06r0101_mugenboss_end_08w , msg_t06r0101_mugenboss_end_08b , T06R0101_MUGENBOSS_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //バージョンによって入手ポケモンを変更
  _GET_ROM_VERSION( LCW_VERSION )
  
  IF $LCW_VERSION == VERSION_B2 THEN
    //ポケモン入手処理ブラック：フカマル
    _ADD_POKEMON_TO_PARTY_EX( LCW_PT_RESURT, MONSNO_443, 0, 1, SCR_TOKUSEI_SPEC_1, SCR_SEX_SPEC_MALE, SCR_RARE_SPEC_TRUE, ITEM_GAKUSYUUSOUTI, ITEM_MONSUTAABOORU )
    _MONS_NAME(1,MONSNO_443)
  ELSE
    //ポケモン入手処理ホワイト：ミニリュウ
    _ADD_POKEMON_TO_PARTY_EX( LCW_PT_RESURT, MONSNO_147, 0, 1, SCR_TOKUSEI_SPEC_1, SCR_SEX_SPEC_MALE, SCR_RARE_SPEC_TRUE, ITEM_GAKUSYUUSOUTI, ITEM_MONSUTAABOORU )
    _MONS_NAME(1,MONSNO_147)
  ENDIF
  
  //追加できたかチェック
  
  //追加した
  IF $LCW_PT_RESURT == TRUE THEN
    
    //プレイヤー名代入
    _PLAYER_NAME( 0 )
    
    //手に入れた
    _ME_PLAY( SEQ_ME_POKEGET )
    _SYSWIN_MSG(msg_t06r0101_poke_01, POS_DEFAULT)
    _ME_WAIT()
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()

    //名前をつけますか？
    _SYSWIN_MSG(msg_t06r0101_poke_02, POS_DEFAULT )
    DEFINE_LOCAL LCW_NAME_ANS
    DEFINE_LOCAL LCW_NAMEINPUT
    _YES_NO_WIN( LCW_NAME_ANS )
    _SYSWIN_CLOSE()
    
    //はい
    IF $LCW_NAME_ANS == 0 THEN
      
      //手持ち数格納（最後尾のPOSを指定するため）
      DEFINE_LOCAL LWK_POKE_COUNT
      _GET_PARTY_POKE_COUNT (LWK_POKE_COUNT,POKECOUNT_MODE_TOTAL)
      //名前入力結果が格納されるローカル変数を定義
      DEFINE_LOCAL SCWK_NAMEINPUT
      
      //$POKE_COUNTに1をひいて手持ちの最後尾の数を指定
      $LWK_POKE_COUNT -= 1
      //名前入力画面呼び出し
      _PARTY_POKE_NAME_INPUT(LCW_NAMEINPUT,LWK_POKE_COUNT,TRUE)
    ENDIF
    
    //WB分岐：おまえをみとめて
    _BALLOONWIN_OBJMSG_WB( msg_t06r0101_mugenboss_end_10w , msg_t06r0101_mugenboss_end_10b , T06R0101_MUGENBOSS_01 , POS_DEFAULT)
    _MSGWIN_CLOSE()
    
    //主人公方向取得
    _PLAYER_DIR_GET( LWK_DIR )
    
    //アニメ：下から話しかけ退場
    IF $LWK_DIR == DIR_UP THEN
      _OBJ_ANIME( T06R0101_MUGENBOSS_01, anm_mugenboss_bye_down )
    //アニメ：下以外から退場
    ELSE
      _OBJ_ANIME( T06R0101_MUGENBOSS_01, anm_mugenboss_bye )
    ENDIF
    
    //アニメ：バンジロウを見送る
    IF $LWK_DIR != DIR_DOWN THEN
      _TIME_WAIT( 8 )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    ENDIF
    _OBJ_ANIME_WAIT()
    
    //階段SE再生
    _SE_PLAY( SEQ_SE_KAIDAN )
  
    //バンジロウ動作モデル削除
    _OBJ_DEL( T06R0101_MUGENBOSS_01 )
    
    //SE待ち
    _SE_WAIT()
    //========================================//
    //バンジロウ非表示
    _FLAG_SET( FV_T06R0101_MUGENBOSS_01 )
    //========================================//
  
  //追加できなかった
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_t06r0101_mugenboss_end_09, T06R0101_MUGENBOSS_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
}
EVENT_END

