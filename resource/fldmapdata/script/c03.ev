/**************************************************************/
/*		SCENE_CHANGE：ライモンラリー開始
/**************************************************************/
EVENT_START		ev_scene_c03_rarry_start
{
DEFINE_LOCAL  LCW_POSI
DEFINE_LOCAL  LCW_POSF
DEFINE_LOCAL  LCW_POSS

  //アニメ：ピエロ「！」
  _OBJ_ANIME( C03_CLOWN_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  _GET_PLAYER_RAIL_LOC( LCW_POSI, LCW_POSF, LCW_POSS )
  
  //アニメ：ピエロ接近
  IF $LCW_POSI == 5 && $LCW_POSF == 4 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_come_01 )
  ELSIF $LCW_POSI == 5 && $LCW_POSF == 3 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_come_02 )
  ELSIF $LCW_POSI == 5 && $LCW_POSF == 2 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_come_03 )
  ELSIF $LCW_POSI == 5 && $LCW_POSF == 1 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_come_04 )
  ELSIF $LCW_POSI == 5 && $LCW_POSF == 0 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_come_05 )
  ELSIF $LCW_POSI == 3 && $LCW_POSF == 28 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_come_06 )
  ELSIF $LCW_POSI == 3 && $LCW_POSF == 27 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_come_07 )
  ELSIF $LCW_POSI == 3 && $LCW_POSF == 26 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_come_08 )
  ELSIF $LCW_POSI == 3 && $LCW_POSF == 25 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_come_09 )
  ENDIF
  
  _OBJ_ANIME_WAIT()
  
  //ピエロ：ようこそ！ヒウンシティ！
  _BALLOONWIN_OBJMSG_POS( msg_c03_rally_01, C03_CLOWN_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //じてんしゃ入手処理
  _ITEM_EVENT_KEYWAIT( ITEM_ZITENSYA, 1 )
  
  //ピエロ：ルールは簡単
  _BALLOONWIN_OBJMSG_POS( msg_c03_rally_02, C03_CLOWN_01, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //アニメ：ピエロ戻る
  IF $LCW_POSI == 5 && $LCW_POSF == 4 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_ret_01 )
  ELSIF $LCW_POSI == 5 && $LCW_POSF == 3 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_ret_02 )
  ELSIF $LCW_POSI == 5 && $LCW_POSF == 2 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_ret_03 )
  ELSIF $LCW_POSI == 5 && $LCW_POSF == 1 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_ret_04 )
  ELSIF $LCW_POSI == 5 && $LCW_POSF == 0 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_ret_05 )
  ELSIF $LCW_POSI == 3 && $LCW_POSF == 28 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_ret_06 )
  ELSIF $LCW_POSI == 3 && $LCW_POSF == 27 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_ret_07 )
  ELSIF $LCW_POSI == 3 && $LCW_POSF == 26 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_ret_08 )
  ELSIF $LCW_POSI == 3 && $LCW_POSF == 25 && $LCW_POSS == 5 THEN
    _OBJ_ANIME( C03_CLOWN_01, anm_rarry_ret_09 )
  ENDIF
  
  _OBJ_ANIME_WAIT()
  
  //==================================//
  //SCENE_CHANGE無効
  $WK_SCENE_C03_RALLY_01 = 2
  //じてんしゃヒントメダル取得
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CYCLE_LV1 )
  //C03到着フラグセット
  _FLAG_SET( SYS_FLAG_ARRIVE_C03 )
  //==================================//
  
}
EVENT_END

/**************************************************************/
/*  クラウン：話しかけ（ヒウンラリー）                      */
/**************************************************************/
EVENT_START   ev_c03_clown_01
{
  _TALK_OBJ_START()

  //ラリーイベント中の場合
  IF $WK_SCENE_C03_RALLY_01 != 6 THEN

    //クラウン：まだ　おとずれて　いないのは……
    _BALLOONWIN_TALKOBJ_MSG( msg_c03_rally_03 )

    //全てのポイントをめぐっていた場合
    IF $WK_SCENE_C03_RALLY_01 == 5 THEN
      //クラウン：なんと！　のこり０！
      _BALLOONWIN_TALKOBJ_MSG( msg_c03_rally_08 )
      _MSGWIN_CLOSE()

      //記念品受け取り
      _ITEM_EVENT_KEYWAIT( ITEM_HUSIGINAAME, 1 )
      
      //クラウン：なんと！　のこり０！
      _BALLOONWIN_TALKOBJ_MSG( msg_c03_rally_09 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
      //========================================//
      //クリア後メッセージ表示終了
      $WK_SCENE_C03_RALLY_01 = 6
      //========================================//

    ELSE
      //まだ訪れていない場所を数える用変数定義
      DEFINE_LOCAL LWK_POINT_NUM  //訪れていないポイントの数
      DEFINE_LOCAL LWK_COUNT_NUM  //WHILE文のカウンタ

      //訪れていない場所の確認処理（繰り返し処理）
      WHILE $LWK_COUNT_NUM < 3

        //メダル事務局におとずれていない
        IF $LWK_COUNT_NUM == 0 && FLAG_OFF( FE_C03_RALLYPOINT_01 ) THEN
          _BALLOONWIN_OBJMSG_POS( msg_c03_rally_04, C03_CLOWN_01, POS_DEFAULT )
          $LWK_POINT_NUM += 1 //ポイント加算

        //すれ違い調査隊におとずれていない
        ELSIF $LWK_COUNT_NUM == 1 && FLAG_OFF( FE_C03_RALLYPOINT_02 ) THEN
          _BALLOONWIN_OBJMSG_POS( msg_c03_rally_05, C03_CLOWN_01, POS_DEFAULT )
          $LWK_POINT_NUM += 1 //ポイント加算

        //バトルカンパニーにおとずれていない
        ELSIF $LWK_COUNT_NUM == 2 && FLAG_OFF( FE_C03_RALLYPOINT_03 ) THEN
          _BALLOONWIN_OBJMSG_POS( msg_c03_rally_06, C03_CLOWN_01, POS_DEFAULT )
          $LWK_POINT_NUM += 1 //ポイント加算

        ENDIF

        //カウント
        $LWK_COUNT_NUM += 1

      ENDWHILE

      //訪れていない場所の数値を指定タグにセット
      _NUMBER( 0, LWK_POINT_NUM, 1 )

      //クラウン：～の　X箇所　ですね
      _BALLOONWIN_TALKOBJ_MSG( msg_c03_rally_07 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSE
    //クラウン：ヒウンを　あいする
    _BALLOONWIN_TALKOBJ_MSG( msg_c03_rally_09 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF
}
EVENT_END

