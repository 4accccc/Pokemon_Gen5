/**************************************************************/
/*		POS：アイリス誘導
/**************************************************************/
EVENT_START		ev_pos_c03_swchampion_01
{

  DEFINE_LOCAL  LCW_POSI
  DEFINE_LOCAL  LCW_POSF
  DEFINE_LOCAL  LCW_POSS
  
  //主人公座標取得
  _GET_OBJ_RAIL_LOC( MMDL_ID_PLAYER, LCW_POSI, LCW_POSF, LCW_POSS )
  
  //上から来たケースでは振り向き
  IF $LCW_POSS > 11 THEN
    _OBJ_ANIME( C03_SWCHAMPION_01, anm_staystep_u )
    _OBJ_ANIME_WAIT()
  ENDIF

  //アイリス：このさきが
  _BALLOONWIN_OBJMSG_POS( msg_c03_swchampion_01, C03_SWCHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アイリス退場
  IF $LCW_POSS > 11 THEN
    _DEBUG_PRINT_WK( 300 )
    _OBJ_ANIME( C03_SWCHAMPION_01, anm_swchampion_bye_01u )
  ELSE
    _OBJ_ANIME( C03_SWCHAMPION_01, anm_swchampion_bye_01l )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //==================================//
  
  //C03のPOS有効
  $WK_SCENE_C03GYM_STOPPER = 2
  
  //C03のアイリス非表示
  _FLAG_SET( FV_C03_SWCHAMPION_01 )
  _FLAG_RESET( FV_C03_SWCHAMPION_02 )
  
  //==================================//
  
  //アイリス動作モデル生成
  _OBJ_ADD( C03_SWCHAMPION_02 )
  _OBJ_DEL( C03_SWCHAMPION_01 )

}
EVENT_END

