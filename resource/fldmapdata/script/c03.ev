/**************************************************************/
/*		POS：アイリス誘導
/**************************************************************/
EVENT_START		ev_pos_c03_swchampion_01

	//カメラ移動
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 3915,15679,2812248,3137334,-455884,3150850,40 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //アイリス：こっちが
  _BALLOONWIN_OBJMSG_POS( msg_c03_swchampion_01, C03_SWCHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アイリス退場
  _OBJ_ANIME( C03_SWCHAMPION_01, anm_swchampion_bye )
  _OBJ_ANIME_WAIT()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (40)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //アイリスOBJ削除
  _OBJ_DEL( C03_SWCHAMPION_01 )
  
  //==================================//
  
  //C03のPOS無効
  $WK_SCENE_C03GYM_STOPPER = 2
  
  //C03のアイリス非表示
  _FLAG_SET( FV_C03_SWCHAMPION_01 )
  
  //C03P07表示
  _FLAG_RESET( FV_C03P17_SWCHAMPION_01 )
  _FLAG_RESET( FV_C03P17_PILOT_01 )
  
  //C03P17_SCENE_CHANGE有効
  $WK_SCENE_C03P17 = 1
  
  //==================================//
EVENT_END

