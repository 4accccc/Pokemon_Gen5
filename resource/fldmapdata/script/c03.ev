/**************************************************************/
/*		POS：アイリス誘導
/**************************************************************/
EVENT_START		ev_pos_c03_swchampion_02
  
  //アイリス：こっちが
  _BALLOONWIN_OBJMSG_POS( msg_c03_swchampion_02, C03_SWCHAMPION_02, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アイリス退場
  _OBJ_ANIME( C03_SWCHAMPION_02, anm_swchampion_bye_02 )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //アイリスOBJ削除
  _OBJ_DEL( C03_SWCHAMPION_02 )
  
  //==================================//
  
  //C03のPOS無効
  $WK_SCENE_C03GYM_STOPPER = 3
  
  //C03のアイリス非表示
  _FLAG_SET( FV_C03_SWCHAMPION_02 )
  
  //C03P07表示
  _FLAG_RESET( FV_C03P17_SWCHAMPION_01 )
  
  //C03P17_SCENE_CHANGE有効
  $WK_SCENE_C03P17 = 1
  
  //==================================//
EVENT_END

