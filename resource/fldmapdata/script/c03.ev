//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/**************************************************************/
/*		SCENE_CHANGE：マコモと出会う
/**************************************************************/
EVENT_START		ev_scene_c03_macomomeet_01
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //カメラ移動
  //_CAMERA_START()		//カメラ操作開始
  //_CAMERA_PURGE()		//カメラのバインドを解く
  
  //【仮】カメラ移動
  //_CAMERA_MOVE( 4290,0,2531848,3108662,-455884,3150850,40 )
  
  //【仮】カメラ全確認必要
  SWITCH $LCW_POSX
  CASE 43 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x43 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    //_CAMERA_MOVE( 2303,63662,2671645,3145728,12288,3121152,40 )
	CASE 44 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x44 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    //_CAMERA_MOVE( 2303,64159,2702915,3145728,12288,3112960,40 )
  CASE 45 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x45 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    //_CAMERA_MOVE( 2305,64579,2667962,3145728,12288,3112960,40 )
  CASE 46 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x46 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    //_CAMERA_MOVE( 2305,65013,2667515,3145728,12288,3112960,40 )
  CASE 47 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x47 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    //_CAMERA_MOVE( 2305,65453,2667086,3145728,12288,3108864,40 )
  CASE 48 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x48 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    //_CAMERA_MOVE( 2305,261,2666954,3145728,12288,3112960,40 )
  CASE 49 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x49 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l)
    //_CAMERA_MOVE( 2305,680,2667265,3145728,12288,3112960,40 )
  CASE 50 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x50 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    //_CAMERA_MOVE( 2305,1098,2701548,3145728,12288,3112960,40 )
  CASE 51 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x51 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    //_CAMERA_MOVE( 2305,1098,2701548,3145728,12288,3112960,40 )
  CASE 52 THEN
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x52 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    //_CAMERA_MOVE( 2303,1504,2670381,3145728,12288,3112960,40 )
	CASE DIR_DOWN THEN  //本来ここにはこないが念のため
    _OBJ_ANIME( C03_MACOMO_01, anm_macomo_to_pl_x47 )
    _TIME_WAIT( 48 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    //_CAMERA_MOVE( 2305,65453,2667086,3145728,12288,3108864,40 )
  ENDSWITCH
  
  //_CAMERA_WAIT_MOVE()	//カメラ移動待ち
  _OBJ_ANIME_WAIT()
  
   //マコモ：やっほー
  _BALLOONWIN_OBJMSG_POS( msg_c03_inventor_01, C03_MACOMO_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：「!」
  _OBJ_ANIME( C03_MACOMO_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //マコモ：あたしは
  _BALLOONWIN_OBJMSG_POS( msg_c03_inventor_02, C03_MACOMO_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //Ｃギア入手処理をコール
  _CALL	ev_cgear_get
  
  //マコモ：くわしいことは
  _BALLOONWIN_OBJMSG_POS( msg_c03_inventor_05, C03_MACOMO_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：マコモ退場
  _OBJ_ANIME( C03_MACOMO_01, anm_macomo_bye )
  
  //アニメ：主人公の座標が47以上なら見送り（それ以外は既に左を向いている）
  IF $LCW_POSX <= 47 THEN
    _TIME_WAIT(16)
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  /*
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (40)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  */
  
  //マコモOBJ削除
  _OBJ_DEL( C03_MACOMO_01 )
  
  //==================================//
  
  //C03のPOS無効
  $WK_SCENE_C03 = 2
  
  //C03のマコモ非表示
  _FLAG_SET( FV_C03_MACOMO_01 )
  
  //==================================//
	
EVENT_END

//Ｃギア入手処理
ev_cgear_get:
	//Ｃギアを手に入れた！
	_ME_PLAY( SEQ_ME_KEYITEM )
	_PLAYER_NAME( 0 )
	_SYSWIN_MSG( msg_c03_cgear_01, POS_DOWN )
	_ME_WAIT()
	_AB_KEYWAIT_MARK()

	//Ｃギアの電源ON/OFF選択
	_PUT_CGEAR_COMMENT( TRUE )		//注意書きを表示
	{
	DEFINE_LOCAL lwk_loop
	WHILE $lwk_loop != 555
	
		//Cギアの電源をONにしますか？
		_SYSWIN_MSG( msg_c03_cgear_02, POS_DOWN )
		_BMPMENU_INIT_RIGHT( MENU_X1, 13, 0, 1, SCWK_ANSWER )
		_BMPMENU_MAKE_LIST( msg_c03_cgear_03, 0 )	//はい
		_BMPMENU_MAKE_LIST( msg_c03_cgear_04, 1 )	//いいえ
		_BMPMENU_START()

		IF $SCWK_ANSWER == 0 THEN
			//はい選択
			_PUT_CGEAR_COMMENT( FALSE )		//注意書きを非表示
			
			//本体設定が通信可能な状態かチェック
			_GET_AVAILABLE_WIRELESS( SCWK_TEMP0 )
			IF $SCWK_TEMP0 == TRUE THEN
				//通信可能

				//質問メッセージのウインドウを消す
				_MSGWIN_CLOSE()
				
				//Cギア起動ＳＥ
				_SE_PLAY( SEQ_SE_DECIDE3 )
				_CGEAR_ON_DEMO( TRUE )		//Ｃギア画面をアクティブで起動
				_SE_WAIT()
				
				//ほら！Ｃギアが起動したでしょ！
				_BALLOONWIN_OBJMSG_POS( msg_c03_inventor_03 , C03_MACOMO_01, POS_DEFAULT )

			ELSE
				//通信不可（TWL本体設定により無線通信がOFFになっている状態）
				
				//DS本体設定により通信できません
				_SYSWIN_MSG( msg_c03_cgear_06, POS_DOWN )
				_MSGWIN_CLOSE()
				
				_CGEAR_ON_DEMO( FALSE )		//Ｃギア画面をパッシブで起動
				
				//Ｃギアの画面があらわれたでしょ？
				_BALLOONWIN_OBJMSG_POS( msg_c03_inventor_04 , C03_MACOMO_01, POS_DEFAULT )
				
			ENDIF
			
			//ループから抜ける
			$lwk_loop = 555
			
		ELSE
			//いいえ選択なら再確認メッセージ
			//通信機能がオフになりますがよろしいですか？
			_SYSWIN_MSG( msg_c03_cgear_05, POS_DOWN )
			_BMPMENU_INIT_RIGHT( MENU_X1, 13, 0, 1, SCWK_ANSWER )
			_BMPMENU_MAKE_LIST( msg_c03_cgear_03, 0 )	//はい
			_BMPMENU_MAKE_LIST( msg_c03_cgear_04, 1 )	//いいえ
			_BMPMENU_START()
			
			IF $SCWK_ANSWER == SCR_YES THEN
				//はい選択なら通信オフで先へ進む
				_MSGWIN_CLOSE()
				
				_PUT_CGEAR_COMMENT( FALSE )		//注意書きを非表示
				
				_CGEAR_ON_DEMO( FALSE )		//Ｃギア画面をパッシブで起動
				
				//Ｃギアの画面があらわれたでしょ？
				_BALLOONWIN_OBJMSG_POS( msg_c03_inventor_04 , C03_MACOMO_01, POS_DEFAULT )
				
				//ループから抜ける
				$lwk_loop = 555
				
			ENDIF
			
		
		ENDIF
	
	ENDWHILE
	}
_RET

