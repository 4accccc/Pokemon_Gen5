/**************************************************************/
/*            秘書  広場用スクリプト                          */
/**************************************************************/
EVENT_START    ev_resort_secretary_space
{
	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT,0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_GREET, RESORT_WORD_PARAM_FRONT,1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,2 )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_secretary_space_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_SECRETARY_SPACE_SEARCH THEN    //検索
      //_RESORT_SEARCH_RECEPTION( RESORT_PEOPLE_TYPE_RESIDENT )
      $LWK_MENU_LOOP = FALSE
    CASE SEQ_SECRETARY_SPACE_HELP THEN      //おしえて！
      $LWK_MENU_LOOP = FALSE
    CASE SEQ_SECRETARY_SPACE_BYE THEN       //またね
      _RESORT_GET_MSGID( RESORT_SECRETARY_BYE_MSGID, LWK_MSGID )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,0 )
	    _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

