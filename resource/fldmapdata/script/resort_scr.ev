/**************************************************************/
/*            秘書  パソコン用スクリプト                      */
/**************************************************************/
EVENT_START    ev_resort_secretary_pc
{
	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT,0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_GREET, RESORT_WORD_PARAM_FRONT,1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,2 )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DL )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_secretary_pc_main_menu


    IF $LWK_MENU_RET == SEQ_SECRETARY_PC_BYE THEN
      _RESORT_GET_MSGID( RESORT_SECRETARY_BYE_MSGID, LWK_MSGID )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,0 )
  	  _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
  	  _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    ELSIF $LWK_MENU_RET == SEQ_SECRETARY_PC_RECORD THEN
  	  _BALLOONWIN_CLOSE()
      _CALL_DENDOU_PC_PROC( SCRCMD_DENDOU_PC_DENDOU, LWK_RET )
    ELSE 

	    _BALLOONWIN_CLOSE()
      _MAP_FADE_BLACK_OUT()                  // フェードアウト
      _MAP_FADE_END_CHECK()                  //

      //分岐
      SWITCH $LWK_MENU_RET
      CASE SEQ_SECRETARY_PC_BOX THEN    //整理
        _CALL_BOX_PROC( LWK_RET, BOX_MODE_SEIRI )
      CASE SEQ_SECRETARY_PC_BTLBOX THEN //バトルボックス
        _CALL_BOX_PROC( LWK_RET, BOX_MODE_BATTLE )
      CASE SEQ_SECRETARY_PC_ITEM THEN
        _CALL_BOX_PROC( LWK_RET, BOX_MODE_ITEM )
      CASE SEQ_SECRETARY_PC_MAILBOX THEN       //メール
        _CALL_MAILBOX_PROC( LWK_RET ) // メールボックス画面へ
      CASE SEQ_SECRETARY_PC_HELP THEN       //ヘルプをみる
        _CALL_GAME_MANUAL( LWK_RET )
      DEFAULT
      ENDSWITCH

      _MAP_FADE_BLACK_IN()                   // フェードイン
      _MAP_FADE_END_CHECK()                  //
    ENDIF
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：秘書　パソコン用メニュー表示
//==============================================================
sub_secretary_pc_main_menu:
{
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST( resort_sys_select_22, SEQ_SECRETARY_PC_BOX )	//せいり
  _BMPMENU_MAKE_LIST( resort_sys_select_23, SEQ_SECRETARY_PC_BTLBOX )	//バトルボックス
  _BMPMENU_MAKE_LIST( resort_sys_select_24, SEQ_SECRETARY_PC_ITEM )	  //もちもの
  _BMPMENU_MAKE_LIST( resort_sys_select_25, SEQ_SECRETARY_PC_RECORD )	  //きろく
  _BMPMENU_MAKE_LIST( resort_sys_select_26, SEQ_SECRETARY_PC_MAILBOX )	  //メール
  _BMPMENU_MAKE_LIST( resort_sys_select_27, SEQ_SECRETARY_PC_HELP )	  //ヘルプをみる
  _BMPMENU_MAKE_LIST( resort_sys_select_10, SEQ_SECRETARY_PC_BYE )	  //またね

	//メニュー表示
	_BMPMENU_START()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_SECRETARY_PC_BYE
  ENDIF
}
_RET
/**************************************************************/
/*            NPC　クチコミ                     */
/**************************************************************/
EVENT_START ev_resort_npc_mouthcomm
{
  DEFINE_LOCAL LWK_TMP

	_TALK_OBJ_START()

  _RESORT_GET_NPC_DATA( LWK_TMP, RESORT_NPC_DATA_OBJID, LWK_OBJID )
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_INDEX, LWK_INDEX )


  //自分のクチコミに何も入力がないならば初回
  $LWK_TMP = $LWK_INDEX
  $LWK_TMP += RESORT_MY_PARAM_GOSSIP_00
  _RESORT_GET_MY_DATA( LWK_TMP, LWK_RET )

  IF $LWK_RET == 0 THEN
    //初回
    
    //初回挨拶
    _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_00, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

    _CALL sub_npc_mouthcomm_question
  ELSE
    //通常

    //選択肢
    _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_01, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

	  //メニュー表示
	  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
    _BMPMENU_MAKE_LIST( resort_mouthcomm_sel_00, SEQ_MOUTHCOMM_HEAR )
    _BMPMENU_MAKE_LIST( resort_mouthcomm_sel_01, SEQ_MOUTHCOMM_ANSWER )
    _BMPMENU_MAKE_LIST( resort_mouthcomm_sel_02, SEQ_MOUTHCOMM_CANCEL )
	  _BMPMENU_START()
    IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
      $LWK_MENU_RET = SEQ_MOUTHCOMM_CANCEL
    ENDIF

    SWITCH $LWK_MENU_RET
    CASE SEQ_MOUTHCOMM_HEAR THEN
      //噂があるかないか
      _CALL sub_npc_mouthcomm_hear
    CASE SEQ_MOUTHCOMM_ANSWER THEN
      _CALL sub_npc_mouthcomm_question
    ENDSWITCH
  ENDIF

	_BALLOONWIN_CLOSE()

}
EVENT_END
//==============================================================
//サブルーチン：クチコミ　うわさをきく部分
//==============================================================
sub_npc_mouthcomm_hear:
{
  //クチコミを取得
  _RESORT_GET_MOUTHCOMM( LWK_INDEX, LOCALWORK11, LWK_RET )
  $LOCALWORK11 += 1

  IF $LWK_RET == 0 THEN
    //とくにうわさはない…
    _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_04, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
  ELSE
    //噂をいう
    _CALL sub_npc_mouthcomm_hear_core
  ENDIF 
}
_RET

//==============================================================
//サブルーチン：クチコミ　うわさをきく部分
//==============================================================
sub_npc_mouthcomm_hear_core:
{
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    
    //クチコミを取得
    _RESORT_GET_MOUTHCOMM( LWK_INDEX, LOCALWORK11, LWK_RET )
    $LOCALWORK11 += 1

    //噂をいう
    $LWK_RET += RESORT_NPC_DATA_MOUTHCOMM_I_00
    _RESORT_GET_NPC_DATA( LWK_OBJID, LWK_RET, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

    //もっと聞きたい？
    _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_03, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

    //はい/いいえ
 	  _YES_NO_WIN( LWK_YESNO )
    IF $LWK_YESNO == SCR_NO THEN
      $LWK_MENU_LOOP = FALSE
    ENDIF

  ENDWHILE

}
_RET

//==============================================================
//サブルーチン：クチコミ　質問部分
//==============================================================
sub_npc_mouthcomm_question:
{
  DEFINE_LOCAL LWK_TMP
  DEFINE_LOCAL LWK_CNT

  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,0 )
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_INDEX, LWK_INDEX )
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_A_NUM, LWK_TMP )

  //質問文
  _BALLOONWIN_CLOSE()
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_Q, LWK_MSGID )
  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

  //選択肢作成
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 0, LWK_MENU_RET )

  WHILE $LWK_CNT < $LWK_TMP
    _DEBUG_PRINT_WK( LWK_CNT )
    _RESORT_SET_WORD_MOUTHCOMM( LWK_INDEX, LWK_CNT, 0 )
	  _BMPMENU_MAKE_LIST( resort_mouthcomm_sys_03, LWK_CNT )	//質問
    $LWK_CNT += 1
  ENDWHILE

	//メニュー表示
	_BMPMENU_START()

  //そうなんだー
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_02, LWK_MSGID )
  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

  //回答を設定
  $LWK_TMP = $LWK_INDEX
  $LWK_TMP += RESORT_MY_PARAM_GOSSIP_00
  //回答は０オリジンから１オリジンにする
  $LWK_MENU_RET += 1
  _RESORT_SET_MY_DATA( LWK_TMP, LWK_MENU_RET )
}
_RET

/**************************************************************/
/*            NPC　オフレコ                     */
/**************************************************************/
EVENT_START ev_resort_npc_offreco
{
  DEFINE_LOCAL LWK_TMP
  DEFINE_LOCAL LWK_CNT

  _TALK_OBJ_START()

  _RESORT_GET_NPC_DATA( LWK_TMP, RESORT_NPC_DATA_OBJID, LWK_OBJID )
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_INDEX, LWK_INDEX )

  _RESORT_GET_OFFRECO( LWK_INDEX, LOCALWORK12, LWK_MSGID )
