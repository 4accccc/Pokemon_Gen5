_EVENT_DATA    ev_resort
_EVENT_DATA    ev_resort_tourist
_EVENT_DATA    ev_resort_proxy
_EVENT_DATA_END


DEFINE_LOCAL  LWK_MENU_RET
DEFINE_LOCAL  LWK_MENU_LOOP
DEFINE_LOCAL LWK_OBJID

/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_resort_scr:
