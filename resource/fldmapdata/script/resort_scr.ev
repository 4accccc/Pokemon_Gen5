/**************************************************************/
/*            代理人用スクリプト                              */
/**************************************************************/
EVENT_START ev_resort_proxy
	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )

  //挨拶文
	DEFINE_LOCAL LWK_GREET_MSGID2
  _RESORT_GET_MSGID( 0, LWK_GREET_MSGID2 )
	_BALLOONWIN_OBJMSG( LWK_GREET_MSGID2, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //飛んで去っていく
  _OBJ_WARP_OUT( LWK_OBJID )

  //去るのを待つ
  _TIME_WAIT( 30 )

  //この人は消える
  _RESORT_DELETE_PEOPLE()

  _RESORT_TALK_END()

EVENT_END
