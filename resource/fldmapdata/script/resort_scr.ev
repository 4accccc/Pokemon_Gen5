/**************************************************************/
/*            代理人用スクリプト                              */
/**************************************************************/
EVENT_START ev_resort_proxy
{
	DEFINE_LOCAL LWK_GREET_MSGID
	DEFINE_LOCAL LWK_ITEM_MSGID
  DEFINE_LOCAL LWK_PRESENT_IS_ITEM
  DEFINE_LOCAL LWK_PRESENT_ID
  DEFINE_LOCAL LWK_PRESENT_NUM

	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_PROXY_GREET_MSGID, LWK_GREET_MSGID )
	_BALLOONWIN_OBJMSG( LWK_GREET_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //アイテム取得イベント
  _RESORT_GET_MSGID( RESORT_PROXY_ITEM_MSGID, LWK_ITEM_MSGID )
	_BALLOONWIN_OBJMSG( LWK_ITEM_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_IS_ITEM, LWK_PRESENT_IS_ITEM )
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_ID, LWK_PRESENT_ID )
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_NUM, LWK_PRESENT_NUM )
  IF $LWK_PRESENT_IS_ITEM == TRUE THEN
    //もしアイテムならば
    //アイテムをもらった！
  	_ITEM_EVENT_KEYWAIT( LWK_PRESENT_ID, LWK_PRESENT_NUM )
  ELSE
    //BPだったら
    //BPを取得した！
    _NUMBER( 0, LWK_PRESENT_NUM, 3 )
	  _SYSWIN_MSG( resort_sys_06, POS_DOWN )
    _SYSWIN_CLOSE()
  ENDIF

  //飛んで去っていく
  _OBJ_WARP_OUT( LWK_OBJID )

  //去るのを待つ
  _TIME_WAIT( 30 )

  //この人は消える
  _RESORT_DELETE_PEOPLE()

  _RESORT_TALK_END()
}
EVENT_END

/**************************************************************/
/*            住人用スクリプト                                */
/**************************************************************/
EVENT_START    ev_resort_resident
{
  DEFINE_LOCAL LWK_MERGE

	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_GET_DATA( RESORT_GET_PARAM_MERGE_FLAG, LWK_MERGE )
  //マージチェック
  IF $LWK_MERGE > 0 THEN
    //マージ処理
    _CALL sub_resident_merge
  ELSE
    //施設処理
    _CALL sub_resident_institution
  ENDIF

  _RESORT_TALK_END()
  }
EVENT_END

//==============================================================
//サブルーチン：住民施設処理
//==============================================================
sub_resident_merge:
{
	DEFINE_LOCAL LWK_CHANGE_MSGID
	DEFINE_LOCAL LWK_CHANGE_OK_MSGID
	DEFINE_LOCAL LWK_CHANGE_NG_MSGID
  DEFINE_LOCAL LWK_YESNO
  DEFINE_LOCAL LWK_IS_CHANGE
  DEFINE_LOCAL LWK_X
  DEFINE_LOCAL LWK_Z

  //選択肢
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //今度○○をやりたいと思っているんで
    _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_MSGID, LWK_CHANGE_MSGID )
    _RESORT_SET_WORD( RESORT_WORD_SHOP_GENRE, 0 )
	  _BALLOONWIN_OBJMSG( LWK_CHANGE_MSGID, LWK_OBJID )

    //はい/いいえ
 	  _YES_NO_WIN( LWK_YESNO )

    IF $LWK_YESNO == SCR_YES THEN
      $LWK_MENU_LOOP = FALSE
      $LWK_IS_CHANGE = TRUE
    ELSE
      
      //本当にダメですか？
      _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_CONFIM_MSGID, LWK_CHANGE_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_CHANGE_MSGID, LWK_OBJID )

      //はい/いいえ
 	    _YES_NO_WIN( LWK_YESNO )

      IF $LWK_YESNO == SCR_YES THEN
        $LWK_MENU_LOOP = FALSE
        $LWK_IS_CHANGE = FALSE
      ENDIF
    ENDIF
  ENDWHILE

  //どちらを選んだか
  IF $LWK_IS_CHANGE == TRUE THEN
    //がんばります
    _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_OK_MSGID, LWK_CHANGE_OK_MSGID )
	  _BALLOONWIN_OBJMSG( LWK_CHANGE_OK_MSGID, LWK_OBJID )
	  _BALLOONWIN_CLOSE()

    //転職
    _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_RESIDENT_AUTO )

    //○○に転職した
    _RESORT_SET_WORD( RESORT_WORD_SHOP_GENRE, 0 )
    _RESORT_SET_WORD( RESORT_WORD_SHOP, 1 )
    _SYSWIN_MSG( resort_sys_07, POS_DOWN )
    _SYSWIN_CLOSE()

    //マップチェンジ
    _RESORT_NEW_INSTATITUTION_ENTRANCE( LWK_X, LWK_Z )
    _MAP_CHANGE( ZONE_ID_C16, LWK_X, LWK_Z, 0 )

  ELSE
    //このまま　やります
    _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_NG_MSGID, LWK_CHANGE_NG_MSGID )
	  _BALLOONWIN_OBJMSG( LWK_CHANGE_NG_MSGID, LWK_OBJID )
	  _BALLOONWIN_CLOSE()

    //マージフラグOFF
    _RESORT_MERGE_OFF()
  ENDIF
}
_RET

//==============================================================
//サブルーチン：住民施設処理
//==============================================================
sub_resident_institution:
{
	DEFINE_LOCAL LWK_GREET_MSGID
	DEFINE_LOCAL LWK_BYE_MSGID
	DEFINE_LOCAL LWK_RECENT_MSGID
	DEFINE_LOCAL LWK_SHOP_MSGID

  //挨拶文
  _RESORT_GET_MSGID( RESORT_RESIDENT_GREET_MSGID, LWK_GREET_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, 1 )

	_BALLOONWIN_OBJMSG_POS( LWK_GREET_MSGID, LWK_OBJID, POS_DL )
	_LAST_KEYWAIT()

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_resident_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_RESIDENT_INSTITUTION THEN  //施設
      //TODO 施設処理
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_RESIDENT_DOING THEN        //最近どう？
      _RESORT_GET_MSGID( RESORT_MSGID_RECENT, LWK_RECENT_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_RECENT_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()

    CASE SEQ_RESIDENT_TROUBLE THEN      //困ってない？
      //TODO あとでクエスト処理をいれる
      _RESORT_GET_MSGID( RESORT_RESIDENT_BYE_MSGID, LWK_BYE_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_BYE_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()

    CASE SEQ_RESIDENT_BYE THEN          //またね
      _RESORT_GET_MSGID( RESORT_RESIDENT_BYE_MSGID, LWK_BYE_MSGID )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, 0 )
	    _BALLOONWIN_OBJMSG( LWK_BYE_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE
}
_RET

//==============================================================
//サブルーチン：住民メニュー表示
//==============================================================
sub_resident_main_menu:
{
  DEFINE_LOCAL LWK_SHOPINFO_MSGID

  //どうしますか？
  _RESORT_GET_MSGID( RESORT_MSGID_SHOP_INFO, LWK_SHOPINFO_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_SHOP, 0 )
	_BALLOONWIN_OBJMSG_POS( LWK_SHOPINFO_MSGID, LWK_OBJID, POS_DL )

  _RESORT_SET_WORD( RESORT_WORD_SHOP_LABEL, 0 )
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
  _BMPMENU_MAKE_LIST( resort_sys_select_29, SEQ_RESIDENT_INSTITUTION )	//買うとか
	_BMPMENU_MAKE_LIST( resort_sys_select_04, SEQ_RESIDENT_DOING )	    //最近どう？
	_BMPMENU_MAKE_LIST( resort_sys_select_09, SEQ_RESIDENT_TROUBLE )	  //困ってない？
	_BMPMENU_MAKE_LIST( resort_sys_select_10, SEQ_RESIDENT_BYE )	      //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
	_BALLOONWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_RESIDENT_BYE
  ENDIF
}
_RET

/**************************************************************/
/*            滞在者用スクリプト                              */
/**************************************************************/
EVENT_START    ev_resort_visitor
{
	DEFINE_LOCAL LWK_GREET_MSGID
  DEFINE_LOCAL LWK_IS_EVENT
  DEFINE_LOCAL LWK_GO_MSGID
  DEFINE_LOCAL LWK_RECENT_MSGID
  DEFINE_LOCAL LWK_BYE_MSGID

	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, 1 )
  _RESORT_GET_MSGID( RESORT_VISITOR_GREET_MSGID, LWK_GREET_MSGID )
	_BALLOONWIN_OBJMSG( LWK_GREET_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //イベントをしていなければ、行う
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_EVENT, LWK_IS_EVENT )
  IF $LWK_IS_EVENT == TRUE THEN
    //なにかイベントをする
    //対戦、交換、タマゴ取得、アイテム取得
  ENDIF

  //どこにいきたいか文
  _RESORT_GET_MSGID( RESORT_MSGID_WHERETOGO, LWK_GO_MSGID )
	_BALLOONWIN_OBJMSG( LWK_GO_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_visitor_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_VISITOR_SPOT THEN          //スポット(共通処理)
      _CALL sub_tourist_spot

    CASE SEQ_VISITOR_DOING THEN        //最近どう？
      _RESORT_GET_MSGID( RESORT_MSGID_RECENT, LWK_RECENT_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_RECENT_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_VISITOR_BYE THEN          //またね
      _RESORT_GET_MSGID( RESORT_VISITOR_BYE_MSGID, LWK_BYE_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_BYE_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：滞在者メニュー表示
//==============================================================
sub_visitor_main_menu:
{
  //どうしますか？
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )
	_SYSWIN_MSG( resort_sys_select_11, POS_DOWN )

	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST( resort_sys_select_03, SEQ_VISITOR_SPOT )	    //おすすめスポット
	_BMPMENU_MAKE_LIST( resort_sys_select_04, SEQ_VISITOR_DOING )	    //最近どう？
	_BMPMENU_MAKE_LIST( resort_sys_select_10, SEQ_VISITOR_BYE )	      //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_VISITOR_BYE
  ENDIF
}
_RET

/**************************************************************/
/*            秘書  執務用スクリプト                          */
/**************************************************************/
EVENT_START    ev_resort_secretary_work
{
	DEFINE_LOCAL LWK_GREET_MSGID
	DEFINE_LOCAL LWK_GOSSIP_MSGID
	DEFINE_LOCAL LWK_BYE_MSGID

	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_GREET_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_GREET, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, 2 )
	_BALLOONWIN_OBJMSG( LWK_GREET_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_secretary_work_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_SECRETARY_WORK_GOSSIP THEN       //噂
      _RESORT_GET_MSGID( RESORT_MSGID_GOSSIP, LWK_GOSSIP_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_GOSSIP_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_SECRETARY_WORK_CONSTRUCTION THEN //工事
      //_CALL sub_tourist_scout
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_SECRETARY_WORK_HELP THEN         //おしえて
      //_CALL sub_tourist_bye
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_SECRETARY_WORK_BYE THEN          //またね
      _RESORT_GET_MSGID( RESORT_SECRETARY_BYE_MSGID, LWK_BYE_MSGID )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, 0 )
	    _BALLOONWIN_OBJMSG( LWK_BYE_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE


  _RESORT_TALK_END()
}
EVENT_END

