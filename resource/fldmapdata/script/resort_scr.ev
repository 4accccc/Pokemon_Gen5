/**************************************************************/
/*            セレブ                                          */
/**************************************************************/
EVENT_START ev_resort_celeb
{
	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )


  //挨拶文
  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 1 )
  _RESORT_GET_MSGID( RESORT_CELEB_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	_BALLOONWIN_CLOSE()

  //訪問してきました
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
	_SYSWIN_MSG( resort_sys_select_00, POS_DOWN )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_seleb_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_CELEB_SPOT THEN         //おすすめスポット
      _CALL sub_tourist_spot
    CASE SEQ_CELEB_TRADE THEN         //ポケモン交換
      _CALL sub_celeb_trade
    CASE SEQ_CELEB_BYE THEN          //またね
      _CALL sub_tourist_bye
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：チュートリアル２案内メニュー表示
//==============================================================
sub_seleb_menu:
{
  _SYSWIN_MSG( msg_exp_window , POS_DOWN ) // 説明文表示用のウィンドウを表示
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST_EX( resort_sys_select_03, resort_sys_select_info_03, SEQ_CELEB_SPOT )	    //スポット

  _RESORT_GET_MY_DATA( RESORT_MY_PARAM_CELEB_TRADE_FLAG, LWK_RET )

  IF $LWK_RET == FALSE THEN
	  _BMPMENU_MAKE_LIST_EX( resort_sys_select_48, resort_sys_select_info_11, SEQ_CELEB_TRADE )	    //トレード
  ENDIF
	_BMPMENU_MAKE_LIST_EX( resort_sys_select_10, resort_sys_select_info_10, SEQ_CELEB_BYE )	      //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_CELEB_BYE
  ENDIF
}
_RET

//==============================================================
//サブルーチン：セレブ交換処理
//==============================================================
sub_celeb_trade:
{
  //こうかんしない？
  _RESORT_GET_MSGID( RESORT_CELEB_TRADE_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

  //はい/いいえ
 	_YES_NO_WIN( LWK_YESNO )


  IF $LWK_YESNO == SCR_YES THEN
    
    DEFINE_LOCAL LWK_SELECT   // 選択ポケモン

    //こうかんするポケモンを選んで
    _RESORT_GET_MSGID( RESORT_CELEB_TRADE_SELECT_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	  _BALLOONWIN_CLOSE()
    
    // ポケモン選択画面開く
    _SELECT_TEMOTI_POKE( LWK_RET, LWK_SELECT, 0 )

    IF $LWK_RET == TRUE THEN
      DEFINE_LOCAL LWK_TRADE_POKE

      //交換ポケモンナンバー
      _RESORT_GET_DATA( RESORT_GET_PARAM_CELEB_TRADE_NO, LWK_TRADE_POKE )

      // 選択したポケモンが交換可能かチェック
      _FIELD_POKE_TRADE_CHECK( LWK_RET, LWK_TRADE_POKE, LWK_SELECT )

      IF $LWK_RET == FLD_TRADE_ENABLE THEN
        //交換処理
        _FIELD_POKE_TRADE( LWK_TRADE_POKE, LWK_SELECT )

        //交換完了
        _RESORT_SET_MY_DATA( RESORT_MY_PARAM_CELEB_TRADE_FLAG, TRUE )

        //かわいがってね
        _RESORT_GET_MSGID( RESORT_CELEB_TRADE_OK_MSGID, LWK_MSGID )
	      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	      _BALLOONWIN_CLOSE()
        _RET
        
      ELSE
        //それ違うよ
        _RESORT_GET_MSGID( RESORT_CELEB_TRADE_NG_MSGID, LWK_MSGID )
	      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	      _BALLOONWIN_CLOSE()
        _RET
      ENDIF


    ELSE
      //またのきかい
      _RESORT_GET_MSGID( RESORT_CELEB_TRADE_BYE_MSGID, LWK_MSGID )
	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	    _BALLOONWIN_CLOSE()
      _RET
    ENDIF

  ELSE
    //またのきかい
    _RESORT_GET_MSGID( RESORT_CELEB_TRADE_BYE_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	  _BALLOONWIN_CLOSE()
    _RET
  ENDIF
}
_RET
