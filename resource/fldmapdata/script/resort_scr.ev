_ANIME_LABEL	anm_visible_on
  _ANIME_DATA AC_VANISH_OFF,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*            デバッグスクリプト                              */
/**************************************************************/
EVENT_START ev_reserve_resort_debug
{
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE

	_BMPMENU_INIT_EX( 1, 1, 0, 1, LWK_MENU_RET )
	_BMPMENU_MAKE_LIST( resort_debug_03,   3 ) //チュートリアル終了
	_BMPMENU_MAKE_LIST( resort_debug_00,   0 ) //建てたカメラ
	_BMPMENU_MAKE_LIST( resort_debug_01,   1 ) //案内カメラ
	_BMPMENU_MAKE_LIST( resort_debug_02,   2 ) //街カメラ
	_BMPMENU_MAKE_LIST( resort_debug_12,   4 ) //パレード実行
	_BMPMENU_START()

  SWITCH $LWK_MENU_RET
  CASE 0 THEN
    _CALL sub_debug_num_menu
    
    IF $LWK_MENU_RET != EV_WIN_B_CANCEL THEN
      $LWK_CAMERA_INDEX = $LWK_MENU_RET

	    _BLACK_OUT()
	    _DISP_FADE_END_CHECK()
		  _CAMERA_START()		//カメラ操作開始
		  _CAMERA_PURGE()		//カメラのバインドを解く
      _CALL sub_shopbuild_camera
      _BLACK_IN()
      _DISP_FADE_END_CHECK()

      _AB_KEYWAIT()

      _CALL sub_camera_ret_fade
    ENDIF

  CASE 1 THEN
    _CALL sub_debug_num_menu
    _CALL sub_debug_grade_menu

    IF $LWK_MENU_RET != EV_WIN_B_CANCEL && $LWK_GRADE != EV_WIN_B_CANCEL THEN
      $LWK_CAMERA_INDEX = $LWK_MENU_RET

	    _BLACK_OUT()
	    _DISP_FADE_END_CHECK()
		  _CAMERA_START()		//カメラ操作開始
		  _CAMERA_PURGE()		//カメラのバインドを解く
      _CALL sub_setspot_camera_core
      _BLACK_IN()
      _DISP_FADE_END_CHECK()

      _AB_KEYWAIT()

      _CALL sub_camera_ret_fade
    ENDIF

  CASE 2 THEN

	  _BLACK_OUT()
	  _DISP_FADE_END_CHECK()
		_CAMERA_START()		//カメラ操作開始
		_CAMERA_PURGE()		//カメラのバインドを解く
    _CALL sub_city_camera
    _BLACK_IN()
    _DISP_FADE_END_CHECK()

    _AB_KEYWAIT()

    _CALL sub_camera_ret_fade
  CASE 3 THEN
    IF $WK_SCENE_C16_TUTORIAL_SEQ != 6 THEN
      $WK_SCENE_C16_TUTORIAL_SEQ  = 6
      $WK_SCENE_C16_TUTORIAL_01   = 1
      _RESORT_SET_MY_DATA( RESORT_MY_PARAM_IS_TUTORIAL, FALSE )
      //秘書を追加
      _RESORT_SET_PRESET_PEOPLE( RESORT_PEOPLE_TYPE_SECRETARY, RESORT_PRESET_SECRETARY_01 )
      _RESORT_SET_PRESET_PEOPLE( RESORT_PEOPLE_TYPE_SECRETARY, RESORT_PRESET_SECRETARY_02 )

      _MAP_CHANGE( ZONE_ID_R04, 430, 490, DIR_UP )
      $LWK_MENU_LOOP = FALSE
    ENDIF

  CASE 4 THEN
    $WK_SCENE_C16_PARADE = 1

    _FLAG_SET( SYS_FLAG_BGM_C16_PARADE )
    _MAP_CHANGE( ZONE_ID_C16, 15, 70, DIR_UP )
    $LWK_MENU_LOOP = FALSE
  DEFAULT
    $LWK_MENU_LOOP = FALSE
  ENDSWITCH

  ENDWHILE
}
EVENT_END

//==============================================================
//サブルーチン：数値メニュー
//==============================================================
sub_debug_num_menu:
{
	_BMPMENU_INIT_EX( 1, 1, 0, 1, LWK_MENU_RET )
	_BMPMENU_MAKE_LIST( resort_debug_04,   0 ) //1
	_BMPMENU_MAKE_LIST( resort_debug_05,   1 ) //2
	_BMPMENU_MAKE_LIST( resort_debug_06,   2 ) //3
	_BMPMENU_MAKE_LIST( resort_debug_07,   3 ) //4
	_BMPMENU_MAKE_LIST( resort_debug_08,   4 ) //5
	_BMPMENU_MAKE_LIST( resort_debug_09,   5 ) //6
	_BMPMENU_MAKE_LIST( resort_debug_10,   6 ) //7
	_BMPMENU_MAKE_LIST( resort_debug_11,   7 ) //8
	_BMPMENU_START()
}
_RET

//==============================================================
//サブルーチン：数値メニュー
//==============================================================
sub_debug_grade_menu:
{
	_BMPMENU_INIT_EX( 1, 1, 0, 1, LWK_GRADE )
	_BMPMENU_MAKE_LIST( resort_debug_04,   0 ) //1
	_BMPMENU_MAKE_LIST( resort_debug_05,   1 ) //2
	_BMPMENU_MAKE_LIST( resort_debug_06,   2 ) //3
	_BMPMENU_START()
}
_RET
