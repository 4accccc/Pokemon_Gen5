  _END

/**************************************************************/
/*            旅行者用スクリプト                              */
/**************************************************************/
EVENT_START ev_resort_tourist
{
  DEFINE_LOCAL LWK_PRESENT_ID

	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 2 )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_TOURIST_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

  //街気になる文
  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
  _RESORT_GET_MSGID( RESORT_TOURIST_CITY_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

  //アイテム取得イベント
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_ID, LWK_PRESENT_ID )

  IF $LWK_PRESENT_ID != 0 THEN
    _RESORT_GET_MSGID( RESORT_TOURIST_ITEM_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	  _BALLOONWIN_CLOSE()

    //アイテムをもらった！
  	_ITEM_EVENT_KEYWAIT( LWK_PRESENT_ID, 1 )
    _RESORT_END_ITEM()

    _ADD_RECORD( RECID_RESORT_PRESENT_CNT, 1 )
  ELSE
	  _BALLOONWIN_CLOSE()
  ENDIF

  //訪問してきました
  //_RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
	//_SYSWIN_MSG( resort_sys_select_00, POS_DOWN )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_tourist_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_TOURIST_INVITATION THEN   //招待
      _CALL sub_tourist_invitation
    CASE SEQ_TOURIST_SCOUT THEN        //スカウト
      _CALL sub_tourist_scout
    CASE SEQ_TOURIST_DOING THEN        //最近どうしてる？
      _CALL sub_recent_doing
    CASE SEQ_TOURIST_SPOT THEN         //おすすめスポット
      _CALL sub_tourist_spot
    CASE SEQ_TOURIST_BYE THEN          //またね
      _CALL sub_tourist_bye
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：旅行者メニュー表示
//==============================================================
sub_tourist_main_menu:
{
  DEFINE_LOCAL LWK_IS_SECRETARY_FULL 
  DEFINE_LOCAL LWK_IS_INSTITUTION_EMPTY
  DEFINE_LOCAL LWK_PEOPLE_TYPE

  _SYSWIN_MSG( msg_exp_window , POS_DOWN ) // 説明文表示用のウィンドウを表示
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST_EX( resort_sys_select_01, resort_sys_select_info_01, SEQ_TOURIST_INVITATION )	//招待

  //スポットは施設がないとでない
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_INSTITUTION_EMPTY, LWK_IS_INSTITUTION_EMPTY )
  IF $LWK_IS_INSTITUTION_EMPTY == FALSE THEN
	  _BMPMENU_MAKE_LIST_EX( resort_sys_select_03, resort_sys_select_info_03, SEQ_TOURIST_SPOT )	    //スポット
  ENDIF

  //スカウトは秘書がいっぱいでないとでない
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_SCOUT, LWK_IS_SECRETARY_FULL )
  IF $LWK_IS_SECRETARY_FULL == TRUE THEN
	  _BMPMENU_MAKE_LIST_EX( resort_sys_select_02, resort_sys_select_info_02, SEQ_TOURIST_SCOUT )	    //スカウト
  ENDIF

  //代理人はでない
  _RESORT_GET_DATA( RESORT_GET_PARAM_PEOPLE_TYPE, LWK_PEOPLE_TYPE )

  IF $LWK_PEOPLE_TYPE != RESORT_PEOPLE_TYPE_PROXY THEN
    _RESORT_GET_DATA( RESORT_GET_PARAM_NUM_RECORD, LWK_RET )
    _RESORT_GET_DATA( RESORT_GET_PARAM_HAS_MEDAL, LWK_YESNO )
    IF $LWK_RET > 0 || $LWK_YESNO == TRUE THEN
	    _BMPMENU_MAKE_LIST_EX( resort_sys_select_04, resort_sys_select_info_04, SEQ_TOURIST_DOING )	      //さいきんどう？
    ENDIF
  ENDIF

	_BMPMENU_MAKE_LIST_EX( resort_sys_select_10, resort_sys_select_info_10, SEQ_TOURIST_BYE )	        //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_TOURIST_BYE
  ENDIF
}
_RET


//==============================================================
//サブルーチン：旅行者招待
//==============================================================
sub_tourist_invitation:
{
  DEFINE_LOCAL LWK_IS_FULL

  $LWK_FUNCTION_RETURN  = FALSE

  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_INSTITUTION_FULL, LWK_IS_FULL )

  //アピール文
  _RESORT_GET_MSGID( RESORT_MSGID_APPEAL, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

	//メニュー表示
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
  _BMPMENU_MAKE_LIST( resort_sys_select_34, SCR_YES )
  _BMPMENU_MAKE_LIST( resort_sys_select_35, SCR_NO )
	_BMPMENU_START()

	 _BALLOONWIN_CLOSE()
  IF $LWK_MENU_RET == SCR_NO || $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    _RET
  ENDIF

  //いっぱいだったときどれをけすか
  IF $LWK_IS_FULL == TRUE THEN
  
    _SYSWIN_MSG( resort_sys_11, POS_DOWN )
    _SYSWIN_CLOSE()

    _RESORT_CHANGE_OV_TO_SHOP()

    _RESORT_CALL_LIST( RESORT_LIST_TYPE_SELECT, RESORT_LIST_SELECT_INSTATITUTION_DEL, RESORT_LIST_CAMERA_GRID,LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM, LWK_LIST_RET_PARAM2, LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )

    _RESORT_CHANGE_OV_TO_COMMON()

    IF $LWK_LIST_RET_TYPE == RESORT_LIST_CANCEL THEN
      _RET
    ENDIF

    //一人消す
    _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MODE_ERASE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX )
  ENDIF

  //案内招待カウント
   _ADD_RECORD( RECID_RESORT_SHOP_MAKE_CNT, 1 )

  //喜び文を表示
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 2 )

  _RESORT_GET_MSGID( RESORT_TOURIST_JOY_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	_BALLOONWIN_CLOSE()

  _RESORT_SET_WORD( RESORT_WORD_WANT_SHOP_GENRE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_WANT_SHOP, RESORT_WORD_PARAM_FRONT, 0, 1 )

  //フェードアウト
	_MAP_FADE_BLACK_OUT_SLOW()
	_MAP_FADE_END_CHECK()

  //何かに転職
  _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_RESIDENT, LWK_INDEX )
  _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MODE_ERASE, RESORT_DELTE_PEOPLE_MINE, 0 )

	_FIELD_CLOSE()
	_FIELD_OPEN()
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
  $LWK_CAMERA_INDEX = $LWK_INDEX
  _CALL sub_shopbuild_camera
	_MAP_FADE_BLACK_IN_SLOW()
	_MAP_FADE_END_CHECK()

  //施設メッセージ
  _SYSWIN_MSG( resort_sys_00_00, POS_DOWN )

  _ME_PLAY( SEQ_ME_AVENUE_01 )
  _SYSWIN_MSG( resort_sys_00_me, POS_DOWN )
	_ME_WAIT()
	_AB_KEYWAIT_MARK()

  _SYSWIN_MSG( resort_sys_00_01, POS_DOWN )
  _SYSWIN_CLOSE()

  //フェードアウト
  _CALL sub_camera_ret_fade

  //選択肢終了
  $LWK_MENU_LOOP = FALSE

  //成功
  $LWK_FUNCTION_RETURN  = TRUE
}
_RET

//==============================================================
//サブルーチン：旅行者スカウト
//==============================================================
sub_tourist_scout:
{
  _RESORT_GET_DATA( RESORT_GET_PARAM_CHECK_SCOUT, LWK_RET )

  SWITCH $LWK_RET
  CASE RESORT_CHECK_SCOUT_YES THEN  //OK
    _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 0 )
    _RESORT_GET_MSGID( RESORT_TOURIST_SCOUT_YES_MSGID, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	  _BALLOONWIN_CLOSE()

	  _SYSWIN_MSG( resort_sys_12, POS_DOWN )
	  _SYSWIN_CLOSE()
	
    _RESORT_CHANGE_OV_TO_SHOP()

	  _RESORT_CALL_LIST( RESORT_LIST_TYPE_SELECT, RESORT_LIST_SELECT_SECRETARY_DEL, RESORT_LIST_CAMERA_GRID,LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM, LWK_LIST_RET_PARAM2, LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )

    _RESORT_CHANGE_OV_TO_COMMON()

	  IF $LWK_LIST_RET_TYPE != RESORT_LIST_CANCEL THEN
	
      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 1 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 2 )

      _RESORT_GET_MSGID( RESORT_TOURIST_SCOUT_THANKS_MSGID, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	    _BALLOONWIN_CLOSE()

	    //フェードアウト
		  _BLACK_OUT()
		  _DISP_FADE_END_CHECK()
	
	    //秘書を一人消し
	    _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MODE_ERASE, RESORT_PEOPLE_TYPE_SECRETARY, LWK_LIST_RET_IDX )
	
	    //旅行者を秘書に
	    _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_SECETARY, LWK_INDEX )
	
	    //転職したのでこの人は消える
	    _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MODE_ERASE, RESORT_DELTE_PEOPLE_MINE, 0 )
	
	    _BLACK_IN()
	    _DISP_FADE_END_CHECK()
	
	    //選択肢終了
	    $LWK_MENU_LOOP = FALSE
	  ENDIF
  CASE RESORT_CHECK_SCOUT_NO THEN //だめ
    _RESORT_GET_MSGID( RESORT_TOURIST_SCOUT_NO_MSGID, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	  _BALLOONWIN_CLOSE()
  CASE RESORT_CHECK_SCOUT_REFUSE THEN //興味なし
    _RESORT_GET_MSGID( RESORT_TOURIST_SCOUT_REFUSE_MSGID, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	  _BALLOONWIN_CLOSE()
  ENDSWITCH
}
_RET

//==============================================================
//サブルーチン：旅行者・住人　最近どう？
//==============================================================
sub_recent_doing:
{
  DEFINE_LOCAL LWK_RECENT
  DEFINE_LOCAL LWK_CNT
  DEFINE_LOCAL LWK_MAX

  $LWK_MENU_SUBLOOP = TRUE
  WHILE $LWK_MENU_SUBLOOP == TRUE
	  //なにを　ききますか
	  _SYSWIN_MSG( resort_sys_19, POS_DOWN )
		_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
	
    _RESORT_GET_DATA( RESORT_GET_PARAM_NUM_RECORD, LWK_RET )
    IF $LWK_RET > 0 THEN
	    _BMPMENU_MAKE_LIST( resort_sys_select_37, SEQ_RECENT_RECORD )	  //できごとをきく
    ENDIF
    _RESORT_GET_DATA( RESORT_GET_PARAM_HAS_MEDAL, LWK_RET )
    IF $LWK_RET == TRUE THEN
		  _BMPMENU_MAKE_LIST( resort_sys_select_38, SEQ_RECENT_MEDAL )	  //メダルをきく
    ENDIF
		_BMPMENU_MAKE_LIST( resort_sys_select_49, SEQ_RECENT_BYE )	    //もどる
		_BMPMENU_START()
	
	  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
	    $LWK_MENU_RET = SEQ_RECENT_BYE
	  ENDIF

    _SYSWIN_CLOSE()
	
	  SWITCH $LWK_MENU_RET
	  CASE SEQ_RECENT_RECORD THEN
      _RESORT_GET_DATA( RESORT_GET_PARAM_NUM_RECORD, LWK_MAX )

      $LWK_CNT = 0
      IF $LWK_MAX > 0 THEN
        WHILE $LWK_CNT < $LWK_MAX
          $LWK_RECENT = $LWK_CNT
          $LWK_RECENT += RESORT_MSGID_RECENT_00

          _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 0 )
          _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 1 )
          _RESORT_GET_MSGID( LWK_RECENT, LWK_MSGID )
      	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
          $LWK_CNT += 1

          IF $LWK_CNT < $LWK_MAX THEN
            _RESORT_GET_MSGID( RESORT_MSGID_RECORD_NEXT, LWK_MSGID )
      	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
          ENDIF
        ENDWHILE

      ELSE
        _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 0 )
        _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 1 )
        _RESORT_GET_MSGID( RESORT_MSGID_RECORD_NONE, LWK_MSGID )
      	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
      ENDIF
	    _BALLOONWIN_CLOSE()

	  CASE SEQ_RECENT_MEDAL THEN
      _RESORT_GET_DATA( RESORT_GET_PARAM_HAS_MEDAL, LWK_RET )
      IF $LWK_RET == TRUE THEN
        _RESORT_GET_MSGID( RESORT_MSGID_MEDAL_HAVE, LWK_MSGID )
      	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	      _BALLOONWIN_CLOSE()

        _RESORT_CALL_MEDALINFO()
      ELSE
        _RESORT_GET_MSGID( RESORT_MSGID_MEDAL_NONE, LWK_MSGID )
      	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	      _BALLOONWIN_CLOSE()
      ENDIF

	  CASE SEQ_RECENT_BYE THEN
      $LWK_MENU_SUBLOOP = FALSE
    DEFAULT
      $LWK_MENU_SUBLOOP = FALSE
	  ENDSWITCH

  ENDWHILE
}
_RET

//==============================================================
//サブルーチン：旅行者スポット
//==============================================================
sub_tourist_spot:
{
  DEFINE_LOCAL  LWK_MAIN_EXP
  DEFINE_LOCAL  LWK_CITY_EXP
  DEFINE_LOCAL  LWK_CITY

  $LWK_FUNCTION_RETURN  = FALSE

  //スポット文を表示
  _RESORT_GET_MSGID( RESORT_MSGID_WHERETOGO, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	_BALLOONWIN_CLOSE()

  //施設選択
  _RESORT_CHANGE_OV_TO_SHOP()

  _RESORT_CALL_LIST( RESORT_LIST_TYPE_SELECT, RESORT_LIST_SELECT_INSTATITUTION, RESORT_LIST_CAMERA_GRID,LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM, LWK_LIST_RET_PARAM2, LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )

  _RESORT_CHANGE_OV_TO_COMMON()

  IF $LWK_LIST_RET_TYPE != RESORT_LIST_CANCEL THEN
    //案内カウント
    _ADD_RECORD( RECID_RESORT_GUID_CNT, 1 )

    //いってきます
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 1 )
    _RESORT_GET_MSGID( RESORT_TOURIST_SPOT_GOING, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	  _BALLOONWIN_CLOSE()

    //おすすめスポットをチェック
    _RESORT_SET_SPOT( LWK_LIST_RET_IDX, LWK_SPOT_RESULT, LWK_MSGID, LWK_MSGID2, LWK_MAIN_EXP )
    $LWK_EXP  = $LWK_MAIN_EXP

    $LWK_CITY_EXP = $LWK_MAIN_EXP
    
    //フェードアウト
    _BLACK_OUT()
    _DISP_FADE_END_CHECK()
	  _CAMERA_START()		//カメラ操作開始
	  _CAMERA_PURGE()		//カメラのバインドを解く

    //コンボ初期化
    _RESORT_COMBO( LWK_LIST_RET_IDX, RESORT_COMBO_PARAM_INIT, LWK_RET, LWK_RET )

    //お店にきた
    _CALL sub_come_shop
    IF $LWK_COME_SHOP_RET != 0 THEN
      $LWK_CITY = TRUE
    ELSE
      $LWK_CITY = FALSE
    ENDIF

    //もしオススメがあれば
    WHILE $LWK_COME_SHOP_RET == 2
      //オススメのお店にきた
      $LWK_LIST_RET_IDX = $LWK_COMBO_IDX

      //成功するか取得
      _RESORT_COMBO( LWK_COMBO_IDX, RESORT_COMBO_PARAM_SHOPRESULT, LWK_SPOT_RESULT, LWK_RET )
      //評価文取得
      _RESORT_COMBO( LWK_SPOT_RESULT, RESORT_COMBO_PARAM_GRADE_MSGID, LWK_MSGID, LWK_RET )

      
      _RESORT_GET_MSGID( RESORT_TOURIST_COMBO_EFF_MSGID, LWK_MSGID2 )

      //コンボの経験値取得
      _RESORT_COMBO( LWK_MAIN_EXP, RESORT_COMBO_PARAM_EXP, LWK_EXP, LWK_RET )

      IF $LWK_SPOT_RESULT == TRUE THEN
        $LWK_CITY_EXP = $LWK_EXP
      ENDIF

      //コンボ確定！
      _RESORT_COMBO( LWK_COMBO_IDX, RESORT_COMBO_PARAM_DECIDE, LWK_RET, LWK_RET )
      _CALL sub_come_shop
    ENDWHILE

    //街へ経験値加算
    IF $LWK_CITY == TRUE THEN
      $LWK_EXP = $LWK_CITY_EXP
      _CALL sub_city_app_exp
      _SYSWIN_CLOSE()
    ENDIF


    //チュートリアル用処理
    IF $LWK_TUTORIAL_MODE  == TRUE THEN
      _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 15, 0, 71, DIR_UP )
    ENDIF


    //表示ON
    _CALL sub_crowdpeople_visible_on

    //黒いうちにけす
    _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MODE_ERASE, RESORT_DELTE_PEOPLE_MINE, 0 )

    //演出終了（開始してなかったら何もしない）
    _RESORT_END_EFFECT( RESORT_EFFECT_CONFETTI )

	  //自機にカメラを戻す
	  _CAMERA_DEF_MOVE (1) 
	  _CAMERA_WAIT_MOVE()
	  _CAMERA_BIND()		//カメラバインド
	  _CAMERA_END()		//カメラ操作終了

    _BLACK_IN()
    _DISP_FADE_END_CHECK()

    _RESORT_GET_MY_DATA( RESORT_MY_PARAM_IS_FEVER, LWK_RET )
    IF $LWK_RET == TRUE && $LOCALWORK11 == 0 THEN
      //フィーバーメッセージ
      _SYSWIN_MSG( resort_sys_21, POS_DOWN )
	    _LAST_KEYWAIT()
      _SYSWIN_CLOSE()
      $LOCALWORK11  = 1
    ENDIF

    //選択肢終了
    $LWK_MENU_LOOP = FALSE

    //成功
    $LWK_FUNCTION_RETURN  = TRUE
  ENDIF
}
_RET

//==============================================================
//サブルーチン：お店に来る処理
//  LWK_LIST_RET_IDX[in]    お店番号
//  LWK_SPOT_RESULT[in]     スポット結果  
//  LWK_MSGID[in]           満足文章
//  LWK_MSGID2[in]          演出文章
//  LWK_EXP[in]             経験値
//
//  LWK_COME_SHOP_RET[out]  0 気に入らなかった
//                          1 気に入った終了 
//                          2 気に入ってオススメのお店
//  
//==============================================================
sub_come_shop:
{
  DEFINE_LOCAL LWK_MSGID3
  DEFINE_LOCAL LWK_LV

  //カメラ切り替え
  $LWK_CAMERA_INDEX = $LWK_LIST_RET_IDX
  _CALL sub_setspot_camera
  _BLACK_IN()
  _DISP_FADE_END_CHECK()

  //～が　おすすめしたみせに　やってきた！
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 1 )
  _SYSWIN_MSG( resort_sys_15, POS_DOWN )

  //先にコンボ結果を取得し、コンボ演出文をいれる
  _RESORT_COMBO( LWK_LIST_RET_IDX, RESORT_COMBO_PARAM_RECOMMEND, LWK_COMBO_RET, LWK_COMBO_IDX )

  //コンボ演出文はセレブは出さない
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_CELEB, LWK_RET )
  _RESORT_GET_MY_DATA( RESORT_MY_PARAM_IS_ENABLE_COMBO, LWK_YESNO )

  IF $LWK_RET == FALSE && $LWK_YESNO == TRUE THEN
    SWITCH $LWK_COMBO_RET
    CASE RESORT_COMBO_RESULT_SUCSESS THEN
      _GET_RND( LWK_RET, 20 )
      $LWK_MSGID3 = 0
      IF $LWK_RET <= 0 THEN
        _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_EFF_MSGID_RARE, LWK_MSGID3 )
      ELSIF $LWK_RET <= 5 THEN
        _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_EFF_MSGID_HIGH, LWK_MSGID3 )
      ELSIF $LWK_RET < 14 THEN
        _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_EFF_MSGID_LOW, LWK_MSGID3 )
      ENDIF
  
      IF $LWK_MSGID3 != 0 THEN
        _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 0 )
        _SYSWIN_MSG( LWK_MSGID3, POS_DOWN )
      ENDIF
    CASE RESORT_COMBO_RESULT_FAILER THEN
      _GET_RND( LWK_RET, 8 )
      $LWK_MSGID3 = 0
      IF $LWK_RET <= 0 THEN
        _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_EFF_MSGID_HIGH, LWK_MSGID3 )
      ELSIF $LWK_RET < 3 THEN
        _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_EFF_MSGID_LOW, LWK_MSGID3 )
      ENDIF
  
      IF $LWK_MSGID3 != 0 THEN
        _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 0 )
        _SYSWIN_MSG( LWK_MSGID3, POS_DOWN )
      ENDIF
    CASE RESORT_COMBO_RESULT_PITY THEN
      _GET_RND( LWK_RET, 12 )
      $LWK_MSGID3 = 0
      IF $LWK_RET <= 2 THEN
        _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_EFF_MSGID_HIGH, LWK_MSGID3 )
      ELSIF $LWK_RET < 7 THEN
        _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_EFF_MSGID_LOW, LWK_MSGID3 )
      ENDIF
  
      IF $LWK_MSGID3 != 0 THEN
        _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 0 )
        _SYSWIN_MSG( LWK_MSGID3, POS_DOWN )
      ENDIF
    ENDSWITCH
  ENDIF

  //お店の人の挨拶
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 2 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 3 )
  _SYSWIN_MSG( resort_sys_15_01, POS_DOWN )


  //お店に来た人の挨拶文
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 4 )
  _RESORT_GET_MSGID( RESORT_TOURIST_SHOP_GREET_MSGID, LWK_MSGID3 )
  _SYSWIN_MSG( LWK_MSGID3, POS_DOWN )

  //満足したかどうか
  IF $LWK_SPOT_RESULT == FALSE THEN
    //満足しなかった
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 1 )
    _SYSWIN_MSG( LWK_MSGID, POS_DOWN )

    //気に入らなかった
    $LWK_COME_SHOP_RET  = 0

  ELSE

    $LWK_COME_SHOP_RET  = 1

    //演出文
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 1 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 2 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 3 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 4 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 5 )

    //演出文はセレブは出さない
    _RESORT_GET_DATA( RESORT_GET_PARAM_IS_CELEB, LWK_RET )
    IF $LWK_RET == FALSE THEN
      _SYSWIN_MSG( LWK_MSGID2, POS_DOWN )
    ENDIF

    //満足した
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
    _SYSWIN_MSG( LWK_MSGID, POS_DOWN )

    //お店に経験値が入る
    _RESORT_ADD_EXP_SHOP( LWK_LIST_RET_IDX, LWK_EXP, LWK_RET, LWK_LV )
    $LWK_LV += 1

    //LVMAXの分岐
    IF $LWK_RET != RESORT_SET_SPOT_SHOP_LVMAX THEN

      _NUMBER( 5, LWK_EXP, 5 )
      _SYSWIN_MSG( resort_sys_16, POS_DOWN )
      _SE_WAIT()
      //TODO SEループバグのため一旦コメント
      //_SE_PLAY( SEQ_SE_SW_JA_EXP )
      //_SE_WAIT()

      _NUMBER( 6, LWK_LV, 2 )
      //施設レベルアップ
      SWITCH $LWK_RET
      CASE RESORT_SET_SPOT_SHOP_LVUP THEN
        _SYSWIN_MSG( resort_sys_13_00, POS_DOWN )
        _ME_PLAY( SEQ_ME_AVENUE_01 )
        _SYSWIN_MSG( resort_sys_13_me, POS_DOWN )
        _ME_WAIT()
        _AB_KEYWAIT_MARK()
        _SYSWIN_MSG( resort_sys_13_01, POS_DOWN )

      CASE RESORT_SET_SPOT_SHOP_CHANGE THEN
        _SYSWIN_MSG( resort_sys_13_00, POS_DOWN )
        _ME_PLAY( SEQ_ME_AVENUE_01 )
        _SYSWIN_MSG( resort_sys_13_me, POS_DOWN )
        _ME_WAIT()
        _AB_KEYWAIT_MARK()
        _SYSWIN_MSG( resort_sys_13_01, POS_DOWN )

        _SYSWIN_CLOSE()
        //変化した店を見せるためにフィールド開き直し
        //フェードアウト
        _MAP_FADE_WHITE_OUT_SLOW()
        _MAP_FADE_END_CHECK()
        _CALL sub_camera_ret
        _FIELD_CLOSE()
        _FIELD_OPEN()
	      _CAMERA_START()		//カメラ操作開始
	      _CAMERA_PURGE()		//カメラのバインドを解く

        _RESORT_RESET_MMDL( LWK_LIST_RET_IDX )

        $LWK_CAMERA_INDEX = $LWK_LIST_RET_IDX
        _CALL sub_shopbuild_camera
        _MAP_FADE_WHITE_IN_SLOW()
        _MAP_FADE_END_CHECK()

        _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 0 )
          //○○から○○になった！
        _ME_PLAY( SEQ_ME_AVENUE_02 )
        _SYSWIN_MSG( resort_sys_20_me, POS_DOWN )
        _ME_WAIT()
        _AB_KEYWAIT_MARK()
      ENDSWITCH
    ENDIF

    //オススメするかどうか
    SWITCH $LWK_COMBO_RET
    CASE RESORT_COMBO_RESULT_SUCSESS THEN
      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 0 )

      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 1 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 2 )

      //いってみませんか？
      _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_RECOMMEND_MSGID, LWK_MSGID )
      _SYSWIN_MSG( LWK_MSGID, POS_DOWN )

      //いってみます
      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 1 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 2 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 3 )
      _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_OK_MSGID, LWK_MSGID )
      _SYSWIN_MSG( LWK_MSGID, POS_DOWN )

      //おしえた
      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 0 )
      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 1 )
      _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_PEOPLE_TYPE_RESIDENT, LWK_COMBO_IDX, 2 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 3 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 4 )
      _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_TEACH_MSGID, LWK_MSGID )
      _SYSWIN_MSG( LWK_MSGID, POS_DOWN )

      $LWK_COME_SHOP_RET  = 2
    CASE RESORT_COMBO_RESULT_FAILER THEN
      $LWK_COME_SHOP_RET  = 1
    CASE RESORT_COMBO_RESULT_PITY THEN
      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 0 )

      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 1 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX, 2 )

      //いってみませんか？
      _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_RECOMMEND_MSGID, LWK_MSGID )
      _SYSWIN_MSG( LWK_MSGID, POS_DOWN )

      //またこんど
      _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 3 )
      _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_NG_MSGID, LWK_MSGID )
      _SYSWIN_MSG( LWK_MSGID, POS_DOWN )

      $LWK_COME_SHOP_RET  = 1
    ENDSWITCH
  ENDIF

  _SYSWIN_CLOSE()

  //フェードアウト
  _BLACK_OUT()
  _DISP_FADE_END_CHECK()

  _CALL sub_crowdpeople_visible_on
}
_RET

//==============================================================
//サブルーチン：街経験値加算処理
//  LWK_EXP[in]             経験値
//==============================================================
sub_city_app_exp:
{
  DEFINE_LOCAL LWK_RET2
  DEFINE_LOCAL LWK_LV

  //街に経験値が入る
  _RESORT_ADD_EXP_CITY( LWK_EXP, LWK_RET2, LWK_LV )
      
  //LV最大以外は街カメラへいく
  IF $LWK_RET2 != RESORT_SET_SPOT_CITY_LVMAX THEN

    _CALL sub_crowdpeople_visible_on

    //街カメラで人が見えてしまうので消す
	  _OBJ_ANIME( LWK_OBJID, anm_off_visible )
    _OBJ_ANIME_WAIT()

    _CALL sub_city_camera
    _BLACK_IN()
    _DISP_FADE_END_CHECK()

    //経験値加算メッセージ
    _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
    _NUMBER( 7, LWK_EXP, 5 )

    _SYSWIN_MSG( resort_sys_17, POS_DOWN )
    _SE_WAIT()
    //TODO SEループバグのため一旦コメント
    //_SE_PLAY( SEQ_SE_SW_JA_EXP )
    //_SE_WAIT()

    //街レベルアップ
    IF $LWK_RET2 == RESORT_SET_SPOT_CITY_LVUP || $LWK_RET2 == RESORT_SET_SPOT_CITY_LVUP_PRIZE || $LWK_RET2 == RESORT_SET_SPOT_CITY_LVUP_RANK || $LWK_RET2 == RESORT_SET_SPOT_CITY_LVUP_PRIZE_RANK THEN
      _RESORT_START_EFFECT( RESORT_EFFECT_CONFETTI )

      _NUMBER( 8, LWK_LV, 4 )
      _SYSWIN_MSG( resort_sys_18_00, POS_DOWN )
      _ME_PLAY( SEQ_ME_AVENUE_02 )
      _SYSWIN_MSG( resort_sys_18_me, POS_DOWN )
	    _ME_WAIT()
	    _AB_KEYWAIT_MARK()
      _SYSWIN_MSG( resort_sys_18_01, POS_DOWN )

      //肩書き
      IF $LWK_RET2 == RESORT_SET_SPOT_CITY_LVUP_RANK || $LWK_RET2 == RESORT_SET_SPOT_CITY_LVUP_PRIZE_RANK THEN
        _RESORT_SET_WORD( RESORT_WORD_CITY_RANK, RESORT_WORD_PARAM_NONE, 0, 2 )
        _SYSWIN_MSG( resort_sys_18_02, POS_DOWN )
      ENDIF

      //ご褒美
      IF $LWK_RET2 == RESORT_SET_SPOT_CITY_LVUP_PRIZE || $LWK_RET2 == RESORT_SET_SPOT_CITY_LVUP_PRIZE_RANK THEN

        _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
        _SYSWIN_MSG( resort_sys_22, POS_DOWN )
        //=========================================
        //LVアップしてご褒美があったのでご褒美イベント開始
        $WK_SCENE_C16R0101_PRIZE = 1
        //=========================================
      ENDIF
    ENDIF

    //フェードイン
    _BLACK_OUT()
    _DISP_FADE_END_CHECK()

  ENDIF
}
_RET

//--------------------------------------------------------------------
//消す
//--------------------------------------------------------------------
_ANIME_LABEL	anm_off_visible
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

//==============================================================
//サブルーチン：案内用カメラセット
//==============================================================
sub_setspot_camera:
{
  DEFINE_LOCAL LWK_TMP

  $LWK_TMP  = $LWK_CAMERA_INDEX
  $LWK_TMP  += RESORT_GET_PARAM_GRADE_RESIDENT_00
  _RESORT_GET_DATA( LWK_TMP, LWK_GRADE )

  _CALL sub_setspot_camera_core
}
_RET

//==============================================================
//サブルーチン：案内用カメラセット内部
//==============================================================
sub_setspot_camera_core:
{
  _CALL sub_people_visible_off

  SWITCH $LWK_CAMERA_INDEX
  CASE 0 THEN
    SWITCH $LWK_GRADE
    CASE 0 THEN
	    _CAMERA_MOVE( RESORT_SCAM1_SHOP1_PITCH,RESORT_SCAM1_SHOP1_YAW,RESORT_SCAM1_SHOP1_DIST,RESORT_SCAM1_SHOP1_X,RESORT_SCAM1_SHOP1_Y,RESORT_SCAM1_SHOP1_Z,1 )
    CASE 1 THEN
	    _CAMERA_MOVE( RESORT_SCAM2_SHOP1_PITCH,RESORT_SCAM2_SHOP1_YAW,RESORT_SCAM2_SHOP1_DIST,RESORT_SCAM2_SHOP1_X,RESORT_SCAM2_SHOP1_Y,RESORT_SCAM2_SHOP1_Z,1 )
    CASE 2 THEN
	    _CAMERA_MOVE( RESORT_SCAM3_SHOP1_PITCH,RESORT_SCAM3_SHOP1_YAW,RESORT_SCAM3_SHOP1_DIST,RESORT_SCAM3_SHOP1_X,RESORT_SCAM3_SHOP1_Y,RESORT_SCAM3_SHOP1_Z,1 )
    ENDSWITCH
  CASE 1 THEN
    SWITCH $LWK_GRADE
    CASE 0 THEN
	    _CAMERA_MOVE( RESORT_SCAM1_SHOP2_PITCH,RESORT_SCAM1_SHOP2_YAW,RESORT_SCAM1_SHOP2_DIST,RESORT_SCAM1_SHOP2_X,RESORT_SCAM1_SHOP2_Y,RESORT_SCAM1_SHOP2_Z,1 )
    CASE 1 THEN
	    _CAMERA_MOVE( RESORT_SCAM2_SHOP2_PITCH,RESORT_SCAM2_SHOP2_YAW,RESORT_SCAM2_SHOP2_DIST,RESORT_SCAM2_SHOP2_X,RESORT_SCAM2_SHOP2_Y,RESORT_SCAM2_SHOP2_Z,1 )
    CASE 2 THEN
	    _CAMERA_MOVE( RESORT_SCAM3_SHOP2_PITCH,RESORT_SCAM3_SHOP2_YAW,RESORT_SCAM3_SHOP2_DIST,RESORT_SCAM3_SHOP2_X,RESORT_SCAM3_SHOP2_Y,RESORT_SCAM3_SHOP2_Z,1 )
    ENDSWITCH
  CASE 2 THEN
    SWITCH $LWK_GRADE
    CASE 0 THEN
	    _CAMERA_MOVE( RESORT_SCAM1_SHOP3_PITCH,RESORT_SCAM1_SHOP3_YAW,RESORT_SCAM1_SHOP3_DIST,RESORT_SCAM1_SHOP3_X,RESORT_SCAM1_SHOP3_Y,RESORT_SCAM1_SHOP3_Z,1 )
    CASE 1 THEN
	    _CAMERA_MOVE( RESORT_SCAM2_SHOP3_PITCH,RESORT_SCAM2_SHOP3_YAW,RESORT_SCAM2_SHOP3_DIST,RESORT_SCAM2_SHOP3_X,RESORT_SCAM2_SHOP3_Y,RESORT_SCAM2_SHOP3_Z,1 )
    CASE 2 THEN
	    _CAMERA_MOVE( RESORT_SCAM3_SHOP3_PITCH,RESORT_SCAM3_SHOP3_YAW,RESORT_SCAM3_SHOP3_DIST,RESORT_SCAM3_SHOP3_X,RESORT_SCAM3_SHOP3_Y,RESORT_SCAM3_SHOP3_Z,1 )
    ENDSWITCH
  CASE 3 THEN
    SWITCH $LWK_GRADE
    CASE 0 THEN
	    _CAMERA_MOVE( RESORT_SCAM1_SHOP4_PITCH,RESORT_SCAM1_SHOP4_YAW,RESORT_SCAM1_SHOP4_DIST,RESORT_SCAM1_SHOP4_X,RESORT_SCAM1_SHOP4_Y,RESORT_SCAM1_SHOP4_Z,1 )
    CASE 1 THEN
	    _CAMERA_MOVE( RESORT_SCAM2_SHOP4_PITCH,RESORT_SCAM2_SHOP4_YAW,RESORT_SCAM2_SHOP4_DIST,RESORT_SCAM2_SHOP4_X,RESORT_SCAM2_SHOP4_Y,RESORT_SCAM2_SHOP4_Z,1 )
    CASE 2 THEN
	    _CAMERA_MOVE( RESORT_SCAM3_SHOP4_PITCH,RESORT_SCAM3_SHOP4_YAW,RESORT_SCAM3_SHOP4_DIST,RESORT_SCAM3_SHOP4_X,RESORT_SCAM3_SHOP4_Y,RESORT_SCAM3_SHOP4_Z,1 )
    ENDSWITCH
  CASE 4 THEN
    SWITCH $LWK_GRADE
    CASE 0 THEN
	    _CAMERA_MOVE( RESORT_SCAM1_SHOP5_PITCH,RESORT_SCAM1_SHOP5_YAW,RESORT_SCAM1_SHOP5_DIST,RESORT_SCAM1_SHOP5_X,RESORT_SCAM1_SHOP5_Y,RESORT_SCAM1_SHOP5_Z,1 )
    CASE 1 THEN
	    _CAMERA_MOVE( RESORT_SCAM2_SHOP5_PITCH,RESORT_SCAM2_SHOP5_YAW,RESORT_SCAM2_SHOP5_DIST,RESORT_SCAM2_SHOP5_X,RESORT_SCAM2_SHOP5_Y,RESORT_SCAM2_SHOP5_Z,1 )
    CASE 2 THEN
	    _CAMERA_MOVE( RESORT_SCAM3_SHOP5_PITCH,RESORT_SCAM3_SHOP5_YAW,RESORT_SCAM3_SHOP5_DIST,RESORT_SCAM3_SHOP5_X,RESORT_SCAM3_SHOP5_Y,RESORT_SCAM3_SHOP5_Z,1 )
    ENDSWITCH
  CASE 5 THEN
    SWITCH $LWK_GRADE
    CASE 0 THEN
	    _CAMERA_MOVE( RESORT_SCAM1_SHOP6_PITCH,RESORT_SCAM1_SHOP6_YAW,RESORT_SCAM1_SHOP6_DIST,RESORT_SCAM1_SHOP6_X,RESORT_SCAM1_SHOP6_Y,RESORT_SCAM1_SHOP6_Z,1 )
    CASE 1 THEN
	    _CAMERA_MOVE( RESORT_SCAM2_SHOP6_PITCH,RESORT_SCAM2_SHOP6_YAW,RESORT_SCAM2_SHOP6_DIST,RESORT_SCAM2_SHOP6_X,RESORT_SCAM2_SHOP6_Y,RESORT_SCAM2_SHOP6_Z,1 )
    CASE 2 THEN
	    _CAMERA_MOVE( RESORT_SCAM3_SHOP6_PITCH,RESORT_SCAM3_SHOP6_YAW,RESORT_SCAM3_SHOP6_DIST,RESORT_SCAM3_SHOP6_X,RESORT_SCAM3_SHOP6_Y,RESORT_SCAM3_SHOP6_Z,1 )
    ENDSWITCH
  CASE 6 THEN
    SWITCH $LWK_GRADE
    CASE 0 THEN
	    _CAMERA_MOVE( RESORT_SCAM1_SHOP7_PITCH,RESORT_SCAM1_SHOP7_YAW,RESORT_SCAM1_SHOP7_DIST,RESORT_SCAM1_SHOP7_X,RESORT_SCAM1_SHOP7_Y,RESORT_SCAM1_SHOP7_Z,1 )
    CASE 1 THEN
	    _CAMERA_MOVE( RESORT_SCAM2_SHOP7_PITCH,RESORT_SCAM2_SHOP7_YAW,RESORT_SCAM2_SHOP7_DIST,RESORT_SCAM2_SHOP7_X,RESORT_SCAM2_SHOP7_Y,RESORT_SCAM2_SHOP7_Z,1 )
    CASE 2 THEN
	    _CAMERA_MOVE( RESORT_SCAM3_SHOP7_PITCH,RESORT_SCAM3_SHOP7_YAW,RESORT_SCAM3_SHOP7_DIST,RESORT_SCAM3_SHOP7_X,RESORT_SCAM3_SHOP7_Y,RESORT_SCAM3_SHOP7_Z,1 )
    ENDSWITCH
  CASE 7 THEN
    SWITCH $LWK_GRADE
    CASE 0 THEN
	    _CAMERA_MOVE( RESORT_SCAM1_SHOP8_PITCH,RESORT_SCAM1_SHOP8_YAW,RESORT_SCAM1_SHOP8_DIST,RESORT_SCAM1_SHOP8_X,RESORT_SCAM1_SHOP8_Y,RESORT_SCAM1_SHOP8_Z,1 )
    CASE 1 THEN
	    _CAMERA_MOVE( RESORT_SCAM2_SHOP8_PITCH,RESORT_SCAM2_SHOP8_YAW,RESORT_SCAM2_SHOP8_DIST,RESORT_SCAM2_SHOP8_X,RESORT_SCAM2_SHOP8_Y,RESORT_SCAM2_SHOP8_Z,1 )
    CASE 2 THEN
	    _CAMERA_MOVE( RESORT_SCAM3_SHOP8_PITCH,RESORT_SCAM3_SHOP8_YAW,RESORT_SCAM3_SHOP8_DIST,RESORT_SCAM3_SHOP8_X,RESORT_SCAM3_SHOP8_Y,RESORT_SCAM3_SHOP8_Z,1 )
    ENDSWITCH
  ENDSWITCH
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
}
_RET

//==============================================================
//サブルーチン：街用カメラセット
//==============================================================
sub_city_camera:
{

	_CAMERA_MOVE( RESORT_CAM_CITY_PITCH,RESORT_CAM_CITY_YAW,RESORT_CAM_CITY_DIST,RESORT_CAM_CITY_X,RESORT_CAM_CITY_Y,RESORT_CAM_CITY_Z,1 )
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

  //カメラ位置を見るため、カメラ移動させてから呼ぶ
  _RESORT_SET_SCENE_VISIBLE( RESORT_SCENE_VISIBLE_OFF_CAMERA_RANGE )
}
_RET

//==============================================================
//サブルーチン：カメラ戻りフェード
//==============================================================
sub_camera_ret_fade:
{
  //フェードアウト
	_BLACK_OUT()
	_DISP_FADE_END_CHECK()

	//自機にカメラを戻す
  _CALL sub_camera_ret
  _BLACK_IN()
  _DISP_FADE_END_CHECK()
}
_RET

//==============================================================
//サブルーチン：カメラ戻る
//==============================================================
sub_camera_ret:
{
	//自機にカメラを戻す
	_CAMERA_DEF_MOVE (1) 
	_CAMERA_WAIT_MOVE()
	_CAMERA_BIND()		//カメラバインド
	_CAMERA_END()		//カメラ操作終了
  _CALL sub_crowdpeople_visible_on
}
_RET

//==============================================================
//サブルーチン：旅行者またね
//==============================================================
sub_tourist_bye:
{
  //さよなら文を表示
  _RESORT_GET_MSGID( RESORT_TOURIST_BYE_MSGID, LWK_MSGID )

  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 1 )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //選択肢終了
  $LWK_MENU_LOOP = FALSE
}
_RET

/**************************************************************/
/*            住人用スクリプト                                */
/**************************************************************/
EVENT_START    ev_resort_resident
{
	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _CALL sub_resident_institution

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：住民施設処理
//==============================================================
sub_resident_institution:
{
	DEFINE_LOCAL LWK_TYPE

  //挨拶文
  _RESORT_GET_MSGID( RESORT_RESIDENT_GREET_MSGID, LWK_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 2 )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

  //１番！
  _RESORT_GET_MSGID( RESORT_RESIDENT_RANK_MSGID, LWK_MSGID )
  _RESORT_GET_DATA( RESORT_GET_PARAM_INDEX, LWK_INDEX )
  IF $LWK_MSGID != RESORT_MSGID_NONE THEN
    SWITCH $LWK_INDEX
    CASE 0 THEN
      $LWK_RET = $LOCALWORK0
    CASE 1 THEN
      $LWK_RET = $LOCALWORK1
    CASE 2 THEN
      $LWK_RET = $LOCALWORK2
    CASE 3 THEN
      $LWK_RET = $LOCALWORK3
    CASE 4 THEN
      $LWK_RET = $LOCALWORK4
    CASE 5 THEN
      $LWK_RET = $LOCALWORK5
    CASE 6 THEN
      $LWK_RET = $LOCALWORK6
    CASE 7 THEN
      $LWK_RET = $LOCALWORK7
    ENDSWITCH

    IF $LWK_RET == FALSE THEN

      _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 0 )
  	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  
      SWITCH $LWK_INDEX
      CASE 0 THEN
        $LOCALWORK0  = TRUE
      CASE 1 THEN
        $LOCALWORK1  = TRUE
      CASE 2 THEN
        $LOCALWORK2  = TRUE
      CASE 3 THEN
        $LOCALWORK3  = TRUE
      CASE 4 THEN
        $LOCALWORK4  = TRUE
      CASE 5 THEN
        $LOCALWORK5  = TRUE
      CASE 6 THEN
        $LOCALWORK6  = TRUE
      CASE 7 THEN
        $LOCALWORK7  = TRUE
      ENDSWITCH

    ENDIF

  ENDIF


  //フィーバー
  _RESORT_GET_MY_DATA( RESORT_MY_PARAM_IS_FEVER, LWK_RET )
  IF $LWK_RET == TRUE THEN

    _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_FEVER_DAY, RESORT_WORD_PARAM_NONE, 0, 1 )
    _RESORT_GET_MSGID( RESORT_RESIDENT_FEVER_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
  ENDIF

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_resident_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_RESIDENT_INSTITUTION THEN  //施設
      _RESORT_GET_DATA( RESORT_GET_PARAM_SHOPKIND, LWK_TYPE )

      SWITCH $LWK_TYPE
      CASE RESORT_RESIDENT_TYPE_LOT THEN //くじ
        _CALL sub_resident_lot
      CASE RESORT_RESIDENT_TYPE_PARLOR THEN //美容室
        _CALL sub_resident_parlor
      CASE RESORT_RESIDENT_TYPE_MARKET THEN //マーケット
        _CALL sub_resident_market
      CASE RESORT_RESIDENT_TYPE_FLORIST THEN //花屋
        _CALL sub_resident_florist
      CASE RESORT_RESIDENT_TYPE_EXERCICE THEN //道場
        _CALL sub_resident_exercice
      CASE RESORT_RESIDENT_TYPE_NURSERY THEN //保育所
        _CALL sub_resident_nursery
      CASE RESORT_RESIDENT_TYPE_ANTIQUE THEN //古道具屋
        _CALL sub_resident_antique
      CASE RESORT_RESIDENT_TYPE_CAFE THEN //カフェ（レストラン？）
        _CALL sub_resident_cafe
      ENDSWITCH
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_RESIDENT_DOING THEN        //最近どう？
	    _BALLOONWIN_CLOSE()
      _CALL sub_recent_doing

    CASE SEQ_RESIDENT_CHECKEXP THEN   //調子どう？

      _RESORT_GET_MSGID( RESORT_RESIDENT_COMBO_RND_MSGID, LWK_MSGID )
      IF $LWK_MSGID != RESORT_MSGID_NONE THEN
	      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
      ENDIF

      _RESORT_SET_WORD( RESORT_WORD_SHOP_RESTEXP, RESORT_WORD_PARAM_FRONT, 0, 0 )
      _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_WORD_PARAM_FRONT, 0, 1 )
      _RESORT_SET_WORD( RESORT_WORD_SHOP_LV, RESORT_WORD_PARAM_FRONT, 0, 2 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 3 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 4 )

      _RESORT_GET_MSGID( RESORT_RESIDENT_LV_MSGID, LWK_MSGID )
	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

    CASE SEQ_RESIDENT_JOBCHANGE THEN  //転職させる
      _CALL sub_resident_merge

    CASE SEQ_RESIDENT_BYE THEN          //またね
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
      _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 1 )
      _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 2 )
      _RESORT_GET_MSGID( RESORT_RESIDENT_BYE_MSGID, LWK_MSGID )
	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE
}
_RET

//==============================================================
//サブルーチン：住民メニュー表示
//==============================================================
sub_resident_main_menu:
{
  DEFINE_LOCAL LWK_MERGE

  //どうしますか？
  _RESORT_GET_MSGID( RESORT_MSGID_SHOP_INFO, LWK_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_WORD_PARAM_FRONT, 0, 0 )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

  _RESORT_GET_DATA( RESORT_GET_PARAM_MERGE_FLAG, LWK_MERGE )

  _RESORT_SET_WORD( RESORT_WORD_SHOP_LABEL, RESORT_WORD_PARAM_FRONT, 0, 0 )
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
  _BMPMENU_MAKE_LIST( resort_sys_select_29, SEQ_RESIDENT_INSTITUTION )	//買うとか

  _RESORT_GET_DATA( RESORT_GET_PARAM_NUM_RECORD, LWK_RET )
  _RESORT_GET_DATA( RESORT_GET_PARAM_HAS_MEDAL, LWK_YESNO )
  IF $LWK_RET > 0 || $LWK_YESNO == TRUE THEN
	  _BMPMENU_MAKE_LIST( resort_sys_select_04, SEQ_RESIDENT_DOING )	      //最近どう？
  ENDIF
	_BMPMENU_MAKE_LIST( resort_sys_select_09, SEQ_RESIDENT_CHECKEXP )	    //最近どう？

  IF $LWK_MERGE == TRUE THEN
	  _BMPMENU_MAKE_LIST( resort_sys_select_36, SEQ_RESIDENT_JOBCHANGE )	//転職する
  ENDIF

	_BMPMENU_MAKE_LIST( resort_sys_select_10, SEQ_RESIDENT_BYE )	      //またね

	//メニュー表示
	_BMPMENU_START()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_RESIDENT_BYE
  ENDIF
}
_RET

//==============================================================
//サブルーチン：住民施設マージ
//==============================================================
sub_resident_merge:
{
  DEFINE_LOCAL LWK_IS_CHANGE

  //選択肢
  $LWK_MENU_SUBLOOP = TRUE
  WHILE $LWK_MENU_SUBLOOP == TRUE
    //今度○○をやりたいと思っているんで
    _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_MSGID, LWK_MSGID )
    _RESORT_SET_WORD( RESORT_WORD_WANT_SHOP_GENRE, RESORT_WORD_PARAM_FRONT, 0, 0 )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

    //はい/いいえ
 	  _YES_NO_WIN( LWK_YESNO )

    IF $LWK_YESNO == SCR_YES THEN
      $LWK_MENU_SUBLOOP = FALSE
      $LWK_IS_CHANGE = TRUE
    ELSE

      //本当にダメですか？
      _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_CONFIM_MSGID, LWK_MSGID )
	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

      //はい/いいえ
 	    _YES_NO_WIN( LWK_YESNO )

      IF $LWK_YESNO == SCR_YES THEN
        $LWK_MENU_SUBLOOP = FALSE
        $LWK_IS_CHANGE = FALSE
      ENDIF
    ENDIF
  ENDWHILE

  //どちらを選んだか
  IF $LWK_IS_CHANGE == TRUE THEN
    //がんばります

    _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 1 )
    _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_OK_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	  _BALLOONWIN_CLOSE()

    _RESORT_SET_WORD( RESORT_WORD_WANT_SHOP_GENRE, RESORT_WORD_PARAM_FRONT, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_WANT_SHOP, RESORT_WORD_PARAM_FRONT, 0, 1 )

    //フェードアウト
	  _MAP_FADE_BLACK_OUT_SLOW()
	  _MAP_FADE_END_CHECK()

    //転職
    _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_RESIDENT, LWK_INDEX )

	  _FIELD_CLOSE()
	  _FIELD_OPEN()
	  _CAMERA_START()		//カメラ操作開始
	  _CAMERA_PURGE()		//カメラのバインドを解く

    $LWK_CAMERA_INDEX = $LWK_INDEX
    _CALL sub_shopbuild_camera
	  _MAP_FADE_BLACK_IN_SLOW()
	  _MAP_FADE_END_CHECK()

    //○○に転職した
    _SYSWIN_MSG( resort_sys_07, POS_DOWN )
    _SYSWIN_CLOSE()

    //フェードアウト
    _CALL sub_camera_ret_fade

    $LWK_MENU_LOOP = FALSE
  ELSE
    //このまま　やります
    _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_NG_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

    //マージフラグOFF
    //_RESORT_MERGE_OFF()
  ENDIF
}
_RET


//==============================================================
//サブルーチン：お店が建った時用カメラ
//==============================================================
sub_shopbuild_camera:
{
  _CALL sub_crowdpeople_visible_off

  SWITCH $LWK_CAMERA_INDEX
  CASE 0 THEN
	  _CAMERA_MOVE( RESORT_BCAM_SHOP1_PITCH,RESORT_BCAM_SHOP1_YAW,RESORT_BCAM_SHOP1_DIST,RESORT_BCAM_SHOP1_X,RESORT_BCAM_SHOP1_Y,RESORT_BCAM_SHOP1_Z,1 )
  CASE 1 THEN
	  _CAMERA_MOVE( RESORT_BCAM_SHOP2_PITCH,RESORT_BCAM_SHOP2_YAW,RESORT_BCAM_SHOP2_DIST,RESORT_BCAM_SHOP2_X,RESORT_BCAM_SHOP2_Y,RESORT_BCAM_SHOP2_Z,1 )
  CASE 2 THEN
	  _CAMERA_MOVE( RESORT_BCAM_SHOP3_PITCH,RESORT_BCAM_SHOP3_YAW,RESORT_BCAM_SHOP3_DIST,RESORT_BCAM_SHOP3_X,RESORT_BCAM_SHOP3_Y,RESORT_BCAM_SHOP3_Z,1 )
  CASE 3 THEN
	  _CAMERA_MOVE( RESORT_BCAM_SHOP4_PITCH,RESORT_BCAM_SHOP4_YAW,RESORT_BCAM_SHOP4_DIST,RESORT_BCAM_SHOP4_X,RESORT_BCAM_SHOP4_Y,RESORT_BCAM_SHOP4_Z,1 )
  CASE 4 THEN
	  _CAMERA_MOVE( RESORT_BCAM_SHOP5_PITCH,RESORT_BCAM_SHOP5_YAW,RESORT_BCAM_SHOP5_DIST,RESORT_BCAM_SHOP5_X,RESORT_BCAM_SHOP5_Y,RESORT_BCAM_SHOP5_Z,1 )
  CASE 5 THEN
	  _CAMERA_MOVE( RESORT_BCAM_SHOP6_PITCH,RESORT_BCAM_SHOP6_YAW,RESORT_BCAM_SHOP6_DIST,RESORT_BCAM_SHOP6_X,RESORT_BCAM_SHOP6_Y,RESORT_BCAM_SHOP6_Z,1 )
  CASE 6 THEN
	  _CAMERA_MOVE( RESORT_BCAM_SHOP7_PITCH,RESORT_BCAM_SHOP7_YAW,RESORT_BCAM_SHOP7_DIST,RESORT_BCAM_SHOP7_X,RESORT_BCAM_SHOP7_Y,RESORT_BCAM_SHOP7_Z,1 )
  CASE 7 THEN
	  _CAMERA_MOVE( RESORT_BCAM_SHOP8_PITCH,RESORT_BCAM_SHOP8_YAW,RESORT_BCAM_SHOP8_DIST,RESORT_BCAM_SHOP8_X,RESORT_BCAM_SHOP8_Y,RESORT_BCAM_SHOP8_Z,1 )
  ENDSWITCH

	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
}
_RET

