//==============================================================
//サブルーチン：購入リスト共通処理
//==============================================================
sub_resident_buy_list:
{
  _RESORT_CALL_LIST( RESORT_LIST_TYPE_BUY, 0, LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM,LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )

  SWITCH $LWK_LIST_RET_TYPE 
  CASE RESORT_SERVICE_TYPE_EFFORT_SPEDEF THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_SPEPOW THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_AGI THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_DEF THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_POW THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_HP THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_FRIEND THEN
    _CALL sub_resident_service_friend
  CASE RESORT_SERVICE_TYPE_HATCH THEN
    _CALL sub_resident_service_hatch
  CASE RESORT_SERVICE_TYPE_LV THEN
    _CALL sub_resident_service_lv
  CASE RESORT_SERVICE_TYPE_ITEM THEN
    //なにもなし
  CASE RESORT_LIST_CANCEL THEN
    _RESORT_GET_MSGID( RESORT_RESIDENT_BYE_MSGID, LWK_MSGID )
    _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,0 )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DL )
	  _LAST_KEYWAIT()
	  _BALLOONWIN_CLOSE()
  DEFAULT
    //なにもなし
  ENDSWITCH
}
_RET

//==============================================================
//サブルーチン：サービス　努力値アップ
//==============================================================
sub_resident_service_effort:
{
  DEFINE_LOCAL LWK_RET_IDX

  _BALLOONWIN_OBJMSG_POS( resort_exercice_00, LWK_OBJID, POS_DL )
	_BALLOONWIN_CLOSE()
  _SELECT_TEMOTI_POKE( LWK_RET, LWK_RET_IDX, 0 )

  IF $LWK_RET == TRUE THEN
    //たまごチェック
    _CHECK_TEMOTI_EGG( LWK_RET, LWK_RET_IDX )

    IF $LWK_RET == TRUE THEN 
      //選んだものがタマゴだった
      _BALLOONWIN_OBJMSG_POS( resort_exercice_01, LWK_OBJID, POS_DL )
    	_BALLOONWIN_CLOSE()
    ELSE
      SWITCH $LWK_LIST_RET_TYPE 
      CASE RESORT_SERVICE_TYPE_EFFORT_SPEDEF THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_SPEDEF, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_SPEPOW THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_SPEPOW, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_AGI THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_AGI, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_DEF THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_DEF, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_POW THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_POW, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_HP THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_HP, LWK_LIST_RET_PARAM, LWK_RET )
      DEFAULT
      ENDSWITCH

      IF $LWK_RET == TRUE THEN

        _RESORT_USE_MSG_ALPHA( FALSE )
        _RESORT_BLEND_BRIGHTNESS( 0, -16, 15 )

        _RESORT_GET_WORD_SERVICE( LWK_LIST_RET_IDX, RESORT_SERVICE_DATA_EFFECT, LWK_RET )
        _SYSWIN_MSG( LWK_RET, POS_DOWN )
        _SYSWIN_CLOSE()

        _RESORT_BLEND_BRIGHTNESS( -16, 0, 15 )
        _RESORT_USE_MSG_ALPHA( TRUE )

        _BALLOONWIN_OBJMSG_POS( resort_exercice_03, LWK_OBJID, POS_DL )
        //あげた
        _CALL sub_resident_gold
      ELSE
        _BALLOONWIN_OBJMSG_POS( resort_exercice_02, LWK_OBJID, POS_DL )
    	  _BALLOONWIN_CLOSE()
      ENDIF
    ENDIF

  ENDIF
}
_RET

//==============================================================
//サブルーチン：サービス　なつきアップ
//==============================================================
sub_resident_service_friend:
{
  DEFINE_LOCAL LWK_RET_IDX

  _BALLOONWIN_OBJMSG_POS( resort_parlor_00, LWK_OBJID, POS_DL )
	_BALLOONWIN_CLOSE()
  _SELECT_TEMOTI_POKE( LWK_RET, LWK_RET_IDX, 0 )

  IF $LWK_RET == TRUE THEN
    //たまごチェック
    _CHECK_TEMOTI_EGG( LWK_RET, LWK_RET_IDX )

    IF $LWK_RET == TRUE THEN 
      //選んだものがタマゴだった
      _BALLOONWIN_OBJMSG_POS( resort_parlor_01, LWK_OBJID, POS_DL )
    ELSE
      _RESORT_ADD_KINDLY( LWK_RET_IDX, LWK_LIST_RET_PARAM, LWK_RET )

      IF $LWK_RET == TRUE THEN
	      _BLACK_OUT()
	      _DISP_FADE_END_CHECK()
	      _ME_PLAY( SEQ_ME_ASA )
	      _ME_WAIT()
	      _BLACK_IN()
	      _DISP_FADE_END_CHECK()

        _BALLOONWIN_OBJMSG_POS( resort_parlor_03, LWK_OBJID, POS_DL )
        _CALL sub_resident_gold
      ELSE
        _BALLOONWIN_OBJMSG_POS( resort_parlor_02, LWK_OBJID, POS_DL )
      ENDIF
    ENDIF

	  _BALLOONWIN_CLOSE()
  ENDIF
}
_RET

//==============================================================
//サブルーチン：サービス　タマゴふか
//==============================================================
sub_resident_service_hatch:
{
  DEFINE_LOCAL LWK_RET_IDX

  _BALLOONWIN_OBJMSG_POS( resort_nursery_00, LWK_OBJID, POS_DL )
	_BALLOONWIN_CLOSE()
  _SELECT_TEMOTI_POKE( LWK_RET, LWK_RET_IDX, 0 )

  IF $LWK_RET == TRUE THEN
    //たまごチェック
    _CHECK_TEMOTI_EGG( LWK_RET, LWK_RET_IDX )

    IF $LWK_RET == TRUE THEN 
      //選んだものがタマゴだった

      _RESORT_USE_MSG_ALPHA( FALSE )
      _RESORT_BLEND_BRIGHTNESS( 0, -16, 15 )

      _RESORT_GET_WORD_SERVICE( LWK_LIST_RET_IDX, RESORT_SERVICE_DATA_EFFECT, LWK_RET )
      _SYSWIN_MSG( LWK_RET, POS_DOWN )
      _SYSWIN_CLOSE()

      _RESORT_BLEND_BRIGHTNESS( -16, 0, 15 )
      _RESORT_USE_MSG_ALPHA( TRUE )

      _RESORT_HATCH( LWK_RET_IDX )
      _PARTY_POKE_EGG_BIRTH( LWK_RET )

      _BALLOONWIN_OBJMSG_POS( resort_nursery_02, LWK_OBJID, POS_DL )
      _CALL sub_resident_gold
    ELSE
      _BALLOONWIN_OBJMSG_POS( resort_nursery_01, LWK_OBJID, POS_DL )
    ENDIF

	  _BALLOONWIN_CLOSE()
  ENDIF
}
_RET

//==============================================================
//サブルーチン：サービス　LV
//==============================================================
sub_resident_service_lv:
{
  DEFINE_LOCAL LWK_RET_IDX

  _BALLOONWIN_OBJMSG_POS( resort_breeder_00, LWK_OBJID, POS_DL )
	_BALLOONWIN_CLOSE()
  _SELECT_TEMOTI_POKE( LWK_RET, LWK_RET_IDX, 0 )

  IF $LWK_RET == TRUE THEN
    //たまごチェック
    _CHECK_TEMOTI_EGG( LWK_RET, LWK_RET_IDX )

    IF $LWK_RET == TRUE THEN 
      //選んだものがタマゴだった
      _BALLOONWIN_OBJMSG_POS( resort_breeder_01, LWK_OBJID, POS_DL )
    ELSE
      _RESORT_ADD_LV( LWK_RET_IDX, LWK_RET )

      IF $LWK_RET == TRUE THEN
        _RESORT_USE_MSG_ALPHA( FALSE )
        _RESORT_BLEND_BRIGHTNESS( 0, -16, 15 )

        _RESORT_GET_WORD_SERVICE( LWK_LIST_RET_IDX, RESORT_SERVICE_DATA_EFFECT, LWK_RET )
        _SYSWIN_MSG( LWK_RET, POS_DOWN )
        _SYSWIN_CLOSE()

        _RESORT_BLEND_BRIGHTNESS( -16, 0, 15 )
        _RESORT_USE_MSG_ALPHA( TRUE )


        _BALLOONWIN_OBJMSG_POS( resort_breeder_03, LWK_OBJID, POS_DL )
        //あげた
        _CALL sub_resident_gold
      ELSE
        _BALLOONWIN_OBJMSG_POS( resort_breeder_02, LWK_OBJID, POS_DL )
      ENDIF
    ENDIF

	  _BALLOONWIN_CLOSE()
  ENDIF
}
_RET

//==============================================================
//サブルーチン：お金を支払う処理
//==============================================================
sub_resident_gold:
{
  _GOLD_WIN_OPEN( MENU_X1, MENU_Y1 )

  _BALLOONWIN_OBJMSG_POS( resort_sys_10, LWK_OBJID, POS_DL )
	_BALLOONWIN_CLOSE()

  //お金払いとフラグたて
  _RESORT_END_SERVICE( LWK_LIST_RET_PRICE, LWK_LIST_RET_IDX )
  _GOLD_WIN_UPDATE() 

  //お金を支払った！
  _PLAYER_NAME(0)
  _NUMBER( 1, LWK_LIST_RET_PRICE, 6 )
  _SYSWIN_MSG( resort_sys_09, POS_DOWN )
  _SYSWIN_CLOSE()


  _GOLD_WIN_CLOSE()
}
_RET

/**************************************************************/
/*            滞在者用スクリプト                              */
/**************************************************************/
EVENT_START    ev_resort_visitor
{
  DEFINE_LOCAL LWK_IS_EVENT

	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT,0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,1 )
  _RESORT_GET_MSGID( RESORT_VISITOR_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()

  //イベントをしていなければ、行う
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_EVENT, LWK_IS_EVENT )
  IF $LWK_IS_EVENT == TRUE THEN
    //なにかイベントをする
    //対戦、交換、タマゴ取得、アイテム取得
  ENDIF

  //どこにいきたいか文
  _RESORT_GET_MSGID( RESORT_MSGID_WHERETOGO, LWK_MSGID )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_visitor_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_VISITOR_SPOT THEN          //スポット(共通処理)
      _CALL sub_tourist_spot

    CASE SEQ_VISITOR_DOING THEN        //最近どう？
      _RESORT_GET_MSGID( RESORT_MSGID_RECENT, LWK_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_VISITOR_BYE THEN          //またね
      _RESORT_GET_MSGID( RESORT_VISITOR_BYE_MSGID, LWK_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：滞在者メニュー表示
//==============================================================
sub_visitor_main_menu:
{
  //どうしますか？
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT,0 )
	_SYSWIN_MSG( resort_sys_select_11, POS_DOWN )

	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST( resort_sys_select_03, SEQ_VISITOR_SPOT )	    //おすすめスポット
	_BMPMENU_MAKE_LIST( resort_sys_select_04, SEQ_VISITOR_DOING )	    //最近どう？
	_BMPMENU_MAKE_LIST( resort_sys_select_10, SEQ_VISITOR_BYE )	      //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_VISITOR_BYE
  ENDIF
}
_RET

/**************************************************************/
/*            秘書  執務用スクリプト                          */
/**************************************************************/
EVENT_START    ev_resort_secretary_work
{
	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT,0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_GREET, RESORT_WORD_PARAM_FRONT,1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,2 )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_secretary_work_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_SECRETARY_WORK_GOSSIP THEN       //噂
      _RESORT_GET_MSGID( RESORT_MSGID_GOSSIP, LWK_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_SECRETARY_WORK_CONSTRUCTION THEN //工事
      //_CALL sub_tourist_scout
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_SECRETARY_WORK_HELP THEN         //おしえて
      //_CALL sub_tourist_bye
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_SECRETARY_WORK_CITYNAME THEN   //街名
       _RESORT_INPUT_CITYNAME()

    CASE SEQ_SECRETARY_WORK_AUTHERNAME THEN //自分呼び名
       _RESORT_INPUT_AUTHERNAME()

    CASE SEQ_SECRETARY_WORK_AUTHERPHRASE THEN //自分口癖
       _RESORT_INPUT_AUTHERPHRASE()

    CASE SEQ_SECRETARY_WORK_BYE THEN          //またね
      _RESORT_GET_MSGID( RESORT_SECRETARY_BYE_MSGID, LWK_MSGID )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,0 )
	    _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE


  _RESORT_TALK_END()
}
EVENT_END

