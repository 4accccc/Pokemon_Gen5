/**************************************************************/
/*            秘書  パソコン用スクリプト                      */
/**************************************************************/
EVENT_START    ev_resort_secretary_pc
{
	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE

    //挨拶文
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 1 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 2 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 3 )
    _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

    //メニュー表示
    _CALL sub_secretary_pc_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_SECRETARY_PC_BOX THEN    //整理
	    _BALLOONWIN_CLOSE()
      _MAP_FADE_BLACK_OUT()                  // フェードアウト
      _MAP_FADE_END_CHECK()                  //
      _CALL_BOX_PROC( LWK_RET, BOX_MODE_SEIRI )
      _MAP_FADE_BLACK_IN()                   // フェードイン
      _MAP_FADE_END_CHECK()                  //

    CASE SEQ_SECRETARY_PC_RANK THEN   //ランキング
      _CALL sub_secretary_rankwindow

    CASE SEQ_SECRETARY_PC_SORT_SEC THEN //秘書入れ替え
      _CALL sub_secretary_sort_sec

    CASE SEQ_SECRETARY_PC_SORT_SHOP THEN //お店入れ替え
      _CALL sub_secretary_sort_shop

    CASE SEQ_SECRETARY_PC_CHANGE_NEON THEN //ネオン
      _CALL sub_secretary_neon

    CASE SEQ_SECRETARY_PC_BYE THEN
      _RESORT_GET_MSGID( RESORT_SECRETARY_BYE_MSGID, LWK_MSGID )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,0, 0 )
	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	      _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    DEFAULT
    ENDSWITCH

  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：秘書　パソコン用メニュー表示
//==============================================================
sub_secretary_pc_main_menu:
{
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST( resort_sys_select_22, SEQ_SECRETARY_PC_BOX )	//せいり
  _BMPMENU_MAKE_LIST( resort_sys_select_47, SEQ_SECRETARY_PC_RANK )	//ランキング
  _BMPMENU_MAKE_LIST( resort_sys_select_40, SEQ_SECRETARY_PC_SORT_SEC )	  //秘書入れ替え
  _BMPMENU_MAKE_LIST( resort_sys_select_41, SEQ_SECRETARY_PC_SORT_SHOP )  //お店入れ替え

  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_NEON, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_sys_select_13, SEQ_SECRETARY_PC_CHANGE_NEON )	//ネオン
  ENDIF
  _BMPMENU_MAKE_LIST( resort_sys_select_10, SEQ_SECRETARY_PC_BYE )	//またね

	//メニュー表示
	_BMPMENU_START()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_SECRETARY_PC_BYE
  ENDIF
}
_RET


//==============================================================
//サブルーチン：秘書　秘書入れ替え
//==============================================================
sub_secretary_sort_sec:
{
  _BALLOONWIN_CLOSE()

  _RESORT_CHANGE_OV_TO_SHOP()

  _RESORT_CALL_LIST( RESORT_LIST_TYPE_SORT, RESORT_LIST_SORT_SECRETARY, RESORT_LIST_CAMERA_RECEPTION,LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM, LWK_LIST_RET_PARAM2, LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )

  _RESORT_CHANGE_OV_TO_COMMON()

  IF $LWK_LIST_RET_TYPE == TRUE THEN
    _RESORT_GET_MSGID( RESORT_SECRETARY_SECSORT_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
    _BALLOONWIN_CLOSE()
 	  _MAP_FADE_BLACK_OUT_SLOW()
    _MAP_FADE_END_CHECK()
    _FIELD_CLOSE()
	  _FIELD_OPEN()

    _RESORT_RESET_MMDL( RESORT_RESET_MMDL_SECRETARY_ALL )

	  _MAP_FADE_BLACK_IN_SLOW()
	  _MAP_FADE_END_CHECK()
    $LWK_MENU_LOOP = FALSE
  ENDIF
}
_RET


//==============================================================
//サブルーチン：秘書　お店入れ替え
//==============================================================
sub_secretary_sort_shop:
{
  _BALLOONWIN_CLOSE()

  _RESORT_CHANGE_OV_TO_SHOP()

  _RESORT_CALL_LIST( RESORT_LIST_TYPE_SORT, RESORT_LIST_SORT_INSTATITUTION, RESORT_LIST_CAMERA_RECEPTION,LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM, LWK_LIST_RET_PARAM2, LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )

  _RESORT_CHANGE_OV_TO_COMMON()

  IF $LWK_LIST_RET_TYPE == TRUE THEN
    _RESORT_GET_MSGID( RESORT_SECRETARY_SHOPSORT_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
    _BALLOONWIN_CLOSE()
    _MAP_FADE_BLACK_OUT_SLOW()
	  _MAP_FADE_END_CHECK()
	  _FIELD_CLOSE()
	  _FIELD_OPEN()
	  _MAP_FADE_BLACK_IN_SLOW()
	  _MAP_FADE_END_CHECK()
    $LWK_MENU_LOOP = FALSE
  ENDIF
}
_RET

/**************************************************************/
/*            秘書  得意なお店用スクリプト                      */
/**************************************************************/
EVENT_START    ev_resort_secretary_select
{
  DEFINE_LOCAL LWK_CNT

	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 2 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 3 )
  _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

  //選べる箇所が何個あるか
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_LOT, LWK_RET )
  IF $LWK_RET == TRUE THEN
    $LWK_CNT += 1
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_PARLOR, LWK_RET )
  IF $LWK_RET == TRUE THEN
    $LWK_CNT += 1
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_EXERCICE, LWK_RET )
  IF $LWK_RET == TRUE THEN
    $LWK_CNT += 1
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_MARKET, LWK_RET )
  IF $LWK_RET == TRUE THEN
    $LWK_CNT += 1
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_FLORIST, LWK_RET )
  IF $LWK_RET == TRUE THEN
    $LWK_CNT += 1
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_NURSERY, LWK_RET )
  IF $LWK_RET == TRUE THEN
    $LWK_CNT += 1
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_ANTIQUE, LWK_RET )
  IF $LWK_RET == TRUE THEN
    $LWK_CNT += 1
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_CAFE, LWK_RET )
  IF $LWK_RET == TRUE THEN
    $LWK_CNT += 1
  ENDIF

  IF $LWK_CNT == 1 THEN
    //一箇所
    _RESORT_SET_WORD( RESORT_WORD_OWNER_SHOP_GENRE, RESORT_WORD_PARAM_NONE, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 1 )
    _RESORT_GET_MSGID( RESORT_SECRETARY_SEL_ONE, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
  ELSE
    //メニュー表示
    _CALL sub_secretary_select_main_menu
    //複数ヶ所からえらんだ
    _RESORT_SET_WORD( RESORT_WORD_OWNER_SHOP_GENRE, RESORT_WORD_PARAM_NONE, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 1 )
    _RESORT_GET_MSGID( RESORT_SECRETARY_SEL_MANY, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
  ENDIF

  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
  _RESORT_GET_MSGID( RESORT_SECRETARY_BYE_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	_LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：秘書　得意なお店用メニュー表示
//==============================================================
