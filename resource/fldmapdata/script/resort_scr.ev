DEFINE_LOCAL  LWK_RET
DEFINE_LOCAL  LWK_YESNO

DEFINE_LOCAL LWK_LIST_RET_TYPE
DEFINE_LOCAL LWK_LIST_RET_PARAM
DEFINE_LOCAL LWK_LIST_RET_IDX
DEFINE_LOCAL LWK_LIST_RET_PRICE
DEFINE_LOCAL LWK_INDEX


//------------------------------注意--------------------------------//
//																	//
//	NPCのイベントに LOCALWORK11～13 まで使用ししています。		//
