//DEFINE_LOCALの数が多いので、グローバルにおいて使い回しています。
DEFINE_LOCAL  LWK_MENU_RET
DEFINE_LOCAL  LWK_MENU_LOOP
DEFINE_LOCAL  LWK_MENU_SUBLOOP
DEFINE_LOCAL  LWK_OBJID
DEFINE_LOCAL  LWK_MSGID
DEFINE_LOCAL LWK_MSGID2
DEFINE_LOCAL  LWK_RET
DEFINE_LOCAL  LWK_YESNO
DEFINE_LOCAL  LWK_RET_IDX

DEFINE_LOCAL LWK_LIST_RET_TYPE
DEFINE_LOCAL LWK_LIST_RET_PARAM
DEFINE_LOCAL LWK_LIST_RET_PARAM2
DEFINE_LOCAL LWK_LIST_RET_IDX
DEFINE_LOCAL LWK_LIST_RET_PRICE
DEFINE_LOCAL LWK_INDEX
DEFINE_LOCAL LWK_GRADE

DEFINE_LOCAL LWK_FUNCTION_RETURN
DEFINE_LOCAL LWK_TUTORIAL_MODE

DEFINE_LOCAL LWK_CAMERA_INDEX
DEFINE_LOCAL LWK_COME_SHOP_RET
DEFINE_LOCAL LWK_EXP
DEFINE_LOCAL LWK_SPOT_RESULT

DEFINE_LOCAL LWK_COMBO_RET
DEFINE_LOCAL LWK_COMBO_IDX

//------------------------------注意--------------------------------//
//	住民のイベントにLOCALWORK0～7
//	NPCのイベントに LOCALWORK11～13 まで使用ししています。		//
