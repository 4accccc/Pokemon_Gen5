//==============================================================
//サブルーチン：購入リスト共通処理
//==============================================================
sub_resident_buy_list:
{
	_BALLOONWIN_CLOSE()

  _RESORT_CHANGE_OV_TO_SHOP()

  _RESORT_CALL_LIST( RESORT_LIST_TYPE_BUY, 0, RESORT_LIST_CAMERA_SHOP, LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM, LWK_LIST_RET_PARAM2, LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )

  _RESORT_CHANGE_OV_TO_COMMON()

  SWITCH $LWK_LIST_RET_TYPE 
  CASE RESORT_SERVICE_TYPE_EFFORT_SPEDEF THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_SPEPOW THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_AGI THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_DEF THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_POW THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_EFFORT_HP THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_HP_DOWN_FRIEND_UP THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_POW_DOWN_FRIEND_UP THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_DEF_DOWN_FRIEND_UP THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_SP_DOWN_FRIEND_UP THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_SD_DOWN_FRIEND_UP THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_AGI_DOWN_FFIEND_UP THEN
    _CALL sub_resident_service_effort
  CASE RESORT_SERVICE_TYPE_FRIEND THEN
    _CALL sub_resident_service_friend
  CASE RESORT_SERVICE_TYPE_HATCH THEN
    _CALL sub_resident_service_hatch
  CASE RESORT_SERVICE_TYPE_LV THEN
    _CALL sub_resident_service_lv
  CASE RESORT_SERVICE_TYPE_ITEM THEN
    //なにもなし
  CASE RESORT_LIST_CANCEL THEN
    _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 1 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 2 )
    _RESORT_GET_MSGID( RESORT_RESIDENT_BYE_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	  _LAST_KEYWAIT()
	  _BALLOONWIN_CLOSE()
  DEFAULT
    //なにもなし
  ENDSWITCH
}
_RET

//==============================================================
//サブルーチン：サービス　努力値アップ
//==============================================================
sub_resident_service_effort:
{
  //ポケモン選択文
  _CALL sub_poke_select_msg

  _SELECT_TEMOTI_POKE( LWK_RET, LWK_RET_IDX, 0 )

  IF $LWK_RET == TRUE THEN
    //たまごチェック
    _CHECK_TEMOTI_EGG( LWK_RET, LWK_RET_IDX )

    IF $LWK_RET == TRUE THEN 
      //選んだものがタマゴだった
      _RESORT_GET_MSGID( RESORT_SHOP_EGG_NG_MSGID, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
    	_BALLOONWIN_CLOSE()
    ELSE
      SWITCH $LWK_LIST_RET_TYPE 
      CASE RESORT_SERVICE_TYPE_EFFORT_SPEDEF THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_SPEDEF, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_SPEPOW THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_SPEPOW, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_AGI THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_AGI, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_DEF THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_DEF, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_POW THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_POW, LWK_LIST_RET_PARAM, LWK_RET )
      CASE RESORT_SERVICE_TYPE_EFFORT_HP THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_ADD_EFFORT_HP, LWK_LIST_RET_PARAM, LWK_RET )

      CASE RESORT_SERVICE_TYPE_HP_DOWN_FRIEND_UP THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_DEC_EFFORT_HP, LWK_LIST_RET_PARAM, LWK_RET )
        _RESORT_ADD_KINDLY( LWK_RET_IDX, LWK_LIST_RET_PARAM2, LWK_RET )
      CASE RESORT_SERVICE_TYPE_POW_DOWN_FRIEND_UP THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_DEC_EFFORT_POW, LWK_LIST_RET_PARAM, LWK_RET )
        _RESORT_ADD_KINDLY( LWK_RET_IDX, LWK_LIST_RET_PARAM2, LWK_RET )
      CASE RESORT_SERVICE_TYPE_DEF_DOWN_FRIEND_UP THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_DEC_EFFORT_DEF, LWK_LIST_RET_PARAM, LWK_RET )
        _RESORT_ADD_KINDLY( LWK_RET_IDX, LWK_LIST_RET_PARAM2, LWK_RET )
      CASE RESORT_SERVICE_TYPE_SP_DOWN_FRIEND_UP THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_DEC_EFFORT_SPEPOW, LWK_LIST_RET_PARAM, LWK_RET )
        _RESORT_ADD_KINDLY( LWK_RET_IDX, LWK_LIST_RET_PARAM2, LWK_RET )
      CASE RESORT_SERVICE_TYPE_SD_DOWN_FRIEND_UP THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_DEC_EFFORT_SPEDEF, LWK_LIST_RET_PARAM, LWK_RET )
        _RESORT_ADD_KINDLY( LWK_RET_IDX, LWK_LIST_RET_PARAM2, LWK_RET )
      CASE RESORT_SERVICE_TYPE_AGI_DOWN_FFIEND_UP THEN
        _RESORT_ADD_EFFORT( LWK_RET_IDX, RESORT_DEC_EFFORT_AGI, LWK_LIST_RET_PARAM, LWK_RET )
        _RESORT_ADD_KINDLY( LWK_RET_IDX, LWK_LIST_RET_PARAM2, LWK_RET )

      DEFAULT
      ENDSWITCH

      IF $LWK_RET == TRUE THEN

        //演出
        _CALL sub_resident_service_effect

        //演出終了
        _CALL sub_service_end_msg

        //あげた
        _CALL sub_resident_gold
      ELSE
        //努力値あがらない
        _RESORT_GET_MSGID( RESORT_SHOP_DORYOKU_U_NG_MSGID, LWK_MSGID )
        _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
    	  _BALLOONWIN_CLOSE()
      ENDIF
    ENDIF

  ENDIF
}
_RET

//==============================================================
//サブルーチン：サービス　なつきアップ
//==============================================================
sub_resident_service_friend:
{
  //ポケモン選択文
  _CALL sub_poke_select_msg
  _SELECT_TEMOTI_POKE( LWK_RET, LWK_RET_IDX, 0 )

  IF $LWK_RET == TRUE THEN
    //たまごチェック
    _CHECK_TEMOTI_EGG( LWK_RET, LWK_RET_IDX )

    IF $LWK_RET == TRUE THEN 
      //選んだものがタマゴだった
      _RESORT_GET_MSGID( RESORT_SHOP_EGG_NG_MSGID, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	    _BALLOONWIN_CLOSE()
    ELSE
      _RESORT_ADD_KINDLY( LWK_RET_IDX, LWK_LIST_RET_PARAM, LWK_RET )

      IF $LWK_RET == TRUE THEN
        //演出
        _CALL sub_resident_service_effect

        //演出終了
        _CALL sub_service_end_msg

        //お金
        _CALL sub_resident_gold
      ELSE
        //なつきど最大
        _RESORT_GET_MSGID( RESORT_SHOP_NATUKI_NG_MSGID, LWK_MSGID )
        _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	      _BALLOONWIN_CLOSE()
      ENDIF
    ENDIF

  ENDIF
}
_RET

//==============================================================
//サブルーチン：サービス　タマゴふか
//==============================================================
sub_resident_service_hatch:
{
  DEFINE_LOCAL LWK_HATCH

  //ポケモン選択文
  _CALL sub_poke_select_msg
  _SELECT_TEMOTI_TAMAGO( LWK_RET, LWK_RET_IDX, 0 )

  IF $LWK_RET == TRUE THEN
    //たまごチェック
    _CHECK_TEMOTI_EGG( LWK_RET, LWK_RET_IDX )

    IF $LWK_RET == TRUE THEN 
      //選んだものがタマゴだった

      //演出
      _CALL sub_resident_service_effect

      //減らす
      //割合を取得して、百分率で現在の値を減らす
      _RESORT_HATCH( LWK_LIST_RET_IDX, LWK_RET_IDX, LWK_RET )

      IF $LWK_RET == 0 THEN
        _RESORT_GET_MSGID( RESORT_SHOP_NURSERY_HATCH_00_MSGID, LWK_MSGID )
      ELSIF $LWK_RET <= 5 THEN
        _RESORT_GET_MSGID( RESORT_SHOP_NURSERY_HATCH_01_MSGID, LWK_MSGID )
      ELSIF $LWK_RET <= 10 THEN
        _RESORT_GET_MSGID( RESORT_SHOP_NURSERY_HATCH_02_MSGID, LWK_MSGID )
      ELSIF $LWK_RET <= 40 THEN
        _RESORT_GET_MSGID( RESORT_SHOP_NURSERY_HATCH_03_MSGID, LWK_MSGID )
      ELSE
        _RESORT_GET_MSGID( RESORT_SHOP_NURSERY_HATCH_04_MSGID, LWK_MSGID )
      ENDIF
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	    _BALLOONWIN_CLOSE()

      //もし０なら産まれる
      IF $LWK_RET == 0 THEN
        //生まれる
        _PARTY_POKE_EGG_BIRTH( LWK_RET )

        //おわる文
        _RESORT_GET_MSGID( RESORT_SHOP_NURSERY_OK_MSGID, LWK_MSGID )
        _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
      ENDIF

      //お金払う
      _CALL sub_resident_gold
    ELSE
      //タマゴじゃない
      _RESORT_GET_MSGID( RESORT_SHOP_POKE_NG_MSGID, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	    _BALLOONWIN_CLOSE()
    ENDIF

  ENDIF
}
_RET

//==============================================================
//サブルーチン：サービス　LV
//==============================================================
sub_resident_service_lv:
{
  //ポケモン選択文
  _CALL sub_poke_select_msg
  _SELECT_TEMOTI_POKE( LWK_RET, LWK_RET_IDX, 0 )

  IF $LWK_RET == TRUE THEN
    //たまごチェック
    _CHECK_TEMOTI_EGG( LWK_RET, LWK_RET_IDX )

    IF $LWK_RET == TRUE THEN 
      //選んだものがタマゴだった
      _RESORT_GET_MSGID( RESORT_SHOP_EGG_NG_MSGID, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	    _BALLOONWIN_CLOSE()
    ELSE
      _RESORT_ADD_LV( LWK_RET_IDX, LWK_LIST_RET_PARAM, LWK_RET )

      IF $LWK_RET == TRUE THEN

        //演出
        _CALL sub_resident_service_effect
        //終了
        _CALL sub_service_end_msg
        //金支払い
        _CALL sub_resident_gold
      ELSE
        //LVあがらない
        _RESORT_GET_MSGID( RESORT_SHOP_LV_NG_MSGID, LWK_MSGID )
        _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	      _BALLOONWIN_CLOSE()
      ENDIF
    ENDIF
  ENDIF
}
_RET

//==============================================================
//サブルーチン：サービス演出
//==============================================================
sub_resident_service_effect:
{
  //フェードアウト
	_BLACK_OUT()
	_DISP_FADE_END_CHECK()


	//カメラ切り替え
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
  _RESORT_GET_DATA( RESORT_GET_PARAM_INDEX, LWK_CAMERA_INDEX )
  _CALL sub_setspot_camera

  //フェードイン
  _BLACK_IN()
  _DISP_FADE_END_CHECK()

  //演出文
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 1 )
  _TEMOTI_NICK_NAME( 2, LWK_RET_IDX )
  _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 3 )
  _RESORT_GET_WORD_SERVICE( LWK_LIST_RET_IDX, RESORT_SERVICE_DATA_EFFECT, LWK_MSGID )
  _SYSWIN_MSG( LWK_MSGID, POS_DOWN )
  _SYSWIN_CLOSE()

  //フェード
  _CALL sub_camera_ret_fade
}
_RET

//==============================================================
//サブルーチン：ポケモン選択メッセージ
//==============================================================
sub_poke_select_msg:
{
	DEFINE_LOCAL LWK_TYPE

  _RESORT_GET_DATA( RESORT_GET_PARAM_SHOPKIND, LWK_TYPE )

  SWITCH $LWK_TYPE
  CASE RESORT_RESIDENT_TYPE_PARLOR THEN //美容室
    _RESORT_GET_MSGID( RESORT_SHOP_PARLOR_POKESEL_MSGID, LWK_MSGID )
  CASE RESORT_RESIDENT_TYPE_EXERCICE THEN //道場
    _RESORT_GET_MSGID( RESORT_SHOP_EXERCIDE_POKESEL_MSGID, LWK_MSGID )
  CASE RESORT_RESIDENT_TYPE_NURSERY THEN //保育所
    _RESORT_GET_MSGID( RESORT_SHOP_NURSERY_POKESEL_MSGID, LWK_MSGID )
  CASE RESORT_RESIDENT_TYPE_CAFE THEN //カフェ（レストラン？）
    _RESORT_GET_MSGID( RESORT_SHOP_BREEDER_POKESEL_MSGID, LWK_MSGID )
  DEFAULT
    _RESORT_GET_MSGID( RESORT_SHOP_PARLOR_POKESEL_MSGID, LWK_MSGID )
  ENDSWITCH

  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	_BALLOONWIN_CLOSE()
}
_RET

//==============================================================
//サブルーチン：サービス終了メッセージ
//==============================================================
sub_service_end_msg:
{
	DEFINE_LOCAL LWK_TYPE

  _RESORT_GET_DATA( RESORT_GET_PARAM_SHOPKIND, LWK_TYPE )

  SWITCH $LWK_TYPE
  CASE RESORT_RESIDENT_TYPE_PARLOR THEN //美容室
    _RESORT_GET_MSGID( RESORT_SHOP_PARLOR_OK_MSGID, LWK_MSGID )
  CASE RESORT_RESIDENT_TYPE_EXERCICE THEN //道場
    _RESORT_GET_MSGID( RESORT_SHOP_EXERCIDE_OK_MSGID, LWK_MSGID )
  CASE RESORT_RESIDENT_TYPE_CAFE THEN //カフェ（レストラン？）
    _RESORT_GET_MSGID( RESORT_SHOP_BREEDER_OK_MSGID, LWK_MSGID )
  DEFAULT
    _RESORT_GET_MSGID( RESORT_SHOP_PARLOR_OK_MSGID, LWK_MSGID )
  ENDSWITCH

  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
}
_RET

//==============================================================
//サブルーチン：お金を支払う処理
//==============================================================
sub_resident_gold:
{
  _GOLD_WIN_OPEN( MENU_X1, MENU_Y1 )

  _RESORT_GET_MSGID( RESORT_SHOP_MONEY_MSGID, LWK_MSGID )
  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	_BALLOONWIN_CLOSE()

  //お金払いとフラグたて
  _RESORT_END_SERVICE( LWK_LIST_RET_PRICE, LWK_LIST_RET_IDX )
  _SE_PLAY( SEQ_SE_SYS_22 )
  _GOLD_WIN_UPDATE() 

  //お金を支払った！
  _PLAYER_NAME(0)
  //_NUMBER( 1, LWK_LIST_RET_PRICE, 6 ) EndService内で行なっています。
  _SYSWIN_MSG( resort_sys_09, POS_DOWN )
  _SYSWIN_CLOSE()


  _GOLD_WIN_CLOSE()
}
_RET

/**************************************************************/
/*            秘書  執務用スクリプト                          */
/**************************************************************/
EVENT_START    ev_resort_secretary_work
{
	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_secretary_work_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_SECRETARY_WORK_CITYLV THEN       //街情報
      _RESORT_SET_WORD( RESORT_WORD_CITY_LV, RESORT_WORD_PARAM_NONE, 0, 0 )
      _RESORT_SET_WORD( RESORT_WORD_CITY_RESTEXP, RESORT_WORD_PARAM_NONE, 0, 1 )
      _RESORT_SET_WORD( RESORT_WORD_CITY_RANK, RESORT_WORD_PARAM_NONE, 0, 2 )
      _RESORT_GET_MSGID( RESORT_SECRETARY_CITYLV_MSGID, LWK_MSGID )
	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

      _RESORT_GET_MY_DATA( RESORT_MY_PARAM_IS_FEVER, LWK_RET )
      IF $LWK_RET == TRUE THEN
        _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
        _RESORT_SET_WORD( RESORT_WORD_FEVER_DAY, RESORT_WORD_PARAM_NONE, 0, 1 )
        _RESORT_GET_MSGID( RESORT_SECRETARY_FEVER_MSGID, LWK_MSGID )
	      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
      ENDIF

    CASE SEQ_SECRETARY_WORK_CITYNAME THEN   //街名
       _BALLOONWIN_CLOSE()
       _RESORT_INPUT_CITYNAME( TRUE )

    CASE SEQ_SECRETARY_WORK_AUTHERNAME THEN //自分呼び名
       _BALLOONWIN_CLOSE()
       _RESORT_INPUT_AUTHERNAME( TRUE )

    CASE SEQ_SECRETARY_WORK_AUTHERPHRASE THEN //自分口癖
       _BALLOONWIN_CLOSE()
       _RESORT_INPUT_AUTHERPHRASE( TRUE )

    CASE SEQ_SECRETARY_WORK_AUTHERTHANKS THEN //自分感謝
       _BALLOONWIN_CLOSE()
       _RESORT_INPUT_AUTHERTHANKS( TRUE )
    
    CASE SEQ_SECRETARY_WORK_PARADE THEN //パレード
      _RESORT_GET_MSGID( RESORT_SECRETARY_SEL_PARADE, LWK_MSGID )
	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
 	    _YES_NO_WIN( LWK_YESNO )
      IF $LWK_YESNO == SCR_YES THEN
        _BALLOONWIN_CLOSE()
        $WK_SCENE_C16_PARADE = 1
        _FLAG_SET( SYS_FLAG_BGM_C16_PARADE )
        _MAP_CHANGE( ZONE_ID_C16, 15, 70, DIR_UP )
        $LWK_MENU_LOOP = FALSE
      ENDIF

    CASE SEQ_SECRETARY_WORK_BYE THEN          //またね
      _RESORT_GET_MSGID( RESORT_SECRETARY_BYE_MSGID, LWK_MSGID )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE


  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：秘書　執務メニュー表示
//==============================================================
sub_secretary_work_main_menu:
{
  //どうしますか？
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 2 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 3 )
  _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
	_BMPMENU_MAKE_LIST( resort_sys_select_12, SEQ_SECRETARY_WORK_CITYLV )	    //街情報

  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_CITYNAME, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_sys_select_31, SEQ_SECRETARY_WORK_CITYNAME )	//街の呼び名
  ENDIF
  _BMPMENU_MAKE_LIST( resort_sys_select_32, SEQ_SECRETARY_WORK_AUTHERNAME )	//自分の呼び名
  _BMPMENU_MAKE_LIST( resort_sys_select_33, SEQ_SECRETARY_WORK_AUTHERPHRASE )	//くちぐせ
  _BMPMENU_MAKE_LIST( resort_sys_select_39, SEQ_SECRETARY_WORK_AUTHERTHANKS )	//かんげき

  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_PARADE, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_sys_select_52, SEQ_SECRETARY_WORK_PARADE )	//パレード
  ENDIF

  _BMPMENU_MAKE_LIST( resort_sys_select_10, SEQ_SECRETARY_WORK_BYE )	//またね

	//メニュー表示
	_BMPMENU_START()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_SECRETARY_WORK_BYE
  ENDIF
}
_RET

//==============================================================
//サブルーチン：秘書　ネオン選択
//==============================================================
sub_secretary_neon:
{
  DEFINE_LOCAL LWK_X
  DEFINE_LOCAL LWK_Z
  DEFINE_LOCAL LWK_DEFAULT

  _RESORT_GET_MY_DATA( RESORT_MY_PARAM_TEX, LWK_DEFAULT )

  $LWK_MENU_SUBLOOP = TRUE
  WHILE $LWK_MENU_SUBLOOP == TRUE
    //どうしますか？
    _RESORT_GET_MSGID( RESORT_SECRETARY_NEON_SEL_MSGID, LWK_MSGID )
  	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
  
  	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
  	_BMPMENU_MAKE_LIST( resort_sys_select_42, SEQ_SECRETARY_NEON_COOL      )	//かっこいい
    _BMPMENU_MAKE_LIST( resort_sys_select_43, SEQ_SECRETARY_NEON_BEAUTIFUL )	//きれい
    _BMPMENU_MAKE_LIST( resort_sys_select_44, SEQ_SECRETARY_NEON_CUTE      )	//かわいい
    _BMPMENU_MAKE_LIST( resort_sys_select_45, SEQ_SECRETARY_NEON_RICH      )	//ごうか
    _BMPMENU_MAKE_LIST( resort_sys_select_46, SEQ_SECRETARY_NEON_BYE       )	//やめる
  
  	//メニュー表示
  	_BMPMENU_START()

    IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
      $LWK_MENU_RET = SEQ_SECRETARY_NEON_BYE
    ENDIF
  
    IF $LWK_MENU_RET == SEQ_SECRETARY_NEON_BYE THEN

      //見るために変えていたのをもとに戻す
      _RESORT_SET_MY_DATA( RESORT_MY_PARAM_TEX, LWK_DEFAULT )
      $LWK_MENU_SUBLOOP  = FALSE
    ELSE
      _BALLOONWIN_CLOSE()
  
      //見るために変える
      _RESORT_SET_MY_DATA( RESORT_MY_PARAM_TEX, LWK_MENU_RET )
 
      //確認させにZONE移動
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
  
      _PLAYER_POS_GET( LWK_X, LWK_Z )
      _MAP_CHANGE_NO_FADE( ZONE_ID_C16, 0, 0, 0, DIR_UP )
  
  		_CAMERA_START()		//カメラ操作開始
  		_CAMERA_PURGE()		//カメラのバインドを解く
      _CALL sub_city_camera
  
      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
  
  
      //選択肢
      $LWK_MSGID  = $LWK_MENU_RET
      $LWK_MSGID += resort_secretary_talk_11_m
  	  _SYSWIN_MSG( LWK_MSGID, POS_DOWN )
   	  _YES_NO_WIN( LWK_YESNO )
      _SYSWIN_CLOSE()
  
      //確認させにZONE移動　戻ってくる
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
  
  	  _CAMERA_BIND()		//カメラバインド
  	  _CAMERA_END()		//カメラ操作終了
  
      //位置によって飛び先が違う
      IF $LWK_Z == 11 THEN
        IF $LWK_X == 10 THEN
          _MAP_CHANGE_NO_FADE( ZONE_ID_C16R0101, 10, 0, 11, DIR_RIGHT )
        ELSE
          _MAP_CHANGE_NO_FADE( ZONE_ID_C16R0101, 12, 0, 11, DIR_LEFT )
        ENDIF
      ELSE
        IF $LWK_Z == 10 THEN
          _MAP_CHANGE_NO_FADE( ZONE_ID_C16R0101, 11, 0, 10, DIR_DOWN )
        ELSE
          _MAP_CHANGE_NO_FADE( ZONE_ID_C16R0101, 11, 0, 12, DIR_UP )
        ENDIF
      ENDIF


      //戻ってくるとMMDLが破棄されているので再度入れて上げる
      _GET_OBJID( LWK_OBJID, LWK_RET, 11, 0, 11 )
      _RESORT_SET_MY_DATA( RESORT_MY_PARAM_MAPCHANGE_MMDL, LWK_OBJID )
  
      _TURN_HERO_SITE()

      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
  
      IF $LWK_YESNO == SCR_YES THEN
        //変える
        _RESORT_GET_MSGID( RESORT_SECRETARY_NEON_OK_MSGID, LWK_MSGID )
  	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
        $LWK_MENU_SUBLOOP  = FALSE
      ENDIF
    ENDIF
  ENDWHILE
}
_RET

//==============================================================
//サブルーチン：秘書　ランクウィンドウ
//==============================================================
sub_secretary_rankwindow:
{
  $LWK_MENU_RET = 0
  $LWK_MENU_SUBLOOP = TRUE

  WHILE $LWK_MENU_SUBLOOP == TRUE

    //どうしますか？
    _RESORT_GET_MSGID( RESORT_SECRETARY_RANK_SEL_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

	  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
	  _BMPMENU_MAKE_LIST( resort_sys_select_rnk_0, RESORT_RANK_WND_NET_TRADE  )
    _BMPMENU_MAKE_LIST( resort_sys_select_rnk_1, RESORT_RANK_WND_NICKNAME   )
    _BMPMENU_MAKE_LIST( resort_sys_select_rnk_2, RESORT_RANK_WND_JA_TOURIST )
    _BMPMENU_MAKE_LIST( resort_sys_select_rnk_3, RESORT_RANK_WND_BUY_MONEY )
    _BMPMENU_MAKE_LIST( resort_sys_select_rnk_4, RESORT_RANK_WND_CROSSING   )
    _BMPMENU_MAKE_LIST( resort_sys_select_rnk_5, RESORT_RANK_WND_NET_BATTLE )
    _BMPMENU_MAKE_LIST( resort_sys_select_rnk_6, RESORT_RANK_WND_GET_POKE  )
    _BMPMENU_MAKE_LIST( resort_sys_select_rnk_7, RESORT_RANK_WND_HATCH_EGG )	
    _BMPMENU_MAKE_LIST( resort_sys_select_rnk_8, RESORT_RANK_WND_MEDALNUM )	
    _BMPMENU_MAKE_LIST( resort_sys_select_46,  SEQ_SCRETARY_RANK_BYE )	

	  //メニュー表示
	  _BMPMENU_START()

    IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
      $LWK_MENU_RET = SEQ_SCRETARY_RANK_BYE
    ENDIF

    IF $LWK_MENU_RET == SEQ_SCRETARY_RANK_BYE THEN
      $LWK_MENU_SUBLOOP = FALSE
    ELSE
      _BALLOONWIN_CLOSE()
      _RESORT_PRINT_RANKWND( LWK_MENU_RET, LWK_MENU_RET )
    ENDIF
  ENDWHILE
}
_RET

/**************************************************************/
/*            秘書　移動用スクリプト                          */
/**************************************************************/
EVENT_START    ev_resort_secretary_move
{
  DEFINE_LOCAL LWK_SORA_SELECT
  DEFINE_LOCAL LWK_SORA_ZONEID

	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 2 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_THANKS, RESORT_WORD_PARAM_FRONT, 0, 3 )
  _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	_BALLOONWIN_CLOSE()

  //どうしますか？
	_SYSWIN_MSG( resort_sys_select_30, POS_DOWN )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_secretary_move_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_SECRETARY_MOVE_RESORT THEN    //リゾート

      _CALL sub_secretary_move_resort_menu

      SWITCH $LWK_MENU_RET
      CASE SEQ_SECRETARY_MOVE_POS_SPACE THEN
	      _SYSWIN_MSG( resort_sys_select_30, POS_DOWN )
        _SYSWIN_CLOSE()
        _RESORT_TALK_END()
        _MAP_CHANGE( ZONE_ID_C16, 42, 52, DIR_DOWN )
        $LWK_MENU_LOOP = FALSE
      CASE SEQ_SECRETARY_MOVE_POS_GATE THEN
        _SYSWIN_CLOSE()
        _RESORT_TALK_END()
        _MAP_CHANGE( ZONE_ID_C16, 31, 39, DIR_DOWN )
        $LWK_MENU_LOOP = FALSE
      CASE SEQ_SECRETARY_MOVE_POS_WEST THEN
        _SYSWIN_CLOSE()
        _RESORT_TALK_END()
        _MAP_CHANGE( ZONE_ID_C16, 31, 27, DIR_DOWN )
        $LWK_MENU_LOOP = FALSE
      CASE SEQ_SECRETARY_MOVE_POS_EAST THEN
        _SYSWIN_CLOSE()
        _RESORT_TALK_END()
        _MAP_CHANGE( ZONE_ID_C16, 31, 15, DIR_DOWN )
        $LWK_MENU_LOOP = FALSE
      CASE SEQ_SECRETARY_MOVE_POS_BYE THEN 
        $LWK_MENU_LOOP = FALSE
      ENDSWITCH

    CASE SEQ_SECRETARY_MOVE_EASH THEN      //イッシュ
      _SYSWIN_CLOSE()
      _RESORT_TALK_END()

      _MAP_FADE_BLACK_OUT()                  // フェードアウト
      _MAP_FADE_END_CHECK()                  //
      _CALL_SORAWOTOBU( LWK_SORA_SELECT, LWK_SORA_ZONEID )
      _MAP_FADE_BLACK_IN()                   // フェードイン
      _MAP_FADE_END_CHECK()                  //

      IF $LWK_SORA_SELECT == TRUE THEN
        _MAP_CHANGE_DEFAULT_POS( LWK_SORA_ZONEID, 0 )
      ENDIF
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_SECRETARY_MOVE_BYE THEN       //またね
      _SYSWIN_CLOSE()
      _RESORT_GET_MSGID( RESORT_SECRETARY_BYE_MSGID, LWK_MSGID )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
	    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )
	    _LAST_KEYWAIT()
	    _BALLOONWIN_CLOSE()
      _RESORT_TALK_END()
      $LWK_MENU_LOOP = FALSE
    DEFAULT
      _SYSWIN_CLOSE()
      _RESORT_TALK_END()
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE
}
EVENT_END

//==============================================================
//サブルーチン：秘書　移動メインメニュー表示
//==============================================================
sub_secretary_move_main_menu:
{

  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST( resort_sys_select_16, SEQ_SECRETARY_MOVE_RESORT )	//リゾート
