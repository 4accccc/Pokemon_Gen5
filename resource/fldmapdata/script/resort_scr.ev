/**************************************************************/
/*            代理人用スクリプト                              */
/**************************************************************/
EVENT_START ev_resort_proxy
{
  DEFINE_LOCAL LWK_PRESENT_IS_ITEM
  DEFINE_LOCAL LWK_PRESENT_ID
  DEFINE_LOCAL LWK_PRESENT_NUM

	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0 )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_PROXY_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()

  //アイテム取得イベント
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_IS_ITEM, LWK_PRESENT_IS_ITEM )
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_ID, LWK_PRESENT_ID )
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_NUM, LWK_PRESENT_NUM )

  IF $LWK_PRESENT_ID != 0 THEN
    _RESORT_GET_MSGID( RESORT_PROXY_ITEM_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	  _BALLOONWIN_CLOSE()

    IF $LWK_PRESENT_IS_ITEM == TRUE THEN
      //もしアイテムならば
      //アイテムをもらった！
  	  _ITEM_EVENT_KEYWAIT( LWK_PRESENT_ID, LWK_PRESENT_NUM )
    ELSE
      //BPだったら
      //BPを取得した！
      _NUMBER( 0, LWK_PRESENT_NUM, 3 )
	    _SYSWIN_MSG( resort_sys_06, POS_DOWN )
      _SYSWIN_CLOSE()
    ENDIF

    _RESORT_END_ITEM()
  ENDIF

  //飛んで去っていく
  _OBJ_WARP_OUT( LWK_OBJID )

  //去るのを待つ
  _TIME_WAIT( 30 )

  //この人は消える
  _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MINE, 0 )

  _RESORT_TALK_END()
}
EVENT_END

/**************************************************************/
/*            住人用スクリプト                                */
/**************************************************************/
EVENT_START    ev_resort_resident
{
  DEFINE_LOCAL LWK_MERGE

	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_GET_DATA( RESORT_GET_PARAM_MERGE_FLAG, LWK_MERGE )
  //マージチェック
  IF $LWK_MERGE > 0 THEN
    //マージ処理
    _CALL sub_resident_merge
  ELSE
    //施設処理
    _CALL sub_resident_institution
  ENDIF

  _RESORT_TALK_END()
  }
EVENT_END

//==============================================================
//サブルーチン：住民施設処理
//==============================================================
sub_resident_merge:
{
  DEFINE_LOCAL LWK_IS_CHANGE
  DEFINE_LOCAL LWK_X
  DEFINE_LOCAL LWK_Z

  //選択肢
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //今度○○をやりたいと思っているんで
    _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_MSGID, LWK_MSGID )
    _RESORT_SET_WORD( RESORT_WORD_SHOP_GENRE, RESORT_WORD_PARAM_FRONT, 0 )
	  _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )

    //はい/いいえ
 	  _YES_NO_WIN( LWK_YESNO )

    IF $LWK_YESNO == SCR_YES THEN
      $LWK_MENU_LOOP = FALSE
      $LWK_IS_CHANGE = TRUE
    ELSE
      
      //本当にダメですか？
      _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_CONFIM_MSGID, LWK_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )

      //はい/いいえ
 	    _YES_NO_WIN( LWK_YESNO )

      IF $LWK_YESNO == SCR_YES THEN
        $LWK_MENU_LOOP = FALSE
        $LWK_IS_CHANGE = FALSE
      ENDIF
    ENDIF
  ENDWHILE

  //どちらを選んだか
  IF $LWK_IS_CHANGE == TRUE THEN
    //がんばります
    _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_OK_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	  _BALLOONWIN_CLOSE()

    //転職
    _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_RESIDENT_AUTO )

    //○○に転職した
    _RESORT_SET_WORD( RESORT_WORD_SHOP_GENRE, RESORT_WORD_PARAM_FRONT, 0 )
    _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_WORD_PARAM_FRONT, 1 )
    _SYSWIN_MSG( resort_sys_07, POS_DOWN )
    _SYSWIN_CLOSE()

    //マップチェンジ
    _RESORT_NEW_INSTATITUTION_ENTRANCE( LWK_X, LWK_Z )
    _MAP_CHANGE( ZONE_ID_C16, LWK_X, LWK_Z, 0 )

  ELSE
    //このまま　やります
    _RESORT_GET_MSGID( RESORT_RESIDENT_CHANGE_NG_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	  _BALLOONWIN_CLOSE()

    //マージフラグOFF
    _RESORT_MERGE_OFF()
  ENDIF
}
_RET

//==============================================================
//サブルーチン：住民施設処理
//==============================================================
sub_resident_institution:
{
	DEFINE_LOCAL LWK_TYPE

  //挨拶文
  _RESORT_GET_MSGID( RESORT_RESIDENT_GREET_MSGID, LWK_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,1 )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT,0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT,2 )

	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DL )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_resident_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_RESIDENT_INSTITUTION THEN  //施設
      _RESORT_GET_DATA( RESORT_GET_PARAM_TYPE, LWK_TYPE )

      SWITCH $LWK_TYPE
      CASE RESORT_RESIDENT_TYPE_LOT THEN //くじ
        _CALL sub_resident_lot
      CASE RESORT_RESIDENT_TYPE_PARLOR THEN //美容室
        _CALL sub_resident_parlor
      CASE RESORT_RESIDENT_TYPE_BREEDER THEN //育て屋
        _CALL sub_resident_breeder
      CASE RESORT_RESIDENT_TYPE_MARKET THEN //マーケット
        _CALL sub_resident_market
      CASE RESORT_RESIDENT_TYPE_FLORIST THEN //花屋
        _CALL sub_resident_florist
      CASE RESORT_RESIDENT_TYPE_EXERCICE THEN //道場
        _CALL sub_resident_exercice
      CASE RESORT_RESIDENT_TYPE_NURSERY THEN //保育所
        _CALL sub_resident_nursery
      CASE RESORT_RESIDENT_TYPE_JEWELLERY THEN //宝石店
        _CALL sub_resident_jewellery
      CASE RESORT_RESIDENT_TYPE_ANTIQUE THEN //古道具屋
        _CALL sub_resident_antique
      CASE RESORT_RESIDENT_TYPE_CAFE THEN //カフェ（レストラン？）
        _CALL sub_resident_cafe
      CASE RESORT_RESIDENT_TYPE_GYM THEN //ジム
        _CALL sub_resident_gym
      CASE RESORT_RESIDENT_TYPE_HOUSE THEN //民家
        _CALL sub_resident_house
      ENDSWITCH
      $LWK_MENU_LOOP = FALSE

    CASE SEQ_RESIDENT_DOING THEN        //最近どう？
      _RESORT_GET_MSGID( RESORT_MSGID_RECENT, LWK_MSGID )
	    _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	    _BALLOONWIN_CLOSE()

    CASE SEQ_RESIDENT_TROUBLE THEN      //困ってない？
      //TODO 経験値表示をきくことになった
      _RESORT_SET_WORD( RESORT_WORD_SHOP_RESTEXP, RESORT_WORD_PARAM_FRONT,0 )
	    _BALLOONWIN_OBJMSG( resort_sys_14, LWK_OBJID )
	    _BALLOONWIN_CLOSE()

    CASE SEQ_RESIDENT_BYE THEN          //またね
      //TODO　メッセージが邪魔なので消してみた
      //_RESORT_GET_MSGID( RESORT_RESIDENT_BYE_MSGID, LWK_MSGID )
      //_RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE,0 )
	    //_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	    //_LAST_KEYWAIT()
	    //_BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE

    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE
}
_RET

//==============================================================
//サブルーチン：住民メニュー表示
//==============================================================
sub_resident_main_menu:
{

  //どうしますか？
  _RESORT_GET_MSGID( RESORT_MSGID_SHOP_INFO, LWK_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_WORD_PARAM_FRONT,0 )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DL )

  _RESORT_SET_WORD( RESORT_WORD_SHOP_LABEL, RESORT_WORD_PARAM_FRONT,0 )
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
  _BMPMENU_MAKE_LIST( resort_sys_select_29, SEQ_RESIDENT_INSTITUTION )	//買うとか
	_BMPMENU_MAKE_LIST( resort_sys_select_04, SEQ_RESIDENT_DOING )	    //最近どう？
	_BMPMENU_MAKE_LIST( resort_sys_select_09, SEQ_RESIDENT_TROUBLE )	  //困ってない？
	_BMPMENU_MAKE_LIST( resort_sys_select_10, SEQ_RESIDENT_BYE )	      //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
	_BALLOONWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_RESIDENT_BYE
  ENDIF
}
_RET

//==============================================================
//サブルーチン：住民くじびき処理
//==============================================================
sub_resident_lot:
{
  DEFINE_LOCAL LWK_DAY_FLAG

  _RESORT_GET_DATA( RESORT_GET_PARAM_DAY_FLAG, LWK_DAY_FLAG )

  IF $LWK_DAY_FLAG == FALSE THEN
    _RESORT_LOT( 0, LWK_RET )

    IF $LWK_RET == RESORT_LOT_FAILURE THEN
  	  _BALLOONWIN_OBJMSG( resort_lot_00, LWK_OBJID )
    ELSE
      //TODO 何等がなに？
      //データからひっぱってきた値
      _NUMBER( 0, LWK_RET, 2 )
  	  _BALLOONWIN_OBJMSG( resort_lot_01, LWK_OBJID )
    	_BALLOONWIN_CLOSE()
      $LWK_RET += 10
 	    _ITEM_EVENT_KEYWAIT( LWK_RET, 1 )
    ENDIF

    _RESORT_SET_DAY_FLAG() 
  ELSE
  	_BALLOONWIN_OBJMSG( resort_lot_02, LWK_OBJID )
	  _BALLOONWIN_CLOSE()
  ENDIF
}
_RET
