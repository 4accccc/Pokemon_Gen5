  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_EXERCICE, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_shop_genre_05, RESORT_RESIDENT_TYPE_EXERCICE )	  //道場
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_MARKET, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_shop_genre_03, RESORT_RESIDENT_TYPE_MARKET )	    //雑貨屋
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_FLORIST, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_shop_genre_04, RESORT_RESIDENT_TYPE_FLORIST )	  //花屋
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_NURSERY, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_shop_genre_06, RESORT_RESIDENT_TYPE_NURSERY )	  //保育所
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_ANTIQUE, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_shop_genre_08, RESORT_RESIDENT_TYPE_ANTIQUE )	  //古道具屋
  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_CAFE, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_shop_genre_09, RESORT_RESIDENT_TYPE_CAFE )	      //カフェ
  ENDIF
	//メニュー表示
	_BMPMENU_START()
  _RESORT_SET_MY_DATA( RESORT_MY_PARAM_WANT_JOB, LWK_MENU_RET )
}
_RET

/**************************************************************/
/*            代理人　ファン                                  */
/**************************************************************/
EVENT_START ev_resort_proxy_fun
{
	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 2 )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_FUN_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	_BALLOONWIN_CLOSE()

  //訪問してきました
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
	_SYSWIN_MSG( resort_sys_select_00, POS_DOWN )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_proxy_fun_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_TOURIST_INVITATION THEN   //招待
      _CALL sub_tourist_invitation
    CASE SEQ_TOURIST_SPOT THEN         //おすすめスポット
      _CALL sub_tourist_spot
    CASE SEQ_TOURIST_BYE THEN          //またね
      _CALL sub_tourist_bye
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：代理人ファンメニュー表示
//==============================================================
sub_proxy_fun_menu:
{
  DEFINE_LOCAL LWK_IS_INSTITUTION_EMPTY

  _SYSWIN_MSG( msg_exp_window , POS_DOWN ) // 説明文表示用のウィンドウを表示
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST_EX( resort_sys_select_01, resort_sys_select_info_01, SEQ_TOURIST_INVITATION )	//招待

  //スポットは施設がないとでない
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_INSTITUTION_EMPTY, LWK_IS_INSTITUTION_EMPTY )
  IF $LWK_IS_INSTITUTION_EMPTY == FALSE THEN
	  _BMPMENU_MAKE_LIST_EX( resort_sys_select_03, resort_sys_select_info_03, SEQ_TOURIST_SPOT )	    //スポット
  ENDIF

	_BMPMENU_MAKE_LIST_EX( resort_sys_select_10, resort_sys_select_info_10, SEQ_TOURIST_BYE )	        //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_TOURIST_BYE
  ENDIF
}
_RET

/**************************************************************/
/*            NPC　クチコミ                                   */
/**************************************************************/
EVENT_START ev_resort_npc_mouthcomm
{
  DEFINE_LOCAL LWK_TMP

	_TALK_OBJ_START()

  _RESORT_GET_NPC_DATA( LWK_TMP, RESORT_NPC_DATA_OBJID, LWK_OBJID )
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_INDEX, LWK_INDEX )


  //自分のクチコミに何も入力がないならば初回
  $LWK_TMP = $LWK_INDEX
  $LWK_TMP += RESORT_MY_PARAM_GOSSIP_00
  _RESORT_GET_MY_DATA( LWK_TMP, LWK_RET )

  IF $LWK_RET == 0 THEN
    //初回
    
    //初回挨拶
    _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_00, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

    _CALL sub_npc_mouthcomm_question
  ELSE
    //通常

    //選択肢
    _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_01, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

	  //メニュー表示
	  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
    _BMPMENU_MAKE_LIST( resort_mouthcomm_sel_00, SEQ_MOUTHCOMM_HEAR )
    _BMPMENU_MAKE_LIST( resort_mouthcomm_sel_01, SEQ_MOUTHCOMM_ANSWER )
    _BMPMENU_MAKE_LIST( resort_mouthcomm_sel_02, SEQ_MOUTHCOMM_CANCEL )
	  _BMPMENU_START()
    IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
      $LWK_MENU_RET = SEQ_MOUTHCOMM_CANCEL
    ENDIF

    SWITCH $LWK_MENU_RET
    CASE SEQ_MOUTHCOMM_HEAR THEN
      //噂があるかないか
      _CALL sub_npc_mouthcomm_hear
    CASE SEQ_MOUTHCOMM_ANSWER THEN
      _CALL sub_npc_mouthcomm_question
    ENDSWITCH
  ENDIF

	_BALLOONWIN_CLOSE()

}
EVENT_END
//==============================================================
//サブルーチン：クチコミ　うわさをきく部分
//==============================================================
sub_npc_mouthcomm_hear:
{
  //カウンタをリセット
  $LOCALWORK11 = 0

  //クチコミがあるかチェック
  _RESORT_GET_MOUTHCOMM( LWK_INDEX, LOCALWORK11, LWK_RET )
  IF $LWK_RET == 0 THEN
    //とくにうわさはない…
    _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_04, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
  ELSE
    //噂をいう
    _CALL sub_npc_mouthcomm_hear_core
  ENDIF 
}
_RET

//==============================================================
//サブルーチン：クチコミ　うわさをきく部分
//==============================================================
sub_npc_mouthcomm_hear_core:
{
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    
    //クチコミを取得
    _RESORT_GET_MOUTHCOMM( LWK_INDEX, LOCALWORK11, LWK_RET )
    $LOCALWORK11 += 1

    _DEBUG_PRINT_WK( LWK_RET )

    //噂をいう
    $LWK_RET += RESORT_NPC_DATA_MOUTHCOMM_I_00
    //１オリジンになっているので
    $LWK_RET -= 1  

    _DEBUG_PRINT_WK( LWK_RET )

    _RESORT_GET_NPC_DATA( LWK_OBJID, LWK_RET, LWK_MSGID )
	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

    //次があるかチェック
    _RESORT_GET_MOUTHCOMM( LWK_INDEX, LOCALWORK11, LWK_RET )
    //一周した
    IF $LWK_RET == 0 THEN
      $LWK_MENU_LOOP = FALSE
    ELSE
      //もっと聞きたい？
      _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_03, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

      //はい/いいえ
 	    _YES_NO_WIN( LWK_YESNO )
      IF $LWK_YESNO == SCR_NO THEN
        $LWK_MENU_LOOP = FALSE
      ENDIF
    ENDIF

  ENDWHILE

}
_RET

//==============================================================
//サブルーチン：クチコミ　質問部分
//==============================================================
sub_npc_mouthcomm_question:
{
  DEFINE_LOCAL LWK_TMP
  DEFINE_LOCAL LWK_CNT

  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_INDEX, LWK_INDEX )
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_A_NUM, LWK_TMP )

  //質問文
  _BALLOONWIN_CLOSE()
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_Q, LWK_MSGID )
  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

  //選択肢作成
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 0, LWK_MENU_RET )

  WHILE $LWK_CNT < $LWK_TMP
    _DEBUG_PRINT_WK( LWK_CNT )
    _RESORT_SET_WORD_MOUTHCOMM( LWK_INDEX, LWK_CNT, 0 )
	  _BMPMENU_MAKE_LIST( resort_mouthcomm_sys_03, LWK_CNT )	//質問
    $LWK_CNT += 1
  ENDWHILE

	//メニュー表示
	_BMPMENU_START()

  //そうなんだー
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_MOUTHCOMM_MSG_02, LWK_MSGID )
  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

  //回答を設定
  $LWK_TMP = $LWK_INDEX
  $LWK_TMP += RESORT_MY_PARAM_GOSSIP_00
  //回答は０オリジンから１オリジンにする
  $LWK_MENU_RET += 1
  _RESORT_SET_MY_DATA( LWK_TMP, LWK_MENU_RET )
}
_RET

/**************************************************************/
/*            NPC　オフレコ                     */
/**************************************************************/
EVENT_START ev_resort_npc_offreco
{
  DEFINE_LOCAL LWK_CNT
  DEFINE_LOCAL LWK_TMP

  _TALK_OBJ_START()

  //OBJID
  _RESORT_GET_NPC_DATA( LWK_OBJID, RESORT_NPC_DATA_OBJID, LWK_OBJID )


  //わたし　街　大好き
  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
  _BALLOONWIN_OBJMSG_POS( resort_offreco_sys_01, LWK_OBJID, POS_DEFAULT )

  //住民選択
  _CALL sub_resident_select_menu

  IF $LWK_MENU_RET != EV_WIN_B_CANCEL THEN
    
    $LWK_INDEX  = $LWK_MENU_RET

    //前口上
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, LWK_INDEX, 0 )
    _BALLOONWIN_OBJMSG_POS( resort_offreco_sys_02, LWK_OBJID, POS_DEFAULT )

    //冒険をはじめた
    _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_GAMESTART_MSGID, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

    //殿堂入り
    _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_DENDOU_MSGID, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

    //プレイ時間
    _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_PLAYTIME_MSGID, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

    //図鑑登録
    _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_ZUKAN_MSGID, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

    //手持ちポケモン
    _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_POKE_MSGID, LWK_MSGID )
    _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

    //もっとしりたいですか？
    _BALLOONWIN_OBJMSG_POS( resort_offreco_sys_08, LWK_OBJID, POS_DEFAULT )
    
    //はい/いいえ
 	  _YES_NO_WIN( LWK_YESNO )

    IF $LWK_YESNO == SCR_YES THEN

      //出身地
      _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_COMEFROM_MSGID, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

      //仕事
      _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_JOB_MSGID, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

      //趣味
      _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_HOBBY_MSGID, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

      //街ランク
      _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_CITYLV_MSGID, LWK_MSGID )
      _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

      //街の様子
      _BALLOONWIN_OBJMSG_POS( resort_offreco_sys_13_01, LWK_OBJID, POS_DEFAULT )
      _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_CITYMSG_EXSIT, LWK_RET )
      IF $LWK_RET == FALSE THEN
        //ない
        _BALLOONWIN_OBJMSG_POS( resort_offreco_sys_13_05, LWK_OBJID, POS_DEFAULT )
      ELSE

        _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_CITYSHOP_CNT, LWK_RET )
        $LWK_CNT = 0
        WHILE $LWK_CNT < $LWK_RET
        
        $LWK_TMP =  $LWK_CNT
        $LWK_TMP +=  RESORT_OFFRECO_SHOP_MSGID_00
        _RESORT_GET_OFFRECO( LWK_INDEX, LWK_TMP, LWK_MSGID )
        _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

        $LWK_CNT += 1
        ENDWHILE

        _RESORT_GET_OFFRECO( LWK_INDEX, RESORT_OFFRECO_ENDSHOP_MSGID, LWK_MSGID )
        _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
      ENDIF

    ENDIF
  ENDIF

  //街　大好き
  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 0 )
  _BALLOONWIN_OBJMSG_POS( resort_offreco_sys_14, LWK_OBJID, POS_DEFAULT )
  _LAST_KEYWAIT()
}
EVENT_END

//==============================================================
//サブルーチン：住人選択メニュー
//==============================================================
sub_resident_select_menu:
{
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

  //一人目
  _RESORT_GET_DATA( RESORT_GET_PARAM_CHECK_RESIDENT_00, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, 0, 0 )
    _BMPMENU_MAKE_LIST( resort_offreco_sys_17, 0 )
  ENDIF
  //二人目
  _RESORT_GET_DATA( RESORT_GET_PARAM_CHECK_RESIDENT_01, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, 1, 0 )
    _BMPMENU_MAKE_LIST( resort_offreco_sys_17, 1 )
  ENDIF
  //三人目
  _RESORT_GET_DATA( RESORT_GET_PARAM_CHECK_RESIDENT_02, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, 2, 0 )
    _BMPMENU_MAKE_LIST( resort_offreco_sys_17, 2 )
  ENDIF
  //四人目
  _RESORT_GET_DATA( RESORT_GET_PARAM_CHECK_RESIDENT_03, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, 3, 0 )
    _BMPMENU_MAKE_LIST( resort_offreco_sys_17, 3 )
  ENDIF
  //五人目
  _RESORT_GET_DATA( RESORT_GET_PARAM_CHECK_RESIDENT_04, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, 4, 0 )
    _BMPMENU_MAKE_LIST( resort_offreco_sys_17, 4 )
  ENDIF
  //六人目
  _RESORT_GET_DATA( RESORT_GET_PARAM_CHECK_RESIDENT_05, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, 5, 0 )
    _BMPMENU_MAKE_LIST( resort_offreco_sys_17, 5 )
  ENDIF
  //七人目
  _RESORT_GET_DATA( RESORT_GET_PARAM_CHECK_RESIDENT_06, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, 6, 0 )
    _BMPMENU_MAKE_LIST( resort_offreco_sys_17, 6 )
  ENDIF
  //八人目
  _RESORT_GET_DATA( RESORT_GET_PARAM_CHECK_RESIDENT_07, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_RESIDENT, 7, 0 )
    _BMPMENU_MAKE_LIST( resort_offreco_sys_17, 7 )
  ENDIF

  //またね
  _BMPMENU_MAKE_LIST( resort_offreco_sys_16, EV_WIN_B_CANCEL )

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()
}
_RET

/**************************************************************/
/*            看板                                       */
/**************************************************************/
EVENT_START ev_resort_board
{
  DEFINE_LOCAL LWK_X
  DEFINE_LOCAL LWK_Z
  _PLAYER_POS_GET( LWK_X, LWK_Z )

  $LWK_INDEX  = 0
  IF $LWK_Z >= 60 && $LWK_Z <= 66 THEN
    $LWK_INDEX  = 0
  ELSIF $LWK_Z >= 53 && $LWK_Z <= 59 THEN
    $LWK_INDEX  = 1
  ELSIF $LWK_Z >= 46 && $LWK_Z <= 52 THEN
    $LWK_INDEX  = 2
  ELSIF $LWK_Z >= 39 && $LWK_Z <= 45 THEN
    $LWK_INDEX  = 3
  ELSIF $LWK_Z >= 32 && $LWK_Z <= 38 THEN
    $LWK_INDEX  = 4
  ELSIF $LWK_Z >= 25 && $LWK_Z <= 31 THEN
    $LWK_INDEX  = 5
  ELSIF $LWK_Z >= 18 && $LWK_Z <= 24 THEN
    $LWK_INDEX  = 6
  ELSIF $LWK_Z >= 11 && $LWK_Z <= 17 THEN
    $LWK_INDEX  = 7
  ENDIF

  $LWK_INDEX  += RESORT_MSGID_BOARD_00
  _RESORT_GET_MSGID( LWK_INDEX, LWK_MSGID )
  _EASY_BGWIN_MSG( LWK_MSGID, TYPE_POST )
}
EVENT_END

/**************************************************************/
/*            チュートリアル１招待                            */
/**************************************************************/
EVENT_START ev_resort_tutorial_01
{
	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 2 )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_TUTORIAL01_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	_BALLOONWIN_CLOSE()

  //訪問してきました
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
	_SYSWIN_MSG( resort_sys_select_00, POS_DOWN )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_tutorial_01_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_TOURIST_INVITATION THEN   //招待
      _CALL sub_tourist_invitation
      //==================================//
      //招待したので、招待チュートリアル終了
      IF $LWK_FUNCTION_RETURN == TRUE THEN
        $WK_SCENE_C16_TUTORIAL_SEQ  = 3
      ENDIF
      //==================================//
    CASE SEQ_TOURIST_BYE THEN          //またね
      _CALL sub_tourist_bye
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：チュートリアル１招待メニュー表示
//==============================================================
sub_tutorial_01_menu:
{
  _SYSWIN_MSG( msg_exp_window , POS_DOWN ) // 説明文表示用のウィンドウを表示
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST_EX( resort_sys_select_01, resort_sys_select_info_01, SEQ_TOURIST_INVITATION )	//招待
	_BMPMENU_MAKE_LIST_EX( resort_sys_select_10, resort_sys_select_info_10, SEQ_TOURIST_BYE )	        //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_TOURIST_BYE
  ENDIF
}
_RET

/**************************************************************/
/*            チュートリアル２案内                            */
/**************************************************************/
EVENT_START ev_resort_tutorial_02
{
  $LWK_TUTORIAL_MODE  = TRUE

	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0, 2 )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_TUTORIAL02_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	_BALLOONWIN_CLOSE()

  //訪問してきました
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0, 0 )
	_SYSWIN_MSG( resort_sys_select_00, POS_DOWN )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_tutorial_02_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_TOURIST_SPOT THEN         //おすすめスポット
      _CALL sub_tourist_spot
      IF $LWK_FUNCTION_RETURN == TRUE THEN
        //==================================//
        //案内したので、案内チュートリアル終了
        $WK_SCENE_C16_TUTORIAL_SEQ  = 5

          //スクリプトリザーブ
          _RESERVE_SCRIPT( SCRID_RESERVE_C16_TUTORIAL )
        //==================================//
      ENDIF
    CASE SEQ_TOURIST_BYE THEN          //またね
      _CALL sub_tourist_bye
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END


//==============================================================
//サブルーチン：チュートリアル２案内メニュー表示
//==============================================================
sub_tutorial_02_menu:
{
  _SYSWIN_MSG( msg_exp_window , POS_DOWN ) // 説明文表示用のウィンドウを表示
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST_EX( resort_sys_select_03, resort_sys_select_info_03, SEQ_TOURIST_SPOT )	    //スポット
	_BMPMENU_MAKE_LIST_EX( resort_sys_select_10, resort_sys_select_info_10, SEQ_TOURIST_BYE )	        //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_TOURIST_BYE
  ENDIF
}
