  ENDIF
  _RESORT_GET_DATA( RESORT_GET_PARAM_SELECT_NURSERY, LWK_RET )
  IF $LWK_RET == TRUE THEN
    _BMPMENU_MAKE_LIST( resort_shop_genre_06, RESORT_RESIDENT_TYPE_NURSERY )	  //保育所
