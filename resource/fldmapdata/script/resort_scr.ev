  _END

/**************************************************************/
/*            旅行者用スクリプト                              */
/**************************************************************/
EVENT_START ev_resort_tourist
{
  DEFINE_LOCAL LWK_PRESENT_IS_ITEM
  DEFINE_LOCAL LWK_PRESENT_ID
  DEFINE_LOCAL LWK_PRESENT_NUM

	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0 )
  _RESORT_SET_WORD( RESORT_WORD_COMM_TYPE, RESORT_WORD_PARAM_FRONT, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 2 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 3 )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_TOURIST_GREET_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()

  //アイテム取得イベント
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_IS_ITEM, LWK_PRESENT_IS_ITEM )
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_ID, LWK_PRESENT_ID )
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_NUM, LWK_PRESENT_NUM )

  IF $LWK_PRESENT_ID != 0 THEN
    _RESORT_GET_MSGID( RESORT_TOURIST_ITEM_MSGID, LWK_MSGID )
	  _BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	  _BALLOONWIN_CLOSE()

    //もしアイテムならば
    IF $LWK_PRESENT_IS_ITEM == TRUE THEN
      //アイテムをもらった！
  	  _ITEM_EVENT_KEYWAIT( LWK_PRESENT_ID, LWK_PRESENT_NUM )
    //BPだったら
    ELSE
      //BPを取得した！
      _NUMBER( 0, LWK_PRESENT_NUM, 3 )
	    _SYSWIN_MSG( resort_sys_06, POS_DOWN )
      _SYSWIN_CLOSE()
      //TODO BP獲得処理
    ENDIF

    _RESORT_END_ITEM()
  ENDIF

  //訪問してきました
	_SYSWIN_MSG( resort_sys_select_00, POS_DOWN )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_tourist_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_TOURIST_INVITATION THEN   //招待
      _CALL sub_tourist_invitation
    CASE SEQ_TOURIST_SCOUT THEN        //スカウト
      _CALL sub_tourist_scout
    CASE SEQ_TOURIST_FAREWELL THEN     //さようなら
      _CALL sub_tourist_farewell
    CASE SEQ_TOURIST_DOING THEN        //最近どうしてる？
      _CALL sub_tourist_doing
    CASE SEQ_TOURIST_SPOT THEN         //おすすめスポット
      _CALL sub_tourist_spot
    CASE SEQ_TOURIST_APPEAL THEN       //アピールを聞く
      _CALL sub_tourist_appeal
    CASE SEQ_TOURIST_WAIT THEN         //ちょっと待ってて
      _CALL sub_tourist_wait
    CASE SEQ_TOURIST_BYE THEN          //またね
      _CALL sub_tourist_bye
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：旅行者メニュー表示
//==============================================================
sub_tourist_main_menu:
{
  DEFINE_LOCAL LWK_IS_SECRETARY_FULL 
  DEFINE_LOCAL LWK_IS_INSTITUTION_EMPTY

  _SYSWIN_MSG( msg_exp_window , POS_DOWN ) // 説明文表示用のウィンドウを表示
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST_EX( resort_sys_select_01, resort_sys_select_info_01, SEQ_TOURIST_INVITATION )	//招待

  //スポットは施設がないとでない
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_INSTITUTION_EMPTY, LWK_IS_INSTITUTION_EMPTY )
  IF $LWK_IS_INSTITUTION_EMPTY == FALSE THEN
	  _BMPMENU_MAKE_LIST_EX( resort_sys_select_03, resort_sys_select_info_03, SEQ_TOURIST_SPOT )	    //スポット
  ENDIF

	//_BMPMENU_MAKE_LIST_EX( resort_sys_select_05, resort_sys_select_info_05, SEQ_TOURIST_APPEAL )	    //アピール

  //スカウトは秘書がいっぱいでないとでない
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_SECREARY_FULL, LWK_IS_SECRETARY_FULL )
  IF $LWK_IS_SECRETARY_FULL == TRUE THEN
	  _BMPMENU_MAKE_LIST_EX( resort_sys_select_02, resort_sys_select_info_02, SEQ_TOURIST_SCOUT )	    //スカウト
  ENDIF

	//_BMPMENU_MAKE_LIST_EX( resort_sys_select_07, resort_sys_select_info_07, SEQ_TOURIST_FAREWELL )	        //さようなら  TODO 仮で出さない
	_BMPMENU_MAKE_LIST_EX( resort_sys_select_04, resort_sys_select_info_04, SEQ_TOURIST_DOING )	      //さいきんどう？

	//_BMPMENU_MAKE_LIST_EX( resort_sys_select_06, resort_sys_select_info_06, SEQ_TOURIST_WAIT )	      //まってて  TODO 仮で出さない
	_BMPMENU_MAKE_LIST_EX( resort_sys_select_10, resort_sys_select_info_10, SEQ_TOURIST_BYE )	        //またね

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_TOURIST_BYE
  ENDIF
}
_RET


//==============================================================
//サブルーチン：旅行者招待
//==============================================================
sub_tourist_invitation:
{
  DEFINE_LOCAL LWK_IS_FULL
	DEFINE_LOCAL LWK_IS_VISITOR

  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_INSTITUTION_FULL, LWK_IS_FULL )

  //アピール文
  _RESORT_GET_MSGID( RESORT_MSGID_APPEAL, LWK_MSGID )
	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DOWN )

	//メニュー表示
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
  _BMPMENU_MAKE_LIST( resort_sys_select_34, SCR_YES )
  _BMPMENU_MAKE_LIST( resort_sys_select_35, SCR_NO )
	_BMPMENU_START()

	 _BALLOONWIN_CLOSE()
  IF $LWK_MENU_RET == SCR_NO || $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    _RET
  ENDIF

  //いっぱいだったときどれをけすか
  IF $LWK_IS_FULL == TRUE THEN
  
    _SYSWIN_MSG( resort_sys_11, POS_DOWN )
    _SYSWIN_CLOSE()

    _RESORT_CALL_LIST( RESORT_LIST_TYPE_SELECT, RESORT_LIST_SELECT_INSTATITUTION_DEL, LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM, LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )
    IF $LWK_LIST_RET_TYPE == RESORT_LIST_CANCEL THEN
      _RET
    ENDIF

    //一人消す
    _RESORT_DELETE_PEOPLE( RESORT_PEOPLE_TYPE_RESIDENT, LWK_LIST_RET_IDX )
  ENDIF

  //喜び文を表示
  _RESORT_GET_MSGID( RESORT_TOURIST_JOY_MSGID, LWK_MSGID )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()

  //飛んで去っていく
  _OBJ_WARP_OUT( LWK_OBJID )

  //去るのを待つ
  _TIME_WAIT( 30 )

  //何かに転職
  _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_RESIDENT_AUTO )

  //施設メッセージ
  _RESORT_SET_WORD( RESORT_WORD_SHOP_GENRE, RESORT_WORD_PARAM_FRONT, 0 )
  _RESORT_SET_WORD( RESORT_WORD_SHOP, RESORT_WORD_PARAM_FRONT, 1 )
  _SYSWIN_MSG( resort_sys_00, POS_DOWN )
  _SYSWIN_CLOSE()

  //特殊NPC出現チェック
  _RESORT_CHECK_VISITOR( LWK_IS_VISITOR, LWK_MSGID )

  IF $LWK_IS_VISITOR == TRUE THEN
    _SYSWIN_MSG( LWK_MSGID, POS_DOWN )
    _SYSWIN_CLOSE()
  ENDIF

  //転職したのでこの人は消える
  _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MINE, 0 )

  //選択肢終了
  $LWK_MENU_LOOP = FALSE
}
_RET

//==============================================================
//サブルーチン：旅行者スカウト
//==============================================================
sub_tourist_scout:
{
	DEFINE_LOCAL LWK_IS_VISITOR

  _SYSWIN_MSG( resort_sys_12, POS_DOWN )
  _SYSWIN_CLOSE()

  _RESORT_CALL_LIST( RESORT_LIST_TYPE_SELECT, RESORT_LIST_SELECT_SECRETARY_DEL, LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM, LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )
  IF $LWK_LIST_RET_TYPE != RESORT_LIST_CANCEL THEN
    //飛んで去っていく
    _OBJ_WARP_OUT( LWK_OBJID )

    //去るのを待つ
    _TIME_WAIT( 30 )

    //秘書を一人消し
    _RESORT_DELETE_PEOPLE( RESORT_PEOPLE_TYPE_SECRETARY, LWK_LIST_RET_IDX )

    //旅行者を秘書に
    _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_SECETARY )

    //施設生成？

    //特殊NPC出現チェック
    _RESORT_CHECK_VISITOR( LWK_IS_VISITOR, LWK_MSGID )

    IF $LWK_IS_VISITOR == TRUE THEN
      _SYSWIN_MSG( LWK_MSGID, POS_DOWN )
      _SYSWIN_CLOSE()
    ENDIF

    //転職したのでこの人は消える
    _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MINE, 0 )

    //選択肢終了
    $LWK_MENU_LOOP = FALSE
  ENDIF
}
_RET

//==============================================================
//サブルーチン：旅行者さようなら
//==============================================================
sub_tourist_farewell:
{
  //さよなら文を表示
  _RESORT_GET_MSGID( RESORT_TOURIST_BYE_MSGID, LWK_MSGID )

  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_WORD_PARAM_FRONT, 0 )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()

  //飛んで去っていく
  _OBJ_WARP_OUT( LWK_OBJID )

  //去るのを待つ
  _TIME_WAIT( 30 )

  //転職
  _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_VISITOR )

  //転職したのでこの人は消える
  _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MINE, 0 )

  //選択肢終了
  $LWK_MENU_LOOP = FALSE
}
_RET

//==============================================================
//サブルーチン：旅行者最近どう？
//==============================================================
sub_tourist_doing:
{
  //最近のMSG文を表示
  _RESORT_GET_MSGID( RESORT_MSGID_RECENT, LWK_MSGID )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()
}
_RET

//==============================================================
//サブルーチン：旅行者スポット
//==============================================================
sub_tourist_spot:
{
  DEFINE_LOCAL LWK_MSGID2
  DEFINE_LOCAL LWK_RET2

  //スポット文を表示
  _RESORT_GET_MSGID( RESORT_MSGID_WHERETOGO, LWK_MSGID )
	_BALLOONWIN_OBJMSG( LWK_MSGID, LWK_OBJID )
	_BALLOONWIN_CLOSE()

  //施設選択
  _RESORT_CALL_LIST( RESORT_LIST_TYPE_SELECT, RESORT_LIST_SELECT_INSTATITUTION, LWK_LIST_RET_TYPE, LWK_LIST_RET_PARAM,LWK_LIST_RET_IDX, LWK_LIST_RET_PRICE )

  IF $LWK_LIST_RET_TYPE == RESORT_LIST_CANCEL THEN
  ELSE
    _OBJ_WARP_OUT( LWK_OBJID )
    _TIME_WAIT( 30 )

    _RESORT_SET_WORD( RESORT_WORD_SHOP, LWK_LIST_RET_IDX, 1 )
    _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_WORD_PARAM_FRONT, 0 )
    _RESORT_SET_SPOT( LWK_LIST_RET_IDX, LWK_MSGID, LWK_MSGID2, LWK_RET, LWK_RET2 )
    _RESORT_USE_MSG_ALPHA( FALSE )
    _RESORT_BLEND_BRIGHTNESS( 0, -16, 15 )

    //～が　おすすめしたみせに　やってきた！
    _SYSWIN_MSG( resort_sys_15, POS_DOWN )
    //演出文
    _SYSWIN_MSG( LWK_MSGID2, POS_DOWN )
    //満足したかどうか
    IF $LWK_RET == resort_sys_08 THEN
      //満足しなかった
      _SYSWIN_MSG( LWK_MSGID, POS_DOWN )
    ELSE
      //満足した
      _SYSWIN_MSG( LWK_MSGID, POS_DOWN )
      //施設の経験値アップ
      _SYSWIN_MSG( resort_sys_16, POS_DOWN )

      //施設レベルアップ
      IF $LWK_RET == TRUE THEN
        _RESORT_SET_WORD( RESORT_WORD_SHOP, LWK_LIST_RET_IDX, 0 )
        _SYSWIN_MSG( resort_sys_13, POS_DOWN )
      ENDIF

      //街の経験値アップ
      _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0 )
      _SYSWIN_MSG( resort_sys_17, POS_DOWN )
      //街レベルアップ
      IF $LWK_RET2 == TRUE THEN
        _RESORT_SET_WORD( RESORT_WORD_CITY_RANK, RESORT_WORD_PARAM_NONE, 2 )
        _SYSWIN_MSG( resort_sys_18, POS_DOWN )
      ENDIF

    ENDIF

    _SYSWIN_CLOSE()
  
    _RESORT_BLEND_BRIGHTNESS( -16, 0, 15 )
    _RESORT_USE_MSG_ALPHA( TRUE )

    _RESORT_DELETE_PEOPLE( RESORT_DELTE_PEOPLE_MINE, 0 )

    //選択肢終了
    $LWK_MENU_LOOP = FALSE
  ENDIF
}
_RET

