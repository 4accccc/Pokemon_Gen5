//==============================================================
//サブルーチン：住民くじびき処理
//==============================================================
sub_resident_lot:
{
  DEFINE_LOCAL LWK_DAY_FLAG

  _RESORT_GET_DATA( RESORT_GET_PARAM_LOT_DAY_FLAG, LWK_DAY_FLAG )

  IF $LWK_DAY_FLAG == FALSE THEN
   
    //くじをひく
    $LWK_INDEX  = 0
    _CALL sub_resident_lot_one

    //フィーバーのときはもう１回
    _RESORT_GET_MY_DATA( RESORT_MY_PARAM_IS_FEVER, LWK_RET )
    IF $LWK_RET == TRUE THEN

      //フィーバーのとき
      _RESORT_GET_MSGID( RESORT_SHOP_LOT_FEVER_MSGID, LWK_MSGID )
  	  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

      $LWK_INDEX  = 1
      _CALL sub_resident_lot_one
    ENDIF

    _RESORT_SET_LOT_DAY_FLAG() 
  ELSE
    _RESORT_GET_MSGID( RESORT_SHOP_LOT_DAYEND_MSGID, LWK_MSGID )
  	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	  _BALLOONWIN_CLOSE()
  ENDIF
}
_RET

//==============================================================
//サブルーチン：くじびき１回の処理
//==============================================================
sub_resident_lot_one:
{
  DEFINE_LOCAL LWK_RET_ITEM
  _RESORT_LOT( LWK_INDEX, LWK_RET_ITEM, LWK_RET )

  _RESORT_GET_MSGID( RESORT_SHOP_LOT_READY_MSGID, LWK_MSGID )
  _BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )

  IF $LWK_RET == RESORT_LOT_FAILURE THEN
    _RESORT_GET_MSGID( RESORT_SHOP_LOT_FAILER_MSGID, LWK_MSGID )
  	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
  ELSE

    _ITEM_NAME( 1, LWK_RET_ITEM )
    IF $LWK_RET == 1 THEN
      _RESORT_GET_MSGID( RESORT_SHOP_LOT_BIG_MSGID, LWK_MSGID )
    ELSE
      _NUMBER( 0, LWK_RET, 2 )
      _RESORT_GET_MSGID( RESORT_SHOP_LOT_SUCCESS_MSGID, LWK_MSGID )
    ENDIF

    _ME_PLAY( SEQ_ME_AVENUE_03 )
  	_BALLOONWIN_OBJMSG_POS( LWK_MSGID, LWK_OBJID, POS_DEFAULT )
	  _ME_WAIT()
	  _AB_KEYWAIT_MARK()
    _BALLOONWIN_CLOSE()

 	  _ITEM_EVENT_KEYWAIT( LWK_RET_ITEM, 1 )
  ENDIF

}
_RET

