/**************************************************************/
/*            秘書　ポケセン用スクリプト                      */
/**************************************************************/
EVENT_START    ev_resort_secretary_center
{
	DEFINE_LOCAL LWK_GREET_MSGID

	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_GREET_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_GREET, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, 2 )
	_BALLOONWIN_OBJMSG( LWK_GREET_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

	//暗転して手持ちポケモンを回復
	_BLACK_OUT()
	_DISP_FADE_END_CHECK()
	_TEMOTI_POKEMON_KAIFUKU()		//回復処理
	_ME_PLAY( SEQ_ME_ASA )
	_ME_WAIT()
	_BLACK_IN()
	_DISP_FADE_END_CHECK()

  _RESORT_TALK_END()
}  
EVENT_END
/**************************************************************/
/*            秘書  パソコン用スクリプト                      */
/**************************************************************/
EVENT_START    ev_resort_secretary_pc
{
	DEFINE_LOCAL LWK_GREET_MSGID
  DEFINE_LOCAL LWK_BYE_MSGID
  DEFINE_LOCAL LWK_BOX_RET

	_TALK_OBJ_START()
  _RESORT_TALK_START()
  
  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_SECRETARY_GREET_MSGID, LWK_GREET_MSGID )
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_GREET, 1 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, 2 )
	_BALLOONWIN_OBJMSG_POS( LWK_GREET_MSGID, LWK_OBJID, POS_DL )

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_secretary_pc_main_menu


    IF $LWK_MENU_RET == SEQ_SECRETARY_PC_BYE THEN
      _RESORT_GET_MSGID( RESORT_SECRETARY_BYE_MSGID, LWK_BYE_MSGID )
      _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, 0 )
  	  _BALLOONWIN_OBJMSG( LWK_BYE_MSGID, LWK_OBJID )
  	  _LAST_KEYWAIT()
  	  _BALLOONWIN_CLOSE()
      $LWK_MENU_LOOP = FALSE
    ELSE 

	    _BALLOONWIN_CLOSE()
      _MAP_FADE_BLACK_OUT()                  // フェードアウト
      _MAP_FADE_END_CHECK()                  //

      //分岐
      SWITCH $LWK_MENU_RET
      CASE SEQ_SECRETARY_PC_BOX THEN    //整理
        _CALL_BOX_PROC( LWK_BOX_RET, BOX_MODE_SEIRI )
      CASE SEQ_SECRETARY_PC_BTLBOX THEN //バトルボックス
        _CALL_BOX_PROC( LWK_BOX_RET, BOX_MODE_BATTLE )
      CASE SEQ_SECRETARY_PC_ITEM THEN
        _CALL_BOX_PROC( LWK_BOX_RET, BOX_MODE_ITEM )
      CASE SEQ_SECRETARY_PC_RECORD THEN       //きろく
        _CALL_DENDOU_PC_PROC( SCRCMD_DENDOU_PC_DENDOU, LWK_BOX_RET )
      CASE SEQ_SECRETARY_PC_MAILBOX THEN       //メール
        _CALL_MAILBOX_PROC( LWK_BOX_RET ) // メールボックス画面へ
      CASE SEQ_SECRETARY_PC_HELP THEN       //ヘルプをみる
        _CALL_GAME_MANUAL( LWK_BOX_RET )
      DEFAULT
      ENDSWITCH

      _MAP_FADE_BLACK_IN()                   // フェードイン
      _MAP_FADE_END_CHECK()                  //
    ENDIF
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：秘書　パソコン用メニュー表示
//==============================================================
sub_secretary_pc_main_menu:
{
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST( resort_sys_select_22, SEQ_SECRETARY_PC_BOX )	//せいり
  _BMPMENU_MAKE_LIST( resort_sys_select_23, SEQ_SECRETARY_PC_BTLBOX )	//バトルボックス
  _BMPMENU_MAKE_LIST( resort_sys_select_24, SEQ_SECRETARY_PC_ITEM )	  //もちもの
  _BMPMENU_MAKE_LIST( resort_sys_select_25, SEQ_SECRETARY_PC_RECORD )	  //きろく
  _BMPMENU_MAKE_LIST( resort_sys_select_26, SEQ_SECRETARY_PC_MAILBOX )	  //メール
  _BMPMENU_MAKE_LIST( resort_sys_select_27, SEQ_SECRETARY_PC_HELP )	  //ヘルプをみる
  _BMPMENU_MAKE_LIST( resort_sys_select_10, SEQ_SECRETARY_PC_BYE )	  //またね

	//メニュー表示
	_BMPMENU_START()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_SECRETARY_PC_BYE
  ENDIF
}
_RET
