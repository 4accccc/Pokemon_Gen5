/**************************************************************/
/*            旅行者用スクリプト                              */
/**************************************************************/
EVENT_START ev_resort_tourist
{
	DEFINE_LOCAL LWK_GREET_MSGID
  DEFINE_LOCAL LWK_PRESENT_IS_ITEM
  DEFINE_LOCAL LWK_PRESENT_ID
  DEFINE_LOCAL LWK_PRESENT_NUM
	DEFINE_LOCAL LWK_ITEM_MSGID
	DEFINE_LOCAL LWK_APPEAL_MSGID

	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )

  //挨拶文
  _RESORT_GET_MSGID( RESORT_TOURIST_GREET_MSGID, LWK_GREET_MSGID )
	_BALLOONWIN_OBJMSG( LWK_GREET_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //アイテム取得イベント
  _RESORT_GET_MSGID( RESORT_TOURIST_ITEM_MSGID, LWK_ITEM_MSGID )
	_BALLOONWIN_OBJMSG( LWK_ITEM_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //もしアイテムならば
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_IS_ITEM, LWK_PRESENT_IS_ITEM )
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_ID, LWK_PRESENT_ID )
  _RESORT_GET_DATA( RESORT_GET_PARAM_PRESENT_NUM, LWK_PRESENT_NUM )
  IF $LWK_PRESENT_IS_ITEM == TRUE THEN
    //アイテムをもらった！
  	_ITEM_EVENT_KEYWAIT( LWK_PRESENT_ID, LWK_PRESENT_NUM )
  //BPだったら
  ELSE
    //BPを取得した！
    _NUMBER( 0, LWK_PRESENT_NUM, 3 )
	  _SYSWIN_MSG( resort_sys_06, POS_DOWN )
    _SYSWIN_CLOSE()
  ENDIF

  //アピール文
  _RESORT_GET_MSGID( RESORT_MSGID_APPEAL, LWK_APPEAL_MSGID )
	_BALLOONWIN_OBJMSG( LWK_APPEAL_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_tourist_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_TOURIST_INVITATION THEN   //招待
      _CALL sub_tourist_invitation
    CASE SEQ_TOURIST_SCOUT THEN        //スカウト
      _CALL sub_tourist_scout
    CASE SEQ_TOURIST_BYE THEN          //さようなら
      _CALL sub_tourist_bye
    CASE SEQ_TOURIST_DOING THEN        //最近どうしてる？
      _CALL sub_tourist_doing
    CASE SEQ_TOURIST_SPOT THEN         //おすすめスポット
      _CALL sub_tourist_spot
    CASE SEQ_TOURIST_APPEAL THEN       //アピールを聞く
      _CALL sub_tourist_appeal
    CASE SEQ_TOURIST_WAIT THEN         //ちょっと待ってて
      _CALL sub_tourist_wait
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
}
EVENT_END

//==============================================================
//サブルーチン：旅行者メニュー表示
//==============================================================
sub_tourist_main_menu:
{
  DEFINE_LOCAL LWK_IS_SECRETARY_FULL 
  DEFINE_LOCAL LWK_IS_INSTITUTION_EMPTY

  //どうしますか？
	_SYSWIN_MSG( resort_sys_select_00, POS_DOWN )

	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST( resort_sys_select_01, SEQ_TOURIST_INVITATION )	//招待

  //スカウトは秘書がいっぱいでないとでない
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_SECREARY_FULL, LWK_IS_SECRETARY_FULL )
  IF $LWK_IS_SECRETARY_FULL == TRUE THEN
	  _BMPMENU_MAKE_LIST( resort_sys_select_02, SEQ_TOURIST_SCOUT )	      //スカウト
  ENDIF

	_BMPMENU_MAKE_LIST( resort_sys_select_07, SEQ_TOURIST_BYE )	        //さようなら
	_BMPMENU_MAKE_LIST( resort_sys_select_04, SEQ_TOURIST_DOING )	      //さいきんどう？
  //スポットは施設がないとでない
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_INSTITUTION_EMPTY, LWK_IS_INSTITUTION_EMPTY )
  IF $LWK_IS_INSTITUTION_EMPTY == TRUE THEN
	  _BMPMENU_MAKE_LIST( resort_sys_select_03, SEQ_TOURIST_SPOT )	      //スポット
  ENDIF

	_BMPMENU_MAKE_LIST( resort_sys_select_05, SEQ_TOURIST_APPEAL )	    //アピール
	_BMPMENU_MAKE_LIST( resort_sys_select_06, SEQ_TOURIST_WAIT )	      //まってて

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_TOURIST_WAIT
  ENDIF
}
_RET


//==============================================================
//サブルーチン：旅行者招待
//==============================================================
sub_tourist_invitation:
{
	DEFINE_LOCAL LWK_JOY_MSGID
	DEFINE_LOCAL LWK_IS_VISITOR
	DEFINE_LOCAL LWK_VISITOR_MSGID

  //喜び文を表示
  _RESORT_GET_MSGID( RESORT_TOURIST_JOY_MSGID, LWK_JOY_MSGID )
	_BALLOONWIN_OBJMSG( LWK_JOY_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //飛んで去っていく
  _OBJ_WARP_OUT( LWK_OBJID )

  //去るのを待つ
  _TIME_WAIT( 30 )

  //何かに転職
  _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_RESIDENT_AUTO )

  //施設メッセージ
  _RESORT_SET_WORD( RESORT_WORD_SHOP_GENRE, 0 )
  _RESORT_SET_WORD( RESORT_WORD_SHOP, 1 )
  _SYSWIN_MSG( resort_sys_00, POS_DOWN )
  _SYSWIN_CLOSE()

  //特殊NPC出現チェック
  _RESORT_CHECK_VISITOR( LWK_IS_VISITOR, LWK_VISITOR_MSGID )

  IF $LWK_IS_VISITOR == TRUE THEN
    _SYSWIN_MSG( LWK_VISITOR_MSGID, POS_DOWN )
    _SYSWIN_CLOSE()
  ENDIF

  //転職したのでこの人は消える
  _RESORT_DELETE_PEOPLE()

  //選択肢終了
  $LWK_MENU_LOOP = FALSE
}
_RET

//==============================================================
//サブルーチン：旅行者スカウト
//==============================================================
sub_tourist_scout:
{
  DEFINE_LOCAL LWK_IS_SECRETARY_FULL
  DEFINE_LOCAL LWK_SELECT_ID
	DEFINE_LOCAL LWK_IS_VISITOR
	DEFINE_LOCAL LWK_VISITOR_MSGID

  //秘書入れ替えチェック
  _RESORT_GET_DATA( RESORT_GET_PARAM_IS_SECREARY_FULL, LWK_IS_SECRETARY_FULL )
  IF $LWK_IS_SECRETARY_FULL == TRUE THEN
    //誰と入れ替えるか選択 //TODO
    _RESORT_CALL_LIST( 0, 0, LWK_SELECT_ID )
  ENDIF


  //飛んで去っていく
  _OBJ_WARP_OUT( LWK_OBJID )

  //去るのを待つ
  _TIME_WAIT( 30 )

    //秘書に転職
  IF $LWK_IS_SECRETARY_FULL == TRUE THEN
    _RESORT_JOB_CHANGE_EX( RESORT_JOBCHANGE_SECETARY, LWK_SELECT_ID )
  ELSE
    _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_SECETARY )
  ENDIF

  //施設生成？

 //特殊NPC出現チェック
  _RESORT_CHECK_VISITOR( LWK_IS_VISITOR, LWK_VISITOR_MSGID )

  IF $LWK_IS_VISITOR == TRUE THEN
    _SYSWIN_MSG( LWK_VISITOR_MSGID, POS_DOWN )
    _SYSWIN_CLOSE()
  ENDIF

  //転職したのでこの人は消える
  _RESORT_DELETE_PEOPLE()

  //選択肢終了
  $LWK_MENU_LOOP = FALSE
}
_RET

