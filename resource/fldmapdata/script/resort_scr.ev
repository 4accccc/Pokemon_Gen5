ev_resort:
  //とりあえず最初のラベルだけ生成している
  _END

/**************************************************************/
/*            観光客用スクリプト                              */
/**************************************************************/
EVENT_START ev_resort_tourist
	_TALK_OBJ_START()
  _RESORT_TALK_START()

  _RESORT_GET_DATA( RESORT_GET_PARAM_FRONT_OBJID, LWK_OBJID )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, 0 )

  //挨拶文
	DEFINE_LOCAL LWK_GREET_MSGID
  _RESORT_GET_MSGID( 0, LWK_GREET_MSGID )
	_BALLOONWIN_OBJMSG( LWK_GREET_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //以下メニュー表示はLWK_MENU_LOOPがFALSEになるまで続く
  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE
    //メニュー表示
    _CALL sub_tourist_main_menu

    //分岐
    SWITCH $LWK_MENU_RET
    CASE SEQ_INVITATION THEN   //招待
      _CALL sub_tourist_invitation
    CASE SEQ_SCOUT THEN        //スカウト
      _CALL sub_tourist_scout
    CASE SEQ_BYE THEN          //さようなら
      _CALL sub_tourist_bye
    CASE SEQ_DOING THEN        //最近どうしてる？
      _CALL sub_tourist_doing
    CASE SEQ_SPOT THEN         //おすすめスポット
      _CALL sub_tourist_spot
    CASE SEQ_APPEAL THEN       //アピールを聞く
      _CALL sub_tourist_appeal
    CASE SEQ_WAIT THEN         //ちょっと待ってて
      _CALL sub_tourist_wait
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE

  _RESORT_TALK_END()
EVENT_END

//==============================================================
//サブルーチン：メニュー表示
//==============================================================
sub_tourist_main_menu:
{
  //どうしますか？
	_SYSWIN_MSG( resort_sys_select_00, POS_DOWN )

	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )

	_BMPMENU_MAKE_LIST( resort_sys_select_01, SEQ_INVITATION )	//招待
	_BMPMENU_MAKE_LIST( resort_sys_select_02, SEQ_SCOUT )	      //スカウト
	_BMPMENU_MAKE_LIST( resort_sys_select_07, SEQ_BYE )	        //さようなら
	_BMPMENU_MAKE_LIST( resort_sys_select_04, SEQ_DOING )	      //さいきんどう？

  //スポットは施設がなかったら出さない
	_BMPMENU_MAKE_LIST( resort_sys_select_03, SEQ_SPOT )	      //スポット
	_BMPMENU_MAKE_LIST( resort_sys_select_05, SEQ_APPEAL )	    //アピール
	_BMPMENU_MAKE_LIST( resort_sys_select_06, SEQ_WAIT )	      //まってて

	//メニュー表示
	_BMPMENU_START()

  //どうしますか？を閉じる
  _SYSWIN_CLOSE()

  IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
    $LWK_MENU_RET = SEQ_WAIT
  ENDIF
}
_RET


//==============================================================
//サブルーチン：招待
//==============================================================
sub_tourist_invitation:
{
  //喜び文を表示
	DEFINE_LOCAL LWK_JOY_MSGID
  _RESORT_GET_MSGID( 3, LWK_JOY_MSGID )
	_BALLOONWIN_OBJMSG( LWK_JOY_MSGID, LWK_OBJID )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

  //飛んで去っていく
  _OBJ_WARP_OUT( LWK_OBJID )

  //去るのを待つ
  _TIME_WAIT( 30 )

  //秘書に転職 TODO
  _RESORT_JOB_CHANGE( RESORT_JOBCHANGE_RESIDENT )

  //転職したのでこの人は消える
  _RESORT_DELETE_PEOPLE()

  //施設生成

  //特殊NPC出現チェック

  //選択肢終了
  $LWK_MENU_LOOP = FALSE
}
_RET

