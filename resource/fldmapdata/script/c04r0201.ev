//ここまで一言メッセージのみ

/************************************************************/
/*				ミュージカル：オーナー						*/
/************************************************************/
EVENT_START		ev_c04r0201_owner_01
{
  DEFINE_LOCAL LWK_IS_CONV
	DEFINE_LOCAL LWK_IS_EXIST
	DEFINE_LOCAL LWK_GET_ITEM
	DEFINE_LOCAL LWK_COMPLETE_CK

  //すでに何かイベントを行ったか？
  _TALK_OBJ_START()
  
  _DATACONV_IS_EXIST( DATACONV_ID_MUSICAL, LWK_IS_EXIST )
  _DATACONV_IS_CONV_MUSICAL( LWK_IS_CONV )

  IF $LWK_IS_EXIST == TRUE && $LWK_IS_CONV == FALSE THEN
    //受け取っていない
    
    //グッズコンプリートチェック
    _IS_MUSICAL_GOODS_COMPLETE( LWK_COMPLETE_CK )
    
    //過去主人公名を代入
    _DATACONV_SET_NAME( DATACONV_ID_MUSICAL, 0 )
    
    //コンプリート済み
    IF $LWK_COMPLETE_CK == 1 THEN
      
       //ふーむ！　やはり　あなたには
       _BALLOONWIN_OBJMSG( msg_c04r0201_owner_swan_01, C04R0201_OWNER_01 )
      
       //おもいでリンク起動メッセージ
       _BALLOONWIN_OBJMSG( msg_c04r0201_memory_01, C04R0201_OWNER_01 )
       _MSGWIN_CLOSE()
          
       //暗転
       _MAP_FADE_BLACK_OUT_SLOW()
       //過去イベント・ミュージカルホール起動
       _RESERVE_SCRIPT( SCRID_RESERVE_OLDC04R0201_EVENT_01 )
       _MAP_FADE_END_CHECK()
       //マップチェンジ
       _MAP_CHANGE_NO_FADE( ZONE_ID_OLDC04R0201, 14, 0, 15, DIR_DOWN )
    
    //未入手のグッズがある
    ELSE
      
      //ふーむ！　やはり　あなたには
  	  _BALLOONWIN_OBJMSG( msg_c04r0201_owner_swan_01, C04R0201_OWNER_01 )
  	  _MSGWIN_CLOSE()
  	  
  	  //システム：（コンバート名）とおそろいのグッズをうけとりますか？
  	  _SYSWIN_MSG( msg_c04r0201_confirm_00 , POS_DEFAULT )
      _YES_NO_WIN( SCWK_ANSWER )
      
      //はい
      IF $SCWK_ANSWER == SCR_YES THEN
      
        //システム：一回しか受け取れませんが よいですか？
        _SYSWIN_MSG( msg_c04r0201_confirm_01 , POS_DEFAULT )
        _YES_NO_WIN( SCWK_ANSWER )
        
        //はい
        IF $SCWK_ANSWER == SCR_YES THEN
        
          _MSGWIN_CLOSE()
          
          //おもいでリンク起動メッセージ
          _BALLOONWIN_OBJMSG( msg_c04r0201_memory_01, C04R0201_OWNER_01 )
          _MSGWIN_CLOSE()
          
          //暗転
          _MAP_FADE_BLACK_OUT_SLOW()
          //過去イベント・ミュージカルホール起動
          _RESERVE_SCRIPT( SCRID_RESERVE_OLDC04R0201_EVENT_01 )
          _MAP_FADE_END_CHECK()
          //マップチェンジ
          _MAP_CHANGE_NO_FADE( ZONE_ID_OLDC04R0201, 14, 0, 15, DIR_DOWN )
        
        //いいえ
        ELSE
          _MSGWIN_CLOSE()
          //あらあら　そうですか！
          _BALLOONWIN_OBJMSG( msg_c04r0201_goods_get_reject_00, C04R0201_OWNER_01 )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()
          
        ENDIF
      
      //いいえ
      ELSE
        _MSGWIN_CLOSE()
        //あらあら　そうですか！
        _BALLOONWIN_OBJMSG( msg_c04r0201_goods_get_reject_00, C04R0201_OWNER_01 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
      ENDIF
      
    ENDIF

  ELSE
    //受け取っているなら通常のイベントアイテム入手処理へ
    _CALL ev_owner_normal
  ENDIF
}
EVENT_END

/************************************************************/
/*		RESERVE：チュートリアルからおもいでリンク復帰処理				*/
/************************************************************/
EVENT_START		ev_reserve_c04r0201_link_event_ret02
{
  DEFINE_LOCAL LWK_GET_ITEM

  //ブラックイン
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()

  //グッズコンバート
  _DATACONV_CONV_MUSICAL( LWK_GET_ITEM )

  IF $LWK_GET_ITEM == TRUE THEN

    //プレイヤー名　は　グッズの　つめあわせを　もらった
    _PLAYER_NAME( 0 )
    _ME_PLAY(	SEQ_ME_KEYITEM )
    _SYSWIN_MSG( msg_c04r0201_goods_get_00, POS_DEFAULT )
    _ME_WAIT()
    _SYSWIN_CLOSE()
    
    //オーナー：おもいでリンク終了メッセージ
    _BALLOONWIN_OBJMSG( msg_c04r0201_memory_02, C04R0201_OWNER_01 )
    _AB_KEYWAIT_MARK()

    //あなたなら　きっと　それらの　グッズ
    _BALLOONWIN_OBJMSG( msg_c04r0201_owner_swan_02, C04R0201_OWNER_01 )

  ELSE
    
    //オーナー：おもいでリンク終了メッセージ
    _BALLOONWIN_OBJMSG( msg_c04r0201_memory_02, C04R0201_OWNER_01 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
    //アニメ：オーナー「！」
    _OBJ_ANIME( C04R0201_OWNER_01, anm_mark_gyoe )
    _OBJ_ANIME_WAIT()
    
    //おやおや？　すでにおもちの
    _BALLOONWIN_OBJMSG( msg_c04r0201_owner_swan_03, C04R0201_OWNER_01 )
  ENDIF

  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //========================================//
  //リンクイベント終了
  $WK_SYS_LINK_EVENT_07 = 1
  //========================================//
}
EVENT_END

/************************************************************/
/*				ミュージカル：オーナー通常会話						*/
/************************************************************/
ev_owner_normal:
{
  DEFINE_LOCAL isEvent
  $isEvent = FALSE

  //誕生日イベント
  //ケーキを持っているか？
  _GET_MUSICAL_VALUE( MUSICAL_VALUE_CHECK_HAVE_GOODS , MUSICAL_GOODS_KEEKI , SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
  {
    DEFINE_LOCAL birthDay
    DEFINE_LOCAL birthMonth
    DEFINE_LOCAL nowDay
    DEFINE_LOCAL nowMonth
    
    _GET_BIRTHDAY( birthMonth , birthDay )
    _GET_DATE( nowMonth , nowDay )
    
    IF $birthMonth == $nowMonth && $birthDay == $nowDay THEN
      $isEvent = TRUE
      //ハッピーバースデイ！
      _BALLOONWIN_TALKOBJ_MSG( msg_c04r0201_owner_05_01 )
      _MSGWIN_CLOSE()
   
      $SCWK_TEMP0 = MUSICAL_GOODS_KEEKI
      $SCWK_TEMP1 = FALSE
      _CHG_COMMON_SCR SCRID_MUSICAL_ADD_GOODS
    ENDIF
  }
  ENDIF

  //通信参加記念
  IF $isEvent == FALSE THEN
    //ティアラを持っているか？
    _GET_MUSICAL_VALUE( MUSICAL_VALUE_CHECK_HAVE_GOODS , MUSICAL_GOODS_THIARA , SCWK_ANSWER )
    IF $SCWK_ANSWER == FALSE THEN
      //通信参加フラグが立っているか？
      _FLAG_CHECK( FE_MUSICAL_COMM_PLAY, SCWK_ANSWER )
      IF $SCWK_ANSWER == TRUE THEN
        $isEvent = TRUE
        _BALLOONWIN_TALKOBJ_MSG( msg_c04r0201_owner_02 )
        _MSGWIN_CLOSE()

        $SCWK_TEMP0 = MUSICAL_GOODS_THIARA
        $SCWK_TEMP1 = TRUE
        _CHG_COMMON_SCR SCRID_MUSICAL_ADD_GOODS
        
        _BALLOONWIN_TALKOBJ_MSG( msg_c04r0201_owner_03 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
      ENDIF
    ENDIF
  ENDIF

  //トップ5回以上
  IF $isEvent == FALSE THEN
    //クラウンを持っているか？
    _GET_MUSICAL_VALUE( MUSICAL_VALUE_CHECK_HAVE_GOODS , MUSICAL_GOODS_KURAUN , SCWK_ANSWER )
    IF $SCWK_ANSWER == FALSE THEN
      //トップ回数の取得
      _GET_MUSICAL_VALUE( MUSICAL_VALUE_TOPNUM , 0 , SCWK_ANSWER )
      IF $SCWK_ANSWER >= 5 THEN
        $isEvent = TRUE
        _BALLOONWIN_TALKOBJ_MSG( msg_c04r0201_owner_03_01 )
        _MSGWIN_CLOSE()

        $SCWK_TEMP0 = MUSICAL_GOODS_KURAUN
        $SCWK_TEMP1 = TRUE
        _CHG_COMMON_SCR SCRID_MUSICAL_ADD_GOODS
        
        _BALLOONWIN_TALKOBJ_MSG( msg_c04r0201_owner_04 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
      ENDIF
    ENDIF
  ENDIF

  //トップ10回以上
  IF $isEvent == FALSE THEN
    //優勝ベルトを持っているか？
    _GET_MUSICAL_VALUE( MUSICAL_VALUE_CHECK_HAVE_GOODS , MUSICAL_GOODS_YUUSHOUBERUTO , SCWK_ANSWER )
    IF $SCWK_ANSWER == FALSE THEN
      //トップ回数の取得
      _GET_MUSICAL_VALUE( MUSICAL_VALUE_TOPNUM , 0 , SCWK_ANSWER )
      IF $SCWK_ANSWER >= 10 THEN
        $isEvent = TRUE
        _BALLOONWIN_TALKOBJ_MSG( msg_c04r0201_owner_04_01 )
        _MSGWIN_CLOSE()

        $SCWK_TEMP0 = MUSICAL_GOODS_YUUSHOUBERUTO
        $SCWK_TEMP1 = TRUE
        _CHG_COMMON_SCR SCRID_MUSICAL_ADD_GOODS
        
        _BALLOONWIN_TALKOBJ_MSG( msg_c04r0201_owner_05 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
      ENDIF
    ENDIF
  ENDIF

  //何も無かったら通常メッセージ
  IF $isEvent == FALSE THEN
    _BALLOONWIN_TALKOBJ_MSG( msg_c04r0201_owner_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
}
_RET

