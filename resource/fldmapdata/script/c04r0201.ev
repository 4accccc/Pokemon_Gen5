_EVENT_DATA    ev_reserve_c04r0201_link_event_ret02
_EVENT_DATA_END


/************************************************************/
/*  FIELD_INIT_SCRIPT                                       */
/************************************************************/
INIT_EVENT_START  ev_c04R0201_init

  //ミュージカル初回イベント用
  IF $WK_SCENE_C04R0201 == 0 THEN
    //オーナーの位置を変更
    _OBJ_POS_CHANGE( C04R0201_OWNER_01, 14, 0, 13, DIR_UP )
  ELSIF $WK_SCENE_C04R0201 == 1 THEN
    //オーナーの位置を変更
    _OBJ_POS_CHANGE( C04R0201_OWNER_01, 14, 0, 14, DIR_DOWN )
  ENDIF

INIT_EVENT_END


/************************************************************/
/*				ミュージカル初回訪問イベント				*/
/************************************************************/
EVENT_START		ev_scene_c04r0201_musical_first
{
	DEFINE_LOCAL LWK_IS_EXIST
	DEFINE_LOCAL LWK_GET_ITEM

  _DATACONV_IS_EXIST( DATACONV_ID_MUSICAL, LWK_IS_EXIST )

  //サポート＆主人公：受付前へ進む
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_first_player_walk_01 )
	_OBJ_ANIME_WAIT()


  //オーナー：近寄ってくる
	_OBJ_ANIME( C04R0201_OWNER_01, anm_first_owner_come_01 )
	_OBJ_ANIME_WAIT()

  IF $LWK_IS_EXIST == TRUE THEN
    //コンバート用データある

	  //おや　あなた　どこかで
	  _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_swan_01a, C04R0201_OWNER_01 )
	  _MSGWIN_CLOSE()

		//オーナー：！マーク
		_TIME_WAIT( 16 )
		_OBJ_ANIME( C04R0201_OWNER_01, anm_mark_gyoe )
		_OBJ_ANIME_WAIT()

	  //ふーむ！　なんというか　あなたから
	  _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_swan_02a, C04R0201_OWNER_01 )
    {
    DEFINE_LOCAL LWK_YESNO
    _YES_NO_WIN( LWK_YESNO )
    IF $LWK_YESNO == SCR_YES THEN
      //ならば　はなしは　はやい
	    _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_swan_02b, C04R0201_OWNER_01 )
    ELSE
      //ポケモンに　グッズを　つけて
	    _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_swan_02c, C04R0201_OWNER_01 )
    ENDIF
    }
	  _MSGWIN_CLOSE()

		//オーナー：！マーク
		_TIME_WAIT( 16 )
		_OBJ_ANIME( C04R0201_OWNER_01, anm_mark_gyoe )
		_OBJ_ANIME_WAIT()
		
    //過去主人公名を代入
    _DATACONV_SET_NAME( DATACONV_ID_MUSICAL, 0 )

    //そうだ！　あなたに　さしあげる
	  _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_swan_02d, C04R0201_OWNER_01 )
	  _MSGWIN_CLOSE()
	  
	  //システム：（コンバート名）とおそろいのグッズをうけとりますか？
	  _SYSWIN_MSG( msg_c04r0201_confirm_00 , POS_DEFAULT )
    _YES_NO_WIN( SCWK_ANSWER )
    
    //はい
    IF $SCWK_ANSWER == SCR_YES THEN
      
      //システム：一回しか受け取れませんが よいですか？
      _SYSWIN_MSG( msg_c04r0201_confirm_01 , POS_DEFAULT )
      _YES_NO_WIN( SCWK_ANSWER )
      
      //はい
      IF $SCWK_ANSWER == SCR_YES THEN
        _MSGWIN_CLOSE()
        
        //========================================//
        //チュートリアルイベント中断
      	$WK_SCENE_C04R0201 = 1
        //========================================//
        
        //おもいでリンク起動メッセージ
        _BALLOONWIN_OBJMSG( msg_c04r0201_memory_01, C04R0201_OWNER_01 )
        _MSGWIN_CLOSE()
        
        //暗転
        _MAP_FADE_BLACK_OUT_SLOW()
        //過去イベント・ミュージカルホール起動
        _RESERVE_SCRIPT( SCRID_RESERVE_OLDC04R0201_EVENT_01 )
        _MAP_FADE_END_CHECK()
        //マップチェンジ
        _MAP_CHANGE_NO_FADE( ZONE_ID_OLDC04R0201, 14, 0, 15, DIR_DOWN )
        
      //いいえ
      ELSE
        _MSGWIN_CLOSE()
        _CALL ev_first_convert_no
        _CALL ev_scene_c04r0201_musical_first_02
      ENDIF
    
    //いいえ
    ELSE
        _MSGWIN_CLOSE()
        _CALL ev_first_convert_no
        _CALL ev_scene_c04r0201_musical_first_02
    ENDIF

  ELSE
    //コンバート用データない

	  //やあ きみたち！
	  _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_01, C04R0201_OWNER_01 )
	  _MSGWIN_CLOSE()
	
		//オーナー：！マーク
		_TIME_WAIT( 16 )
		_OBJ_ANIME( C04R0201_OWNER_01, anm_mark_gyoe )
		_OBJ_ANIME_WAIT()
	
	  //きみたち いいかんじ！
	  _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_02, C04R0201_OWNER_01 )
	  _MSGWIN_CLOSE()
	
	  //オーナー：グッズケースを渡す
	  _OBJ_ANIME( C04R0201_OWNER_01, anm_first_owner_move_02 )
	  _OBJ_ANIME_WAIT()
	
	  //グッズケース入手
	  _ITEM_EVENT_KEYWAIT( ITEM_GUZZUKEESU, 1 )
	
	  //オーナー：一歩さがる
	  _OBJ_ANIME( C04R0201_OWNER_01, anm_first_owner_move_03 )
	  _OBJ_ANIME_WAIT()
	
	  //そのグッズケースの中に
	  _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_03, C04R0201_OWNER_01 )
	  _MSGWIN_CLOSE()
	  
	  _CALL ev_scene_c04r0201_musical_first_02

  ENDIF
  
}
EVENT_END

/************************************************************/
/*		CALL：チュートリアル後半処理				*/
/************************************************************/
ev_scene_c04r0201_musical_first_02:

  _MUSICAL_TOOLS( MUSICAL_TOOL_INIT, 0,0,0 )
	{
	DEFINE_LOCAL LWK_ENT_CHK
	
	//ミュージカル参加できるポケが何匹いるかチェック
	_GET_MUSICAL_VALUE_COUNT_MUSICAL_POKE( LWK_ENT_CHK )
	IF $LWK_ENT_CHK == 0 THEN
		//参加できるポケモンがいない
		
		//オーナー：！マーク
		_TIME_WAIT( 16 )
		_OBJ_ANIME( C04R0201_OWNER_01, anm_mark_gyoe )
		_OBJ_ANIME_WAIT()
		
		//残念ながら参加できないようだ
		_BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_03a, C04R0201_OWNER_01 )
		
	ELSE
		//参加できるポケモンがいる
		
		//ドレスアップ参加フローへ
		_CALL	ev_fitting_entry
		
	ENDIF
	
	}
  _MUSICAL_TOOLS( MUSICAL_TOOL_EXIT, 0,0,0 )

	//私はね… …楽しみにしてるよ
	_BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_05, C04R0201_OWNER_01 )
	_MSGWIN_CLOSE()
	
	//オーナー：去る
	_OBJ_ANIME( C04R0201_OWNER_01, anm_first_owner_goaway_01 )
	_OBJ_ANIME_WAIT()
	
	//オーナーを元の位置へ配置
	_OBJ_POS_CHANGE( C04R0201_OWNER_01, 17, 6, 3, DIR_DOWN )

  //========================================//
  //初回話しかけイベント無効
	$WK_SCENE_C04R0201 = 2
  //========================================//
_RET

/************************************************************/
/*		CALL：初回コンバートありで「いいえ」処理				*/
/************************************************************/
ev_first_convert_no:

  //あらあら　そうですか！
  _BALLOONWIN_OBJMSG( msg_c04r0201_goods_get_reject_00, C04R0201_OWNER_01 )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //オーナー：グッズケースを渡す
  _OBJ_ANIME( C04R0201_OWNER_01, anm_first_owner_move_02 )
  _OBJ_ANIME_WAIT()

  //グッズケース入手
  _ITEM_EVENT_KEYWAIT( ITEM_GUZZUKEESU, 1 )

  //オーナー：一歩さがる
  _OBJ_ANIME( C04R0201_OWNER_01, anm_first_owner_move_03 )
  _OBJ_ANIME_WAIT()

  //あなたなら　きっと　しんせだいの
  _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_03, C04R0201_OWNER_01 )
  _MSGWIN_CLOSE()

_RET

/************************************************************/
/*		CALL：ドレスアップ参加フロー				*/
/************************************************************/
ev_fitting_entry:
	
	{
	DEFINE_LOCAL LWK_ENT_POKE
	DEFINE_LOCAL LWK_SEL_CANCEL
	
	//参加ポケモンを選ぶまで繰り返す
	WHILE $LWK_SEL_CANCEL == 0
		
		//選択画面をコール
		_SELECT_MUSCAL_POKE( LWK_SEL_CANCEL , LWK_ENT_POKE )
		
		//キャンセルして戻ってきたなら再度勧誘
		IF $LWK_SEL_CANCEL == 0 THEN
			//そんな事言わないで さあさあポケモン選んでよ
			_BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_03c, C04R0201_OWNER_01 )
			_MSGWIN_CLOSE()
		ENDIF
		
	ENDWHILE
	
	//ではではレッツ ドレスアップ
	_BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_03d, C04R0201_OWNER_01 )
	_MSGWIN_CLOSE()
	
	//ドレスアップ処理：呼び出し
  _DEMO_MUSICAL_DRESSUP_FADEOUT_CALL()
  _FIELD_CLOSE()

	_MUSICAL_FITTING_CALL( LWK_ENT_POKE )

  _FIELD_OPEN()
  _DEMO_MUSICAL_DRESSUP_FADEIN_CALL()
		
	//グッズをつけたか（0＝未装着, 1＝装着）
	_GET_MUSICAL_VALUE_IS_EQUIP_ANY_DRESSUP( SCWK_ANSWER )
	IF $SCWK_ANSWER == FALSE THEN
		//グッズを１つもつけなかった
		
		//なにもつけずに…
		_BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_03b, C04R0201_OWNER_01 )
	ELSE
		//グッズ１つ以上つけてた
		
		//おおお！二人とも素晴らしい
		_BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_04, C04R0201_OWNER_01 )
	ENDIF
	
	}
	
_RET

/************************************************************/
/*		RESERVE：チュートリアルからおもいでリンク復帰処理				*/
/************************************************************/
EVENT_START		ev_reserve_c04r0201_link_event_ret01
{
  DEFINE_LOCAL LWK_GET_ITEM
  
  //ブラックイン
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()
  
  //オーナー：おもいでリンク終了メッセージ
  _BALLOONWIN_OBJMSG( msg_c04r0201_memory_02, C04R0201_OWNER_01 )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //オーナー：グッズケースを渡す
  _OBJ_ANIME( C04R0201_OWNER_01, anm_first_owner_move_02 )
  _OBJ_ANIME_WAIT()

  //グッズケース入手
  _ITEM_EVENT_KEYWAIT( ITEM_GUZZUKEESU, 1 )
  
  //オーナー：一歩さがる
  _OBJ_ANIME( C04R0201_OWNER_01, anm_first_owner_move_03 )
  _OBJ_ANIME_WAIT()
  
  //グッズコンバート
  _DATACONV_CONV_MUSICAL( LWK_GET_ITEM )
  
  //あなたなら　きっと　しんせだいの
  _BALLOONWIN_OBJMSG( msg_c04r0201_owner_demo_swan_03a, C04R0201_OWNER_01 )
  _MSGWIN_CLOSE()
  
  //========================================//
  //リンクイベント終了
  $WK_SYS_LINK_EVENT_07 = 1
  //========================================//
  
  //チュートリアル後半処理
  _CALL ev_scene_c04r0201_musical_first_02
}
EVENT_END

