//    スクリプトファイル：n01r0501用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_n01r0501.h"
  .include  "n01r0501.h"
  .include  "n01r0501_def.h"
  .include  "pair_scr_def.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_n01r0501
_EVENT_DATA    ev_init_n01r0501
_EVENT_DATA    ev_pos_n01r0501_boss_01
_EVENT_DATA    ev_n01r0501_boss_02
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_n01r0501
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_n01r0501

  //N表示状態なら位置を変更
  IF FLAG_OFF( FV_N01R0501_BOSS_01 ) THEN
    _OBJ_POS_CHANGE( N01R0501_BOSS_01, 31, 0, 18, DIR_LEFT )
  ENDIF
  
INIT_EVENT_END

/**************************************************************/
/*		POS：謁見の間前						  */
/**************************************************************/
EVENT_START		ev_pos_n01r0501_boss_01
    //連れ歩いている
  IF FLAG_ON(SYS_FLAG_PAIR) THEN
    _CALL ev_n01r0501_pairend_01
  
  //連れ歩いていない
  ELSE
    _CALL ev_n01r0501_boss_stopper_01
  ENDIF
EVENT_END

/**************************************************************/
/*		CALL：謁見の間イベントまでストッパー						  */
/**************************************************************/
ev_n01r0501_boss_stopper_01:
  //Ｎ：ここが
  _BALLOONWIN_OBJMSG_POS( msg_n01r0501_boss_02, N01R0501_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公１歩左へ
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
  _OBJ_ANIME_WAIT()
_RET

/**************************************************************/
/*		CALL：連れ歩き終了						  */
/**************************************************************/
ev_n01r0501_pairend_01:
  
  //==================================//
  //通常用N配置
  _FLAG_RESET( FV_N01R0501_BOSS_01 )
  //N01R0401_N01R0402_SCENE_CHANGE無効
  $WK_SCENE_N01R0402_BOSS = 4
  //==================================//
  
  //連れ歩き解除
  _PAIR_TRAINER_FREE( SCRID_N01R0501_BOSS_02, MV_DMY )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  $LCW_POSX += 1
  
  //動作モデル・連れ歩き削除・通常用生成
  _OBJ_ADD( N01R0501_BOSS_01 )
  //通常用を現在のNと同じ位置に配置
  _OBJ_POS_CHANGE(N01R0501_BOSS_01,LCW_POSX,0,LCW_POSZ,DIR_LEFT)
  _OBJ_DEL( PAIR_TRAINER_01 )
  
  //アニメ：主人公１歩左へ
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
  _OBJ_ANIME_WAIT()
  
  //Ｎ：ここが
  _BALLOONWIN_OBJMSG_POS( msg_n01r0501_boss_01, N01R0501_BOSS_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
_RET

/**************************************************************/
/*		空ラベル：連れ歩き後Ｎ						  */
/**************************************************************/
EVENT_START	ev_n01r0501_boss_02
//
EVENT_END

