  .text

  .include  "scr_seq_def.h"
  .include  "msg_c03p17.h"
  .include  "c03p17.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_scene_c03p17_swchampion_02
_EVENT_DATA		ev_c03p17_swchampion_01
_EVENT_DATA		ev_c03p17_workman_01
_EVENT_DATA		ev_zone_c03p17
_EVENT_DATA		ev_init_c03p17
_EVENT_DATA		ev_pos_c03p17_swchampion_03_01
_EVENT_DATA		ev_pos_c03p17_swchampion_03_02
_EVENT_DATA		ev_c03p17_badman_01
_EVENT_DATA_END

//話しかけた方向取得変数
  DEFINE_LOCAL LWK_DIR
  DEFINE_LOCAL  LCW_POSX
  DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c03p17
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c03p17
  
  //下水道ストッパーをジム前イベントまで配置
  IF $WK_SCENE_C03P17 < 1 THEN
    _OBJ_POS_CHANGE( C03P17_WORKMAN_01, 11, -1, 21, DIR_RIGHT )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*		SCENE_CHANGE：アイリス誘導イベント                      */
/**************************************************************/
EVENT_START		ev_scene_c03p17_swchampion_02
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )

  //カメラ移動
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9467,0,1191936,528384,0,897024,40 )
  
  //アニメ：主人公アイリスの前に移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 8,14, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //アイリス：こっちが
  _BALLOONWIN_OBJMSG_POS( msg_c03p17_swchampion_01, C03P17_SWCHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アイリス下を向く
  _OBJ_ANIME( C03P17_SWCHAMPION_01, anm_staystep_r )
  
  //カメラ：下水道に注目して戻す
  _CAMERA_MOVE( 9688,4480,970752,1130496,0,1155072,50 )
  _TIME_WAIT(120)
  _CAMERA_MOVE( 9467,0,1191936,528384,0,897024,40 )
  
  _OBJ_ANIME_WAIT()
  
  //==================================//
  //C03P17ライバル表示
  _FLAG_RESET( FV_C03P17_SWRIVAL_01 )
  _OBJ_ADD( C03P17_SWRIVAL_01 )
  //==================================//
  
  //アニメ：ライバル主人公わきに移動
  _OBJ_ANIME( C03P17_SWCHAMPION_01, anm_staystep_l )
  _OBJ_ANIME_AUTO( C03P17_SWRIVAL_01, 8,15, FORCE_TYPE_NOT, 4, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C03P17_SWRIVAL_01, anm_staystep_u )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ライバル：こっちが
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_c03p17_swrival_01, C03P17_SWRIVAL_01, POS_DEFAULT )
  
   {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_c03p17_swrival_02, C03P17_SWRIVAL_01, POS_DEFAULT )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_c03p17_swrival_03, C03P17_SWRIVAL_01, POS_DEFAULT )
  ENDIF
  
  //ライバル：となると
  _BALLOONWIN_OBJMSG_POS( msg_c03p17_swrival_04, C03P17_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  }
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (40)
  
  //アニメ：ライバル・下水道に移動
  _OBJ_ANIME( C03P17_SWRIVAL_01, anm_swrival_go_d11 )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( C03P17_SWCHAMPION_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()    //カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()   //カメラ操作終了
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //ライバル動作モデル削除
  _OBJ_DEL( C03P17_SWRIVAL_01 )
  
  _SE_WAIT()
  
  _OBJ_ANIME( C03P17_SWCHAMPION_01, anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //アイリス：いいんじゃない？
  _BALLOONWIN_OBJMSG_POS( msg_c03p17_swchampion_02, C03P17_SWCHAMPION_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //==================================//
  //C03P17_SCENE_CHANGE無効
  $WK_SCENE_C03P17 = 2
  //C03P17ライバル非表示
  _FLAG_SET( FV_C03P17_SWRIVAL_01 )
  //ローカルライブキャスター・ライバル通話状態を変更（D11開始まで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_D11_0 )
  //==================================//
EVENT_END

//--------------------------------------------------------------------
//	☆ライバル下水道へ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swrival_go_d11
	_ANIME_DATA	AC_WALK_D_4F,2
	_ANIME_DATA	AC_WALK_R_4F,2
	_ANIME_DATA	AC_WALK_D_4F,4
	_ANIME_DATA	AC_WALK_R_4F,9
	_ANIME_DATA	AC_WALK_U_4F,4
	_ANIME_DATA	AC_WALK_L_4F,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*		POS：下水道クリア後                                     */
/**************************************************************/
EVENT_START		ev_pos_c03p17_swchampion_03_01

  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  _OBJ_ANIME( C03P17_SWCHAMPION_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  $LCW_POSZ -= 2
  
  //アニメ：アイリス主人公の前に移動
  _OBJ_ANIME_AUTO( C03P17_SWCHAMPION_01, LCW_POSX , LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //アイリス：きみのともだち
  _BALLOONWIN_OBJMSG_POS( msg_c03p17_swchampion_03, C03P17_SWCHAMPION_01, POS_DEFAULT )
  
  //アイリス：これから
  _BALLOONWIN_OBJMSG_POS( msg_c03p17_swchampion_04, C03P17_SWCHAMPION_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //==================================//
  //C03P17_POS無効
  $WK_SCENE_C03P17 = 4
  //C03P07ジム前ストッパー解除
  _FLAG_SET( FV_C03P07_SUNGLASSES_01 )
  //==================================//
  
EVENT_END

/**************************************************************/
/*		POS：下水道クリア後                                     */
/**************************************************************/
EVENT_START		ev_pos_c03p17_swchampion_03_02

  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  _OBJ_ANIME( C03P17_SWCHAMPION_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //アニメ：アイリス主人公の前に移動
  _OBJ_ANIME_AUTO( C03P17_SWCHAMPION_01, 6 , LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //アニメ：アイリス左を向く
  _OBJ_ANIME( C03P17_SWCHAMPION_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
   
  //アイリス：きみのともだち
  _BALLOONWIN_OBJMSG_POS( msg_c03p17_swchampion_03, C03P17_SWCHAMPION_01, POS_DEFAULT )
  
  //アイリス：これから
  _BALLOONWIN_OBJMSG_POS( msg_c03p17_swchampion_04, C03P17_SWCHAMPION_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //==================================//
  //C03P17_POS無効
  $WK_SCENE_C03P17 = 4
  //C03P07ジム前ストッパー解除
  _FLAG_SET( FV_C03P07_SUNGLASSES_01 )
  //==================================//
  
EVENT_END

/**************************************************************/
/*		アイリス話しかけ                                        */
/**************************************************************/
EVENT_START		ev_c03p17_swchampion_01
  
  //下水道クリア後
  IF $WK_SCENE_C03P17 > 3 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03p17_swchampion_04 )
  //下水道クリア前
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03p17_swchampion_02 )
  ENDIF
  
EVENT_END

/**************************************************************/
/*		badman話しかけ                                          */
/**************************************************************/
EVENT_START		ev_c03p17_badman_01

  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03p17_badman_01 )

EVENT_END

/**************************************************************/
/*		ストッパー：workman                                     */
/**************************************************************/
EVENT_START		ev_c03p17_workman_01
  //下水道開始前
  IF $WK_SCENE_C03P17 < 1 THEN
    _TALK_START_SE_PLAY()
    _BALLOONWIN_OBJMSG_POS( msg_c03p17_stop_01 , C03P17_WORKMAN_01 ,POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  //下水道クリア
  ELSIF $WK_SCENE_C03P17 == 4 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03p17_stop_03 )
  //下水道攻略中
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03p17_stop_02 )
  ENDIF
EVENT_END


