
//======================================================================
//                n01r0401.ev
//
//    スクリプトファイル：n01r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_n01r0401.h"
  .include  "n01r0401.h"
  .include  "pair_scr_def.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_pos_n01r0401_boss_01
_EVENT_DATA		ev_pos_n01r0401_boss_02
_EVENT_DATA		ev_scene_n01r0401_boss_03
_EVENT_DATA    ev_zone_n01r0401
_EVENT_DATA    ev_init_n01r0401
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
DEFINE_LOCAL  LCW_N_POSX
DEFINE_LOCAL  LCW_N_POSZ

//------------------------------注意--------------------------------//
//下記のローカルワークを使用しているため注意して下さい。

// LOCALWORK15→N戻り位置設定
//------------------------------------------------------------------//

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_n01r0401
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_n01r0401

  //イベント進行で配置を分岐
  IF $WK_SCENE_N01R0402_BOSS == 2 THEN
  //子ども部屋から退室時なら以下の配置に
    _OBJ_POS_CHANGE( N01R0401_BOSS_01, 9, 0, 9, DIR_RIGHT )
  ENDIF
INIT_EVENT_END

/**************************************************************/
/*		POS：N連れ歩き（階段前）						  */
/**************************************************************/
EVENT_START		ev_pos_n01r0401_boss_01
    //連れ歩いている
  IF FLAG_ON(SYS_FLAG_PAIR) THEN
    _CALL ev_n01r0401_pairend_01
  
  //連れ歩いていない
  ELSE
    _CALL ev_n01r0401_pairstart_01
  ENDIF
EVENT_END

//連れ歩き開始スクリプト
ev_n01r0401_pairstart_01:

  //主人公・N名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  //N座標取得
  _OBJ_POS_GET( N01R0401_BOSS_01,LCW_N_POSX,LCW_N_POSZ ) 

  $LCW_POSX += 2
  
  IF $LCW_POSZ != $LCW_N_POSZ || $LOCALWORK15 == 0 THEN
    _OBJ_ANIME_AUTO( N01R0401_BOSS_01, LCW_POSX,LCW_POSZ, FORCE_TYPE_NOT, 16, DIR_LR )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  IF $LCW_POSZ != $LCW_N_POSZ THEN
    _OBJ_ANIME( N01R0401_BOSS_01, anm_staystep_l )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //一緒に行こう！
  _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_01, N01R0401_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( N01R0401_BOSS_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_02, N01R0401_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( N01R0401_BOSS_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_03, N01R0401_BOSS_01, POS_DEFAULT )
  _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_04, N01R0401_BOSS_01, POS_DEFAULT )
   {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_05, N01R0401_BOSS_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //自転車に乗ってるなら歩行状態へ
    _PLAYER_FORM_GET( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_PLAYER_FORM_CYCLE THEN
      _PLAYER_REQUEST( FIELD_PLAYER_REQBIT_NORMAL )
    ENDIF
    
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
    
    //連れ歩き開始
    _PAIR_TRAINER_SET( N01R0401_BOSS_01 , PAIR_ID_N01_BOSS, PAIR_TYPE_FREE_ZONE, 0, SCRID_N01R0401_BOSS )
    //==================================//
    //入室イベント初期化
    $LOCALWORK15 = 0
    //N01R0501_POS起動
    $WK_SCENE_N01R0501_BOSS = 1
    //N01R0502_POS起動
    $WK_SCENE_N01R0502_BOSS = 1
    //N非表示
    _FLAG_SET(FV_N01R0401_BOSS_01)
    
    //子ども部屋イベントが未見であったらSCENE_CHANGEを有効に
    IF FLAG_OFF( FE_N01R0401_HEYA_END_01 ) THEN
      $WK_SCENE_N01R0402_BOSS = 1
    ENDIF
    //==================================//
    
  //いいえ
  ELSE

    _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_07, N01R0401_BOSS_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
    
    //==================================//
    //入室イベント終了状態（マップ遷移で初期化）
    $LOCALWORK15 = 1
    //==================================//

  ENDIF
  }
_RET

//連れ歩き中終了処理
ev_n01r0401_pairend_01:

  //主人公名代入
  _PLAYER_NAME( 0 )
  
  //主人公方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //アニメ：主人公振り向き
  IF $LWK_DIR == DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_d )
  ELSIF $LWK_DIR == DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_r )
  ELSIF $LWK_DIR == DIR_LEFT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_l )
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_u )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //N：いちどそとにでる？
  _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_06, PAIR_TRAINER_01, POS_DEFAULT )
  
   {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_07, PAIR_TRAINER_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //連れ歩き解除
    _PAIR_TRAINER_FREE( SCRID_N01R0401_BOSS, MV_DMY )
    
    //アニメ：主人公戻す・N戻る
    _OBJ_ANIME_AUTO( PAIR_TRAINER_01,12,14, FORCE_TYPE_NOT, 8, DIR_LR )
    _OBJ_ANIME_WAIT()
    
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_l )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
    
    //==================================//
    //N01R0401_N表示
    _FLAG_RESET(FV_N01R0401_BOSS_01)
    //==================================//
    
    _OBJ_ADD( N01R0401_BOSS_01 )
    _OBJ_DEL( PAIR_TRAINER_01 )

    //==================================//
    //N01R0502_POS無効
    $WK_SCENE_N01R0502_BOSS = 0
    //==================================//
  
  //いいえ
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_08, PAIR_TRAINER_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    _PAIR_PLAYER_FOLLOW_ON()  //連れ歩き追随開始
    //アニメ：主人公戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
    _PAIR_PLAYER_FOLLOW_OFF() //連れ歩き追随終了
    
  ENDIF
  }
_RET

/**************************************************************/
/*		POS：N連れ歩き（子ども部屋前ストッパー）						  */
/**************************************************************/
EVENT_START		ev_pos_n01r0401_boss_02

  //Ｎ：もうそこはいい
  _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_13, PAIR_TRAINER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _PAIR_PLAYER_FOLLOW_ON()  //連れ歩き追随開始
  //アニメ：主人公１歩戻る処理
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_d )
  _OBJ_ANIME_WAIT()
  _PAIR_PLAYER_FOLLOW_OFF() //連れ歩き追随終了
    
EVENT_END

/**************************************************************/
/*		SCENE_CHANGE：子ども部屋から出てくる		  */
/**************************************************************/
EVENT_START		ev_scene_n01r0401_boss_03
  
  //アニメ：主人公振り向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //Ｎ：さあ！案内したまえ
  _BALLOONWIN_OBJMSG_POS( msg_n01r0401_boss_05, N01R0401_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //連れ歩き開始
  _PAIR_TRAINER_SET( N01R0401_BOSS_01 , PAIR_ID_N01_BOSS, PAIR_TYPE_FREE_ZONE, 0, SCRID_N01R0401_BOSS )
  
  _PAIR_PLAYER_FOLLOW_ON()  //連れ歩き追随開始
  //アニメ：主人公１歩下に行く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_d )
  _OBJ_ANIME_WAIT()
  _PAIR_PLAYER_FOLLOW_OFF() //連れ歩き追随終了
  
  //==================================//
  //N01R0401_SCENE_CHANGE無効
  $WK_SCENE_N01R0402_BOSS = 3
  //N01R0401_N非表示
  _FLAG_SET(FV_N01R0401_BOSS_01)
  //==================================//
    
EVENT_END


//--------------------------------------------------------------------
//	☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_staystep_u
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_d
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_l
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_r
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：はてな
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_hatena
	_ANIME_DATA	AC_MARK_HATENA,1
	_ANIME_DATA	ACMD_END,0