
//======================================================================
//                r13r0301.ev
//
//    スクリプトファイル：r13r0301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_r13r0301.h"
  .include  "r13r0301.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_r13r0301_badman_01
_EVENT_DATA    ev_r13r0301_poke_01
_EVENT_DATA_END

//主人公座標取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*  スキンヘッド：話しかけ                                  */
/************************************************************/
EVENT_START   ev_r13r0301_badman_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r13r0301_badman_01 )
EVENT_END

/**************************************************************/
/*  コマタナ：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_r13r0301_poke_01

  _TALK_OBJ_START()

  //コマタナ：シュパッ！！【仮】モデルはチラーミィ、声のみコマタナ
  _VOICE_PLAY( MONSNO_634, 0 ) 
  _BALLOONWIN_TALKOBJ_MSG( msg_r13r0301_pokemon_01 )
  _VOICE_WAIT()
  _AB_KEYWAIT()
  _MSGWIN_CLOSE()

  //自機方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //アニメ：コマタナそっぽを向く
  SWITCH $LWK_DIR
  CASE DIR_UP THEN
    _OBJ_ANIME( R13R0301_POKE_01, anm_common_turn_u )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( R13R0301_POKE_01, anm_common_turn_r )
  CASE DIR_DOWN THEN
    _OBJ_ANIME( R13R0301_POKE_01, anm_common_turn_d )
  CASE DIR_LEFT THEN
    _OBJ_ANIME( R13R0301_POKE_01, anm_common_turn_l )
  ENDSWITCH
 _OBJ_ANIME_WAIT()

EVENT_END

//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

