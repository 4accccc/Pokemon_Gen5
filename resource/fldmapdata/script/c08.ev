/**************************************************************/
/* POS：リンクイベント                                   */
/**************************************************************/
EVENT_START   ev_pos_c08_link_event
  
  //アニメ：シャガ「！」振り向く
  _OBJ_ANIME( C08_SWLEADER7_01,anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C08_SWLEADER7_01,anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  $LCW_POSZ -= 2
  //アニメ：シャガ隣接
  _OBJ_ANIME_AUTO( C08_SWLEADER7_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  IF $LCW_POSX != 418 THEN
    _OBJ_ANIME( C08_SWLEADER7_01,anm_staystep_d )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //シャガ：起動
  _BALLOONWIN_OBJMSG_POS( msg_c08_memory_01 , C08_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  _MAP_FADE_BLACK_OUT_SLOW()
  
  //過去イベント・ソウリュウ起動
  _RESERVE_SCRIPT( SCRID_RESERVE_OLDC08R0101_EVENT_01 )
  _MAP_FADE_END_CHECK()
  //マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_OLDC08R0101, 9, 0, 9, DIR_DOWN )

EVENT_END

/**************************************************************/
/* RESERVE：リンクイベント終了                                   */
/**************************************************************/
EVENT_START   ev_reserve_c08_link_event_ret

  //画面暗転処理
	_MAP_FADE_BLACK_IN()
	_MAP_FADE_END_CHECK()

  //アニメ：シャガ退場
  _OBJ_ANIME_AUTO( C08_SWLEADER7_01, 418, 161, FORCE_TYPE_ALL, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //シャガ動作モデル削除
  _OBJ_DEL( C08_SWLEADER7_01 )
  
  //========================================//
  //POS無効
  $WK_SCENE_C08_LINK_EVENT = 2
  //リンクイベント終了
  $WK_SYS_LINK_EVENT_04 = 1
  //C08シャガ非表示
  _FLAG_SET( FV_C08R0101_SWLEADER7_01 )
  //========================================//

EVENT_END
/**************************************************************/
/* GEGNTLEMAN_01                                              */
/**************************************************************/

EVENT_START   ev_c08_gentleman_01
	//クリア前メッセージ
	IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_gentleman_01)
	
	//クリア後
	ELSE
		//WB分岐メッセージ
		_TALK_OBJ_START()
		_BALLOONWIN_OBJMSG_WB( msg_c08_gentleman_01w , msg_c08_gentleman_01b , C08_GENTLEMAN_01 , POS_DEFAULT)
		_LAST_KEYWAIT()
		_BALLOONWIN_CLOSE()
	
	ENDIF
EVENT_END

