//	オノノクス：「？」振り向き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_ononokusu_hatena
  _ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	ヴィオ：左右をきょろきょろ見る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_sage7_look_lr
	_ANIME_DATA	AC_STAY_WALK_L_16F,1
	_ANIME_DATA	AC_STAY_WALK_R_16F,1
	_ANIME_DATA	AC_STAY_WALK_L_16F,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*  CALL：ダークトリニティ（１）                                  */
/**************************************************************/
ev_c08_ninja_comming:
  
  _OBJ_ANIME( C08_SWLEADER7_01, anm_staystep_l)
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r)
  _OBJ_ANIME_WAIT()

  //シャガ：さすがだな
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_13 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //【仮】回復処理（メッセージが必要かも）
  _SE_PLAY( SEQ_SE_RECOVERY )
  _SE_WAIT()
	//回復処理
	_TEMOTI_POKEMON_KAIFUKU()
	
	//シャガ：ここで
	_BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_14 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //バージョンを取得
  _GET_ROM_VERSION( LCW_VERSION )
  
  //アニメ：シャガジム方面へ移動
  IF $LCW_VERSION == VERSION_B2 THEN
    _OBJ_ANIME( C08_SWLEADER7_01, anm_swleader7_go_gym_b)
  ELSE
    _OBJ_ANIME( C08_SWLEADER7_01, anm_swleader7_go_gym_w)
  ENDIF
  
  _TIME_WAIT(4)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _OBJ_DEL( C08_SWLEADER7_01 )
  _SE_WAIT()
  
  _TIME_WAIT( 8 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _OBJ_ADD( C08_SWLEADER7_01 )
  _SE_WAIT()
  
  //アニメ：シャガジム方面から戻る
  IF $LCW_VERSION == VERSION_B2 THEN
    _OBJ_ANIME( C08_SWLEADER7_01, anm_swleader7_return_gym_b)
  ELSE
    _OBJ_ANIME( C08_SWLEADER7_01, anm_swleader7_return_gym_w)
  ENDIF

  _TIME_WAIT(4)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r)
  _OBJ_ANIME_WAIT()
  
  //プレイヤー名格納
  _PLAYER_NAME( 0 )
  
  //シャガ：ふむ…！
	_BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_15 , C08_SWLEADER7_01 , POS_UR)
	
	//シャガ：いいか主人公
	_BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_15a , C08_SWLEADER7_01 , POS_UR)
	
  //_MSGWIN_CLOSE()
  
  //【仮】いでんしのくさびデモ
  
  //シャガ：これがあいつら
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_16 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //ダークトリニティ登場
	_OBJ_ADD( C08_NINJA_01 )
	
  //ダークトリニティ配置
  IF $LCW_VERSION == VERSION_B2 THEN
    _OBJ_POS_CHANGE( C08_NINJA_01, 403, 0, 147, DIR_DOWN )
  ELSE
    _OBJ_POS_CHANGE( C08_NINJA_01, 404, 0, 148, DIR_DOWN )
  ENDIF
	
	//登場アニメーション
	_OBJ_ANIME( C08_NINJA_01 , anm_c08_ninja_coming_01 )
	_OBJ_ANIME_WAIT()
	
	//イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_DARK_TRINITY )
	
	//アニメ：シャガ・主人公「！」
	_OBJ_ANIME( MMDL_ID_PLAYER , anm_look_ninja_gyoe )
	_OBJ_ANIME( C08_SWLEADER7_01 , anm_look_ninja_gyoe )
	_OBJ_ANIME_WAIT()
	
	//？？？：ジムがかくしばしょか
  _BALLOONWIN_OBJMSG_POS( msg_c08_ninja_01 , C08_NINJA_01 , POS_DL)
  _MSGWIN_CLOSE()
  
  //シャガ：まさか
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_17 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //？？？：おっしゃるとおり
  _BALLOONWIN_OBJMSG_POS( msg_c08_ninja_02 , C08_NINJA_01 , POS_DL)
  _MSGWIN_CLOSE()
  
  //ダークトリニティ2～3登場
	_OBJ_ADD( C08_NINJA_02 )
	_OBJ_ADD( C08_NINJA_03 )

  //ダークトリニティ配置
  IF $LCW_VERSION == VERSION_B2 THEN
    _OBJ_POS_CHANGE( C08_NINJA_02, 406, 0, 145, DIR_LEFT )
    _OBJ_POS_CHANGE( C08_NINJA_03, 406, 0, 146, DIR_LEFT )
  ELSE
    _OBJ_POS_CHANGE( C08_NINJA_02, 402, 0, 147, DIR_RIGHT )
    _OBJ_POS_CHANGE( C08_NINJA_03, 407, 0, 147, DIR_LEFT )
  ENDIF

	//登場アニメーション
	_OBJ_ANIME( C08_NINJA_02 , anm_c08_ninja_coming_01 )
	_OBJ_ANIME( C08_NINJA_03 , anm_c08_ninja_coming_01 )
	_OBJ_ANIME_WAIT()
	
	_TIME_WAIT( 8*5 )
	
  //アニメ：ダークトリニティ退場
  IF $LCW_VERSION == VERSION_B2 THEN
    _OBJ_ANIME( C08_NINJA_01 , anm_c08_ninja_escape_01b )
    _OBJ_ANIME( C08_NINJA_02 , anm_c08_ninja_escape_02b )
    _OBJ_ANIME( C08_NINJA_03 , anm_c08_ninja_escape_03b )
  ELSE
    _OBJ_ANIME( C08_NINJA_01 , anm_c08_ninja_escape_01w )
    _OBJ_ANIME( C08_NINJA_02 , anm_c08_ninja_escape_02w )
    _OBJ_ANIME( C08_NINJA_03 , anm_c08_ninja_escape_03w )
  ENDIF

	_OBJ_ANIME_WAIT()
	
	//ダークトリニティ2～3削除
	_OBJ_DEL( C08_NINJA_02 )
	_OBJ_DEL( C08_NINJA_03 )
	
	_OBJ_ANIME_WAIT()
	
	//シャガ：うばわれたら
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_18 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
	
	//アニメ：シャガ追いかける
  IF $LCW_VERSION == VERSION_B2 THEN
    _OBJ_ANIME( C08_SWLEADER7_01 , anm_c08_swleader7_run_b )
  ELSE
    _OBJ_ANIME( C08_SWLEADER7_01 , anm_c08_swleader7_run_w )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //シャガ・ダークトリニティ配置変更
  _OBJ_POS_CHANGE( C08_SWLEADER7_01, 398, 0, 167, DIR_UP )
  _MOVE_CODE_CHANGE( C08_SWLEADER7_01, MV_RND_H )
  _OBJ_POS_CHANGE( C08_NINJA_01, 442, 0, 175, DIR_LEFT )
  
  //BGM終了
  _END_EVENT_BGM()
  
  //========================================//
  //C08：ダークトリニティ戦起動
  $WK_SCENE_C08_NINJA = 1
  //C08：戦闘しないダークトリニティ非表示
  _FLAG_SET( FV_C08_NINJA_02 )
  //========================================//
  
_RET

