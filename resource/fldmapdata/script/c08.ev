/**************************************************************/
/*  シャガ：話しかけ                                  */
/**************************************************************/
EVENT_START   ev_c08_swleader7_01
  
  //主人公名格納
  _PLAYER_NAME( 0 )

  //ヴィオ戦前（振り向きなし一言メッセージ）
  IF $WK_SCENE_C08_SWPLAZMA <= 5 THEN
    _TALK_START_TURN_NOT()
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_12 , C08_SWLEADER7_01 , POS_DEFAULT)
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  //D10後～クリアまで
  ELSIF $WK_SCENE_D10R0401_SWSAGE1_01 == 3 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_swleader7_25 )
  //【仮】ヴィオ戦条件を満たしている
  ELSIF $WK_SCENE_C08_SWPLAZMA == 6 && $WK_SCENE_C08_NINJA == 0 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_poke47_01 )
  //ダークトリニティイベント起動時
  ELSIF $WK_SCENE_C08_NINJA == 1 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_swleader7_19 )
  //プラズマ団イベント終了時
  ELSIF $WK_SCENE_C08_NINJA >= 2 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_swleader7_24 )
  ENDIF
  
  
  
EVENT_END

/**************************************************************/
/*  ヴィオ（SAGE7）：話しかけ                                  */
/**************************************************************/
EVENT_START   ev_c08_swsage7_01
  
    //ハイリンク通信ブロック処理
    _DISABLE_NETWORK_IN_IMPORTANT_EVENT()
    
    _TALK_OBJ_START()
    
    //イベント曲再生
    _START_TEMP_EVENT_BGM( SEQ_BGM_E_7_SAGE )
    
    //ヴィオ：やれやれ
    _BALLOONWIN_OBJMSG( msg_c08_sage7_05 , C08_SWSAGE7_01 )
    _BALLOONWIN_CLOSE()
    
    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_SWSAGE3_03, 0 )
    
    //結果チェック
    _CALL ev_battle_check
    
    //ヴィオ：強いトレーナーです
    _BALLOONWIN_OBJMSG( msg_c08_sage7_06 , C08_SWSAGE7_01 )
    _BALLOONWIN_CLOSE()
    
    //バージョンを取得
    _GET_ROM_VERSION( LCW_VERSION )
    
    //暗転処理
    _BLACK_OUT_SLOW()
    _DISP_FADE_END_CHECK()
    
     //シャガ・主人公配置変更
    IF $LCW_VERSION == VERSION_B2 THEN
      _OBJ_POS_CHANGE( C08_SWLEADER7_01, 404, 0, 145, DIR_DOWN )
      _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 403, 0, 145, DIR_DOWN )
    ELSE
      _OBJ_POS_CHANGE( C08_SWLEADER7_01, 405, 0, 145, DIR_DOWN )
      _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 404, 0, 145, DIR_DOWN )
    ENDIF

    //========================================//
    //プラズマ団動作OBJ削除
    _OBJ_DEL(C08_SWSAGE7_01)
    _OBJ_DEL(C08_SWPLAZMAM_01)
    _OBJ_DEL(C08_SWPLAZMAM_02)
    _OBJ_DEL(C08_SWPLAZMAM_03)
    _OBJ_DEL(C08_SWPLAZMAM_04)
    _OBJ_DEL(C08_SWPLAZMAW_01)
    _OBJ_DEL(C08_SWPLAZMAW_02)
    //C08プラズマ団非表示
    _FLAG_SET( FV_C08_SWSAGE7_01 )
    _FLAG_SET( FV_C08_SWPLAZMA_01 )
    //C08ダークトリニティ（１）（２）表示
    _FLAG_RESET( FV_C08_NINJA_01 )
    _FLAG_RESET( FV_C08_NINJA_02 )
    
    //プラズマ団進行状況にプラス1
     $WK_SCENE_C08_SWPLAZMA += 1
    //========================================//
    
    //暗転復帰
    _BLACK_IN_SLOW()
    _DISP_FADE_END_CHECK()
    
    //ダークトリニティイベント（１）起動
    _CALL ev_c08_ninja_comming
    
    //ハイリンク通信ブロック処理終了
    _ENABLE_NETWORK_IN_IMPORTANT_EVENT()
    
EVENT_END

/**************************************************************/
/*  プラズマ団♂（１）：話しかけ／戦闘あり                     */
/**************************************************************/
EVENT_START   ev_c08_swplazmam_01
  
  _TALK_OBJ_START()
  
  //既に戦ったかチェック
  _TRAINER_FLAG_CHECK( TRID_SWPLAZMAM_32, SCWK_ANSWER )
  
  //まだ勝利していない
  IF $SCWK_ANSWER ==  FALSE THEN
    
    //トレーナー曲再生
    _TRAINER_BGM_SET(  TRID_SWPLAZMAM_32 )

    //戦闘前メッセージ
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam1_01 , C08_SWPLAZMAM_01 )
    _BALLOONWIN_CLOSE()
    
    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_SWPLAZMAM_32, 0 )
    
    //結果チェック
    _CALL ev_battle_check
      
    //========================================/
    //プラズマ団進行状況にプラス1
     $WK_SCENE_C08_SWPLAZMA += 1
     
    //トレーナーフラグセット
    _TRAINER_FLAG_SET( TRID_SWPLAZMAM_32 )
    
    //========================================/
    
    //プラズマ団全員に勝利した
    IF $WK_SCENE_C08_SWPLAZMA >= 5 THEN
      //========================================//
      //C08ヴィオ表示
      _FLAG_RESET( FV_C08_SWSAGE7_01 )
      _OBJ_ADD(C08_SWSAGE7_01)
      //========================================//
    ENDIF
    
  ENDIF
      
  //プラズマ団全員に勝利した（ヴィオ誘導メッセージ）
  IF $WK_SCENE_C08_SWPLAZMA >= 5 THEN
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam1_03 , C08_SWPLAZMAM_01 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
 
  //まだ全員倒していない（戦闘後メッセージ）
  ELSE
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam1_02 , C08_SWPLAZMAM_01 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF

EVENT_END

/**************************************************************/
/*  プラズマ団♂（２）：話しかけ／戦闘あり                     */
/**************************************************************/
EVENT_START   ev_c08_swplazmam_02
  
  _TALK_OBJ_START()
  
  //既に戦ったかチェック
  _TRAINER_FLAG_CHECK( TRID_SWPLAZMAM_33, SCWK_ANSWER )
  
  //まだ勝利していない
  IF $SCWK_ANSWER ==  FALSE THEN

    //トレーナー曲再生
    _TRAINER_BGM_SET(  TRID_SWPLAZMAM_33 )

    //戦闘前メッセージ
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam2_01 , C08_SWPLAZMAM_02 )
    _BALLOONWIN_CLOSE()
    
    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_SWPLAZMAM_33, 0 )
    
    //結果チェック
    _CALL ev_battle_check
      
    //========================================/
    //プラズマ団進行状況にプラス1
     $WK_SCENE_C08_SWPLAZMA += 1
     
    //トレーナーフラグセット
    _TRAINER_FLAG_SET( TRID_SWPLAZMAM_33 )
    
    //========================================/
    
    //プラズマ団全員に勝利した
    IF $WK_SCENE_C08_SWPLAZMA >= 5 THEN
      //========================================//
      //C08ヴィオ表示
      _FLAG_RESET( FV_C08_SWSAGE7_01 )
      _OBJ_ADD(C08_SWSAGE7_01)
      //========================================//
    ENDIF
    
  ENDIF
      
  //プラズマ団全員に勝利した（ヴィオ誘導メッセージ）
  IF $WK_SCENE_C08_SWPLAZMA >= 5 THEN
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam2_03 , C08_SWPLAZMAM_02 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
 
  //まだ全員倒していない（戦闘後メッセージ）
  ELSE
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam2_02 , C08_SWPLAZMAM_02 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF
  
EVENT_END

/**************************************************************/
/*  プラズマ団♀（１）：話しかけ／戦闘あり                     */
