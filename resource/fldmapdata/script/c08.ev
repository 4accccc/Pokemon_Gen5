	_ANIME_DATA	AC_NINJA_ACT0,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------
//	C07　リュウラセンイベント開始：ダークトリニティ退場
//--------------------------------------------------------------
_ANIME_LABEL	anm_c07_ninja_bye_01
	_ANIME_DATA	AC_NINJA_ACT1,1
	_ANIME_DATA	AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*  POS：ダークトリニティ戦                                  */
/**************************************************************/
EVENT_START   ev_pos_c08_ninja_01
  //ハイリンク通信ブロック処理
  _DISABLE_NETWORK_IN_IMPORTANT_EVENT()
  
  //？？？：おっしゃるとおり
  _BALLOONWIN_OBJMSG_POS( msg_c08_ninja_03 , C08_NINJA_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //【仮】トレーナー戦呼び出し
  _TRAINER_BTL_SET( TRID_TANPAN_19, 0 )
    
  //結果チェック
  _CALL ev_battle_check
  
  //？？？：……ざんねん
  _BALLOONWIN_OBJMSG_POS( msg_c08_ninja_04 , C08_NINJA_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //シャガ近くに配置
  _OBJ_POS_CHANGE( C08_SWLEADER7_01, 405, 0, 175, DIR_LEFT )
  _MOVE_CODE_CHANGE( C08_SWLEADER7_01, MV_DMY )
  
  //シャガ隣接
  _OBJ_ANIME_AUTO( C08_SWLEADER7_01, 394, 175, FORCE_TYPE_ALL, 4, DIR_UD)
  
  _TIME_WAIT( 16)
  
  //アニメ：ダークトリニティ退場
	_OBJ_ANIME( C08_NINJA_01 , anm_c07_ninja_bye_01 )
	_OBJ_ANIME_WAIT()
	//ダークトリニティ動作OBJ削除
	_OBJ_DEL( C08_NINJA_01 )
	
	//シャガ：なんたること！
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_20 , C08_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
	
	//システムメッセージ：ライブキャスター着信
	_ME_PLAY( SEQ_ME_CALL )
  _SYSWIN_MSG( msg_c08_tvt_01, POS_DOWN )
  _ME_WAIT()//仮
  _SYSWIN_CLOSE()
  
  //システムメッセージ：ライブキャスターをつなげた
  _PLAYER_NAME( 0 )
  _SYSWIN_MSG( msg_c08_tvt_02, POS_DOWN )
  _SYSWIN_CLOSE()
  
  //【仮】ライブキャスターデモ
  
  //シャガ：ぐぬう！
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_21 , C08_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //フィールド上にチェレン配置
  _OBJ_ADD_EX( 385, 175, DIR_RIGHT, MMDL_ID_EVENTOBJ_00, SWLEADER1, MV_DMY )
  
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 391, 175, FORCE_TYPE_ALL, 4, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //プレイヤー・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //チェレン：（主人公名）！
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader1_01 , MMDL_ID_EVENTOBJ_00 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //シャガ：チェレンではないか
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_22 , C08_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //プレイヤー・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //チェレン：（主人公名）！
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader1_02 , MMDL_ID_EVENTOBJ_00 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //シャガ：そういってくれるか
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_23 , C08_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //プレイヤー・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //チェレン：（主人公名）！きみのはんだんに
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader1_03 , MMDL_ID_EVENTOBJ_00 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン退場
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 385, 175, FORCE_TYPE_ALL, 4, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //プレイヤー・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //シャガ：プラズマだん　から
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_24 , C08_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //チェレン動作OBJ削除
  _OBJ_DEL(MMDL_ID_EVENTOBJ_00)
  
  //========================================//
  //C08：ダークトリニティ戦POS無効
  $WK_SCENE_C08_NINJA = 2
  //C08：ダークトリニティ非表示
  _FLAG_SET( FV_C08_NINJA_01 )
  //========================================//
    
  //ハイリンク通信ブロック処理終了
  _ENABLE_NETWORK_IN_IMPORTANT_EVENT()
EVENT_END

/**************************************************************/
/*  シャガ：話しかけ                                  */
/**************************************************************/
EVENT_START   ev_c08_swleader7_01
  
  //主人公名格納
  _PLAYER_NAME( 0 )

  //ヴィオ戦前（振り向きなし一言メッセージ）
  IF $WK_SCENE_C08_SWPLAZMA <= 5 THEN
    _TALK_START_TURN_NOT()
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_12 , C08_SWLEADER7_01 , POS_DEFAULT)
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  //【仮】D10クリア前（参照条件が仮）
  //ELSIF $WK_SCENE_D10 == 0 THEN
    //_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_swleader7_25 )
  //【仮】ヴィオ戦条件を満たしている
  ELSIF $WK_SCENE_C08_SWPLAZMA == 6 && $WK_SCENE_C08_NINJA == 0 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_poke47_01 )
  //ダークトリニティイベント起動時
  ELSIF $WK_SCENE_C08_NINJA == 1 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_swleader7_19 )
  //プラズマ団イベント終了時
  ELSIF $WK_SCENE_C08_NINJA >= 2 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_swleader7_24 )
  ENDIF
  
  
  
EVENT_END

/**************************************************************/
/*  ヴィオ（SAGE7）：話しかけ                                  */
/**************************************************************/
EVENT_START   ev_c08_swsage7_01
  
  //プラズマ団全員に勝利した
  IF $WK_SCENE_C08_SWPLAZMA == 5 THEN
  
    //ハイリンク通信ブロック処理
    _DISABLE_NETWORK_IN_IMPORTANT_EVENT()
    
    _TALK_OBJ_START()
    
    //ヴィオ：やれやれ
    _BALLOONWIN_OBJMSG( msg_c08_sage7_05 , C08_SWSAGE7_01 )
    _BALLOONWIN_CLOSE()
    
    //【仮】トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_TANPAN_19, 0 )
    
    //結果チェック
    _CALL ev_battle_check
    
    //ヴィオ：強いトレーナーです
    _BALLOONWIN_OBJMSG( msg_c08_sage7_06 , C08_SWSAGE7_01 )
    _BALLOONWIN_CLOSE()
    
    //暗転処理
    _BLACK_OUT_SLOW()
    _DISP_FADE_END_CHECK()
    
    //シャガ配置変更
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 406, 0, 175, DIR_LEFT )
    _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 405, 0, 175, DIR_UP )
    
    //========================================//
    //プラズマ団動作OBJ削除
    _OBJ_DEL(C08_SWSAGE7_01)
    _OBJ_DEL(C08_SWPLAZMAM_01)
    _OBJ_DEL(C08_SWPLAZMAM_02)
    _OBJ_DEL(C08_SWPLAZMAM_03)
    _OBJ_DEL(C08_SWPLAZMAM_04)
    _OBJ_DEL(C08_SWPLAZMAW_01)
    _OBJ_DEL(C08_SWPLAZMAW_02)
    //C08プラズマ団非表示
    _FLAG_SET( FV_C08_SWPLAZMA_01 )
    //C08ダークトリニティ（１）（２）表示
    _FLAG_RESET( FV_C08_NINJA_01 )
    _FLAG_RESET( FV_C08_NINJA_02 )
    
    //プラズマ団進行状況にプラス1
     $WK_SCENE_C08_SWPLAZMA += 1
    //========================================//
    
    //暗転復帰
    _BLACK_IN_SLOW()
    _DISP_FADE_END_CHECK()
    
    //ダークトリニティイベント（１）起動
    _CALL ev_c08_ninja_comming
    
    //ハイリンク通信ブロック処理終了
    _ENABLE_NETWORK_IN_IMPORTANT_EVENT()
  
  //【仮】プラズマ団全員にまだ勝利していない
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08_poke47_01 )
  ENDIF
EVENT_END

/**************************************************************/
/*  プラズマ団♂（１）：話しかけ／戦闘あり                     */
/**************************************************************/
EVENT_START   ev_c08_swplazmam_01
  
  _TALK_OBJ_START()
  
  //【仮】既に戦ったかチェック
  _TRAINER_FLAG_CHECK( TRID_TANPAN_19, SCWK_ANSWER )
  
  //まだ勝利していない
  IF $SCWK_ANSWER ==  FALSE THEN

    //戦闘前メッセージ
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam1_01 , C08_SWPLAZMAM_01 )
    _AB_KEYWAIT_MARK()
    _BALLOONWIN_CLOSE()
    
    //【仮】トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_TANPAN_19, 0 )
    
    //結果チェック
    _CALL ev_battle_check
      
    //========================================/
    //プラズマ団進行状況にプラス1
     $WK_SCENE_C08_SWPLAZMA += 1
     
    //【仮】トレーナーフラグセット
    _TRAINER_FLAG_SET( TRID_TANPAN_19 )
    
    //========================================/
    
    //プラズマ団全員に勝利した
    IF $WK_SCENE_C08_SWPLAZMA >= 5 THEN
      //========================================//
      //C08ヴィオ表示
      _FLAG_RESET( FV_C08_SWSAGE7_01 )
      _OBJ_ADD(C08_SWSAGE7_01)
      //========================================//
    ENDIF
    
  ENDIF
      
  //【仮】プラズマ団全員に勝利した（ヴィオ誘導メッセージ）
  IF $WK_SCENE_C08_SWPLAZMA >= 5 THEN
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam1_03 , C08_SWPLAZMAM_01 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
 
  //まだ全員倒していない（戦闘後メッセージ）
  ELSE
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam1_02 , C08_SWPLAZMAM_01 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF

EVENT_END

/**************************************************************/
/*  プラズマ団♂（２）：話しかけ／戦闘あり                     */
/**************************************************************/
EVENT_START   ev_c08_swplazmam_02
  
  _TALK_OBJ_START()
  
  //【仮】既に戦ったかチェック
  _TRAINER_FLAG_CHECK( TRID_SCHOOLB_11, SCWK_ANSWER )
  
  //まだ勝利していない
  IF $SCWK_ANSWER ==  FALSE THEN

    //戦闘前メッセージ
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam2_01 , C08_SWPLAZMAM_02 )
    _AB_KEYWAIT_MARK()
    _BALLOONWIN_CLOSE()
    
    //【仮】トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_SCHOOLB_11, 0 )
    
    //結果チェック
    _CALL ev_battle_check
      
    //========================================/
    //プラズマ団進行状況にプラス1
     $WK_SCENE_C08_SWPLAZMA += 1
     
    //【仮】トレーナーフラグセット
    _TRAINER_FLAG_SET( TRID_SCHOOLB_11 )
    
    //========================================/
    
    //プラズマ団全員に勝利した
    IF $WK_SCENE_C08_SWPLAZMA >= 5 THEN
      //========================================//
      //C08ヴィオ表示
      _FLAG_RESET( FV_C08_SWSAGE7_01 )
      _OBJ_ADD(C08_SWSAGE7_01)
      //========================================//
    ENDIF
    
  ENDIF
      
  //【仮】プラズマ団全員に勝利した（ヴィオ誘導メッセージ）
  IF $WK_SCENE_C08_SWPLAZMA >= 5 THEN
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam2_03 , C08_SWPLAZMAM_02 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
 
  //まだ全員倒していない（戦闘後メッセージ）
  ELSE
    _BALLOONWIN_OBJMSG( msg_d27r0101_swplazmam2_02 , C08_SWPLAZMAM_02 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF
  
EVENT_END

