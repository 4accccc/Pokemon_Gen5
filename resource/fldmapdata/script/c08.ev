/**************************************************************/
/*  POS：ダークトリニティ戦                                  */
/**************************************************************/
EVENT_START   ev_pos_c08_ninja_01
  //ハイリンク通信ブロック処理
  _DISABLE_NETWORK_IN_IMPORTANT_EVENT()
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_DARK_TRINITY )
  
  //プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  $LCW_POSX += 1
  
  //アニメ：ダークトリニティ隣接
  _OBJ_ANIME_AUTO( C08_NINJA_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_ALL, 4, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //？？？：おっしゃるとおり
  _BALLOONWIN_OBJMSG_POS( msg_c08_ninja_03 , C08_NINJA_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //トレーナー戦呼び出し
  _TRAINER_BTL_SET( TRID_NINJA_04, 0 )
    
  //結果チェック
  _CALL ev_battle_check
  
  //？？？：……ざんねん
  _BALLOONWIN_OBJMSG_POS( msg_c08_ninja_04 , C08_NINJA_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //シャガ近くに配置
  IF $LCW_POSZ == 177 THEN
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 431, 0, 176, DIR_RIGHT )
  ELSE
     $LCW_POSZ += 1
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 431, 0, LCW_POSZ, DIR_RIGHT )
  ENDIF
  
  _MOVE_CODE_CHANGE( C08_SWLEADER7_01, MV_DMY )
  
  //プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //シャガ隣接
  SWITCH  $LCW_POSZ
  CASE 173 THEN
    _OBJ_ANIME( C08_SWLEADER7_01,anm_c08_swleader7_arrive_z173 )
  CASE 174 THEN
    _OBJ_ANIME( C08_SWLEADER7_01,anm_c08_swleader7_arrive_z174 )
  CASE 175 THEN
    _OBJ_ANIME( C08_SWLEADER7_01,anm_c08_swleader7_arrive_z175 )
  CASE 176 THEN
    _OBJ_ANIME( C08_SWLEADER7_01,anm_c08_swleader7_arrive_z176 )
  CASE 177 THEN
    _OBJ_ANIME( C08_SWLEADER7_01,anm_c08_swleader7_arrive_z175 )
  ENDSWITCH
  
  _TIME_WAIT(16)
  
  //アニメ：ダークトリニティ退場
	_OBJ_ANIME( C08_NINJA_01 , anm_ninja_bye_01 )
	_OBJ_ANIME_WAIT()
	
	//ダークトリニティ動作OBJ削除
	_OBJ_DEL( C08_NINJA_01 )
	
	//イベント曲終了
  _END_EVENT_BGM()
	
	//プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
	
	//シャガ：なんたること！
	IF $LCW_POSZ == 177 THEN
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_20 , C08_SWLEADER7_01 , POS_UL)
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_20 , C08_SWLEADER7_01 , POS_DL)
  ENDIF
  _MSGWIN_CLOSE()
	
	//システムメッセージ：ライブキャスター着信
	_ME_PLAY( SEQ_ME_CALL )
  _SYSWIN_MSG( msg_c08_tvt_01, POS_DOWN )
  _ME_WAIT()
  _SYSWIN_CLOSE()
  
  //システムメッセージ：ライブキャスターをつなげた
  _PLAYER_NAME( 0 )
  _SYSWIN_MSG( msg_c08_tvt_02, POS_DOWN )
  _SYSWIN_CLOSE()
  
  //ライブキャスター起動
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()
  _CALL_TVT_DEMO( 5 )
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()
  
  //シャガ：ぐぬう！
  IF $LCW_POSZ == 177 THEN
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_21 , C08_SWLEADER7_01 , POS_UL)
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_21 , C08_SWLEADER7_01 , POS_DL)
  ENDIF
  _MSGWIN_CLOSE()
  
  //プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_E_CHEREN )
  
  //フィールド上にチェレン配置
  _OBJ_ADD_EX( 446, 175, DIR_LEFT, MMDL_ID_EVENTOBJ_00, SWLEADER1, MV_DMY )
  
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 442, LCW_POSZ, FORCE_TYPE_ALL, 4, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //プレイヤー・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //チェレン：（主人公名）！
  IF $LCW_POSZ == 177 THEN
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader1_01 , MMDL_ID_EVENTOBJ_00 , POS_DR)
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader1_01 , MMDL_ID_EVENTOBJ_00 , POS_UR)
  ENDIF
  _MSGWIN_CLOSE()
  
  //シャガ：チェレンではないか
  IF $LCW_POSZ == 177 THEN
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_22 , C08_SWLEADER7_01 , POS_UL)
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_22 , C08_SWLEADER7_01 , POS_DL)
  ENDIF
  _MSGWIN_CLOSE()
  
  //プレイヤー・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //チェレン：（主人公名）！あっ　シャガさんも
  IF $LCW_POSZ == 177 THEN
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader1_02 , MMDL_ID_EVENTOBJ_00 , POS_DR)
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader1_02 , MMDL_ID_EVENTOBJ_00 , POS_UR)
  ENDIF
  _MSGWIN_CLOSE()
  
  //シャガ：そういってくれるか
  IF $LCW_POSZ == 177 THEN
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_23 , C08_SWLEADER7_01 , POS_UL)
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_23 , C08_SWLEADER7_01 , POS_DL)
  ENDIF
  _MSGWIN_CLOSE()
  
  //プレイヤー・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //チェレン：（主人公名）！きみのはんだんに
  IF $LCW_POSZ == 177 THEN
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader1_03 , MMDL_ID_EVENTOBJ_00 , POS_DR)
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader1_03 , MMDL_ID_EVENTOBJ_00 , POS_UR)
  ENDIF
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン退場
  IF $LCW_POSZ == 173 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 446, 174, FORCE_TYPE_ALL, 4, DIR_UD)
  
  ELSIF $LCW_POSZ == 177 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 446, 176, FORCE_TYPE_ALL, 4, DIR_UD)
    
  ELSE
    _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 446, LCW_POSZ, FORCE_TYPE_ALL, 4, DIR_UD)
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //イベント曲終了
  _END_EVENT_BGM()
  
  //チェレン動作OBJ削除
  _OBJ_DEL(MMDL_ID_EVENTOBJ_00)
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //プレイヤー・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //プレイヤー座標でふりむきを分岐
  IF $LCW_POSZ == 177 THEN
    _OBJ_ANIME( C08_SWLEADER7_01 , anm_staystep_d )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  ELSE
    _OBJ_ANIME( C08_SWLEADER7_01 , anm_staystep_u )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //シャガ：プラズマだん　から
  IF $LCW_POSZ == 177 THEN
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_24 , C08_SWLEADER7_01 , POS_UL)
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_24 , C08_SWLEADER7_01 , POS_DL)
  ENDIF
  _MSGWIN_CLOSE()
  
  //========================================//
  //C08：ダークトリニティ戦POS無効
  $WK_SCENE_C08_NINJA = 2
  //C08：ダークトリニティ非表示
  _FLAG_SET( FV_C08_NINJA_01 )
  //T04R0101：ストッパー無効
  $WK_SCENE_T04R101_STOPPER_01 = 1
  //T04R0101：ストッパー非表示
  _FLAG_SET( FV_T04R101_STOPPER_01 )
  _FLAG_RESET( FV_T04R101_STOPPER_02 )
  //C14 SCENE_CHANGE有効
  $WK_SCENE_C14_SWRIVAL_01 = 1
  //T04,R20 ローカルライブキャスターPOS起動
  $WK_SCENE_T04_D20_TVT = 1
  //========================================//
    
  //ハイリンク通信ブロック処理終了
  _ENABLE_NETWORK_IN_IMPORTANT_EVENT()
EVENT_END

