
//======================================================================
//                c08.ev
//
//    スクリプトファイル：c08用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c08.h"
  .include  "c08.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_bg_c08_board_01
_EVENT_DATA    ev_bg_c08_board_02
_EVENT_DATA    ev_bg_c08_board_03
_EVENT_DATA    ev_bg_c08_board_04
_EVENT_DATA    ev_bg_c08_board_05
_EVENT_DATA_END

/**************************************************************/
/* 町看板                                                       */
/**************************************************************/
EVENT_START   ev_bg_c08_board_01
	_EASY_BGWIN_MSG( msg_c08_sign1_01, TYPE_TOWN )
EVENT_END

/**************************************************************/
/* シャガの家施設看板                                          */
/**************************************************************/
EVENT_START   ev_bg_c08_board_02
	_EASY_BGWIN_MSG( msg_c08_sign2_01, TYPE_POST)
EVENT_END

/**************************************************************/
/* ローテーションバトル・トリプルバトル施設看板               */
/**************************************************************/
EVENT_START   ev_bg_c08_board_03

	//バージョンを取得して表示内容をを変化させる
	_GET_ROM_VERSION( SCWK_ANSWER )
	
	//BlackVERならトリプルバトル
	IF $SCWK_ANSWER == VERSION_B2 THEN
		_EASY_BGWIN_MSG( msg_c08_sign3_01b, TYPE_POST )
	
	//Whiteならローテーションバトル
	ELSE
		_EASY_BGWIN_MSG( msg_c08_sign3_01w, TYPE_POST )
	ENDIF

EVENT_END

/**************************************************************/
/* おとくなけいじばん                                         */
/**************************************************************/
EVENT_START   ev_bg_c08_board_04
	_EASY_BGWIN_MSG( msg_c08_sign4_01, TYPE_INFO )
EVENT_END

/**************************************************************/
/* ジム看板                                         */
/**************************************************************/
EVENT_START   ev_bg_c08_board_05
	//バージョンを取得して表示内容をを変化させる
	_GET_ROM_VERSION( SCWK_ANSWER )
	
	//BlackVERならトリプルバトル
	IF $SCWK_ANSWER == VERSION_B2 THEN
		_EASY_BGWIN_MSG( msg_c08_gymsign_01b, TYPE_POST )
	
	//Whiteならローテーションバトル
	ELSE
		_EASY_BGWIN_MSG( msg_c08_gymsign_01w, TYPE_POST )
	ENDIF
EVENT_END
