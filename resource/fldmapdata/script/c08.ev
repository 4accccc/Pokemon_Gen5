EVENT_END

/**************************************************************/
/* シャガの家施設看板                                          */
/**************************************************************/
EVENT_START   ev_bg_c08_board_02
	_EASY_BGWIN_MSG( msg_c08_sign2_01, TYPE_POST)
EVENT_END

/**************************************************************/
/* ローテーションバトル・トリプルバトル施設看板               */
/**************************************************************/
EVENT_START   ev_bg_c08_board_03

	//バージョンを取得して表示内容をを変化させる
	_GET_ROM_VERSION( SCWK_ANSWER )
	
	//BlackVERならトリプルバトル
	IF $SCWK_ANSWER == VERSION_B2 THEN
		_EASY_BGWIN_MSG( msg_c08_sign3_01b, TYPE_POST )
	
	//Whiteならローテーションバトル
	ELSE
		_EASY_BGWIN_MSG( msg_c08_sign3_01w, TYPE_POST )
	ENDIF

EVENT_END

/**************************************************************/
/* おとくなけいじばん                                         */
