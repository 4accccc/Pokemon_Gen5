//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
DEFINE_LOCAL  LCW_VERSION
//------------------------------注意--------------------------------//
//
//  LOCALWORK15をリンクイベントで使用。
//                                                                  //
//------------------------------------------------------------------//

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c08
  
  //プラズマ団イベント起動中接続を切る
  IF FLAG_ON( FE_C08_PLAZMA_COME ) THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C08_C08R0201_EXIT01, 0, 0, 0 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C08_C08R0301_EXIT01, 0, 0, 0 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C08_C08R0401_EXIT01, 0, 0, 0 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C08_C08R0801_EXIT01, 0, 0, 0 )
  ENDIF
  
  {
  //バージョンを取得してOBJを変化させる
  _GET_ROM_VERSION( SCWK_ANSWER )
  
  //BlackVERならキーボード
  IF $SCWK_ANSWER == VERSION_B2 THEN
    $OBJCHRWORK0 = KEYBOARD
  
  //Whiteならフィドル
  ELSE
    $OBJCHRWORK0 = FIDDLE
  ENDIF
  }
  {
  //データコンバートフラグチェック
  _DATACONV_GET_FLAG( DATACONV_FLAG_BADGE_08, LOCALWORK15 )
  
  //ゲームクリア状態でリンクイベント起動ならシャガを表示・POSを有効に
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) && $LOCALWORK15 == 1 && $WK_SYS_LINK_EVENT_04 == 0 THEN
    //========================================//
    //C08シャガ表示
    _FLAG_RESET( FV_C08_SWLEADER7_01 )
    //POS有効
    $WK_SCENE_C08_LINK_EVENT = 1
    //========================================//
  ENDIF
  }
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c08
{
  
  DEFINE_LOCAL LCWK_VERSION
	_GET_ROM_VERSION( LCWK_VERSION )
	
	//アイリスイベント起動前はNPCの位置を変更
  IF $WK_SCENE_C08_SWCHAMPION == 0 && $WK_SCENE_C08_SWPLAZMA < 1 THEN
    _DEBUG_PRINT_WK( 9 )
    _OBJ_POS_CHANGE( C08_OLDMAN1_02, 432, 0, 160, DIR_LEFT )
  ENDIF

  //シャガイベントごとに配置変更
  
  //誘導イベント起動（１）
  IF $WK_SCENE_C08_LEADER7 == 2  && $LCWK_VERSION == VERSION_W2 THEN
    _DEBUG_PRINT_WK( 0 )
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 418, -1, 167, DIR_DOWN )
  ELSIF $WK_SCENE_C08_LEADER7 == 2  && $LCWK_VERSION == VERSION_B2 THEN
    _DEBUG_PRINT_WK( 1 )
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 418, 0, 167, DIR_DOWN )
  //誘導イベント起動（２）ホワイトver
  ELSIF $WK_SCENE_C08_LEADER7 == 3 && $LCWK_VERSION == VERSION_W2 THEN
    _DEBUG_PRINT_WK( 2 )
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 418, -1, 162, DIR_DOWN )
  //誘導イベント起動（２）ブラックver
  ELSIF $WK_SCENE_C08_LEADER7 == 3 && $LCWK_VERSION == VERSION_B2 THEN
    _DEBUG_PRINT_WK( 3 )
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 418, 0, 162, DIR_DOWN )
  //プラズマ団襲来　ホワイトver
  ELSIF $WK_SCENE_C08_SWPLAZMA == 1 && $LCWK_VERSION == VERSION_W2 THEN
    _DEBUG_PRINT_WK( 4 )
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 419, 0, 162, DIR_DOWN )
   //プラズマ団襲来　ブラックver
  ELSIF $WK_SCENE_C08_SWPLAZMA == 1 && $LCWK_VERSION == VERSION_B2 THEN
    _DEBUG_PRINT_WK( 5 )
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 419, 0, 162, DIR_DOWN )
  //ヴィオ戦前
  ELSIF $WK_SCENE_C08_SWPLAZMA != 0 && $WK_SCENE_C08_SWPLAZMA < 6 THEN
    _DEBUG_PRINT_WK( 6 )
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 424, 0, 176, DIR_UP )
  //ダークトリニティイベント起動時（ダークトリニティはゴール地点に配置）
  ELSIF $WK_SCENE_C08_NINJA == 1 THEN
    _DEBUG_PRINT_WK( 7 )
    _OBJ_POS_CHANGE( C08_NINJA_01, 442, 0, 175, DIR_LEFT )
    //_MOVE_CODE_CHANGE( C08_SWLEADER7_01, MV_RND_H )
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 398, 0, 167, DIR_UP )
  //クリア前・プラズマ団イベント終了時
  ELSIF $WK_SCENE_C08_NINJA >= 2 && FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
    _DEBUG_PRINT_WK( 8 )
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 418, 0, 167, DIR_DOWN )
  ENDIF
  
  //データコンバートフラグチェック
  _DATACONV_GET_FLAG( DATACONV_FLAG_BADGE_08, LOCALWORK15 )
  
  //リンクイベント起動条件を満たしているならばシャガの配置を変更（ホワイト）
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) && $LOCALWORK15 == 1 && $WK_SCENE_C08_LINK_EVENT == 1 && $LCWK_VERSION == VERSION_W2 THEN
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 418, -1, 167, DIR_UP )
  //リンクイベント起動条件を満たしているならばシャガの配置を変更（ブラック）
  ELSIF FLAG_ON( SYS_FLAG_GAME_CLEAR )&& $LOCALWORK15 == 1 && $WK_SCENE_C08_LINK_EVENT == 1 && $LCWK_VERSION == VERSION_B2 THEN
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 418, 0, 167, DIR_UP )
  ENDIF
}
INIT_EVENT_END

/**************************************************************/
/* POS：街到着でアイリス解説                                   */
/**************************************************************/
EVENT_START   ev_pos_c08_swchampion_01
  //ハイリンク通信ブロック処理
  _DISABLE_NETWORK_IN_IMPORTANT_EVENT()
  
  //プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //アニメ：アイリス「！」振り向く
  _OBJ_ANIME( C08_SWCHAMPION_01,anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C08_SWCHAMPION_01,anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  $LCW_POSX -=2 
  //アニメ：アイリス隣接
  _OBJ_ANIME_AUTO( C08_SWCHAMPION_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //アイリス：やっほー！
  _BALLOONWIN_OBJMSG_POS( msg_c08_swchampion_01 , C08_SWCHAMPION_01 , POS_DEFAULT)
  
  //アイリス：ひょっとして
  _BALLOONWIN_OBJMSG_POS( msg_c08_swchampion_02 , C08_SWCHAMPION_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //アニメ：アイリス左を向く
  _OBJ_ANIME( C08_SWCHAMPION_01, anm_staystep_l)
  _OBJ_ANIME_WAIT()
  
  //アイリス：あっ！
  _BALLOONWIN_OBJMSG_POS( msg_c08_swchampion_03 , C08_SWCHAMPION_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //アニメ：アイリス主人公の方を向く
  _OBJ_ANIME( C08_SWCHAMPION_01, anm_staystep_r)
  _OBJ_ANIME_WAIT()
  
  //それにしても
  _BALLOONWIN_OBJMSG_MF( msg_c08_swchampion_04, msg_c08_swchampion_05, C08_SWCHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アイリス退場
  _OBJ_ANIME_AUTO( C08_SWCHAMPION_01, 426, LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  _OBJ_DEL( C08_SWCHAMPION_01 )
  
  //========================================//
  //C08：アイリスイベントPOS無効
  $WK_SCENE_C08_SWCHAMPION = 1
  //C08アイリス非表示
  _FLAG_SET( FV_C08_SWCHAMPION_01 )
  //C08到着フラグセット
  _FLAG_SET(SYS_FLAG_ARRIVE_C08)
  //========================================//
  
  //ハイリンク通信ブロック処理終了
  _ENABLE_NETWORK_IN_IMPORTANT_EVENT()
EVENT_END

/**************************************************************/
/* SCENE_CHANGE：シャガ誘導（１）                                   */
/**************************************************************/
EVENT_START   ev_scene_c08_guide_01
{
  //ハイリンク通信ブロック処理
  _DISABLE_NETWORK_IN_IMPORTANT_EVENT()

  //アニメ：主人公ジムから出る
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 405, 147, FORCE_TYPE_NOT, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()
  _CAMERA_MOVE( 9688,0,970752,26574848,0,9535488,24 )
  
  //========================================//
  //C08シャガ表示
  _FLAG_RESET( FV_C08_SWLEADER7_01 )
  //C08GYM0101シャガ非表示
  _FLAG_SET( FV_C08GYM0101_SWLEADER7_01 )
  //========================================//
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //シャガ動作OBJ表示
  _OBJ_ADD( C08_SWLEADER7_01 )
  
  //アニメ：シャガジムから出る
  _OBJ_ANIME_AUTO( C08_SWLEADER7_01, 405, 145, FORCE_TYPE_NOT, 8, DIR_LR)
  _TIME_WAIT(8)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //シャガ：いえまで
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_01 , C08_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //アニメ：シャガ自宅方面へ
  _OBJ_ANIME_AUTO( C08_SWLEADER7_01, 406, 154, FORCE_TYPE_ALL, 8, DIR_LR)
  _TIME_WAIT(24)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (24)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  DEFINE_LOCAL LCWK_VERSION
	_GET_ROM_VERSION( LCWK_VERSION )
  
  //OBJ配置変更
  IF $LCWK_VERSION == VERSION_W2 THEN
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 418, -1, 167, DIR_DOWN )
  ELSIF $LCWK_VERSION == VERSION_B2 THEN
    _OBJ_POS_CHANGE( C08_SWLEADER7_01, 418, 0, 167, DIR_DOWN )
  ENDIF
  
  //========================================//
  //C08：誘導イベントPOS起動（１）
  $WK_SCENE_C08_LEADER7 = 2
  //========================================//
  //ハイリンク通信ブロック処理終了
  _ENABLE_NETWORK_IN_IMPORTANT_EVENT()
}
EVENT_END

/**************************************************************/
/*  POS：シャガ誘導（２）                                   */
/**************************************************************/
EVENT_START   ev_pos_c08_guide_02
  
  //ハイリンク通信ブロック処理
  _DISABLE_NETWORK_IN_IMPORTANT_EVENT()
  
  //プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //シャガ：コチラだ
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_02 , C08_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //アニメ：シャガ退場
  _OBJ_ANIME_AUTO( C08_SWLEADER7_01, 418, 161, FORCE_TYPE_ALL, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C08_SWLEADER7_01,anm_dir_d )
  _OBJ_ANIME_WAIT()
  
  //========================================//
  //C08：誘導イベントPOS起動（２）
  $WK_SCENE_C08_LEADER7 = 3
  //C08R0101伝説解説SCENE_CHANGEイベント起動
  $WK_SCENE_C08R0101 = 1
  //C08R0101シャガ表示
  _FLAG_RESET( FV_C08R0101_SWLEADER7_01 )
  //C08シャガ非表示
  _FLAG_SET( FV_C08_SWLEADER7_01 )
  //========================================//
  //ハイリンク通信ブロック処理終了
  _ENABLE_NETWORK_IN_IMPORTANT_EVENT()
EVENT_END

/**************************************************************/
/*  POS：シャガ誘導（３）                                   */
/**************************************************************/
EVENT_START   ev_pos_c08_guide_03

  //ハイリンク通信ブロック処理
  _DISABLE_NETWORK_IN_IMPORTANT_EVENT()
  
  //シャガ：着いたぞ
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_03 , C08_SWLEADER7_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //アニメ：シャガドア手前へ移動
  _OBJ_ANIME_AUTO( C08_SWLEADER7_01, 418, 160, FORCE_TYPE_NOT, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ドア開ける
  DEFINE_LOCAL	DOOR_ANIME_ID
  _BMODEL_ANIME_CREATE( DOOR_ANIME_ID, SCR_BMID_DOOR, 418, 159 )
  _BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_OPEN )
  _BMODEL_ANIME_WAIT( DOOR_ANIME_ID )
  
  //アニメ：シャガ上に進む
  _OBJ_ANIME( C08_SWLEADER7_01,anm_walk_u )
  _OBJ_ANIME_WAIT()
	
  _OBJ_DEL( C08_SWLEADER7_01 )
  
  //ドア閉じる
  _BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_WAIT( DOOR_ANIME_ID )
  _BMODEL_ANIME_DELETE( DOOR_ANIME_ID )
  
  //========================================//
  //C08：誘導イベントPOS無効
  $WK_SCENE_C08_LEADER7 = 4
  //========================================//
  //ハイリンク通信ブロック処理終了
  _ENABLE_NETWORK_IN_IMPORTANT_EVENT()
EVENT_END

/**************************************************************/
/*  RESERVE：プラズマ団イベント開始（C08R0101から予約）       */
/**************************************************************/
EVENT_START   ev_reserve_c08_plazma_comming_01
  
  //シャガ：なんだ？
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_04 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //３Ｄデモコール
  _DEMO_FADEOUT_BLACK_CALL_SINGLE()
  
  {
    DEFINE_LOCAL LCWK_VERSION
    // ROMバージョン取得
    _GET_ROM_VERSION( LCWK_VERSION )
    //デモ再生処理
    IF $LCWK_VERSION == VERSION_B2 THEN
      _CALL_3D_DEMO( DEMO3D_ID_CITY_PLASMA_COME_B )
    ELSE
      _CALL_3D_DEMO( DEMO3D_ID_CITY_PLASMA_COME_W )
    ENDIF
  }
  
  //========================================//
  //プラズマ団襲来状態に変更
  _FLAG_SET( FE_C08_PLAZMA_COME )
  _FLAG_SET( SYS_FLAG_BGM_C08_PLAZMA )
  //C08プラズマ団表示
  _FLAG_RESET( FV_C08_SWPLAZMA_01 )
  _FLAG_RESET( FV_C08_SWSAGE7_01 )
  //C08ふつうの人非表示
  _FLAG_SET( FV_C08_PEOPLE_01 )
  //c08r0101ふつうの人一時非表示（クリア時復帰）
  _FLAG_SET( FV_C08R0102_FOOTBALLM_01 )
  //c08r0101オロオロしてる人一時表示
  _FLAG_RESET( FV_C08R0102_FOOTBALLM_02 )
  //C08マップ破壊状態に差し替え
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_01, TRUE, TRUE )
  //========================================//
  
  //予約スクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_C08_PLAZMA_COMMING_02 )
  //マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_C08, 418, 0, 162, DIR_DOWN )
  
EVENT_END


/**************************************************************/
/*  RESERVE：プラズマ団イベント開始（同一ゾーンで使用）       */
/**************************************************************/
EVENT_START   ev_reserve_c08_plazma_comming_02
  //ハイリンク通信ブロック処理
  _DISABLE_NETWORK_IN_IMPORTANT_EVENT()

  //暗転復帰
  _MAP_FADE_BLACK_IN()
  _DISP_FADE_END_CHECK()
  
  //シャガ：この　こおりの　せかいは…
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_04a , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //オノノクス動作OBJ表示
  _OBJ_ADD_EX( 419, 163, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE46, MV_DMY )
  
  //シャガ：ドラゴンテールだ
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_05 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //オノノクスの鳴き声を鳴らす
  _VOICE_PLAY(MONSNO_509,0)
  _BALLOONWIN_OBJMSG_POS( msg_c08_poke47_01 , MMDL_ID_EVENTOBJ_00 , POS_DR)
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //アニメ：オノノクス技を出した的な演出（移動＋カメラゆれ＋ドラゴンテール音再生）
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 419, 164, FORCE_TYPE_ALL, 8, DIR_UD)
  _TIME_WAIT(16)
  _SE_PLAY( SEQ_SE_W121_01 )
  _SHAKE_CAMERA(0,1,3,6,0,0,0,0)
  _OBJ_ANIME_WAIT()
  _SE_WAIT()
  
  //アニメ：オノノクス「？」
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  _TIME_WAIT(8)
  
  //アニメ：主人公「！」シャガ「？」
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_common_hatena )
  _OBJ_ANIME( C08_SWLEADER7_01,anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //シャガ：よくやった！
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_06 , C08_SWLEADER7_01 , POS_UR)
  
  //オノノクス動作OBJ非表示
  _OBJ_DEL(MMDL_ID_EVENTOBJ_00)
  
  //シャガ：それにしても
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_07 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //？？？：そうでしょうとも
  _PLAINWIN_MSG_DOWN( msg_c08_sage7_01 )
  _MSGWIN_CLOSE()
  
  //イベント曲再生
    _START_EVENT_BGM( SEQ_BGM_E_7_SAGE )
  
  //ヴィオ配置変更
  _OBJ_POS_CHANGE( C08_SWPLAZMAM_01, 419, 0, 169, DIR_UP )
  _OBJ_POS_CHANGE( C08_SWSAGE7_01, 419, 0, 170, DIR_UP )
  _OBJ_POS_CHANGE( C08_SWPLAZMAW_01, 419, 0, 171, DIR_UP )
  
  //アニメ：ヴィオ接近
  _OBJ_ANIME_AUTO( C08_SWPLAZMAM_01, 417, 164, FORCE_TYPE_ALL, 8, DIR_UD)
  _OBJ_ANIME_AUTO( C08_SWSAGE7_01, 418, 164, FORCE_TYPE_ALL, 8, DIR_UD)
  _OBJ_ANIME_AUTO( C08_SWPLAZMAW_01, 419, 164, FORCE_TYPE_ALL, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //アニメ：上を向く
  _OBJ_ANIME( C08_SWPLAZMAM_01, anm_staystep_u)
  _OBJ_ANIME( C08_SWSAGE7_01, anm_staystep_u)
  _OBJ_ANIME( C08_SWPLAZMAW_01, anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //シャガ：おまえは
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_08 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //アニメ：ヴィオ左右を見る
  _OBJ_ANIME( C08_SWSAGE7_01, anm_sage7_look_lr)
  _OBJ_ANIME_WAIT()
  
  //ヴィオ：それにしても
  _BALLOONWIN_OBJMSG_POS( msg_c08_sage7_02 , C08_SWSAGE7_01 , POS_DL)
  _MSGWIN_CLOSE()
  
  //ヴィオ：ようけんを
  _BALLOONWIN_OBJMSG_POS( msg_c08_sage7_03 , C08_SWSAGE7_01 , POS_DL)
  _MSGWIN_CLOSE()
  
  //シャガ：2年前
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_09 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //ヴィオ：想像通りの
  _BALLOONWIN_OBJMSG_POS( msg_c08_sage7_04 , C08_SWSAGE7_01 , POS_DL)
  _MSGWIN_CLOSE()
  
  //アニメ：ヴィオ1歩上へ
  _OBJ_ANIME( C08_SWSAGE7_01, anm_walk_d)
  _OBJ_ANIME_WAIT()
  
  //アニメ：ヴィオ退場
  _OBJ_ANIME_AUTO( C08_SWPLAZMAM_01, 419, 171, FORCE_TYPE_ALL, 8, DIR_UD)
  _OBJ_ANIME_AUTO( C08_SWSAGE7_01, 419, 172, FORCE_TYPE_ALL, 8, DIR_UD)
  _OBJ_ANIME_AUTO( C08_SWPLAZMAW_01, 419, 173, FORCE_TYPE_ALL, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //イベント曲終了
  _END_EVENT_BGM()
  
  //ヴィオ動作OBJ削除
  _OBJ_DEL( C08_SWSAGE7_01 )
  
  //シャガ：2年前
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_10 , C08_SWLEADER7_01 , POS_UR)
  
  //アニメ：主人公とシャガ向き合う
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_r )
  _OBJ_ANIME( C08_SWLEADER7_01,anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //プレイヤー名代入
  _PLAYER_NAME( 0 )
  
  //シャガ：（主人公名）！きみの
  _BALLOONWIN_OBJMSG_POS( msg_c08_swleader7_11 , C08_SWLEADER7_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //アニメ：シャガ退場
  _OBJ_ANIME_AUTO( C08_SWLEADER7_01, 420, 171, FORCE_TYPE_ALL, 8, DIR_UD)
  _TIME_WAIT( 16 )
  //アニメ：主人公見送り
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //シャガ配置変更
  _OBJ_POS_CHANGE( C08_SWLEADER7_01, 424, 0, 176, DIR_UP )
  //プラズマ団員配置変更
  _OBJ_POS_CHANGE( C08_SWPLAZMAM_01, 430, 0, 168, DIR_DOWN )
  _OBJ_POS_CHANGE( C08_SWPLAZMAW_01, 424, 0, 145, DIR_DOWN )
  
  //========================================//
  //C08プラズマ団襲来イベント進行
  $WK_SCENE_C08_SWPLAZMA = 2
  //C08ヴィオ非表示
  _FLAG_SET( FV_C08_SWSAGE7_01 )
  //========================================//
  
  //ハイリンク通信ブロック処理終了
  _ENABLE_NETWORK_IN_IMPORTANT_EVENT()
EVENT_END


