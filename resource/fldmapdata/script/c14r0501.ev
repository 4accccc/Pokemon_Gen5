  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

/*
★コジョフー座標
a=x:5,z:2
b=x:7,z:2
c=x:8,x:3
d=x:7,z:4
e=x:6,z:5
f=x:5,z:4
g=x:4,z:3
*/

/**************************************************************/
/*            POKE45                               */
/**************************************************************/
EVENT_START ev_c14r0501_poke45_01
  

  //連れ歩きしていない
  IF FLAG_OFF(SYS_FLAG_PAIR) && FLAG_OFF( TMFLG_C14R0501_POKEWALK ) THEN
    _EASY_TALK_POKEVOICE( MONSNO_630, msg_c14r0501_poke46_01 )
  
  //連れ歩き後達成
  ELSIF FLAG_ON(TMFLG_C14R0501_POKEWALK) && FLAG_ON( TMFLG_C14R0501_WALK_CLEAR ) THEN
    _EASY_TALK_POKEVOICE( MONSNO_630, msg_c14r0501_poke46_03 )
  
  //連れ歩き後未達成
  ELSIF FLAG_ON(TMFLG_C14R0501_POKEWALK) && FLAG_OFF( TMFLG_C14R0501_WALK_CLEAR ) THEN
    _EASY_TALK_POKEVOICE( MONSNO_630, msg_c14r0501_poke46_02 )
    
  //連れ歩き中
  ELSE

    _TALK_OBJ_START()
    
    //歩数をプリント（デバッグ用）
    _DEBUG_PRINT_WK( LOCALWORK14 )

    //プレイヤー名代入
    _PLAYER_NAME( 0 )
    //歩数取得
    _SC_WALK_COUNT_GET( LOCALWORK14 )
    
    _VOICE_PLAY( MONSNO_630, 0 )

    //歩数がレベル0
    IF $LOCALWORK14 <= 99 THEN
      _SYSWIN_MSG( msg_c14r0501_poke46_08 , POS_DOWN )
      _VOICE_WAIT()
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
    
    //歩数がレベル1
    ELSIF $LOCALWORK14 <= 199 THEN
      _SYSWIN_MSG( msg_c14r0501_poke46_07 , POS_DOWN )
      _VOICE_WAIT()
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
    //歩数がレベル2
    ELSIF $LOCALWORK14 <= 299 THEN
      _SYSWIN_MSG( msg_c14r0501_poke46_06 , POS_DOWN )
      _VOICE_WAIT()
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
    //歩数がレベル3
    ELSIF $LOCALWORK14 <= 364 THEN
      _SYSWIN_MSG( msg_c14r0501_poke46_05 , POS_DOWN )
      _VOICE_WAIT()
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
    //歩数がレベル5
    ELSE
      _SYSWIN_MSG( msg_c14r0501_poke46_04 , POS_DOWN )
      _VOICE_WAIT()
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
    ENDIF
  
  ENDIF
    
EVENT_END

/**************************************************************/
/*            BG：TV                               */
/**************************************************************/
EVENT_START ev_bg_c14r0501_tv_01
  
  _TALK_START_SE_PLAY()
  
  //散歩イベント起動していない
  IF FLAG_OFF(FH_15) THEN
    _SYSWIN_MSG( msg_c14r0501_tv_01 , POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  //散歩イベント起動中
  ELSE
    
    //ギザウィンSE再生
    _SE_PLAY( SEQ_SE_SYS_58 )
    
    //LADY：ちょっと　あなたー！
    _GIZAPLAINWIN_MSG_POS( msg_c14r0501_lady_10, POS_DOWN )
    _SE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
    
    //アニメ：LADY振り向き
    _OBJ_ANIME( C14R0501_LADY_01,anm_staystep_u )
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_d )
    _OBJ_ANIME_WAIT()
    
    _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_13,C14R0501_LADY_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：LADYもとの位置に
    _OBJ_ANIME( C14R0501_LADY_01,anm_staystep_d )
    _OBJ_ANIME_WAIT()
    
  ENDIF

EVENT_END

/**************************************************************/
/*            BG：ゴミ箱                               */
/**************************************************************/
EVENT_START ev_bg_c14r0501_trash_01
  
  _TALK_START_SE_PLAY()
  
  //散歩イベント起動していない
  IF FLAG_OFF(FH_15) THEN
    _SYSWIN_MSG( msg_c14r0501_trash_01 , POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  //散歩イベント起動中
  ELSE
    
    //ギザウィンSE再生
    _SE_PLAY( SEQ_SE_SYS_58 )
  
    //LADY：ちょっと　あなたー！
    _GIZAPLAINWIN_MSG_POS( msg_c14r0501_lady_10, POS_DOWN )
    _SE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
    
    //アニメ：LADY接近
    _OBJ_ANIME_AUTO( C14R0501_LADY_01, 7, 5, FORCE_TYPE_NPC, 4, DIR_UD)
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_l )
    _OBJ_ANIME_WAIT()
    
    _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_12,C14R0501_LADY_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：LADYもとの位置に
    _OBJ_ANIME_AUTO( C14R0501_LADY_01, 6, 3, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( C14R0501_LADY_01,anm_staystep_d )
    _OBJ_ANIME_WAIT()
    
  ENDIF
  
EVENT_END

/**************************************************************/
/*            POS：ポケモン散歩イベントSTOPPER                 */
/**************************************************************/
EVENT_START ev_pos_c14r0501_stopper_01
  
  //ギザウィンSE再生
  _SE_PLAY( SEQ_SE_SYS_58 )
  
  //LADY：ちょっと　あなたー！
  _GIZAPLAINWIN_MSG_POS( msg_c14r0501_lady_10, POS_DOWN )
  _SE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()
    
  //アニメ：LADY接近
  _OBJ_ANIME_AUTO( C14R0501_LADY_01, 5, 6, FORCE_TYPE_NPC, 4, DIR_UD)
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_11,C14R0501_LADY_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _PAIR_PLAYER_FOLLOW_ON()  //連れ歩き追随開始
  //アニメ：LADYもとの位置に・主人公戻る
  _OBJ_ANIME_AUTO( C14R0501_LADY_01, 6, 3, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C14R0501_LADY_01,anm_staystep_d )
  _OBJ_ANIME_WAIT()
  _PAIR_PLAYER_FOLLOW_OFF() //連れ歩き追随終了
  
EVENT_END



//--------------------------------------------------------------------
//	☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u
	_ANIME_DATA	AC_WALK_U_8F,1
