  .text

  .include  "scr_seq_def.h"
  .include  "msg_c14r0501.h"
  .include  "c14r0501.h"
  .include  "c14r0501_def.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c14r0501_lady_01
_EVENT_DATA    ev_c14r0501_poke45_01
_EVENT_DATA    ev_bg_c14r0501_tv_01
_EVENT_DATA    ev_bg_c14r0501_trash_01
_EVENT_DATA    ev_pos_c14r0501_stopper_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
DEFINE_LOCAL  LCW_POKE_POSX
DEFINE_LOCAL  LCW_POKE_POSZ

//------------------------！注意！------------------------------//
//																//
//		LOCALWORK14,LOCALWORK15をポケモン散歩イベント制御ワークに使用			//
//		FH_15をポケモン散歩イベント制御フラグにしよう			//
//		同一ゾーン内での使用を禁止します							//
//																//
//--------------------------------------------------------------//

/**************************************************************/
/*            LADY：コジョフー散歩イベント                               */
/**************************************************************/
EVENT_START ev_c14r0501_lady_01
  
  //散歩イベント発生中
  IF FLAG_ON( FH_15 ) THEN
    //歩数取得
    _SC_WALK_COUNT_GET( LOCALWORK14 )
    //歩数をプリント（デバッグ用）
    _DEBUG_PRINT_WK( LOCALWORK14 )
  ENDIF

  //今日既に散歩イベントを終えた
  IF FLAG_ON( TMFLG_C14R0501_POKEWALK ) THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14r0501_lady_09 )
    
  //今日まだイベントを終えていない（イベント未発生）
  ELSIF FLAG_OFF( TMFLG_C14R0501_POKEWALK ) && FLAG_OFF( FH_15 ) THEN
  
    _TALK_OBJ_START()
    
    //LADY：ちょっと！そこのあなた！
    _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_01,C14R0501_LADY_01, POS_DEFAULT )
    _YES_NO_WIN( SCWK_ANSWER )
    
    //はい
    IF $SCWK_ANSWER == SCR_YES THEN
      
      //歩数ワーク初期化
      $LOCALWORK14 = 0
      
      //LADY：話がわかる！
      _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_02,C14R0501_LADY_01, POS_DEFAULT )
      _MSGWIN_CLOSE()
      
      //進入方向によって演出を分岐
      _PLAYER_DIR_GET( LWK_DIR )
      
      SWITCH $LWK_DIR
      CASE DIR_UP THEN
        _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
        _OBJ_ANIME_AUTO( C14R0501_POKE45_01, 5, 4, FORCE_TYPE_NOT, 8, DIR_LR)
      CASE DIR_DOWN THEN
        _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
        _OBJ_ANIME_AUTO( C14R0501_POKE45_01, 5, 2, FORCE_TYPE_NOT, 8, DIR_LR)
      CASE DIR_LEFT THEN
        _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
        _OBJ_ANIME_AUTO( C14R0501_POKE45_01, 7, 2, FORCE_TYPE_NOT, 8, DIR_LR)
      ENDSWITCH
      _OBJ_ANIME_WAIT()
      
      //連れ歩き開始
      _PAIR_TRAINER_SET( C14R0501_POKE45_01, PAIR_ID_C14R0501_POKE45, PAIR_TYPE_ONE_ZONE, 0, SCRID_C14R0501_POKE45_01 )
      
      //歩数カウント開始
      _SC_WALK_COUNT_START()
    
      //========================================//
      //POSイベント有効
      $LOCALWORK15 = 1
      //LOCALFLAGをイベント起動状態に変更
      _FLAG_SET( FH_15 )
      //========================================//
    ELSE
      
      //LADY：あらヤダ！
      _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_03,C14R0501_LADY_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
    
    ENDIF
  
  //今日までイベントを終えていない（イベント発生中・条件未達成） 
  ELSIF $LOCALWORK14 < 365 && FLAG_ON( FH_15 ) THEN
    _TALK_OBJ_START()
    
    DEFINE_LOCAL  LWK_WALK_ANSWER
    
    //LADY：まだまだ…とちゅうでやめますの？
    _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_06,C14R0501_LADY_01, POS_DL )
    _BMPMENU_INIT_RIGHT( MENU_X2, MENU_Y2, 0, 1, LWK_WALK_ANSWER  )
    
    _BMPMENU_MAKE_LIST( msg_c14r0501_select_01, 0 ) //つづける
    _BMPMENU_MAKE_LIST( msg_c14r0501_select_02, 1 ) //やめる
    _BMPMENU_START()
    
    //いいえ
    IF $LWK_WALK_ANSWER == 1 THEN
      
       //LADY：またきがむいたら
      _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_09,C14R0501_LADY_01, POS_DEFAULT )
      _MSGWIN_CLOSE()
      
      //連れ歩き解除
      _PAIR_TRAINER_FREE( SCRID_C14R0501_POKE45_01, MV_DMY )
      
      //アニメ：コジョフー戻り処理
      _CALL ev_poke45_ret
      
      //歩数カウント終了
      _SC_WALK_COUNT_STOP()
    
      //========================================//
      //POSイベント無効
      $LOCALWORK15 = 0
      //今日のお散歩終了フラグをセット
      _FLAG_SET( TMFLG_C14R0501_POKEWALK )
      //LOCALFLAGをイベント起動してない状態に変更
      _FLAG_RESET( FH_15 )
      //========================================//
      
    //つづける・キャンセル
    ELSE
        _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_07,C14R0501_LADY_01, POS_DEFAULT )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
    ENDIF
  
  //今日までイベントを終えていない（イベント発生中・条件達成） 
  ELSE
    
   //LADY：たくましくみえますわ
   _TALK_OBJ_START()
   _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_04,C14R0501_LADY_01, POS_DEFAULT )
   _MSGWIN_CLOSE()
   
    //アイテム入手処理：しんじゅ
    _ITEM_EVENT_KEYWAIT( ITEM_SINZYU, 1 )
    
    //連れ歩き解除
    _PAIR_TRAINER_FREE( SCRID_C14R0501_POKE45_01, MV_DMY )
    
    //アニメ：コジョフー戻り処理
    _CALL ev_poke45_ret
    
    //LADY：またわたくしの
    _BALLOONWIN_OBJMSG_POS( msg_c14r0501_lady_05,C14R0501_LADY_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //歩数カウント終了
    _SC_WALK_COUNT_STOP()
    
    //========================================//
    //POSイベント無効
    $LOCALWORK15 = 0
    //今日のお散歩終了フラグをセット
    _FLAG_SET( TMFLG_C14R0501_POKEWALK )
    //お散歩クリア状態にセット
    _FLAG_SET( TMFLG_C14R0501_WALK_CLEAR )
    //LOCALFLAGをイベント起動してない状態に変更
    _FLAG_RESET( FH_15 )
    //========================================//
  
  ENDIF

EVENT_END

/**************************************************************/
/*            LADY：コジョフー散歩イベント                               */
/**************************************************************/
ev_poke45_ret:

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
    _PLAYER_DIR_GET( LWK_DIR )
    //コジョフー座標取得
    _OBJ_POS_GET( C14R0501_POKE45_01,LCW_POKE_POSX,LCW_POKE_POSZ ) 
    
    //アニメ：コジョフー復帰
    
    //A && a
    IF $LWK_DIR == DIR_DOWN && $LCW_POKE_POSX == 5  && $LCW_POKE_POSZ == 2 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_a_a )
    
    //A && b
    ELSIF $LWK_DIR == DIR_DOWN && $LCW_POKE_POSX == 7  && $LCW_POKE_POSZ == 2 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_a_b )
    
    //B && b
    ELSIF $LWK_DIR == DIR_LEFT && $LCW_POKE_POSX == 7  && $LCW_POKE_POSZ == 2 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_b_b )
    
    //B && c
    ELSIF $LWK_DIR == DIR_LEFT && $LCW_POKE_POSX == 8  && $LCW_POKE_POSZ == 3 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_b_c )
    
    //B && d
    ELSIF $LWK_DIR == DIR_LEFT && $LCW_POKE_POSX == 7  && $LCW_POKE_POSZ == 4 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_b_d )
    
    //C && d
    ELSIF $LWK_DIR == DIR_UP && $LCW_POKE_POSX == 7  && $LCW_POKE_POSZ == 4 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_c_d )
    
    //C && e
    ELSIF $LWK_DIR == DIR_UP && $LCW_POKE_POSX == 6  && $LCW_POKE_POSZ == 5 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_c_e )
    
    //C && f
    ELSIF $LWK_DIR == DIR_UP && $LCW_POKE_POSX == 5  && $LCW_POKE_POSZ == 4 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_c_f )
    
    //D && f
    ELSIF $LWK_DIR == DIR_RIGHT && $LCW_POKE_POSX == 5  && $LCW_POKE_POSZ == 4 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_d_f )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_d_f )
    
    //D && g
    ELSIF $LWK_DIR == DIR_RIGHT && $LCW_POKE_POSX == 4  && $LCW_POKE_POSZ == 3 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_d_g )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_d_g )
    
    //D && a
    ELSIF $LWK_DIR == DIR_RIGHT && $LCW_POKE_POSX == 5  && $LCW_POKE_POSZ == 2 THEN
      _OBJ_ANIME( C14R0501_POKE45_01, anm_poke_ret_d_a )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_d_g )
    
    ELSE
      _OBJ_ANIME_AUTO( C14R0501_POKE45_01, 5, 3, FORCE_TYPE_NPC, 8, DIR_LR)
    ENDIF
    
    _OBJ_ANIME_WAIT()

_RET

//--------------------------------------------------------------------
//	主人公：コジョフーポイントからどく
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_avoid_down
  _ANIME_DATA	AC_DIR_U,1
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_avoid_up
  _ANIME_DATA	AC_DIR_U,1
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_d_f
  _ANIME_DATA	AC_WALK_L_8F,1
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	AC_WALK_R_8F,2
  _ANIME_DATA	AC_STAY_WALK_U_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_d_g
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA	AC_STAY_WALK_U_8F,1
