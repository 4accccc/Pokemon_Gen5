  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_poke_ret_a_b
  _ANIME_DATA	AC_WALK_D_8F,2
  _ANIME_DATA	AC_WALK_L_8F,2
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_poke_ret_b_b
  _ANIME_DATA	AC_WALK_L_8F,2
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_poke_ret_b_c
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	AC_WALK_L_8F,3
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_poke_ret_b_d
  _ANIME_DATA	AC_WALK_L_8F,2
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_poke_ret_c_d
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	AC_WALK_L_8F,2
  _ANIME_DATA	AC_WALK_U_8F,2
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_poke_ret_c_e
  _ANIME_DATA	AC_WALK_L_8F,1
  _ANIME_DATA	AC_WALK_U_8F,2
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_poke_ret_c_f
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_poke_ret_d_f
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_poke_ret_d_g
