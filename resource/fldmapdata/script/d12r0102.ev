
//======================================================================
//                d12r0102.ev
//
//    スクリプトファイル：d12r0102用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d12r0102.h"
  .include  "d12r0102.h"
  //@author suginaka_katsunori//ビクティニイベント

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_d12r0102
_EVENT_DATA    ev_init_d12r0102
_EVENT_DATA    ev_scene_d12r0102
_EVENT_DATA		ev_pos_d12r0102_01
_EVENT_DATA_END

DEFINE_LOCAL	LWK_PARTY_NUM
DEFINE_LOCAL	LWK_RET_MONSNO
DEFINE_LOCAL	LWK_COUNT_NUM

//LOCALWORK10使用　0＝イベント起動なし　1＝ビクティニＰＯＳイベント起動

/************************************************************/
/*		ゾーンチェンジ                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d12r0102

//手持ちのポケモンの数を確認（タマゴのポケモンは除外）
//タマゴ除外処理をTOTALに変更（2012.02.28　水口）
_GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_TOTAL )

//手持ちのポケモンの中にビクティニがいるか確認（繰り返し処理）
WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

	//指定POSのポケモンのNOを取得
	_GET_PARTY_POKE_MONSNO( LWK_RET_MONSNO, LWK_COUNT_NUM )

	//ビクティニがいるかチェックする
	IF $LWK_RET_MONSNO == 494 THEN
		$LOCALWORK10 = 1
	ENDIF

	_DEBUG_PRINT_WK(LWK_RET_MONSNO)

	//カウント
	$LWK_COUNT_NUM += 1

ENDWHILE

INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL						*/
/************************************************************/
INIT_EVENT_START	ev_init_d12r0102

INIT_EVENT_END

/************************************************************/
/*		シーンチェンジ                            */
/************************************************************/
EVENT_START   ev_scene_d12r0102

EVENT_END

/**************************************************************/
/*		ビクティニＰＯＳイベント							  */
/**************************************************************/
EVENT_START		ev_pos_d12r0102_01

//ボールの　なかの
_PLAINWIN_MSG_UP( msg_d12r0102_poke14_01 )

//はい・いいえ分岐
_YES_NO_WIN( SCWK_ANSWER )

//はいの場合
IF $SCWK_ANSWER == SCR_YES THEN
	
	_MSGWIN_CLOSE()
	
	//プレイヤー移動
	_OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 4, 7, FORCE_TYPE_NOT, 8, DIR_UD )
	_OBJ_ANIME_WAIT()

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_d )
	_OBJ_ANIME_WAIT()

	//ビクティニ登場
	_OBJ_ADD_EX( 4,8,DIR_DOWN,MMDL_ID_EVENTOBJ_00,POKE14,MV_DMY )
	
	//きゅきゅわわーん
	_VOICE_PLAY( MONSNO_657, 0 )
	_BALLOONWIN_OBJMSG_POS( msg_d12r0102_poke14_02 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_VOICE_WAIT()
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()

	_OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 4, 4, FORCE_TYPE_NOT, 8, DIR_LR )
	_TIME_WAIT( 20 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_u )
	
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
	
	//カメラ操作　部屋中央に移動
	_CAMERA_MOVE( 9688,0,970752,294912,0,294912,30 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()
	
	_OBJ_ANIME_WAIT()

	//ビクティニ・部屋見渡す
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_biku_01 )
	_OBJ_ANIME_WAIT()
	
	//ビクティニ・ベッドに移動
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_biku_02 )
	_OBJ_ANIME_WAIT()
	
	_VOICE_PLAY( MONSNO_657, 0 )
	_VOICE_WAIT()
	
	//ビクティニ・トイボックスに移動
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_biku_03 )
	_OBJ_ANIME_WAIT()
	
	//ビクティニ・クッションに移動
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_biku_04 )
	_OBJ_ANIME_WAIT()

	//きゅきゅわわーん
	_VOICE_PLAY( MONSNO_657, 0 )
	_BALLOONWIN_OBJMSG_POS( msg_d12r0102_poke14_02 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_AB_KEYWAIT_MARK()
	_VOICE_WAIT()
	_MSGWIN_CLOSE()
	
	//プレイヤーの前へ戻る
	_OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 4, 6, FORCE_TYPE_NOT, 8, DIR_UD )
	_OBJ_ANIME_WAIT()

	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_jump_d )
	_OBJ_ANIME_WAIT()
	
	_VOICE_PLAY( MONSNO_657, 0 )
	_VOICE_WAIT()

	_OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
	
	_PLAINWIN_MSG_UP( msg_d12r0102_poke14_03 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
	//自機にカメラを戻す
	_CAMERA_RECV_MOVE( 20 )	//_CAMERA_START()を使った時の座標に戻します。引数は移動にかかるフレーム数です
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	_CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
	_CAMERA_END()		//カメラ操作終了

	//========================================/
	$LOCALWORK10 = 0
	//========================================/

//いいえの場合
ELSE

_PLAINWIN_MSG_UP( msg_d12r0102_poke14_04 )
_LAST_KEYWAIT()
_MSGWIN_CLOSE()

//========================================/
$LOCALWORK10 = 0
//========================================/

ENDIF

EVENT_END

