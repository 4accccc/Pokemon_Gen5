
//======================================================================
//                r04r0101.ev
//
//    スクリプトファイル：r04r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_r04r0101.h"
  .include  "r04r0101.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_r04r0101_trainerw_01
_EVENT_DATA   ev_r04r0101_trainerm_01
_EVENT_DATA_END

//ポケモンチェック変数一覧
DEFINE_LOCAL LWK_RND            //乱数
DEFINE_LOCAL LWK_WHILE_CLEAR    //繰り返し処理完了

DEFINE_LOCAL LWK_PARTY_NUM      //手持ちポケモンの数
DEFINE_LOCAL LWK_COUNT_NUM      //WHILE文のカウンタ
DEFINE_LOCAL LWK_POKE_AGI       //ポケモンのすばやさ
DEFINE_LOCAL LWK_POKE_AGI_HIGH  //お題の値以上の「すばやさ」のポケモン
DEFINE_LOCAL LWK_POKE_AGI_GOOD  //お題の値と同じ「すばやさ」のポケモン
DEFINE_LOCAL LWK_EGG_CHK        //タマゴであるか
DEFINE_LOCAL LWK_HP             //HP（瀕死であるかに使用）


/**************************************************************/
/*  エリート♀：話しかけ（１日１回すばやさチェッカー）        */
/**************************************************************/
EVENT_START   ev_r04r0101_trainerw_01

  _TALK_OBJ_START()

  //今日のすばやさチェックは終了したか
  IF FLAG_OFF( TMFLG_R04_PARA_CLEAR_01 ) THEN

    //今日の数値は保存したか
    IF FLAG_OFF( TMFLG_R04_PARA_CHECK_01 ) THEN

      //今日のお題となる数字を抽出（繰り返し処理）
      WHILE $LWK_WHILE_CLEAR == 0 

        //乱数取得
        _GET_RND( LWK_RND, 201 )

        //乱数は50以上か
        IF $LWK_RND >= 50 THEN
          //50以上の場合、今日のお題として保存（値セット）
          $WK_OTHER_R04_PARA_CHECK_01 = $LWK_RND
          //条件が確定した（値セット）
          $LWK_WHILE_CLEAR = 1

        ENDIF

      ENDWHILE

      //========================================//
      //フラグON（１日１回／値を固定する）
      _FLAG_SET( TMFLG_R04_PARA_CHECK_01 )
      //========================================//

    ENDIF

    //エリート♀：あたしね　ポケモンの
    _BALLOONWIN_TALKOBJ_MSG( msg_r04r0101_trainerw_01 )
    _AB_KEYWAIT_MARK()

    //数値を指定タグにセット
    _NUMBER( 1, WK_OTHER_R04_PARA_CHECK_01, 3 )
    //エリート♀：《数値》より　すばやい
    _BALLOONWIN_TALKOBJ_MSG( msg_r04r0101_trainerw_02 )
    _AB_KEYWAIT_MARK()

    //手持ちのポケモンの数を確認（全てのポケモン）
    _GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_TOTAL )

    //手持ちのポケモンの中に条件『お題の値と同じすばやさ』を満たしたポケモンがいるか確認（繰り返し処理）
    WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

      //条件を満たしたポケモンは見つかったか
      IF $LWK_POKE_AGI_GOOD == 0 THEN

        //指定POSのポケモンの「すばやさ」を取得
        _GET_PARTY_POKE_PARAM( LWK_POKE_AGI, LWK_COUNT_NUM, SCR_POKEPARA_AGI )

        //指定POSのポケモンはタマゴか
        _CHECK_TEMOTI_EGG( LWK_EGG_CHK, LWK_COUNT_NUM )

        // 指定POSのポケモンのHP
        _GET_PARTY_POKE_PARAM( LWK_HP, LWK_COUNT_NUM ,SCR_POKEPARA_HP )

        //指定POSのポケモンの「すばやさ」はお題と同じ数値か
        IF $LWK_POKE_AGI == $WK_OTHER_R04_PARA_CHECK_01 && $LWK_EGG_CHK == FALSE && $LWK_HP > 0 THEN

          //条件を満たしたポケモンの名前取得
          _TEMOTI_MONS_NAME( 0, LWK_COUNT_NUM )
          //指定された数値そのものだった（値セット）
          $LWK_POKE_AGI_GOOD = 1

        ENDIF

      ENDIF

      //カウント
      $LWK_COUNT_NUM += 1

    ENDWHILE

    //条件を満たしたポケモン『お題の値と同じすばやさ』は見つかったか
    IF $LWK_POKE_AGI_GOOD == 0 THEN

      //数値リセット
      $LWK_COUNT_NUM = 0

      //手持ちのポケモンの中に条件『お題の値以上のすばやさ』を満たしたポケモンがいるか確認（繰り返し処理）
      WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

        //条件を満たしたポケモンは見つかったか
        IF $LWK_POKE_AGI_HIGH == 0 THEN

          //指定POSのポケモンの「すばやさ」を取得
          _GET_PARTY_POKE_PARAM( LWK_POKE_AGI, LWK_COUNT_NUM, SCR_POKEPARA_AGI )

          //指定POSのポケモンはタマゴか
          _CHECK_TEMOTI_EGG( LWK_EGG_CHK, LWK_COUNT_NUM )

          // 指定POSのポケモンのHP
          _GET_PARTY_POKE_PARAM( LWK_HP, LWK_COUNT_NUM ,SCR_POKEPARA_HP )

          //指定POSのポケモンの「すばやさ」はお題より大きいか
          IF $LWK_POKE_AGI >= $WK_OTHER_R04_PARA_CHECK_01 && $LWK_EGG_CHK == FALSE && $LWK_HP > 0 THEN

            //条件を満たしたポケモンの名前取得
            _TEMOTI_MONS_NAME( 0, LWK_COUNT_NUM )
            //条件を満たしたポケモンがいた（値セット）
            $LWK_POKE_AGI_HIGH = 1

          ENDIF

        ENDIF

        //カウント
        $LWK_COUNT_NUM += 1

      ENDWHILE

    ENDIF

    //手持ちに条件を満たしたポケモンがいた（お題の値と同じ）
    IF $LWK_POKE_AGI_GOOD == 1 THEN

      //エリート♀：あなたの　《ポケモン》！　まさに
      _BALLOONWIN_TALKOBJ_MSG( msg_r04r0101_trainerw_04 )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      //アイテム（たいりょくのハネ×５）入手
      _ITEM_EVENT_KEYWAIT( ITEM_TAIRYOKUNOHANE, 5 )
      
      //エリート♀：いろんなすばやさ
      _BALLOONWIN_TALKOBJ_MSG( msg_r04r0101_trainerw_05 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //========================================//
      //アイテム入手フラグON（１日１回）
      _FLAG_SET( TMFLG_R04_PARA_CLEAR_01 )
      //========================================//

    //手持ちに条件を満たしたポケモンがいた（お題の値より高い）
    ELSIF $LWK_POKE_AGI_HIGH == 1 THEN

      //エリート♀：あなたの　《ポケモン》！
      _BALLOONWIN_TALKOBJ_MSG( msg_r04r0101_trainerw_03 )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      //アイテム（たいりょくのハネ×１）入手
      _ITEM_EVENT_KEYWAIT( ITEM_TAIRYOKUNOHANE, 1 )
      
      //エリート♀：いろんなすばやさ
      _BALLOONWIN_TALKOBJ_MSG( msg_r04r0101_trainerw_05 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //========================================//
      //アイテム入手フラグON（１日１回）
      _FLAG_SET( TMFLG_R04_PARA_CLEAR_01 )
      //========================================//

    ELSE
      
      _MSGWIN_CLOSE()
    
      //アニメ：「…」
      _OBJ_ANIME( R04R0101_TRAINERW_01 , anm_common_tenten )
      _OBJ_ANIME_WAIT()

      //エリート♀：いいのよ！　ポケモンの　よさは
      _BALLOONWIN_TALKOBJ_MSG( msg_r04r0101_trainerw_06 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //イベント終了（日付が変わるまで繰り返し）
  ELSE

    //エリート♀：いろんな　すばやさの
    _BALLOONWIN_TALKOBJ_MSG( msg_r04r0101_trainerw_05 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END


/**************************************************************/
/*  エリート♂：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_r04r0101_trainerm_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r04r0101_trainerm_01 )
EVENT_END

//--------------------------------------------------------------
//	共通アニメ：「…」
//--------------------------------------------------------------
_ANIME_LABEL	anm_common_tenten
  _ANIME_DATA	AC_MARK_TENTEN,1
	_ANIME_DATA	ACMD_END,0
