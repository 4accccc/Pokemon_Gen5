/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_d29r0101:
//  _END

/**************************************************************/
/*		ネジ山ストッパー									  */
/**************************************************************/
EVENT_START		ev_d29r0101_stop1_01

DEFINE_LOCAL	LWK_CHKWAZA

	_TALK_OBJ_START()
	
	_BALLOONWIN_TALKOBJ_MSG( msg_d29r0101_stop1_02 )
	_AB_KEYWAIT_MARK()
	
	_CHECK_POKE_WAZA_GROUP( LWK_CHKWAZA, WAZANO_IWAKUDAKI )
	
	//いわくだきもってない
	IF $LWK_CHKWAZA == 6 THEN
	
		_BALLOONWIN_TALKOBJ_MSG( msg_d29r0101_stop1_05 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	
	//いわくだきもってる
	ELSE
		_MSGWIN_CLOSE()
		
		_OBJ_ANIME( D29R0101_STOP1_01, anm_common_gyoe )
		_OBJ_ANIME_WAIT()
		
		_BALLOONWIN_TALKOBJ_MSG( msg_d29r0101_stop1_03 )
		_MSGWIN_CLOSE()
	
		_OBJ_ANIME( D29R0101_STOP1_01, anm_break )
		_TIME_WAIT( 5 )
		_OBJ_ANIME( D29R0101_STOP2_01, anm_break )
		_OBJ_ANIME( D29R0101_STOP3_01, anm_break )
		_TIME_WAIT( 10 )
		//暗転・岩OBJ削除
		_BLACK_OUT()
		_DISP_FADE_END_CHECK()
		_OBJ_ANIME_WAIT()
		
		_OBJ_DEL( D29R0101_SPROCK_01 )
		_OBJ_DEL( D29R0101_SPROCK_02 )
		_OBJ_DEL( D29R0101_SPROCK_03 )
		_OBJ_DEL( D29R0101_SPROCK_04 )
		_OBJ_DEL( D29R0101_SPROCK_05 )
		_OBJ_DEL( D29R0101_SPROCK_06 )
		_OBJ_DEL( D29R0101_SPROCK_07 )
		_OBJ_DEL( D29R0101_SPROCK_08 )
		_OBJ_DEL( D29R0101_SPROCK_09 )
		_OBJ_DEL( D29R0101_SPROCK_10 )

		_TIME_WAIT( 60 )
	
		//暗転復帰
		_BLACK_IN()
		_DISP_FADE_END_CHECK()
	
		_OBJ_ANIME( D29R0101_STOP1_01, anm_jump_l )
		_TIME_WAIT( 5 )
		_OBJ_ANIME( D29R0101_STOP2_01, anm_jump_l )
		_TIME_WAIT( 5 )
		_OBJ_ANIME( D29R0101_STOP3_01, anm_jump_l )
		_OBJ_ANIME_WAIT()
		
		//ばんざ－い！
		_BALLOONWIN_TALKOBJ_MSG_POS( msg_d29r0101_stop1_04,POS_UP )
		_MSGWIN_CLOSE()
		
		_PLAYER_DIR_GET(SCWK_ANSWER)
		
		SWITCH $SCWK_ANSWER
		CASE DIR_LEFT THEN
			_OBJ_ANIME( D29R0101_STOP1_01, anm_stop1_leave_01 )
			_TIME_WAIT( 12 )
			_OBJ_ANIME( D29R0101_STOP3_01, anm_stop3_leave_01 )
			_OBJ_ANIME( D29R0101_STOP2_01, anm_stop2_leave_01 )
		CASE DIR_UP THEN
			_OBJ_ANIME( D29R0101_STOP1_01, anm_stop1_leave_02 )
			_OBJ_ANIME( D29R0101_STOP3_01, anm_stop3_leave_02 )
			_TIME_WAIT( 12 )
			_OBJ_ANIME( D29R0101_STOP2_01, anm_stop2_leave_02 )
		CASE DIR_DOWN THEN
			_OBJ_ANIME( D29R0101_STOP1_01, anm_stop1_leave_01 )
			_TIME_WAIT( 12 )
			_OBJ_ANIME( D29R0101_STOP3_01, anm_stop3_leave_01 )
			_OBJ_ANIME( D29R0101_STOP2_01, anm_stop2_leave_01 )
		ENDSWITCH
		_OBJ_ANIME_WAIT()

		//作業員OBJ削除
		_OBJ_DEL( D29R0101_STOP1_01 )
		_OBJ_DEL( D29R0101_STOP2_01 )
		_OBJ_DEL( D29R0101_STOP3_01 )
		
		//バニシュフラグセット
		//========================================/
		
		_FLAG_SET(FV_D29R0101_STOP)
		
		//========================================/
		

	ENDIF

EVENT_END

//--------------------------------------------------------------------
//		☆ネジ山ストッパー用アニメラベル
//--------------------------------------------------------------------
_ANIME_LABEL	anm_jump_l
	_ANIME_DATA	AC_STAY_JUMP_L_8F,2
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_break
	_ANIME_DATA	AC_STAY_JUMP_L_8F,1
	_ANIME_DATA	AC_STAY_WALK_L_2F,20
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stop1_leave_01
	_ANIME_DATA	AC_WALK_D_8F,10
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stop2_leave_01
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_D_8F,10
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stop3_leave_01
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_D_8F,10
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stop1_leave_02
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_D_8F,10
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stop2_leave_02
	_ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	AC_WALK_D_8F,10
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stop3_leave_02
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	AC_WALK_D_8F,10
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0


/**************************************************************/
/*		ネジ山ストッパー	一言メッセージのみ				  */
/**************************************************************/
EVENT_START		ev_d29r0101_stop2_01
_TALK_START_TURN_NOT()
	_BALLOONWIN_TALKOBJ_MSG( msg_d29r0101_stop2_01 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
EVENT_END

/**************************************************************/
/*		ネジ山ストッパー	一言メッセージのみ				  */
/**************************************************************/
EVENT_START		ev_d29r0101_stop3_01
_TALK_START_TURN_NOT()
	_BALLOONWIN_TALKOBJ_MSG( msg_d29r0101_stop2_01 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
EVENT_END

/**************************************************************/
/*		トロッコ乗り場のおっさん１号						  */
/**************************************************************/
EVENT_START		ev_d29r0101_d29r0201_workman2_01

	_TALK_OBJ_START()
	
	//この　トロッコに　のるかい
	_BALLOONWIN_TALKOBJ_MSG( msg_d29r0101_workman2_01 )

	//はい・いいえ分岐
	_YES_NO_WIN( SCWK_ANSWER )
	
	//はいの場合
	IF $SCWK_ANSWER == SCR_YES THEN
	
		_BALLOONWIN_TALKOBJ_MSG( msg_d29r0101_workman2_02 )
		_MSGWIN_CLOSE()
		
		//暗転処理
		_MAP_FADE_BLACK_OUT_SLOW()
		_OBJ_ANIME( D29R0101_WORKMAN2_01, anm_stay_r )
		_MAP_FADE_END_CHECK()
		_OBJ_ANIME_WAIT()
		
		//ガタゴトSE再生
		_SE_PLAY(SEQ_SE_SW_YACONROAD_01)
		_SE_WAIT()
		
		//フラグセット
		//========================================/
		
		_FLAG_SET(FV_D29R0101_WORKMAN2_01)
		_FLAG_RESET(FV_D29R0201_WORKMAN2_01)
		
		//========================================/

		//予約スクリプト
		_RESERVE_SCRIPT( SCRID_RESERVE_D29R0201_RECOVER )

		//マップチェンジ
		_MAP_CHANGE_NO_FADE( ZONE_ID_D29R0201, 27, 0, 14, DIR_LEFT )
	
	//いいえの場合
	ELSE
	
		_BALLOONWIN_TALKOBJ_MSG( msg_d29r0101_workman2_03 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	
	ENDIF

EVENT_END

