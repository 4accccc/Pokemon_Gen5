//=============================================================================
/**
 *    ファンの処理
 *    
 *    @param  [in]msg_greeting    挨拶メッセージ 
 *    @param  [in]fan_no          ファン番号
 */
//=============================================================================
fan:
{
  _TALK_OBJ_START()

  _PLAYER_NAME( 0 )

  // 挨拶メッセージ
  _BALLOONWIN_OBJMSG_POS( msg_greeting, SCWK_TARGET_OBJID, POS_DOWN )
  _AB_KEYWAIT_MARK()

  // ごほうびアイテムチェック
  _PKWD_GET_BONUS_ITEM( LOCALWORK2, fan_no, bonus_item_no, bonus_item_num )

  // 以下の条件でごほうびアイテムをもらえる
  // 1.ごほうびをもらっていない
  // 2.ごほうびアイテムが設定されている
  // 3.初めて上映する
  IF $bonus_localwork == 0 && $bonus_item_no != 0 && $LOCALWORK3 == 1 THEN
    // ご褒美アイテム
    _CALL bonus_item
  ELSE
    // 通常メッセージ
    _CALL normal_msg
  ENDIF

  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
}
_RET

//=============================================================================
/**
 *    通常メッセージ
 *    エンディングによってメッセージ分岐する
 *    
 *    @param  [in]msg_bad_end     バッドEDメッセージ
 *    @param  [in]msg_good_end    グッドEDメッセージ
 *    @param  [in]msg_strange_end ストレンジEDメッセージ
 */
//=============================================================================
normal_msg:
{
  _PKWD_GET_MOVIE_VALUE( LOCALWORK2, SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_PKWD_RESULT_BAD_END THEN
  // BAD END
  _BALLOONWIN_OBJMSG_POS( msg_bad_end, SCWK_TARGET_OBJID, POS_DOWN )

  CASE SCR_PKWD_RESULT_GOOD_END THEN
  // GOOD END
  _BALLOONWIN_OBJMSG_POS( msg_good_end, SCWK_TARGET_OBJID, POS_DOWN )

  CASE SCR_PKWD_RESULT_STRANGE_END THEN
  // STRANGE END
  _BALLOONWIN_OBJMSG_POS( msg_strange_end, SCWK_TARGET_OBJID, POS_DOWN )

  ENDSWITCH
}
_RET

//=============================================================================
/**
 *    ご褒美アイテムをくれるファンの処理
 *
 *    @param  [in]bonus_item_no       もらうアイテム番号
 *    @param  [in]bonus_item_num      もらうアイテムの個数
 *    @param  [in]msg_bonus_item      アイテム授与メッセージ
 *    @param  [in]msg_bonus_item_fail 道具がいっぱいの時メッセージ
 *    @param  [out]bonus_localwork    道具をもらったフラグ
 *
 */
//=============================================================================
bonus_item:
{
  DEFINE_LOCAL  ret_add

  _BALLOONWIN_OBJMSG_POS( msg_bonus_item, SCWK_TARGET_OBJID, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  // アイテムを取得できたのかチェック
  _ADD_ITEM_CHK( bonus_item_no, bonus_item_num, ret_add)

  // アイテム入手
  // ↓のコマンドをよぶことで、バッグがいっぱいの時のメッセージをだす
  _ITEM_EVENT_KEYWAIT( bonus_item_no, bonus_item_num )

  IF $ret_add == FALSE THEN
    //入手失敗システムメッセージ
    _BALLOONWIN_OBJMSG_POS( msg_bonus_item_fail, SCWK_TARGET_OBJID, POS_DOWN )
  ELSE
    $bonus_localwork = 1    // 道具授与フラグON
    //入手成功システムメッセージ
    _CALL normal_msg
  ENDIF
}
_RET

