//------------------------！注意！------------------------------//
//																                              //
//  C15R0301:シアターでのローカルワーク使途
//  pokewood_scr.evで設定しています
//  LOCALWORK0  1のとき初上映でのオーナー出現イベント発生
//  LOCALWORK1  上記イベントでの上映データ位置を記録
//  LOCALWORK2  上映した作品Noを保存している
//  LOCALWORK3  1のとき初上映
//              ※LOCALWORK0も同じ意味だが、オーナーイベントが終わると
//                リセットされるため新しく定義した
//
//	LOCALWORK5～15までをファンにアイテムを渡したかの制御に使用//
//		ゾーン内での使用を禁止します							                //
//
//																                              //
//--------------------------------------------------------------//

// fan関数で使用する
DEFINE_LOCAL  msg_greeting      // 挨拶メッセージ
DEFINE_LOCAL  fan_no            // ファン番号

// normal_msg関数で使用する
DEFINE_LOCAL  msg_bad_end       // バッドエンド用メッセージ
DEFINE_LOCAL  msg_good_end      // グッドエンド用メッセージ
DEFINE_LOCAL  msg_strange_end   // ストレンジエンド用メッセージ

// bonus_item関数で使用する
DEFINE_LOCAL  msg_bonus_item    // ご褒美授与メッセージ
DEFINE_LOCAL  msg_bonus_item_fail  // どうぐいっぱいのメッセージ
DEFINE_LOCAL  bonus_item_no     // ご褒美アイテム番号
DEFINE_LOCAL  bonus_item_num    // ご褒美アイテムの個数
DEFINE_LOCAL  bonus_localwork   // ご褒美アイテム処理関数の引数
                                // LOCALWORKを入れる


/************************************************************/
/*  ZONE_CHANGE_SCRIPT                                      */
/************************************************************/
INIT_EVENT_START  ev_zone_c15r0301
  
  //ファンを非表示
  _FLAG_SET( FV_C15R0301_BONUS_0 )
  _FLAG_SET( FV_C15R0301_BONUS_1 )
  _FLAG_SET( FV_C15R0301_BONUS_2 )
  _FLAG_SET( FV_C15R0301_BONUS_3 )
  _FLAG_SET( FV_C15R0301_BONUS_4 )


INIT_EVENT_END

/**************************************************************/
/*			一言メッセージ					  */
/**************************************************************/
EVENT_START		ev_c15r0301_cleaningm_01
