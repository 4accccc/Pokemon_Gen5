// スターランク 0
EVENT_START       ev_c15r0301_backpackerm_01
{
  // 各データ
  $fan_no               = 0             // ファン番号
  $msg_greeting         = pwfun_01_01   // 挨拶
  $msg_strange_end      = pwfun_01_02   // ストレンジED
  $msg_good_end         = pwfun_01_03   // グッドED
  $msg_bad_end          = pwfun_01_04   // バッドED
  $msg_bonus_item       = pwfun_01_05   // 道具授与
  $msg_bonus_item_fail  = pwfun_01_06   // 道具いっぱい
  $bonus_localwork      = $LOCALWORK5   // 道具授与フラグ

  // ファンの処理
  _CALL fan

  // フラグ再設定
  $LOCALWORK5 = $bonus_localwork
}
EVENT_END
