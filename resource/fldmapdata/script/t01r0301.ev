  .text

  .include  "scr_seq_def.h"
  .include  "../../../prog/include/msg/script/msg_t01r0301.h"
  .include  "t01r0301.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori //スクリプト修正

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_t01r0301_middleman2_01
_EVENT_DATA   ev_t01r0301_middlewoman2_01
_EVENT_DATA_END


/**************************************************************/
/*  チェレンの父：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_t01r0301_middleman2_01

  //どうぐ入手：きのみジュース
  _EASY_TALK_ITEM_EVENT( ITEM_KINOMIZYUUSU, 1, FE_T01R0301_ITEMGET_01, msg_t01r0301_middleman2_01, msg_t01r0301_middleman2_02, msg_t01r0301_middleman2_02 )

EVENT_END

/**************************************************************/
/*  チェレンの母：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_t01r0301_middlewoman2_01
{
  _TALK_OBJ_START()
  
  //データコンバートチェック
  _DATACONV_IS_EXIST( DATACONV_ID_SYSTEM, LOCALWORK15 )

  //データを引き継いでいるか
  IF $LOCALWORK15 >= 1 THEN

    //主人公名代入
    _PLAYER_NAME( 0 )
    //名前代入
    _DATACONV_SET_NAME( DATACONV_ID_DENDOU,1 ) 

    //チェレンの母：あなた　《前作主人公》に　にてる……かも▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0301_middlewoman2_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE

    //主人公名代入
    _PLAYER_NAME( 0 )

    //チェレンの母：《主人公》っていうんだ▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0301_middlewoman2_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF
}
EVENT_END




