//--------------------------------------------------------------------
// チュートリアルイベント生成
//--------------------------------------------------------------------
tutorial_event_call:
{
  DEFINE_LOCAL LWK_ROOM_ID

  // 部屋番号取得
  _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_ROOM_ID  ,0 ,LWK_ROOM_ID )

  // イベントは部屋ID10で発生する
  IF $LWK_ROOM_ID == 10 THEN
    // ROMバージョンとダンジョンのバージョン比較
	  _INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
    _GET_ROM_VERSION ( LWK_ROM_VERSION )

    // ROMとダンジョンのバージョンが同じ場合のみチュートリアルイベントは発生する
    // エリアIDを取得する
    _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)

    // エリア1用イベント呼び出し
    _FLAG_CHECK( FE_INFDUNGEON_TUTORIAL_01, SCWK_ANSWER ) // 初めてのイベントか？
    IF $SCWK_ANSWER == FALSE THEN
      IF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_1 THEN
        // エリア1用チュートリアル呼び出し
        _INFINITY_DUNGEON_GET_BOSS_OBJ_CODE(SCWK_TEMP0)
	      IF $LWK_D_VERSION == VERSION_B2 THEN
          _OBJ_ADD_EX( 6, -1, DIR_LEFT, MMDL_ID_EVENTOBJ_00, SCWK_TEMP0, MV_DMY )
        ELSE
          _OBJ_ADD_EX( 6, -1, DIR_LEFT, MMDL_ID_EVENTOBJ_00, SCWK_TEMP0, MV_DMY )
        ENDIF
        _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA1_TUTORIAL )
        _FLAG_SET( FE_INFDUNGEON_TUTORIAL_01 )  // イベントフラグをセット
      ENDIF
    ENDIF

    // エリア2用イベント呼び出し(フラグは連番で3を使用)
    _FLAG_CHECK( FE_INFDUNGEON_TUTORIAL_03, SCWK_ANSWER ) // 初めてのイベントか？
    IF $SCWK_ANSWER == FALSE THEN 
      IF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_2 THEN
        // エリア2用チュートリアル呼び出し
        _INFINITY_DUNGEON_GET_BOSS_OBJ_CODE(SCWK_TEMP0)
 	      IF $LWK_D_VERSION == VERSION_B2 THEN
          _OBJ_ADD_EX( -1, 7, DIR_LEFT, MMDL_ID_EVENTOBJ_00, SCWK_TEMP0, MV_DMY )
        ELSE
          _OBJ_ADD_EX( -1, 7, DIR_LEFT, MMDL_ID_EVENTOBJ_00, SCWK_TEMP0, MV_DMY )
        ENDIF
        _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA2_TUTORIAL )
        _FLAG_SET( FE_INFDUNGEON_TUTORIAL_03 )  // イベントフラグをセット
      ENDIF
    ENDIF
  ENDIF
}
_RET

//--------------------------------------------------------------------
// チュートリアルイベント生成(ボス部屋)
//--------------------------------------------------------------------
tutorial_event_boss_call:
{
  DEFINE_LOCAL LWK_IS_BOSS_ROOM

  // 部屋番号取得
  _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_CHECK_UP_ROOMTYPE_BOSS  ,0 ,LWK_IS_BOSS_ROOM )

  // TUTORIAL用イベントキャラクターの表示状態を設定
  _FLAG_SET( FV_D31R0601_MUGENBOSS_01 ) // リセット
  _FLAG_SET( FV_D31R0501_MUGENBOSS_01 ) // リセット

  _FLAG_CHECK( FE_INFDUNGEON_TUTORIAL_02, SCWK_ANSWER ) // 初めてのイベントか？
  IF $SCWK_ANSWER == FALSE THEN
    // 移動スクリプトが呼ばれる前によばれるので、一つ下の部屋かどうかを調べる
    IF $LWK_IS_BOSS_ROOM == TRUE THEN
      // ROMバージョンとダンジョンのバージョン比較
	    _INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
      _GET_ROM_VERSION ( LWK_ROM_VERSION )

      // ROMとダンジョンのバージョンが同じ場合のみチュートリアルイベントは発生する
      IF $LWK_D_VERSION == $LWK_ROM_VERSION THEN
        // エリアIDを取得する
        _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
        IF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_3 THEN
          // エリア3用チュートリアル呼び出し
          _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA3_TUTORIAL_BOSS )
          _FLAG_SET( FE_INFDUNGEON_TUTORIAL_02 )
      
          // バージョンごとに表示するOBJを変える
	        IF $LWK_D_VERSION == VERSION_B2 THEN
            _FLAG_RESET( FV_D31R0601_MUGENBOSS_01 )   // ボスOBJを見えるようにする
          ELSE
            _FLAG_RESET( FV_D31R0501_MUGENBOSS_01 )   // ボスOBJを見えるようにする
          ENDIF

        ENDIF
      ENDIF
    ENDIF
  ENDIF

}
_RET

