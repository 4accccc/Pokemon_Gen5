DEFINE_LOCAL LWK_TR_OBJID
DEFINE_LOCAL LWK_TRID_POS
DEFINE_LOCAL LWK_IS_BATTLE
DEFINE_LOCAL LWK_HINT_MSG_ID
DEFINE_LOCAL LWK_TRTYPE
DEFINE_LOCAL LWK_ROM_VERSION
DEFINE_LOCAL LWK_DRAW_FLOOR_NO
DEFINE_LOCAL LWK_DRAW_AREA_NO
DEFINE_LOCAL LWK_MOVE_ROOM_NUM

//----------------------------------------------------------------------------
//	リタイアイベント
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_retire
{
  // 内部でフェードが呼ばれるので、後からエレベータ音を鳴らす
  _INFINITY_DUNGEON_WARP(WARP_INFORMATION,SCR_INFDUNGEON_WARP_FADE,SCR_INFDUNGEON_WARP_NO_FADE)

  // エレベータ移動音
  _CALL play_elevator_move_se
  _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_COMEBACK )
  _SE_STOP()
}
EVENT_END

//----------------------------------------------------------------------------
//	ゲームオーバーイベント
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_gameover
{
  // 内部でフェードが呼ばれるので、後からエレベータ音を鳴らす
  _INFINITY_DUNGEON_WARP(WARP_INFORMATION,SCR_INFDUNGEON_WARP_FADE,SCR_INFDUNGEON_WARP_NO_FADE)

  // エレベータ移動音
  _CALL play_elevator_move_se
  _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_COMEBACK )
  _SE_STOP()
}

