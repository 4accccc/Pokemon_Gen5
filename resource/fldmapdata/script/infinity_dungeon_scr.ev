	.text

  .include	"scr_seq_def.h"
  .include  "../../../prog/src/field/infinity_dungeon_warp_dir.h"
  .include  "../../../prog/src/field/infinity_dungeon_def.h"
  .include  "msg_infinity_dungeon_scr.h"
  .include  "infinity_dungeon_scr_def.h"
  .include  "d31r0101.h"
  .include  "d31r0201.h"

//--------------------------------------------------------------------
//		スクリプトテーブル
//--------------------------------------------------------------------
_EVENT_DATA		ev_init_infinity_dungeon
_EVENT_DATA		ev_infinity_dungeon_warp_up
_EVENT_DATA		ev_infinity_dungeon_warp_down
_EVENT_DATA		ev_infinity_dungeon_warp_left
_EVENT_DATA		ev_infinity_dungeon_warp_right
_EVENT_DATA		ev_infinity_dungeon_information
_EVENT_DATA   ev_infinity_dungeon_elevator
_EVENT_DATA   ev_infinity_dungeon_comeback
_EVENT_DATA   ev_infinity_dungeon_out_elevator
_EVENT_DATA_END


//----------------------------------------------------------------------------
//	無限ダンジョン初期化
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_init_infinity_dungeon
  _INFINITY_DUNGEON_START()
INIT_EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(上)
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_infinity_dungeon_warp_up
  _INFINITY_DUNGEON_WARP(WARP_DIR_UP)
INIT_EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(下)
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_infinity_dungeon_warp_down
  _INFINITY_DUNGEON_WARP(WARP_DIR_DOWN)
INIT_EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(左)
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_infinity_dungeon_warp_left
  _INFINITY_DUNGEON_WARP(WARP_DIR_LEFT)
INIT_EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(右)
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_infinity_dungeon_warp_right
  _INFINITY_DUNGEON_WARP(WARP_DIR_RIGHT)
INIT_EVENT_END

//----------------------------------------------------------------------------
//	エレベータ移動
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_infinity_dungeon_elevator
  DEFINE_LOCAL select_floor
  DEFINE_LOCAL index 
  DEFINE_LOCAL floor_num
  DEFINE_LOCAL end_floor
  DEFINE_LOCAL now_floor
  DEFINE_LOCAL now_area
  DEFINE_LOCAL draw_floor_no

  // 案内メッセージ
  _SYSWIN_MSG( msg_elevator_01, POS_DOWN )
  _LAST_KEYWAIT()
 
  // フロアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_FLOOR_NO( now_floor )

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(now_area)
 
  // 階数選択メニュー
  $floor_num = $now_area
  $floor_num *= 10
  $end_floor = $floor_num
  $end_floor += INFINITYDUNGEON_FLOOR_MAX
  $index = 0

  _DEBUG_PRINT_WK(floor_num)
  _DEBUG_PRINT_WK(end_floor)
 
  // リスト作成
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, select_floor )
  WHILE $floor_num != $end_floor
    IF $now_floor != $floor_num THEN
      // メニューに回数表示を追加
      $draw_floor_no = $floor_num
      $draw_floor_no += 1
	    _NUMBER( 0 ,  draw_floor_no , 2 )
      _BMPMENU_MAKE_LIST( msg_elevator_02, floor_num )
    ENDIF
    // カウンタをインクリメント
    $floor_num += 1
    $index += 1
  ENDWHILE
  // かえる
  _BMPMENU_MAKE_LIST( msg_elevator_03, 0xf0 )

  // やめる
  _BMPMENU_MAKE_LIST( msg_elevator_04, 0xff )

  _BMPMENU_START()

  // メッセージを非表示に
  _SYSWIN_CLOSE()
 
  // 選択後処理
  IF ($select_floor != EV_WIN_B_CANCEL)&&($select_floor != 0xff) THEN
    IF $select_floor != 0xf0 THEN
      // 選択フロア
      _DEBUG_PRINT_WK(select_floor)

      // エレベータから出る
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_OUT_ELEVATOR )

      // 選択フロアまで移動
      _INFINITY_DUNGEON_MOVE_FLOOR( select_floor )
    ELSE
      // かえるしょり
      _INFINITY_DUNGEON_WARP(WARP_INFORMATION)
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_COMEBACK )
    ENDIF
  ENDIF

INIT_EVENT_END

//----------------------------------------------------------------------------
//	受付
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_infinity_dungeon_information

  // 会話開始
  _TALK_OBJ_START()
  
  // 初期化
  $SCWK_ANSWER = 1

  // メニューを呼び出し
  WHILE $SCWK_ANSWER == 1
    $SCWK_ANSWER = 0
    _CALL dungeon_information
  ENDWHILE
 
INIT_EVENT_END

//----------------------------------------------------------------------------
//	エリア選択（$SCWK_ANSWER == 1でもう一度実行）
//-----------------------------------------------------------------------------
dungeon_information:
 DEFINE_LOCAL list_ret
 DEFINE_LOCAL rom_version

  // 初期化
  $SCWK_ANSWER = 0
  
  // あいさつ
  // ROMバージョンでの判断
	_GET_ROM_VERSION( rom_version )
	IF $rom_version == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_info_greet_b , SCWK_TARGET_OBJID, POS_DL )
  ELSE 
    _BALLOONWIN_OBJMSG_POS( msg_info_greet_w , SCWK_TARGET_OBJID, POS_DL )
  ENDIF

	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, list_ret )
  _BMPMENU_MAKE_LIST( msg_info_menu_01, 0 )  //せつめい
  _BMPMENU_MAKE_LIST( msg_info_menu_02, 1 )  //ちょうせんする
  _BMPMENU_MAKE_LIST( msg_info_menu_03, 2 )  //やめる
  _BMPMENU_START()

  IF $list_ret != EV_WIN_B_CANCEL THEN
    SWITCH $list_ret
     CASE 0 THEN
        // せつめい
       _BALLOONWIN_OBJMSG_POS( msg_info_help , SCWK_TARGET_OBJID, POS_DL )
        _LAST_KEYWAIT()
       _BALLOONWIN_CLOSE()
        $SCWK_ANSWER = 1
     CASE 1 THEN
       // どのえりあにちょうせんしますか？
       _BALLOONWIN_OBJMSG_POS( msg_info_000 , SCWK_TARGET_OBJID, POS_DL )
       _LAST_KEYWAIT()
       _CALL select_area
        $SCWK_ANSWER = 0
     CASE 2 THEN
        // きゃんせる
        _BALLOONWIN_OBJMSG_POS( msg_info_cancel , SCWK_TARGET_OBJID, POS_DL )
        _LAST_KEYWAIT()
        _BALLOONWIN_CLOSE()
        $SCWK_ANSWER = 0
    ENDSWITCH
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_info_cancel , SCWK_TARGET_OBJID, POS_DL )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
    $SCWK_ANSWER = 0
  ENDIF

_RET

//----------------------------------------------------------------------------
//	エリア選択
//-----------------------------------------------------------------------------
select_area:
  DEFINE_LOCAL area_menu 
  DEFINE_LOCAL list_num
  DEFINE_LOCAL list_count
  DEFINE_LOCAL menu_num
  DEFINE_LOCAL start_room
  
  // ダンジョンの状態を取得
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( menu_num )
 
  // エリア選択メニュー
  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, area_menu )
      
  // メニューを呼び出し
  $list_count = 0
  WHILE $list_count <= $menu_num
    // エリア番号を登録
    $start_room  = $list_count
    $start_room *= 10
    $list_num =  $list_count
    $list_num += 1
	  _NUMBER( 0 , list_num , 2 )
    _BMPMENU_MAKE_LIST( msg_info_area, start_room )
    $list_count += 1
    _DEBUG_PRINT_WK(floor_num)
  ENDWHILE

  // やめる
  _BMPMENU_MAKE_LIST( msg_elevator_04, 0xff )

  // メニュー開始
  _BMPMENU_START()

  // キャンセル判定
  IF ($area_menu != EV_WIN_B_CANCEL)&&($area_menu != 0xff) THEN

    // 確認
    _BALLOONWIN_OBJMSG_POS( msg_info_002 , SCWK_TARGET_OBJID, POS_DL )
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN
      // じゅんびはよろしいですね
      _BALLOONWIN_OBJMSG_POS( msg_info_001 , SCWK_TARGET_OBJID, POS_DL )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
   
      // みちをあける
      _OBJ_ANIME( OBJ_INFORMATION, anm_move_make_room_l )
	    _OBJ_ANIME_WAIT()

      // 主人公をエレベータまで移動
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in )
	    _OBJ_ANIME_WAIT()
      
      // 無限ダンジョン生成シードを設定
      _INFINITY_DUNGEON_INIT_SEED()
 
      // エレベータから出る
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_OUT_ELEVATOR )

      // スタートフロアまで移動
      _INFINITY_DUNGEON_MOVE_FLOOR( area_menu )
     
    ELSE
      // やめる
      _BALLOONWIN_OBJMSG_POS( msg_info_cancel , SCWK_TARGET_OBJID, POS_DL )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ENDIF
  ELSE
      // やめる
    _BALLOONWIN_OBJMSG_POS( msg_info_cancel , SCWK_TARGET_OBJID, POS_DL )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF
_RET

//----------------------------------------------------------------------------
//	帰還
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_infinity_dungeon_comeback

  // 道をあける
  _OBJ_ANIME( OBJ_INFORMATION, anm_move_make_room_l )
	_OBJ_ANIME_WAIT()
  
  // 主人公をエレベータまで移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out_reception )
  _OBJ_ANIME_WAIT()
  
  // みちをふさぐ
  _OBJ_ANIME( OBJ_INFORMATION, anm_move_default_l )
  _OBJ_ANIME_WAIT()

INIT_EVENT_END


//----------------------------------------------------------------------------
//	エレベータから降りる
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_infinity_dungeon_out_elevator

  // 主人公をエレベータまで移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
  _OBJ_ANIME_WAIT()

INIT_EVENT_END

//--------------------------------------------------------------------
// 受付がみちをあける
//--------------------------------------------------------------------
_ANIME_LABEL	anm_move_make_room_l
	_ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
// 受付がみちをふさぐ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_move_default_l
  _ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
// エレベータまで移動(主人公)
//--------------------------------------------------------------------
_ANIME_LABEL	anm_move_elev_in
	_ANIME_DATA	AC_WALK_U_8F,3
  _ANIME_DATA	AC_WALK_L_8F,2
	_ANIME_DATA	AC_WALK_U_8F,3
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
// 受付まで移動(主人公)
//--------------------------------------------------------------------
_ANIME_LABEL	anm_move_elev_out_reception
	_ANIME_DATA	AC_WALK_D_8F,3
  _ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	AC_WALK_D_8F,3
  _ANIME_DATA AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
// 受付まで移動(主人公)
//--------------------------------------------------------------------
_ANIME_LABEL	anm_move_elev_out
  _ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

