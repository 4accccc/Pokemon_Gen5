//		スクリプトテーブル
//--------------------------------------------------------------------
_EVENT_DATA		ev_init_infinity_dungeon
_EVENT_DATA		ev_infinity_dungeon_warp_up
_EVENT_DATA		ev_infinity_dungeon_warp_down
_EVENT_DATA		ev_infinity_dungeon_warp_left
_EVENT_DATA		ev_infinity_dungeon_warp_right
_EVENT_DATA		ev_infinity_dungeon_information
_EVENT_DATA   ev_infinity_dungeon_elevator
_EVENT_DATA   ev_infinity_dungeon_comeback
_EVENT_DATA   ev_infinity_dungeon_out_elevator
_EVENT_DATA   ev_infinity_dungeon_move_battle_trainer
_EVENT_DATA   ev_infinity_dungeon_talk_battle_trainer
_EVENT_DATA   ev_infinity_dungeon_battle_boss_trainer
_EVENT_DATA_END


//----------------------------------------------------------------------------
//	無限ダンジョン初期化
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_init_infinity_dungeon
  _INFINITY_DUNGEON_START()
INIT_EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(上)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_warp_up
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT()
	_SE_PLAY( SEQ_SE_KAIDAN )
  _INFINITY_DUNGEON_WARP(WARP_DIR_UP)
EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(下)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_warp_down
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_down_dir )
  _OBJ_ANIME_WAIT()
	_SE_PLAY( SEQ_SE_KAIDAN )
  _INFINITY_DUNGEON_WARP(WARP_DIR_DOWN)
EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(左)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_warp_left
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_left_dir )
  _OBJ_ANIME_WAIT()
	_SE_PLAY( SEQ_SE_KAIDAN )
  _INFINITY_DUNGEON_WARP(WARP_DIR_LEFT)
EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(右)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_warp_right
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_right_dir )
  _OBJ_ANIME_WAIT()
	_SE_PLAY( SEQ_SE_KAIDAN )
  _INFINITY_DUNGEON_WARP(WARP_DIR_RIGHT)
EVENT_END

//----------------------------------------------------------------------------
//	エレベータ移動
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_elevator
{
  DEFINE_LOCAL LWK_SELECT_FLOOR
  DEFINE_LOCAL LWK_INDEX 
  DEFINE_LOCAL LWK_FLOOR_NUM
  DEFINE_LOCAL LWK_END_FLOOR
  DEFINE_LOCAL LWK_NOW_FLOOR
  DEFINE_LOCAL LWK_NOW_AREA
  DEFINE_LOCAL LWK_DRAW_FLOOR_NO

  // エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

  // エレベータに乗り込む
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_02 )
  _OBJ_ANIME_WAIT()

  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)

  // 案内メッセージ
  _SYSWIN_MSG( msg_elevator_01, POS_DOWN )
 
  // フロアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_FLOOR_NO( LWK_NOW_FLOOR )

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
 
  // 階数選択メニュー
  $LWK_FLOOR_NUM = $LWK_NOW_AREA
  $LWK_FLOOR_NUM *= 10
  $LWK_END_FLOOR = $LWK_FLOOR_NUM
  $LWK_END_FLOOR += INFINITYDUNGEON_FLOOR_MAX
  $LWK_INDEX = 0

  _DEBUG_PRINT_WK(LWK_FLOOR_NUM)
  _DEBUG_PRINT_WK(LWK_END_FLOOR)
 
  // リスト作成
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_SELECT_FLOOR )
  WHILE $LWK_FLOOR_NUM != $LWK_END_FLOOR
    IF $LWK_NOW_FLOOR != $LWK_FLOOR_NUM THEN
      // メニューに回数表示を追加
      $LWK_DRAW_FLOOR_NO = $LWK_FLOOR_NUM
      $LWK_DRAW_FLOOR_NO += 1
	    _NUMBER( 0 ,  LWK_DRAW_FLOOR_NO , 2 )
      _BMPMENU_MAKE_LIST( msg_elevator_02, LWK_FLOOR_NUM )
    ENDIF
    // カウンタをインクリメント
    $LWK_FLOOR_NUM += 1
    $LWK_INDEX += 1
  ENDWHILE
  // かえる
  _BMPMENU_MAKE_LIST( msg_elevator_03, 0xf0 )

  // やめる
  _BMPMENU_MAKE_LIST( msg_elevator_04, 0xff )

  _BMPMENU_START()

  // メッセージを非表示に
  _SYSWIN_CLOSE()
 
  // 選択後処理
  IF ($LWK_SELECT_FLOOR != EV_WIN_B_CANCEL)&&($LWK_SELECT_FLOOR != 0xff) THEN
    IF $LWK_SELECT_FLOOR != 0xf0 THEN
      
      // エレベータ移動音
      _SE_PLAY( SEQ_SE_FLD_23 )

      // エレベータから出る
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_OUT_ELEVATOR )

      // 選択フロアまで移動
      _INFINITY_DUNGEON_MOVE_FLOOR( LWK_SELECT_FLOOR )
      _SE_STOP()
    ELSE
      // かえるしょり
      _INFINITY_DUNGEON_WARP(WARP_INFORMATION)
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_COMEBACK )
    ENDIF
  ELSE
    // エレベータを開ける
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)
    
    // エレベータから降りる
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
    _OBJ_ANIME_WAIT()

    // エレベータを閉める
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
  ENDIF
}
EVENT_END

//----------------------------------------------------------------------------
//	受付
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_information
{
  // 会話開始
  _TALK_OBJ_START()
  
  // 初期化
  $SCWK_ANSWER = 1

  // メニューを呼び出し
  WHILE $SCWK_ANSWER == 1
    $SCWK_ANSWER = 0
    _CALL dungeon_information
  ENDWHILE
}
EVENT_END

//----------------------------------------------------------------------------
//	エリア選択（$SCWK_ANSWER == 1でもう一度実行）
//-----------------------------------------------------------------------------
dungeon_information:
{
 DEFINE_LOCAL LWK_LIST_RET
 DEFINE_LOCAL LWK_ROM_VERSION

  // 初期化
  $SCWK_ANSWER = 0
  
  // あいさつ
  // ROMバージョンでの判断
	_GET_ROM_VERSION( LWK_ROM_VERSION )
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_info_greet_b , SCWK_TARGET_OBJID, POS_DL )
  ELSE 
    _BALLOONWIN_OBJMSG_POS( msg_info_greet_w , SCWK_TARGET_OBJID, POS_DL )
  ENDIF

	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_LIST_RET )
  _BMPMENU_MAKE_LIST( msg_info_menu_01, 0 )  //せつめい
  _BMPMENU_MAKE_LIST( msg_info_menu_02, 1 )  //ちょうせんする
  _BMPMENU_MAKE_LIST( msg_info_menu_03, 2 )  //やめる
  _BMPMENU_START()

  IF $LWK_LIST_RET != EV_WIN_B_CANCEL THEN
    SWITCH $LWK_LIST_RET
     CASE 0 THEN
        // せつめい
       _BALLOONWIN_OBJMSG_POS( msg_info_help , SCWK_TARGET_OBJID, POS_DL )
       _BALLOONWIN_CLOSE()
        $SCWK_ANSWER = 1
     CASE 1 THEN
       // どのえりあにちょうせんしますか？
       _BALLOONWIN_OBJMSG_POS( msg_info_000 , SCWK_TARGET_OBJID, POS_DL )
       _CALL select_area
        $SCWK_ANSWER = 0
     CASE 2 THEN
        // きゃんせる
        _BALLOONWIN_OBJMSG_POS( msg_info_cancel , SCWK_TARGET_OBJID, POS_DL )
        _BALLOONWIN_CLOSE()
        $SCWK_ANSWER = 0
    ENDSWITCH
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_info_cancel , SCWK_TARGET_OBJID, POS_DL )
    _BALLOONWIN_CLOSE()
    $SCWK_ANSWER = 0
  ENDIF
}
_RET

//----------------------------------------------------------------------------
//	エリア選択
//-----------------------------------------------------------------------------
select_area:
{
  DEFINE_LOCAL LWK_AREA_MENU 
  DEFINE_LOCAL LWK_LIST_NUM
  DEFINE_LOCAL LWK_LIST_COUNT
  DEFINE_LOCAL LWK_MENU_NUM
  DEFINE_LOCAL LWK_START_ROOM
  
  // ダンジョンの状態を取得
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_MENU_NUM )
 
  // エリア選択メニュー
  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_AREA_MENU )
      
  // メニューを呼び出し
  $LWK_LIST_COUNT = 0
  WHILE $LWK_LIST_COUNT <= $LWK_MENU_NUM
    // エリア番号を登録
    $LWK_START_ROOM  = $LWK_LIST_COUNT
    $LWK_START_ROOM *= 10
    $LWK_LIST_NUM =  $LWK_LIST_COUNT
    $LWK_LIST_NUM += 1
	  _NUMBER( 0 , LWK_LIST_NUM , 2 )
    _BMPMENU_MAKE_LIST( msg_info_area, LWK_START_ROOM )
    $LWK_LIST_COUNT += 1
  ENDWHILE

  // やめる
  _BMPMENU_MAKE_LIST( msg_elevator_04, 0xff )

  // メニュー開始
  _BMPMENU_START()

  // キャンセル判定
  IF ($LWK_AREA_MENU != EV_WIN_B_CANCEL)&&($LWK_AREA_MENU != 0xff) THEN

    // 確認
    _BALLOONWIN_OBJMSG_POS( msg_info_002 , SCWK_TARGET_OBJID, POS_DL )
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN
      // じゅんびはよろしいですね
      _BALLOONWIN_OBJMSG_POS( msg_info_001 , SCWK_TARGET_OBJID, POS_DL )
      _BALLOONWIN_CLOSE()
   
      // みちをあける
      _OBJ_ANIME( OBJ_INFORMATION, anm_move_make_room_l )
	    _OBJ_ANIME_WAIT()

      // 主人公をエレベータまで移動
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_01 )
	    _OBJ_ANIME_WAIT()
      
      // エレベータを開ける
      _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

      // エレベータに乗り込む
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_02 )
	    _OBJ_ANIME_WAIT()
 
      // エレベータを閉める
      _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
      
      // エレベータ移動音
      _SE_PLAY( SEQ_SE_FLD_23 )

      // 無限ダンジョン生成シードを設定
      // 内部で初期化も行っている
      _INFINITY_DUNGEON_INIT_SEED()

      // スタートフロアまで移動
      _INFINITY_DUNGEON_MOVE_FLOOR( LWK_AREA_MENU )
      _SE_STOP()
  
      // ボストレーナーの見た目を設定
      _INFINITY_DUNGEON_GET_BOSS_OBJ_CODE(OBJCHRWORK0)
       
      // エレベータから出る
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_OUT_ELEVATOR )
    ELSE
      // やめる
      _BALLOONWIN_OBJMSG_POS( msg_info_cancel , SCWK_TARGET_OBJID, POS_DL )
      _BALLOONWIN_CLOSE()
    ENDIF
  ELSE
      // やめる
    _BALLOONWIN_OBJMSG_POS( msg_info_cancel , SCWK_TARGET_OBJID, POS_DL )
    _BALLOONWIN_CLOSE()
  ENDIF
}
_RET

//----------------------------------------------------------------------------
//	帰還
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_comeback
{
   
  // エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

   // エレベータから降りる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
  _OBJ_ANIME_WAIT()

  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE )

  // 道をあける
  _OBJ_ANIME( OBJ_INFORMATION, anm_move_make_room_l )
	_OBJ_ANIME_WAIT()
  
  // 主人公をエレベータ受付まで移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out_reception )
  _OBJ_ANIME_WAIT()
  
  // みちをふさぐ
  _OBJ_ANIME( OBJ_INFORMATION, anm_move_default_l )
  _OBJ_ANIME_WAIT()
}
EVENT_END

//----------------------------------------------------------------------------
//	エレベータから降りる
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_out_elevator
{
  _SE_PLAY( SEQ_SE_FLD_87 ) //エレベーター到着音
  _SE_WAIT()
            
  // エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

  // 主人公をエレベータから降りる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
  _OBJ_ANIME_WAIT()
   
  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)

}
EVENT_END

//----------------------------------------------------------------------------
//	トレーナーとの戦闘(会話)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_talk_battle_trainer
{
  DEFINE_LOCAL  LWK_TR_OBJID
  DEFINE_LOCAL  LWK_TRID
  DEFINE_LOCAL  LWK_TRTYPE
  DEFINE_LOCAL  LWK_IS_BATTLE
  DEFINE_LOCAL  LWK_HINT_MSG_ID
  DEFINE_LOCAL  LWK_BOSS_FLOOR
  
  _TALK_OBJ_START()

  // OBJID=TRID
  $LWK_TRID = $SCWK_TARGET_OBJID
 
  // トレーナータイプ取得
  _INFINITY_DUNGEON_GET_TRTYPE( LWK_TRID, LWK_TRTYPE )

  // 戦闘データ取得
  _INFINITY_DUNGEON_GET_TRAINER_BATTLE_FLAG( LWK_TRID ,LWK_IS_BATTLE )

	IF $LWK_IS_BATTLE == FALSE THEN

    //視線曲セット
    _TRAINER_BGM_SET_BY_TRTYPE( LWK_TRTYPE )
  
    //移動終了前、会話へ
    _TRAINER_MSG_SET( LWK_TRID, TRMSG_FIGHT_START, SCWK_TARGET_OBJID )
    _BALLOONWIN_CLOSE()

    // トレーナーとの戦闘
    _INFINITY_DUNGEON_BATTLE_TRAINER()

    // 勝敗チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()
      _DEBUG_PRINT_WK( LWK_TRID )
      _INFINITY_DUNGEON_SET_TRAINER_BATTLE_FLAG( LWK_TRID , TRUE )
    ELSE
      _TRAINER_LOSE()
    ENDIF
  ELSE
    _INFINITY_DUNGEON_GET_AFTER_BTL_MSG_TYPE( SCWK_ANSWER )
    IF $SCWK_ANSWER == INF_SRC_MSG_TYPE_HINT THEN
      // ヒントメッセージ
      _INFINITY_DUNGEON_GET_HINT_MSG_ID( LWK_HINT_MSG_ID )
      _INFINITY_DUNGEON_GET_BOSS_FLOOR( LWK_BOSS_FLOOR )
      _NUMBER( 0 , LWK_BOSS_FLOOR , 3 )
      _BALLOONWIN_OBJMSG_POS( LWK_HINT_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
      _BALLOONWIN_CLOSE()
    ELSE
      // 回復メッセージ呼び出し
      _CALL recover_trainer
    ENDIF
	ENDIF
}
EVENT_END

//----------------------------------------------------------------------------
//	トレーナーとの戦闘(視線移動)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_move_battle_trainer
{
  DEFINE_LOCAL  LWK_TR_OBJID
  DEFINE_LOCAL  LWK_TRID
  DEFINE_LOCAL  LWK_TRTYPE
  DEFINE_LOCAL  LWK_IS_BATTLE
  DEFINE_LOCAL  LWK_HINT_MSG_ID

  // 視線データ取得
  _EYE_TRAINER_ID_GET( SCR_EYE_TR_0, LWK_TRID )

  // トレーナータイプ取得
  _INFINITY_DUNGEON_GET_TRTYPE( LWK_TRID, LWK_TRTYPE )

  // 戦闘済み確認
  _INFINITY_DUNGEON_GET_TRAINER_BATTLE_FLAG( LWK_TRID ,LWK_IS_BATTLE )

	IF $LWK_IS_BATTLE == FALSE THEN
  
    //視線曲セット
    _TRAINER_BGM_SET_BY_TRTYPE( LWK_TRTYPE )
 
    // 戦闘開始位置まで移動
    _EYE_TRAINER_MOVE_SET( SCR_EYE_TR_0 )        //トレーナー移動処理呼び出し
    _EYE_TRAINER_MOVE()                          //移動終了待ち

    //移動終了前、会話へ
    _EYE_TRAINER_OBJ_ID_GET( SCR_EYE_TR_0, LWK_TR_OBJID )
    _TRAINER_MSG_SET( LWK_TRID, TRMSG_FIGHT_START, LWK_TR_OBJID )
    _BALLOONWIN_CLOSE()

    // トレーナーとの戦闘
    _INFINITY_DUNGEON_BATTLE_TRAINER()

    // 勝敗チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()
      _INFINITY_DUNGEON_SET_TRAINER_BATTLE_FLAG( LWK_TRID , TRUE )
    ELSE
      _TRAINER_LOSE()
    ENDIF

	ENDIF
}
EVENT_END

//----------------------------------------------------------------------------
//	BOSSトレーナーとの戦闘
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_battle_boss_trainer
{
  DEFINE_LOCAL  LWK_ROM_VERSION
  DEFINE_LOCAL	LWK_HERO_X
  DEFINE_LOCAL	LWK_HERO_Z
  DEFINE_LOCAL	LWK_TR_START_MSG_ID
  DEFINE_LOCAL	LWK_BOSS_TRNO
    
  // ROMバージョン取得
  _GET_ROM_VERSION( LWK_ROM_VERSION )

  // ボスナンバー取得
  _INFINITY_DUNGEON_GET_BOSS_NO( LWK_BOSS_TRNO )

  // 出口まで歩く
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 7, FORCE_TYPE_NOT, 8, DIR_UD)
  ELSE 
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 7, FORCE_TYPE_NOT, 8, DIR_UD)
  ENDIF
  _OBJ_ANIME_WAIT()

  // 上に向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT()

  // 戦闘前メッセージID取得
  $LWK_TR_START_MSG_ID = msg_b_boss_start_00

  // メッセージ開始
  _BALLOONWIN_OBJMSG_POS( LWK_TR_START_MSG_ID , D31R0601_WKOBJCODE00, POS_DOWN )
	_BALLOONWIN_CLOSE()

	//トレーナー戦呼び出し
	_TRAINER_BTL_SET( LWK_BOSS_TRNO, 0 )

  //敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
			_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF

  // 戦闘終了後メッセージ
  $LWK_TR_START_MSG_ID = msg_b_boss_end_00
  _BALLOONWIN_OBJMSG_POS( LWK_TR_START_MSG_ID , D31R0601_WKOBJCODE00, POS_DOWN )
	_BALLOONWIN_CLOSE()

  // 出口まで歩く
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 13, FORCE_TYPE_NOT, 8, DIR_UD)
  ELSE 
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 13, FORCE_TYPE_NOT, 8, DIR_UD)
  ENDIF
  _OBJ_ANIME_WAIT()

  // かえるしょり
  _INFINITY_DUNGEON_WARP(WARP_INFORMATION)
  _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_COMEBACK )

}
EVENT_END


//--------------------------------------------------------------------
// 回復トレーナー
//--------------------------------------------------------------------
recover_trainer:
{
  DEFINE_LOCAL LWK_START_MSG_ID
  DEFINE_LOCAL LWK_CANCEL_MSG_ID
  DEFINE_LOCAL LWK_END_MSG_ID
  DEFINE_LOCAL LWK_TRID
  DEFINE_LOCAL LWK_IS_RECOVER

  // OBJID=TRID
  $LWK_TRID = $SCWK_TARGET_OBJID
 
  // メッセージタイプの判断(ナースorドクター)
  IF $SCWK_ANSWER == INF_SRC_MSG_TYPE_DOCTOR THEN
    $LWK_START_MSG_ID   = msg_doctor_msg_00
    $LWK_CANCEL_MSG_ID  = msg_doctor_msg_01
    $LWK_END_MSG_ID     = msg_doctor_msg_02
  ELSE
    $LWK_START_MSG_ID   = msg_nurse_msg_00
    $LWK_CANCEL_MSG_ID  = msg_nurse_msg_01
    $LWK_END_MSG_ID     = msg_nurse_msg_02
  ENDIF
 
  _TALK_OBJ_START()

  // 回復済みか調べる
  _INFINITY_DUNGEON_GET_RECOVER_FLAG( LWK_TRID ,LWK_IS_RECOVER)
  IF $LWK_IS_RECOVER != TRUE THEN
  
    // メッセージ
    _BALLOONWIN_OBJMSG_POS( LWK_START_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
    _BALLOONWIN_CLOSE()

    // YES_NO
    _YES_NO_WIN( SCWK_ANSWER )

    // 回復選択後
    IF $SCWK_ANSWER == SCR_YES THEN
      // フェード
      _BLACK_OUT()
      _DISP_FADE_END_CHECK()

      // 回復処理
      _TEMOTI_POKEMON_KAIFUKU()
	    _ME_PLAY( SEQ_ME_ASA )
      _ME_WAIT()

      // フェード
      _BLACK_IN()
      _DISP_FADE_END_CHECK()

      // 回復後メッセージ
      _BALLOONWIN_OBJMSG_POS( LWK_END_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
      
      // 回復済みフラグを立てる
      _INFINITY_DUNGEON_SET_RECOVER_FLAG( LWK_TRID ,TRUE)
    ELSE
      // キャンセルメッセージ
      _BALLOONWIN_OBJMSG_POS( LWK_CANCEL_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ENDIF
  ELSE
     // 回復後メッセージ
    _BALLOONWIN_OBJMSG_POS( LWK_END_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF
}
_RET

