  _OBJ_ANIME_WAIT()
  _CALL play_floor_move_se
  _INFINITY_DUNGEON_WARP(WARP_DIR_DOWN,SCR_INFDUNGEON_WARP_FADE,SCR_INFDUNGEON_WARP_FADE)
  _CALL tutorial_event_call
EVENT_END

