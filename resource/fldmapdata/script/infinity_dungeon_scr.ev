//----------------------------------------------------------------------------
//	エレベータ移動
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_elevator
{
  DEFINE_LOCAL LWK_INDEX 
  DEFINE_LOCAL LWK_FLOOR_NUM
  DEFINE_LOCAL LWK_END_FLOOR
  DEFINE_LOCAL LWK_NOW_FLOOR
  DEFINE_LOCAL LWK_NOW_FLOOR_NUM
 
  // ROMバージョンでの判断
	_INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
  
  // カメラ移動開始
  _CAMERA_START()
  _CAMERA_PURGE() //対象物とカメラのバインドを解く（この場面で対象物＝自機）
  
  // エレベータにカメラをを寄せる
  IF $LWK_D_VERSION == VERSION_B2 THEN
    _CAMERA_MOVE(3672,0,970752,425984,131072,-131072, 20 ) 
  ELSE
    _CAMERA_MOVE(4056,0,970752,425984,65536,-77824, 20 ) 
  ENDIF

  // エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

  // エレベータに乗り込む
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_02 )
  _OBJ_ANIME_WAIT()

  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
  
  // カメラ待ち
  _CAMERA_WAIT_MOVE()

  // 案内メッセージ
  _SYSWIN_MSG( msg_elevator_01_00, POS_DOWN )

  // フロアを取得する
  _INFINITY_DUNGEON_GET_NOW_FLOOR_NO( LWK_NOW_FLOOR )

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
 
  // 階数選択メニュー
  // 開始階を入れる
  _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_START_FLOOR  ,LWK_NOW_AREA ,LWK_FLOOR_NUM )
  // 終了階を入れる
  _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_FLOOR_NUM ,LWK_NOW_AREA ,LWK_END_FLOOR )
  $LWK_END_FLOOR += $LWK_FLOOR_NUM
  $LWK_INDEX = 0

  _DEBUG_PRINT_WK( LWK_FLOOR_NUM )
  _DEBUG_PRINT_WK( LWK_END_FLOOR )

  // リスト作成
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MOVE_ROOM_NUM )
  WHILE $LWK_FLOOR_NUM != $LWK_END_FLOOR
    IF $LWK_NOW_FLOOR != $LWK_INDEX THEN
      // メニューに回数表示を追加
      $LWK_DRAW_FLOOR_NO = $LWK_FLOOR_NUM
      $LWK_DRAW_FLOOR_NO += 1
      
      // 階数
	    _NUMBER( 0 ,  LWK_DRAW_FLOOR_NO , 2 )
      IF $LWK_D_VERSION == VERSION_B2 THEN
        _BMPMENU_MAKE_LIST( msg_elevator_02_00, LWK_FLOOR_NUM )
      ELSE
        _BMPMENU_MAKE_LIST( msg_elevator_02_01, LWK_FLOOR_NUM )
      ENDIF
    ELSE
      $LWK_NOW_FLOOR_NUM = $LWK_FLOOR_NUM
    ENDIF
    // カウンタをインクリメント
    $LWK_FLOOR_NUM += 1
    $LWK_INDEX += 1
  ENDWHILE

  
  // かえる・やめる
  _BMPMENU_MAKE_LIST( msg_elevator_03_00, 0xf0 )
  _BMPMENU_MAKE_LIST( msg_elevator_04_00, 0xff )

  _BMPMENU_START()

  // メッセージを非表示に
  _SYSWIN_CLOSE()
 
  // 選択後処理
  IF ($LWK_MOVE_ROOM_NUM != EV_WIN_B_CANCEL)&&($LWK_MOVE_ROOM_NUM != 0xff) THEN
    IF $LWK_MOVE_ROOM_NUM != 0xf0 THEN
      
      IF $LWK_MOVE_ROOM_NUM > $LWK_NOW_FLOOR_NUM THEN
        // 上
        IF $LWK_D_VERSION == VERSION_B2 THEN
          _CAMERA_MOVE(3672,0,970752,425984,131072+500000,-131072, 40 ) 
          $WK_OTHER_INF_ELEVATOR_UP_MOVE = 1
        ELSE
          _CAMERA_MOVE(4056,0,970752,425984,65536-500000,-77824, 40 ) 
          $WK_OTHER_INF_ELEVATOR_UP_MOVE = 0
        ENDIF
      ELSE
        // 下
        IF $LWK_D_VERSION == VERSION_B2 THEN
          _CAMERA_MOVE(3672,0,970752,425984,131072-500000,-131072, 40 ) 
          $WK_OTHER_INF_ELEVATOR_UP_MOVE = 0
        ELSE
          _CAMERA_MOVE(4056,0,970752,425984,65536+500000,-77824, 40 ) 
          $WK_OTHER_INF_ELEVATOR_UP_MOVE = 1
        ENDIF
      ENDIF

      // エレベータ移動音
      _CALL play_elevator_move_se
      
      // エレベータから出る
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_OUT_ELEVATOR )

      // 選択フロアまで移動
      _INFINITY_DUNGEON_MOVE_FLOOR( LWK_MOVE_ROOM_NUM )
  
      _SE_STOP()
      _CAMERA_WAIT_MOVE()
      _CAMERA_BIND()        // カメラバインド
      _CAMERA_END()

    ELSE
    
      // リタイア確認メッセージ
      _SYSWIN_MSG( msg_elevator_05_00, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )
      _SYSWIN_CLOSE()

      IF $SCWK_ANSWER == FALSE THEN
        // かえるしょり
        IF $LWK_D_VERSION == VERSION_B2 THEN
        // 下
          _CAMERA_MOVE(3672,0,970752,425984,131072-500000,-131072, 40 ) 
        ELSE
        // 上
          _CAMERA_MOVE(4056,0,970752,425984,65536+500000,-77824, 40 ) 
        ENDIF

        // エレベータ移動音
        _CALL play_elevator_move_se

        _INFINITY_DUNGEON_WARP(WARP_INFORMATION,SCR_INFDUNGEON_WARP_FADE,SCR_INFDUNGEON_WARP_NO_FADE)
        _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_COMEBACK )
        _SE_STOP()

        _CAMERA_BIND()        // カメラバインド
        _CAMERA_END()
      ELSE
        // 帰る処理をキャンセル
        // エレベータを開ける
        _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

        // エレベータから降りる
        _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
        _OBJ_ANIME_WAIT()

        // カメラを戻す
        _CAMERA_DEF_MOVE( 20 )

        // エレベータを閉める
        _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)

        _CAMERA_WAIT_MOVE()
        _CAMERA_BIND()        // カメラバインド
        _CAMERA_END()
      ENDIF
    ENDIF
  ELSE

    // エレベータを開ける
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)
    
    // エレベータから降りる
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
    _OBJ_ANIME_WAIT()

    // カメラを戻す
    _CAMERA_DEF_MOVE( 20 )

    // エレベータを閉める
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)

    _CAMERA_WAIT_MOVE()
    _CAMERA_BIND()        // カメラバインド
    _CAMERA_END()
  ENDIF

}
EVENT_END

//----------------------------------------------------------------------------
//	受付
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_information
{
  // 会話開始
  _TALK_OBJ_START()
  
  // 初期化
  $SCWK_ANSWER = 1

  // メニューを呼び出し
  WHILE $SCWK_ANSWER == 1
    $SCWK_ANSWER = 0
    _CALL dungeon_information
  ENDWHILE
}
EVENT_END

//----------------------------------------------------------------------------
//	エリア選択（$SCWK_ANSWER == 1でもう一度実行）
//-----------------------------------------------------------------------------
dungeon_information:
{
 DEFINE_LOCAL LWK_LIST_RET

  // 初期化
  $SCWK_ANSWER = 0
  
  // ROMバージョンでの判断
	_INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )

  // あいさつ
	IF $LWK_D_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_info_b_01_00 , SCWK_TARGET_OBJID, POS_DL )
  ELSE 
    _BALLOONWIN_OBJMSG_POS( msg_info_w_01_00 , SCWK_TARGET_OBJID, POS_DL )
  ENDIF

	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_LIST_RET )
  _BMPMENU_MAKE_LIST( msg_info_menu_02_00, 1 )  //ちょうせんする
  _BMPMENU_MAKE_LIST( msg_info_menu_01_00, 0 )  //せつめい
  _BMPMENU_MAKE_LIST( msg_info_menu_03_00, 2 )  //やめる
  _BMPMENU_START()

  IF $LWK_LIST_RET != EV_WIN_B_CANCEL THEN
    SWITCH $LWK_LIST_RET
     CASE 0 THEN

        // トレーナー名をセット
        _PLAYER_NAME( 0 )

        // せつめい
        IF $LWK_D_VERSION == VERSION_B2 THEN
          _BALLOONWIN_OBJMSG_POS( msg_info_help_b_01_00 , SCWK_TARGET_OBJID, POS_DL )
          _BALLOONWIN_OBJMSG_POS( msg_info_help_b_02_00 , SCWK_TARGET_OBJID, POS_DL )
        ELSE 
          _BALLOONWIN_OBJMSG_POS( msg_info_help_w_01_00 , SCWK_TARGET_OBJID, POS_DL )
          _BALLOONWIN_OBJMSG_POS( msg_info_help_w_02_00 , SCWK_TARGET_OBJID, POS_DL )
        ENDIF

        $SCWK_ANSWER = 1
     CASE 1 THEN
        // どのえりあにちょうせんしますか？
        IF $LWK_D_VERSION == VERSION_B2 THEN
          _BALLOONWIN_OBJMSG_POS( msg_info_b_02_00 , SCWK_TARGET_OBJID, POS_DL )
        ELSE 
          _BALLOONWIN_OBJMSG_POS( msg_info_w_02_00 , SCWK_TARGET_OBJID, POS_DL )
        ENDIF
       _CALL select_area
        $SCWK_ANSWER = 0
     CASE 2 THEN
        // キャンセル
        IF $LWK_D_VERSION == VERSION_B2 THEN
          _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , SCWK_TARGET_OBJID, POS_DL )
        ELSE 
          _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , SCWK_TARGET_OBJID, POS_DL )
        ENDIF
        _LAST_KEYWAIT()
        _BALLOONWIN_CLOSE()
        $SCWK_ANSWER = 0
    ENDSWITCH
  ELSE
    // キャンセル
    IF $LWK_D_VERSION == VERSION_B2 THEN
      _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , SCWK_TARGET_OBJID, POS_DL )
    ELSE 
      _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , SCWK_TARGET_OBJID, POS_DL )
    ENDIF
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
    $SCWK_ANSWER = 0
  ENDIF
}
_RET

//----------------------------------------------------------------------------
//	エリア選択
//-----------------------------------------------------------------------------
select_area:
{
  DEFINE_LOCAL LWK_START_FLOOR
  DEFINE_LOCAL LWK_LIST_NUM
  DEFINE_LOCAL LWK_LIST_COUNT
  DEFINE_LOCAL LWK_MENU_NUM

  // ROMバージョン取得
  _INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
 
  // ダンジョンの状態を取得
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_MENU_NUM )

  // 最大値制限
  IF $LWK_MENU_NUM > INFINITY_DUNGEON_AREA_ID_10 THEN
    $LWK_MENU_NUM = INFINITY_DUNGEON_AREA_ID_10
  ENDIF
 
  // エリア選択メニュー
  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_AREA_MENU )
   
  // メニューを呼び出し
  $LWK_LIST_COUNT = 0
  WHILE $LWK_LIST_COUNT <= $LWK_MENU_NUM
    // エリア番号を登録
    $LWK_LIST_NUM =  $LWK_LIST_COUNT
    $LWK_LIST_NUM += 1
	  _NUMBER( 0 , LWK_LIST_NUM , 2 )
	  
    _BMPMENU_MAKE_LIST( msg_info_area_00, LWK_LIST_COUNT )

    $LWK_LIST_COUNT += 1
  ENDWHILE

  // やめる
  _BMPMENU_MAKE_LIST( msg_elevator_04_00, 0xff )

  // メニュー開始
  _BMPMENU_START()

  // キャンセル判定
  IF ($LWK_AREA_MENU != EV_WIN_B_CANCEL)&&($LWK_AREA_MENU != 0xff) THEN
    // 確認
    IF $LWK_D_VERSION == VERSION_B2 THEN
      _BALLOONWIN_OBJMSG_POS( msg_info_b_03_00 , SCWK_TARGET_OBJID, POS_DL )
    ELSE 
      _BALLOONWIN_OBJMSG_POS( msg_info_w_03_00 , SCWK_TARGET_OBJID, POS_DL )
    ENDIF

    // YesNoウィンドウ
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN

      // ビーコン：無限ダンジョン進入
      _BEACON_SET_REQ_INF_DUNGEON_ENTRY( LWK_AREA_MENU )

      // JA履歴
      IF $LWK_D_VERSION == VERSION_B2 THEN
        _RESORT_SET_RECORD( RESORT_RECORD_ID_INFINITYD_B )
      ELSE
        _RESORT_SET_RECORD( RESORT_RECORD_ID_INFINITYD_W )
      ENDIF

      // 回復会話
      IF $LWK_D_VERSION == VERSION_B2 THEN
        _BALLOONWIN_OBJMSG_POS( msg_info_b_recovery_01 , SCWK_TARGET_OBJID, POS_DL )
      ELSE 
        _BALLOONWIN_OBJMSG_POS( msg_info_w_recovery_01 , SCWK_TARGET_OBJID, POS_DL )
      ENDIF

      // 回復処理(フェードなし)
      _TEMOTI_POKEMON_KAIFUKU()
      _ME_PLAY( SEQ_SE_RECOVERY )
      _ME_WAIT()

      // じゅんびはよろしいですね
      IF $LWK_D_VERSION == VERSION_B2 THEN
        _BALLOONWIN_OBJMSG_POS( msg_info_b_04_00 , SCWK_TARGET_OBJID, POS_DL )
      ELSE 
        _BALLOONWIN_OBJMSG_POS( msg_info_w_04_00 , SCWK_TARGET_OBJID, POS_DL )
      ENDIF
      _BALLOONWIN_CLOSE()

      // みちをあける
      IF $LWK_AREA_MENU < 5 THEN
        _OBJ_ANIME( SCWK_TARGET_OBJID, anm_move_make_room_l )
      ELSE
        _OBJ_ANIME( SCWK_TARGET_OBJID, anm_move_make_room_r )
      ENDIF
      _OBJ_ANIME_WAIT()

      // エレベーターに乗り込む演出
      _CAMERA_START()
      _CAMERA_PURGE()
      
      // エレベーターにカメラを寄せる
      IF $LWK_D_VERSION == VERSION_B2 THEN
        IF $LWK_AREA_MENU < 5 THEN
          _CAMERA_MOVE(2776,0,970752,491520,139264,94208, 40 ) 
        ELSE
          _CAMERA_MOVE(2776,0,970752,491520+262144,139264,94208, 40 ) 
        ENDIF
      ELSE
        IF $LWK_AREA_MENU < 5 THEN
          _CAMERA_MOVE(3544,0,970752,491520,102400,86016, 40 ) 
        ELSE
          _CAMERA_MOVE(3544,0,970752,491520+262144,102400,86016, 40 ) 
        ENDIF
      ENDIF

      // 主人公をエレベータまで移動
      IF $LWK_AREA_MENU < 5 THEN
        _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_01_l )
      ELSE
        _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_01_r )
      ENDIF
      _OBJ_ANIME_WAIT()
    
      // エレベータを開ける
      IF $LWK_AREA_MENU < 5 THEN
        _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)
      ELSE
        _INFINITY_DUNGEON_ACTION_ELEVATOR( 1 ,TRUE)
      ENDIF

      // エレベータに乗り込む
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_02 )
      _OBJ_ANIME_WAIT()

      // カメラ移動待ち
      _CAMERA_WAIT_MOVE()

      // エレベータを閉める
      IF $LWK_AREA_MENU < 5 THEN
        _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
      ELSE
        _INFINITY_DUNGEON_ACTION_ELEVATOR( 1 ,FALSE)
      ENDIF

      // バージョンによって上下にカメラ移動
      IF $LWK_D_VERSION == VERSION_B2 THEN
        IF $LWK_AREA_MENU < 5 THEN
          _CAMERA_MOVE(2776,0,970752,491520,139264+500000,94208, 40 ) 
          $WK_OTHER_INF_ELEVATOR_UP_MOVE = 1
        ELSE
          _CAMERA_MOVE(2776,0,970752,491520+262144,139264+500000,94208, 40 ) 
          $WK_OTHER_INF_ELEVATOR_UP_MOVE = 1
        ENDIF
      ELSE
        IF $LWK_AREA_MENU < 5 THEN
          _CAMERA_MOVE(3544,0,970752,491520,102400-500000,86016, 40 ) 
          $WK_OTHER_INF_ELEVATOR_UP_MOVE = 0
        ELSE
          _CAMERA_MOVE(3544,0,970752,491520+262144,102400-500000,86016, 40 ) 
          $WK_OTHER_INF_ELEVATOR_UP_MOVE = 0
        ENDIF
      ENDIF

      // エレベータ移動音
      _CALL play_elevator_move_se

      // 無限ダンジョン生成シードを設定
      // 内部で初期化も行っている
      _INFINITY_DUNGEON_INIT_SEED()

      // 選択したエリアのスタート位置を取得
      _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_START_FLOOR  ,LWK_AREA_MENU ,LWK_START_FLOOR )

      // スタートフロアまで移動
      _INFINITY_DUNGEON_MOVE_FLOOR( LWK_START_FLOOR )
      _SE_STOP()

      // カメラ演出終了
      _CAMERA_WAIT_MOVE()
      _CAMERA_BIND()        // カメラバインド
      _CAMERA_END()

      // ボストレーナーの見た目を設定
      _INFINITY_DUNGEON_GET_BOSS_OBJ_CODE(OBJCHRWORK0)

      // エレベータから出る
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_OUT_ELEVATOR )

      // 歩数カウント開始
      _SC_WALK_COUNT_START()

    ELSE
      // やめる
      IF $LWK_D_VERSION == VERSION_B2 THEN
        _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , SCWK_TARGET_OBJID, POS_DL )
        _LAST_KEYWAIT()
        _BALLOONWIN_CLOSE()
      ELSE 
        _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , SCWK_TARGET_OBJID, POS_DL )
        _LAST_KEYWAIT()
        _BALLOONWIN_CLOSE()
      ENDIF
    ENDIF
  ELSE
    // やめる
    IF $LWK_D_VERSION == VERSION_B2 THEN
      _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , SCWK_TARGET_OBJID, POS_DL )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ELSE 
      _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , SCWK_TARGET_OBJID, POS_DL )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ENDIF
  ENDIF
}
_RET

//----------------------------------------------------------------------------
//	帰還
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_comeback
{
  DEFINE_LOCAL  LWK_MAP_STATUS

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
  
  // ダンジョンのバージョン取得
  _INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
  
  // ROMバージョン取得
  _GET_ROM_VERSION ( LWK_ROM_VERSION )
  
  IF $LWK_D_VERSION == VERSION_B2 THEN
    $LWK_INFOOBJ_ID = D31R0201_INFORMATIONW_00
  ELSE
    $LWK_INFOOBJ_ID = D31R0101_WORKMAN2_00
  ENDIF

  // エレベータ移動音
  _CALL play_elevator_move_se

  //　現在のフロアと比較して、カメラを動かす
  _CAMERA_START()
  _CAMERA_PURGE() //対象物とカメラのバインドを解く（この場面で対象物＝自機）

  // バージョンによって上下にカメラ移動
  IF $LWK_D_VERSION == VERSION_B2 THEN
    IF $LWK_NOW_AREA < 5 THEN
      _CAMERA_MOVE(2776,0,970752,491520,139264+250000,94208, 1 ) 
    ELSE
      _CAMERA_MOVE(2776,0,970752,491520+262144,139264+250000,94208, 1 ) 
    ENDIF
  ELSE
    IF $LWK_NOW_AREA < 5 THEN
      _CAMERA_MOVE(3544,0,970752,491520,102400-250000,86016, 1 ) 
    ELSE
      _CAMERA_MOVE(3544,0,970752,491520+262144,102400-250000,86016, 1 ) 
    ENDIF
  ENDIF

  // カメラ移動待ち
  _CAMERA_WAIT_MOVE()
  
  // エレベーターにカメラを寄せる
  IF $LWK_D_VERSION == VERSION_B2 THEN
    IF $LWK_NOW_AREA < 5 THEN
      _CAMERA_MOVE(2776,0,970752,491520,139264,94208, 25 ) 
    ELSE
      _CAMERA_MOVE(2776,0,970752,491520+262144,139264,94208, 25 ) 
    ENDIF
  ELSE
    IF $LWK_NOW_AREA < 5 THEN
      _CAMERA_MOVE(3544,0,970752,491520,102400,86016, 25 ) 
    ELSE
      _CAMERA_MOVE(3544,0,970752,491520+262144,102400,86016, 25 ) 
    ENDIF
  ENDIF

  // ブラックイン
  _BLACK_IN()
  _CAMERA_WAIT_MOVE()
  _SE_STOP()
 
  _CALL play_elevator_stop_se
  _SE_WAIT()
 
  //フェード,カメラ待ち
  _CAMERA_WAIT_MOVE()
  _DISP_FADE_END_CHECK()

  // カメラを戻す
  _CAMERA_DEF_MOVE( 20 )

  // エレベータを開ける
  IF $LWK_NOW_AREA < 5 THEN
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)
  ELSE
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 1 ,TRUE)
  ENDIF

  // カメラバインド
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()        
  _CAMERA_END()
 
   // エレベータから降りる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )

  // カメラ、移動待ち
  _OBJ_ANIME_WAIT()

  // エリアによって降りてくる方向が違う
  IF $LWK_NOW_AREA < 5 THEN
    // エレベータを閉める
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
    
    // 道をあける
    _OBJ_ANIME( LWK_INFOOBJ_ID, anm_move_make_room_l )
    //_OBJ_ANIME_WAIT()

    // 主人公をエレベータ受付まで移動
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out_reception_l )
    _OBJ_ANIME_WAIT()

    // みちをふさぐ
    _OBJ_ANIME( LWK_INFOOBJ_ID, anm_move_default_l )
    _OBJ_ANIME_WAIT()
  ELSE
    // エレベータを閉める
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 1 ,FALSE)
    
    // 道をあける
    _OBJ_ANIME( LWK_INFOOBJ_ID, anm_move_make_room_r )
    //_OBJ_ANIME_WAIT()

    // 主人公をエレベータ受付まで移動
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out_reception_r )
    _OBJ_ANIME_WAIT()

    // みちをふさぐ
    _OBJ_ANIME( LWK_INFOOBJ_ID, anm_move_default_r )
    _OBJ_ANIME_WAIT()
  ENDIF

  // マップステータスを取得
  _INFINITY_DUNGEON_GET_MAP_STATUS( LWK_MAP_STATUS )
  
  // ダンジョンの状態を取得
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  // 会話開始音
  _TALK_START_SE_PLAY()
  
  // ボス勝利判定
  IF $LWK_MAP_STATUS == INFINITY_DUNGEON_MAP_STATUS_BOSS_WIN THEN
    $LWK_CLEAR_AREA_ID = $LWK_NOW_AREA

    // 無限ダンジョンクリアビーコン
    _BEACON_SET_REQ_INF_DUNGEON_CLEAR( LWK_CLEAR_AREA_ID )

    // エリア2~5のメダル取得
    IF (($LWK_CLEAR_AREA_ID >= INFINITY_DUNGEON_AREA_ID_2) && ($LWK_CLEAR_AREA_ID <= INFINITY_DUNGEON_AREA_ID_5)) THEN

      // 歩数関連メダル
      _SC_WALK_COUNT_GET( SCWK_ANSWER )
      IF $SCWK_ANSWER <= 100 THEN
        _SET_MEDAL_ACHIVE( MDLID_MUGEN_SPEEDY_LV1 )
      ENDIF
       
      // 戦闘関連メダル
      // トレーナーの最大数取得
      _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_TRAINER_COUNT  ,0 ,SCWK_TEMP0 )
      // 倒したトレーナーの数取得
      _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_WIN_TRAINER_COUNT  ,0 ,SCWK_TEMP1 )
      IF $SCWK_TEMP1 == 0 THEN
        _SET_MEDAL_ACHIVE( MDLID_MUGEN_BOSS_ONLY_LV1 )
      ENDIF
      IF $SCWK_TEMP0 == $SCWK_TEMP1 THEN
        _SET_MEDAL_ACHIVE( MDLID_MUGEN_ALL_WIN_LV1 )
      ENDIF

    ENDIF
    
    // エリア5クリアヒントメダル取得
    IF $LWK_CLEAR_AREA_ID == INFINITY_DUNGEON_AREA_ID_5 THEN
      _SET_MEDAL_HINT_ACHIEVE( MDLID_MUGEN_ALL_WIN_LV1 )   // ぜんぬきイージー
      _SET_MEDAL_HINT_ACHIEVE( MDLID_MUGEN_BOSS_ONLY_LV1 ) // ねらいうちイージー
      _SET_MEDAL_HINT_ACHIEVE( MDLID_MUGEN_SPEEDY_LV1 )    // そっこうイージー
    ENDIF
 
    // エリア10クリアヒントメダル取得
    IF $LWK_CLEAR_AREA_ID == INFINITY_DUNGEON_AREA_ID_10 THEN
      _SET_MEDAL_HINT_ACHIEVE( MDLID_MUGEN_ALL_WIN_LV2 )   // ぜんぬきハード
      _SET_MEDAL_HINT_ACHIEVE( MDLID_MUGEN_BOSS_ONLY_LV2 ) // ねらいうちマスター
      _SET_MEDAL_HINT_ACHIEVE( MDLID_MUGEN_SPEEDY_LV2 )    // そっこうマスター
    ENDIF

    // エリア6~10のメダル取得
    IF (($LWK_CLEAR_AREA_ID >= INFINITY_DUNGEON_AREA_ID_6) && ($LWK_CLEAR_AREA_ID <= INFINITY_DUNGEON_AREA_ID_10)) THEN
      
      // 歩数関連メダル
      _SC_WALK_COUNT_GET( SCWK_ANSWER )
      IF $SCWK_ANSWER <= 1000 THEN
        _SET_MEDAL_ACHIVE( MDLID_MUGEN_SPEEDY_LV2 )
      ENDIF

 
      // 戦闘関連メダル
      // トレーナーの最大数取得
      _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_TRAINER_COUNT  ,0 ,SCWK_TEMP0 )
      // 倒したトレーナーの数取得
      _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_WIN_TRAINER_COUNT  ,0 ,SCWK_TEMP1 )
      IF $SCWK_TEMP1 == 0 THEN
        _SET_MEDAL_ACHIVE( MDLID_MUGEN_BOSS_ONLY_LV2 )
      ENDIF
      IF $SCWK_TEMP0 == $SCWK_TEMP1 THEN
        _SET_MEDAL_ACHIVE( MDLID_MUGEN_ALL_WIN_LV2 )
      ENDIF
    ENDIF

    // 初クリア判定
    IF $LWK_NOW_AREA == $LWK_DUNGEON_STATUS THEN
    
      // ランクアップ処理
      $LWK_DUNGEON_STATUS+=1
      _INFINITY_DUNGEON_SET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

      //　現在のフロアと比較して、カメラを動かす
      _CAMERA_START()
      _CAMERA_PURGE() //対象物とカメラのバインドを解く（この場面で対象物＝自機）

      IF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_5 THEN
        // エリア５クリア
        _CALL item_get
        IF $LWK_D_VERSION == VERSION_B2 THEN
          _BALLOONWIN_OBJMSG_POS( msg_info_clear_b_03_00 , LWK_INFOOBJ_ID, POS_DOWN )
          // エレベータにカメラをを寄せる
          _CAMERA_MOVE(9688,0,970752,741376,0,233472, 30 ) 
          _BALLOONWIN_OBJMSG_POS( msg_info_clear_b_04_00 , LWK_INFOOBJ_ID, POS_DOWN )
          _BALLOONWIN_OBJMSG_POS( msg_info_clear_b_05_00 , LWK_INFOOBJ_ID, POS_DOWN )
          _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , LWK_INFOOBJ_ID, POS_DL )
        ELSE
          _BALLOONWIN_OBJMSG_POS( msg_info_clear_w_03_00 , LWK_INFOOBJ_ID, POS_DOWN )
          // エレベータにカメラをを寄せる
          _CAMERA_MOVE(9688,0,970752,741376,0,233472, 30 ) 
          _BALLOONWIN_OBJMSG_POS( msg_info_clear_w_04_00 , LWK_INFOOBJ_ID, POS_DOWN )
          _BALLOONWIN_OBJMSG_POS( msg_info_clear_w_05_00 , LWK_INFOOBJ_ID, POS_DOWN )
          _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , LWK_INFOOBJ_ID, POS_DL )
        ENDIF
        _BALLOONWIN_CLOSE()

        // カメラ待ち
        _CAMERA_WAIT_MOVE()

        // エレベータ開放イベント再生
        _INFINITY_DUNGEON_INIT_LIFT_BAN_ELEVATOR()

        // カメラを戻す
        _CAMERA_DEF_MOVE( 20 )
        _CAMERA_WAIT_MOVE()
 
        // メダル入手
        IF $LWK_D_VERSION == VERSION_B2 THEN
          _SET_MEDAL_ACHIVE( MDLID_MUGEN_AREA_B_LV1 )
        ELSE
          _SET_MEDAL_ACHIVE( MDLID_MUGEN_AREA_W_LV1 )
        ENDIF

        // キー入手（自分の色のダンジョンクリア時のみ）
        IF $LWK_ROM_VERSION == $LWK_D_VERSION THEN
          _KEYSYS_CALL_DEMO( KEYSYS_TYPE_CITY_WFBC )
        ENDIF

      ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_10 THEN
        // エリア１０クリア
        _CALL all_area_clear
         
        // メダル入手
        IF $LWK_D_VERSION == VERSION_B2 THEN
          _SET_MEDAL_ACHIVE( MDLID_MUGEN_AREA_B_LV2 )
        ELSE
          _SET_MEDAL_ACHIVE( MDLID_MUGEN_AREA_W_LV2 )
        ENDIF
      ELSE
        // 初クリア
        _CALL item_get
        _CALL area_first_clear
      ENDIF
    ELSE
      // ２回目のクリア
      _CALL item_get
      IF $LWK_D_VERSION == VERSION_B2 THEN
        _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , LWK_INFOOBJ_ID, POS_DOWN )
      ELSE
        _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , LWK_INFOOBJ_ID, POS_DOWN )
      ENDIF
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ENDIF

    _CAMERA_BIND()        // カメラバインド
    _CAMERA_END()
  ELSE
    // エレベータからの帰還
    // 案内メッセージ
    IF $LWK_D_VERSION == VERSION_B2 THEN
      _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , LWK_INFOOBJ_ID, POS_DL )
    ELSE 
      _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , LWK_INFOOBJ_ID, POS_DL )
    ENDIF

    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF
  
  // マップ状態を初期化
  _INFINITY_DUNGEON_SET_MAP_STATUS( INFINITY_DUNGEON_MAP_STATUS_BOSS_NO_WIN )

  // 歩数カウント終了
  _SC_WALK_COUNT_STOP()

}
EVENT_END

//----------------------------------------------------------------------------
//	エレベータから降りる
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_out_elevator
{
  DEFINE_LOCAL LWK_FLOOR_NUM
  DEFINE_LOCAL LWK_NOW_FLOOR_NUM

  // バージョン取得
  _INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )

  // 到着モデルをセットしておく
  _CALL add_arrival_model
  
  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)

  // 現在のフロア取得
  _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_START_FLOOR  ,LWK_NOW_AREA ,LWK_NOW_FLOOR_NUM )
  _INFINITY_DUNGEON_GET_PARAM( SCR_INFDUNGEON_PARAM_NOW_LOCAL_FLOOR_ID  ,LWK_NOW_AREA ,LWK_FLOOR_NUM )

 
  //　現在のフロアと比較して、カメラを動かす
  _CAMERA_START()
  _CAMERA_PURGE() //対象物とカメラのバインドを解く（この場面で対象物＝自機）

  // カメラの初期位置を設定
  IF $WK_OTHER_INF_ELEVATOR_UP_MOVE == 1 THEN
    // 下からきた
    IF $LWK_D_VERSION == VERSION_B2 THEN
      _CAMERA_MOVE(3672,0,970752,425984,131072-250000,-131072, 1 ) 
    ELSE
      _CAMERA_MOVE(4056,0,970752,425984,65536-250000,-77824, 1 ) 
    ENDIF
  ELSE
    // 上から来た
    IF $LWK_D_VERSION == VERSION_B2 THEN
      _CAMERA_MOVE(3672,0,970752,425984,131072+250000,-131072, 1 ) 
    ELSE
      _CAMERA_MOVE(4056,0,970752,425984,65536+250000,-77824, 1 ) 
    ENDIF
  ENDIF

  // カメラ移動待ち
  _CAMERA_WAIT_MOVE()
 
  // フェード
  _BLACK_IN()
 
   
  // エレベータにカメラをを寄せる
  IF $LWK_D_VERSION == VERSION_B2 THEN
    _CAMERA_MOVE(3672,0,970752,425984,131072,-131072, 20 ) 
  ELSE
    _CAMERA_MOVE(4056,0,970752,425984,65536,-77824, 20 ) 
  ENDIF

  //フェード,カメラ待ち
  _CAMERA_WAIT_MOVE()
  _DISP_FADE_END_CHECK()
 
  // スタートフロア＋現在のフロア
  $LWK_DRAW_FLOOR_NO=$LWK_NOW_FLOOR_NUM
  $LWK_DRAW_FLOOR_NO+=$LWK_FLOOR_NUM
  // ゼロオリジン修正
  $LWK_DRAW_FLOOR_NO+=1

  $LWK_DRAW_AREA_NO = $LWK_NOW_AREA
  $LWK_DRAW_AREA_NO += 1
 
  // エリアID登録
  _NUMBER( 0 ,LWK_DRAW_AREA_NO ,2 )

  // フロア番号登録
  _NUMBER( 1 ,LWK_DRAW_FLOOR_NO ,2)
  
  // エリアメッセージ
	IF $LWK_D_VERSION == VERSION_B2 THEN
    _SYSWIN_MSG( msg_elevator_06_b, POS_DOWN )
  ELSE
    _SYSWIN_MSG( msg_elevator_06_w, POS_DOWN )
  ENDIF

  // エレベータ到着音
  _CALL play_elevator_stop_se
  _SE_WAIT()
            
  // エレベータを開ける
  _SYSWIN_CLOSE()

  // カメラを戻す
  _CAMERA_DEF_MOVE( 20 )

  //エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)
  
  // カメラバインド
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()        
  _CAMERA_END()

  // 主人公をエレベータから降りる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
  _OBJ_ANIME_WAIT()
   
  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
}
EVENT_END

//----------------------------------------------------------------------------
//	トレーナーとの戦闘(会話)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_talk_battle_trainer
{
  _TALK_OBJ_START()

  // OBJID=LWK_TRID_POS
  $LWK_TRID_POS = $SCWK_TARGET_OBJID
 
  /// トレーナーID取得
  _INFINITY_DUNGEON_GET_TRID_BY_IDPOS( LWK_TRID_POS, LWK_TRID )
 
  // トレーナータイプ取得
  _INFINITY_DUNGEON_GET_TRTYPE( LWK_TRID, LWK_TRTYPE )

  // 戦闘データ取得
  _INFINITY_DUNGEON_GET_TRAINER_BATTLE_FLAG( LWK_TRID_POS ,LWK_IS_BATTLE )

	IF $LWK_IS_BATTLE == FALSE THEN

    //視線曲セット
    _TRAINER_BGM_SET_BY_TRTYPE( LWK_TRTYPE )
  
    //移動終了前、会話へ
    _TRAINER_MSG_SET( LWK_TRID, TRMSG_FIGHT_START, SCWK_TARGET_OBJID )
    _BALLOONWIN_CLOSE()

    // トレーナーとの戦闘
    _INFINITY_DUNGEON_BATTLE_TRAINER()

    // 勝敗チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()
      _INFINITY_DUNGEON_SET_TRAINER_BATTLE_FLAG( LWK_TRID_POS , TRUE )
      // レコードを加算：無限ダンジョントレーナーを倒した数
      _ADD_RECORD( RECID_INF_TRAINER_WIN, 1 )

      //ヒントメッセージ
      _INFINITY_DUNGEON_GET_AFTER_BTL_MSG_TYPE( SCWK_ANSWER )
      IF $SCWK_ANSWER == INF_SRC_MSG_TYPE_HINT THEN
        _CALL talk_hint
      ELSE
        // 回復メッセージ呼び出し
        _CALL recover_trainer
      ENDIF

    ELSE
      _SC_WALK_COUNT_STOP()
      _TRAINER_LOSE()
    ENDIF
  ELSE
    //ヒントメッセージ
    _INFINITY_DUNGEON_GET_AFTER_BTL_MSG_TYPE( SCWK_ANSWER )
    IF $SCWK_ANSWER == INF_SRC_MSG_TYPE_HINT THEN
      _CALL talk_hint
    ELSE
      // 回復メッセージ呼び出し
      _CALL recover_trainer
    ENDIF
	ENDIF
}
EVENT_END

//----------------------------------------------------------------------------
//	トレーナーとの戦闘(視線移動)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_move_battle_trainer
{
  // 視線データ取得
  _EYE_TRAINER_ID_GET( SCR_EYE_TR_0, LWK_TRID_POS )
  
  /// トレーナーID取得
  _INFINITY_DUNGEON_GET_TRID_BY_IDPOS( LWK_TRID_POS, LWK_TRID )

  // トレーナータイプ取得
  _INFINITY_DUNGEON_GET_TRTYPE( LWK_TRID, LWK_TRTYPE )

  // 戦闘済み確認
  _INFINITY_DUNGEON_GET_TRAINER_BATTLE_FLAG( LWK_TRID_POS ,LWK_IS_BATTLE )

	IF $LWK_IS_BATTLE == FALSE THEN
  
    //視線曲セット
    _TRAINER_BGM_SET_BY_TRTYPE( LWK_TRTYPE )
 
    // 戦闘開始位置まで移動
    _EYE_TRAINER_MOVE_SET( SCR_EYE_TR_0 )        //トレーナー移動処理呼び出し
    _EYE_TRAINER_MOVE()                          //移動終了待ち

    //移動終了前、会話へ
    _EYE_TRAINER_OBJ_ID_GET( SCR_EYE_TR_0, LWK_TR_OBJID )
    _TRAINER_MSG_SET( LWK_TRID, TRMSG_FIGHT_START, LWK_TR_OBJID )
    _BALLOONWIN_CLOSE()

    // トレーナーとの戦闘
    _INFINITY_DUNGEON_BATTLE_TRAINER()

    // 勝敗チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()
      _INFINITY_DUNGEON_SET_TRAINER_BATTLE_FLAG( LWK_TRID_POS , TRUE )
      // レコードを加算：無限ダンジョントレーナーを倒した数
      _ADD_RECORD( RECID_INF_TRAINER_WIN, 1 )
      
      //ヒントメッセージ
      _INFINITY_DUNGEON_GET_AFTER_BTL_MSG_TYPE( SCWK_ANSWER )
      IF $SCWK_ANSWER == INF_SRC_MSG_TYPE_HINT THEN
        _CALL talk_hint
      ELSE
        // 回復メッセージ呼び出し
        _CALL recover_trainer
      ENDIF
    ELSE
      _SC_WALK_COUNT_STOP()
      _TRAINER_LOSE()
    ENDIF

	ENDIF
}
EVENT_END

//----------------------------------------------------------------------------
//	BOSSトレーナーとの戦闘
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_battle_boss_trainer
{
  DEFINE_LOCAL	LWK_HERO_X
  DEFINE_LOCAL	LWK_HERO_Z
  DEFINE_LOCAL	LWK_TR_START_MSG_ID
  DEFINE_LOCAL	LWK_TR_END_MSG_ID
  DEFINE_LOCAL	LWK_BOSS_TRNO
 
  _TALK_OBJ_START()
 
  // ダンジョンの状態を取得
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
 
  // バージョン取得
  _INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )

  // ボスナンバー取得
  _INFINITY_DUNGEON_GET_BOSS_NO( LWK_BOSS_TRNO )

  // 戦闘前メッセージID取得
	IF $LWK_D_VERSION == VERSION_B2 THEN
    IF $LWK_NOW_AREA == $LWK_DUNGEON_STATUS THEN
      $LWK_TR_START_MSG_ID  = msg_b_boss_first_start_00
      $LWK_TR_END_MSG_ID    = msg_b_boss_first_end_00
    ELSE
      $LWK_TR_START_MSG_ID  = msg_b_boss_start_00
      $LWK_TR_END_MSG_ID    = msg_b_boss_end_00
    ENDIF
  ELSE
    IF $LWK_NOW_AREA == $LWK_DUNGEON_STATUS THEN
      $LWK_TR_START_MSG_ID  = msg_w_boss_first_start_00
      $LWK_TR_END_MSG_ID    = msg_w_boss_first_end_00
    ELSE
      $LWK_TR_START_MSG_ID  = msg_w_boss_start_00
      $LWK_TR_END_MSG_ID    = msg_w_boss_end_00
    ENDIF
  ENDIF

  // エリア分ずらす
  $LWK_TR_START_MSG_ID  += $LWK_NOW_AREA
  $LWK_TR_END_MSG_ID    += $LWK_NOW_AREA

  // 最上階のバージョン違いボスの場合のみ、メッセージIDをプラス１
  IF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_10 THEN
    IF $LWK_NOW_AREA != $LWK_DUNGEON_STATUS THEN
      $LWK_TR_START_MSG_ID  += 1
      $LWK_TR_END_MSG_ID    += 1
    ENDIF
  ENDIF

  // メッセージ開始
	IF $LWK_D_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( LWK_TR_START_MSG_ID , D31R0601_WKOBJCODE00, POS_DOWN )
  ELSE
    _BALLOONWIN_OBJMSG_POS( LWK_TR_START_MSG_ID , D31R0501_WKOBJCODE00, POS_DOWN )
  ENDIF
	_BALLOONWIN_CLOSE()

	//トレーナー戦呼び出し
  _TRAINER_BTL_SP_SET( LWK_BOSS_TRNO , 0 , SCR_BATTLE_MODE_MUGEN)

  //敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
	  _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
    // レコードを加算：無限ダンジョントレーナーを倒した数
    _ADD_RECORD( RECID_INF_TRAINER_WIN, 1 )
	ELSE
    _SC_WALK_COUNT_STOP()
	  _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF

  // 戦闘終了後メッセージ
	IF $LWK_D_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( LWK_TR_END_MSG_ID , D31R0601_WKOBJCODE00, POS_DOWN )
  ELSE
    _BALLOONWIN_OBJMSG_POS( LWK_TR_END_MSG_ID , D31R0501_WKOBJCODE00, POS_DOWN )
  ENDIF
	_BALLOONWIN_CLOSE()

  // 勝利フラグをセット
  _INFINITY_DUNGEON_SET_MAP_STATUS( INFINITY_DUNGEON_MAP_STATUS_BOSS_WIN )
  
  // 出口まで歩く
	IF $LWK_D_VERSION == VERSION_B2 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 13, FORCE_TYPE_NOT, 8, DIR_UD)
  ELSE 
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 13, FORCE_TYPE_NOT, 8, DIR_UD)
  ENDIF
  _OBJ_ANIME_WAIT()
  
  // 下を向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_down_dir )
  _OBJ_ANIME_WAIT()

  // フロア移動
  _CALL play_floor_move_se

  // かえるしょり
  _INFINITY_DUNGEON_WARP(WARP_INFORMATION,SCR_INFDUNGEON_WARP_FADE,SCR_INFDUNGEON_WARP_NO_FADE)
  _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_COMEBACK )

  // SE止め
  _SE_STOP()

}
EVENT_END

//----------------------------------------------------------------------------
//	エリア初回イベント（チュートリアル専用)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_area_arrival_tutorial
{
  DEFINE_LOCAL  LWK_START_MSG_ID
    
  // ROMバージョンでの判断
	_INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
 
  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
 
  // 一歩下に移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_down_1 )
  _OBJ_ANIME_WAIT()

  // 主人公がびっくり
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_gyoe )
  _OBJ_ANIME_WAIT()
   
  // 主人公の前まで移動
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_move_arrival_model_01 )
  _OBJ_ANIME_WAIT()
  
  // メッセージ
  IF $LWK_D_VERSION == VERSION_B2 THEN
    $LWK_START_MSG_ID = msg_event_b_01_01_00
    $LWK_START_MSG_ID += $LWK_NOW_AREA
    _BALLOONWIN_OBJMSG_POS( LWK_START_MSG_ID , MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ELSE
    $LWK_START_MSG_ID = msg_event_w_01_01_00
    $LWK_START_MSG_ID += $LWK_NOW_AREA
    _BALLOONWIN_OBJMSG_POS( LWK_START_MSG_ID , MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ENDIF

      
  _BALLOONWIN_CLOSE()

  // 画面外まで移動させる
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_move_down_7 )
  _OBJ_ANIME_WAIT()

  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
   
}
EVENT_END

//----------------------------------------------------------------------------
//	エリア初回イベント（エレベータを降りた後に発生)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_area_arrival
{
  DEFINE_LOCAL  LWK_START_MSG_ID
    
  // ROMバージョンでの判断
	_INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
 
  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
 
  // 一歩下に移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_down_1 )
  _OBJ_ANIME_WAIT()
  
  // 主人公がびっくり
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_gyoe )
  _OBJ_ANIME_WAIT()
   
  // 主人公の前まで移動
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_move_arrival_model_01 )
  _OBJ_ANIME_WAIT()
 
  // メッセージ
  IF $LWK_D_VERSION == VERSION_B2 THEN
    $LWK_START_MSG_ID = msg_event_b_01_01_00
    $LWK_START_MSG_ID += $LWK_NOW_AREA
    _BALLOONWIN_OBJMSG_POS( LWK_START_MSG_ID , MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ELSE
    $LWK_START_MSG_ID = msg_event_w_01_01_00
    $LWK_START_MSG_ID += $LWK_NOW_AREA
    _BALLOONWIN_OBJMSG_POS( LWK_START_MSG_ID , MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ENDIF

      
  _BALLOONWIN_CLOSE()
 
  // 主人公が左によける
  IF $LWK_D_VERSION == VERSION_B2 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_arrival_02_b )
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_arrival_02_w )
  ENDIF
  _OBJ_ANIME_WAIT()

  // エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)
 
  // エレベータにイベントキャラが乗り込む
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_move_arrival_model_03 )
  _OBJ_ANIME_WAIT()

  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
     
  // エレベータ移動音
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
   
  // 主人公が元の位置に
  IF $LWK_D_VERSION == VERSION_B2 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_arrival_04_b )
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_arrival_04_w )
  ENDIF
  _OBJ_ANIME_WAIT()

  //_TIME_WAIT( 60 )
  //_SE_STOP() 
}
EVENT_END

