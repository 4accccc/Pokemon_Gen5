//--------------------------------------------------------------------
// ヒントメッセージを話す
//--------------------------------------------------------------------
talk_hint:
{
  DEFINE_LOCAL  LWK_BOSS_FLOOR

  // ヒントメッセージ
  _INFINITY_DUNGEON_GET_HINT_MSG_ID( LWK_HINT_MSG_ID )
  _INFINITY_DUNGEON_GET_BOSS_FLOOR( LWK_BOSS_FLOOR )
  _NUMBER( 0 , LWK_BOSS_FLOOR , 2 )

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
 
  // ROMバージョンでの判断
	_INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
  
  // エリアごとのボスポケモン名をセット
  IF $LWK_D_VERSION == VERSION_B2 THEN
      SWITCH $LWK_NOW_AREA
      CASE 0 THEN
        _MONS_NAME( 1, MONSNO_512 )	//ポケモン名タグをセット
      CASE 1 THEN
        _MONS_NAME( 1, MONSNO_538 )	//ポケモン名タグをセット
      CASE 2 THEN
        _MONS_NAME( 1, MONSNO_582 )	//ポケモン名タグをセット
      CASE 3 THEN
        _MONS_NAME( 1, MONSNO_602 )	//ポケモン名タグをセット
      CASE 4 THEN
        _MONS_NAME( 1, MONSNO_437 )	//ポケモン名タグをセット
      CASE 5 THEN
        _MONS_NAME( 1, MONSNO_474 )	//ポケモン名タグをセット
      CASE 6 THEN
        _MONS_NAME( 1, MONSNO_130 )	//ポケモン名タグをセット
      CASE 7 THEN
        _MONS_NAME( 1, MONSNO_392 )	//ポケモン名タグをセット
      CASE 8 THEN
        _MONS_NAME( 1, MONSNO_642 )	//ポケモン名タグをセット
      CASE 9 THEN
        _MONS_NAME( 1, MONSNO_381 )	//ポケモン名タグをセット
      ENDSWITCH
    ELSE
      SWITCH $LWK_NOW_AREA
      CASE 0 THEN
        _MONS_NAME( 1, MONSNO_538 )	//ポケモン名タグをセット
      CASE 1 THEN
        _MONS_NAME( 1, MONSNO_512 )	//ポケモン名タグをセット
      CASE 2 THEN
        _MONS_NAME( 1, MONSNO_592 )	//ポケモン名タグをセット
      CASE 3 THEN
        _MONS_NAME( 1, MONSNO_638 )	//ポケモン名タグをセット
      CASE 4 THEN
        _MONS_NAME( 1, MONSNO_344 )	//ポケモン名タグをセット
      CASE 5 THEN
        _MONS_NAME( 1, MONSNO_468 )	//ポケモン名タグをセット
      CASE 6 THEN
        _MONS_NAME( 1, MONSNO_350 )	//ポケモン名タグをセット
      CASE 7 THEN
        _MONS_NAME( 1, MONSNO_389 )	//ポケモン名タグをセット
      CASE 8 THEN
        _MONS_NAME( 1, MONSNO_373 )	//ポケモン名タグをセット
      CASE 9 THEN
        _MONS_NAME( 1, MONSNO_380 )	//ポケモン名タグをセット
      ENDSWITCH
  ENDIF

  _BALLOONWIN_OBJMSG_POS( LWK_HINT_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()

}
_RET


//--------------------------------------------------------------------
// 手持ちポケモン回復
//--------------------------------------------------------------------
recover_temoti_poke:
{
  // フェード
  _BLACK_OUT()
  _DISP_FADE_END_CHECK()

  // 回復処理
  _TEMOTI_POKEMON_KAIFUKU()
  _ME_PLAY( SEQ_ME_ASA )
  _ME_WAIT()

  // フェード
  _BLACK_IN()
  _DISP_FADE_END_CHECK()
}
_RET

