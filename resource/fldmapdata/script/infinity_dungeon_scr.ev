  _CALL play_floor_move_se
  _CALL tutorial_event_boss_call
  _INFINITY_DUNGEON_WARP(WARP_DIR_UP,SCR_INFDUNGEON_WARP_FADE,SCR_INFDUNGEON_WARP_FADE)
  _CALL tutorial_event_call
EVENT_END

