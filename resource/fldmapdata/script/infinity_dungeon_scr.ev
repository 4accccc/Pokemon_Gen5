area5_item_get:
{
}
_RET

//--------------------------------------------------------------------
// アイテム入手
//--------------------------------------------------------------------
item_get:
{
  DEFINE_LOCAL  LWK_ROM_VERSION
  DEFINE_LOCAL  LWK_NOW_AREA
  DEFINE_LOCAL  LWK_ITEM_ID
 
  // ROMバージョンでの判断
	_GET_ROM_VERSION( LWK_ROM_VERSION )

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
  $LWK_NOW_AREA += 1
  
  // データ登録
  _PLAYER_NAME( 0 )
  _NUMBER( 1 ,  LWK_NOW_AREA , 2 )

  // クリアメッセージ
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_info_clear_b_01 , OBJ_INFORMATION, POS_DOWN )
  ELSE 
    _BALLOONWIN_OBJMSG_POS( msg_info_clear_w_01 , OBJ_INFORMATION, POS_DOWN )
  ENDIF

  
  // リスト作成
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 0, LWK_ITEM_ID )

  _ITEM_NAME( 0, ITEM_AOZORAPUREETO )
  _BMPMENU_MAKE_LIST( msg_event_item_name, ITEM_AOZORAPUREETO )
  
  _ITEM_NAME( 0, ITEM_HINOTAMAPUREETO )
  _BMPMENU_MAKE_LIST( msg_event_item_name, ITEM_HINOTAMAPUREETO )
  
  _ITEM_NAME( 0, ITEM_SIZUKUPUREETO )
  _BMPMENU_MAKE_LIST( msg_event_item_name, ITEM_SIZUKUPUREETO )
  
  _ITEM_NAME( 0, ITEM_DAITINOPUREETO )
  _BMPMENU_MAKE_LIST( msg_event_item_name, ITEM_DAITINOPUREETO )
  
  _ITEM_NAME( 0, ITEM_KOUTETUPUREETO )
  _BMPMENU_MAKE_LIST( msg_event_item_name, ITEM_KOUTETUPUREETO )

  _BMPMENU_START()

  // アイテム入手メッセージ
	_BALLOONWIN_CLOSE()
  _ITEM_EVENT_KEYWAIT( LWK_ITEM_ID , 1  )
}
_RET

