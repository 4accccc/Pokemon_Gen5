//--------------------------------------------------------------------
//		スクリプトテーブル
//--------------------------------------------------------------------
_EVENT_DATA		ev_init_infinity_dungeon
_EVENT_DATA		ev_infinity_dungeon_warp_up
_EVENT_DATA		ev_infinity_dungeon_warp_down
_EVENT_DATA		ev_infinity_dungeon_warp_left
_EVENT_DATA		ev_infinity_dungeon_warp_right
_EVENT_DATA		ev_infinity_dungeon_information
_EVENT_DATA   ev_infinity_dungeon_elevator
_EVENT_DATA   ev_infinity_dungeon_comeback
_EVENT_DATA   ev_infinity_dungeon_out_elevator
_EVENT_DATA   ev_infinity_dungeon_move_battle_trainer
_EVENT_DATA   ev_infinity_dungeon_talk_battle_trainer
_EVENT_DATA   ev_infinity_dungeon_battle_boss_trainer
_EVENT_DATA   ev_infinity_dungeon_area_arrival
_EVENT_DATA_END

//----------------------------------------------------------------------------
//	初回イベント用グローバル変数
//-----------------------------------------------------------------------------
DEFINE_LOCAL  LWK_SET_ARRIVAL_EVENT

//----------------------------------------------------------------------------
//	無限ダンジョン初期化
//-----------------------------------------------------------------------------
INIT_EVENT_START  ev_init_infinity_dungeon
  _INFINITY_DUNGEON_START()
INIT_EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(上)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_warp_up
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT()
  _CALL play_floor_move_se
  _INFINITY_DUNGEON_WARP(WARP_DIR_UP)
EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(下)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_warp_down
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_down_dir )
  _OBJ_ANIME_WAIT()
  _CALL play_floor_move_se
  _INFINITY_DUNGEON_WARP(WARP_DIR_DOWN)
EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(左)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_warp_left
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_left_dir )
  _OBJ_ANIME_WAIT()
  _CALL play_floor_move_se
  _INFINITY_DUNGEON_WARP(WARP_DIR_LEFT)
EVENT_END

//----------------------------------------------------------------------------
//	無限ダンジョン内ワープ(右)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_warp_right
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_right_dir )
  _OBJ_ANIME_WAIT()
  _CALL play_floor_move_se
  _INFINITY_DUNGEON_WARP(WARP_DIR_RIGHT)
EVENT_END

//----------------------------------------------------------------------------
//	エレベータ移動
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_elevator
{
  DEFINE_LOCAL LWK_SELECT_FLOOR
  DEFINE_LOCAL LWK_INDEX 
  DEFINE_LOCAL LWK_FLOOR_NUM
  DEFINE_LOCAL LWK_END_FLOOR
  DEFINE_LOCAL LWK_NOW_FLOOR
  DEFINE_LOCAL LWK_NOW_AREA
  DEFINE_LOCAL LWK_DRAW_FLOOR_NO
  DEFINE_LOCAL LWK_ROM_VERSION
 
  // ROMバージョンでの判断
	_GET_ROM_VERSION( LWK_ROM_VERSION )

  // エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

  // エレベータに乗り込む
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_02 )
  _OBJ_ANIME_WAIT()

  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)

  // 案内メッセージ
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _SYSWIN_MSG( msg_elevator_b_001, POS_DOWN )
  ELSE 
    _SYSWIN_MSG( msg_elevator_w_001, POS_DOWN )
  ENDIF

  // フロアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_FLOOR_NO( LWK_NOW_FLOOR )

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
 
  // 階数選択メニュー
  $LWK_FLOOR_NUM = $LWK_NOW_AREA
  $LWK_FLOOR_NUM *= 10
  $LWK_END_FLOOR = $LWK_FLOOR_NUM
  $LWK_END_FLOOR += INFINITYDUNGEON_FLOOR_MAX
  $LWK_INDEX = 0

  // リスト作成
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_SELECT_FLOOR )
  WHILE $LWK_FLOOR_NUM != $LWK_END_FLOOR
    IF $LWK_NOW_FLOOR != $LWK_INDEX THEN
      // メニューに回数表示を追加
      $LWK_DRAW_FLOOR_NO = $LWK_FLOOR_NUM
      $LWK_DRAW_FLOOR_NO += 1
      
      // 階数
	    _NUMBER( 0 ,  LWK_DRAW_FLOOR_NO , 2 )
      IF $LWK_ROM_VERSION == VERSION_B2 THEN
        _BMPMENU_MAKE_LIST( msg_elevator_b_002, LWK_FLOOR_NUM )
      ELSE 
        _BMPMENU_MAKE_LIST( msg_elevator_b_002, LWK_FLOOR_NUM )
      ENDIF
    ENDIF
    // カウンタをインクリメント
    $LWK_FLOOR_NUM += 1
    $LWK_INDEX += 1
  ENDWHILE

  
  // かえる・やめる
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _BMPMENU_MAKE_LIST( msg_elevator_b_003, 0xf0 )
    _BMPMENU_MAKE_LIST( msg_elevator_b_004, 0xff )
  ELSE 
    _BMPMENU_MAKE_LIST( msg_elevator_w_003, 0xf0 )
    _BMPMENU_MAKE_LIST( msg_elevator_w_004, 0xff )
  ENDIF

  _BMPMENU_START()

  // メッセージを非表示に
  _SYSWIN_CLOSE()
 
  // 選択後処理
  IF ($LWK_SELECT_FLOOR != EV_WIN_B_CANCEL)&&($LWK_SELECT_FLOOR != 0xff) THEN
    IF $LWK_SELECT_FLOOR != 0xf0 THEN
      
      // エレベータ移動音
      _CALL play_elevator_move_se
      
      // エレベータから出る
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_OUT_ELEVATOR )

      // 選択フロアまで移動
      _INFINITY_DUNGEON_MOVE_FLOOR( LWK_SELECT_FLOOR )
      _SE_STOP()
    ELSE
      // かえるしょり
      // エレベータ移動音
      _CALL play_elevator_move_se

      _INFINITY_DUNGEON_WARP(WARP_INFORMATION)
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_COMEBACK )
      _SE_STOP()
    ENDIF
  ELSE
    // エレベータを開ける
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)
    
    // エレベータから降りる
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
    _OBJ_ANIME_WAIT()

    // エレベータを閉める
    _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
  ENDIF
}
EVENT_END

//----------------------------------------------------------------------------
//	受付
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_information
{
  // 会話開始
  _TALK_OBJ_START()
  
  // 初期化
  $SCWK_ANSWER = 1

  // メニューを呼び出し
  WHILE $SCWK_ANSWER == 1
    $SCWK_ANSWER = 0
    _CALL dungeon_information
  ENDWHILE
       
}
EVENT_END

//----------------------------------------------------------------------------
//	エリア選択（$SCWK_ANSWER == 1でもう一度実行）
//-----------------------------------------------------------------------------
dungeon_information:
{
 DEFINE_LOCAL LWK_LIST_RET
 DEFINE_LOCAL LWK_ROM_VERSION

  // 初期化
  $SCWK_ANSWER = 0
  
  // ROMバージョンでの判断
	_GET_ROM_VERSION( LWK_ROM_VERSION )

  // あいさつ
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_info_greet_b_01 , SCWK_TARGET_OBJID, POS_DL )
  ELSE 
    _BALLOONWIN_OBJMSG_POS( msg_info_greet_w_01 , SCWK_TARGET_OBJID, POS_DL )
  ENDIF

	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_LIST_RET )
  _BMPMENU_MAKE_LIST( msg_info_menu_01, 0 )  //せつめい
  _BMPMENU_MAKE_LIST( msg_info_menu_02, 1 )  //ちょうせんする
  _BMPMENU_MAKE_LIST( msg_info_menu_03, 2 )  //やめる
  _BMPMENU_START()

  IF $LWK_LIST_RET != EV_WIN_B_CANCEL THEN
    SWITCH $LWK_LIST_RET
     CASE 0 THEN

        // トレーナー名をセット
        _PLAYER_NAME( 0 )

        // せつめい
        IF $LWK_ROM_VERSION == VERSION_B2 THEN
          _BALLOONWIN_OBJMSG_POS( msg_info_help_b_01 , SCWK_TARGET_OBJID, POS_DL )
          _BALLOONWIN_OBJMSG_POS( msg_info_help_b_02 , SCWK_TARGET_OBJID, POS_DL )
          _BALLOONWIN_OBJMSG_POS( msg_info_help_b_03 , SCWK_TARGET_OBJID, POS_DL )
        ELSE 
          _BALLOONWIN_OBJMSG_POS( msg_info_help_w_01 , SCWK_TARGET_OBJID, POS_DL )
          _BALLOONWIN_OBJMSG_POS( msg_info_help_w_02 , SCWK_TARGET_OBJID, POS_DL )
          _BALLOONWIN_OBJMSG_POS( msg_info_help_w_03 , SCWK_TARGET_OBJID, POS_DL )
        ENDIF

        $SCWK_ANSWER = 1
     CASE 1 THEN
        // どのえりあにちょうせんしますか？
        IF $LWK_ROM_VERSION == VERSION_B2 THEN
          _BALLOONWIN_OBJMSG_POS( msg_info_b_001 , SCWK_TARGET_OBJID, POS_DL )
        ELSE 
          _BALLOONWIN_OBJMSG_POS( msg_info_w_001 , SCWK_TARGET_OBJID, POS_DL )
        ENDIF
       _CALL select_area
        $SCWK_ANSWER = 0
     CASE 2 THEN
        // きゃんせる
        _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel , SCWK_TARGET_OBJID, POS_DL )
        _LAST_KEYWAIT()
        _BALLOONWIN_CLOSE()
        $SCWK_ANSWER = 0
    ENDSWITCH
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel , SCWK_TARGET_OBJID, POS_DL )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
    $SCWK_ANSWER = 0
  ENDIF
}
_RET

//----------------------------------------------------------------------------
//	エリア選択
//-----------------------------------------------------------------------------
select_area:
{
  DEFINE_LOCAL LWK_AREA_MENU 
  DEFINE_LOCAL LWK_LIST_NUM
  DEFINE_LOCAL LWK_LIST_COUNT
  DEFINE_LOCAL LWK_MENU_NUM
  DEFINE_LOCAL LWK_START_ROOM
  DEFINE_LOCAL  LWK_ROM_VERSION
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LWK_ROM_VERSION )
 
  // ダンジョンの状態を取得
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_MENU_NUM )

  // 最大値制限
  IF $LWK_MENU_NUM > INFINITY_DUNGEON_AREA_ID_10 THEN
    $LWK_MENU_NUM = INFINITY_DUNGEON_AREA_ID_10
  ENDIF
 
  // エリア選択メニュー
  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_AREA_MENU )
   
  // メニューを呼び出し
  $LWK_LIST_COUNT = 0
  WHILE $LWK_LIST_COUNT <= $LWK_MENU_NUM
    // エリア番号を登録
    $LWK_START_ROOM  = $LWK_LIST_COUNT
    $LWK_START_ROOM *= 10
    $LWK_LIST_NUM =  $LWK_LIST_COUNT
    $LWK_LIST_NUM += 1
	  _NUMBER( 0 , LWK_LIST_NUM , 2 )
	  
    IF $LWK_ROM_VERSION == VERSION_B2 THEN
      _BMPMENU_MAKE_LIST( msg_info_b_area, LWK_START_ROOM )
    ELSE 
      _BMPMENU_MAKE_LIST( msg_info_w_area, LWK_START_ROOM )
    ENDIF

    $LWK_LIST_COUNT += 1
  ENDWHILE

  // やめる
  IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _BMPMENU_MAKE_LIST( msg_elevator_b_004, 0xff )
  ELSE 
    _BMPMENU_MAKE_LIST( msg_elevator_b_004, 0xff )
  ENDIF

  // メニュー開始
  _BMPMENU_START()

  // キャンセル判定
  IF ($LWK_AREA_MENU != EV_WIN_B_CANCEL)&&($LWK_AREA_MENU != 0xff) THEN
    
    // 確認
    IF $LWK_ROM_VERSION == VERSION_B2 THEN
      _BALLOONWIN_OBJMSG_POS( msg_info_single_b_01 , SCWK_TARGET_OBJID, POS_DL )
      _BALLOONWIN_OBJMSG_POS( msg_info_b_003 , SCWK_TARGET_OBJID, POS_DL )
    ELSE 
      _BALLOONWIN_OBJMSG_POS( msg_info_single_w_01 , SCWK_TARGET_OBJID, POS_DL )
      _BALLOONWIN_OBJMSG_POS( msg_info_w_003 , SCWK_TARGET_OBJID, POS_DL )
    ENDIF

    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN
       
      // じゅんびはよろしいですね
      IF $LWK_ROM_VERSION == VERSION_B2 THEN
        _BALLOONWIN_OBJMSG_POS( msg_info_b_004 , SCWK_TARGET_OBJID, POS_DL )
      ELSE 
        _BALLOONWIN_OBJMSG_POS( msg_info_w_004 , SCWK_TARGET_OBJID, POS_DL )
      ENDIF
      _BALLOONWIN_CLOSE()
   
      // みちをあける
      _OBJ_ANIME( OBJ_INFORMATION, anm_move_make_room_l )
	    _OBJ_ANIME_WAIT()

      // 主人公をエレベータまで移動
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_01 )
	    _OBJ_ANIME_WAIT()
      
      // エレベータを開ける
      _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

      // エレベータに乗り込む
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_in_02 )
	    _OBJ_ANIME_WAIT()
 
      // エレベータを閉める
      _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
      
      // エレベータ移動音
      _CALL play_elevator_move_se

      // 無限ダンジョン生成シードを設定
      // 内部で初期化も行っている
      _INFINITY_DUNGEON_INIT_SEED()

      // スタートフロアまで移動
      _INFINITY_DUNGEON_MOVE_FLOOR( LWK_AREA_MENU )
      _SE_STOP()
  
      // ボストレーナーの見た目を設定
      _INFINITY_DUNGEON_GET_BOSS_OBJ_CODE(OBJCHRWORK0)
       
      // エレベータから出る
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_OUT_ELEVATOR )
    ELSE
      // やめる
      _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel , SCWK_TARGET_OBJID, POS_DL )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ENDIF
  ELSE
    // やめる
    IF $LWK_ROM_VERSION == VERSION_B2 THEN
      _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel , SCWK_TARGET_OBJID, POS_DL )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ELSE 
      _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel , SCWK_TARGET_OBJID, POS_DL )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ENDIF
  ENDIF
}
_RET

//----------------------------------------------------------------------------
//	帰還
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_comeback
{
  DEFINE_LOCAL  LWK_MAP_STATUS
  DEFINE_LOCAL  LWK_DUNGEON_STATUS
  DEFINE_LOCAL  LWK_NOW_AREA

  // エレベータ移動音
  _CALL play_elevator_move_se
  _TIME_WAIT( 50 )
  _SE_STOP()

  _CALL play_elevator_stop_se
  _SE_WAIT()

  // エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

   // エレベータから降りる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
  _OBJ_ANIME_WAIT()

  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE )

  // 道をあける
  _OBJ_ANIME( OBJ_INFORMATION, anm_move_make_room_l )
	_OBJ_ANIME_WAIT()
  
  // 主人公をエレベータ受付まで移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out_reception )
  _OBJ_ANIME_WAIT()
  
  // みちをふさぐ
  _OBJ_ANIME( OBJ_INFORMATION, anm_move_default_l )
  _OBJ_ANIME_WAIT()

  // マップステータスを取得
  _INFINITY_DUNGEON_GET_MAP_STATUS( LWK_MAP_STATUS )
  
  // ダンジョンの状態を取得
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
  
  // 会話開始音
  _TALK_START_SE_PLAY()
  
  // ボス勝利判定
  IF $LWK_MAP_STATUS == INFINITY_DUNGEON_MAP_STATUS_BOSS_WIN THEN
    
    // 初クリア判定
    IF $LWK_NOW_AREA == $LWK_DUNGEON_STATUS THEN
    
      // ランクアップ処理
      $LWK_DUNGEON_STATUS+=1
      _INFINITY_DUNGEON_SET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

      IF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_5 THEN
        // エリア５クリア
        _CALL area5_item_get
      ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_10 THEN
        // エリア１０クリア
        _CALL item_get
        _CALL all_area_clear
      ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_1 THEN
        // 初クリア
        _CALL item_get
        _CALL area_first_clear
      ENDIF
    ELSE
      // ２回目のクリア
      _CALL item_get
      _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel , OBJ_INFORMATION, POS_DL )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ENDIF
  ELSE
    // エレベータからの帰還
    _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel , OBJ_INFORMATION, POS_DL )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF

}
EVENT_END

//----------------------------------------------------------------------------
//	エレベータから降りる
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_out_elevator
{
  $LWK_SET_ARRIVAL_EVENT = FALSE

  // 到着モデルをセットしておく
  _CALL add_arrival_model

  // エレベータ到着音
  _CALL play_elevator_stop_se
  _SE_WAIT()
            
  // エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)

  // 主人公をエレベータから降りる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_elev_out )
  _OBJ_ANIME_WAIT()
   
  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
 
  // エリア初挑戦イベント
  IF $LWK_SET_ARRIVAL_EVENT == TRUE THEN
    _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA_ARRIVAL )
  ENDIF
}
EVENT_END

//----------------------------------------------------------------------------
//	トレーナーとの戦闘(会話)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_talk_battle_trainer
{
  DEFINE_LOCAL  LWK_TR_OBJID
  DEFINE_LOCAL  LWK_TRID_POS
  DEFINE_LOCAL  LWK_TRID
  DEFINE_LOCAL  LWK_TRTYPE
  DEFINE_LOCAL  LWK_IS_BATTLE
  DEFINE_LOCAL  LWK_HINT_MSG_ID
  DEFINE_LOCAL  LWK_BOSS_FLOOR
  
  _TALK_OBJ_START()

  // OBJID=LWK_TRID_POS
  $LWK_TRID_POS = $SCWK_TARGET_OBJID
 
  /// トレーナーID取得
  _INFINITY_DUNGEON_GET_TRID_BY_IDPOS( LWK_TRID_POS, LWK_TRID )
 
  // トレーナータイプ取得
  _INFINITY_DUNGEON_GET_TRTYPE( LWK_TRID, LWK_TRTYPE )

  // 戦闘データ取得
  _INFINITY_DUNGEON_GET_TRAINER_BATTLE_FLAG( LWK_TRID_POS ,LWK_IS_BATTLE )

	IF $LWK_IS_BATTLE == FALSE THEN

    //視線曲セット
    _TRAINER_BGM_SET_BY_TRTYPE( LWK_TRTYPE )
  
    //移動終了前、会話へ
    _TRAINER_MSG_SET( LWK_TRID, TRMSG_FIGHT_START, SCWK_TARGET_OBJID )
    _BALLOONWIN_CLOSE()

    // トレーナーとの戦闘
    _INFINITY_DUNGEON_BATTLE_TRAINER()

    // 勝敗チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()
      _INFINITY_DUNGEON_SET_TRAINER_BATTLE_FLAG( LWK_TRID_POS , TRUE )
    ELSE
      _TRAINER_LOSE()
    ENDIF
  ELSE
    _INFINITY_DUNGEON_GET_AFTER_BTL_MSG_TYPE( SCWK_ANSWER )
    IF $SCWK_ANSWER == INF_SRC_MSG_TYPE_HINT THEN
      // ヒントメッセージ
      _INFINITY_DUNGEON_GET_HINT_MSG_ID( LWK_HINT_MSG_ID )
      _INFINITY_DUNGEON_GET_BOSS_FLOOR( LWK_BOSS_FLOOR )
      _NUMBER( 0 , LWK_BOSS_FLOOR , 3 )
      _BALLOONWIN_OBJMSG_POS( LWK_HINT_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ELSE
      // 回復メッセージ呼び出し
      _CALL recover_trainer
    ENDIF
	ENDIF
}
EVENT_END

//----------------------------------------------------------------------------
//	トレーナーとの戦闘(視線移動)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_move_battle_trainer
{
  DEFINE_LOCAL  LWK_TR_OBJID
  DEFINE_LOCAL  LWK_TRID_POS
  DEFINE_LOCAL  LWK_TRID
  DEFINE_LOCAL  LWK_TRTYPE
  DEFINE_LOCAL  LWK_IS_BATTLE
  DEFINE_LOCAL  LWK_HINT_MSG_ID

  // 視線データ取得
  _EYE_TRAINER_ID_GET( SCR_EYE_TR_0, LWK_TRID_POS )
  
  /// トレーナーID取得
  _INFINITY_DUNGEON_GET_TRID_BY_IDPOS( LWK_TRID_POS, LWK_TRID )

  // トレーナータイプ取得
  _INFINITY_DUNGEON_GET_TRTYPE( LWK_TRID, LWK_TRTYPE )

  // 戦闘済み確認
  _INFINITY_DUNGEON_GET_TRAINER_BATTLE_FLAG( LWK_TRID_POS ,LWK_IS_BATTLE )

	IF $LWK_IS_BATTLE == FALSE THEN
  
    //視線曲セット
    _TRAINER_BGM_SET_BY_TRTYPE( LWK_TRTYPE )
 
    // 戦闘開始位置まで移動
    _EYE_TRAINER_MOVE_SET( SCR_EYE_TR_0 )        //トレーナー移動処理呼び出し
    _EYE_TRAINER_MOVE()                          //移動終了待ち

    //移動終了前、会話へ
    _EYE_TRAINER_OBJ_ID_GET( SCR_EYE_TR_0, LWK_TR_OBJID )
    _TRAINER_MSG_SET( LWK_TRID, TRMSG_FIGHT_START, LWK_TR_OBJID )
    _BALLOONWIN_CLOSE()

    // トレーナーとの戦闘
    _INFINITY_DUNGEON_BATTLE_TRAINER()

    // 勝敗チェック
    _TRAINER_LOSE_CHECK( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
      _TRAINER_WIN()
      _INFINITY_DUNGEON_SET_TRAINER_BATTLE_FLAG( LWK_TRID_POS , TRUE )
    ELSE
      _TRAINER_LOSE()
    ENDIF

	ENDIF
}
EVENT_END

//----------------------------------------------------------------------------
//	BOSSトレーナーとの戦闘
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_battle_boss_trainer
{
  DEFINE_LOCAL  LWK_ROM_VERSION
  DEFINE_LOCAL	LWK_HERO_X
  DEFINE_LOCAL	LWK_HERO_Z
  DEFINE_LOCAL	LWK_TR_START_MSG_ID
  DEFINE_LOCAL	LWK_TR_END_MSG_ID
  DEFINE_LOCAL	LWK_BOSS_TRNO
  DEFINE_LOCAL  LWK_DUNGEON_STATUS
  DEFINE_LOCAL  LWK_NOW_AREA

  // ダンジョンの状態を取得
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
 
  // ROMバージョン取得
  _GET_ROM_VERSION( LWK_ROM_VERSION )

  // ボスナンバー取得
  _INFINITY_DUNGEON_GET_BOSS_NO( LWK_BOSS_TRNO )

  // 出口まで歩く
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 7, FORCE_TYPE_NOT, 8, DIR_UD)
  ELSE 
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 7, FORCE_TYPE_NOT, 8, DIR_UD)
  ENDIF
  _OBJ_ANIME_WAIT()

  // 上に向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT()

  // 戦闘前メッセージID取得
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    IF $LWK_NOW_AREA == $LWK_DUNGEON_STATUS THEN
      $LWK_TR_START_MSG_ID  = msg_b_boss_first_start_00
      $LWK_TR_END_MSG_ID    = msg_b_boss_first_end_00
    ELSE
      $LWK_TR_START_MSG_ID  = msg_b_boss_start_00
      $LWK_TR_END_MSG_ID    = msg_b_boss_end_00
    ENDIF
  ELSE
    IF $LWK_NOW_AREA == $LWK_DUNGEON_STATUS THEN
      $LWK_TR_START_MSG_ID  = msg_w_boss_first_start_00
      $LWK_TR_END_MSG_ID    = msg_w_boss_first_end_00
    ELSE
      $LWK_TR_START_MSG_ID  = msg_w_boss_start_00
      $LWK_TR_END_MSG_ID    = msg_w_boss_end_00
    ENDIF
  ENDIF

  // エリア分ずらす
  $LWK_TR_START_MSG_ID  += $LWK_NOW_AREA
  $LWK_TR_END_MSG_ID    += $LWK_NOW_AREA

  // メッセージ開始
  _BALLOONWIN_OBJMSG_POS( LWK_TR_START_MSG_ID , D31R0601_WKOBJCODE00, POS_DOWN )
	_BALLOONWIN_CLOSE()

	//トレーナー戦呼び出し
	_TRAINER_BTL_SET( LWK_BOSS_TRNO, 0 )

  //敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
	  _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
	  _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF

  // 戦闘終了後メッセージ
  _BALLOONWIN_OBJMSG_POS( LWK_TR_END_MSG_ID , D31R0601_WKOBJCODE00, POS_DOWN )
	_BALLOONWIN_CLOSE()

  // 勝利フラグをセット
  _INFINITY_DUNGEON_SET_MAP_STATUS( INFINITY_DUNGEON_MAP_STATUS_BOSS_WIN )
  
  // 出口まで歩く
	IF $LWK_ROM_VERSION == VERSION_B2 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 13, FORCE_TYPE_NOT, 8, DIR_UD)
  ELSE 
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 13, FORCE_TYPE_NOT, 8, DIR_UD)
  ENDIF
  _OBJ_ANIME_WAIT()
  
  // フロア移動
  _CALL play_floor_move_se

  // かえるしょり
  _INFINITY_DUNGEON_WARP(WARP_INFORMATION)
  _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_COMEBACK )

  // SE止め
  _SE_STOP()

}
EVENT_END

//----------------------------------------------------------------------------
//	エリア初回イベント（エレベータを降りた後に発生)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_area_arrival
{
  DEFINE_LOCAL  LWK_NOW_AREA
  DEFINE_LOCAL  LWK_ROM_VERSION
  DEFINE_LOCAL  LWK_START_MSG_ID
    
  // ROMバージョンでの判断
	_GET_ROM_VERSION( LWK_ROM_VERSION )
 
  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
  
  // 主人公がびっくり
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_gyoe )
  _OBJ_ANIME_WAIT()
   
  // 主人公の前まで移動
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_move_arrival_model_01 )
  _OBJ_ANIME_WAIT()
 
  // メッセージ
  IF $LWK_ROM_VERSION == VERSION_B2 THEN
    $LWK_START_MSG_ID = msg_event_b_01_a
    $LWK_START_MSG_ID += LWK_NOW_AREA
    _BALLOONWIN_OBJMSG_POS( LWK_START_MSG_ID , MMDL_ID_EVENTOBJ_00, POS_DOWN )
    $LWK_START_MSG_ID = msg_event_b_01_b
    $LWK_START_MSG_ID += LWK_NOW_AREA
    _BALLOONWIN_OBJMSG_POS( LWK_START_MSG_ID , MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ENDIF
      
  _BALLOONWIN_CLOSE()
 
  // 主人公が左によける
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_arrival_02 )
  _OBJ_ANIME_WAIT()

  // エレベータを開ける
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,TRUE)
 
  // エレベータにイベントキャラが乗り込む
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_move_arrival_model_03 )
  _OBJ_ANIME_WAIT()

  // エレベータを閉める
  _INFINITY_DUNGEON_ACTION_ELEVATOR( 0 ,FALSE)
     
  // エレベータ移動音
  //_CALL play_elevator_move_se
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
   
  // 主人公が元の位置に
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_arrival_04 )
  _OBJ_ANIME_WAIT()

  //_TIME_WAIT( 60 )
  //_SE_STOP() 
}
EVENT_END

//--------------------------------------------------------------------
// エリア到着イベント用モデル配置
//--------------------------------------------------------------------
add_arrival_model:
{
  DEFINE_LOCAL  LWK_NOW_AREA
  DEFINE_LOCAL  LWK_ROM_VERSION
    
  // ROMバージョンでの判断
	_GET_ROM_VERSION( LWK_ROM_VERSION )
 
  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)

  IF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_1 THEN
    _FLAG_CHECK( FE_INF_AREA1_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
    IF $SCWK_ANSWER == FALSE THEN 
      $LWK_SET_ARRIVAL_EVENT = TRUE
      _FLAG_SET( FE_INF_AREA1_ARRIVAL )
    ENDIF
  ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_2 THEN
    _FLAG_CHECK( FE_INF_AREA2_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
    IF $SCWK_ANSWER == FALSE THEN 
      $LWK_SET_ARRIVAL_EVENT = TRUE
      _FLAG_SET( FE_INF_AREA2_ARRIVAL )
    ENDIF
  ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_3 THEN
    _FLAG_CHECK( FE_INF_AREA3_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
    IF $SCWK_ANSWER == FALSE THEN 
      $LWK_SET_ARRIVAL_EVENT = TRUE
      _FLAG_SET( FE_INF_AREA3_ARRIVAL )
    ENDIF
  ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_4 THEN
    _FLAG_CHECK( FE_INF_AREA4_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
    IF $SCWK_ANSWER == FALSE THEN 
      $LWK_SET_ARRIVAL_EVENT = TRUE
      _FLAG_SET( FE_INF_AREA4_ARRIVAL )
    ENDIF
  ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_5 THEN
    _FLAG_CHECK( FE_INF_AREA5_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
    IF $SCWK_ANSWER == FALSE THEN 
      $LWK_SET_ARRIVAL_EVENT = TRUE
      _FLAG_SET( FE_INF_AREA5_ARRIVAL )
    ENDIF
  ENDIF

  // モデル追加
  IF $LWK_SET_ARRIVAL_EVENT == TRUE THEN
    IF $LWK_ROM_VERSION == VERSION_B2 THEN
      _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, TBOSSBL, MV_DMY )
    ELSE 
      _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, TBOSS, MV_DMY )
    ENDIF
  ENDIF

}
_RET

//--------------------------------------------------------------------
// 回復トレーナー
//--------------------------------------------------------------------
recover_trainer:
{
  DEFINE_LOCAL LWK_START_MSG_ID
  DEFINE_LOCAL LWK_CANCEL_MSG_ID
  DEFINE_LOCAL LWK_END_MSG_ID
  DEFINE_LOCAL LWK_TRID
  DEFINE_LOCAL LWK_TRID_POS
  DEFINE_LOCAL LWK_IS_RECOVER

  // OBJID=LWK_TRID_POS
  $LWK_TRID_POS = $SCWK_TARGET_OBJID
 
  // メッセージタイプの判断(ナースorドクター)
  IF $SCWK_ANSWER == INF_SRC_MSG_TYPE_DOCTOR THEN
    $LWK_START_MSG_ID   = msg_doctor_msg_00
    $LWK_CANCEL_MSG_ID  = msg_doctor_msg_01
    $LWK_END_MSG_ID     = msg_doctor_msg_02
  ELSE
    $LWK_START_MSG_ID   = msg_nurse_msg_00
    $LWK_CANCEL_MSG_ID  = msg_nurse_msg_01
    $LWK_END_MSG_ID     = msg_nurse_msg_02
  ENDIF
 
  _TALK_OBJ_START()
 
  /// トレーナーID取得
  _INFINITY_DUNGEON_GET_TRID_BY_IDPOS( LWK_TRID_POS, LWK_TRID )
 
  // 回復済みか調べる
  _INFINITY_DUNGEON_GET_RECOVER_FLAG( LWK_TRID ,LWK_IS_RECOVER)
  IF $LWK_IS_RECOVER != TRUE THEN
  
    // メッセージ
    _BALLOONWIN_OBJMSG_POS( LWK_START_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )

    // YES_NO
    _YES_NO_WIN( SCWK_ANSWER )

    // 回復選択後
    IF $SCWK_ANSWER == SCR_YES THEN
      
      _BALLOONWIN_CLOSE()
      // フェード
      _BLACK_OUT()
      _DISP_FADE_END_CHECK()

      // 回復処理
      _TEMOTI_POKEMON_KAIFUKU()
	    _ME_PLAY( SEQ_ME_ASA )
      _ME_WAIT()

      // フェード
      _BLACK_IN()
      _DISP_FADE_END_CHECK()

      // 回復後メッセージ
      _BALLOONWIN_OBJMSG_POS( LWK_END_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
      
      // 回復済みフラグを立てる
      _INFINITY_DUNGEON_SET_RECOVER_FLAG( LWK_TRID ,TRUE)
    ELSE
      // キャンセルメッセージ
      _BALLOONWIN_OBJMSG_POS( LWK_CANCEL_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ENDIF
  ELSE
     // 回復後メッセージ
    _BALLOONWIN_OBJMSG_POS( LWK_END_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF
}
_RET

