//----------------------------------------------------------------------------
//	エリア2用チュートリアルイベント(ボス部屋)
//-----------------------------------------------------------------------------
EVENT_START  ev_infinity_dungeon_area3_tutorial_boss
{
  DEFINE_LOCAL LWK_MSG_ID
  
  // 無限ダンジョンのバージョン取得
  _INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )

  // 主人公がびっくり
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_gyoe )
  _OBJ_ANIME_WAIT()
   
  // 主人公が2歩進む
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_up_2 )
  _OBJ_ANIME_WAIT() 

  // 主人公の前まで移動
  IF $LWK_D_VERSION == VERSION_B2 THEN
    _OBJ_ANIME_AUTO( D31R0601_MUGENBOSS, 6, 10, FORCE_TYPE_ALL, 8, DIR_UD)
  ELSE
    _OBJ_ANIME_AUTO( D31R0501_MUGENBOSS, 6, 10, FORCE_TYPE_ALL, 8, DIR_UD)
  ENDIF
  _OBJ_ANIME_WAIT()
 
  // メッセージ
  IF $LWK_D_VERSION == VERSION_B2 THEN
    $LWK_MSG_ID = msg_event_b_03_01_00
  ELSE
    $LWK_MSG_ID = msg_event_w_03_01_00
  ENDIF
  
  
  // 主人公の前まで移動
  IF $LWK_D_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( LWK_MSG_ID , D31R0601_MUGENBOSS, POS_DOWN )
  ELSE
    _BALLOONWIN_OBJMSG_POS( LWK_MSG_ID , D31R0501_MUGENBOSS, POS_DOWN )
  ENDIF
  _OBJ_ANIME_WAIT()
 
  _BALLOONWIN_CLOSE() 
  
  // 主人公よける
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 7, 11, FORCE_TYPE_NOT, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT() 

  // 画面外まで移動させる
  
  // 主人公の前まで移動
  IF $LWK_D_VERSION == VERSION_B2 THEN
    _OBJ_ANIME( D31R0601_MUGENBOSS, anm_move_down_7 )
  ELSE
    _OBJ_ANIME( D31R0501_MUGENBOSS, anm_move_down_7 )
  ENDIF
  _OBJ_ANIME_WAIT()
   
  // 主人公もどる
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 11, FORCE_TYPE_NOT, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT()
  
  // 非表示フラグセット
  _FLAG_SET( FV_D31R0601_MUGENBOSS_01 ) // リセット
  _FLAG_SET( FV_D31R0501_MUGENBOSS_01 ) // リセット
}
EVENT_END

//--------------------------------------------------------------------
// エリア到着イベント用モデル配置
//--------------------------------------------------------------------
add_arrival_model:
{
  // バージョンでの判断
	_INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
 
  // エリアIDを取得する
  _INFINITY_DUNGEON_GET_NOW_AREA_NO(LWK_NOW_AREA)
  
  // ROMバージョン
  _GET_ROM_VERSION ( LWK_ROM_VERSION )

  IF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_1 THEN
    _FLAG_CHECK( FE_INF_AREA1_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
    IF $SCWK_ANSWER == FALSE THEN 
	    IF $LWK_D_VERSION == VERSION_B2 THEN
        _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, BREEDERM, MV_DMY )
      ELSE
        _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, BREEDERW, MV_DMY )
      ENDIF
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA_ARRIVAL_TUTORIAL )
      _FLAG_SET( FE_INF_AREA1_ARRIVAL )
    ENDIF
  ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_2 THEN
    _FLAG_CHECK( FE_INF_AREA2_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
    IF $SCWK_ANSWER == FALSE THEN 
 	    IF $LWK_D_VERSION == VERSION_B2 THEN
        _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, BREEDERW, MV_DMY )
      ELSE
        _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, BREEDERM, MV_DMY )
      ENDIF
      _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA_ARRIVAL_TUTORIAL )
      _FLAG_SET( FE_INF_AREA2_ARRIVAL )
    ENDIF
  ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_3 THEN
    IF $LWK_ROM_VERSION == $LWK_D_VERSION THEN
      _FLAG_CHECK( FE_INF_AREA3_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
      IF $SCWK_ANSWER == FALSE THEN 
        _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA_ARRIVAL )
	      IF $LWK_D_VERSION == VERSION_B2 THEN
          _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, ASSISTANTM, MV_DMY )
        ELSE
          _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, FIGHTERM, MV_DMY )
        ENDIF
        _FLAG_SET( FE_INF_AREA3_ARRIVAL )
      ENDIF
    ENDIF
  ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_4 THEN
    IF $LWK_ROM_VERSION == $LWK_D_VERSION THEN
      _FLAG_CHECK( FE_INF_AREA4_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
      IF $SCWK_ANSWER == FALSE THEN 
        _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA_ARRIVAL )
	      IF $LWK_D_VERSION == VERSION_B2 THEN
          _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, ASSISTANTM, MV_DMY )
        ELSE
          _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, FIGHTERM, MV_DMY )
        ENDIF
        _FLAG_SET( FE_INF_AREA4_ARRIVAL )
      ENDIF
    ENDIF
  ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_5 THEN
      IF $LWK_ROM_VERSION == $LWK_D_VERSION THEN
      _FLAG_CHECK( FE_INF_AREA5_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
      IF $SCWK_ANSWER == FALSE THEN 
        _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA_ARRIVAL )
	      IF $LWK_D_VERSION == VERSION_B2 THEN
          _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, ASSISTANTM, MV_DMY )
        ELSE
          _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, FIGHTERM, MV_DMY )
        ENDIF
        _FLAG_SET( FE_INF_AREA5_ARRIVAL )
      ENDIF
    ENDIF
  ELSIF $LWK_NOW_AREA == INFINITY_DUNGEON_AREA_ID_6 THEN
    IF $LWK_ROM_VERSION == $LWK_D_VERSION THEN
      _FLAG_CHECK( FE_INF_AREA6_ARRIVAL, SCWK_ANSWER ) // 初めてのイベントか？
      IF $SCWK_ANSWER == FALSE THEN 
        _OBJ_ADD_EX( 6, 8, DIR_UP, MMDL_ID_EVENTOBJ_00, MUGENBOSS, MV_DMY )
        _RESERVE_SCRIPT( SCRID_INFINITY_DUNGEON_AREA_ARRIVAL )
        _FLAG_SET( FE_INF_AREA6_ARRIVAL )
      ENDIF
    ENDIF
  ENDIF

}
_RET

//--------------------------------------------------------------------
// 回復トレーナー
//--------------------------------------------------------------------
recover_trainer:
{
  DEFINE_LOCAL LWK_START_MSG_ID
  DEFINE_LOCAL LWK_CANCEL_MSG_ID
  DEFINE_LOCAL LWK_END_MSG_ID
  DEFINE_LOCAL LWK_IS_RECOVER

  // OBJID=LWK_TRID_POS
  $LWK_TRID_POS = $SCWK_TARGET_OBJID
 
  // メッセージタイプの判断(ナースorドクター)
  IF $SCWK_ANSWER == INF_SRC_MSG_TYPE_DOCTOR THEN
    $LWK_START_MSG_ID   = msg_doctor_msg_00
    $LWK_CANCEL_MSG_ID  = msg_doctor_msg_01
    $LWK_END_MSG_ID     = msg_doctor_msg_02
  ELSE
    $LWK_START_MSG_ID   = msg_nurse_msg_00
    $LWK_CANCEL_MSG_ID  = msg_nurse_msg_01
    $LWK_END_MSG_ID     = msg_nurse_msg_02
  ENDIF
 
  _TALK_OBJ_START()
 
  /// トレーナーID取得
  _INFINITY_DUNGEON_GET_TRID_BY_IDPOS( LWK_TRID_POS, LWK_TRID )
 
  // 回復済みか調べる
  _INFINITY_DUNGEON_GET_RECOVER_FLAG( LWK_TRID ,LWK_IS_RECOVER)
  IF $LWK_IS_RECOVER != TRUE THEN
  
    // メッセージ
    _BALLOONWIN_OBJMSG_POS( LWK_START_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )

    // YES_NO
    _YES_NO_WIN( SCWK_ANSWER )

    // 回復選択後
    IF $SCWK_ANSWER == SCR_YES THEN
      
      _BALLOONWIN_CLOSE()

      // 手持ちポケモン回復
      _CALL recover_temoti_poke

      // 回復後メッセージ
      _BALLOONWIN_OBJMSG_POS( LWK_END_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
      
      // 回復済みフラグを立てる
      _INFINITY_DUNGEON_SET_RECOVER_FLAG( LWK_TRID ,TRUE)
    ELSE
      // キャンセルメッセージ
      _BALLOONWIN_OBJMSG_POS( LWK_CANCEL_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()
    ENDIF
  ELSE
     // 回復後メッセージ
    _BALLOONWIN_OBJMSG_POS( LWK_END_MSG_ID , SCWK_TARGET_OBJID, POS_DOWN )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDIF
}
_RET

//--------------------------------------------------------------------
// アイテム入手
//--------------------------------------------------------------------
item_get:
{
  DEFINE_LOCAL  LWK_ITEM_MAX
  DEFINE_LOCAL  LWK_GET_NUM
  DEFINE_LOCAL  LWK_RND
  DEFINE_LOCAL  LWK_ITEM_ID_01
  DEFINE_LOCAL  LWK_ITEM_ID_02
  DEFINE_LOCAL  LWK_ITEM_ID_03
  DEFINE_LOCAL  LWK_ITEM_ID_04
  DEFINE_LOCAL  LWK_ITEM_ID_05
  DEFINE_LOCAL  LWK_ITEM_ID_06
 
  // この値がFALSEのときは、ランダム抽選、TRUEのときはフシギあめ
  $SCWK_ANSWER = FALSE

  // バージョンでの判断
	_INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )

  // エリアIDを取得する
  $LWK_NOW_AREA = $LWK_CLEAR_AREA_ID
  $LWK_NOW_AREA += 1
  
  // データ登録
  _PLAYER_NAME( 0 )
  _NUMBER( 1 ,  LWK_NOW_AREA , 2 )

  // クリアメッセージ
	IF $LWK_D_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_info_clear_b_01_00 , LWK_INFOOBJ_ID, POS_DOWN )
  ELSE 
    _BALLOONWIN_OBJMSG_POS( msg_info_clear_w_01_00 , LWK_INFOOBJ_ID, POS_DOWN )
  ENDIF

  // エリアごとのアイテム取得
  SWITCH $LWK_CLEAR_AREA_ID
   CASE 0 THEN
    $LWK_ITEM_ID_01 = ITEM_TAURIN
    $LWK_ITEM_ID_02 = ITEM_BUROMUHEKISIN
    $LWK_ITEM_ID_03 = ITEM_RIZOTIUMU
    $LWK_ITEM_ID_04 = ITEM_KITOSAN
    $LWK_ITEM_ID_05 = ITEM_INDOMETASIN
    $LWK_ITEM_MAX = 5
    $LWK_GET_NUM = 1
   CASE 1 THEN
    $LWK_ITEM_ID_01 = ITEM_TAURIN
    $LWK_ITEM_ID_02 = ITEM_BUROMUHEKISIN
    $LWK_ITEM_ID_03 = ITEM_RIZOTIUMU
    $LWK_ITEM_ID_04 = ITEM_KITOSAN
    $LWK_ITEM_ID_05 = ITEM_INDOMETASIN
    $LWK_ITEM_MAX = 5
    $LWK_GET_NUM = 1
   CASE 2 THEN
    $LWK_ITEM_ID_01 = ITEM_TAURIN
    $LWK_ITEM_ID_02 = ITEM_BUROMUHEKISIN
    $LWK_ITEM_ID_03 = ITEM_RIZOTIUMU
    $LWK_ITEM_ID_04 = ITEM_KITOSAN
    $LWK_ITEM_ID_05 = ITEM_INDOMETASIN
    $LWK_ITEM_MAX = 5
    $LWK_GET_NUM = 2
   CASE 3 THEN
    $LWK_ITEM_ID_01 = ITEM_TAURIN
    $LWK_ITEM_ID_02 = ITEM_BUROMUHEKISIN
    $LWK_ITEM_ID_03 = ITEM_RIZOTIUMU
    $LWK_ITEM_ID_04 = ITEM_KITOSAN
    $LWK_ITEM_ID_05 = ITEM_INDOMETASIN
    $LWK_ITEM_MAX = 5
    $LWK_GET_NUM = 2
   CASE 4 THEN
    $LWK_ITEM_ID_01 = ITEM_TAURIN
    $LWK_ITEM_ID_02 = ITEM_BUROMUHEKISIN
    $LWK_ITEM_ID_03 = ITEM_RIZOTIUMU
    $LWK_ITEM_ID_04 = ITEM_KITOSAN
    $LWK_ITEM_ID_05 = ITEM_INDOMETASIN
    $LWK_ITEM_MAX = 5
    $LWK_GET_NUM = 2
   CASE 5 THEN
    $LWK_ITEM_ID_01 = ITEM_ZAROKUNOMI
    $LWK_ITEM_ID_02 = ITEM_NEKOBUNOMI
    $LWK_ITEM_ID_03 = ITEM_TAPORUNOMI
    $LWK_ITEM_ID_04 = ITEM_ROMENOMI
    $LWK_ITEM_ID_05 = ITEM_UBUNOMI
    $LWK_ITEM_ID_06 = ITEM_MATOMANOMI
    $LWK_ITEM_MAX = 6
    $LWK_GET_NUM = 1
    // あめ判定
    _GET_RND( LWK_RND, 10 )
    IF $LWK_RND == 0 THEN
      $SCWK_ANSWER = TRUE 
    ENDIF
   CASE 6 THEN
    $LWK_ITEM_ID_01 = ITEM_ZAROKUNOMI
    $LWK_ITEM_ID_02 = ITEM_NEKOBUNOMI
    $LWK_ITEM_ID_03 = ITEM_TAPORUNOMI
    $LWK_ITEM_ID_04 = ITEM_ROMENOMI
    $LWK_ITEM_ID_05 = ITEM_UBUNOMI
    $LWK_ITEM_ID_06 = ITEM_MATOMANOMI
    $LWK_ITEM_MAX = 6
    $LWK_GET_NUM = 1
    // あめ判定
    _GET_RND( LWK_RND, 10 )
    IF $LWK_RND == 0 THEN
      $SCWK_ANSWER = TRUE 
    ENDIF
   CASE 7 THEN
    $LWK_ITEM_ID_01 = ITEM_ZAROKUNOMI
    $LWK_ITEM_ID_02 = ITEM_NEKOBUNOMI
    $LWK_ITEM_ID_03 = ITEM_TAPORUNOMI
    $LWK_ITEM_ID_04 = ITEM_ROMENOMI
    $LWK_ITEM_ID_05 = ITEM_UBUNOMI
    $LWK_ITEM_ID_06 = ITEM_MATOMANOMI
    $LWK_ITEM_MAX = 6
    $LWK_GET_NUM = 1
    // あめ判定
    _GET_RND( LWK_RND, 10 )
    IF $LWK_RND == 0 THEN
      $SCWK_ANSWER = TRUE 
    ENDIF
   CASE 8 THEN
    $LWK_ITEM_ID_01 = ITEM_ZAROKUNOMI
    $LWK_ITEM_ID_02 = ITEM_NEKOBUNOMI
    $LWK_ITEM_ID_03 = ITEM_TAPORUNOMI
    $LWK_ITEM_ID_04 = ITEM_ROMENOMI
    $LWK_ITEM_ID_05 = ITEM_UBUNOMI
    $LWK_ITEM_ID_06 = ITEM_MATOMANOMI
    $LWK_ITEM_MAX = 6
    $LWK_GET_NUM = 2
    // あめ判定
    _GET_RND( LWK_RND, 10 )
    IF $LWK_RND == 0 THEN
      $SCWK_ANSWER = TRUE 
    ENDIF
   CASE 9 THEN
    $LWK_ITEM_ID_01 = ITEM_ZAROKUNOMI
    $LWK_ITEM_ID_02 = ITEM_NEKOBUNOMI
    $LWK_ITEM_ID_03 = ITEM_TAPORUNOMI
    $LWK_ITEM_ID_04 = ITEM_ROMENOMI
    $LWK_ITEM_ID_05 = ITEM_UBUNOMI
    $LWK_ITEM_ID_06 = ITEM_MATOMANOMI
    $LWK_ITEM_MAX = 6
    $LWK_GET_NUM = 2
    // あめ判定
    _GET_RND( LWK_RND, 10 )
    IF $LWK_RND == 0 THEN
      $SCWK_ANSWER = TRUE 
    ENDIF
  ENDSWITCH


 
  // ウィンドウを閉じておく
	_BALLOONWIN_CLOSE()

  IF  $SCWK_ANSWER == TRUE THEN
    _ITEM_EVENT_KEYWAIT( ITEM_HUSIGINAAME , LWK_GET_NUM  )
  ELSE
   // アイテム入手
    _GET_RND( LWK_RND, LWK_ITEM_MAX )
    SWITCH $LWK_RND
    CASE 0 THEN
      _ITEM_EVENT_KEYWAIT( LWK_ITEM_ID_01 , LWK_GET_NUM  )
    CASE 1 THEN
      _ITEM_EVENT_KEYWAIT( LWK_ITEM_ID_02 , LWK_GET_NUM  )
    CASE 2 THEN
      _ITEM_EVENT_KEYWAIT( LWK_ITEM_ID_03 , LWK_GET_NUM  )
    CASE 3 THEN
      _ITEM_EVENT_KEYWAIT( LWK_ITEM_ID_04 , LWK_GET_NUM  )
    CASE 4 THEN
      _ITEM_EVENT_KEYWAIT( LWK_ITEM_ID_05 , LWK_GET_NUM  )
    CASE 5 THEN
      _ITEM_EVENT_KEYWAIT( LWK_ITEM_ID_06 , LWK_GET_NUM  )
    ENDSWITCH
  ENDIF
  
}
_RET

//--------------------------------------------------------------------
// 全エリアクリア
//--------------------------------------------------------------------
all_area_clear:
{
  // 自分のバージョンの色のエリアをクリアした判定
  IF $LWK_ROM_VERSION == $LWK_D_VERSION THEN

    // クリアフラグをセット
    $WK_SCENE_MUGENDUNGEON_CLEAR = 1
    _FLAG_RESET( FV_T06R0101_MUGENBOSS_01 )

    // 自分の名前をセット
    _PLAYER_NAME( 0 )

    // 全エリアクリアメッセージ
    IF $LWK_D_VERSION == VERSION_B2 THEN
      _BALLOONWIN_OBJMSG_POS( msg_info_clear_b_06_00 , LWK_INFOOBJ_ID, POS_DOWN )
      _BALLOONWIN_CLOSE()
      _ITEM_EVENT_KEYWAIT( ITEM_HUSIGINAAME , 1  )
      _BALLOONWIN_OBJMSG_POS( msg_info_clear_b_07_00 , LWK_INFOOBJ_ID, POS_DOWN )
      _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , LWK_INFOOBJ_ID, POS_DL )
    ELSE 
      _BALLOONWIN_OBJMSG_POS( msg_info_clear_w_06_00 , LWK_INFOOBJ_ID, POS_DOWN )
      _BALLOONWIN_CLOSE()
      _ITEM_EVENT_KEYWAIT( ITEM_HUSIGINAAME , 1  )
      _BALLOONWIN_OBJMSG_POS( msg_info_clear_w_07_00 , LWK_INFOOBJ_ID, POS_DOWN )
      _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , LWK_INFOOBJ_ID, POS_DL )
    ENDIF
  ELSE
    _CALL item_get
    IF $LWK_D_VERSION == VERSION_B2 THEN
      _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , LWK_INFOOBJ_ID, POS_DOWN )
    ELSE
      _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , LWK_INFOOBJ_ID, POS_DOWN )
    ENDIF
  ENDIF

  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()
}
_RET

//--------------------------------------------------------------------
// エリア初回クリア
//--------------------------------------------------------------------
area_first_clear:
{
  _INFINITY_DUNGEON_GET_VERSION( LWK_D_VERSION )
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )
  $LWK_DUNGEON_STATUS += 1

  // クリアメッセージ
  _NUMBER( 0 ,  LWK_DUNGEON_STATUS , 2 )

  IF $LWK_D_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_info_clear_b_02_00 , LWK_INFOOBJ_ID, POS_DOWN )
    _BALLOONWIN_OBJMSG_POS( msg_info_b_cancel_00 , LWK_INFOOBJ_ID, POS_DL )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_info_clear_w_02_00 , LWK_INFOOBJ_ID, POS_DOWN )
    _BALLOONWIN_OBJMSG_POS( msg_info_w_cancel_00 , LWK_INFOOBJ_ID, POS_DL )
  ENDIF

  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()
}
_RET

