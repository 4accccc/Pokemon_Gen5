/**************************************************************/
/*                                                            */
/**************************************************************/
EVENT_START   ev_debug_ichiraku

	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_1,   1 ) // 自動歩行
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_2,   2 ) // 捕獲デモ
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_3,   3 ) // ライバル名入力
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_4,   4 ) // ライバル名表示
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_5,   5 ) // ぎょえ
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_6,   6 ) // わざおしえショップ
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_7,   7 ) // アジト船パスワード入力(ゾーン限定)
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_8,   8 ) // TV番組
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_9,   9 ) // キュレム戦
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_10,  10 ) // 観覧車トレーナーリセット
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_11,  11 ) // 背景真っ黒のままメッセージ
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_12,  12 ) // キュレム合体イベントリセット
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_13,  13 ) // キュレム合体したあと
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_14,  14 ) // コバルオン入退場
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_15,  15 ) // キュレムデモ 覚醒
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_16,  16 ) // キュレムデモ 登場
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_17,  17 ) // PWTのカメラ合わせ
	_BMPMENU_MAKE_LIST( msg_debug_ichiraku_18,  18 ) // エンディング　花火
	_BMPMENU_START()

  SWITCH $SCWK_ANSWER
  CASE 1 THEN
    //ローカル変数を定義
    DEFINE_LOCAL	LWK_HERO_X
    DEFINE_LOCAL	LWK_HERO_Z
    //自機の位置取得
    _PLAYER_POS_GET( LWK_HERO_X,LWK_HERO_Z )
    $LWK_HERO_X -= 5
    $LWK_HERO_Z -= 5
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, LWK_HERO_X, LWK_HERO_Z, FORCE_TYPE_NOT, 8, DIR_UD)
    _OBJ_ANIME_WAIT()
    $LWK_HERO_X += 5
    $LWK_HERO_Z += 5
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, LWK_HERO_X, LWK_HERO_Z, FORCE_TYPE_NPC, 8, DIR_UD)
    _OBJ_ANIME_WAIT()
    $LWK_HERO_X -= 5
    $LWK_HERO_Z -= 5
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, LWK_HERO_X, LWK_HERO_Z, FORCE_TYPE_MAP, 8, DIR_UD)
    _OBJ_ANIME_WAIT()
    $LWK_HERO_X += 5
    $LWK_HERO_Z += 5
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, LWK_HERO_X, LWK_HERO_Z, FORCE_TYPE_ALL, 8, DIR_UD)
    _OBJ_ANIME_WAIT()
  CASE 2 THEN
    _CAPTURE_DEMO_SET()
    _WILD_WIN()
  CASE 3 THEN
    DEFINE_LOCAL ret
    _RIVAL_NAME_INPUT( ret )
    _DEBUG_PRINT_WK( ret )
  CASE 4 THEN
    _RIVAL_NAME(0)
    _PLAINWIN_MSG_DOWN( msg_debug_ichiraku_4_a )
	  _LAST_KEYWAIT()	
	  _PLAINWIN_CLOSE()
  CASE 5 THEN
    // !アイコン表示
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_tr_gyoe )
		_OBJ_ANIME_WAIT()
  CASE 6 THEN
    _WAZA_OSHIE_RED_SHOP_CALL_GREETING_LESS()
  CASE 7 THEN
    _HIDE_SHIP_PASSWORD_INPUT( SCWK_ANSWER )
    _DEBUG_PRINT_WK( SCWK_ANSWER )
  CASE 8 THEN
    _GLOBAL_CALL  SCRID_TV
  CASE 9 THEN
    {
    // キュレム戦
    DEFINE_LOCAL LWK_BATTLE_FLAG
    DEFINE_LOCAL LCWK_VERSION

    // ROMバージョン取得
    _GET_ROM_VERSION( LCWK_VERSION )
    
    // 専用背景、伝説系、レアなし、捕獲不可
    $LWK_BATTLE_FLAG = SCR_WILD_BTL_FLAG_KYUREMU
    $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_LEGEND
    $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_NO_RARE

    // 野生戦
    IF $LCWK_VERSION == VERSION_B2 THEN
      //ブラック
      //キュロム
      _WILD_BTL_SET_EX2( MONSNO_653, 50, FORMNO_653_BLACK, LWK_BATTLE_FLAG )
    ELSE
      //ホワイト
      //キュラム
      _WILD_BTL_SET_EX2( MONSNO_653, 50, FORMNO_653_WHITE, LWK_BATTLE_FLAG )
    ENDIF

    _WILD_LOSE_CHECK( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った
      _WILD_WIN()
    ELSE
      _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
    ENDIF
    }

  CASE 10 THEN
    // 観覧車トレーナー
		_FLAG_RESET( TMFLG_AMUSEMENT_TR_BTL )
		_FLAG_RESET( TMFLG_AMUSEMENT_NPC )
    _SET_ZENKOKU_ZUKAN_FLAG()

  CASE 11 THEN
    // メッセージ面以外のフェード
    _MAP_FADE_OUT_MSG_ENABLE( MSG_FADE_WHITE, 0 )
    _TIME_WAIT(15)
    _RIVAL_NAME(0)
    _PLAINWIN_MSG_DOWN( msg_debug_ichiraku_4_a )
	  _LAST_KEYWAIT()	
	  _PLAINWIN_CLOSE()
    _MAP_FADE_IN_MSG_ENABLE( MSG_FADE_WHITE, 0 )

  CASE 12 THEN
    // キュレム合体イベントリセット
    _FLAG_SET( FV_D10R0401_BOSS_01 )
    _FLAG_RESET( FV_D10R0401_POKE_01 )
    _FLAG_SET( FV_D10R0401_POKE_02 )
    _FLAG_SET( FV_D10R0401_POKE_03 )
    $WK_SCENE_D10R0401_SWSAGE1_01 = 1

    _MAP_CHANGE( ZONE_ID_D10R0401, 16, 4, DIR_UP )

  CASE 13 THEN
    // キュレム合体したあと
    // N表示
    _FLAG_RESET( FV_D10R0401_BOSS_01 )
    //キュラム・キュロム表示
    _FLAG_RESET( FV_D10R0401_POKE_03 )
    //キュレム非表示
    _FLAG_SET( FV_D10R0401_POKE_01 )
    //SCENE_CHANGE無効
    $WK_SCENE_D10R0401_SWSAGE1_01 = 2

    _MAP_CHANGE( ZONE_ID_D10R0501, 15, 19, DIR_UP )

  CASE 14 THEN
    // コバルオンイベント
    {

      // コバルオンOBJ生成
      _OBJ_ADD_EX( 103, 364, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE4_STEP, MV_DMY )

      // 鳴き声を鳴らす
      // voice_play

      // 移動ポケモンアニメ作成
      _EV_MOVEPOKE_CREATE( MMDL_ID_EVENTOBJ_00 )
    
      // 登場アニメ
      _EV_MOVEPOKE_START_ANIME( SCR_EV_MOVEPOKE_ANIME_KOBARUON_IN )
      _EV_MOVEPOKE_CHECK_ANIME_END()

      // なんかしゃべる?
      _TIME_WAIT(60)

      // 退場アニメ
      _EV_MOVEPOKE_START_ANIME( SCR_EV_MOVEPOKE_ANIME_KOBARUON_OUT )
      _EV_MOVEPOKE_CHECK_ANIME_END()

      // 移動ポケモンアニメ破棄
      _EV_MOVEPOKE_DELETE()

      // コバルオンOBJ削除
      _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
    }

  CASE 15 THEN
    {
    DEFINE_LOCAL LCWK_VERSION
    _GET_ROM_VERSION( LCWK_VERSION )

    // キュレムデモ　覚醒
	  _DEMO_FADEOUT_BLACK_CALL()
    _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_00 )

	  IF $LCWK_VERSION == VERSION_B2 THEN
      _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_B_01 )
    ELSE
      _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_W_01 )
    ENDIF
	  _DEMO_FADEIN_BLACK_CALL()
    }
  CASE 16 THEN
    {
      DEFINE_LOCAL LCWK_VERSION

      _GET_ROM_VERSION( LCWK_VERSION )

      // キュレムデモ　登場
	    _DEMO_FADEOUT_BLACK_CALL()

	    IF $LCWK_VERSION == VERSION_B2 THEN
        _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_B_02 )
        _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_B_03 )
      ELSE
        _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_W_02 )
        _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_W_03 )
      ENDIF
	    _DEMO_FADEIN_BLACK_CALL()
    }

  CASE 17 THEN
    {
      //カメラ移動・中央固定　
      _CAMERA_START()		//カメラ操作開始
      _CAMERA_PURGE()		//カメラのバインドを解く

      //カメラ操作　ステージ中央にカメラを合わせる
      _CAMERA_MOVE( 2008,0,1036288,1515520,131103,946176,1 )	//一番最後の引数は移動にかかるフレーム数
      _CAMERA_WAIT_MOVE()

      _OBJ_ADD_EX( 20, 15, DIR_RIGHT, MMDL_ID_EVENTOBJ_00, RGLEADER3, MV_DMY )

      _CAMERA_END()
    }
  CASE 18 THEN
    _MAP_FADE_BLACK_OUT_SLOW()
    _MAP_FADE_END_CHECK()
    _MAP_CHANGE_NO_FADE( ZONE_ID_C09P03, 31, 47, 1, DIR_DOWN )
    _GLOBAL_CALL  SCRID_C09P03_ENDING
    _MAP_CHANGE_NO_FADE( ZONE_ID_C09P03, 31, 47, 1, DIR_DOWN )
    _MAP_FADE_BLACK_IN()
    _MAP_FADE_END_CHECK()

  ENDSWITCH

EVENT_END
//--------------------------------------------------------------
//	トレーナー[!]マーク
//--------------------------------------------------------------
_ANIME_LABEL	anm_tr_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	下向く
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

