	$SCWK_TEMP0 = 0
	
	WHILE $SCWK_TEMP0 != 555
		
		//メニュー作成
		_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
		//リスト追加
		_BMPMENU_MAKE_LIST( msg_debug_suginaka_21, 72 )	//ゾロアーク不具合対処
		_BMPMENU_MAKE_LIST( msg_debug_common_00, 0 )	//シナリオクリア
		_BMPMENU_MAKE_LIST( msg_debug_common_04, 1 )	//殿堂入り
		_BMPMENU_MAKE_LIST( msg_debug_common_01, 10 )	//ジムバッジ全部
		_BMPMENU_MAKE_LIST( msg_debug_common_02, 20 )	//到着フラグ
		_BMPMENU_MAKE_LIST( msg_debug_08, 70 )	//イベントジャンプ
		_BMPMENU_MAKE_LIST( msg_debug_05, 80 )	//イベントＯＦＦ
		_BMPMENU_MAKE_LIST( msg_debug_07, 90 )	//マップ差し替え
