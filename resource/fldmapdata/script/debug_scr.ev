/************************************************************/
/*				斉藤マのデバッグメニュー					*/
/************************************************************/
EVENT_START ev_debug_masafumi
	$SCWK_TEMP0 = 0
	$SCWK_TEMP1 = 0
	
	//メニュー作成
	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_TEMP1 )
	//リスト追加
	_BMPMENU_MAKE_LIST( msg_debug_01, 1 )	//テスト01
	_BMPMENU_MAKE_LIST( msg_debug_02, 2 )	//テスト02
	_BMPMENU_MAKE_LIST( msg_debug_03, 3 )	//テスト03
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_13, 4 )	//観覧車トレーナー
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_14, 5 )	//カナワタウン
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_05, 0 )	//四天王部屋
	_BMPMENU_MAKE_LIST( msg_debug_00, 10 )	//やめる
	//メニュー表示
	_BMPMENU_START()
	
	IF $SCWK_TEMP1 == 0 THEN
		_CALL	ev_bigfour_menu	//四天王部屋

	ELSIF $SCWK_TEMP1 == 1 THEN
		_FLAG_SET( SYS_FLAG_WEATHER_R07 )

	ELSIF $SCWK_TEMP1 == 2 THEN
		//テスト02

		$WK_SYS_FIRST_POKETYPE = FIRST_POKETYPE_MIZU

	ELSIF $SCWK_TEMP1 == 3 THEN

		_SUBWIN_MSG( msg_debug_masafumi_15, 10, 10, 1 )
		_AB_KEYWAIT()
		_SUBWIN_CLOSE( 1 )
		
	ELSIF $SCWK_TEMP1 == 4 THEN
		//観覧車トレーナー
		//_FLAG_RESET( TMFLG_AMUSEMENT_TR_BTL )
		//_FLAG_RESET( FV_AMUSEMENT_TRAINER )
		_MAP_CHANGE( ZONE_ID_C04P01, 52, 15, DIR_RIGHT )
 
	ELSIF $SCWK_TEMP1 == 5 THEN
		//カナワタウンの転車台に配置される車両を変更
		_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_01, 1 )	//シングル
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_02, 2 )	//Ｓシングル
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_03, 3 )	//ダブル
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_04, 4 )	//Ｓダブル
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_05, 5 )	//マルチ
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_06, 6 )	//Ｓマルチ
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_07, 7 )	//Wi-Fi
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_08, 8 )	//カナワ行き
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_09, 9 )	//古いレア
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_10, 10 )	//新しいレア
		_BMPMENU_MAKE_LIST( msg_debug_01, 0 )	//テスト01（車両なし）
		_BMPMENU_MAKE_LIST( msg_debug_00, 100 )	//やめる
		_BMPMENU_START()
		
		SWITCH $SCWK_ANSWER
		CASE 0 THEN
			$WK_OTHER_T05_TRAIN = 0
		CASE 1 THEN
			$WK_OTHER_T05_TRAIN = 1
		CASE 2 THEN
			$WK_OTHER_T05_TRAIN = 2
		CASE 3 THEN
			$WK_OTHER_T05_TRAIN = 3
		CASE 4 THEN
			$WK_OTHER_T05_TRAIN = 4
		CASE 5 THEN
			$WK_OTHER_T05_TRAIN = 5
		CASE 6 THEN
			$WK_OTHER_T05_TRAIN = 6
		CASE 7 THEN
			$WK_OTHER_T05_TRAIN = 7
		CASE 8 THEN
			$WK_OTHER_T05_TRAIN = 8
		CASE 9 THEN
			$WK_OTHER_T05_TRAIN = 9
		CASE 10 THEN
			$WK_OTHER_T05_TRAIN = 10
		ENDSWITCH
		
		IF $SCWK_ANSWER <= 10 THEN
			_MAP_CHANGE( ZONE_ID_T05, 25, 38, DIR_UP )
		ENDIF
		
	ENDIF
	
EVENT_END


//四天王部屋デバッグメニュー------------------------------------
ev_bigfour_menu:
	//メニュー作成
	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
	//リスト追加
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_07, 0 )	//勝利フラグ
	_BMPMENU_MAKE_LIST( msg_debug_04, 1 )	//ジャンプ ※階段前にジャンプ（アニメチェック用）
	_BMPMENU_MAKE_LIST( msg_debug_00, 10 )	//やめる
	//メニュー表示
	_BMPMENU_START()

	IF $SCWK_ANSWER == 0 THEN
		
		WHILE $SCWK_TEMP0 != 111
		
			_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_PARAM0 )
			_BMPMENU_MAKE_LIST( msg_debug_masafumi_01, 0 )	//ゴースト
			_BMPMENU_MAKE_LIST( msg_debug_masafumi_02, 1 )	//あく
			_BMPMENU_MAKE_LIST( msg_debug_masafumi_03, 2 )	//かくとう
			_BMPMENU_MAKE_LIST( msg_debug_masafumi_04, 3 )	//エスパー
			_BMPMENU_MAKE_LIST( msg_debug_00, 10 )	//やめる
			_BMPMENU_START()
			
			IF $SCWK_PARAM0 == 0 THEN
				_FLAG_SET( SYS_FLAG_BIGFOUR_GHOSTWIN )
			ELSIF $SCWK_PARAM0 == 1 THEN
				_FLAG_SET( SYS_FLAG_BIGFOUR_EVILWIN )
			ELSIF $SCWK_PARAM0 == 2 THEN
				_FLAG_SET( SYS_FLAG_BIGFOUR_FIGHTWIN )
			ELSIF $SCWK_PARAM0 == 3 THEN
				_FLAG_SET( SYS_FLAG_BIGFOUR_ESPWIN )
			ELSE
				$SCWK_TEMP0 = 111
			ENDIF
		
		ENDWHILE
		
	ELSIF $SCWK_ANSWER == 1 THEN
		
		
		_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_PARAM0 )
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_01, 0 )	//ゴースト
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_02, 1 )	//あく
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_03, 2 )	//かくとう
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_04, 3 )	//エスパー
		_BMPMENU_START()
		
		IF $SCWK_PARAM0 == 0 THEN
			_MAP_CHANGE( ZONE_ID_C09R0101, 15, 28, DIR_DOWN )
		ELSIF $SCWK_PARAM0 == 1 THEN
			_MAP_CHANGE( ZONE_ID_C09R0201, 15, 28, DIR_DOWN )
		ELSIF $SCWK_PARAM0 == 2 THEN
			_MAP_CHANGE( ZONE_ID_C09R0301, 15, 28, DIR_DOWN )
		ELSIF $SCWK_PARAM0 == 3 THEN
			_MAP_CHANGE( ZONE_ID_C09R0401, 15, 28, DIR_DOWN )
		ENDIF
		
		
	ENDIF

_RET


/**************************************************************/
/* MIZUGUCHI                                                  */
/**************************************************************/
EVENT_START   ev_debug_mizuguchi

		$SCWK_TEMP2 = 0
		//メニュー作成
		_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, SCWK_TEMP2 )
		//リスト追加
		_BMPMENU_MAKE_LIST( msg_debug_mizu_01, 0 )	//C03到着
		_BMPMENU_MAKE_LIST( msg_debug_mizu_02, 1 )	//C03P17開始
		_BMPMENU_MAKE_LIST( msg_debug_mizu_03, 2 )	//ジムクリア
		_BMPMENU_MAKE_LIST( msg_debug_mizu_04, 3 )	//R04アクロマ初期化
		_BMPMENU_MAKE_LIST( msg_debug_mizu_05, 4 )	//D07R0401イベント初期化
		_BMPMENU_MAKE_LIST( msg_debug_mizu_06, 5 )	//C03R0301イベント初期化
		_BMPMENU_MAKE_LIST( msg_debug_mizu_07, 6 )	//C08初期化
		//メニュー表示
		_BMPMENU_START()
	
		IF $SCWK_TEMP2 == 0 THEN
			//C03イベント開始
			$WK_SCENE_C03P15 = 1
			_MAP_CHANGE( ZONE_ID_C03P15, 12, 10, DIR_LEFT )
		ELSIF $SCWK_TEMP2 == 1 THEN
		   $WK_SCENE_C03P17 = 1
			_FLAG_SET( FV_C03P17_SWRIVAL_01 )
			_FLAG_RESET( FV_C03P17_SWCHAMPION_01 )
			_FLAG_RESET( FV_C03P17_PILOT_01 )
			_MAP_CHANGE( ZONE_ID_C03P17, 2, 14, DIR_RIGHT )
		ELSIF $SCWK_TEMP2 == 2 THEN
			//ジムクリア
			$WK_SCENE_C03P01 = 1
			_FLAG_RESET( FV_C03P01_SWBOSS_01 )
			_MAP_CHANGE( ZONE_ID_C03P01, 21, 7, DIR_LEFT )
		ELSIF $SCWK_TEMP2 == 3 THEN
			//C03P01アクロマイベント終了
			$WK_SCENE_R04_SWBOSS = 1
			_FLAG_RESET( FV_R04_SWBOSS_01 )
			_FLAG_RESET( FV_R04_BIGROCK_01 )
			_MAP_CHANGE( ZONE_ID_R04, 430, 589, DIR_LEFT )
		ELSIF $SCWK_TEMP2 == 4 THEN

		ELSIF $SCWK_TEMP2 == 5 THEN
				$WK_SCENE_C04GYM0101_SHOWEND = 1
		ELSIF $SCWK_TEMP2 == 6 THEN
		    //C12のSCENE_CHANGE起動
	      $WK_SCENE_C12_WHITE_MEET = 5
	      
	      //C12PC0101のベルを非表示
	      _FLAG_SET( FV_C12PC0101_SWBELL )
	      
	      //C12のママと妹を表示
	      _FLAG_RESET( FV_C12_SWRIVAL_SISTER )
	      _FLAG_RESET( FV_C12_SWMAMA )
		ELSIF $SCWK_TEMP2 == 7 THEN
		    $WK_SCENE_MEDAL_EVENT = 4
		ELSE
			//C04R0101でんきジム実験
			$WK_SCENE_C04GYM0101_SHOWEND = 1
		ENDIF
	
EVENT_END

/**************************************************************/
/*				杉中のデバッグメニュー						  */
/**************************************************************/
EVENT_START   ev_debug_suginaka
	$SCWK_TEMP0 = 0
	
	WHILE $SCWK_TEMP0 != 428

		//メニュー作成
		_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
		//リスト追加
		_BMPMENU_MAKE_LIST( msg_debug_suginaka_04, 0 )	//ＷＢＴ１回戦
		_BMPMENU_MAKE_LIST( msg_debug_suginaka_05, 1 )	//ＷＢＴ２回戦
		_BMPMENU_MAKE_LIST( msg_debug_suginaka_06, 2 )	//ＷＢＴ決勝戦
		_BMPMENU_MAKE_LIST( msg_debug_suginaka_07, 3 )	//Ｃ１３ネオプラズマ団イベント
		//_BMPMENU_MAKE_LIST( msg_debug_suginaka_09, 5 )	//D02プラズマ団
		//_BMPMENU_MAKE_LIST( msg_debug_suginaka_12, 6 )	//C03のゲーチスイベント
		//_BMPMENU_MAKE_LIST( msg_debug_suginaka_07, 80 )		//ラストイベント１・はじめから
		//_BMPMENU_MAKE_LIST( msg_debug_suginaka_08, 90 )		//ラストイベント２・伝説捕獲前
		//_BMPMENU_MAKE_LIST( msg_debug_suginaka_10, 100 )	//ラストイベント３・Ｎ戦前
		//_BMPMENU_MAKE_LIST( msg_debug_suginaka_13, 110 )	//ラストイベント４・ゲーチス戦前
		_BMPMENU_MAKE_LIST( msg_debug_00, 800 )	//やめる
		//メニュー表示
		_BMPMENU_START()
	
		IF $SCWK_ANSWER == 0 THEN
      //↓↓↓　本当は受付で行う初期化処理をデバッグ用にここで呼び出し
      _WBT_SYSTEM_START()
      _WBT_SET_TOURNAMENT_TYPE( SCR_WBT_TYPE_ALL )
      _WBT_SET_BATTLE_RULE( SCR_WBT_RULE_SINGLE )
      _WBT_SYSTEM_ENTRY()
      //↑↑↑　本当は受付で行う初期化処理をデバッグ用にここで呼び出し
			//予約スクリプト
			_RESERVE_SCRIPT( SCRID_WBT_HALL_01 )
	
			//マップチェンジ
      _MAP_FADE_BLACK_OUT_SLOW()
      _MAP_FADE_END_CHECK()
			_MAP_CHANGE_NO_FADE( ZONE_ID_D05R0201, 31, 0, 15, DIR_LEFT )
			
			$SCWK_TEMP0 = 428
		
		ELSIF $SCWK_ANSWER == 1 THEN
			
			//予約スクリプト
			_RESERVE_SCRIPT( SCRID_DEBUG_WBT_SECOND_GAME )
	
			//マップチェンジ
			_MAP_CHANGE( ZONE_ID_D05R0201, 31, 15, DIR_LEFT )
			
			$SCWK_TEMP0 = 428
			
		ELSIF $SCWK_ANSWER == 2 THEN
		
			//予約スクリプト
			_RESERVE_SCRIPT( SCRID_DEBUG_WBT_FINAL_GAME )
	
			//マップチェンジ
			_MAP_CHANGE( ZONE_ID_D05R0201, 31, 15, DIR_LEFT )
			
			$SCWK_TEMP0 = 428
			
		ELSIF $SCWK_ANSWER == 3 THEN
			//C13：ネオプラズマ団イベント
			$WK_SCENE_C13 = 5

			_FLAG_RESET( FV_C13_SWPLAZMA )	//ネオプラズマ団イベント用　表示

			$SCWK_TEMP0 = 428

			//マップチェンジ
			_MAP_CHANGE( ZONE_ID_C13, 237, 670, DIR_RIGHT )

		ELSIF $SCWK_ANSWER == 6 THEN
		
			//プラズマ団イベント終了
			//$WK_SCENE_C03P07 = 3
		
			//ビル内にゲーチスその他出現＆イベント開始
			//$WK_SCENE_C03R1101 = 1
			//_FLAG_RESET( FV_C03R1101_PLASMA )
		
			//C03P07のイベント関連OBJフラグセット
			//_FLAG_SET( FV_C03P07_SUPPORT_LEADER8 )
			//_FLAG_SET( FV_C03P07_PLASMA_LEADER3 )
		
			//C03P15からアイリス・サポート削除
			//_FLAG_SET( FV_C03P15_SUPPORT_LEADER8 )

			$SCWK_TEMP0 = 428

			//マップチェンジ
			_MAP_CHANGE( ZONE_ID_C03P07, 9, 33, DIR_LEFT )
		
		ELSIF $SCWK_ANSWER == 80 THEN
			//ラストシーン・はじめから
			//OBJ調整
			//_FLAG_SET( FV_N01R0502_LEGEND_01 )
			//_FLAG_SET( FV_N01R0502_LEGEND_02 )
			//_FLAG_SET( FV_N01R0502_EVENT_01 )

			//ワークを０に
			//$WK_SCENE_N01R0502 = 0

			//マップチェンジ
			_MAP_CHANGE( ZONE_ID_N01R0502, 16, 58, DIR_UP )
			
			$SCWK_TEMP0 = 428
	
		ELSIF $SCWK_ANSWER == 90 THEN
			//ラストシーン・伝説捕獲前
			//OBJ調整
			//_FLAG_RESET( FV_N01R0502_LEGEND_01 )
			//_FLAG_RESET( FV_N01R0502_LEGEND_02 )
			//_FLAG_SET( FV_N01R0502_EVENT_01 )

			//謁見の間、水が干上がった状態のマップに変更
			_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, TRUE, TRUE )

			//ワークを２に
			//$WK_SCENE_N01R0502 = 2
		
			_MAP_CHANGE( ZONE_ID_N01R0502, 16, 45, DIR_UP )
			
			$SCWK_TEMP0 = 428
	
		ELSIF $SCWK_ANSWER == 100 THEN
			//ラストシーン・Ｎ戦前
			//OBJ調整
			//_FLAG_RESET( FV_N01R0502_LEGEND_01 )	//Nの伝説
			//_FLAG_SET( FV_N01R0502_LEGEND_02 )	//自機の伝説
			//_FLAG_SET( FV_N01R0502_EVENT_01 )

			//謁見の間、水が干上がった状態のマップに変更
			_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, TRUE, TRUE )

			//ワークを３に
			//$WK_SCENE_N01R0502 = 3
		
			_MAP_CHANGE( ZONE_ID_N01R0502, 16, 45, DIR_UP )
			
			$SCWK_TEMP0 = 428
		
		ELSIF $SCWK_ANSWER == 110 THEN
			//ラストシーン・ゲーチス戦前
			//OBJセット
			//_FLAG_SET( FV_C09R0501_RIVAL_01 )
			//_FLAG_SET( FV_C09R0501_CHAMPION_01 )
			//_FLAG_SET( FV_N01R0501_SAGE1 )
			//_FLAG_RESET( FV_N01R0502_EVENT_01 )

			//謁見の間、水が干上がった状態のマップに変更
			_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, TRUE, TRUE )

			//ワーク
			//$WK_SCENE_N01R0502 = 5
			//$WK_SCENE_C09R0501 = 2	
				
			_MAP_CHANGE( ZONE_ID_N01R0502, 16, 45, DIR_UP )
			
			$SCWK_TEMP0 = 428

		ELSE

			$SCWK_TEMP0 = 428
			
		ENDIF
	
	ENDWHILE
	
EVENT_END

