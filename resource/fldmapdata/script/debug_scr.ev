      _FLAG_SET( SYS_FLAG_ARRIVE_D22 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D23 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D11R0101 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R04 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D03 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D04R0101 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R05 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R16 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R16R0201 )
      _FLAG_SET( SYS_FLAG_ARRIVE_H02 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R06 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D28R0101 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R06R0201 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D06 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R07 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R07R0101 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D24 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D25R0101 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R13 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D20 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R14 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R14R0201 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R12 )
      _FLAG_SET( SYS_FLAG_ARRIVE_H04 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R11 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R09 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D32R0101 )
      _FLAG_SET( SYS_FLAG_ARRIVE_W21 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R15 )
