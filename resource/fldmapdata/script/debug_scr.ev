EVENT_START ev_debug_obata

	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
	_BMPMENU_MAKE_LIST( msg_debug_obata_1,   1 ) // 初回クリア
	_BMPMENU_MAKE_LIST( msg_debug_obata_2,   2 ) // 殿堂入り
	_BMPMENU_MAKE_LIST( msg_debug_obata_3,   3 ) // リーグ・エレベータチェック
	_BMPMENU_MAKE_LIST( msg_debug_obata_4,   4 ) // 育て屋オープン
	_BMPMENU_MAKE_LIST( msg_debug_obata_5,   5 ) // 育て屋ポケセット
	_BMPMENU_MAKE_LIST( msg_debug_obata_6,   6 ) // 育て屋ポケクリア
	_BMPMENU_MAKE_LIST( msg_debug_obata_7,   7 ) // 育て屋ジャンプ
	_BMPMENU_MAKE_LIST( msg_debug_obata_8,   8 ) // 無音曲再生
	_BMPMENU_MAKE_LIST( msg_debug_obata_9,   9 ) // 調査項目全オープン
	_BMPMENU_MAKE_LIST( msg_debug_obata_10, 10 ) // テスト
	_BMPMENU_MAKE_LIST( msg_debug_obata_10, 11 ) // テスト
	_BMPMENU_MAKE_LIST( msg_debug_obata_10, 12 ) // テスト
	_BMPMENU_START()

  SWITCH $SCWK_ANSWER
  CASE 1 THEN 
    _GOTO_GAMECLEAR_DEMO( 0 )
  CASE 2 THEN 
    _FLAG_SET( SYS_FLAG_GAME_CLEAR )
    _GOTO_GAMECLEAR_DEMO( 1 )
  CASE 3 THEN 
    _FLAG_SET( SYS_FLAG_BIGFOUR_GHOSTWIN )
    _FLAG_SET( SYS_FLAG_BIGFOUR_EVILWIN )
    _FLAG_SET( SYS_FLAG_BIGFOUR_FIGHTWIN )
    _FLAG_SET( SYS_FLAG_BIGFOUR_ESPWIN )
    _MAP_CHANGE( ZONE_ID_C09P01, 31, 45, DIR_UP )
  CASE 4 THEN
    _FLAG_SET( FE_SODATEYAOLDMAN_OPEN ) 
    _FLAG_RESET( FV_R03_SODATEYA_01 ) 
  CASE 5 THEN
    _POKE_TO_SODATEYA(0)
    _POKE_TO_SODATEYA(1)
  CASE 6 THEN 
    _POKE_FROM_SODATEYA(0)
    _POKE_FROM_SODATEYA(0)
  CASE 7 THEN 
    _MAP_CHANGE( ZONE_ID_R03R0201, 6, 9, DIR_UP )
  CASE 8 THEN 
    _START_EVENT_BGM( SEQ_BGM_SILENCE_FIELD )
  CASE 9 THEN 
    _FLAG_SET( FE_RES_QUESTION_YOU )
    _FLAG_SET( FE_RES_QUESTION_FAVARITE )
    _FLAG_SET( FE_RES_QUESTION_WISH )
    _FLAG_SET( FE_RES_QUESTION_PARTNER )
    _FLAG_SET( FE_RES_QUESTION_TASTE )
    _FLAG_SET( FE_RES_QUESTION_HOBBY )
    _FLAG_SET( FE_RES_QUESTION_SCHOOL )
    _FLAG_SET( FE_RES_QUESTION_PLAY )
    _FLAG_SET( FE_RES_QUESTION_POKEMON )
  CASE 10 THEN
    _BGM_VOLUME_DOWN( 30, 100 )
  CASE 11 THEN
    _BGM_VOLUME_RECOVER( 30 )
  CASE 12 THEN
    _BGM_VOLUME_DOWN( 30, 60 )
    _TIME_WAIT( 60 )
    _START_EVENT_BGM( SEQ_BGM_C_01 )
    _TIME_WAIT( 60 )
    _BGM_VOLUME_RECOVER( 30 )
  ENDSWITCH

EVENT_END

