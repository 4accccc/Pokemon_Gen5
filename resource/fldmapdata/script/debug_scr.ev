		_BMPMENU_MAKE_LIST( msg_debug_00, 1000 )	//やめる
		//メニュー表示
		_BMPMENU_START()
		
		IF $SCWK_ANSWER == 0 THEN
			
			//シナリオクリア後にかかる処理を呼び出す
			_GLOBAL_CALL	SCRID_INIT_GAMECLEAR_SCRIPT
			
      //設定した特殊接続先からゲームを開始するリクエストをクリア＝＝コンティニュー時にその場から
      _FLAG_RESET( SYS_FLAG_SPEXIT_REQUEST )

		ELSIF $SCWK_ANSWER == 1 THEN
			
			//殿堂入り後にかかる処理を呼び出す（シナリオクリアしてなければ２回呼ぶことで殿堂入り処理へ流す）
			IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
				_GLOBAL_CALL	SCRID_INIT_GAMECLEAR_SCRIPT
			ENDIF
