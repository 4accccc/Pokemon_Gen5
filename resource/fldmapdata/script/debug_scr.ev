/************************************************************/
/*				斉藤マのデバッグメニュー					*/
/************************************************************/
EVENT_START ev_debug_masafumi
	$SCWK_TEMP0 = 0
	$SCWK_TEMP1 = 0
	
	//メニュー作成
	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_TEMP1 )
	//リスト追加
	_BMPMENU_MAKE_LIST( msg_debug_01, 1 )	//テスト01
	_BMPMENU_MAKE_LIST( msg_debug_02, 2 )	//テスト02
	_BMPMENU_MAKE_LIST( msg_debug_03, 3 )	//テスト03
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_13, 4 )	//観覧車トレーナー
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_14, 5 )	//カナワタウン
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_05, 0 )	//四天王部屋
	_BMPMENU_MAKE_LIST( msg_debug_00, 10 )	//やめる
	//メニュー表示
	_BMPMENU_START()
	
	IF $SCWK_TEMP1 == 0 THEN
		_CALL	ev_bigfour_menu	//四天王部屋

	ELSIF $SCWK_TEMP1 == 1 THEN
		_FLAG_SET( SYS_FLAG_WEATHER_R07 )

	ELSIF $SCWK_TEMP1 == 2 THEN
		//テスト02

		$WK_SYS_FIRST_POKETYPE = FIRST_POKETYPE_MIZU

	ELSIF $SCWK_TEMP1 == 3 THEN

		_SUBWIN_MSG( msg_debug_masafumi_15, 10, 10, 1 )
		_AB_KEYWAIT()
		_SUBWIN_CLOSE( 1 )
		
	ELSIF $SCWK_TEMP1 == 4 THEN
		//観覧車トレーナー
		//_FLAG_RESET( TMFLG_AMUSEMENT_TR_BTL )
		//_FLAG_RESET( FV_AMUSEMENT_TRAINER )
		_MAP_CHANGE( ZONE_ID_C04P01, 52, 15, DIR_RIGHT )
 
	ELSIF $SCWK_TEMP1 == 5 THEN
		//カナワタウンの転車台に配置される車両を変更
		_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_01, 1 )	//シングル
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_02, 2 )	//Ｓシングル
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_03, 3 )	//ダブル
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_04, 4 )	//Ｓダブル
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_05, 5 )	//マルチ
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_06, 6 )	//Ｓマルチ
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_07, 7 )	//Wi-Fi
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_08, 8 )	//カナワ行き
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_09, 9 )	//古いレア
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_14_10, 10 )	//新しいレア
		_BMPMENU_MAKE_LIST( msg_debug_01, 0 )	//テスト01（車両なし）
		_BMPMENU_MAKE_LIST( msg_debug_00, 100 )	//やめる
		_BMPMENU_START()
		
		SWITCH $SCWK_ANSWER
		CASE 0 THEN
			$WK_OTHER_T05_TRAIN = 0
		CASE 1 THEN
			$WK_OTHER_T05_TRAIN = 1
		CASE 2 THEN
			$WK_OTHER_T05_TRAIN = 2
		CASE 3 THEN
			$WK_OTHER_T05_TRAIN = 3
		CASE 4 THEN
			$WK_OTHER_T05_TRAIN = 4
		CASE 5 THEN
			$WK_OTHER_T05_TRAIN = 5
		CASE 6 THEN
			$WK_OTHER_T05_TRAIN = 6
		CASE 7 THEN
			$WK_OTHER_T05_TRAIN = 7
		CASE 8 THEN
			$WK_OTHER_T05_TRAIN = 8
		CASE 9 THEN
			$WK_OTHER_T05_TRAIN = 9
		CASE 10 THEN
			$WK_OTHER_T05_TRAIN = 10
		ENDSWITCH
		
		IF $SCWK_ANSWER <= 10 THEN
			_MAP_CHANGE( ZONE_ID_T05, 25, 38, DIR_UP )
		ENDIF
		
	ENDIF
	
EVENT_END


//四天王部屋デバッグメニュー------------------------------------
ev_bigfour_menu:
	//メニュー作成
	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
	//リスト追加
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_07, 0 )	//勝利フラグ
	_BMPMENU_MAKE_LIST( msg_debug_04, 1 )	//ジャンプ ※階段前にジャンプ（アニメチェック用）
	_BMPMENU_MAKE_LIST( msg_debug_00, 10 )	//やめる
	//メニュー表示
	_BMPMENU_START()

	IF $SCWK_ANSWER == 0 THEN
		
		WHILE $SCWK_TEMP0 != 111
		
			_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_PARAM0 )
			_BMPMENU_MAKE_LIST( msg_debug_masafumi_01, 0 )	//ゴースト
			_BMPMENU_MAKE_LIST( msg_debug_masafumi_02, 1 )	//あく
			_BMPMENU_MAKE_LIST( msg_debug_masafumi_03, 2 )	//かくとう
			_BMPMENU_MAKE_LIST( msg_debug_masafumi_04, 3 )	//エスパー
			_BMPMENU_MAKE_LIST( msg_debug_00, 10 )	//やめる
			_BMPMENU_START()
			
			IF $SCWK_PARAM0 == 0 THEN
				_FLAG_SET( SYS_FLAG_BIGFOUR_GHOSTWIN )
			ELSIF $SCWK_PARAM0 == 1 THEN
				_FLAG_SET( SYS_FLAG_BIGFOUR_EVILWIN )
			ELSIF $SCWK_PARAM0 == 2 THEN
				_FLAG_SET( SYS_FLAG_BIGFOUR_FIGHTWIN )
			ELSIF $SCWK_PARAM0 == 3 THEN
				_FLAG_SET( SYS_FLAG_BIGFOUR_ESPWIN )
			ELSE
				$SCWK_TEMP0 = 111
			ENDIF
		
		ENDWHILE
		
	ELSIF $SCWK_ANSWER == 1 THEN
		
		
		_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_PARAM0 )
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_01, 0 )	//ゴースト
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_02, 1 )	//あく
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_03, 2 )	//かくとう
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_04, 3 )	//エスパー
		_BMPMENU_START()
		
		IF $SCWK_PARAM0 == 0 THEN
			_MAP_CHANGE( ZONE_ID_C09R0101, 15, 28, DIR_DOWN )
		ELSIF $SCWK_PARAM0 == 1 THEN
			_MAP_CHANGE( ZONE_ID_C09R0201, 15, 28, DIR_DOWN )
		ELSIF $SCWK_PARAM0 == 2 THEN
			_MAP_CHANGE( ZONE_ID_C09R0301, 15, 28, DIR_DOWN )
		ELSIF $SCWK_PARAM0 == 3 THEN
			_MAP_CHANGE( ZONE_ID_C09R0401, 15, 28, DIR_DOWN )
		ENDIF
		
		
	ENDIF

_RET

/**************************************************************/
/* map_debug                                                  */
/**************************************************************/
EVENT_START   ev_debug_scr_map
{
  //バージョン取得
  DEFINE_LOCAL LCWK_VERSION
  
  $SCWK_TEMP2 = 0
  //メニュー作成
  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, SCWK_TEMP2 )
  //リスト追加
  _BMPMENU_MAKE_LIST( msg_debug_map_02, 0 ) //C08氷漬け
  _BMPMENU_MAKE_LIST( msg_debug_map_01, 1 ) //C08初期化
  _BMPMENU_MAKE_LIST( msg_debug_map_03, 2 ) //D10船あり
  _BMPMENU_MAKE_LIST( msg_debug_map_04, 3 ) //D10船なし
  _BMPMENU_MAKE_LIST( msg_debug_map_05, 4 ) //C03P15船あり
  _BMPMENU_MAKE_LIST( msg_debug_map_06, 5 ) //C03P15船なし
  _BMPMENU_MAKE_LIST( msg_debug_map_07, 6 ) //D05船あり
  _BMPMENU_MAKE_LIST( msg_debug_map_08, 7 ) //D05船なし
  _BMPMENU_MAKE_LIST( msg_debug_map_09, 8 ) //W21タラップなし
  _BMPMENU_MAKE_LIST( msg_debug_map_10, 9 ) //W21タラップあり
  _BMPMENU_MAKE_LIST( msg_debug_map_11, 10 ) //W21なし
  _BMPMENU_MAKE_LIST( msg_debug_map_12, 11 ) //d13 クリア後
  _BMPMENU_MAKE_LIST( msg_debug_map_13, 12 ) //トロフィー表示・非表示
  
  _BMPMENU_START()
  
  //C08氷漬け
  IF $SCWK_TEMP2 == 0 THEN
    //C08ヴィオ戦前
    //C08アイリス表示
    $WK_SCENE_C08_SWCHAMPION = 1
    _FLAG_SET( FV_C08_SWCHAMPION_01 )
    $WK_SCENE_C08_NINJA = 0
    $WK_SCENE_C08_SWPLAZMA = 5
		    _FLAG_RESET(FV_C08_SWLEADER7_01)
		    _FLAG_RESET(FV_C08_SWSAGE7_01)
		    _FLAG_RESET(FV_C08_SWPLAZMA_01)
		    _FLAG_SET(FV_C08_PEOPLE_01)  //ソウリュウシティ：一般市民
		    _FLAG_SET( SYS_FLAG_BGM_C08_PLAZMA )
		    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_01, TRUE, TRUE )
		    
		    _MAP_CHANGE( ZONE_ID_C08, 425, 173, DIR_DOWN)
  
  //C08初期化
  ELSIF $SCWK_TEMP2 == 1 THEN
       $WK_SCENE_C08_SWCHAMPION = 0
       _FLAG_RESET( FV_C08_SWCHAMPION_01 )
       $WK_SCENE_C08_LEADER7 = 0
       $WK_SCENE_C08_SWPLAZMA = 0
       $WK_SCENE_C08_NINJA = 0
       $WK_SCENE_C08R0101 = 0
       _FLAG_SET(FV_C08_SWLEADER7_01)  //ソウリュウシティ：シャガ
       _FLAG_SET(FV_C08_SWSAGE7_01) //ソウリュウシティ：ヴィオ（SAGE7）
       _FLAG_SET(FV_C08_SWPLAZMA_01) //ソウリュウシティ：プラズマ団
       _FLAG_SET(FV_C08_NINJA_01)  //ソウリュウシティ：ダークトリニティ（戦うやつ）
       _FLAG_SET(FV_C08_NINJA_02)  //ソウリュウシティ：ダークトリニティ（戦わないやつ）
       _FLAG_SET(FV_C08R0101_SWLEADER7_01) //シャガ家：シャガ
       _FLAG_RESET(FV_C08_PEOPLE_01)  //ソウリュウシティ：一般市民
       _FLAG_SET( FE_C08_PLAZMA_COME )
       _FLAG_RESET( SYS_FLAG_BGM_C08_PLAZMA )
       _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_01, FALSE, FALSE ) //マップ復帰
       
       _MAP_CHANGE( ZONE_ID_C08, 425, 173, DIR_DOWN)
       
  //D10船あり
  ELSIF $SCWK_TEMP2 == 2 THEN
    _FLAG_SET( FE_D10_PLAZMA_FRIGATE_01 )
    //マップ遷移
    _MAP_CHANGE( ZONE_ID_D10R0101, 23, 52, DIR_UP )
    
  //D10船なし
  ELSIF $SCWK_TEMP2 == 3 THEN
    _FLAG_RESET( FE_D10_PLAZMA_FRIGATE_01 )
    //マップ遷移
    _MAP_CHANGE( ZONE_ID_D10R0101, 23, 52, DIR_UP )
    
  //C03P15船あり
  ELSIF $SCWK_TEMP2 == 4 THEN
    //C03P15アジト船出現
    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, TRUE, TRUE )
    //マップ遷移
    _MAP_CHANGE( ZONE_ID_C03P15, 20, 8, DIR_RIGHT)
    
  //C03P15船なし
  ELSIF $SCWK_TEMP2 == 5 THEN
    //C03P15アジト船非表示
    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, FALSE, FALSE )
    //マップ遷移
    _MAP_CHANGE( ZONE_ID_C03P15, 20, 8, DIR_RIGHT)

  //D05船あり
  ELSIF $SCWK_TEMP2 == 6 THEN
    //D05イベント進行状態を進めて接続を作成
    $WK_SCENE_D05 = 3
    $WK_SCENE_W21_01 = 0
    _FLAG_RESET( FV_D05_SWBOSS_01 )
    //D05アジト船出現
    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_05, TRUE, TRUE )
    //マップ遷移
    _MAP_CHANGE( ZONE_ID_D05, 197, 493, DIR_RIGHT )
    
  //D05船なし
  ELSIF $SCWK_TEMP2 == 7 THEN
    //D05アジト船非表示
    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_05, FALSE, FALSE )
    //マップ遷移
    _MAP_CHANGE( ZONE_ID_D05, 197, 493, DIR_RIGHT )
  
  //W21タラップなし
  ELSIF $SCWK_TEMP2 == 8 THEN
    //W21アジト船表示（タラップなし）
      _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, TRUE , TRUE )
      _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, FALSE , FALSE )
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_W21, 797, 243, DIR_RIGHT )
      
  //W21タラップあり
  ELSIF $SCWK_TEMP2 == 9 THEN
    //W21のイベント進行状態を進めて接続を作成
    $WK_SCENE_W21_01 = 3
    $WK_SCENE_D05 = 0
    //W21アジト船表示（タラップあり）
    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, FALSE , FALSE )
    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, TRUE , TRUE )
    //マップ遷移
    _MAP_CHANGE( ZONE_ID_W21, 797, 243, DIR_RIGHT )
    
  //W21なし
  ELSIF $SCWK_TEMP2 == 10 THEN
    //W21アジト船非表示
      _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, FALSE , FALSE )
      _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, FALSE , FALSE )
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_W21, 797, 243, DIR_RIGHT )
  
  //d13プラズマフリゲートクリア状態
  ELSIF $SCWK_TEMP2 == 11 THEN
    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_02, TRUE, TRUE )
    //D27の人々をクリア後状態
    _FLAG_SET( FV_D27_BEFORE_PWPLAZMA_01 )
    _FLAG_RESET( FV_D27_AFTER_PWPLAZMA_01 )
    _FLAG_SET( FV_D27R1001_R1301_POKE10_01 )
    //マップ遷移
    _MAP_CHANGE( ZONE_ID_D13, 727, 716, DIR_RIGHT )
  //トロフィー表示
  ELSIF $SCWK_TEMP2 == 12 THEN
    //主人公部屋トロフィー表示非表示
      IF FLAG_ON(FV_C12R0101_TRORHY1_01) THEN
        _FLAG_RESET( FV_C12R0101_TRORHY1_01 )
        _FLAG_RESET( FV_C12R0101_TRORHY2_01 )
        _FLAG_RESET( FV_C12R0101_TRORHY3_01 )
        _FLAG_RESET( FV_C12R0101_PRIZE1_01 )
        _FLAG_RESET( FV_C12R0101_PRIZE2_01 )
      ELSE
        _FLAG_SET( FV_C12R0101_TRORHY1_01 )
        _FLAG_SET( FV_C12R0101_TRORHY2_01 )
        _FLAG_SET( FV_C12R0101_TRORHY3_01 )
        _FLAG_SET( FV_C12R0101_PRIZE1_01 )
        _FLAG_SET( FV_C12R0101_PRIZE2_01 )
      ENDIF
  ENDIF
}
EVENT_END

/**************************************************************/
/* local_tvt                                                  */
/**************************************************************/
EVENT_START   ev_debug_local_tvt

$SCWK_TEMP2 = 0
  //メニュー作成
  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, SCWK_TEMP2 )
  //リスト追加
  _BMPMENU_MAKE_LIST( msg_debug_localtvt_01, 0 )
  _BMPMENU_MAKE_LIST( msg_debug_localtvt_02, 1 )
  _BMPMENU_MAKE_LIST( msg_debug_localtvt_03, 2 )
  _BMPMENU_MAKE_LIST( msg_debug_localtvt_04, 3 )
  _BMPMENU_MAKE_LIST( msg_debug_localtvt_05, 4 )
  _BMPMENU_MAKE_LIST( msg_debug_localtvt_06, 5 )
  _BMPMENU_MAKE_LIST( msg_debug_localtvt_07, 6 )
  _BMPMENU_MAKE_LIST( msg_debug_localtvt_08, 7 )
  
  _BMPMENU_START()
  
  IF $SCWK_TEMP2 == 0 THEN
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
      _CALL_TVT_DEMO( 1 )
      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
    ELSIF $SCWK_TEMP2 == 1 THEN
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
      _CALL_TVT_DEMO( 2 )
      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
    ELSIF $SCWK_TEMP2 == 2 THEN
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
      _CALL_TVT_DEMO( 3 )
      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
      
    ELSIF $SCWK_TEMP2 == 3 THEN
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
      _CALL_TVT_DEMO( 4 )
      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
    ELSIF $SCWK_TEMP2 == 4 THEN
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
      _CALL_TVT_DEMO( 5 )
      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
    ELSIF $SCWK_TEMP2 == 5 THEN
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
      _CALL_TVT_DEMO( 6 )
      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
    ELSIF $SCWK_TEMP2 == 6 THEN
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
      _CALL_TVT_DEMO( 7 )
      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
    ELSIF $SCWK_TEMP2 == 7 THEN
      _MAP_FADE_BLACK_OUT()
      _MAP_FADE_END_CHECK()
      _CALL_TVT_DEMO( 8 )
      _MAP_FADE_BLACK_IN()
      _MAP_FADE_END_CHECK()
    ENDIF

EVENT_END
/**************************************************************/
/* MIZUGUCHI                                                  */
/**************************************************************/
EVENT_START   ev_debug_mizuguchi
{
    //バージョン取得
    DEFINE_LOCAL LCWK_VERSION

		$SCWK_TEMP2 = 0
		//メニュー作成
		_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, SCWK_TEMP2 )
		//リスト追加
		_BMPMENU_MAKE_LIST( msg_debug_mizu_01, 0 )	//C03到着
		_BMPMENU_MAKE_LIST( msg_debug_mizu_02, 1 )	//C03P17開始
		_BMPMENU_MAKE_LIST( msg_debug_mizu_03, 2 )	//ジムクリア
		_BMPMENU_MAKE_LIST( msg_debug_mizu_04, 3 )	//R04アクロマ初期化
		_BMPMENU_MAKE_LIST( msg_debug_mizu_05, 4 )	//D07R0401イベント初期化
		_BMPMENU_MAKE_LIST( msg_debug_mizu_06, 5 )	//C03R0301イベント初期化
		_BMPMENU_MAKE_LIST( msg_debug_mizu_07, 6 )	//C08初期化
		_BMPMENU_MAKE_LIST( msg_debug_mizu_08, 7 )	//D27カードキー所持
		_BMPMENU_MAKE_LIST( msg_debug_mizu_09, 8 )	//D27搭乗1回目
		_BMPMENU_MAKE_LIST( msg_debug_mizu_10, 9 )	//D27搭乗2回目
		_BMPMENU_MAKE_LIST( msg_debug_mizu_11, 10 )	//D27搭乗3回目
		_BMPMENU_MAKE_LIST( msg_debug_mizu_12, 11 )	//D27・ヴィオ戦前
		_BMPMENU_MAKE_LIST( msg_debug_mizu_13, 12 )	//D27・アクロマ戦前
		_BMPMENU_MAKE_LIST( msg_debug_mizu_14, 13 )	//D10・船あり接続
		_BMPMENU_MAKE_LIST( msg_debug_mizu_15, 14 )	//D10・船なし接続
		_BMPMENU_MAKE_LIST( msg_debug_mizu_16, 15 )	//D10・イベント起動
		_BMPMENU_MAKE_LIST( msg_debug_mizu_17, 16 )	//D10・キュレム手前
		_BMPMENU_MAKE_LIST( msg_debug_mizu_18, 17 )	//d24連れ歩き開始
		_BMPMENU_MAKE_LIST( msg_debug_mizu_19, 18 )	//c14イベント開始
		_BMPMENU_MAKE_LIST( msg_debug_mizu_20, 19 )	//c15チュートリアル開始
		_BMPMENU_MAKE_LIST( msg_debug_mizu_21, 20 )	//コバルオン登場
		_BMPMENU_MAKE_LIST( msg_debug_mizu_00, 21 )	//テスト
		_BMPMENU_MAKE_LIST( msg_debug_mizu_00, 22 )	//テスト
		_BMPMENU_MAKE_LIST( msg_debug_mizu_00, 23 )	//テスト
		
		//メニュー表示
		_BMPMENU_START()
	
		IF $SCWK_TEMP2 == 0 THEN
			//C03イベント開始
			$WK_SCENE_C03P15 = 1
			_MAP_CHANGE( ZONE_ID_C03P15, 12, 10, DIR_LEFT )
		ELSIF $SCWK_TEMP2 == 1 THEN
		   $WK_SCENE_C03P17 = 1
			_FLAG_SET( FV_C03P17_SWRIVAL_01 )
			_FLAG_RESET( FV_C03P17_SWCHAMPION_01 )
			_MAP_CHANGE( ZONE_ID_C03P17, 2, 14, DIR_RIGHT )
		ELSIF $SCWK_TEMP2 == 2 THEN
		  //Cギアチュートリアル起動
		  $WK_SCENE_C03P08_FESGUIDE_01 = 1
			//ジムクリア
			$WK_SCENE_C03P01 = 1
			_FLAG_RESET( FV_C03P01_SWBOSS_01 )
			_MAP_CHANGE( ZONE_ID_C03P01, 21, 7, DIR_LEFT )
		ELSIF $SCWK_TEMP2 == 3 THEN
			//C03P01アクロマイベント終了
			$WK_SCENE_R04_SWBOSS = 1
			_FLAG_RESET( FV_R04_SWBOSS_01 )
			_FLAG_RESET( FV_R04_BIGROCK_01 )
			_FLAG_SET( FV_R04_WORKMAN_01 )
			
			// ROMバージョン取得
      _GET_ROM_VERSION( LCWK_VERSION )
      
      IF $LCWK_VERSION == VERSION_B2 THEN
        //マップ遷移
        _MAP_CHANGE( ZONE_ID_R04, 430, 589, DIR_UP )
      ELSE
        //マップ遷移
        _MAP_CHANGE( ZONE_ID_R04W, 405, 579, DIR_UP )
      ENDIF
      
		ELSIF $SCWK_TEMP2 == 4 THEN
		  //C08アイリス表示
      $WK_SCENE_C08_SWCHAMPION = 1
      _FLAG_SET( FV_C08_SWCHAMPION_01 )
		  //C08プラズマ団イベント開始
      $WK_SCENE_C08_LEADER7 = 1
		  _MAP_CHANGE( ZONE_ID_C08, 405, 145, DIR_DOWN )
		ELSIF $SCWK_TEMP2 == 5 THEN
        //C08ヴィオ戦前
        //C08アイリス非表示
        $WK_SCENE_C08_SWCHAMPION = 1
        _FLAG_SET( FV_C08_SWCHAMPION_01 )
		    $WK_SCENE_C08_NINJA = 0
		    $WK_SCENE_C08_SWPLAZMA = 5
		    _FLAG_RESET(FV_C08_SWLEADER7_01)
		    _FLAG_RESET(FV_C08_SWSAGE7_01)
		    _FLAG_RESET(FV_C08_SWPLAZMA_01)
		    _FLAG_SET( FV_C08_NINJA_01 )
        _FLAG_SET( FV_C08_NINJA_02 )
		    _FLAG_SET(FV_C08_PEOPLE_01)  //ソウリュウシティ：一般市民
		    _FLAG_SET( FE_C08_PLAZMA_COME )
		    _FLAG_SET( SYS_FLAG_BGM_C08_PLAZMA )
		    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_01, TRUE, TRUE )
		    
		    //マップ遷移
        _MAP_CHANGE( ZONE_ID_C08, 405, 147, DIR_UP )
		    
		ELSIF $SCWK_TEMP2 == 6 THEN
		   //C08初期化
		   //C08アイリス非表示
       $WK_SCENE_C08_SWCHAMPION = 0
       _FLAG_RESET( FV_C08_SWCHAMPION_01 )
       $WK_SCENE_C08_LEADER7 = 0
       $WK_SCENE_C08_SWPLAZMA = 0
       $WK_SCENE_C08_NINJA = 0
       $WK_SCENE_C08R0101 = 0
       _FLAG_SET(FV_C08_SWLEADER7_01)  //ソウリュウシティ：シャガ
       _FLAG_SET(FV_C08_SWSAGE7_01) //ソウリュウシティ：ヴィオ（SAGE7）
       _FLAG_SET(FV_C08_SWPLAZMA_01) //ソウリュウシティ：プラズマ団
       _FLAG_SET(FV_C08_NINJA_01)  //ソウリュウシティ：ダークトリニティ（戦うやつ）
       _FLAG_SET(FV_C08_NINJA_02)  //ソウリュウシティ：ダークトリニティ（戦わないやつ）
       _FLAG_SET(FV_C08R0101_SWLEADER7_01) //シャガ家：シャガ
       _FLAG_RESET(FV_C08_PEOPLE_01)  //ソウリュウシティ：一般市民
       _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_01, FALSE, FALSE ) //マップ復帰
    ELSIF $SCWK_TEMP2 == 7 THEN
      
      //D27カードキー所持
      _FLAG_SET(FE_D27_CARDKEY_01)
      
    ELSIF $SCWK_TEMP2 == 8 THEN
      
      //D27搭乗一回目
      _FLAG_RESET(FV_D27R0101_SWRIVAL_01)
      _FLAG_RESET(FV_D27R0101_SWPLAZMA_01)
      _FLAG_RESET(FV_D27R0101_SWLEADER1_01)
      _FLAG_SET(FV_D27R0101_SWPLAZMA_02)
      _FLAG_SET(FV_D27R1101_SWPLAZMA_03)
      _FLAG_SET(FV_D27R0101_SWSAGE7_01)
      _FLAG_SET(FV_D27R0101_NINJA_01)
      //プラズマフリゲート曲をサイレントに
      _FLAG_SET( SYS_FLAG_BGM_D27R0101_SILENT )
      
      //ワーク初期化
      $WK_SCENE_D27R0101_FIRST_01 = 1
      $WK_SCENE_D27R0101_SECONDW_01 = 0
      $WK_SCENE_D27R0101_SECONDB_01 = 0
      $WK_SCENE_D05 = 4
      
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_D27R0101, 10, 32, DIR_RIGHT )
      
    ELSIF $SCWK_TEMP2 == 9 THEN
      
      //D27搭乗二回目
      _FLAG_RESET(FV_D27R0101_SWRIVAL_01)
      _FLAG_SET(FV_D27R0101_SWPLAZMA_01)
      _FLAG_SET(FV_D27R1101_SWPLAZMA_03)
      _FLAG_SET(FV_D27R0101_SWLEADER1_01)
      _FLAG_RESET(FV_D27R0101_SWPLAZMA_02)
      _FLAG_SET(FV_D27R0101_SWSAGE7_01)
      _FLAG_SET(FV_D27R0101_NINJA_01)
      //プラズマフリゲート曲再生
      _FLAG_RESET( SYS_FLAG_BGM_D27R0101_SILENT )
      
      //ワーク初期化
      $WK_SCENE_D27R0101_FIRST_01 = 4
      
      // ROMバージョン取得
      _GET_ROM_VERSION( LCWK_VERSION )
      
      //ヒントPOS初期化
      IF $LCWK_VERSION == VERSION_B2 THEN
        $WK_SCENE_D27_HINT_01 = 1
        $WK_SCENE_D27_HINT_02 = 1
        $WK_SCENE_D27_HINT_03 = 1
        $WK_SCENE_D27_HINT_04 = 1
        $WK_SCENE_D27_HINT_05 = 1
      ELSE
        $WK_SCENE_D27_HINT_01 = 0
        $WK_SCENE_D27_HINT_02 = 0
        $WK_SCENE_D27_HINT_03 = 0
        $WK_SCENE_D27_HINT_04 = 0
        $WK_SCENE_D27_HINT_05 = 0
      ENDIF
      
      //B2
      IF $LCWK_VERSION == VERSION_B2 THEN
        $WK_SCENE_D27R0101_SECONDW_01 = 0
        $WK_SCENE_D27R0101_SECONDB_01 = 1
      ELSE
        $WK_SCENE_D27R0101_SECONDW_01 = 1
        $WK_SCENE_D27R0101_SECONDB_01 = 0
      ENDIF
      
      //バリア状態を初期化
      $WK_SCENE_D27R1201_BARRIER_01 = 0
      $WK_SCENE_D27R1001_BARRIER_01 = 0
      $WK_SCENE_D27_SWITCH_04 = 0
      $WK_SCENE_D27_SWITCH_03 = 0
      $WK_SCENE_D27_SWITCH_02 = 0
      $WK_SCENE_D27_SWITCH_01 = 0
      
      //W21シズイイベント終了
      $WK_SCENE_W21_01 = 3
      //マップ差し替え:W21アジト船タラップ表示
      _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, FALSE , FALSE )
      _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, TRUE , TRUE )
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_W21, 797, 240, DIR_RIGHT )
      
    ELSIF $SCWK_TEMP2 == 10 THEN
      
      //D27搭乗三回目
      _FLAG_RESET(FV_D27R0101_SWRIVAL_01)
      _FLAG_SET(FV_D27R0101_SWPLAZMA_01)
      _FLAG_SET(FV_D27R0101_SWLEADER1_01)
      _FLAG_SET(FV_D27R0101_SWPLAZMA_02)
      _FLAG_SET(FV_D27R0101_SWSAGE7_01)
      _FLAG_SET(FV_D27R0101_NINJA_01)
      _FLAG_SET( FV_D27R0101_STOPPER_01 )
      _FLAG_RESET(FV_D27R0201_SWRIVAL_01)
      _FLAG_RESET(FV_D27R1201_SWRIVAL_01)
      //D27R0101 プラズマ団員表示
      _FLAG_RESET(FV_D27R1101_SWPLAZMA_03)
      //プラズマフリゲート曲再生
      _FLAG_RESET( SYS_FLAG_BGM_D27R0101_SILENT )
      
      //ワーク初期化
      $WK_SCENE_D27R0101_FIRST_01 = 4
      $WK_SCENE_D27R0101_SECONDW_01 = 4
      $WK_SCENE_D27R0101_SECONDB_01 = 4
      $WK_SCENE_D27R0501_SWSAGE7_01 = 2
      
      // ROMバージョン取得
      _GET_ROM_VERSION( LCWK_VERSION )
      
      //ヒントPOS初期化
      IF $LCWK_VERSION == VERSION_B2 THEN
        $WK_SCENE_D27_HINT_01 = 0
        $WK_SCENE_D27_HINT_02 = 0
        $WK_SCENE_D27_HINT_03 = 0
        $WK_SCENE_D27_HINT_04 = 0
        $WK_SCENE_D27_HINT_05 = 0
      ELSE
        $WK_SCENE_D27_HINT_01 = 1
        $WK_SCENE_D27_HINT_02 = 1
        $WK_SCENE_D27_HINT_03 = 1
        $WK_SCENE_D27_HINT_04 = 1
        $WK_SCENE_D27_HINT_05 = 1
      ENDIF
      
      //第二階層誘導イベント設定
      _FLAG_RESET(FV_D27R1301_SWPLAZMAM_01)
      _FLAG_SET( FV_D27R1301_SWSAGE7_01 )
      $WK_SCENE_D27R1301_PLAZMAM_01 = 1
      $WK_SCENE_D27R1301_SWSAGE7_01 = 0
      
      _FLAG_RESET(FV_D27R1001_SWPLAZMAM_01)
      _FLAG_SET( FV_D27R1001_SWSAGE7_01 )
      $WK_SCENE_D27R1001_PLAZMAM_01 = 1
      $WK_SCENE_D27R1001_SWSAGE7_01 = 0
      
      //バリア状態を初期化
      //B2
      IF $LCWK_VERSION == VERSION_B2 THEN
      
        $WK_SCENE_D27R1201_BARRIER_01 = 1
        $WK_SCENE_D27R1001_BARRIER_01 = 0
        $WK_SCENE_D27_SWITCH_04 = 1
        $WK_SCENE_D27_SWITCH_03 = 1
        $WK_SCENE_D27_SWITCH_02 = 1
        $WK_SCENE_D27_SWITCH_01 = 1
        _FLAG_RESET( FE_D27_HINT_01 )
        _FLAG_RESET( FE_D27_HINT_02 )
        _FLAG_RESET( FE_D27_HINT_03 )
        _FLAG_RESET( FE_D27_HINT_04 )
        _FLAG_RESET( FE_D27_HINT_05 )
        _FLAG_RESET( FE_D27_HINT_06 )
        _FLAG_RESET( FE_D27_HINT_07 )
        
      ELSE
      
        $WK_SCENE_D27R1001_BARRIER_01 = 0
        $WK_SCENE_D27R1201_BARRIER_01 = 1
        $WK_SCENE_D27_SWITCH_04 = 0
        $WK_SCENE_D27_SWITCH_03 = 0
        $WK_SCENE_D27_SWITCH_02 = 0
        $WK_SCENE_D27_SWITCH_01 = 0
        _FLAG_SET( FE_D27_HINT_01 )
        _FLAG_SET( FE_D27_HINT_02 )
        _FLAG_SET( FE_D27_HINT_03 )
        _FLAG_SET( FE_D27_HINT_04 )
        _FLAG_SET( FE_D27_HINT_05 )
        _FLAG_SET( FE_D27_HINT_06 )
        _FLAG_SET( FE_D27_HINT_07 )
        
      ENDIF
      
      //D10イベント開始状態
      _FLAG_RESET( FE_D10_PLAZMA_FRIGATE_01 )
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_D27R1101, 11, 31, DIR_RIGHT )
      
    ELSIF $SCWK_TEMP2 == 11 THEN
    
      //プラズマフリゲート曲再生
      _FLAG_RESET( SYS_FLAG_BGM_D27R0101_SILENT )
      
      _FLAG_SET(FV_D27R0501_NINJA_01)
      $WK_SCENE_D27R0501_SWSAGE7_01 = 1
      
      $WK_SCENE_D27R1001_BARRIER_01 = 1
      
      //バリア状態を解除に
      $WK_SCENE_D27R1201_BARRIER_01 = 1
      $WK_SCENE_D27_SWITCH_04 = 1
      $WK_SCENE_D27_SWITCH_03 = 1
      $WK_SCENE_D27_SWITCH_02 = 1
      $WK_SCENE_D27_SWITCH_01 = 1
      
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_D27R0201, 9, 3, DIR_RIGHT )
    
    ELSIF $SCWK_TEMP2 == 12 THEN
    
      //プラズマフリゲート曲再生
      _FLAG_RESET( SYS_FLAG_BGM_D27R0101_SILENT )
      
      $WK_SCENE_D27R0401_SWBOSS_01 = 1
      
      _FLAG_RESET(FV_D27R0601_SWSAGE1_01)
      _FLAG_SET(FV_D27R0601_NINJA_01)
      _FLAG_SET(FV_D27R0601_SWRIVAL_01)
      $WK_SCENE_D27R0601_SWSAGE1_01 = 0
      
      _FLAG_RESET(FV_D27R1001_SWPLAZMAM_01)
      _FLAG_SET( FV_D27R1001_SWSAGE7_01 )
      $WK_SCENE_D27R1001_PLAZMAM_01 = 2
      $WK_SCENE_D27R1001_SWSAGE7_01 = 0
      
      _FLAG_RESET(FV_D27R1301_SWPLAZMAM_01)
      _FLAG_SET( FV_D27R1301_SWSAGE7_01 )
      $WK_SCENE_D27R1301_PLAZMAM_01 = 2
      $WK_SCENE_D27R1301_SWSAGE7_01 = 0
      
      //バリア状態を解除に（とりあえずブラックだけ）
      $WK_SCENE_D27R1001_BARRIER_01 = 1
      $WK_SCENE_D27_SWITCH_04 = 1
      $WK_SCENE_D27_SWITCH_03 = 1
      $WK_SCENE_D27_SWITCH_02 = 1
      $WK_SCENE_D27_SWITCH_01 = 1
      
      //【仮】トレーナーフラグをリセット
      _TRAINER_FLAG_RESET( TRID_NINJA_02 )
      _TRAINER_FLAG_RESET( TRID_NINJA_03 )
      
      // ROMバージョン取得
      _GET_ROM_VERSION( LCWK_VERSION )
      
      IF $LCWK_VERSION == VERSION_B2 THEN
        //マップ遷移
        _MAP_CHANGE( ZONE_ID_D27R1001, 15, 19, DIR_UP )
      ELSE
        //マップ遷移
        _MAP_CHANGE( ZONE_ID_D27R1301, 15, 19, DIR_UP )
      ENDIF
    
    ELSIF $SCWK_TEMP2 == 13 THEN
      _FLAG_SET( FE_D10_PLAZMA_FRIGATE_01 )
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_D10R0101, 23, 52, DIR_UP )
    ELSIF $SCWK_TEMP2 == 14 THEN
      _FLAG_RESET( FE_D10_PLAZMA_FRIGATE_01 )
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_D10R0101, 23, 52, DIR_UP )
    ELSIF $SCWK_TEMP2 == 15 THEN
      //D10R0101 POS有効
      $WK_SCENE_D10R0101_SWPLAZMA_01 = 1
      _FLAG_SET( FE_D10_PLAZMA_FRIGATE_01 )
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_R22, 710, 136, DIR_LEFT )
    ELSIF $SCWK_TEMP2 == 16 THEN
      //D10R0401 POS有効
      $WK_SCENE_D10R0401_SWSAGE1_01 = 1
      _FLAG_SET( FV_D10R0401_POKE_03 )
      _FLAG_SET( FV_D10R0401_POKE_02 )
      _FLAG_RESET( FV_D10R0401_POKE_01 )
      _FLAG_RESET( FV_D10R0401_SWSAGE1_01 )
      _FLAG_SET( FV_D10R0501_WAND_01 )
      _FLAG_SET( FV_D10R0401_BOSS_01 )
      _FLAG_SET( FE_D10_PLAZMA_FRIGATE_01 )
      _FLAG_SET( FV_D10R0501_SWRIVAL_01 )
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_D10R0401, 16, 4, DIR_UP )
    
    ELSIF $SCWK_TEMP2 == 17 THEN
      //連れ歩きイベント起動
      $WK_SCENE_D24_PAIR_START = 1
      _MAP_CHANGE( ZONE_ID_D24, 654, 295, DIR_UP)
      $WK_SCENE_D27R0601_SWSAGE1_01 = 1
      $WK_SCENE_C03P08_FESGUIDE_01 = 1
    
    ELSIF $SCWK_TEMP2 == 18 THEN
      //C14 SCENE_CHANGE有効
      $WK_SCENE_C14_SWRIVAL_01 = 1
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_C14R0601, 3, 6, DIR_LEFT)
    
    ELSIF $SCWK_TEMP2 == 19 THEN
      //C15チュートリアル開始
      $WK_SCENE_C15_TUTORIAL_01 = 1
      //マップ遷移
      _MAP_CHANGE( ZONE_ID_C13R0501, 5, 3, DIR_UP)

    ELSIF $SCWK_TEMP2 == 20 THEN
      
      //コバルオン登場
      $WK_SCENE_R06_LEGEND_MEET = 1
      //R06七賢人ロット非表示
      _FLAG_SET( FV_R06_SAGE6_01 )
      //R06事情通の老人非表示
      _FLAG_SET( FV_R06_OLDMAN1_01 )
      _MAP_CHANGE( ZONE_ID_R06, 103, 366, DIR_UP )
      
    ELSIF $SCWK_TEMP2 == 21 THEN
      
      /*
      //W21イベント開始
      _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, TRUE , TRUE )
      _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, FALSE , FALSE )
      $WK_SCENE_W21_01 = 1
      _FLAG_SET( FV_W21_SWLEADER1_01 )
      _MAP_CHANGE( ZONE_ID_W21, 793, 241, DIR_RIGHT )
      */
      
      /*
      //D22R0101 牧場イベント（２）起動
