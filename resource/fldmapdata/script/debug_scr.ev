/************************************************************/
/*				一般向けデバッグメニュー					*/
/************************************************************/
EVENT_START ev_debug_common
	$SCWK_TEMP0 = 0
	
	WHILE $SCWK_TEMP0 != 555
		
		//メニュー作成
		_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
		//リスト追加
		_BMPMENU_MAKE_LIST( msg_debug_common_00, 0 )	//シナリオクリア
		_BMPMENU_MAKE_LIST( msg_debug_common_04, 1 )	//殿堂入り
		_BMPMENU_MAKE_LIST( msg_debug_common_01, 10 )	//ジムバッジ全部
		_BMPMENU_MAKE_LIST( msg_debug_common_02, 20 )	//到着フラグ
		_BMPMENU_MAKE_LIST( msg_debug_08, 70 )	//イベントジャンプ
		_BMPMENU_MAKE_LIST( msg_debug_05, 80 )	//イベントＯＦＦ
		_BMPMENU_MAKE_LIST( msg_debug_07, 90 )	//マップ差し替え
		_BMPMENU_MAKE_LIST( msg_debug_common_03, 100 )	//育て屋オープン
		_BMPMENU_MAKE_LIST( msg_debug_masafumi_15, 110 )	//初期３匹のタイプ変更
		_BMPMENU_MAKE_LIST( msg_debug_00, 1000 )	//やめる
		//メニュー表示
		_BMPMENU_START()
		
		IF $SCWK_ANSWER == 0 THEN
			
			//シナリオクリア後にかかる処理を呼び出す
			_GLOBAL_CALL	SCRID_INIT_GAMECLEAR_SCRIPT
			
      //設定した特殊接続先からゲームを開始するリクエストをクリア＝＝コンティニュー時にその場から
      _FLAG_RESET( SYS_FLAG_SPEXIT_REQUEST )

		ELSIF $SCWK_ANSWER == 1 THEN
			
			//殿堂入り後にかかる処理を呼び出す（シナリオクリアしてなければ２回呼ぶことで殿堂入り処理へ流す）
			IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
				_GLOBAL_CALL	SCRID_INIT_GAMECLEAR_SCRIPT
			ENDIF
			_GLOBAL_CALL	SCRID_INIT_GAMECLEAR_SCRIPT
			
			//ボックス壁紙を追加
			_GET_BOX_WALLPAPER( SCR_BOX_EX_WALLPAPER2 )
			
      //設定した特殊接続先からゲームを開始するリクエストをクリア＝＝コンティニュー時にその場から
      _FLAG_RESET( SYS_FLAG_SPEXIT_REQUEST )

		ELSIF $SCWK_ANSWER == 10 THEN
			
			_SET_BADGE_FLAG( BADGE_ID_01 )
			_SET_BADGE_FLAG( BADGE_ID_02 )
			_SET_BADGE_FLAG( BADGE_ID_03 )
			_SET_BADGE_FLAG( BADGE_ID_04 )
			_SET_BADGE_FLAG( BADGE_ID_05 )
			_SET_BADGE_FLAG( BADGE_ID_06 )
			_SET_BADGE_FLAG( BADGE_ID_07 )
			_SET_BADGE_FLAG( BADGE_ID_08 )
			
		ELSIF $SCWK_ANSWER == 20 THEN
			
			_FLAG_SET( SYS_FLAG_ARRIVE_T01 )
			_FLAG_SET( SYS_FLAG_ARRIVE_T02 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C01 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C02 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C03 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C04 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C05 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C06 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C07 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C08 )
			_FLAG_SET( SYS_FLAG_ARRIVE_D09 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C09 )
			_FLAG_SET( SYS_FLAG_ARRIVE_T03 )
			_FLAG_SET( SYS_FLAG_ARRIVE_T04 )
			_FLAG_SET( SYS_FLAG_ARRIVE_C11 )
			
		ELSIF $SCWK_ANSWER == 70 THEN
			//イベントジャンプ
			_CALL	ev_event_jump
			$SCWK_TEMP0 = 555
			
		ELSIF $SCWK_ANSWER == 80 THEN
			//イベントＯＦＦ
			_CALL	ev_event_off
			$SCWK_TEMP0 = 555
			
		ELSIF $SCWK_ANSWER == 90 THEN
			//マップ差し替え
			_CALL	ev_change_mapmatrix
			$SCWK_TEMP0 = 555
			
		ELSIF $SCWK_ANSWER == 100 THEN
			//育て屋オープン
			_FLAG_RESET( FV_R03_SODATEYA_01 )
			_FLAG_SET( FE_SODATEYAOLDMAN_OPEN )
			
		ELSIF $SCWK_ANSWER == 110 THEN
			//初期３匹のタイプ変更
			_CALL	ev_firstpoke_type
			
		ELSE
			//やめる
			$SCWK_TEMP0 = 555
			
		ENDIF
	
	ENDWHILE

EVENT_END


//イベントＯＦＦ-----------------------------------------------
ev_event_off:
	//メニュー作成
	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
	//リスト追加
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_06, 2 )	//Ｎの城
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_08, 0 )	//チャンピオン部屋
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_09, 1 )	//Ｔ01全イベント
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_11, 3 )	//Ｃ09ポケモンリーグ手前
	_BMPMENU_MAKE_LIST( msg_debug_00, 10 )	//やめる
	//メニュー表示
	_BMPMENU_START()

	IF $SCWK_ANSWER == 0 THEN
		//チャンピオン部屋のＮとのイベントを無効にする
		//$WK_SCENE_C09R0501 = 1
		//_FLAG_SET( FV_C09R0501_BOSS_01 )
		//_FLAG_SET( FV_C09R0501_CHAMPION_01 )
		_MAP_CHANGE( ZONE_ID_C09R0501, 16, 9, DIR_UP )

	ELSIF $SCWK_ANSWER == 1 THEN
		//T01の初回イベントを全部OFF
		//図鑑入手イベント終わった状態にする
		//$WK_SCENE_T01R0401 = 1
		//_FLAG_SET( FV_T01R0401_HAKASE2 )
		//_FLAG_SET( FV_T01R0401_RIVAL )
		//_FLAG_SET( FV_T01R0401_SUPPORT )
		//サポート初回イベント終わった
		//$WK_SCENE_T01R0201 = 1
		//_FLAG_SET( FV_T01R0201_SUPPORT )
		//_FLAG_RESET( FV_T01_SUPPORT )
		//主人公宅の初回イベント終わった
		//$WK_SCENE_T01R0101 = 1
		//_FLAG_SET( FV_T01R0101_FRIENDS )
		//_FLAG_SET( FV_T01R0102_PRESENT )
		//$WK_SCENE_T01R0102 = 2
		//_FLAG_SET( FV_T01R0102_RIVAL )
		//_FLAG_SET( FV_T01R0102_SUPPORT )

	ELSIF $SCWK_ANSWER == 2 THEN
		//Ｎの城１Ｆの初回イベント無効
		//$WK_SCENE_N01R0101 = 20
		//Ｎの城２Ｆのダークトリニティイベント無効
		//$WK_SCENE_N01R0201 = 20
		//Ｎの城・謁見の間イベント無効
		//$WK_SCENE_N01R0502 = 20
		
		_MAP_CHANGE( ZONE_ID_N01R0101, 25, 17, DIR_UP )

	ELSIF $SCWK_ANSWER == 3 THEN
		//ポケモンリーグ手前の初回誘導POSイベントを無効
		//$WK_SCENE_C09 = 1
		_MAP_CHANGE( ZONE_ID_C09, 32, 57, DIR_UP )

	ENDIF
	
_RET


//マップ差し替え-----------------------------------------------
ev_change_mapmatrix:
	//マップマトリクスの差し替え全部ON
	_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_01, TRUE, TRUE )
	_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_02, TRUE, TRUE )
	_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, TRUE, TRUE )
	_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_05, TRUE, TRUE )
	_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, TRUE, TRUE )
	_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, TRUE, TRUE )
_RET


//イベントジャンプ-----------------------------------------------
ev_event_jump:
	{
	DEFINE_LOCAL LWK_EVTJUMP
	//メニュー作成
	_BMPMENU_INIT_EX( 1, 1, 0, 1, LWK_EVTJUMP )
	//リスト追加
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_10, 10 )	//自宅２Fゲーム開始イベント
	_BMPMENU_MAKE_LIST( msg_debug_10, 12 )	//T02演説イベント
	_BMPMENU_MAKE_LIST( msg_debug_suginaka_11, 15 )	//Ｃギア入手イベント
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_12, 20 )	//C04 サポート父イベント
	_BMPMENU_MAKE_LIST( msg_debug_09, 30 )	//復帰チャンピオン戦
	_BMPMENU_MAKE_LIST( msg_debug_mizu_03, 40 )	//カザカミ・ライカミイベント
	_BMPMENU_MAKE_LIST( msg_debug_mizu_04, 50 )	//ツチノカミ（カザカミ・ライカミ追加）
//	_BMPMENU_MAKE_LIST( msg_debug_mizu_05, 60 )	//カザカミ・ライカミ手持ちに追加
	_BMPMENU_MAKE_LIST( msg_debug_masafumi_16, 70 )	//ライ遭遇イベント
	_BMPMENU_MAKE_LIST( msg_debug_suginaka_07, 80 )		//ラストイベント１・はじめから
	_BMPMENU_MAKE_LIST( msg_debug_suginaka_08, 90 )		//ラストイベント２・伝説捕獲前
	_BMPMENU_MAKE_LIST( msg_debug_suginaka_10, 100 )	//ラストイベント３・Ｎ戦前
	_BMPMENU_MAKE_LIST( msg_debug_suginaka_13, 110 )	//ラストイベント４・ゲーチス戦前
	_BMPMENU_MAKE_LIST( msg_debug_00, 0 )	//やめる
	//メニュー表示
	_BMPMENU_START()
	
	IF $LWK_EVTJUMP == 10 THEN
		//自宅２階のゲーム開始イベントを起動
		_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, FALSE, TRUE )
		//_FLAG_SET( FV_T01R0102_SUPPORT )
		//_FLAG_RESET( FV_T01R0102_RIVAL )
		//_FLAG_RESET( FV_T01R0102_PRESENT )
		//$WK_SCENE_T01R0102 = 0
		_MAP_CHANGE( ZONE_ID_T01R0102, 5, 6, DIR_DOWN )

	ELSIF $LWK_EVTJUMP == 12 THEN
		//T02演説イベント
		//$WK_SCENE_T02 = 1
		//ライバルストッパー解除
		//_FLAG_SET( FV_T02_RIVAL )
		//_FLAG_SET( FV_T02_HAKASE )
		//演説イベントフラグ開始
		//_FLAG_RESET( FV_T02_SAGE )
		//_FLAG_RESET( FV_T02_HAKAI )
		//_FLAG_RESET( FV_T02_NNN )
		//_FLAG_RESET( FV_T02_RIVAL_02 )
		//_FLAG_RESET( FV_T02_MAN )
		//_FLAG_RESET( FV_T02_SPEECH_BEFORE )
		//_FLAG_SET( FV_T02_SPEECH_AFTER )
		_MAP_CHANGE( ZONE_ID_T02PC0101, 10, 10, DIR_DOWN )

	ELSIF $LWK_EVTJUMP == 15 THEN
		//Ｃギア入手イベント
		//ワーク追加
		//$WK_SCENE_C01R0102 = 1
		//$WK_SCENE_D01R0101_POKE = 4
		_MAP_CHANGE( ZONE_ID_C01R0102, 10, 8, DIR_RIGHT )

	ELSIF $LWK_EVTJUMP == 20 THEN
		//C04サポートパパイベント

		//ミュージカルホール内、イベント無効
		//$WK_SCENE_C04R0201 = 1
		//C04フィールド：サポートパパイベントを有効にする
		//$WK_SCENE_C04 = 2
		//サポートパパを表示
		//_FLAG_RESET( FV_C04_SUPPORTPAPA_01 )
		//_FLAG_RESET( FV_C04_SUPPORT_01 )
		_MAP_CHANGE( ZONE_ID_C04R0201, 10, 10, DIR_UP )

	ELSIF $LWK_EVTJUMP == 30 THEN
		//復帰チャンピオン戦

		//ポケモンリーグのチャンピオンとライバルを非表示
		//_FLAG_SET( FV_C09R0501_RIVAL_01 )
		//_FLAG_SET( FV_C09R0501_CHAMPION_01 )
		//_FLAG_SET( FV_C09R0501_BOSS_01 )
		//チャンピオン部屋：復帰チャンピオンを表示
		//_FLAG_RESET( FV_C09R0501_CHAMPION_02 )
		//復帰チャンピオン戦を有効
		//$WK_SCENE_C09R0501 = 3
		_MAP_CHANGE( ZONE_ID_C09R0501, 16, 20, DIR_UP )
		
	ELSIF $LWK_EVTJUMP == 40 THEN
		//R07カザカミ・ライカミ登場イベント起動
		//$WK_SCENE_R07_MOVEPOKE = 2
		//R07天気を晴れに
		_FLAG_RESET(SYS_FLAG_WEATHER_R07)
		//おばあちゃん家に移動
		_MAP_CHANGE( ZONE_ID_R07R0301, 6, 8, DIR_DOWN )
	
	ELSIF $LWK_EVTJUMP == 50 THEN
		//カザカミ・ライカミを手持ちに追加
		_ADD_POKEMON_TO_PARTY( SCWK_ANSWER, MONSNO_648, 0, 50 )
		_ADD_POKEMON_TO_PARTY( SCWK_ANSWER, MONSNO_649, 0, 50 )

		//ツチノカミ寸劇を終了しておく
		//$WK_SCENE_R14R0201_LEG = 2
		//イベント初期化
		_FLAG_RESET( FE_R14R0201_LEG_GET )
		_FLAG_RESET( FE_R14R0201_LEG_MEET )
		_FLAG_SET( FV_R14R0201_LEG )
		//神社前に移動
		_MAP_CHANGE( ZONE_ID_R14R0201, 22, 17, DIR_UP )
		
	ELSIF $LWK_EVTJUMP == 70 THEN
		//ライ遭遇イベント
		//$WK_SCENE_D10_LEG = 0
		_MAP_CHANGE( ZONE_ID_D10R0201, 50, 50, DIR_DOWN )

	ELSIF $LWK_EVTJUMP == 80 THEN
		//ラストシーン・はじめから
		//OBJ調整
		//_FLAG_SET( FV_N01R0502_LEGEND_01 )
		//_FLAG_SET( FV_N01R0502_LEGEND_02 )
		//_FLAG_SET( FV_N01R0502_EVENT_01 )

		//ワークを０に
		//$WK_SCENE_N01R0502 = 0

		//マップチェンジ
		_MAP_CHANGE( ZONE_ID_N01R0502, 16, 58, DIR_UP )

	ELSIF $LWK_EVTJUMP == 90 THEN
		//ラストシーン・伝説捕獲前
		//OBJ調整
		//_FLAG_RESET( FV_N01R0502_LEGEND_01 )
		//_FLAG_RESET( FV_N01R0502_LEGEND_02 )
		//_FLAG_SET( FV_N01R0502_EVENT_01 )

		//謁見の間、水が干上がった状態のマップに変更
		_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, TRUE, TRUE )

		//ワークを２に
		//$WK_SCENE_N01R0502 = 2
		
		_MAP_CHANGE( ZONE_ID_N01R0502, 16, 45, DIR_UP )

	ELSIF $LWK_EVTJUMP == 100 THEN
		//ラストシーン・Ｎ戦前
		//OBJ調整
		//_FLAG_RESET( FV_N01R0502_LEGEND_01 )	//Nの伝説
		//_FLAG_SET( FV_N01R0502_LEGEND_02 )	//自機の伝説
		//_FLAG_SET( FV_N01R0502_EVENT_01 )

		//謁見の間、水が干上がった状態のマップに変更
		_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, TRUE, TRUE )

		//ワークを３に
		//$WK_SCENE_N01R0502 = 3
		
		_MAP_CHANGE( ZONE_ID_N01R0502, 16, 45, DIR_UP )

	ELSIF $LWK_EVTJUMP == 110 THEN
		//ラストシーン・ゲーチス戦前
		//OBJセット
		//_FLAG_SET( FV_C09R0501_RIVAL_01 )
		//_FLAG_SET( FV_C09R0501_CHAMPION_01 )
		//_FLAG_SET( FV_N01R0501_SAGE1 )
		//_FLAG_RESET( FV_N01R0502_EVENT_01 )

		//謁見の間、水が干上がった状態のマップに変更
		_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, TRUE, TRUE )

		//ワーク
		//$WK_SCENE_N01R0502 = 5
		//$WK_SCENE_C09R0501 = 2	
			
		_MAP_CHANGE( ZONE_ID_N01R0502, 16, 45, DIR_UP )
		
	ENDIF
	}
	
_RET


//初期３匹のタイプ変更-----------------------------------------------
ev_firstpoke_type:
	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
	//リスト追加
	_BMPMENU_MAKE_LIST( msg_debug_suginaka_01, 0 )	//くさタイプ
	_BMPMENU_MAKE_LIST( msg_debug_suginaka_03, 1 )	//ほのおタイプ
	_BMPMENU_MAKE_LIST( msg_debug_suginaka_02, 2 )	//みずタイプ
	_BMPMENU_MAKE_LIST( msg_debug_00, 3 )	//やめる
	_BMPMENU_START()
	
	SWITCH $SCWK_ANSWER
	CASE 0 THEN
		$WK_SYS_FIRST_POKETYPE = FIRST_POKETYPE_KUSA
	CASE 1 THEN
		$WK_SYS_FIRST_POKETYPE = FIRST_POKETYPE_HONOO
	CASE 2 THEN
		$WK_SYS_FIRST_POKETYPE = FIRST_POKETYPE_MIZU
	DEFAULT
		//やめる
	ENDSWITCH

_RET


