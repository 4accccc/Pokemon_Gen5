/*                                                            */
/**************************************************************/
EVENT_START ev_debug_onoue
	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
	_BMPMENU_MAKE_LIST( msg_debug_onoue_01,   0 ) // 最も獲得数の多いメダルカテゴリ
	_BMPMENU_MAKE_LIST( msg_debug_onoue_02,   1 ) // メダル獲得済み確認
	_BMPMENU_MAKE_LIST( msg_debug_onoue_03,   2 ) // メダル獲得済み確認
	_BMPMENU_MAKE_LIST( msg_debug_onoue_04,   3 ) // メダル獲得済み確認
	_BMPMENU_MAKE_LIST( msg_debug_onoue_05,   4 ) // メダル獲得済み確認
	_BMPMENU_MAKE_LIST( msg_debug_onoue_06,   5 ) // 全捕獲チェック
	_BMPMENU_MAKE_LIST( msg_debug_onoue_07,   6 ) // 全捕獲
	_BMPMENU_MAKE_LIST( msg_debug_onoue_08,   7 ) // 獣道データセット
	_BMPMENU_START()

  SWITCH $SCWK_ANSWER
  CASE 0 THEN
  {
	  DEFINE_LOCAL LWK_CATEGORY
    _GET_MOST_GET_MEDALCATEGORY(LWK_CATEGORY)
    _DEBUG_PRINT_WK(LWK_CATEGORY)
  }
  CASE 1 THEN
  {
 	  DEFINE_LOCAL LWK_IS_GET
    _CHECK_MEDAL_GET( LWK_IS_GET ,1)
    _DEBUG_PRINT_WK(LWK_IS_GET)
  }
  CASE 2 THEN
  {
    _SC_WALK_COUNT_START()
  }
  CASE 3 THEN
  {
    _SC_WALK_COUNT_STOP()
  }
  CASE 4 THEN
  {
	  DEFINE_LOCAL LWK_WALK_CNT
    _SC_WALK_COUNT_GET(LWK_WALK_CNT)
    _DEBUG_PRINT_WK(LWK_WALK_CNT)
  }
  CASE 5 THEN
  {
	  DEFINE_LOCAL RET_WK
    _SC_GET_ZONE_POKE_CMP_CHECK(ZONE_ID_C12,SCR_HABITAT_TYPE_LAND,TRUE,RET_WK)
    _DEBUG_PRINT_WK(RET_WK)
    _SC_GET_ZONE_POKE_CMP_CHECK(ZONE_ID_C12,SCR_HABITAT_TYPE_SEA,TRUE,RET_WK)
    _DEBUG_PRINT_WK(RET_WK)
    _SC_GET_ZONE_POKE_CMP_CHECK(ZONE_ID_C12,SCR_HABITAT_TYPE_FISHING,TRUE,RET_WK)
    _DEBUG_PRINT_WK(RET_WK)
    _SC_GET_ZONE_POKE_CMP_CHECK(ZONE_ID_C12,SCR_HABITAT_TYPE_LAND,FALSE,RET_WK)
    _DEBUG_PRINT_WK(RET_WK)
    _SC_GET_ZONE_POKE_CMP_CHECK(ZONE_ID_C12,SCR_HABITAT_TYPE_SEA,FALSE,RET_WK)
    _DEBUG_PRINT_WK(RET_WK)
    _SC_GET_ZONE_POKE_CMP_CHECK(ZONE_ID_C12,SCR_HABITAT_TYPE_FISHING,FALSE,RET_WK)
    _DEBUG_PRINT_WK(RET_WK)
  }
  CASE 6 THEN
  {
	  DEFINE_LOCAL RET_WK
    _INFINITY_DUNGEON_GET_DUNGEON_STATUS(RET_WK)
    _DEBUG_PRINT_WK(RET_WK)
  }
  CASE 7 THEN
  {
    _ANIMAL_TRAIL_DATA_SET(SCR_ANIMAL_TRAIL_ID_03,SCR_ANIMAL_TRAIL_MAIN_TABLE_POKE_A,3,TRUE)
  }
  ENDSWITCH
 
EVENT_END

/**************************************************************/
/*              なぎはし                                      */
/**************************************************************/
EVENT_START   ev_debug_nagihashi
{
  DEFINE_LOCAL LWK_RET

  $SCWK_TEMP0 = 0

	WHILE $SCWK_TEMP0 == 0

    //メインメニュー
    _CALL sub_nagi_main_menu

	  SWITCH $SCWK_ANSWER
	  CASE 0 THEN //JA
      _GET_ZONE_ID( LWK_RET )
      IF $LWK_RET == ZONE_ID_C16 THEN
        _RESERVE_SCRIPT( SCRID_RESERVE_RESORT_DEBUG )
        $SCWK_TEMP0 = 1
      ENDIF
    DEFAULT
      $SCWK_TEMP0 = 1
	  ENDSWITCH

  ENDWHILE
}
EVENT_END

//--------------------------------------------------------------
//               なぎはしメインメニュー
//--------------------------------------------------------------
sub_nagi_main_menu:
{
	_BMPMENU_INIT_EX( 1, 1, 0, 1, SCWK_ANSWER )
	_BMPMENU_MAKE_LIST( msg_debug_nagi_00,   0 ) //JA
	_BMPMENU_START()
}
_RET

