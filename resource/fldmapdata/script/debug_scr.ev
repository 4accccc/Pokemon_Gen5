      _FLAG_SET( SYS_FLAG_ARRIVE_D26R0101 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R08 )
      _FLAG_SET( SYS_FLAG_ARRIVE_R08R0101 )
      _FLAG_SET( SYS_FLAG_ARRIVE_D08 )
