
//======================================================================
//                c15r0201.ev
//
//    スクリプトファイル：c15r0201用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c15r0201.h"
  .include  "c15r0201.h"

  //@author fujimura_souichirou（ポケウッド説明ＮＰＣ）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_c15r0201_pwmoji_01
_EVENT_DATA   ev_c15r0201_policeman_01
_EVENT_DATA_END


/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
// pokewood_scr.evにある


/**************************************************************/
/*  アクター：話しかけ（ポケウッド説明）                      */
/**************************************************************/
EVENT_START   ev_c15r0201_pwmoji_01

_TALK_OBJ_START()

  DEFINE_LOCAL  LWK_SELECT
  DEFINE_LOCAL  LWK_REPEAT

  $LWK_REPEAT = 0

  WHILE $LWK_REPEAT != 1

    //アクター：やあ！　ポケウッドに　ついて
    _BALLOONWIN_OBJMSG_POS( msg_c15r0201_pwmoji_01_01, C15R0201_PWMOJI_01, POS_DL )

    //分岐・トライ・ベーシック……　やめる
    _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_SELECT )

    _BMPMENU_MAKE_LIST( msg_c15r0201_pwmoji_01_08, 0 ) //だいほんに　ついて
    _BMPMENU_MAKE_LIST( msg_c15r0201_pwmoji_01_09, 1 ) //ポケモンに　ついて
    _BMPMENU_MAKE_LIST( msg_c15r0201_pwmoji_01_10, 2 ) //えんぎに　ついて
    _BMPMENU_MAKE_LIST( msg_c15r0201_pwmoji_01_11, 3 ) //セリフに　ついて
    _BMPMENU_MAKE_LIST( msg_c15r0201_pwmoji_01_12, 4 ) //にんきに　ついて
    _BMPMENU_MAKE_LIST( msg_c15r0201_pwmoji_01_13, 5 ) //いいえ

    //メニュー表示
    _BMPMENU_START()

    //選択結果で分岐
    SWITCH $LWK_SELECT
    CASE 0 THEN
      //アクター：ポケウッドの　えいがの　さつえいは
      _BALLOONWIN_OBJMSG_POS( msg_c15r0201_pwmoji_01_02, C15R0201_PWMOJI_01, POS_DL )

    CASE 1 THEN
      //アクター：ポケウッドの　さつえいにも
      _BALLOONWIN_OBJMSG_POS( msg_c15r0201_pwmoji_01_03, C15R0201_PWMOJI_01, POS_DL )

    CASE 2 THEN
      //アクター：ポケウッドの　えんぎの　きほんは
      _BALLOONWIN_OBJMSG_POS( msg_c15r0201_pwmoji_01_04, C15R0201_PWMOJI_01, POS_DL )

    CASE 3 THEN
      //アクター：さつえいを　すすめていると
      _BALLOONWIN_OBJMSG_POS( msg_c15r0201_pwmoji_01_05, C15R0201_PWMOJI_01, POS_DL )

    CASE 4 THEN
      //アクター：たくさん　えいがを　さつえいして
      _BALLOONWIN_OBJMSG_POS( msg_c15r0201_pwmoji_01_06, C15R0201_PWMOJI_01, POS_DL )

    CASE 5 THEN
      //アクター：じゃあ　がんばってね！
      _BALLOONWIN_OBJMSG_POS( msg_c15r0201_pwmoji_01_07, C15R0201_PWMOJI_01, POS_DL )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      //========================================/
      //繰り返し脱出
      $LWK_REPEAT = 1
      //========================================/

    DEFAULT
      //アクター：じゃあ　がんばってね！
      _BALLOONWIN_OBJMSG_POS( msg_c15r0201_pwmoji_01_07, C15R0201_PWMOJI_01, POS_DL )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      //========================================/
      //繰り返し脱出
      $LWK_REPEAT = 1
      //========================================/

    ENDSWITCH

  ENDWHILE

EVENT_END

/**************************************************************/
/*  POLICEMAN：話しかけ（ガードマン）                      */
/**************************************************************/
EVENT_START   ev_c15r0201_policeman_01

  _PLAYER_NAME(0)

  IF FLAG_ON( FE_C15R0401_GUARDMAN ) THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c15r0201_policeman_02_02 )
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c15r0201_policeman_02_01 )
  ENDIF

EVENT_END

