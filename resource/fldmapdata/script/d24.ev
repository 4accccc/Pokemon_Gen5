//    スクリプトファイル：d24用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d24.h"
  .include  "d24.h"
  .include  "pair_scr_def.h"

  //@author Mizuguchi_Mai
  //@author fujimura_souichirou（看板配置）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_d24
_EVENT_DATA   ev_init_d24
_EVENT_DATA   ev_bg_d24_sign1_01
_EVENT_DATA   ev_recover_d24
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL LCW_POSX
DEFINE_LOCAL LCW_POSZ

/************************************************************/
/*		CALL：特殊接続                             */
/************************************************************/
ev_exit_change:

  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //バージョンごとに異なる接続を配置
  
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D24_D24R0701_EXIT01, 655, -2, 289 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D24_D24R1101_EXIT01, 667, -1, 304 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D24_D24R1101_EXIT02, 671, -1, 299 )
  //W2
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D24_D24R0101_EXIT01, 655, -2, 289 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D24_D24R0501_EXIT01, 667, -1, 304 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D24_D24R0501_EXIT02, 671, -1, 299 )
  ENDIF

_RET

/************************************************************/
/*  ZONE_CHANGE                                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d24
  
  _CALL ev_exit_change
  
  //イベント進行状態を見てライブキャスターの状態をセット
  IF FLAG_ON( SYS_FLAG_PAIR )  THEN
    //==================================//
    //ローカルライブキャスター・ベル通話状態を変更
    _PERSON_STATE_SET_BELL( BELL_STATE_D24_2 )
    //==================================//
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d24

  _CALL ev_exit_change
  
INIT_EVENT_END


/************************************************************/
/*  FIELD_INIT_SCRIPT                                       */
/************************************************************/
INIT_EVENT_START ev_init_d24

//

INIT_EVENT_END

/**************************************************************/
/*  施設掲示板01                                              */
/**************************************************************/
EVENT_START  ev_bg_d24_sign1_01
  _EASY_BGWIN_MSG( msg_d24_sign1_01, TYPE_POST )
EVENT_END


