  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c04r0801.h"
  //.include  "c04r0801.h"
  
  //@author	suginaka_katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_bg_c04r0801_board_01
_EVENT_DATA		ev_c04r0801_baseballm_01
_EVENT_DATA		ev_c04r0801_trainerw_01
_EVENT_DATA		ev_c04r0801_infomationw_01
_EVENT_DATA		ev_c04r0801_boy4_01
_EVENT_DATA_END


/**************************************************************/
/*  電光掲示板のイベントスクリプト*/
/**************************************************************/
EVENT_START   ev_bg_c04r0801_board_01

	_LOOK_ELBOARD(ELBOARD_CAMERA_FRAME)

EVENT_END

/************************************************************/
/*							野球選手						*/
/************************************************************/
EVENT_START	ev_c04r0801_baseballm_01
	//きょうせいギプス入手処理
	_EASY_TALK_ITEM_EVENT( ITEM_KYOUSEIGIPUSU, 1, FE_C04R0801_ITEMGET_01, msg_c04r0801_baseballm_01, msg_c04r0801_baseballm_02, msg_c04r0801_baseballm_02)
EVENT_END

/**************************************************************/
/*			エリートトレーナー♀							  */
/**************************************************************/
EVENT_START		ev_c04r0801_trainerw_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c04r0801_elitew_01 )
EVENT_END	

/**************************************************************/
/*		受付員									  */
/**************************************************************/
EVENT_START		ev_c04r0801_infomationw_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c04r0801_infomationw_01 )
EVENT_END	

/************************************************************/
/*		せいそくちリストイベント						*/
/************************************************************/
EVENT_START	ev_c04r0801_boy4_01

	//イベント終了前か？
	IF FLAG_OFF( FE_C04R0801_ITEMGET_02 ) THEN

		_TALK_OBJ_START()
		
		//あら？
		_BALLOONWIN_TALKOBJ_MSG(msg_c04r0801_list_01)
		
		//せいそくちリストが埋まっているかチェック
		_SC_GET_ZONE_POKE_CMP_CHECK( ZONE_ID_R16 ,SCR_HABITAT_TYPE_LAND ,FALSE ,SCWK_ANSWER )

		//みたコンプしている場合
		IF $SCWK_ANSWER == TRUE THEN
		
			_BALLOONWIN_TALKOBJ_MSG(msg_c04r0801_list_03)
			_MSGWIN_CLOSE()
			
			_ITEM_EVENT_KEYWAIT( ITEM_TAIMAABOORU, 5 )
			
			//========================================//
			//イベント終了フラグセット
			_FLAG_SET(FE_C04R0801_ITEMGET_02)
			
			//========================================//

			//せいそくちリストの　きのうを
			_BALLOONWIN_TALKOBJ_MSG(msg_c04r0801_list_04)
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		ELSE
			
			//うまってないんだね
			_BALLOONWIN_TALKOBJ_MSG(msg_c04r0801_list_02)
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		ENDIF


	//イベント終了後の場合
	ELSE

		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c04r0801_list_04 )

	ENDIF

EVENT_END
