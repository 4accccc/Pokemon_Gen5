
//======================================================================
//                d27r0401.ev
//
//    スクリプトファイル：d27r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d27r0401.h"
  .include  "d27r0401.h"

  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_pos_d27r0401_warp_01
_EVENT_DATA    ev_zone_d27r0401
_EVENT_DATA    ev_init_d27r0401
_EVENT_DATA    ev_recover_d27r0401
_EVENT_DATA    ev_scene_d27r0401_swboss_01
_EVENT_DATA    ev_d27r0401_swboss_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//																	//
//	特殊な接続に LOCALWORK15 を使用ししています。     //
//	同マップ内の使用を禁止します。									//
//------------------------------------------------------------------//

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*					ZONE_CHANGE_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r0401
  
  //

INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r0401
  
  //【仮】アクロマ戦終了後
  IF $WK_SCENE_D27R0401_SWBOSS_01 == 2 THEN
    _OBJ_POS_CHANGE(D27R0401_SWBOSS_01,7,2,5,DIR_DOWN)
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r0401

  //

INIT_EVENT_END

/************************************************************/
/*					SCENE_CHANGE：アクロマ戦  						*/
/************************************************************/
INIT_EVENT_START	ev_scene_d27r0401_swboss_01

  //カメラ操作　アクロマを中央に
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,491520,0,176128,80 )
  
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //主人公ワープ
  _OBJ_POS_CHANGE(MMDL_ID_PLAYER,7,0,10,DIR_UP)

  //アニメ：アクロマ振り返る／主人公中央に移動
  _OBJ_ANIME( D27R0401_SWBOSS_01 , anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //アクロマ：そのポケモンは……
  _BALLOONWIN_OBJMSG_POS( msg_d27r0401_swboss_03_01 , D27R0401_SWBOSS_01 ,POS_DEFAULT )
  
  //アクロマ：わたくしは
  _BALLOONWIN_OBJMSG_POS( msg_d27r0401_swboss_03_02 , D27R0401_SWBOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アクロマ中央へ移動
  _OBJ_ANIME_AUTO( D27R0401_SWBOSS_01 , 7, 7, FORCE_TYPE_NPC, 8, DIR_UD)
  _CAMERA_MOVE( 9688,0,970752,491520,131103,434176,24 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  _OBJ_ANIME_WAIT()
  
  //アクロマ：あなたがた
  _BALLOONWIN_OBJMSG_POS( msg_d27r0401_swboss_03_03 , D27R0401_SWBOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (24)
  
  //アニメ：アクロマ中央へ移動
  _OBJ_ANIME_AUTO( D27R0401_SWBOSS_01 , 7, 9, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //アクロマ：それはさておきっ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0401_swboss_03_04 , D27R0401_SWBOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //トレーナー戦
  _TRAINER_BTL_SET( TRID_SWBOSS_01, 0 )
  _CALL ev_battle_check
  
  //アクロマ：……つよい！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0401_swboss_03_05 , D27R0401_SWBOSS_01 ,POS_DEFAULT )
  _YES_NO_WIN( SCWK_ANSWER )
  
  //アクロマ：なるほど……！
  _BALLOONWIN_OBJMSG_WB( msg_d27r0401_swboss_03_06 , msg_d27r0401_swboss_03_07 , D27R0401_SWBOSS_01 , POS_DEFAULT)
  
  //アクロマ：くりかえしますが
  _BALLOONWIN_OBJMSG_POS( msg_d27r0401_swboss_03_08 , D27R0401_SWBOSS_01 ,POS_DEFAULT )
  
  //アクロマ：ごぶうんを
  _BALLOONWIN_OBJMSG_POS( msg_d27r0401_swboss_03_09 , D27R0401_SWBOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()

  //========================================//
  //D27R0401 SCENE_CHANGE無効
  $WK_SCENE_D27R0401_SWBOSS_01 = 2
  //D27R0501 SCENE_CHANGE有効
  $WK_SCENE_D27R0601_SWSAGE1_01 = 1
  //D27R1001,D27R1301 STOPPER解除
  _FLAG_SET( FV_D27R1001_STOPPER_01 )
  _FLAG_SET( FV_D27R1301_STOPPER_01 )
  //========================================//

INIT_EVENT_END

/**************************************************************/
/* アクロマ：話しかけ                                         */
/**************************************************************/
EVENT_START   ev_d27r0401_swboss_01
  //【仮】条件で会話分岐
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0401_swboss_03_09 )
EVENT_END

/************************************************************/
/*					特殊接続				*/
/************************************************************/
EVENT_START	ev_pos_d27r0401_warp_01

  
  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //バージョンごとに異なるマップに移動
  
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _MAP_CHANGE_WARP( ZONE_ID_D27R1001, 26, 10, LWK_DIR )
  //W2
  ELSE
    _MAP_CHANGE_WARP( ZONE_ID_D27R1301, 26, 10, LWK_DIR )
  ENDIF
  
EVENT_END

ev_battle_check:	
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

