
//======================================================================
//                c03gym0201.ev
//
//    スクリプトファイル：c03gym0201用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c03gym0201.h"
  .include  "c03gym0201.h"
  .include  "c03gym0101_def.h"


//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   prog_c03gym0201_gate_in_4a
_EVENT_DATA   prog_c03gym0201_gate_in_4b
_EVENT_DATA   c03gym0201_leader3_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_c03gym0201:
//  _END

/**************************************************************/
/*  出入り口                                               */
/**************************************************************/
EVENT_START prog_c03gym0201_gate_in_4a
  _CALL sub_gatein_anm

  //3Fに移動
  _MAP_CHANGE_NO_FADE( ZONE_ID_C03GYM0101, 4, 20, 13, DIR_DOWN )
EVENT_END

EVENT_START prog_c03gym0201_gate_in_4b
  _CALL sub_gatein_anm
  
  //1Fに移動
  _MAP_CHANGE_NO_FADE( ZONE_ID_C03GYM0101, 8, 0, 4, DIR_DOWN )
EVENT_END

sub_gatein_anm:
{
  DEFINE_LOCAL  i_player_dir

  _PLAYER_DIR_GET( i_player_dir ) 
  SWITCH $i_player_dir
  CASE DIR_UP THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gatein_u )
  CASE DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gatein_d )
  CASE DIR_LEFT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gatein_l )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gatein_r )
  ENDSWITCH
  _OBJ_ANIME_WAIT()
  
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()
}
_RET

_ANIME_LABEL  anm_player_gatein_u
  _ANIME_DATA AC_JUMP_U_1G_8F,1
  _ANIME_DATA AC_VANISH_ON,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gatein_d
  _ANIME_DATA AC_JUMP_D_1G_8F,1
  _ANIME_DATA AC_VANISH_ON,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gatein_l
  _ANIME_DATA AC_JUMP_L_1G_8F,1
  _ANIME_DATA AC_VANISH_ON,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_gatein_r
  _ANIME_DATA AC_JUMP_R_1G_8F,1
  _ANIME_DATA AC_VANISH_ON,1
  _ANIME_DATA ACMD_END,0


/************************************************************/
/*			ジムリーダー戦のスクリプトイベント				*/
/************************************************************/
EVENT_START	c03gym0201_leader3_01

	_TALK_OBJ_START()
	//バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_03 )

	//ジムバッジフラグで分岐
	IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前なら、ジムリーダー戦イベント
		_CALL		ev_leader3_btl

	ELSE

		//ゲームクリア前なら
		IF FLAG_OFF( SYS_FLAG_GAME_CLEAR )  THEN
		
			//キミは　たびに　でてから　どれだけの
			_BALLOONWIN_OBJMSG( msg_c03gym0201_leader_06 , C03GYM0201_LEADER3_01 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
			
		//ゲームクリア後なら
		ELSE
		
			//やあ　さいきんは　ポケモンを　そだて
			_BALLOONWIN_OBJMSG( msg_c03gym0201_leader_end_01 , C03GYM0201_LEADER3_01 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
		
		ENDIF

	ENDIF
	
EVENT_END

//ジムリーダー戦
ev_leader3_btl:

	//アーティが喋る　
	//アーティ:ぬうん？　･･････キミ　どこかで　であったっけ？
	_BALLOONWIN_TALKOBJ_MSG( msg_c03gym0201_leader_01 )
	_BALLOONWIN_CLOSE()

	//トレーナー戦呼び出し
	_TRAINER_BTL_SET( TRID_LEADER3_01, 0 )
	
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
			_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF
		
	//リーダー：戦闘後メッセージ→続けてバッジ入手へ
	//アーティが喋る　
	//アーティ:あうう　まけちゃったよ……
	_BALLOONWIN_TALKOBJ_MSG( msg_c03gym0201_leader_02 )
	_BALLOONWIN_CLOSE()

  //リーダー戦勝利時の情報登録
  _SET_GYM_VICTORY_INFO( BADGE_ID_03 )
	//バッジ入手処理
	_SET_BADGE_FLAG( BADGE_ID_03 )		//バッジフラグon
	_PLAYER_NAME( 0 )
	
	{
	
	//バッジ入手演出再生
	_ME_PLAY( SEQ_ME_BADGE )
	
	//性別が格納されるローカル変数を定義
	DEFINE_LOCAL SCWK_SEX
	_GET_MY_SEX(SCWK_SEX)
	
	//男性だった場合
	IF $SCWK_SEX == PM_MALE THEN
		_CALL_FLD3D_CUTIN( FLDCIID_GYM03 )
	//女性だった場合
	ELSE
		_CALL_FLD3D_CUTIN( FLDCIID_GYM03F )
	ENDIF
	
	//ME待ち
	_ME_WAIT()
		
	}
	
	//～～はベーシックバッジを入手した！
	_SYSWIN_MSG( msg_c03gym0201_leader_03 , POS_DEFAULT )
	_SYSWIN_CLOSE()

	//ビードルバッジ　かっこいいでしょ！
	_BALLOONWIN_TALKOBJ_MSG( msg_c03gym0201_leader_04)
	_BALLOONWIN_CLOSE()

	//わざマシン入手処理　「むしのていこう」
	_ITEM_EVENT_KEYWAIT( ITEM_WAZAMASIN76, 1 )

	//リーダー：わざマシンの解説
	_BALLOONWIN_TALKOBJ_MSG( msg_c03gym0201_leader_05 )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

	//================================================//

	//電光掲示板フラグセット
	_FLAG_SET( SYS_FLAG_ELBOARD_C03GYMWIN )

	//================================================//

	
_RET

