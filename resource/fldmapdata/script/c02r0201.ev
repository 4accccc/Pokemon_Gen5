  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c02r0201.h"
  .include  "c02r0201.h"
  .include "pdw_scr_local.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_c02r0201_musician_01
_EVENT_DATA   ev_c02r0201_boy3_01
_EVENT_DATA   ev_c02r0201_man1_01
_EVENT_DATA_END


/**************************************************************/
/*  ミュージシャン：話しかけ                                  */
/**************************************************************/
EVENT_START   ev_c02r0201_musician_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c02r0201_musician_01 )
EVENT_END

/**************************************************************/
/*  男の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c02r0201_boy3_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c02r0201_boy3_01 )
EVENT_END

/**************************************************************/
/*  男性：話しかけ                                            */
/**************************************************************/
EVENT_START   ev_c02r0201_man1_01

  //PDWのアカウントチェック
  _PDW_COMMON_TOOLS( PDW_TOOLS_CHECK_ACCOUNT, 0, 0, SCWK_ANSWER )

  //PDWのアカウントを持っているかどうかで、メッセージ分岐
  //PDWアカウントが無い！
  IF $SCWK_ANSWER == FALSE THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c02r0201_man1_01 )
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c02r0201_man1_02 )
  ENDIF

EVENT_END


