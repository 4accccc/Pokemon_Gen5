/**************************************************************/
/*    MIDDLEWOMAN1の話しかけイベント           */                                                           
/**************************************************************/ 
EVENT_START    ev_h03_middlewoman1_01
	
	_TALK_OBJ_START()
	_BALLOONWIN_OBJMSG_POS(msg_h03_middlewoman_01, H03_MIDDLEWOMAN1_01, POS_UP )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
EVENT_END

/**************************************************************/
/*  おばさん：話しかけ（特性「ぼうおん」見せイベント）        */
/**************************************************************/
EVENT_START  ev_h03_middlewoman2_01

  //ポケモンチェック変数一覧
  DEFINE_LOCAL LWK_PARTY_NUM  //手持ちポケモンの数
  DEFINE_LOCAL LWK_COUNT_NUM  //WHILE文のカウンタ

  DEFINE_LOCAL LWK_POKE_TOKUSEI //ポケモンの特性
  DEFINE_LOCAL LWK_POKE_TOKUSEI_CLEAR //条件の特性を持つポケモン
  
  DEFINE_LOCAL LWK_EGG_CHK        //タマゴであるか

  _TALK_OBJ_START()

  //特性「ぼうおん」のポケモンを見せた後か
  IF $WK_OTHER_H03_BOUON_MONSNUM == 0 || $LOCALWORK3 == 1 THEN

    //おばさん：あー！　うるさいわ
    _GIZAWIN_OBJMSG_POS( msg_h03_middlewoman2_01, H03_MIDDLEWOMAN2_01, POS_DEFAULT )
    _AB_KEYWAIT_MARK()

    //乱数で0～4幅で次の台詞を決める
    _GET_RND( LOCALWORK2, 4 )

    IF $LOCALWORK2 == 0 THEN

      //おばさん：ヒウンシティの　おおどおり　くらいね！
      _GIZAWIN_OBJMSG_POS( msg_h03_middlewoman2_02, H03_MIDDLEWOMAN2_01, POS_DEFAULT )
      _AB_KEYWAIT_MARK()

    ELSIF $LOCALWORK2 == 1 THEN

      //おばさん：しゃべってるくらい　うるさいわ！
      _GIZAWIN_OBJMSG_POS( msg_h03_middlewoman2_03, H03_MIDDLEWOMAN2_01, POS_DEFAULT )
      _AB_KEYWAIT_MARK()

    ELSIF $LOCALWORK2 == 2 THEN

      //おばさん：まぢかで　きくぐらい　うるさいわ！
      _GIZAWIN_OBJMSG_POS( msg_h03_middlewoman2_04, H03_MIDDLEWOMAN2_01, POS_DEFAULT )
      _AB_KEYWAIT_MARK()

    ELSIF $LOCALWORK2 == 3 THEN

      //おばさん：エンジンの　おとぐらい　うるさいわ！
      _GIZAWIN_OBJMSG_POS( msg_h03_middlewoman2_05, H03_MIDDLEWOMAN2_01, POS_DEFAULT )
      _AB_KEYWAIT_MARK()

    ENDIF

    //手持ちのポケモンの数を確認
    //手持ち取得処理をTOTALに修正（2012.02.29　水口）
    _GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_TOTAL )

    //手持ちのポケモンの中に条件を満たしたポケモンがいるか確認（繰り返し処理）
    WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

      //指定POSのポケモンの特性を取得
      _GET_PARTY_POKE_PARAM( LWK_POKE_TOKUSEI, LWK_COUNT_NUM, SCR_POKEPARA_TOKUSEI )
      //タマゴすけチェックを追加（2012.02.29　水口）
      _CHECK_TEMOTI_EGG( LWK_EGG_CHK, LWK_COUNT_NUM )

      //指定POSのポケモンの特性は「ぼうおん」か
      IF $LWK_POKE_TOKUSEI == TOKUSYU_BOUON && $LWK_POKE_TOKUSEI_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN

        //条件を満たしたポケモンの名前を取得して保存する
        _GET_PARTY_POKE_MONSNO( WK_OTHER_H03_BOUON_MONSNUM, LWK_COUNT_NUM )
        //条件を満たしたポケモンの名前取得
        _MONS_NAME( 0, WK_OTHER_H03_BOUON_MONSNUM )
        //_TEMOTI_MONS_NAME( 0, LWK_COUNT_NUM )
        //条件を満たしたポケモンがいた（値セット）
        $LWK_POKE_TOKUSEI_CLEAR = 1

      ENDIF

      //カウント
      $LWK_COUNT_NUM += 1

    ENDWHILE

    //手持ちに特性「ぼうおん」のポケモンがいた
    IF $LWK_POKE_TOKUSEI_CLEAR == 1 THEN

      //おばさん：その　《ポケモン》の　とくせい
      _GIZAWIN_OBJMSG_POS( msg_h03_middlewoman2_07, H03_MIDDLEWOMAN2_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //イベント進行（マップチェンジするとメッセージが変わる）
      $LOCALWORK3 = 1

    ELSE

      //おばさん：あー！　とくせい　ぼうおん　の
      _GIZAWIN_OBJMSG_POS( msg_h03_middlewoman2_06, H03_MIDDLEWOMAN2_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //特性「ぼうおん」のポケモンを見せた後（マップチェンジ後）
  ELSE

    //条件を満たしたポケモンの名前取得
    _MONS_NAME( 0, WK_OTHER_H03_BOUON_MONSNUM )

    //おばさん：あなたの　《ポケモン》の　おかげよ▽
    _BALLOONWIN_TALKOBJ_MSG( msg_h03_middlewoman2_08 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

/**************************************************************/
/*  バトルガール：話しかけ（アイテム入手）                    */
/**************************************************************/
EVENT_START   ev_h03_fighterw_01
  //技マシン43「ニトロチャージ」入手
  _EASY_TALK_ITEM_EVENT( ITEM_WAZAMASIN43, 1, FE_H03_ITEMGET_01, msg_h03_fighterw_01, msg_h03_fighterw_02, msg_h03_fighterw_02 )
EVENT_END

/**************************************************************/
/*  暴走族：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_h03_badrider_01
  
  //データコンバートチェック
  _DATACONV_IS_EXIST( DATACONV_ID_SYSTEM, LOCALWORK15 )

  //データを引き継いでいるか
  IF $LOCALWORK15 >= 1 THEN

    //名前代入
    _DATACONV_SET_NAME( DATACONV_ID_SYSTEM , 1 ) 
    //暴走族：アイツと　タイマンしてたころ▼
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h03_badrider2_01 )

  ELSE

    //暴走族：アイツと　タイマンしてたころ▼
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h03_badrider2_02 )

  ENDIF

EVENT_END

/**************************************************************/
/*  太った兄さん：話しかけ（橋マニアイベント）                */
/**************************************************************/
EVENT_START   ev_h03_man3_01

  _TALK_OBJ_START()

  //おいしい水を渡す前
  IF $WK_SCENE_BRIDGE_MANIA_01 == 2 THEN

    //太った兄さん：のどが　かわいた……▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h03_bridge_01 )

    //アイテム「おいしいみず」をあげる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //かばんの中の「おいしいみず」を減らす
      _SUB_ITEM( ITEM_OISIIMIZU, 1, SCWK_ANSWER )

      //おいしいみずがある
      IF $SCWK_ANSWER == TRUE THEN

        _MSGWIN_CLOSE()

        //SE再生
        _SE_PLAY( SEQ_SE_ARDEMO_01 )
        _SE_WAIT()

        //太った兄さん：げんき　でてきたー！　ありがとう▼
        _BALLOONWIN_TALKOBJ_MSG( msg_h03_bridge_02 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

		_PLAYER_DIR_GET( SCWK_ANSWER )
		
		IF $SCWK_ANSWER == DIR_DOWN THEN
			_OBJ_ANIME( H03_MAN3_01, anm_man3_leave1 )
		ELSE
			_OBJ_ANIME( H03_MAN3_01, anm_man3_leave2 )
		ENDIF

		_TIME_WAIT( 20 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_ou )
		_OBJ_ANIME_WAIT()

		_OBJ_DEL( H03_MAN3_01 )
		
        //========================================//
        //イベント進行
        $WK_SCENE_BRIDGE_MANIA_01 = 3
        //シリンダーブリッジの橋マニア非表示
        _FLAG_SET( FV_H03_BRIDGE_MANIA_01 )
        //ビレッジブリッジの橋マニア表示
        _FLAG_RESET( FV_H04_BRIDGE_MANIA_01 )
        //========================================//

      //おいしいみずが無い
      ELSE

        //太った兄さん：でも　おいしいみず　ないよね……
        _BALLOONWIN_TALKOBJ_MSG( msg_h03_bridge_03 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //太った兄さん：おいしいみずが　ないと……
      _BALLOONWIN_TALKOBJ_MSG( msg_h03_bridge_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //おいしい水を渡した後
  ELSIF $WK_SCENE_BRIDGE_MANIA_01 == 3 THEN

    //太った兄さん：げんき　でてきたー！　ありがとう▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h03_bridge_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

 //--------------------------------------------------------------------
//	●橋マニア：退場演出
//--------------------------------------------------------------------
_ANIME_LABEL	anm_man3_leave1
  _ANIME_DATA	AC_STAY_WALK_R_4F,4
  _ANIME_DATA	AC_WALK_R_4F,1
  _ANIME_DATA	AC_WALK_U_4F,8
  _ANIME_DATA	AC_WALK_U_2F,25
  _ANIME_DATA	ACMD_END,0
 
_ANIME_LABEL	anm_man3_leave2
  _ANIME_DATA	AC_STAY_WALK_U_4F,4
  _ANIME_DATA	AC_WALK_U_4F,8
  _ANIME_DATA	AC_WALK_U_2F,25
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_ou
  _ANIME_DATA	AC_DIR_U,1
  _ANIME_DATA	ACMD_END,0
