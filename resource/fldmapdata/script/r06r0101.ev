/**************************************************************/
/*  パラソル：話しかけ（天候説明イベント）                    */
/**************************************************************/
EVENT_START  ev_r06r0101_ambrella_01

  //日付取得変数一覧
  DEFINE_LOCAL LWK_BIRTHMONTH //設定された誕生日の月
  DEFINE_LOCAL LWK_BIRTHDAY   //設定された誕生日の日
  DEFINE_LOCAL LWK_MONTH      //月
  DEFINE_LOCAL LWK_DAY        //日

  //ポケモンチェック変数一覧
  DEFINE_LOCAL LWK_PARTY_NUM      //手持ちポケモンの数
  DEFINE_LOCAL LWK_COUNT_POKE_NUM //WHILE文01のカウンタ（手持ちポケモンの数）
  DEFINE_LOCAL LWK_EGG_CHK        //タマゴであるか

  DEFINE_LOCAL LWK_WAZA_NUM       //ポケモンの技個数
  DEFINE_LOCAL LWK_COUNT_WAZA_NUM //WHILE文02のカウンタ（技の数）

  DEFINE_LOCAL LWK_POKE_TOKUSEI //ポケモンの特性
  DEFINE_LOCAL LWK_POKE_WAZA    //ポケモンの技

  DEFINE_LOCAL LWK_POKE_TOKUSEI_CLEAR //条件の特性を持つポケモン
  DEFINE_LOCAL LWK_POKE_WAZA_CLEAR    //条件の技を持つポケモン

  DEFINE_LOCAL LWK_TENKI        //天気

  // 以下の変数は内部の値を定数として使用
  DEFINE_LOCAL LWK_CLEAR_HARE   //晴れ系
  DEFINE_LOCAL LWK_CLEAR_AME    //雨系
  DEFINE_LOCAL LWK_CLEAR_ARARE  //霰系
  DEFINE_LOCAL LWK_CLEAR_SUNA   //砂嵐系
  DEFINE_LOCAL LWK_CLEAR_NOOTEN //天候打消し系

  $LWK_CLEAR_HARE    = 1 //晴れ系
  $LWK_CLEAR_AME     = 2 //雨系
  $LWK_CLEAR_ARARE   = 3 //霰系
  $LWK_CLEAR_SUNA    = 4 //砂嵐系
  $LWK_CLEAR_NOOTEN  = 5 //天候打消し系

  _TALK_OBJ_START()

  //誕生日と日付取得
  _GET_BIRTHDAY( LWK_BIRTHMONTH, LWK_BIRTHDAY )
  _GET_DATE( LWK_MONTH, LWK_DAY )

  //DSに設定してある誕生日か？
  IF $LWK_MONTH == $LWK_BIRTHMONTH && $LWK_DAY == $LWK_BIRTHDAY THEN

    //パラソル：はれやかで　あることを　ねがいますわ……
    _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_06 )

  ENDIF

  //12/31のダイヤモンドダストの日？
  IF $LWK_MONTH == 12 && $LWK_DAY == 31 THEN

    //パラソル：みてみたい　ですわ！　うふふ！
    _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_07 )

  //それ以外の日
  ENDIF

  {
    //手持ちのポケモンの数を確認（タマゴのポケモンは除外）
    _GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_TOTAL )

    //手持ちのポケモンの中に条件を満たしたポケモンがいるか確認（繰り返し処理）
    WHILE $LWK_PARTY_NUM > $LWK_COUNT_POKE_NUM

      //指定POSのポケモンの特性を取得
      _GET_PARTY_POKE_PARAM( LWK_POKE_TOKUSEI, LWK_COUNT_POKE_NUM, SCR_POKEPARA_TOKUSEI )
      //タマゴすけチェックを追加（2012.03.26　水口）
      _CHECK_TEMOTI_EGG( LWK_EGG_CHK, LWK_COUNT_POKE_NUM )

      //指定POSのポケモンの特性は「ひでり」か
      IF $LWK_POKE_TOKUSEI == TOKUSYU_HIDERI && $LWK_POKE_TOKUSEI_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN
        //条件を満たしていたら、晴れ状態の説明へ
        $LWK_TENKI = $LWK_CLEAR_HARE
        //指定POSのポケモンの名前取得
        _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
        //特性「ひでり」タグセット
        _TOKUSEI_NAME( 2, LWK_POKE_TOKUSEI )
        //条件を満たしたポケモンがいた（値セット）
        $LWK_POKE_TOKUSEI_CLEAR = 1

      //指定POSのポケモンの特性は「あめふらし」か
      ELSIF $LWK_POKE_TOKUSEI == TOKUSYU_AMEHURASI && $LWK_POKE_TOKUSEI_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN
        //条件を満たしていたら、雨状態の説明へ
        $LWK_TENKI = $LWK_CLEAR_AME
        //指定POSのポケモンの名前取得
        _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
        //特性「あめふらし」タグセット
        _TOKUSEI_NAME( 2, LWK_POKE_TOKUSEI )
        //条件を満たしたポケモンがいた（値セット）
        $LWK_POKE_TOKUSEI_CLEAR = 1

      //指定POSのポケモンの特性は「ゆきふらし」か
      ELSIF $LWK_POKE_TOKUSEI == TOKUSYU_YUKIHURASI && $LWK_POKE_TOKUSEI_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN
        //条件を満たしていたら、霰状態の説明へ
        $LWK_TENKI = $LWK_CLEAR_ARARE
        //指定POSのポケモンの名前取得
        _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
        //特性「ゆきふらし」タグセット
        _TOKUSEI_NAME( 2, LWK_POKE_TOKUSEI )
        //条件を満たしたポケモンがいた（値セット）
        $LWK_POKE_TOKUSEI_CLEAR = 1

      //指定POSのポケモンの特性は「すなおこし」か
      ELSIF $LWK_POKE_TOKUSEI == TOKUSYU_SUNAOKOSI && $LWK_POKE_TOKUSEI_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN
        //条件を満たしていたら、砂嵐状態の説明へ
        $LWK_TENKI = $LWK_CLEAR_SUNA
        //指定POSのポケモンの名前取得
        _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
        //特性「すなおこし」タグセット
        _TOKUSEI_NAME( 2, LWK_POKE_TOKUSEI )
        //条件を満たしたポケモンがいた（値セット）
        $LWK_POKE_TOKUSEI_CLEAR = 1

      //指定POSのポケモンの特性は「エアロック」か
      ELSIF $LWK_POKE_TOKUSEI == TOKUSYU_EAROKKU && $LWK_POKE_TOKUSEI_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN
        //条件を満たしていたら、天候打消しの説明へ
        $LWK_TENKI = $LWK_CLEAR_NOOTEN
        //指定POSのポケモンの名前取得
        _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
        //特性「ノーてんき」「エアロック」タグセット
        _TOKUSEI_NAME( 2, LWK_POKE_TOKUSEI )
        //条件を満たしたポケモンがいた（値セット）
        $LWK_POKE_TOKUSEI_CLEAR = 1
      
      //指定POSのポケモンの特性は「ノーてんき」
      ELSIF $LWK_POKE_TOKUSEI == TOKUSYU_NOOTENKI && $LWK_POKE_TOKUSEI_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN
        //条件を満たしていたら、天候打消しの説明へ
        $LWK_TENKI = $LWK_CLEAR_NOOTEN
        //指定POSのポケモンの名前取得
        _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
        //特性「ノーてんき」「エアロック」タグセット
        _TOKUSEI_NAME( 2, LWK_POKE_TOKUSEI )
        //条件を満たしたポケモンがいた（値セット）
        $LWK_POKE_TOKUSEI_CLEAR = 1

      ENDIF

      //指定POSのポケモンは条件の特性を持ったポケモンであるか
      IF $LWK_POKE_TOKUSEI_CLEAR == 1 THEN

        //「ひでり」
        IF $LWK_TENKI == $LWK_CLEAR_HARE THEN
          _CALL ev_r06r0101_hare_01

        //「あめふらし」
        ELSIF $LWK_TENKI == $LWK_CLEAR_AME THEN
          _CALL ev_r06r0101_ame_01

        //「ゆきふらし」
        ELSIF $LWK_TENKI == $LWK_CLEAR_ARARE THEN
          _CALL ev_r06r0101_arare_01

        //「すなおこし」
        ELSIF $LWK_TENKI == $LWK_CLEAR_SUNA THEN
          _CALL ev_r06r0101_suna_01

        //「ノーてんき」「エアロック」
        ELSIF $LWK_TENKI == $LWK_CLEAR_NOOTEN THEN
          _CALL ev_r06r0101_nooten_01

        ENDIF

      //条件の特性を持っていない
      ELSE

        //数値リセット
        $LWK_COUNT_WAZA_NUM = 0

        //指定POSのポケモンの技数取得
        _GET_TEMOTI_WAZA_NUM( LWK_WAZA_NUM, LWK_COUNT_POKE_NUM )

        //指定POSポケモンの中に条件を満たした技があるか確認（繰り返し処理）
        WHILE $LWK_WAZA_NUM > $LWK_COUNT_WAZA_NUM

          //指定POSのポケモンの技番号取得
          _GET_TEMOTI_WAZA_ID( LWK_POKE_WAZA, LWK_COUNT_POKE_NUM, LWK_COUNT_WAZA_NUM )
          //タマゴすけチェックを追加（2012.03.26　水口）
          _CHECK_TEMOTI_EGG( LWK_EGG_CHK, LWK_COUNT_POKE_NUM )

          //「にほんばれ」を覚えている
          IF $LWK_POKE_WAZA == WAZANO_NIHONBARE && $LWK_POKE_WAZA_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN

            //条件を満たしていたら、晴れ状態の説明へ
            $LWK_TENKI = $LWK_CLEAR_HARE
            //「にほんばれ」を覚えているポケモンの名前取得
            _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
            //「にほんばれ」タグセット
            _WAZA_NAME( 1, 241 )
            //条件を満たしたポケモンがいた（値セット）
            $LWK_POKE_WAZA_CLEAR = 1

          //「あまごい」を覚えている
          ELSIF $LWK_POKE_WAZA == WAZANO_AMAGOI && $LWK_POKE_WAZA_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN

            //条件を満たしていたら、雨状態の説明へ
            $LWK_TENKI = $LWK_CLEAR_AME
            //「あまごい」を覚えているポケモンの名前取得
            _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
            //「あまごい」タグセット
            _WAZA_NAME( 1, 240 )
            //条件を満たしたポケモンがいた（値セット）
            $LWK_POKE_WAZA_CLEAR = 1

          //「あられ」を覚えている
          ELSIF $LWK_POKE_WAZA == WAZANO_ARARE && $LWK_POKE_WAZA_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN

            //条件を満たしていたら、霰状態の説明へ
            $LWK_TENKI = $LWK_CLEAR_ARARE
            //「あられ」を覚えているポケモンの名前取得
            _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
            //「あられ」タグセット
            _WAZA_NAME( 1, 258 )
            //条件を満たしたポケモンがいた（値セット）
            $LWK_POKE_WAZA_CLEAR = 1

          //「すなあらし」を覚えている
          ELSIF $LWK_POKE_WAZA == WAZANO_SUNAARASI && $LWK_POKE_WAZA_CLEAR == 0 && $LWK_EGG_CHK == FALSE THEN

            //条件を満たしていたら、砂嵐状態の説明へ
            $LWK_TENKI = $LWK_CLEAR_SUNA
            //「すなあらし」を覚えているポケモンの名前取得
            _TEMOTI_MONS_NAME( 0, LWK_COUNT_POKE_NUM )
            //「すなあらし」タグセット
            _WAZA_NAME( 1, 201 )
            //条件を満たしたポケモンがいた（値セット）
            $LWK_POKE_WAZA_CLEAR = 1

          ENDIF

          //指定POSのポケモンは条件の技を持っていたか
          IF $LWK_POKE_WAZA_CLEAR == 1 THEN
          
            //「にほんばれ」
            IF $LWK_TENKI == $LWK_CLEAR_HARE THEN
              _CALL ev_r06r0101_hare_01

            //「あまごい」
            ELSIF $LWK_TENKI == $LWK_CLEAR_AME THEN
              _CALL ev_r06r0101_ame_01

            //「あられ」
            ELSIF $LWK_TENKI == $LWK_CLEAR_ARARE THEN
              _CALL ev_r06r0101_arare_01

            //「すなあらし」
            ELSIF $LWK_TENKI == $LWK_CLEAR_SUNA THEN
              _CALL ev_r06r0101_suna_01

            ENDIF

          ENDIF

          //カウント
          $LWK_COUNT_WAZA_NUM += 1

        ENDWHILE

      ENDIF

      //カウント
      $LWK_COUNT_POKE_NUM += 1

    ENDWHILE

    //条件の特性も技も持っていなかった
    IF $LWK_POKE_TOKUSEI_CLEAR == 0 && $LWK_POKE_WAZA_CLEAR == 0 THEN

      //パラソル：あらあら　あなたの　ポケモン
      _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  }
EVENT_END


//「晴れ」の説明
ev_r06r0101_hare_01:

  //「にほんばれ」を覚えたポケモン
  IF $LWK_POKE_WAZA_CLEAR == 1 THEN

    //パラソル：あらあら　あなたの　《ポケモン》
    _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_01 )
    _AB_KEYWAIT_MARK()

  //特性「ひでり」のポケモン
  ELSIF $LWK_POKE_TOKUSEI_CLEAR == 1 THEN

    //パラソル：あらあら　めずらしい！
    _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_02 )
    _AB_KEYWAIT_MARK()

  ENDIF

  //パラソル：ひざしが　つよくなるでしょう
  _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_hare_01 )
  _AB_KEYWAIT_MARK()

  //パラソル：ひざしが　つよい　ときは
  _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_hare_02 )
  _AB_KEYWAIT_MARK()

  //パラソル：ひざしが　つよい　ため
  _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_hare_03 )
  _AB_KEYWAIT_MARK()

  //パラソル：そらが　すみますので
  _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_hare_04 )
  _AB_KEYWAIT_MARK()

  //パラソル：つづいて　ちゅういほうです！▼
  _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_hare_05 )
  _AB_KEYWAIT_MARK()

  //パラソル：なお　ようりょくそ　しゅうかく
  _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_hare_06 )
  _AB_KEYWAIT_MARK()

  //パラソル：そんな　はれの　ひの
  _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_hare_07 )
  _AB_KEYWAIT_MARK()

  //パラソル：わたくしの　ポケモン　てんきよほう
  _BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_ambrella_03 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

  //繰り返し処理（手持ちポケモンチェック）終了
  $LWK_COUNT_POKE_NUM = 6

  //繰り返し処理（ポケモンの技）終了
  $LWK_COUNT_WAZA_NUM = 4

_RET


