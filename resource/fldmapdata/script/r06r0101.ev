  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_r06r0101.h"
  .include  "r06r0101.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA 	ev_bg_r06r0101_case_01
_EVENT_DATA 	ev_bg_r06r0101_case_02
_EVENT_DATA		ev_reserve_r06r0101_swleader1_01
_EVENT_DATA		ev_r06r0101_swleader1_01

_EVENT_DATA_END

/**************************************************************/
/*  reserve：異常気象説明イベント*/
/**************************************************************/
EVENT_START   ev_reserve_r06r0101_swleader1_01

  //アニメ；主人公中央へ
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 7, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //チェレン：あまり
  _BALLOONWIN_OBJMSG_POS( msg_r06r0101_swleader1_01,R06R0101_SWLEADER1_01, POS_DEFAULT ) 
  
  //チェレン：それだけじゃない
  _BALLOONWIN_OBJMSG_POS( msg_r06r0101_swleader1_02,R06R0101_SWLEADER1_01, POS_DEFAULT ) 
  
  //チェレン：で　さきほどの
  _BALLOONWIN_OBJMSG_POS( msg_r06r0101_swleader1_03,R06R0101_SWLEADER1_01, POS_DEFAULT ) 
  
  //チェレン：あしどめして
  _BALLOONWIN_OBJMSG_POS( msg_r06r0101_swleader1_04,R06R0101_SWLEADER1_01, POS_DEFAULT ) 
  
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  話しかけ：チェレン*/
/**************************************************************/
EVENT_START   ev_r06r0101_swleader1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r06r0101_swleader1_04 )
EVENT_END

/**************************************************************/
/*  R06 栽培ケース/
/**************************************************************/
EVENT_START  ev_bg_r06r0101_case_01
	_TALK_START_SE_PLAY()
	{
	DEFINE_LOCAL LWK_KISETU
	_GET_SEASON_ID( LWK_KISETU )
	
	IF$LWK_KISETU == 0 THEN
		_PLAINWIN_MSG_DOWN(msg_r06r0101_planter_01)
	ELSIF$LWK_KISETU == 1 THEN
		_PLAINWIN_MSG_DOWN(msg_r06r0101_planter_02)
	ELSIF$LWK_KISETU == 2 THEN
		_PLAINWIN_MSG_DOWN(msg_r06r0101_planter_03)
	ELSE
		_PLAINWIN_MSG_DOWN(msg_r06r0101_planter_04)
	ENDIF
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	}
EVENT_END
/**************************************************************/
/*  R06 温度計*/
/**************************************************************/
EVENT_START  ev_bg_r06r0101_case_02	
	_TALK_START_SE_PLAY()
	{
	DEFINE_LOCAL LWK_KISETU
	DEFINE_LOCAL LWK_NUM
	_GET_SEASON_ID( LWK_KISETU )

	IF$LWK_KISETU == 0 THEN
		_NUMBER( 0, LOCALWORK3, 2 )
		_PLAINWIN_MSG_DOWN(msg_r06r0101_heatgauge_01)
	ELSIF$LWK_KISETU == 1 THEN
		_NUMBER( 0, LOCALWORK3, 2 )
		_PLAINWIN_MSG_DOWN(msg_r06r0101_heatgauge_02)
	ELSIF$LWK_KISETU == 2 THEN
		_NUMBER( 0, LOCALWORK3, 2 )
		_PLAINWIN_MSG_DOWN(msg_r06r0101_heatgauge_03)
	ELSE
		_NUMBER( 0, LOCALWORK3, 2 )
		_PLAINWIN_MSG_DOWN(msg_r06r0101_heatgauge_04)
	ENDIF
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	}
EVENT_END
