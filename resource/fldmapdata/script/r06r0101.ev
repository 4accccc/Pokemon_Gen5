EVENT_END

/**************************************************************/
/*  助手♂04：話しかけ（シキジカを貰う）                      */
/**************************************************************/
EVENT_START  ev_r06r0101_assistantm_04

  _TALK_OBJ_START()

  //シキジカを貰っていない
  IF FLAG_OFF( FE_R06R0101_POKE_GET_01 ) THEN

    //助手♂04：ちょっと　めずらしい　シキジカを▽
    _BALLOONWIN_OBJMSG_POS( msg_r06r0101_assistantm4_01, R06R0101_ASSISTANTM_04, POS_DEFAULT ) 

    //シキジカを貰う？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN    //はい

      //シキジカを貰う処理へ
      _CALL ev_c06r0101_poke_get

    ELSE    //いいえ

      //助手♂04：めずらしい　シキジカ　なのですが
      _BALLOONWIN_OBJMSG_POS( msg_r06r0101_assistantm4_06, R06R0101_ASSISTANTM_04, POS_DEFAULT ) 
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //シキジカ入手後
  ELSE

    //助手♂04：てんのめぐみ……▼
    _BALLOONWIN_OBJMSG_POS( msg_r06r0101_assistantm4_07, R06R0101_ASSISTANTM_04, POS_DEFAULT ) 
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

//シキジカを貰う処理
ev_c06r0101_poke_get:
{
  DEFINE_LOCAL LWK_POKE_COUNT //手持ち
  DEFINE_LOCAL SCWK_SEASON  //季節
  DEFINE_LOCAL LWK_INPUT

  //手持ちのポケモンの数を取得
  _GET_PARTY_POKE_COUNT( LWK_POKE_COUNT, POKECOUNT_MODE_TOTAL )

  //手持ちがいっぱいなら
  IF $LWK_POKE_COUNT == 6 THEN

    //助手♂04：たくさんの　ポケモンを
    _BALLOONWIN_OBJMSG_POS( msg_r06r0101_assistantm4_05, R06R0101_ASSISTANTM_04, POS_DEFAULT ) 
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //手持ちに空きがある
  ELSE

    //助手♂04：かわいがって　あげてください！▼
    _BALLOONWIN_OBJMSG_POS( msg_r06r0101_assistantm4_02, R06R0101_ASSISTANTM_04, POS_DEFAULT ) 
    _MSGWIN_CLOSE()

    //シキジカのフォルム選出（今の季節で入手できるフォルムに）
    //季節取得
    _GET_SEASON_ID( SCWK_SEASON )

    //春
    IF $SCWK_SEASON == PMSEASON_SPRING THEN
      //シキジカ（春）特性：てんのめぐみ
      _ADD_POKEMON_TO_PARTY_EX( SCWK_ANSWER, MONSNO_511, 0, 30, SCR_TOKUSEI_SPEC_3, SCR_SEX_SPEC_UNKNOWN, SCR_RARE_SPEC_FALSE, 0, ITEM_MONSUTAABOORU )

    //夏
    ELSIF $SCWK_SEASON == PMSEASON_SUMMER THEN
      //シキジカ（夏）特性：てんのめぐみ
      _ADD_POKEMON_TO_PARTY_EX( SCWK_ANSWER, MONSNO_511, 1, 30, SCR_TOKUSEI_SPEC_3, SCR_SEX_SPEC_UNKNOWN, SCR_RARE_SPEC_FALSE, 0, ITEM_MONSUTAABOORU )

    //秋
    ELSIF $SCWK_SEASON == PMSEASON_AUTUMN THEN
      //シキジカ（秋）特性：てんのめぐみ
      _ADD_POKEMON_TO_PARTY_EX( SCWK_ANSWER, MONSNO_511, 2, 30, SCR_TOKUSEI_SPEC_3, SCR_SEX_SPEC_UNKNOWN, SCR_RARE_SPEC_FALSE, 0, ITEM_MONSUTAABOORU )

    //冬
    ELSIF $SCWK_SEASON == PMSEASON_WINTER THEN
      //シキジカ（冬）特性：てんのめぐみ
      _ADD_POKEMON_TO_PARTY_EX( SCWK_ANSWER, MONSNO_511, 3, 30, SCR_TOKUSEI_SPEC_3, SCR_SEX_SPEC_UNKNOWN, SCR_RARE_SPEC_FALSE, 0, ITEM_MONSUTAABOORU )

    ENDIF

    //プレイヤー名を代入
    _PLAYER_NAME( 0 )

    //システム：シキジカを手に入れた！
    _ME_PLAY( SEQ_ME_POKEGET )
    _SYSWIN_MSG( msg_r06r0101_assistantm4_03, POS_DEFAULT )
    _ME_WAIT()
    _AB_KEYWAIT_MARK()

    //システム：ニックネームを　つけますか？
    _SYSWIN_MSG( msg_r06r0101_assistantm4_04, POS_DEFAULT )
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい
      _MSGWIN_CLOSE()

      //ニックネーム入力処理（一番後ろのポケモンを取得する）
      _PARTY_POKE_NAME_INPUT( LWK_INPUT, LWK_POKE_COUNT, TRUE )

    ELSE  //いいえ
      _MSGWIN_CLOSE()

    ENDIF

    //助手♂04：てんのめぐみ……▼
    _BALLOONWIN_OBJMSG_POS( msg_r06r0101_assistantm4_07, R06R0101_ASSISTANTM_04, POS_DEFAULT ) 
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //========================================//
    //シキジカ入手
    _FLAG_SET( FE_R06R0101_POKE_GET_01 )
    //========================================//

  ENDIF
}
_RET

