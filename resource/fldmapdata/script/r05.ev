EVENT_START		ev_r05_stop01_01
{
DEFINE_LOCAL LWK_BADGE
//バッジフラグ取得
_GET_BADGE_FLAG( LWK_BADGE, BADGE_ID_04 )

//ボルトバッジを入手していない場合
