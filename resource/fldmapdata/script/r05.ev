/*							看板							*/
/************************************************************/
EVENT_START	ev_bg_r05_board_03
	_EASY_BGWIN_MSG( msg_r05_sign4_01, TYPE_INFO )
  _FLAG_SET( MDL_FLAG_BOARD_R05_04 )
EVENT_END

/**************************************************************/
/*		POS：ベルかくしあなイベント					  */
/**************************************************************/
EVENT_START		ev_pos_r05_swbell_01
  
  _PLAYER_NAME( 0 )

  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //フィールド上にベル配置
  _OBJ_ADD_EX( 377, 438, DIR_LEFT, MMDL_ID_EVENTOBJ_00, SWBELL, MV_DMY )
  
  //メッセージ：おうい！
  _BALLOONWIN_OBJMSG_MF( msg_r05_swbell_01,msg_r05_swbell_02,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  _OBJ_ANIME(MMDL_ID_PLAYER,anm_common_gyoe)
  _OBJ_ANIME_WAIT()
  
  //ベル曲再生
  _START_EVENT_BGM( SEQ_BGM_E_BERU )

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
 
  //アニメ：ベル隣接・主人公振り向き
  _OBJ_ANIME(MMDL_ID_EVENTOBJ_00,anm_bell_to_player)
 _TIME_WAIT( 8 )
 
  //アニメ：主人公中央へ
  IF $LCW_POSZ != 438 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 372, 438, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME(MMDL_ID_PLAYER,anm_staystep_r)
    _OBJ_ANIME_WAIT()
  ENDIF

  IF $LCW_POSZ == 438 THEN
    _OBJ_ANIME(MMDL_ID_PLAYER,anm_staystep_r)
    _OBJ_ANIME_WAIT()
  ENDIF

  //メッセージ：いいところで
  _BALLOONWIN_OBJMSG_POS( msg_r05_swbell_03,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //わざマシン入手処理　「そらをとぶ」
  _ITEM_EVENT_KEYWAIT( ITEM_HIDENMASIN02, 1 )
  
  //メッセージ：そらをとぶ
  _BALLOONWIN_OBJMSG_MF( msg_r05_swbell_04,msg_r05_swbell_05,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_r05_swbell_06,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  //いいえ
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_r05_swbell_07,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  ENDIF
  }
  _MSGWIN_CLOSE()
  
  _TIME_WAIT( 30 )
  
  //ベル：！マーク
  _OBJ_ANIME(MMDL_ID_EVENTOBJ_00,anm_common_gyoe)
  _OBJ_ANIME_WAIT()
  
  _OBJ_ANIME(MMDL_ID_EVENTOBJ_00,anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //メッセージ：まって！
  _BALLOONWIN_OBJMSG_POS( msg_r05_swbell_08,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 372, 436, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT( 15 )
  _OBJ_ANIME(MMDL_ID_PLAYER,anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //アニメ：キョロキョロする
  _OBJ_ANIME(MMDL_ID_EVENTOBJ_00,anm_bell_kyoro)
  _OBJ_ANIME_WAIT()
  
  _TIME_WAIT(20)
  
  _OBJ_ANIME(MMDL_ID_EVENTOBJ_00,anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //メッセージ：あっちから
  _BALLOONWIN_OBJMSG_POS( msg_r05_swbell_09,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_tsureteke )
  _TIME_WAIT( 5 )
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 369, 425, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()

  //アニメ：キョロキョロする２
  _OBJ_ANIME(MMDL_ID_EVENTOBJ_00,anm_bell_kyoro2)
  _OBJ_ANIME_WAIT()
  
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 374, 425, FORCE_TYPE_NPC, 8, DIR_LR)
  _TIME_WAIT( 10 )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 373, 425, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()

  //アニメ：キョロキョロする３
  _OBJ_ANIME(MMDL_ID_EVENTOBJ_00,anm_bell_kyoro3)
  _OBJ_ANIME_WAIT()

  //メッセージ：この　あたりから
  _BALLOONWIN_OBJMSG_POS( msg_r05_swbell_10,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：キョロキョロする４
  _OBJ_ANIME(MMDL_ID_EVENTOBJ_00,anm_bell_kyoro4)
  _OBJ_ANIME_WAIT()

  //メッセージ：うあ！ここ！
  _BALLOONWIN_OBJMSG_POS( msg_r05_swbell_11,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME(MMDL_ID_PLAYER,anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  _SYSWIN_MSG( msg_r05_swbell_12, POS_DOWN )
  _YES_NO_WIN( SCWK_ANSWER )
  
  //いいえを選択した場合
  IF $SCWK_ANSWER == SCR_NO THEN
  
  	_SYSWIN_CLOSE()
  	
  	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_l )
  	_TIME_WAIT( 8 )
  	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  	_OBJ_ANIME_WAIT()
  
  	//メッセージ：せっかくだから
  	_BALLOONWIN_OBJMSG_POS( msg_r05_swbell_13,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  	_MSGWIN_CLOSE()
  	
  	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_u )
  	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  	_OBJ_ANIME_WAIT()
  
  //はいを選択した場合
  ELSE
  
  	_SYSWIN_CLOSE()
  
  ENDIF

  //かくしあなにチラーミィ配置
  _ANIMAL_TRAIL_DATA_SET( SCR_ANIMAL_TRAIL_ID_02 ,SCR_ANIMAL_TRAIL_MAIN_TABLE_POKE_A ,0 ,FALSE )

  //リザーブスクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_D34R0101_EVENT_01 )

  _SE_PLAY( SEQ_SE_KAIDAN )
  _WARP_ANIMAL_TRAIL( 1 )
  _END_EVENT_BGM()
  
  //========================================//
  //R05かくしあなイベントPOS無効
  $WK_SCENE_R05_SWBELL_01 = 1
  
  //そらをとぶヒントメダル取得
  _SET_MEDAL_HINT_ACHIEVE( MDLID_SORAWOTOBU )

  //かくしあなヒントメダル取得
  _SET_MEDAL_HINT_ACHIEVE( MDLID_KEMONOMICHI )

  //========================================//
  
EVENT_END

//--------------------------------------------------------------------
//	ベル：隣接
//--------------------------------------------------------------------
