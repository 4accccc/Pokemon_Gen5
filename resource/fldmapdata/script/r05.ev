/**************************************************************/
/*	R05	データコンバート用　チェレンバトルイベント			  */
/**************************************************************/
EVENT_START		ev_r05_swleader1_01
_TALK_OBJ_START()

	//初回会話の場合
	IF FLAG_OFF( FE_R05_SWLEADER1_TALK) THEN
		
		//きいたよ　Nという
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_swleader1_01 )
	
		//========================================/
		
		//初回会話フラグセット
		_FLAG_SET(FE_R05_SWLEADER1_TALK)
		
		//========================================/
	
	//二度目の会話の場合
	ELSE
		//きみとのしょうぶで
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_swleader1_02 )
	
	ENDIF

	//はい・いいえ分岐
	_YES_NO_WIN( SCWK_ANSWER )
	
	//はいの場合
	IF $SCWK_ANSWER == SCR_YES THEN
		
		//旧主人公名を代入
		_DATACONV_SET_NAME(DATACONV_ID_SYSTEM,1)
		
		//きみと　～～は　どこか　にているから
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_swleader1_03 )
		_MSGWIN_CLOSE()
		
		//変数を定義
		DEFINE_LOCAL	LWK_TYPE
		DEFINE_LOCAL	LWK_TRAINER
		
		//旧主人公の初期タイプを取得
		_DATACONV_GET_WORK( DATACONV_WORK_FIRST_POKETYPE, LWK_TYPE )
		
		SWITCH $LWK_TYPE
		CASE FIRST_POKETYPE_KUSA THEN
			$LWK_TRAINER = TRID_SWLEADER1_1_03
		CASE FIRST_POKETYPE_HONOO THEN
			$LWK_TRAINER = TRID_SWLEADER1_1_04
		CASE FIRST_POKETYPE_MIZU THEN
			$LWK_TRAINER = TRID_SWLEADER1_1_05
		ENDSWITCH
		
		//トレーナー戦呼び出し
		_TRAINER_BTL_SET( LWK_TRAINER, 0 )
		//敗戦チェック
		_TRAINER_LOSE_CHECK( SCWK_ANSWER )
		IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
		ELSE
			_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
		ENDIF
	
		//旧主人公名を代入
		_DATACONV_SET_NAME(DATACONV_ID_SYSTEM,1)
	
		_OBJ_ANIME( R05_SWLEADER1_01, anm_staystep_d )
		_OBJ_ANIME_WAIT()
	
		//むかし　ここで
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_swleader1_05 )
	
		//Nも　おなじ　ものを
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_swleader1_06 )
		_MSGWIN_CLOSE()
		
		//退場
		_OBJ_ANIME_AUTO( R05_SWLEADER1_01, 348,439, FORCE_TYPE_NOT, 8, DIR_LR )
		_TIME_WAIT( 20 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_l )
		_OBJ_ANIME_WAIT()
		
		_OBJ_DEL( R05_SWLEADER1_01 )
		
		//========================================/
		
		//バニシュフラグセット
		_FLAG_SET(FV_R05_SWLEADER1_01)
		
		//戦闘済にする
		_FLAG_SET(FE_R05_SWLEADER1_BTL)
		
		//========================================/
	
	//いいえの場合
	ELSE
		
		//そう？
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_swleader1_04 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	
	ENDIF

EVENT_END

/************************************************************/
/*				ミュージシャン						*/
/************************************************************/
//トレーナーですが、グッズ入手処理があるためスクリプトで制御しています
EVENT_START	ev_r05_musician_01
  
  //グッズケースを持っているかチェック
  _ITEM_CHK( ITEM_GUZZUKEESU, 1, SCWK_ANSWER )
  
  //グッズケースを持っている場合
  IF $SCWK_ANSWER == TRUE THEN
	
	_TALK_OBJ_START()
	//戦闘済みかで分岐
	//既に戦闘しているかチェック
	_TRAINER_FLAG_CHECK( TRID_MUSICIAN_03, SCWK_ANSWER )
	IF $SCWK_ANSWER == FALSE THEN
		//戦闘前なら
		
		//トレーナー曲セット
		_TRAINER_BGM_SET( TRID_MUSICIAN_03 )
		
		//びひけっ！おれのメロディー！
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_musician_01a )
		_MSGWIN_CLOSE()
		
		//トレーナー戦呼び出し
		_TRAINER_BTL_SET( TRID_MUSICIAN_03 , 0 )
		//敗戦チェック
		_TRAINER_LOSE_CHECK( SCWK_ANSWER )
		IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_FLAG_SET( TRID_MUSICIAN_03 )
			_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
		ELSE
			_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
		ENDIF
		
		//勝負をしてわかったよ
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_musician_01 )
		_MSGWIN_CLOSE()
		
		//ミュージカルのグッズ番号をセット
		$SCWK_TEMP0 = 84	//エレキギター
		$SCWK_TEMP1 = TRUE	//キー待ち記号あり
		
		//グッズ入手共通処理へ
		_CHG_COMMON_SCR	SCRID_MUSICAL_ADD_GOODS
		
		//グッズのエレキギターを持たせれば…
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_musician_02 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	
	ELSE
		//戦闘済みなら
		
		//グッズのエレキギターを持たせれば…
		_BALLOONWIN_TALKOBJ_MSG( msg_r05_musician_02 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
		
	ENDIF

  //グッズケースを持っていない場合
  ELSE
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_r05_musician_00 )
  ENDIF

EVENT_END

/**************************************************************/
/*	R05	WOMAN1									  */
