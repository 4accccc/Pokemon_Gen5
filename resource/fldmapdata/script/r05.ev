/*	R05	STOP01									  */
/**************************************************************/
EVENT_START		ev_r05_stop01_01

//バッジフラグ取得
_GET_BADGE_FLAG( LWK_BADGE, BADGE_ID_04 )

//ボルトバッジを入手していない場合
IF $LWK_BADGE == 0 THEN
	
	_TALK_START_TURN_NOT()
	
	_OBJ_ANIME( R05_STOP01_01, anm_staystep_l_3 )
	_OBJ_ANIME_WAIT()
	
	//こいする　おとこに　まけるのか
	_BALLOONWIN_TALKOBJ_MSG_POS( msg_r05_stop01_01, POS_DEFAULT )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()

ELSE

	_TALK_OBJ_START()
	
	_OBJ_ANIME( R05_STOP01_01, anm_common_gyoe )
	_OBJ_ANIME_WAIT()
	
	//ジムバッジが　４こ……
	_BALLOONWIN_TALKOBJ_MSG_POS( msg_r05_stop01_02, POS_DEFAULT )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
ENDIF

EVENT_END

