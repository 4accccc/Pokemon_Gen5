EVENT_START	ev_bg_r05_board_03
	_EASY_BGWIN_MSG( msg_r05_sign4_01, TYPE_INFO )
  _FLAG_SET( MDL_FLAG_BOARD_R05_04 )
EVENT_END

/**************************************************************/
/*		R05		きのみ販売イベント							  */
/**************************************************************/
EVENT_START		ev_r05_breederw_01


//初会話の場合
IF FLAG_OFF( TMFLG_R05_KINOMI ) THEN

	//乱数で0～5のうち１つ選んで格納する。
	_GET_RND( WK_OTHER_R05_KINOMI,5 )

ENDIF

//まだきのみを購入していないか？
//購入フラグをみる
IF FLAG_OFF ( TMFLG_R05_KINOMI_BUY ) THEN
	_TALK_OBJ_START()
	_CALL ev_r05_kinomi_buy

//購入済みの場合
ELSE

	//よかったら　あした　かいにきてね！
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_r05_breederw_06 )

ENDIF

EVENT_END

/**************************************************************/
/*		きのみの購入処理									  */
/**************************************************************/
ev_r05_kinomi_buy:

DEFINE_LOCAL	LWK_KINOMI_GOLD
DEFINE_LOCAL	LWK_GOLD_CHK
DEFINE_LOCAL	LWK_BAG_CHK

//きのみの金額を指定
$LWK_KINOMI_GOLD = 200

//所持金の表示
_GOLD_WIN_OPEN( MENU_X1, MENU_Y1 )

//きのみを割り当てる
SWITCH $WK_OTHER_R05_KINOMI
CASE 0 THEN
	//ザロクのみをどうぐ名に格納
	_ITEM_NAME( 0, ITEM_ZAROKUNOMI )
CASE 1 THEN
	//ネコブのみをどうぐ名に格納
	_ITEM_NAME( 0, ITEM_NEKOBUNOMI )
CASE 2 THEN
	//タポルのみをどうぐ名に格納
	_ITEM_NAME( 0, ITEM_TAPORUNOMI)
CASE 3 THEN
	//ロメのみをどうぐ名に格納
	_ITEM_NAME( 0, ITEM_ROMENOMI )
CASE 4 THEN
	//ウブのみをどうぐ名に格納
	_ITEM_NAME( 0, ITEM_UBUNOMI )
CASE 5 THEN
	//マトマのみをどうぐ名に格納
	_ITEM_NAME( 0, ITEM_MATOMANOMI )
ENDSWITCH

//タイムフラグをみる
//初会話の場合
IF FLAG_OFF( TMFLG_R05_KINOMI ) THEN

	//トレーナーさん！　あたしが集めた　きのみを　買わない？
	_BALLOONWIN_OBJMSG_POS( msg_r05_breederw_01 , R05_BREEDERW_01, POS_DOWN )

//会話済の場合
ELSE

	//あたしが　もっている　きのみは　
	_BALLOONWIN_OBJMSG_POS( msg_r05_breederw_07 , R05_BREEDERW_01, POS_DOWN )

ENDIF

//はい・いいえ選択表示
_YES_NO_WIN( SCWK_ANSWER )

//はいの場合
IF $SCWK_ANSWER ==  SCR_YES THEN

	//バッグの空きチェック
	SWITCH $WK_OTHER_R05_KINOMI
	CASE 0 THEN
		//ザロクのみ　バッグの空きチェック
		_ADD_ITEM_CHK( ITEM_ZAROKUNOMI,5,LWK_BAG_CHK )
	CASE 1 THEN
		//ネコブのみ　バッグの空きチェック
		_ADD_ITEM_CHK( ITEM_NEKOBUNOMI,5,LWK_BAG_CHK )
	CASE 2 THEN
		//タポルのみ　バッグの空きチェック
		_ADD_ITEM_CHK( ITEM_TAPORUNOMI,5,LWK_BAG_CHK )
	CASE 3 THEN
		//ロメのみ　バッグの空きチェック
		_ADD_ITEM_CHK( ITEM_ROMENOMI,5,LWK_BAG_CHK )
	CASE 4 THEN
		//ウブのみ　バッグの空きチェック
		_ADD_ITEM_CHK( ITEM_UBUNOMI,5,LWK_BAG_CHK )
	CASE 5 THEN
		//マトマのみ　バッグの空きチェック
		_ADD_ITEM_CHK( ITEM_MATOMANOMI,5,LWK_BAG_CHK )
	ENDSWITCH
	
	//金額チェック
	_CHECK_GOLD( LWK_GOLD_CHK, LWK_KINOMI_GOLD )

	//バッグがいっぱいの場合
	IF $LWK_BAG_CHK == FALSE THEN
		
		_GOLD_WIN_CLOSE()
		
		//バッグが　いっぱいだよね！
		_BALLOONWIN_OBJMSG_POS( msg_r05_breederw_04 , R05_BREEDERW_01, POS_DOWN )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()

	//所持金が足りない場合
	ELSIF $LWK_GOLD_CHK == FALSE THEN
	
		_GOLD_WIN_CLOSE()
	
		//お金が　たりないよね！
		_BALLOONWIN_OBJMSG_POS( msg_r05_breederw_05 , R05_BREEDERW_01, POS_DOWN )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()

	//購入条件を満たしている場合
	ELSE
		
		//レジ音再生
		_SE_PLAY( SEQ_SE_SYS_22 )		
		_SUBTRACT_GOLD( LWK_KINOMI_GOLD )
		_GOLD_WIN_UPDATE()
		_SE_WAIT()
		
		//～～５コで　２００円！　あなた　かいものじょうず　よね！
		_BALLOONWIN_OBJMSG_POS( msg_r05_breederw_03 , R05_BREEDERW_01, POS_DOWN )
		_MSGWIN_CLOSE()	
		_GOLD_WIN_CLOSE()

		//きのみの入手
		SWITCH $WK_OTHER_R05_KINOMI
		CASE 0 THEN
			//ザロクのみ　５コ入手
			_ITEM_EVENT_SUCCESS_KEYWAIT( ITEM_ZAROKUNOMI, 5 )
		CASE 1 THEN
			//ネコブのみ　バッグの空きチェック
			_ITEM_EVENT_SUCCESS_KEYWAIT( ITEM_NEKOBUNOMI, 5 )
		CASE 2 THEN
			//タポルのみ　バッグの空きチェック
			_ITEM_EVENT_SUCCESS_KEYWAIT( ITEM_TAPORUNOMI, 5 )
		CASE 3 THEN
			//ロメのみ　バッグの空きチェック
			_ITEM_EVENT_SUCCESS_KEYWAIT( ITEM_ROMENOMI, 5 )
		CASE 4 THEN
			//ウブのみ　バッグの空きチェック
			_ITEM_EVENT_SUCCESS_KEYWAIT( ITEM_UBUNOMI, 5 )
		CASE 5 THEN
			//マトマのみ　バッグの空きチェック
			_ITEM_EVENT_SUCCESS_KEYWAIT( ITEM_MATOMANOMI, 5 )
		ENDSWITCH

		//よかったら　あした　かいにきてね！
		_BALLOONWIN_OBJMSG_POS( msg_r05_breederw_06 , R05_BREEDERW_01, POS_DOWN )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()	
		_GOLD_WIN_CLOSE()

		//========================================/
		
		//購入フラグをONにする
		_FLAG_SET( TMFLG_R05_KINOMI_BUY )
		
		//========================================/

	ENDIF

//いいえの場合
ELSE

_GOLD_WIN_CLOSE()

//せっかく　あつめた　きのみ　なのに
_BALLOONWIN_OBJMSG_POS( msg_r05_breederw_02 , R05_BREEDERW_01, POS_DOWN )
_LAST_KEYWAIT()
_MSGWIN_CLOSE()

ENDIF

//========================================/

//タイムフラグON
_FLAG_SET( TMFLG_R05_KINOMI )

//========================================/

_RET

/**************************************************************/
/*	R05		BADRIDER	チャールズストッパーイベント		  */
/**************************************************************/
EVENT_START		ev_r05_badrider_01
{
//バージョンチェック
DEFINE_LOCAL LCW_VERSION
_GET_ROM_VERSION ( LCW_VERSION ) 


DEFINE_LOCAL LWK_BADGE
//バッジフラグ取得
_GET_BADGE_FLAG( LWK_BADGE, BADGE_ID_04 )

//ホワイト２の場合：トリプルバトル
IF $LCW_VERSION == VERSION_W2 THEN 

	//ボルトバッジを入手していない場合
	IF $LWK_BADGE == 0 THEN
		
		//トリプルバトル真っ最中
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_00w )
	
	//ボルトバッジ入手済みの場合
	ELSE
		_TALK_OBJ_START()
		
		//初回会話の場合
		IF FLAG_OFF( FE_R05_BADRIDER_TALK ) THEN
		
			//トリプルバトルが　どんな　しょうぶか　しりたいか？
			_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_01w )

			_YES_NO_WIN( SCWK_ANSWER )	
		
			//はい
			IF $SCWK_ANSWER == SCR_YES THEN
			
				//========================================/
			
				//初回会話終了
				_FLAG_SET(FE_R05_BADRIDER_TALK)
				
				//========================================/
				
				
				//トリプルバトルの　あらましさ
				_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_03w )
				
				_CALL ev_r05_btl_white
		
			//いいえ
			ELSE
		
				//まいったぜ！　あいての　きをひくのは
				_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_02w )
				_LAST_KEYWAIT()
				_MSGWIN_CLOSE()
		
			ENDIF
	
		//２回目以降の場合
		ELSE
		
			_CALL ev_r05_btl_white
		
		ENDIF

	ENDIF

//ブラック２の場合：ローテーションバトル
ELSE

	//ボルトバッジを入手していない場合
	IF $LWK_BADGE == 0 THEN
		
		//ローテーションバトル真っ最中
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_00b )
	
	//ボルトバッジ入手済みの場合
	ELSE
		_TALK_OBJ_START()
		
		//初回会話の場合
		IF FLAG_OFF( FE_R05_BADRIDER_TALK ) THEN
		
			//ローテーションバトルが　どんな　しょうぶか　しりたいか？
			_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_01b )

			_YES_NO_WIN( SCWK_ANSWER )	
		
			//はい
			IF $SCWK_ANSWER == SCR_YES THEN
			
				//========================================/
			
				//初回会話終了
				_FLAG_SET(FE_R05_BADRIDER_TALK)
				
				//========================================/
				
				
				//ローテーションバトルの　あらましさ
				_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_03b )
				
				_CALL ev_r05_btl_black
		
			//いいえ
			ELSE
		
				//まいったぜ！　あいての　きをひくのは
				_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_02b )
				_LAST_KEYWAIT()
				_MSGWIN_CLOSE()
		
			ENDIF
	
		//２回目以降の場合
		ELSE
		
			_CALL ev_r05_btl_black
		
		ENDIF
		
	ENDIF

ENDIF
}
EVENT_END

/**************************************************************/
/*CALL：チャールズバトル処理
/**************************************************************/
ev_r05_btl_white:
{
//オレは　こいするおとこ　そのなも　チャールズ
_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_04w )
_YES_NO_WIN( SCWK_ANSWER )
	
//はい
IF $SCWK_ANSWER == 0 THEN
		
	//手持ちポケモンカウント
	DEFINE_LOCAL LCW_POKECOUNT
	_GET_PARTY_POKE_COUNT( LCW_POKECOUNT , POKECOUNT_MODE_BATTLE_ENABLE )
		
	//戦えるポケモンが３匹未満
	IF $LCW_POKECOUNT < 3 THEN
		
		_BALLOONWIN_OBJMSG(msg_r05_badrider_06w,R05_BADRIDER_01)
		_LAST_KEYWAIT()
		_BALLOONWIN_CLOSE()
		
	//戦えるポケモンが３匹以上
	ELSE
	
			_BALLOONWIN_OBJMSG(msg_r05_badrider_05w,R05_BADRIDER_01)
			_BALLOONWIN_CLOSE()
			
			//戦闘処理
			_TRAINER_BTL_SET( TRID_BADRIDER_01_09, 0 )
		
			//結果チェック
			_TRAINER_LOSE_CHECK( SCWK_ANSWER )
			IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
				_TRAINER_WIN()
			ELSE
				_TRAINER_LOSE()
			ENDIF
			
			_BALLOONWIN_OBJMSG(msg_r05_badrider_08w,R05_BADRIDER_01)
			_BALLOONWIN_CLOSE()
			
			//【仮】チャールズ退場演出が仮
			
			//退場演出
			_CALL ev_badrider_move
			
			_BALLOONWIN_OBJMSG(msg_r05_badrider_09w,R05_BADRIDER_01)
			_BALLOONWIN_CLOSE()
			
			//画面暗転
			_BLACK_OUT()
			
			//退場演出
			_CALL ev_badrider_leave

			_DISP_FADE_END_CHECK()

			//ストッパーを消す
			_OBJ_DEL( R05_BADRIDER_01 )
			_OBJ_DEL( R05_STOP01_01 )
			_OBJ_DEL( R05_STOP02_01 )
			_OBJ_DEL( R05_STOP03_01 )
			_OBJ_DEL( R05_STOP04_01 )
			_OBJ_DEL( R05_STOP05_01 )
			_OBJ_DEL( R05_STOP06_01 )
			_OBJ_DEL( R05_STOP07_01 )
			_OBJ_DEL( R05_STOP08_01 )
			_OBJ_DEL( R05_STOP09_01 )
			
			
			//========================================/
			
			//バニシュフラグをセット
			_FLAG_SET(FV_R05_STOP)
			
			
			//========================================/
			
			_TIME_WAIT( 30 )
			
			//画面暗転解除
			_BLACK_IN()
			_DISP_FADE_END_CHECK()
			
			
		ENDIF
	
//いいえ
ELSE
	
	_BALLOONWIN_OBJMSG(msg_r05_badrider_07w,R05_BADRIDER_01)
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()
	
ENDIF

}
_RET


/**************************************************************/
/*CALL：チャールズバトル処理
/**************************************************************/
ev_r05_btl_black:
{
//オレは　こいするおとこ　そのなも　チャールズ
_BALLOONWIN_TALKOBJ_MSG( msg_r05_badrider_04b )
_YES_NO_WIN( SCWK_ANSWER )
	
//はい
IF $SCWK_ANSWER == 0 THEN
		
	//手持ちポケモンカウント
	DEFINE_LOCAL LCW_POKECOUNT
	_GET_PARTY_POKE_COUNT( LCW_POKECOUNT , POKECOUNT_MODE_BATTLE_ENABLE )
		
	//戦えるポケモンが３匹未満
	IF $LCW_POKECOUNT < 3 THEN
		
		_BALLOONWIN_OBJMSG(msg_r05_badrider_06b,R05_BADRIDER_01)
		_LAST_KEYWAIT()
		_BALLOONWIN_CLOSE()
		
	//戦えるポケモンが３匹以上
	ELSE
	
			_BALLOONWIN_OBJMSG(msg_r05_badrider_05b,R05_BADRIDER_01)
			_BALLOONWIN_CLOSE()
			
			//戦闘処理
			_TRAINER_BTL_SET( TRID_BADRIDER_01_08, 0 )
		
			//結果チェック
			_TRAINER_LOSE_CHECK( SCWK_ANSWER )
			IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
				_TRAINER_WIN()
			ELSE
				_TRAINER_LOSE()
			ENDIF
			
			_BALLOONWIN_OBJMSG(msg_r05_badrider_08b,R05_BADRIDER_01)
			_BALLOONWIN_CLOSE()
			
			//【仮】チャールズ退場演出が仮
			
			//退場演出
			_CALL ev_badrider_move
			
			_BALLOONWIN_OBJMSG(msg_r05_badrider_09b,R05_BADRIDER_01)
			_BALLOONWIN_CLOSE()
			
			//画面暗転
			_BLACK_OUT()			
			
			//退場演出
			_CALL ev_badrider_leave

			_DISP_FADE_END_CHECK()

			//ストッパーを消す
			_OBJ_DEL( R05_BADRIDER_01 )
			_OBJ_DEL( R05_STOP01_01 )
			_OBJ_DEL( R05_STOP02_01 )
			_OBJ_DEL( R05_STOP03_01 )
			_OBJ_DEL( R05_STOP04_01 )
			_OBJ_DEL( R05_STOP05_01 )
			_OBJ_DEL( R05_STOP06_01 )
			_OBJ_DEL( R05_STOP07_01 )
			_OBJ_DEL( R05_STOP08_01 )
			_OBJ_DEL( R05_STOP09_01 )
			
			
			//========================================/
			
			//バニシュフラグをセット
			_FLAG_SET(FV_R05_STOP)
			
			
			//========================================/
			
			_TIME_WAIT( 30 )
			
			//画面暗転解除
			_BLACK_IN()
			_DISP_FADE_END_CHECK()
			
			
		ENDIF
	
	//いいえ
	ELSE
	
		_BALLOONWIN_OBJMSG(msg_r05_badrider_07b,R05_BADRIDER_01)
		_LAST_KEYWAIT()
		_BALLOONWIN_CLOSE()
	
	ENDIF

}
_RET

ev_badrider_move:
{
DEFINE_LOCAL	LWK_DIR

_PLAYER_DIR_GET( LWK_DIR )
SWITCH $LWK_DIR
CASE DIR_UP,DIR_LEFT,DIR_DOWN THEN
	_OBJ_ANIME( R05_BADRIDER_01, anm_badrider_move )
CASE DIR_RIGHT THEN
	_OBJ_ANIME( R05_BADRIDER_01, anm_badrider_move_r )
ENDSWITCH
_OBJ_ANIME_WAIT()

}
_RET

ev_badrider_leave:
{
DEFINE_LOCAL	LWK_DIR

_PLAYER_DIR_GET( LWK_DIR )
SWITCH $LWK_DIR
CASE DIR_UP,DIR_LEFT,DIR_DOWN THEN
	_OBJ_ANIME( R05_BADRIDER_01, anm_badrider_leave )
CASE DIR_RIGHT THEN
	_OBJ_ANIME( R05_BADRIDER_01, anm_badrider_leave )
ENDSWITCH
_OBJ_ANIME_WAIT()

}
_RET

