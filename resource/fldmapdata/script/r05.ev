//話しかけた方向取得変数
DEFINE_LOCAL LCW_POSX
DEFINE_LOCAL LCW_POSZ

DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL LCW_VERSION
DEFINE_LOCAL LWK_BADGE

/**************************************************************/
/*			ゾーンチェンジラベル							  */
/**************************************************************/
INIT_EVENT_START	ev_zone_r05
	
	DEFINE_LOCAL	LWK_CONV

	//ゲームをクリアしているかチェック
	_DATACONV_GET_FLAG( DATACONV_FLAG_GAME_CLEAR, LWK_CONV )
	
	//BWをクリアしている場合
	IF $LWK_CONV == TRUE THEN
	
		//今作をクリアしている場合
		IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
	
			//チェレンと戦闘前か？
			IF FLAG_OFF( FE_R05_SWLEADER1_BTL) THEN	
			
				//チェレン表示
				_FLAG_RESET(FV_R05_SWLEADER1_01)
		
			ENDIF
		
		ENDIF
	
	ENDIF

INIT_EVENT_END

/************************************************************/
/*							看板							*/
/************************************************************/
EVENT_START	ev_bg_r05_board_01
	_EASY_BGWIN_MSG( msg_r05_sign1_01, TYPE_ROAD )
EVENT_END


/************************************************************/
/*							看板							*/
/************************************************************/
