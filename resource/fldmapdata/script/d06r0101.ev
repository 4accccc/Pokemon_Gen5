
//======================================================================
//                d06r0101.ev
//
//    スクリプトファイル：d06r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_d06r0101.h"
  .include  "d06r0101.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori //フェスミッションイベント

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_d06r0101
_EVENT_DATA   ev_init_d06r0101
_EVENT_DATA   ev_pos_d06r0101_swbell_01
_EVENT_DATA   ev_pos_d06r0101_boss_01
_EVENT_DATA   ev_d06r0101_swbell_01
_EVENT_DATA   ev_d06r0101_workman2_01
_EVENT_DATA	ev_d06r0101_girl4_01
_EVENT_DATA_END

//主人公座標取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_d06r0101

  //POSイベントを起動させている＆プラズマフリゲート（１回目）を終わらせている
  IF $WK_SCENE_D06R0101_SWBELL_01 == 1 && $WK_SCENE_D27R0101_FIRST_01 == 4 THEN

    //ベルが表示されたままならば削除
    IF FLAG_OFF( FV_D06R0101_SWBELL_01 ) THEN

      //========================================//
      //ベルを非表示
      _FLAG_SET( FV_D06R0101_SWBELL_01 )
      //========================================//

    ENDIF

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  FIELD_INIT_LABEL                                           */
/**************************************************************/
INIT_EVENT_START  ev_init_d06r0101

  //POSイベントを起動させていない場合はベルを再配置
  IF $WK_SCENE_D06R0101_SWBELL_01 == 0 THEN

    //ベル再配置（POSイベント用）
    _OBJ_POS_CHANGE( D06R0101_SWBELL_01, 11, 0, 48, DIR_RIGHT )

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  POS：ベルイベント01
/**************************************************************/
EVENT_START   ev_pos_d06r0101_swbell_01

  //アニメ：ベル「！」振り向き
  _OBJ_ANIME( D06R0101_SWBELL_01, anm_swbell_guide01 )
  _OBJ_ANIME_WAIT()

  //ベル：おうい（主人公の性別でセリフが異なる）
  _BALLOONWIN_OBJMSG_MF( msg_d06r0101_swbell_01, msg_d06r0101_swbell_02, D06R0101_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //主人公座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

  //アニメ：ベル接近
  IF $LCW_POSX == 11 THEN
    $LCW_POSZ -= 1
    _OBJ_ANIME_AUTO( D06R0101_SWBELL_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
    _OBJ_ANIME_WAIT()
  ELSE
    $LCW_POSZ -= 1
    _OBJ_ANIME_AUTO( D06R0101_SWBELL_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( D06R0101_SWBELL_01, anm_common_turn_d )
    _OBJ_ANIME_WAIT()
  ENDIF

  //主人公名代入
  _PLAYER_NAME( 0 )
  //ベル：主人公　しってる？▼
  _BALLOONWIN_OBJMSG_POS( msg_d06r0101_swbell_03, D06R0101_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //間（ベルがきょろきょろする）
  _OBJ_ANIME( D06R0101_SWBELL_01, anm_meet )
  _OBJ_ANIME_WAIT()
  _TIME_WAIT( 8 )
  _OBJ_ANIME( D06R0101_SWBELL_01, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //ベル：それにしても　ここ　あいかわらず
  _BALLOONWIN_OBJMSG_POS( msg_d06r0101_swbell_04, D06R0101_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ベル「！」
  _OBJ_ANIME( D06R0101_SWBELL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //ベル：そうだった！
  _BALLOONWIN_OBJMSG_POS( msg_d06r0101_swbell_05, D06R0101_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //ベル退場
  _OBJ_ANIME_AUTO( D06R0101_SWBELL_01, 14, 45, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME_AUTO( D06R0101_SWBELL_01, 15, 40, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //========================================//
  //POSイベント進行
  $WK_SCENE_D06R0101_SWBELL_01 = 1
  //ローカルライブキャスター・ベル通話状態を変更（T07到着まで）
  _PERSON_STATE_SET_BELL( BELL_STATE_D06 )
  //========================================//

  //イベント進行によって分岐
  //プラズマフリゲート（１回目）を終わらせている
  IF $WK_SCENE_D27R0101_FIRST_01 == 4 THEN

    //ベル削除
    _OBJ_DEL( D06R0101_SWBELL_01 )

    //========================================//
    //ベルを非表示
    _FLAG_SET( FV_D06R0101_SWBELL_01 )
    //========================================//

  //プラズマフリゲート（１回目）を終わらせていない
  ELSE

    //ベル再配置
    _OBJ_POS_CHANGE( D06R0101_SWBELL_01, 37, 0, 37, DIR_RIGHT )

  ENDIF

EVENT_END

/**************************************************************/
/*  POS：Nイベント01
/**************************************************************/
EVENT_START   ev_pos_d06r0101_boss_01

  //N：でんきいしの　ほらあな……
  _BALLOONWIN_OBJMSG_POS( msg_d06r0101_boss_01, D06R0101_BOSS_01, POS_DEFAULT )

  //N：ボクは　いかねば　ならない
  _BALLOONWIN_OBJMSG_POS( msg_d06r0101_boss_02, D06R0101_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //遠ざかっていく演出
  
  //階段SE
  _SE_PLAY( SEQ_SE_KAIDAN ) 
  _SE_WAIT()
  _OBJ_DEL( D06R0101_BOSS_01 )

  //========================================//
  //Nを非表示
  _FLAG_SET( FV_D06R0101_BOSS_01 )
  //========================================//
  //POSイベント進行
  $WK_SCENE_D06R0101_BOSS_01 = 1
  //========================================//

EVENT_END

/**************************************************************/
/*  ベル：話しかけ（ストッパー）                              */
/**************************************************************/
EVENT_START  ev_d06r0101_swbell_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d06r0101_swbell_06 )
EVENT_END

/**************************************************************/
/*  働くおじさん：話しかけ（ストッパー）                      */
/**************************************************************/
EVENT_START  ev_d06r0101_workman2_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d06r0101_workeman2_01 )
EVENT_END


//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：きょろきょろする
//--------------------------------------------------------------------
_ANIME_LABEL  anm_meet
  _ANIME_DATA AC_WAIT_2F,1
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA AC_WAIT_2F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_gyoe
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//ベル：「！」振り向く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_swbell_guide01
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA ACMD_END,0

/**************************************************************/
/*  GIRL4                                            */
/**************************************************************/
EVENT_START   ev_d06r0101_girl4_01
  
  //初回話しかけであったならば
  IF FLAG_OFF( SYS_FLAG_FES_STONE1BW ) THEN
  
    _TALK_OBJ_START()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_d06r0101_mission_add_01 )
    _MSGWIN_CLOSE()
    
    //フェスミッションが追加されました
    _SE_PLAY( SEQ_SE_FLD_133 )
    
    _GET_ROM_VERSION( SCWK_ANSWER )
  
    //メッセージ分岐
    IF $SCWK_ANSWER == VERSION_W2 THEN
    		
    	    //フェスミッション名格納
    	    _FMISSION_NAME( 0, FMISSION_ID_ITEM_KAKERA_03W, 0 )
    
         _SYSWIN_MSG( msg_d06r0101_mission_add_02w, POS_DEFAULT )
    ELSE
    
    	    //フェスミッション名格納
    	    _FMISSION_NAME( 0, FMISSION_ID_ITEM_KAKERA_03B, 0 )
    
         _SYSWIN_MSG( msg_d06r0101_mission_add_02b, POS_DEFAULT )
    ENDIF
    _SE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_d06r0101_mission_add_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //==================================//
    //初回会話終了
    _FLAG_SET( SYS_FLAG_FES_STONE1BW )
    //==================================//
    
  //2回目以降
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d06r0101_mission_add_03 )
  ENDIF
  
EVENT_END
