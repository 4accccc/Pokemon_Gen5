ev_battle_check:	
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    
    //搭乗1回目ライバル戦後ならば
    IF $WK_SCENE_D27R0101_FIRST_01 == 3 THEN
      
      //プラズマ団員1の動作モデルを非表示に
      _OBJ_DEL( D27R0101_SWPLAZMAM_01 )
      _OBJ_DEL( D27R0101_SWPLAZMAM_02 )
      _OBJ_DEL( D27R0101_SWPLAZMAM_03 )
      _OBJ_DEL( D27R0101_SWPLAZMAM_04 )
      _OBJ_DEL( D27R0101_SWPLAZMAM_05 )
      _OBJ_DEL( D27R0101_SWPLAZMAW_01 )
      _OBJ_DEL( D27R0101_SWPLAZMAM_07 )
      _OBJ_DEL( D27R0101_SWPLAZMAM_08 )
      _OBJ_DEL( D27R0101_SWPLAZMAM_09 )
      _OBJ_DEL( D27R0101_SWPLAZMAM_10 )
      _OBJ_DEL( D27R0101_SWPLAZMAM_11 )
      _OBJ_DEL( D27R0101_SWPLAZMAW_02 )
      
      //ライバル・チェレン・主人公の位置を調整
      _OBJ_POS_CHANGE( D27R0101_SWRIVAL_01, 12, 0, 32, DIR_DOWN )
      _OBJ_POS_CHANGE( D27R0101_SWLEADER1_01, 14, 0, 32, DIR_DOWN )
      _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 13, 0, 33, DIR_DOWN )
      
      //========================================//
      //プラズマ船員1を非表示に
      _FLAG_SET( FV_D27R0101_SWPLAZMA_01 )
      //========================================//
    ENDIF
    
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

