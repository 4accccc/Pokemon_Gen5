/************************************************************/
/*					POS：船首楼・ハッチ前W  						*/
/************************************************************/
EVENT_START	ev_pos_d27r0101_second_w_01
  
  //ライバル・主人公名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //左
  IF $LCW_POSX == 16 THEN
    _OBJ_ANIME( D27R0101_SWRIVAL_01, anm_staystep_l )
  //右
  ELSE
    _OBJ_ANIME( D27R0101_SWRIVAL_01, anm_staystep_r )
  ENDIF
  
  _OBJ_ANIME_WAIT()
    
  //ライバル：……ここだな
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_02_05 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル入室
  _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_rival_to_r1201_01 )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //動作モデル削除
  _OBJ_DEL( D27R0101_SWRIVAL_01 )
  
  _SE_WAIT()
  
  //アニメ：主人公船内へ
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 18, 15, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_walk_u )
  _OBJ_ANIME_WAIT()
  
  //予約スクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_D27R1201_RIVAL_01 )
  //マップチェンジ
  _MAP_CHANGE( ZONE_ID_D27R1201, 11, 15, DIR_DOWN )
  
EVENT_END

