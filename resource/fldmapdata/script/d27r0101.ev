
//======================================================================
//                d27r0101.ev
//
//    スクリプトファイル：d27r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d27r0101.h"
  .include  "d27r0101.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_init_d27r0101
_EVENT_DATA    ev_recover_d27r0101
_EVENT_DATA_END


/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r0101

  // 出口位置変更
  _CALL sub_exit_change

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r0101

  // 出口位置変更
  _CALL sub_exit_change

INIT_EVENT_END

// バージョン別で出口位置変更
sub_exit_change:
{
  DEFINE_LOCAL  version   // ROMバージョン

  // ROMバージョン取得
  _GET_ROM_VERSION( version )

  // B2
  IF $version == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D27R0701_EXIT02, 0, 0, 0 ) 
  // W2
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D27R0701_EXIT01, 0, 0, 0 ) 
  ENDIF
}
_RET

