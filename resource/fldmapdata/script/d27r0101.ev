/************************************************************/
/*					話しかけ：ストッパープラズマ団員  						*/
/************************************************************/
EVENT_START	ev_d27r0101_stopper_01
  _TALK_START_SE_PLAY()
  
  //アニメ：「…」
  _OBJ_ANIME( D27R0101_STOPPER_01 , anm_common_tenten )
  _OBJ_ANIME_WAIT()
  
  _PLAINWIN_MSG_UP( msg_d27r0101_swplazmam_stop_01 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()
EVENT_END

/************************************************************/
/*					話しかけ：クリア後アクロマ  						*/
/************************************************************/
EVENT_START	ev_d27r0101_swboss_01

  _TALK_OBJ_START()

  //一日一回アクロマ戦前
  IF FLAG_OFF( TMFLG_D27R0101_SWBOSS_BTL ) THEN
    
    //初回会話
    IF FLAG_OFF( FE_D27R0101_SWBOSS_TALK ) THEN
      //アクロマ：おなじ
      _BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swboss_end_01 )
      //========================================//
      //初回会話終了
      _FLAG_SET( FE_D27R0101_SWBOSS_TALK )
      //========================================//
    //2回目以降
    ELSE
      //アクロマ：おなじ
      _BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swboss_end_04 )
    ENDIF
    
    {
    _YES_NO_WIN( SCWK_ANSWER )
    
    //はい
    IF $SCWK_ANSWER == SCR_YES THEN
      
      //アクロマ：あなたと
      _BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swboss_end_02 )
      _MSGWIN_CLOSE()

      //アクロマ戦 
      _TRAINER_BTL_SET( TRID_SWBOSS_2_01, 0 )

      //結果チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()
      ELSE
        _TRAINER_LOSE()
      ENDIF

      //アクロマ：あなたと　ポケモンが
      _BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swboss_end_05 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //========================================//
      //一日一回アクロマ戦終了
      _FLAG_SET( TMFLG_D27R0101_SWBOSS_BTL )
      //========================================//
    
    ELSE
      
      //アクロマ：つれないひとですね
      _BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swboss_end_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
    ENDIF
    }

  //一日一回イベント終了後
  ELSE

    //アクロマ：よければ　また
    _BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swboss_end_05 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END


/************************************************************/
/*					話しかけ：クリア後プラズマ団員01  						*/
/************************************************************/
EVENT_START	ev_d27r0101_swplazmam_end_01

  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swplazmam_end_01 )

EVENT_END

/************************************************************/
/*					話しかけ：クリア後プラズマ団員01  						*/
/************************************************************/
EVENT_START	ev_d27r0101_swplazmam_end_02

  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swplazmaw_end_01 )

EVENT_END


ev_battle_check:	
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
  
    //搭乗1回目チェレン戦後ならば
    IF $WK_SCENE_D27R0101_FIRST_01 == 2 THEN
    
       //手持ち全滅チェック
       _CALL ev_kaihuku_check
    ENDIF
    
    //搭乗1回目ライバル戦後ならば
    IF $WK_SCENE_D27R0101_FIRST_01 == 3 THEN
    
        //手持ち全滅チェック
       _CALL ev_kaihuku_check
      
      //最初に戦ったしたっぱの位置を調整
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_01,10,0,30,DIR_RIGHT) //初回戦う人
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_02,10,0,32,DIR_RIGHT) //初回戦う人
      
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_03,12,0,27,DIR_DOWN) //チェレンマルチバトルの人
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_04,11,0,27,DIR_DOWN) //チェレンマルチバトルの人
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_05,13,0,35,DIR_UP) //ライバルマルチバトルの人
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAW_01,12,0,35,DIR_UP) //ライバルマルチバトルの人
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_07,14,0,36,DIR_UP)  //その他
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_08,11,0,36,DIR_UP)  //その他
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_09,15,0,35,DIR_UP)  //その他
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_10,14,0,28,DIR_DOWN)  //その他
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_11,13,0,26,DIR_DOWN)  //その他
      _OBJ_POS_CHANGE(D27R0101_SWPLAZMAW_02,14,0,27,DIR_DOWN)  //その他
      
      //ライバル・チェレン・主人公の位置を調整
      _OBJ_POS_CHANGE( D27R0101_SWRIVAL_01, 12, 0, 32, DIR_UP )
      _OBJ_POS_CHANGE( D27R0101_SWLEADER1_01, 14, 0, 32, DIR_UP )
      _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 13, 0, 33, DIR_UP )
      
      //========================================//
      //プラズマ船員1を非表示に
      _FLAG_SET( FV_D27R0101_SWPLAZMA_01 )
      //========================================//
    ENDIF
    
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

/************************************************************/
/*					CALL：生存チェック		*/
/************************************************************/
ev_kaihuku_check:
  //手持ちが0匹だったら
  _GET_PARTY_POKE_COUNT( SCWK_TEMP0, POKECOUNT_MODE_BATTLE_ENABLE )
  IF $SCWK_TEMP0 == 0 THEN
    _TEMOTI_POKEMON_KAIFUKU() //回復処理
  ENDIF
_RET
