//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*					ZONE_CHANGE_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r0101
  
  // 出口位置変更
  _CALL sub_exit_change
  
  //プラズマフリゲート・現在地対応
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    $WK_SYS_HIDE_SHIP_PLACE = SCR_HIDE_SHIP_PLACE_W17
  ENDIF
  
  //アクロマ戦終了・一日一回がオフになっている
  IF FLAG_ON( FE_D27R0401_SWBOSS_WIN_01 ) && FLAG_OFF( TMFLG_D27R0101_SWBOSS_BTL ) THEN
    //========================================//
    //D27R0101アクロマ表示
    _FLAG_RESET( FV_D27R0101_SWBOSS_01 )
    //D27R0401アクロマ非表示
    _FLAG_SET( FV_D27R0401_SWBOSS_01 )
    //========================================//
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r0101
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //乗船2回目戦闘前
  IF $WK_SCENE_D27R0101_SECONDW_01 == 1 || $WK_SCENE_D27R0101_SECONDB_01 == 1 THEN
    _DEBUG_PRINT_WK( 12 )
    _OBJ_POS_CHANGE(D27R0101_SWRIVAL_01,12,0,29,DIR_RIGHT)
    _OBJ_POS_CHANGE(MMDL_ID_PLAYER,8,0,30,DIR_RIGHT)
  ENDIF
  
  //搭乗1回目開始前
  IF $WK_SCENE_D27R0101_FIRST_01 == 1 THEN
    _OBJ_POS_CHANGE(MMDL_ID_PLAYER,9,0,30,DIR_RIGHT)
  ENDIF
  
  //搭乗1回目終了前
  IF $WK_SCENE_D27R0101_FIRST_01 == 2  ||  $WK_SCENE_D27R0101_FIRST_01 == 3 THEN
    _DEBUG_PRINT_WK( 22 )
    _OBJ_POS_CHANGE(D27R0101_SWRIVAL_01,13,0,34,DIR_DOWN)
    _OBJ_POS_CHANGE(D27R0101_SWLEADER1_01,11,0,28,DIR_UP)
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_01,10,0,31,DIR_RIGHT) //初回戦う人
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_02,14,0,31,DIR_LEFT) //初回戦う人
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_03,12,0,27,DIR_DOWN) //チェレンマルチバトルの人
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_04,11,0,27,DIR_DOWN) //チェレンマルチバトルの人
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_05,13,0,35,DIR_UP) //ライバルマルチバトルの人
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAW_01,12,0,35,DIR_UP) //ライバルマルチバトルの人
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_07,14,0,36,DIR_UP)  //その他
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_08,11,0,36,DIR_UP)  //その他
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_09,15,0,35,DIR_LEFT)  //その他
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_10,14,0,28,DIR_LEFT)  //その他
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM_11,13,0,26,DIR_DOWN)  //その他
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAW_02,14,0,27,DIR_LEFT)  //その他
  ENDIF
  
  //搭乗2回目・船首楼イベント前（ホワイト）
  IF $WK_SCENE_D27R0101_SECONDW_01 == 2 THEN
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM1_02_01,18,0,45,DIR_UP)
    _OBJ_POS_CHANGE(D27R0101_SWPLAZMAM1_02_02,19,0,46,DIR_UP)
    _OBJ_POS_CHANGE(D27R0101_SWRIVAL_01,18,0,16,DIR_UP)
  //搭乗2回目・船首楼イベント前（ブラック）
  ELSIF $WK_SCENE_D27R0101_SECONDB_01 == 2 THEN
    _OBJ_POS_CHANGE(D27R0101_SWRIVAL_01,18,0,16,DIR_UP)
  ENDIF

  // 出口位置変更
  _CALL sub_exit_change

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r0101

  // 出口位置変更
  _CALL sub_exit_change

INIT_EVENT_END

// バージョン別で出口位置変更
sub_exit_change:
{
  DEFINE_LOCAL  version   // ROMバージョン

  // ROMバージョン取得
  _GET_ROM_VERSION( version )

  // B2クリア前
  IF $version == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D27R0701_EXIT02, 0, 0, 0 ) 
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D27R1201_EXIT01, 0, 0, 0 )
  
  // W2クリア前
  ELSIF $version == VERSION_W2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D27R0701_EXIT01, 0, 0, 0 ) 
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D27R0201_EXIT01, 0, 0, 0 )

  ENDIF
  
  //D05からの搭乗時
  IF $WK_SCENE_D05 == 3 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_W21_EXIT01, 0, 0, 0 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D13_EXIT01, 0, 0, 0 )
  //W21からの搭乗時
  ELSIF $WK_SCENE_W21_01  == 3 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D05_EXIT01, 0, 0, 0 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D13_EXIT01, 0, 0, 0 )
  //D13からの搭乗時
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_D05_EXIT01, 0, 0, 0 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0101_W21_EXIT01, 0, 0, 0 )
  ENDIF
  
}
_RET

/************************************************************/
/*					SCEME_CHANGE：搭乗1回目イベント  						*/
/************************************************************/
EVENT_START	ev_scene_d27r0101_firstbtl_01

  _DEBUG_PRINT_WK( 8 )

  //アニメ：3人右方向に移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 12, 31, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWRIVAL_01 , 13, 32, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWLEADER1_01 , 14, 31, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //主人公・ライバル名格納
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //アニメ：ライバル「？」
  _OBJ_ANIME( D27R0101_SWRIVAL_01, anm_common_hatena )
  _OBJ_ANIME_WAIT()
  
  //ライバル：なんだ　この　ふね
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_01 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン左を向く
  _OBJ_ANIME( D27R0101_SWLEADER1_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //チェレン：それに……
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swleader1_01 , D27R0101_SWLEADER1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレンあたりを見回す
  _OBJ_ANIME( D27R0101_SWLEADER1_01, anm_swleader1_kyoro_01 )
  _OBJ_ANIME_WAIT()
  
  //チェレン：ふるいふねに
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swleader1_02 , D27R0101_SWLEADER1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //プラズマ団（１）登場
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_01 , 13, 29, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT( 16 )
  _OBJ_ANIME( D27R0101_SWRIVAL_01, anm_staystep_u )
  _OBJ_ANIME( D27R0101_SWLEADER1_01, anm_staystep_u )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME_WAIT()
  
  //プラズマ団員：まっ　どうでも
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam1_01 , D27R0101_SWPLAZMAM_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //他のプラズマ団員も登場
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_03 , 12, 27, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_04 , 11, 27, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_10 , 14, 28, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_11 , 13, 26, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAW_02 , 14, 27, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()

  //ライバル名格納
  _RIVAL_NAME( 1 )
  
  //BGM再生:プラズマフリゲート
  _START_EVENT_BGM( SEQ_BGM_SW_D_27_F_AJITO )
  
  //========================================//
  //プラズマフリゲート曲に戻す
  _FLAG_RESET( SYS_FLAG_BGM_D27R0101_SILENT )
  //========================================//
  
  //BGMチェンジでの環境SEポーズ状態をCLEAR
  _CLEAR_ENVSE_EVENT_BGMPLAY_PAUSE()
  
  //ライバル：なるほど
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_02 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //プラズマ団（１）登場
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_02 , 14, 33, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT( 32 )
  //アニメ：「！」
  _OBJ_ANIME( D27R0101_SWLEADER1_01, anm_look_d_gyoe )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( D27R0101_SWRIVAL_01, anm_look_d_gyoe )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_look_d_gyoe )
  _OBJ_ANIME_WAIT()
  
  //プラズマ団員：せいかーい
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam2_01 , D27R0101_SWPLAZMAM_02 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団（下）登場
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAW_01 , 12, 35, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_05 , 13, 35, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_07 , 14, 36, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_08 , 11, 36, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM_09 , 15, 35, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //プラズマ団員：そう！　だから
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam2_04 , D27R0101_SWPLAZMAM_02 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル名格納
  _RIVAL_NAME( 1 )
  
  //ライバル：だからなんだよ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_03 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //プラズマ団員：かわいいね！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam1_04 , D27R0101_SWPLAZMAM_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公たち向き合う
  _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_staystep_u )
  _OBJ_ANIME( D27R0101_SWLEADER1_01 , anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ライバル：（解散前メッセージ）
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_07 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団と対峙
  _OBJ_ANIME( D27R0101_SWPLAZMAM_01 , anm_swplazmam01_come_01 )
  _OBJ_ANIME( D27R0101_SWPLAZMAM_02 , anm_swplazmam02_come_01 )
  _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_swrival_vs_01 )
  _OBJ_ANIME( D27R0101_SWLEADER1_01 , anm_swleader1_vs_01 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( D27R0101_SWPLAZMAW_02 , anm_staystep_l )
  _OBJ_ANIME( D27R0101_SWPLAZMAM_09 , anm_staystep_l)
  _OBJ_ANIME( D27R0101_SWPLAZMAM_10 , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //プラズマ団：うでにじしんが
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam1_02 , D27R0101_SWPLAZMAM_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団接近
  _OBJ_ANIME( D27R0101_SWPLAZMAM_01, anm_walk_r )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //トレーナー戦
  _TRAINER_BTL_SET( TRID_SWPLAZMAM_05, 0 )
  //結果チェック
  _CALL ev_battle_check
  
  //アニメ：プラズマ団1歩下がる
  _OBJ_ANIME( D27R0101_SWPLAZMAM_01, anm_swplazma_backstep_l )
  _OBJ_ANIME_WAIT()
  
  //プラズマ団：つぎつぎ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam1_03 , D27R0101_SWPLAZMAM_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //プラズマ団：というわけで
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam2_02 , D27R0101_SWPLAZMAM_02 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団接近
  _OBJ_ANIME( D27R0101_SWPLAZMAM_02, anm_walk_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //トレーナー戦
  _TRAINER_BTL_SET( TRID_SWPLAZMAM_06, 0 )
  //結果チェック
  _CALL ev_battle_check
  
  //プラズマ団：なんだよこいつ！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam2_03 , D27R0101_SWPLAZMAM_02 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団1歩下がる
  _OBJ_ANIME( D27R0101_SWPLAZMAM_02, anm_swplazma_backstep_r )
  _OBJ_ANIME_WAIT()
  
  //========================================//
  //搭乗1回目SCENE_CHANGEを終了
  $WK_SCENE_D27R0101_FIRST_01 = 2
  //ローカルライブキャスター通話状態変更（搭乗一回目）
  _PERSON_STATE_SET_DOCTOR( DOCTOR_STATE_RESEARCHINSTITUTE )
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_PLASMAFRIGATE_1 )
  _PERSON_STATE_SET_CHELEN( CHELEN_STATE_PLASMAFRIGATE_1 )
  _PERSON_STATE_SET_MOTHER( MOTHER_STATE_HOME )
  //========================================//

EVENT_END

