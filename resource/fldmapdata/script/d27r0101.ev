//	ライバル：船首楼内へ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_rival_to_r1201_01
	_ANIME_DATA	AC_WALK_R_8F,5
	_ANIME_DATA	AC_WALK_U_8F,30
	_ANIME_DATA	AC_WALK_L_8F,4
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*					POS：船首楼・ハッチ前B  						*/
/************************************************************/
EVENT_START	ev_pos_d27r0101_second_b_01

  //ライバル・主人公名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //========================================//
  //ライバルを表示
  _FLAG_RESET( FV_D27R0101_SWRIVAL_01 )
  //========================================//
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //動作モデルを生成
  _OBJ_ADD( D27R0101_SWRIVAL_01 )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //ドア前にライバルを移動
  _OBJ_POS_CHANGE(D27R0101_SWRIVAL_01,18,0,14,DIR_DOWN)
  
   //ハッチ前ならば振り返り
  IF $LCW_POSZ == 17 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u)
    _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_walk_d )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //ライバル：おい！こっちだ！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_02_04 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  
  //アニメ：ライバル中に入る
  IF $LCW_POSZ == 17 THEN
    _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_walk_u)
    _OBJ_ANIME_WAIT()
  ELSE
    _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_staystep_u )
  ENDIF
  
  _OBJ_ANIME_WAIT()
  
  //動作モデル削除
  _OBJ_DEL( D27R0101_SWRIVAL_01 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //ハッチ前ならば移動
  IF $LCW_POSZ == 17 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 18, 15, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //アニメ：主人公船内へ
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_walk_u )
  _OBJ_ANIME_WAIT()
  
  //========================================//
  //D27R0101のPOSを無効に
  $WK_SCENE_D27R0101_SECONDB_01 = 3
  //D27R0101のライバルを非表示
  _FLAG_SET( FV_D27R0101_SWRIVAL_01 )
  //========================================//
  
  //予約スクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_D27R0201_RIVAL_01 )
  //マップチェンジ
  _MAP_CHANGE( ZONE_ID_D27R0201, 11, 15, DIR_DOWN )
  
EVENT_END

