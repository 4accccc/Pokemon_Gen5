/************************************************************/
/*					SCEME_CHANGE：搭乗2回目イベント  						*/
/************************************************************/
EVENT_START	ev_scene_d27r0101_secondbtl_01

  //主人公・ライバル名を代入
  _PLAYER_NAME(0)
  _RIVAL_NAME(1)

  //アニメ：ライバル主人公を見る
  _OBJ_ANIME( D27R0101_SWRIVAL_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //ライバル：そっちは　まかせる！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_02_01 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル上に向きなおす・プラズマ団接近
  _OBJ_ANIME( D27R0101_SWRIVAL_01, anm_staystep_r )
  _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM1_02_01 , 10, 30, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //プラズマ団：おまえらか！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam1_02_01 , D27R0101_SWPLAZMAM1_02_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //トレーナー戦
  _TRAINER_BTL_SET( TRID_SWPLAZMAM_31, 0 )
  //結果チェック
  _CALL ev_battle_check
  
  //アニメ：プラズマ団1歩下がる
  _OBJ_ANIME( D27R0101_SWPLAZMAM1_02_01, anm_swplazma_02_backstep_l )
  _OBJ_ANIME_WAIT()
  
  //プラズマ団：しまった！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam1_02_02 , D27R0101_SWPLAZMAM1_02_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    
    //上方向に退場
    _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM1_02_01 , 14, 20, FORCE_TYPE_NPC, 4, DIR_LR)
    _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM1_02_02 , 13, 20, FORCE_TYPE_NPC, 4, DIR_LR)
    
    //========================================//
    //搭乗2回目ハッチ前POSを有効に
    $WK_SCENE_D27R0101_SECONDB_01 = 2
    //========================================//
  
  //W2  
  ELSE
    
    //下方向に退場
    _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM1_02_01 , 13, 38, FORCE_TYPE_NPC, 4, DIR_LR)
    _OBJ_ANIME_AUTO( D27R0101_SWPLAZMAM1_02_02 , 14, 38, FORCE_TYPE_NPC, 4, DIR_LR)
  
    //========================================//
    //搭乗2回目ハッチ前POSを有効に
    $WK_SCENE_D27R0101_SECONDW_01 = 2
    //========================================//
    
  ENDIF
  
  _OBJ_ANIME_WAIT()
  
  //動作モデルを削除
  _OBJ_DEL( D27R0101_SWPLAZMAM1_02_01 )
  _OBJ_DEL( D27R0101_SWPLAZMAM1_02_02 )
  
  
  //主人公・ライバル名を代入
  _PLAYER_NAME(0)
  _RIVAL_NAME(1)
  
  //ライバル：フゥ いくぜ！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_02_03 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル隣接
  _OBJ_ANIME_AUTO( D27R0101_SWRIVAL_01 , 9, 29, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D27R0101_SWRIVAL_01, anm_staystep_d )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //アニメ：ライバル・主人公船首楼前へ
  _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_rival_to_r0201_01 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_to_r0201_01 )
  _OBJ_ANIME_WAIT()
  
  //アニメ
  _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_rival_to_r0201_02 )
  _OBJ_ANIME_WAIT()
  
  //動作モデルを削除
  _OBJ_DEL( D27R0101_SWRIVAL_01 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //========================================//
  //ライバル・プラズマ団を非表示に
  _FLAG_SET( FV_D27R0101_SWRIVAL_01 )
  _FLAG_SET(FV_D27R0101_SWPLAZMA_02)
  //========================================//
  
EVENT_END

//--------------------------------------------------------------------
//	プラズマ団：1歩下がる
//--------------------------------------------------------------------
