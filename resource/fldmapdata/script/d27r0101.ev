  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	AC_WALK_R_8F,2
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：チェレンタッグバトル位置調整
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_tag_cheren_02
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	ACMD_END,0

/************************************************************/
/*					CALL：乗船1回目・終了イベント起動  						*/
/************************************************************/
ev_d27r0101_first_end:

  _RIVAL_NAME(1)
  _PLAYER_NAME(0)
  
  //歓声があがる
  _SUBWIN_MSG( msg_d27r0101_sub_01 , 6 , 20 , 1 )
  _TIME_WAIT( 26 )
  _SUBWIN_MSG( msg_d27r0101_sub_02 , 4 , 11 , 2 )
  _TIME_WAIT( 26 )
  _SUBWIN_CLOSE( 1 )
  _SUBWIN_MSG( msg_d27r0101_sub_03 , 13 , 2 , 3 )
  _TIME_WAIT( 26 )
  _SUBWIN_CLOSE( 2 )
  _SUBWIN_MSG( msg_d27r0101_sub_04 , 18 , 14, 4 )
  _TIME_WAIT( 26 )
  _SUBWIN_CLOSE( 3 )
  _TIME_WAIT( 26 )
  _SUBWIN_CLOSE( 4 )
  
  //ライバル：ほら！ぜんいん
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_06 , D27R0101_SWRIVAL_01 ,POS_UL )
  _MSGWIN_CLOSE()
  
  //チェレン：左を向く
  _OBJ_ANIME( D27R0101_SWLEADER1_01 , anm_staystep_l )
  _OBJ_ANIME_WAIT()

  //チェレン：そうだね
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swleader1_06 , D27R0101_SWLEADER1_01 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //========================================//
  //ヴィオを表示
  _FLAG_RESET( FV_D27R0101_SWSAGE7_01 )
  //ダークトリニティを表示
  _FLAG_RESET( FV_D27R0101_NINJA_01 )
  //========================================//
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //七賢人動作OBJ生成
  _OBJ_ADD( D27R0101_SWSAGE7_01 )
  
  _SE_WAIT()
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_E_7_SAGE )
 
  //ヴィオ：なにごと　である？
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_01 , D27R0101_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン上に注目
  _OBJ_ANIME( D27R0101_SWLEADER1_01 , anm_staystep_u )
  //アニメ：ヴィオ主人公に接近
  _OBJ_ANIME_AUTO( D27R0101_SWSAGE7_01 , 13, 30, FORCE_TYPE_NPC, 8, DIR_UD)
  
  //カメラ操作　アデク追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,884736,0,2068480,30 )
  
  //アニメ：プラズマ団したっぱのく
  _OBJ_ANIME( D27R0101_SWPLAZMAM_03, anm_swplazma_yokeru_01 )
  _OBJ_ANIME( D27R0101_SWPLAZMAM_11, anm_swplazma_yokeru_02 )
  _TIME_WAIT( 10 )
  _OBJ_ANIME( D27R0101_SWPLAZMAM_04, anm_staystep_r )
  _OBJ_ANIME( D27R0101_SWPLAZMAM_10, anm_staystep_l )
  _OBJ_ANIME( D27R0101_SWPLAZMAW_02, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち  
  
  //アニメ：ヴィオ「！」「？」
  _OBJ_ANIME( D27R0101_SWSAGE7_01 , anm_swsage7_gyoe )
  _OBJ_ANIME_WAIT()
  
  //チェレン：やれやれ……
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swleader1_07 , D27R0101_SWLEADER1_01 ,POS_DR )
  _MSGWIN_CLOSE()
  
  //ヴィオ：ぐぬぬ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_02 , D27R0101_SWSAGE7_01 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //アニメ：ヴィオ・1歩上に移動してきょろきょろ
  _OBJ_ANIME( D27R0101_SWSAGE7_01 , anm_swsage7_onestep_back )
  _OBJ_ANIME_WAIT()
  
  //ヴィオ：おい！こいつらを
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_03 , D27R0101_SWSAGE7_01 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //イベント曲終了
  _END_EVENT_BGM()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (24)
  
  //ダークトリニティOBJ生成
  //アニメ：ダークトリニティ登場
  _OBJ_ADD( D27R0101_NINJA_01 )
  _OBJ_ANIME( D27R0101_NINJA_01 , anm_ninja_coming_01 )
  _OBJ_ADD( D27R0101_NINJA_02 )
  _OBJ_ADD( D27R0101_NINJA_03 )
  _OBJ_ANIME( D27R0101_NINJA_02 , anm_ninja_coming_01 )
  _OBJ_ANIME( D27R0101_NINJA_03 , anm_ninja_coming_01 )
  _OBJ_ANIME_WAIT()
  
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //ダークトリニティ：いっておくが
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_ninja_01 , D27R0101_NINJA_01 ,POS_DL )
  _MSGWIN_CLOSE()
  
  //アニメ：ヴィオ下を見る
  _OBJ_ANIME( D27R0101_SWSAGE7_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ヴィオ：わかっておる！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_04 , D27R0101_SWSAGE7_01 ,POS_UR )
  _MSGWIN_CLOSE()
  
   //ダークトリニティ：ということだ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_ninja_02 , D27R0101_NINJA_01 ,POS_DL )
  _MSGWIN_CLOSE()
  
_RET

