//	主人公：チェレンタッグバトル位置調整
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_tag_cheren_01
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	AC_WALK_R_8F,2
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：チェレンタッグバトル位置調整
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_tag_cheren_02
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	ACMD_END,0

/************************************************************/
/*					CALL：乗船1回目・終了イベント起動  						*/
/************************************************************/
ev_d27r0101_first_end:

  _RIVAL_NAME(1)
  _PLAYER_NAME(0)
  
  //チェレン：左を向く
  _OBJ_ANIME( D27R0101_SWLEADER1_01 , anm_staystep_l )
  _OBJ_ANIME_WAIT()

  //チェレン：さてと
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swleader1_06 , D27R0101_SWLEADER1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //カメラ操作　アデク追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  
  _CAMERA_MOVE( 9688,0,970752,884736,0,1343488,104 )
  
  //アニメ：3人上に移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 13, 22, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWRIVAL_01 , 12, 23, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D27R0101_SWLEADER1_01 , 14, 23, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //========================================//
  //ヴィオを表示
  _FLAG_RESET( FV_D27R0101_SWSAGE7_01 )
  //ダークトリニティを表示
  _FLAG_RESET( FV_D27R0101_NINJA_01 )
  //========================================//
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //七賢人動作OBJ生成
  _OBJ_ADD( D27R0101_SWSAGE7_01 )
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_E_7_SAGE )
  
  //アニメ：ヴィオ1歩前へ
  _OBJ_ANIME_AUTO( D27R0101_SWSAGE7_01 , 18, 16, FORCE_TYPE_NPC, 16, DIR_UD)
  _OBJ_ANIME_WAIT()
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //ヴィオ：なにごと　である？
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_01 , D27R0101_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ヴィオ主人公に接近
  _OBJ_ANIME_AUTO( D27R0101_SWSAGE7_01 , 13, 19, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D27R0101_SWSAGE7_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //アニメ：ヴィオ「！」「？」
  _OBJ_ANIME( D27R0101_SWSAGE7_01 , anm_swsage7_gyoe )
  _OBJ_ANIME_WAIT()
  
  //チェレン：やれやれ……
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swleader1_07 , D27R0101_SWLEADER1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ヴィオ：ぐぬぬ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_02 , D27R0101_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ヴィオ・1歩上に移動してきょろきょろ
  _OBJ_ANIME( D27R0101_SWSAGE7_01 , anm_swsage7_onestep_back )
  _OBJ_ANIME_WAIT()
  
  //ヴィオ：おい！こいつらを
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_03 , D27R0101_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //イベント曲終了
  _END_EVENT_BGM()
  
  //ダークトリニティOBJ生成
  //アニメ：ダークトリニティ登場
  _OBJ_ADD( D27R0101_NINJA_01 )
  _OBJ_ANIME( D27R0101_NINJA_01 , anm_ninja_coming_01 )
  _OBJ_ADD( D27R0101_NINJA_02 )
  _OBJ_ADD( D27R0101_NINJA_03 )
  _OBJ_ANIME( D27R0101_NINJA_02 , anm_ninja_coming_01 )
  _OBJ_ANIME( D27R0101_NINJA_03 , anm_ninja_coming_01 )
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ：ということだ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_ninja_01 , D27R0101_NINJA_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
_RET

