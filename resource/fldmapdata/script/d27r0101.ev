/************************************************************/
/*					POS：船首楼・ハッチ前W  						*/
/************************************************************/
EVENT_START	ev_pos_d27r0101_second_w_01
  
  //ライバル・主人公名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )

  //========================================//
  //ライバルを表示
  _FLAG_RESET( FV_D27R0101_SWRIVAL_01 )
  //========================================//
  
  //動作モデルを生成
  _OBJ_ADD( D27R0101_SWRIVAL_01 )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //ドア前
  IF $LCW_POSZ == 15 THEN
  
    //階段SE再生
    _SE_PLAY( SEQ_SE_KAIDAN )
    _SE_WAIT()
    
    //ドア前にライバルを移動
    _OBJ_POS_CHANGE(D27R0101_SWRIVAL_01,18,0,14,DIR_DOWN)
    
    //ライバル：おい！こっちだ！
    _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_02_04 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：ライバル上を向く
    _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_staystep_u )
    _OBJ_ANIME_WAIT()
  
  //ハッチ前
  ELSE
  
    //ハッチ手前にライバルを移動
    _OBJ_POS_CHANGE(D27R0101_SWRIVAL_01,13,0,35,DIR_DOWN)
    //アニメ：ライバル隣接
    _OBJ_ANIME_AUTO( D27R0101_SWRIVAL_01 , 17, 45, FORCE_TYPE_NPC, 4, DIR_UD)
    _OBJ_ANIME_WAIT()
    
    //ライバル：おい！こっちだ！
    _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_02_04 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：主人公中央へ
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 18, 45, FORCE_TYPE_ALL, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    
    //アニメ：主人公・ライバル連れ立って
    _OBJ_ANIME( D27R0101_SWRIVAL_01 , anm_rival_to_r1201_01 )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_to_r1201_01 )
    _OBJ_ANIME_WAIT()
  
  ENDIF
  
  //動作モデル削除
  _OBJ_DEL( D27R0101_SWRIVAL_01 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //アニメ：主人公船内へ
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_walk_u )
  _OBJ_ANIME_WAIT()
  
  //========================================//
  //D27R0101のPOSを無効に
  $WK_SCENE_D27R0101_SECONDW_01 = 3
  //D27R0101のライバルを非表示
  _FLAG_SET( FV_D27R0101_SWRIVAL_01 )
  //========================================//
  
  //予約スクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_D27R1201_RIVAL_01 )
  //マップチェンジ
  _MAP_CHANGE( ZONE_ID_D27R1201, 11, 15, DIR_DOWN )


EVENT_END

//--------------------------------------------------------------------
//	ライバル・主人公：船首楼前へ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_to_r1201_01
	_ANIME_DATA	AC_WALK_R_8F,4
	_ANIME_DATA	AC_WAIT_8F,1
	_ANIME_DATA	AC_WALK_U_8F,29
	_ANIME_DATA	AC_WALK_L_8F,4
	_ANIME_DATA	ACMD_END,0

