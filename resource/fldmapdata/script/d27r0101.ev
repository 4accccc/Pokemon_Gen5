/************************************************************/
/*					話しかけ：ライバル  						*/
/************************************************************/
EVENT_START	ev_d27r0101_swrival_01
  
  _RIVAL_NAME(1)
  _PLAYER_NAME(0)
  
  //タッグ戦条件を満たしていない
  IF $WK_SCENE_D27R0101_FIRST_01 == 2 THEN
    _TALK_START_SE_PLAY()
    _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_04 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
  //タッグ戦条件を満たしている
  ELSIF $WK_SCENE_D27R0101_FIRST_01 == 3 THEN
  
    _TALK_START_SE_PLAY()
    
    //戦闘前メッセージ
    _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_05 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //プレイヤー位置取得
    _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
    
    //アニメ：主人公の位置調整
    IF $LCW_POSX == 14 && $LCW_POSZ == 34 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_tag_rival_01 )
    ELSIF $LCW_POSX == 13 && $LCW_POSZ == 33 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_tag_rival_02 )
    ELSE
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    ENDIF

    //アニメ：ライバル向き合う
    _OBJ_ANIME( D27R0101_SWPLAZMAM_05, anm_dir_u )
    _OBJ_ANIME( D27R0101_SWPLAZMAW_01, anm_dir_u )
    _OBJ_ANIME_WAIT()
    
    //トレーナー戦
    IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
      //初期３匹で草タイプを選択
      _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_07, TRID_SWPLAZMAM_09, TRID_SWPLAZMAM_10 ) 
    ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
      //初期３匹で炎タイプを選択
      _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_08, TRID_SWPLAZMAM_09, TRID_SWPLAZMAM_10 ) 
    ELSE
      //初期３匹で水タイプを選択・主人公は♀
      _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_09, TRID_SWPLAZMAM_09, TRID_SWPLAZMAM_10 ) 
    ENDIF
    
    //結果チェック
    _CALL ev_battle_check
    
    _PLAYER_NAME(0)
    
    _RIVAL_NAME(1)
    _PLAYER_NAME(0)
    
    //戦闘後メッセージ
    _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_06 , D27R0101_SWRIVAL_01 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //CALL：乗船1回目終了イベント起動
    _CALL ev_d27r0101_first_end
    
    //========================================//
    //乗船1回目の全てのイベントを終了
    $WK_SCENE_D27R0101_FIRST_01 = 4
    $WK_SCENE_D05 = 4
    //乗船1回目の人物を全て非表示に
    _FLAG_SET(FV_D27R0101_SWRIVAL_01)
    _FLAG_SET(FV_D27R0101_SWPLAZMA_01)
    _FLAG_SET(FV_D27R0101_SWLEADER1_01)
    _FLAG_SET(FV_D27R0101_SWSAGE7_01)
    _FLAG_SET(FV_D27R0101_NINJA_01)
    
    //D05ライバル表示
    _FLAG_RESET( FV_D05_SWRIVAL_01 )
    //D05チェレン表示
    _FLAG_RESET( FV_D05_SWLEADER1_01 )
    //D05アクロマ非表示
    _FLAG_SET( FV_D05_SWBOSS_01 )
    //========================================//
    
    //マップ差し替え:D05アジト船非表示
    _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_05, FALSE , FALSE )
    
    //予約スクリプト
    _RESERVE_SCRIPT( SCRID_RESERVE_D05_SWPLAZMA_AF_01 )
    //D05マップチェンジ
    _MAP_CHANGE( ZONE_ID_D05, 197, 491, DIR_UP )
  
  //乗船2回目（プラズマ団員勝利前）
  ELSIF $WK_SCENE_D27R0101_SECONDW_01 == 1 || $WK_SCENE_D27R0101_SECONDW_01 == 1 THEN
  
    //主人公名代入
    _PLAYER_NAME( 0 )
    //ライバル名代入
    _RIVAL_NAME( 0 )
    
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swrival_02_01 )
  
  //乗船2回目（プラズマ団員勝利後）
  ELSE
    
    //主人公名代入
    _PLAYER_NAME( 0 )
    //ライバル名代入
    _RIVAL_NAME( 0 )
    
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swrival_02_02 )
  ENDIF

EVENT_END

//--------------------------------------------------------------------
//	主人公：ライバルタッグバトル位置調整
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_tag_rival_01
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_WALK_L_8F,2
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：ライバルタッグバトル位置調整
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_tag_rival_02
  _ANIME_DATA	AC_WALK_L_8F,1
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	ACMD_END,0

/************************************************************/
/*					話しかけ：チェレン  						*/
/************************************************************/
EVENT_START	ev_d27r0101_swleader1_01

  _PLAYER_NAME(0)
  _RIVAL_NAME(1)
  
  //タッグ戦条件を満たしている
  IF $WK_SCENE_D27R0101_FIRST_01 == 2 THEN
  
    _TALK_START_SE_PLAY()
    
     //プラズマ団：ちっ
    _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swplazmam3_01 , D27R0101_SWPLAZMAM_03 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //主人公方向取得
    _PLAYER_DIR_GET( LWK_DIR )
    
    //アニメ：チェレン振り向き
    IF $LWK_DIR == DIR_UP THEN
      _OBJ_ANIME( D27R0101_SWLEADER1_01, anm_staystep_d )
    ELSIF $LWK_DIR == DIR_RIGHT THEN
      _OBJ_ANIME( D27R0101_SWLEADER1_01, anm_staystep_l )
    ELSE
      _OBJ_ANIME( D27R0101_SWLEADER1_01, anm_staystep_r )
    ENDIF
  _OBJ_ANIME_WAIT()
    
    //戦闘前メッセージ
    _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swleader1_03 , D27R0101_SWLEADER1_01 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //プレイヤー位置取得
    _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
    
    //アニメ：主人公の位置調整
    IF $LCW_POSX == 10 && $LCW_POSZ == 28 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_tag_cheren_01 )
    ELSIF $LCW_POSX == 11 && $LCW_POSZ == 29 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_tag_cheren_02 )
    ELSE
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    ENDIF
    
    //アニメ：チェレン・プラズマ団員と向き合う
    _OBJ_ANIME( D27R0101_SWPLAZMAM_03, anm_dir_d )
    _OBJ_ANIME( D27R0101_SWPLAZMAM_04, anm_dir_d )
    _OBJ_ANIME( D27R0101_SWLEADER1_01, anm_staystep_u )
    _OBJ_ANIME_WAIT()
    
    //トレーナー戦
    _TRAINER_MULTI_BTL_SET ( TRID_SWLEADER1_1_01 , TRID_SWPLAZMAM_07 , TRID_SWPLAZMAM_08 ) 
    
    //結果チェック
    _CALL ev_battle_check
    
    _PLAYER_NAME(0)
    
    //アニメ：主人公とチェレン向き合う
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME( D27R0101_SWLEADER1_01, anm_staystep_r )
    _OBJ_ANIME_WAIT()
    
    //戦闘後メッセージ
    _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swleader1_04 , D27R0101_SWLEADER1_01 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //========================================//
    //チェレンマルチタッグ終了／ライバルマルチタッグ起動
    $WK_SCENE_D27R0101_FIRST_01 = 3
    //========================================//
  
  //タッグ戦を終えている
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swleader1_05 )
  ENDIF

EVENT_END

