_EVENT_DATA    ev_init_d27r0101
_EVENT_DATA    ev_recover_d27r0101
_EVENT_DATA    ev_zone_d27r0101
_EVENT_DATA    ev_pos_d27r0101_second_w_01
_EVENT_DATA    ev_pos_d27r0101_second_b_01
_EVENT_DATA    ev_d27r0101_swrival_01
_EVENT_DATA    ev_d27r0101_swleader1_01
_EVENT_DATA    ev_d27r0101_swplazmam_01
_EVENT_DATA    ev_d27r0101_swplazmam_02
_EVENT_DATA    ev_d27r0101_swplazmam_03
_EVENT_DATA    ev_d27r0101_swplazmam_04
_EVENT_DATA    ev_d27r0101_swplazmam_05
_EVENT_DATA    ev_d27r0101_swplazmaw_01
_EVENT_DATA    ev_d27r0101_swplazmam_07
_EVENT_DATA    ev_d27r0101_swplazmam_08
_EVENT_DATA    ev_d27r0101_swplazmam_09
_EVENT_DATA    ev_d27r0101_swplazmam_10
_EVENT_DATA    ev_d27r0101_swplazmam_11
_EVENT_DATA    ev_d27r0101_swplazmaw_02
_EVENT_DATA    ev_d27r0101_swplazmam1_02_01
_EVENT_DATA    ev_d27r0101_swplazmam1_02_02
_EVENT_DATA    ev_scene_d27r0101_firstbtl_01
_EVENT_DATA    ev_scene_d27r0101_secondbtl_01
_EVENT_DATA    ev_d27r0101_stopper_01
_EVENT_DATA    ev_d27r0101_swplazmam_end_01
_EVENT_DATA    ev_d27r0101_swplazmam_end_02
