//                d03r0101.ev
//
//    スクリプトファイル：d03r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_d03r0101.h"
  .include  "d03r0101.h"

//@author suginaka_katsunori
//@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_d03r0101_sunglasses_01
_EVENT_DATA		ev_d03r0101_backpackerm_01
_EVENT_DATA		ev_d03r0101_fighterm_01
_EVENT_DATA		ev_zone_d03r0101
_EVENT_DATA		ev_d03r0101_rangerm_01
_EVENT_DATA_END

//ヒヒダルマの戦闘フラグ指定用ユーザーワークを定義（共通化のためここで定義します）
DEFINE_LOCAL	LWK_BTL_FLAG

/**************************************************************/
/*		ZONE CHANGE LABEL									  */
/**************************************************************/
INIT_EVENT_START	ev_zone_d03r0101

INIT_EVENT_END

/**************************************************************/
/*			バックパッカー♂								  */
/**************************************************************/
EVENT_START		ev_d03r0101_backpackerm_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_d03r0101_backpackerm_01 )
EVENT_END

/**************************************************************/
/*			格闘家♂										  */
/**************************************************************/
EVENT_START		ev_d03r0101_fighterm_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_d03r0101_fighterm_01 )
EVENT_END

/**************************************************************/
/*			サングラス	D03R0101イベントスクリプト			  */
/**************************************************************/
EVENT_START		ev_d03r0101_sunglasses_01

	//初回話しかけの場合、やわらかいすな入手
	IF FLAG_OFF( FE_D03R0101_ITEMGET_01 ) THEN
	
		_EASY_TALK_ITEM_EVENT(ITEM_YAWARAKAISUNA, 1, FE_D03R0101_ITEMGET_01 , msg_d03r0101_sunglasses_01, msg_d03r0101_sunglasses_02, msg_d03r0101_sunglasses_02 )
	
	//やわらかいすな入手後
	ELSE
		
		//古代の城に入っているか？
		IF FLAG_ON( SYS_FLAG_ARRIVE_D04R0101) THEN
			_EASY_BALLOONWIN_TALKOBJ_MSG( msg_d03r0101_sunglasses_03 )
		//まだはいっていない場合
		ELSE
			_EASY_BALLOONWIN_TALKOBJ_MSG( msg_d03r0101_sunglasses_02 )
		ENDIF
		
	ENDIF

EVENT_END

/**************************************************************/
/*  RANGERM                                            */
/**************************************************************/
EVENT_START   ev_d03r0101_rangerm_01
  
  //初回話しかけであったならば
  IF FLAG_OFF(SYS_FLAG_FES_TREASURE1) THEN
  
    _TALK_OBJ_START()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_d03r0101_mission_add_01 )
    _MSGWIN_CLOSE()
    
    DEFINE_LOCAL LCWK_VERSION
    _GET_ROM_VERSION( LCWK_VERSION )
    
    //フェスミッション名代入
    IF $LCWK_VERSION == VERSION_B2 THEN
      _FMISSION_NAME( 0, FMISSION_ID_ITEM_TREASURE1B, 0 )
    ELSE
      _FMISSION_NAME( 0, FMISSION_ID_ITEM_TREASURE1W, 0 )
    ENDIF
    
    //フェスミッションが追加されました
    _SE_PLAY( SEQ_SE_FLD_133 )
    _SYSWIN_MSG( msg_d03r0101_mission_add_02, POS_DEFAULT )
    _SE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_d03r0101_mission_add_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //==================================//
    //初回会話終了
    _FLAG_SET(SYS_FLAG_FES_TREASURE1)
    //==================================//
    
  //2回目以降
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d03r0101_mission_add_03 )
  ENDIF
  
EVENT_END
