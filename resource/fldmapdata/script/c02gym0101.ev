EVENT_END

/**************************************************************/
/*  展示物の解説プレート1                                     */
/**************************************************************/
EVENT_START   ev_bg_c02gym0101_plate_01

  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_c02gym0101_plate_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  展示物の解説プレート2                                     */
/**************************************************************/
EVENT_START   ev_bg_c02gym0101_plate_02

  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_c02gym0101_plate_02 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  展示物の解説プレート3                                     */
/**************************************************************/
EVENT_START   ev_bg_c02gym0101_plate_03

  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_c02gym0101_plate_03 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  展示物の解説プレート4                                     */
/**************************************************************/
EVENT_START   ev_bg_c02gym0101_plate_04

  _TALK_START_SE_PLAY()

  //バージョンを取得してメッセージを変化
  _GET_ROM_VERSION( LCWK_VERSION )
  //B2:ダークストーンのレプリカ
  IF $LCWK_VERSION == VERSION_B2 THEN
    _PLAINWIN_MSG_DOWN( msg_c02gym0101_plate_04b )
  //W2:ライトストーンのレプリカ
  ELSE
    _PLAINWIN_MSG_DOWN( msg_c02gym0101_plate_04w )
  ENDIF
  _LAST_KEYWAIT()
