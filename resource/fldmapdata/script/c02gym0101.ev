  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c02gym0101.h"
  .include  "c02gym0101.h"
  
  .include  "oldc02gym0202.h"
  .include  "oldc02gym0202_def.h"

  //@author fujimura_souichirou
  //@author Mizuguchi_Mai（リンクイベント）
  //@author suginaka_katsunori（石配置）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_init_c02gym0101
_EVENT_DATA   ev_zone_c02gym0101
_EVENT_DATA   ev_pos_c02gym0101_leader2_01
_EVENT_DATA   ev_c02gym0101_informationw_01
_EVENT_DATA   ev_c02gym0101_informationw_02
_EVENT_DATA   ev_c02gym0101_ad_01
_EVENT_DATA   ev_c02gym0101_man1_01
_EVENT_DATA   ev_c02gym0101_girl3_01
_EVENT_DATA   ev_c02gym0101_oldman_01
_EVENT_DATA   ev_c02gym0101_rangerw_01
_EVENT_DATA   ev_bg_c02gym0101_plate_01
_EVENT_DATA   ev_bg_c02gym0101_plate_02
_EVENT_DATA   ev_bg_c02gym0101_plate_03
_EVENT_DATA   ev_bg_c02gym0101_plate_04
_EVENT_DATA   ev_bg_c02gym0101_plate_05
_EVENT_DATA   ev_bg_c02gym0101_plate_06
_EVENT_DATA   ev_bg_c02gym0101_plate_07
_EVENT_DATA   ev_pos_c02gym0101_link_event
_EVENT_DATA   ev_reserve_c02gym0101_link_event_ret
_EVENT_DATA   ev_scene_c02gym0101_link_event
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//バージョン取得
DEFINE_LOCAL  LCWK_VERSION

//------------------------------注意--------------------------------//
//
//  LOCALWORK15をリンクイベントで使用。
//                                                                  //
//------------------------------------------------------------------//

/**************************************************************/
/*  FIELD_INIT_LABEL                                          */
/**************************************************************/
INIT_EVENT_START  ev_init_c02gym0101

  //博物館案内後、アロエと会話をするまで副館長は階段の下で待機
  IF $WK_SCENE_C02GYM0101 == 1 && FLAG_OFF( FE_C02GYM0202_LEADER2_TALK_01 ) THEN

    _OBJ_POS_CHANGE( C02GYM0101_AD_01, 13, 0, 11, DIR_UP )

  ENDIF
  
  //リンクイベント起動状態ならアロエの位置を変更
  IF FLAG_OFF( FV_C02GYM0101_LEADER2_01 ) THEN
    _OBJ_POS_CHANGE( C02GYM0101_LEADER2_01, 12, 3, 4, DIR_DOWN )
  ENDIF

  //バージョンによって石の種類を変更
  _GET_ROM_VERSION( SCWK_ANSWER )
  _DEBUG_PRINT_WK(SCWK_ANSWER)
  
  SWITCH $SCWK_ANSWER
  CASE VERSION_B2 THEN
	$OBJCHRWORK0 = BLACKSTONE
  CASE VERSION_W2 THEN
	$OBJCHRWORK0 = WHITESTONE
  ENDSWITCH

INIT_EVENT_END

/************************************************************/
/*  ZONE_CHANGE_SCRIPT                                      */
/************************************************************/
INIT_EVENT_START  ev_zone_c02gym0101
{
  //データコンバートフラグチェック
  _DATACONV_GET_FLAG( DATACONV_FLAG_BADGE_05, LOCALWORK15 )

  //リンクイベント起動状態でアロエを表示
  IF $LOCALWORK15 == 1 &&  $WK_SYS_LINK_EVENT_05 == 0 && FLAG_OFF( FE_C02GYM0101_LINKEV_ZONE ) THEN
    //========================================//
    //C02GYM0101アロエを表示
    _FLAG_RESET( FV_C02GYM0101_LEADER2_01 )
    //POS有効
     $WK_SCENE_C02_LINK_EVENT = 1
    //========================================//
  ENDIF
  
  //リンクイベント起動状態でSCENE_CHANGE起動（図書館側から来た処理）
  IF $LOCALWORK15 == 1 &&  $WK_SYS_LINK_EVENT_05 == 0 && FLAG_ON( FE_C02GYM0101_LINKEV_ZONE ) THEN
    //========================================//
    //C02GYM0101アロエを非表示
    _FLAG_SET( FV_C02GYM0101_LEADER2_01 )
    //POS有効
     $WK_SCENE_C02_LINK_EVENT = 2
    //========================================//
  ENDIF
  
  //========================================//
  //C06GYM0201退室フラグを初期化
  _FLAG_RESET( FE_C02GYM0101_LINKEV_ZONE )
  //========================================//

  //バージョンによって石の種類を変更
  _GET_ROM_VERSION( SCWK_ANSWER )
  _DEBUG_PRINT_WK(SCWK_ANSWER)
  
  SWITCH $SCWK_ANSWER
  CASE VERSION_B2 THEN
	$OBJCHRWORK0 = BLACKSTONE
  CASE VERSION_W2 THEN
	$OBJCHRWORK0 = WHITESTONE
  ENDSWITCH

}
INIT_EVENT_END

/**************************************************************/
/*  POS： リンクイベント                              */
/**************************************************************/
EVENT_START   ev_pos_c02gym0101_link_event
  
  //アニメ：アロエ「！」
  _OBJ_ANIME( C02GYM0101_LEADER2_01,anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //プレイヤー座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //POSを踏んだ座標で処理を分岐
  IF $LCW_POSZ == 3 THEN
    
    //アニメ：図書室方面から来たらアロエ振り向き
    _OBJ_ANIME( C02GYM0101_LEADER2_01,anm_stay_u )
    _OBJ_ANIME_WAIT()
    
  ELSE
  
    $LCW_POSZ -= 2
    //アニメ：アロエ隣接
    IF $LCW_POSX != 12 THEN
      _OBJ_ANIME_AUTO( C02GYM0101_LEADER2_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR)
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( C02GYM0101_LEADER2_01,anm_stay_d )
      _OBJ_ANIME_WAIT()
    ENDIF
  
  ENDIF
  
  _BALLOONWIN_OBJMSG_POS(msg_c02gym0101_memory_01, C02GYM0101_LEADER2_01 , POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _MAP_FADE_BLACK_OUT_SLOW()
  //過去イベント・シッポウ起動
  _RESERVE_SCRIPT( SCRID_RESERVE_OLDC02GYM0202_EVENT_01 )
  _MAP_FADE_END_CHECK()
  //マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_OLDC02GYM0202, 6, 0, 3, DIR_DOWN )
  
EVENT_END

/**************************************************************/
/*  SCENE_CHANGE： リンクイベント                              */
/**************************************************************/
EVENT_START   ev_scene_c02gym0101_link_event
  
  //========================================//
  //C02GYM0101アロエを表示
  _FLAG_RESET( FV_C02GYM0101_LEADER2_01 )
  //========================================//
  
  //アニメ：主人公中央まで移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 12, 6, FORCE_TYPE_NOT, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //アロエ動作モデル生成
  _OBJ_ADD( C02GYM0101_LEADER2_01 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //アロエワープ
  _OBJ_POS_CHANGE(C02GYM0101_LEADER2_01,12,0,2,DIR_DOWN)
  
  _SE_WAIT()
  
  //アニメ：主人公振り向く
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_stay_u )
  _OBJ_ANIME_WAIT()
  
  //アニメ：アロエ隣接
  _OBJ_ANIME_AUTO( C02GYM0101_LEADER2_01, 12, 4, FORCE_TYPE_ALL, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  _BALLOONWIN_OBJMSG_POS(msg_c02gym0101_memory_01, C02GYM0101_LEADER2_01 , POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _MAP_FADE_BLACK_OUT_SLOW()
  //過去イベント・シッポウ起動
  _RESERVE_SCRIPT( SCRID_RESERVE_OLDC02GYM0202_EVENT_01 )
  _MAP_FADE_END_CHECK()
  //マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_OLDC02GYM0202, 6, 0, 3, DIR_DOWN )
  
EVENT_END

/**************************************************************/
/*  RESERVE： リンクイベント                              */
/**************************************************************/
EVENT_START   ev_reserve_c02gym0101_link_event_ret
  
  //ブラックイン
  _MAP_FADE_BLACK_IN_SLOW()
  _MAP_FADE_END_CHECK()
  
  //アロエ：おもいでリンク終了メッセージ
  _BALLOONWIN_OBJMSG_POS(msg_c02gym0101_memory_02, C02GYM0101_LEADER2_01 , POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //アニメ：アロエ退場
  _OBJ_ANIME_AUTO( C02GYM0101_LEADER2_01, 12, 2, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  _TIME_WAIT( 8 )
  
  //動作モデル削除
  _OBJ_DEL( C02GYM0101_LEADER2_01 )
  _SE_WAIT()

  //========================================//
  //POS無効
  $WK_SCENE_C02_LINK_EVENT = 3
  //リンクイベント起動終了
  $WK_SYS_LINK_EVENT_05 = 1
  //C02GYM0101のアロエを非表示
  _FLAG_SET( FV_C02GYM0101_LEADER2_01 )
  //========================================//
  
EVENT_END

/**************************************************************/
/*  POS：博物館案内（化石入手）                               */
/**************************************************************/
EVENT_START   ev_pos_c02gym0101_leader2_01

  DEFINE_LOCAL  LWK_SELECT
  DEFINE_LOCAL  LWK_REPEAT

  //副館長：うーむ！　この　こっかくは
  _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_ad_01, C02GYM0101_AD_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
  //アニメ：副館長接近
  IF $LCW_POSX != 12 THEN
    $LCW_POSZ -= 1
    _OBJ_ANIME_AUTO( C02GYM0101_AD_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR )
    _OBJ_ANIME_WAIT()
  ENDIF
  _OBJ_ANIME( C02GYM0101_AD_01, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //副館長：どうも　わたくし
  _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_ad_02, C02GYM0101_AD_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

   //フィールド上にアロエ配置
  _OBJ_ADD_EX( 8, 11, DIR_DOWN, MMDL_ID_EVENTOBJ_00, LEADER2, MV_DMY )

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
  //アニメ：アロエ接近
  $LCW_POSX -= 1
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  //プライヤー名代入
  _PLAYER_NAME( 0 )
  //？？？：あんた　《主人公》だろ！
  _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_01, MMDL_ID_EVENTOBJ_00, POS_DOWN )

  WHILE $LWK_REPEAT != 1

    //化石選択
    _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_SELECT )

    _BMPMENU_MAKE_LIST( msg_c02gym0101_select_01, 0 ) //ふたのカセキ
    _BMPMENU_MAKE_LIST( msg_c02gym0101_select_02, 1 ) //はねのカセキ
    _BMPMENU_MAKE_LIST( msg_c02gym0101_select_03, 2 ) //やめる

    //メニュー表示
    _BMPMENU_START()

    //選択結果で分岐
    SWITCH $LWK_SELECT
    CASE 0 THEN   //ふたのカセキ
      //？？？：ふたのカセキに　するんだね？
      _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_02, MMDL_ID_EVENTOBJ_00, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )

      IF $SCWK_ANSWER == SCR_YES THEN   //はい

        //？？？：ふたのカセキなんだね
        _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_06, MMDL_ID_EVENTOBJ_00, POS_DOWN )
        _MSGWIN_CLOSE()

        //アイテム「ふたのカセキ」入手
        _ITEM_EVENT_NOWAIT( ITEM_HUTANOKASEKI, 1 )

        //========================================/
        //アイテム入手フラグON
        _FLAG_SET( FE_C02GYM0101_ITEMGET_01 )
        //繰り返し脱出
        $LWK_REPEAT = 1
        //========================================/

      ELSE  //いいえ

        //？？？：どっちが　すきだい？
        _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_04, MMDL_ID_EVENTOBJ_00, POS_DOWN )

      ENDIF

    CASE 1 THEN   //はねのカセキ
      //？？？：はねのカセキに　するんだね？
      _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_03, MMDL_ID_EVENTOBJ_00, POS_DOWN )
      _YES_NO_WIN( SCWK_ANSWER )

      IF $SCWK_ANSWER == SCR_YES THEN   //はい

        //？？？：はねのカセキなんだね
        _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_07, MMDL_ID_EVENTOBJ_00, POS_DOWN )
        _MSGWIN_CLOSE()

        //アイテム「はねのカセキ」入手
        _ITEM_EVENT_NOWAIT( ITEM_HANENOKASEKI, 1 )

        //========================================/
        //アイテム入手フラグON
        _FLAG_SET( FE_C02GYM0101_ITEMGET_01 )
        //繰り返し脱出
        $LWK_REPEAT = 1
        //========================================/

      ELSE  //いいえ

        //？？？：どっちが　すきだい？
        _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_04, MMDL_ID_EVENTOBJ_00, POS_DOWN )

      ENDIF

    CASE 2 THEN   //いいえ
      //？？？：なんだい　なんだい！▼
      _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_05, MMDL_ID_EVENTOBJ_00, POS_DOWN )
      _MSGWIN_CLOSE()
      //========================================/
      //繰り返し脱出
      $LWK_REPEAT = 1
      //========================================/

    DEFAULT
      //？？？：なんだい　なんだい！▼
      _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_05, MMDL_ID_EVENTOBJ_00, POS_DOWN )
      _MSGWIN_CLOSE()
      //========================================/
      //繰り返し脱出
      $LWK_REPEAT = 1
      //========================================/

    ENDSWITCH

  ENDWHILE

  //アニメ：副館長振り向き
  _OBJ_ANIME( C02GYM0101_AD_01, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  //副館長：ちょっと　ママ！▼
  _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_ad_07, C02GYM0101_AD_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //カセキを入手している場合
  IF FLAG_ON( FE_C02GYM0101_ITEMGET_01 ) THEN
    //アロエ：いつもは　おくに　こもっているから
    _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_08, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  ELSE
    //アロエ：カセキが　ほしくなったら▽
    _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_leader2_09, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  ENDIF
  _MSGWIN_CLOSE()

  //アニメ：アロエ退場
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 8, 11, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )   //動作モデル削除

  //アニメ：副館長と主人公向かい合う
  _OBJ_ANIME( C02GYM0101_AD_01, anm_common_turn_d )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
  _OBJ_ANIME_WAIT()

  //副館長：ママったら……
  _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_ad_03, C02GYM0101_AD_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：副館長、主人公移動
  _OBJ_ANIME_AUTO( C02GYM0101_AD_01, 6, 13, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 14, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C02GYM0101_AD_01, anm_common_turn_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  //副館長：デオキシスという　ポケモンは
  _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_ad_04, C02GYM0101_AD_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：副館長、主人公移動
  _OBJ_ANIME_AUTO( C02GYM0101_AD_01, 7, 11, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 6, 11, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C02GYM0101_AD_01, anm_common_turn_u )
  _OBJ_ANIME_WAIT()

  //副館長：これが　あの　ダークストーンの（バージョンによってセリフが異なる）
  _BALLOONWIN_OBJMSG_WB( msg_c02gym0101_ad_06, msg_c02gym0101_ad_05, C02GYM0101_AD_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：副館長、主人公移動
  _OBJ_ANIME_AUTO( C02GYM0101_AD_01, 13, 11, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 12, 11, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C02GYM0101_AD_01, anm_common_turn_u )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
  _OBJ_ANIME_WAIT()

  //副館長：つぎの　へやは　としょしつ
  _BALLOONWIN_OBJMSG_POS( msg_c02gym0101_ad_06a, C02GYM0101_AD_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

  //========================================//
  //POS無効
  $WK_SCENE_C02GYM0101 = 1
  //========================================//

EVENT_END

/**************************************************************/
/*  博物館受付嬢01                                            */
/**************************************************************/
EVENT_START   ev_c02gym0101_informationw_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c02gym0101_counter1_01 )
EVENT_END

/**************************************************************/
/*  博物館受付嬢02                                            */
/**************************************************************/
EVENT_START   ev_c02gym0101_informationw_02

  _TALK_OBJ_START()
  //受付嬢：いま　はくぶつかん　では（バージョンによってセリフが異なる）
  _BALLOONWIN_OBJMSG_WB( msg_c02gym0101_counter2_01w, msg_c02gym0101_counter2_01b, C02GYM0101_INFORMATIONW_02, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  副館長                                                    */
/**************************************************************/
EVENT_START   ev_c02gym0101_ad_01

  //アロエと会話するまで
  IF FLAG_OFF( FE_C02GYM0202_LEADER2_TALK_01 ) THEN

    //副館長：つぎの　へやは　としょしつ
    _EASY_BALLOONWIN_TALKOBJ_MSG  ( msg_c02gym0101_ad_06a )

  //アロエと会話後
  ELSE

    //副館長：ホネの　ひょうほん　って
    _EASY_BALLOONWIN_TALKOBJ_MSG  ( msg_c02gym0101_ad_08 )

  ENDIF

EVENT_END

/**************************************************************/
/*  見物客その１  MAN1                                        */
/**************************************************************/
EVENT_START   ev_c02gym0101_man1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG  ( msg_c02gym0101_man1_01 )
EVENT_END

