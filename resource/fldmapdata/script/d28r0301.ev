//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_d28r0301_workman2_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_d28r0301:
//  _END

/**************************************************************/
/*  D28R0301 WORKMAN2 一言メッセージ                          */
/**************************************************************/
EVENT_START   ev_d28r0301_workman2_01

  //初回話しかけであったならば
  IF FLAG_OFF(SYS_FLAG_FES_JEWEL1) THEN
  
    _TALK_OBJ_START()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_d28r0301_mission_add_01 )
    _MSGWIN_CLOSE()

    //フェスミッション名格納
    _FMISSION_NAME( 0, FMISSION_ID_EVENT_JEWEL_01, 0 )

    //フェスミッションが追加されました
    _SE_PLAY( SEQ_SE_FLD_133 )
    _SYSWIN_MSG( msg_d28r0301_mission_add_02, POS_DEFAULT )
    _SE_WAIT()
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //==================================//
    //初回会話終了
    _FLAG_SET(SYS_FLAG_FES_JEWEL1)
    //==================================//
    
  //2回目以降
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d28r0301_mission_add_01 )
  ENDIF

EVENT_END