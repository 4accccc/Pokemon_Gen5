
//======================================================================
//                d26r0301.ev
//
//    スクリプトファイル：d26r0301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d26r0301.h"
  .include  "d26r0301.h"

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_zone_d26r0301
_EVENT_DATA		ev_recover_d26r0301
_EVENT_DATA_END

/************************************************************/
/*		CALL：特殊接続                             */
/************************************************************/
ev_exit_change:

	//バージョン取得
	DEFINE_LOCAL LCWK_VERSION

  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //バージョンごとに異なる接続を配置
  
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0301_D26R0901_EXIT01, -248, 0, 248 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0301_D26R1001_EXIT01, -248, 0, 232 )
  //W2
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0301_D26R0201_EXIT01, -248, 0, 248 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0301_D26R0401_EXIT01, -248, 0, 232 )
  ENDIF
_RET


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
INIT_EVENT_START   ev_zone_d26r0301

  _CALL ev_exit_change

INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d26r0301

  _CALL ev_exit_change
  
INIT_EVENT_END