//======================================================================
//
//                n01r0502.ev
//
//    スクリプトファイル：Ｎの城、謁見の間
//
//
//  N01R0502_BOSS_01          N
//  N01R0502_WKOBJCODE00_01   Nの連れている伝説ポケモン
//
//
/*
使用可能なアニメコマンド一覧
シンムA( SHIN_A / MU_A )
AC_DIR_U 上向き
AC_SHIN_MU_FLY_L シンム　飛ぶ　左
AC_SHIN_MU_FLY_UPPER シンム　上昇
AC_SHIN_MU_GUTARI シンム　ぐったりアニメ

シンムB( SHIN_B / MU_B )
AC_DIR_U　上向き
AC_DIR_D　下向き
AC_SHIN_MU_HOERU シンム　吠えるアニメ
AC_SHIN_MU_TURN シンム　振り向き

シンムC( SHIN_C / MU_C)
AC_SHIN_MU_C_FLY //<シンムC 滞空アニメ
AC_SHIN_MU_OFFS_CLEAR //描画オフセットをクリア

*/
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_n01r0502.h"
  .include  "n01r0502.h"
  .include  "n01r0502_def.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_pos_n01r0502_boss_01
_EVENT_DATA		ev_n01r0502_boss_02
_EVENT_DATA		ev_zone_n01r0502
_EVENT_DATA		ev_init_n01r0502
_EVENT_DATA		ev_recover_n01r0502
_EVENT_DATA		ev_n01r0502_npoke_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
DEFINE_LOCAL  LCWK_VERSION
DEFINE_LOCAL  LCWK_ANSWER
DEFINE_LOCAL  LCWK_SEX

//------------------------------注意--------------------------------//

//  LOCALWORK15を初回会話チェックに使用

//------------------------------------------------------------------//

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_n01r0502
{
  //N再戦処理
  DEFINE_LOCAL  LCWK_SEASON
  //月を取得
  _GET_DATE( LCWK_SEASON, LOCALWORK15 )
  
  //・D10でキュレムと戦闘した
  //・C04P01観覧車でNと出会った
  //・季節が変わっている
  //以上3点の条件を満たしていたならばNを再表示
  IF FLAG_ON( FE_D10R0401_POKE10_MEET ) && FLAG_ON( FE_C04WHEEL_N_MEET ) && $WK_OTHER_N01R0502_N_SEASON != $LCWK_SEASON THEN
    //==================================//
    //n01r0502 N表示
    _FLAG_RESET( FV_N01R0502_BOSS_01 )
    //==================================//
  ENDIF
  
  //==================================//
  //日にちを取得したワークを初期化
  $LOCALWORK15 = 0
  //==================================//
  
}

  //バージョンを取得してOBJを変化させる
	_GET_ROM_VERSION( SCWK_ANSWER )
	
	//BlackVERならゼクロム
	IF $SCWK_ANSWER == VERSION_B2 THEN
		$OBJCHRWORK0 = SPPOKE02_ZE
	
	//Whiteならレシラム
	ELSE
		$OBJCHRWORK0 = SPPOKE01_RE
	ENDIF

   {
  DEFINE_LOCAL LWK_SEX
  //性別を取得してOBJを変化させる
  _GET_MY_SEX( LWK_SEX )
  IF $LWK_SEX == PM_MALE THEN
    $OBJCHRWORK1 = SWHERO
  ELSE
    $OBJCHRWORK1 = SWHEROINE
  ENDIF
  }
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_n01r0502

  _CALL ev_n01r0502_change

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_n01r0502
  
  _CALL ev_n01r0502_change

INIT_EVENT_END

/************************************************************/
/*					CALL：人物配置を変更  						*/
/************************************************************/
// バージョン別で出口位置変更
ev_n01r0502_change:
{
  // イベント進行状態なら
  IF FLAG_OFF( FV_N01R0502_BOSS_01 ) THEN
    _OBJ_POS_CHANGE(N01R0502_BOSS_01,16,0,36,DIR_DOWN)
  ELSE 
  ENDIF
}
_RET


/************************************************************/
/*					POS：連れ歩き解除						*/
/************************************************************/
EVENT_START	ev_pos_n01r0502_boss_01

  //==================================//
  //N01R0502 N配置
  _FLAG_RESET( FV_N01R0502_BOSS_01 )
  _FLAG_RESET( FV_N01R0502_NPOKE_01 )
  _FLAG_RESET( FV_N01R0502_PLAYER_01 )
  //==================================//
  
  //Ｎ動作モデル生成
  _OBJ_ADD( N01R0502_BOSS_01 )
  //動作モデルワープ
  _OBJ_POS_CHANGE(N01R0502_BOSS_01,16,0,48,DIR_UP)
  
  //N曲再生
  _START_EVENT_BGM( SEQ_BGM_E_N_SWAN )
  
  //メッセージ：そこだ！
  _PLAINWIN_MSG_DOWN( msg_n01r0502_boss_01 )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公振り向く
  _OBJ_ANIME( MMDL_ID_PLAYER ,anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  IF $LCW_POSX >= 17 THEN
    $LCW_POSX -= 1
  ELSE
    $LCW_POSX += 1
  ENDIF
  
  //アニメ：主人公とN並ぶ
  _OBJ_ANIME_AUTO( N01R0502_BOSS_01,LCW_POSX,LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //アニメ：主人公とＮ向き合う
  IF $LCW_POSX >= 17 THEN
    _OBJ_ANIME( N01R0502_BOSS_01,anm_staystep_r )
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_l )
    _OBJ_ANIME_WAIT()
  ELSE
    _OBJ_ANIME( N01R0502_BOSS_01,anm_staystep_l )
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_r )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //Ｎ：2年前のことだ
  _BALLOONWIN_OBJMSG_WB(  msg_n01r0502_boss_02w, msg_n01r0502_boss_02b , N01R0502_BOSS_01 , POS_DEFAULT)

  //Ｎ：そして敗れた
  _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_03, N01R0502_BOSS_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  //カメラ操作・ダミー主人公を中心に
  _CAMERA_MOVE( 9688,0,970752,1081344,0,2371584,56 )
  
  //アニメ：Ｎ中心へ
  SWITCH $LCW_POSX
  CASE 14 THEN
    _OBJ_ANIME( N01R0502_BOSS_01,anm_boss_go_center_x14 )
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_go_center_x14 )
  CASE 15 THEN
    _OBJ_ANIME( N01R0502_BOSS_01,anm_boss_go_center_x15 )
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_go_center_x15 )
  CASE 16 THEN
    _OBJ_ANIME( N01R0502_BOSS_01,anm_boss_go_center_x16 )
    _TIME_WAIT( 16 )
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_go_center_x16 )
  CASE 17 THEN
    _OBJ_ANIME( N01R0502_BOSS_01,anm_boss_go_center_x17 )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_go_center_x17 )
  CASE 18 THEN
    _OBJ_ANIME( N01R0502_BOSS_01,anm_boss_go_center_x16 )
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_go_center_x18 )
  ENDSWITCH
  _OBJ_ANIME_WAIT()
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //ダミーの主人公を表示
  _OBJ_ADD( N01R0502_PLAYER_01 )
  
  //アニメ：主人公消す
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_vanish_on)
  _OBJ_ANIME_WAIT()
  
  //主人公座標変更（一時的にNと同じ座標に）
  _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 16, 0, 36, DIR_DOWN )
  
  //Ｎ：ことなる
  _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_04, N01R0502_BOSS_01, POS_UL )
  
  //Ｎ：おいで！
  _BALLOONWIN_OBJMSG_WB( msg_n01r0502_boss_05w , msg_n01r0502_boss_05b , N01R0502_BOSS_01 , POS_UL)
  _MSGWIN_CLOSE()
  
  //アニメ：Ｎ右を向く
  _OBJ_ANIME( N01R0502_BOSS_01, anm_staystep_r)
  _OBJ_ANIME_WAIT()
  
  //レシラム・ゼクロム登場演出
  _CALL ball_out
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //ブラック：バリバリダー！
  IF $LCWK_VERSION == VERSION_B2 THEN
    _GIZAPLAINWIN_MSG_POS( msg_n01r0502_mu_01, POS_UP )
    _VOICE_PLAY( MONSNO_651, 0 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
  //ホワイト：モエルーワ！
  ELSE
    _GIZAPLAINWIN_MSG_POS( msg_n01r0502_shin_01, POS_UP )
    _VOICE_PLAY( MONSNO_650, 0 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
  ENDIF
  
  //アニメ：Ｎ下を向く
  _OBJ_ANIME( N01R0502_BOSS_01, anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //Ｎ：キミが
  _BALLOONWIN_OBJMSG_WB( msg_n01r0502_boss_06w , msg_n01r0502_boss_06b , N01R0502_BOSS_01 , POS_UL)
  
  //主人公座標戻す
  _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 16, 0, 38, DIR_UP )
  
  //アニメ：主人公出現
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_vanish_off)
  _OBJ_ANIME_WAIT()
  
  //ダミー主人公削除
  _OBJ_DEL( N01R0502_PLAYER_01 )
  
  //==================================//
  //N01R0502 POS無効
  $WK_SCENE_N01R0502_BOSS = 2
  //N01R0401 POS無効
  $WK_SCENE_N01R0401_BOSS = 1
  //N01R0501 N非表示
  _FLAG_SET( FV_N01R0501_BOSS_01 )
  //N01R0501 POS無効
  $WK_SCENE_N01R0501_BOSS = 2
  //ダミー主人公非表示
  _FLAG_SET( FV_N01R0502_PLAYER_01 )
  
  //初回会話セット
  $LOCALWORK15 = 99
  //==================================//
  
  //CALL：ストーン入手用会話処理へジャンプ
  _CALL ev_n02r0502_boss_stone

EVENT_END

//--------------------------------------------------------------------
//	N：センターへ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_boss_go_center_x14
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA	AC_WALK_U_8F,6
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_boss_go_center_x15
	_ANIME_DATA	AC_WALK_U_8F,6
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_boss_go_center_x16
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_WALK_L_8F,1
  _ANIME_DATA	AC_WALK_U_8F,5
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_boss_go_center_x17
	_ANIME_DATA	AC_WALK_U_8F,6
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_boss_go_center_x18
  _ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_U_8F,6
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：センターへ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_go_center_x14
  _ANIME_DATA	AC_WALK_R_8F,2
  _ANIME_DATA	AC_WALK_U_8F,4
  _ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_go_center_x15
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA	AC_WALK_U_8F,4
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_go_center_x16
	_ANIME_DATA	AC_WALK_U_8F,4
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_go_center_x17
  _ANIME_DATA	AC_WALK_L_8F,1
  _ANIME_DATA	AC_WALK_U_8F,4
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_go_center_x18
  _ANIME_DATA	AC_WALK_L_8F,2
  _ANIME_DATA	AC_WALK_U_8F,4
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0


//--------------------------------------------------------------------
//		カメラ移動用に主人公を一時的に非表示
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_vanish_on
	_ANIME_DATA	AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_vanish_off
	_ANIME_DATA	AC_VANISH_OFF,1
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*					CALL：ボール出る演出						*/
/************************************************************/
ball_out:
  _MOVE_BALL( SCR_BALL_ANM_TYPE_OUT, 18, 0, 36, 3, 8 )
  _START_BALL_ANM( SCR_BALL_ANM_TYPE_OUT, 18, 0, 36 )
  //ボール出現フレーム待ち
  _WAIT_BALL_POKE_APP( SCR_BALL_ANM_TYPE_OUT )
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()
  //ポケを表示
  _OBJ_ADD( N01R0502_NPOKE_01 )
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _WAIT_BALL_ANM( SCR_BALL_ANM_TYPE_OUT )
_RET
 
/************************************************************/
/*					話しかけ：Ｎ戦闘確認						*/
/************************************************************/
EVENT_START	ev_n01r0502_boss_02
  
  _TALK_OBJ_START()
  
  //ゼクロム・レシラム戦後
  IF $WK_SCENE_N01R0502_BOSS == 3 && FLAG_ON( FE_D08R0901_BOSS_TALK ) THEN
    
    //再戦闘
    _CALL ev_n02r0502_boss_retry
  
  //ゼクロム・レシラム戦前
  ELSIF $WK_SCENE_N01R0502_BOSS == 3 && FLAG_OFF( FE_D08R0901_BOSS_TALK ) THEN
      
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_n01r0502_boss_18 )
      
  //ダークストーン・ライトストーン入手イベント
  ELSE
    
    //N曲再生
    _START_EVENT_BGM( SEQ_BGM_E_N_SWAN )
    
    //CALL：戦闘前会話処理へジャンプ
    _CALL ev_n02r0502_boss_stone
  ENDIF

EVENT_END

/************************************************************/
/*					話しかけ：レシラム・ゼクロム						*/
/************************************************************/
EVENT_START	ev_n01r0502_npoke_01

  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //ブラック：バリバリダー！
  IF $LCWK_VERSION == VERSION_B2 THEN
    _VOICE_PLAY( MONSNO_651, 0 )
    _GIZAPLAINWIN_MSG_POS( msg_n01r0502_mu_01, POS_DOWN )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
  //ホワイト：モエルーワ！
  ELSE
    _VOICE_PLAY( MONSNO_650, 0 )
    _GIZAPLAINWIN_MSG_POS( msg_n01r0502_shin_01, POS_DOWN )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
  ENDIF
  
EVENT_END

/************************************************************/
/*					CALL：vs N（ストーン入手版）						*/
/************************************************************/
ev_n02r0502_boss_stone:
  
  //Ｎ：その準備は
  _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_07, N01R0502_BOSS_01, POS_DEFAULT )
  
  _YES_NO_WIN( SCWK_ANSWER )
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    //みせてほしい！
    _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_08, N01R0502_BOSS_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    // ROMバージョン取得
    _GET_ROM_VERSION( LCWK_VERSION )
    
    //ブラック：バババリッシュ！
    IF $LCWK_VERSION == VERSION_B2 THEN
      _VOICE_PLAY( MONSNO_651, 0 )
      _GIZAPLAINWIN_MSG_POS( msg_n01r0502_mu_02, POS_UP )
      _VOICE_WAIT()
      _AB_KEYWAIT_MARK()
      _GIZAPLAINWIN_CLOSE()
      //トレーナー戦
      _TRAINER_BTL_SET( TRID_BOSS_01, 0 )
    //ホワイト：ンバーニガガ！
    ELSE
      _VOICE_PLAY( MONSNO_650, 0 )
      _GIZAPLAINWIN_MSG_POS( msg_n01r0502_shin_02, POS_UP )
      _VOICE_WAIT()
      _AB_KEYWAIT_MARK()
      _GIZAPLAINWIN_CLOSE()
      //トレーナー戦
      _TRAINER_BTL_SET( TRID_BOSS_02, 0 )
    ENDIF
    
    //結果チェック
    _CALL ev_battle_check
    
    //CALL：戦闘後処理
    _CALL ev_n02r0502_boss_vs_end
    
  //いいえ
  ELSE
    
    //いつまでも　待つ！
    _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_09, N01R0502_BOSS_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
     //初回会話時にいいえの場合カメラを戻す
    IF $LOCALWORK15 == 99 THEN
    
      //自機にカメラを戻す
      _CAMERA_DEF_MOVE (24)
      //カメラ待ち
      _CAMERA_WAIT_MOVE()
      _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
      _CAMERA_END()		//カメラ操作終了
      //==================================//
      $LOCALWORK15 = 0
      //==================================//
    
    ENDIF
    
    //イベント曲停止
    _END_EVENT_BGM()
  ENDIF
  

_RET

/************************************************************/
/*					CALL：vs N						*/
/************************************************************/
ev_n02r0502_boss_vs_end:
  
  _PLAYER_NAME( 0 )
  
  //Ｎ：ボクと
  _BALLOONWIN_OBJMSG_WB( msg_n01r0502_boss_10w , msg_n01r0502_boss_10b , N01R0502_BOSS_01 , POS_UL)
  
  //性別取得
  _GET_MY_SEX( LCWK_SEX )
  
  //Ｎ：キミと
  _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_11, N01R0502_BOSS_01, POS_UL )
  _MSGWIN_CLOSE()
  
  //アニメ：Nレシゼクの方を見る
  _OBJ_ANIME( N01R0502_BOSS_01,anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //男性
  IF $LCWK_SEX == PM_MALE THEN
    _BALLOONWIN_OBJMSG_WB( msg_n01r0502_boss_12w , msg_n01r0502_boss_12b , N01R0502_BOSS_01 , POS_UL)
  //女性
  ELSE
    _BALLOONWIN_OBJMSG_WB( msg_n01r0502_boss_13w , msg_n01r0502_boss_13b , N01R0502_BOSS_01 , POS_UL)
  ENDIF
  
  _MSGWIN_CLOSE()
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //ブラック
  IF $LCWK_VERSION == VERSION_B2 THEN
    _VOICE_PLAY( MONSNO_651, 0 )
    _BALLOONWIN_OBJMSG_POS(msg_n01r0502_mu_03,N01R0502_NPOKE_01 , POS_UR )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  ELSE
    _VOICE_PLAY( MONSNO_650, 0 )
    _BALLOONWIN_OBJMSG_POS(msg_n01r0502_shin_03,N01R0502_NPOKE_01 , POS_UR )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
  ENDIF
  
  //アニメ：N顔をふる
  _OBJ_ANIME( N01R0502_BOSS_01,anm_boss_act1 )
  _OBJ_ANIME_WAIT()
  
  //Ｎ：ボクだってさみしい
  _BALLOONWIN_OBJMSG_WB( msg_n01r0502_boss_14w , msg_n01r0502_boss_14b , N01R0502_BOSS_01 , POS_UL)
  
  //Ｎ：だから…オヤスミ
  _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_15, N01R0502_BOSS_01, POS_UL )
  _MSGWIN_CLOSE()
  
  //ホワイトアウト
  _WHITE_OUT_SLOW()
  _DISP_FADE_END_CHECK()
  
  //動作モデル削除
  _OBJ_DEL( N01R0502_NPOKE_01 )
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //BlackVERならゼクロム
  IF $LCWK_VERSION == VERSION_B2 THEN
    _OBJ_ADD_EX( 18, 36, DIR_DOWN, MMDL_ID_EVENTOBJ_00, BLACKSTONE, MV_DMY )
  //Whiteならレシラム
  ELSE
    _OBJ_ADD_EX( 18, 36, DIR_DOWN, MMDL_ID_EVENTOBJ_00, WHITESTONE, MV_DMY )
  ENDIF
  
  //ホワイトイン
  _WHITE_IN_SLOW()
  _DISP_FADE_END_CHECK()
  
  _TIME_WAIT( 8 )
  
  //アニメ：Nストーンに向かう
  _OBJ_ANIME( N01R0502_BOSS_01,anm_walk_r )
  _OBJ_ANIME_WAIT()
  
  _TIME_WAIT( 16 )
  
  //動作モデル削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  _TIME_WAIT( 8 )
  
  //アニメ：N主人公と向き合う
  _OBJ_ANIME( N01R0502_BOSS_01,anm_boss_ret_stone )
  _OBJ_ANIME_WAIT()
  
  //Ｎ：このストーンを託す！
  _BALLOONWIN_OBJMSG_WB( msg_n01r0502_boss_16w , msg_n01r0502_boss_16b , N01R0502_BOSS_01 , POS_UL)
  _MSGWIN_CLOSE()
  
  //どうぐ入手処理
  //ブラック
  IF $LCWK_VERSION == VERSION_B2 THEN
    _ITEM_EVENT_KEYWAIT(ITEM_DAAKUSUTOON, 1)
  ELSE
    _ITEM_EVENT_KEYWAIT(ITEM_RAITOSUTOON, 1)
  ENDIF
  
  //Ｎ：そのストーンを持って
  _BALLOONWIN_OBJMSG_WB( msg_n01r0502_boss_17w , msg_n01r0502_boss_17b , N01R0502_BOSS_01 , POS_UL)
  _MSGWIN_CLOSE()
  
  //イベント曲停止
	_END_EVENT_BGM()
  
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (24)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //==================================//
  //n01r0502 全てのイベント終了
  $WK_SCENE_N01R0502_BOSS = 3
  //n01r0502 レシラム・ゼクロム非表示
  _FLAG_SET( FV_N01R0502_NPOKE_01 )
  //d08r0901 POS有効
  $WK_SCENE_D08R0901_LEGEND = 1
  //d08r0101 POS有効
  $WK_SCENE_D08R0101 = 1
  //==================================//
  
_RET

/************************************************************/
/*					CALL：vs N（再戦版）						*/
/************************************************************/
ev_n02r0502_boss_retry:
  
  //季節が変わって初回会話
  IF FLAG_OFF( FE_N01R0502_N_RETRY_TALK ) THEN
    //Ｎ：……おどろいた
    _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_01_01, N01R0502_BOSS_01, POS_DEFAULT )
  
  //再会話
  ELSE
    //Ｎ：キミのポケモンが
    _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_01_06, N01R0502_BOSS_01, POS_DEFAULT )
  ENDIF
  
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    
    //ウン…！！
    _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_01_02, N01R0502_BOSS_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    {
    
    //季節取得
    DEFINE_LOCAL  LCWK_SEASON
    _GET_SEASON_ID( LCWK_SEASON )
    
    //季節でトレーナーデータ分岐
    IF $LCWK_SEASON == PMSEASON_SPRING THEN
      _TRAINER_BTL_SET( TRID_BOSS_03, 0 )
    ELSIF $LCWK_SEASON == PMSEASON_SUMMER THEN
      _TRAINER_BTL_SET( TRID_BOSS_04, 0 )
    ELSIF $LCWK_SEASON == PMSEASON_AUTUMN THEN
      _TRAINER_BTL_SET( TRID_BOSS_05, 0 )
    ELSIF $LCWK_SEASON == PMSEASON_WINTER THEN
      _TRAINER_BTL_SET( TRID_BOSS_06, 0 )
    ENDIF
    
    //結果チェック
    _CALL ev_battle_check
    
    //Ｎ：…はなしてくれたこと　おもいだした
    _BALLOONWIN_OBJMSG_WB( msg_n01r0502_boss_01_03w ,  msg_n01r0502_boss_01_03b , N01R0502_BOSS_01 , POS_DEFAULT)
    _MSGWIN_CLOSE()
    
    //Ｎ：ボクはまた
    _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_01_04, N01R0502_BOSS_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    _OBJ_ANIME_AUTO( N01R0502_BOSS_01,17,44, FORCE_TYPE_NPC, 8, DIR_LR )
    _TIME_WAIT( 24 )
    _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_d )
    _OBJ_ANIME_WAIT()
    
    //N動作モデル削除
    _OBJ_DEL( N01R0502_BOSS_01 )
    
    _GET_DATE( LCWK_SEASON, LOCALWORK15 )
    
    //==================================//
    //戦闘した月を格納
    $WK_OTHER_N01R0502_N_SEASON = $LCWK_SEASON
    //n01r0502 N非表示
    _FLAG_SET( FV_N01R0502_BOSS_01 )
    //再会話フラグリセット
    _FLAG_RESET( FE_N01R0502_N_RETRY_TALK )
    //日にちを取得したワークを初期化
    $LOCALWORK15 = 0
    //==================================//
    }
  
  //いいえ
  ELSE
    //いつまでも　待つ！
    _BALLOONWIN_OBJMSG_POS( msg_n01r0502_boss_01_05, N01R0502_BOSS_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //==================================//
    //再会話フラグ
    _FLAG_SET( FE_N01R0502_N_RETRY_TALK )
    //==================================//
  ENDIF
  
_RET

/************************************************************/
/*					CALL：戦闘チェック						*/
/************************************************************/
ev_battle_check:	
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    
    //Nとの初戦時なら上下で向き合う
    IF $WK_SCENE_N01R0502_BOSS == 2 THEN
      _OBJ_POS_CHANGE(MMDL_ID_PLAYER,16,0,38,DIR_UP)
      
      _CAMERA_START()		//カメラ操作開始
      _CAMERA_PURGE()		//カメラのバインドを解く
      //カメラ操作　N中心に
      _CAMERA_MOVE( 9688,0,970752,1081344,0,2371584,1 )
      _CAMERA_WAIT_MOVE()	//カメラ移動待ち
    ENDIF
    
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

