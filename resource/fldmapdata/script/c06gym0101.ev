
//======================================================================
//                c06gym0101.ev
//
//    スクリプトファイル：c06gym0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c06gym0101.h"
  .include  "c06gym0101.h"


//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   c06gym0101_leader6_01
_EVENT_DATA   ev_zone_c06gym0101
_EVENT_DATA   ev_init_c06gym0101
_EVENT_DATA   ev_pos_c06gym0101_guide
_EVENT_DATA   ev_c06gym0101_danpei_01
_EVENT_DATA   ev_bg_c06gym0101_statue
_EVENT_DATA_END


/************************************************************/
/*					ジムギミック初期化						*/
/*          ZONE_CHANGE_LABEL             */
/************************************************************/
INIT_EVENT_START  ev_zone_c06gym0101

INIT_EVENT_END

/************************************************************/
/*					ジムギミック初期化						*/
/*          ZONE_CHANGE_LABEL             */
/************************************************************/
INIT_EVENT_START  ev_init_c06gym0101

  // ガイドの吹き飛ばしイベントをしていない場合
  // 位置を変える
  IF $WK_SCENE_C06GYM0101_GUIDE == 0 THEN
    _OBJ_POS_CHANGE( C06GYM0101_DANPEI_01, 11, 0, 37, DIR_DOWN )
  ELSE
    // 全員初期位置
  ENDIF

INIT_EVENT_END

/************************************************************/
/*			ジムリーダー戦のスクリプトイベント				*/
/************************************************************/
EVENT_START	c06gym0101_leader6_01

	_TALK_OBJ_START()
	//バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_06 )

	//ジムバッジフラグで分岐
	IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前なら、ジムリーダー戦イベント
		_CALL		ev_leader6_btl

	ELSE

		//ゲームクリア前なら
		IF FLAG_OFF( SYS_FLAG_GAME_CLEAR )  THEN
		
			//つぎの　ジムがある　セッカシティは
			_BALLOONWIN_OBJMSG( msg_c06gym0101_leader_06 , C06GYM0101_LEADER6_01 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
			
		//ゲームクリア後なら
		ELSE
		
			//フウロ『ポケモンも　アナタも
			_BALLOONWIN_OBJMSG( msg_c06gym0101_leader_07 , C06GYM0101_LEADER6_01 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
		
		ENDIF

	ENDIF
	
EVENT_END

//ジムリーダー戦
ev_leader6_btl:

	//フウロが喋る　
	//フウロ:ウフフ
	_BALLOONWIN_TALKOBJ_MSG( msg_c06gym0101_leader_01 )
	_BALLOONWIN_CLOSE()

	//トレーナー戦呼び出し
	_TRAINER_BTL_SET( TRID_SWLEADER6_01, 0 )
	
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
			_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF
		
	//リーダー：戦闘後メッセージ→続けてバッジ入手へ
	//フウロが喋る　
	//フウロ:アナタって　すごい
	_BALLOONWIN_TALKOBJ_MSG( msg_c06gym0101_leader_02 )
	_BALLOONWIN_CLOSE()

  //リーダー戦勝利時の情報登録
  _SET_GYM_VICTORY_INFO( BADGE_ID_06 )
	//バッジ入手処理
	_SET_BADGE_FLAG( BADGE_ID_06 )		//バッジフラグon
	_PLAYER_NAME( 0 )
	
	{
	
	//バッジ入手演出再生
	_ME_PLAY( SEQ_ME_BADGE )
	
	//性別が格納されるローカル変数を定義
	DEFINE_LOCAL SCWK_SEX
	_GET_MY_SEX(SCWK_SEX)
	
	//男性だった場合
	IF $SCWK_SEX == PM_MALE THEN
		_CALL_FLD3D_CUTIN( FLDCIID_GYM06 )
	//女性だった場合
	ELSE
		_CALL_FLD3D_CUTIN( FLDCIID_GYM06F )
	ENDIF
	
	//ME待ち
	_ME_WAIT()
		
	}
	
	//～～はジェットバッジを入手した！
	_SYSWIN_MSG( msg_c06gym0101_leader_03 , POS_DEFAULT )
	_SYSWIN_CLOSE()

	//うわあ　すごいわね！
	_BALLOONWIN_TALKOBJ_MSG( msg_c06gym0101_leader_04)
	_BALLOONWIN_CLOSE()

	//わざマシン入手処理　「アクロバット」
	_ITEM_EVENT_KEYWAIT( ITEM_WAZAMASIN62, 1 )

	//リーダー：わざマシンの解説
	_BALLOONWIN_TALKOBJ_MSG( msg_c06gym0101_leader_05 )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()
	
	//================================================//
	
	//ジムトレーナーの視線無効
	_TRAINER_FLAG_SET( TRID_PILOT_04 )
	_TRAINER_FLAG_SET( TRID_PILOT_05 )
	_TRAINER_FLAG_SET( TRID_PILOT_06 )
	_TRAINER_FLAG_SET( TRID_PILOT_07 )
	_TRAINER_FLAG_SET( TRID_PILOT_08 )
			
	//================================================//

	//電光掲示板フラグセット
	_FLAG_SET( SYS_FLAG_ELBOARD_C06GYMWIN )

	//================================================//
_RET

/************************************************************/
/*				ガイドのPOS吹き飛ばしイベント				*/
/************************************************************/
EVENT_START   ev_pos_c06gym0101_guide
{
  
  // POSイベント起動
  IF $WK_SCENE_C06GYM0101_GUIDE == 0 THEN

    // ガイドのX座標を自機に合わせる
    {
      DEFINE_LOCAL	LWK_HERO_X
      DEFINE_LOCAL	LWK_HERO_Z

      //自機の位置取得
      _PLAYER_POS_GET( LWK_HERO_X,LWK_HERO_Z )
      // ガイドのX座標変更
      // 左向きなのは、回転後に見た目がいいから
      _OBJ_POS_CHANGE( C06GYM0101_DANPEI_01, LWK_HERO_X, 0, 37, DIR_LEFT )
    }

    // !アイコン表示
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_tr_gyoe )
		_OBJ_ANIME_WAIT()

    // 吹き飛ばしイベント
    _GYM_FLY_BLOW( C06GYM0101_DANPEI_01 )
    _TIME_WAIT(30)
    // 1歩進む
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_tr_up )
		_OBJ_ANIME_WAIT()

		//アイテム入手フラグで分岐
		IF FLAG_OFF( FE_C06GYM_ITEM ) THEN
      // おいしいみず入手イベント
      _BALLOONWIN_OBJMSG( msg_c06gym0101_glasses_01, C06GYM0101_DANPEI_01 )
      _BALLOONWIN_CLOSE()
      _ITEM_EVENT_KEYWAIT( ITEM_OISIIMIZU, 1 )

      _FLAG_SET( FE_C06GYM_ITEM )			//アイテム入手フラグをセット
		ENDIF

    // 元の位置に戻る
    _OBJ_ANIME_AUTO( C06GYM0101_DANPEI_01, 12, 46, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME( C06GYM0101_DANPEI_01, anm_dir_l )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 11, 46, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
    _OBJ_ANIME_WAIT()

    // カメラ操作とメッセージ
    _CALL move_camera_start
    _PLAINWIN_MSG_DOWN( msg_c06gym0101_glasses_02a )
    _MSGWIN_CLOSE()
    _CALL move_camera_end

    //=====================================
    //このPOSの起動をさせなくする
		$WK_SCENE_C06GYM0101_GUIDE = 1
    //=====================================
  ENDIF

}
EVENT_END

//--------------------------------------------------------------
//	トレーナー[!]マーク
//--------------------------------------------------------------
_ANIME_LABEL	anm_tr_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	1歩進む
//--------------------------------------------------------------
_ANIME_LABEL	anm_tr_up
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	左向く
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	右向く
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*				カメラ操作				*/
/************************************************************/
move_camera_start:
{
  _CAMERA_START()       // カメラ操作開始
  _CAMERA_PURGE()		    // カメラのバインドを解く

  _CAMERA_MOVE( 4056,0,970752,753664,0,1323008,90 )
}
_RET

move_camera_end:
{
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _CAMERA_DEF_MOVE( 60 )
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _CAMERA_BIND()        // カメラバインド
  _CAMERA_END()         // カメラ操作終了
}
_RET

/************************************************************/
/*				サングラスのスクリプトイベント				*/
/************************************************************/
EVENT_START	ev_c06gym0101_danpei_01

		_TALK_OBJ_START()
		
		//バッジフラグ取得
		_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_06 )

		//バッジフラグで分岐
		IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前の処理
			
			//メッセージのみ
			_BALLOONWIN_TALKOBJ_MSG( msg_c06gym0101_glasses_02 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()

		ELSE
			//バッジ入手後の処理

			//わざと　ふきとばされるのも
			_BALLOONWIN_TALKOBJ_MSG( msg_c06gym0101_glasses_03 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()

		ENDIF

EVENT_END

/**************************************************************/
/*     			像		      					              */
/**************************************************************/
EVENT_START	ev_bg_c06gym0101_statue

	_TALK_START_SE_PLAY()
	
	DEFINE_LOCAL	LWK_BADGE
	
	//ジムバッジを持っているのかを判定
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_06 )
	
	//ジムバッジを取得していない場合
	IF $SCWK_TEMP0 == 0 THEN
		_PLAYER_NAME( 0 )
		_PLAINWIN_MSG_DOWN( msg_c06gym0101_statue_01 )
	
	//ジムバッジを取得している場合【仮】
	ELSE
	
		//ジムバッジを持っているのかを判定【仮】
		_GET_BADGE_FLAG( LWK_BADGE, BADGE_ID_07 )
		
		//D07でライバルと戦っている場合【仮】
		IF $WK_SCENE_D07_RIVAL_01 == 2 THEN
		
			_PLAYER_NAME( 0 )
			_PLAINWIN_MSG_DOWN( msg_c06gym0101_statue_03 )
			
		//まだ戦っていない場合【仮】
		ELSE
		
			_PLAYER_NAME( 0 )
			_PLAINWIN_MSG_DOWN( msg_c06gym0101_statue_02 )
		
		ENDIF
		
	ENDIF
	
	_LAST_KEYWAIT()	
	_PLAINWIN_CLOSE()

EVENT_END

