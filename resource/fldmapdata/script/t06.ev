//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_t06
_EVENT_DATA    ev_init_t06
_EVENT_DATA    ev_pos_t06_champion_guide_01
_EVENT_DATA    ev_pos_t06_champion_guide_02
_EVENT_DATA    ev_pos_t06_champion_guide_03
_EVENT_DATA    ev_pos_t06_champion_guide_04_01
_EVENT_DATA    ev_pos_t06_champion_guide_04_02
_EVENT_DATA    ev_t06_champion_01
_EVENT_DATA    ev_t06_boy1_01
_EVENT_DATA    ev_t06_girl1_01
_EVENT_DATA    ev_t06_oldman1_01
_EVENT_DATA    ev_t06_middleman1_01
_EVENT_DATA    ev_bg_t06_board_01
_EVENT_DATA    ev_t06_woman2_01
_EVENT_DATA    ev_bg_t06_board_02
_EVENT_DATA    ev_t06_boy1_02
_EVENT_DATA_END

//ドア変数定義
DEFINE_LOCAL	DOOR_ANIME_ID

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*  ZONE_CHANGE                                             */
/************************************************************/
INIT_EVENT_START   ev_zone_t06

  //イベント進行でアデクの配置を分岐
  IF $WK_SCENE_T06 == 1 THEN
    _SXY_MOVE_NPC_POS( T06_CHAMPION_01, DIR_DOWN , 113, 2, 669 )
  ELSIF $WK_SCENE_T06 == 2 || $WK_SCENE_T06 == 3 THEN
    _SXY_MOVE_NPC_POS( T06_CHAMPION_01, DIR_RIGHT , 111, 2, 669 )
  ENDIF
  
INIT_EVENT_END


/************************************************************/
/*  FIELD_INIT_SCRIPT                                       */
/************************************************************/
INIT_EVENT_START   ev_init_t06
//
INIT_EVENT_END


/**************************************************************/
/* POS：アデクのガイド                                        */
/**************************************************************/
EVENT_START   ev_pos_t06_champion_guide_01

  //アニメ：アデク「！」
  _OBJ_ANIME( T06_CHAMPION_01, anm_champion_guide01 )
  _OBJ_ANIME_WAIT()
  
  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //アニメ：アデク、プレイヤーの正面に移動
  IF $LCW_POSZ != 695 THEN
    _OBJ_ANIME_AUTO( T06_CHAMPION_01, 110, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( T06_CHAMPION_01, anm_staystep_l )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //メッセージ：そうだ！
  _PLAYER_NAME( 0 )   //プレイヤー名を反映
  _BALLOONWIN_OBJMSG_POS( msg_t06_champion_01,T06_CHAMPION_01, POS_DEFAULT )
  _BALLOONWIN_OBJMSG_POS( msg_t06_champion_02,T06_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アデク退場
  _OBJ_ANIME( T06_CHAMPION_01, anm_champion_guide01_bye )
  _OBJ_ANIME_WAIT()

  //アデク寺小屋方面にワープ
  _OBJ_POS_CHANGE( T06_CHAMPION_01, 113, 2, 669, DIR_DOWN )

  //========================================//
  //T06階段方面のPOSを有効
  $WK_SCENE_T06 = 1
  //========================================//

EVENT_END


//--------------------------------------------------------------------
//アデク：「！」振り向く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_champion_guide01
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//アデク：寺小屋方面に移動
//--------------------------------------------------------------------
_ANIME_LABEL  anm_champion_guide01_bye
  _ANIME_DATA AC_WALK_R_8F,3
  _ANIME_DATA AC_WALK_U_8F,11
  _ANIME_DATA ACMD_END,0

/**************************************************************/
/* POS：アデクのガイド                                        */
/**************************************************************/
EVENT_START   ev_pos_t06_champion_guide_02

  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
   //アニメ：アテグ主人公に隣接
   IF $LCW_POSX != 113 THEN
   $LCW_POSZ -= 1
  _OBJ_ANIME_AUTO( T06_CHAMPION_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( T06_CHAMPION_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  ENDIF
  
  //メッセージ：こっちだ！
  _BALLOONWIN_OBJMSG_POS( msg_t06_champion_03,T06_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アテグ「？」
  _OBJ_ANIME( T06_CHAMPION_01, anm_common_hatena )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：ところで
  _BALLOONWIN_OBJMSG_POS( msg_t06_champion_04,T06_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アテグ「！」
  _OBJ_ANIME( T06_CHAMPION_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：なるほど
  _BALLOONWIN_OBJMSG_POS( msg_t06_champion_05,T06_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //ライバル入手ポケモンの種族名をセット
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    _MONS_NAME( 0, MONSNO_557 )
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    _MONS_NAME( 0, MONSNO_554 )
  ELSE
    _MONS_NAME( 0, MONSNO_551 )
  ENDIF
  
  //メッセージ：おまえさんのともだちが
  _BALLOONWIN_OBJMSG_POS( msg_t06_champion_06,T06_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //カメラ操作　アデク追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,7438336,131103,43667456,40 )
  
  //アニメ：上に移動
  _OBJ_ANIME( T06_CHAMPION_01, anm_champion_look_r20 )
  _OBJ_ANIME_WAIT()
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //メッセージ：20ばんどうろなら
  _BALLOONWIN_OBJMSG_POS( msg_t06_champion_07,T06_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (40)
  
  //アニメ：もとの位置に戻る
  _OBJ_ANIME_AUTO( T06_CHAMPION_01, 111, 669, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //アニメ：右を見る
  _OBJ_ANIME( T06_CHAMPION_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //========================================//
  //寺子屋方面のストッパーPOSを有効
  $WK_SCENE_T06 = 2
  //========================================//
EVENT_END


//--------------------------------------------------------------------
//アデク：20ばんどうろを見る
//--------------------------------------------------------------------
_ANIME_LABEL  anm_champion_look_r20
  _ANIME_DATA AC_WALK_U_8F,2
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

/**************************************************************/
/* POS：アデクのガイド（ストッパー）                          */
/**************************************************************/
EVENT_START   ev_pos_t06_champion_guide_03

  //アニメ：アテグ「！」
  _OBJ_ANIME( T06_CHAMPION_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )

  //アニメ：アデクと主人公向き合う
  IF $LCW_POSZ == 668 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    _OBJ_ANIME( T06_CHAMPION_01, anm_staystep_u )
  ELSIF $LCW_POSZ == 670 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME( T06_CHAMPION_01, anm_staystep_d )
  ENDIF
  
  _OBJ_ANIME_WAIT()
  
  //メッセージ：20ばんどうろなら
  _BALLOONWIN_OBJMSG_POS( msg_t06_champion_07,T06_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
   //アニメ：主人公1歩右へ
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( T06_CHAMPION_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
EVENT_END

/**************************************************************/
/* アデクのガイド上下共通処理                                 */
/**************************************************************/
champion_guide_04:
 
  //メッセージ：おう！ぶじに
  _BALLOONWIN_OBJMSG_POS( msg_t06_champion_09,T06_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アデク退場
  _OBJ_ANIME_AUTO( T06_CHAMPION_01, 107, 662, FORCE_TYPE_NPC, 8, DIR_LR)
  _TIME_WAIT( 16 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
    //ドア生成
  _BMODEL_ANIME_CREATE( DOOR_ANIME_ID, SCR_BMID_DOOR, 107, 661 )
  _BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_OPEN )
  _BMODEL_ANIME_WAIT( DOOR_ANIME_ID )

  //アニメ：ドアの中に入る
  _OBJ_ANIME( T06_CHAMPION_01, anm_walk_u )
  _OBJ_ANIME_WAIT()
  
  //アデクモデル非表示に
  _OBJ_DEL( T06_CHAMPION_01 )
  
  //ドア閉じる
	_BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_CLOSE )
	_BMODEL_ANIME_WAIT( DOOR_ANIME_ID )
	_BMODEL_ANIME_DELETE( DOOR_ANIME_ID )
  
  //========================================//
  //T06のPOSを無効
  $WK_SCENE_T06 = 4
  
  //T06アデクを非表示に
  _FLAG_SET( FV_T06_CHAMPION_01 )
  //========================================//
_RET

/**************************************************************/
/* POS：アデクのガイド（迷子ポケモン終了）                    */
/* 主人公が上から来た場合                                     */
/**************************************************************/
EVENT_START   ev_pos_t06_champion_guide_04_01

  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //アニメ：アデク主人公と向き合う
  _OBJ_ANIME_AUTO( T06_CHAMPION_01, LCW_POSX, 669, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( T06_CHAMPION_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  // 上下共通処理実行
  _CALL champion_guide_04
 
EVENT_END

/**************************************************************/
/* POS：アデクのガイド（迷子ポケモン終了）                    */
/* 主人公が下から来た場合                                     */
/**************************************************************/
EVENT_START   ev_pos_t06_champion_guide_04_02

  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //アニメ：アデク主人公と向き合う
  _OBJ_ANIME_AUTO( T06_CHAMPION_01, LCW_POSX, 668, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( T06_CHAMPION_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
 
  // 上下共通処理実行
  _CALL champion_guide_04
 
EVENT_END

//--------------------------------------------------------------------
//アデク：寺小屋方面に移動
//--------------------------------------------------------------------
_ANIME_LABEL  anm_champion_guide04_bye
  _ANIME_DATA AC_WALK_L_8F,6
  _ANIME_DATA AC_WALK_U_8F,7
  _ANIME_DATA ACMD_END,0

