//==============================================================
//サブルーチン：ご褒美イベント：開始
//==============================================================
sub_prize_come_player:
{
  //プレイヤーこさせる
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 8, 5, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
}
_RET

//==============================================================
//サブルーチン：ご褒美イベント：終了
//==============================================================
sub_prize_goout_owner:
{

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_makeaway )
  _OBJ_ANIME( C16R0101_OWNER, anm_owner_goout )
  _OBJ_ANIME( C16R0101_SECRETARY_01, anm_sec01_goout )
  _OBJ_ANIME( C16R0101_SECRETARY_02, anm_sec02_goout )
  _OBJ_ANIME_WAIT()

  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()

  _OBJ_DEL( C16R0101_OWNER )
  _OBJ_DEL( C16R0101_SECRETARY_01 )
  _OBJ_DEL( C16R0101_SECRETARY_02 )
}
_RET


//--------------------------------------------------------------------
//主人公：退く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_makeaway
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_DIR_L,1
  _ANIME_DATA AC_WAIT_8F, 1
	_ANIME_DATA	AC_DIR_D,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//オーナー：帰る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_owner_goout
	_ANIME_DATA	AC_WALK_D_8F,9
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//秘書１：帰る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_sec01_goout
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_D_8F,9
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//秘書２：帰る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_sec02_goout
  _ANIME_DATA AC_WAIT_8F, 1
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_D_8F,9
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0


//==============================================================
//サブルーチン：ご褒美イベント：秘書３出てくる
//==============================================================
sub_prize_sec03_come:
{
  _OBJ_ANIME( LWK_OBJID, anm_sec03_come )
  _OBJ_ANIME_WAIT()
}
_RET


//--------------------------------------------------------------------
//秘書３：でてくる
//--------------------------------------------------------------------
_ANIME_LABEL	anm_sec03_come
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
