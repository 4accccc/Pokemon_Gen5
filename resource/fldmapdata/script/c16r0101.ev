
//======================================================================
//                c16r0101.ev
//
//    スクリプトファイル：c16r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c16r0101.h"
  .include  "c16r0101.h"
  .include  "resort_scr_define.h"
  .include  "../../../prog/src/field/resonance_resort/resort_people_def.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_init_c16r0101
_EVENT_DATA    ev_c16r0101_infomation
_EVENT_DATA    ev_scene_c16r0101_prize
_EVENT_DATA_END

DEFINE_LOCAL LWK_RET
DEFINE_LOCAL LWK_MSGID
DEFINE_LOCAL LWK_OBJID
DEFINE_LOCAL LWK_INDEX

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c16r0101
{
  //ご褒美イベント以外は消す
  IF $WK_SCENE_C16R0101_PRIZE == 1 THEN
    _RESORT_GET_MY_DATA( RESORT_MY_PARAM_EV_PRIZE, LWK_RET )
    _DEBUG_PRINT_WK( LWK_RET )
    SWITCH $LWK_RET
    CASE RESORT_CITYPRIZE_TYPE_ADD_SECRETARY3 THEN
      _RESORT_SET_PRESET_PEOPLE( RESORT_PEOPLE_TYPE_SECRETARY, RESORT_PRESET_TYPE_SECRETARY_03 )
      _RESORT_ADD_PEOPLE( RESORT_ADD_PEOPLE_SECRETARY_03, LWK_OBJID )
      _OBJ_POS_CHANGE( LWK_OBJID, 6, 0, 4, DIR_DOWN )
    CASE RESORT_CITYPRIZE_TYPE_ADD_SECRETARY4 THEN
      _RESORT_SET_PRESET_PEOPLE( RESORT_PEOPLE_TYPE_SECRETARY, RESORT_PRESET_TYPE_SECRETARY_04 )
      _RESORT_ADD_PEOPLE( RESORT_ADD_PEOPLE_SECRETARY_04, LWK_OBJID )
      _OBJ_POS_CHANGE( LWK_OBJID, 6, 0, 4, DIR_DOWN )
    CASE RESORT_CITYPRIZE_TYPE_NONE THEN
      $WK_SCENE_C16R0101_PRIZE = 0
      _OBJ_DEL(C16R0101_OWNER)
      _OBJ_DEL(C16R0101_SECRETARY_01)
      _OBJ_DEL(C16R0101_SECRETARY_02)
    ENDSWITCH
  ELSE
    $WK_SCENE_C16R0101_PRIZE = 0
    _OBJ_DEL(C16R0101_OWNER)
    _OBJ_DEL(C16R0101_SECRETARY_01)
    _OBJ_DEL(C16R0101_SECRETARY_02)
  ENDIF
}
INIT_EVENT_END

/**************************************************************/
/*            説明する人                                       */
/**************************************************************/
EVENT_START ev_c16r0101_infomation
{
  DEFINE_LOCAL  LWK_MENU_LOOP
  DEFINE_LOCAL  LWK_MENU_RET

  _TALK_OBJ_START()

  $LWK_MENU_LOOP = TRUE
  WHILE $LWK_MENU_LOOP == TRUE

    _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
    _RESORT_SET_WORD( RESORT_WORD_FREE_CITY, RESORT_WORD_PARAM_NONE, 0, 1 )
    _BALLOONWIN_OBJMSG_POS( resort_drill_00, C16R0101_INFOMATION, POS_DEFAULT )

    _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_MENU_RET )
    _BMPMENU_MAKE_LIST( resort_drill_sel_01, SEQ_INFOMATION_Q00 )
    _BMPMENU_MAKE_LIST( resort_drill_sel_02, SEQ_INFOMATION_Q01 )
    _BMPMENU_MAKE_LIST( resort_drill_sel_03, SEQ_INFOMATION_Q02 )
    _BMPMENU_MAKE_LIST( resort_drill_sel_04, SEQ_INFOMATION_Q03 )
    _BMPMENU_MAKE_LIST( resort_drill_sel_05, SEQ_INFOMATION_Q04 )
    _BMPMENU_MAKE_LIST( resort_drill_sel_06, SEQ_INFOMATION_Q05 )
    _BMPMENU_MAKE_LIST( resort_drill_sel_07, SEQ_INFOMATION_Q06 )
    _BMPMENU_START()

    IF $LWK_MENU_RET == EV_WIN_B_CANCEL THEN
      $LWK_MENU_RET = SEQ_INFOMATION_Q06
    ENDIF

    SWITCH $LWK_MENU_RET
    CASE SEQ_INFOMATION_Q00 THEN
      _BALLOONWIN_OBJMSG_POS( resort_drill_sel_ans_01, C16R0101_INFOMATION, POS_DEFAULT )
    CASE SEQ_INFOMATION_Q01 THEN  
      _BALLOONWIN_OBJMSG_POS( resort_drill_sel_ans_02, C16R0101_INFOMATION, POS_DEFAULT )
    CASE SEQ_INFOMATION_Q02 THEN  
      _BALLOONWIN_OBJMSG_POS( resort_drill_sel_ans_03, C16R0101_INFOMATION, POS_DEFAULT )
    CASE SEQ_INFOMATION_Q03 THEN  
      _BALLOONWIN_OBJMSG_POS( resort_drill_sel_ans_04, C16R0101_INFOMATION, POS_DEFAULT )
    CASE SEQ_INFOMATION_Q04 THEN  
      _BALLOONWIN_OBJMSG_POS( resort_drill_sel_ans_05, C16R0101_INFOMATION, POS_DEFAULT )
    CASE SEQ_INFOMATION_Q05 THEN  
      _BALLOONWIN_OBJMSG_POS( resort_drill_sel_ans_06, C16R0101_INFOMATION, POS_DEFAULT )
    CASE SEQ_INFOMATION_Q06 THEN  
      _BALLOONWIN_OBJMSG_POS( resort_drill_sel_ans_07, C16R0101_INFOMATION, POS_DEFAULT )
      $LWK_MENU_LOOP = FALSE
    DEFAULT
      $LWK_MENU_LOOP = FALSE //念のため無限ループを避ける
    ENDSWITCH
  ENDWHILE
  _BALLOONWIN_CLOSE()
}
EVENT_END

/**************************************************************/
/*            ご褒美イベント                                  */
/**************************************************************/
EVENT_START ev_scene_c16r0101_prize
{
  _RESORT_GET_MY_DATA( RESORT_MY_PARAM_EV_PRIZE, LWK_RET )

  SWITCH $LWK_RET
  CASE RESORT_CITYPRIZE_TYPE_ADD_SECRETARY3 THEN
    _CALL sub_prize_add_sec03
  CASE RESORT_CITYPRIZE_TYPE_ADD_SECRETARY4 THEN
    _CALL sub_prize_add_sec04
  CASE RESORT_CITYPRIZE_TYPE_CHANGE_CITYNAME THEN
    _CALL sub_prize_cityname
  CASE RESORT_CITYPRIZE_TYPE_CHANGE_CITYNEON THEN
    _CALL sub_prize_neon
  CASE RESORT_CITYPRIZE_TYPE_SCOUT_SECRETARY THEN
    _CALL sub_prize_scout
  CASE RESORT_CITYPRIZE_TYPE_DENDOU THEN
    _CALL sub_prize_dendou
  ENDSWITCH

  //シーン終了
  //====================================
  $WK_SCENE_C16R0101_PRIZE  = 0
  //====================================
}
EVENT_END

//==============================================================
//サブルーチン：ご褒美イベント１：秘書３追加
//==============================================================
sub_prize_add_sec03:
{
  //プレイヤー近づく
  _CALL sub_prize_come_player


  //挨拶
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
  _BALLOONWIN_OBJMSG_POS( resort_prize_owner_greet_01, C16R0101_OWNER, POS_DEFAULT )

  //説明
  _BALLOONWIN_OBJMSG_POS( resort_prize_owner_info_01, C16R0101_OWNER, POS_DEFAULT )
  _BALLOONWIN_CLOSE()

  //OBJID取得
  _GET_OBJID( LWK_OBJID, LWK_RET, 6, 0, 4 )

  //秘書３出てくる
  _CALL sub_prize_sec03_come

  //秘書３話す
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_SECRETARY, 2, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_PEOPLE_TYPE_SECRETARY, 2, 1 )
  _BALLOONWIN_OBJMSG_POS( resort_prize_sec_01, LWK_OBJID, POS_DEFAULT )
  _BALLOONWIN_CLOSE()

  //退出
  _BALLOONWIN_OBJMSG_POS( resort_prize_owner_bye_01, C16R0101_OWNER, POS_DEFAULT )
  _BALLOONWIN_CLOSE()

  //フラグON
  _RESORT_SET_MY_DATA( RESORT_MY_PARAM_EV_PRIZE_END, RESORT_CITYPRIZE_TYPE_ADD_SECRETARY3 )

  //オーナー帰る
  _CALL sub_prize_goout_owner
}
_RET

//==============================================================
//サブルーチン：ご褒美イベント２：秘書４追加
//==============================================================
sub_prize_add_sec04:
{
  //プレイヤー近づく
  _CALL sub_prize_come_player

  //挨拶
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
  _BALLOONWIN_OBJMSG_POS( resort_prize_owner_greet_02, C16R0101_OWNER, POS_DEFAULT )

  //説明
  _BALLOONWIN_OBJMSG_POS( resort_prize_owner_info_02, C16R0101_OWNER, POS_DEFAULT )
  _BALLOONWIN_CLOSE()

  //OBJID取得
  _GET_OBJID( LWK_OBJID, LWK_RET, 6, 0, 4 )

  //秘書４出てくる
  _CALL sub_prize_sec03_come

  //秘書４話す
  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_SECRETARY, 3, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_PEOPLE_TYPE_SECRETARY, 3, 1 )
  _BALLOONWIN_OBJMSG_POS( resort_prize_sec_02, LWK_OBJID, POS_DEFAULT )
  _BALLOONWIN_CLOSE()

  //退出
  _BALLOONWIN_OBJMSG_POS( resort_prize_owner_bye_02, C16R0101_OWNER, POS_DEFAULT )
  _BALLOONWIN_CLOSE()

  //フラグON
  _RESORT_SET_MY_DATA( RESORT_MY_PARAM_EV_PRIZE_END, RESORT_CITYPRIZE_TYPE_ADD_SECRETARY4 )

  //オーナー帰る
  _CALL sub_prize_goout_owner

}
_RET

//==============================================================
//サブルーチン：ご褒美イベント３：街名変更
//==============================================================
sub_prize_cityname:
{
  //プレイヤー近づく
  _CALL sub_prize_come_player

  //挨拶
  _RESORT_SET_WORD( RESORT_WORD_FREE_NAME, RESORT_WORD_PARAM_NONE, 0, 0 )
  _BALLOONWIN_OBJMSG_POS( resort_prize_owner_greet_03, C16R0101_OWNER, POS_DEFAULT )

  //説明
  _BALLOONWIN_OBJMSG_POS( resort_prize_owner_info_03, C16R0101_OWNER, POS_DEFAULT )
  _BALLOONWIN_CLOSE()

  //性別で台詞が違う
  _GET_OBJID( LWK_OBJID, LWK_RET, 13, 0, 5 )
  _RESORT_GET_DATA( RESORT_GET_PARAM_CITYNAME_SEC_SEX, LWK_RET )
  _RESORT_GET_DATA( RESORT_GET_PARAM_CITYNAME_SEC_INDEX, LWK_INDEX )

  _RESORT_SET_WORD( RESORT_WORD_PEOPLE, RESORT_PEOPLE_TYPE_SECRETARY, LWK_INDEX, 0 )
  _RESORT_SET_WORD( RESORT_WORD_FREE_PHRASE, RESORT_PEOPLE_TYPE_SECRETARY, LWK_INDEX, 1 )
  IF $LWK_RET == 0 THEN
    _BALLOONWIN_OBJMSG_POS( resort_prize_sec_03_m, LWK_OBJID, POS_DEFAULT )
  ELSE
    _BALLOONWIN_OBJMSG_POS( resort_prize_sec_03_f, LWK_OBJID, POS_DEFAULT )
  ENDIF
  _BALLOONWIN_CLOSE()

  //退出
  _BALLOONWIN_OBJMSG_POS( resort_prize_owner_bye_03, C16R0101_OWNER, POS_DEFAULT )
  _BALLOONWIN_CLOSE()

  //フラグON
  _RESORT_SET_MY_DATA( RESORT_MY_PARAM_EV_PRIZE_END, RESORT_CITYPRIZE_TYPE_CHANGE_CITYNAME )

  //メダル
  _SET_MEDAL_ACHIVE( MDLID_RESORT_CLEAR )

  //オーナー帰る
  _CALL sub_prize_goout_owner
}
_RET

