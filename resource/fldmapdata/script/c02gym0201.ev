/************************************************************/
/*  ＢＧ：「社会」の本棚01                                  */
/************************************************************/
EVENT_START   ev_bg_c02gym0201_category_01_01

  _TALK_START_SE_PLAY()
  //ＢＧ：「しゃかい」の　ほんだな▼
  _PLAINWIN_MSG_DOWN( msg_c02gym0101_category_01 )

  //ＢＧ：「うつりかわる　イッシュ」
  _PLAINWIN_MSG_DOWN( msg_c02gym0101_headline_03 )
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい

    //ＢＧ：この２ねんで　さまがわりした
    _PLAINWIN_MSG_DOWN( msg_c02gym0101_book_03 )

  ELSE  //いいえ

  ENDIF
  _MSGWIN_CLOSE()

EVENT_END

