  .text

  .include  "scr_seq_def.h"
  .include  "msg_medal_ev.h"

  .include  "../../medal/data/mdlid_def.h"

//----------------------------------------------------------------------
//               スクリプトテーブル
//----------------------------------------------------------------------
_EVENT_DATA   ev_init_medal_oyaji
_EVENT_DATA   ev_recover_medal_oyaji
_EVENT_DATA   ev_medal_oyaji_intro
_EVENT_DATA   ev_medal_oyaji_pc
_EVENT_DATA   ev_medal_office
_EVENT_DATA_END


DEFINE_LOCAL  LWK_MEDAL_ID
DEFINE_LOCAL  LWK_MEDAL_RANK
DEFINE_LOCAL  LWK_MEDAL_COUNT
DEFINE_LOCAL  LWK_MEDAL_NEXT
DEFINE_LOCAL  LWK_OYAJI_ID

/********************************************************************/
/*						FIELD_INIT_LABEL                                      */
/********************************************************************/
INIT_EVENT_START   ev_init_medal_oyaji
  _CALL sub_medaloyaji_on_off
INIT_EVENT_END

/********************************************************************/
/*						FIELD_RECOVER_LABEL                                   */
/********************************************************************/
INIT_EVENT_START   ev_recover_medal_oyaji
  _CHECK_CONTINUE_RECOVER( SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    //「つづきから」の場合だけ呼び出す
    _CALL   sub_medaloyaji_on_off
  ENDIF
INIT_EVENT_END

/********************************************************************/
/*						メダルおやじの出現・引っ込み処理                      */
/********************************************************************/
sub_medaloyaji_on_off:
  //レコードなどを参照して、メダル情報をアップデートする
  _UPDATE_MEDAL_INFO( SCR_MEDALUPDATE_INFO )

  _CALL sub_medaloyaji_status
  IF $SCWK_ANSWER == 1 THEN
    //メダルおやじの表示
    _FLAG_RESET( FV_PC_MEDALOYAJI )
    _GET_MEDALOYAJI_OBJID( SCWK_ANSWER, LWK_OYAJI_ID )
    IF $SCWK_ANSWER == FALSE THEN
      _OBJ_ADD( LWK_OYAJI_ID )
    ENDIF
    _CALL sub_medaloyaji_move
  ELSE
    //メダルおやじの削除
    _GET_MEDALOYAJI_OBJID( SCWK_ANSWER, LWK_OYAJI_ID )
    IF $SCWK_ANSWER == TRUE THEN
      _OBJ_DEL( LWK_OYAJI_ID )
    ENDIF
    _FLAG_SET( FV_PC_MEDALOYAJI )
  ENDIF

  _RET


sub_medaloyaji_status:
  _ITEM_CHK( ITEM_MEDARUBOKKUSU, 1, SCWK_ANSWER )
  _DEBUG_PRINT_WK( SCWK_ANSWER )
  IF $SCWK_ANSWER == 0 THEN
    $SCWK_ANSWER = 0
    _RET
  ENDIF
  //タイトルメダルをもらえるか？
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_TITLE_ACHIEVE, LWK_MEDAL_COUNT  )
  IF $LWK_MEDAL_COUNT != 0 THEN
    $SCWK_ANSWER = 1
    _RET
  ENDIF
  //ヒントメダルをもらえるか？
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_HINT_ACHIEVE, LWK_MEDAL_COUNT  )
  IF $LWK_MEDAL_COUNT != 0 THEN
    $SCWK_ANSWER = 1
    _RET
  ENDIF
  //上のランクに達するだけのメダルを持っているか？（初回表彰前のみ発生）
  _CALL sub_medal_rankup_check
  _RET

sub_medaloyaji_move:
  /* 未実装 */
  _RET

/********************************************************************/
/*            メダル初回イベント                                    */
/********************************************************************/
EVENT_START ev_medal_oyaji_intro

  //メダルおやじ出現

  _TALK_OBJ_START()

  _CALL sub_medaloyaji_intro

  //メダルおやじ去る

  $WK_SCENE_MEDAL_EVENT = MEDALEV_SEQ_1ST_STAGE
EVENT_END

sub_medaloyaji_intro:
  //前口上
  _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_intro_01 )
  _BALLOONWIN_CLOSE()

  //メダルボックスをもらう
  _ITEM_EVENT_KEYWAIT( ITEM_MEDARUBOKKUSU, 1 )

  //知ってるか尋ねる（尋ねるだけ）
  _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_intro_02 )
  _YES_NO_WIN( SCWK_ANSWER )

  _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_intro_03 )
  _BALLOONWIN_CLOSE()
  //メダルをもらう
  $LWK_MEDAL_ID = MDLID_FIRST_MEDAL
  _CALL sub_medaloyaji_gettitle

  _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_intro_04 )
  _BALLOONWIN_CLOSE()
  
  //ヒントメダルをもらった！
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_HINT_ACHIEVE, LWK_MEDAL_COUNT  )
  _PLAYER_NAME( 0 )
  _NUMBER( 1 , LWK_MEDAL_COUNT , 3 )
  _SYSWIN_MSG( msg_mdloyj_hintget_sys, POS_DEFAULT )
  _SYSWIN_CLOSE()
  
  //ヒントメダルをもらう
  _UPDATE_MEDAL_INFO( SCR_MEDALUPDATE_INIT )
  //
  _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_intro_05 )
  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()
  _RET

/********************************************************************/
/*            メダルおやじ                                          */
/********************************************************************/
EVENT_START ev_medal_oyaji_pc
  _TALK_OBJ_START()

  SWITCH $WK_SCENE_MEDAL_EVENT
  CASE MEDALEV_SEQ_START THEN
    //ありえないはずだが、とりあえず
    _CALL sub_medaloyaji_intro
    $WK_SCENE_MEDAL_EVENT = MEDALEV_SEQ_1ST_STAGE

  CASE MEDALEV_SEQ_1ST_PRIZE_OK THEN
    //事務局で表彰式（最初）
    _PLACE_NAME( 0, ZONE_ID_C03 )  //とりあえず。不要になる予定
    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_end_03 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()

  CASE MEDALEV_SEQ_COMP_PRIZE_OK THEN
    //事務局で表彰式（コンプリート）
    _PLAYER_NAME( 0 )
    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_comp_01 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()

  CASE MEDALEV_SEQ_1ST_STAGE THEN
    //タイトルメダル獲得チェック
    _CALL sub_medaloyaji_title_check
    //ヒントメダル獲得チェック
    _CALL sub_medaloyaji_hint_check

    _GET_MEDAL_COUNT( SCR_MEDALCOUNT_TITLE_GET,LWK_MEDAL_COUNT  )
    _GET_MEDAL_COUNT( SCR_MEDALCOUNT_NEXT_RANK,LWK_MEDAL_NEXT  )
    IF $LWK_MEDAL_COUNT >= $LWK_MEDAL_NEXT THEN
      //現在のメダル数が次のランクまでに必要なメダル数以上ある場合最初の表彰！
      $WK_SCENE_MEDAL_EVENT = MEDALEV_SEQ_1ST_PRIZE_OK

      _PLAYER_NAME( 0 )
      _PLACE_NAME( 1, ZONE_ID_C03 )  //とりあえず。不要になる予定
      _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_goal_01 )
    ELSE
      _CALL sub_medaloyaji_goodbye
    ENDIF
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()

  CASE MEDALEV_SEQ_1ST_PRIZE_AFTER THEN
    //タイトルメダル獲得チェック
    _CALL sub_medaloyaji_title_check
    //ヒントメダル獲得チェック
    _CALL sub_medaloyaji_hint_check
    //ランクアップチェック
    _CALL sub_medaloyaji_rankup_check
    _CALL sub_medaloyaji_goodbye
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDSWITCH

EVENT_END


/********************************************************************/
//  サブルーチン：
/********************************************************************/
sub_goal_check1:
  _RET
/********************************************************************/
//  サブルーチン：
/********************************************************************/
sub_goal_check2:
  _RET
/********************************************************************/
//  サブルーチン：タイトルメダル取得
/********************************************************************/
sub_medaloyaji_title_check:
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_TITLE_ACHIEVE,SCWK_ANSWER  )
  IF $SCWK_ANSWER == 0 THEN
    //取得できるタイトルメダルがないので終了
    _RET
  ENDIF

  _PLAYER_NAME( 0 )
  _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_titleget_01 )
  _BALLOONWIN_CLOSE()
  _GET_LAST_ACHIEVE_MEDAL_ID( SCWK_ANSWER, LWK_MEDAL_ID )
  IF $SCWK_ANSWER == TRUE THEN
    //メダルをもらう
    _CALL sub_medaloyaji_gettitle
  ENDIF

  _GET_LAST_ACHIEVE_MEDAL_ID( SCWK_ANSWER, LWK_MEDAL_ID )
  WHILE $SCWK_ANSWER == TRUE
    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_titleget_02 )
    _BALLOONWIN_CLOSE()

    //メダルをもらう
    _CALL sub_medaloyaji_gettitle

    _GET_LAST_ACHIEVE_MEDAL_ID( SCWK_ANSWER, LWK_MEDAL_ID )
  ENDWHILE

  _RET

/********************************************************************/
//  サブルーチン：ヒントメダル取得
/********************************************************************/
sub_medaloyaji_hint_check:
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_HINT_ACHIEVE,SCWK_ANSWER  )
  IF $SCWK_ANSWER == 0 THEN
    //ヒントメダルが取得できない場合は戻る
    _RET
  ENDIF

  _PLAYER_NAME( 0 )
  _NUMBER( 1, SCWK_ANSWER, 3 )
  _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_hintget_01 )
  _BALLOONWIN_CLOSE()
  _SYSWIN_MSG( msg_mdloyj_hintget_sys, POS_DEFAULT )
  _SYSWIN_CLOSE()
  
  //ヒントメダルをもらった！
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_HINT_ACHIEVE, LWK_MEDAL_COUNT  )
  _PLAYER_NAME( 0 )
  _NUMBER( 1 , LWK_MEDAL_COUNT , 3 )
  _SYSWIN_MSG( msg_mdloyj_hintget_sys, POS_DEFAULT )
  _SYSWIN_CLOSE()
  
   //ヒントメダル取得処理
  _UPDATE_MEDAL_INFO( SCR_MEDALUPDATE_HINT )
  
  //まだ取得していないヒントがある？
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_HINT_REST, SCWK_ANSWER  )
  IF $SCWK_ANSWER != 0 THEN
    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_hintget_02 )
  ENDIF
  _RET

/********************************************************************/
//  サブルーチン：ランクアップ
/********************************************************************/
sub_medaloyaji_rankup_check:
  _CALL sub_medal_rankup_check
  IF $SCWK_ANSWER == 0 THEN
    //現在のメダル数が次のランクまでに必要なメダル数に足りていないので、何もしない
    _RET
  ENDIF

  _PLAYER_NAME( 0 )
  _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_rankup_01 )
  _BALLOONWIN_CLOSE()

  //_CALL sub_medal_rankup_check
  WHILE $SCWK_ANSWER == 1
    //ランクを上げる
    _UPDATE_MEDAL_INFO( SCR_MEDALUPDATE_RANK )
    _GET_MEDAL_COUNT( SCR_MEDALCOUNT_RANK,LWK_MEDAL_RANK  )
    _MEDAL_RANK_NAME( 1, LWK_MEDAL_RANK )
    _SYSWIN_MSG( msg_mdloyj_rankup_sys, POS_DEFAULT )
    _ME_PLAY(	SEQ_ME_KEYITEM )  //仮
    _ME_WAIT()
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()

    //ランクアップによって取得するメダルを変更する
    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_rankup_02 )
    _BALLOONWIN_CLOSE()
    SWITCH $LWK_MEDAL_RANK
    CASE SCR_MEDALRANK_COPPER  THEN
      $LWK_MEDAL_ID = MDLID_RANK_COPPER
    CASE SCR_MEDALRANK_SILVER  THEN
      $LWK_MEDAL_ID = MDLID_RANK_SILVER
    CASE SCR_MEDALRANK_GOLD  THEN
      $LWK_MEDAL_ID = MDLID_RANK_GOLD
    CASE SCR_MEDALRANK_BW  THEN
      $LWK_MEDAL_ID = MDLID_RANK_BW
    DEFAULT
      //万が一のために
      $LWK_MEDAL_ID = MDLID_GOAL  //仮
    ENDSWITCH
    _CALL sub_medaloyaji_gettitle

    //あがったランクでも必要なメダルを満たしているかチェック
    _CALL sub_medal_rankup_check
    IF $SCWK_ANSWER == 1 THEN
      //「さらにリニューアル！」
      _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_rankup_03 )
      _BALLOONWIN_CLOSE()
    ENDIF
  ENDWHILE

  _RET

/*------------------------------------------------------------------*/
//    サブルーチン：ランクアップするか？判定
/*------------------------------------------------------------------*/
sub_medal_rankup_check:
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_RANK, LWK_MEDAL_RANK )
  IF $LWK_MEDAL_RANK == SCR_MEDALRANK_BW THEN
    //最高ランクではもうランクアップできない
    $SCWK_ANSWER = 0
    _RET
  ENDIF
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_TITLE_GET, LWK_MEDAL_COUNT  )
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_NEXT_RANK, LWK_MEDAL_NEXT  )
  IF $LWK_MEDAL_COUNT >= $LWK_MEDAL_NEXT THEN
    $SCWK_ANSWER = 1
    _RET
  ENDIF
  $SCWK_ANSWER = 0
  _RET

/********************************************************************/
//  サブルーチン：オヤジ〆の台詞
/********************************************************************/
sub_medaloyaji_goodbye:
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_TITLE_REST, SCWK_ANSWER  )
  IF $SCWK_ANSWER <= 1 THEN
    //メダルを集めるだけ集めたので事務局へ誘導
    $WK_SCENE_MEDAL_EVENT = MEDALEV_SEQ_COMP_PRIZE_OK
    _PLAYER_NAME( 0 )
    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_comp_01 )
    _RET
  ENDIF
  //メダリストランク取得
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_RANK, LWK_MEDAL_RANK  )
  IF $LWK_MEDAL_RANK == SCR_MEDALRANK_BW THEN
    //ランクが最高の場合
    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_end_02 )
    _RET
  ENDIF
  //次のランクまでの獲得メダル数を取得
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_NEXT_RANK,LWK_MEDAL_NEXT  )
  _NUMBER( 0, LWK_MEDAL_NEXT, 3 )
  _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_end_01 )
  _RET



sub_medaloyaji_gettitle:
  //【仮】_CALL_FLD3D_CUTIN( ... )
  //SE再生
  _SE_PLAY(	SEQ_SE_FLD_56 ) 
  _SE_WAIT()
  _SE_PLAY(	SEQ_SE_SYS_89 ) 
  _SE_WAIT()
  
  //システムウィンドウ表示
  _GET_MEDAL( LWK_MEDAL_ID, TRUE )
  _PLAYER_NAME( 0 )
  _MEDAL_NAME( 1, LWK_MEDAL_ID )
  _SYSWIN_MSG( msg_mdloyj_titleget_sys, POS_DEFAULT )
  _SYSWIN_CLOSE()
  _RET

/********************************************************************/
//    メダル事務局（仮）
//    ※実際にはちゃんとイベントを作成するが現状は話しかけただけで遷移
/********************************************************************/
EVENT_START ev_medal_office
  _TALK_OBJ_START()

  SWITCH $WK_SCENE_MEDAL_EVENT
  CASE MEDALEV_SEQ_START  THEN
    _CALL sub_medaloyaji_intro
    $WK_SCENE_MEDAL_EVENT = MEDALEV_SEQ_1ST_STAGE

  CASE MEDALEV_SEQ_1ST_PRIZE_OK THEN

    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_prize_1st )
    _ME_PLAY(	SEQ_ME_KEYITEM )  //仮
    _ME_WAIT()
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()

    $WK_SCENE_MEDAL_EVENT = MEDALEV_SEQ_1ST_PRIZE_AFTER

  CASE MEDALEV_SEQ_COMP_PRIZE_OK THEN

    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_prize_max )
    _ME_PLAY(	SEQ_ME_KEYITEM )  //仮
    _ME_WAIT()
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()

    $WK_SCENE_MEDAL_EVENT = MEDALEV_SEQ_COMP_PRIZE_AFTER

  DEFAULT
    _BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_intro_05 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
  ENDSWITCH

EVENT_END





