//--------------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------------
_EVENT_DATA   ev_pair_trainer_set_call
_EVENT_DATA   ev_pair_trainer_free_call
_EVENT_DATA   ev_pos_d06r0101_pair
_EVENT_DATA   ev_pos_d06r0101_pair_return
_EVENT_DATA   ev_d06_pair
_EVENT_DATA   ev_c12_rival_pair_01
_EVENT_DATA_END //終了

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//====================================================================
/*
  フィールドトレーナー連れ歩き開始処理コモン
  @param  SCWK_PARAM0 連れ歩き対象にするOBJID
  @param  SCWK_PARAM1 ペアID 
  @param  SCWK_PARAM2 トレーナーID 
*/
//====================================================================
ev_pair_trainer_set_call:
{
  IF FLAG_ON( SYS_FLAG_PAIR ) THEN
    _CHG_LOCAL_SCR  //既に連れ歩きがいる場合スルー
  ENDIF

  _PAIR_TRAINER_PARAM_SET( SCWK_PARAM0, SCWK_PARAM1, SCWK_PARAM2, SCWK_PARAM3 )
  //ゾーン切替で消えないOBJに指定
	_OBJ_SET_NOT_DEL_ZONECHG( PAIR_TRAINER_01 )
  //動作コード変更
//  _MOVE_CODE_CHANGE( SCWK_PARAM0, MV_PAIR )
  //連れ歩きフラグセット
//  _FLAG_SET( SYS_FLAG_PAIR )

  _CHG_LOCAL_SCR                          //ローカルスクリプトに切り替え
}
_END

//====================================================================
/*
  フィールドトレーナー連れ歩き解放処理コモン
  @param  SCWK_PARAM0 連れ歩き対象に設定する新しい動作コード
*/
//====================================================================
ev_pair_trainer_free_call:
{
  IF FLAG_OFF( SYS_FLAG_PAIR ) THEN
    _CHG_LOCAL_SCR  //連れ歩きがいない場合スルー
  ENDIF

  //動作コード変更
//  _MOVE_CODE_CHANGE( PAIR_TRAINER_01, SCWK_PARAM0 )
  _PAIR_TRAINER_PARAM_FREE( SCWK_PARAM0 )
  //連れ歩きフラグリセット
//  _FLAG_RESET( SYS_FLAG_PAIR )

  _CHG_LOCAL_SCR                          //ローカルスクリプトに切り替え
}
_END


/*******************************************************************/
//====================================================================
/*
  以下　各連れ歩きイベント
*/
//====================================================================
/*******************************************************************/

//====================================================================
/*
  @brief  電気穴の洞窟連れ歩きテスト 
*/
//====================================================================
//連れ歩きスタート
EVENT_START ev_pos_d06r0101_pair
{
  DEFINE_LOCAL  i_x
  DEFINE_LOCAL  i_z

  _PLAYER_POS_GET( i_x, i_z )
  $i_x -= 1
  _OBJ_ANIME_AUTO( D06R0101_PAIR, i_x, i_z, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //一緒に行こう
  _BALLOONWIN_OBJMSG( msg_pair_pos_d06r0101_start01, D06R0101_PAIR )
  _MSGWIN_CLOSE()

  //連れ歩き開始
  _PAIR_TRAINER_SET( D06R0101_PAIR, PAIR_ID_NATURAL, PAIR_TYPE_OPEN, TRID_RIVAL_07 )
//  $WK_SYS_PAIR_ID = PAIR_ID_NATURAL 
  $WK_SCENE_D06_PAIR = 1
  _FLAG_SET( FV_D06R0101_PAIR )
}
EVENT_END

//連れ歩き出戻り
EVENT_START ev_pos_d06r0101_pair_return
{
  //連れ歩き解除
  _PAIR_TRAINER_FREE( MV_DMY )
  $WK_SCENE_D06_PAIR = 0
  _FLAG_RESET( FV_D06R0101_PAIR )
}
EVENT_END

//連れ歩き中話しかけスクリプト
EVENT_START ev_d06_pair
{
	_TALK_OBJ_START()
  _BALLOONWIN_OBJMSG( msg_pair_d06_01, PAIR_TRAINER_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
}
EVENT_END

//====================================================================
// C12：話しかけ 
//====================================================================

//連れ歩き中話しかけスクリプト
EVENT_START ev_c12_rival_pair_01

  //【仮】ライバル名代入
  _NUMBER( 1 , 12345 , 5 )

  //話しかけるごとに0～2のセリフを順番に表示
  
  IF $WK_OTHER_C12_RIVAL_PAIR == 3 THEN
    $WK_OTHER_C12_RIVAL_PAIR = 0
  ENDIF
  
  $SCWK_TEMP0 = msg_c12_swrival_05
  $SCWK_TEMP0 += $WK_OTHER_C12_RIVAL_PAIR
  
  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG( SCWK_TEMP0, PAIR_TRAINER_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  $WK_OTHER_C12_RIVAL_PAIR += 1
  _DEBUG_PRINT_WK( WK_OTHER_C12_RIVAL_PAIR )
  
EVENT_END


