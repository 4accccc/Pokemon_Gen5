_EVENT_DATA   ev_pair_trainer_set_call
_EVENT_DATA   ev_pair_trainer_free_call
_EVENT_DATA   ev_n01r0401_boss
_EVENT_DATA   ev_d24_swbell
_EVENT_DATA   ev_c12_swrival
_EVENT_DATA   ev_d11r0101_swrival_pair_01
_EVENT_DATA_END //終了

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/**************************************************************/
/*		話しかけ：C12のライバル
/**************************************************************/
EVENT_START		ev_c12_swrival
  _TALK_START_SE_PLAY()
  
   //主人公・チェレン名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  
  //話しかけるごとに0～2のセリフを順番に表示（2で終わり）
  $SCWK_TEMP0 = msg_c12_swrival_05
  $SCWK_TEMP0 += $WK_OTHER_C12_RIVAL_PAIR
  
  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG( SCWK_TEMP0, PAIR_TRAINER_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  IF $WK_OTHER_C12_RIVAL_PAIR != 2 THEN
    $WK_OTHER_C12_RIVAL_PAIR += 1
  ENDIF
 
  
EVENT_END

/**************************************************************/
/*		話しかけ：D11のライバル
/**************************************************************/
EVENT_START		ev_d11r0101_swrival_pair_01
  _TALK_START_SE_PLAY()
  
 //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )

  //話しかけるごとに0～4のセリフを順番に表示（4で終わり）
  $SCWK_TEMP0 = msg_d11r0101_swrival_05
  $SCWK_TEMP0 += $WK_OTHER_D11R0101_PAIR
  
  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG( SCWK_TEMP0, PAIR_TRAINER_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  IF $WK_OTHER_D11R0101_PAIR != 4 THEN
    $WK_OTHER_D11R0101_PAIR += 1
  ENDIF
  
EVENT_END



/**************************************************************/
/*		話しかけ：N城のN
/**************************************************************/
EVENT_START		ev_n01r0401_boss
{
  
  _GET_ZONE_ID( LOCALWORK15 )
  
  IF $LOCALWORK15 == ZONE_ID_N01R0401 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_n01r0401_boss_12 )
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_n01r0501_boss_05 )
  ENDIF
 
 }
  
EVENT_END

/**************************************************************/
/*		話しかけ：リバースマウンテンのベル
/**************************************************************/
EVENT_START		ev_d24_swbell
  _TALK_START_SE_PLAY()
  
   //主人公名代入
  _PLAYER_NAME( 0 )
  
  //話しかけるごとに0～4のセリフを順番に表示（4で終わり）
  $SCWK_TEMP0 = msg_d24r0301_swbell_07
  $SCWK_TEMP0 += $WK_OTHER_D24_PAIR
  
  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG( SCWK_TEMP0, PAIR_TRAINER_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  IF $WK_OTHER_D24_PAIR != 4 THEN
    $WK_OTHER_D24_PAIR += 1
  ENDIF
  
EVENT_END


//====================================================================
/*
  フィールドトレーナー連れ歩き開始処理コモン
  @param  SCWK_PARAM0 連れ歩き対象にするOBJID
  @param  SCWK_PARAM1 ペアID 
  @param  SCWK_PARAM2 トレーナーID 
*/
//====================================================================
ev_pair_trainer_set_call:
{
  IF FLAG_ON( SYS_FLAG_PAIR ) THEN
    _CHG_LOCAL_SCR  //既に連れ歩きがいる場合スルー
  ENDIF

  _PAIR_TRAINER_PARAM_SET( SCWK_PARAM0, SCWK_PARAM1, SCWK_PARAM2, SCWK_PARAM3, SCWK_PARAM4 )
  //ゾーン切替で消えないOBJに指定
	_OBJ_SET_NOT_DEL_ZONECHG( PAIR_TRAINER_01 )
  //動作コード変更
//  _MOVE_CODE_CHANGE( SCWK_PARAM0, MV_PAIR )
  //連れ歩きフラグセット
//  _FLAG_SET( SYS_FLAG_PAIR )

  _CHG_LOCAL_SCR                          //ローカルスクリプトに切り替え
}
_END

//====================================================================
/*
  フィールドトレーナー連れ歩き解放処理コモン
  @param  SCWK_PARAM0 連れ歩き対象に設定する新しいイベントID
  @param  SCWK_PARAM1 連れ歩き対象に設定する新しい動作コード
*/
//====================================================================
ev_pair_trainer_free_call:
{
  IF FLAG_OFF( SYS_FLAG_PAIR ) THEN
    _CHG_LOCAL_SCR  //連れ歩きがいない場合スルー
  ENDIF

  //連れ歩き解除
  _PAIR_TRAINER_PARAM_FREE( SCWK_PARAM0, SCWK_PARAM1 )

  _CHG_LOCAL_SCR                          //ローカルスクリプトに切り替え
}
_END


