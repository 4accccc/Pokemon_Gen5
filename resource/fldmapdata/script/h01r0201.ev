  .text

  .include  "scr_seq_def.h"
  .include  "msg_h01r0201.h"
  .include  "h01r0201.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_bg_h01r0201_board_01
_EVENT_DATA   ev_h01r0201_informationw_01
_EVENT_DATA   ev_h01r0201_woman2_01
_EVENT_DATA   ev_h01r0201_workman_01
_EVENT_DATA   ev_pos_h01r0201_workman_01
_EVENT_DATA   ev_h01r0201_ol_01
_EVENT_DATA   ev_h01r0201_clown_01
_EVENT_DATA_END

//主人公座標取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_h01r0201:
//  _END

/**************************************************************/
/*  電光掲示板のイベントスクリプト                            */
/**************************************************************/
EVENT_START   ev_bg_h01r0201_board_01
  _LOOK_ELBOARD( ELBOARD_CAMERA_FRAME )
EVENT_END

/**************************************************************/
/*  受付嬢：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_h01r0201_informationw_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h01r0201_infomationw_01 )
EVENT_END

/**************************************************************/
/*  女性：話しかけ                                            */
/**************************************************************/
EVENT_START   ev_h01r0201_woman2_01

  //ゲームクリア後か
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //女性：すっごく　あるいちゃった！
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h01r0201_woman2_02 )

  ELSE
    //女性:スカイアローブリッジも
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h01r0201_woman2_01 )

  ENDIF

EVENT_END

/**************************************************************/
/*  ストッパー：話しかけ（クリアまで）                        */
/**************************************************************/
EVENT_START   ev_h01r0201_workman_01

  //働くおじさん:スカイアローブリッジ　だがね
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h01r0201_workman_01 )

EVENT_END

/**************************************************************/
/*  POS：ストッパーイベント（クリアまで）                     */
/**************************************************************/
EVENT_START   ev_pos_h01r0201_workman_01

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

  _OBJ_ANIME( H01R0201_WORKMAN_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //主人公の位置で振り向き分岐
  IF $LCW_POSX == 8 THEN
    //アニメ：主人公とストッパー向かい合う
    _OBJ_ANIME( H01R0201_WORKMAN_01, anm_common_turn_l )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
    _OBJ_ANIME_WAIT()

  ELSIF $LCW_POSX == 10 THEN
    //アニメ：主人公とストッパー向かい合う
    _OBJ_ANIME( H01R0201_WORKMAN_01, anm_common_turn_r )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
    _OBJ_ANIME_WAIT()

  ENDIF

  //働くおじさん:ちょっと　とおるのは　まってよ
  _BALLOONWIN_OBJMSG_POS( msg_h01r0201_workman_02, H01R0201_WORKMAN_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：主人公一歩下がり、ストッパー上を向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( H01R0201_WORKMAN_01, anm_common_turn_u )
  _OBJ_ANIME_WAIT()

EVENT_END

/**************************************************************/
/*  ＯＬ：話しかけ（アイテム入手）                            */
/**************************************************************/
EVENT_START   ev_h01r0201_ol_01
  //アイテム「せんせいのツメ」入手
  _EASY_TALK_ITEM_EVENT( ITEM_SENSEINOTUME, 1, FE_H01R0201_ITEMGET_01, msg_h01r0201_ol_01, msg_h01r0201_ol_02, msg_h01r0201_ol_02 )
EVENT_END

/**************************************************************/
/*  ヒウンラリー：チェックポイント                                          */
/**************************************************************/
EVENT_START   ev_h01r0201_clown_01
{
  _TALK_OBJ_START()

  //ラリーイベント中の場合
  IF $WK_SCENE_C03_RALLY_01 != 6 THEN

    //クラウン：まだ　おとずれて　いないのは……
    _BALLOONWIN_TALKOBJ_MSG( msg_h01r0201_rally_03 )

    //全てのポイントをめぐっていた場合
    IF $WK_SCENE_C03_RALLY_01 == 5 THEN
      //クラウン：なんと！　のこり０！
      _BALLOONWIN_TALKOBJ_MSG( msg_h01r0201_rally_08 )
      _MSGWIN_CLOSE()

      //記念品受け取り
      _ITEM_EVENT_KEYWAIT( ITEM_HUSIGINAAME, 1 )
      
      //クラウン：なんと！　のこり０！
      _BALLOONWIN_TALKOBJ_MSG( msg_h01r0201_rally_09 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
      //========================================//
      //クリア後メッセージ表示終了
      $WK_SCENE_C03_RALLY_01 = 6
      //========================================//

    ELSE
      //まだ訪れていない場所を数える用変数定義
      DEFINE_LOCAL LWK_POINT_NUM  //訪れていないポイントの数
      DEFINE_LOCAL LWK_COUNT_NUM  //WHILE文のカウンタ

      //訪れていない場所の確認処理（繰り返し処理）
      WHILE $LWK_COUNT_NUM < 3

        //メダル事務局におとずれていない
        IF $LWK_COUNT_NUM == 0 && FLAG_OFF( FE_C03_RALLYPOINT_01 ) THEN
          _BALLOONWIN_OBJMSG_POS( msg_h01r0201_rally_04, H01R0201_CLOWN_01, POS_DEFAULT )
          $LWK_POINT_NUM += 1 //ポイント加算

        //すれ違い調査隊におとずれていない
        ELSIF $LWK_COUNT_NUM == 1 && FLAG_OFF( FE_C03_RALLYPOINT_02 ) THEN
          _BALLOONWIN_OBJMSG_POS( msg_h01r0201_rally_05, H01R0201_CLOWN_01, POS_DEFAULT )
          $LWK_POINT_NUM += 1 //ポイント加算

        //バトルカンパニーにおとずれていない
        ELSIF $LWK_COUNT_NUM == 2 && FLAG_OFF( FE_C03_RALLYPOINT_03 ) THEN
          _BALLOONWIN_OBJMSG_POS( msg_h01r0201_rally_06, H01R0201_CLOWN_01, POS_DEFAULT )
          $LWK_POINT_NUM += 1 //ポイント加算

        ENDIF

        //カウント
        $LWK_COUNT_NUM += 1

      ENDWHILE

      //訪れていない場所の数値を指定タグにセット
      _NUMBER( 0, LWK_POINT_NUM, 1 )

      //クラウン：～の　X箇所　ですね
      _BALLOONWIN_TALKOBJ_MSG( msg_h01r0201_rally_07 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSE
    //クラウン：ヒウンを　あいする
    _BALLOONWIN_TALKOBJ_MSG( msg_h01r0201_rally_09 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF
}
EVENT_END

//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：上に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_u
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0
	
//-----------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

