  .text

  .include  "scr_seq_def.h"
  .include  "msg_c15.h"
  .include  "c15.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c15
_EVENT_DATA    ev_init_c15
_EVENT_DATA    ev_scene_c15_tutorial_01
_EVENT_DATA_END


/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c15
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c15

  //イベント進行で配置を分岐
  IF $WK_SCENE_C15_TUTORIAL_01 == 1 THEN
    _OBJ_POS_CHANGE( C15_SWRIVAL_01, 31, 0, 56, DIR_DOWN )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*			SCENE_CHANGE：【仮】誘導イベント					  */
/**************************************************************/
EVENT_START		ev_scene_c15_tutorial_01

  _BALLOONWIN_OBJMSG_POS( msg_c15_test_01,C15_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //==================================//
  //C16誘導イベント終了
  $WK_SCENE_C15_TUTORIAL_01 = 2
  //C16ライバル非表示
  _FLAG_SET( FV_C15_SWRIVAL_01 )
  
  //C13プラズマ団イベント開始
  $WK_SCENE_C13 = 5
  //C13プラズマ団員表示
  _FLAG_RESET( FV_C13_SWPLAZMA )
  //==================================//
  
  
EVENT_END