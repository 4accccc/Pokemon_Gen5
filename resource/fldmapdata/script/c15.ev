//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c15
  
//
  // ごほうびイベントチェック
  IF $WK_SCENE_C15_BONUS_EVENT_01 == 1 THEN
    _FLAG_RESET( FV_C15_BONUS_EVENT_01 )  //NPC：表示
    _FLAG_RESET( FV_C15_BRONZE_01 )       //銅像：表示
  ENDIF
{

  //スターランク取得
  _PKWD_GET_STAR_RANK( LOCALWORK15 )
  
  //ランク状況でバニッシュフラグを操作
  IF $LOCALWORK15 == SCR_PKWD_STAR_RANK_1 THEN
    _FLAG_RESET( FV_C15_PEAPLE_LANK_01 )
  ELSIF $LOCALWORK15 == SCR_PKWD_STAR_RANK_2 THEN
    _FLAG_RESET( FV_C15_PEAPLE_LANK_01 )
    _FLAG_RESET( FV_C15_PEAPLE_LANK_02 )
  ELSIF $LOCALWORK15 == SCR_PKWD_STAR_RANK_3 THEN
    _FLAG_RESET( FV_C15_PEAPLE_LANK_01 )
    _FLAG_RESET( FV_C15_PEAPLE_LANK_02 )
    _FLAG_RESET( FV_C15_PEAPLE_LANK_03 )
  ELSIF $LOCALWORK15 == SCR_PKWD_STAR_RANK_4 THEN
    _FLAG_RESET( FV_C15_PEAPLE_LANK_01 )
    _FLAG_RESET( FV_C15_PEAPLE_LANK_02 )
    _FLAG_RESET( FV_C15_PEAPLE_LANK_03 )
    _FLAG_RESET( FV_C15_PEAPLE_LANK_04 )
  ENDIF

}
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c15

  //イベント進行で配置を分岐
  IF $WK_SCENE_C15_TUTORIAL_01 == 1 THEN
    //チュートリアル開始：初めてC15に入ったタイミング
    //　スタッフ移動
    _OBJ_POS_CHANGE( C15_PWSTAFF_01, 32, 0, 56, DIR_LEFT )
    //　オーナー移動
    _OBJ_POS_CHANGE( C15_PWOWNER_01, 30, 0, 56, DIR_RIGHT )
  ELSIF $WK_SCENE_C15_TUTORIAL_01 == 2 THEN
    //チュートリアル中：シアターから出てきたタイミング
    //　スタッフ移動
    _OBJ_POS_CHANGE( C15_PWSTAFF_01, 45, 0, 19, DIR_DOWN )
    //　オーナー移動なし（プレイヤーにみえない位置）
  ENDIF

  // ごほうびイベントチェック
  IF $WK_SCENE_C15_BONUS_EVENT_01 == 1 THEN
    //　スタッフ移動
    _OBJ_POS_CHANGE( C15_PWSTAFF_01, 45, 2, 21, DIR_UP )
    //　オーナー移動
    _OBJ_POS_CHANGE( C15_PWOWNER_01, 31, 0, 10 ,DIR_DOWN )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*			SCENE_CHANGE：誘導イベント					  */
/**************************************************************/
EVENT_START		ev_scene_c15_tutorial_01

  //TODO：オーナーとスタッフを中心にするカメラの移動が必要！！！
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く

  //カメラ操作　ちょっと上のほうを初期位置にする
  _CAMERA_MOVE( 9688,0,970752,2064384,0,3768320,30 )	//一番最後の引数は移動にかかるフレーム数
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち

  //オーナー：「なるほどな…よさそうじゃないか　そのこ…
  _BALLOONWIN_OBJMSG_POS( msg_c15_tutorial_00_01, C15_PWOWNER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //スタッフ：「ええ…まもなくみえるとおもうんですが…
  _BALLOONWIN_OBJMSG_POS( msg_c15_tutorial_00_02, C15_PWSTAFF_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：スタッフ「！」・主人公と向かい合う 
  _OBJ_ANIME( C15_PWSTAFF_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C15_PWSTAFF_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  _TIME_WAIT( 8 )
  _OBJ_ANIME( C15_PWOWNER_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  //スタッフ：「あ！うわさをすれば！
  _BALLOONWIN_OBJMSG_POS( msg_c15_tutorial_00_03, C15_PWSTAFF_01, POS_DEFAULT )
  //スタッフ：ウェルカムトゥ
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_c15_tutorial_00_04, C15_PWSTAFF_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //カメラ操作　デフォ位置に移動
  _CAMERA_RECV_MOVE(15)	//カメラ復帰移動
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  _CAMERA_BIND()		//カメラバインド
  _CAMERA_END()

  //アニメ：オーナー・主人公向き合う
  _OBJ_ANIME( C15_PWOWNER_01, anm_walk_r )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C15_PWOWNER_01, anm_staystep_d )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 31, 58, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //オーナー：「ハロー！ハロー！ボクはウッドウ！
  _BALLOONWIN_OBJMSG_POS( msg_c15_tutorial_00_05, C15_PWOWNER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  //スタッフ：「ではそれまでの間　案内しましょう！
  _BALLOONWIN_OBJMSG_POS( msg_c15_tutorial_00_06, C15_PWSTAFF_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：オーナー・スタッフの方を向く
  _OBJ_ANIME( C15_PWOWNER_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //オーナー：「ウンウン！それナイスね！
  _BALLOONWIN_OBJMSG_POS( msg_c15_tutorial_00_07, C15_PWOWNER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //オーナー退出アニメ
  _OBJ_ANIME_AUTO( C15_PWOWNER_01, 31, 45, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( C15_PWOWNER_01 )
  
  //アニメ：スタッフ接近
  _OBJ_ANIME( C15_PWSTAFF_01, anm_walk_l )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C15_PWSTAFF_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //スタッフ：「イエス！ボス！では～さん　わたくしとまいりましょう！」
  _BALLOONWIN_OBJMSG_POS( msg_c15_tutorial_01,C15_PWSTAFF_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：スタッフ隣接
  _OBJ_ANIME( C15_PWSTAFF_01, anm_walk_d )
  _OBJ_ANIME_WAIT()
  
  //アニメ：移動
  _OBJ_ANIME_AUTO( C15_PWSTAFF_01, 31,32, FORCE_TYPE_NOT, 8, DIR_LR )
  _TIME_WAIT( 4 )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 31,33, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //アニメ：スタッフ・主人公を見る
  _OBJ_ANIME( C15_PWSTAFF_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //スタッフ：「せっかくですからポケウッドについて軽くご紹介しましょう
  _BALLOONWIN_OBJMSG_POS( msg_c15_tutorial_02, C15_PWSTAFF_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：移動
  _OBJ_ANIME( C15_PWSTAFF_01, anm_pwstaff_to_theater )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_to_theater )
  _OBJ_ANIME_WAIT()
  
  //カメラ操作　シアター写す
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 5848,0,970752,2981888,241695,1277952,40 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //スタッフ：「ここは　シアター！
  _PLAINWIN_MSG_DOWN( msg_c15_tutorial_03 )
  _PLAINWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (40)
   
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了

  _OBJ_ANIME_AUTO( C15_PWSTAFF_01, 45,20, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C15_PWSTAFF_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C15_PWSTAFF_01, anm_pwstaff_to_theater_in )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_to_theater_in )
  _OBJ_ANIME_WAIT()

  //==================================//
  //C16誘導イベントその２へ
  $WK_SCENE_C15_TUTORIAL_01 = 2
  //==================================//
  //new!!!!!!    ここで　シアター内に遷移！　!!!!!!///
  _MAP_CHANGE( ZONE_ID_C15R0301, 15, 31, DIR_UP )
  _RESERVE_SCRIPT( SCRID_RESERVE_PKWD_THEATER_TUTORIAL )
  
EVENT_END

EVENT_START ev_scene_c15_tutorial_02

  _MAP_FADE_BLACK_IN_SLOW()

  //アニメ：移動
  _OBJ_ANIME( C15_PWSTAFF_01, anm_pwstaff_theater_out )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_theater_out )

  _MAP_FADE_END_CHECK()
  _OBJ_ANIME_WAIT()

  _OBJ_ANIME( C15_PWSTAFF_01, anm_pwstaff_to_studio )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_to_studio )
  _OBJ_ANIME_WAIT()

  //カメラ操作　スタジオ写す
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 6616,0,1167360,1343488,65551,1110016,40 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //スタッフ：さあ！
  _PLAINWIN_MSG_DOWN( msg_c15_tutorial_04 )
  _PLAINWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (40)
   
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //アニメ：入場
  _OBJ_ANIME( C15_PWSTAFF_01, anm_pwstaff_in_studio )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C15_PWSTAFF_01, anm_pwstaff_in_studio2 )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_in_studio )
  _OBJ_ANIME_WAIT()
  
  //チュートリアル開始
  _FLAG_SET( SYS_FLAG_POKEWOOD_TUTORIAL )
  _RESERVE_SCRIPT( SCRID_RESERVE_PKWD_ENTRANCE_TUTORIAL )
  _MAP_CHANGE( ZONE_ID_C15R0201, 14, 21, DIR_UP )
  
  //==================================//
  //C16誘導イベント終了
  $WK_SCENE_C15_TUTORIAL_01 = 3
  
  //C13プラズマ団イベント開始
  $WK_SCENE_C13 = 5
  //C13プラズマ団員表示
  _FLAG_RESET( FV_C13_SWPLAZMA )
  //==================================//
  
  
EVENT_END

