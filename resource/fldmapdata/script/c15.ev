/**************************************************************/
/*			一言メッセージ					  */
/**************************************************************/
EVENT_START		ev_c15_oldman1_01
{
  
  //主人公名格納
  _PLAYER_NAME( 0 )

  //スターランク取得
  _PKWD_GET_STAR_RANK( LOCALWORK15 )

  //スターランクが0～2
  IF $LOCALWORK15 < 3 THEN
    
    //ランダム数結果変数定義
    DEFINE_LOCAL LCWK_RANDOM
    //ランダムでメッセージを変更
    _GET_RND( LCWK_RANDOM, 4 )
    //メッセージ代入変数定義
    DEFINE_LOCAL LCWK_MSGID
    //メッセージ代入
    $LCWK_MSGID = msg_c15_oldman2_01_01
    $LCWK_MSGID += $LCWK_RANDOM
    
    _EASY_BALLOONWIN_TALKOBJ_MSG( LCWK_MSGID )
  
  //スターランクが3～4
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c15_oldman2_01_04 )
  ENDIF
 
}
EVENT_END

/**************************************************************/
/*			一言メッセージ					  */
/**************************************************************/
EVENT_START		ev_c15_oldman1_02

  //主人公名格納
  _PLAYER_NAME( 0 )

  //スターランク取得
  _PKWD_GET_STAR_RANK( LOCALWORK15 )

  //スターランクが0～2
  IF $LOCALWORK15 < 3 THEN
	
	_TALK_START_TURN_NOT()
	
	//そうさねえ……
	_BALLOONWIN_TALKOBJ_MSG_POS( msg_c15_oldman2_02_01, POS_DEFAULT )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()

  ELSE
  
	_TALK_START_TURN_NOT()
	
	//うむ　いいねえ……
	_BALLOONWIN_TALKOBJ_MSG_POS( msg_c15_oldman2_02_02, POS_DEFAULT )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
  
  ENDIF

EVENT_END


