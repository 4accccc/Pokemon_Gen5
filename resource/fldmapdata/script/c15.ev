//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c15
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c15

  //イベント進行で配置を分岐
  IF $WK_SCENE_C15_TUTORIAL_01 == 1 THEN
    _OBJ_POS_CHANGE( C15_SUNGLASSES_01, 31, 0, 56, DIR_DOWN )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*			SCENE_CHANGE：誘導イベント					  */
/**************************************************************/
EVENT_START		ev_scene_c15_tutorial_01

  //アニメ：サングラス「！」
  _OBJ_ANIME( C15_SUNGLASSES_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  $LCW_POSZ -= 2
  
  //アニメ：サングラス接近
  _OBJ_ANIME_AUTO( C15_SUNGLASSES_01, LCW_POSX,LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //サングラス：ウェルカムトゥ
  _BALLOONWIN_OBJMSG_POS( msg_c15_sunglasses_01,C15_SUNGLASSES_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：サングラス隣接
  _OBJ_ANIME( C15_SUNGLASSES_01, anm_walk_d )
  _OBJ_ANIME_WAIT()
  
  //アニメ：移動
  _OBJ_ANIME_AUTO( C15_SUNGLASSES_01, 31,40, FORCE_TYPE_NOT, 8, DIR_LR )
  _TIME_WAIT( 4 )
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  IF $LCW_POSX == 30 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_wolk_center_x30 )
  ELSIF $LCW_POSX == 31 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_wolk_center_x31 )
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_wolk_center_x32 )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //アニメ：サングラス左右を見る
  _OBJ_ANIME( C15_SUNGLASSES_01, anm_sunglasses_lr_look )
  _OBJ_ANIME_WAIT()
  
  //サングラス：ついでといってはなんですが
  _BALLOONWIN_OBJMSG_POS( msg_c15_sunglasses_02,C15_SUNGLASSES_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：移動
  _OBJ_ANIME( C15_SUNGLASSES_01, anm_sunglasses_to_theater )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_to_theater )
  _OBJ_ANIME_WAIT()
  
  //カメラ操作　シアター写す
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 8664,0,970752,2981888,65551,1232896,40 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //サングラス：ここは　シアター！
  _PLAINWIN_MSG_DOWN( msg_c15_sunglasses_03 )
  _PLAINWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (40)
   
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //アニメ：移動
  _OBJ_ANIME( C15_SUNGLASSES_01, anm_sunglasses_to_studio )
  _TIME_WAIT( 8*2 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_to_studio )
  _OBJ_ANIME_WAIT()
  
  //サングラス：さあ！
  _BALLOONWIN_OBJMSG_POS( msg_c15_sunglasses_04,C15_SUNGLASSES_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：入場
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_in_studio )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( C15_SUNGLASSES_01, anm_sunglasses_in_studio )
  _OBJ_ANIME_WAIT()
  
  //チュートリアル開始
  _FLAG_SET( SYS_FLAG_POKEWOOD_TUTORIAL )
  _RESERVE_SCRIPT( SCRID_RESERVE_PKWD_ENTRANCE_TUTORIAL )
  _MAP_CHANGE( ZONE_ID_C15R0201, 14, 21, DIR_UP )
  
  //==================================//
  //C16誘導イベント終了
  $WK_SCENE_C15_TUTORIAL_01 = 2
  //C16ライバル非表示
  _FLAG_SET( FV_C15_SWRIVAL_01 )
  
  //C13プラズマ団イベント開始
  $WK_SCENE_C13 = 5
  //C13プラズマ団員表示
  _FLAG_RESET( FV_C13_SWPLAZMA )
  //==================================//
  
  
EVENT_END

