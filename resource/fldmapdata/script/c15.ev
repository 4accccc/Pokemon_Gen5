/**************************************************************/
/*			SCENE_CHANGE：ごほうびイベント					  */
/**************************************************************/
EVENT_START   ev_scene_c15_bonus_event_01
{

  //アニメ：スタッフ「！」
  _OBJ_ANIME( C15_PWSTAFF_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //タグ０にプレイヤー名
  _PLAYER_NAME( 0 )

  //スタッフの前に移動
  {
    DEFINE_LOCAL  LWK_HERO_X
    DEFINE_LOCAL  LWK_HERO_Z
    //自機の位置取得
    _PLAYER_POS_GET( LWK_HERO_X,LWK_HERO_Z )

    SWITCH $LWK_HERO_X
    CASE 44 THEN  // 下1歩 右1歩
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_bonus_event_01_a )
    CASE 45 THEN  // 下1歩
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_d )
    CASE 46 THEN  // 下1歩 左1歩
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_bonus_event_01_b )
    ENDSWITCH
    _OBJ_ANIME_WAIT()
  }

  //スタッフ：ヘイヘイ！　～！！
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_01,C15_PWSTAFF_01, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //=================================================
  //♀MAIDの前に移動
  _OBJ_ANIME( C15_PWSTAFF_01, anm_bonus_event_02_s )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_bonus_event_02_p )
  _OBJ_ANIME_WAIT()

  //♀MAID話しかけ
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_02, C15_BONUS_MAID_01, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //=================================================
  //♂PWMOJIの前に移動
  _OBJ_ANIME( C15_PWSTAFF_01, anm_bonus_event_03 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_bonus_event_03 )
  _OBJ_ANIME_WAIT()
  
  //♂PWMOJI話しかけ
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_03, C15_BONUS_PWMOJI_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //=================================================
  // ♂BACKPACKERMの前に移動
  _OBJ_ANIME( C15_PWSTAFF_01, anm_bonus_event_04 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_bonus_event_04 )
  _OBJ_ANIME_WAIT()

  //♂BACKPACKERM 話しかけ
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_04, C15_BONUS_BACKPACKERM_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //=================================================
  // ♀RGLEADER5の前に移動
  _OBJ_ANIME( C15_PWSTAFF_01, anm_bonus_event_05_s )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_bonus_event_05_p )
  _OBJ_ANIME_WAIT()

  //♀RGLEADER5 話しかけ
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_05, C15_BONUS_RGLEADER5_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //=================================================
  //♀OLの前に移動
  _OBJ_ANIME( C15_PWSTAFF_01, anm_bonus_event_06 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_bonus_event_06 )
  _OBJ_ANIME_WAIT()

  //♀OL 話しかけ
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_06, C15_BONUS_OL_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //=================================================
  //♂GENTLEMAN の前に移動
  _OBJ_ANIME( C15_PWSTAFF_01, anm_bonus_event_07 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_bonus_event_07 )
  _OBJ_ANIME_WAIT()

  //♂GENTLEMAN 話しかけ
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_07, C15_BONUS_ADULTW_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //=================================================
  // ♂PWOWNERの前に移動
  _OBJ_ANIME( C15_PWSTAFF_01, anm_bonus_event_08 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_bonus_event_08 )
  _OBJ_ANIME_WAIT()

  //スタッフ：ヘイ！ボス！おつれしました
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_08,C15_PWSTAFF_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  // 横にどける
  _OBJ_ANIME( C15_PWSTAFF_01, anm_bonus_event_09 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
  _OBJ_ANIME_WAIT()

  //=================================================
  // PWOWNERこちらを向く
  _OBJ_ANIME( C15_PWOWNER_01, anm_dir_d )
  _OBJ_ANIME( C15_BONUS_LEADER7_01, anm_dir_d )
  _OBJ_ANIME_WAIT()

  //オーナー：うむ・・・ ○○ちゃん　きょうは　きねんすべき　ひ　なんだ・・・
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_09, C15_PWOWNER_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //ハチク：フッ・・・　きみの　えんぎは　きょうえんしゃを　ふるわせる・・・
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_10, C15_BONUS_LEADER7_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //オーナー：○○ちゃん！！　キミこそ　ポケウッドのしんの　スターだ
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_11, C15_PWOWNER_01, POS_DOWN )
  _ME_PLAY( SEQ_ME_HYOUKA6 )             //ファンファーレ
  _ME_WAIT()

  //オーナー：とういことで　○○ちゃんに　ボクから　ささやかな　プレゼントだよ
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_12, C15_PWOWNER_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //スタッフ：横向く
  _OBJ_ANIME( C15_PWSTAFF_01, anm_dir_r )
  _OBJ_ANIME_WAIT()
  //スタッフ：イエッサー！ボス！　さぁ　○○！　カモン！
  _BALLOONWIN_OBJMSG_POS( msg_c15_end_13,C15_PWSTAFF_01, POS_DOWN )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()


  //楽屋に飛ぶ
	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_C15R0401_SUNGLASSES_01 )
	//マップチェンジ
	_MAP_CHANGE( ZONE_ID_C15R0401, 11, 16, DIR_RIGHT )

  //==================================//
  // 楽屋前のガードマンどかす
  _FLAG_SET( FE_C15R0401_GUARDMAN )
  // NPC非表示
  _FLAG_SET( FV_C15_BONUS_EVENT_01 )
  //==================================//
}
EVENT_END


