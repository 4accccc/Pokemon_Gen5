    //ラティアス：ひゅああん！
    _VOICE_PLAY( MONSNO_380, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke2_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  ENDIF

  //アニメ：ラティオス（ラティアス）振り向き
  _OBJ_ANIME( D01R0101_RATI2_01, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

  //主人公の立ち位置によって演出が分岐
  IF $LCW_POSX == 22 THEN

    //ラティオス（ラティアス）停止座標まで移動
    _OBJ_TRANS( D01R0101_RATI2_01, 31, 4, 15, 6*2 )

  ELSIF $LCW_POSX == 23 THEN

    //ラティオス（ラティアス）停止座標まで移動
    _OBJ_TRANS( D01R0101_RATI2_01, 32, 4, 15, 6*2 )

  ENDIF

  //ラティオス（ラティアス）退場
  _OBJ_DEL( D01R0101_RATI2_01 )

  //========================================//
  //ラティオス（ラティアス）非表示
  _FLAG_SET( FV_D01R0101_RATI2_01 )
  //イベント進行
  $WK_SCENE_D01R0101_RATI2 = 5
  //========================================//

INIT_EVENT_END

/**************************************************************/
/*  POS：ラティオス（ラティアス）イベント06                   */
/**************************************************************/
EVENT_START   ev_pos_d01r0101_rati2_06

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ )

  //ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )

  //Ｂ２ならラティオス
  IF $LCWK_VERSION == VERSION_B2 THEN

    //ラティオス：しゅわん！
    _VOICE_PLAY( MONSNO_381, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke1_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  //Ｗ２ならラティアス
  ELSE

    //ラティアス：ひゅああん！
    _VOICE_PLAY( MONSNO_380, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke2_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  ENDIF

  //==================================//
  //ラティオス（ラティアス）表示
  _FLAG_RESET( FV_D01R0101_RATI2_01 )
  //==================================//
  _OBJ_ADD( D01R0101_RATI2_01 )

  //ラティオス（ラティアス）登場座標にジャンプ
  _OBJ_POS_CHANGE( D01R0101_RATI2_01, 56, 4, 12, DIR_LEFT )

  //ラティオス（ラティアス）停止座標まで移動
  _OBJ_TRANS( D01R0101_RATI2_01, 50, 4, 12, 6*3 )

  _TIME_WAIT( 32 )

  //ラティオス（ラティアス）主人公に接近
  _OBJ_TRANS( D01R0101_RATI2_01, 48, 4, 12, 6 )

  //Ｂ２ならラティオス
  IF $LCWK_VERSION == VERSION_B2 THEN

    //ラティオス：しゅわーん！
    _VOICE_PLAY( MONSNO_381, 0 )
    _GIZAPLAINWIN_MSG_POS( msg_d01r0101_poke1_02, POS_DOWN )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    _WILD_BTL_SET_LEGEND( MONSNO_381, 68 ) // Lv.680 ラティオス

  //Ｗ２ならラティアス
  ELSE

    //ラティアス：ひゅああーん！
    _VOICE_PLAY( MONSNO_380, 0 )
    _GIZAPLAINWIN_MSG_POS( msg_d01r0101_poke2_02, POS_DOWN )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    _WILD_BTL_SET_LEGEND( MONSNO_380, 68 ) // Lv.68 ラティアス

  ENDIF

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //========================================//
    //ラティオス（ラティアス）非表示
    _FLAG_SET( FV_D01R0101_RATI2_01 )
    //イベント進行
    $WK_SCENE_D01R0101_RATI2 = 6
    //========================================//
    
    //ゆめのしずくを手に入れていない
    IF FLAG_OFF( FE_D01R0101_SIZUKU_GET ) THEN
      //========================================//
      //ゆめのしずく表示
      _FLAG_RESET( FV_D01R0101_ITEMBALL_01 )
      //========================================//
      _OBJ_ADD( D01R0101_SIZUKU_01 )
    ENDIF

    //ラティオス（ラティアス）退場
    _OBJ_DEL( D01R0101_RATI2_01 )

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //ラティオス（ラティアス）を捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合
    //==================================//
    //ラティオス（ラティアス）を捕獲した
    _FLAG_SET( FE_D01R0101_RATI2_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

  ENDSWITCH

  //ラティオス（ラティアス）を見たことがあるか
  IF FLAG_OFF( FE_D01R0101_RATI2_MEET_01 ) THEN
    //==================================//
    //ラティオス（ラティアス）発見
    _FLAG_SET( FE_D01R0101_RATI2_MEET_01 )
    //==================================//

  ENDIF

INIT_EVENT_END

/************************************************************/
/*					話しかけ：しずく						*/
/************************************************************/
EVENT_START ev_d01r0101_sizuku_01

  _TALK_START_SE_PLAY()

  //モンスターボール非表示
  _OBJ_DEL( D01R0101_SIZUKU_01 )

  //アイテム（こころのしずく）入手
  _ITEM_EVENT_FIELD( ITEM_KOKORONOSIZUKU, 1 )

  //========================================//
  //モンスターボール非表示
  _FLAG_SET( FV_D01R0101_ITEMBALL_01 )
  //いでんしのくさび入手済み
  _FLAG_SET( FE_D01R0101_SIZUKU_GET )
  //========================================//
  
EVENT_END

