  _OBJ_POS_CHANGE( D01R0101_RATI2_01, 44, 2, 22, DIR_LEFT )

  //ラティオス（ラティアス）停止座標まで移動
  _OBJ_TRANS( D01R0101_RATI2_01, 26, 2, 22, 6*8 )

  //ラティオス（ラティアス）退場
