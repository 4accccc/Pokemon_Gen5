/**************************************************************/
/*  POS：ラティオス（ラティアス）イベント05                   */
/**************************************************************/
EVENT_START   ev_pos_d01r0101_rati2_05

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ )

  //ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )

  //Ｂ２ならラティオス
  IF $LCWK_VERSION == VERSION_B2 THEN

    //ラティオス：しゅわん！
    _VOICE_PLAY( MONSNO_381, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke1_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  //Ｗ２ならラティアス
  ELSE

    //ラティアス：ひゅああん！
    _VOICE_PLAY( MONSNO_380, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke2_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  ENDIF

  //==================================//
  //ラティオス（ラティアス）表示
  _FLAG_RESET( FV_D01R0101_RATI2_01 )
  //==================================//
  _OBJ_ADD( D01R0101_RATI2_01 )

  //主人公の立ち位置によって演出が分岐
  IF $LCW_POSX == 22 THEN
    //ラティオス（ラティアス）登場座標にジャンプ
    _OBJ_POS_CHANGE( D01R0101_RATI2_01, 13, 4, 20, DIR_RIGHT )

    //ラティオス（ラティアス）停止座標まで移動
    _OBJ_TRANS( D01R0101_RATI2_01, 26, 4, 15, 6*6 )

  ELSIF $LCW_POSX == 23 THEN
    //ラティオス（ラティアス）登場座標にジャンプ
    _OBJ_POS_CHANGE( D01R0101_RATI2_01, 14, 4, 20, DIR_RIGHT )

    //ラティオス（ラティアス）停止座標まで移動
    _OBJ_TRANS( D01R0101_RATI2_01, 27, 4, 15, 6*6 )

  ENDIF

  //アニメ：ラティオス（ラティアス）振り向き
  _OBJ_ANIME( D01R0101_RATI2_01, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 8 )

  //アニメ：主人公振り向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 16 )

  //Ｂ２ならラティオス
  IF $LCWK_VERSION == VERSION_B2 THEN

    //ラティオス：しゅわん！
    _VOICE_PLAY( MONSNO_381, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke1_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  //Ｗ２ならラティアス
