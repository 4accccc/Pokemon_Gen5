/**************************************************************/
/*  POS：ラティオス（ラティアス）イベント03                   */
/**************************************************************/
EVENT_START   ev_pos_d01r0101_rati2_03

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ )

  //ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )

  //Ｂ２ならラティオス
  IF $LCWK_VERSION == VERSION_B2 THEN

    //ラティオス：しゅわん！
    _VOICE_PLAY( MONSNO_381, 0 )
    _PLAINWIN_MSG_UP( msg_d01r0101_poke1_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  //Ｗ２ならラティアス
  ELSE

    //ラティアス：ひゅああん！
    _VOICE_PLAY( MONSNO_380, 0 )
    _PLAINWIN_MSG_UP( msg_d01r0101_poke2_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  ENDIF

  //==================================//
  //ラティオス（ラティアス）表示
  _FLAG_RESET( FV_D01R0101_RATI2_01 )
  //==================================//
  _OBJ_ADD( D01R0101_RATI2_01 )

  //主人公の立ち位置によって演出が分岐
  IF $LCW_POSX == 26 THEN
    //ラティオス（ラティアス）登場座標にジャンプ
    _OBJ_POS_CHANGE( D01R0101_RATI2_01, 17, 4, 12, DIR_RIGHT )

    //ラティオス（ラティアス）停止座標まで移動
    _OBJ_TRANS( D01R0101_RATI2_01, 35, 4, 11, 6*8 )

  ELSIF $LCW_POSX == 27 THEN
    //ラティオス（ラティアス）登場座標にジャンプ
    _OBJ_POS_CHANGE( D01R0101_RATI2_01, 18, 4, 12, DIR_RIGHT )

    //ラティオス（ラティアス）停止座標まで移動
    _OBJ_TRANS( D01R0101_RATI2_01, 36, 4, 11, 6*8 )

  ELSIF $LCW_POSX == 28 THEN
    //ラティオス（ラティアス）登場座標にジャンプ
    _OBJ_POS_CHANGE( D01R0101_RATI2_01, 19, 4, 12, DIR_RIGHT )

    //ラティオス（ラティアス）停止座標まで移動
    _OBJ_TRANS( D01R0101_RATI2_01, 37, 4, 11, 6*8 )

  ENDIF

  //ラティオス（ラティアス）退場
  _OBJ_DEL( D01R0101_RATI2_01 )

  //========================================//
  //ラティオス（ラティアス）非表示
  _FLAG_SET( FV_D01R0101_RATI2_01 )
  //イベント進行
  $WK_SCENE_D01R0101_RATI2 = 3
  //========================================//

INIT_EVENT_END

