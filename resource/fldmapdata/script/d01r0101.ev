//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//主人公方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL LCW_POSX
DEFINE_LOCAL LCW_POSZ


/************************************************************/
/*  ZONE_CHANGE_LABEL                                       */
/************************************************************/
INIT_EVENT_START  ev_zone_d01r0101

  //ラティオス（ラティアス）と戦闘していない？
  IF FLAG_OFF( FE_D01R0101_RATI2_GET_01 ) && $WK_SCENE_D01R0101_RATI2 != 6 THEN

    //ROMバージョン取得
    _GET_ROM_VERSION( LCWK_VERSION )

    //B2
    IF $LCWK_VERSION == VERSION_B2 THEN
      $OBJCHRWORK0 = TPOKE_0408   //Ｂ版ならラティオス
    ELSE
      $OBJCHRWORK0 = TPOKE_0407   //Ｗ版ならラティアス
    ENDIF

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_d01r0101

//

INIT_EVENT_END

/************************************************************/
/*  FIELD_RECOVER_LABEL                                     */
/************************************************************/
INIT_EVENT_START	ev_recover_d01r0101

//

INIT_EVENT_END

/**************************************************************/
/*  POS：ラティオス（ラティアス）イベント01                   */
/**************************************************************/
EVENT_START   ev_pos_d01r0101_rati2_01

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ )

  //ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )

  //Ｂ２ならラティオス
  IF $LCWK_VERSION == VERSION_B2 THEN

    //ラティオス：しゅわん！
    _VOICE_PLAY( MONSNO_381, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke1_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  //Ｗ２ならラティアス
  ELSE

    //ラティアス：ひゅああん！
    _VOICE_PLAY( MONSNO_380, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke2_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  ENDIF

  //==================================//
  //ラティオス（ラティアス）表示
  _FLAG_RESET( FV_D01R0101_RATI2_01 )
  //==================================//
  _OBJ_ADD( D01R0101_RATI2_01 )

  //ラティオス（ラティアス）登場座標にジャンプ
  _OBJ_POS_CHANGE( D01R0101_RATI2_01, 19, 0, LCW_POSZ, DIR_LEFT )

  //ラティオス（ラティアス）停止座標まで移動
  _OBJ_TRANS( D01R0101_RATI2_01, 13, 0, LCW_POSZ, 6*4 )

  _TIME_WAIT( 16 )    //間

  //ラティオス（ラティアス）主人公に接近
  _OBJ_TRANS( D01R0101_RATI2_01, 12, 0, LCW_POSZ, 8 )

  _TIME_WAIT( 48 )    //間

  //ラティオス（ラティアス）交代
  _OBJ_TRANS( D01R0101_RATI2_01, 13, 0, LCW_POSZ, 8*2 )

  _TIME_WAIT( 16 )    //間

  //Ｂ２ならラティオス
  IF $LCWK_VERSION == VERSION_B2 THEN

    //ラティオス：しゅわん！
    _VOICE_PLAY( MONSNO_381, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke1_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  //Ｗ２ならラティアス
  ELSE

    //ラティアス：ひゅああん！
    _VOICE_PLAY( MONSNO_380, 0 )
    _PLAINWIN_MSG_DOWN( msg_d01r0101_poke2_01 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  ENDIF

  //アニメ：ラティオス（ラティアス）振り向き
  _OBJ_ANIME( D01R0101_RATI2_01, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

  //ラティオス（ラティアス）登場座標まで移動・退場
  _OBJ_TRANS( D01R0101_RATI2_01, 19, 0, LCW_POSZ, 6*3 )
  _OBJ_DEL( D01R0101_RATI2_01 )

  //========================================//
  //ラティオス（ラティアス）非表示
  _FLAG_SET( FV_D01R0101_RATI2_01 )
  //イベント進行
  $WK_SCENE_D01R0101_RATI2 = 1
  //========================================//

INIT_EVENT_END

/**************************************************************/
/*  POS：ラティオス（ラティアス）イベント02                   */
