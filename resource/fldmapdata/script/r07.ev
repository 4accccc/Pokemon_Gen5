//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA ev_bg_r07_board_01
_EVENT_DATA ev_bg_r07_board_02
_EVENT_DATA ev_bg_r07_board_03
_EVENT_DATA ev_zone_r07
_EVENT_DATA	ev_pos_r07_livecaster
_EVENT_DATA	ev_r07_fighterw_01
_EVENT_DATA_END

/**************************************************************/
/*            ZONE_CHANGE_SCRIPT                               */
/**************************************************************/
INIT_EVENT_START ev_zone_r07
  //フェスミッション用 タワーオブヘブンの鐘を鳴らしたフラグをリセット
  _FLAG_RESET ( FE_FMISSION_EV_TOH_CLEAR )
INIT_EVENT_END

/**************************************************************/
/*看板01（７番道路用）                                         */
/**************************************************************/
EVENT_START  ev_bg_r07_board_01
	_EASY_BGWIN_MSG(msg_r07_sign1_01 , TYPE_ROAD)
EVENT_END

/**************************************************************/
/*看板02（タワーオブへブン用）                                 */
/**************************************************************/
EVENT_START  ev_bg_r07_board_02
	_EASY_BGWIN_MSG(msg_r07_sign2_01 , TYPE_POST)
EVENT_END

/**************************************************************/
/*看板03（おとくな掲示板）                                     */
/**************************************************************/
EVENT_START  ev_bg_r07_board_03
	_EASY_BGWIN_MSG(msg_r07_sign3_01 , TYPE_INFO)
  _FLAG_SET( MDL_FLAG_BOARD_R07_03 )
EVENT_END

/**************************************************************/
/*  話しかけ：FIGHTERW */
/**************************************************************/
EVENT_START   ev_r07_fighterw_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r07_fighterw1_01 )
EVENT_END

/**************************************************************/
/*		R07		ライブキャスターイベント					  */
/**************************************************************/
EVENT_START		ev_pos_r07_livecaster
	
	//TVT着信音を再生
	_ME_PLAY( SEQ_ME_CALL )
	_SYSWIN_MSG( msg_r07_tvt_01, POS_DOWN )
	_ME_WAIT()

	_PLAYER_NAME(0)
	_SYSWIN_MSG( msg_r07_tvt_02, POS_DOWN )
	_MSGWIN_CLOSE()
	
	//ライブキャスター起動
	
	//ライブキャスター起動
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()
  _CALL_TVT_DEMO( 4 )
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()
  
	
	//========================================/
	
	//ライブキャスターイベント終了
	$WK_SCENE_R07 = 1
	
	//========================================/
	
EVENT_END