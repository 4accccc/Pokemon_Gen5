
//======================================================================
//                c03r0302.ev
//
//    スクリプトファイル：c03r0302用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c03r0302.h"
  .include  "c03r0302.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c03r0302_scientistm_01
_EVENT_DATA    ev_c03r0302_businessman_01
_EVENT_DATA    ev_c03r0302_businessman_02
_EVENT_DATA_END


/**************************************************************/
/*  助手♂：話しかけ（アイテム入手）                          */
/**************************************************************/
EVENT_START   ev_c03r0302_scientistm_01
  _EASY_TALK_ITEM_EVENT( ITEM_PINTORENZU, 1, FE_C03R0302_ITEM_01, msg_c03r0302_assistantm_01, msg_c03r0302_assistantm_02, msg_c03r0302_assistantm_02 )
EVENT_END

/**************************************************************/
/*  ビジネスマン01：話しかけ（トレーナー戦／アイテム入手）    */
/**************************************************************/
EVENT_START   ev_c03r0302_businessman_01

  _TALK_OBJ_START()

  //アイテム入手済み？
  IF FLAG_OFF( FE_C03R0302_ITEM_02 ) THEN

    //ビジネスマン：おっ！？　かいしゃけんがく？
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0302_businessman1_01 )
    _MSGWIN_CLOSE()

    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_BUSINESS1_10, 0 ) 

    //結果チェック
    _CALL ev_battle_check

    //勝利時
    //ビジネスマン：なんという　じつりょく！
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0302_businessman1_02 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //アイテム（クイックボール×2）入手
    _ITEM_EVENT_KEYWAIT( ITEM_KUIKKUBOORU, 2 )

    //ビジネスマン：クイックボールは　ポケモンと
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0302_businessman1_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //========================================//
    //フラグON
    _FLAG_SET( FE_C03R0302_ITEM_02 )
    //========================================//

  ELSE

    //ビジネスマン：クイックボールは　ポケモンと
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0302_businessman1_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

ev_battle_check:
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()      //勝ち(1)ならエリート勝利処理へ
  ELSE
    _TRAINER_LOSE()     //負け(0)ならエリート敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

/**************************************************************/
/*  ビジネスマン02：話しかけ（トレーナー戦／アイテム入手）    */
/**************************************************************/
EVENT_START   ev_c03r0302_businessman_02

  _TALK_OBJ_START()

  //アイテム入手済み？
  IF FLAG_OFF( FE_C03R0302_ITEM_03 ) THEN

    //ビジネスマン：もしかして　ポケモンしゅぎょう？
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0302_businessman2_01 )
    _MSGWIN_CLOSE()

    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_BUSINESS1_11, 0 ) 

    //結果チェック
    _CALL ev_battle_check

    //勝利時
    //ビジネスマン：その　うでまえ　なら
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0302_businessman2_02 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //アイテム（タイマーボール×5）入手
    _ITEM_EVENT_KEYWAIT( ITEM_TAIMAABOORU, 5 )

    //ビジネスマン：タイマーボールは　ポケモンと
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0302_businessman2_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //========================================//
    //フラグON
    _FLAG_SET( FE_C03R0302_ITEM_03 )
    //========================================//

  ELSE

    //ビジネスマン：タイマーボールは　ポケモンと
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0302_businessman2_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END




