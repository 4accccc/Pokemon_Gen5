  .text

  .include  "scr_seq_def.h"
  .include  "msg_c14r0201.h"
  .include  "c14r0201.h"

  //@author fujimura_souichirou
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c14r0201_badman_01
_EVENT_DATA    ev_c14r0201_waitress_01
_EVENT_DATA_END


/**************************************************************/
/*  スキンヘッズ：話しかけ（ポケモン交換）                    */
/**************************************************************/
EVENT_START   ev_c14r0201_badman_01
{
  _TALK_OBJ_START()

  //ポケモン交換済みか
  IF FLAG_ON( FE_C14R0201_TRADE_01 ) THEN

    //スキンヘッズ：ポケモントレードしたら
    _BALLOONWIN_TALKOBJ_MSG( msg_c14r0201_badman_06 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE

    //スキンヘッズ：マンタイン　って　ポケモン　もってる？▼
    _BALLOONWIN_TALKOBJ_MSG( msg_c14r0201_badman_01 )

    //マンタインとモジャンボを交換する？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == 0 THEN    //はい

      _MSGWIN_CLOSE()

      //選択ポケモン格納変数定義
      DEFINE_LOCAL LWK_CHOICE
      //キャンセルしたか結果格納変数定義
      DEFINE_LOCAL LWK_SELECT_RESULT

      //ポケモン選択画面開く
      _SELECT_TEMOTI_POKE( LWK_SELECT_RESULT, LWK_CHOICE, 0 )

      //ポケモンを選択したか
      IF $LWK_SELECT_RESULT == TRUE THEN

        //要望と一致してるかチェック結果格納変数定義
        DEFINE_LOCAL LWK_TRADE_CHECK

        //選択したポケモンが交換可能かチェック
        _FIELD_POKE_TRADE_CHECK ( LWK_TRADE_CHECK, FLD_TRADE_POKE_28_MOZYANBO, LWK_CHOICE )

        //交換可能であるか
        IF $LWK_TRADE_CHECK == FLD_TRADE_ENABLE THEN

          //スキンヘッズ：じゃ　レッツ　ポケモントレード！▼
          _BALLOONWIN_TALKOBJ_MSG( msg_c14r0201_badman_02 )
          _MSGWIN_CLOSE()

          //交換処理
          _FIELD_POKE_TRADE ( FLD_TRADE_POKE_28_MOZYANBO, LWK_CHOICE )

          //スキンヘッズ：モジャンボ　サイコーだぜ！▼
          _BALLOONWIN_TALKOBJ_MSG( msg_c14r0201_badman_03 )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()

          //==================================//
          //交換完了
          _FLAG_SET ( FE_C14R0201_TRADE_01 )
          //==================================//

        //条件と一致しなかった
        ELSE

          //スキンヘッズ：マンタイン　なんだぜ？
          _BALLOONWIN_TALKOBJ_MSG( msg_c14r0201_badman_04 )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()

        ENDIF

      //選択キャンセル
      ELSE

        //スキンヘッズ：まー　いいや！　きがかわったら
        _BALLOONWIN_TALKOBJ_MSG( msg_c14r0201_badman_05 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //スキンヘッズ：まー　いいや！　きがかわったら
      _BALLOONWIN_TALKOBJ_MSG( msg_c14r0201_badman_05 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

}
EVENT_END

/**************************************************************/
/*		WAITRESS	会話スクリプト						  */
/**************************************************************/
EVENT_START		ev_c14r0201_waitress_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14r0201_waitress_01 )
EVENT_END
