EVENT_END

/**************************************************************/
/*  チラーミィ：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_h04r0201_poke19_01
	_EASY_TALK_POKEVOICE( MONSNO_533, msg_h04r0201_poke19_01 )
EVENT_END

/**************************************************************/
/*  ミネズミ：話しかけ                                      */
