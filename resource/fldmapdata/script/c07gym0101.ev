  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c07gym0101.h"
  .include  "c07gym0101.h"
  
  .include  "oldt06r0101.h"
  .include  "oldt06r0101_def.h"

  //@author fujimura_souichirou（ハチクイベント追加）
  //@author Mizuguchi_Mai（リンクイベント）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c07gym0101_leader7_01
_EVENT_DATA    ev_c07gym0101_sunglasses_01
_EVENT_DATA    ev_bg_c07gym0101_statue_01
_EVENT_DATA    ev_pos_c07gym0101_switch_01
_EVENT_DATA    ev_pos_c07gym0101_switch_02
_EVENT_DATA    ev_pos_c07gym0101_switch_03
_EVENT_DATA    ev_pos_c07gym0101_zimen_01
_EVENT_DATA    ev_pos_c07gym0101_zimen_02
_EVENT_DATA    ev_pos_c07gym0101_zimen_03
_EVENT_DATA    ev_pos_c07gym0101_zimen_04
_EVENT_DATA    ev_pos_c07gym0101_zimen_05
_EVENT_DATA    ev_pos_c07gym0101_zimen_06
_EVENT_DATA    ev_pos_c07gym0101_zimen_07
_EVENT_DATA    ev_pos_c07gym0101_zimen_08
_EVENT_DATA    ev_zone_c07gym0101
_EVENT_DATA    ev_reserve_c07gym0101_link_ret
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//------------------------------注意--------------------------------//
//                                                                  //
//  ジムギミックに LOCALWORK15、01、02、03 を使用ししています。     //
//  同マップ内の使用を禁止します。                                  //
//  LOCALWORK15 ⇒ POS起動WORK。常に0。                             //
//  LOCALWORK01 ⇒ 歯車0を管理するWORK。オンオフで0か1になる。      //
//  LOCALWORK02 ⇒ 歯車1を管理するWORK。オンオフで0か1になる。      //
//  LOCALWORK03 ⇒ 歯車2を管理するWORK。オンオフで0か1になる。      //
//  LOCALWORK12をリンクイベントで使用。
//                                                                  //
//------------------------------------------------------------------//

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c07gym0101
  
  //データコンバートフラグチェック
  _DATACONV_GET_FLAG( DATACONV_FLAG_GAME_CLEAR, LOCALWORK12 )
  
  IF $LOCALWORK12 == 1 && $WK_SYS_LINK_EVENT_03 == 0 THEN
  
    //========================================//
    //ハチクを表示
    _FLAG_RESET( FV_C07GYM0101_LEADDER7_01 )
    //========================================//
  
  ENDIF
  
INIT_EVENT_END

/**************************************************************/
/*  ハチク：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c07gym0101_leader7_01

  _TALK_OBJ_START()

  //データコンバートフラグチェック
  _DATACONV_GET_FLAG( DATACONV_FLAG_GAME_CLEAR, LOCALWORK15 )

  //リンクイベントを起動しているならばコール
  IF $LOCALWORK15 == 1 && $WK_SYS_LINK_EVENT_03 == 0 THEN
    
    _CALL ev_link_event
  
  //リンクイベントを起動していないなら初回会話をコール
  ELSIF FLAG_OFF( FE_C07GYM0101_LEADER7 ) THEN
  
    _CALL ev_leader7_first_tark
  
  ENDIF

EVENT_END

/**************************************************************/
/*  CALL：リンクイベント                                          */
/**************************************************************/
ev_link_event:

    _BALLOONWIN_TALKOBJ_MSG( msg_c07gym0101_memory_01 )
    _MSGWIN_CLOSE()
  
    _MAP_FADE_BLACK_OUT_SLOW()
    //過去イベント起動
    _RESERVE_SCRIPT( SCRID_RESERVE_OLDT06R0101_EVENT_01 )
    _MAP_FADE_END_CHECK()
    //マップチェンジ
    _MAP_CHANGE_NO_FADE( ZONE_ID_OLDT06R0101, 6, 0, 3, DIR_DOWN )
    
    //========================================//
    
    //リンクイベント終了
    $WK_SYS_LINK_EVENT_03 = 1
    
    //========================================//

_RET

/**************************************************************/
/*  RESERVE：リンクイベントから復帰                                          */
/**************************************************************/
EVENT_START   ev_reserve_c07gym0101_link_ret
  
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()
  
  //ハチク：おもいでリンク終了メッセージ
  _BALLOONWIN_OBJMSG_POS(msg_c07gym0101_memory_02,C07GYM0101_LEADER7_01 , POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //初回イベントが未消化なら続けて
  IF FLAG_OFF( FE_C07GYM0101_LEADER7 ) THEN
  
    _CALL ev_leader7_first_tark
  
  ENDIF
  
  //退場アニメ再生
  _CALL ev_leader7_bye
  
EVENT_END

/**************************************************************/
/*  CALL：初回会話イベント                                          */
/**************************************************************/
ev_leader7_first_tark:

  //ハチク：そのむかし　ケガをして
  _BALLOONWIN_OBJMSG_POS( msg_c07gym0101_leader_01,C07GYM0101_LEADER7_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //自機方向取得
  _PLAYER_DIR_GET( LWK_DIR )
   //アニメ：ハチク別方向を向く
  SWITCH $LWK_DIR
  CASE DIR_UP THEN
    _OBJ_ANIME( C07GYM0101_LEADER7_01, anm_common_turn_l )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( C07GYM0101_LEADER7_01, anm_common_turn_u )
  CASE DIR_DOWN THEN
    _OBJ_ANIME( C07GYM0101_LEADER7_01, anm_common_turn_r )
  CASE DIR_LEFT THEN
    _OBJ_ANIME( C07GYM0101_LEADER7_01, anm_common_turn_d )
  ENDSWITCH
  _OBJ_ANIME_WAIT()

  //ハチク：ジムリーダーを　つとめ
  _BALLOONWIN_OBJMSG_POS( msg_c07gym0101_leader_02,C07GYM0101_LEADER7_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //自機方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  //アニメ：ハチク主人公と向き合う
  SWITCH $LWK_DIR
  CASE DIR_UP THEN
    _OBJ_ANIME( C07GYM0101_LEADER7_01, anm_common_turn_d )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( C07GYM0101_LEADER7_01, anm_common_turn_l )
  CASE DIR_DOWN THEN
    _OBJ_ANIME( C07GYM0101_LEADER7_01, anm_common_turn_u )
  CASE DIR_LEFT THEN
    _OBJ_ANIME( C07GYM0101_LEADER7_01, anm_common_turn_r )
  ENDSWITCH
  _OBJ_ANIME_WAIT()

  //ハチク：おしえることは　おそわること……
  _BALLOONWIN_OBJMSG_POS( msg_c07gym0101_leader_03,C07GYM0101_LEADER7_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //リンクイベント時以外なら退場アニメ再生
  IF $WK_SYS_LINK_EVENT_03 == 0 THEN
  
    _CALL ev_leader7_bye
  
  ENDIF
  
  //========================================//
  //初回会話終了
  _FLAG_SET( FE_C07GYM0101_LEADER7 )
  //========================================//

_RET

/**************************************************************/
/*  CALL：初回会話イベント                                          */
/**************************************************************/
ev_leader7_bye:
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
  //アニメ：ハチク退場
  IF $LCW_POSX == 17 && $LCW_POSZ == 15 THEN
    _OBJ_ANIME_AUTO( C07GYM0101_LEADER7_01, 16, 23, FORCE_TYPE_NPC, 8, DIR_LR )
    _TIME_WAIT( 8*2 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
  ELSE
    _OBJ_ANIME_AUTO( C07GYM0101_LEADER7_01, 17, 23, FORCE_TYPE_NPC, 8, DIR_UD )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
  ENDIF
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( C07GYM0101_LEADER7_01 )

  //========================================//
  //ハチクを非表示に
  _FLAG_SET( FV_C07GYM0101_LEADDER7_01 )
  //========================================//
_RET

/************************************************************/
/*  ガイドー：話しかけ                                      */
/************************************************************/
EVENT_START   ev_c07gym0101_sunglasses_01

  //ジム内にハチクがいる
  IF FLAG_OFF( FV_C07GYM0101_LEADDER7_01 ) THEN
    //ガイド：やっぱ　いいすねえ……！▼
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c07gym0101_glasses_01 )

  ELSE
    //ガイド：あー　もうしわけ　ないっすねえ▼
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c07gym0101_glasses_02 )

  ENDIF

EVENT_END

/************************************************************/
/*  ＢＧ：石像                                              */
/************************************************************/
EVENT_START   ev_bg_c07gym0101_statue_01

  _TALK_START_SE_PLAY()
  //ＢＧ：ポケモンジム　あとち
  _PLAINWIN_MSG_DOWN( msg_c07gym0101_statue_01 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()

EVENT_END

/**************************************************************/
/*    ジムギミック（１）                                      */
/**************************************************************/
EVENT_START	ev_pos_c07gym0101_switch_01

	//SE再生
	 _SE_PLAY( SEQ_SE_FLD_64 )
	//スイッチアニメ
	_GYM_ICE_SW_ANM(0)
	//障害物のアニメ
	_GYM_ICE_WALL_ANM(0)
	
	//スイッチをオンにした時
	IF $LOCALWORK1 == 0 THEN
		
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI0_02,19,0,54,DIR_DOWN)
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI0_03,18,0,53,DIR_DOWN)
		
		//========================================//
	
		//歯車0をオンに
		$LOCALWORK1 = 1

		//========================================//
	
	//スイッチをオフにした時
	ELSE
	
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI0_02,18,0,55,DIR_DOWN)
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI0_03,17,0,54,DIR_DOWN)
		
		//========================================//
	
		//歯車0をオフに
		$LOCALWORK1 = 0

		//========================================//
	
	ENDIF
	
EVENT_END

/**************************************************************/
/*    ジムギミック（２）                                      */
/**************************************************************/
EVENT_START	ev_pos_c07gym0101_switch_02

	//SE再生
	 _SE_PLAY( SEQ_SE_FLD_64 )
	//スイッチアニメ
	_GYM_ICE_SW_ANM(1)
	//障害物のアニメ
	_GYM_ICE_WALL_ANM(1)

	//スイッチをオンにした時
	IF $LOCALWORK2 == 0 THEN
		
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI1_02,55,3,42,DIR_DOWN)
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI1_03,54,3,43,DIR_DOWN)
		
		//========================================//
	
		//歯車1をオンに
		$LOCALWORK2 = 1

		//========================================//
	
	//スイッチをオフにした時
	ELSE
	
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI1_02,55,3,44,DIR_DOWN)
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI1_03,56,3,43,DIR_DOWN)
		
		//========================================//
	
		//歯車1をオフに
		$LOCALWORK2 = 0

		//========================================//
	
	ENDIF
	
EVENT_END

/**************************************************************/
/*    ジムギミック（３）                                      */
/**************************************************************/
EVENT_START	ev_pos_c07gym0101_switch_03

	//SE再生
	 _SE_PLAY( SEQ_SE_FLD_64 )
	//スイッチアニメ
	_GYM_ICE_SW_ANM(2)
	//障害物のアニメ
	_GYM_ICE_WALL_ANM(2)

	//スイッチをオンにした時
	IF $LOCALWORK3 == 0 THEN
		
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI2_02,17,6,32,DIR_DOWN)
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI2_03,18,6,33,DIR_DOWN)
		
		//========================================//
	
		//歯車2をオンに
		$LOCALWORK3 = 1

		//========================================//
	
	//スイッチをオフにした時
	ELSE
	
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI2_02,16,6,33,DIR_DOWN)
		_OBJ_POS_CHANGE(C07GYM0101_TOUMEI2_03,17,6,34,DIR_DOWN)
		
		//========================================//
	
		//歯車2をオフに
		$LOCALWORK3 = 0

		//========================================//
	
	ENDIF
	
EVENT_END

/**************************************************************/
/*   地面POS（１）                                            */
/**************************************************************/
EVENT_START	ev_pos_c07gym0101_zimen_01
  _POS_PLAYER_TURN()
  _GYM_ICE_CHG_RAIL(0)
EVENT_END

