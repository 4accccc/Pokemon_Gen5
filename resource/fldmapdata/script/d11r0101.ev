
//======================================================================
//                d11r0101.ev
//
//    スクリプトファイル：d11r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d11r0101.h"
  .include  "d11r0101.h"
  .include  "d11r0101_def.h"
  .include  "pair_scr_def.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_zone_d11r0101
_EVENT_DATA		ev_init_d11r0101
_EVENT_DATA		ev_pos_d11r0101_plasma_01
_EVENT_DATA		ev_pos_d11r0101_swrival_01
_EVENT_DATA		ev_pos_d11r0101_stopper_01
_EVENT_DATA		ev_d11r0101_man2_01
_EVENT_DATA		ev_d11r0101_businessman_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
DEFINE_LOCAL  LCW_RIVAL_POSX
DEFINE_LOCAL  LCW_RIVAL_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START  ev_zone_d11r0101
  
  IF $WK_SCENE_D11R0101 == 0 && FLAG_OFF(SYS_FLAG_PAIR) THEN
    
    //==================================//
    //ライバルを表示に
    _FLAG_RESET( FV_D11R0101_SWRIVAL_01 )
    //==================================//
    
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START  ev_init_d11r0101
//
INIT_EVENT_END

/**************************************************************/
/*		POS：ライバル連れ歩き解除確認イベント
/**************************************************************/
EVENT_START		ev_pos_d11r0101_swrival_01
   
  //連れ歩いている
  IF FLAG_ON(SYS_FLAG_PAIR) THEN
    _CALL ev_d11r0101_pairend_01
  
  //連れ歩いていない
  ELSE
    _CALL ev_d11r0101_pairstart_01
  ENDIF

EVENT_END

//連れ歩き開始スクリプト
ev_d11r0101_pairstart_01:

  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  _OBJ_POS_GET( D11R0101_SWRIVAL_01,LCW_RIVAL_POSX,LCW_RIVAL_POSZ ) 
  
  $LCW_POSX -= 2
  
  IF $LCW_POSZ != $LCW_RIVAL_POSZ THEN
    _OBJ_ANIME_AUTO( D11R0101_SWRIVAL_01, LCW_POSX,LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( D11R0101_SWRIVAL_01, anm_staystep_r )
    _OBJ_ANIME_WAIT()
  ENDIF
    
  //一緒に行こう！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_01, D11R0101_SWRIVAL_01, POS_DEFAULT )
  
   {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_03, D11R0101_SWRIVAL_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //自転車に乗ってるなら歩行状態へ
    _PLAYER_FORM_GET( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_PLAYER_FORM_CYCLE THEN
      _PLAYER_REQUEST( FIELD_PLAYER_REQBIT_NORMAL )
    ENDIF
    
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
    
    //連れ歩き開始
   IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
     //初期３匹で草タイプを選択
     _PAIR_TRAINER_SET( D11R0101_SWRIVAL_01, PAIR_ID_D11R0101_SWRIVAL, PAIR_TYPE_FREE_ZONE, TRID_SWRIVAL_13, SCRID_D11R0101_SWRIVAL_PAIR_01 )
   ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
     //初期３匹で炎タイプを選択
     _PAIR_TRAINER_SET( D11R0101_SWRIVAL_01, PAIR_ID_D11R0101_SWRIVAL, PAIR_TYPE_FREE_ZONE, TRID_SWRIVAL_14, SCRID_D11R0101_SWRIVAL_PAIR_01 )
   ELSE
     //初期３匹で水タイプを選択
     _PAIR_TRAINER_SET( D11R0101_SWRIVAL_01, PAIR_ID_D11R0101_SWRIVAL, PAIR_TYPE_FREE_ZONE, TRID_SWRIVAL_15, SCRID_D11R0101_SWRIVAL_PAIR_01 )
   ENDIF
    
    //==================================//
    //ライバルを非表示に
    _FLAG_SET( FV_D11R0101_SWRIVAL_01 )
    //ローカルライブキャスター・ライバル通話状態を変更（D11クリアまで）
    _PERSON_STATE_SET_RIVAL( RIVAL_STATE_D11 )
    //==================================//
    
  //いいえ
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_02, D11R0101_SWRIVAL_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：主人公戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
  ENDIF
  }
_RET

//連れ歩き中終了処理
ev_d11r0101_pairend_01:

  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //主人公方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //アニメ：主人公振り向き
  IF $LWK_DIR == DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_d )
  ELSIF $LWK_DIR == DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_r )
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_r )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //ライバル：いちどそとにでる？
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_04, PAIR_TRAINER_01, POS_DEFAULT )
  
   {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_02, PAIR_TRAINER_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
    
    //アニメ：ライバル戻す
    _OBJ_ANIME_AUTO( PAIR_TRAINER_01, 81,20, FORCE_TYPE_NPC, 8, DIR_LR )
      
    //アニメ：主人公戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
    
    //アニメ：ライバル振り向く
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_r )
    _OBJ_ANIME_WAIT()
    
    //連れ歩き解除
    _PAIR_TRAINER_FREE( SCRID_DUMMY, MV_DMY )
    
    //==================================//
    //プラズマ団・ライバルを表示に
    _FLAG_RESET( FV_D11R0101_SWRIVAL_01 )
    //ローカルライブキャスター・ライバル通話状態を変更（連れ歩き再開まで）
    _PERSON_STATE_SET_RIVAL( RIVAL_STATE_D11_2 )
    //==================================//
      
    //ライバル動作モデル生成
    _OBJ_ADD( D11R0101_SWRIVAL_01 )
    //ペアトレーナー動作モデル削除
    _OBJ_DEL( PAIR_TRAINER_01 )
    
  //いいえ
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_03, PAIR_TRAINER_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    _PAIR_PLAYER_FOLLOW_ON()  //連れ歩き追随開始
    //アニメ：主人公戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
    _PAIR_PLAYER_FOLLOW_OFF() //連れ歩き追随終了
  ENDIF
  }
_RET

//--------------------------------------------------------------------
//	ライバル：向き合う
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swrival_pair_start_z21
  _ANIME_DATA	AC_WALK_D_8F,1
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
  _ANIME_DATA	ACMD_END,0

/**************************************************************/
/*		POS：プラズマ団戦
/**************************************************************/
EVENT_START		ev_pos_d11r0101_plasma_01
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //カメラ操作　アデク追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  
  _CAMERA_MOVE( 9688,0,970752,3375104,0,413696,32 )
  
  //アニメ：主人公・ライバル所定の位置に移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 52,8, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_AUTO( PAIR_TRAINER_01, 50,8, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち  
  
  _PLAYER_NAME( 0 )
	
  //ライバル：「！」
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_12, PAIR_TRAINER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団振り向き
  _OBJ_ANIME( D11R0101_PLASMAM_01 , anm_staystep_d )
  _OBJ_ANIME( D11R0101_PLASMAM_02 , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //プラズマ団：なんだ？おまえら
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swplazmam1_01, D11R0101_PLASMAM_01, POS_UL )
  _MSGWIN_CLOSE()
  
  //ライバル：プラズマ団なの？
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_13, PAIR_TRAINER_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //プラズマ団：そうとも！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swplazmam1_02, D11R0101_PLASMAM_01, POS_UL )
  _MSGWIN_CLOSE()
  
  //ライバル：あきれた…！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_14, PAIR_TRAINER_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //プラズマ団：タチワキ？
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swplazmam1_03, D11R0101_PLASMAM_01, POS_UL )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバルと向きあう
  _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_r )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //ライバル：主人公！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_15, PAIR_TRAINER_01, POS_DL )
  _MSGWIN_CLOSE()
  
   //アニメ：プラズマ団に向き合う
  _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_u )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //マルチバトル
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_13, TRID_SWPLAZMAM_01, TRID_SWPLAZMAM_02 ) 
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_14, TRID_SWPLAZMAM_01, TRID_SWPLAZMAM_02 ) 
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_15, TRID_SWPLAZMAM_01, TRID_SWPLAZMAM_02 ) 
  ENDIF
  
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    
    //手持ちが0匹だったら
    _GET_PARTY_POKE_COUNT( SCWK_TEMP0, POKECOUNT_MODE_BATTLE_ENABLE )
    IF $SCWK_TEMP0 == 0 THEN
      _TEMOTI_POKEMON_KAIFUKU() //回復処理
    ENDIF
    
    //カメラ操作　プラズマ団追従
    _CAMERA_START()		//カメラ操作開始
    _CAMERA_PURGE()		//カメラのバインドを解く
    _CAMERA_MOVE( 9688,0,970752,3375104,0,413696,1 )
    _CAMERA_WAIT_MOVE()	//カメラ移動待ち
    
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
  
  //プラズマ団：チッ
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swplazmam1_04, D11R0101_PLASMAM_01, POS_UL )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団退場
  _OBJ_ANIME( D11R0101_PLASMAM_01 , anm_swplazma_bye_l )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( D11R0101_PLASMAM_02 , anm_swplazma_bye_r )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
	
	//プラズマ団員の動作モデルを削除
	_OBJ_DEL( D11R0101_PLASMAM_01 )
  _OBJ_DEL( D11R0101_PLASMAM_02 )
  
  //ライバル：まてよ！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_16, PAIR_TRAINER_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //？？？：そのひつようはないっぽいよ
  _PLAINWIN_MSG_UP(msg_d11r0101_swleader3_01 )
	_MSGWIN_CLOSE()
  
  //アニメ：ライバル・主人公「？」
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_gyoe )
  _OBJ_ANIME( PAIR_TRAINER_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //アニメ：アーティ隣接
  _OBJ_ANIME_AUTO( D11R0101_SWLEADER3_01, 51,7, FORCE_TYPE_NOT, 8, DIR_LR )
  _TIME_WAIT( 8*5 )
  _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_u )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D11R0101_SWLEADER3_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ライバル：あっ　アーティ！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_17, PAIR_TRAINER_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //アーティ：奥は調べたけど
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swleader3_02, D11R0101_SWLEADER3_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //ライバル：それにしても
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_18, PAIR_TRAINER_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //アーティ：そうだねー
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swleader3_03, D11R0101_SWLEADER3_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //ライバル：…そうだね
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_19, PAIR_TRAINER_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル主人公の方を向く
  _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_r )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //ライバル：（主人公名）！いっしょに
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_20, PAIR_TRAINER_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル隣接
	_OBJ_ANIME( PAIR_TRAINER_01 , anm_walk_r )
	_OBJ_ANIME_WAIT()
  
  //ひでんマシン「かいりき」入手処理
	_ITEM_EVENT_KEYWAIT(ITEM_HIDENMASIN04, 1)
	
	//ライバル：ほかにも
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_21, PAIR_TRAINER_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  _OBJ_ANIME( PAIR_TRAINER_01 , anm_swrival_bye )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //アニメ：アーティ・主人公に隣接
  _OBJ_ANIME_AUTO( D11R0101_SWLEADER3_01, 50,8, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //アーティ：いっちゃった
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swleader3_04, D11R0101_SWLEADER3_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //？？？：そこのあなた！
  _PLAINWIN_MSG_UP( msg_d11r0101_swboss_01 )
  _PLAINWIN_CLOSE()
  
  //アニメ：「！」
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_common_gyoe )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( D11R0101_SWLEADER3_01 , anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //アクロマ配置変更
  _OBJ_POS_CHANGE( D11R0101_SWBOSS_01, 51, 0, 0, DIR_DOWN )
  
  //アニメ：上を向く
  _OBJ_ANIME( D11R0101_SWLEADER3_01 , anm_staystep_u )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  
  _TIME_WAIT( 4 )
  
  _SE_WAIT()
  _OBJ_ANIME_WAIT()
  
  //アニメ：アクロマ登場
  _OBJ_ANIME( D11R0101_SWBOSS_01 , anm_swboss_comming )
  _OBJ_ANIME_WAIT()
  
  //アクロマ：すばらしくいい！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swboss_02, D11R0101_SWBOSS_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //アニメ：アクロマ退場
  _OBJ_ANIME( D11R0101_SWBOSS_01 , anm_swboss_bye )
  _TIME_WAIT(8*5)
  _OBJ_ANIME( D11R0101_SWLEADER3_01 , anm_staystep_d )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //アニメ：アーティ：「？」
  _OBJ_ANIME( D11R0101_SWLEADER3_01 , anm_common_hatena )
  _OBJ_ANIME_WAIT()
  
  //アーティ：いまの…だれ？
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swleader3_05, D11R0101_SWLEADER3_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //アニメ：アーティと主人公向き合う
  _OBJ_ANIME( D11R0101_SWLEADER3_01 , anm_staystep_r )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //アーティ：まあいいや
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swleader3_06, D11R0101_SWLEADER3_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (32)
  
  //アニメ：アーティ・退場
  _OBJ_ANIME( D11R0101_SWLEADER3_01 , anm_swleader3_bye )
  _TIME_WAIT( 12 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //連れ歩き解除
  _PAIR_TRAINER_FREE( SCRID_DUMMY, MV_DMY )
  
  //プラズマ団イベント関連の動作モデル削除
  _OBJ_DEL( PAIR_TRAINER_01 )
  _OBJ_DEL( D11R0101_SWBOSS_01 )
  _OBJ_DEL( D11R0101_SWLEADER3_01 )

  //ストッパー非表示
  _OBJ_DEL( D11R0101_MAN2_01 )
  
  //==================================//
  //下水道クリア
  $WK_SCENE_D11R0101 = 1
  $WK_SCENE_C03P17 = 3
  
  //プラズマ団・ライバル・ストッパーを非表示に
  _FLAG_SET( FV_D11R0101_SWRIVAL_01 )
  _FLAG_SET( FV_D11R0101_SWPLAZMA_01 )
  _FLAG_SET( FV_D11R0101_STOPPER_01 )
  
  //C03P07サングラスを非表示に
  _FLAG_SET( FV_C03P07_SUNGLASSES_01 )
  
  //ローカルライブキャスター・ライバル通話状態を変更（C03GYMクリアまで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_C03_2 )
  
  //かいりきヒントメダル取得
  _SET_MEDAL_HINT_ACHIEVE( MDLID_KAIRIKI )
  //==================================//

EVENT_END

/**************************************************************/
/*		POS：ストッパー
/**************************************************************/
EVENT_START		ev_pos_d11r0101_stopper_01

  //アニメ：MAN2「！」
  _OBJ_ANIME( D11R0101_MAN2_01, anm_stopper_gyoe_01 )
  _TIME_WAIT( 40 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //メッセージ
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_man2_02, D11R0101_MAN2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _PAIR_PLAYER_FOLLOW_ON()  //連れ歩き追随開始
  //アニメ：主人公戻す
  _OBJ_ANIME( D11R0101_MAN2_01, anm_staystep_r )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
  _OBJ_ANIME_WAIT()
  _PAIR_PLAYER_FOLLOW_OFF() //連れ歩き追随終了
  
EVENT_END

