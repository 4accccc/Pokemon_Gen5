  .text

  .include  "scr_seq_def.h"
  .include  "msg_d11r0101.h"
  .include  "d11r0101.h"
  .include  "d11r0101_def.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_zone_d11r0101
_EVENT_DATA		ev_init_d11r0101
_EVENT_DATA		ev_pos_d11r0101_plasma_01
_EVENT_DATA		ev_pos_d11r0101_swrival_01
_EVENT_DATA		ev_d11r0101_swrival_02
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START  ev_zone_d11r0101
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START  ev_init_d11r0101
//
INIT_EVENT_END

/**************************************************************/
/*		POS：ライバル連れ歩き解除確認イベント
/**************************************************************/
EVENT_START		ev_pos_d11r0101_swrival_01
   
  //連れ歩いている
  IF FLAG_ON(SYS_FLAG_PAIR) THEN
    _CALL ev_d11r0101_pairend_01
  
  //連れ歩いていない
  ELSE
    _CALL ev_d11r0101_pairstart_01
  ENDIF

EVENT_END

/**************************************************************/
/*		ライバル話しかけ
/**************************************************************/
EVENT_START		ev_d11r0101_swrival_02
  _TALK_START_SE_PLAY()
  //連れ歩き話しかけ
  _CALL ev_d11r0101_swrival_pair_01
EVENT_END

//連れ歩き開始スクリプト
ev_d11r0101_pairstart_01:

  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //一緒に行こう！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_01, D11R0101_SWRIVAL_01, POS_DEFAULT )
  
   {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_03, D11R0101_SWRIVAL_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //連れ歩き開始
   IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
     //初期３匹で草タイプを選択
     _PAIR_TRAINER_SET( D11R0101_SWRIVAL_01, PAIR_ID_D11R0101_SWRIVAL, PAIR_TYPE_ONE_ZONE, TRID_SWRIVAL_13, SCRID_D11R0101_SWRIVAL_02 )
   ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
     //初期３匹で炎タイプを選択
     _PAIR_TRAINER_SET( D11R0101_SWRIVAL_01, PAIR_ID_D11R0101_SWRIVAL, PAIR_TYPE_ONE_ZONE, TRID_SWRIVAL_14, SCRID_D11R0101_SWRIVAL_02 )
   ELSE
     //初期３匹で水タイプを選択
     _PAIR_TRAINER_SET( D11R0101_SWRIVAL_01, PAIR_ID_D11R0101_SWRIVAL, PAIR_TYPE_ONE_ZONE, TRID_SWRIVAL_15, SCRID_D11R0101_SWRIVAL_02 )
   ENDIF
   
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
    
  //いいえ
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_02, D11R0101_SWRIVAL_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：主人公戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
  ENDIF
  }
_RET

//連れ歩き中終了処理
ev_d11r0101_pairend_01:

  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //アニメ：主人公振り向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //ライバル：いちどそとにでる？
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_04, PAIR_TRAINER_01, POS_DEFAULT )
  
   {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_02, PAIR_TRAINER_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //連れ歩き解除
    _PAIR_TRAINER_FREE( SCRID_D11R0101_SWRIVAL_02, MV_DMY )
    
    //アニメ：主人公戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
    
  //いいえ
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_03, PAIR_TRAINER_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：主人公戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
  ENDIF
  }
_RET

//====================================================================
// D11R0101：話しかけ 
//====================================================================

//連れ歩き中話しかけスクリプト
ev_d11r0101_swrival_pair_01:

 //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )

  //話しかけるごとに0～4のセリフを順番に表示（4で終わり）
  $SCWK_TEMP0 = msg_d11r0101_swrival_05
  $SCWK_TEMP0 += $WK_OTHER_D11R0101_PAIR
  
  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG( SCWK_TEMP0, PAIR_TRAINER_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  IF $WK_OTHER_D11R0101_PAIR != 4 THEN
    $WK_OTHER_D11R0101_PAIR += 1
  ENDIF
  
_RET

/**************************************************************/
/*		POS：プラズマ団戦
/**************************************************************/
EVENT_START		ev_pos_d11r0101_plasma_01
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //連れ歩き解除
  _PAIR_TRAINER_FREE( SCRID_D11R0101_SWRIVAL_02, MV_DMY )

  _PLAYER_NAME( 0 )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //アニメ：ライバル主人公の位置に合わせて移動
  IF $LCW_POSZ == 10 THEN
    _OBJ_ANIME_AUTO( D11R0101_SWRIVAL_01, 53,11, FORCE_TYPE_NOT, 8, DIR_LR )
  ELSE
    _OBJ_ANIME_AUTO( D11R0101_SWRIVAL_01, 53,10, FORCE_TYPE_NOT, 8, DIR_LR )
  ENDIF
  
  _OBJ_ANIME_WAIT()
	
  //ライバル：「！」
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_12, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //プラズマ団：なんだ？おまえら
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swplazmam1_01, D11R0101_PLASMAM_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：プラズマ団なの？
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_13, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //プラズマ団：そうとも！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swplazmam1_02, D11R0101_PLASMAM_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：あきれた…！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_14, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //プラズマ団：タチワキ？
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swplazmam1_03, D11R0101_PLASMAM_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル主人公の方を向く
  IF $LCW_POSZ == 10 THEN
    _OBJ_ANIME( D11R0101_SWRIVAL_01, anm_staystep_u )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  ELSE
    _OBJ_ANIME( D11R0101_SWRIVAL_01, anm_staystep_d )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //ライバル：きみ！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_15, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
   //アニメ：プラズマ団に向き合う
  _OBJ_ANIME( D11R0101_SWRIVAL_01, anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
   
  //マルチバトル
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_13, TRID_SWPLAZMAM_01, TRID_SWPLAZMAM_02 ) 
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_14, TRID_SWPLAZMAM_01, TRID_SWPLAZMAM_02 ) 
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_15, TRID_SWPLAZMAM_01, TRID_SWPLAZMAM_02 ) 
  ENDIF
  
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
  
  
  //プラズマ団：チッ
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swplazmam1_04, D11R0101_PLASMAM_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //暗転処理
  _BLACK_OUT()
	_DISP_FADE_END_CHECK()
	
	//プラズマ団員の動作モデルを削除
	_OBJ_DEL( D11R0101_PLASMAM_01 )
  _OBJ_DEL( D11R0101_PLASMAM_02 )
	
	//暗転復帰
	_BLACK_IN()
	_DISP_FADE_END_CHECK()
  
  //ライバル：まちなさいよ！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_16, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //？？？：そのひつようはないっぽいよ
  _PLAINWIN_MSG_DOWN(msg_d11r0101_swleader3_01 )
	_MSGWIN_CLOSE()
	
	//フィールド上にアーティ表示
  _OBJ_ADD_EX( 51, 1, DIR_DOWN, MMDL_ID_EVENTOBJ_00, SWLEADER3, MV_DMY )
  
  //アーティ隣接
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_gyoe )
  _OBJ_ANIME( D11R0101_SWRIVAL_01, anm_common_gyoe )
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 51,10, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ライバル：あっ　アーティ！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_17, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アーティ：奥は調べたけど
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swleader3_02, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：それにしても
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_18, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アーティ：そうだねー
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swleader3_03, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：…そうだね
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_19, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル主人公の方を向く
  IF $LCW_POSZ == 10 THEN
    _OBJ_ANIME( D11R0101_SWRIVAL_01, anm_staystep_u )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  ELSE
    _OBJ_ANIME( D11R0101_SWRIVAL_01, anm_staystep_d )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //ライバル：（主人公名）！いっしょに
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_20, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ひでんマシン「かいりき」入手処理
	_ITEM_EVENT_KEYWAIT(ITEM_HIDENMASIN04, 1)
	
	//ライバル：アーティはね！
  _BALLOONWIN_OBJMSG_POS( msg_d11r0101_swrival_21, D11R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アーティ・ライバル退場
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 62,14, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_AUTO( D11R0101_SWRIVAL_01, 62,14, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //プラズマ団イベント関連の動作モデル削除
  _OBJ_DEL( D11R0101_SWRIVAL_01 )
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  //==================================//
  //下水道クリア
  $WK_SCENE_D11R0101 = 1
  $WK_SCENE_C03P17 = 3
  
  //プラズマ団・ライバルを非表示に
  _FLAG_SET( FV_D11R0101_SWRIVAL_01 )
  
  //C03P07サングラスを非表示に
  _FLAG_SET( FV_C03P07_SUNGLASSES_01 )
  
  //==================================//

EVENT_END

//--------------------------------------------------------------------
//	☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_staystep_u
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_d
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_l
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_r
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：はてな
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_hatena
	_ANIME_DATA	AC_MARK_HATENA,1
	_ANIME_DATA	ACMD_END,0
	
