//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_bg_r20r0101_board_01
_EVENT_DATA   ev_r20r0101_informationw_01
_EVENT_DATA   ev_r20r0101_trainerm_01
_EVENT_DATA   ev_r20r0101_girl2_01
_EVENT_DATA   ev_pos_r20r0101_informationw_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/**************************************************************/
/*  電光掲示板のイベントスクリプト                            */
/**************************************************************/
EVENT_START   ev_bg_r20r0101_board_01
  _LOOK_ELBOARD( ELBOARD_CAMERA_FRAME )
EVENT_END

/**************************************************************/
/*  POS：受付嬢イベント                            */
/**************************************************************/
EVENT_START   ev_pos_r20r0101_informationw_01
  
  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  //！マーク
  _OBJ_ANIME( R20R0101_INFORMATIONW_01, anm_common_gyoe )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //受付嬢：あれ？　あなた…▼
  IF $LCW_POSZ == 4 THEN
    _BALLOONWIN_OBJMSG_POS( msg_r20r0101_infomationw_01, R20R0101_INFORMATIONW_01, POS_DEFAULT )
  ELSE
    _PLAINWIN_MSG_UP( msg_r20r0101_infomationw_01 )
  ENDIF
  
  _MSGWIN_CLOSE()
  
  IF $LCW_POSZ != 4 THEN
    //アニメ：主人公振り向き
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 13, 4, FORCE_TYPE_NPC, 8, DIR_UD)
  ENDIF
  
  _OBJ_ANIME_WAIT()
  
  //手持ち変数定義
  DEFINE_LOCAL LWK_PARTY_NUM
  //手持ちのポケモンの数を確認（タマゴのポケモンは除外）
  _GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_NOT_EGG )
  
  //瀕死・タマゴを除くポケモンの先頭を選択
  DEFINE_LOCAL LWK_FRONT
  _GET_PARTY_FRONT_POKEMON  ( LWK_FRONT , POKECOUNT_MODE_BATTLE_ENABLE )
  
  //先頭ポケモンの名前を取得
  _TEMOTI_MONS_NAME  (  0 , LWK_FRONT  )
  //手持ち匹数を格納
  _NUMBER( 1, LWK_PARTY_NUM, 1 )
  
  //手持ち2匹以下
  IF $LWK_PARTY_NUM == 1 THEN
    _BALLOONWIN_OBJMSG_POS( msg_r20r0101_infomationw_02, R20R0101_INFORMATIONW_01, POS_DEFAULT )
  //手持ち3匹以上
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_r20r0101_infomationw_03, R20R0101_INFORMATIONW_01, POS_DEFAULT )
  ENDIF
  
  _MSGWIN_CLOSE()
  
  //きずぐすり入手処理
  _ITEM_EVENT_KEYWAIT(ITEM_SUUPAABOORU, 2)
  
  //受付嬢：よくいうでしょ
  _BALLOONWIN_OBJMSG_POS( msg_r20r0101_infomationw_04, R20R0101_INFORMATIONW_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //==================================//
  //R20R0101　POS無効
  $WK_SCENE_R20R0101 = 1
  //==================================//

EVENT_END

/**************************************************************/
/*  受付嬢：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_r20r0101_informationw_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r20r0101_infomationw_04 )
EVENT_END

/**************************************************************/
/*  トレーナー♂：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_r20r0101_trainerm_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r20r0101_trainerm_01 )
EVENT_END

/**************************************************************/
/*  女の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_r20r0101_girl2_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r20r0101_girl2_01 )
EVENT_END

