_EVENT_DATA		ev_d23r0101_middleman2_01
_EVENT_DATA		ev_d23r0101_workman2_01
_EVENT_DATA		ev_d23r0101_workman2_02
_EVENT_DATA		ev_d23r0101_workman2_03
_EVENT_DATA		ev_d23r0101_assistantm_01
_EVENT_DATA		ev_init_d23r0101
