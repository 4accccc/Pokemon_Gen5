/**************************************************************/
/*		D23R0101	ASSISTANTM		マニアイベント			  */
/**************************************************************/
EVENT_START		ev_d23r0101_assistantm_01
_TALK_START_TURN_NOT()
	//場所によってメッセージを変更する
	
	//蒸留塔の前
	SWITCH $WK_SCENE_D23R0101_ASSISTANTM
	CASE 0 THEN
		_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_assistantm_01 )
		_MSGWIN_CLOSE()
		
		//主人公と向き合って
		_PLAYER_DIR_GET( SCWK_ANSWER )
		SWITCH $SCWK_ANSWER
		CASE DIR_UP THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_dir_d )
		CASE DIR_RIGHT THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_dir_l )
		CASE DIR_LEFT THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_dir_r )
		ENDSWITCH
		_OBJ_ANIME_WAIT()
		
		_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_assistantm_02 )
		_MSGWIN_CLOSE()
	
		//煙突に移動する
		SWITCH $SCWK_ANSWER
		CASE DIR_UP THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_assistantm_leave1_u )
		CASE DIR_RIGHT,DIR_LEFT THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_assistantm_leave1_rl )
		ENDSWITCH
		_OBJ_ANIME_WAIT()
		
		//煙突へ移動する
		_OBJ_POS_CHANGE( D23R0101_ASSISTANTM_01, 8, 0, 47, DIR_LEFT )
		
		//========================================/
		
		//ワークを変更する
		$WK_SCENE_D23R0101_ASSISTANTM = 1
		
		//========================================/
	
	//煙突の前
	CASE 1 THEN
		_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_assistantm_03 )
		_MSGWIN_CLOSE()
		
		//主人公と向き合って
		_PLAYER_DIR_GET( SCWK_ANSWER )
		SWITCH $SCWK_ANSWER
		CASE DIR_UP THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_dir_d )
		CASE DIR_RIGHT THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_dir_l )
		CASE DIR_DOWN THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_dir_u )
		ENDSWITCH
		_OBJ_ANIME_WAIT()

		_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_assistantm_04 )
		_MSGWIN_CLOSE()

		//煙突に移動する
		SWITCH $SCWK_ANSWER
		CASE DIR_UP THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_assistantm_leave2_u )
		CASE DIR_LEFT THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_assistantm_leave2_l )
		CASE DIR_DOWN THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_assistantm_leave2_d )
		ENDSWITCH
		_OBJ_ANIME_WAIT()

		//ガスホルダーに移動する
		_OBJ_POS_CHANGE( D23R0101_ASSISTANTM_01, 20, -1, 58, DIR_RIGHT )
		
		//========================================/
		
		//ワークを変更する
		$WK_SCENE_D23R0101_ASSISTANTM = 2
		
		//========================================/
	
	//ガスホルダーの前
	CASE 2 THEN
		_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_assistantm_05 )
		_MSGWIN_CLOSE()
		
		//主人公と向き合って
		_PLAYER_DIR_GET( SCWK_ANSWER )
		SWITCH $SCWK_ANSWER
		CASE DIR_RIGHT THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_dir_l )
		CASE DIR_DOWN THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_dir_u )
		ENDSWITCH
		_OBJ_ANIME_WAIT()
		
		IF FLAG_OFF( FE_D23R0101_ITEMGET_01 ) THEN
		
			_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_assistantm_06 )
			_MSGWIN_CLOSE()
			
			//【仮】とりあえず、きずぐすりにしています。
			_ITEM_EVENT_KEYWAIT( ITEM_KIZUGUSURI, 1 )
			
			//========================================/
			
			//アイテム入手フラグをセット
			_FLAG_SET(FE_D23R0101_ITEMGET_01)
		
		ELSE
		
			_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_assistantm_07 )
			_MSGWIN_CLOSE()
		
		ENDIF
		
		SWITCH $SCWK_ANSWER
		CASE DIR_RIGHT THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_assistantm_leave3_r )
		CASE DIR_DOWN THEN
			_OBJ_ANIME( D23R0101_ASSISTANTM_01, anm_assistantm_leave3_d )
		ENDSWITCH
		_OBJ_ANIME_WAIT()
		
		//蒸留塔に移動する
		_OBJ_POS_CHANGE( D23R0101_ASSISTANTM_01, 29, 0, 32, DIR_UP )
		
		//========================================/
		
		//ワークを変更する
		$WK_SCENE_D23R0101_ASSISTANTM = 0
		
		//========================================/

	ENDSWITCH

EVENT_END

