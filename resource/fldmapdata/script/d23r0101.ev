//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LWK_POSX
DEFINE_LOCAL  LWK_POSZ

/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_d23r0101:
//  _END

/**************************************************************/
/*				FIELD INIT SCRIPT							  */
/**************************************************************/
INIT_EVENT_START	ev_init_d23r0101

	SWITCH $WK_SCENE_D23R0101_ASSISTANTM
	CASE 0 THEN
		_OBJ_POS_CHANGE( D23R0101_ASSISTANTM_01, 29, 0, 32, DIR_UP )
	CASE 1 THEN
		_OBJ_POS_CHANGE( D23R0101_ASSISTANTM_01, 8, 0, 47, DIR_LEFT )
	CASE 2 THEN
		_OBJ_POS_CHANGE( D23R0101_ASSISTANTM_01, 20, -1, 58, DIR_RIGHT )
	ENDSWITCH
	
INIT_EVENT_END

/**************************************************************/
/*		D23R0101	MIDDLEMAN2		現場監督イベント		  */
/**************************************************************/
EVENT_START		ev_d23r0101_middleman2_01
_TALK_OBJ_START()
	//依頼を請けていない場合
	IF FLAG_OFF ( FE_D23R0101_MANAGER_TALK) THEN
		
		_BALLOONWIN_TALKOBJ_MSG( sg_d23r0101_workman_01 )
		
		//はい・いいえ分岐
		_YES_NO_WIN( SCWK_ANSWER )
		//はいの場合
		IF $SCWK_ANSWER == SCR_YES THEN 
		
			_BALLOONWIN_TALKOBJ_MSG( sg_d23r0101_workman_02 )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
			
			//========================================/
			
			//依頼請けフラグを建てる
			_FLAG_SET(FE_D23R0101_MANAGER_TALK)
		
			//========================================/
		
		//いいえの場合
		ELSE
		
			_BALLOONWIN_TALKOBJ_MSG( sg_d23r0101_workman_03 )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		ENDIF
	
	//依頼を請けている場合
	ELSE
		
		//依頼を達成した場合
		IF FLAG_ON(FE_D23R0101_WORKMAN2A_BTL) && FLAG_ON(FE_D23R0101_WORKMAN2B_BTL) && FLAG_ON(FE_D23R0101_WORKMAN2C_BTL) THEN
		
			_BALLOONWIN_TALKOBJ_MSG( sg_d23r0101_workman_04 )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		
		//依頼を達成していない場合
		ELSE
		
			_BALLOONWIN_TALKOBJ_MSG( sg_d23r0101_workman_05 )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		ENDIF
	
	
	ENDIF

EVENT_END

/**************************************************************/
/*		D23R0101	WORKMAN2		作業員１				  */
/**************************************************************/
EVENT_START		ev_d23r0101_workman2_01
_TALK_OBJ_START()

	//依頼を請けていない場合
	IF FLAG_OFF( FE_D23R0101_MANAGER_TALK ) THEN

		_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_workman2a_01 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	
	//依頼を請けている場合
	ELSE
		
		//既に戦闘済みの場合
		IF FLAG_ON( FE_D23R0101_WORKMAN2A_BTL ) THEN
		
			_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_workman2a_03 )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		//まだ戦闘をしていない場合
		ELSE
		
			//メッセージ表示
			_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_workman2a_02 )
			_MSGWIN_CLOSE()
		
			//戦闘処理
			_TRAINER_BTL_SET( TRID_WORKER2_21, 0 )
	
			//結果チェック
			_TRAINER_LOSE_CHECK( SCWK_ANSWER )
			IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
				_TRAINER_WIN()
			ELSE
				_TRAINER_LOSE()
			ENDIF
	
			//メッセージ表示
			_BALLOONWIN_TALKOBJ_MSG( msg_d23r0101_workman2a_03 )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
	
			//========================================/
			
			//戦闘済みのフラグをたてる
			_FLAG_SET(FE_D23R0101_WORKMAN2A_BTL)
			
			//========================================/
			
		
		ENDIF

	ENDIF

EVENT_END

