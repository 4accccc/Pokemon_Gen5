
//======================================================================
//                c09r0301.ev
//
//    スクリプトファイル：c09r0301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0301.h"
  .include  "c09r0301.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_c09r0301
_EVENT_DATA   ev_init_c09r0301
_EVENT_DATA   ev_recover_c09r0301
_EVENT_DATA   ev_c09r0301_bigfour3_01
_EVENT_DATA   ev_pos_c09r0301_enter_01
_EVENT_DATA   ev_pos_c09r0301_enter_02
_EVENT_DATA   ev_pos_c09r0301_warp_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//                                                                  //
//  LOCALWORK0 をギミックの制御に使用しています。                   //
//    0 = 階段下のPOSイベント有効                                   //
//  LOCALWORK1 をギミックの制御に使用しています。                   //
//    0 = 階段上のPOSイベント有効                                   //
//  LOCALWORK10 をギミックの制御に使用しています。マップ内使用禁止  //
//    555 = POSイベント有効                                         //
//                                                                  //
//------------------------------------------------------------------//


/************************************************************/
/*  ZONE_CHANGE_LABEL                                       */
/************************************************************/
INIT_EVENT_START  ev_zone_c09r0301

  //四天王（格闘）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) THEN
    $LOCALWORK10 = 555
  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_c09r0301
/*
  //格闘　音開始
  //一番上で呼んでください
  _FOURKINGS_SET_SOUND_SYSTEM( 3 )
*/
  //頂上のPOSを踏んでいない時の処理
  IF $LOCALWORK1 == 0 THEN
    //頂上のPOSを踏んでいない時の処理
    //レンブを上に配置
    _OBJ_POS_CHANGE( C09R0301_BIGFOUR3_01, 15, 22, 7, DIR_DOWN )
  ENDIF

  //四天王（格闘）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) THEN

    //配置モデルのアニメをループ再生
    _BMODEL_DIRECT_ANIME_SET_LOOP( SCR_BMID_WARP, 17, 9 )

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_RECOVER_LABEL                                     */
/************************************************************/
INIT_EVENT_START  ev_recover_c09r0301
/*
  //格闘　音開始
  //一番上で呼んでください
  _FOURKINGS_SET_SOUND_SYSTEM( 3 )
*/
  // 主人公が頂上にいるときの処理
  IF $LOCALWORK1 == 1 THEN
    //レールOFF
    _FOURKINGS_RAIL_OFF( 3 )
    //カメラ設定を変更
    _FOURKINGS_SET_TOP_CAMERA( 3 )

  ELSE
    //頂上のPOSを踏んでいない時の処理
    //レンブを上に配置
    _OBJ_POS_CHANGE( C09R0301_BIGFOUR3_01, 15, 22, 7, DIR_DOWN )
  ENDIF

  //四天王（格闘）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) THEN

    //配置モデルのアニメをループ再生
    _BMODEL_DIRECT_ANIME_SET_LOOP( SCR_BMID_WARP, 17, 9 )

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  四天王（格闘）                                          */
/************************************************************/
EVENT_START   ev_c09r0301_bigfour3_01

  _TALK_OBJ_START()

  //ゲームクリア前後で分岐
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    //========ゲームクリア前===============

    //戦闘済みかで分岐
    IF FLAG_OFF( SYS_FLAG_BIGFOUR_FIGHTWIN ) THEN

      //戦闘前---------------------------------------------------
	 
	 IF FLAG_OFF( FE_D07_BIGFOUR3_TALK ) THEN
      	//レンブ：ちょうせんしゃ　よ……
          _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_01 ,C09R0301_BIGFOUR3_01 ,POS_UP )
      	_MSGWIN_CLOSE()	 
	 ELSE
      	//d07で出会っている場合
      	//レンブ：ネジやまで　であったか……▼
          _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_02 ,C09R0301_BIGFOUR3_01 ,POS_UP )
      	_MSGWIN_CLOSE()
	 ENDIF

      //========================================//
      //戦闘終了後にワープのアニメを再生させるため、マップ構築前に勝利フラグをたてておく
      //負けた場合はC09でリセットされるので問題なし
      //四天王（レンブ）勝利フラグをセット
      _FLAG_SET( SYS_FLAG_BIGFOUR_FIGHTWIN )
      //ワープPOSイベント有効
      $LOCALWORK10 = 555
      //========================================//

    {
      //難易度取得ワーク定義
      DEFINE_LOCAL  LCW_DIFFICULTY
      
      //現在の難易度を取得
      _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
      
      //トレーナー戦呼び出し
      
      //むずかしい
      IF $LCW_DIFFICULTY == 2 THEN
        _TRAINER_BTL_SET( TRID_BIGFOUR3_03, 0 )
      
      //ふつう・かんたん
      ELSE
        _TRAINER_BTL_SET( TRID_BIGFOUR3_01, 0 )
      ENDIF

    }

      //敗戦チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
      ELSE
        _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
      ENDIF

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //レンブ：さいきょうの　トレーナーとなった▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_05 ,C09R0301_BIGFOUR3_01 ,POS_UP )

      ELSE
        //それ以外なら通常メッセージを表示
        //レンブ：さすが　だな！▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_03 ,C09R0301_BIGFOUR3_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ELSE

      //戦闘後---------------------------------------------------

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //レンブ：さいきょうの　トレーナーとなった▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_05 ,C09R0301_BIGFOUR3_01 ,POS_UP )

      ELSE
        //戦闘後メッセージ
        //レンブ：じぶんの　しんじる　みちを　ゆけ！▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_04 ,C09R0301_BIGFOUR3_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSE

    //========ゲームクリア後===============

    //戦闘済みかで分岐
    IF FLAG_OFF( SYS_FLAG_BIGFOUR_FIGHTWIN ) THEN

      //戦闘前---------------------------------------------------

      //レンブ：……また　こうして
      _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_06 ,C09R0301_BIGFOUR3_01 ,POS_UP )
      _MSGWIN_CLOSE()

      //========================================//
      //戦闘終了後にワープのアニメを再生させるため、マップ構築前に勝利フラグをたてておく
      //負けた場合はC09でリセットされるので問題なし
      //四天王（レンブ）勝利フラグをセット
      _FLAG_SET( SYS_FLAG_BIGFOUR_FIGHTWIN )
      //ワープPOSイベント有効
      $LOCALWORK10 = 555
      //========================================//

    {
      //難易度取得ワーク定義
      DEFINE_LOCAL  LCW_DIFFICULTY
      
      //現在の難易度を取得
      _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
      
      //トレーナー戦呼び出し
      
      //むずかしい
      IF $LCW_DIFFICULTY == 2 THEN
        _TRAINER_BTL_SET( TRID_BIGFOUR3_04, 0 )
      
      //ふつう・かんたん
      ELSE
        _TRAINER_BTL_SET( TRID_BIGFOUR3_02, 0 )
      ENDIF

    }

      //敗戦チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
      ELSE
        _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
      ENDIF

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //レンブ：きみたちの　つよさ
        _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_09 ,C09R0301_BIGFOUR3_01 ,POS_UP )

      ELSE
        //それ以外なら通常メッセージを表示
        //レンブ：まだまだ　つよい　トレーナーがいる▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_07 ,C09R0301_BIGFOUR3_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ELSE

      //戦闘後---------------------------------------------------

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //レンブ：きみたちの　つよさ
        _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_09 ,C09R0301_BIGFOUR3_01 ,POS_UP )

      ELSE
        //戦闘後メッセージ
        //レンブ：つよさを　もとめ　せかいかっこくを
        _BALLOONWIN_OBJMSG_POS( msg_c09r0301_bigfour3_08 ,C09R0301_BIGFOUR3_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

EVENT_END

/************************************************************/
/*  階段下のposイベント                                     */
/************************************************************/
EVENT_START   ev_pos_c09r0301_enter_01

  //======================================
  //演出開始
  //--------------------------------------

  _TIME_WAIT( 5 )

  //ドア開く
  _FOURKINGS_FIGHT_DOOR()
  _SE_PLAY( SEQ_SE_SW_RENBU_01 )    // 重い金網の扉が開く音

  _TIME_WAIT( 60 )

  //階段せりあがる
  _FOURKINGS_FIGHT_STAIRS( 0 )
  _SE_PLAY( SEQ_SE_SW_RENBU_02 )    // 機械仕掛けの階段が競りあがる音

  _TIME_WAIT( 20 )

  //--------------------------------------
  //演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

EVENT_END

/************************************************************/
/*  階段上のposイベント                                     */
/************************************************************/
EVENT_START   ev_pos_c09r0301_enter_02

  //レールOFF
  _FOURKINGS_RAIL_OFF( 3 )

  //カメラ設定を変更
  _FOURKINGS_SET_TOP_CAMERA( 3 )

  //======================================
  //演出開始
  //--------------------------------------

  //アイコン「！」表示
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_tr_gyoe )
  _OBJ_ANIME_WAIT()

  //階段消失
  _FOURKINGS_FIGHT_STAIRS( 1 )
  _SE_PLAY( SEQ_SE_SW_RENBU_03 )    // 機械仕掛けの階段が消える音

  _TIME_WAIT( 30 )

    //ステージ落下
  _FOURKINGS_FIGHT_STAGE()

  _TIME_WAIT( 30 ) 

  //レンブの芝居(立ち上がる)
  _OBJ_ANIME( C09R0301_BIGFOUR3_01, anm_renbu_stand_up )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 10 ) 

  //ライト点灯
  _FOURKINGS_FIGHT_LIGHT()
  _SE_PLAY( SEQ_SE_SW_RENBU_05 )    // ライトが点く音 

  _TIME_WAIT( 5 )

  //--------------------------------------
  //演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

EVENT_END

/************************************************************/
/*  ワープ（出口用）                                        */
/************************************************************/
EVENT_START	ev_pos_c09r0301_warp_01

  //マップチェンジ
  _MAP_CHANGE_WARP( ZONE_ID_C09P01, 31, 48, DIR_UP )

EVENT_END

//--------------------------------------------------------------
//  トレーナー[!]マーク
//--------------------------------------------------------------
_ANIME_LABEL  anm_tr_gyoe
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------
//  レンブ：芝居
//--------------------------------------------------------------
_ANIME_LABEL  anm_renbu_stand_up
  _ANIME_DATA AC_BIGFOUR3_STANDUP,1
  _ANIME_DATA ACMD_END,0



