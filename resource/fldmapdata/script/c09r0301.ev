
//======================================================================
//                c09r0301.ev
//
//    スクリプトファイル：c09r0301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0301.h"
  .include  "c09r0301.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c09r0301
_EVENT_DATA    ev_init_c09r0301
_EVENT_DATA    ev_recover_c09r0301
_EVENT_DATA    ev_c09r0301_bigfour3_01
_EVENT_DATA    ev_pos_c09r0301_enter_01
_EVENT_DATA    ev_pos_c09r0301_enter_02
_EVENT_DATA    ev_pos_c09r0301_warp_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//																	//
//	LOCALWORK0 をギミックの制御に使用しています。					//
//		0 = 階段下のPOSイベント有効 	//
//	LOCALWORK1 をギミックの制御に使用しています。					//
//		0 = 階段上のPOSイベント有効 	//
//	LOCALWORK10 をギミックの制御に使用しています。マップ内使用禁止	//
//		555 = POSイベント有効										//
//																	//
//------------------------------------------------------------------//

/************************************************************/
/*					ZONE_CHANGE_LABEL 						*/
/************************************************************/
INIT_EVENT_START	ev_zone_c09r0301
  
INIT_EVENT_END
/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_c09r0301

  // 頂上のPOSを踏んでいない時の処理
  IF $LOCALWORK1 == 0 THEN
    // 頂上のPOSを踏んでいない時の処理
    // レンブを上に配置
    _OBJ_POS_CHANGE( C09R0301_BIGFOUR3_01, 15, 22, 7, DIR_DOWN )
  ENDIF

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_c09r0301

  // 主人公が頂上にいるときの処理
  IF $LOCALWORK1 == 1 THEN
    // レールOFF
    _FOURKINGS_RAIL_OFF( 3 )
		// カメラ設定を変更
		_FOURKINGS_SET_TOP_CAMERA( 3 )

  ELSE
    // 頂上のPOSを踏んでいない時の処理
    // レンブを上に配置
    _OBJ_POS_CHANGE( C09R0301_BIGFOUR3_01, 15, 22, 7, DIR_DOWN )
  ENDIF

INIT_EVENT_END

/************************************************************/
/*						四天王（格闘）						*/
/************************************************************/
EVENT_START	ev_c09r0301_bigfour3_01

EVENT_END

/************************************************************/
/*					階段下のposイベント					*/
/************************************************************/
EVENT_START	ev_pos_c09r0301_enter_01

  //======================================
  // 演出開始
  //--------------------------------------

  _TIME_WAIT( 5 )

  // ドア開く
  _FOURKINGS_FIGHT_DOOR()
	_SE_PLAY( SEQ_SE_SW_RENBU_01 )    // 重い金網の扉が開く音

  _TIME_WAIT( 20 )

  // 階段せりあがる
  _FOURKINGS_FIGHT_STAIRS( 0 )
	_SE_PLAY( SEQ_SE_SW_RENBU_02 )    // 機械仕掛けの階段が競りあがる音

  _TIME_WAIT( 10 )

  //--------------------------------------
  // 演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

EVENT_END

/************************************************************/
/*					階段上のposイベント					*/
/************************************************************/
EVENT_START	ev_pos_c09r0301_enter_02

  // レールOFF
  _FOURKINGS_RAIL_OFF(3)

	// カメラ設定を変更
	_FOURKINGS_SET_TOP_CAMERA(3)

  //======================================
  // 演出開始
  //--------------------------------------

  // !アイコン表示
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_tr_gyoe )
  _OBJ_ANIME_WAIT()

  // 階段消失
  _FOURKINGS_FIGHT_STAIRS( 1 )
	_SE_PLAY( SEQ_SE_SW_RENBU_03 )    // 機械仕掛けの階段が消える音

  _TIME_WAIT( 15 )

  // ステージ落下
  _FOURKINGS_FIGHT_STAGE()
	_SE_PLAY( SEQ_SE_SW_RENBU_04 )    // ステージが振ってくる音 

  _TIME_WAIT( 10 ) 

  // ライト点灯
  _FOURKINGS_FIGHT_LIGHT()
	_SE_PLAY( SEQ_SE_SW_RENBU_05 )    // ライトが点く音 

  _TIME_WAIT( 5 )

  //--------------------------------------
  // 演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

  //=====================================
  //ワープPOSイベントを有効
	$LOCALWORK10 = 555
  //=====================================

EVENT_END

/************************************************************/
/*						ワープ（出口用）					*/
/************************************************************/
EVENT_START	ev_pos_c09r0301_warp_01
	
	//マップチェンジ
	_MAP_CHANGE_WARP( ZONE_ID_C09P01, 31, 48, DIR_UP )
	
EVENT_END

//--------------------------------------------------------------
//	トレーナー[!]マーク
//--------------------------------------------------------------
_ANIME_LABEL	anm_tr_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

