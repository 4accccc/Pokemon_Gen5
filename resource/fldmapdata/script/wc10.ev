/**************************************************************/
/*  ヒロコ（じゅくがえり♀）：話しかけ                        */
/**************************************************************/
EVENT_START   ev_wc10_02_01

  //無限ダンジョンの進行具合で台詞が分岐
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  //初期状態
  IF $LWK_DUNGEON_STATUS <= 4 THEN

    //ヒロコ：ポワ～ン……▼
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_02_01 )

  //エリア05クリア後
  ELSIF $LWK_DUNGEON_STATUS >= 5 && $LWK_DUNGEON_STATUS <= 9 THEN

    //ヒロコ：わわっ！　みました！？
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_02_02 )

  //エリア10クリア後
  ELSIF $LWK_DUNGEON_STATUS >= 10 THEN

    //ヒロコ：ポケモンが　あそんでいるのを
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_02_03 )

  ENDIF

EVENT_END

/**************************************************************/
/*  マサオ（たんパンこぞう）：話しかけ                        */
/**************************************************************/
EVENT_START   ev_wc10_05_01

  //無限ダンジョンの進行具合で台詞が分岐
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  //初期状態
  IF $LWK_DUNGEON_STATUS <= 4 THEN

    //マサオ：おれの　にいちゃんは
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_05_01 )

  //エリア05クリア後
  ELSIF $LWK_DUNGEON_STATUS >= 5 && $LWK_DUNGEON_STATUS <= 9 THEN

    //マサオ：すーっごい　ひさしぶりに！
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_05_02 )

  //エリア10クリア後
  ELSIF $LWK_DUNGEON_STATUS >= 10 THEN

    //主人公名代入
    _PLAYER_NAME( 0 )
    //マサオ：にいちゃんが　さいきん
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_05_03 )

  ENDIF

EVENT_END

/**************************************************************/
/*  タクマ（カラテおう）：話しかけ                            */
/**************************************************************/
EVENT_START   ev_wc10_07_01   //エリア05クリア後に出現する

  //主人公名代入
  _PLAYER_NAME( 0 )

  //無限ダンジョンの進行具合で台詞が分岐
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  //初期状態
  IF $LWK_DUNGEON_STATUS <= 9 THEN

    //タクマ：さいきん　しろのたいじゅで
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_07_01 )

  //エリア10クリア後
  ELSIF $LWK_DUNGEON_STATUS >= 10 THEN

    //タクマ：きみが　《主人公》　か！
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_07_02 )

  ENDIF

EVENT_END

