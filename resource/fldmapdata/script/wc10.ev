/**************************************************************/
/*  ヒロコ（じゅくがえり♀）：話しかけ                        */
/**************************************************************/
EVENT_START   ev_wc10_02_01

  //無限ダンジョンの進行具合で台詞が分岐
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  //初期状態
  IF $LWK_DUNGEON_STATUS <= 4 THEN

    //ヒロコ：ポワ～ン……▼
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_02_01 )

  //エリア05クリア後
  ELSIF $LWK_DUNGEON_STATUS >= 5 && $LWK_DUNGEON_STATUS <= 9 THEN

    //ヒロコ：わわっ！　みました！？
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_02_02 )

  //エリア10クリア後
  ELSIF $LWK_DUNGEON_STATUS >= 10 THEN

    //ヒロコ：ポケモンが　あそんでいるのを
    _EASY_BALLOONWIN_TALKOBJ_MSG( wc10_02_03 )

  ENDIF

EVENT_END

