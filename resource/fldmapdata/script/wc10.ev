/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_wc10


INIT_EVENT_END

/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_wc10

  //無限ダンジョンの進行具合でOBJ配置が変化
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  IF $LWK_DUNGEON_STATUS >= 5 && $LWK_DUNGEON_STATUS <= 9 THEN

    //トレーナー（wc10_07_01）が配置されていない場合はトレーナー配置
    IF FLAG_ON( FV_WC10_TRAINER_01 ) THEN

      //==================================//
      //トレーナー表示
      _FLAG_RESET( FV_WC10_TRAINER_01 )
      //==================================//

      //トレーナー配置
      _OBJ_ADD( WC10_07_01 )  //タクマ

     ENDIF

  ELSIF $LWK_DUNGEON_STATUS >= 10 THEN

    //トレーナー（wc10_07_01）が配置されていない場合はトレーナー配置
    IF FLAG_ON( FV_WC10_TRAINER_01 ) THEN

      //==================================//
      //トレーナー表示
      _FLAG_RESET( FV_WC10_TRAINER_01 )
      //==================================//

      //トレーナー配置
      _OBJ_ADD( WC10_07_01 )  //タクマ

     ENDIF

    //トレーナー（WC10_30_01）が配置されていない場合はトレーナー配置
    IF FLAG_ON( FV_WC10_TRAINER_02 ) THEN

      //==================================//
      //トレーナー表示
      _FLAG_RESET( FV_WC10_TRAINER_02 )
      //==================================//

      //トレーナー配置
      _OBJ_ADD( WC10_30_01 )  //グレース

     ENDIF

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  POS：無限ダンジョンに移動                                 */
/**************************************************************/
EVENT_START  ev_pos_wc10_d31r0101_door

  //カメラ操作　無限ダンジョンにフォーカス
  _CAMERA_START()   //カメラ操作開始
  _CAMERA_PURGE()   //カメラのバインドを解く

  //カメラ操作,最後の引数はカメラ操作にかけるフレーム数
  _CAMERA_MOVE( 358,0,1085440,1867776,544799,1409024,1 )

  //アニメ：主人公入り口へ移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
  _OBJ_ANIME_WAIT()

  _CAMERA_WAIT_MOVE() //カメラ移動待ち

  //マップチェンジ
  _MAP_CHANGE( ZONE_ID_D31R0101, 7, 14, DIR_UP )

EVENT_END

/**************************************************************/
/*  看板01                                                    */
/**************************************************************/
EVENT_START  ev_bg_wc10_board_01
  _EASY_BGWIN_MSG( wc10_sign_01, TYPE_TOWN) 
EVENT_END

/************************************************************/
/*		ショップの共通スクリプト						*/
/************************************************************/
ev_shop_scr:

_TALK_OBJ_START()

//未購入の場合
IF FLAG_OFF( LWK_FLAG ) THEN

  //商品をいかがですか？
  SWITCH $LWK_WEEK
  CASE RTC_WEEK_SATURDAY,RTC_WEEK_SUNDAY THEN   //土,日曜日
    _BALLOONWIN_TALKOBJ_MSG_POS( LWK_MSG2, POS_DOWN )
  DEFAULT
    _BALLOONWIN_TALKOBJ_MSG_POS( LWK_MSG1, POS_DOWN )
  ENDSWITCH

  //所持金の表示
  _GOLD_WIN_OPEN( MENU_X1, MENU_Y1 )

  //購入本数の選択画面を作成
  _BMPMENU_INIT_RIGHT( MENU_X2, MENU_Y2, 0, 1, LWK_SELECT  )
  _BMPMENU_MAKE_LIST( msg_wc10_shop_choice_01, 0 ) //かう
  _BMPMENU_MAKE_LIST( msg_wc10_shop_choice_02, 1 ) //いらない

  _BMPMENU_START()

  //買う場合
  IF $LWK_SELECT == 0 THEN
	
    //アイテムが購入できるかチェック
    _ADD_ITEM_CHK( LWK_ITEM, 1, LWK_BAG_CHK )
    _CHECK_GOLD( LWK_GOLD_CHK, LWK_PRICE )

    //アイテムがいっぱいの場合
    IF $LWK_BAG_CHK == FALSE THEN
	
      //バッグがいっぱいだぞ
      _BALLOONWIN_TALKOBJ_MSG_POS( LWK_MSG4, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    //お金が足りない場合
    ELSIF $LWK_GOLD_CHK == FALSE THEN

      //おかねが　たりないぞ！
      _BALLOONWIN_TALKOBJ_MSG_POS( LWK_MSG5, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()	

    //購入条件を満たしている場合
    ELSE

      //レジ音再生・所持金から金額分を減算
      _SE_PLAY( SEQ_SE_SYS_22 )
      _SUBTRACT_GOLD( LWK_PRICE )
      _GOLD_WIN_UPDATE()
      _SE_WAIT()

      //はい　どうぞ
      _BALLOONWIN_TALKOBJ_MSG_POS( LWK_MSG3, POS_DOWN )
      _MSGWIN_CLOSE()
		
      _ITEM_EVENT_KEYWAIT( LWK_ITEM, 1 )
	
      //またきてくれよ
      _BALLOONWIN_TALKOBJ_MSG_POS( LWK_MSG6, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
      //========================================//
      //購入フラグセット
      _FLAG_SET( LWK_FLAG )
      //========================================//
      
    ENDIF

  //買わない場合
  ELSE
	
    //またきてくれよ
    _BALLOONWIN_TALKOBJ_MSG_POS( LWK_MSG6, POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

  //金額ウィンドウを消す
  _GOLD_WIN_CLOSE()

ELSE

  //おっと　すまない　きょうは　うりきれだ
  _BALLOONWIN_TALKOBJ_MSG_POS( LWK_MSG7, POS_DOWN )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

ENDIF

_RET


/**************************************************************/
/* ショップ01                                                 */
/**************************************************************/
EVENT_START   ev_wc10_shopm1_01

  //========================================//
  //商品・金額・メッセージ格納
  _GET_WEEK( LWK_WEEK )
  SWITCH $LWK_WEEK
  CASE RTC_WEEK_SATURDAY,RTC_WEEK_SUNDAY THEN
	  $LWK_ITEM = ITEM_SINKAINOKIBA
	  $LWK_PRICE = 1000
  DEFAULT
	  $LWK_ITEM = ITEM_RIIHUNOISI
	  $LWK_PRICE = 1000
  ENDSWITCH

  _ITEM_NAME( 0, LWK_ITEM )
  _NUMBER( 1, LWK_PRICE, 4 )

  $LWK_MSG1 = msg_wc10_shop_a_01
  $LWK_MSG2 = msg_wc10_shop_a_02
  $LWK_MSG3 = msg_wc10_shop_a_03
  $LWK_MSG4 = msg_wc10_shop_a_04
  $LWK_MSG5 = msg_wc10_shop_a_05
  $LWK_MSG6 = msg_wc10_shop_a_06
  $LWK_MSG7 = msg_wc10_shop_a_07
  
  $LWK_FLAG = TMFLG_WC10_SHOPBUY_01

  //========================================//

  _CALL ev_shop_scr

EVENT_END

