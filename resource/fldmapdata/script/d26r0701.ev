  .text

  .include  "scr_seq_def.h"
  .include  "msg_d26r0701.h"
  .include  "d26r0701.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori //スクリプト修正

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_d26r0701
_EVENT_DATA   ev_pos_d26r0701_poke23_01
_EVENT_DATA	ev_init_d26r0701
_EVENT_DATA	ev_d26r0701_poke23_01
_EVENT_DATA   ev_pos_d26r0701_poke23_02
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_d26r0701

INIT_EVENT_END

/************************************************************/
/*	INIT_CHANGE_LABEL								*/
/************************************************************/
INIT_EVENT_START	ev_init_d26r0701

	IF $WK_SCENE_D26_POKE23_01 == 0 THEN
	
		_OBJ_POS_CHANGE( D26R0701_POKE23_01, 35, 2, 32, DIR_DOWN )
	
	ELSIF $WK_SCENE_D26_POKE23_01 == 2 THEN
	
		_OBJ_POS_CHANGE( D26R0701_POKE23_01, 30, 2, 33, DIR_LEFT )
	
	ENDIF

INIT_EVENT_END

/**************************************************************/
/*  POS：ゾロアーク・Ｎの城誘導01                             */
/**************************************************************/
EVENT_START   ev_pos_d26r0701_poke23_01

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //ゾロアーク：くあぁああああぁん！！
  _VOICE_PLAY( MONSNO_530, 0 ) 
  _BALLOONWIN_OBJMSG_POS( msg_d26r1101_poke23_01, D26R0701_POKE23_01, POS_DEFAULT )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //アニメ：ゾロアーク、洞窟へ移動
  _OBJ_ANIME_AUTO( D26R0701_POKE23_01, 44, 19, FORCE_TYPE_NPC, 6, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D26R0701_POKE23_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  _SE_PLAY( SEQ_SE_KAIDAN )   //階段SE再生
  _OBJ_DEL( D26R0701_POKE23_01 )  //動作モデル削除
  _SE_WAIT()  //SE待ち

  //========================================//
  //POS進行
  $WK_SCENE_D26_POKE23_01 = 2
  //========================================//

EVENT_END

/**************************************************************/
/*  POS：ゾロアーク・Ｎの城誘導02                             */
/**************************************************************/
EVENT_START   ev_pos_d26r0701_poke23_02

  //ゾロアーク：くあぁああああぁん！！
  _VOICE_PLAY( MONSNO_530, 0 ) 
  _BALLOONWIN_OBJMSG_POS( msg_d26r1101_poke23_01, D26R0701_POKE23_01, POS_DEFAULT )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //アニメ：ゾロアーク、Ｎ城方面へ移動
  _OBJ_ANIME_AUTO( D26R0701_POKE23_01, 35, 32, FORCE_TYPE_NPC, 6, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D26R0701_POKE23_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  _SE_PLAY( SEQ_SE_KAIDAN )   //階段SE再生
  _OBJ_DEL( D26R0701_POKE23_01 )  //動作モデル削除
  _SE_WAIT()  //SE待ち

  //========================================//
  //POS進行
  $WK_SCENE_D26_POKE23_01 = 3
  //ゾロアーク非表示
  
  /*************************************************
   * BUGFIX_AFTER_MASTER_BTS2334_20120703
   *
   * 日本語版市場バグ ゾロアークのNの城誘導バグ修正
   * 修正内容 _FLAG_SET( FV_D26_POKE23_01 ) → _FLAG_SET( FV_D26R0701_POKE23_01 )
   *
   * d26r0701.mev vanish_flag.xls にも差分がある
   * 詳細は bugfix.hを参照のこと
   *************************************************/
  _FLAG_SET( FV_D26R0701_POKE23_01 )  //_FLAG_SET( FV_D26_POKE23_01 )
  /*************************************************
   * BUGFIX_AFTER_MASTER_BTS2334_20120703 修正ここまで
   *************************************************/

  //========================================//

EVENT_END

//--------------------------------------------------------------------
//☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL  anm_staystep_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

/************************************************************/
/*	ＰＯＫＥ２３：話しかけ							*/
/************************************************************/
EVENT_START	ev_d26r0701_poke23_01
	_TALK_OBJ_START()
	//ゾロアーク：くあぁああああぁん！！
	_VOICE_PLAY( MONSNO_530, 0 ) 
	_BALLOONWIN_OBJMSG_POS( msg_d26r0701_poke23_02, D26R0701_POKE23_01, POS_DEFAULT )
	_VOICE_WAIT()
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()

	_SYSWIN_MSG( msg_d26r0701_poke23_03, POS_DOWN )
	_LAST_KEYWAIT()
	_SYSWIN_CLOSE()

EVENT_END
