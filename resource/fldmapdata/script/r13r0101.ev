  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_r13r0101.h"
  .include  "r13r0101.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_r13r0101_oldman_01
_EVENT_DATA    ev_r13r0101_girl1_01
_EVENT_DATA    ev_r13r0101_poke_01
_EVENT_DATA    ev_r13r0101_oldwoman_01
_EVENT_DATA_END


/**************************************************************/
/*  おじいさん：一言メッセージ		                      */
/**************************************************************/
EVENT_START   ev_r13r0101_oldman_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_r13_oldman_01 )
EVENT_END

/**************************************************************/
/*  おばあさん：一言メッセージ		                      */
/**************************************************************/
EVENT_START   ev_r13r0101_oldwoman_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_r13_oldwoman_01 )
EVENT_END

/**************************************************************/
/*  女の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_r13r0101_girl1_01
	
	//まだアイテム未入手の場合
	IF FLAG_OFF( FE_R13R0101_ITEMGET_01 ) THEN
	
		_TALK_OBJ_START()
	
		//このコ　むかしは　みんなに
		_BALLOONWIN_TALKOBJ_MSG_POS( msg_r13r0101_girl1_01, POS_DEFAULT )
	
		// ROMバージョン取得
		_GET_ROM_VERSION( SCWK_ANSWER )
		
		//ブラック２の場合
		IF $SCWK_ANSWER == VERSION_B2 THEN
			
			//パワーレンズ　あげる
			_BALLOONWIN_TALKOBJ_MSG_POS( msg_r13r0101_girl1_02b, POS_DEFAULT )
			_MSGWIN_CLOSE()
			
			_ITEM_EVENT_KEYWAIT( ITEM_PAWAARENZU, 1 )

		//ホワイト２の場合
		ELSE

			//パワーバンド　あげる
			_BALLOONWIN_TALKOBJ_MSG_POS( msg_r13r0101_girl1_02w, POS_DEFAULT )
			_MSGWIN_CLOSE()
			
			_ITEM_EVENT_KEYWAIT( ITEM_PAWAABANDO, 1 )
		
		ENDIF
		
		//ポケモンしょうぶで　つよくなくても
		_BALLOONWIN_TALKOBJ_MSG_POS( msg_r13r0101_girl1_03, POS_DEFAULT )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
		
		//========================================//
		//アイテム入手フラグセット
		_FLAG_SET( FE_R13R0101_ITEMGET_01 )
		//========================================//
		

	//すでにアイテムを入手している場合
	ELSE
	
		//ポケモンしょうぶで　つよくなくても
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_r13r0101_girl1_03 )

	ENDIF

EVENT_END

/**************************************************************/
/*  キャモメ：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_r13r0101_poke_01
  _EASY_TALK_POKEVOICE( MONSNO_278, msg_r13_poke_01 )
EVENT_END

