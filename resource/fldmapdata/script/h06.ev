  .text

  .include  "scr_seq_def.h"
  .include  "msg_h06.h"
  .include  "h06.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_h06
_EVENT_DATA   ev_h06_man3_01
_EVENT_DATA   ev_h06_fighterm_01
_EVENT_DATA   ev_h06_man3_02
_EVENT_DATA   ev_h06_soccerm_01
_EVENT_DATA   ev_h06_maid_01
_EVENT_DATA   ev_h06_lady_01
_EVENT_DATA   ev_h06_trainerw_01
_EVENT_DATA_END

//手持ちに「どくバリ」を持ったポケモンが要るか用変数定義
DEFINE_LOCAL LWK_PARTY_NUM    //手持ちポケモンの数
DEFINE_LOCAL LWK_COUNT_NUM    //WHILE文のカウンタ
DEFINE_LOCAL LWK_POKE_ITEMNO  //ポケモンの保持アイテムナンバー
DEFINE_LOCAL LWK_CLEAR_POKE   //条件を満たしたポケモンの有無
DEFINE_LOCAL LWK_EGG_CHK      //タマゴであるか


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
INIT_EVENT_START  ev_zone_h06
  // ギミック初期化
  _H06_GMK_INIT()
INIT_EVENT_END

/**************************************************************/
/*  太った兄さん：話しかけ（橋マニアイベント）                */
/**************************************************************/
EVENT_START   ev_h06_man3_01

  _TALK_OBJ_START()

  //おいしい水を渡す前
  IF $WK_SCENE_BRIDGE_MANIA_01 == 5 THEN

    //太った兄さん：のどが　かわいた……▼
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_h06_bridge_01,POS_UP )

    //アイテム「おいしいみず」をあげる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //かばんの中の「おいしいみず」を減らす
      _SUB_ITEM( ITEM_OISIIMIZU, 1, SCWK_ANSWER )

      //おいしいみずがある
      IF $SCWK_ANSWER == TRUE THEN

        _MSGWIN_CLOSE()

        //SE再生
        _SE_PLAY( SEQ_SE_ARDEMO_01 )
        _SE_WAIT()

        //太った兄さん：げんき　でてきたー！　ありがとう▼
        _BALLOONWIN_TALKOBJ_MSG_POS( msg_h06_bridge_02 , POS_UP )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

		DEFINE_LOCAL	LWK_INDEX
		DEFINE_LOCAL	LWK_FRONT
		DEFINE_LOCAL	LWK_SIDE

		//レール座標の取得
		_GET_PLAYER_RAIL_LOC( LWK_INDEX, LWK_FRONT, LWK_SIDE )

		IF $LWK_FRONT == 22 THEN
			_OBJ_ANIME( H06_MAN3_01, anm_man3_leave1 )
		ELSE
			_OBJ_ANIME( H06_MAN3_01, anm_man3_leave2 )
		ENDIF
		
		_TIME_WAIT( 20 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_ou )
		_OBJ_ANIME_WAIT()

		_OBJ_DEL( H06_MAN3_01 )

        //========================================//
        //イベント進行
        $WK_SCENE_BRIDGE_MANIA_01 = 6
        //ワンダーブリッジの橋マニア非表示
        _FLAG_SET( FV_H06_BRIDGE_MANIA_01 )
        //スカイアローブリッジの橋マニア表示
        _FLAG_RESET( FV_H01_BRIDGE_MANIA_01 )
        //========================================//

      //おいしいみずが無い
      ELSE

        //太った兄さん：でも　おいしいみず　ないよね……
        _BALLOONWIN_TALKOBJ_MSG_POS( msg_h06_bridge_03 , POS_UP )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //太った兄さん：おいしいみずが　ないと……
      _BALLOONWIN_TALKOBJ_MSG_POS( msg_h06_bridge_04 , POS_UP )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //おいしい水を渡した後
  ELSIF $WK_SCENE_BRIDGE_MANIA_01 == 6 THEN

    //太った兄さん：げんき　でてきたー！　ありがとう▼
    _BALLOONWIN_TALKOBJ_MSG_POS( msg_h06_bridge_02 , POS_UP )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

 //--------------------------------------------------------------------
//	●橋マニア：退場演出
//--------------------------------------------------------------------
_ANIME_LABEL	anm_man3_leave1
  _ANIME_DATA	AC_STAY_WALK_R_4F,4
  _ANIME_DATA	AC_WALK_R_4F,1
  _ANIME_DATA	AC_WALK_D_4F,13
  _ANIME_DATA	ACMD_END,0
 
_ANIME_LABEL	anm_man3_leave2
  _ANIME_DATA	AC_STAY_WALK_D_4F,4
  _ANIME_DATA	AC_WALK_D_4F,13
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_ou
  _ANIME_DATA	AC_DIR_D,1
  _ANIME_DATA	ACMD_END,0


/**************************************************************/
/*  カラテ王：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_h06_fighterm_01
  _TALK_OBJ_START()
  _BALLOONWIN_TALKOBJ_MSG_POS( msg_h06_fighterm_01, POS_UP )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
EVENT_END

/**************************************************************/
/*  男性：話しかけ                                            */
/**************************************************************/
EVENT_START   ev_h06_man3_02
  _TALK_OBJ_START()
  _BALLOONWIN_TALKOBJ_MSG_POS( msg_h06_man3_01, POS_UP )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
EVENT_END

/**************************************************************/
/*  サッカー選手：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_h06_soccerm_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h06_soccerm_01 )
EVENT_END

/**************************************************************/
/*  メイド：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_h06_maid_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h06_maid_01 )
EVENT_END

/**************************************************************/
/*  マダム：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_h06_lady_01
  _TALK_OBJ_START()
  _BALLOONWIN_TALKOBJ_MSG_POS( msg_h06_lady_01, POS_UP )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
EVENT_END

/**************************************************************/
/*  エリート♀：話しかけ（ポケモン見せ／アイテム入手）        */
/**************************************************************/
EVENT_START   ev_h06_trainerw_01

  _TALK_OBJ_START()

  //アイテム「くろいヘドロ」を既に受け取っている？
  IF FLAG_OFF( FE_H06_ITEMGET_01 ) THEN

    //手持ちのポケモンの数を確認（全てのポケモン）
    _GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_TOTAL )

    //手持ちのポケモンの中に条件『どくバリを持っている』ポケモンがいるか確認（繰り返し処理）
    WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

      //条件を満たしたポケモンは見つかったか
      IF $LWK_CLEAR_POKE == 0 THEN

        //指定POSのポケモンの「保持アイテムナンバー」を取得
        _GET_PARTY_POKE_PARAM( LWK_POKE_ITEMNO, LWK_COUNT_NUM, SCR_POKEPARA_ITEMNO )

        //指定POSのポケモンはタマゴか
        _CHECK_TEMOTI_EGG( LWK_EGG_CHK, LWK_COUNT_NUM )

        //指定POSのポケモンは「どくバリ」を持っているか
        IF $LWK_POKE_ITEMNO == $ITEM_DOKUBARI && $LWK_EGG_CHK == FALSE THEN

          //条件を満たしたポケモンの名前取得
          _TEMOTI_MONS_NAME( 0, LWK_COUNT_NUM )
          //条件を満たしたポケモンがいた（値セット）
          $LWK_CLEAR_POKE = 1

        ENDIF

      ENDIF

      //カウント
      $LWK_COUNT_NUM += 1

    ENDWHILE

    //手持ちに条件を満たしたポケモンがいた
    IF $LWK_CLEAR_POKE == 1 THEN

      //エリート♀：どくバリを　もってる！▼
      _BALLOONWIN_TALKOBJ_MSG( msg_h06_trainerw_02 )
      _MSGWIN_CLOSE()

      //アイテム（くろいヘドロ）入手
      _ITEM_EVENT_NOWAIT( ITEM_KUROIHEDORO, 1 )

      //========================================//
      //アイテム入手フラグON
      _FLAG_SET( FE_H06_ITEMGET_01 )
      //========================================//

    //手持ちに条件を満たしたポケモンがいない
    ELSE

      //エリート♀：どくバリを　もたせてる？
      _BALLOONWIN_TALKOBJ_MSG( msg_h06_trainerw_01 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //アイテム受け取り済み
  ELSE

    //エリート♀：くろいヘドロ！　それを　もって
    _BALLOONWIN_TALKOBJ_MSG( msg_h06_trainerw_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END


