
//======================================================================
//                c03r0601.ev
//
//    スクリプトファイル：c03r0601用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c03r0601.h"
  .include  "c03r0601.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_bg_c03r0601_board_01
_EVENT_DATA   ev_pos_c03r0601_swbell_01
_EVENT_DATA   ev_c03r0601_middleman2_01
_EVENT_DATA   ev_c03r0601_informationw_01
_EVENT_DATA   ev_zone_c03r0601
_EVENT_DATA   ev_init_c03r0601
_EVENT_DATA   ev_c03r0601_clown_01
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//主人公座標取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c03r0601
  
  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //バージョンごとに異なる接続を配置
  
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C03R0601_R04W_EXIT01, 9, 0, 11 )
  //W2
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_C03R0601_R04_EXIT01, 9, 0, 11 )
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c03r0601

//

INIT_EVENT_END

/**************************************************************/
/*  電光掲示板のイベントスクリプト                            */
/**************************************************************/
EVENT_START   ev_bg_c03r0601_board_01
  _LOOK_ELBOARD(ELBOARD_CAMERA_FRAME)
EVENT_END

/**************************************************************/
/*  POS:ベルからダウンジングマシンをもらう                    */
/**************************************************************/
EVENT_START   ev_pos_c03r0601_swbell_01

  //========================================//
  //ベルを表示
  _FLAG_RESET( FV_C03R0601_SWBELL_01 )
  //========================================//
  
  //階段SE
  _SE_PLAY( SEQ_SE_KAIDAN ) 
  _SE_WAIT()

  _OBJ_ADD( C03R0601_SWBELL_01 )  //ベル表示
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_E_BERU )

  //ベル：おうい（主人公の性別でセリフが異なる）
  _BALLOONWIN_OBJMSG_MF( msg_c03r0601_swbell_01, msg_c03r0601_swbell_02, C03R0601_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //主人公座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

  //アニメ：ベル接近
  $LCW_POSZ += 1
  _OBJ_ANIME_AUTO( C03R0601_SWBELL_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //ベル：まちなかを　あるく　あなたを
  _BALLOONWIN_OBJMSG_POS( msg_c03r0601_swbell_03, C03R0601_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アイテム入手：ダウジングマシン
  _ITEM_EVENT_KEYWAIT( ITEM_DAUZINGUMASIN, 1 )

  //ベル：ダウジングマシンを　つかえば
  _BALLOONWIN_OBJMSG_POS( msg_c03r0601_swbell_04, C03R0601_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ベル退場
  _OBJ_ANIME_AUTO( C03R0601_SWBELL_01, 5, 14, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( C03R0601_SWBELL_01 )
  
  //階段SE
  _SE_PLAY( SEQ_SE_KAIDAN ) 
  _SE_WAIT()
  
  //イベント曲終了
  _END_EVENT_BGM()

  //========================================//
  //ベルを非表示
  _FLAG_SET( FV_C03R0601_SWBELL_01 )
  //========================================//
  //POSイベント進行
  $WK_SCENE_C03R0601_SWBELL_01 = 1
  //========================================//
  //ダウジングマシンヒントメダル取得
  _SET_MEDAL_HINT_ACHIEVE( MDLID_DOWSING_LV1 )
  //========================================//

EVENT_END

/**************************************************************/
/*  おじさん：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_c03r0601_middleman2_01

  _TALK_OBJ_START()
  //おじさん：４ばんどうろの～（バージョンでセリフが異なる）
  _BALLOONWIN_OBJMSG_WB( msg_c03r0601_middleman2_01, msg_c03r0601_middleman2_02, C03R0601_MIDDLEMAN2_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  受付嬢：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c03r0601_informationw_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03r0601_infomatinonw_01 )
EVENT_END

/**************************************************************/
/*  ヒウンラリー：チェックポイント                                          */
/**************************************************************/
EVENT_START   ev_c03r0601_clown_01
{
  _TALK_OBJ_START()

  //ラリーイベント中の場合
  IF $WK_SCENE_C03_RALLY_01 != 6 THEN

    //クラウン：まだ　おとずれて　いないのは……
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0601_rally_03 )

    //全てのポイントをめぐっていた場合
    IF $WK_SCENE_C03_RALLY_01 == 5 THEN
      //クラウン：なんと！　のこり０！
      _BALLOONWIN_TALKOBJ_MSG( msg_c03r0601_rally_08 )
      _MSGWIN_CLOSE()

      //記念品受け取り
      _ITEM_EVENT_KEYWAIT( ITEM_HUSIGINAAME, 1 )
      
      //クラウン：なんと！　のこり０！
      _BALLOONWIN_TALKOBJ_MSG( msg_c03r0601_rally_09 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      
      //========================================//
      //クリア後メッセージ表示終了
      $WK_SCENE_C03_RALLY_01 = 6
      //========================================//

    ELSE
      //まだ訪れていない場所を数える用変数定義
      DEFINE_LOCAL LWK_POINT_NUM  //訪れていないポイントの数
      DEFINE_LOCAL LWK_COUNT_NUM  //WHILE文のカウンタ

      //訪れていない場所の確認処理（繰り返し処理）
      WHILE $LWK_COUNT_NUM < 3

        //メダル事務局におとずれていない
        IF $LWK_COUNT_NUM == 0 && FLAG_OFF( FE_C03_RALLYPOINT_01 ) THEN
          _BALLOONWIN_OBJMSG_POS( msg_c03r0601_rally_04, C03R0601_CLOWN_01, POS_DEFAULT )
          $LWK_POINT_NUM += 1 //ポイント加算

        //すれ違い調査隊におとずれていない
        ELSIF $LWK_COUNT_NUM == 1 && FLAG_OFF( FE_C03_RALLYPOINT_02 ) THEN
          _BALLOONWIN_OBJMSG_POS( msg_c03r0601_rally_05, C03R0601_CLOWN_01, POS_DEFAULT )
          $LWK_POINT_NUM += 1 //ポイント加算

        //バトルカンパニーにおとずれていない
        ELSIF $LWK_COUNT_NUM == 2 && FLAG_OFF( FE_C03_RALLYPOINT_03 ) THEN
          _BALLOONWIN_OBJMSG_POS( msg_c03r0601_rally_06, C03R0601_CLOWN_01, POS_DEFAULT )
          $LWK_POINT_NUM += 1 //ポイント加算

        ENDIF

        //カウント
        $LWK_COUNT_NUM += 1

      ENDWHILE

      //訪れていない場所の数値を指定タグにセット
      _NUMBER( 0, LWK_POINT_NUM, 1 )

      //クラウン：～の　X箇所　ですね
      _BALLOONWIN_TALKOBJ_MSG( msg_c03r0601_rally_07 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSE
    //クラウン：ヒウンを　あいする
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0601_rally_09 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF
}
EVENT_END


//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0


