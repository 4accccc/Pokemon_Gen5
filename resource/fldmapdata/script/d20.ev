
//======================================================================
//                d20.ev
//
//    スクリプトファイル：d20用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d20.h"
  .include  "d20.h"
  
  //@author Mizuguchi_Mai
  //@author fujimura_souichirou（ブルンゲルイベント）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_d20
_EVENT_DATA   ev_d20_wkobjcode00_poke_01
_EVENT_DATA   ev_pos_d20_localtvt_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL LCW_POSX
DEFINE_LOCAL LCW_POSZ

//曜日取得変数
DEFINE_LOCAL LWK_WEEKCK
//バージョン取得変数
DEFINE_LOCAL LCWK_VERSION


/************************************************************/
/*  ZONE_CHANGE_SCRIPT                                      */
/************************************************************/
INIT_EVENT_START  ev_zone_d20

  //曜日を取得
  _GET_WEEK( LWK_WEEKCK )

  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )

  //B2バージョンで月曜日ならば、ブルンゲル♂が出現（１週間に１匹のみ）
  IF $LCWK_VERSION == VERSION_B2 && $LWK_WEEKCK == RTC_WEEK_MONDAY && FLAG_OFF( TMFLG_D20_POKE_536_MEET ) THEN

    //==================================//
    //ブルンゲル表示
    _FLAG_RESET( FV_D20_POKE_536_01 )
    //==================================//

    //可変OBJの見た目をブルンゲル♂に
    $OBJCHRWORK0 = POKE47


  //W2バージョンで木曜日ならば、ブルンゲル♀が出現（１週間に１匹のみ）
  ELSIF $LCWK_VERSION == VERSION_W2 && $LWK_WEEKCK == RTC_WEEK_THURSDAY && FLAG_OFF( TMFLG_D20_POKE_536_MEET ) THEN

    //==================================//
    //ブルンゲル表示
    _FLAG_RESET( FV_D20_POKE_536_01 )
    //==================================//

    //可変OBJの見た目をブルンゲル♀に
    $OBJCHRWORK0 = POKE48

  //それ以外の曜日は非表示に
  ELSE

    //==================================//
    //ブルンゲル表示
    _FLAG_SET( FV_D20_POKE_536_01 )
    //==================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  ブルンゲル：話しかけ（戦闘／毎週指定された曜日に出現）    */
/**************************************************************/
EVENT_START   ev_d20_wkobjcode00_poke_01

  _TALK_OBJ_START()

  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )

  //B2バージョンならばブルンゲル♂
  IF $LCWK_VERSION == VERSION_B2 THEN

    //ブルンゲル：ぶるうッ！！
    _VOICE_PLAY( MONSNO_536, 0 ) 
    _GIZAPLAINWIN_MSG_POS( msg_d20_poke47_01, POS_DOWN )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()

    //戦闘開始
    {
      DEFINE_LOCAL LWK_BTL_FLAG
      $LWK_BTL_FLAG = SCR_WILD_BTL_FLAG_WILD_TALK   //野生話しかけ戦闘メッセージ
      $LWK_BTL_FLAG |= SCR_WILD_BTL_FLAG_SPEABI3    //第３特性指定
      $LWK_BTL_FLAG |= SCR_WILD_BTL_FLAG_MALE       //♂と戦闘
      _WILD_BTL_SET_EX( MONSNO_536, 40, LWK_BTL_FLAG )   //Lv.40 ブルンゲル♂
    }

  //W2バージョンならばブルンゲル♀
  ELSIF $LCWK_VERSION == VERSION_W2 THEN

    //ブルンゲル：ぶるぅ♪
    _VOICE_PLAY( MONSNO_536, 0 ) 
    _GIZAPLAINWIN_MSG_POS( msg_d20_poke48_01, POS_DOWN )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()

    //戦闘開始
    {
      DEFINE_LOCAL LWK_BTL_FLAG
      $LWK_BTL_FLAG = SCR_WILD_BTL_FLAG_WILD_TALK   //野生話しかけ戦闘メッセージ
      $LWK_BTL_FLAG |= SCR_WILD_BTL_FLAG_SPEABI3    //第３特性指定
      $LWK_BTL_FLAG |= SCR_WILD_BTL_FLAG_FEMALE     //♀と戦闘
      _WILD_BTL_SET_EX( MONSNO_536, 40, LWK_BTL_FLAG )   //Lv.40 ブルンゲル♀
    }

  ENDIF

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //ブルンゲル非表示
    _FLAG_SET( FV_D20_POKE_536_01 )
    //フラグON
    _FLAG_SET( TMFLG_D20_POKE_536_MEET )
    //==================================//
    _OBJ_DEL( D20_WKOBJCODE00_POKE_01 )   //ブルンゲルを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //ブルンゲルを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //倒した場合、あるいは逃げた場合

    //ROMのバージョンを取得
    _GET_ROM_VERSION( LCWK_VERSION )

    //ブルンゲルを捕獲できなかった場合の分岐（B2）
    IF $LCWK_VERSION == VERSION_B2 THEN

      //システム：ブルンゲルは
      _SYSWIN_MSG( msg_d20_poke47_02, POS_DOWN )
      _LAST_KEYWAIT()
      _SYSWIN_CLOSE()

    //ブルンゲルを捕獲できなかった場合の分岐（W2）
    ELSIF $LCWK_VERSION == VERSION_W2 THEN

      //システム：ブルンゲルは
      _SYSWIN_MSG( msg_d20_poke48_02, POS_DOWN )
      _LAST_KEYWAIT()
      _SYSWIN_CLOSE()

    ENDIF

  ENDSWITCH

EVENT_END


/**************************************************************/
/*		ライブキャスターイベント					  */
/**************************************************************/
EVENT_START		ev_pos_d20_localtvt_01
	
	//TVT着信音を再生
	_ME_PLAY( SEQ_ME_CALL )
	_SYSWIN_MSG( msg_d20_tvt_01, POS_DOWN )
	_ME_WAIT()
 
	_PLAYER_NAME(0)
	_SYSWIN_MSG( msg_d20_tvt_02, POS_DOWN )
	_MSGWIN_CLOSE()
	
	//ライブキャスター起動
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()
  _CALL_TVT_DEMO( 8 )
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()
  
	
	//========================================/
	
	//ライブキャスターイベント終了
	$WK_SCENE_T04_D20_TVT = 2
	
	//========================================/
	
EVENT_END

