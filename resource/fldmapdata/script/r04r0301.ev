  .text

  .include  "scr_seq_def.h"
  .include  "msg_r04r0301.h"
  .include  "r04r0301.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_r04r0301_workman2_01
_EVENT_DATA   ev_r04r0301_poke49_01
_EVENT_DATA   ev_r04r0301_girl2_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_r04r0301:
//  _END

/**************************************************************/
/*  働くおじさん：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_r04r0301_workman2_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r04r0301_workman2_01 )
EVENT_END

/**************************************************************/
/*  ダンゴロ：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_r04r0301_poke49_01
  _EASY_TALK_POKEVOICE( MONSNO_600, msg_r04r0301_poke49_01 )
EVENT_END

/**************************************************************/
/*  女の子：話しかけ（ポケモン交換）                          */
/**************************************************************/
EVENT_START   ev_r04r0301_girl2_01
{
  _TALK_OBJ_START()

  //ポケモン交換済みか
  IF FLAG_ON( FE_R04_POKETRADE_01 ) THEN

    //交換したしたポケモンのニックネーム取得【仮】ニックネームを取得する方法がまだ仮
    //_MONS_NAME( 0, SCR_TRPOKE_AFTER_SAVE_C05 )

    //女の子：あなたが　つけた　ニックネーム！
    _BALLOONWIN_TALKOBJ_MSG( msg_r04r0301_girl2_06 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE

    //女の子：きみの　ウソハチと
    _BALLOONWIN_TALKOBJ_MSG( msg_r04r0301_girl2_01 )

    //ウソハチとマネネを交換する？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == 0 THEN    //はい

      _MSGWIN_CLOSE()

      //選択ポケモン格納変数定義
      DEFINE_LOCAL LWK_CHOICE
      //キャンセルしたか結果格納変数定義
      DEFINE_LOCAL LWK_SELECT_RESULT

      //ポケモン選択画面開く
      _SELECT_TEMOTI_POKE( LWK_SELECT_RESULT, LWK_CHOICE, 0 )

      //ポケモンを選択したか
      IF $LWK_SELECT_RESULT == TRUE THEN

        //要望と一致してるかチェック結果格納変数定義
        DEFINE_LOCAL LWK_TRADE_CHECK

        //選択したポケモンが交換可能かチェック
        _FIELD_POKE_TRADE_CHECK ( LWK_TRADE_CHECK, FLD_TRADE_POKE_25_TYURINE, LWK_CHOICE )

        //交換可能であるか
        IF $LWK_TRADE_CHECK == FLD_TRADE_ENABLE THEN

          //ポケモンのニックネームを格納【仮】格納先を勝手に借りている←停止したのでコメントアウト中
          //_SET_WORD_TRADEAFTER_POKENAME( SCR_TRPOKE_AFTER_SAVE_C05, 0 )

          //女の子：ポケモンこうかん！
          _BALLOONWIN_TALKOBJ_MSG( msg_r04r0301_girl2_02 )
          _MSGWIN_CLOSE()

          //交換処理
          _FIELD_POKE_TRADE ( FLD_TRADE_POKE_25_TYURINE, LWK_CHOICE )

          //女の子：きみの　ウソハチと
          _BALLOONWIN_TALKOBJ_MSG( msg_r04r0301_girl2_03 )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()

          //==================================//
          //交換完了
          _FLAG_SET ( FE_R04_POKETRADE_01 )
          //==================================//

        //条件と一致しなかった
        ELSE

          //女の子：あたしが　ほしい　ポケモンは
          _BALLOONWIN_TALKOBJ_MSG( msg_r04r0301_girl2_04 )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()

        ENDIF

      //選択キャンセル
      ELSE

        //女の子：そっか……▼
        _BALLOONWIN_TALKOBJ_MSG( msg_r04r0301_girl2_05 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //女の子：そっか……▼
      _BALLOONWIN_TALKOBJ_MSG( msg_r04r0301_girl2_05 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF
}
EVENT_END


