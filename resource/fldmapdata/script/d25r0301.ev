//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_pos_d25r0301_girl2_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_d25r0301:
//  _END

/**************************************************************/
/*  POS:幽霊少女イベント                                      */
/**************************************************************/
EVENT_START   ev_pos_d25r0301_girl2_01

  _TIME_WAIT ( 16 )

  _TALK_START_SE_PLAY()

  //==================================//
  //幽霊少女表示
  _FLAG_RESET( FV_D25_GIRL2_01 )
  //==================================//

  //女の子出現
  _OBJ_ADD( D25R0301_GIRL2_01 )

  _TIME_WAIT ( 8 )

  //幽霊少女：いつまでも　まっくろの　ゆめ……
  _BALLOONWIN_OBJMSG_POS( msg_d25r0301_girl2_01, D25R0301_GIRL2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _TIME_WAIT ( 16 )

  //女の子を非表示
  _OBJ_DEL( D25R0301_GIRL2_01 )

  //========================================//
  //幽霊少女非表示
  _FLAG_SET( FV_D25_GIRL2_01 )
  //POSイベント進行
  $WK_SCENE_D05_GIRL2 = 1
  //========================================//

EVENT_END


