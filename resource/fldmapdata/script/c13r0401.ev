  .text

  .include  "scr_seq_def.h"
  .include  "msg_c13r0401.h"
  .include  "c13r0401.h"
  
  .include  "c03p15_def.h"
  
  //@author suginaka_katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_c13r0401_boy1_01
_EVENT_DATA		ev_c13r0401_veteranw_01
_EVENT_DATA		ev_c13r0401_pilot_01
_EVENT_DATA		ev_c13r0401_swrival_01
_EVENT_DATA		ev_reserve_c13r0401_end
_EVENT_DATA_END

/************************************************************/
/*		飛行機降りた後のリザーブ						*/
/************************************************************/
EVENT_START	ev_reserve_c13r0401_end

	//暗転復帰
	_MAP_FADE_BLACK_IN()
	_DISP_FADE_END_CHECK()
	
EVENT_END


/**************************************************************/
/*		C13R0401	BOY1	一言メッセージ					  */
/**************************************************************/
EVENT_START		ev_c13r0401_boy1_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c13r0401_boy1_01 )
EVENT_END

/**************************************************************/
/*		C13R0401	VETERANW	分岐メッセージ				  */
/**************************************************************/
EVENT_START		ev_c13r0401_veteranw_01
_TALK_OBJ_START()
	
	//船長がいない場合
	IF FLAG_ON( FV_C13R0401_PILOT ) THEN
		_BALLOONWIN_TALKOBJ_MSG( msg_c13r0401_veteranw_01 )	
	//船長がいる場合
	ELSE
		_BALLOONWIN_TALKOBJ_MSG( msg_c13r0401_veteranw_02 )
	ENDIF
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
EVENT_END

/**************************************************************/
/*		C13R0401	PILOT		出航イベント				  */
/**************************************************************/
EVENT_START		ev_c13r0401_pilot_01
_TALK_OBJ_START()

	//おや？　どうなさいました
	_BALLOONWIN_OBJMSG_POS( msg_c13r0401_pilot_01 , C13R0401_PILOT_01, POS_DOWN )
	
	//はい/いいえ分岐
	_YES_NO_WIN( SCWK_ANSWER )

	//はいの場合
	IF $SCWK_ANSWER == SCR_YES THEN

		//よろしいですとも！
		_BALLOONWIN_OBJMSG_POS( msg_c13r0401_pilot_02 , C13R0401_PILOT_01, POS_DOWN )
		_MSGWIN_CLOSE()
		
		//３Ｄデモコール
		_DEMO_FADEOUT_BLACK_CALL_SINGLE()
		_CALL_3D_DEMO( DEMO3D_ID_TACHIWAKI_SHIP_SHORT )

		//リザーブスクリプト
		_RESERVE_SCRIPT( SCRID_RESERVE_C03P15_END )

		//マップチェンジ
		_MAP_CHANGE_NO_FADE( ZONE_ID_C03P15, 12, 0, 10, DIR_LEFT )

	//いいえの場合
	ELSE
		
		//わかりました！　のりたくなったときは
		_BALLOONWIN_OBJMSG_POS( msg_c13r0401_pilot_03 , C13R0401_PILOT_01, POS_DOWN )	
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()

	ENDIF

EVENT_END

/**************************************************************/
/*		C13R0401	SWRIVAL		出航イベント				  */
/**************************************************************/
EVENT_START		ev_c13r0401_swrival_01
_TALK_OBJ_START()

	//ライバルの名前格納
	_RIVAL_NAME( 1 )

	//オマエ　ヒウンに　いくんだろ？
	_BALLOONWIN_OBJMSG_POS( msg_c13r0401_swrival_01 , C13R0401_SWRIVAL_01, POS_DOWN )
	
	//はい/いいえ分岐
	_YES_NO_WIN( SCWK_ANSWER )

	//はいの場合
	IF $SCWK_ANSWER == SCR_YES THEN

		//プラズマだん　おいかけるからな
		_BALLOONWIN_OBJMSG_POS( msg_c13r0401_swrival_02 , C13R0401_SWRIVAL_01, POS_DOWN )
		_MSGWIN_CLOSE()
		
		//スワンライバル：上を向いて
		_OBJ_ANIME( C13R0401_SWRIVAL_01, anm_staystep_u )
		_OBJ_ANIME_WAIT()
		
		//な！　ヒウンいきの　ふね
		_BALLOONWIN_OBJMSG_POS( msg_c13r0401_swrival_03 , C13R0401_SWRIVAL_01, POS_DOWN )
		_MSGWIN_CLOSE()
		
		_PLAYER_DIR_GET(SCWK_ANSWER)
		
		SWITCH $SCWK_ANSWER
		CASE DIR_LEFT,DIR_RIGHT THEN
			//プレイヤー：上を向く
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
			_OBJ_ANIME_WAIT()
		ENDSWITCH

		//よろしいですとも！
		_BALLOONWIN_OBJMSG_POS( msg_c13r0401_pilot_02 , C13R0401_PILOT_01, POS_DOWN )
		_MSGWIN_CLOSE()
		
		//３Ｄデモコール
		_DEMO_FADEOUT_BLACK_CALL_SINGLE()
		_CALL_3D_DEMO( DEMO3D_ID_TACHIWAKI_SHIP )

		//スワンライバルのOBJを削除する
		_OBJ_DEL( C13R0401_SWRIVAL_01 )
		
		//マップ差し替え：C03P15アジト船出現
		_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, TRUE, TRUE )

		//マップチェンジ
		_MAP_CHANGE_NO_FADE( ZONE_ID_C03P15, 12, 0, 10, DIR_LEFT )

		//========================================/
		
		//スワンライバルのバニシュフラグをセットする
		_FLAG_SET(FV_C13R0401_SWRIVAL)
		
		//C03P15到着時イベント起動
		$WK_SCENE_C03P15 = 1

		//========================================/

	//いいえの場合
	ELSE
		
		//なんだよ！
		_BALLOONWIN_OBJMSG_POS( msg_c13r0401_swrival_04 , C13R0401_SWRIVAL_01, POS_DOWN )	
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()

	ENDIF

EVENT_END

//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_staystep_u
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_d
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_l
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_r
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0