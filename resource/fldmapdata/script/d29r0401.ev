
//======================================================================
//                d29r0401.ev
//
//    スクリプトファイル：d29r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d29r0401.h"
  .include  "d29r0401.h"
  .include  "d29r0501_def.h"
  .include  "d29r0601_def.h"
  .include  "d29r0701_def.h"
  .include  "d29r0801_def.h"
  .include  "d29r0901_def.h"

	//@author ichiraku_katsuhiko //仕組作成
	//@author suginaka_katsunori //演出修正

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA     ev_zone_d29r0401
_EVENT_DATA     ev_init_d29r0401
_EVENT_DATA     ev_recover_d29r0401
_EVENT_DATA     ev_pos_d29r0401_door_in
_EVENT_DATA     ev_reserve_d29r0401_door_out
_EVENT_DATA     ev_bg_d29r0401_switch
_EVENT_DATA     ev_d29r0401_espm_01
_EVENT_DATA_END


//------------------------------注意--------------------------------//
// ローカルワークを使用しています。
// 
// LOCALWORK0⇒接続先ID
//              0:午前の間
//              1:午後の間
//              2:岩山の間
//              3:鉄の間
//              4:氷山の間
//
// LOCALWORK1⇒レジロックのスイッチ
//              0:押していない
//              1:押している
//------------------------------------------------------------------//


/************************************************************/
/*          ZONE_CHANGE_LABEL                               */
/************************************************************/
INIT_EVENT_START  ev_zone_d29r0401

INIT_EVENT_END

/************************************************************/
/*          FIELD_INIT_LABEL                                */
/************************************************************/
INIT_EVENT_START  ev_init_d29r0401
  // フィールド初期化
  _CALL sub_field_init
INIT_EVENT_END

/************************************************************/
/*          FIELD_RECOVER_LABEL                             */
/************************************************************/
INIT_EVENT_START  ev_recover_d29r0401
  // フィールド初期化
  _CALL sub_field_init
INIT_EVENT_END

//------------------------------------------------------------
//  フィールド初期化
//------------------------------------------------------------
sub_field_init:
{
  // 接続先取得
  _CALL sub_get_connect_door

  // 巨人の眼の色を設定
  SWITCH $LOCALWORK0
  CASE 0 THEN   // 午前の間
  CASE 1 THEN   // 午後の間
    _REZI_GMK_SET_EYE(3)
  CASE 2 THEN   // 岩山の間
    _REZI_GMK_SET_EYE(0)
  CASE 3 THEN   // 鉄の間
    _REZI_GMK_SET_EYE(1)
  CASE 4 THEN   // 氷山の間
    _REZI_GMK_SET_EYE(2)
  DEFAULT // 午前の間と同じにしておく
    _REZI_GMK_SET_EYE(3)
  ENDSWITCH

}
_RET


/************************************************************/
/*  POS：ドアにはいる       */
/************************************************************/
EVENT_START   ev_pos_d29r0401_door_in

  //ローカル変数を定義
  DEFINE_LOCAL	LWK_HERO_X
  DEFINE_LOCAL	LWK_HERO_Z
  //自機の位置取得
  _PLAYER_POS_GET( LWK_HERO_X,LWK_HERO_Z )

  // 主人公中央へ
  SWITCH $LWK_HERO_X
  CASE 13 THEN
	  _OBJ_ANIME( MMDL_ID_PLAYER, anm_x13 )
  CASE 14 THEN
	  _OBJ_ANIME( MMDL_ID_PLAYER, anm_x14 )
  CASE 16 THEN
	  _OBJ_ANIME( MMDL_ID_PLAYER, anm_x16 )
  CASE 17 THEN
	  _OBJ_ANIME( MMDL_ID_PLAYER, anm_x17 )
  ENDSWITCH
  _OBJ_ANIME_WAIT()

  // カメラを操作
  _CAMERA_START()
  _CAMERA_PURGE()//
  _CAMERA_MOVE( 5720,0,970752,1015808,0,86016, 40 )
  _CAMERA_WAIT_MOVE()

  // ドアが開く
  _REZI_GMK_SET_DOOR(0)
  _REZI_GMK_ANM_DOOR(1)

  // ドアが開くSE
  _SE_PLAY( SEQ_SE_FLD_144 )

  _TIME_WAIT( 30 )

  // 主人公入る
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_door_in )

  _TIME_WAIT( 10 )

  // ブラックアウトフェード
  _MAP_FADE_BLACK_OUT_SLOW()

  _OBJ_ANIME_WAIT()
  // フェード終了チェック
  _MAP_FADE_END_CHECK()
  
  // カメラ戻し
  _CAMERA_BIND()	//カメラバインド
  _CAMERA_END()		//カメラ操作終了

  // 接続先取得
  _CALL sub_get_connect_door

  // マップチェンジ
  SWITCH $LOCALWORK0
  CASE 0 THEN   // 午前の間
	  //予約スクリプト
	  _RESERVE_SCRIPT( SCRID_RESERVE_D29R0501_DOOR_OUT )
    // マップチェンジ
    _MAP_CHANGE_NO_FADE( ZONE_ID_D29R0501, 15, 0, 61, DIR_UP )

  CASE 1 THEN   // 午後の間
	  //予約スクリプト
	  _RESERVE_SCRIPT( SCRID_RESERVE_D29R0601_DOOR_OUT )
    // マップチェンジ
    _MAP_CHANGE_NO_FADE( ZONE_ID_D29R0601, 15, 0, 61, DIR_UP )

  CASE 2 THEN   // 岩山の間
	  //予約スクリプト
	  _RESERVE_SCRIPT( SCRID_RESERVE_D29R0701_DOOR_OUT )
    // マップチェンジ
    _MAP_CHANGE_NO_FADE( ZONE_ID_D29R0701, 15, 0, 61, DIR_UP )

  CASE 3 THEN   // 鉄の間
	  //予約スクリプト
	  _RESERVE_SCRIPT( SCRID_RESERVE_D29R0801_DOOR_OUT )
    // マップチェンジ
    _MAP_CHANGE_NO_FADE( ZONE_ID_D29R0801, 15, 0, 61, DIR_UP )

  CASE 4 THEN   // 氷山の間
	  //予約スクリプト
	  _RESERVE_SCRIPT( SCRID_RESERVE_D29R0901_DOOR_OUT )
    // マップチェンジ
    _MAP_CHANGE_NO_FADE( ZONE_ID_D29R0901, 15, 0, 61, DIR_UP )

  DEFAULT // 午前の間に飛ばすことにする
	  //予約スクリプト
	  _RESERVE_SCRIPT( SCRID_RESERVE_D29R0501_DOOR_OUT )
    // マップチェンジ
    _MAP_CHANGE_NO_FADE( ZONE_ID_D29R0501, 15, 0, 61, DIR_UP )

  ENDSWITCH

EVENT_END

//------------------------------------------------------------
// アニメ:ドアに入る
//------------------------------------------------------------
_ANIME_LABEL  anm_door_in
  _ANIME_DATA AC_WALK_U_16F,2
  _ANIME_DATA ACMD_END,0
//------------------------------------------------------------
// アニメ:中央に行く
//------------------------------------------------------------
_ANIME_LABEL  anm_x13
  _ANIME_DATA AC_WALK_R_8F,2
  _ANIME_DATA AC_DIR_U,1
  _ANIME_DATA ACMD_END,0
_ANIME_LABEL  anm_x14
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_DIR_U,1
  _ANIME_DATA ACMD_END,0
_ANIME_LABEL  anm_x16
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_DIR_U,1
  _ANIME_DATA ACMD_END,0
_ANIME_LABEL  anm_x17
  _ANIME_DATA AC_WALK_L_8F,2
  _ANIME_DATA AC_DIR_U,1
  _ANIME_DATA ACMD_END,0


//------------------------------------------------------------
//  接続先取得
//    
//  LOCALWORK0に接続先IDを格納
//------------------------------------------------------------
sub_get_connect_door:
{
  DEFINE_LOCAL LWK_KEYSYS_DOOR

  // キーシステムに設定してあるドアを取得
  _KEYSYS_GET_DOOR( LWK_KEYSYS_DOOR )
  // 時間の取得
	_GET_TIME( SCWK_TEMP0, SCWK_TEMP1 )

  // 接続分岐
  IF $LOCALWORK1 == 1 THEN
    // 岩山の間 最優先
    $LOCALWORK0 = 2

  ELSIF $LWK_KEYSYS_DOOR == KEYSYS_DOOR_BLACK THEN
    // 氷山の間
    $LOCALWORK0 = 4

  ELSIF $LWK_KEYSYS_DOOR == KEYSYS_DOOR_WHITE THEN
    // 鉄の間
    $LOCALWORK0 = 3

  ELSIF $SCWK_TEMP0 >= 0 && $SCWK_TEMP0 <12 THEN
    // 午前の間
    $LOCALWORK0 = 0

  ELSE
    // 午後の間
    $LOCALWORK0 = 1

  ENDIF

  _DEBUG_PRINT_WK( LOCALWORK0 )
}
_RET


/************************************************************/
/*  リザーブスクリプト：ドアからでる       */
/************************************************************/
EVENT_START   ev_reserve_d29r0401_door_out

  // ドアを閉まった状態に
  _REZI_GMK_SET_DOOR(1)

  // カメラ位置を設定しておく
  _CAMERA_START()
  _CAMERA_PURGE()
  _CAMERA_MOVE( 5720,0,970752,1015808,0,86016, 1 )
  _CAMERA_WAIT_MOVE()

  // ブラックインフェード
  _MAP_FADE_BLACK_IN_SLOW()

  // 主人公出る
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_door_out )

  _TIME_WAIT(20)

  // ドアが閉まる
  _REZI_GMK_ANM_DOOR(0)
  // ドアが開くSE
  _SE_PLAY( SEQ_SE_FLD_144 )

  _OBJ_ANIME_WAIT()
  // フェード終了チェック
  _MAP_FADE_END_CHECK()

  // ドアが閉まるまで待つ
  _TIME_WAIT(15)

  _SE_STOP()

  _CAMERA_DEF_MOVE( 10 )
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()	//カメラバインド
  _CAMERA_END()		//カメラ操作終了

EVENT_END

//------------------------------------------------------------
// アニメ:ドアから出る
//------------------------------------------------------------
_ANIME_LABEL  anm_door_out
  _ANIME_DATA AC_WALK_D_16F,3
  _ANIME_DATA ACMD_END,0


/************************************************************/
/*  BGイベント：レジロックのスイッチ       */
/************************************************************/
EVENT_START   ev_bg_d29r0401_switch

  // 押していないときのみ
  IF $LOCALWORK1 == 0 THEN

	  _TALK_START_SE_PLAY()

    // あしもとに　ふるい　スイッチがある！　ふんでみますか？
    _PLAINWIN_MSG_DOWN( msg_d29r0401_switch_01 )

    // YES NO
    _YES_NO_WIN( SCWK_ANSWER )
  
    // はい
    IF $SCWK_ANSWER == SCR_YES THEN
      DEFINE_LOCAL LWK_KEYSYS_DOOR

      // キーシステムに設定してあるドアを取得
      _KEYSYS_GET_DOOR( LWK_KEYSYS_DOOR )

      // スイッチの音
      _SE_PLAY( SEQ_SE_FLD_44 )
      _SE_WAIT()

      // キーを設定していないときのみ作動する
      IF $LWK_KEYSYS_DOOR == KEYSYS_DOOR_NORMAL THEN

	   _PLAINWIN_CLOSE()
	   
        // 画面をゆらす
        _SE_PLAY( SEQ_SE_BE_SE_033 )
        _SHAKE_CAMERA( 6, 0, 3, 10, 1, 0, 1, 3)

        // 暗転
        _BLACK_OUT_SLOW()
        _DISP_FADE_END_CHECK()

        // 巨人の眼を赤色に変更
        _REZI_GMK_SET_EYE(0)
        _TIME_WAIT(60)

        _BLACK_IN_SLOW()
        _DISP_FADE_END_CHECK()

        // どびらの　むこうがわで　おもおもしい　おとが　ひびいた・・・
        _PLAINWIN_MSG_DOWN( msg_d29r0401_switch_02 )

        // スイッチ押した
        $LOCALWORK1 = 1

      ELSE
        // どうやら　なにも　おこらないようだ
        _PLAINWIN_MSG_DOWN( msg_d29r0401_switch_03 )
      ENDIF

      _LAST_KEYWAIT()

    ENDIF

	  _PLAINWIN_CLOSE()

  ENDIF

EVENT_END

/************************************************************/
/* OBJ：サイキッカー                                        */
/************************************************************/
EVENT_START   ev_d29r0401_espm_01

  // 時間の取得
	_GET_TIME( SCWK_TEMP0, SCWK_TEMP1 )

  // 午前
  IF $SCWK_TEMP0 >= 0 && $SCWK_TEMP0 <12 THEN
	  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d29r0401_espm_01 )
  ELSE
  // 午後
	  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d29r0401_espm_02 )
  ENDIF

EVENT_END


