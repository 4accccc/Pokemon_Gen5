
//======================================================================
//                d29r0401.ev
//
//    スクリプトファイル：d29r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d29r0401.h"
  .include  "d29r0401.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_d29r0401_poke1_01
_EVENT_DATA   ev_d29r0401_poke2_01
_EVENT_DATA   ev_d29r0401_poke3_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_d29r0401:
//  _END

/**************************************************************/
/*  レジアイス：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
/**************************************************************/
EVENT_START   ev_d29r0401_poke1_01

  _TALK_START_SE_PLAY()

  //システム：こおりの　ちからを　かんじさせる
  _SYSWIN_MSG( msg_d29r0401_poke1_01, POS_DOWN )
  _SYSWIN_CLOSE()

  //レジアイス：ぎゃぎー！！
  _VOICE_PLAY( MONSNO_378, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_d29r0401_poke1_02, POS_DOWN )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  // Lv.60 レジアイス
  _WILD_BTL_SET_LEGEND( MONSNO_378, 60 )

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //レジアイス非表示
    _FLAG_SET( FV_D29R0401_POKE1_01 )
    //==================================//
    _OBJ_DEL( D29R0401_POKE1_01 )   //レジアイスを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //レジアイスを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合

    //==================================//
    //レジアイスを捕獲した
    _FLAG_SET( FE_D29R0401_POKE1_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

    //システム：レジアイスは　こうどうの
    _SYSWIN_MSG( msg_d29r0401_poke1_03, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDSWITCH

EVENT_END

/**************************************************************/
/*  レジロック：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
/**************************************************************/
EVENT_START   ev_d29r0401_poke2_01

  _TALK_START_SE_PLAY()

  //システム：いわの　ちからを　かんじさせる
  _SYSWIN_MSG( msg_d29r0401_poke2_01, POS_DOWN )
  _SYSWIN_CLOSE()

  //レジロック：ざざ　ざり　ざ……
  _VOICE_PLAY( MONSNO_377, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_d29r0401_poke2_02, POS_DOWN )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  // Lv.60 レジロック
  _WILD_BTL_SET_LEGEND( MONSNO_377, 60 )

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //レジロック非表示
    _FLAG_SET( FV_D29R0401_POKE2_01 )
    //==================================//
    _OBJ_DEL( D29R0401_POKE2_01 )   //レジロックを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //レジロックを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合

    //==================================//
    //レジロックを捕獲した
    _FLAG_SET( FE_D29R0401_POKE2_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

    //システム：レジロックは　こうどうの
    _SYSWIN_MSG( msg_d29r0401_poke2_03, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDSWITCH

EVENT_END

/**************************************************************/
/*  レジスチル：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
