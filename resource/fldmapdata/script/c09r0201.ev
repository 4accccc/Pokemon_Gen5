
//======================================================================
//                c09r0201.ev
//
//    スクリプトファイル：c09r0201用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0201.h"
  .include  "c09r0201.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori //スクリプト修正

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_c09r0201
_EVENT_DATA   ev_init_c09r0201
_EVENT_DATA   ev_recover_c09r0201
_EVENT_DATA   ev_c09r0201_bigfour2_01
_EVENT_DATA   ev_pos_c09r0201_enter_01
_EVENT_DATA   ev_pos_c09r0201_enter_02
_EVENT_DATA   ev_pos_c09r0201_warp_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//                                                                  //
//  LOCALWORK0 をギミックの制御に使用しています。                   //
//    0 = 階段下のPOSイベント有効                                   //
//  LOCALWORK1 をギミックの制御に使用しています。                   //
//    0 = 階段上のPOSイベント有効                                   //
//  LOCALWORK10 をギミックの制御に使用しています。マップ内使用禁止  //
//    555 = POSイベント有効                                         //
//                                                                  //
//------------------------------------------------------------------//


/************************************************************/
/*  ZONE_CHANGE_LABEL                                       */
/************************************************************/
INIT_EVENT_START  ev_zone_c09r0201

  //四天王（あく）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) THEN
    $LOCALWORK10 = 555
  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_c09r0201
/*
  //あく　音開始
  //一番上で呼んでください
  _FOURKINGS_SET_SOUND_SYSTEM( 2 )
*/
  //四天王（あく）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) THEN

    //配置モデルのアニメをループ再生
    _BMODEL_DIRECT_ANIME_SET_LOOP( SCR_BMID_WARP, 19, 7 )

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_RECOVER_LABEL                                     */
/************************************************************/
INIT_EVENT_START  ev_recover_c09r0201
/*
  //あく　音開始 
  //一番上で呼んでください
  _FOURKINGS_SET_SOUND_SYSTEM( 2 )
*/
  //主人公が頂上にいるときの処理
  IF $LOCALWORK1 == 1 THEN
    //レールOFF
    _FOURKINGS_RAIL_OFF( 2 )
    //カメラ設定を変更
    _FOURKINGS_SET_TOP_CAMERA( 2 )
  ENDIF

  //四天王（あく）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) THEN

    //配置モデルのアニメをループ再生
    _BMODEL_DIRECT_ANIME_SET_LOOP( SCR_BMID_WARP, 19, 7 )

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  四天王（あく）                                          */
/************************************************************/
EVENT_START   ev_c09r0201_bigfour2_01

  _TALK_OBJ_START()


  //ゲームクリア前後で分岐
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    //========ゲームクリア前===============

    //戦闘済みかで分岐
    IF FLAG_OFF( SYS_FLAG_BIGFOUR_EVILWIN ) THEN

      //戦闘前---------------------------------------------------

      //ギーマ：ここで　きめるのは
      _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_01 ,C09R0201_BIGFOUR2_01 ,POS_UP )
      _MSGWIN_CLOSE()

      //========================================//
      //戦闘終了後にワープのアニメを再生させるため、マップ構築前に勝利フラグをたてておく
      //負けた場合はC09でリセットされるので問題なし
      //四天王（ギーマ）勝利フラグをセット
      _FLAG_SET( SYS_FLAG_BIGFOUR_EVILWIN )
      //ワープPOSイベントを有効
      $LOCALWORK10 = 555
      //========================================//

    {
      //難易度取得ワーク定義
      DEFINE_LOCAL  LCW_DIFFICULTY
      
      //現在の難易度を取得
      _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
      
      //トレーナー戦呼び出し
      
      //むずかしい
      IF $LCW_DIFFICULTY == 2 THEN
        _TRAINER_BTL_SET( TRID_BIGFOUR2_03, 0 )
      
      //ふつう・かんたん
      ELSE
        _TRAINER_BTL_SET( TRID_BIGFOUR2_01, 0 )
      ENDIF

    }
      //敗戦チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
      ELSE
        _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
      ENDIF

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //ギーマ：だが　まだ　おわり　ではない！▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_04 ,C09R0201_BIGFOUR2_01 ,POS_UP )

      ELSE
        //それ以外なら通常メッセージを表示
        //ギーマ：まけは　まけ……▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_02 ,C09R0201_BIGFOUR2_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ELSE

      //戦闘後---------------------------------------------------

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //ギーマ：だが　まだ　おわり　ではない！▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_04 ,C09R0201_BIGFOUR2_01 ,POS_UP )

      ELSE
        //戦闘後メッセージ
        //ギーマ：ぶざまな　はいぼくしゃ……▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_03 ,C09R0201_BIGFOUR2_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSE

    //========ゲームクリア後===============

    //戦闘済みかで分岐
    IF FLAG_OFF( SYS_FLAG_BIGFOUR_EVILWIN ) THEN

      //戦闘前---------------------------------------------------

      //ギーマ：じんせいは　あたえられた
      _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_05 ,C09R0201_BIGFOUR2_01 ,POS_UP )
      _MSGWIN_CLOSE()

      //========================================//
      //戦闘終了後にワープのアニメを再生させるため、マップ構築前に勝利フラグをたてておく
      //負けた場合はC09でリセットされるので問題なし
      //四天王（ギーマ）勝利フラグをセット
      _FLAG_SET( SYS_FLAG_BIGFOUR_EVILWIN )
      //ワープPOSイベントを有効
      $LOCALWORK10 = 555
      //========================================//

    {
      //難易度取得ワーク定義
      DEFINE_LOCAL  LCW_DIFFICULTY
      
      //現在の難易度を取得
      _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
      
      //トレーナー戦呼び出し
      
      //むずかしい
      IF $LCW_DIFFICULTY == 2 THEN
        _TRAINER_BTL_SET( TRID_BIGFOUR2_04, 0 )
      
      //ふつう・かんたん
      ELSE
        _TRAINER_BTL_SET( TRID_BIGFOUR2_02, 0 )
      ENDIF

    }
      //敗戦チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
      ELSE
        _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
      ENDIF

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //ギーマ：だが　まだ　おわり　ではない！▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_08 ,C09R0201_BIGFOUR2_01 ,POS_UP )

      ELSE
        //それ以外なら通常メッセージを表示
        //ギーマ：さて　よのなか　には
        _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_06 ,C09R0201_BIGFOUR2_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ELSE

      //戦闘後---------------------------------------------------

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //ギーマ：だが　まだ　おわり　ではない！▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_08 ,C09R0201_BIGFOUR2_01 ,POS_UP )

      ELSE
        //戦闘後メッセージ
        //ギーマ：どんなことに　だって　いみはある▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0201_bigfour2_07 ,C09R0201_BIGFOUR2_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

EVENT_END

/************************************************************/
/*  階段下のposイベント                                     */
/************************************************************/
EVENT_START   ev_pos_c09r0201_enter_01

  //炎点火
  _FOURKINGS_EVIL_FIRE( 0 )
  _SE_PLAY( SEQ_SE_SW_GEEMA_01 )    // 火がつく音

  _TIME_WAIT( 20 )

  //爪開く
  _FOURKINGS_EVIL_CLAW( 0 )
  _SE_PLAY( SEQ_SE_SW_GEEMA_02 )    // 爪が順番に開く音

  _TIME_WAIT( 25 )

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

EVENT_END

/************************************************************/
/*  階段上のposイベント                                     */
/************************************************************/
EVENT_START   ev_pos_c09r0201_enter_02

  //レールOFF
  _FOURKINGS_RAIL_OFF( 2 )

  //カメラ設定を変更
  _FOURKINGS_SET_TOP_CAMERA( 2 )

  _TIME_WAIT( 10 )

  //爪閉じる
  _FOURKINGS_EVIL_CLAW( 1 )
  _SE_PLAY( SEQ_SE_SW_GEEMA_03 )    // 爪が一気に閉じる音

  _TIME_WAIT( 50 )

  //炎点火
  _FOURKINGS_EVIL_FIRE( 1 )
  _SE_PLAY( SEQ_SE_SW_GEEMA_01 )    // 火がつく音

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

EVENT_END

/************************************************************/
/*  ワープ（出口用）                                        */
/************************************************************/
EVENT_START   ev_pos_c09r0201_warp_01

  //マップチェンジ
  _MAP_CHANGE_WARP( ZONE_ID_C09P01, 31, 48, DIR_UP )

EVENT_END


