
//======================================================================
//                c09r0201.ev
//
//    スクリプトファイル：c09r0201用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0201.h"
  .include  "c09r0201.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c09r0201
_EVENT_DATA    ev_init_c09r0201
_EVENT_DATA    ev_recover_c09r0201
_EVENT_DATA    ev_c09r0201_bigfour2_01
_EVENT_DATA    ev_pos_c09r0201_enter_01
_EVENT_DATA    ev_pos_c09r0201_enter_02
_EVENT_DATA    ev_pos_c09r0201_warp_01
_EVENT_DATA_END


//------------------------------注意--------------------------------//
//																	//
//	LOCALWORK0 をギミックの制御に使用しています。					//
//		0 = 階段下のPOSイベント有効 	//
//	LOCALWORK1 をギミックの制御に使用しています。					//
//		0 = 階段上のPOSイベント有効 	//
//	LOCALWORK10 をギミックの制御に使用しています。マップ内使用禁止	//
//		555 = POSイベント有効										//
//																	//
//------------------------------------------------------------------//


/************************************************************/
/*					ZONE_CHANGE_LABEL 						*/
/************************************************************/
INIT_EVENT_START	ev_zone_c09r0201
INIT_EVENT_END
/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_c09r0201
INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_c09r0201

  // 主人公が頂上にいるときの処理
  IF $LOCALWORK1 == 1 THEN
    // レールOFF
    _FOURKINGS_RAIL_OFF( 2 )
		// カメラ設定を変更
		_FOURKINGS_SET_TOP_CAMERA( 2 )
  ENDIF

INIT_EVENT_END

/************************************************************/
/*						四天王（あく）						*/
/************************************************************/
EVENT_START	ev_c09r0201_bigfour2_01

EVENT_END

/************************************************************/
/*					階段下のposイベント					*/
/************************************************************/
EVENT_START	ev_pos_c09r0201_enter_01

  _TIME_WAIT(1)

  // 炎点火
  _FOURKINGS_EVIL_FIRE(0)
	_SE_PLAY( SEQ_SE_SW_GEEMA_01 )    // 火がつく音

  _TIME_WAIT(6)

  // 爪開く
  _FOURKINGS_EVIL_CLAW(0)
	_SE_PLAY( SEQ_SE_SW_GEEMA_02 )    // 爪が順番に開く音

  _TIME_WAIT(10)

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

EVENT_END

/************************************************************/
/*					階段上のposイベント					*/
/************************************************************/
EVENT_START	ev_pos_c09r0201_enter_02

  // レールOFF
  _FOURKINGS_RAIL_OFF(2)

	// カメラ設定を変更
	_FOURKINGS_SET_TOP_CAMERA(2)

  _TIME_WAIT(1)

  // 炎点火
  _FOURKINGS_EVIL_FIRE(1)
	_SE_PLAY( SEQ_SE_SW_GEEMA_01 )    // 火がつく音

  _TIME_WAIT(6)

  // 爪閉じる
  _FOURKINGS_EVIL_CLAW(1)
	_SE_PLAY( SEQ_SE_SW_GEEMA_03 )    // 爪が一気に閉じる音

  _TIME_WAIT(10)

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

  //=====================================
  //ワープPOSイベントを有効
	$LOCALWORK10 = 555
  //=====================================

EVENT_END

/************************************************************/
/*						ワープ（出口用）					*/
/************************************************************/
EVENT_START	ev_pos_c09r0201_warp_01
	
	//マップチェンジ
	_MAP_CHANGE_WARP( ZONE_ID_C09P01, 31, 48, DIR_UP )
	
EVENT_END

