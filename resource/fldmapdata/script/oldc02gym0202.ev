
//======================================================================
//                oldc02gym0202.ev
//
//    スクリプトファイル：oldc02gym0202用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_oldc02gym0202.h"
  .include  "oldc02gym0202.h"
  
  .include  "c02gym0101.h"
  .include  "c02gym0101_def.h"

//@author Suginaka Katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_reserve_oldc02gym0202_event_01
_EVENT_DATA_END


/**************************************************************/
/*			過去イベント	アロエ・アーティ・ヤーコン	  */
/**************************************************************/
EVENT_START		ev_reserve_oldc02gym0202_event_01

	//暗転復帰
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//カメラ操作　ちょっと上のほうを初期位置にする
	_CAMERA_MOVE( 9698,0,970582,360448,348175,360448,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_on )
	_OBJ_ANIME_WAIT()

	_MAP_FADE_BLACK_IN()

	//カメラ操作　デフォ位置に移動
	_CAMERA_RECV_MOVE( 60 ) //一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_MAP_FADE_END_CHECK()
	
	//アーティ　上へ歩いてアロエの前へ
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER3_01, anm_walk_6u )
	_OBJ_ANIME_WAIT()	
	
	//アロエ　！マークを出す
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER2_01, anm_gyoe )
	_OBJ_ANIME_WAIT()
	
	//アロエ：おや　アーティ
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader2_01 , OLDC02GYM0202_OLD_LEADER2_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アーティ：うーん　ホネ　なのかなあ
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader3_01 , OLDC02GYM0202_OLD_LEADER3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アロエ：？マークをだす
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER2_01, anm_hatena )
	_OBJ_ANIME_WAIT()	
	
	//アロエ：ホネ？
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader2_02 , OLDC02GYM0202_OLD_LEADER2_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アーティ：そうかなあ
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader3_02 , OLDC02GYM0202_OLD_LEADER3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アロエ：で　ここに　くれば
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader2_03 , OLDC02GYM0202_OLD_LEADER2_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//アーティ：むうん
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader3_03 , OLDC02GYM0202_OLD_LEADER3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アロエ：あたしが
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader2_04 , OLDC02GYM0202_OLD_LEADER2_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アーティ：あう
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader3_04 , OLDC02GYM0202_OLD_LEADER3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//プレーンウィン：おお！　なんだ
	_PLAINWIN_MSG_UP( msg_oldc02gym0202_old_leader5_01 )
	_PLAINWIN_CLOSE()
	
	//ヤーコン　上へ歩いてくる
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER5_01, anm_walk_6u )
	_OBJ_ANIME_WAIT()	
		
	//アーティ　ヤーコンのほうをむく
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER3_01, anm_stay_l )
	_OBJ_ANIME_WAIT()	
	
	//アーティ：どうしたの？
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader3_05 , OLDC02GYM0202_OLD_LEADER3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ヤーコン：ネジやまで
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader5_02 , OLDC02GYM0202_OLD_LEADER5_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アーティ：ヤーコンさんにとって
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader3_06 , OLDC02GYM0202_OLD_LEADER3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ヤーコン　アーティのほうをむく
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER5_01, anm_stay_r )
	_OBJ_ANIME_WAIT()
	
	//ヤーコン：ん？
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader5_03 , OLDC02GYM0202_OLD_LEADER5_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アロエ：また　うそぶいてるのか
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader2_05 , OLDC02GYM0202_OLD_LEADER2_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ヤーコン　上を向いて
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER5_01, anm_stay_u )
	_TIME_WAIT( 8 )
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER3_01, anm_stay_u )
	_OBJ_ANIME_WAIT()	
	
	//ヤーコン：おお！　これだ　これ！
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader5_04 , OLDC02GYM0202_OLD_LEADER5_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アロエ　ヤーコンと隣接・ヤーコンはアロエのほうをむく
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER2_01, anm_leader2_move )
	_OBJ_ANIME_WAIT()
	
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER5_01, anm_stay_l )
	//アーティ　左を向く
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER3_01, anm_stay_l )
	_OBJ_ANIME_WAIT()	
	
	_TIME_WAIT( 60 )
	
	//アロエ：そうだね
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader2_06 , OLDC02GYM0202_OLD_LEADER2_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//アーティ　？マークをだす
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER3_01, anm_hatena )
	_OBJ_ANIME_WAIT()	

	//アーティ：どーゆーこと？
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader3_07 , OLDC02GYM0202_OLD_LEADER3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アロエ：うん　びみょうなんだけど
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader2_07 , OLDC02GYM0202_OLD_LEADER2_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER5_01, anm_stay_d_16f )
	_OBJ_ANIME_WAIT()
	
	//ヤーコン：そうか！
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader5_05 , OLDC02GYM0202_OLD_LEADER5_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ヤーコン　下へ歩く・途中で止まり振り向く
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER5_01, anm_leader5_leave1 )
	_TIME_WAIT( 10 )
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER2_01, anm_stay_d )
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER3_01, anm_stay_d )
	_OBJ_ANIME_WAIT()	

	//カメラ操作　ヤーコンを中心に
	_CAMERA_MOVE( 9688,0,970752,360448,0,622592,30 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	//ヤーコン：アーティ！
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader5_06 , OLDC02GYM0202_OLD_LEADER5_01, POS_DOWN )
	_MSGWIN_CLOSE()

	//カメラ操作　デフォ位置に移動
	_CAMERA_RECV_MOVE( 30 ) //一番最後の引数は移動にかかるフレーム数
	//ヤーコン　退場
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER5_01, anm_leave )
	_OBJ_ANIME_WAIT()
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	
	_TIME_WAIT( 30 )
	
	//アロエ・アーティ　向かい合う
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER2_01, anm_stay_r )
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER3_01, anm_stay_l )
	_OBJ_ANIME_WAIT()	
	
	//アーティ：ねえさん　ありがと
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader3_08 , OLDC02GYM0202_OLD_LEADER3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アロエ：いいんじゃない？
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader2_08 , OLDC02GYM0202_OLD_LEADER2_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アーティ：だね
	_BALLOONWIN_OBJMSG_POS( msg_oldc02gym0202_old_leader3_09 , OLDC02GYM0202_OLD_LEADER3_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アーティ　下に移動
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER3_01, anm_leave2 )
	
	//暗転
	_CAMERA_MOVE( 9698,0,970582,360448,348175,360448,60 )
	_TIME_WAIT( 8 )
	_OBJ_ANIME( OLDC02GYM0202_OLD_LEADER2_01, anm_stay_d )

	_OBJ_ANIME_WAIT()
	
	//画面暗転処理
	_MAP_FADE_BLACK_OUT()
	_MAP_FADE_END_CHECK()
	
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	
	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_C02GYM0101_LINK_EVENT_RET )

	_CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
	_CAMERA_END()		//カメラ操作終了

	//マップチェンジ
	_MAP_CHANGE_NO_FADE( ZONE_ID_C02GYM0101, 12, 3, 6, DIR_UP )

EVENT_END

//--------------------------------------------------------------------
//	☆共通処理：歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0
	
_ANIME_LABEL	anm_walk_6u
