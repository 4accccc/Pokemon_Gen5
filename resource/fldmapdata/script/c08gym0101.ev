//------------------------------注意--------------------------------//
// ローカルワークをプログラム側で操作しています。
// 
// LOCALWORK0⇒上ボタン
// LOCALWORK1⇒下ボタン
// LOCALWORK2⇒左ボタン
// LOCALWORK3⇒右ボタン
//------------------------------------------------------------------/

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		 ev_zone_c08gym0101
_EVENT_DATA    ev_pos_c08gym0101_button_up        // 上ボタン
_EVENT_DATA    ev_pos_c08gym0101_button_down      // 下ボタン
_EVENT_DATA    ev_pos_c08gym0101_button_left      // 左ボタン
_EVENT_DATA    ev_pos_c08gym0101_button_right     // 右ボタン
_EVENT_DATA    ev_tr_c08gym0101_tail              // 尻尾トレーナー
_EVENT_DATA    ev_tr_c08gym0101_arm_l             // 左腕トレーナー
_EVENT_DATA    ev_tr_c08gym0101_arm_r             // 左腕トレーナー
_EVENT_DATA    ev_tr_c08gym0101_foot_l            // 左足トレーナー
_EVENT_DATA    ev_tr_c08gym0101_foot_r            // 左足トレーナー
_EVENT_DATA    ev_tr_c08gym0101_guide             // ガイド
_EVENT_DATA    ev_tr_c08gym0101_swleader7         // シャガ
_EVENT_DATA    ev_tr_c08gym0101_up_button_turn_on // 上ボタン点灯
_EVENT_DATA    ev_bg_c08gym0101_statue            // 像
_EVENT_DATA_END

/************************************************************/
/*					ジムギミック初期化						*/
/************************************************************/
INIT_EVENT_START	ev_zone_c08gym0101
{
  // ジムの初期化
  _GYM_DRAGON_INIT()

  // ※戦闘状況によってボタンフラグを操作します
	DEFINE_LOCAL LWK_BATTLE_FG
	_TRAINER_FLAG_CHECK( TRID_VETERANM_09, LWK_BATTLE_FG )
	IF $WK_SCENE_C08GYM_TURN_BTN_02 == 2 THEN
    $LOCALWORK0 = TRUE
  ELSE
    $LOCALWORK0 =  FALSE
  ENDIF

  $LOCALWORK1 = FALSE
  $LOCALWORK2 = FALSE
  $LOCALWORK3 = FALSE
}
INIT_EVENT_END

/**************************************************************/
/*                    上ボタン                                */
/**************************************************************/
EVENT_START   ev_pos_c08gym0101_button_up
{
  // ボタン起動音
  _SE_PLAY( SEQ_SE_SW_DRGGYM_06 )

  // 下に移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_down )
  _OBJ_ANIME_WAIT()

  // 上を向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT()

  // 上ボタン処理
  _GYM_DRAGON_PUSH_BUTTON(GYM_DRAGON_EVENT_SEQ_UP_BUTTON)
}
EVENT_END

/**************************************************************/
/*                    下ボタン                                */
/**************************************************************/
EVENT_START   ev_pos_c08gym0101_button_down
{
  // ボタン起動音
  _SE_PLAY( SEQ_SE_SW_DRGGYM_06 )

  // 上に移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_up )
  _OBJ_ANIME_WAIT()

  // 上を向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT()

  // 下ボタン処理
  _GYM_DRAGON_PUSH_BUTTON(GYM_DRAGON_EVENT_SEQ_DOWN_BUTTON)
}
EVENT_END

/**************************************************************/
/*                    左ボタン                                */
/**************************************************************/
EVENT_START   ev_pos_c08gym0101_button_left
{
  // ボタン起動音
  _SE_PLAY( SEQ_SE_SW_DRGGYM_06 )

  // 右に移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_right )
  _OBJ_ANIME_WAIT()

  // 上を向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT()

  // 左ボタン処理
  _GYM_DRAGON_PUSH_BUTTON(GYM_DRAGON_EVENT_SEQ_LEFT_BUTTON)
}
EVENT_END

/**************************************************************/
/*                    右ボタン                                */
/**************************************************************/
EVENT_START   ev_pos_c08gym0101_button_right
{
  // ボタン起動音
  _SE_PLAY( SEQ_SE_SW_DRGGYM_06 )

  // 左に移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_move_left )
  _OBJ_ANIME_WAIT()

  // 上を向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_up_dir )
  _OBJ_ANIME_WAIT()

  // 右ボタン処理
  _GYM_DRAGON_PUSH_BUTTON(GYM_DRAGON_EVENT_SEQ_RIGHT_BUTTON)
}
EVENT_END

// トレーナーID設定用グローバル変数
DEFINE_LOCAL  LWK_TRID

//--------------------------------------------------------------------
// トレーナー共通処理
//--------------------------------------------------------------------
trainer_battle:
{
  //視線曲を再生
  //_TRAINER_BGM_SET( LWK_TRID )

  //トレーナー戦呼び出し
  _TRAINER_BTL_SET( LWK_TRID, 0 )
  
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
	
  // 戦闘フラグセット
  _TRAINER_FLAG_SET( LWK_TRID )

}
_RET

///**************************************************************/
///*                    尻尾トレーナー                          */
///**************************************************************/
EVENT_START ev_tr_c08gym0101_tail
{
  _TALK_OBJ_START()
  $LWK_TRID = TRID_VETERANM_09
	
	//既に戦闘しているか状態を取得
	DEFINE_LOCAL LWK_BATTLE_FG
	_TRAINER_FLAG_CHECK( LWK_TRID, LWK_BATTLE_FG )
	
	//既に戦闘を行った
	IF $LWK_BATTLE_FG == 0 THEN
    
    // 戦闘前会話
    _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranm_09_01 )
		_MSGWIN_CLOSE()

    // 戦闘を行う
    _CALL trainer_battle
    
    // 戦闘後会話
    _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranm_09_02 )
    _LAST_KEYWAIT()
		_MSGWIN_CLOSE()

    // ボタン点灯イベントを起動する状態にする
    IF $WK_SCENE_C08GYM_TURN_BTN_01 == 0 THEN
      $WK_SCENE_C08GYM_TURN_BTN_01 = 1
    ENDIF
      
  ELSE
    // 戦闘後会話
    _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranm_09_02 )    // ヒント会話
    _LAST_KEYWAIT()
		_MSGWIN_CLOSE()
  ENDIF
}
EVENT_END

///**************************************************************/
///*                    左腕トレーナー                          */
///**************************************************************/
EVENT_START ev_tr_c08gym0101_arm_l
{
  _TALK_OBJ_START()
  $LWK_TRID = TRID_VETERANM_11
	
	//既に戦闘しているか状態を取得
	DEFINE_LOCAL LWK_BATTLE_FG
	_TRAINER_FLAG_CHECK( LWK_TRID, LWK_BATTLE_FG )
	
	//既に戦闘を行った
	IF $LWK_BATTLE_FG == 0 THEN
	  DEFINE_LOCAL LWK_PARTY_NUM

    // 手持ち数判定
    _GET_PARTY_POKE_COUNT ( LWK_PARTY_NUM , POKECOUNT_MODE_BATTLE_ENABLE)
    IF $LWK_PARTY_NUM < 3 THEN
      // 戦えないよメッセージ
      _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranm_11_01 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
    ELSE
 
      // 戦闘前会話
      _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranm_11_02 )
		  _MSGWIN_CLOSE()

      // 戦闘を行う
      _CALL trainer_battle

      // ボタン状況を再設定
      _GYM_DRAGON_REFRESH_BUTTON()

      // ボタン点灯イベントを起動する状態にする
      IF $WK_SCENE_C08GYM_TURN_BTN_03 == 0 THEN
        $WK_SCENE_C08GYM_TURN_BTN_03 = 1
      ENDIF
      
      // ヒント
      _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranm_11_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
    ENDIF
  ELSE

    // ヒント
    _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranm_11_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
}
EVENT_END

///**************************************************************/
///*                    右腕トレーナー                          */
///**************************************************************/
EVENT_START ev_tr_c08gym0101_arm_r
{
  _TALK_OBJ_START()
  $LWK_TRID = TRID_VETERANW_08
	
	//既に戦闘しているか状態を取得
	DEFINE_LOCAL LWK_BATTLE_FG
	_TRAINER_FLAG_CHECK( LWK_TRID, LWK_BATTLE_FG )
	
	//既に戦闘を行った
	IF $LWK_BATTLE_FG == 0 THEN
	  DEFINE_LOCAL LWK_PARTY_NUM
    
    // 手持ち数判定
    _GET_PARTY_POKE_COUNT ( LWK_PARTY_NUM , POKECOUNT_MODE_BATTLE_ENABLE)
    IF $LWK_PARTY_NUM < 3 THEN
      // 戦えないよメッセージ
      _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranw_08_01 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
    ELSE
            // 戦闘前会話
      _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranw_08_02 )
		  _MSGWIN_CLOSE()

      // 戦闘を行う
      _CALL trainer_battle

      // ボタン状況を再設定
      _GYM_DRAGON_REFRESH_BUTTON()

      // ボタン点灯イベントを起動する状態にする
      IF $WK_SCENE_C08GYM_TURN_BTN_03 == 0 THEN
        $WK_SCENE_C08GYM_TURN_BTN_03 = 1
      ENDIF
      
      // ヒント
      _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranw_08_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
    ENDIF
  ELSE
    // ヒント
    _BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_veteranw_08_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF
}
EVENT_END

