///**************************************************************/
///*                    ガイド                                  */
///**************************************************************/
EVENT_START ev_tr_c08gym0101_guide
{
	_TALK_OBJ_START()

	//バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_07 )

	//バッジフラグで分岐
	IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前の処理

		//アイテム入手フラグで分岐
		IF FLAG_OFF( FE_C08GYM_ITEM ) THEN
			//アイテム未入手なら、おいしいみず入手イベント
			_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_glasses_01 )
			_BALLOONWIN_CLOSE()
			_ITEM_EVENT_KEYWAIT( ITEM_OISIIMIZU, 1 )

      _CALL move_camera_start
			_PLAINWIN_MSG_DOWN( msg_c08gym0101_glasses_02 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
      _CALL move_camera_end

			_FLAG_SET( FE_C08GYM_ITEM )			//アイテム入手フラグをセット

		ELSE
			//入手済みならメッセージのみ
			_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_glasses_02 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
		ENDIF

	ELSE
		//バッジ入手後の処理
		_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_glasses_03 )
		_LAST_KEYWAIT()
		_BALLOONWIN_CLOSE()

	ENDIF
}
EVENT_END

/************************************************************/
/*				カメラ操作				*/
/************************************************************/
move_camera_start:
{
  _CAMERA_START()       // カメラ操作開始
  _CAMERA_PURGE()		    // カメラのバインドを解く

  _CAMERA_MOVE( 4056,0,970752,753664,0,1323008,90 )
}
_RET

move_camera_end:
{
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _CAMERA_DEF_MOVE( 60 )
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _CAMERA_BIND()        // カメラバインド
  _CAMERA_END()         // カメラ操作終了
}
_RET

///**************************************************************/
///*                    【仮】シャガ                                  */
///**************************************************************/
EVENT_START ev_tr_c08gym0101_swleader7
{
  _TALK_OBJ_START()
	
	//ジムバッジ取得チェック
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_07 )
	
	//ジムバッジを取得していない場合
	IF $SCWK_TEMP0 == 0 THEN
	
    // 【仮】引継ぎチェックを入れる必要がある
		//会話
		_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_swleader7_01 )
		_BALLOONWIN_CLOSE()
		
    //戦闘処理
		_TRAINER_BTL_SET( TRID_SWLEADER7_01, 0 )

		//結果チェック
		_TRAINER_LOSE_CHECK( SCWK_ANSWER )
		IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()
		ELSE
			_TRAINER_LOSE()
		ENDIF
			
		//勝利後会話
		_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_swleader7_02 )
		_BALLOONWIN_CLOSE()
	
    //リーダー戦勝利時の情報登録
    _SET_GYM_VICTORY_INFO( BADGE_ID_07 )

		//レジェンドバッジ入手処理
		_SET_BADGE_FLAG( BADGE_ID_07 )
		
		{
		
		//バッジ入手演出再生
		_ME_PLAY( SEQ_ME_BADGE )
		
		//性別が格納されるローカル変数を定義
		DEFINE_LOCAL SCWK_SEX
		_GET_MY_SEX(SCWK_SEX)
		
		//男性だった場合
		IF $SCWK_SEX == PM_MALE THEN
			_CALL_FLD3D_CUTIN( FLDCIID_GYM07 )
		//女性だった場合
		ELSE
			_CALL_FLD3D_CUTIN( FLDCIID_GYM07F )
		ENDIF
		
		//ME待ち
		_ME_WAIT()
			
	  }
		
		//バッジをもらった
		_PLAYER_NAME( 0 )
    _SYSWIN_MSG( msg_c08gym0101_swleader7_03 , POS_DEFAULT )
	  _SYSWIN_CLOSE()

		_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_swleader7_04 )
		_BALLOONWIN_CLOSE()

		//わざマシン入手処理「ドラゴンテール」
		_ITEM_EVENT_KEYWAIT( ITEM_WAZAMASIN82, 1 )

    // 技マシン説明
		_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_swleader7_05 )

    // メッセージ
		_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_swleader7_06 )
		_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_swleader7_07 )
	  _LAST_KEYWAIT()
    
    //ジムトレーナーの視線無効
    _TRAINER_FLAG_SET( TRID_VETERANM_09 )
    _TRAINER_FLAG_SET( TRID_VETERANM_11 )
    _TRAINER_FLAG_SET( TRID_VETERANW_08 )
    _TRAINER_FLAG_SET( TRID_VETERANW_07 )
    _TRAINER_FLAG_SET( TRID_VETERANM_10 )
    
    //電光掲示板フラグセット
    _FLAG_SET( SYS_FLAG_ELBOARD_C08GYMWIN )

    //C08プラズマ団イベント開始
    $WK_SCENE_C08_LEADER7 = 1

  ELSE
		_BALLOONWIN_TALKOBJ_MSG( msg_c08gym0101_swleader7_07 )
	  _LAST_KEYWAIT()
		_BALLOONWIN_CLOSE()
  ENDIF
}
EVENT_END

///**************************************************************/
///*                1階：上ボタン点灯イベント                   */
///**************************************************************/
EVENT_START ev_tr_c08gym0101_up_button_turn_on
{
  // ボタン点灯イベントを起動する状態にする
  IF $WK_SCENE_C08GYM_TURN_BTN_01 == 1 THEN
    // 上ボタンを点灯する
    _GYM_DRAGON_TURNON_UP_BUTTON( 0 )
    $WK_SCENE_C08GYM_TURN_BTN_01 = 2
  
    // ボタン状況を再設定
    _GYM_DRAGON_REFRESH_BUTTON()
  ENDIF
}
EVENT_END

/**************************************************************/
/*          【仮】像                                          */
/**************************************************************/
EVENT_START	ev_bg_c08gym0101_statue

  _TALK_START_SE_PLAY()

  DEFINE_LOCAL	LWK_BADGE

  //ジムバッジを持っているのかを判定
  _GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_07 )

  //ジムバッジを取得していない場合
  IF $SCWK_TEMP0 == 0 THEN

    _PLAYER_NAME( 0 )
    _PLAINWIN_MSG_DOWN( msg_c08gym0101_statue_01 )

  //ジムバッジを取得している場合【仮】
  ELSE
    _PLAYER_NAME( 0 )
    _PLAINWIN_MSG_DOWN( msg_c08gym0101_statue_02 )
  ENDIF

  _LAST_KEYWAIT()	
  _PLAINWIN_CLOSE()

EVENT_END



