/**************************************************************/
/* 			RESERVE：アジト船から復帰イベント			  */
/**************************************************************/
EVENT_START		ev_reserve_d05_swplazma_af_01
  
  //アニメ：ライバルきょろきょろ
  _OBJ_ANIME( D05_SWRIVAL_01, anm_rival_look_lr )
  _OBJ_ANIME_WAIT()
  
  //ライバル名代入
  _RIVAL_NAME(1)

  //ライバル：いまの！？
  _BALLOONWIN_OBJMSG_POS( msg_d05_swrival_04,D05_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル高速で退場
  _OBJ_ANIME_AUTO( D05_SWRIVAL_01, 196, 476, FORCE_TYPE_NPC, 4, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //ライバル動作OBJ削除
  _OBJ_DEL( D05_SWRIVAL_01 )
  
  _OBJ_ANIME( D05_SWLEADER1_01, anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //チェレン：あんなことができるのは
  _BALLOONWIN_OBJMSG_POS( msg_d05_swleader1_03,D05_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン主人公に向き合う
  _OBJ_ANIME( D05_SWLEADER1_01, anm_swleader1_look_player)
  _OBJ_ANIME_WAIT()
  
  //主人公名代入
  _PLAYER_NAME(0)
  
  //チェレン：あんなことができるのは
  _BALLOONWIN_OBJMSG_POS( msg_d05_swleader1_04,D05_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン退場
  _OBJ_ANIME_AUTO( D05_SWLEADER1_01, 197, 476, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //チェレン動作OBJ削除
  _OBJ_DEL( D05_SWLEADER1_01 )
  
  //========================================//
  //D05 全てのイベントを終了
  $WK_SCENE_D05 = 5
  //D05ライバル非表示
  _FLAG_SET( FV_D05_SWRIVAL_01 )
  //D05チェレン非表示
  _FLAG_SET( FV_D05_SWLEADER1_01 )
  //========================================//
EVENT_END

