/**************************************************************/
/* 			アクロマ：話しかけ			  */
/**************************************************************/
EVENT_START		ev_d05_swboss_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d05_swboss_03 )
EVENT_END

/**************************************************************/
/* 			ストッパー：話しかけ			  */
/**************************************************************/
EVENT_START		ev_d05_stopper_01
  //【仮】ストッパー：工事中（メッセージラベルが仮）
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d05_swboss_03 )
EVENT_END

/**************************************************************/
/* 			ストッパー：POS起動			  */
/**************************************************************/
EVENT_START		ev_pos_d05_stopper_01

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //主人公に隣接
  IF $LCW_POSX >= 470 THEN
    _OBJ_ANIME( D05_STOPPER_01, anm_stopper_lookpleyer_d )
    _TIME_WAIT(16)
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME_WAIT()
  ELSE
    _OBJ_ANIME( D05_STOPPER_01, anm_stopper_lookpleyer_u )
    _TIME_WAIT(16)
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //【仮】ストッパー：工事中（メッセージラベルが仮）
  _BALLOONWIN_OBJMSG_POS( msg_d05_swboss_03,D05_STOPPER_01, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //主人公1歩戻る・ストッパー元の位置に戻る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
  _OBJ_ANIME( D05_STOPPER_01 , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
EVENT_END

