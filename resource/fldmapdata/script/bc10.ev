_EVENT_DATA   ev_zone_bc10
_EVENT_DATA   ev_init_bc10
_EVENT_DATA   ev_pos_bc10_d31r0201_door
_EVENT_DATA   ev_reserve_bc10_d31r0201_door
_EVENT_DATA   ev_bg_bc10_board_01
_EVENT_DATA   ev_bc10_03_01
_EVENT_DATA   ev_bc10_08_01
_EVENT_DATA   ev_bc10_11_01   //エリア05クリア後に出現する
