//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_bg_bc10_board_01
_EVENT_DATA    ev_pos_bc10_d31r0201_door
_EVENT_DATA    ev_reserve_bc10_d31r0201_door
_EVENT_DATA_END

//------------------------！注意！------------------------------//
//																//
//		LOCALWORK12をD32への接続に使用			//
//		ゾーン内での使用を禁止します							//
//																//
//--------------------------------------------------------------//

/**************************************************************/
/*POS：無限ダンジョンに移動                                                 */
/**************************************************************/
EVENT_START  ev_pos_bc10_d31r0201_door

  //カメラ操作　無限ダンジョンにフォーカス
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  
  //カメラ操作,最後の引数はカメラ操作にかけるフレーム数
  _CAMERA_MOVE( 59750,0,2330624,1802240,1261568,692224,1 )
  
  //アニメ：主人公入り口へ移動
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_walk_u)
  _OBJ_ANIME_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //マップチェンジ
  _MAP_CHANGE( ZONE_ID_D31R0201, 7, 14, DIR_UP )
  
EVENT_END

/**************************************************************/
/*RESERVE：無限ダンジョンから出る                                                 */
/**************************************************************/
EVENT_START  ev_reserve_bc10_d31r0201_door
  
  //入り口から出る
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_walk_d)
  _OBJ_ANIME_WAIT()
  
EVENT_END


/**************************************************************/
/*看板01                                                 */
/**************************************************************/
EVENT_START  ev_bg_bc10_board_01
	_EASY_BGWIN_MSG(bc10_sign1_01 , TYPE_TOWN)
EVENT_END

