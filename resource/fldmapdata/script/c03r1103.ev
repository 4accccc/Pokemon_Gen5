
//======================================================================
//                c03r1103.ev
//
//    スクリプトファイル：c03r1103用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c03r1103.h"
  .include  "c03r1103.h"

//@author Suginaka katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_bg_c03r1103_pc_01
_EVENT_DATA		ev_bg_c03r1103_books_01
_EVENT_DATA		ev_bg_c03r1103_books_02
_EVENT_DATA		ev_c03r1103_inventor_01
_EVENT_DATA		ev_c03r1103_girl3_01
_EVENT_DATA_END

/**************************************************************/
/*			C03R1103	パソコン							  */
/**************************************************************/
EVENT_START		ev_bg_c03r1103_pc_01
{
_TALK_START_SE_PLAY()

	DEFINE_LOCAL	LWK_REPEAT
	DEFINE_LOCAL	LWK_SELECT
	
	$LWK_REPEAT = 0
	
	//マコモのメモ
	_SYSWIN_MSG( msg_c03r1103_pc_01 , POS_DOWN )
	
	WHILE $LWK_REPEAT != 1
	
		//どの　項目を　よみますか？
		_SYSWIN_MSG( msg_c03r1103_pc_02 , POS_DOWN )
	
		//分岐・ゲームシンク・ポケモンのゆめ・やめる
		_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_SELECT )

		_BMPMENU_MAKE_LIST( msg_c03r1103_pc_select_01, 1 )	//ゲームシンク
		_BMPMENU_MAKE_LIST( msg_c03r1103_pc_select_02, 2 )	//ポケモンのゆめ
		_BMPMENU_MAKE_LIST( msg_c03r1103_pc_select_03, 3 )	//やめる

		//メニュー表示
		_BMPMENU_START()
		
		//選択結果で分岐
		SWITCH $LWK_SELECT
		CASE 1 THEN
			_SYSWIN_MSG( msg_c03r1103_pc_03 , POS_DOWN )
		CASE 2 THEN
			_SYSWIN_MSG( msg_c03r1103_pc_04 , POS_DOWN )
		CASE 3 THEN
			
			_SYSWIN_CLOSE()
			
			//========================================/
			//繰り返し脱出
			$LWK_REPEAT = 1
			//========================================/
			
		DEFAULT
		
			_SYSWIN_CLOSE()
			
			//========================================/
			//繰り返し脱出
			$LWK_REPEAT = 1
			//========================================/
			
		ENDSWITCH
	
	ENDWHILE
}
EVENT_END

/**************************************************************/
/*			C03R1103	本棚１								  */
/**************************************************************/
EVENT_START		ev_bg_c03r1103_books_01
_TALK_START_SE_PLAY()
	_SYSWIN_MSG( msg_c01r0101_books_01 , POS_DOWN )
	_LAST_KEYWAIT()
	_SYSWIN_CLOSE()
EVENT_END

/**************************************************************/
/*			C03R1103	本棚２								  */
/**************************************************************/
EVENT_START		ev_bg_c03r1103_books_02
_TALK_START_SE_PLAY()
	_SYSWIN_MSG( msg_c01r0101_books2_01 , POS_DOWN )
	_LAST_KEYWAIT()
	_SYSWIN_CLOSE()
EVENT_END

/**************************************************************/
/*			C03R1103	マコモ								  */
/**************************************************************/
EVENT_START		ev_c03r1103_inventor_01
{
_TALK_OBJ_START()

	//初回会話か？
	IF FLAG_OFF( FE_C03R1103_FIRSTTALK ) THEN	
	 
		//ヤッホー！
		_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_inventor_01 )
		
    
    //主人公の向きの変数を定義
    DEFINE_LOCAL LWK_DIR
    
    //主人公方向取得
    _PLAYER_DIR_GET( LWK_DIR )
    
    IF $LWK_DIR == DIR_UP THEN
      _OBJ_ANIME( C03R1103_INVENTOR_01, anm_stayjump_d )
    ELSIF $LWK_DIR == DIR_DOWN THEN
      _OBJ_ANIME( C03R1103_INVENTOR_01, anm_stayjump_u )
    ELSIF $LWK_DIR == DIR_LEFT THEN
      _OBJ_ANIME( C03R1103_INVENTOR_01, anm_stayjump_r )
    ELSIF $LWK_DIR == DIR_RIGHT THEN
      _OBJ_ANIME( C03R1103_INVENTOR_01, anm_stayjump_l )
    ENDIF
    _OBJ_ANIME_WAIT()
    
    
		//さてと　ゲームシンク
		_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_inventor_02 )
	
		//ゲームシンクと　いうのは
		_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_inventor_03 )
	
		//さらに　ゲームシンク
		_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_inventor_04 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
    
		//----------------------------------

		//マコモと会話フラグ
		_FLAG_SET(FE_C03R1103_FIRSTTALK)

		//----------------------------------
		
		

	//既に会話済みの場合
	ELSE

		DEFINE_LOCAL	LWK_RECORD
	
		_GET_RECORD( RECID_PDW_SLEEP_POKEMON, LWK_RECORD )
		
		//ゲームシンクを利用していない
		IF $LWK_RECORD == 0 THEN
		
			//ゲームシンクって　すごいでしょ
			_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_inventor_05 )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		//ゲームシンクを利用している
		ELSE
		
			//あらアナタも
			_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_inventor_06 )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		ENDIF

	ENDIF
}
EVENT_END

//--------------------------------------------------------------------
//	☆共通処理：その場ジャンプ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_stayjump_u
  _ANIME_DATA	AC_STAY_JUMP_U_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stayjump_d
  _ANIME_DATA	AC_STAY_JUMP_D_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stayjump_l
  _ANIME_DATA	AC_STAY_JUMP_L_8F,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stayjump_r
  _ANIME_DATA	AC_STAY_JUMP_R_8F,1
  _ANIME_DATA	ACMD_END,0

/**************************************************************/
/*			C03R1103	ショーロ							  */
/**************************************************************/
EVENT_START		ev_c03r1103_girl3_01
_TALK_OBJ_START()
	DEFINE_LOCAL	LWK_ITEM_CHK
	
	//ともだちてちょうを所持しているかチェック
	_ITEM_CHK( ITEM_TOMODATITETYOU, 1, LWK_ITEM_CHK )
	
	//ともだちてちょうを所持いない場合
	IF $LWK_ITEM_CHK == FALSE THEN
		
		//あなた　トレーナー？
		_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_girl3_01 )
		_MSGWIN_CLOSE()
		
		//ともだちてちょう入手
		_ITEM_EVENT_KEYWAIT( ITEM_TOMODATITETYOU, 1 )
		
		//その　ともだちてちょうに
		_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_girl3_02 )

	ENDIF

	//ゲームクリア後なら
	IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN

		//イーブイを既に入手している
		IF FLAG_ON( FE_C03R1103_POKE_GET ) THEN
			
			//入手直後の場合
			IF $LOCALWORK10 == 1 THEN 
			
				//イーブイは　おおくの
				_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_girl3_14 )
				_LAST_KEYWAIT()
				_MSGWIN_CLOSE()
			
			//それ以外の場合はコール
			ELSE
			
				_CALL ev_explain
			
			ENDIF
			
		//イーブイを入手していない
		ELSE
		
			//あっ　ボックスの　つかいがっては
			_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_girl3_08 )
			
			//はい・いいえ分岐
			_YES_NO_WIN( SCWK_ANSWER )
			
			//はいの場合
			IF $SCWK_ANSWER == SCR_YES THEN
			
				//手持ちポケモンのカウント
				DEFINE_LOCAL	LWK_COUNT
				
				_GET_PARTY_POKE_COUNT( LWK_COUNT, POKECOUNT_MODE_TOTAL )
			
				//手持ちがいっぱいの場合
				IF $LWK_COUNT == 6 THEN
				
					_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_girl3_13 )
					_LAST_KEYWAIT()
					_MSGWIN_CLOSE()
				
				//手持ちに空きがある場合
				ELSE
				
					_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_girl3_09 )
					_MSGWIN_CLOSE()
					_ADD_POKEMON_TO_PARTY( SCWK_ANSWER, MONSNO_IIBUI, 0, 10 )
				
					//プレイヤーネームを格納
					_PLAYER_NAME(0)
		
					//イーブイを　てにいれた
					_ME_PLAY( SEQ_ME_POKEGET )
					_SYSWIN_MSG(msg_c03r1103_girl3_10, POS_DEFAULT)
					_ME_WAIT()
					_AB_KEYWAIT_MARK()
					_SYSWIN_CLOSE()
			
					//イーブイになまえをつけますか？
					_SYSWIN_MSG(msg_c03r1103_girl3_11, POS_DEFAULT )
					DEFINE_LOCAL LWK_NAME
					_YES_NO_WIN( LWK_NAME )
					_SYSWIN_CLOSE()
				
					//名前をつけるか分岐
					IF $LWK_NAME == SCR_YES THEN
					
						DEFINE_LOCAL LWK_INPUT
					
						_PARTY_POKE_NAME_INPUT( LWK_INPUT, LWK_COUNT, TRUE )

					//いいえの場合
					ELSE

					ENDIF
					
					//イーブイは　おおくの
					_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_girl3_14 )
					_LAST_KEYWAIT()
					_MSGWIN_CLOSE()
					
					//----------------------------------
					
					//イーブイ入手フラグセット
					_FLAG_SET(FE_C03R1103_POKE_GET)
					
					$LOCALWORK10 = 1
					
					//----------------------------------
				
				ENDIF
	
			//いいえの場合
			ELSE
				
				_DEBUG_PRINT_WK( SCWK_ANSWER )
				
				//ざんねん　です
				_BALLOONWIN_TALKOBJ_MSG( msg_c03r1103_girl3_13 )
				_LAST_KEYWAIT()
				_MSGWIN_CLOSE()
			
			ENDIF

		ENDIF
	
	//ゲームクリア前
	ELSE

		_CALL ev_explain
	
	ENDIF
	
EVENT_END

ev_explain:

DEFINE_LOCAL	LWK_REPEAT
DEFINE_LOCAL	LWK_SELECT

$LWK_REPEAT = 0

WHILE $LWK_REPEAT != 1

	//あたしに　なにか
	_BALLOONWIN_OBJMSG_POS( msg_c03r1103_girl3_03 , C03R1103_GIRL3_01, POS_DOWN )

	//分岐・ボックス・バトルボックス・ともだちてちょう・やめる
	_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, LWK_SELECT )

	_BMPMENU_MAKE_LIST( msg_c01r0102_select_01, 1 )	//ボックス
	_BMPMENU_MAKE_LIST( msg_c01r0102_select_02, 2 )	//バトルボックス
	_BMPMENU_MAKE_LIST( msg_c01r0102_select_03, 3 )	//ともだちてちょう
	_BMPMENU_MAKE_LIST( msg_c01r0102_select_04, 4 )	//やめる

	//メニュー表示
	_BMPMENU_START()
	
	//選択結果で分岐
	SWITCH $LWK_SELECT
	CASE 1 THEN
		_BALLOONWIN_OBJMSG_POS( msg_c03r1103_girl3_04 , C03R1103_GIRL3_01, POS_DOWN )
		_AB_KEYWAIT_MARK()
	CASE 2 THEN
		_BALLOONWIN_OBJMSG_POS( msg_c03r1103_girl3_05 , C03R1103_GIRL3_01, POS_DOWN )
		_AB_KEYWAIT_MARK()
	CASE 3 THEN
		_BALLOONWIN_OBJMSG_POS( msg_c03r1103_girl3_06 , C03R1103_GIRL3_01, POS_DOWN )
		_AB_KEYWAIT_MARK()
	CASE 4 THEN
		_BALLOONWIN_OBJMSG_POS( msg_c03r1103_girl3_07 , C03R1103_GIRL3_01, POS_DOWN )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
		//========================================/
		//繰り返し脱出
		$LWK_REPEAT = 1
		//========================================/
			
	DEFAULT
		_BALLOONWIN_OBJMSG_POS( msg_c03r1103_girl3_07 , C03R1103_GIRL3_01, POS_DOWN )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
		//========================================/
		//繰り返し脱出
		$LWK_REPEAT = 1
		//========================================/
	
	ENDSWITCH

ENDWHILE
	
_RET
