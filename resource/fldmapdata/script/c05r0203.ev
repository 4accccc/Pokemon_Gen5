  .text

  .include  "scr_seq_def.h"
  .include  "msg_c05r0203.h"
  .include  "c05r0203.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_c05r0203_girl4_01
_EVENT_DATA   ev_c05r0203_boy4_01
_EVENT_DATA   ev_c05r0203_poke42_01
_EVENT_DATA_END


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
//ev_zone_c05r0203:
//  _END

/**************************************************************/
/*  女の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c05r0203_girl4_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05r0203_girl4_01 )
EVENT_END

/**************************************************************/
/*  男の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c05r0203_boy4_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05r0203_boy4_01 )
EVENT_END

/**************************************************************/
/*  キバゴ：話しかけ（アイテム入手）                          */
/**************************************************************/
EVENT_START   ev_c05r0203_poke42_01

  _TALK_OBJ_START()
  //アイテム（未定）を入手しているか？
  IF FLAG_OFF( FE_C05R0203_ITEMGET_01 ) THEN

    //システム：おや？　ポケモンは
    _SYSWIN_MSG( msg_c05r0203_poke42_01, POS_DEFAULT )
    _AB_KEYWAIT()

    //アイテム「キズぐすり」入手【仮】アイテムは仮です
    _ITEM_EVENT_KEYWAIT ( ITEM_KIZUGUSURI, 1 )

      //==================================//
      //アイテム入手
      _FLAG_SET ( FE_C05R0203_ITEMGET_01 )
      //==================================//

  ELSE

    //キバゴ：ぎゃおお！
    _EASY_TALK_POKEVOICE( MONSNO_541, msg_c05r0203_poke42_02 )

  ENDIF

EVENT_END


