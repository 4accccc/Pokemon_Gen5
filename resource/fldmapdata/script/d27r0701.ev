  .include  "scr_seq_def.h"
  .include  "msg_d27r0701.h"
  .include  "d27r0701.h"

  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_d27r0701_swplazmam_01
_EVENT_DATA    ev_zone_d27r0701
_EVENT_DATA    ev_init_d27r0701
_EVENT_DATA    ev_recover_d27r0701
_EVENT_DATA    ev_scene_d27r0701_plazmam_01
_EVENT_DATA    ev_d27r0701_swplazmam_02w
_EVENT_DATA    ev_d27r0701_swplazmam_02b
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
//パスワード正解取得
DEFINE_LOCAL LCWK_MSGID
DEFINE_LOCAL LCWK_PASSID
/************************************************************/
/*					ZONE_CHANGE_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r0701

  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  IF $WK_SCENE_D27R0501_SWSAGE7_01 == 2 THEN
  
    //乗船2回目終了ならばヒント人を非表示に
   _FLAG_SET( FV_D27R0701_SWPLAZMAM_01 )
   
  ELSIF $WK_SCENE_D27R0501_SWSAGE7_01 == 0 && $LCWK_VERSION == VERSION_B2 THEN
    //乗船2回目ならばヒント人を表示
   _FLAG_RESET( FV_D27R0701_SWPLAZMAM_01 )
  ELSIF $WK_SCENE_D27R0501_SWSAGE7_01 == 0 && $LCWK_VERSION == VERSION_W2 THEN
    //乗船2回目ならばヒント人を表示
   _FLAG_RESET( FV_D27R0701_SWPLAZMAM_01 )
  ENDIF
  
  //乗船2回目終了ならば移動手段助言キャラを非表示に
  IF $WK_SCENE_D27R0501_SWSAGE7_01 == 2 THEN
  
    _FLAG_SET( FV_D27R0701_SWPLAZMAM_02B )
    _FLAG_SET( FV_D27R0701_SWPLAZMAM_02W )
  
  ELSIF $LCWK_VERSION == VERSION_B2 THEN
  
    _FLAG_RESET( FV_D27R0701_SWPLAZMAM_02B )
    _FLAG_SET( FV_D27R0701_SWPLAZMAM_02W )
  
  ELSIF $LCWK_VERSION == VERSION_W2 THEN
    
    _FLAG_SET( FV_D27R0701_SWPLAZMAM_02B )
    _FLAG_RESET( FV_D27R0701_SWPLAZMAM_02W )
  
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r0701
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //乗船2回目でブラックならばヒント人の位置を変更
  IF $WK_SCENE_D27R0701_PLAZMAM_01 == 1 && $LCWK_VERSION == VERSION_B2 THEN
    _OBJ_POS_CHANGE(D27R0701_SWPLAZMAM_01,16,0,26,DIR_UP)
  ENDIF
  
  
INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r0701

  //

INIT_EVENT_END

/************************************************************/
/*					SCENE_CHANGE：元プラズマ団員  						*/
/************************************************************/
EVENT_START	ev_scene_d27r0701_plazmam_01

  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //アニメ：主人公移動
  IF $LCWK_VERSION == VERSION_B2 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 16, 24, FORCE_TYPE_NPC, 8, DIR_LR)
  ELSE
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 16, 43, FORCE_TYPE_NPC, 8, DIR_LR)
  ENDIF
  
  _TIME_WAIT( 4 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //ライバル登場：ブラックとホワイトで分岐
  IF $LCWK_VERSION == VERSION_B2 THEN
    _OBJ_ADD_EX( 17, 20, DIR_DOWN, MMDL_ID_EVENTOBJ_00, SWRIVAL, MV_DMY )
  ELSE
    _OBJ_ADD_EX( 15, 47, DIR_UP, MMDL_ID_EVENTOBJ_00, SWRIVAL, MV_DMY )
  ENDIF
  
  _SE_WAIT()
  
  //アニメ：ライバル移動
  IF $LCWK_VERSION == VERSION_B2 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_rival_come_b)
  ELSE
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_rival_come_w)
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //ライバル：またかよ
  IF $LCWK_VERSION == VERSION_B2 THEN
   _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swrival_02_01 , MMDL_ID_EVENTOBJ_00 ,POS_UR )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swrival_02_01 , MMDL_ID_EVENTOBJ_00 ,POS_DL )
  ENDIF
  _MSGWIN_CLOSE()
  
  //アニメ：したっぱ「！」
  _OBJ_ANIME( D27R0701_SWPLAZMAM_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //ネオプラズマ：おっと！
  IF $LCWK_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swplazmam1_02_01 , D27R0701_SWPLAZMAM_01 ,POS_DL )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swplazmam1_02_01 , D27R0701_SWPLAZMAM_01 ,POS_UR )
  ENDIF
  _MSGWIN_CLOSE()
  
  //ネオプラズマ：おれはあやしくないです
  IF $LCWK_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swplazmam1_02_02 , D27R0701_SWPLAZMAM_01 ,POS_DL )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swplazmam1_02_02 , D27R0701_SWPLAZMAM_01 ,POS_UR )
  ENDIF
  _MSGWIN_CLOSE()
  
  //ライバル：たいへんだな
  IF $LCWK_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swrival_02_02 , MMDL_ID_EVENTOBJ_00 ,POS_UR )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swrival_02_02 , MMDL_ID_EVENTOBJ_00 ,POS_DL )
  ENDIF
  _MSGWIN_CLOSE()
  
  //ネオプラズマ：それは　わからないです
  IF $LCWK_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swplazmam1_02_04 , D27R0701_SWPLAZMAM_01 ,POS_DL )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swplazmam1_02_04 , D27R0701_SWPLAZMAM_01 ,POS_UR )
  ENDIF
  _MSGWIN_CLOSE()
  
  //ライバル：まあいいさ
  IF $LCWK_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swrival_02_03 , MMDL_ID_EVENTOBJ_00 ,POS_UR )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swrival_02_03 , MMDL_ID_EVENTOBJ_00 ,POS_DL )
  ENDIF
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  IF $LCWK_VERSION == VERSION_B2 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_rival_bye_b)
    _OBJ_ANIME_WAIT()
    //階段SE再生
    _SE_PLAY( SEQ_SE_KAIDAN )
    _SE_WAIT()
  ELSE
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_rival_bye_w)
    _TIME_WAIT( 16 )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d)
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //ライバル動作モデル削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  IF $LCWK_VERSION == VERSION_W2 THEN
    //アニメ：主人公向きなおす
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u)
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //アニメ：したっぱ「…」
  _OBJ_ANIME( D27R0701_SWPLAZMAM_01, anm_common_tenten )
  _OBJ_ANIME_WAIT()
  
  //ネオプラズマ：……うう
  IF $LCWK_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swplazmam1_02_05 , D27R0701_SWPLAZMAM_01 ,POS_DL )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d27r0701_swplazmam1_02_05 , D27R0701_SWPLAZMAM_01 ,POS_UR )
  ENDIF
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //========================================//
  //D27R0701 SCENE_CHANGE無効
  $WK_SCENE_D27R0701_PLAZMAM_01 = 2
  //D27アナウンスSCENE_CHANGE起動
  $WK_SCENE_D27_ANNOUNCE = 1
  //========================================//
  
EVENT_END

