//--------------------------------------------------------------------
_ANIME_LABEL	anm_rival_bye_b
	_ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	AC_WALK_D_8F,3
	_ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*					話しかけ：元プラズマ団員  						*/
/************************************************************/
EVENT_START	ev_d27r0701_swplazmam_01
  _TALK_OBJ_START() 
  _BALLOONWIN_OBJMSG_WB( msg_d27r0701_swplazmam1_02_03w , msg_d27r0701_swplazmam1_02_03b , D27R0701_SWPLAZMAM_01 , POS_DEFAULT)
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
EVENT_END

/************************************************************/
/*					話しかけ：プラズマ団員  						*/
/************************************************************/
EVENT_START	ev_d27r0701_swplazmam_02w
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0701_swplazmam_end_01 )
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0701_swplazmam2_01w )
  ENDIF
EVENT_END

/************************************************************/
/*					話しかけ：プラズマ団員  						*/
