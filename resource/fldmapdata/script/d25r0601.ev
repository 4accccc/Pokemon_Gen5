//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_pos_d25r0601_girl2_01
_EVENT_DATA   ev_bg_d25r0601_picture_01
_EVENT_DATA   ev_bg_d25r0601_picture_02
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_d25r0601:
//  _END

/**************************************************************/
/*  POS:幽霊少女イベント                                      */
/**************************************************************/
EVENT_START   ev_pos_d25r0601_girl2_01

  _TIME_WAIT ( 16 )

  //==================================//
  //幽霊少女表示
  _FLAG_RESET( FV_D25_GIRL2_01 )
  //==================================//

  //女の子出現
  _OBJ_ADD( D25R0601_GIRL2_01 )
  
  _OBJ_ANIME( D25R0601_GIRL2_01, anm_girl_deru )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT ( 8 )

  //幽霊少女：まっくろの　ゆめの　なか……
  _BALLOONWIN_OBJMSG_POS( msg_d25r0601_girl2_01, D25R0601_GIRL2_01, POS_DOWN )
  _MSGWIN_CLOSE()

  _TIME_WAIT ( 16 )

  _OBJ_ANIME( D25R0601_GIRL2_01, anm_girl_kieru )
  _OBJ_ANIME_WAIT()

  //女の子を非表示
  _OBJ_DEL( D25R0601_GIRL2_01 )

  //========================================//
  //幽霊少女非表示
  _FLAG_SET( FV_D25_GIRL2_01 )
  //POSイベント進行
  $WK_SCENE_D05_GIRL2 = 2
  //========================================//

EVENT_END

/**************************************************************/
/*  絵画01                                                    */
/**************************************************************/
EVENT_START   ev_bg_d25r0601_picture_01

  _TALK_START_SE_PLAY()
  //ＢＧ：しょうぞうがが　ずれおちている……
  _PLAINWIN_MSG_DOWN( msg_d25r0601_picture_01 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  絵画02                                                    */
/**************************************************************/
EVENT_START   ev_bg_d25r0601_picture_02

  _TALK_START_SE_PLAY()
  //ＢＧ：いつのまにか
  _PLAINWIN_MSG_DOWN( msg_d25r0301_picture_02 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()

EVENT_END

