_EVENT_DATA   ev_zone_c02
_EVENT_DATA   ev_bg_c02_sign1_01
_EVENT_DATA   ev_bg_c02_sign2_01
_EVENT_DATA   ev_bg_c02_gymsign_01
_EVENT_DATA   ev_pos_c02_sppoke1_01
_EVENT_DATA   ev_c02_sppoke1_01
