_EVENT_DATA		ev_c02_middlewoman2_01
_EVENT_DATA		ev_c02_backpackerw_01
_EVENT_DATA		ev_c02_accordion_01
_EVENT_DATA		ev_c02_girl3a_01
_EVENT_DATA		ev_c02_girl3b_01
_EVENT_DATA	ev_bg_c02_sign3_01
_EVENT_DATA	ev_bg_c02_sign4_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_c02

  //ユクシーを呼び出した状態でゾーンチェンジした場合、再度POSイベントから
  IF FLAG_OFF( FV_C02_SPPOKE1_01 ) && $WK_SCENE_C02_SPPOKE1_01 == 2 THEN

    //==================================//
    //ユクシー非表示
    _FLAG_SET( FV_C02_SPPOKE1_01 )
    //POS再配置
    $WK_SCENE_C02_SPPOKE1_01 = 1
    //==================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  C02 SIGN1の会話用イベントスクリプト                      */
/**************************************************************/
EVENT_START   ev_bg_c02_sign1_01
  _EASY_BGWIN_MSG( msg_c02_sign1_01, TYPE_TOWN)   //簡易メッセージＢＧ用
EVENT_END

