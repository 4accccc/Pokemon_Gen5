//★C12連れ歩きストッパー振り向き処理
ev_c12_rival_ng_return01:
  //進入方向によって演出を分岐
  _PLAYER_DIR_GET( LWK_DIR )
  SWITCH $LWK_DIR
  CASE DIR_LEFT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_l )
    _OBJ_ANIME_WAIT()
	CASE DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_r )
    _OBJ_ANIME_WAIT()
	CASE DIR_UP THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_u )
    _OBJ_ANIME_WAIT()
	CASE DIR_DOWN THEN  //本来ここにはこないが念のため
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_d )
    _OBJ_ANIME_WAIT()
  ENDSWITCH
_RET

//★C12連れ歩きストッパー戻り処理
ev_c12_rival_ng_return02:
  //アニメ：下に移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_downwalk )
  _OBJ_ANIME_WAIT()
_RET

/**************************************************************/
/*  C12：POS：高台方面                         */
/**************************************************************/
EVENT_START ev_pos_c12_rival_pair_01_guide
  //話しかけた方向によって演出を分岐
  _PLAYER_DIR_GET( LWK_DIR )
  SWITCH $LWK_DIR
  CASE DIR_LEFT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    _OBJ_ANIME_WAIT()
	CASE DIR_RIGHT THEN //本来ここにはこないが念のため
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_l )
    _OBJ_ANIME_WAIT()
	CASE DIR_UP THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_l )
    _OBJ_ANIME_WAIT()
	CASE DIR_DOWN THEN 
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_u )
    _OBJ_ANIME_WAIT()
  ENDSWITCH
  
  //ライバル：ちがうよ
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_04,PAIR_TRAINER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
   //========================================//
  //POSイベント無効
  $WK_SCENE_C12_RIVAL_GUIDE_01 = 1
  //========================================//
  
EVENT_END


