_EVENT_DATA    ev_zone_c12
_EVENT_DATA    ev_init_c12
_EVENT_DATA    ev_c12_swbell_01
_EVENT_DATA    ev_pos_c12_swbell_meet_btl
_EVENT_DATA    ev_c12_swmama_01
_EVENT_DATA    ev_c12_swsister_01
_EVENT_DATA    ev_c12_boy2_01
_EVENT_DATA    ev_c12_oldman1_01
_EVENT_DATA    ev_c12_man3_01
_EVENT_DATA    ev_bg_c12_board_01
_EVENT_DATA    ev_bg_c12_board_02
_EVENT_DATA    ev_bg_c12_board_03
_EVENT_DATA    ev_bg_c12_board_04
_EVENT_DATA    ev_pos_c12_rival_pair_01
_EVENT_DATA    ev_pos_c12_ng_01
_EVENT_DATA    ev_pos_c12_ng_02
