/**************************************************************/
/*			タウンマップ入手イベント					  */
/**************************************************************/
EVENT_START		ev_scene_c12_townmap_01

  	//最初に選択した三匹で台詞内にセットする名前を変える
		IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
			//最初の３匹で草タイプを選択した時の処理
			
			//0に選択ポケモンの名前をセット
			_MONS_NAME(2,MONSNO_551)
			//1に有効ポケモンの名前をセット
				
		ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN	
			//最初の３匹で炎タイプを選択した時の処理
			
			//0に選択ポケモンの名前をセット
			_MONS_NAME(2,MONSNO_554)
			
		ELSE
			//最初の３匹で水タイプを選択した時の処理
			
			//0に選択ポケモンの名前をセット
			_MONS_NAME(2,MONSNO_557)
				
		ENDIF
		
  //ママ：よっ！
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_c12_swmama_01,C12_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ「！」
  _OBJ_ANIME( C12_SWMAMA_01, anm_common_gyoe )
	_OBJ_ANIME_WAIT()
	
	//ママ：おっと
	_BALLOONWIN_OBJMSG_POS( msg_c12_swmama_02,C12_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ママ主人公に隣接
  _OBJ_ANIME_AUTO( C12_SWMAMA_01, 48, 741, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME( C12_SWBELL_01, anm_staystep_r )
	_OBJ_ANIME_WAIT()
	
	//ME鳴らす
	_GET_SHOES()
	_ME_PLAY( SEQ_ME_KEYITEM )
	_PLAYER_NAME( 0 )	 //プレイヤー名を反映
	_SYSWIN_MSG( msg_c12_swmama_03, POS_DEFAULT )	//～～を手に入れた
	_ME_WAIT()
	_AB_KEYWAIT_MARK()
	_SYSWIN_CLOSE()
	
	//ママ：にあってるじゃない
	_BALLOONWIN_OBJMSG_POS( msg_c12_swmama_04,C12_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：いもうと主人公に隣接
  _OBJ_ANIME_AUTO( C12_SWSISTER_01, 49, 740, FORCE_TYPE_NPC, 8, DIR_LR)
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME( C12_SWSISTER_01, anm_staystep_l )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
	_OBJ_ANIME_WAIT()
	
	//【仮】ライバル名代入
  _NUMBER( 1 , 12345 , 5 )
	
	//妹：あたしからはこれを
	_BALLOONWIN_OBJMSG_POS( msg_c12_rivalsister_03,C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //タウンマップ入手処理
	_ITEM_EVENT_KEYWAIT( ITEM_TAUNMAPPU, 1 )
	
	//ベル：その　タウンマップ
	_BALLOONWIN_OBJMSG_POS( msg_c12_white_18,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //【仮】ライバル名代入
   _NUMBER( 1 , 12345 , 5 )
   
  //妹：おにいちゃんに
	_BALLOONWIN_OBJMSG_POS( msg_c12_rivalsister_05,C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ママ：そうね！
	_BALLOONWIN_OBJMSG_POS( msg_c12_swmama_05,C12_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	_OBJ_ANIME_WAIT()
  
  //ベル：さあ！
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_19,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
   //アニメ：ベル退場
  _OBJ_ANIME( C12_SWBELL_01, anm_townmap_bell_bye )
  
  _TIME_WAIT(48)
  
  //アニメ：見送り
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME( C12_SWMAMA_01, anm_staystep_r )
  _OBJ_ANIME( C12_SWSISTER_01, anm_staystep_r )
  
	_OBJ_ANIME_WAIT()
	
	//アニメ：向かい合う
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME( C12_SWMAMA_01, anm_townmap_mama_back )
  _OBJ_ANIME( C12_SWSISTER_01, anm_townmap_sister_back )
	_OBJ_ANIME_WAIT()
	
	//ママ：いってらっしゃい！
	_BALLOONWIN_OBJMSG_POS( msg_c12_swmama_06,C12_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
	
	//妹：いってらっしゃい！
	_BALLOONWIN_OBJMSG_POS( msg_c12_white_20,C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //ベル動作モデル非表示
  _OBJ_DEL(C12_SWBELL_01)
  
  //==================================//
	
	//C12のSCENE_CHANGE起動をOFFに
	$WK_SCENE_C12_WHITE_MEET = 6
	
	//C12のベルを非表示
	_FLAG_SET( FV_C12_SWBELL )

	//==================================//
EVENT_END

//====================================================================
//  C12連れ歩き
//====================================================================
//連れ歩きスタート
EVENT_START ev_pos_c12_rival_pair_01
{
  //主人公名を代入
  _PLAYER_NAME(0)
  //【仮】ライバル名代入
   _NUMBER( 1 , 12345 , 5 )
  
  //妹：主人公さーん！
  _PLAINWIN_MSG_DOWN( msg_c12_rivalsister_01 )
	_MSGWIN_CLOSE()
	
	//【仮】アニメ：ライバル・妹登場（POSの位置が仮なため登場演出を仮とする）
	_OBJ_ANIME_AUTO( C12_SWSISTER_01, 43, 762, FORCE_TYPE_NPC, 8, DIR_LR)
	_OBJ_ANIME_AUTO( C12_SWRIVAL_01, 43, 763, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ライバル：どこいくの？
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_01,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル・妹向き合う
  _OBJ_ANIME( C12_SWSISTER_01, anm_staystep_d )
	_OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ライバル：かえってな
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_02,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：妹主人公の方を向く
  _OBJ_ANIME( C12_SWSISTER_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //妹：じゃあね
  _BALLOONWIN_OBJMSG_POS( msg_c12_rivalsister_02,C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：妹退場
  _OBJ_ANIME_AUTO( C12_SWSISTER_01, 36, 762, FORCE_TYPE_NPC, 8, DIR_LR)
	_OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_r )
  
  //ライバル：さてと
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_03,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME_WAIT()
  
  //ライバル妹の動作OBJを非表示
	_OBJ_DEL(C12_SWSISTER_01)
  
  //アニメ：ライバル主人公に隣接
  DEFINE_LOCAL  i_x
  DEFINE_LOCAL  i_z

  _PLAYER_POS_GET( i_x, i_z )
  $i_x -= 1
  _OBJ_ANIME_AUTO( C12_SWRIVAL_01, i_x, i_z, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //連れ歩き開始
  _PAIR_TRAINER_SET( C12_SWRIVAL_01, PAIR_ID_NATURAL, PAIR_TYPE_OPEN, TRID_RIVAL_07 )
  
  //========================================//
  //POSイベント無効
  $WK_SCENE_C12_WHITE_MEET = 1
  
  //ライバル妹を非表示
  _FLAG_SET(FV_C12_SWRIVAL_SISTER)
  //========================================//

}
EVENT_END

//連れ歩き解除
EVENT_START ev_pos_c12_rival_pair_return_01
{

  //【仮】ライバル名代入
  _NUMBER( 1 , 12345 , 5 )
   
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_11, PAIR_TRAINER_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //連れ歩き解除
  _PAIR_TRAINER_FREE( MV_DMY )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  IF $LCW_POSX == 36 THEN
    _OBJ_ANIME_AUTO( C12_SWRIVAL_01, 38, 714, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
  ELSE
    _OBJ_ANIME_AUTO( C12_SWRIVAL_01, 35, 714, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_r )
    _OBJ_ANIME_WAIT()
  ENDIF

  
  //========================================//
  //POSイベント無効
  $WK_SCENE_C12_WHITE_MEET = 2
  //========================================//
}
EVENT_END

