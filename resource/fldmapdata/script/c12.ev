//話しかけた方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LWK_POSX
DEFINE_LOCAL  LWK_POSZ
DEFINE_LOCAL  ans_yes

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c12
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c12

  //イベント進行で配置を分岐
  IF $WK_SCENE_C12_WHITE_MEET == 0 THEN
    //ゲーム開始直後なら妹・ライバルの初期位置を変更
    _OBJ_POS_CHANGE( C12_SWSISTER_01, 42, 1, 751, DIR_RIGHT )
    _OBJ_POS_CHANGE( C12_SWRIVAL_01, 43, 1, 751, DIR_LEFT )
  
  //ライバルの位置を移動
  ELSIF $WK_SCENE_C12_WHITE_MEET == 1 THEN
    //_OBJ_POS_CHANGE( C12_SWRIVAL_01, 37, 8, 717, DIR_UP )
    //ポケセン案内後ならベルの位置を移動
  ELSIF $WK_SCENE_C12_WHITE_MEET == 6 THEN
    _OBJ_POS_CHANGE( C12_SWBELL_01, 49, 1, 740, DIR_LEFT )
    _OBJ_POS_CHANGE( C12_SWMAMA_01, 38, 1, 740, DIR_RIGHT )
    _OBJ_POS_CHANGE( C12_SWSISTER_01, 38, 1, 741, DIR_RIGHT )
  ENDIF
  
  //ジムストッパー（ジム開放まで）
  IF $WK_SCENE_C12_WHITE_MEET < 2 || $WK_SCENE_C12GYM_OPEN >= 1 THEN
    //連れ歩き中・ジムオープンはドア前にいない
    _OBJ_POS_CHANGE( C12_BOY2_01, 36, 1, 741, DIR_RIGHT )
  ENDIF
  
  //ジムクリア後
  IF $WK_SCENE_C12GYM_OPEN == 2 THEN
    _OBJ_POS_CHANGE( C12_SWBELL_01, 42, 1, 741, DIR_LEFT )
  ENDIF
  
  //ポケガイダンスまでライバルとベルの位置を変更（ジム内のチェレンについて要検討）
  IF $WK_SCENE_C12GYM_OPEN == 3 THEN
    _OBJ_POS_CHANGE( C12_SWBELL_01, 40, 1, 741, DIR_DOWN )
  ENDIF

  //エンディング後ならライバルと妹の位置を変更
  IF $WK_SCENE_SPPOKE_EVENT_01 == 1 THEN

    _OBJ_POS_CHANGE( C12_SWRIVAL_01, 45, 1, 762, DIR_RIGHT )
    _OBJ_POS_CHANGE( C12_SWSISTER_01, 45, 1, 763, DIR_RIGHT )

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  C12：POS：高台方面                         */
/**************************************************************/
EVENT_START ev_pos_c12_rival_pair_01_guide

  //アニメ：ライバルが！マークを
  _OBJ_ANIME( PAIR_TRAINER_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_u )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  //ライバル名代入
  _RIVAL_NAME( 1 )
  
  //ライバル：スパークしたぜッ！
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_11,PAIR_TRAINER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //========================================//
  //ライバルを表示
  _FLAG_RESET(FV_C12_SWRIVAL)
  //========================================//
  
  //ライバル動作モデル生成
  _OBJ_ADD( C12_SWRIVAL_01 )
  
  //自機座標取得
  _PLAYER_POS_GET( LWK_POSX,LWK_POSZ ) 
  _OBJ_POS_CHANGE( C12_SWRIVAL_01, LWK_POSX, 7, 720, DIR_UP )
  
  //連れ歩き解除
  _PAIR_TRAINER_FREE( SCRID_C12_SWRIVAL_01, MV_DMY )
  
  //連れ歩き動作モデル削除
  _OBJ_DEL( PAIR_TRAINER_01 )

  IF $LWK_POSX != 36 THEN
  
    _OBJ_ANIME_AUTO( C12_SWRIVAL_01, 36, 720, FORCE_TYPE_NOT, 8, DIR_UD )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_u )
    _OBJ_ANIME_WAIT()
  
  ENDIF

   //========================================//
  //POSイベント無効
  $WK_SCENE_C12_RIVAL_GUIDE_01 = 1
  //ストッパー有効
  $WK_SCENE_C12_WHITE_MEET = 2
  //========================================//
  
EVENT_END


/**************************************************************/
/*  ライバルはなしかけ                         */
/**************************************************************/
EVENT_START ev_c12_swrival_01
    
  _TALK_OBJ_START()
  
  IF $WK_SCENE_C12_WHITE_MEET <= 2 THEN
    //ライバル名代入
    _RIVAL_NAME( 1 )
    //オレの　スパークに　まちがいないぜ
    _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_12,C12_SWRIVAL_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ELSIF $WK_SCENE_C12_WHITE_MEET == 3 THEN
    //ライバル名代入
    _RIVAL_NAME( 1 )
    //なッ！　ベルって　ひと　いたんだろ
    _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_20,C12_SWRIVAL_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  //ライバル戦分岐
  ELSE
  	//ライバル曲再生
  	_START_EVENT_BGM( SEQ_BGM_E_HUE )
    //ライバル戦をコール
    _CALL		ev_vs_rival
  ENDIF
EVENT_END

/**************************************************************/
/*  ベルはなしかけ                         */
/**************************************************************/
EVENT_START ev_c12_swbell_01

  //初回会話か？
  IF $WK_SCENE_C12_WHITE_MEET <= 2 THEN
  
  	_CALL bell_firsttalk
  
  //２回目の会話か？
  ELSIF $WK_SCENE_C12_WHITE_MEET == 3 THEN
  
  	_CALL bell_secondtalk

  //３回目の会話か？
  ELSIF $WK_SCENE_C12_WHITE_MEET == 4 THEN
  
  	//それにしても　アララギはかせ　ったら！
  	_TALK_OBJ_START()
  	_BALLOONWIN_OBJMSG_POS( msg_c12_white_39 ,C12_SWBELL_01 ,POS_UP )
  	_LAST_KEYWAIT()
  	_MSGWIN_CLOSE()
  
  //４回目の会話か？
  ELSIF $WK_SCENE_C12_WHITE_MEET == 5 THEN
  
  	//ねえねえ　ふたりとも　ポケモン勝負
  	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12_white_32 )
  
  
  //それ以外
  ELSE

	//ジムクリア後
	IF $WK_SCENE_C12GYM_OPEN == 3 THEN
		
		//本体設定が通信可能な状態かチェック
		_GET_AVAILABLE_WIRELESS( SCWK_TEMP0 )
		IF $SCWK_TEMP0 == TRUE THEN
			_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12_white_35 )
		ELSE
			_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12_white_36 )
		ENDIF
	
	ELSE
	//ジムクリア前
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12_white_14 )
	ENDIF
  
  ENDIF

EVENT_END

/************************************************************/
/*	ベル初回会話用スクリプト							*/
/************************************************************/
bell_firsttalk:
  _TALK_START_TURN_NOT()

  //ベル曲再生
  _START_EVENT_BGM( SEQ_BGM_E_BERU )

  //ベル：きれい　だよねえ！
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_01,C12_SWBELL_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //プレイヤーの方向を取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  SWITCH $LWK_DIR
  CASE DIR_UP THEN
    _OBJ_ANIME( C12_SWBELL_01, anm_staystep_d )
  CASE DIR_LEFT THEN
    _OBJ_ANIME( C12_SWBELL_01, anm_staystep_r )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( C12_SWBELL_01, anm_staystep_l )
  ENDSWITCH
  _OBJ_ANIME_WAIT()

  //ベル：ねえねえ　そうおもうでしょ？
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_02,C12_SWBELL_01, POS_UP )
  _MSGWIN_CLOSE()

  //アニメ：「！」
  _OBJ_ANIME( C12_SWBELL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //ベル：（主人公名）を探してるんだけど
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_03,C12_SWBELL_01, POS_UP ) 
  
  //はい・いいえ選択肢
  _YES_NO_WIN( SCWK_ANSWER )

  _MSGWIN_CLOSE()
  
  //アニメ：「！」
  _OBJ_ANIME( C12_SWBELL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //って！　あなた　●●！
  _BALLOONWIN_OBJMSG_MF( msg_c12_white_37, msg_c12_white_38, C12_SWBELL_01, POS_UP )
  _MSGWIN_CLOSE()

  //ベル芝居
  _OBJ_ANIME( C12_SWBELL_01, anm_swbell_anime )
  _OBJ_ANIME_WAIT()

  //ベル：はじめまして！
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_04,C12_SWBELL_01, POS_UP )
  _YES_NO_WIN( SCWK_ANSWER )
  
  //いいえなら再質問
  IF $SCWK_ANSWER == SCR_NO THEN
    //いいえの処理
    
    //再質問にyesと答えるまでループ
    $ans_yes = SCR_NO

    WHILE $ans_yes == SCR_NO
    
     //メッセージ：そ、そんなあ
     _BALLOONWIN_OBJMSG_POS( msg_c12_white_31,C12_SWBELL_01, POS_UP )
     _YES_NO_WIN( ans_yes )
     
   ENDWHILE
  ENDIF
  
  //はい選択時
  
  //ベル：えへへ！
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_30,C12_SWBELL_01, POS_UP )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

  _END_EVENT_BGM()

  //========================================//
  //POSイベント無効
  $WK_SCENE_C12_WHITE_MEET = 3
  //========================================//

_RET

 //--------------------------------------------------------------------
//	☆ベル：ベル専用アニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swbell_anime
  _ANIME_DATA	AC_SWBELL_HAT,1
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_swbell_walk
  _ANIME_DATA	AC_WALK_U_8F,2
  _ANIME_DATA	ACMD_END,0

/************************************************************/
/*	ベル２回目会話用スクリプト						*/
/************************************************************/
bell_secondtalk:

  _TALK_OBJ_START()

  //ベル：それでは　じゃじゃーん！！
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_05,C12_SWBELL_01, POS_UP )
  _MSGWIN_CLOSE()
 
  //---------------三匹選択アプリを呼び出し--------------//
	{
	DEFINE_LOCAL	lwk_ret_num
	DEFINE_LOCAL	lwk_poke_num
	
	_MAP_FADE_BLACK_OUT()
	_DISP_FADE_END_CHECK()
	
	_CALL_FIRST_POKE_SELECT( lwk_ret_num )
	
	_MAP_FADE_WHITE_IN()
	_DISP_FADE_END_CHECK()
	
	IF $lwk_ret_num == 0 THEN
		//草タイプを選んだ
		$WK_SYS_FIRST_POKETYPE = FIRST_POKETYPE_KUSA
		_SET_MY_ANSWER( QUESTION_ID_FIRST_POKEMON, 3 ) // 草タイプを選択（すれ違い調査隊用）
		$lwk_poke_num = MONSNO_551	//ツタージャをセット
		_MONS_NAME( 1, MONSNO_551 )	//ポケモン名タグをセット
		_MONS_NAME( 2, MONSNO_551 )	//ポケモン名タグをセット

	ELSIF $lwk_ret_num == 1 THEN
		//炎タイプを選んだ
		$WK_SYS_FIRST_POKETYPE = FIRST_POKETYPE_HONOO
		_SET_MY_ANSWER( QUESTION_ID_FIRST_POKEMON, 1 ) // 炎タイプを選択（すれ違い調査隊用）
		$lwk_poke_num = MONSNO_554	//ポカブをセット
		_MONS_NAME( 1, MONSNO_554 )	//ポケモン名タグをセット
		_MONS_NAME( 2, MONSNO_554 )	//ポケモン名タグをセット

	ELSE
		//水タイプを選んだ
		$WK_SYS_FIRST_POKETYPE = FIRST_POKETYPE_MIZU
		_SET_MY_ANSWER( QUESTION_ID_FIRST_POKEMON, 2 ) // 水タイプを選択（すれ違い調査隊用）
		$lwk_poke_num = MONSNO_557	//ミジュマルをセット
		_MONS_NAME( 1, MONSNO_557 )	//ポケモン名タグをセット
		_MONS_NAME( 2, MONSNO_557 )	//ポケモン名タグをセット

	ENDIF
	
	//ME鳴らす
	_ME_PLAY( SEQ_ME_POKEGET )
	_PLAYER_NAME( 0 )	 //プレイヤー名を反映
	_SYSWIN_MSG( msg_c12_ball_get_01, POS_UP )	//～～を手に入れた
	_ME_WAIT()
	_AB_KEYWAIT_MARK()
	_SYSWIN_CLOSE()
	
	//ポケモン追加
	_ADD_POKEMON_TO_PARTY( SCWK_ANSWER, lwk_poke_num, 0, 5 )
	
	//初期３体入手フラグ
	_FLAG_SET( SYS_FLAG_FIRST_POKE_GET )
	
	}
	//--------------------------------------------------------//
	
	//ベル：ってぴったり　ニックネームつける？
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_06,C12_SWBELL_01, POS_UP )
  
  _YES_NO_WIN( SCWK_ANSWER )

	//はい/いいえで分岐
	IF $SCWK_ANSWER == SCR_YES THEN
		//はいの処理
		_MSGWIN_CLOSE()
		//ニックネーム入力処理
		_CALL		ev_name_input
	ELSE
		//いいえの処理
		//ニックネームをつけないんだね
		_BALLOONWIN_OBJMSG_POS( msg_c12_white_07 , C12_SWBELL_01 , POS_UP )
	ENDIF
  
  _MSGWIN_CLOSE()

  //ベル芝居
  _OBJ_ANIME( C12_SWBELL_01, anm_swbell_anime )
  _OBJ_ANIME_WAIT()

  //ベル：ポケモンのつぎは
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_10 , C12_SWBELL_01 , POS_UP )
  _MSGWIN_CLOSE()
  

//********************ポケモン図鑑入手処理*******************//

	//ポケモン図鑑入手フラグをセット
	_FLAG_SET( SYS_FLAG_ZUKAN_GET )

	//ME鳴らす
	_ME_PLAY( SEQ_ME_KEYITEM )

	_GET_MY_SEX( SCWK_ANSWER )	//主人公の性別取得
	IF $SCWK_ANSWER == PM_MALE THEN
		_CALL_FLD3D_CUTIN( FLDCIID_ZUKAN_M )	//男の子
	ELSE
		_CALL_FLD3D_CUTIN( FLDCIID_ZUKAN_W )	//女の子
	ENDIF

	//ポケモンずかんを手に入れた！
	_PLAYER_NAME( 0 ) //プレイヤー名を反映
	_SYSWIN_MSG( msg_c12_white_11, POS_UP )

	_ME_WAIT()
	_AB_KEYWAIT_MARK()
	_SYSWIN_CLOSE()
	
//***********************************************************//

  //ベル：ポケモンずかんはね
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_12 , C12_SWBELL_01 , POS_UP )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

  //========================================//
  //POSイベント無効
  $WK_SCENE_C12_WHITE_MEET = 4
  //========================================//

_RET

//★ニックネーム入力処理
ev_name_input:

	//ローカル変数を定義
	{
	DEFINE_LOCAL	lwk_name_while
	DEFINE_LOCAL	lwk_nick_name

	WHILE $lwk_name_while != 555

		//名前入力画面呼び出し（インデックスは１匹しかいないはずなので固定値）
		_MAP_FADE_BLACK_OUT()
		_DISP_FADE_END_CHECK()
		_PARTY_POKE_NAME_INPUT( SCWK_ANSWER, 0, FALSE )
		
		_MAP_FADE_BLACK_IN()
		_DISP_FADE_END_CHECK()

		//ニックネームフラグチェック
		_GET_PARTY_POKE_PARAM( lwk_nick_name, 0, SCR_POKEPARA_NICKNAME_FLAG )

		//ニックネームがついていないなら確認
		IF $lwk_nick_name == TRUE THEN
			//その[ニックネーム]で良いですか？
			_TEMOTI_NICK_NAME( 0, 0 )
			_BALLOONWIN_OBJMSG_POS( msg_c12_white_09, C12_SWBELL_01, POS_UP )
			_YES_NO_WIN( SCWK_ANSWER )

			IF $SCWK_ANSWER == SCR_YES THEN
				//はいなら繰り返し処理から抜ける
				$lwk_name_while = 555
			ELSE
				//いいえならウインドウを閉じて名前入力画面へ（ループ）
				_MSGWIN_CLOSE()
			ENDIF

		ELSE
			//入力無しなら繰り返し処理から抜ける
			$lwk_name_while = 555

		ENDIF

	ENDWHILE

	//名前入力の有無で分岐
	IF $lwk_nick_name == TRUE THEN
		//ニックネームあり
		
		//～～と言うのか
		_TEMOTI_NICK_NAME( 0, 0 )	//ニックネーム取得
		_BALLOONWIN_OBJMSG_POS( msg_c12_white_08 , C12_SWBELL_01, POS_UP )

	ELSE
		//ニックネーム無し（キャンセル操作で戻ってきたor種族名と同じ文字列を入力した）
		
		//ニックネームを　つけないんだね
		_BALLOONWIN_OBJMSG_POS( msg_c12_white_07 , C12_SWBELL_01, POS_UP )

	ENDIF

	}
_RET

/**************************************************************/
/*  ベルはなしかけ                         */
/**************************************************************/
EVENT_START ev_c12_swleader1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12_swleader1_04 )
EVENT_END

/**************************************************************/
/*  ママはなしかけ                         */
/**************************************************************/
EVENT_START ev_c12_swmama_01

  	//最初に選択した三匹で台詞内にセットする名前を変える
		IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
			//最初の３匹で草タイプを選択した時の処理
			
			//0に選択ポケモンの名前をセット
			_MONS_NAME(2,MONSNO_551)
			//1に有効ポケモンの名前をセット
				
		ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN	
			//最初の３匹で炎タイプを選択した時の処理
			
			//0に選択ポケモンの名前をセット
			_MONS_NAME(2,MONSNO_554)
			
		ELSE
			//最初の３匹で水タイプを選択した時の処理
			
			//0に選択ポケモンの名前をセット
			_MONS_NAME(2,MONSNO_557)
				
		ENDIF
		
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12_swmama_06 )
EVENT_END

/**************************************************************/
/*  妹はなしかけ                         */
/**************************************************************/
EVENT_START ev_c12_swsister_01
  //ライバル名代入
  _RIVAL_NAME( 1 )
  
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12_white_20 )
EVENT_END

/**************************************************************/
/*  POS：ベルと出会う（ストッパー）                         */
/**************************************************************/
EVENT_START ev_pos_c12_swbell_meet_stop_01
  
  _OBJ_ANIME( C12_SWRIVAL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_r )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：オレの　スパークに　まちがいは　ないぜッ！
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_13,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  //1歩戻る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
EVENT_END

EVENT_START ev_pos_c12_swbell_meet_stop_02
  
  _OBJ_ANIME( C12_SWRIVAL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_r )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：なッ！　ベルって　ひと　いたんだろ
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_21,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  //1歩戻る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
EVENT_END

/**************************************************************/
/*  POS：ライバルが高台に来る							  */
/**************************************************************/
EVENT_START ev_pos_c12_swbell_meet_rival

  _PLAYER_POS_GET( LWK_POSX, LWK_POSZ )

  _OBJ_ANIME_AUTO( C12_SWRIVAL_01, LWK_POSX, 716, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  _PLAYER_DIR_GET(SCWK_ANSWER)
  IF $SCWK_ANSWER == DIR_RIGHT THEN
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
	_OBJ_ANIME_WAIT()
  ENDIF

  //ライバル名格納
  _RIVAL_NAME( 1 )

  //ライバル：おーい　いつまで　またせるんだよ！
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_26 , C12_SWRIVAL_01 , POS_DEFAULT )
  _MSGWIN_CLOSE()

  //！マーク表示後、主人公に近づく
  _OBJ_ANIME( C12_SWRIVAL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWRIVAL_01, anm_walk_u )
  _OBJ_ANIME_WAIT()

  //ライバル：そいつが　オマエの　パートナー！
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_15 , C12_SWRIVAL_01 , POS_DEFAULT )
  _MSGWIN_CLOSE()

  SWITCH $LWK_POSX
  CASE 36 THEN
    $LWK_POSX = 37
  CASE 37 THEN
    $LWK_POSX = 36
  CASE 38 THEN
    $LWK_POSX = 37
  ENDSWITCH

  //ベルが近づいてくる
  _OBJ_ANIME_AUTO( C12_SWBELL_01, LWK_POSX, 713, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //ベル：それは　ポケモンずかん　だよ
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_41 , C12_SWBELL_01 , POS_UP )
  _MSGWIN_CLOSE()

  //ライバル：少し悩んだ後に話を切り出す
  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWRIVAL_01, anm_common_tenten )
  _OBJ_ANIME_WAIT()
  _TIME_WAIT( 30 )
  
  //ライバル：ベルのほうをみる
  _OBJ_ANIME_AUTO( C12_SWRIVAL_01, LWK_POSX, 715, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  _PLAYER_POS_GET( LWK_POSX, LWK_POSZ )

  SWITCH $LWK_POSX
  CASE 36 THEN
  	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  CASE 37 THEN
  	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  CASE 38 THEN
  	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  ENDSWITCH
  _OBJ_ANIME_WAIT()

  //ライバル名代入
  _RIVAL_NAME( 1 )
   
  //ライバル：……オレにも　ポケモンずかんを　くれませんか？
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_16 , C12_SWRIVAL_01 , POS_UP )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( C12_SWBELL_01, anm_common_hatena )
  _OBJ_ANIME_WAIT()

   //ベル：あなたは？
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_13 , C12_SWBELL_01 , POS_DEFAULT )
  _MSGWIN_CLOSE()

  //ライバル名代入
  _RIVAL_NAME( 1 )

  //ライバル：オレは
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_22 , C12_SWRIVAL_01 , POS_UP )
  _MSGWIN_CLOSE()
  
  //アニメ：ベル考える動作
  _OBJ_ANIME( C12_SWBELL_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWBELL_01, anm_common_tenten )
  _OBJ_ANIME_WAIT()
  _TIME_WAIT( 20 )
  _OBJ_ANIME( C12_SWBELL_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
   //ベル：うん　いいよ！
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_14 , C12_SWBELL_01 , POS_DEFAULT )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( C12_SWBELL_01, anm_walk_d )
  _OBJ_ANIME_WAIT()

  //========================================//
  //POSイベント無効
  $WK_SCENE_C12_WHITE_MEET = 5
  //========================================//

EVENT_END

/**************************************************************/
/*  POS：ライバルと戦闘								  */
/**************************************************************/
EVENT_START ev_pos_c12_swbell_meet_btl

  //！マーク
  _OBJ_ANIME( C12_SWRIVAL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //ライバル曲再生
  _START_EVENT_BGM( SEQ_BGM_E_HUE )
  
  //自機座標取得
  _PLAYER_POS_GET( LWK_POSX,LWK_POSZ ) 
  //アニメ：ライバル隣接
  _OBJ_ANIME_AUTO( C12_SWRIVAL_01, LWK_POSX, 715, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_d )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ライバル戦をコール
  _CALL	ev_vs_rival
	
EVENT_END

//★ライバル戦
ev_vs_rival:

	//ローカル変数を定義
	{

	//ライバル名代入
	_RIVAL_NAME( 1 )
	SWITCH $WK_SYS_FIRST_POKETYPE
	CASE FIRST_POKETYPE_KUSA THEN
		_MONS_NAME( 3, MONSNO_POKABU )
	CASE FIRST_POKETYPE_HONOO THEN
		_MONS_NAME( 3, MONSNO_MIZYUMARU )
	CASE FIRST_POKETYPE_MIZU THEN
		_MONS_NAME( 3, MONSNO_TUTAAZYA )
	ENDSWITCH
	
	_OBJ_ANIME( C12_SWBELL_01, anm_dir_d )
	_OBJ_ANIME( C12_SWRIVAL_01, anm_swrival_anime )
	_OBJ_ANIME_WAIT()

	//オマエの　ポケモンが　どんな　ポケモンか　しりたい
	_BALLOONWIN_OBJMSG_POS( msg_c12_swrival_17, C12_SWRIVAL_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//ライバル戦呼び出し　最初の３匹によって分岐　負けてもシナリオ進行
	IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
		//初期３匹で草タイプを選択
		_TRAINER_BTL_SP_SET( TRID_SWRIVAL_01, 0, SCR_BATTLE_MODE_NOLOSE )
	ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
		//初期３匹で炎タイプを選択
		_TRAINER_BTL_SP_SET( TRID_SWRIVAL_02, 0, SCR_BATTLE_MODE_NOLOSE )
	ELSE
		//初期３匹で水タイプを選択
		_TRAINER_BTL_SP_SET( TRID_SWRIVAL_03, 0, SCR_BATTLE_MODE_NOLOSE )
	ENDIF

	//戦闘復帰処理
	_TRAINER_WIN()
	
	//ライバル名代入
	_RIVAL_NAME( 1 )

	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
		//勝利
		//この感動！
		_BALLOONWIN_OBJMSG_POS( msg_c12_swrival_18, C12_SWRIVAL_01, POS_DEFAULT )
	ELSE
		//敗北
		_TEMOTI_POKEMON_KAIFUKU()		//全滅したら回復しておく
		//
		_BALLOONWIN_OBJMSG_POS( msg_c12_swrival_19, C12_SWRIVAL_01, POS_DEFAULT )
	ENDIF
	_MSGWIN_CLOSE()

	//プレイヤーの座標取得
	_PLAYER_POS_GET( LWK_POSX,LWK_POSZ ) 
	
	IF $LWK_POSX == 37 && $LWK_POSZ == 715 THEN
		_OBJ_ANIME_AUTO( C12_SWRIVAL_01, 37, 724, FORCE_TYPE_MAP, 8, DIR_UD )
	ELSE
		_OBJ_ANIME_AUTO( C12_SWRIVAL_01, 37, 724, FORCE_TYPE_MAP, 8, DIR_LR )
	ENDIF
	
	//========================================//
	//ライバル非表示
	_FLAG_SET( FV_C12_SWRIVAL )
	//========================================//
  
	_TIME_WAIT( 20 )

	//アニメ：ベル・主人公、ライバル見送る
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
	
	//ライバル曲停止
	_END_EVENT_BGM()
	
	//アニメ待ち
	_OBJ_ANIME_WAIT()

	//プレイヤーの座標取得
	_PLAYER_POS_GET( LWK_POSX,LWK_POSZ ) 
	
	//ベルの座標指定
	SWITCH $LWK_POSX
	CASE 36 THEN
		$LWK_POSX += 1
	CASE 37 THEN
		$LWK_POSX -= 1
	CASE 38 THEN
		$LWK_POSX -= 1
	ENDSWITCH

	_OBJ_ANIME_AUTO( C12_SWBELL_01, LWK_POSX, LWK_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
	_OBJ_ANIME_WAIT()

	//ベル：どっちのポケモンも
	_BALLOONWIN_OBJMSG_POS( msg_c12_white_15 , C12_SWBELL_01 , POS_DEFAULT )
	_MSGWIN_CLOSE()

	//プレイヤーの座標取得
	_PLAYER_POS_GET( LWK_POSX,LWK_POSZ ) 

	//ベルとプレイヤー向かい合う
	SWITCH $LWK_POSX
	CASE 36 THEN
		_OBJ_ANIME( C12_SWBELL_01, anm_staystep_l )
		_TIME_WAIT( 8 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
	CASE 37 THEN
		_OBJ_ANIME( C12_SWBELL_01, anm_staystep_r )
		_TIME_WAIT( 8 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	CASE 38 THEN
		_OBJ_ANIME( C12_SWBELL_01, anm_staystep_r )
		_TIME_WAIT( 8 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	ENDSWITCH

	_OBJ_ANIME_WAIT()

	//ベル：さて！
	_BALLOONWIN_OBJMSG_POS( msg_c12_white_16 , C12_SWBELL_01 , POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( C12_SWBELL_01, anm_sp_walk )
     _TIME_WAIT( 6 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_sp_walk )
	_TIME_WAIT( 10 )
	//暗転処理
	_BLACK_OUT_SLOW()

	_DISP_FADE_END_CHECK()
	_OBJ_ANIME_WAIT()

	//カメラ操作　ポケセン中心に
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
	_CAMERA_MOVE( 9688,0,970752,3178496,65551,48529408,1 )
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	//主人公・ベル：ポケモンセンター前にワープ
	_OBJ_POS_CHANGE(C12_SWBELL_01,47,1,741,DIR_UP)
	_OBJ_POS_CHANGE(MMDL_ID_PLAYER,49,1,741,DIR_UP)
	
	_TIME_WAIT( 60 )
	
	//暗転復帰
	_BLACK_IN_SLOW()
	_DISP_FADE_END_CHECK()
	
	//ベル：どこのまちでも
	_BALLOONWIN_OBJMSG_POS( msg_c12_white_17 , C12_SWBELL_01 , POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アニメ：ポケセンの中に入るベル
	_OBJ_ANIME( C12_SWBELL_01, anm_goto_pc_bell_01 )
	_OBJ_ANIME_WAIT()
	
	//ドア開ける
	DEFINE_LOCAL	DOOR_ANIME_ID
	_BMODEL_ANIME_CREATE( DOOR_ANIME_ID, SCR_BMID_DOOR, 48, 739 )
	_BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_OPEN )
	_BMODEL_ANIME_WAIT( DOOR_ANIME_ID )
	
	//アニメ：ポケセンの中に入るベル
	_OBJ_ANIME( C12_SWBELL_01, anm_goto_pc_bell_02 )
	_OBJ_ANIME_WAIT()
	
	_OBJ_DEL(C12_SWBELL_01)
	
	//アニメ：ポケセンの中に入る主人公
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_goto_pc_player )
	_OBJ_ANIME_WAIT()
	
	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_C12PC0101_PCGUIDE_01 )
	
	//C12PC0101マップチェンジ
	_MAP_CHANGE( ZONE_ID_C12PC0101, 7, 19, DIR_UP )

	_CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
	_CAMERA_END()		//カメラ操作終了

	 //========================================//
	//C12のライバルを非表示に
	_FLAG_SET( FV_C12_SWRIVAL )
	//========================================//

}
_RET

//--------------------------------------------------------------------
//	☆ベルと会う：ポケモンセンターに入る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_goto_pc_bell_01
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆ベルと会う：ポケモンセンターに入る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_goto_pc_bell_02
  _ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆ベルと会う：ポケモンセンターに入る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_goto_pc_player
  _ANIME_DATA	AC_WALK_L_8F,1
  _ANIME_DATA	AC_WALK_U_8F,2
	_ANIME_DATA	ACMD_END,0

//-----------------------------------------------------------
//	☆カメラ挙動用
//-----------------------------------------------------------
_ANIME_LABEL	anm_sp_walk
	_ANIME_DATA	AC_WALK_D_12F,6
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*			タウンマップ入手イベント					  */
/**************************************************************/
EVENT_START		ev_scene_c12_townmap_01

  //最初に選択した三匹で台詞内にセットする名前を変える
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
  //最初の３匹で草タイプを選択した時の処理
			
	//0に選択ポケモンの名前をセット
	_MONS_NAME(2,MONSNO_551)
	//1に有効ポケモンの名前をセット
				
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN	
	//最初の３匹で炎タイプを選択した時の処理
			
	//0に選択ポケモンの名前をセット
	_MONS_NAME(2,MONSNO_554)
			
  ELSE
	//最初の３匹で水タイプを選択した時の処理
			
	//0に選択ポケモンの名前をセット
	_MONS_NAME(2,MONSNO_557)
				
  ENDIF

  _OBJ_ANIME( C12_SWBELL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()

  _OBJ_ANIME_AUTO( C12_SWMAMA_01, 46, 740, FORCE_TYPE_NPC, 8, DIR_LR)
  _TIME_WAIT( 4 )
  _OBJ_ANIME_AUTO( C12_SWSISTER_01, 46, 741, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()

  //ママ：よっ！
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_c12_swmama_01,C12_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ「！」
  _OBJ_ANIME( C12_SWMAMA_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
	
  //ママ：おっと
  _BALLOONWIN_OBJMSG_POS( msg_c12_swmama_02,C12_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ママ主人公に隣接
  _OBJ_ANIME_AUTO( C12_SWMAMA_01, 47, 740, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
	
  //ME鳴らす
  _GET_SHOES()
  _ME_PLAY( SEQ_ME_KEYITEM )
  _PLAYER_NAME( 0 )	 //プレイヤー名を反映
  _SYSWIN_MSG( msg_c12_swmama_03, POS_DEFAULT )	//～～を手に入れた
  _ME_WAIT()
  _AB_KEYWAIT_MARK()
  _SYSWIN_CLOSE()

  //ママ：にあってるじゃない
  _BALLOONWIN_OBJMSG_POS( msg_c12_swmama_04,C12_SWMAMA_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //アニメ：いもうと主人公に隣接
  _OBJ_ANIME_AUTO( C12_SWSISTER_01, 48, 741, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWSISTER_01, anm_staystep_u )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
	
  //ライバル名代入
  _RIVAL_NAME( 1 )
	
  //妹：あたしからはこれを
  _BALLOONWIN_OBJMSG_POS( msg_c12_rivalsister_03,C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //タウンマップ入手処理
  _ITEM_EVENT_KEYWAIT( ITEM_TAUNMAPPU, 1 )

  _OBJ_ANIME( C12_SWBELL_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWBELL_01, anm_common_hatena )
  _OBJ_ANIME_WAIT()

  //ベル：その　タウンマップ
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_18,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル名代入
  _RIVAL_NAME( 1 )
   
  //妹：おにいちゃんに
  _BALLOONWIN_OBJMSG_POS( msg_c12_rivalsister_05,C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( C12_SWBELL_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()

  //ママ：そうね！
  _BALLOONWIN_OBJMSG_POS( msg_c12_swmama_05,C12_SWMAMA_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //ベル：さあ！
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_19,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
   //アニメ：ベル退場
  _OBJ_ANIME_AUTO( C12_SWBELL_01, 53, 725, FORCE_TYPE_NPC, 8, DIR_LR)
  
  _TIME_WAIT(20)
  
  //アニメ：見送り
  _OBJ_ANIME( C12_SWSISTER_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ベル動作モデル非表示
  _OBJ_DEL(C12_SWBELL_01)
  
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME( C12_SWSISTER_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ママ：そうね！
  _BALLOONWIN_OBJMSG_POS( msg_c12_swmama_06,C12_SWMAMA_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

  //==================================//
	
	//C12のSCENE_CHANGE起動をOFFに
	$WK_SCENE_C12_WHITE_MEET = 7
	
	//C12のベルを非表示
	_FLAG_SET( FV_C12_SWBELL )
	//C12R0101ママを非表示
	_FLAG_SET( FV_C12R0101_SWMAMA )
	//C12R0202妹を非表示
	_FLAG_SET( FV_C12R0202_RIVALSISTER_01 )
	
	//ローカルライブキャスター・ママ通話状態を変更（R19捕獲イベントまで）
	_PERSON_STATE_SET_MOTHER( MOTHER_STATE_C12 )

	//==================================//

EVENT_END

/**************************************************************/
/*			ジムクリア後イベント					  */
/**************************************************************/
EVENT_START		ev_scene_c12_gymclear_01
  
  //男女別メッセージ
  _BALLOONWIN_OBJMSG_MF( msg_c12_white_20a, msg_c12_white_20b, C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ベル接近
  _OBJ_ANIME( C12_SWBELL_01, anm_walk_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_gymclear_pl_to_bell )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：これを
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_21,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( C12_SWBELL_01, anm_walk_l )
  _OBJ_ANIME_WAIT()
  
  //わざマシン入手処理　「おんがえし」
  _ITEM_EVENT_KEYWAIT( ITEM_WAZAMASIN27, 1 )
	
  //メッセージ：そのわざはね
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_22,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ベルジムの方を向く
  _OBJ_ANIME( C12_SWBELL_01, anm_gymclear_bell_look_gym )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：それにしても
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_23,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //カメラ操作　アデク追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,2588672,65551,48410624,24 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  
  //========================================// 
  //C12のチェレン表示
  _FLAG_RESET( FV_C12_SWANLEADER1 )
  //OBJ生成
  _OBJ_ADD( C12_SWLEADER1_01 )
  //========================================//
  _SE_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //メッセージ：なにかいった？
  _BALLOONWIN_OBJMSG_POS( msg_c12_swleader1_01,C12_SWLEADER1_01, POS_UL )
  _MSGWIN_CLOSE()
  
  //アニメ：ベルその場ジャンプ
  _OBJ_ANIME( C12_SWBELL_01, anm_gymclear_bell_jump )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：うひゃあ
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_24,C12_SWBELL_01, POS_UR )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( C12_SWBELL_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //メッセージ：どっ　どうしたの
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_25,C12_SWBELL_01, POS_UR )
  _MSGWIN_CLOSE()

  //メッセージ：せっかくだから
  _BALLOONWIN_OBJMSG_POS( msg_c12_swleader1_02,C12_SWLEADER1_01, POS_UL )
  _MSGWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (24)
  
  //アニメ：主人公に隣接
  _OBJ_ANIME_AUTO( C12_SWLEADER1_01, 39, 740, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
	
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  _OBJ_ANIME( C12_SWLEADER1_01, anm_staystep_d )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ライブキャスター登録SE再生
  _SE_PLAY( SEQ_SE_SW_LC_NO )
  _SE_WAIT()
  
  //メッセージ：これで
  _BALLOONWIN_OBJMSG_POS( msg_c12_swleader1_03,C12_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：あっ　あたしも
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_26,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公に隣接
  _OBJ_ANIME( C12_SWBELL_01, anm_staystep_l )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ライブキャスター登録SE再生
  _SE_PLAY( SEQ_SE_SW_LC_NO )
  _SE_WAIT()
  
  //メッセージ：いっしょに
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_27,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //チェレンライブキャスター登録
  _PERSON_TVT_CALL_SET_CHELEN()
  //ベルライブキャスター登録
  _PERSON_TVT_CALL_SET_BELL()
  //アララギ娘ライブキャスター登録
  _PERSON_TVT_CALL_SET_DOCTOR()
  
  //TVT着信音を再生
  _ME_PLAY( SEQ_ME_CALL )
  _SYSWIN_MSG( msg_c12_tvt_01, POS_DOWN )
  _ME_WAIT()
  _PLAYER_NAME(0)
  _SYSWIN_MSG( msg_c12_tvt_02, POS_DOWN )
  _MSGWIN_CLOSE()

  //ライブキャスター起動
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()
  _CALL_TVT_DEMO( 6 )
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()

  //ベル：音符マーク
  _OBJ_ANIME( C12_SWBELL_01, anm_common_onpu )
  _OBJ_ANIME_WAIT()

  //メッセージ：ね！　アララギはかせ　かっこいいでしょ
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_28,C12_SWBELL_01, POS_DEFAULT )
  
  //メッセージ：あなたの　ポケモンが
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_29,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( C12_SWLEADER1_01, anm_staystep_d )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：そうだね　ぼくは　ポケモンの　とくせいや
  _BALLOONWIN_OBJMSG_POS( msg_c12_swleader1_04,C12_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバルOBJ表示
  _OBJ_ADD_EX( 53, 740, DIR_DOWN, MMDL_ID_EVENTOBJ_00, SWRIVAL, MV_DMY )
  
  //ライバル左手から登場
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 41, 740, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //！マークを出す
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_common_gyoe )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( C12_SWLEADER1_01, anm_staystep_r )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( C12_SWBELL_01, anm_dir_u )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
  _OBJ_ANIME_WAIT()
  
  //ライバル名格納
  _RIVAL_NAME(1)
  
  //メッセージ：ジムリーダーだな！
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_24,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：きみも　てごわそうな
  _BALLOONWIN_OBJMSG_POS( msg_c12_swleader1_05,C12_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( C12_SWLEADER1_01, anm_swleader1_leave )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_u )
  _OBJ_ANIME_WAIT()
  
  //階段SE
  _SE_PLAY( SEQ_SE_KAIDAN ) 
  _OBJ_DEL( C12_SWLEADER1_01 )
  _SE_WAIT()

  //ライバル・その場じたんだ
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swrival_zitanda )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：なんだよ！　ぜったいに
  _GIZAWIN_OBJMSG_POS( msg_c12_swrival_25 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _GIZAWIN_CLOSE()
  
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 39, 738, FORCE_TYPE_ALL, 4, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //階段SE
  _SE_PLAY( SEQ_SE_KAIDAN ) 
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  _SE_WAIT()
  
  //メッセージ：ジムリーダーって　そうぞういじょうに
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_33,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //主人公とベル向かい合う
  _OBJ_ANIME( C12_SWBELL_01, anm_staystep_l )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：Ｃギア入手メッセージ
  _BALLOONWIN_OBJMSG_POS( msg_c12_white_34,C12_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _CALL ev_cgear_get

  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

  //========================================/
  //C12のSCENECHANGE無効
  $WK_SCENE_C12GYM_OPEN = 3
  
  //R20 ストッパー戦POS有効
  $WK_SCENE_R20 = 1
  //T06 せいそくちリストPOS有効（2012.01.13 水口）
  $WK_SCENE_T06_ZUKAN_01 = 1
  
  
  //チェレン非表示
  _FLAG_SET(FV_C12_SWANLEADER1)
  
  //C-GEAR入手フラグセット
  _FLAG_SET( FE_CGEAR_GET )
  
  //ノーマルジム内にストッパー表示
  _FLAG_RESET( FV_C12GYM0101_GLASSES_01 )
  
  //ローカルライブキャスター・ベル通話状態を変更（R19到着まで）
  _PERSON_STATE_SET_BELL( BELL_STATE_C12 )
  
  //スタートメニューに「バトル大会」を追加
  _SET_STARTMENU_FLAG( SCR_STARTMENU_FLAG_BATTLE )
  //スタートメニューに「ゲームシンク設定」を追加
  _SET_STARTMENU_FLAG( SCR_STARTMENU_FLAG_GAMESYNC )
  
  //Cギア入手ヒントメダル取得
  _SET_MEDAL_HINT_ACHIEVE( MDLID_SURECHIGAI_CNT_LV1 )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_FRIEND_CODE_LV1 )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_AFFINITY_CHECK_LV1 )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_AFFINITY_CHECK_POINT )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CTVT_GAME_PLAY_LV1 )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_CTVT_BALLOON_LV1 )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_GAMESYNC )
  _SET_MEDAL_HINT_ACHIEVE( MDLID_DATACONVERT_LV1 )
  
  //========================================//
EVENT_END

/************************************************************/
/*		Ｃギア　コール文							*/
/************************************************************/
//Ｃギア入手処理
ev_cgear_get:
	//Ｃギアを手に入れた！
	_ME_PLAY( SEQ_ME_KEYITEM )
	_PLAYER_NAME( 0 )
	_SYSWIN_MSG( msg_c12_gear_01, POS_DOWN )
	_ME_WAIT()
	_AB_KEYWAIT_MARK()

	//Ｃギアの電源ON/OFF選択
	_PUT_CGEAR_COMMENT( TRUE )		//注意書きを表示
	{
	DEFINE_LOCAL lwk_loop
	WHILE $lwk_loop != 555
	
		//Cギアの電源をONにしますか？
		_SYSWIN_MSG( msg_c12_gear_02, POS_DOWN )
		_BMPMENU_INIT_RIGHT( MENU_X1, 13, 0, 1, SCWK_ANSWER )
		_BMPMENU_MAKE_LIST( msg_c12_gear_03, 0 )	//はい
		_BMPMENU_MAKE_LIST( msg_c12_gear_04, 1 )	//いいえ
		_BMPMENU_START()

		IF $SCWK_ANSWER == 0 THEN
			//はい選択
			_PUT_CGEAR_COMMENT( FALSE )		//注意書きを非表示
			
			//本体設定が通信可能な状態かチェック
			_GET_AVAILABLE_WIRELESS( SCWK_TEMP0 )
			IF $SCWK_TEMP0 == TRUE THEN
				//通信可能

				//質問メッセージのウインドウを消す
				_MSGWIN_CLOSE()
				
				//Cギア起動ＳＥ
				_SE_PLAY( SEQ_SE_DECIDE3 )
				_CGEAR_ON_DEMO( TRUE )		//Ｃギア画面をアクティブで起動
				_SE_WAIT()
				
				//ほら！Ｃギアが起動したでしょ！
				_BALLOONWIN_OBJMSG_POS( msg_c12_white_35 , C12_SWBELL_01, POS_DEFAULT )

			ELSE
				//通信不可（TWL本体設定により無線通信がOFFになっている状態）
				
				//DS本体設定により通信できません
				_SYSWIN_MSG( msg_c12_white_40, POS_DOWN )
				_MSGWIN_CLOSE()
				
				_CGEAR_ON_DEMO( FALSE )		//Ｃギア画面をパッシブで起動
				
				//Ｃギアの画面があらわれたでしょ？
				_BALLOONWIN_OBJMSG_POS( msg_c12_white_36 , C12_SWBELL_01, POS_DEFAULT )
				
			ENDIF
			
			//ループから抜ける
			$lwk_loop = 555
			
		ELSE
			//いいえ選択なら再確認メッセージ
			//通信機能がオフになりますがよろしいですか？
			_SYSWIN_MSG( msg_c12_gear_05, POS_DOWN )
			_BMPMENU_INIT_RIGHT( MENU_X1, 13, 0, 1, SCWK_ANSWER )
			_BMPMENU_MAKE_LIST( msg_c12_gear_03, 0 )	//はい
			_BMPMENU_MAKE_LIST( msg_c12_gear_04, 1 )	//いいえ
			_BMPMENU_START()
			
			IF $SCWK_ANSWER == SCR_YES THEN
				//はい選択なら通信オフで先へ進む
				_MSGWIN_CLOSE()
				
				_PUT_CGEAR_COMMENT( FALSE )		//注意書きを非表示
				
				_CGEAR_ON_DEMO( FALSE )		//Ｃギア画面をパッシブで起動
				
				//Ｃギアの画面があらわれたでしょ？
				_BALLOONWIN_OBJMSG_POS( msg_c12_white_36 , C12_SWBELL_01, POS_DEFAULT )
				
				//ループから抜ける
				$lwk_loop = 555
				
			ENDIF
			
		
		ENDIF
	
	ENDWHILE
	}
_RET

