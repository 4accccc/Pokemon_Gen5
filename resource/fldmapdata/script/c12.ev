//====================================================================
//  C12連れ歩き
//====================================================================
//連れ歩きスタート
EVENT_START ev_pos_c12_rival_pair_01
{
  //主人公名を代入
  _PLAYER_NAME(0)
  //ライバル名代入
  _RIVAL_NAME( 1 )
  
  //妹：主人公さーん！
  _PLAINWIN_MSG_DOWN( msg_c12_rivalsister_01 )
  _MSGWIN_CLOSE()

  //アニメ：ライバル・妹登場
  _OBJ_ANIME_AUTO( C12_SWSISTER_01, 42, 758, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_AUTO( C12_SWRIVAL_01, 43, 758, FORCE_TYPE_NPC, 8, DIR_LR)
  _TIME_WAIT( 30 )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 43, 760, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  _OBJ_ANIME( C12_SWRIVAL_01, anm_swrival_anime )
  _OBJ_ANIME_WAIT()
  
  //ライバル：よお！
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_01,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( C12_SWRIVAL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //ライバル：えっ？
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_08,C12_SWRIVAL_01, POS_DEFAULT )
  //ライバル：ベルって
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_10,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //妹：……ポケモンをもらったら
  _BALLOONWIN_OBJMSG_POS( msg_c12_rivalsister_06,C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //妹のほうを見る
  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_l)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWRIVAL_01, anm_common_tenten)
  _OBJ_ANIME_WAIT()
  _TIME_WAIT( 20 )
  
  //ライバル：……そうだよな
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_09,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //プレイヤーをみる
  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ライバル：よし！
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_23,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル・妹向き合う
  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_l )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( C12_SWSISTER_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ライバル：かえってな
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_02,C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：妹主人公の方を向く
  _OBJ_ANIME( C12_SWSISTER_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //妹：じゃあね
  _BALLOONWIN_OBJMSG_POS( msg_c12_rivalsister_02,C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：妹退場
  _OBJ_ANIME_AUTO( C12_SWSISTER_01, 43, 751, FORCE_TYPE_NOT, 8, DIR_LR)
  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_d )
  _TIME_WAIT( 16 )
  //ライバル：さてと
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_03,C12_SWRIVAL_01, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  _OBJ_ANIME_WAIT()
  
  //ライバル妹の動作OBJを非表示
  _OBJ_DEL(C12_SWSISTER_01)
  
  _PLAYER_POS_GET( LWK_POSX, LWK_POSZ )
  IF $LWK_POSX == 41 THEN
    $LWK_POSX += 1
  ELSE
    $LWK_POSX -= 1
  ENDIF
  
  _OBJ_ANIME_AUTO( C12_SWRIVAL_01, LWK_POSX, LWK_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  _OBJ_ANIME( C12_SWRIVAL_01, anm_staystep_r )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()

  //ライバル：レッツゴー
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_set_01,C12_SWRIVAL_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

  //連れ歩き開始
  _PAIR_TRAINER_SET( C12_SWRIVAL_01, PAIR_ID_C12_SWRIVAL, PAIR_TYPE_FREE_ZONE, 0, SCRID_C12_SWRIVAL )
  
  //========================================//
  //POSイベント無効
  $WK_SCENE_C12_WHITE_MEET = 1
  
  //ライバル妹を非表示
  _FLAG_SET(FV_C12_SWRIVAL_SISTER)
  //ライバルを非表示
  _FLAG_SET(FV_C12_SWRIVAL)
  //========================================//

}
EVENT_END

