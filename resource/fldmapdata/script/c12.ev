/************************************************************/
/*  SCENE_CHANGE：ライバルの妹イベント（クリア後）          */
/************************************************************/
EVENT_START   ev_scene_c12_rivalsister_end_01

  //アニメ：主人公振り向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()

  //主人公名を代入
  _PLAYER_NAME( 0 )
  //ライバル名代入
  _RIVAL_NAME( 1 )

  //ライバル：コイツが　はなしたいってさ▼
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_end_01, C12_SWRIVAL_01, POS_UP )
  _MSGWIN_CLOSE()

  //アニメ：ライバルの妹移動
  _OBJ_ANIME_AUTO( C12_SWSISTER_01, 47, 763, FORCE_TYPE_NPC, 8, DIR_LR )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C12_SWSISTER_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //妹：あたしの　チョロネコ……
  _BALLOONWIN_OBJMSG_POS( msg_c12_rivalsister_end_01, C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //ライバル：まだ　あるんだろ？
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_end_02, C12_SWRIVAL_01, POS_UP )
  _MSGWIN_CLOSE()

  //妹：ポケモンの　ゆめを　みるの▽
  _BALLOONWIN_OBJMSG_POS( msg_c12_rivalsister_end_02, C12_SWSISTER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：主人公振り向き、妹移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME( C12_SWSISTER_01, anm_swsister_work_a )
  //ライバル：なんか　よくわかんないけど
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_end_03, C12_SWRIVAL_01, POS_UP )
  _OBJ_ANIME_WAIT()
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル、妹移動（途中でライバル止まる）
  _OBJ_ANIME( C12_SWRIVAL_01, anm_swrival_work_a )
  _OBJ_ANIME( C12_SWSISTER_01, anm_swsister_work_b )
  _OBJ_ANIME_WAIT()

  //アニメ：ライバル戻ってくる
  _OBJ_ANIME( C12_SWRIVAL_01, anm_swrival_work_b )
  _OBJ_ANIME_WAIT()

  //ライバル：あっ　わすれてた▼
  _BALLOONWIN_OBJMSG_POS( msg_c12_swrival_end_04, C12_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ライバル、妹移動（途中でライバル止まる）
  _OBJ_ANIME( C12_SWRIVAL_01, anm_swrival_work_c )
  _OBJ_ANIME( C12_SWSISTER_01, anm_swsister_work_c )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( C12_SWRIVAL_01 )
  _OBJ_DEL( C12_SWSISTER_01 )

  //========================================//
  //ライバルと妹を非表示 
  _FLAG_SET( FV_C12_SWRIVAL )
  _FLAG_SET( FV_C12_SWRIVAL_SISTER )
  //POSイベント進行
  $WK_SCENE_SPPOKE_EVENT_01 = 2
  //ローカルライブキャスター：アララギ娘通話状態を変更（D33R0101終了まで）
  _PERSON_STATE_SET_DOCTOR( DOCTOR_STATE_D33R0101 )
  //ローカルライブキャスター：ライバル通話状態を変更（t04終了まで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_T04 )
  //========================================//

EVENT_END

/************************************************************/
/*  SCENE_CHANGE：物語開始デモ後イベント　初期化 */
/************************************************************/
EVENT_START   ev_c12_game_start_init

   _OBJ_ADD_EX( 45, 763, DIR_RIGHT, MMDL_ID_EVENTOBJ_00, SWMAMA2, MV_DMY )
   
EVENT_END
/************************************************************/
/*  SCENE_CHANGE：物語開始デモ後イベント */
/************************************************************/
EVENT_START   ev_c12_game_start

  // 花びら舞う
  _DEMO_GIMMICK_INTRO_ANM_START()

  //ママ・花びらを眼で追う
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_game_start_02 )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT(45)

  //TVT着信音を再生
  _ME_PLAY( SEQ_ME_CALL )
  _ME_WAIT()

  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //ママ・電話に出る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_game_start_03 )
  _OBJ_ANIME_WAIT()

  //メッセージ：りょうかい！　うちのコなら
  _BALLOONWIN_OBJMSG_POS( msg_c12_demo_01, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _TIME_WAIT( 30 )

  //メッセージ：うん！　ベルちゃんね
  _BALLOONWIN_OBJMSG_POS( msg_c12_demo_02, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _TIME_WAIT( 15 )
  
  //ママ・電話をきる
  _SE_PLAY( SEQ_SE_SYS_72 )
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_game_start_04 )
  _OBJ_ANIME_WAIT()
  _SE_WAIT()
  
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 47, 762, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //ドア開ける
  _BMODEL_ANIME_CREATE( SCWK_ANSWER, SCR_BMID_DOOR, 47, 761 )
  _BMODEL_ANIME_SET( SCWK_ANSWER, SCR_BMANM_DOOR_OPEN )
  _BMODEL_ANIME_WAIT( SCWK_ANSWER )
	
  //ママ：家の中に入る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_u )
  _OBJ_ANIME_WAIT()

  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

  //暗転
  _MAP_FADE_BLACK_OUT_SLOW()
  
  //ママイベント起動
  _RESERVE_SCRIPT( SCRID_RESERVE_C12R0101_EVENT_01 )
  _MAP_FADE_END_CHECK()
  //マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_C12R0101, 14, 0, 3, DIR_UP )

EVENT_END

/************************************************************/
/*  エンディングイベント                                    */
/*  プログラムから呼ばれる                                  */
/************************************************************/
EVENT_START    ev_c12_ending

  // 初期化
  _DEMO_GIMMICK_ENDING_C12_INIT()

  _OBJ_DEL( C12_MAN3_01 )

  //プレイヤーの初期位置決定
  _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 53, 0, 750, DIR_DOWN )

  // フェードイン
  _GET_ROM_VERSION( SCWK_ANSWER )
  IF $SCWK_ANSWER == VERSION_B2 THEN
    _DISP_FADE_START( DISP_FADE_BLACKOUT_MAIN,16,0,DISP_FADE_SPEED )
  ELSE
    _DISP_FADE_START( DISP_FADE_WHITEOUT_MAIN,16,0,DISP_FADE_SPEED )
  ENDIF
  
  //家まで走る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_ending_01 )
  _DISP_FADE_END_CHECK()
  _OBJ_ANIME_WAIT()
  
  _TIME_WAIT( 30 )
  
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラパージ
  _CAMERA_MOVE(9688,0,970752,2854912,65551,50036736, 60)
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  _TIME_WAIT( 20 )
  _OBJ_ANIME( C12_MAMA_ED_01, anm_staystep_u_16 )
  _OBJ_ANIME_WAIT()
 
  _TIME_WAIT( 30 )

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_ending_02 )
  _OBJ_ANIME_WAIT()
  
  _TIME_WAIT( 30 )

  _CAMERA_MOVE(9688,0,970752,3112960,65551,49971200, 60)

  //アニメ：家に入る
  _OBJ_ANIME_AUTO( C12_MAMA_ED_01, 46, 763, FORCE_TYPE_NOT, 16, DIR_LR )
  _TIME_WAIT( 4 )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 46, 762, FORCE_TYPE_NOT, 16, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  _OBJ_ANIME( C12_MAMA_ED_01, anm_staystep_u_16 )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  _TIME_WAIT( 60 )
  
  _OBJ_ANIME_AUTO( C12_MAMA_ED_01, 47, 762, FORCE_TYPE_NOT, 16, DIR_LR )
  _TIME_WAIT( 24 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 30 )

  _OBJ_ANIME( C12_MAMA_ED_01, anm_staystep_u_16 )
  _OBJ_ANIME_WAIT()

  //ドア開ける
  _BMODEL_ANIME_CREATE( SCWK_ANSWER, SCR_BMID_DOOR, 47, 761 )
  _BMODEL_ANIME_SET( SCWK_ANSWER, SCR_BMANM_DOOR_OPEN )
  _BMODEL_ANIME_WAIT( SCWK_ANSWER )

  _OBJ_ANIME( C12_MAMA_ED_01, anm_swmama_ending_01 )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
  _OBJ_ANIME_WAIT()
  
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d_16 )
  _OBJ_ANIME_WAIT()
  
  _TIME_WAIT( 45 )

  _CAMERA_MOVE(9688,0,970752,3112960,741391,49971200, 100)

  _TIME_WAIT( 20 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_swmama_ending_01 )
  //暗転処理
  _GET_ROM_VERSION( SCWK_ANSWER )
  IF $SCWK_ANSWER == VERSION_B2 THEN
    _DISP_FADE_START( DISP_FADE_BLACKOUT_MAIN,0,16,DISP_SLOW_FADE_SPEED )
  ELSE
    _DISP_FADE_START( DISP_FADE_WHITEOUT_MAIN,0,16,DISP_SLOW_FADE_SPEED )
  ENDIF
  _OBJ_ANIME_WAIT()

  //ドア閉める
  _BMODEL_ANIME_SET( SCWK_ANSWER, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_WAIT( SCWK_ANSWER )
  _BMODEL_ANIME_DELETE( SCWK_ANSWER )

  _DISP_FADE_END_CHECK()

  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  _CAMERA_BIND()		//カメラバインド
  _CAMERA_END()		//カメラ操作終了

  //========================================//
  // エンディングのキャラ非表示
  _FLAG_SET( FV_C09P02_ENDING )
  //========================================//

EVENT_END

