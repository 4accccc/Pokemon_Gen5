  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_r13.h"
  .include  "r13.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_bg_r13_sign1_01
_EVENT_DATA   ev_bg_r13_sign2_01
_EVENT_DATA   ev_bg_r13_sign3_01
_EVENT_DATA   ev_pos_r13_poke4_01
_EVENT_DATA   ev_r13_poke4_01
_EVENT_DATA   ev_r13_trainerm_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/**************************************************************/
/*  看板01                                                    */
/**************************************************************/
EVENT_START   ev_bg_r13_sign1_01
  _EASY_BGWIN_MSG( msg_r13_sign1_01, TYPE_ROAD )
EVENT_END

/**************************************************************/
/*  看板02                                                    */
/**************************************************************/
EVENT_START   ev_bg_r13_sign2_01
  _EASY_BGWIN_MSG( msg_r13_sign2_01, TYPE_ROAD )
EVENT_END

/**************************************************************/
/*  看板03                                                    */
/**************************************************************/
EVENT_START   ev_bg_r13_sign3_01
  _EASY_BGWIN_MSG( msg_r13_sign3_01, TYPE_INFO )
  _FLAG_SET( MDL_FLAG_BOARD_R13_03 )
EVENT_END

/**************************************************************/
/*  POS：コバルオン登場                         */
/**************************************************************/
EVENT_START   ev_pos_r13_poke4_01

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

  //アニメ：主人公「！」
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //カメラ操作
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,44859392,0,12484608,32 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //コバルオン振り向き
  IF $LCW_POSZ == 187 THEN
    _OBJ_ANIME( R13_POKE4_01, anm_common_turn_u )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  /*
  
  //主人公の位置でアニメ分岐
  IF $LCW_POSZ == 187 THEN
    //アニメ：コバルオン主人公の前に
    $LCW_POSZ += 2
    _OBJ_ANIME_AUTO( R13_POKE4_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 6, DIR_UD )
    _OBJ_ANIME_WAIT()
  ELSE
    //アニメ：コバルオン主人公の前に
    $LCW_POSZ -= 2
    _OBJ_ANIME_AUTO( R13_POKE4_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 6, DIR_UD )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
  
  //コバルオン向き合う
  IF $LCW_POSZ != 684 && $LCW_POSZ == 187 THEN
    _OBJ_ANIME( R13_POKE4_01, anm_common_turn_u )
    _OBJ_ANIME_WAIT()
  ELSIF $LCW_POSZ != 684 && $LCW_POSZ == 193 THEN
    _OBJ_ANIME( R13_POKE4_01, anm_common_turn_d )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  */

  //コバルオン：こふおおおおーっ！
  _VOICE_PLAY( MONSNO_645, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_r13_poke4_01, POS_UP )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (8*4)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  

  //==================================//
  //POS無効
  $WK_SCENE_R13_POKE4 = 1
  //==================================//

EVENT_END

/**************************************************************/
/*  コバルオン：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
/**************************************************************/
EVENT_START   ev_r13_poke4_01

  _TALK_OBJ_START()

  //コバルオン：こふおおおおーっ！
  _VOICE_PLAY( MONSNO_645, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_r13_poke4_01, POS_UP )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  //コバルオンを見たことがあるか
  IF FLAG_OFF( FE_R13_POKE4_MEET_01 ) THEN

    //==================================//
    //コバルオン発見
    _FLAG_SET( FE_R13_POKE4_MEET_01 )
    //==================================//

    //戦闘開始
    {
      DEFINE_LOCAL flag
      $flag = SCR_WILD_BTL_FLAG_LEGEND    //メッセージを変更
      $flag |= SCR_WILD_BTL_FLAG_NO_RARE  //レア禁止
      _WILD_BTL_SET_EX( MONSNO_645, 45, flag ) // Lv.45 コバルオン
    }

  ELSE

    //戦闘開始
    {
      DEFINE_LOCAL flag
      $flag = SCR_WILD_BTL_FLAG_LEGEND    //メッセージを変更
      $flag |= SCR_WILD_BTL_FLAG_NO_RARE  //レア禁止
      _WILD_BTL_SET_EX( MONSNO_645, 65, flag ) // Lv.65 コバルオン
    }

  ENDIF

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //コバルオン非表示
    _FLAG_SET( FV_R13_POKE4_01 )
    //==================================//
    _OBJ_DEL( R13_POKE4_01 )   //コバルオンを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //コバルオンを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合
    //==================================//
    //コバルオンを捕獲した
    _FLAG_SET( FE_R13_POKE4_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

  ENDSWITCH

  //コバルオンを捕獲できなかった場合の分岐
  IF FLAG_OFF( FE_R13_POKE4_GET_01 ) THEN

    //システム：ポケモンは　どうろの　さきへ
    _SYSWIN_MSG( msg_r13_poke4_02, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDIF

EVENT_END

/**************************************************************/
/*  黒服：話しかけ（海辺のお宝イベント）                      */
/**************************************************************/
EVENT_START   ev_r13_trainerm_01

  _TALK_OBJ_START()

  //初めて会話する場合
  IF FLAG_OFF( FE_R13_TREASURE_FIRSTTALK ) THEN

    //黒服：なにを　しているか　だって？
    _BALLOONWIN_TALKOBJ_MSG( msg_r13_salvage_01 )
    _MSGWIN_CLOSE()

    //アイテム入手処理へ
    _CALL ev_treasure

    //黒服：あしたも　ここで　たからさがし
    _BALLOONWIN_TALKOBJ_MSG( msg_r13_salvage_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //========================================/
    //一日フラグセット
    _FLAG_SET( TMFLG_R13_TREASURE )
    //初回会話フラグセット
    _FLAG_SET( FE_R13_TREASURE_FIRSTTALK )
    //========================================/

  //２回目以降の場合
  ELSE

    //１日フラグが立っていない場合
    IF FLAG_OFF( TMFLG_R13_TREASURE ) THEN

      //黒服：さっき　おたからを　みつけたんだ▼
      _BALLOONWIN_TALKOBJ_MSG( msg_r13_salvage_02 )
      _MSGWIN_CLOSE()

      //アイテム入手処理へ
      _CALL ev_treasure

      //黒服：あしたも　ここで　たからさがし
      _BALLOONWIN_TALKOBJ_MSG( msg_r13_salvage_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //========================================/
      //一日フラグセット
      _FLAG_SET( TMFLG_R13_TREASURE )
      //========================================/

    //１日フラグが立っている場合
    ELSE

      //黒服：あしたも　ここで　たからさがし
      _BALLOONWIN_TALKOBJ_MSG( msg_r13_salvage_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

EVENT_END


ev_treasure: 

DEFINE_LOCAL  LWK_TREASURE

_GET_RND( LWK_TREASURE, 5 )

SWITCH $LWK_TREASURE
CASE 0 THEN
  _ITEM_EVENT_KEYWAIT( ITEM_AOIBIIDORO, 1 )
CASE 1 THEN
  _ITEM_EVENT_KEYWAIT( ITEM_KIIROBIIDORO, 1 )
CASE 2 THEN
  _ITEM_EVENT_KEYWAIT( ITEM_AKAIBIIDORO, 1 )
CASE 3 THEN
  _ITEM_EVENT_KEYWAIT( ITEM_KUROIBIIDORO, 1 )
CASE 4 THEN
  _ITEM_EVENT_KEYWAIT( ITEM_SIROIBIIDORO, 1 )
ENDSWITCH

_RET


//--------------------------------------------------------------------
//☆共通処理：ギョエ
