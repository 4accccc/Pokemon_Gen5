
//======================================================================
//                c14gym0101.ev
//
//    スクリプトファイル：c14gym0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c14gym0101.h"
  .include  "c14gym0101.h"

  //@author fujimura_souichirou
  //@author Mizuguchi_Mai（ストッパー・演出調整）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_c14gym0101_swleader8_01
_EVENT_DATA   ev_c14gym0101_guide_01
_EVENT_DATA   ev_bg_c14gym0101_statue_01
_EVENT_DATA   ev_pos_c14gym0101_stopper_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/**************************************************************/
/*  ジムリーダー会話                                          */
/**************************************************************/
EVENT_START   ev_c14gym0101_swleader8_01

  _TALK_OBJ_START()
  //バッジフラグ取得
  _GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_08 )

  //ジムバッジフラグで分岐
  IF $SCWK_TEMP0 == 0 THEN
    //バッジ入手前なら、ジムリーダー戦イベント
    _CALL   ev_leader8_btl

  ELSE

    //ゲームクリア前なら
    IF FLAG_OFF( SYS_FLAG_GAME_CLEAR )  THEN

      //シズイ：とりゃお！
      _BALLOONWIN_OBJMSG( msg_c14gym0101_swleader8_07, C14GYM0101_SWLEADER8_01 )
      _AB_KEYWAIT_MARK()
      _BALLOONWIN_CLOSE()
      
      //退場
      _CALL sub_leader_return

    //ゲームクリア後なら
    ELSE

      //シズイ：おだやかな　うみも
      _BALLOONWIN_OBJMSG( msg_c14gym0101_swleader8_08, C14GYM0101_SWLEADER8_01 )
      _AB_KEYWAIT_MARK()
      _BALLOONWIN_CLOSE()
      
      //退場
      _CALL sub_leader_return

    ENDIF

  ENDIF

EVENT_END


//ジムリーダー戦
ev_leader8_btl:

  //シズイ：お！　さっそく　きたか！▼
  _BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_swleader8_01 )
  _BALLOONWIN_CLOSE()

{
  //難易度取得ワーク定義
  DEFINE_LOCAL  LCW_DIFFICULTY
  
  //現在の難易度を取得
  _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
  
  //トレーナー戦呼び出し
  
  //むずかしい
  IF $LCW_DIFFICULTY == 2 THEN
    _TRAINER_BTL_SET( TRID_SWLEADER8_02, 0 )
  
  //ふつう・かんたん
  ELSE
    _TRAINER_BTL_SET( TRID_SWLEADER8_01, 0 )
  ENDIF

}

  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()    //勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()   //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF

  //戦闘後メッセージ

  //シズイ：おはん　つよそーじゃなく
  _BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_swleader8_02 )
  _BALLOONWIN_CLOSE()

  //リーダー戦勝利時の情報登録
  _SET_GYM_VICTORY_INFO( BADGE_ID_08 )
  //バッジ入手処理
  _SET_BADGE_FLAG( BADGE_ID_08 )    //バッジフラグon
  _PLAYER_NAME( 0 )

{
  //バッジ入手演出再生
  _ME_PLAY( SEQ_ME_BADGE )

  //性別が格納されるローカル変数を定義
  DEFINE_LOCAL SCWK_SEX
  _GET_MY_SEX( SCWK_SEX )

  //男性だった場合
  IF $SCWK_SEX == PM_MALE THEN
    _CALL_FLD3D_CUTIN( FLDCIID_GYM08 )
  //女性だった場合
  ELSE
    _CALL_FLD3D_CUTIN( FLDCIID_GYM08F )
  ENDIF

  //ME待ち
  _ME_WAIT()
}

  //システム：ウェーブバッジをもらった！▼
  _SYSWIN_MSG( msg_c14gym0101_swleader8_03, POS_DEFAULT )
  _SYSWIN_CLOSE()

  //シズイ：それは　ウェーブバッジ
  _BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_swleader8_04 )
  _BALLOONWIN_CLOSE()

  //わざマシン「ねっとう」入手
  _ITEM_EVENT_KEYWAIT( ITEM_WAZAMASIN55, 1 )

  //シズイ：ねっとうはな　つかうと　ときどき
  _BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_swleader8_05 )

  //シズイ：ほな　いっとこかい！
  _BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_swleader8_06 )
  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()

  //================================================//
  //ジムトレーナーの視線無効

  _TRAINER_FLAG_SET( TRID_ELITEM_26 )
  _TRAINER_FLAG_SET( TRID_ELITEM_27 )
  _TRAINER_FLAG_SET( TRID_ELITEM_28 )
  _TRAINER_FLAG_SET( TRID_ELITEW_26 )
  _TRAINER_FLAG_SET( TRID_ELITEW_27 )
  _TRAINER_FLAG_SET( TRID_ELITEW_28 )

  //================================================//
  //電光掲示板フラグセット
  _FLAG_SET( SYS_FLAG_ELBOARD_C06GYMWIN )
  //================================================//
  //POSイベント進行
  $WK_SCENE_C14_SWLEADER8_01 = 1    //ジムの外に出た時のライバルイベント用
  //R22テラキオンイベント起動
  $WK_SCENE_R22_POKE5 = 1
  _FLAG_RESET( FV_R22_POKE5_01 )
  //C14GYM0101 シズイ非表示
  _FLAG_SET( FV_C14GYM0101_SWLEADER8_01 )
  //ローカルライブキャスター・ライバル通話状態を変更（C14GYM前イベント終了まで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_C14_4 )
  //================================================//
  
  //主人公方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //アニメ：シズイ退場
  _OBJ_ANIME( C14GYM0101_SWLEADER8_01, anm_swleader_go_sea_def )
  
  //アニメ：主人公が上から話しかけていたらのく
  IF $LWK_DIR == DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_backstep )
  
  //アニメ：主人公が左右から話しかけていたら見送り
  ELSIF $LWK_DIR == DIR_LEFT || $LWK_DIR == DIR_RIGHT THEN
    _TIME_WAIT( 4 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  ENDIF
  
  _OBJ_ANIME_WAIT()

  //海にジャンプ
  _OBJ_HIGH_JUMP( C14GYM0101_SWLEADER8_01, 16, -4, 1 )

  //水しぶき
  _GYM_WATER_SPLASH_ANIME()

  // 非表示
  _OBJ_ANIME( C14GYM0101_SWLEADER8_01, anm_vanish )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 35 )    // 調整用

  //シズイ帰りアニメ
  _GYM_WATER_RETURN_ANIME()

  _TIME_WAIT( 80 )    // 調整用

_RET

//ジムリーダーが海へ帰っていく
sub_leader_return:
  
  //主人公方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //アニメ：シズイ退場
  _OBJ_ANIME( C14GYM0101_SWLEADER8_01, anm_swleader_go_sea_def )
  
  //アニメ：主人公が上から話しかけていたらのく
  IF $LWK_DIR == DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_backstep )
  
  //アニメ：主人公が左右から話しかけていたら見送り
  ELSIF $LWK_DIR == DIR_LEFT || $LWK_DIR == DIR_RIGHT THEN
    _TIME_WAIT( 4 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  ENDIF
  
  _OBJ_ANIME_WAIT()

  //海にジャンプ
  _OBJ_HIGH_JUMP( C14GYM0101_SWLEADER8_01, 16, -4, 1 )

  //水しぶき
  _GYM_WATER_SPLASH_ANIME()

  // 非表示
  _OBJ_ANIME( C14GYM0101_SWLEADER8_01, anm_vanish )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 35 )    // 調整用

  //シズイ帰りアニメ
  _GYM_WATER_RETURN_ANIME()

  _TIME_WAIT( 80 )    // 調整用

_RET

/************************************************************/
/*  POS：STOPPER                        */
/************************************************************/
EVENT_START   ev_pos_c14gym0101_stopper_01
  
  //アニメ：ダンペイ・主人公見る
  _OBJ_ANIME( C14GYM0101_GUIDE_01, anm_danpei_look_player )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ダンペイ：ジムリーダーなら
  _BALLOONWIN_OBJMSG_POS( msg_c14gym0101_glasses_01 , C14GYM0101_GUIDE_01, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _BALLOONWIN_CLOSE()
  
  //アニメ：主人公戻る・ダンペイ下を見る
  _OBJ_ANIME( C14GYM0101_GUIDE_01, anm_staystep_d )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_d )
  _OBJ_ANIME_WAIT()
  
EVENT_END

//--------------------------------------------------------------------
//	ダンペイ：主人公見る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_danpei_look_player
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*  ダンペイ：話しかけ（ジムガイド）                        */
/************************************************************/
EVENT_START   ev_c14gym0101_guide_01
  
  //ストッパー有効
  IF $WK_SCENE_C14GYM0101_STOPPER == 0 THEN
    
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_glasses_01 )
    
  //ストッパー無効
  ELSE

    //バッジフラグ取得
    _GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_08 )
    
    //バッジフラグで分岐
    IF $SCWK_TEMP0 == 0 THEN
      //バッジ入手前の処理

      //アイテム入手フラグで分岐
      IF FLAG_OFF( FE_C14GYM_ITEM ) THEN
      
        _TALK_OBJ_START()

        //アイテム未入手なら、おいしいみず入手イベント
        //ダンペイ：リゾートきぶんな　ジムですけれど
        _BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_glasses_02 )
        _BALLOONWIN_CLOSE()

        //アイテム「おいしいみず」入手
        _ITEM_EVENT_KEYWAIT( ITEM_OISIIMIZU, 1 )

        //ダンペイ：この　ポケモンジムは
        _BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_glasses_03 )
        _LAST_KEYWAIT()
        _BALLOONWIN_CLOSE()

        //=====================================
        //アイテム入手フラグをセット
        _FLAG_SET( FE_C14GYM_ITEM )
        //=====================================

      ELSE
        //入手済みならメッセージのみ
        //ダンペイ：この　ポケモンジムは
        _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_glasses_03 )

      ENDIF

    ELSE
      //バッジ入手後の処理
      //ダンペイ：シズイさん　およいじゃってますね
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14gym0101_glasses_04 )
      
    ENDIF
  ENDIF

EVENT_END

/************************************************************/
/*  石像                                                    */
/************************************************************/
EVENT_START   ev_bg_c14gym0101_statue_01

  _TALK_START_SE_PLAY()

  //主人公名代入
  _PLAYER_NAME( 0 )
  //ライバル名代入
  _RIVAL_NAME( 1 )

  //バッジフラグ取得
  _GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_08 )
  //ジムバッジフラグによって分岐
  IF $SCWK_TEMP0 == 0 THEN
    //バッジ入手前なら
    _PLAINWIN_MSG_DOWN( msg_c03gym0101_statue_01 )

  ELSE
    _PLAINWIN_MSG_DOWN( msg_c03gym0101_statue_02 )

  ENDIF
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END


