
//======================================================================
//                c14gym0101.ev
//
//    スクリプトファイル：c14gym0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c14gym0101.h"
  .include  "c14gym0101.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c14gym0101_swleader8_01
_EVENT_DATA_END


/**************************************************************/
/*    ジムリーダー会話                                  */
/**************************************************************/
EVENT_START		ev_c14gym0101_swleader8_01

  // ジムリーダーが海へ帰っていく
  _CALL sub_leader_return

EVENT_END

// ジムリーダーが海へ帰っていく
sub_leader_return:
  //上に2歩
  _OBJ_ANIME( C14GYM0101_SWLEADER8_01, anm_tr_up )
  _OBJ_ANIME_WAIT()

  //海にジャンプ
  _OBJ_HIGH_JUMP( C14GYM0101_SWLEADER8_01, 16, -2, 0 )

  //水しぶき
  _GYM_WATER_SPLASH_ANIME()

  // 非表示
  _OBJ_ANIME( C14GYM0101_SWLEADER8_01, anm_vanish )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT(35)    // 調整用

  //シ･ズイ帰りアニメ
  _GYM_WATER_RETURN_ANIME()

  _TIME_WAIT(80)    // 調整用
_RET

//--------------------------------------------------------------
//	上に2歩進む
//--------------------------------------------------------------
_ANIME_LABEL	anm_tr_up
	_ANIME_DATA	AC_WALK_U_8F,3
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------
//	非表示
//--------------------------------------------------------------
_ANIME_LABEL  anm_vanish
  _ANIME_DATA AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

