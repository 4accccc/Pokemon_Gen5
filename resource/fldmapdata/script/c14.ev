/**************************************************************/
/*  FIGHTERM_02                                            */
/**************************************************************/
EVENT_START   ev_c14_fighterm_02
  
  //初回話しかけであったならば
  IF FLAG_OFF(SYS_FLAG_FES_MQUIZ1) THEN
  
    _TALK_OBJ_START()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_c14_mission_add_1_01 )
    _MSGWIN_CLOSE()
    
    //フェスミッション名代入
    _FMISSION_NAME( 0, FMISSION_ID_NPC_MEMORYQUIZ_01S, 0 )
    
    //フェスミッションが追加されました
    _SE_PLAY( SEQ_SE_FLD_133 )
    _SYSWIN_MSG( msg_c14_mission_add_1_02, POS_DEFAULT )
    _SE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_c14_mission_add_1_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //==================================//
    //初回会話終了
    _FLAG_SET(SYS_FLAG_FES_MQUIZ1)
    //==================================//
    
  //2回目以降
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14_mission_add_1_03 )
  ENDIF
  
EVENT_END
