  //@author fujimura_souichirou（ジムクリア時イベント・カップル・顔出し看板）
  //@author Mizuguchi_Mai（ジムクリア前イベント・看板）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c14
_EVENT_DATA    ev_init_c14
_EVENT_DATA    ev_pos_c14_swrival_01
_EVENT_DATA    ev_scene_c14_swleader8_01
_EVENT_DATA    ev_c14_swrival_01
_EVENT_DATA    ev_c14_girl4_01
_EVENT_DATA    ev_c14_boy4_01
_EVENT_DATA    ev_c14_boy4_02
_EVENT_DATA    ev_pos_c14_swleader8_01
_EVENT_DATA    ev_pos_c14_kaodasi_01
_EVENT_DATA    ev_c14_girl4_02
_EVENT_DATA    ev_c14_middleman2_01
_EVENT_DATA    ev_c14_swimmerw_01
_EVENT_DATA    ev_c14_swimmerw_02
_EVENT_DATA    ev_c14_fighterm_01
_EVENT_DATA    ev_bg_c14_board_01
_EVENT_DATA    ev_bg_c14_board_02
_EVENT_DATA    ev_bg_c14_board_03
_EVENT_DATA    ev_c14_fighterm_02
_EVENT_DATA    ev_c14_man3_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//------------------------------注意--------------------------------//
//                                                                  //
//  顔出し看板イベントに LOCALWORK0～1を使用しています。            //
//  同マップ内の使用を禁止します。                                  //
//                                                                  //
//------------------------------------------------------------------//


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_c14

  //顔出し看板イベント制御（１日１回）
  IF FLAG_ON( TMFLG_C14_KAODASI_01 ) THEN

    //顔出し看板POSをOFFに
    $LOCALWORK0 = 1

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_c14

  IF $WK_SCENE_C14_SWLEADER8_01 == 1 THEN
    _OBJ_POS_CHANGE( C14_SWRIVAL_01, 787, -4, 176, DIR_LEFT )
  ENDIF

  //カップル男と会話済みでありゲームクリア後である場合、ユニットを再配置
  IF FLAG_ON( FE_C14_BOY4_TALK_01 ) && FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN

    //カップルが砂浜にいる？
    IF FLAG_OFF( FV_C14_GIRL4_01 ) && FLAG_OFF( FV_C14_BOY4_01 ) THEN
      //========================================//
      //カップルを非表示
      _FLAG_SET( FV_C14_GIRL4_01 )
      _FLAG_SET( FV_C14_BOY4_01 )
      //========================================//
      //カップルを非表示
      _OBJ_DEL( C14_GIRL4_01 )
      _OBJ_DEL( C14_BOY4_01 )
    ENDIF

    //カップル男（後）がいる？
    IF FLAG_ON( FV_C14_BOY4_02 ) THEN
      //========================================//
      //カップル男を表示
      _FLAG_RESET( FV_C14_BOY4_02 )
      //========================================//
      //カップル男（後）配置
      _OBJ_ADD( C14_BOY4_02 )
    ENDIF

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  SCENE_CHANGE01：街到着ライバルイベント                  */
/************************************************************/
EVENT_START   ev_pos_c14_swrival_01

  //主人公方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //アニメ：ライバル「！」
  _OBJ_ANIME( C14_SWRIVAL_01, anm_common_gyoe )
  
  //アニメ：主人公上向き以外なら上を向く
  IF $LWK_DIR != DIR_UP THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
  ENDIF
  _OBJ_ANIME_WAIT()

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：いでんしのくさび
  _BALLOONWIN_OBJMSG_POS( msg_c14_swrival_01a, C14_SWRIVAL_01, POS_DEFAULT )

  //ライバル：はやく
  _BALLOONWIN_OBJMSG_POS( msg_c14_swrival_02, C14_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //========================================//
  //C14 POS無効
  $WK_SCENE_C14_SWRIVAL_01 = 2
  //========================================//

EVENT_END

/************************************************************/
/*  POS：シズイ登場イベント                  */
/************************************************************/
EVENT_START   ev_pos_c14_swleader8_01
  
  //シズイ動作モデル生成
  // 見えないところに。
  _OBJ_ADD_EX( 792, 100, DIR_DOWN, MMDL_ID_EVENTOBJ_00, SWLEADER8, MV_DMY )

  //水しぶきの演出
  _C14_GMK_SPLASH( 791, -5, 151 )
  // ハイジャンプ
  _C14_GMK_OBJ_WATER_JUMP( MMDL_ID_EVENTOBJ_00, 791, 156, DIR_DOWN )

  //シズイ：とりゃお
  _BALLOONWIN_OBJMSG_POS( msg_c14_swleader8_01, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  // アニメ：左向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
  // アニメ：シズイ近づく
  IF $LCW_POSZ == 156 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swleader8_come_z156 )
  ELSE
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swleader8_come_z157 )
  ENDIF
  _OBJ_ANIME_WAIT()


  //おう！おはん
  _BALLOONWIN_OBJMSG_POS( msg_c14_swleader8_02, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  
  //アニメ：シズイ退場・主人公見送り
  IF $LCW_POSZ == 156 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swleader8_bye_z156 )
    _TIME_WAIT( 8*5 )
  ELSE
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swleader8_bye_z157 )
    _TIME_WAIT( 8*4 )
  ENDIF
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
  _OBJ_ANIME_WAIT()
  
  //シズイ動作モデル削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  //========================================//
  //C14GYM0101 STOPPER無効
  $WK_SCENE_C14GYM0101_STOPPER = 1
  //========================================//
  
EVENT_END

//--------------------------------------------------------------------
//	シズイ近づく：z156
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader8_come_z156
	_ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	シズイ近づく：z157
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader8_come_z157
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	シズイ退場：z156
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader8_bye_z156
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_D_8F,9
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	シズイ退場：z157
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader8_bye_z157
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_D_8F,8
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*  SCENE_CHANGE02：ジムバッチ後ジムリーダーイベント        */
/************************************************************/
EVENT_START   ev_scene_c14_swleader8_01
{

  //アニメ：主人公移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 783, 176, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()

  //アニメ：ライバル「！」
  _OBJ_ANIME( C14_SWRIVAL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //アニメ：ライバル移動
  _OBJ_ANIME_AUTO( C14_SWRIVAL_01, 784, 176, FORCE_TYPE_NPC, 8, DIR_LR )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：バッジがそろったか▼
  _BALLOONWIN_OBJMSG_POS( msg_c14_swrival_04, C14_SWRIVAL_01, POS_UR )
  _MSGWIN_CLOSE()

  //========================================//
  //シズイ表示
  _FLAG_RESET( FV_C14_SWLEADER8_01 )
  //========================================//

  //シズイ動作モデル生成
  _OBJ_ADD( C14_SWLEADER8_01 )

  //アニメ：シズイ移動
  _OBJ_ANIME_AUTO( C14_SWLEADER8_01, 783, 178, FORCE_TYPE_NPC, 8, DIR_UD )
  _TIME_WAIT( 8*4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
  _OBJ_ANIME( C14_SWRIVAL_01, anm_common_turn_d )
  //アニメーション待ち
  _OBJ_ANIME_WAIT()

  //シズイ：よう！　おはんら！▼
  _BALLOONWIN_OBJMSG_POS( msg_c14_swleader8_03, C14_SWLEADER8_01, POS_DR )
  _MSGWIN_CLOSE()

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：プラズマだん　ってのは
  _BALLOONWIN_OBJMSG_POS( msg_c14_swrival_05, C14_SWRIVAL_01, POS_UR )
  _MSGWIN_CLOSE()

  //シズイ：しらん！▼
  _BALLOONWIN_OBJMSG_POS( msg_c14_swleader8_04, C14_SWLEADER8_01, POS_DR )

  //シズイ：で　おまはん
  _BALLOONWIN_OBJMSG_POS( msg_c14_swleader8_05, C14_SWLEADER8_01, POS_DR )

  //プラズマ団は悪いと思う？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN  //はい
    //シズイ：そうか
    _BALLOONWIN_OBJMSG_POS( msg_c14_swleader8_06, C14_SWLEADER8_01, POS_DR )
    _MSGWIN_CLOSE()

  ELSE    //いいえ
    //シズイ：ほう　わるくない……　そう
    _BALLOONWIN_OBJMSG_POS( msg_c14_swleader8_07, C14_SWLEADER8_01, POS_DR )
    _MSGWIN_CLOSE()

  ENDIF

  //アニメ：シズイ２１番水道を見る
  _OBJ_ANIME( C14_SWLEADER8_01, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //シズイ：さてと……▼
  _BALLOONWIN_OBJMSG_POS( msg_c14_swleader8_08, C14_SWLEADER8_01, POS_DR )
  _MSGWIN_CLOSE()

  //アニメ：シズイ退散
  _OBJ_ANIME_AUTO( C14_SWLEADER8_01, 783, 184, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  
  //シズイ動作モデル削除
  _OBJ_DEL( C14_SWLEADER8_01 )

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：なんだ
  _BALLOONWIN_OBJMSG_POS( msg_c14_swrival_06, C14_SWRIVAL_01, POS_UR )
  _AB_KEYWAIT()
  _MSGWIN_CLOSE()

  //アニメ：ライバル退散
  _OBJ_ANIME_AUTO( C14_SWRIVAL_01, 783, 184, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  
  //ライバル動作モデル削除
  _OBJ_DEL( C14_SWRIVAL_01 )

  //========================================//
  //イベント進行
  $WK_SCENE_C14_SWLEADER8_01 = 2
  //ライバル、シズイ削除
  _FLAG_SET( FV_C14_SWRIVAL_01 )
  _FLAG_SET( FV_C14_SWLEADER8_01 )
  //========================================//

}
EVENT_END

/**************************************************************/
/*  ライバル：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_c14_swrival_01
  
  //C14初回会話時（POSを踏んでいない時
  IF $WK_SCENE_C14_SWRIVAL_01 == 1 THEN
    
    _TALK_OBJ_START()
    //ライバル名代入
    _RIVAL_NAME( 1 )
    //ライバル：いでんしのくさび
    _BALLOONWIN_OBJMSG_POS( msg_c14_swrival_01a, C14_SWRIVAL_01, POS_DEFAULT )
    //ライバル：はやく
    _BALLOONWIN_OBJMSG_POS( msg_c14_swrival_02, C14_SWRIVAL_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    //========================================//
    //C14 POS無効
    $WK_SCENE_C14_SWRIVAL_01 = 2
    //========================================//
  ELSE
    //ライバル名代入
    _RIVAL_NAME( 1 )
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14_swrival_03 )
  ENDIF

EVENT_END

/**************************************************************/
/*  おいかけっこカップル女：話しかけ                          */
/**************************************************************/
EVENT_START   ev_c14_girl4_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14_girl4_01 )
EVENT_END

/**************************************************************/
/*  おいかけっこカップル男：話しかけ（前）                    */
/**************************************************************/
EVENT_START   ev_c14_boy4_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14_boy4_01 )

  //会話済みフラグが立っていなかった場合フラグを立てる
  IF FLAG_OFF( FV_C14_GIRL4_01 ) THEN
    //========================================//
    //会話済みフラグON
    _FLAG_SET( FE_C14_BOY4_TALK_01 )
    //========================================//
  ENDIF

EVENT_END

/**************************************************************/
/*  おいかけっこカップル男：話しかけ（後）                    */
/**************************************************************/
EVENT_START   ev_c14_boy4_02
  
    //初回話しかけであったならば
  IF FLAG_OFF(SYS_FLAG_FES_HEART1) THEN
  
    _TALK_OBJ_START()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_c14_mission_add_01 )
    _MSGWIN_CLOSE()
    
    //フェスミッション名代入
    _FMISSION_NAME( 0, FMISSION_ID_ITEM_HEART_01, 0 )
    
    //フェスミッションが追加されました
    _SE_PLAY( SEQ_SE_FLD_133 )
    _SYSWIN_MSG( msg_c14_mission_add_02, POS_DEFAULT )
    _SE_WAIT()
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //==================================//
    //初回会話終了
    _FLAG_SET(SYS_FLAG_FES_HEART1)
    //==================================//
    
  //2回目以降
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14_boy4_02 )
  ENDIF

EVENT_END

/************************************************************/
/*  POS：顔出し看板イベント（１日１回）                     */
/************************************************************/
EVENT_START   ev_pos_c14_kaodasi_01

  _TALK_START_SE_PLAY()

  //プレイヤーの向きを取得
  _PLAYER_DIR_GET( LWK_DIR ) 

  //主人公が下を向いていない場合は下を向かせる
  IF $LWK_DIR != DIR_DOWN THEN
    //アニメ：主人公振り向き
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
    _OBJ_ANIME_WAIT()
  ENDIF

  //クリア前の場合
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    //ＢＧ：かおだしかんばんだ……
    _PLAINWIN_MSG_DOWN( msg_c14_sign4_01 )
    _LAST_KEYWAIT()
    _PLAINWIN_CLOSE()

    //==================================//
    //顔出し看板イベント終了（翌日復活）
    _FLAG_SET( TMFLG_C14_KAODASI_01 )
    //POS進行
    $LOCALWORK0 = 1
    //==================================//

  //クリア後
  ELSE

    //==================================//
    //カメラマン表示
    _FLAG_RESET( FV_C14_KAODASI_01 )
    //POS進行
    $LOCALWORK0 = 1
    //==================================//

    //ＢＧ：かおだしかんばんが　ある……！▼
    _PLAINWIN_MSG_DOWN( msg_c14_sign4_02 )
    _PLAINWIN_CLOSE()

    //カメラマン出現
    _OBJ_ADD( C14_VETERANM_01 )

    //乱数で0～4幅で一緒に出現するゲストキャラを決める
    _GET_RND( LOCALWORK1, 4 )
    IF $LOCALWORK1 == 0 THEN
      //フィールド上にシズイ配置
      _OBJ_ADD_EX( 777, 182, DIR_RIGHT, MMDL_ID_EVENTOBJ_00, SWLEADER8, MV_DMY )
    ELSIF $LOCALWORK1 == 1 THEN
      //フィールド上に女性配置
      _OBJ_ADD_EX( 777, 182, DIR_RIGHT, MMDL_ID_EVENTOBJ_00, WOMAN2, MV_DMY )
    ELSIF $LOCALWORK1 == 2 THEN
      //フィールド上にビジネスマン配置
      _OBJ_ADD_EX( 777, 182, DIR_RIGHT, MMDL_ID_EVENTOBJ_00, BUSINESSMAN, MV_DMY )
    ELSIF $LOCALWORK1 == 3 THEN
      //フィールド上にゴチミル配置
      _OBJ_ADD_EX( 777, 182, DIR_RIGHT, MMDL_ID_EVENTOBJ_00, POKE39, MV_DMY )
    ENDIF

    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX, LCW_POSZ )
    //アニメ：カメラマン＋ゲスト登場
    IF $LCW_POSX == 786 THEN
      _OBJ_ANIME( C14_VETERANM_01, anm_veteranm_walk_01 )
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_eventobj_walk_01 )
    ELSE
      _OBJ_ANIME( C14_VETERANM_01, anm_veteranm_walk_02 )
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_eventobj_walk_02 )
    ENDIF
    _OBJ_ANIME_WAIT()

    //カメラマン：はい　チーズ！！▼
    _BALLOONWIN_OBJMSG_POS( msg_c14_sign4_03, C14_VETERANM_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //フラッシュ演出（SE
    _SE_PLAY( SEQ_SE_GYM_E02 )
    _WHITE_IN()
    _DISP_FADE_END_CHECK()
    _SE_WAIT()  //SE待ち

    _TIME_WAIT( 8 )

    //登場ゲストによって演出分岐
    IF $LOCALWORK1 == 0 THEN
      //シズイ：これも　きねん　たい！▼
      _BALLOONWIN_OBJMSG_POS( msg_c14_sign4_04, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    ELSIF $LOCALWORK1 == 1 THEN
      //女性：ひとりだと……　さみしいから！▼
      _BALLOONWIN_OBJMSG_POS( msg_c14_sign4_05, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    ELSIF $LOCALWORK1 == 2 THEN
      //ビジネスマン：じぶん　マニアです
      _BALLOONWIN_OBJMSG_POS( msg_c14_sign4_06, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    ELSIF $LOCALWORK1 == 3 THEN
      //ゴチミル：ちみる♪
      _VOICE_PLAY( MONSNO_607, 0 ) 
      _BALLOONWIN_OBJMSG_POS( msg_c14_sign4_07, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
      _VOICE_WAIT()
    ENDIF
    _MSGWIN_CLOSE()

    //アニメ：カメラマン＋ゲスト退場
    IF $LCW_POSX == 786 THEN
      _OBJ_ANIME( C14_VETERANM_01, anm_veteranm_bye_01 )
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_eventobj_bye_01 )
      _TIME_WAIT( 16 )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
    ELSE
      _OBJ_ANIME( C14_VETERANM_01, anm_veteranm_bye_02 )
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_eventobj_bye_02 )
      _TIME_WAIT( 8 )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
    ENDIF
    _OBJ_ANIME_WAIT()
    _OBJ_DEL( C14_VETERANM_01 )
    _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

    _TIME_WAIT( 16 )   //砂浜の足跡が消えるまで待ち
    
    //メダル入手条件達成
    _SET_MEDAL_ACHIVE( MDLID_KAODASHI )

    //==================================//
    //カメラマン非表示
    _FLAG_SET( FV_C14_KAODASI_01 )
    //顔出し看板イベント終了（翌日復活）
    _FLAG_SET( TMFLG_C14_KAODASI_01 )
    //==================================//

  ENDIF

EVENT_END

