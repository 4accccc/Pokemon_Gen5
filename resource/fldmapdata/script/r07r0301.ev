  .text

  .include  "scr_seq_def.h"
  .include  "msg_r07r0301.h"
  .include  "r07r0301.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_r07r0301_oldman_01
_EVENT_DATA   ev_r07r0301_oldwoman_01
_EVENT_DATA   ev_r07r0301_boy1_01
_EVENT_DATA   ev_r07r0301_woman3_01
_EVENT_DATA_END

/**************************************************************/
/*  OLDMAN                                          */
/**************************************************************/
EVENT_START   ev_r07r0301_oldman_01

  //二回目以降話しかけ
  IF FLAG_ON( FE_R07R0301_ZUKAN_LOOK ) THEN
    _TALK_OBJ_START()
    _BALLOONWIN_OBJMSG_POS( msg_r07r0301_oldman_01,R07R0301_OLDMAN_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    _BALLOONWIN_OBJMSG_POS( msg_r07r0301_oldman_02,R07R0301_OLDMAN_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  //初回話しかけ
  ELSE
    
    _TALK_OBJ_START()
    
    //OLDMAN：わしがムッキムキの
    _BALLOONWIN_OBJMSG_POS( msg_r07r0301_oldman_03,R07R0301_OLDMAN_01, POS_DEFAULT )
    
    //OLDMAN：ほら　みせてやろう！
    _BALLOONWIN_OBJMSG_POS( msg_r07r0301_oldman_04,R07R0301_OLDMAN_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //ポケモンウィンドウ表示
    _DISP_POKE_WIN( MONSNO_648, 0, 0, 0 )
    //図鑑登録処理
    _SET_ZUKAN_FLAG( ZUKANCTRL_MODE_SEE, MONSNO_648 )
    
    //OLDMAN：こっちが
    _BALLOONWIN_OBJMSG_POS( msg_r07r0301_oldman_05,R07R0301_OLDMAN_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //ポケモンウィンドウ表示
    _DISP_POKE_WIN( MONSNO_649, 0, 0, 0 )
    //図鑑登録処理
    _SET_ZUKAN_FLAG( ZUKANCTRL_MODE_SEE, MONSNO_649 )
    
    //システム：登録された
    _SYSWIN_MSG( msg_r07r0301_oldman_06 , POS_DEFAULT )
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()
    
    //OLDMAN：わるさを　していた
    _BALLOONWIN_OBJMSG_POS( msg_r07r0301_oldman_07,R07R0301_OLDMAN_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //ポケモンウィンドウ表示
    _DISP_POKE_WIN( MONSNO_652, 0, 0, 0 )
    //図鑑登録処理
    _SET_ZUKAN_FLAG( ZUKANCTRL_MODE_SEE, MONSNO_652 )
    
    //システム：登録された
    _SYSWIN_MSG( msg_r07r0301_oldman_08 , POS_DEFAULT )
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()
    
    //========================================/
    //図鑑登録イベント終了
    _FLAG_SET( FE_R07R0301_ZUKAN_LOOK )
    //========================================/
  
  ENDIF
EVENT_END

/**************************************************************/
/*  OLDWOMAN                                          */
/**************************************************************/
EVENT_START   ev_r07r0301_oldwoman_01
  _EASY_BALLOONWIN_TALKOBJ_MSG(msg_r07r0301_oldwoman_01)
EVENT_END

/**************************************************************/
/*  BOY1                                          */
/**************************************************************/
EVENT_START   ev_r07r0301_boy1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG(msg_r07r0301_boy_01)
EVENT_END

/**************************************************************/
/*  WOMAN3                                          */
/**************************************************************/
EVENT_START   ev_r07r0301_woman3_01
{
  _TALK_OBJ_START()

  //体力の満タンではないポケモンのための変数定義
  DEFINE_LOCAL LWK_PARTY_NUM  //手持ちポケモンの数
  DEFINE_LOCAL LWK_COUNT_NUM  //WHILE文のカウンタ
  DEFINE_LOCAL LWK_RET_HP     //HPチェックの帰り値
  DEFINE_LOCAL LWK_RET_PP     //PPチェックの帰り値
  DEFINE_LOCAL LWK_DAME       //HPかPPが満タンではないポケモンの数

  //手持ちのポケモンの数を確認（ひんし、タマゴのポケモンは除外）
  _GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_BATTLE_ENABLE )

  //手持ちのポケモンの中にHPかPPが満タンではないポケモンがいるか確認（繰り返し処理）
  WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

    //指定POSのポケモンのHPを取得
    _CHECK_TEMOTI_HP( LWK_RET_HP, LWK_COUNT_NUM )

    //指定POSのポケモンのPPを取得
    _CHECK_TEMOTI_PP( LWK_RET_PP, LWK_COUNT_NUM )

    //チェックしたポケモンのHP（またはPP）が満タンではないのならば
    IF $LWK_RET_HP == FALSE || $LWK_RET_PP == FALSE THEN
      //HPかPPが満タンではないポケモンの数に＋１
      $LWK_DAME += 1

    ENDIF

    //カウント
     $LWK_COUNT_NUM += 1

  ENDWHILE

  //手持ちにHPかPPが満タンではないポケモンがいた場合
  IF $LWK_DAME >= 1 THEN

    _BALLOONWIN_TALKOBJ_MSG( msg_r07r0301_woman_01 )
    _MSGWIN_CLOSE()

    //暗転して手持ちポケモンを回復
    _BLACK_OUT()
    _DISP_FADE_END_CHECK()
    _TEMOTI_POKEMON_KAIFUKU()   //回復処理
    _ME_PLAY( SEQ_ME_ASA )
    _ME_WAIT()
    _BLACK_IN()
    _DISP_FADE_END_CHECK()

    //========================================//
    $LOCALWORK1 = 1
    //========================================//

    //手持ちのポケモンはHPもPPも満タン
  ELSE
    _BALLOONWIN_TALKOBJ_MSG( msg_r07r0301_woman_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

}
EVENT_END
