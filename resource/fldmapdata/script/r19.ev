//    スクリプトファイル：r19用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_r19.h"
  .include  "r19.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_pos_r19_pokeget_01
_EVENT_DATA    ev_pos_r19_champion_01
_EVENT_DATA    ev_r19_boy2_01
_EVENT_DATA    ev_bg_r19_board_01
_EVENT_DATA    ev_bg_r19_board_02
_EVENT_DATA    ev_bg_r19_board_03
_EVENT_DATA    ev_pos_r19_champion_02
_EVENT_DATA    ev_pos_r19_zukan_01
_EVENT_DATA    ev_r19_girl2_01
_EVENT_DATA    ev_r19_boy2_02
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/**************************************************************/
/*ポケモン捕獲デモ                                */
/**************************************************************/
EVENT_START   ev_pos_r19_pokeget_01
  
  //ベル：おうい！こっちだよ
  _BALLOONWIN_OBJMSG_MF( msg_r19_white_01a, msg_r19_white_01b, R19_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ベル登場
  _CALL ev_r19_swbell_commeing_01
  
  //アニメ：ベル右向き
  _OBJ_ANIME( R19_SWBELL_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  _BALLOONWIN_OBJMSG_POS( msg_r19_white_02, R19_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ベル下向き
  _OBJ_ANIME( R19_SWBELL_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  _BALLOONWIN_OBJMSG_POS( msg_r19_white_03, R19_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //カメラ操作　ベル追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  
  _CAMERA_MOVE( 9688,0,970752,4030464,65551,45645824,72 )
  
  _OBJ_ANIME( R19_SWBELL_01, r19_swbell_goto_kusa )
  _OBJ_ANIME( MMDL_ID_PLAYER, r19_player_look_kusa)
  _OBJ_ANIME_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //捕獲デモ呼び出し
  _CAPTURE_DEMO_SET()
  
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  
  //カメラ操作　博士中心に
  _CAMERA_MOVE( 9688,0,970752,4030464,65551,45645824,1 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //暗転終了
  _WILD_WIN()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (32)
  
  //アニメ：ベル戻る
  _OBJ_ANIME_AUTO( R19_SWBELL_01, 58, 696, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
   
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //ベル：いまのポイントを
  _BALLOONWIN_OBJMSG_POS( msg_r19_white_04, R19_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _BALLOONWIN_OBJMSG_POS( msg_r19_white_05, R19_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ベル右を向く
  _OBJ_ANIME( R19_SWBELL_01 , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ベル：となりまちの
  _BALLOONWIN_OBJMSG_POS( msg_r19_white_06, R19_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ベル左を向く
  _OBJ_ANIME( R19_SWBELL_01 , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //ベル：じゃあ
  _BALLOONWIN_OBJMSG_POS( msg_r19_white_07, R19_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ベル退場
  _CALL ev_r19_swbell_bye_01

  //==================================//
  
  //アデクのイベントPOS有効
  $WK_SCENE_R19 = 1
  
  //R19のベル非表示
  _FLAG_SET( FV_R19_SWBELL_01 )
  //C12R0101のベル表示
  _FLAG_RESET( FV_C12R0101_SWBELL )
  
  //C12のママと妹を非表示
	_FLAG_SET( FV_C12_SWRIVAL_SISTER )
	_FLAG_SET( FV_C12_SWMAMA )
	
	//C12R0101ママを表示
	_FLAG_RESET( FV_C12R0101_SWMAMA )
	//C12R0202ライバル宅の妹を表示
	_FLAG_RESET( FV_C12R0202_RIVALSISTER_01 )
	
	//ローカルライブキャスター・ママ通話状態を変更（デフォルト）
	_PERSON_STATE_SET_MOTHER( MOTHER_STATE_HOME )

  //==================================//
  
EVENT_END

/**************************************************************/
/*CALL：ベル登場                                */
/**************************************************************/
ev_r19_swbell_commeing_01:
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  IF $LCW_POSX != 53 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 53, 698, FORCE_TYPE_NPC, 8, DIR_LR)
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME_WAIT()
  ENDIF
  _OBJ_ANIME_WAIT()
  
_RET

/**************************************************************/
/*CALL：ベル登場                                */
/**************************************************************/
ev_r19_swbell_commeing_02:

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
   
   //フィールド上にベル配置
  _OBJ_ADD_EX( 53, 703, DIR_UP, MMDL_ID_EVENTOBJ_00, SWBELL, MV_DMY )
   
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  $LCW_POSZ += 1
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()

_RET


/**************************************************************/
/*CALL：ベル退場                                */
/**************************************************************/
ev_r19_swbell_bye_01:
  
  //アニメ：ベル退場・主人公見送り
  _OBJ_ANIME( R19_SWBELL_01, r19_swbell_bye_01)
  _TIME_WAIT(16)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //サポートOBJ消す
  _OBJ_DEL( R19_SWBELL_01 )
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
_RET

/**************************************************************/
/*CALL：ベル退場                                */
/**************************************************************/
ev_r19_swbell_bye_02:
  
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 53, 702, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,anm_downwalk )
  _OBJ_ANIME_WAIT()
    
  //サポートOBJ消す
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
_RET


//--------------------------------------------------------------------
//ベル：草むらに移動                    
//--------------------------------------------------------------------
	_ANIME_LABEL r19_swbell_goto_kusa
	_ANIME_DATA AC_WALK_R_8F,8
	_ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//主人公：草むら前に移動                     
//--------------------------------------------------------------------
	_ANIME_LABEL r19_player_look_kusa
	_ANIME_DATA AC_WALK_U_8F,2
	_ANIME_DATA AC_WALK_R_8F,3
	_ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//ベル：退場                     
//--------------------------------------------------------------------
	_ANIME_LABEL r19_swbell_bye_01
	_ANIME_DATA AC_WALK_D_8F,1
	_ANIME_DATA AC_WALK_L_8F,5
	_ANIME_DATA AC_WALK_D_8F,6
	_ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//ベル：退場                     
//--------------------------------------------------------------------
	_ANIME_LABEL r19_swbell_bye_02
	_ANIME_DATA AC_WALK_L_8F,1
	_ANIME_DATA AC_WALK_D_8F,8
	_ANIME_DATA ACMD_END,0

/**************************************************************/
/*POS：アデク登場                               */
/**************************************************************/
EVENT_START   ev_pos_r19_champion_01
  
  //メッセージ：そこのトレーナー！
  _PLAINWIN_MSG_DOWN( msg_r19_champion_01 )
  _MSGWIN_CLOSE()
  
  //カメラ操作　アデク追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  
  _CAMERA_MOVE( 9688,0,970752,6127616,393311,45318144,20 )
  
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_E_CHAMPION )
  
  //メッセージ：わしはアデク！
  _BALLOONWIN_OBJMSG_POS( msg_r19_champion_02, R19_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (30)
   
   //アテグジャンプ
	_OBJ_HIGH_JUMP( R19_CHAMPION_01, 93, 1, 693 )
	
	//カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
	
	//着地後WAIT
	_TIME_WAIT ( 14 )
	
	//自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  $LCW_POSX +=2
  
  IF $LCW_POSZ != 693 THEN
    _OBJ_ANIME_AUTO( R19_CHAMPION_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD)
  ENDIF
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_r )
  _OBJ_ANIME_WAIT()
  
  _OBJ_ANIME( R19_CHAMPION_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  _PLAYER_NAME( 0 )	 //プレイヤー名を反映
  
  //アデク：おまえさんは？
  _BALLOONWIN_OBJMSG_POS( msg_r19_champion_03, R19_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //アニメ：アデクプレイヤーのまわりをうろうろ
  SWITCH $LCW_POSZ
  CASE 693 THEN
    _OBJ_ANIME( R19_CHAMPION_01,r19_champion_look_player_z693 )
  CASE 697 THEN
    _OBJ_ANIME( R19_CHAMPION_01,r19_champion_look_player_z697 )
  DEFAULT  //目の前に立ったケースと同じ処理を行う
    _OBJ_ANIME( R19_CHAMPION_01,r19_champion_look_player_default )
  ENDSWITCH
  _OBJ_ANIME_WAIT()
  
  //瀕死・タマゴを除くポケモンの先頭を選択
  DEFINE_LOCAL LWK_FRONT
  _GET_PARTY_FRONT_POKEMON  ( LWK_FRONT , POKECOUNT_MODE_BATTLE_ENABLE )
  //先頭ポケモンの名前を取得
  _TEMOTI_MONS_NAME  (  1 , LWK_FRONT  )
  
  //アデク：ついてこい
  _BALLOONWIN_OBJMSG_POS( msg_r19_champion_04, R19_CHAMPION_01, POS_DEFAULT )
  
  _MSGWIN_CLOSE()
  
  //アニメ：アデク退場
  _OBJ_ANIME( R19_CHAMPION_01,r19_champion_bye )
  _OBJ_ANIME_WAIT()
  
  //イベント曲終了
  _END_EVENT_BGM()
  
  //アデク動作モデル非表示
  _OBJ_DEL(R19_CHAMPION_01)
  
  //==================================//
  //R19のアデク登場POS無効
  $WK_SCENE_R19 = 2
  //R19のアデク非表示
  _FLAG_SET( FV_R19_CHAMPION_01 )
  //==================================//
  
EVENT_END

//--------------------------------------------------------------------
//アデク：主人公のまわりをうろうろz693                     
//--------------------------------------------------------------------
	_ANIME_LABEL r19_champion_look_player_z693
	_ANIME_DATA AC_WALK_L_8F,1
	_ANIME_DATA	AC_WAIT_8F,1
	_ANIME_DATA AC_WALK_D_8F,1
	_ANIME_DATA AC_WALK_L_8F,1
