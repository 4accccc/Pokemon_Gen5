/**************************************************************/
/*POS：アデクきのみイベント                               */
/**************************************************************/
EVENT_START   ev_pos_r19_champion_02
  
  //==================================//
  //R19のアデク表示
  _FLAG_RESET( FV_R19_CHAMPION_01 )
  //==================================//
  
  _OBJ_ADD( R19_CHAMPION_01 )
  
  //プレイヤー名代入
  _PLAYER_NAME( 0 )
  
  //メッセージ：プライヤー名！
  _PLAINWIN_MSG_DOWN( msg_r19_champion_10 )
  _MSGWIN_CLOSE()
  
  //カメラ操作　アデク追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  
  _CAMERA_MOVE( 9688,0,970752,6127616,393311,45318144,40 )
  
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち  
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_E_CHAMPION )
  
  _TIME_WAIT( 40 )
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (8*8)
   
   //アテグジャンプ
	_OBJ_HIGH_JUMP( R19_CHAMPION_01, 93, 1, 693 )
	
	//カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
	
	//着地後WAIT
	_TIME_WAIT ( 14 )
	
	//自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  $LCW_POSX += 2
  
  IF $LCW_POSZ != 693 THEN
    _OBJ_ANIME_AUTO( R19_CHAMPION_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD)
  ENDIF
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：すまぬ！
  _BALLOONWIN_OBJMSG_POS( msg_r19_champion_11, R19_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アデク隣接
  _OBJ_ANIME( R19_CHAMPION_01, anm_leftwalk )
  _OBJ_ANIME_WAIT()
  
  //オレンのみ入手処理
  _ITEM_EVENT_KEYWAIT(ITEM_ORENNOMI, 5)
  
  //アニメ：アデク戻る
  _OBJ_ANIME( R19_CHAMPION_01, anm_champion_item_ret )
  _OBJ_ANIME_WAIT()
  
  //プレイヤー名代入
  _PLAYER_NAME( 0 )
  
  //メッセージ：いま渡したのは
  _BALLOONWIN_OBJMSG_POS( msg_r19_champion_12, R19_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アデク下を見る
  _OBJ_ANIME( R19_CHAMPION_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
   //メッセージ：さらに
  _BALLOONWIN_OBJMSG_POS( msg_r19_champion_13, R19_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アデク演技
  _OBJ_ANIME( R19_CHAMPION_01, anm_champion_act_01 )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：さてと…
  _BALLOONWIN_OBJMSG_POS( msg_r19_champion_14, R19_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アデク主人公に向き直る
  _OBJ_ANIME( R19_CHAMPION_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：そうして
  _BALLOONWIN_OBJMSG_POS( msg_r19_champion_15, R19_CHAMPION_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：アデク退場
  _OBJ_ANIME( R19_CHAMPION_01,r19_champion_bye )
  _OBJ_ANIME_WAIT()
  
  //イベント曲終了
  _END_EVENT_BGM()
  
  //アデク動作モデル削除
  _OBJ_DEL( R19_CHAMPION_01 )
  
  //==================================//
  //R19のきのみPOS無効
  $WK_SCENE_R19 = 4
  //R19アデク非表示
  _FLAG_SET( FV_R19_CHAMPION_01 )
  //==================================//
  
EVENT_END

//--------------------------------------------------------------
//	アデク：髪の毛ゆれ演出
//--------------------------------------------------------------
_ANIME_LABEL	anm_champion_act_01
	_ANIME_DATA	AC_CHAMPION_ACT0,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------
//	アデク：アイテム渡した後もどる
//--------------------------------------------------------------
_ANIME_LABEL	anm_champion_item_ret
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*POS：せいそくちリスト                               */
/**************************************************************/
EVENT_START   ev_pos_r19_zukan_01

  //プレイヤー名格納
  _PLAYER_NAME( 0 )
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_E_BERU )

{
  //性別が格納されるローカル変数を定義
  DEFINE_LOCAL SCWK_SEX
  _GET_MY_SEX(SCWK_SEX)
  
  //メッセージ：おおい（しっぽなしメッセージ）
  //男性だった場合
  IF $SCWK_SEX == PM_MALE THEN
  
  _PLAINWIN_MSG_DOWN( msg_r19_swbell_01 )
  _MSGWIN_CLOSE()
  
  //女性だった場合
  ELSE
  
  
  _PLAINWIN_MSG_DOWN( msg_r19_swbell_02 )
  _MSGWIN_CLOSE()
  
  ENDIF
}
  
  //アニメ：ベル登場
  _CALL ev_r19_swbell_commeing_02
  
  //ベル：ごめんね！
  _BALLOONWIN_OBJMSG_POS( msg_r19_swbell_03, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //システム：パワーアップした
  _SE_PLAY( SEQ_SE_SW_ZKN_KAIHOU  )
  _SYSWIN_MSG(msg_r19_swbell_04, POS_DEFAULT)
  _SE_WAIT()
  _AB_KEYWAIT_MARK()
  _SYSWIN_CLOSE()
  
  //せいそくちリスト開放
  _SET_ZUKAN_HABITAT_FLAG()
  
  //ベル：せいそくちリストは
  _BALLOONWIN_OBJMSG_POS( msg_r19_swbell_05, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  
  //つかいかたは
  _BALLOONWIN_OBJMSG_POS( msg_r19_swbell_06, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はいなら再度説明
  IF $SCWK_ANSWER == SCR_YES THEN
    {
    //再質問にyesと答えるまでループ
    DEFINE_LOCAL	ans_yes
    $ans_yes = SCR_YES
    
     WHILE $ans_yes == SCR_YES
      _BALLOONWIN_OBJMSG_POS( msg_r19_swbell_06, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
      _YES_NO_WIN( ans_yes )
     ENDWHILE
     }
  ENDIF
  
  //ベル：ポケモンずかんをうめることは
  _BALLOONWIN_OBJMSG_POS( msg_r19_swbell_07, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ベル退場
  _CALL ev_r19_swbell_bye_02
  
  //イベント曲終了
  _END_EVENT_BGM()
  
  //==================================//
  //R19のすべてのPOS無効
  $WK_SCENE_R19 = 6
  //ローカルライブキャスター・ベル通話状態を変更（D06到着まで）
  _PERSON_STATE_SET_BELL( BELL_STATE_HOME )
  //==================================//
  
EVENT_END

//--------------------------------------------------------------------
//	☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swbell_zukan_back
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*段差降りパフォーマンスの少年                                */
/**************************************************************/
EVENT_START   ev_r19_boy2_01
  _TALK_OBJ_START()
	
	IF FLAG_OFF( FH_16) THEN
	
		_BALLOONWIN_OBJMSG_POS(msg_r19_boy2_01,R19_BOY2_01, POS_DL)
		_YES_NO_WIN( SCWK_ANSWER )
	
		IF $SCWK_ANSWER == SCR_NO THEN
			_FLAG_SET(FH_16)
			_BALLOONWIN_OBJMSG_POS(msg_r19_boy2_02a,R19_BOY2_01, POS_DL)
			_MSGWIN_CLOSE()
			
			_OBJ_ANIME(R19_BOY2_01,anm_staystep_l)
			_OBJ_ANIME_WAIT()
			
			//掛け声を少し間表示して、自動で消す
			_BALLOONWIN_OBJMSG_POS(msg_r19_boy2_03,R19_BOY2_01, POS_DL)
			_TIME_WAIT(4)
			_MSGWIN_CLOSE()
						
			_OBJ_ANIME( R19_BOY2_01,boy2_jump )

			//段差を降りるアニメ+段差を降りるSE
			_TIME_WAIT(4)
			
			_PLAYER_DIR_GET( LWK_DIR )
			IF $LWK_DIR != DIR_LEFT THEN
			  _OBJ_ANIME(MMDL_ID_PLAYER,anm_staystep_l)
			ENDIF
			_OBJ_ANIME_WAIT()
			
			_OBJ_ANIME(R19_BOY2_01,anm_staystep_r)
			_OBJ_ANIME_WAIT()

			_BALLOONWIN_OBJMSG_POS( msg_r19_boy2_04 , R19_BOY2_01, POS_UL )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
					
		ELSE
			_BALLOONWIN_OBJMSG_POS( msg_r19_boy2_02 , R19_BOY2_01, POS_DEFAULT)
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		ENDIF

	ELSE
			_BALLOONWIN_OBJMSG_POS( msg_r19_boy2_04 , R19_BOY2_01, POS_DEFAULT )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
	ENDIF
EVENT_END

