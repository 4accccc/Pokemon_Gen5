//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_pos_r19_pokeget_01
_EVENT_DATA    ev_pos_r19_champion_01
_EVENT_DATA    ev_r19_boy2_01
_EVENT_DATA    ev_bg_r19_board_01
_EVENT_DATA    ev_bg_r19_board_02
_EVENT_DATA    ev_bg_r19_board_03
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/**************************************************************/
/*ポケモン捕獲デモ                                */
/**************************************************************/
EVENT_START   ev_pos_r19_pokeget_01

  //性別が格納されるローカル変数を定義
  DEFINE_LOCAL SCWK_SEX
  _GET_MY_SEX(SCWK_SEX)
  
  //メッセージ：おおい（しっぽなしメッセージ）
  //男性だった場合
  IF $SCWK_SEX == PM_MALE THEN
  
  _PLAINWIN_MSG_DOWN( msg_r19_white_01a )
  _MSGWIN_CLOSE()
  
  //女性だった場合
  ELSE
  
  
  _PLAINWIN_MSG_DOWN( msg_r19_white_01b )
  _MSGWIN_CLOSE()
  
  ENDIF

  //フィールド上にベル配置
  _OBJ_ADD_EX( 53, 703, DIR_UP, MMDL_ID_EVENTOBJ_00, SWBELL, MV_DMY )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  //【仮】主人公の位置より1歩下につくように
  $LCW_POSZ += 1
  
  //アニメ：ベル隣接
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  _BALLOONWIN_OBJMSG_POS( msg_r19_white_03, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  
  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //カメラ操作　ベル追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  
  //ベル草むらへ
  SWITCH $LCW_POSZ
  CASE 692 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,r19_swbell_gotokusa_01_z692 )
  CASE 693 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,r19_swbell_gotokusa_01_z693 )
  CASE 694 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,r19_swbell_gotokusa_01_z694 )
  CASE 695 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,r19_swbell_gotokusa_01_z695 )
  CASE 696 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,r19_swbell_gotokusa_01_z696 )
  CASE 697 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,r19_swbell_gotokusa_01_z697 )
  DEFAULT  //目の前に立ったケースと同じ処理を行う
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,r19_swbell_gotokusa_01_z695 )
  ENDSWITCH
  
  _OBJ_ANIME_WAIT()
  
    //主人公草むらを見る
  SWITCH $LCW_POSZ
  CASE 692 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, r19_player_lookkusa_01_z692 )
  CASE 693 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, r19_player_lookkusa_01_z693 )
  CASE 694 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, r19_player_lookkusa_01_z694 )
  CASE 695 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  CASE 696 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, r19_player_lookkusa_01_z696 )
  CASE 697 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, r19_player_lookkusa_01_z697 )
  DEFAULT  //目の前に立ったケースと同じ処理を行う
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  ENDSWITCH
  
  _CAMERA_MOVE( 9688,0,970752,3899392,65551,45580288,30 )

  //アニメ：主人公ベル方面を見る
  
  _OBJ_ANIME_WAIT()
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  /*
  //捕獲デモ呼び出し
  _CAPTURE_DEMO_SET()
  
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  
  //カメラ操作　博士中心に
  _CAMERA_MOVE( 9694,0,970800,51675136,0,47480832,1 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //暗転終了
  _WILD_WIN()
  */
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (24)
  
  //アニメ：ベル戻る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,r19_swbell_gotokusa_02 )
  _OBJ_ANIME_WAIT()
   
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  _BALLOONWIN_OBJMSG_POS( msg_r19_white_04, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _BALLOONWIN_OBJMSG_POS( msg_r19_white_05, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ベル退場・主人公見送り
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,r19_swbell_gotokusa_03 )
  _TIME_WAIT(16)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //サポートOBJ消す
	_OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

  //==================================//
  
  //アデクのイベントPOS有効
  $WK_SCENE_R19 = 1
  
  //C12R0101のベル表示
  _FLAG_RESET( FV_C12R0101_SWBELL )
  
  //C12のママと妹を非表示
	_FLAG_SET( FV_C12_SWRIVAL_SISTER )
	_FLAG_SET( FV_C12_SWMAMA )
	
	//【仮】C12ライバル宅の妹を表示

  //==================================//
  
EVENT_END

