
//======================================================================
//                d08r0901.ev
//
//    スクリプトファイル：d08r0901用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d08r0901.h"
  .include  "d08r0901.h"
  .include  "d08_def.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori //演出修正・スクリプト修正

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_d08r0901
_EVENT_DATA   ev_pos_d08r0901_stone_01
_EVENT_DATA   ev_d08r0901_poke_01
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LWK_VERSION
//座標取得
DEFINE_LOCAL LWK_POSX
DEFINE_LOCAL LWK_POSZ

/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_d08r0901

  //バージョンを取得してOBJを変化させる
  _GET_ROM_VERSION( LWK_VERSION )

  IF FLAG_OFF( FV_D08R0901_PACKAGE_POKE ) THEN

    IF $LWK_VERSION == VERSION_B2 THEN
      $OBJCHRWORK0 = SPPOKE02_ZE //ゼクロム
    ELSE
      $OBJCHRWORK0 = SPPOKE01_RE //レシラム
    ENDIF

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  POS：ゼクロム（レシラム）復活                             */
/**************************************************************/
EVENT_START   ev_pos_d08r0901_stone_01

  //バージョンを取得してメッセージを変化
  _GET_ROM_VERSION( LWK_VERSION )

  _SE_PLAY(SEQ_SE_END_02)
  _SHAKE_CAMERA(4,0,4,5,1,0,1,3)
  _SE_WAIT()
	
  _TIME_WAIT( 30 )

  //B2:ゼクロム復活
  IF $LWK_VERSION == VERSION_B2 THEN
    //システム：ダークストーンが　うごめいている！？▼
    _SYSWIN_MSG( msg_d08r0901_dstone_01, POS_DOWN )

    //「ダークストーン」を取り出す？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      _MSGWIN_CLOSE()

      _PLAYER_POS_GET( LWK_POSX, LWK_POSZ )
      
      IF $LWK_POSX != 16  THEN
      
          _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 16, LWK_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
          _OBJ_ANIME_WAIT()
          _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_up )
          _OBJ_ANIME_WAIT()
      
      ENDIF
      
      _SUB_ITEM( ITEM_DAAKUSUTOON,1,SCWK_ANSWER )
      
      _CAMERA_START()		//カメラ操作開始
      _CAMERA_PURGE()		//カメラパージ
      _CAMERA_MOVE(9688,0,970752,1081344,0,688128,30)
      _CAMERA_WAIT_MOVE()	//カメラ移動待ち

      _TIME_WAIT ( 8 )  //間

      //ダーク（ライト）ストーンの演出
      _START_LEG_GMK()
      //無音にする
      _START_EVENT_BGM_EX( SEQ_BGM_SILENCE_DUNGEON, BGM_FADE_VSHORT )

      //==================================//
      //ゼクロム表示
      _FLAG_RESET( FV_D08R0901_PACKAGE_POKE )
      //POSイベント進行
      $WK_SCENE_D08R0901_LEGEND = 2
      //==================================//

      $OBJCHRWORK0 = SPPOKE02_ZE //OBJをゼクロムに

      //システム：まわりの　オーラを　とりこんだ
      _SYSWIN_MSG( msg_d08r0901_dstone_02, POS_DOWN )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      _CALL ev_born

    ELSE    //いいえ

      _MSGWIN_CLOSE()

      //アニメ：主人公一歩後ろに下がる
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_back_d )
      _OBJ_ANIME_WAIT()

      _TIME_WAIT ( 8 )

      //プレイヤーネームを格納
      _PLAYER_NAME( 0 )
      //システム：ふしぎな　ちからで　おしもどされた……！
      _SYSWIN_MSG( msg_d08r0901_dstone_03, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //W2:レシラム復活
  ELSE

    //システム：ライトストーンが　うごめいている！？▼
    _SYSWIN_MSG( msg_d08r0901_lstone_01, POS_DOWN )

    //「ライトストーン」を取り出す？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      _MSGWIN_CLOSE()

      _PLAYER_POS_GET( LWK_POSX, LWK_POSZ )
      
      IF $LWK_POSX != 16  THEN
      
          _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 16, LWK_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
          _OBJ_ANIME_WAIT()
          _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_up )
          _OBJ_ANIME_WAIT()
      
      ENDIF

      _SUB_ITEM( ITEM_RAITOSUTOON,1,SCWK_ANSWER )

      _CAMERA_START()		//カメラ操作開始
      _CAMERA_PURGE()		//カメラパージ
      _CAMERA_MOVE(9688,0,970752,1081344,0,688128,30)
      _CAMERA_WAIT_MOVE()	//カメラ移動待ち

      _TIME_WAIT ( 8 )  //間

      //ダーク（ライト）ストーンの演出
      _START_LEG_GMK()
      //無音にする
      _START_EVENT_BGM_EX( SEQ_BGM_SILENCE_DUNGEON, BGM_FADE_VSHORT )

      //==================================//
      //レシラム表示
      _FLAG_RESET( FV_D08R0901_PACKAGE_POKE )
      //POSイベント進行
      $WK_SCENE_D08R0901_LEGEND = 2
      //==================================//

      $OBJCHRWORK0 = SPPOKE01_RE //OBJをレシラムに

      //システム：まわりの　オーラを　とりこんだ
      _SYSWIN_MSG( msg_d08r0901_lstone_02, POS_DOWN )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      _CALL ev_born

    ELSE    //いいえ

      _MSGWIN_CLOSE()

      //アニメ：主人公一歩後ろに下がる
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_back_d )
      _OBJ_ANIME_WAIT()

      _TIME_WAIT ( 8 )

      //プレイヤーネームを格納
      _PLAYER_NAME( 0 )
      //システム：ふしぎな　ちからで　おしもどされた……！
      _SYSWIN_MSG( msg_d08r0901_lstone_03, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

EVENT_END

ev_born:

//デモ再生：ム（シン）石から復活デモ
_DEMO_FADEOUT_BLACK_CALL()

_GET_ROM_VERSION( LWK_VERSION )
_DEBUG_PRINT_WK( LWK_VERSION )
IF $LWK_VERSION == VERSION_B2 THEN
	_CALL_3D_DEMO( DEMO3D_ID_N_LEGEND_BORN_W )
ELSE
	_CALL_3D_DEMO( DEMO3D_ID_N_LEGEND_BORN_B )
ENDIF

//レシゼク配置
_OBJ_ADD( D08R0901_POKE_01 )

_DEMO_FADEIN_BLACK_CALL()
_END_EVENT_BGM_EX( BGM_FADE_VSHORT )

_CAMERA_BIND()		//カメラバインド
_CAMERA_END()		//カメラ操作終了

_RET

/**************************************************************/
/*  ゼクロム（レシラム）：話しかけ（戦闘／倒した場合は殿堂入り後復帰）*/
/**************************************************************/
EVENT_START    ev_d08r0901_poke_01

_TALK_START_SE_PLAY()
{
  DEFINE_LOCAL  LWK_DIR
  _PLAYER_DIR_GET( LWK_DIR )
  SWITCH $LWK_DIR
  CASE DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_last6_d )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_last6_r )
  CASE DIR_LEFT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_last6_l )
  ENDSWITCH
  _OBJ_ANIME_WAIT()
}
{

  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラパージ
  _CAMERA_MOVE(9688,0,937984,1081344,0,757760,6)
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち

  _GET_ROM_VERSION( LWK_VERSION )
  IF $LWK_VERSION == VERSION_B2 THEN 
    _OBJ_ANIME( D08R0901_POKE_01, anm_ze_hoeru )
  ELSE
    _OBJ_ANIME( D08R0901_POKE_01, anm_re_hoeru )
  ENDIF
  
  _OBJ_ANIME_WAIT()

  DEFINE_LOCAL  LWK_BATTLE_FLAG

  //シン・ム専用、伝説系MSG、レア無し
  $LWK_BATTLE_FLAG = SCR_WILD_BTL_FLAG_LEGEND
  $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_NO_RARE

  _GET_ROM_VERSION( LWK_VERSION )
  IF $LWK_VERSION == VERSION_B2 THEN

    _VOICE_PLAY( MONSNO_651, 0 )
    //ゼクロム：ババリバリッシュ！！
    _GIZAPLAINWIN_MSG_POS( msg_d08r0901_poke8_01, POS_DEFAULT )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()

    // Lv.70 ゼクロム
    _WILD_BTL_SET_EX( MONSNO_651, 70, LWK_BATTLE_FLAG )

  ELSE

    _VOICE_PLAY( MONSNO_650, 0 )
    //レシラム：ンバーニンガガッ！！
    _GIZAPLAINWIN_MSG_POS( msg_d08r0901_poke7_01, POS_DEFAULT )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()

    // Lv.70 レシラム
    _WILD_BTL_SET_EX( MONSNO_650, 70, LWK_BATTLE_FLAG )

  ENDIF

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN    //勝った場合

    //レシラム（ゼクロム）OBJ削除
    _OBJ_DEL( D08R0901_POKE_01 )

    //========================================/
    //ゼクロム（レシラム）非表示
    _FLAG_SET( FV_D08R0901_PACKAGE_POKE )
    //========================================/

    //自機にカメラを戻す
    _CAMERA_START()		//カメラ操作開始
    _CAMERA_PURGE()		//カメラのバインドを解く
    _CAMERA_DEF_MOVE (1)
    //カメラ待ち
    _CAMERA_WAIT_MOVE()
    _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
    _CAMERA_END()		//カメラ操作終了

    _WILD_WIN()   //勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _WILD_LOSE()  //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
}

  //ゼクロム（レシラム）を捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN    //捕まえた場合

    //========================================/
    //ゼクロム（レシラム）捕獲フラグをセット
    _FLAG_SET( FE_PACKAGE_POKE_GET )
    //========================================/

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN    //勝利した場合、あるいは逃げた場合
  
    _GET_ROM_VERSION( LWK_VERSION )
    IF $LWK_VERSION == VERSION_B2 THEN
      //システム：ゼクロムは　どこかに
      _SYSWIN_MSG( msg_d08r0901_poke8_02, POS_DOWN )
      _LAST_KEYWAIT()
      _SYSWIN_CLOSE()
    ELSE
      //システム：レシラムは　どこかに
      _SYSWIN_MSG( msg_d08r0901_poke7_02, POS_DOWN )
      _LAST_KEYWAIT()
      _SYSWIN_CLOSE()
    ENDIF

  ENDSWITCH

  //初回か？
  IF FLAG_OFF( FE_D08R0901_BOSS_TALK ) THEN
  
  	_CALL ev_n_come
  
  ENDIF

EVENT_END

ev_n_come:

//Ｎ表示
_OBJ_ADD_EX( 16, 20, DIR_UP, MMDL_ID_EVENTOBJ_00, BOSS, MV_DMY )

//アニメ：主人公に近づく
_OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 16, 14, FORCE_TYPE_NOT, 8, DIR_UD )
_OBJ_ANIME_WAIT()

_OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_down )
_OBJ_ANIME_WAIT()

//バージョン取得
_GET_ROM_VERSION( LWK_VERSION )

SWITCH $SCWK_ANSWER
CASE SCR_WILD_BTL_RET_CAPTURE THEN		//捕まえた場合

	IF $LWK_VERSION == VERSION_B2 THEN
		_BALLOONWIN_OBJMSG_POS( msg_d08r0901_boss_01b ,MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
	ELSE
		_BALLOONWIN_OBJMSG_POS( msg_d08r0901_boss_01w ,MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
	ENDIF

CASE SCR_WILD_BTL_RET_WIN THEN		//勝利した場合

	IF $LWK_VERSION == VERSION_B2 THEN
		_BALLOONWIN_OBJMSG_POS( msg_d08r0901_boss_02b ,MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
	ELSE
		_BALLOONWIN_OBJMSG_POS( msg_d08r0901_boss_02w ,MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
	ENDIF

CASE SCR_WILD_BTL_RET_ESCAPE THEN		//逃げた場合

	IF $LWK_VERSION == VERSION_B2 THEN
		_BALLOONWIN_OBJMSG_POS( msg_d08r0901_boss_03b ,MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
	ELSE
		_BALLOONWIN_OBJMSG_POS( msg_d08r0901_boss_03w ,MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
	ENDIF

ENDSWITCH

//キミに　つたえることが　ある
_BALLOONWIN_OBJMSG_POS( msg_d08r0901_boss_04 ,MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
_MSGWIN_CLOSE()

_TIME_WAIT( 20 )

//主人公名前格納
_PLAYER_NAME( 0 )

//キミが　のぞむ　ポケモンとの　せかい
_BALLOONWIN_OBJMSG_POS( msg_d08r0901_boss_05 ,MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
_MSGWIN_CLOSE()

_CAMERA_START()		//カメラ操作開始
_CAMERA_PURGE()		//カメラパージ
_CAMERA_MOVE(9688,0,970752,1081344,0,1146880,32)
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_n_leave )
_CAMERA_WAIT_MOVE()	//カメラ移動待ち
_OBJ_ANIME_WAIT()

_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_common_turn_left )
_OBJ_ANIME_WAIT()

//いつか……
_BALLOONWIN_OBJMSG_POS( msg_d08r0901_boss_06 ,MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
_MSGWIN_CLOSE()

//アニメ：Ｎ退場
_CAMERA_RECV_MOVE(40)	//カメラ復帰移動
_OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 16, 23, FORCE_TYPE_NOT, 8, DIR_UD )
_CAMERA_WAIT_MOVE()	//カメラ移動待ち
_OBJ_ANIME_WAIT()

_OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

//========================================//

//Ｎのイベントを見たセット
_FLAG_SET(FE_D08R0901_BOSS_TALK)

//N01R0502 N非表示
_FLAG_SET( FV_N01R0502_BOSS_01 )

//D10R0501 キュレム表示
_FLAG_RESET( FV_D10R0501_KYUREMU )

//========================================//

_CAMERA_BIND()		//カメラバインド
_CAMERA_END()		//カメラ操作終了

_RET


//--------------------------------------------------------------------
//シンとム専用のアニメ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_legend_hoeru
  _ANIME_DATA AC_SHIN_MU_HOERU,1
  _ANIME_DATA ACMD_END,0
 
_ANIME_LABEL	anm_re_hoeru
  _ANIME_DATA	AC_SPPOKE01_RE_BARK,1
  _ANIME_DATA	ACMD_END,0
  
_ANIME_LABEL	anm_ze_hoeru
  _ANIME_DATA	AC_SPPOKE02_ZE_BARK,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//話しかけた場合の回り込み処理
//--------------------------------------------------------------------
_ANIME_LABEL  anm_last6_r
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_last6_l
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_last6_d
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_D_8F,2
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：下に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_d
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通スクリプト：びっくりする
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_gyoe
  _ANIME_DATA AC_DIR_U,1
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通スクリプト：上を向く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_up
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通スクリプト：下を向く_むきのみ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_turn_d
  _ANIME_DATA AC_DIR_D,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通スクリプト：下を向く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_down
  _ANIME_DATA AC_STAY_WALK_D_16F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通スクリプト：右を向く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_right
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通スクリプト：左を向く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_left
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：後ろに戻される
//--------------------------------------------------------------------
_ANIME_LABEL  anm_back_d
  _ANIME_DATA AC_STAY_WALK_U_4F,2
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA AC_WALK_D_4F,1
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA ACMD_END,0

//-----------------------------------------------------------
//☆Ｎ：退場
//-----------------------------------------------------------
_ANIME_LABEL	anm_n_leave
	_ANIME_DATA	AC_WALK_D_8F,2
	_ANIME_DATA	AC_WALK_D_16F,1
	_ANIME_DATA	AC_WAIT_8F,3
	_ANIME_DATA	AC_N_ACT1,1
	_ANIME_DATA	ACMD_END,0