
//======================================================================
//                c05gym0101.ev
//
//    スクリプトファイル：c05gym0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c05gym0101.h"
  .include  "c05gym0101.h"
  .include  "c05gym0201_def.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    c05gym0101_leader5_01
_EVENT_DATA    ev_reserve_c05gym0101_gymstart_01
_EVENT_DATA    ev_c05gym0101_sunglasses_01
_EVENT_DATA    ev_bg_c05gym0101_lift_00
_EVENT_DATA    ev_bg_c05gym0101_lift_01
_EVENT_DATA    ev_bg_c05gym0101_lift_02
_EVENT_DATA    ev_bg_c05gym0101_lift_03
_EVENT_DATA    ev_bg_c05gym0101_exitlift_00u
_EVENT_DATA    ev_zone_c05gym0101
_EVENT_DATA    ev_init_c05gym0101
_EVENT_DATA    ev_pos_c05gym0101_shortcut
_EVENT_DATA_END

//--------------------------------------------------------------
//               ローカル変数
//--------------------------------------------------------------
// 昇降リフトID
DEFINE_LOCAL  lift_id

/************************************************************/
/*					ジムギミック初期化						*/
/*          ZONE_CHANGE_LABEL             */
/************************************************************/
INIT_EVENT_START  ev_zone_c05gym0101

INIT_EVENT_END

/************************************************************/
/*					ジムギミック初期化						*/
/*          FIELD_INIT_LABEL             */
/************************************************************/
INIT_EVENT_START  ev_init_c05gym0101

  //バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_05 )

	//バッジフラグで分岐
	IF $SCWK_TEMP0 == 1 THEN
		//バッジ入手後の処理

    // ガイド位置変更
    _OBJ_POS_CHANGE( C05GYM0101_SUNGLASSES_01, 9, 0, 79, DIR_DOWN )
    // ヤーコン位置変更
    _OBJ_POS_CHANGE( C05GYM0101_LEADER5_01, 11, 1, 71, DIR_DOWN )
  ENDIF

INIT_EVENT_END

/************************************************************/
/*				接続イベント エントランスから降下			*/
/************************************************************/
EVENT_START	ev_reserve_c05gym0101_gymstart_01
  //リフトと自機の位置をセット
  _GYM_GROUND_SET_ENTER_POS()
	//マップブラックイン
	_MAP_FADE_BLACK_IN_SLOW()
	//エントランスからリフトが降りる演出（引数0 = 降下アニメ）
	_GYM_GROUND_EXIT_LIFT( 0 )
  //マップフェード待ち
	_MAP_FADE_END_CHECK()

EVENT_END

/**************************************************************/
/*    ジムリーダー会話                                  */
/**************************************************************/
EVENT_START		c05gym0101_leader5_01
	_TALK_OBJ_START()
	
	//ジムバッジ取得チェック
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_05 )
	
	//ジムバッジを取得していない場合
	IF $SCWK_TEMP0 == 0 THEN
	
		//会話
		_BALLOONWIN_OBJMSG( msg_c05gym0101_leader_01,C05GYM0101_LEADER5_01 )
		_BALLOONWIN_CLOSE()
	
		//戦闘処理
		_TRAINER_BTL_SET( TRID_SWLEADER5_01, 0 )
		//結果チェック
		_TRAINER_LOSE_CHECK( SCWK_ANSWER )
		IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()
		ELSE
			_TRAINER_LOSE()
		ENDIF
		
		//勝利後会話
		_BALLOONWIN_OBJMSG( msg_c05gym0101_leader_02 , C05GYM0101_LEADER5_01 )
		_BALLOONWIN_CLOSE()
	
    //リーダー戦勝利時の情報登録
    _SET_GYM_VICTORY_INFO( BADGE_ID_05 )
		//クエイクバッジ入手処理
		_SET_BADGE_FLAG( BADGE_ID_05 )
		
		{
		
		//バッジ入手演出再生
		_ME_PLAY( SEQ_ME_BADGE )
		
		//性別が格納されるローカル変数を定義
		DEFINE_LOCAL SCWK_SEX
		_GET_MY_SEX(SCWK_SEX)
		
		//男性だった場合
		IF $SCWK_SEX == PM_MALE THEN
			_CALL_FLD3D_CUTIN( FLDCIID_GYM05 )
		//女性だった場合
		ELSE
			_CALL_FLD3D_CUTIN( FLDCIID_GYM05F )
		ENDIF
		
		//ME待ち
		_ME_WAIT()
			
	  }
		
		//ヤーコンからクエイクバッジをもらった
		_PLAYER_NAME( 0 )
		_SYSWIN_MSG( msg_c05gym0101_leader_03 , POS_DEFAULT )
		_SYSWIN_CLOSE()

		//ヤーコンメッセージ
		_BALLOONWIN_OBJMSG( msg_c05gym0101_leader_04 , C05GYM0101_LEADER5_01 )
		_BALLOONWIN_CLOSE()

    //わざマシン入手処理　「じならし」
    _ITEM_EVENT_KEYWAIT( ITEM_WAZAMASIN78, 1 )
		_LAST_KEYWAIT()

		
		//============フラグワーク操作=============//
	
		//ジムトレーナーの視線無効
		_TRAINER_FLAG_SET( TRID_WORKER2_24 )
		_TRAINER_FLAG_SET( TRID_WORKER2_25 )
		_TRAINER_FLAG_SET( TRID_WORKER2_26 )
		_TRAINER_FLAG_SET( TRID_WORKER2_27 )
		_TRAINER_FLAG_SET( TRID_WORKER2_28 )
		_TRAINER_FLAG_SET( TRID_WORKER2_29 )
		_TRAINER_FLAG_SET( TRID_WORKER2_30 )
		
		//電光掲示板フラグセット
		_FLAG_SET( SYS_FLAG_ELBOARD_C05GYMWIN )

		//========================================//

    //=====================================
    //帰り道ショートカットPOSの起動をできるようにする
		$WK_SCENE_C05GYM0101_SHORTCUT = 1
    //=====================================

	//ジムバッジ入手後
	ELSE
		
		//クリア後
		IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
			_BALLOONWIN_OBJMSG( msg_c05gym0101_leader_end_01 , C05GYM0101_LEADER5_01 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
				
		//クリア前
		ELSE
			_BALLOONWIN_OBJMSG( msg_c05gym0101_leader_05 , C05GYM0101_LEADER5_01 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
		ENDIF
		
	ENDIF

EVENT_END


/************************************************************/
/*						ジムガイド							*/
/************************************************************/
EVENT_START	ev_c05gym0101_sunglasses_01
	_TALK_OBJ_START()

	//バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_05 )

	//バッジフラグで分岐
	IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前の処理

		//アイテム入手フラグで分岐
		IF FLAG_OFF( FE_C05GYM_ITEM ) THEN
			//アイテム未入手なら、おいしいみず入手イベント
			_BALLOONWIN_TALKOBJ_MSG( msg_c05gym0101_glasses_01 )
			_BALLOONWIN_CLOSE()
			_ITEM_EVENT_KEYWAIT( ITEM_OISIIMIZU, 1 )
			_BALLOONWIN_TALKOBJ_MSG( msg_c05gym0101_glasses_02 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()

			_FLAG_SET( FE_C05GYM_ITEM )			//アイテム入手フラグをセット

		ELSE
			//入手済みならメッセージのみ
			_BALLOONWIN_TALKOBJ_MSG( msg_c05gym0101_glasses_02 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
		ENDIF

	ELSE
		//バッジ入手後の処理

		//思い出してほしいっすね
		_BALLOONWIN_TALKOBJ_MSG( msg_c05gym0101_glasses_03 )
		_LAST_KEYWAIT()
		_BALLOONWIN_CLOSE()

	ENDIF

EVENT_END

/*
    昇降リフトの処理の流れ

    カメラ操作(Script) 
    リフト上昇(Program)
    ↓
    リフトが最高高さになった時の待ち(Script)
    ↓
    リフト下降(Program)
    カメラ操作(Script)

    リフト昇降はプログラムで行っているが、
    パラメータは、デバッグで変更可能
    ・高さ
    ・速度
*/
/************************************************************/
/*				昇降リフト 左上                     */
/************************************************************/
EVENT_START ev_bg_c05gym0101_lift_00
  $lift_id = 0                 // リフトのIDを代入
	_SE_PLAY( SEQ_SE_FLD_61 )		//スイッチＳＥを再生
	_SE_WAIT()
  _CALL move_camera_start
	_GYM_GROUND_MV_LIFT( 0, 0 )
  _CALL move_camera_wait
	_GYM_GROUND_MV_LIFT( 0, 1 )
  _CALL move_camera_end
	_SE_WAIT()
EVENT_END

/************************************************************/
/*				昇降リフト 右上                     */
/************************************************************/
EVENT_START ev_bg_c05gym0101_lift_01
  $lift_id = 1                 // リフトのIDを代入
	_SE_PLAY( SEQ_SE_FLD_61 )		//スイッチＳＥを再生
	_SE_WAIT()
  _CALL move_camera_start
	_GYM_GROUND_MV_LIFT( 1, 0 )
  _CALL move_camera_wait
	_GYM_GROUND_MV_LIFT( 1, 1 )
  _CALL move_camera_end
	_SE_WAIT()
EVENT_END

/************************************************************/
/*				昇降リフト 左下                     */
/************************************************************/
EVENT_START ev_bg_c05gym0101_lift_02
  $lift_id = 2                 // リフトのIDを代入
	_SE_PLAY( SEQ_SE_FLD_61 )		//スイッチＳＥを再生
	_SE_WAIT()
  _CALL move_camera_start
	_GYM_GROUND_MV_LIFT( 2, 0 )
  _CALL move_camera_wait
	_GYM_GROUND_MV_LIFT( 2, 1 )
  _CALL move_camera_end
	_SE_WAIT()
EVENT_END

/************************************************************/
/*				昇降リフト 右下                     */
/************************************************************/
EVENT_START ev_bg_c05gym0101_lift_03
  $lift_id = 3                 // リフトのIDを代入
	_SE_PLAY( SEQ_SE_FLD_61 )		//スイッチＳＥを再生
	_SE_WAIT()
  _CALL move_camera_start
	_GYM_GROUND_MV_LIFT( 3, 0 )
  _CALL move_camera_wait
	_GYM_GROUND_MV_LIFT( 3, 1 )
  _CALL move_camera_end
	_SE_WAIT()
EVENT_END

/************************************************************/
/*				カメラ操作				*/
/************************************************************/
move_camera_start:
{
  _CAMERA_START()       // カメラ操作開始
  _CAMERA_PURGE()		    // カメラのバインドを解く

  // カメラ操作(リフト別)
  SWITCH $lift_id
  CASE 0 THEN   // 左上
    _CAMERA_MOVE( 10840,0,970752,1114112,811008,1826816,30 )
  CASE 1 THEN   // 右上
    _CAMERA_MOVE( 10840,0,970752,3080192,811008,1826816,30 )
  CASE 2 THEN   // 左下
    _CAMERA_MOVE( 10840,0,970752,1114112,811008,3989504,30 )
    //_CAMERA_MOVE( 10584,0,970752,1114112,741376,4096000,30 )
  CASE 3 THEN   // 右下
    _CAMERA_MOVE( 10840,0,970752,3080192,811008,3989504,30 )
    //_CAMERA_MOVE( 10328,0,970752,3112960,860160,4186112,30 )
  ENDSWITCH
}
_RET

move_camera_wait:
{
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _LAST_KEYWAIT()    // 高さMAXでの待機時間

  // デフォルトカメラに戻す(リフト別)
  // _CAMERA_DEF_MOVEで戻すとちらつくので、座標を直指定
  SWITCH $lift_id
  CASE 0 THEN   // 左上
    _CAMERA_MOVE( 9688,0,970752,1146880,0,1933312,30 )
  CASE 1 THEN   // 右上
    _CAMERA_MOVE( 9688,0,970752,3112960,0,1933312,30 )
  CASE 2 THEN   // 左下
    _CAMERA_MOVE( 9688,0,970752,1146880,0,4096000,30 )
  CASE 3 THEN   // 右下
    _CAMERA_MOVE( 9688,0,970752,3112960,0,4096000,30 )
  ENDSWITCH
}
_RET

move_camera_end:
{
  _CAMERA_WAIT_MOVE()   // カメラ移動待ち
  _CAMERA_BIND()        // カメラバインド
  _CAMERA_END()         // カメラ操作終了
}
_RET

/************************************************************/
/*				接続リフト 至ジムエントランス				*/
/************************************************************/
EVENT_START	ev_bg_c05gym0101_exitlift_00u

	//リフト起動
	_SE_PLAY( SEQ_SE_FLD_61 )		//スイッチＳＥを再生
	_SE_WAIT()
		
	//マップブラックアウト
	_MAP_FADE_BLACK_OUT_SLOW()

	//リフトを上昇させる（1 = エントランスに移動アニメ）
	_GYM_GROUND_EXIT_LIFT( 1 )

	_MAP_FADE_END_CHECK()

	//スクリプト予約 マップチェンジ後にエントランスのリフト上昇演出を起動
	_RESERVE_SCRIPT( SCRID_RESERVE_C05GYM0201_GYMBACK_01 )

	//マップチェンジ
	_MAP_CHANGE_NO_FADE( ZONE_ID_C05GYM0201, 8, 0, 4, DIR_UP )

EVENT_END

/************************************************************/
/*				帰り道ショートカットPOSイベント				*/
/************************************************************/
EVENT_START ev_pos_c05gym0101_shortcut
{

  // ヤーコン、主人公の前にくる
  _OBJ_ANIME( C05GYM0101_LEADER5_01, anm_tr_down )
  _OBJ_ANIME_WAIT()

  // 主人公上向く
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_u )
  _OBJ_ANIME_WAIT()

  //【仮】
  // メッセージがないので、仮あて
  // こいよ、送ってってやる
  _BALLOONWIN_OBJMSG( msg_c05gym0101_leader_01, C05GYM0101_LEADER5_01 )
  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()

  //==========エントランスへ移動============//
  //==========ヤーコンリフト専用============//
  {
    //マップブラックアウト
    _MAP_FADE_BLACK_OUT_SLOW()

    //リフトを上昇させる（2 = ヤーコンリフト専用）
    _GYM_GROUND_EXIT_LIFT( 2 )

    _MAP_FADE_END_CHECK()

    // 暗転中にリフトが移動したと思わせる
    _SE_PLAY( SEQ_SE_FLD_59 )		//リフト移動ＳＥを再生
    _TIME_WAIT( 40 )
    _SE_STOP()
    _SE_PLAY( SEQ_SE_FLD_59 )		//リフト移動ＳＥを再生
    _TIME_WAIT( 40 )
    _SE_STOP()
    _SE_PLAY( SEQ_SE_FLD_59 )		//リフト移動ＳＥを再生

    //スクリプト予約 マップチェンジ後にエントランスのリフト上昇演出を起動
    _RESERVE_SCRIPT( SCRID_RESERVE_C05GYM0201_GYMBACK_02 )

    //マップチェンジ
    _MAP_CHANGE_NO_FADE( ZONE_ID_C05GYM0201, 7, 0, 5, DIR_UP )
  }

  //=====================================
  //このPOSの起動をさせなくする
  $WK_SCENE_C05GYM0101_SHORTCUT = 2
  //=====================================

}
EVENT_END

//--------------------------------------------------------------
//	1歩進む
//--------------------------------------------------------------
_ANIME_LABEL	anm_tr_down
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	上向く
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0


