_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE_NO_SE,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*		C05GYM0101	WORKMAN2A	トレーナー戦				  */
/**************************************************************/
EVENT_START		ev_c05gym0101_workman2a_01
	
	//まだ戦っていない場合
	IF $WK_SCENE_C05GYM0101_TRBTL_01 == 0 THEN
		_TALK_OBJ_START()
		
		//視線曲再生・！マーク表示
		_OBJ_ANIME( C05GYM0101_WORKMAN2A_01, anm_common_gyoe )
		_TRAINER_BGM_SET( TRID_WORKER2_29 )
		_OBJ_ANIME_WAIT()
		
		//メッセージ表示
		_BALLOONWIN_TALKOBJ_MSG( msg_c05gym0101_workman2a_01 )
		_MSGWIN_CLOSE()
		
		//戦闘処理
		_TRAINER_BTL_SET( TRID_WORKER2_29, 0 )
	
		//結果チェック
		_TRAINER_LOSE_CHECK( SCWK_ANSWER )
		IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()
		ELSE
			_TRAINER_LOSE()
		ENDIF
	
		//メッセージ表示
		_BALLOONWIN_TALKOBJ_MSG( msg_c05gym0101_workman2a_02 )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()
	
		//========================================/
		
		//POSイベント終了
		$WK_SCENE_C05GYM0101_TRBTL_01 = 1
		
		//========================================/
	
	
	//既に戦っている場合
	ELSE
	
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05gym0101_workman2a_02 )
	
	ENDIF
	

EVENT_END

EVENT_START		ev_pos_c05gym0101_trbtl_01
{
	//視線曲再生・！マーク表示
	_OBJ_ANIME( C05GYM0101_WORKMAN2A_01, anm_common_gyoe )
	_TRAINER_BGM_SET( TRID_WORKER2_29 )
	_OBJ_ANIME_WAIT()

	//プレイヤーの座標を見て移動分岐
	DEFINE_LOCAL	LWK_POSX
	DEFINE_LOCAL	LWK_POSZ
	_PLAYER_POS_GET( LWK_POSX, LWK_POSZ )
	
	//４グリッド分
	SWITCH $LWK_POSX
	CASE 5 THEN
		_OBJ_ANIME( C05GYM0101_WORKMAN2A_01, anm_dir_r )
	CASE 6 THEN
		_OBJ_ANIME( C05GYM0101_WORKMAN2A_01, anm_walk_r )
	CASE 7 THEN
		_OBJ_ANIME( C05GYM0101_WORKMAN2A_01, anm_walk_r_2 )
	CASE 8 THEN
		_OBJ_ANIME( C05GYM0101_WORKMAN2A_01, anm_walk_r_3 )
	DEFAULT	//例外処理
		_OBJ_ANIME( C05GYM0101_WORKMAN2A_01, anm_staystep_u )
	ENDSWITCH
	_OBJ_ANIME_WAIT()

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_l )
	_OBJ_ANIME_WAIT()

	//メッセージ表示
	_BALLOONWIN_OBJMSG( msg_c05gym0101_workman2a_01 , C05GYM0101_WORKMAN2A_01 )
	_MSGWIN_CLOSE()
	
	//戦闘処理
	_TRAINER_BTL_SET( TRID_WORKER2_29, 0 )

	//結果チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
		_TRAINER_WIN()
	ELSE
		_TRAINER_LOSE()
	ENDIF

	//メッセージ表示
	_BALLOONWIN_OBJMSG( msg_c05gym0101_workman2a_02 , C05GYM0101_WORKMAN2A_01 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()

	//========================================/
	
	//POSイベント終了
	$WK_SCENE_C05GYM0101_TRBTL_01 = 1
	
	//========================================/
}
EVENT_END

