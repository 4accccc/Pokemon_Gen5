  _ANIME_DATA	AC_WALK_D_8F,3
  _ANIME_DATA	ACMD_END,0
  
//=============================================================
//ショップカウンター 変動ショップ
//=============================================================
EVENT_START ev_c12pc0101_shop
  _TALK_OBJ_START()
  _SHOP_CALL()
EVENT_END

