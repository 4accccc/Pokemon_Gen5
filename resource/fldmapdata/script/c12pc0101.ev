/*		C12PC0101	MIDDLEMAN2								  */
/**************************************************************/
EVENT_START		ev_c12pc0101_middleman2_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12pc0101_middleman2_02 )
EVENT_END
