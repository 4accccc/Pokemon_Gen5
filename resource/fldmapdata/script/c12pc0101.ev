  .text

  .include  "scr_seq_def.h"
  .include  "msg_c12pc0101.h"
  .include  "c12pc0101.h"
  
  //@author Mizuguchi_Mai（案内イベント・ショップ等配置担当）
  //@author	suginaka_katsunori	//性格NPC配置・演出調整・スクリプト修正

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_c12pc0101_shop
_EVENT_DATA    ev_c12pc0101_fix_shop
_EVENT_DATA    ev_reserve_c12pc0101_pcguide_01
_EVENT_DATA		ev_c12pc0101_woman1_01
_EVENT_DATA		ev_c12pc0101_middleman2_01
_EVENT_DATA    ev_init_c12pc0101
_EVENT_DATA_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c12pc0101

  //イベント進行で配置を分岐
  IF $WK_SCENE_C12_WHITE_MEET == 5 && FLAG_OFF( FV_PC_OMOIDELINK ) THEN
    _OBJ_POS_CHANGE( C12PC0101_BREEDERM_01, 1, 0, 12, DIR_DOWN )
  ENDIF

INIT_EVENT_END

//=============================================================
// ポケモンセンターガイドイベント
//=============================================================
EVENT_START ev_reserve_c12pc0101_pcguide_01

  //ベル：あんないします
	_BALLOONWIN_OBJMSG_POS( msg_c12pc0101_white_01 , C12PC0101_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公・ベル受付前へ
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 7, 12, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME( C12PC0101_SWBELL_01, anm_pcguide_bell_info )
	_OBJ_ANIME_WAIT()
	
	//アニメ：ベル、受付を見る
	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_staystep_u )
	_OBJ_ANIME_WAIT()
	
	//ベル：ポケモンセンターは
	_BALLOONWIN_OBJMSG_POS( msg_c12pc0101_white_02 , C12PC0101_SWBELL_01 , POS_DEFAULT )
	_MSGWIN_CLOSE()

	//受付員：せっかくだから
	_BALLOONWIN_OBJMSG_POS( msg_c12pc0101_pcwoman1_01 , C12PC0101_PCWOMAN , POS_DEFAULT )
	_MSGWIN_CLOSE()

	_PLAYER_REQUEST( FIELD_PLAYER_REQBIT_PC_AZUKE )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_hero_azuke )
	_OBJ_ANIME_WAIT()

	//預け後に通常絵に戻す
	_PLAYER_REQUEST( FIELD_PLAYER_REQBIT_MOVE_FORM_TO_DRAW_FORM )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_hero_azuke_wait )
	_OBJ_ANIME_WAIT()
    
	_CALL sub_heal_kaifuku_anime     //回復アニメ呼び出し
	_TEMOTI_POKEMON_KAIFUKU()        //手持ちポケモン回復処理
    _ADD_RECORD( RECID_RECOVERY_PC, 1 ) //レコード加算
    
	_PLAYER_REQUEST( FIELD_PLAYER_REQBIT_PC_AZUKE )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_hero_uketori )
	_OBJ_ANIME_WAIT()
	_PLAYER_REQUEST( FIELD_PLAYER_REQBIT_MOVE_FORM_TO_DRAW_FORM )

	//アニメ：主人公・ベル、パソコン方面を見る
	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_staystep_l )
	_TIME_WAIT( 8 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	_OBJ_ANIME_WAIT()
  
	//ベル：つぎはあっち
	_BALLOONWIN_OBJMSG_POS( msg_c12pc0101_white_03 , C12PC0101_SWBELL_01 , POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アニメ：主人公・ベルPC前へ
	_OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 4, 12, FORCE_TYPE_NPC, 8, DIR_LR)
	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_pcguide_bell_pc )
	_OBJ_ANIME_WAIT()
	
	//アニメ：ベル、PCを見る
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_staystep_u )
	_OBJ_ANIME_WAIT()

	//ベル：これはパソコン
	_BALLOONWIN_OBJMSG_POS( msg_c12pc0101_white_04 , C12PC0101_SWBELL_01 , POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アニメ：主人公・ベル、ショップ方面を見る
	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_staystep_d )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
	_OBJ_ANIME_WAIT()
	
	//ベル：つぎはあっち
	_BALLOONWIN_OBJMSG_POS( msg_c12pc0101_white_05 , C12PC0101_SWBELL_01 , POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アニメ：主人公・ベルショップ前へ
	_OBJ_ANIME_AUTO( C12PC0101_SWBELL_01, 4, 13, FORCE_TYPE_NPC, 8, DIR_UD)
	_OBJ_ANIME_WAIT()

	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_staystep_u )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_d )
	_OBJ_ANIME_WAIT()

	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_walk_r )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_d )
	_OBJ_ANIME_WAIT()
	
	_OBJ_ANIME_AUTO( C12PC0101_SWBELL_01, 9, 17, FORCE_TYPE_NPC, 8, DIR_LR)
	_TIME_WAIT( 4 )
	_OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 9, 16, FORCE_TYPE_NPC, 8, DIR_LR)
	_OBJ_ANIME_WAIT()
	
	//アニメ：ベル、ショップを見る
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_staystep_r )
	_OBJ_ANIME_WAIT()
	
	//ベル：ここはショップ
	_BALLOONWIN_OBJMSG_POS( msg_c12pc0101_white_06 , C12PC0101_SWBELL_01 , POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//アニメ：主人公・ベル、向き合う
	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_staystep_u )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
	_OBJ_ANIME_WAIT()
	
	//ベル：プレゼント
	_PLAYER_NAME( 0 ) //プレイヤー名を反映
	_BALLOONWIN_OBJMSG_MF( msg_c12pc0101_white_07, msg_c12pc0101_white_08, C12PC0101_SWBELL_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//モンスターボール入手処理
	_ITEM_EVENT_KEYWAIT(ITEM_MONSUTAABOORU, 10)
	
	//ベル：つぎは
	_BALLOONWIN_OBJMSG_POS( msg_c12pc0101_white_09 , C12PC0101_SWBELL_01 , POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ベル退場
	_OBJ_ANIME( C12PC0101_SWBELL_01, anm_pcguide_bell_bye )
	_OBJ_ANIME_WAIT()
	
	//階段SE再生
	_SE_PLAY( SEQ_SE_KAIDAN )

	//ベル動作モデル非表示
	_OBJ_DEL(C12PC0101_SWBELL_01)
  	
  	_SE_WAIT()
	//==================================//
  
	//ゾーンBGM変更フラグをリセット
	_FLAG_RESET( SYS_FLAG_BGM_C12PC0101_GUIDE)
	
	//==================================//
  
	//フィールド通常曲に戻す
	_BGM_NOW_MAP_RECOVER()
  
	//==================================//
	
	//C12のSCENE_CHANGE起動
	$WK_SCENE_C12_WHITE_MEET = 6
	
	//C12PC0101のベルを非表示
	_FLAG_SET( FV_C12PC0101_SWBELL )
	
	//C12のママと妹を表示
	_FLAG_RESET( FV_C12_SWRIVAL_SISTER )
	_FLAG_RESET( FV_C12_SWMAMA )

	//==================================//
	
EVENT_END

