/**************************************************************/
//サブルーチン：回復アニメ
/**************************************************************/
sub_heal_kaifuku_anime:
{
  DEFINE_LOCAL  POKEMON_COUNT

  _OBJ_ANIME( C12PC0101_PCWOMAN, anm_heal_p01_turn_up )
  _OBJ_ANIME_WAIT()

  _GET_PARTY_POKE_COUNT( POKEMON_COUNT, POKECOUNT_MODE_NOT_EGG )
  _POKECEN_RECOVER_ANIME( POKEMON_COUNT )

  _OBJ_ANIME( C12PC0101_PCWOMAN, anm_heal_p01_turn_down )
  _OBJ_ANIME_WAIT()
_RET
}

//--------------------------------------------------------------------
//  左を向く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_heal_p01_turn_up
  _ANIME_DATA  AC_DIR_U,1
  _ANIME_DATA  ACMD_END,0

//--------------------------------------------------------------------
//  下を向く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_heal_p01_turn_down
  _ANIME_DATA  AC_DIR_D,1
  _ANIME_DATA  ACMD_END,0

/**************************************************************/
/*		C12PC0101	WOMAN1									  */
/**************************************************************/
EVENT_START		ev_c12pc0101_woman1_01
_TALK_OBJ_START()

DEFINE_LOCAL	LWK_FRONT
DEFINE_LOCAL	LWK_SEIKAKU

//手持ちの先頭ポケモン位置取得
_GET_PARTY_FRONT_POKEMON( LWK_FRONT, POKECOUNT_MODE_BATTLE_ENABLE )

//先頭ポケモンの名前と性格取得
_GET_PARTY_POKE_PARAM( LWK_SEIKAKU, LWK_FRONT, SCR_POKEPARA_SEIKAKU )

//主人公の名前格納
_PLAYER_NAME(0)
_TEMOTI_MONS_NAME( 1, LWK_FRONT )
_SEIKAKU_NAME( 2, LWK_SEIKAKU )

//あら？
_BALLOONWIN_TALKOBJ_MSG( msg_c12pc0101_woman1_01 )

//せいかくは
_BALLOONWIN_TALKOBJ_MSG( msg_c12pc0101_woman1_02 )
_LAST_KEYWAIT()
_MSGWIN_CLOSE()

EVENT_END

