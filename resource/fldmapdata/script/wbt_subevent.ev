//======================================================================
//                wbt_subevent.ev
//
//    スクリプトファイル：wbt_subevent用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_wbt_subevent.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_wbt_subevent_leader1
_EVENT_DATA   ev_wbt_subevent_leader2
_EVENT_DATA   ev_wbt_subevent_leader3
_EVENT_DATA   ev_wbt_subevent_sunglasses
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_wbt_subevent:
//  _END

/**************************************************************/
//  決勝での対戦相手
/**************************************************************/
EVENT_START ev_wbt_subevent_leader1
  _TALK_OBJ_START()
  _WBT_GET_LOBBY_TRAINER_ID( SCR_WBT_LOBBY_OBJ_1, SCWK_ANSWER )
  _CALL   ev_wbt_leader_main
EVENT_END

/**************************************************************/
//  二回戦での対戦相手
/**************************************************************/
EVENT_START ev_wbt_subevent_leader2
  _TALK_OBJ_START()
  _WBT_GET_LOBBY_TRAINER_ID( SCR_WBT_LOBBY_OBJ_2, SCWK_ANSWER )
  _CALL   ev_wbt_leader_main
EVENT_END

/**************************************************************/
//  一回戦での対戦相手
/**************************************************************/
EVENT_START ev_wbt_subevent_leader3
  _TALK_OBJ_START()
  _WBT_GET_LOBBY_TRAINER_ID( SCR_WBT_LOBBY_OBJ_3, SCWK_ANSWER )
  _CALL   ev_wbt_leader_main
EVENT_END


ev_wbt_leader_main:
  _BALLOONWIN_TALKOBJ_MSG( SCWK_ANSWER )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  _RET

/**************************************************************/
/**************************************************************/
DEFINE_LOCAL  LWK_LOOP
DEFINE_LOCAL  LWK_TOTAL
DEFINE_LOCAL  LWK_SELECT_POS

EVENT_START ev_wbt_subevent_sunglasses
  _TALK_OBJ_START()

  //ホドモエトーナメント優勝回数をチェック
  _WBT_GET_VICTORY_COUNT( SCR_WBT_CUP_HODOMOE, POKETYPE_NULL, SCWK_ANSWER )
  IF $SCWK_ANSWER == 0 THEN
    //０回なのでまだ一度もジムリーダーと戦っていない
    _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_04 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE
    _CALL ev_sunglasses_main
  ENDIF

EVENT_END

ev_sunglasses_main:
  _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_01 )
  _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, TRUE, LWK_SELECT_POS )
  _CALL sub_count_issyu
  IF $LWK_TOTAL != 0 THEN
    _BMPMENU_MAKE_LIST( msg_wbt_subev_area_01, msg_wbt_subev_area_01 )
  ENDIF
  _CALL sub_count_kanto
  IF $LWK_TOTAL != 0 THEN
    _BMPMENU_MAKE_LIST( msg_wbt_subev_area_02, msg_wbt_subev_area_02 )
  ENDIF
  _CALL sub_count_jouto
  IF $LWK_TOTAL != 0 THEN
    _BMPMENU_MAKE_LIST( msg_wbt_subev_area_03, msg_wbt_subev_area_03 )
  ENDIF
  _CALL sub_count_houen
  IF $LWK_TOTAL != 0 THEN
    _BMPMENU_MAKE_LIST( msg_wbt_subev_area_04, msg_wbt_subev_area_04 )
  ENDIF
  _CALL sub_count_sinou
  IF $LWK_TOTAL != 0 THEN
    _BMPMENU_MAKE_LIST( msg_wbt_subev_area_05, msg_wbt_subev_area_05 )
  ENDIF
  _BMPMENU_MAKE_LIST( msg_wbt_subev_cancel, msg_wbt_subev_cancel )
  _BMPMENU_START()

  SWITCH $LWK_SELECT_POS
  CASE msg_wbt_subev_area_01 THEN
    _CALL sub_menu_issyu
  CASE msg_wbt_subev_area_02 THEN
    _CALL sub_menu_kanto
  CASE msg_wbt_subev_area_03 THEN
    _CALL sub_menu_jouto
  CASE msg_wbt_subev_area_04 THEN
    _CALL sub_menu_houen
  CASE msg_wbt_subev_area_05 THEN
    _CALL sub_menu_sinou
  ENDSWITCH

  _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_03 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

  _RET



sub_menu_issyu:
  $LWK_LOOP = TRUE

  WHILE $LWK_LOOP == TRUE
    _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_02 )
    _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, TRUE, LWK_SELECT_POS )
    _WBT_GET_TRAINER_FLAG(  0, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_issyu_01, msg_wbt_subev_issyu_01 )
