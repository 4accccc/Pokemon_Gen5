sub_menu_sinou:
  $LWK_LOOP = TRUE
  WHILE $LWK_LOOP == TRUE
    _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_02 )
    _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, TRUE, LWK_SELECT_POS )
    _WBT_GET_TRAINER_FLAG( 45, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_sinou_01, msg_wbt_subev_sinou_01 )
    ENDIF
    _WBT_GET_TRAINER_FLAG( 46, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_sinou_02, msg_wbt_subev_sinou_02 )
    ENDIF
    _WBT_GET_TRAINER_FLAG( 47, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_sinou_03, msg_wbt_subev_sinou_03 )
    ENDIF
    _WBT_GET_TRAINER_FLAG( 48, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_sinou_04, msg_wbt_subev_sinou_04 )
    ENDIF
    _WBT_GET_TRAINER_FLAG( 49, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_sinou_05, msg_wbt_subev_sinou_05 )
    ENDIF
    _WBT_GET_TRAINER_FLAG( 50, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_sinou_06, msg_wbt_subev_sinou_06 )
    ENDIF
    _WBT_GET_TRAINER_FLAG( 51, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_sinou_07, msg_wbt_subev_sinou_07 )
    ENDIF
    _WBT_GET_TRAINER_FLAG( 52, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_sinou_08, msg_wbt_subev_sinou_08 )
    ENDIF
    _WBT_GET_TRAINER_FLAG( 14, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _BMPMENU_MAKE_LIST( msg_wbt_subev_sinou_00, msg_wbt_subev_sinou_00 )
    ENDIF
    _BMPMENU_MAKE_LIST( msg_wbt_subev_cancel, msg_wbt_subev_cancel )
    _BMPMENU_START()
    SWITCH $LWK_SELECT_POS
    CASE msg_wbt_subev_sinou_01 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_info_46 )
    CASE msg_wbt_subev_sinou_02 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_info_47 )
    CASE msg_wbt_subev_sinou_03 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_info_48 )
    CASE msg_wbt_subev_sinou_04 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_info_49 )
    CASE msg_wbt_subev_sinou_05 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_info_50 )
    CASE msg_wbt_subev_sinou_06 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_info_51 )
    CASE msg_wbt_subev_sinou_07 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_info_52 )
    CASE msg_wbt_subev_sinou_08 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_info_53 )
    CASE msg_wbt_subev_sinou_00 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_wbt_subev_sunglasses_info_19 )
    DEFAULT
      $LWK_LOOP = FALSE
    ENDSWITCH
  ENDWHILE
  _RET


