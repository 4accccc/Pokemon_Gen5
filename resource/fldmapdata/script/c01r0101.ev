//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_c01r0101_bigman_01
_EVENT_DATA   ev_c01r0101_woman1_01
_EVENT_DATA   ev_c01r0101_boy3_01
_EVENT_DATA_END


/**************************************************************/
/*  太った青年：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_c01r0101_bigman_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c01r0101_bigman_01 )
EVENT_END

/**************************************************************/
/*  女性：話しかけ                                            */
/**************************************************************/
EVENT_START   ev_c01r0101_woman1_01

  _TALK_OBJ_START()

  //ラティアス（ラティオス）イベント前
  IF FLAG_OFF( FE_D01R0101_RATI2_MEET_01 ) THEN

    //女性：ちかごろ　ゆめのあとちで
    _BALLOONWIN_TALKOBJ_MSG( msg_c01r0101_woman1_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE

    //女性：ゆめのあとちに……（バージョンでセリフが異なる）
    _BALLOONWIN_OBJMSG_WB( msg_c01r0101_woman1_02w, msg_c01r0101_woman1_02b, C01R0101_WOMAN1_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

/**************************************************************/
/*  男の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c01r0101_boy3_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c01r0101_boy3_01 )
EVENT_END


