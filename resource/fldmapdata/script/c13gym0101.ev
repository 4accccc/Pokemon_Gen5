
//======================================================================
//                c13gym0101.ev
//
//    スクリプトファイル：c13gym0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c13gym0101.h"
  .include  "c13gym0101.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c13gym0101
_EVENT_DATA    ev_init_c13gym0101
_EVENT_DATA    ev_pos_c13gym0101_guide    // ガイドPOSイベント
_EVENT_DATA    ev_c13gym0101_danpei_01    // ガイドスクリプトイベント
_EVENT_DATA_END

//------------------------------注意--------------------------------//
// ローカルワークを使用しています。
// 
// LOCALWORK0⇒ドラムISS
// LOCALWORK1⇒ギターISS
//------------------------------------------------------------------/

/************************************************************/
/*					ジムギミック初期化						*/
/*          ZONE_CHANGE_LABEL             */
/************************************************************/
INIT_EVENT_START  ev_zone_c13gym0101

  // ISSフラグ制御
  // LOCALWORK0とLOCALWORK1を
  // プログラムで参照し、ISSスイッチをOFFにするか決めている
  // LOCALWORKを1にすると、それに対応したISSスイッチがOFFになる
  // ※ここを編集するときは、ev_zone_c13gym0102も同じ様に編集する

	//バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_02 )

	IF $SCWK_TEMP0 == 0 THEN
    // ジムクリア前

    // ジムトレーナー1
    IF FLAG_ON(FE_C13GYM_TRBTL1) THEN
      $LOCALWORK0 = 1
    ENDIF

    // ジムトレーナー2
    IF FLAG_ON(FE_C13GYM_TRBTL2) THEN
      $LOCALWORK1 = 1
    ENDIF

  ELSE
    // ジムクリア後
    // ISSは全てリセット
		$LOCALWORK0 = 0
		$LOCALWORK1 = 0
  ENDIF

  // イベントがらみ
  // ホミカが消えているときは、ISS全てリセット
  IF FLAG_ON(FV_C13GYM0102_SWLEADER2) THEN
		$LOCALWORK0 = 1
		$LOCALWORK1 = 1
		$LOCALWORK2 = 1
  ENDIF

INIT_EVENT_END

/************************************************************/
/*					ジムギミック初期化						*/
/*          FIELD_INIT_LABEL              */
/************************************************************/
INIT_EVENT_START  ev_init_c13gym0101

INIT_EVENT_END

/**************************************************************/
/*            ガイドPOSイベント                               */
/**************************************************************/
EVENT_START   ev_pos_c13gym0101_guide
{
  // POSイベント起動
  IF $WK_SCENE_C13GYM0101_GUIDE == 0 THEN
    DEFINE_LOCAL	LWK_HERO_X
    DEFINE_LOCAL	LWK_HERO_Z

    // ガイドのX座標を自機に合わせる
    {
      //自機の位置取得
      _PLAYER_POS_GET( LWK_HERO_X,LWK_HERO_Z )

      // ガイドを自機の左隣歩かせる
      SWITCH $LWK_HERO_X
      CASE 8 THEN   // 右向くだけ
        _OBJ_ANIME( C13GYM0101_DANPEI_01, anm_dir_r )
		    _OBJ_ANIME_WAIT()
      CASE 9 THEN   // 右1歩歩く
        _OBJ_ANIME( C13GYM0101_DANPEI_01, anm_dir_r_1 )
		    _OBJ_ANIME_WAIT()
      CASE 10 THEN   // 右2歩歩く
        _OBJ_ANIME( C13GYM0101_DANPEI_01, anm_dir_r_2 )
		    _OBJ_ANIME_WAIT()
      DEFAULT       // 右向くだけ
        _OBJ_ANIME( C13GYM0101_DANPEI_01, anm_dir_r )
		    _OBJ_ANIME_WAIT()
      ENDSWITCH
    }

    //アイテム入手フラグで分岐
		IF FLAG_OFF( FE_C13GYM_ITEM ) THEN
      // おいしいみず入手イベント
      _BALLOONWIN_OBJMSG( msg_c13gym0101_glasses_01, C13GYM0101_DANPEI_01 )
      _BALLOONWIN_CLOSE()
      _ITEM_EVENT_KEYWAIT( ITEM_OISIIMIZU, 1 )

      _FLAG_SET( FE_C13GYM_ITEM )			//アイテム入手フラグをセット
		ENDIF

    // 元の位置に戻る
    {
      SWITCH $LWK_HERO_X
      CASE 8 THEN   // 下向くだけ
        _OBJ_ANIME( C13GYM0101_DANPEI_01, anm_dir_d )
        _OBJ_ANIME_WAIT()
      CASE 9 THEN   // 左1歩歩き下向く
        _OBJ_ANIME( C13GYM0101_DANPEI_01, anm_dir_d_1 )
        _OBJ_ANIME_WAIT()
      CASE 10 THEN   // 左2歩歩き下向く
        _OBJ_ANIME( C13GYM0101_DANPEI_01, anm_dir_d_2 )
        _OBJ_ANIME_WAIT()
      CASE 8 THEN   // 下向くだけ
        _OBJ_ANIME( C13GYM0101_DANPEI_01, anm_dir_d )
        _OBJ_ANIME_WAIT()
      ENDSWITCH
    }

    //=====================================
    //このPOSの起動をさせなくする
		$WK_SCENE_C13GYM0101_GUIDE = 1
    //=====================================
  ENDIF
}
EVENT_END

//--------------------------------------------------------------
//	右向く
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	右1歩き
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_r_1
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	右2歩き
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_r_2
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	下向く
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	左1歩歩き下向く
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_d_1
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0
//--------------------------------------------------------------
//	左2歩歩き下向く
//--------------------------------------------------------------
_ANIME_LABEL	anm_dir_d_2
	_ANIME_DATA	AC_WALK_L_8F,2
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0


/************************************************************/
/*				サングラスのスクリプトイベント				*/
/************************************************************/
EVENT_START	ev_c13gym0101_danpei_01

		_TALK_OBJ_START()
		
		//バッジフラグ取得
		_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_02 )

		//バッジフラグで分岐
		IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前の処理
			
			//メッセージのみ
			_BALLOONWIN_TALKOBJ_MSG( msg_c13gym0101_glasses_02 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()

		ELSE
			//バッジ入手後の処理

			//その かがやく ジムバッジは
			_BALLOONWIN_TALKOBJ_MSG( msg_c13gym0101_glasses_03 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()

		ENDIF

EVENT_END

