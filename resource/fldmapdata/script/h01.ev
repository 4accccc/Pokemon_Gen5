
//======================================================================
//                h01.ev
//
//    スクリプトファイル：h01用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_h01.h"
  .include  "h01.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori //スクリプト修正

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_h01_middleman1_01
_EVENT_DATA   ev_h01_girl2_01
_EVENT_DATA   ev_h01_trainerm_01
_EVENT_DATA   ev_h01_backpackerw_01
_EVENT_DATA   ev_h01_man3_01
_EVENT_DATA_END

//買い物用ワーク
DEFINE_LOCAL  LWK_ITEM_BUY
DEFINE_LOCAL  LWK_GOLD_CHK
DEFINE_LOCAL  LWK_BAG_CHK

//------------------------------注意--------------------------------//
//                                                                  //
//  おいしい水おじさんイベントに LOCALWORK0 を使用しています。      //
//  同マップ内の使用を禁止します。                                  //
//                                                                  //
//------------------------------------------------------------------//


/**************************************************************/
/*  おじさん：話しかけ（おいしい水を高値で売ってくる）        */
/**************************************************************/
EVENT_START   ev_h01_middleman1_01

  _TALK_OBJ_START()

  //おじさん：どーも　すいませーん▼
  _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_01, H01_MIDDLEMAN1_01, POS_DOWN )

  //所持金の表示
  _GOLD_WIN_OPEN( MENU_X1, MENU_Y1 )

  //おいしい水を300円で買う？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN    //はい

    //買い処理へ
    _CALL ev_item_buy

  ELSE    //いいえ

    //金額ウィンドウを消す
    _GOLD_WIN_CLOSE()

    //おじさん：ええ　わかってます
    _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_03, H01_MIDDLEMAN1_01, POS_DOWN )

    //乱数で0～4幅で次の台詞を決める
    _GET_RND( LOCALWORK0, 5 )

    IF $LOCALWORK0 == 0 THEN

      //おじさん：つまが　おたかい　ブランドものの
      _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_04, H01_MIDDLEMAN1_01, POS_DOWN )

    ELSIF $LOCALWORK0 == 1 THEN

      //おじさん：むすめが　トレーナー　なんですけどね▼
      _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_05, H01_MIDDLEMAN1_01, POS_DOWN )

    ELSIF $LOCALWORK0 == 2 THEN

      //おじさん：むすこ　ふうふ　からの
      _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_06, H01_MIDDLEMAN1_01, POS_DOWN )

    ELSIF $LOCALWORK0 == 3 THEN

      //おじさん：かわいい　まごに　おもちゃを
      _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_07, H01_MIDDLEMAN1_01, POS_DOWN )

    ELSIF $LOCALWORK0 == 4 THEN

      //おじさん：とくに　なにが　あるって
      _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_08, H01_MIDDLEMAN1_01, POS_DOWN )

    ENDIF

    //おじさん：だから　ここは
    _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_09, H01_MIDDLEMAN1_01, POS_DOWN )

    //所持金の表示
    _GOLD_WIN_OPEN( MENU_X1, MENU_Y1 )

    //おいしい水を300円で買う？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN    //はい

      //買い処理へ
      _CALL ev_item_buy

    ELSE    //いいえ

      //金額ウィンドウを消す
      _GOLD_WIN_CLOSE()

      //おじさん：そうですか……▼
      _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_10, H01_MIDDLEMAN1_01, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

EVENT_END


//買い処理
ev_item_buy:

  //バッグ空きチェック
  _ADD_ITEM_CHK( ITEM_OISIIMIZU, 1, LWK_BAG_CHK )
  //金額チェック
  _CHECK_GOLD( LWK_GOLD_CHK, 300 )

  //お金が足りない
  IF $LWK_GOLD_CHK == 0 THEN
    _GOLD_WIN_CLOSE()

    //おじさん：あ　あなた……　３００円……
    _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_11, H01_MIDDLEMAN1_01, POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //バッグがいっぱい
  ELSIF $LWK_BAG_CHK == 0 THEN
    _GOLD_WIN_CLOSE()

    //おじさん：あ　あなた……　これいじょう
    _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_12, H01_MIDDLEMAN1_01, POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //購入条件は満たしている
  ELSE

    //レジ音再生
    _SE_PLAY( SEQ_SE_SYS_22 )
    _SUBTRACT_GOLD( 300 )
    _GOLD_WIN_UPDATE()
    _SE_WAIT()

    //おじさん：ありがとう　ございます！▼
    _BALLOONWIN_OBJMSG_POS( msg_h01_middleman1_02, H01_MIDDLEMAN1_01, POS_DOWN )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //金額ウィンドウを消す
    _GOLD_WIN_CLOSE()

    //アイテム（おいしいみず）入手
    _ITEM_EVENT_SUCCESS_NOWAIT( ITEM_OISIIMIZU, 1 )

  ENDIF

_RET


/**************************************************************/
/*  女の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_h01_girl2_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h01_girl2_01 )
EVENT_END

/**************************************************************/
/*  エリート♂：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_h01_trainerm_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h01_trainerm_01 )
EVENT_END

/**************************************************************/
/*  バックパッカー♀：話しかけ                                */
/**************************************************************/
EVENT_START   ev_h01_backpackerw_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h01_backpackerw_01 )
EVENT_END

/**************************************************************/
/*  太った兄さん：話しかけ（橋マニアイベント）                */
/**************************************************************/
EVENT_START   ev_h01_man3_01

  _TALK_OBJ_START()

  //イベント起動前
  IF $WK_SCENE_BRIDGE_MANIA_01 == 0 THEN

    //太った兄さん：のどが　かわいた……▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h01_bridge_01 )

    //アイテム「おいしいみず」をあげる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //かばんの中の「おいしいみず」を減らす
      _SUB_ITEM( ITEM_OISIIMIZU, 1, SCWK_ANSWER )

      //おいしいみずがある
      IF $SCWK_ANSWER == TRUE THEN

        _MSGWIN_CLOSE()

        //SE再生
        _SE_PLAY( SEQ_SE_ARDEMO_01 )
        _SE_WAIT()

        //太った兄さん：げんき　でてきたー！　ありがとう▼
        _BALLOONWIN_TALKOBJ_MSG( msg_h01_bridge_02 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

		DEFINE_LOCAL	LWK_INDEX
		DEFINE_LOCAL	LWK_FRONT
		DEFINE_LOCAL	LWK_SIDE


		//レール座標の取得
		_GET_PLAYER_RAIL_LOC( LWK_INDEX, LWK_FRONT, LWK_SIDE )

		IF $LWK_FRONT == 1 THEN
			_OBJ_ANIME( H01_MAN3_01, anm_man3_leave1 )
		ELSE
			_OBJ_ANIME( H01_MAN3_01, anm_man3_leave2 )
		ENDIF
		
		_TIME_WAIT( 20 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_ou )
		_OBJ_ANIME_WAIT()

		_OBJ_DEL( H01_MAN3_01 )

        //========================================//
        //イベント進行
        $WK_SCENE_BRIDGE_MANIA_01 = 1
        //スカイアローの橋マニア非表示
        _FLAG_SET( FV_H01_BRIDGE_MANIA_01 )
        //ホドモエの跳ね橋の橋マニア表示
        _FLAG_RESET( FV_H02_BRIDGE_MANIA_01 )
        //========================================//

      //おいしいみずが無い
      ELSE

        //太った兄さん：でも　おいしいみず　ないよね……
        _BALLOONWIN_TALKOBJ_MSG( msg_h01_bridge_03 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //太った兄さん：おいしいみずが　ないと……
      _BALLOONWIN_TALKOBJ_MSG( msg_h01_bridge_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //イベント起動後（おいしいみずを渡した後）
  ELSIF $WK_SCENE_BRIDGE_MANIA_01 == 1 THEN

    //太った兄さん：げんき　でてきたー！　ありがとう▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h01_bridge_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //イベント起動後（全ての橋を走って来た）
  ELSIF $WK_SCENE_BRIDGE_MANIA_01 == 6 THEN

    //太った兄さん：いやー！　イッシュちほうの
    _BALLOONWIN_TALKOBJ_MSG( msg_h01_bridge_05 )

    //バッグ空きチェック
    _ADD_ITEM_CHK( ITEM_MOOMOOMIRUKU, 12, LWK_BAG_CHK )

    //バッグに空きがある
    IF $LWK_BAG_CHK == TRUE THEN

      _MSGWIN_CLOSE()
      //アイテム「モーモーミルク×１２」入手
      _ITEM_EVENT_SUCCESS_KEYWAIT( ITEM_MOOMOOMIRUKU, 12 )

      //========================================//
      //イベント進行
      $WK_SCENE_BRIDGE_MANIA_01 = 7
      //========================================//

    ELSE

      //太った兄さん：って　バッグが　いっぱいだね
      _BALLOONWIN_TALKOBJ_MSG( msg_h01_bridge_06 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //イベント終了後
  ELSIF $WK_SCENE_BRIDGE_MANIA_01 == 7 THEN

    //太った兄さん：いちばん　はしりやすい　はし　は
    _BALLOONWIN_TALKOBJ_MSG( msg_h01_bridge_07 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

 //--------------------------------------------------------------------
//	●橋マニア：退場演出
//--------------------------------------------------------------------
_ANIME_LABEL	anm_man3_leave1
  _ANIME_DATA	AC_STAY_WALK_L_4F,4
  _ANIME_DATA	AC_WALK_L_4F,1
  _ANIME_DATA	AC_WALK_U_4F,8
  _ANIME_DATA	AC_WALK_U_2F,8
  _ANIME_DATA	ACMD_END,0
 
_ANIME_LABEL	anm_man3_leave2
  _ANIME_DATA	AC_STAY_WALK_U_4F,4
  _ANIME_DATA	AC_WALK_U_4F,8
  _ANIME_DATA	AC_WALK_U_2F,8
  _ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_ou
  _ANIME_DATA	AC_DIR_U,1
  _ANIME_DATA	ACMD_END,0