_EVENT_DATA    ev_c14r0101_middleman1_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//																	//
//	技教えじじいに LOCALWORK12～15 を使用ししています。     //
//	わざオススメ人に LOCALWORK11 を使用ししています。     //
//	同マップ内の使用を禁止します。									//
//------------------------------------------------------------------//

/**************************************************************/
/*  わざオススメ：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c14r0101_middleman1_01
{
  //メッセージラベルの値を格納する変数を定義
  DEFINE_LOCAL LCWK_MSGID
  //0～4の乱数を取得
  _GET_RND( LOCALWORK11, 5 )
  //メッセージラベルに乱数を反映
  $LCWK_MSGID = msg_c14r0101_osusume_01
  $LCWK_MSGID += $LOCALWORK11
  
  _EASY_BALLOONWIN_TALKOBJ_MSG( LCWK_MSGID )
}
EVENT_END
