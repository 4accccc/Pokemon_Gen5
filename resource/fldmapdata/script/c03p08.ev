  //==================================//

	//群集の起動
	_CROWD_PEOPLE_START()
	
INIT_EVENT_END

INIT_EVENT_START	ev_recover_c03p08

	//群集の起動

  _CROWD_PEOPLE_START()

INIT_EVENT_END

