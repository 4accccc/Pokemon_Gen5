
//======================================================================
//                d31r0201.ev
//
//    スクリプトファイル：d31r0201用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d31r0201.h"
  //.include  "d31r0201.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_assistantw_01
_EVENT_DATA    ev_espm_01
_EVENT_DATA_END

DEFINE_LOCAL LWK_DUNGEON_STATUS
DEFINE_LOCAL LWK_MSG_ID

/**************************************************************/
/*			D31R0201 	研究員女						                        */
/**************************************************************/
EVENT_START		ev_assistantw_01
{
  _TALK_OBJ_START()
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  IF $LWK_DUNGEON_STATUS <= INFINITY_DUNGEON_AREA_ID_5 THEN
    // 1~5
    $LWK_MSG_ID = msg_d31r0201_assistantw_01
  ELSIF $LWK_DUNGEON_STATUS <= INFINITY_DUNGEON_AREA_ID_10 THEN
    // 6~9
    $LWK_MSG_ID = msg_d31r0201_assistantw_02
  ELSE
    // 10
    $LWK_MSG_ID = msg_d31r0201_assistantw_03
  ENDIF
  
  // メッセージ
  _BALLOONWIN_TALKOBJ_MSG( LWK_MSG_ID )
	
  // 終了
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
	
}
EVENT_END

/**************************************************************/
/*			D31R0201 	サイキッカー男                              */
/**************************************************************/
EVENT_START		ev_espm_01
{
  _TALK_OBJ_START()
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  IF $LWK_DUNGEON_STATUS <= INFINITY_DUNGEON_AREA_ID_5 THEN
    // 1~5
    $LWK_MSG_ID = msg_d31r0201_espm_01
  ELSIF $LWK_DUNGEON_STATUS <= INFINITY_DUNGEON_AREA_ID_10 THEN
    // 6~9
    $LWK_MSG_ID = msg_d31r0201_espm_02
  ELSE
    // 10
    $LWK_MSG_ID = msg_d31r0201_espm_03
  ENDIF
  
  // メッセージ
  _BALLOONWIN_TALKOBJ_MSG( LWK_MSG_ID )
	
  // 終了
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
}
EVENT_END

  
