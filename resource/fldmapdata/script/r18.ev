
//======================================================================
//                r18.ev
//
//    スクリプトファイル：r18用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_r18.h"
  .include  "r18.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori//マキシ・演出調整

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_r18_dpleader5_01
_EVENT_DATA   ev_r18_item_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
DEFINE_LOCAL	LWK_WBTCHK

/**************************************************************/
/*  マキシ：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_r18_dpleader5_01

  _TALK_START_TURN_NOT()

  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
	
  //カメラ操作
  _CAMERA_MOVE( 9688,0,970752,40910848,327759,46628864,30 )	//一番最後の引数は移動にかかるフレーム数
  _CAMERA_WAIT_MOVE()

  //マキシ：リングは　おれの　うみ♪
  _GIZAWIN_OBJMSG_POS( msg_r18_dpleader5_01 , R18_DPLEADER5_01, POS_UP )
  _GIZAWIN_CLOSE()

  _CAMERA_RECV_MOVE(30)
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラのバインドを解く
  _CAMERA_END()

  _PLAYER_DIR_GET(SCWK_ANSWER)
  
  SWITCH $SCWK_ANSWER
  CASE DIR_UP THEN
	_OBJ_ANIME( R18_DPLEADER5_01, anm_dir_d )
  CASE DIR_LEFT THEN
	_OBJ_ANIME( R18_DPLEADER5_01, anm_dir_r )
  ENDSWITCH
  _OBJ_ANIME_WAIT()

  //WBTで勝負したことがあるかｃｈｋ
  _WBT_GET_TRAINER_FLAG( 49, LWK_WBTCHK )

  //WBTで勝負したことがあるか
  IF $LWK_WBTCHK == TRUE THEN

	//マキシ：おお！　おまえか！
	_BALLOONWIN_TALKOBJ_MSG( msg_r18_dpleader5_02 )
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()

  //WBTで勝負したことがない。
  ELSE

	//マキシ：いま　うたっていたのは　おれさま！▼
	_BALLOONWIN_TALKOBJ_MSG( msg_r18_dpleader5_03 )

	//テーマソングを知っている？
	_YES_NO_WIN( SCWK_ANSWER )

	IF $SCWK_ANSWER == SCR_YES THEN   //はい

		//マキシ：そうだぁ！▼
		_BALLOONWIN_TALKOBJ_MSG( msg_r18_dpleader5_04 )
	
	//いいえ
	ELSE

		//マキシ：なんと　しらないのかぁ！！▼
		_BALLOONWIN_TALKOBJ_MSG( msg_r18_dpleader5_05 )

    ENDIF

    //マキシ：ここで　とうとつに
    _BALLOONWIN_TALKOBJ_MSG( msg_r18_dpleader5_06 )
    _MSGWIN_CLOSE()

  ENDIF
  
  _PLAYER_DIR_GET(SCWK_ANSWER)
  
  SWITCH $SCWK_ANSWER
  CASE DIR_LEFT THEN
	_OBJ_ANIME( R18_DPLEADER5_01, anm_common_turn_r )
	_TIME_WAIT( 10 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_doke )
	_OBJ_ANIME_WAIT()
  ENDSWITCH

  _OBJ_ANIME_AUTO( R18_DPLEADER5_01, 632, 711, FORCE_TYPE_NPC, 8, DIR_LR )
  _TIME_WAIT( 10 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
  _TIME_WAIT( 15 )
  //暗転
  _BLACK_OUT_SLOW()

  _DISP_FADE_END_CHECK()
  _OBJ_ANIME_WAIT()
  
  //マキシ削除
  _OBJ_DEL( R18_DPLEADER5_01 )

  //========================================//
  //マキシを非表示に
  _FLAG_SET( FV_R18_DPLEADER5_01 )
  //========================================//

  _TIME_WAIT( 30 )

  //暗転復帰
  _BLACK_IN_SLOW()
  _DISP_FADE_END_CHECK()

EVENT_END

/**************************************************************/
/*  アイテム入手（かざんのおきいし）                          */
/**************************************************************/
EVENT_START   ev_r18_item_01

  _TALK_START_SE_PLAY()

  //モンスターボール非表示
  _OBJ_DEL( R18_ITEM_01 )

  //アイテム（かざんのおきいし）入手
  _ITEM_EVENT_FIELD( ITEM_KAZANNOOKIISI, 1 ) 

  //========================================//
  //モンスターボール非表示
  _FLAG_SET( FV_R18_ITEM_01 )
  //POSイベント進行
  $WK_SCENE_D24_POKE485 = 1
  //========================================//

EVENT_END


//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//主人公：アイテムゲット
//--------------------------------------------------------------------
_ANIME_LABEL  anm_itemget
  _ANIME_DATA AC_HERO_ITEMGET,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：下に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_d
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：上に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_u
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：右に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_r
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0
  
//--------------------------------------------------------------------
//☆共通処理：左に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_l
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL  anm_dir_u
  _ANIME_DATA AC_DIR_U,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_dir_d
  _ANIME_DATA AC_DIR_D,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_dir_l
  _ANIME_DATA AC_DIR_L,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_dir_r
  _ANIME_DATA AC_DIR_R,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆主人公：退く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_doke
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	AC_DIR_PAUSE_ON,1
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_DIR_PAUSE_OFF,1
	_ANIME_DATA	ACMD_END,0