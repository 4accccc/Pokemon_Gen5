  _SHOP_CALL()
EVENT_END

//=============================================================
//ショップカウンター 固定ショップ
//=============================================================
EVENT_START ev_c05pc0101_fix_shop
  _TALK_OBJ_START()
  _FIX_SHOP_CALL( C05_FS )
EVENT_END

/**************************************************************/
/*  女の子：話しかけ（アイテム入手）                          */
/**************************************************************/
EVENT_START   ev_c05pc0101_girl1_01
  _EASY_TALK_ITEM_EVENT( ITEM_GOOZYASUBOORU, 3, FE_C05PC0101_ITEM, msg_c05pc0101_girl1_01, msg_c05pc0101_girl1_02, msg_c05pc0101_girl1_02 )
EVENT_END

/**************************************************************/
/*  おばさん：話しかけ                                        */
/**************************************************************/
