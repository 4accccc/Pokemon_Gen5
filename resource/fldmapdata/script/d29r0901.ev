
//======================================================================
//                d29r0901.ev
//
//    スクリプトファイル：d29r0901用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d29r0901.h"
  .include  "d29r0901.h"
  .include  "d29r0401_def.h"    // SCRID_RESERVE_D29R0401_DOOR_OUT 

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA     ev_zone_d29r0901
_EVENT_DATA     ev_pos_d29r0901_door_in
_EVENT_DATA     ev_reserve_d29r0901_door_out
_EVENT_DATA     ev_bg_d29r0901_monument_01
_EVENT_DATA     ev_bg_d29r0901_monument_02
_EVENT_DATA     ev_d29r0901_rezisteel
_EVENT_DATA_END

/************************************************************/
/*          ZONE_CHANGE_LABEL                               */
/************************************************************/
INIT_EVENT_START  ev_zone_d29r0901

  // 捕獲していたら非表示
  IF FLAG_ON( FE_D29R0401_POKE3_GET_01 ) THEN
    _FLAG_SET( FV_D29R0401_POKE3_01 )
  ELSE
    _FLAG_RESET( FV_D29R0401_POKE3_01 )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/* POS: ドアに入る                                            */
/**************************************************************/
EVENT_START   ev_pos_d29r0901_door_in

  // 主人公出る
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_door_in )

  // 途中でフェード
  _TIME_WAIT(4)

  // ブラックアウトフェード
  _MAP_FADE_BLACK_OUT_SLOW()

  // 一応入れておく
  _OBJ_ANIME_WAIT()
  // フェード終了チェック
  _MAP_FADE_END_CHECK()

	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_D29R0401_DOOR_OUT )

  // マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_D29R0401, 15, 0, 0, DIR_DOWN )

EVENT_END

//------------------------------------------------------------
// アニメ:出口に歩く
//------------------------------------------------------------
_ANIME_LABEL  anm_door_in
  _ANIME_DATA AC_WALK_D_16F,1
  _ANIME_DATA ACMD_END,0


/**************************************************************/
/*  リザーブスクリプト：ドアからでる       */
/**************************************************************/
EVENT_START   ev_reserve_d29r0901_door_out

  // ブラックインフェード
  _MAP_FADE_BLACK_IN_SLOW()

  // 主人公出る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_door_out )
  _OBJ_ANIME_WAIT()

  // フェード終了チェック
  _MAP_FADE_END_CHECK()

EVENT_END

//------------------------------------------------------------
// アニメ:ドアから出る
//------------------------------------------------------------
_ANIME_LABEL  anm_door_out
  _ANIME_DATA AC_WALK_U_16F,2
  _ANIME_DATA ACMD_END,0


/************************************************************/
/*  BGイベント：石版1                                       */
/************************************************************/
EVENT_START   ev_bg_d29r0901_monument_01
  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_d29r0901_monument_01 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()
EVENT_END

/************************************************************/
/*  BGイベント：石版2                                       */
/************************************************************/
EVENT_START   ev_bg_d29r0901_monument_02
  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_d29r0901_monument_02 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()
EVENT_END

/************************************************************/
/*  OBJ：レジスチル                                       */
/************************************************************/
EVENT_START   ev_d29r0901_rezisteel

 // くろがねの　ちからを　かんじさせる
  _SYSWIN_MSG( msg_d29r0901_poke57_01, POS_DOWN )
  _SYSWIN_CLOSE()

  _TALK_OBJ_START()

  // 鳴き声
  _VOICE_PLAY( MONSNO_379, 0 )
  _GIZAPLAINWIN_MSG_POS( msg_d29r0901_poke57_02, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _VOICE_WAIT()
  _GIZAPLAINWIN_CLOSE()

  // 戦闘
  _WILD_BTL_SET_LEGEND( MONSNO_379, 65 ) // レジアイス

  // 勝敗チェック
  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    // 非表示にする
    _FLAG_SET( FV_D29R0401_POKE3_01 )
    _OBJ_DEL( SCWK_TARGET_OBJID )
    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  // 捕獲チェック
  _WILD_RETRY_CHECK( SCWK_ANSWER )

  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN
    //勝利した場合、あるいは逃げた場合
    _SYSWIN_MSG( msg_d29r0901_poke57_03, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()
        
  CASE SCR_WILD_BTL_RET_CAPTURE THEN
    //捕まえた場合
    _FLAG_SET( FE_D29R0401_POKE3_GET_01 )
    
  ENDSWITCH

EVENT_END


