
//======================================================================
//                t03.ev
//
//    スクリプトファイル：t03用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_t03.h"
  .include  "t03.h"
  .include  "t03r0201.h"
  .include  "t03r0201_def.h"

  //@author fujimura_souichirou
  //@author suginaka_katsunori//スクリプト作り直し・演出調整

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_t03
_EVENT_DATA    ev_init_t03
_EVENT_DATA    ev_pos_t03_hakase2_01
_EVENT_DATA    ev_scene_t03_hakase2_01
_EVENT_DATA    ev_pos_t03_swrival_01
_EVENT_DATA    ev_pos_t03_swrival_02
_EVENT_DATA    ev_bg_t03_board_01
_EVENT_DATA    ev_t03_oldwoman1_01
_EVENT_DATA    ev_t03_woman2_01
_EVENT_DATA    ev_t03_boy3_01
_EVENT_DATA    ev_t03_fighterm_01
_EVENT_DATA    ev_t03_ambrella_01
_EVENT_DATA    ev_t03_policeman_01
_EVENT_DATA    ev_t03_poke19_01
_EVENT_DATA    ev_t03_breederm_01
_EVENT_DATA	ev_t03_swrival_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
//時間変数
DEFINE_LOCAL  LWK_TIMEZONE
//ドア変数定義
DEFINE_LOCAL	DOOR_ANIME_ID
//MSGのPOS位置決定
DEFINE_LOCAL	LWK_POSMSG

/************************************************************/
/*  ZONE_CHANGE_SCRIPT                                      */
/************************************************************/
INIT_EVENT_START  ev_zone_t03

  //現在の時間帯を取得
  _GET_TIMEZONE( LWK_TIMEZONE )

  //夜の場合は住人を非表示
  IF $LWK_TIMEZONE == TIMEZONE_NIGHT || $LWK_TIMEZONE == TIMEZONE_MIDNIGHT THEN

    //========================================//
    //住人非表示
    _FLAG_SET( FV_T03_NIGHT_PEOPLE_01 )
    //おばあさん非表示
    _FLAG_SET( FV_T03_OLDWOMAN1_01 )
    //========================================//

  //昼の場合は住人を表示
  ELSE

    //========================================//
    //住人表示
    _FLAG_RESET( FV_T03_NIGHT_PEOPLE_01 )
    //おばあさん表示
    _FLAG_RESET( FV_T03_OLDWOMAN1_01 )
    //========================================//

  ENDIF

  //カゴメタウンのイベントが終わっていない場合はおばあさんは非表示
  IF $WK_SCENE_T03 != 4 THEN
  	_DEBUG_PRINT_WK(2323)
    //おばあさん非表示
    _FLAG_SET( FV_T03_OLDWOMAN1_01 )
  
  ENDIF

  //民家で昔話を聞いた後の場合、ユニットを再配置
  IF $WK_SCENE_T03 == 2 THEN

    //アララギ娘とベル再配置
    _SXY_MOVE_NPC_POS( T03_HAKASE2_01, DIR_DOWN, 655, 0, 170 )
    _SXY_MOVE_NPC_POS( T03_SWBELL_01, DIR_UP, 655, 0, 171 )

  ENDIF

  //ライバルとプラズマ団待機中の場合は、ユニットを再配置
  IF $WK_SCENE_T03_SWRIVAL == 2 THEN
    _SXY_MOVE_NPC_POS( T03_SWRIVAL_01, DIR_LEFT, 647, 0, 186 )
    _SXY_MOVE_NPC_POS( T03_SWSAGE7_01, DIR_RIGHT, 645, 0, 186 )
    _SXY_MOVE_NPC_POS( T03_SWPLAZMAM_02, DIR_RIGHT, 645, 0, 185 )

  ENDIF

INIT_EVENT_END


/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_t03

  //民家で昔話を聞いた後の場合、ユニットを再配置
  IF $WK_SCENE_T03 == 2 THEN

    //アララギ娘とベル再配置
    _OBJ_POS_CHANGE( T03_HAKASE2_01, 655, 0, 170, DIR_DOWN )
    _OBJ_POS_CHANGE( T03_SWBELL_01, 655, 0, 171, DIR_UP )

  ENDIF

  //ライバルとプラズマ団待機中の場合は、ユニットを再配置
  IF $WK_SCENE_T03_SWRIVAL == 2 THEN

    _OBJ_POS_CHANGE( T03_SWRIVAL_01, 647, 0, 186, DIR_LEFT )
    _OBJ_POS_CHANGE( T03_SWSAGE7_01, 645, 0, 186, DIR_RIGHT )
    _OBJ_POS_CHANGE( T03_SWPLAZMAM_02, 645, 0, 185, DIR_RIGHT )

  ENDIF

INIT_EVENT_END


/**************************************************************/
/*  POS：アララギ娘イベント                                   */
/**************************************************************/
EVENT_START   ev_pos_t03_hakase2_01

  //========================================//
  //POSイベント進行
  $WK_SCENE_T03 = 1
  //D24ベルを非表示に
  _FLAG_SET( FV_D24_PAIR_END_BELL_01 )
  //T07博士娘を非表示
  _FLAG_SET( FV_T07_HAKASE2_01 )
  //T03到着フラグセット
  _FLAG_SET(SYS_FLAG_ARRIVE_T03)
  //========================================//

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  //POSイベント起動場所取得

  //POSイベントをマップ上方（付近）で発生させた？
  IF $LCW_POSX == 667 THEN

	//アニメ：アララギ娘、ベル移動（Aパターン）
	_OBJ_ANIME_AUTO( T03_HAKASE2_01, 664, 171, FORCE_TYPE_NPC, 8, DIR_LR )
	_OBJ_ANIME_AUTO( T03_SWBELL_01, 664, 170, FORCE_TYPE_NPC, 8, DIR_LR )
	_OBJ_ANIME_WAIT()
	
	//========================================//
	$LWK_POSMSG = POS_DEFAULT
	//========================================//

  ELSE  //それ以外（マップ下方）

	//アララギ娘、ベル再配置
	_OBJ_POS_CHANGE( T03_HAKASE2_01, 669, 0, 173, DIR_DOWN )
	_OBJ_POS_CHANGE( T03_SWBELL_01, 670, 0, 173, DIR_DOWN )

    //アニメ：アララギ娘、ベル移動（Bパターン）
	_OBJ_ANIME_AUTO( T03_HAKASE2_01, 669, 181, FORCE_TYPE_NPC, 8, DIR_UD )
	_OBJ_ANIME_AUTO( T03_SWBELL_01, 670, 181, FORCE_TYPE_NPC, 8, DIR_UD )
	_OBJ_ANIME_WAIT()
	
	//========================================//
	$LWK_POSMSG = POS_UL
	//========================================//

  ENDIF

  //主人公名代入
  _PLAYER_NAME( 0 )
  //アララギ娘：はーい　主人公！！
  _BALLOONWIN_OBJMSG_POS( msg_t03_hakase2_01, T03_HAKASE2_01, LWK_POSMSG )
  _MSGWIN_CLOSE()



  //POSイベントをマップ上方（付近）で発生させた？
  IF $LCW_POSX == 667 THEN
    
    	//自転車に乗ってるなら歩行状態へ
	_PLAYER_FORM_GET( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_PLAYER_FORM_CYCLE THEN
		_PLAYER_REQUEST( FIELD_PLAYER_REQBIT_NORMAL )
	ENDIF
    
	//アニメ：主人公博士の前へ（Aパターン）
	IF $LCW_POSZ == 171 THEN
		_OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 666, 171, FORCE_TYPE_NPC, 8, DIR_LR )
	ELSE
		_OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 666, 171, FORCE_TYPE_NPC, 8, DIR_LR )
		_OBJ_ANIME_WAIT()
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
	ENDIF

	_OBJ_ANIME_WAIT()

  ELSE  //それ以外（マップ下方）
    
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_gyoe )
    _OBJ_ANIME_WAIT()
    
    	//自転車に乗ってるなら歩行状態へ
	_PLAYER_FORM_GET( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_PLAYER_FORM_CYCLE THEN
		_PLAYER_REQUEST( FIELD_PLAYER_REQBIT_NORMAL )
	ENDIF
    
    //アニメ：主人公博士の前へ（Bパターン）
    IF $LCW_POSX == 669 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
      _OBJ_ANIME_WAIT()
    ELSE
      _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 669, 183, FORCE_TYPE_NPC, 8, DIR_UD )
      _OBJ_ANIME_WAIT()
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
      _OBJ_ANIME_WAIT()
    ENDIF

  ENDIF

  //ベル：おひさしぶり！
  _BALLOONWIN_OBJMSG_POS( msg_t03_swbell_01, T03_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アララギ娘：この　カゴメから
  _BALLOONWIN_OBJMSG_POS( msg_t03_hakase2_02, T03_HAKASE2_01, LWK_POSMSG )
  _MSGWIN_CLOSE()
  
  //POSイベントをマップ上方（付近）で発生させた？
  IF $LCW_POSX == 667 THEN
	//ベル：アララギのほうを向く
	_OBJ_ANIME( T03_SWBELL_01, anm_common_turn_d )
  ELSE  //それ以外（マップ下方）
	//ベル：アララギのほうを向く
	_OBJ_ANIME( T03_SWBELL_01, anm_common_turn_l )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //ベル：どんな　おはなしですかあ？▼
  _BALLOONWIN_OBJMSG_POS( msg_t03_swbell_02, T03_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アララギ娘：いいからいいから！
  _BALLOONWIN_OBJMSG_POS( msg_t03_hakase2_03, T03_HAKASE2_01, LWK_POSMSG )
  _MSGWIN_CLOSE()

  //現在の時間帯を取得
  _GET_TIMEZONE( LWK_TIMEZONE )
  
  //夜の場合はおばあさんがいない
  IF $LWK_TIMEZONE == TIMEZONE_NIGHT || $LWK_TIMEZONE == TIMEZONE_MIDNIGHT THEN
  
  ELSE
    _OBJ_ADD_EX( 652, 170, DIR_DOWN, MMDL_ID_EVENTOBJ_00, OLDWOMAN1, MV_DMY )
  ENDIF


  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  //POSイベントをマップ上方（付近）で発生させた？
  IF $LCW_POSZ == 171 THEN

	//アニメ：アララギ娘、ベル、主人公移動（Aパターン）
    _OBJ_ANIME( T03_HAKASE2_01, anm_hakase2_work_a )
    _OBJ_ANIME( T03_SWBELL_01, anm_swbell_work_a )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_work_a )
    _OBJ_ANIME_WAIT()

  ELSE  //それ以外（マップ下方）

    //アニメ：アララギ娘、ベル、主人公移動（Bパターン）
    _OBJ_ANIME( T03_HAKASE2_01, anm_hakase2_work_b )
    _OBJ_ANIME( T03_SWBELL_01, anm_swbell_work_b )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_work_b )
    _OBJ_ANIME_WAIT()

  ENDIF

  //現在の時間帯を取得
  _GET_TIMEZONE( LWK_TIMEZONE )

  //夜の場合はイベントが変化
  IF $LWK_TIMEZONE == TIMEZONE_NIGHT || $LWK_TIMEZONE == TIMEZONE_MIDNIGHT THEN
    //アララギ娘：ここ　ね！
    _BALLOONWIN_OBJMSG_POS( msg_t03_hakase2_05, T03_HAKASE2_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //アニメ：アララギ娘民家の前へ
    _OBJ_ANIME_AUTO( T03_HAKASE2_01, 652, 170, FORCE_TYPE_NPC, 8, DIR_UD )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( T03_HAKASE2_01, anm_common_turn_u )
    _OBJ_ANIME_WAIT()

    //ドア生成
    _BMODEL_ANIME_CREATE( DOOR_ANIME_ID, SCR_BMID_DOOR, 652, 169 )
    _BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_OPEN )
    _BMODEL_ANIME_WAIT( DOOR_ANIME_ID )

    //アニメ：アララギ娘民家の中へ
    _OBJ_ANIME( T03_HAKASE2_01, anm_walk_u )
    _OBJ_ANIME_WAIT()
    _OBJ_DEL( T03_HAKASE2_01 )
    _SE_PLAY( SEQ_SE_KAIDAN )
    _SE_WAIT()

  //昼の場合
  ELSE
    //おばあさん：カゴメの　むかしばなしを
    _BALLOONWIN_OBJMSG_POS( msg_t03_oldwoman1_01_01, MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //アララギ娘：はい
    _BALLOONWIN_OBJMSG_POS( msg_t03_hakase2_04, T03_HAKASE2_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //おばあさん：そうかそうか
    _BALLOONWIN_OBJMSG_POS( msg_t03_oldwoman1_01_02, MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //アニメ：おばあさん振り向き
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_common_turn_u )
    _OBJ_ANIME_WAIT()

    //ドア生成
    _BMODEL_ANIME_CREATE( DOOR_ANIME_ID, SCR_BMID_DOOR, 652, 169 )
    _BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_OPEN )
    _BMODEL_ANIME_WAIT( DOOR_ANIME_ID )

    //アニメ：おばあさん民家の中へ
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_u )
    _OBJ_ANIME_WAIT()
    _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
    _SE_PLAY( SEQ_SE_KAIDAN ) 
    _SE_WAIT()

    //アニメ：アララギ娘民家の中へ
    _OBJ_ANIME_AUTO( T03_HAKASE2_01, 652, 170, FORCE_TYPE_NPC, 8, DIR_UD )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( T03_HAKASE2_01, anm_walk_u )
    _OBJ_ANIME_WAIT()
    _OBJ_DEL( T03_HAKASE2_01 )
    _SE_PLAY( SEQ_SE_KAIDAN )
    _SE_WAIT()

  ENDIF

  //アニメ：主人公・ベル民家の中へ
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 652, 170, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
  _OBJ_ANIME_WAIT()

  //予約スクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_T03R0201_HAKASE2_01 )

  //========================================//
  //おばあさんを非表示に
  _FLAG_SET( FV_T03_OLDWOMAN1_01 )
  //========================================//

  //民家までジャンプ
  _MAP_CHANGE( ZONE_ID_T03R0201, 6, 9, DIR_UP )

EVENT_END

/************************************************************/
/*  SCENE：博士イベント                                     */
/************************************************************/
EVENT_START   ev_scene_t03_hakase2_01
{

  //========================================//
  //POSイベント進行
  $WK_SCENE_T03 = 3
  //========================================//

  //アニメ：主人公移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 653, 170, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()

  //アララギ娘：じつに　おもしろい
  _BALLOONWIN_OBJMSG_POS( msg_t03_hakase2_06, T03_HAKASE2_01, POS_UP )
  _MSGWIN_CLOSE()

  //ベル：そうですねえ▼
  _BALLOONWIN_OBJMSG_POS( msg_t03_swbell_03, T03_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アララギ娘：そうねベル（バージョンでセリフが異なる）
  _BALLOONWIN_OBJMSG_WB( msg_t03_hakase2_07w, msg_t03_hakase2_07b, T03_HAKASE2_01, POS_UP )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( T03_HAKASE2_01, anm_common_turn_l )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( T03_SWBELL_01, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  //主人公名代入
  _PLAYER_NAME( 0 )
  //アララギ娘：ところで　主人公▼（バージョンでセリフが異なる）
  _BALLOONWIN_OBJMSG_WB( msg_t03_hakase2_08w, msg_t03_hakase2_08b, T03_HAKASE2_01, POS_UP )

  //ゼクロム（またはレシラム）というポケモンを覚えている？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい
    //アララギ娘：ヤマジタウンで　すこし　はなしたわね▼
    _BALLOONWIN_OBJMSG_WB( msg_t03_hakase2_09w, msg_t03_hakase2_09b, T03_HAKASE2_01, POS_UP )
    _MSGWIN_CLOSE()

  ELSE    //いいえ
    //主人公名代入
    _PLAYER_NAME( 0 )
    //アララギ娘：あら　主人公ったら
    _BALLOONWIN_OBJMSG_WB( msg_t03_hakase2_10w, msg_t03_hakase2_10b, T03_HAKASE2_01, POS_UP )
    _MSGWIN_CLOSE()

  ENDIF

  _OBJ_ANIME( T03_SWBELL_01, anm_common_turn_u )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( T03_HAKASE2_01, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //ベル：はかせは　むかしばなしの
  _BALLOONWIN_OBJMSG_POS( msg_t03_swbell_04, T03_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( T03_HAKASE2_01, anm_dir_l )
  _OBJ_ANIME_WAIT()
  _TIME_WAIT( 20 )
  _OBJ_ANIME( T03_HAKASE2_01, anm_common_tenten )
  _OBJ_ANIME_WAIT()
  _TIME_WAIT( 30 )
  
  //アララギ娘：いんせき　ね▼
  _BALLOONWIN_OBJMSG_POS( msg_t03_hakase2_11, T03_HAKASE2_01, POS_UP )
  _MSGWIN_CLOSE()

  //ベル：いんせき……　ですかあ？▼
  _BALLOONWIN_OBJMSG_POS( msg_t03_swbell_05, T03_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( T03_HAKASE2_01, anm_dir_d )
  _OBJ_ANIME_WAIT()

  //アララギ娘：いしから　ふっかつ　したらしいの▼（バージョンでセリフが異なる）
  _BALLOONWIN_OBJMSG_WB( msg_t03_hakase2_12w, msg_t03_hakase2_12b, T03_HAKASE2_01, POS_UP )
  _MSGWIN_CLOSE()

  //ベル：だとしたら　とても
  _BALLOONWIN_OBJMSG_POS( msg_t03_swbell_06, T03_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アララギ娘：そうね……　その　あたりは
  _BALLOONWIN_OBJMSG_POS( msg_t03_hakase2_13, T03_HAKASE2_01, POS_UP )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( T03_SWBELL_01, anm_common_turn_l )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( T03_HAKASE2_01, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  //主人公名代入
  _PLAYER_NAME( 0 )
  //アララギ娘：はなしが　ながくなったわね▼
  _BALLOONWIN_OBJMSG_POS( msg_t03_hakase2_14, T03_HAKASE2_01, POS_UP )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( T03_SWBELL_01, anm_common_turn_u )
  _OBJ_ANIME_WAIT()
  
  //ベル：もちろん　です！▼
  _BALLOONWIN_OBJMSG_POS( msg_t03_swbell_07, T03_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アララギ娘退場
  _OBJ_ANIME( T03_HAKASE2_01, anm_hakase2_back )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( T03_HAKASE2_01 )

  _OBJ_ANIME_AUTO( T03_SWBELL_01, 653, 171, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()

  //アニメ：主人公とベル、向き合う
  _OBJ_ANIME( T03_SWBELL_01, anm_common_turn_u )
  _TIME_WAIT( 3 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //ベル：ソウリュウシティの　シャガさん
  _BALLOONWIN_OBJMSG_POS( msg_t03_swbell_08, T03_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //ベル：博士の向かった方向を見る
  _OBJ_ANIME( T03_SWBELL_01, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //ベル：アララギはかせえ！
  _BALLOONWIN_OBJMSG_POS( msg_t03_swbell_09, T03_SWBELL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //ベル退場
  _OBJ_ANIME( T03_SWBELL_01, anm_swbell_back )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( T03_SWBELL_01 )

  //========================================//
  //アララギ娘、ベルを非表示に
  _FLAG_SET( FV_T03_HAKASE2_01 )
  _FLAG_SET( FV_T03_SWBELL_01 )
  //ローカルライブキャスター・ベル通話状態を変更（ゲームクリアまで）
  _PERSON_STATE_SET_BELL( BELL_STATE_R13 )
  //ローカルライブキャスター・アララギ通話状態を変更（ゲームクリアまで）
  _PERSON_STATE_SET_DOCTOR( DOCTOR_STATE_R13 )
  //========================================//

}
EVENT_END

/************************************************************/
/*	ライバル話しかけ								*/
/************************************************************/
EVENT_START	ev_t03_swrival_01
  _TALK_OBJ_START()
  
  //イベントの進行状況を確認（初見かどうか）
  IF $WK_SCENE_T03_SWRIVAL == 1 THEN
  	_CALL ev_pos_t03_swrivalev_01
  ELSE

	  //ライバル名代入
	  _RIVAL_NAME( 1 )
	  //ライバル：オマエの　ちからを
	  _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_05, T03_SWRIVAL_01, POS_DEFAULT )

	  //戦う準備はいいか？
	  _YES_NO_WIN( SCWK_ANSWER )

	  IF $SCWK_ANSWER == SCR_YES THEN   //はい
		//ライバル：よし
		_BALLOONWIN_OBJMSG_POS( msg_t03_swrival_03, T03_SWRIVAL_01, POS_DEFAULT )
		_MSGWIN_CLOSE()

		//ライバルイベント02へ
		_CALL ev_pos_t03_swrivalev_02

	ELSE    //いいえ
		//ライバル：わかった
		_BALLOONWIN_OBJMSG_POS( msg_t03_swrival_04, T03_SWRIVAL_01, POS_DEFAULT )
		_AB_KEYWAIT_MARK()
		_MSGWIN_CLOSE()

		//アニメ：ライバル向きなおす
		_OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_l )
		_OBJ_ANIME_WAIT()

  	ENDIF

  ENDIF

EVENT_END

/**************************************************************/
/*  POS：ライバルイベント02                                   */
/**************************************************************/
EVENT_START   ev_pos_t03_swrival_02

	//自機座標取得
	_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

	SWITCH $LCW_POSZ
	CASE 185 THEN
	    _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_u )
	    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
	CASE 187 THEN
	    _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_d )
	    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
	ENDSWITCH
	
    _OBJ_ANIME_WAIT()

    //ライバル名代入
    _RIVAL_NAME( 1 )
    //ライバル：オマエの　ちからを
    _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_05, T03_SWRIVAL_01, POS_DEFAULT )

    //戦う準備はいいか？
    _YES_NO_WIN( SCWK_ANSWER )
    
    //========================================//
    //ローカルライブキャスター・ライバル通話状態を変更（カゴメタウンマルチバトル終了まで）
    _PERSON_STATE_SET_RIVAL( RIVAL_STATE_T03_1 )
    //========================================//

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

	//自転車に乗ってるなら歩行状態へ
	_PLAYER_FORM_GET( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_PLAYER_FORM_CYCLE THEN
		_PLAYER_REQUEST( FIELD_PLAYER_REQBIT_NORMAL )
	ENDIF

      //ライバル：よし
      _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_03, T03_SWRIVAL_01, POS_DEFAULT )
      _MSGWIN_CLOSE()

    //ライバルイベント02へ
    _CALL ev_pos_t03_swrivalev_02

    ELSE    //いいえ
      //ライバル：わかった
      _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_04, T03_SWRIVAL_01, POS_DEFAULT )
	 _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      //アニメ：主人公右へ一歩
      _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_l )
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
      _OBJ_ANIME_WAIT()

    ENDIF

EVENT_END

/**************************************************************/
/*  POS：ライバルイベント01                                   */
/**************************************************************/
EVENT_START   ev_pos_t03_swrival_01

  _CALL ev_pos_t03_swrivalev_01

EVENT_END

ev_pos_t03_swrivalev_01:

{

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  //イベントの進行状況を確認（初見かどうか）
  IF $WK_SCENE_T03_SWRIVAL == 1 THEN

    //========================================//
    //POSイベント進行
    $WK_SCENE_T03_SWRIVAL = 2
    //プラズマ団表示
    _FLAG_RESET( FV_T03_SWPLASMAM_01 )
    //========================================//
    _OBJ_ADD( T03_SWSAGE7_01 )
    _OBJ_ADD( T03_SWPLAZMAM_02 )

    //POSイベントを発生させた位置でライバルの動きを制御
    IF $LCW_POSZ == 185  THEN
      //アニメ：ライバル振り向き
      _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_r )
      _OBJ_ANIME_WAIT()

    ELSIF $LCW_POSZ == 186  THEN
      //アニメ：ライバル「！」
      _OBJ_ANIME( T03_SWRIVAL_01, anm_common_gyoe )
      _OBJ_ANIME_WAIT()

      //アニメ：主人公振り向き
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
      _OBJ_ANIME_WAIT()

    ELSE  //それ以外（マップ下方）
      //アニメ：ライバル「！」
      _OBJ_ANIME( T03_SWRIVAL_01, anm_common_gyoe )
      _OBJ_ANIME_WAIT()

      //アニメ：ライバル主人公に隣接
      $LCW_POSZ -= 1
      _OBJ_ANIME_AUTO( T03_SWRIVAL_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
      _OBJ_ANIME_WAIT()

      //アニメ：主人公振り向き
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
      _OBJ_ANIME_WAIT()

    ENDIF

	//自転車に乗ってるなら歩行状態へ
	_PLAYER_FORM_GET( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_PLAYER_FORM_CYCLE THEN
		_PLAYER_REQUEST( FIELD_PLAYER_REQBIT_NORMAL )
	ENDIF

    //ライバル名代入
    _RIVAL_NAME( 1 )
    //ライバル：なんだ
    _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_01, T03_SWRIVAL_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    _START_EVENT_BGM( SEQ_BGM_E_PLASMA )

    //アニメ：ヴィオ、プラズマ団登場
    _OBJ_ANIME( T03_SWSAGE7_01, anm_walk_r_6 )
    _OBJ_ANIME( T03_SWPLAZMAM_02, anm_walk_r_6 )
    _OBJ_ANIME_WAIT()

    _CAMERA_START()		//カメラ操作開始
    _CAMERA_PURGE()		//カメラパージ
    _CAMERA_MOVE(9688,0,970752,42369024,0,12222464, 30)

    //アニメ：主人公、ライバル振り向き
    _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_l )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
    _OBJ_ANIME_WAIT()

    _CAMERA_WAIT_MOVE()	//カメラ移動待ち

    //ヴィオ：やれやれ
    _BALLOONWIN_OBJMSG_POS( msg_t03_sage7_01, T03_SWSAGE7_01, POS_DOWN )
    _MSGWIN_CLOSE()

    //アニメ：ライバル移動
    _OBJ_ANIME_AUTO( T03_SWRIVAL_01, 647, 186, FORCE_TYPE_NPC, 4, DIR_LR )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( T03_SWRIVAL_01, anm_dir_l )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( T03_SWRIVAL_01, anm_swrival_anime )
    _OBJ_ANIME_WAIT()

    //主人公名代入
    _PLAYER_NAME( 0 )
    //ライバル名代入
    _RIVAL_NAME( 1 )
    //ライバル：オマエら　のつごうなんて
    _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_02, T03_SWRIVAL_01, POS_DEFAULT )

    //戦う準備はいいか？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい
      //ライバル：よし
      _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_03, T03_SWRIVAL_01, POS_DEFAULT )
      _MSGWIN_CLOSE()

      _CAMERA_RECV_MOVE(30)	//カメラ復帰移動
      _CAMERA_WAIT_MOVE()	//カメラ移動待ち\
      _CAMERA_BIND()		//カメラバインド
      _CAMERA_END()		//カメラ操作終了

      //ライバルイベント02へ
      _CALL ev_pos_t03_swrivalev_02

    ELSE    //いいえ
      //ライバル：わかった
      _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_04, T03_SWRIVAL_01, POS_DEFAULT )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      _CAMERA_RECV_MOVE(30)	//カメラ復帰移動
      _CAMERA_WAIT_MOVE()	//カメラ移動待ち\
      _CAMERA_BIND()		//カメラバインド
      _CAMERA_END()		//カメラ操作終了

    ENDIF
    
  //イベント起動が２度目以降
  ELSE

	//自機座標取得
	_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

	SWITCH $LCW_POSZ
	CASE 185 THEN
	    _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_u )
	    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
	CASE 187 THEN
	    _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_d )
	    _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
	ENDSWITCH
	
    _OBJ_ANIME_WAIT()

    //ライバル名代入
    _RIVAL_NAME( 1 )
    //ライバル：オマエの　ちからを
    _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_05, T03_SWRIVAL_01, POS_DEFAULT )

    //戦う準備はいいか？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい
      //ライバル：よし
      _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_03, T03_SWRIVAL_01, POS_DEFAULT )
      _MSGWIN_CLOSE()

	 //ライバルイベント02へ
	 _CALL ev_pos_t03_swrival_02

    ELSE    //いいえ
      //ライバル：わかった
      _BALLOONWIN_OBJMSG_POS( msg_t03_swrival_04, T03_SWRIVAL_01, POS_DEFAULT )
	 _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      //アニメ：ライバル向きなおす
      _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_l )
      _OBJ_ANIME_WAIT()

    ENDIF

  ENDIF

_END_EVENT_BGM()

}

_RET

/**************************************************************/
/*  POS：ライバルイベント02                                   */
/**************************************************************/
ev_pos_t03_swrivalev_02:  //ライバルイベント01からのみ起動可能

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  //主人公はライバルの隣にいるか？
  SWITCH $LCW_POSZ
  CASE 186 THEN
    //アニメ：主人公ライバルの隣へ移動
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 647, 185, FORCE_TYPE_MAP, 8, DIR_UD )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_l )
    _OBJ_ANIME_WAIT()
  CASE 187 THEN
    //アニメ：主人公ライバルの隣へ移動
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 648, 185, FORCE_TYPE_MAP, 8, DIR_LR )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_l )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
  ENDSWITCH
  
  IF $LCW_POSZ == 185 THEN
  
    //座標移動が必要ない場合
    IF $LCW_POSX == 650 THEN
    		_OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 647, 185, FORCE_TYPE_MAP, 8, DIR_LR )
    ELSE
    		_OBJ_ANIME( T03_SWRIVAL_01, anm_common_turn_l )
    		_OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_l )
    ENDIF
    _OBJ_ANIME_WAIT()
  
  ENDIF

  //トレーナー戦呼び出し//マルチバトル
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_25, TRID_SWPLAZMAM_35, TRID_SWSAGE3_04 ) 
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_26, TRID_SWPLAZMAM_35, TRID_SWSAGE3_04 ) 
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_MULTI_BTL_SET( TRID_SWRIVAL_27, TRID_SWPLAZMAM_35, TRID_SWSAGE3_04 ) 
  ENDIF

  //結果チェック
  _CALL ev_battle_check

  //勝利時
  //プラズマ団男：ヴィオさまと
  _BALLOONWIN_OBJMSG_POS( msg_t03_swplazmam1_01, T03_SWPLAZMAM_02, POS_UP )
  _MSGWIN_CLOSE()

  //ヴィオ：この　トレーナーども
  _BALLOONWIN_OBJMSG_POS( msg_t03_sage7_02, T03_SWSAGE7_01, POS_DOWN )
  _MSGWIN_CLOSE()

  _TIME_WAIT( 15 )  //暗転前の間
  
  _OBJ_ANIME_AUTO( T03_SWSAGE7_01, 637, 186, FORCE_TYPE_NPC, 4, DIR_LR )
  _TIME_WAIT( 8 )
  _OBJ_ANIME_AUTO( T03_SWPLAZMAM_02, 637, 185, FORCE_TYPE_NPC, 4, DIR_LR )
  _OBJ_ANIME_WAIT()

  //プラズマ団削除
  _OBJ_DEL( T03_SWSAGE7_01 )
  _OBJ_DEL( T03_SWPLAZMAM_02 )

  //========================================//
  //暗転中にヴィオとプラズマ団を非表示
  _FLAG_SET( FV_T03_SWPLASMAM_01 )
  //========================================//

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：まて！
  _GIZAWIN_OBJMSG_POS( msg_t03_swrival_06 , T03_SWRIVAL_01, POS_DEFAULT )
  _GIZAWIN_CLOSE()

  //アニメ：ライバル退場、主人公見送り
  _OBJ_ANIME_AUTO( T03_SWRIVAL_01, 638, 186, FORCE_TYPE_NPC, 4, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( T03_SWRIVAL_01 )

  //========================================//
  //ライバルを非表示
  _FLAG_SET( FV_T03_SWEIVAL_01 )
  //POSイベント進行
  $WK_SCENE_T03_SWRIVAL = 3
  $WK_SCENE_T03 = 4
  //ローカルライブキャスター・ライバル通話状態を変更（C08GYMクリアまで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_T04_2 )
  //========================================//

_RET


ev_battle_check:
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
	/*手持ちが0匹だったら*/
	_GET_PARTY_POKE_COUNT( SCWK_TEMP0, POKECOUNT_MODE_BATTLE_ENABLE )
	IF $SCWK_TEMP0 == 0 THEN
		_TEMOTI_POKEMON_KAIFUKU() /*回復処理*/
	ENDIF

    _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
  ELSE
  
    //========================================//
    //ローカルライブキャスター・ライバル通話状態を変更（全滅時まきもどり）
    _PERSON_STATE_SET_RIVAL( RIVAL_STATE_T03 )
    //========================================//
    
    _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

