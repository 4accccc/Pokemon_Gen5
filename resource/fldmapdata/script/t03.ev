/*  看板01                                                    */
/**************************************************************/
EVENT_START  ev_bg_t03_board_01
  _EASY_BGWIN_MSG( msg_t03_sign1_01, TYPE_TOWN )
EVENT_END

/**************************************************************/
/*  おばあさん：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_t03_oldwoman1_01
{

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  _TALK_OBJ_START()
  //おばあさん：アンタ　もういちど
  _BALLOONWIN_TALKOBJ_MSG( msg_t03_oldwoman1_01 )

  //昔話を聞く？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい
    //おばあさん：カゴメタウンの　うらには
    _BALLOONWIN_TALKOBJ_MSG( msg_t03_oldwoman1_02 )
    _MSGWIN_CLOSE()

    //一度別方向を向いてから
    _OBJ_ANIME( T03_OLDWOMAN1_01, anm_common_turn_r )
    _OBJ_ANIME_WAIT()

    _TIME_WAIT( 60 )  //間

    //主人公へ向きなおす
    IF $LCW_POSX == 670 && $LCW_POSZ == 167 THEN
      _OBJ_ANIME( T03_OLDWOMAN1_01, anm_common_turn_d )
      _OBJ_ANIME_WAIT()
    ELSE
      _OBJ_ANIME( T03_OLDWOMAN1_01, anm_common_turn_l )
      _OBJ_ANIME_WAIT()
    ENDIF

    //おばあさん：しんじるか　どうかは　じゆう　じゃが
    _BALLOONWIN_TALKOBJ_MSG( msg_t03_oldwoman1_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE    //いいえ
    //おばあさん：ああ　そうかいな
    _BALLOONWIN_TALKOBJ_MSG( msg_t03_oldwoman1_04 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

}
EVENT_END

