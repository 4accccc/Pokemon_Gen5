
//======================================================================
//                d27r2001.ev
//
//    スクリプトファイル：d27r2001用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d27r2001.h"
  .include  "d27r2001.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_d27r2001_swplazmaw_01
_EVENT_DATA    ev_bg_d27r2001_bed_01
_EVENT_DATA_END


/**************************************************************/
/*  プラズマ団員：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_d27r2001_swplazmaw_01
  
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r2001_swplazmaw_01 )
  
EVENT_END
/**************************************************************/
/*  BG：回復ベッド                                      */
/**************************************************************/
EVENT_START   ev_bg_d27r2001_bed_01
  
  _TALK_START_SE_PLAY()
  
  //主人公名格納
  _PLAYER_NAME( 0 )
  
  //システム：休んでいきますか？
  _SYSWIN_MSG( msg_d27r2001_bed_01 , POS_DEFAULT )
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    
    //システム：すやすやと
    _SYSWIN_MSG( msg_d27r2001_bed_02 , POS_DEFAULT )
    _SYSWIN_CLOSE()
    
    //暗転して手持ちポケモンを回復
    _BLACK_OUT()
    _DISP_FADE_END_CHECK()
    _TEMOTI_POKEMON_KAIFUKU()		//回復処理
    _ME_PLAY( SEQ_ME_ASA )
    _ME_WAIT()
    _BLACK_IN()
    _DISP_FADE_END_CHECK()
    
    //システム：げんきいっぱいになった
    _SYSWIN_MSG( msg_d27r2001_bed_03 , POS_DEFAULT )
    _LAST_KEYWAIT()
  
  ENDIF
  _SYSWIN_CLOSE()
  
EVENT_END
