
//======================================================================
//                d04r2301.ev
//
//    スクリプトファイル：d04r2301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_d04r2301.h"
  .include  "d04r2301.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_d04r2301_poke13_01
_EVENT_DATA_END


/**************************************************************/
/*  ウルガモス：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
/**************************************************************/
EVENT_START   ev_d04r2301_poke13_01

  _TALK_START_SE_PLAY()

  //ウルガモス：ぷひぃぃぃぃぃぃぃっぷ！
  _VOICE_PLAY( MONSNO_644, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_d04r2801_poke13_01, POS_DOWN )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  //ウルガモスを見たことがあるか（最戦時の場合はレベルが上がった状態に）
  IF FLAG_OFF( FE_D04R2301_POKE13_MEET_01 ) THEN

    //==================================//
    //ウルガモス発見
    _FLAG_SET( FE_D04R2301_POKE13_MEET_01 )
    //==================================//

    // Lv.35 ウルガモス
    _WILD_BTL_SET_LEGEND( MONSNO_644, 35 )

  ELSE

    // Lv.65 ウルガモス
    _WILD_BTL_SET_LEGEND( MONSNO_644, 65 )

  ENDIF

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //ウルガモス非表示
    _FLAG_SET( FV_D04R2301_POKE13_01 )
    //==================================//
    _OBJ_DEL( D04R2301_POKE13_01 )   //ウルガモスを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //ウルガモスを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合

    //==================================//
    //ウルガモスを捕獲した
    _FLAG_SET( FE_D04R2301_POKE13_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

    //システム：ウルガモスは　こうどうの
    _SYSWIN_MSG( msg_d04r2801_poke13_02, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDSWITCH

EVENT_END


