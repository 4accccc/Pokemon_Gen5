//-------------------------------------


/************************************************************/
/*					CALL：ゲーチス戦						*/
/************************************************************/
ev_vs_swsage1_01:

  //【仮】戦闘後暗転状態でメッセージ表示依頼（2011.12.20）
  
  //アニメ：主人公右を向く
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r)
  _OBJ_ANIME_WAIT()

  //ゲーチス：まさか！
  _BALLOONWIN_OBJMSG_WB( msg_d10r0501_swsage01_15w , msg_d10r0501_swsage01_15b , D10R0501_SWSAGE1_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  _PLAYER_NAME( 0 )
  
  //N：！！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_boss_09 , D10R0501_BOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //N専用回復SE再生
  _SE_PLAY(SEQ_SE_FLD_176)
	//回復
	_TEMOTI_POKEMON_KAIFUKU()
	_SE_WAIT()
  
  //トレーナー戦
  _TRAINER_BTL_SET( TRID_SWSAGE1_01, 0 )
  
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    
   //========================================//
    //ゲーチス動作モデル変更
    _FLAG_SET( FV_D10R0401_SWSAGE1_01 )
    _FLAG_RESET( FV_D10R0501_SWSAGE1_02 )
    _FLAG_RESET( FV_D10R0501_WAND_01 )
    //キュラム・キュロム非表示
    _FLAG_SET( FV_D10R0401_POKE_03 )
    //========================================//
      
    //ゲーチス動作モデル削除・生成
    _OBJ_DEL( D10R0501_SWSAGE1_01 )
    _OBJ_ADD( D10R0501_SWSAGE1_02 )
      
    //登場人物位置変更
    _OBJ_POS_CHANGE(MMDL_ID_PLAYER,15,0,16,DIR_RIGHT)
    _OBJ_POS_CHANGE(D10R0501_SWSAGE1_02,17,0,16,DIR_LEFT)
    _OBJ_POS_CHANGE(D10R0501_NPOKE_01,15,0,22,DIR_UP)
    _OBJ_ANIME( D10R0501_BOSS_01 , anm_dir_u)
    _OBJ_ANIME_WAIT()
    
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
  
  //アニメ：ゲーチス後退する
  _OBJ_ANIME( D10R0501_SWSAGE1_02 , anm_swsage1_backstep)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：…どういうことだ？
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_16 , D10R0501_SWSAGE1_02 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチスうろうろ
  _OBJ_ANIME( D10R0501_SWSAGE1_02 , anm_swsage1_lose_walk01)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：みとめるか　ありえるか
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_17 , D10R0501_SWSAGE1_02 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_EV_GIANTHOLE_03 )
  
  //N：あえて　こうよびます
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_boss_06 , D10R0501_BOSS_01 ,POS_DR )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチス・目をそらして
  _OBJ_ANIME( D10R0501_SWSAGE1_02 , anm_staystep_u)
  _OBJ_ANIME_WAIT()
    
  //ゲーチス：だまれ！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_18 , D10R0501_SWSAGE1_02 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //フィールド上にダークトリニティ配置
  _OBJ_ADD_EX( 19, 16, DIR_DOWN, MMDL_ID_EVENTOBJ_00, NINJA, MV_DMY )
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_ninja_coming_01 )
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ：Nさま
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_ninja_01 , MMDL_ID_EVENTOBJ_00 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //N：…うん
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_boss_07 , D10R0501_BOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ダークトリニティ：…はい
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_ninja_02 , MMDL_ID_EVENTOBJ_00 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //ダークトリニティ退場
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_ninja_bye_01 )
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ・ゲーチス動作モデル削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  _OBJ_DEL( D10R0501_SWSAGE1_02 )
  _OBJ_ADD( D10R0501_WAND_01 )
  
  //【仮】主人公移動まで間
  _TIME_WAIT( 16 )
  
  //アニメ：主人公Ｎに隣接
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_to_boss_01)
  _OBJ_ANIME_WAIT()
  
  //N：アリガトウ
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_boss_08 , D10R0501_BOSS_01 ,POS_DR )
  _MSGWIN_CLOSE()
  
  //アニメ：Ｎ下を向く
  _OBJ_ANIME( D10R0501_BOSS_01 , anm_staystep_l)
  _OBJ_ANIME_WAIT()
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //ブラック
  IF $LCWK_VERSION == VERSION_B2 THEN
    _PLAINWIN_MSG_UP( msg_d10r0501_mu_02 )
    _VOICE_PLAY( MONSNO_651, 0 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  ELSE
    _PLAINWIN_MSG_UP( msg_d10r0501_shin_02 )
    _VOICE_PLAY( MONSNO_650, 0 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
  ENDIF
  
  //アニメ：Ｎ上を向く
  _OBJ_ANIME( D10R0501_BOSS_01 , anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //N：～も言ってる
  _BALLOONWIN_OBJMSG_WB( msg_d10r0501_boss_09w , msg_d10r0501_boss_09b , D10R0501_BOSS_01 , POS_DR)
  _MSGWIN_CLOSE()
  
  //アニメ：N下を向く
  _OBJ_ANIME( D10R0501_BOSS_01 , anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //間
  _TIME_WAIT( 30 )
  
  //アニメ：Ｎ上を向く
  _OBJ_ANIME( D10R0501_BOSS_01 , anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  {
  
  //データコンバートチェック
  _DATACONV_IS_EXIST( DATACONV_ID_SYSTEM, LOCALWORK15 )
  
  //データ引継ぎ分岐（参照データ・反映データが仮）
  IF $LOCALWORK15 >= 1 THEN
    //名前代入
    _DATACONV_SET_NAME( 1 ,DATACONV_ID_SYSTEM ) 
    _BALLOONWIN_OBJMSG_POS( msg_d10r0501_boss_11 , D10R0501_BOSS_01 ,POS_DR )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d10r0501_boss_10 , D10R0501_BOSS_01 ,POS_DR )
  ENDIF
  
  }
  
  //_MSGWIN_CLOSE()
  
  //N：ポケモンといることで
  _BALLOONWIN_OBJMSG_WB( msg_d10r0501_boss_12w , msg_d10r0501_boss_12b , D10R0501_BOSS_01 , POS_DR)
  _MSGWIN_CLOSE()
  
  //アニメ：Ｎ一歩前に出る
  _OBJ_ANIME( D10R0501_BOSS_01 , anm_walk_u)
  _OBJ_ANIME_WAIT()
  
  //N：キミ！キミと
  _BALLOONWIN_OBJMSG_WB( msg_d10r0501_boss_13w , msg_d10r0501_boss_13b , D10R0501_BOSS_01 , POS_DR)
  _MSGWIN_CLOSE()
  
  _BLACK_OUT_SLOW()
  
  //アニメ：Ｎ退場
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_to_boss_02)
  _OBJ_ANIME( D10R0501_BOSS_01 , anm_boss_bye)
  _OBJ_ANIME_WAIT()
  
  _DISP_FADE_END_CHECK()
  
  //Ｎ動作モデル削除
  _OBJ_DEL( D10R0501_BOSS_01 )
  //ゼクロム・レシラム動作モデル削除
  _OBJ_DEL( D10R0501_NPOKE_01 )
  
  //主人公Ｎを見送る位置に移動
  _OBJ_POS_CHANGE(MMDL_ID_PLAYER,17,0,18,DIR_LEFT)
  
  _BLACK_IN_SLOW()
  
  _DEMO_GIMMICK_GIANTHOLE_NPOKE_ANM_START(0) // 1：下降 0：上昇
  _TIME_WAIT(10)
  
  _DISP_FADE_END_CHECK()
  
  //アニメ：N退場
  _TIME_WAIT(100)
  
  //=======================================//
  //D10R0501のBGMを元に戻す
  _FLAG_RESET( SYS_FLAG_BGM_D10R0501_VS_GCIS )
  //=======================================//
  
  //BGMを戻すまで余韻
  _TIME_WAIT( 20 )
  
  //BGMを変更
  _BGM_NOW_MAP_RECOVER()
  
  //=======================================//
  //D10R0201に接続するように状態を変更
  _FLAG_RESET( FE_D10_PLAZMA_FRIGATE_01 )
  //D10R0401イベント終了
  $WK_SCENE_D10R0401_SWSAGE1_01 = 3
  //D10プラズマ団員を削除
  _FLAG_SET( FV_D10R0101_SWPLAZMAM_01 )
  _FLAG_SET( FV_D10R0101_SWPLAZMAM_03 )
  _FLAG_SET( FV_D10R0101_SWPLAZMAM_04 )
  _FLAG_SET( FV_D10R0301_SWPLAZMAM_02 )
  _FLAG_SET( FV_D10R0401_SWSAGE1_01 )
  _FLAG_SET( FV_D10R0501_SWSAGE1_02 )
  _FLAG_SET( FV_D10R0401_BOSS_01 )
  _FLAG_SET( FV_D10R0401_POKE_02 )
  
  //ローカルライブキャスター通話状態変更
  _PERSON_STATE_SET_DOCTOR( DOCTOR_STATE_R13 )
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_R23 )
  _PERSON_STATE_SET_CHELEN( CHELEN_STATE_D08 )
  _PERSON_STATE_SET_BELL( BELL_STATE_R13 )
  _PERSON_STATE_SET_MOTHER( MOTHER_STATE_HOME )
  //=======================================//
  
_RET

