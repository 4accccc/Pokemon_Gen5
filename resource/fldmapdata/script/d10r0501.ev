//======================================================================
//                d10r0501.ev
//
//    スクリプトファイル：d10r0501用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d10r0501.h"
  .include  "d10r0501.h"
  
  //@author Mizuguchi_Mai
  // キュレム合体のPOSイベントのみ ichiraku_katsuhiko

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_d10r0501
_EVENT_DATA    ev_init_d10r0501
_EVENT_DATA    ev_pos_d10r0501_swsage1_01
_EVENT_DATA    ev_d10r0501_swsage1_01
_EVENT_DATA    ev_d10r0501_boss_01
_EVENT_DATA    ev_d10r0501_poke10_01
_EVENT_DATA    ev_d10r0501_wand_01
_EVENT_DATA    ev_d10r0501_kusabi_01
_EVENT_DATA    ev_d10r0501_kyuremu_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
// ローカルワークを使用しています。
// 
//------------------------------------------------------------------//

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d10r0501
  
  //バージョンを取得してOBJを変化させる
	_GET_ROM_VERSION( SCWK_ANSWER )
	
	//BlackVERならレシラム
	IF $SCWK_ANSWER == VERSION_B2 THEN
    $OBJCHRWORK0 = POKE10
		$OBJCHRWORK1 = SPPOKE02_ZE
		$OBJCHRWORK2 = SPPOKE05_KUZE
	
	//Whiteならゼクロム
	ELSE
    $OBJCHRWORK0 = POKE10
		$OBJCHRWORK1 = SPPOKE01_RE
		$OBJCHRWORK2 = SPPOKE04_KURE
	ENDIF

INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_d10r0501

  //ゲーチス勝利前だったらゲーチス配置を変更
   IF $WK_SCENE_D10R0401_SWSAGE1_01 == 2 THEN
    _OBJ_POS_CHANGE( D10R0501_SWSAGE1_01, 17, 0, 16, DIR_DOWN)
   ENDIF

INIT_EVENT_END

/************************************************************/
/*					POS：						*/
/************************************************************/
EVENT_START ev_pos_d10r0501_swsage1_01
  
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//カメラ操作　ゲーチスを中心に
	_CAMERA_MOVE( 9688,0,970752,1015808,0,1081344,40 )	//一番最後の引数は移動にかかるフレーム数

  //アニメ：主人公ゲーチスの前へ
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 15, 20, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()

	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
  _TIME_WAIT(10)
  
  //イベント曲再生
  _START_EVENT_BGM( SEQ_BGM_E_NEW_G_CIS )
  
  //ゲーチス：パワースポット
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_01, D10R0501_SWSAGE1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  // ゲーチス：右に移動
  _OBJ_ANIME( D10R0501_SWSAGE1_01, anm_swsage_1 )
  _TIME_WAIT( 60 )
  //SE再生：通常杖つき音
  _SE_PLAY(SEQ_SE_SW_GHETSIS_STICK_01)
  _SE_WAIT()
  _OBJ_ANIME_WAIT()

  //ゲーチス：いでよキュレム！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_02, D10R0501_SWSAGE1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  // キュレム登場カットイン再生
  _CALL_FLD3D_CUTIN( FLDCIID_BLIZZARD )

  // ホワイトアウト
  // ※カットイン内でしている

  // キュレムを表示し、ゲーチスを横に移動
  _OBJ_POS_CHANGE( D10R0501_POKE1_01, 14, 0, 16, DIR_DOWN )
  _OBJ_POS_CHANGE( D10R0501_SWSAGE1_01, 17, 0, 16, DIR_DOWN)

  // ホワイトイン
  _DISP_FADE_START(DISP_FADE_WHITEOUT,16,0,1) // フェード早くする
  _DISP_FADE_END_CHECK()

  //キュレム：ヒュラララ！
  _VOICE_PLAY(MONSNO_653,0)
	_BALLOONWIN_OBJMSG_POS( msg_d10r0501_poke10_01, D10R0501_POKE1_01, POS_UR )
	_VOICE_WAIT()
	_AB_KEYWAIT_MARK()
	_BALLOONWIN_CLOSE()
	
	//ゲーチス：わたしには
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_03, D10R0501_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
 
  // ゲーチス：右に歩いてつえをかかげる
  _OBJ_ANIME( D10R0501_SWSAGE1_01, anm_swsage_2 )
  _TIME_WAIT( 46 )
  //SE再生：通常杖つき音
  _SE_PLAY(SEQ_SE_SW_GHETSIS_STICK_01)
  _SE_WAIT()
  _OBJ_ANIME_WAIT()

  //ゲーチス：キュレム！こごえるせかいです
  _GIZAPLAINWIN_MSG_POS( msg_d10r0501_swsage01_04, POS_UP )
  _GIZAPLAINWIN_CLOSE()
  
  //キュレム：ヒュラッ！
  _VOICE_PLAY(MONSNO_653,0)
  _GIZAPLAINWIN_MSG_POS( msg_d10r0501_poke10_02, POS_DOWN )
	_VOICE_WAIT()
	_AB_KEYWAIT_MARK()
	_GIZAPLAINWIN_CLOSE()
	
	//無音再生
  _START_EVENT_BGM_SILENT( 12 )
	
  // こごえるせかいエフェクト(前半)
  // 全部で500フレーム
  _DEMO_GIMMICK_GIANTHOLE_ANM_START(0)
  _TIME_WAIT(300)

  // 氷の移動と同時にカメラも移動
	_CAMERA_MOVE( 9688,0,970752,1015808,0,1298432,40 )	//一番最後の引数は移動にかかるフレーム数

  _TIME_WAIT(200)
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  // 暗転処理(メモリ開放)
  {
    // 背景を真っ暗なままメッセージを出したいので
    // 専用フェードアウトを使う
    _MAP_FADE_OUT_MSG_ENABLE( MSG_FADE_WHITE, 0 )

    _TIME_WAIT(20)

    // ROMバージョン取得
    _GET_ROM_VERSION( LCWK_VERSION )

    //ブラック：クロスサンダー
    IF $LCWK_VERSION == VERSION_B2 THEN
      _GIZAPLAINWIN_MSG_POS( msg_d10r0501_boss_01b, POS_DOWN )
    //ホワイト：クロスフレイム
    ELSE
      _GIZAPLAINWIN_MSG_POS( msg_d10r0501_boss_01w, POS_DOWN )
    ENDIF
    _TIME_WAIT(60)
    _GIZAPLAINWIN_CLOSE()

      // こごえるせかい(後半)モデル表示
    _DEMO_GIMMICK_GIANTHOLE_DISP(1)

    // 専用フェードイン
    _MAP_FADE_IN_MSG_ENABLE( MSG_FADE_WHITE, 0 )

  }

  // カットイン再生
  IF $LCWK_VERSION == VERSION_B2 THEN
    _CALL_FLD3D_CUTIN( FLDCIID_ZEKUROMU )
  ELSE
    _CALL_FLD3D_CUTIN( FLDCIID_RESIRAMU )
  ENDIF


  // こごえるせかいエフェクト(後半)
  _DEMO_GIMMICK_GIANTHOLE_ANM_START(1)
  _TIME_WAIT(50)

  // カメラ元に戻す
	_CAMERA_MOVE( 9688,0,970752,1015808,0,1081344,20 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

  //アニメ：ゲーチス一歩左へ
  _OBJ_ANIME( D10R0501_SWSAGE1_01, anm_swsage_3 )
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：きましたか　ひとのこころをもたぬ ばけもの Nよ
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_05 , D10R0501_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //========================================//
  //D10R0501 N登場曲に変更
  _FLAG_SET( SYS_FLAG_BGM_D10R0501_N_COME )
  //========================================//
  
  //イベント曲再生
  _BGM_NOW_MAP_RECOVER()

  // ゼクロムonNがおりてくる
  _DEMO_GIMMICK_GIANTHOLE_NPOKE_ANM_START(1) // 1：下降 0：上昇

  _TIME_WAIT(100)
  
  // 暗転処理(メモリ開放)
  {
    _MAP_FADE_BLACK_OUT_SLOW()
    _MAP_FADE_END_CHECK()

    //=======================================
    // カメラ戻し
    _CAMERA_BIND()	//カメラバインド
    _CAMERA_END()		//カメラ操作終了
    // N表示
    _FLAG_RESET( FV_D10R0401_BOSS_01 )
    //ゼクロム・レシラム表示
    _FLAG_RESET( FV_D10R0401_POKE_02 )
    //=======================================

    _MAP_CHANGE_NO_FADE( ZONE_ID_D10R0501, 15, 0, 21, DIR_UP )

    // 暗転中にカメラを変える
	  _CAMERA_START()		//カメラ操作開始
	  _CAMERA_PURGE()		//カメラのバインドを解く
	  _CAMERA_MOVE( 9816,0,970752,1015808,0,1228800, 1 )	//一番最後の引数は移動にかかるフレーム数
	  _CAMERA_WAIT_MOVE()	//カメラ移動待ち

    //=======================================
    // キュレムを表示し、ゲーチスを横に移動
    _OBJ_POS_CHANGE( D10R0501_POKE1_01, 14, 0, 16, DIR_DOWN )
    _OBJ_POS_CHANGE( D10R0501_SWSAGE1_01, 17, 0, 16, DIR_DOWN)
    //_OBJ_POS_CHANGE( MMDL_ID_PLAYER, 15, 0, 20, DIR_UP)
    //=======================================
    // 背面レシゼクのオフセット調整
    IF $LCWK_VERSION == VERSION_B2 THEN
      // ゼクロム
      _DEMO_GIMMICK_GIANTHOLE_OBJ_OFFSET_SET( D10R0501_NPOKE_01, 0, 9 )
    ELSE
      // レシラム
      _DEMO_GIMMICK_GIANTHOLE_OBJ_OFFSET_SET( D10R0501_NPOKE_01, 0, 9 )
    ENDIF
    // Nも少し右にずらす
    _DEMO_GIMMICK_GIANTHOLE_OBJ_OFFSET_SET( D10R0501_BOSS_01, 4, 0 )
    //=======================================

    _MAP_FADE_BLACK_IN()
    _MAP_FADE_END_CHECK()
  }
  
  //========================================//
  //D10R0501 専用曲に変更
  _FLAG_SET( SYS_FLAG_BGM_D10R0501_VS_GCIS )
  _FLAG_RESET( SYS_FLAG_BGM_D10R0501_N_COME )
  //========================================//

  _TIME_WAIT(7)
  
  //N：おしえてくれた
  _BALLOONWIN_OBJMSG_WB( msg_d10r0501_boss_02w, msg_d10r0501_boss_02b, D10R0501_BOSS_01, POS_DOWN)
  _MSGWIN_CLOSE()
  
  //ブラック：ババリバリッシュ！
  IF $LCWK_VERSION == VERSION_B2 THEN
    _GIZAPLAINWIN_MSG_POS( msg_d10r0501_mu_01, POS_DOWN )
    // ゼクロム 鳴き声指定仮
    _VOICE_PLAY( MONSNO_651, 0 )
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
  //ホワイト：ンバーニガガッ！
  ELSE
    _GIZAPLAINWIN_MSG_POS( msg_d10r0501_shin_01, POS_DOWN )
    // レシラム 鳴き声指定仮
    _VOICE_PLAY( MONSNO_650, 0 )
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
  ENDIF
  
  //ゲーチス：すばらしい
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_06, D10R0501_SWSAGE1_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //ゲーチス：とはいえ
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_07, D10R0501_SWSAGE1_01, POS_UP )
  _MSGWIN_CLOSE()
  
  // ゲーチス：一度右を向いて、下に向き直る
  _OBJ_ANIME( D10R0501_SWSAGE1_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  _TIME_WAIT( 30 )
  _OBJ_ANIME( D10R0501_SWSAGE1_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：だがそれも
  _BALLOONWIN_OBJMSG_WB( msg_d10r0501_swsage01_08w, msg_d10r0501_swsage01_08b, D10R0501_SWSAGE1_01, POS_UP)
  _MSGWIN_CLOSE()
  
  //N：そんな数式は
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_boss_03, D10R0501_BOSS_01, POS_DOWN )
  _MSGWIN_CLOSE()
  
  //無音再生
  _START_EVENT_BGM_SILENT( 12 )
  
  //ゲーチス：できますとも！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_09, D10R0501_SWSAGE1_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //BGMを変更
  _BGM_NOW_MAP_RECOVER()
  
  // ゲーチス：つえをかかげる
  _CAMERA_MOVE( 9688,0,970752,1015808,0,983040, 35 )	//一番最後の引数は移動にかかるフレーム数
  _TIME_WAIT(20)
  _OBJ_ANIME( D10R0501_SWSAGE1_01, anm_swsage_4 )
  
  _TIME_WAIT( 23 )
  //SE【仮】再生：強い杖つき音（2011.12.20.鳴らない不具合持つ）
  _SE_PLAY(SEQ_SE_SW_GHETSIS_STICK_01)
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  _OBJ_ANIME_WAIT()
  _SE_WAIT()

  // いでんしのくさびカットイン
  IF $LCWK_VERSION == VERSION_B2 THEN
    _CALL_FLD3D_CUTIN( FLDCIID_KUSABI_B )
  ELSE
    _CALL_FLD3D_CUTIN( FLDCIID_KUSABI_W )
  ENDIF
  
  // デモ呼び出し
  // ※デモを2つに分けたので連続で呼び出している
	//_DEMO_FADEOUT_BLACK_CALL()
	_DEMO_FADEOUT_BLACK_WITH_BGM_CALL()
	
  //=======================================
  // 解放状態のキュレムにする
  _OBJ_DEL( D10R0501_POKE1_01 )
  $OBJCHRWORK0 = SPPOKE03_KU
  _OBJ_ADD( D10R0501_POKE1_01 )
  //ゼクロム・レシラム非表示
  _FLAG_SET( FV_D10R0401_POKE_02 )
  _OBJ_DEL( D10R0501_NPOKE_01 )
  //=======================================

  _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_00 )
	IF $LCWK_VERSION == VERSION_B2 THEN
    _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_B_01 )
  ELSE
    _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_W_01 )
  ENDIF

  // 暗転中にカメラを変える
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,1015808,0,1200128, 1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

  //=======================================
  // キュレムを表示し、ゲーチスを横に移動
  _OBJ_POS_CHANGE( D10R0501_SWSAGE1_01, 17, 0, 16, DIR_DOWN)
  // 解放キュレムはXに+1する
  _OBJ_POS_CHANGE( D10R0501_POKE1_01, 15, 0, 16, DIR_DOWN )
  //Nの向きを左向きに
  _OBJ_POS_CHANGE( D10R0501_BOSS_01, 17, 0, 19, DIR_LEFT )
  //_OBJ_POS_CHANGE( MMDL_ID_PLAYER, 15, 0, 20, DIR_UP)

  // Nをずらしていたのを元にもどす
  _DEMO_GIMMICK_GIANTHOLE_OBJ_OFFSET_SET( D10R0501_BOSS_01, -4, 0 )
  //=======================================

  // ストーン状態のゼクロム(レシラム)を追加
	IF $LCWK_VERSION == VERSION_B2 THEN
    _OBJ_ADD_EX( 15, 18, DIR_DOWN, MMDL_ID_EVENTOBJ_00, BLACKSTONE, MV_DMY )
  ELSE
    _OBJ_ADD_EX( 15, 18, DIR_DOWN, MMDL_ID_EVENTOBJ_00, WHITESTONE, MV_DMY )
  ENDIF
  _DEMO_GIMMICK_GIANTHOLE_OBJ_OFFSET_SET( MMDL_ID_EVENTOBJ_00, 0, 8 )
  //=======================================

  //ストーン状態のゼクロム(レシラム)をふわふわさせる
  _DEMO_GIMMICK_GIANTHOLE_STONE_FLOAT( MMDL_ID_EVENTOBJ_00 )

	//フェードインでフィールドに戻る
	//_DEMO_FADEIN_BLACK_CALL()
	_DEMO_FADEIN_BLACK_WITH_BGM_CALL()
	
	/*
	//BGMを変更
	_START_EVENT_BGM_SILENT(1)
  _BGM_NOW_MAP_RECOVER()
  */
  
  _TIME_WAIT(18)

  //アニメ：Nビックリ
  _OBJ_ANIME( D10R0501_BOSS_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //N：ゼクロム（レシラム）！？
  _BALLOONWIN_OBJMSG_WB( msg_d10r0501_boss_14w, msg_d10r0501_boss_14b, D10R0501_BOSS_01, POS_DOWN)
  _MSGWIN_CLOSE()

  //ゲーチス：きゅうしゅうなさい！
  _BALLOONWIN_OBJMSG_WB( msg_d10r0501_swsage01_10w, msg_d10r0501_swsage01_10b, D10R0501_SWSAGE1_01, POS_UP )
  _MSGWIN_CLOSE()

  // デモ呼び出し
	//_DEMO_FADEOUT_BLACK_CALL()
	_DEMO_FADEOUT_BLACK_WITH_BGM_CALL()

  //========================================//
  // ストーン状態のゼクロム(レシラム)を削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  //キュレム非表示
  _FLAG_SET( FV_D10R0401_POKE_01 )
  _OBJ_DEL( D10R0501_POKE1_01 )
  // カメラ戻し
	_CAMERA_BIND()	//カメラバインド
	_CAMERA_END()		//カメラ操作終了
  //========================================//
  
  // ※デモを2つに分けたので連続で呼び出している
	IF $LCWK_VERSION == VERSION_B2 THEN
    _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_B_02 )
    _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_B_03 )
  ELSE
    _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_W_02 )
    _CALL_3D_DEMO( DEMO3D_ID_KYUREMU_UNION_W_03 )
  ENDIF

  //========================================//
  //キュラム・キュロム表示
  _FLAG_RESET( FV_D10R0401_POKE_03 )
  _OBJ_ADD( D10R0501_POKE2_01 )
  //ゲーチス移動
  _OBJ_POS_CHANGE( D10R0501_SWSAGE1_01, 17, 0, 16, DIR_DOWN)
  //主人公移動
  _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 15, 0, 20, DIR_UP)
  //N上を向く
  _OBJ_POS_CHANGE( D10R0501_BOSS_01, 17, 0, 19, DIR_UP )
  //========================================//

  // 暗転中にカメラを変える
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,1015808,0,1081344, 1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	//フェードインでフィールドに戻る
	//_DEMO_FADEIN_BLACK_CALL()
	_DEMO_FADEIN_BLACK_WITH_BGM_CALL()
	
	/*
	//BGMを変更
	_START_EVENT_BGM_SILENT(1)
  _BGM_NOW_MAP_RECOVER()
  */
  
  //N：まさか
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_boss_04 , D10R0501_BOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ゲーチス：おろかものめ！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_11 , D10R0501_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _TIME_WAIT( 8 )
  
  //ゲーチス：さてトレーナーよ
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_12 , D10R0501_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  // ゲーチス：?マーク表示
  _OBJ_ANIME( D10R0501_SWSAGE1_01, anm_common_hatena )
  _OBJ_ANIME_WAIT()

  //ゲーチス：おや？アナタの
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_13 , D10R0501_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  // ゲーチス：杖をつく
  _OBJ_ANIME( D10R0501_SWSAGE1_01, anm_swsage_4 )
  _TIME_WAIT( 25 )
  //SE再生：通常杖つき音
  _SE_PLAY(SEQ_SE_SW_GHETSIS_STICK_01)
  _SE_WAIT()
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：おや？アナタの
  _BALLOONWIN_OBJMSG_POS( msg_d10r0501_swsage01_15 , D10R0501_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()

  // カメラ戻し
  _CAMERA_DEF_MOVE( 10 )
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
  _CAMERA_BIND()	//カメラバインド
  _CAMERA_END()		//カメラ操作終了

  //=======================================//
  //SCENE_CHANGE無効
  $WK_SCENE_D10R0401_SWSAGE1_01 = 2
  //=======================================//

EVENT_END


