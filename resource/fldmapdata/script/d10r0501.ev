  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d10r0501_swsage01_14 )
EVENT_END

/************************************************************/
/*					話しかけ：Ｎ						*/
/************************************************************/
EVENT_START ev_d10r0501_boss_01

  //WB分岐メッセージ
  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG_WB( msg_d10r0501_boss_05w , msg_d10r0501_boss_05b , D10R0501_BOSS_01 , POS_DEFAULT)
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/************************************************************/
/*					話しかけ：キュレム（キュラム・キュロム）						*/
/************************************************************/
EVENT_START ev_d10r0501_poke10_01
  
  _TALK_START_SE_PLAY()
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  DEFINE_LOCAL  LWK_BATTLE_FLAG

  //キュレム専用、伝説系MSG、レア無し
  $LWK_BATTLE_FLAG = SCR_WILD_BTL_FLAG_KYUREMU
  $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_LEGEND
  $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_NO_RARE
  
  //ブラック
  IF $LCWK_VERSION == VERSION_B2 THEN
    
    //アニメ：芝居
    _OBJ_ANIME( D10R0501_POKE2_01 , anm_legend_hoeru_b )
    _OBJ_ANIME_WAIT()
    
    _GIZAPLAINWIN_MSG_POS( msg_d10r0501_b_01, POS_DOWN )
    //鳴き声指定仮
    _VOICE_PLAY( MONSNO_653, 2 )
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
    
    //戦闘処理（レア・捕獲・逃走なし）
    _WILD_BTL_SET_EX2( MONSNO_653, 55, FORMNO_653_BLACK, LWK_BATTLE_FLAG )
  ELSE
    
    //アニメ：芝居
    _OBJ_ANIME( D10R0501_POKE2_01 , anm_legend_hoeru_w )
    _OBJ_ANIME_WAIT()
    
    _GIZAPLAINWIN_MSG_POS( msg_d10r0501_w_01, POS_DOWN )
    //鳴き声指定仮
    _VOICE_PLAY( MONSNO_653, 1 )
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
    
    //戦闘処理（レア・捕獲・逃走なし）
    _WILD_BTL_SET_EX2( MONSNO_653, 55, FORMNO_653_WHITE, LWK_BATTLE_FLAG )
  ENDIF
{
  
  DEFINE_LOCAL LWK_BTL_RESULT
  DEFINE_LOCAL LWK_ESCAPE_CK
  
  //敗戦チェック
  _WILD_LOSE_CHECK( LWK_BTL_RESULT )
  //合体キュレムに勝利した？
  _WILD_RETRY_CHECK( LWK_ESCAPE_CK )
  
  IF $LWK_BTL_RESULT == SCR_BATTLE_RESULT_WIN THEN
    
      //勝利したケース
      IF $LWK_ESCAPE_CK == SCR_WILD_BTL_RET_WIN THEN
      
      //戦闘後
      //========================================//
      //キュラム・キュロム非表示
      _FLAG_SET( FV_D10R0401_POKE_03 )
      //ゼクロム・レシラム表示
      _FLAG_RESET( FV_D10R0401_POKE_02 )
      //========================================//
        
      //キュラム・キュロム動作モデル削除
      _OBJ_DEL( D10R0501_POKE2_01 )
      //レシラム・ゼクロム動作モデル生成
      _OBJ_ADD( D10R0501_NPOKE_01 )
        
      //登場人物位置変更
      _OBJ_POS_CHANGE(MMDL_ID_PLAYER,15,0,16,DIR_UP)
      _OBJ_POS_CHANGE(D10R0501_NPOKE_01,15,0,22,DIR_UP)
      _OBJ_POS_CHANGE(D10R0501_SWSAGE1_01,17,0,16,DIR_LEFT)
      _OBJ_ANIME( D10R0501_BOSS_01 , anm_dir_u)
      _OBJ_ANIME_WAIT()
    
    //逃げたケース
    ELSIF $LWK_ESCAPE_CK == SCR_WILD_BTL_RET_ESCAPE THEN
      //キュラム・キュロム動作モデル削除
      _OBJ_DEL( D10R0501_POKE2_01 )
      //キュラム・キュロム動作モデル生成（アニメを通常状態に戻すため）
      _OBJ_ADD( D10R0501_POKE2_01 )
      //=======================================//
      //キュラム・キュロム表示
      _FLAG_RESET( FV_D10R0401_POKE_03 )
      //========================================//
      //逃げたケースにおいては再度話しかけで戦闘
      //勝利するまでイベント進行はしない（2011.12.20 水口）
    ENDIF
    
    _WILD_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    //キュラム・キュロム戦後ならキュラム・キュロムを再表示
    IF FLAG_ON( FV_D10R0401_POKE_03 ) THEN
      //=======================================//
      //キュラム・キュロム表示
      _FLAG_RESET( FV_D10R0401_POKE_03 )
      //========================================//
    ENDIF
    
    _WILD_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
  
  //勝利した場合はイベント進行
  SWITCH $LWK_ESCAPE_CK
  CASE SCR_WILD_BTL_RET_WIN THEN      //勝利した場合
    //ゲーチス戦イベント開始
    _CALL ev_vs_swsage1_01
  ENDSWITCH
}
EVENT_END

