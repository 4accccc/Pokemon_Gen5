
//======================================================================
//                d26r0501.ev
//
//    スクリプトファイル：d26r0501用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d26r0501.h"
  .include  "d26r0501.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_zone_d26r0501
_EVENT_DATA		ev_init_d26r0501
_EVENT_DATA		ev_recover_d26r0501
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION

/************************************************************/
/*		CALL：特殊接続                             */
/************************************************************/
ev_exit_change:

  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //バージョンごとに異なる接続を配置
  
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0501_D26R1001_EXIT01, -248, 80, 248 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0501_D26R1001_EXIT02, -248, 80, 232 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0501_D26R1001_EXIT03, -248, 80, 216 )
    _FLAG_SET(FV_D26R0501_ROCK_W)
  //W2
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0501_D26R0401_EXIT01, -248, 80, 248 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0501_D26R0401_EXIT02, -248, 80, 232 )
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D26R0501_D26R0401_EXIT03, -248, 80, 216 )
    _FLAG_SET(FV_D26R0501_ROCK_B)
  ENDIF

_RET

/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
INIT_EVENT_START   ev_zone_d26r0501
  
  _CALL ev_exit_change
 
INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d26r0501

  _CALL ev_exit_change
  
INIT_EVENT_END

/**************************************************************/
/*			INIT_CHANGE_LABEL								  */
/**************************************************************/
INIT_EVENT_START	ev_init_d26r0501

INIT_EVENT_END

