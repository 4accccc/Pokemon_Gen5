//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_d10r0101
_EVENT_DATA    ev_init_d10r0101
_EVENT_DATA    ev_d10r0101_swplazmam_01
_EVENT_DATA    ev_d10r0101_swplazmam_02
_EVENT_DATA    ev_d10r0101_swplazmam_03
_EVENT_DATA    ev_d10r0101_swplazmam_04
_EVENT_DATA    ev_d10r0101_swplazmam_05
_EVENT_DATA    ev_pos_d10r0101_swplazmam_03
_EVENT_DATA   ev_recover_d10r0101
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*		CALL：特殊接続                             */
/************************************************************/
ev_exit_change:

  //進行状態で異なる接続を配置
  
  //プラズマフリゲート起動中（d10r0301)
  IF FLAG_ON( FE_D10_PLAZMA_FRIGATE_01 ) THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D10R0101_D10R0201_EXIT01, 34, 0, 47 )
  //プラズマフリゲートいない（d10r0201)
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D10R0101_D10R0301_EXIT01, 34, 0, 47 )
  ENDIF

_RET

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d10r0101
  
  _CALL ev_exit_change
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d10r0101

  _CALL ev_exit_change
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_d10r0101

//

INIT_EVENT_END

/************************************************************/
/*					POS：元プラズマ団とライバル						*/
/************************************************************/
EVENT_START ev_pos_d10r0101_swplazmam_03

  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )

  //========================================//
  //ライバル・元プラズマ団員表示
  _FLAG_RESET( FV_D10R0101_SWPLAZMAM_03 )
  _FLAG_RESET( FV_D10R0101_SWRIVAL_01 )
  //========================================//
  
  //ライバル・元プラズマ団員動作モデル生成
  _OBJ_ADD( D10R0101_SWRIVAL_01 )
  _OBJ_ADD( D10R0101_SWPLAZMAM_03 )
  
  //アニメ：ライバル隣接
  _OBJ_ANIME_AUTO( D10R0101_SWRIVAL_01 , 61, 36, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT( 40 )
  //アニメ；主人公振り向く
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ライバル：もうきてたのか
  _BALLOONWIN_OBJMSG_POS( msg_d10r0101_swrival_01 , D10R0101_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：元プラズマ団員接近
  _OBJ_ANIME_AUTO( D10R0101_SWPLAZMAM_03 , 60, 41, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT( 8 )
  _OBJ_ANIME( D10R0101_SWPLAZMAM_02 , anm_staystep_d )
  _OBJ_ANIME( D10R0101_SWPLAZMAM_01 , anm_staystep_d )
  _TIME_WAIT( 8*2 )
  _OBJ_ANIME( D10R0101_SWRIVAL_01 , anm_common_hatena )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //元プラズマ団員：おーい！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0101_swplazmam_01 , D10R0101_SWPLAZMAM_03 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //プラズマ団員：いよいよ　だな！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0101_swplazmam1_02 , D10R0101_SWPLAZMAM_02 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME_AUTO( D10R0101_SWPLAZMAM_02 , 61, 45, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_AUTO( D10R0101_SWPLAZMAM_01 , 61, 45, FORCE_TYPE_NPC, 8, DIR_LR)
  _TIME_WAIT( 16 )
  _OBJ_ANIME( D10R0101_SWPLAZMAM_03 , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //プラズマ団（１）（２）動作モデル削除
  _OBJ_DEL( D10R0101_SWPLAZMAM_01 )
  _OBJ_DEL( D10R0101_SWPLAZMAM_02 )
  
  //アニメ：プラズマ団の手前へ
  _OBJ_ANIME_AUTO( D10R0101_SWRIVAL_01 , 61, 39, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT( 4 )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 60, 39, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //アニメ：主人公下を見る
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ライバル：ひとりになったな
  _BALLOONWIN_OBJMSG_POS( msg_d10r0101_swrival_02 , D10R0101_SWRIVAL_01 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団「！」
  _OBJ_ANIME( D10R0101_SWPLAZMAM_03 , anm_common_hatena )
  _OBJ_ANIME_WAIT()
  
  //アニメ：プラズマ団ふりむく
  _OBJ_ANIME( D10R0101_SWPLAZMAM_03 , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //元プラズマ団員：おれです！　おれ！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0101_swplazmam_02 , D10R0101_SWPLAZMAM_03 ,POS_DL )
  _MSGWIN_CLOSE()
  
  //ライバル：なるほどね
  _BALLOONWIN_OBJMSG_POS( msg_d10r0101_swrival_03 , D10R0101_SWRIVAL_01 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //元プラズマ団員：……うう！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0101_swplazmam_03 , D10R0101_SWPLAZMAM_03 ,POS_DL )
  _MSGWIN_CLOSE()
  
  //ライバル：フンッ！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0101_swrival_04 , D10R0101_SWRIVAL_01 ,POS_UR )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  _OBJ_ANIME_AUTO( D10R0101_SWRIVAL_01 , 61, 51, FORCE_TYPE_NPC, 4, DIR_UD)
  _TIME_WAIT( 12 )
  _OBJ_ANIME( D10R0101_SWPLAZMAM_03 , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //アニメ：主人公上を見る
  _OBJ_ANIME( D10R0101_SWPLAZMAM_03 , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //元プラズマ団員：ああいうふうに
  _BALLOONWIN_OBJMSG_POS( msg_d10r0101_swplazmam_04 , D10R0101_SWPLAZMAM_03 ,POS_DL )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME_AUTO( D10R0101_SWPLAZMAM_03 , 60, 51, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //ライバル・元プラズマ団員動作モデル削除
  _OBJ_DEL( D10R0101_SWRIVAL_01 )
  _OBJ_DEL( D10R0101_SWPLAZMAM_03 )

  //========================================//
  //ライバル・見張り（２）非表示
  _FLAG_SET( FV_D10R0101_SWPLAZMAM_01 )
  _FLAG_SET( FV_D10R0101_SWPLAZMAM_03 )
  _FLAG_SET( FV_D10R0101_SWRIVAL_01 )
  //W21チェレン非表示
  _FLAG_SET( FV_W21_SWLEADER1_01 )
  //D10R0101 POS無効
  $WK_SCENE_D10R0101_SWPLAZMA_01 = 2
  //========================================//
EVENT_END

