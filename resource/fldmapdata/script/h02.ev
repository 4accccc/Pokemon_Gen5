
//======================================================================
//                h02.ev
//
//    スクリプトファイル：h02用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_h02.h"
  .include  "h02.h"

  //@author fujimura_souichirou（橋マニアイベント）
  //@author suginaka_katsunori //フェスミッション追加

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_h02_middleman1_01
_EVENT_DATA   ev_h02_woman2_01
_EVENT_DATA   ev_h02_boy2_01
_EVENT_DATA   ev_h02_man3_01
_EVENT_DATA_END


/**************************************************************/
/*  H02 MIDDLEMAN1  一言メッセージ                            */
/**************************************************************/
EVENT_START   ev_h02_middleman1_01

  //初回話しかけであったならば
  IF FLAG_OFF(SYS_FLAG_FES_FEATHER1) THEN
  
    _TALK_OBJ_START()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_h02_middleman_01 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
    //フェスミッションが追加されました
    _SE_PLAY( SEQ_SE_FLD_133 )
    _SYSWIN_MSG( msg_h02_mission_add_02, POS_DEFAULT )
    _SE_WAIT()
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //==================================//
    //初回会話終了
    _FLAG_SET(SYS_FLAG_FES_FEATHER1)
    //==================================//
    
  //2回目以降
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h02_middleman_01 )
  ENDIF

EVENT_END

/**************************************************************/
/*  H02 WOMAN2  一言メッセージ                                */
/**************************************************************/
EVENT_START   ev_h02_woman2_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h02_woman2_01 )
EVENT_END

/**************************************************************/
/*  H02 BOY2  リザードン見せイベント                          */
/**************************************************************/
EVENT_START   ev_h02_boy2_01

  //アイテム入手イベント終了後の場合
  IF FLAG_ON( FE_H02_ITEMGET_01 ) THEN

  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h02_boy2_04 )

  //まだ終わっていない場合
  ELSE

    DEFINE_LOCAL  FIND_POKE
    DEFINE_LOCAL  FIND_POS

    _GET_PARTY_POS( MONSNO_006, FIND_POKE, FIND_POS )

    //リザードンを持っていない場合
    IF $FIND_POKE == 0 THEN

      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_h02_boy2_01 )

    //リザードンを持っている場合
    ELSE

      _TALK_OBJ_START()

      _BALLOONWIN_TALKOBJ_MSG( msg_h02_boy2_02 )
      _MSGWIN_CLOSE()

      _CALL ev_boy2_anime

      _BALLOONWIN_TALKOBJ_MSG( msg_h02_boy2_03 )
      _MSGWIN_CLOSE()

      _ITEM_EVENT_KEYWAIT( ITEM_BANNOUGONA, 1 )

      //========================================/
      //ばんのうごな入手フラグセット
      _FLAG_SET(FE_H02_ITEMGET_01)
      //========================================/

    ENDIF

  ENDIF

EVENT_END

ev_boy2_anime:
{
DEFINE_LOCAL  LWK_DIR

_PLAYER_DIR_GET( LWK_DIR )
SWITCH $LWK_DIR
CASE DIR_UP THEN
  _OBJ_ANIME( H02_BOY2_01, anm_boy2_chk_u )
CASE DIR_RIGHT THEN
  _OBJ_ANIME( H02_BOY2_01, anm_boy2_chk_r )
CASE DIR_LEFT THEN
  _OBJ_ANIME( H02_BOY2_01, anm_boy2_chk_l )
CASE DIR_DOWN THEN
  _OBJ_ANIME( H02_BOY2_01, anm_boy2_chk_d )
ENDSWITCH
_OBJ_ANIME_WAIT()

}
_RET

/**************************************************************/
/*  太った兄さん：話しかけ（橋マニアイベント）                */
/**************************************************************/
EVENT_START   ev_h02_man3_01

  _TALK_OBJ_START()

  //おいしい水を渡す前
  IF $WK_SCENE_BRIDGE_MANIA_01 == 1 THEN

    //太った兄さん：のどが　かわいた……▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h02_bridge_01 )

    //アイテム「おいしいみず」をあげる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //かばんの中の「おいしいみず」を減らす
      _SUB_ITEM( ITEM_OISIIMIZU, 1, SCWK_ANSWER )

      //おいしいみずがある
      IF $SCWK_ANSWER == TRUE THEN

        _MSGWIN_CLOSE()

        //SE再生
        _SE_PLAY( SEQ_SE_ARDEMO_01 )
        _SE_WAIT()

        //太った兄さん：げんき　でてきたー！　ありがとう▼
        _BALLOONWIN_TALKOBJ_MSG( msg_h02_bridge_02 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

		_PLAYER_DIR_GET( SCWK_ANSWER )
		
		IF $SCWK_ANSWER == DIR_RIGHT THEN
			_OBJ_ANIME( H02_MAN3_01, anm_man3_leave1 )
		ELSE
			_OBJ_ANIME( H02_MAN3_01, anm_man3_leave2 )
		ENDIF

		_TIME_WAIT( 20 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_ou )
		_OBJ_ANIME_WAIT()

		_OBJ_DEL( H02_MAN3_01 )

        //========================================//
        //イベント進行
        $WK_SCENE_BRIDGE_MANIA_01 = 2
        //ホドモエの跳ね橋の橋マニア非表示
        _FLAG_SET( FV_H02_BRIDGE_MANIA_01 )
        //シリンダーブリッジの橋マニア表示
        _FLAG_RESET( FV_H03_BRIDGE_MANIA_01 )
        //========================================//

      //おいしいみずが無い
      ELSE

        //太った兄さん：でも　おいしいみず　ないよね……
        _BALLOONWIN_TALKOBJ_MSG( msg_h02_bridge_03 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //太った兄さん：おいしいみずが　ないと……
      _BALLOONWIN_TALKOBJ_MSG( msg_h02_bridge_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //おいしい水を渡した後
  ELSIF $WK_SCENE_BRIDGE_MANIA_01 == 2 THEN

    //太った兄さん：げんき　でてきたー！　ありがとう▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h02_bridge_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

//--------------------------------------------------------------------
//  ◆橋マニア：退場演出
//--------------------------------------------------------------------
_ANIME_LABEL  anm_man3_leave1
  _ANIME_DATA AC_STAY_WALK_U_4F,4
  _ANIME_DATA AC_WALK_U_4F,1
  _ANIME_DATA AC_WALK_L_4F,10
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_man3_leave2
  _ANIME_DATA AC_STAY_WALK_L_4F,4
  _ANIME_DATA AC_WALK_L_4F,10
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL	anm_player_ou
  _ANIME_DATA	AC_DIR_L,1
  _ANIME_DATA	ACMD_END,0

