  .include  "h04r0801.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_h04r0801_scene_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_h04r0801:
//  _END

/************************************************************/
/*		音痴少女	シーンチェンジイベント				*/
/************************************************************/
EVENT_START	ev_h04r0801_scene_01

	//カメラ操作　少女を中心に
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
	_CAMERA_MOVE( 9688,0,970752,622592,0,622592,30 )
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	//ぶべえ
	_SUBWIN_MSG( msg_h04r0801_girl4_01 , 8 , 6 , 1 )
	_TIME_WAIT( 60 )
	_SUBWIN_CLOSE( 1 )

	//ぼぉー
	_SUBWIN_MSG( msg_h04r0801_girl4_02 , 18 , 13 , 2 )
	_TIME_WAIT( 60 )
	_SUBWIN_CLOSE( 2 )

	_TIME_WAIT( 30 )

	_OBJ_ANIME( H04R0801_GIRL4_01, anm_dir_r )
	_OBJ_ANIME_WAIT()
	
	_TIME_WAIT( 30 )
	
	_OBJ_ANIME( H04R0801_GIRL4_01, anm_common_gyoe )
	_OBJ_ANIME_WAIT()

	//キャッ！
	_BALLOONWIN_OBJMSG_POS( msg_h04r0801_girl4_03 ,H04R0801_GIRL4_01 ,POS_UP )
	_MSGWIN_CLOSE()
	
	_CAMERA_RECV_MOVE(20)	//カメラ復帰移動
	
	_OBJ_ANIME_AUTO( H04R0801_GIRL4_01, 14, 9, FORCE_TYPE_NPC, 4, DIR_LR )
	_OBJ_ANIME_WAIT()
	
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	_CAMERA_BIND()		//カメラバインド
	_CAMERA_END()		//カメラ操作終了
	
	_OBJ_ANIME( H04R0801_GIRL4_01, anm_jump_r )
	_OBJ_ANIME_WAIT()

	//れんしゅうちゅうなの
	_BALLOONWIN_OBJMSG_POS( msg_h04r0801_girl4_04 ,H04R0801_GIRL4_01 ,POS_UP )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( H04R0801_GIRL4_01, anm_walk_r )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
	_OBJ_ANIME_WAIT()
	
	_MAP_CHANGE( ZONE_ID_H04, 31, 39, DIR_RIGHT )

	//========================================//
	
	//イベントを見たらフラグセット
	
	//========================================//

EVENT_END

//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場ジャンプ・歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_jump_r
	_ANIME_DATA	AC_STAY_JUMP_R_8F,2
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：ギョエ・？・…
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0