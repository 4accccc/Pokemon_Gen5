
//======================================================================
//                r06r0301.ev
//
//    スクリプトファイル：r06r0301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_r06r0301.h"
  .include  "r06r0301.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_r06r0301_oldman1_01
_EVENT_DATA   ev_r06r0301_babygirl1_01
_EVENT_DATA   ev_r06r0301_middlewoman1_01
_EVENT_DATA_END

//体力の満タンではないポケモンのための変数定義
DEFINE_LOCAL LWK_PARTY_NUM  //手持ちポケモンの数
DEFINE_LOCAL LWK_COUNT_NUM  //WHILE文のカウンタ
DEFINE_LOCAL LWK_RET_HP     //HPチェックの帰り値
DEFINE_LOCAL LWK_RET_PP     //PPチェックの帰り値
DEFINE_LOCAL LWK_DAME       //HPかPPが満タンではないポケモンの数
DEFINE_LOCAL LWK_EGG_CHK    //タマゴであるか


/**************************************************************/
/*  おじいさん：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_r06r0301_oldman1_01

  _TALK_OBJ_START()
  //おじいさん：さて　７ばんどうろの
  _BALLOONWIN_OBJMSG_WB( msg_r06r0301_oldman1a_01, msg_r06r0301_oldman1b_01, R06R0301_OLDMAN1_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  女の子：話しかけ（アイテム入手）                          */
/**************************************************************/
EVENT_START   ev_r06r0301_babygirl1_01

  _TALK_OBJ_START()

  //アイテム入手済みか
  IF FLAG_OFF( FE_R06R0301_ITEMGET_01 ) THEN

    //女の子：これ　あげる！▼（主人公が女の子の場合は口調が変化）
    _BALLOONWIN_OBJMSG_MF( msg_r06r0301_babygirl1_01, msg_r06r0301_babygirl1_02, R06R0301_BABYGIRL1_01, POS_DEFAULT )
    _MSGWIN_CLOSE()

    //アイテム「ひかりのいし」入手
    _ITEM_EVENT_KEYWAIT( ITEM_HIKARINOISI, 1 )
    
    //女の子：なのね　ポケモンの　チラーミィにね
    _BALLOONWIN_TALKOBJ_MSG( msg_r06r0301_babygirl1_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //========================================//
    //アイテム入手フラグセット
    _FLAG_SET( FE_R06R0301_ITEMGET_01 )
    //========================================//

  ELSE

    //女の子：なのね　ポケモンの　チラーミィにね
    _BALLOONWIN_TALKOBJ_MSG( msg_r06r0301_babygirl1_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

/**************************************************************/
/*  おばさん：話しかけ（回復処理）                            */
/**************************************************************/
EVENT_START   ev_r06r0301_middlewoman1_01

  _TALK_OBJ_START()

  //手持ちのポケモンの数を確認（全てのポケモン）
  _GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_TOTAL )

  //手持ちのポケモンの中にHPかPPが満タンではないポケモンがいるか確認（繰り返し処理）
  WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

    //指定POSのポケモンはタマゴか
    _CHECK_TEMOTI_EGG( LWK_EGG_CHK, LWK_COUNT_NUM )
    IF $LWK_EGG_CHK == FALSE THEN

      //指定POSのポケモンのHPを取得
      _CHECK_TEMOTI_HP( LWK_RET_HP, LWK_COUNT_NUM )

      //指定POSのポケモンのPPを取得
      _CHECK_TEMOTI_PP( LWK_RET_PP, LWK_COUNT_NUM )

      //チェックしたポケモンのHP（またはPP）が満タンではないのならば
      IF $LWK_RET_HP == FALSE || $LWK_RET_PP == FALSE THEN
        //HPかPPが満タンではないポケモンの数に＋１
        $LWK_DAME += 1

      ENDIF

    ENDIF

    //カウント
    $LWK_COUNT_NUM += 1

  ENDWHILE

  //手持ちにHPかPPが満タンではないポケモンがいた場合
  IF $LWK_DAME >= 1 THEN

    //おばさん：なんだか　げんきが　ないみたい▼
    _BALLOONWIN_TALKOBJ_MSG( msg_r06r0301_middlewoman_02 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //暗転して手持ちポケモンを回復
    _BLACK_OUT()
    _DISP_FADE_END_CHECK()

    _TEMOTI_POKEMON_KAIFUKU()   //回復処理
    _ME_PLAY( SEQ_ME_ASA )
    _ME_WAIT()

    _BLACK_IN()
    _DISP_FADE_END_CHECK()

    //おばさん：げんき　いっぱいって　かんじね！！
    _BALLOONWIN_TALKOBJ_MSG( msg_r06r0301_middlewoman_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //手持ちのポケモンはHPもPPも満タン
  ELSE

    //おばさん：げんき　いっぱいって　かんじね！！
    _BALLOONWIN_TALKOBJ_MSG( msg_r06r0301_middlewoman_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END




