//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_animal_trail_battle
_EVENT_DATA    ev_animal_trail_normal_item
_EVENT_DATA    ev_animal_trail_hide_item
_EVENT_DATA    ev_init_d34r0101
_EVENT_DATA    ev_animal_trail_back_zone
_EVENT_DATA	   ev_reserve_d34r0101_event_01
_EVENT_DATA    ev_recover_d34r0101
_EVENT_DATA_END

//--------------------------------------------------------------
//               バトル呼び出し
//--------------------------------------------------------------
EVENT_START ev_animal_trail_battle
{
  DEFINE_LOCAL  LWK_LV
  DEFINE_LOCAL  LWK_MONSNO
  DEFINE_LOCAL  LWK_FORMNO
  DEFINE_LOCAL  LWK_IS_FEMALE
  DEFINE_LOCAL  LWK_BATTLE_FLAG
  DEFINE_LOCAL	LWK_LOSE2
 
  _ANIMAL_TRAIL_DATA_GET( SCR_ANIMAL_TRAIL_GET_MONSNO, LWK_MONSNO )
  _ANIMAL_TRAIL_DATA_GET( SCR_ANIMAL_TRAIL_GET_LV, LWK_LV )
  _ANIMAL_TRAIL_DATA_GET( SCR_ANIMAL_TRAIL_GET_FORMNO, LWK_FORMNO )
  _ANIMAL_TRAIL_DATA_GET( SCR_ANIMAL_TRAIL_GET_IS_FEMALE, LWK_IS_FEMALE )

  $LWK_BATTLE_FLAG = SCR_WILD_BTL_FLAG_NONE
  $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_SPEABI3
  $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_NO_RARE
  $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_WILD_TALK
  $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_TRAIL

  // オス・メス判定
  IF $LWK_IS_FEMALE == TRUE THEN
    $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_FEMALE
  ELSE
    $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_MALE
  ENDIF

  //フェスミッションログアクションビーコンリクエスト
  _FMISSION_LOG_ACTION_EX( FMISSION_LOG_ACT_ANIMAL_TRAIL_ENCOUNT, LWK_MONSNO )
	
	//ジャンプ演出(タマゲタケ・モロバレル）
  IF $LWK_MONSNO == MONSNO_580 || $LWK_MONSNO == MONSNO_581 THEN
	  _OBJ_ANIME( SCWK_TARGET_OBJID, anm_jump )
	  _OBJ_ANIME_WAIT()
    $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_MUSHROOM_ENC
  ELSE
    // 振り向き
    _TURN_HERO_SITE()
  ENDIF
	
  // 戦闘開始
  _WILD_BTL_SET_EX2( LWK_MONSNO, LWK_LV, LWK_FORMNO, LWK_BATTLE_FLAG )
  _WILD_LOSE_CHECK( LWK_LOSE2 )

  // 負け
  IF $LWK_LOSE2 == SCR_BATTLE_RESULT_WIN THEN
    // オブジェクトを消す
    _OBJ_DEL(ANIMAL_TRAIL_OBJ)
    // フィールド復帰
    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF
  
  // 配置フラグを落とす設定
  _ANIMAL_TRAIL_RESET_OBJECT()
}
EVENT_END

//--------------------------------------------------------------
//               通常アイテム取得
//--------------------------------------------------------------
EVENT_START ev_animal_trail_normal_item
{
  DEFINE_LOCAL  LWK_ITEMNO
  _ANIMAL_TRAIL_DATA_GET( SCR_ANIMAL_TRAIL_GET_ITEM_ID, LWK_ITEMNO )
  _OBJ_DEL(ANIMAL_TRAIL_OBJ) // アイテムカプセルの削除
  _ITEM_EVENT_FIELD( LWK_ITEMNO ,1 )
  _ANIMAL_TRAIL_RESET_OBJECT()
}
EVENT_END

//--------------------------------------------------------------
//               隠しアイテム取得
//--------------------------------------------------------------
EVENT_START ev_animal_trail_hide_item
{
  DEFINE_LOCAL  LWK_ITEMNO
  _ANIMAL_TRAIL_DATA_GET( SCR_ANIMAL_TRAIL_GET_HIDE_ITEM_ID, LWK_ITEMNO )
  _ITEM_EVENT_FIELD( LWK_ITEMNO ,1 )
  _ANIMAL_TRAIL_RESET_OBJECT()
  _FLAG_RESET( SYS_FLAG_AT_DOWSING_HIT )
  _SXY_MOVE_BG_EVENT(BGID_D32R0101_HIDE_ITEM,15,0,31)

  // レコードを加算：隠しアイテムを入手した
  _ADD_RECORD( RECID_DOWSINGITEM_GET, 1 )
}
EVENT_END

/**************************************************************/
/*            特殊スクリプト：ゾーン切り替えタイミング  　    */
/**************************************************************/
INIT_EVENT_START ev_init_d34r0101
{
  // OBJのセットアップ
  _ANIMAL_TRAIL_SETUP()
  
  // アイテムデータ移動
  _CALL move_hide_item 
}
INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_recover_d34r0101
{
  // アイテムデータ移動
  _CALL move_hide_item  
}
  
INIT_EVENT_END

move_hide_item:
{
  DEFINE_LOCAL  LWK_IS_SET
 
  // アイテムデータ移動
  _ANIMAL_TRAIL_DATA_GET( SCR_ANIMAL_TRAIL_GET_IS_HIDE_ITEM, LWK_IS_SET )
  IF $LWK_IS_SET == TRUE THEN
    _SXY_MOVE_BG_EVENT(BGID_D32R0101_HIDE_ITEM,15,0,12)
  ENDIF
}
_RET

//--------------------------------------------------------------
//               前のゾーンに戻る
//--------------------------------------------------------------
EVENT_START ev_animal_trail_back_zone
{
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_set_down_dir )
  _OBJ_ANIME_WAIT()

  _SE_PLAY( SEQ_SE_KAIDAN )
  _ANIMAL_TRAIL_EXIT_MAP()
}
EVENT_END

//--------------------------------------------------------------------
//ジャンプ演出（共通）-> tamagetake_scr.evと同じにすること
//--------------------------------------------------------------------
_ANIME_LABEL	anm_jump
	_ANIME_DATA	AC_STAY_JUMP_D_8F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
// 下に向く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_set_down_dir
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*		初回ベル　説明リザーブイベント				*/
/************************************************************/
EVENT_START	ev_reserve_d34r0101_event_01

  
  // メダル:かくしあなのたつじん
  _FLAG_SET( MDL_FLAG_ANIMALTRAIL_02 )

  // JA履歴
  _RESORT_SET_RECORD( RESORT_RECORD_ID_ANIMALTRAIL )

  //フィールド上にベル配置
  _OBJ_ADD_EX( 15, 26, DIR_UP, MMDL_ID_EVENTOBJ_00, SWBELL, MV_DMY )

  //上へ移動
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 14, 14, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT( 10 )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 15, 14, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //ベル向きなおす
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //メッセージ：ポケモンだあ
  _BALLOONWIN_OBJMSG_POS( msg_d34r0101_swbell_01,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ベル向きなおす
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_r )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：すごいね！
  _BALLOONWIN_OBJMSG_POS( msg_d34r0101_swbell_02,MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 15, 23, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT( 25 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
EVENT_END


