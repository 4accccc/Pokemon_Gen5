/**************************************************************/
//  スターランクによりファンが出現
/**************************************************************/
sub_pkwd_fan_appear:
  //スターランクによりファンの表示を変更
  _PKWD_GET_STAR_RANK( SCWK_ANSWER )
  _DEBUG_PRINT_WK( SCWK_ANSWER )
  // スターランク0
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_0 && FLAG_ON( FV_C15R0301_BONUS_0 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_0 )
    _OBJ_ADD( C15R0301_BACKPACKERM_01 )
  ENDIF
  // スターランク1
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_1 && FLAG_ON( FV_C15R0301_BONUS_1 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_1 )
    _OBJ_ADD( C15R0301_WOMAN2_01 )
    _OBJ_ADD( C15R0301_MAN3_01 )
    _OBJ_ADD( C15R0301_MUSICIANW_01 )
  ENDIF
  // スターランク2
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_2 && FLAG_ON( FV_C15R0301_BONUS_2 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_2 )
    _OBJ_ADD( C15R0301_POLICEMAN_01 )
    _OBJ_ADD( C15R0301_WOMAN2_02 )
    _OBJ_ADD( C15R0301_BABYBOY2_01 )
    _OBJ_ADD( C15R0301_NURSE_01 )
  ENDIF
  // スターランク3
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_3 && FLAG_ON( FV_C15R0301_BONUS_3 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_3 )
    _OBJ_ADD( C15R0301_TRAINERM_01 )
    _OBJ_ADD( C15R0301_WOMAN2_03 )
    _OBJ_ADD( C15R0301_MAN3_02 )
    _OBJ_ADD( C15R0301_OLDWOMAN1_01 )
    _OBJ_ADD( C15R0301_MAN3_03 )
    _OBJ_ADD( C15R0301_TENNISW_01 )
  ENDIF
  // スターランク4
  IF $SCWK_ANSWER >= $SCR_PKWD_STAR_RANK_4 && FLAG_ON( FV_C15R0301_BONUS_4 ) THEN
    _FLAG_RESET( FV_C15R0301_BONUS_4 )
    _OBJ_ADD( C15R0301_MAN3_04 )
    _OBJ_ADD( C15R0301_WOMAN2_04 )
    _OBJ_ADD( C15R0301_BABYBOY1_01 )
    _OBJ_ADD( C15R0301_WOMAN2_05 )
    _OBJ_ADD( C15R0301_MAN3_05 )
    _OBJ_ADD( C15R0301_WOMAN2_06 )
    _OBJ_ADD( C15R0301_HAKAIM_01 )
    _OBJ_ADD( C15R0301_SWPLAZMAW_01 )
  ENDIF

  $LOCALWORK2 = $LWK_PKWD_SHOW_REC_POS
  $LOCALWORK5 = 0   // 道具もらえるようにする
  $LOCALWORK6 = 0   // 道具もらえるようにする
  $LOCALWORK7 = 0   // 道具もらえるようにする
  $LOCALWORK8 = 0   // 道具もらえるようにする
  $LOCALWORK9 = 0   // 道具もらえるようにする
  $LOCALWORK10 = 0   // 道具もらえるようにする
  $LOCALWORK11 = 0   // 道具もらえるようにする
  $LOCALWORK12 = 0   // 道具もらえるようにする
  $LOCALWORK13 = 0   // 道具もらえるようにする
  $LOCALWORK14 = 0   // 道具もらえるようにする
  $LOCALWORK15 = 0   // 道具もらえるようにする

  _RET


/**************************************************************/
//  上映後の処理
/**************************************************************/
ev_pkwd_show_after:
  //上映済みかチェック
  _PKWD_IS_SHOWED_MOVIE( LWK_PKWD_SHOW_REC_POS, SCWK_ANSWER  )
  //このコマンドで上映済みフラグをONにしているので注意）
  _PKWD_SET_SHOWED_MOVIE( LWK_PKWD_SHOW_REC_POS )
  IF $SCWK_ANSWER == FALSE THEN
    //オーナー登場POSイベント設定
    $LOCALWORK0 = 1
    $LOCALWORK1 = $LWK_PKWD_SHOW_REC_POS

    // ごほうびイベント用
    $LOCALWORK3 = 1   // 初上映フラグON
  ELSE
    //オーナー登場POSイベント解除（念のため）
    $LOCALWORK0 = 0
  ENDIF
_RET

//==============================================================================
//
//  ポケウッドシアター  オーナー出現イベント
//
//==============================================================================
EVENT_START ev_pos_pkwd_theater_owner_appear
  _CALL ev_pkwd_show_owner_judge

  //オーナー登場POSイベント解除
  $LOCALWORK0 = 0
EVENT_END


/**************************************************************/
//
//
//  オーナーの評価イベント本体
//
//  param[in] LOCALWORK1  上映データの場所
//
//  _OBJ_ADD_EXで動作モデルを生成しているので限界数に注意
//
//
/**************************************************************/
ev_pkwd_show_owner_judge:

  //オーナー出現
  _OBJ_ADD_EX( 15, 31, DIR_UP, MMDL_ID_EVENTOBJ_00, PWOWNER, MV_DMY )
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()

  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_bikkuri )
  _OBJ_ANIME_WAIT()

  //「いやあーちょっと！！～ちゃん！
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_01, MMDL_ID_EVENTOBJ_00, POS_UP )
  _MSGWIN_CLOSE()

  //プレイヤーの位置によりアニメ分岐
  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  SWITCH $LWK_HEROX
  CASE 14 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_appear1 )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_turn_right )
    _OBJ_ANIME_WAIT()
  CASE 15 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_appear2 )
    _OBJ_ANIME_WAIT()
  CASE 16 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_appear3 )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_turn_left )
    _OBJ_ANIME_WAIT()
  ENDSWITCH

  //オーナーから評価メッセージ
  _PLAYER_NAME( 0 )
  _PKWD_GET_MOVIE_VALUE( LOCALWORK1, SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_PKWD_RESULT_GOOD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_04, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  CASE SCR_PKWD_RESULT_BAD_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_02, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  CASE SCR_PKWD_RESULT_STRANGE_END THEN
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_03, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ENDSWITCH

  //出演ポケモンはレンタルか？
  _PKWD_IS_RENTAL_POKE_MOVIE( LOCALWORK1, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE THEN
    //→手持ちの場合、手持ちポケモンスターランク変化を示唆する
    //「んーそうねー～～ちゃんのポケモンにも何か変化がありそうだね
    _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_05, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  ENDIF
  //「じゃーね！
  _BALLOONWIN_OBJMSG_POS( msg_pw_starnpc_06, MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()


  //オーナー去っていく
  //プレイヤーの位置によりアニメ分岐
  SWITCH $LWK_HEROX
  CASE 14, 16 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_disappear1 )
  CASE 15 THEN
    _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_owner_disappear2 )
  ENDSWITCH
  _OBJ_ANIME_WAIT()
  //オーナーOBJ削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

_RET

_ANIME_LABEL  anm_owner_bikkuri
  _ANIME_DATA AC_MARK_GYOE, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_owner_appear1
  _ANIME_DATA AC_WALK_U_8F, 5
  _ANIME_DATA AC_STAY_WALK_L_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_owner_appear2
  _ANIME_DATA AC_WALK_U_8F, 4
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_owner_appear3
  _ANIME_DATA AC_WALK_U_8F, 5
  _ANIME_DATA AC_STAY_WALK_R_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_player_turn_right
  _ANIME_DATA AC_STAY_WALK_R_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_player_turn_left
  _ANIME_DATA AC_STAY_WALK_L_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_owner_disappear1
  _ANIME_DATA AC_WALK_U_8F, 9
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_owner_disappear2
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_U_8F, 10
  _ANIME_DATA ACMD_END, 0

//==============================================================================
//
//  上映成績記録モニター
//
//==============================================================================
EVENT_START   ev_pokewood_monitor
{
  DEFINE_LOCAL  flag_total

  // 上映して観たことのある総数を取得
  _PKWD_GET_FLAG_TOTAL( SCR_PKWD_SCENARIO_THEATERGO_FLAG, flag_total )

  // 一度もないなら記録がないのでSKIP
  IF $flag_total > 0 THEN
    _TALK_START_SE_PLAY()
    _PKWD_RECORD_MONITOR( SCWK_ANSWER )

  ELSE
    // 「ただいま こちらの モニターは ちょうせいちゅう です・・・」
    _SYSWIN_MSG( msg_pw__monitor_01, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()
  ENDIF
}
EVENT_END

