INIT_EVENT_START  ev_init_pkwd_theater
  IF $WK_SCENE_C15_TUTORIAL_01 < 3 THEN
    _OBJ_POS_CHANGE( C15R0301_PWSTAFF_01, 15, 0, 29, DIR_DOWN )
    _OBJ_POS_CHANGE( C15R0301_PWDADDY_01, 12, 0, 23, DIR_RIGHT )
  ENDIF
INIT_EVENT_END

//==============================================================================
//
//
//    ポケウッドシアター  上映受付
//
//
//==============================================================================

DEFINE_LOCAL  LWK_PKWD_SHOW_SEQ
DEFINE_LOCAL  LWK_PKWD_SHOW_MENU
DEFINE_LOCAL  LWK_PKWD_SHOW_LOOP
DEFINE_LOCAL  LWK_PKWD_SHOW_REC_POS
DEFINE_LOCAL  LWK_PKWD_SHOW_REC_COUNT
DEFINE_LOCAL  LWK_BM_DOOR_ID
DEFINE_LOCAL  LWK_PKWD_SHOW_FINISH

DEFINE_LOCAL  LWK_HEROX
DEFINE_LOCAL  LWK_HEROZ

/**************************************************************/
//    ポケウッド：シアターチュートリアル
/**************************************************************/
EVENT_START   ev_reserve_pkwd_theater_tutorial
  //→ev_scene_c15_tutorial_01から

  //(16,25)に主人公と移動
  //「さあさあ！受付はこちらですよ▼
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_01, C15R0301_PWSTAFF_01, POS_DOWN )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 15,24, FORCE_TYPE_NPC, 8, DIR_UD )
  _TIME_WAIT( 4 )
  _OBJ_ANIME_AUTO( C15R0301_PWSTAFF_01, 15,23, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  
  //(12,23)あたりに配置
  //「！」表示
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_tutorial_gyoe )
  _OBJ_ANIME_WAIT()
  
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_walk_r )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME( C15R0301_PWSTAFF_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()

  //「スカウトさんじゃありませんか！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_02, C15R0301_PWDADDY_01, POS_DOWN )
  _MSGWIN_CLOSE()
  
  //「そうですか！それは　なにより！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_03, C15R0301_PWSTAFF_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公に隣接
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_walk_d )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //「で？　こちらは　どちらさま？
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_04, C15R0301_PWDADDY_01, POS_DOWN )
  _MSGWIN_CLOSE()
  
  //「こちらは～さん！おたくの娘さんにチャレンジしているところを
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_05, C15R0301_PWSTAFF_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //「そうか娘を…それはたしかにいいウデをしたトレーナーなんでしょうね
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_06, C15R0301_PWDADDY_01, POS_DOWN )
  _MSGWIN_CLOSE()
  
  //「！」表示
  _OBJ_ANIME( C15R0301_PWSTAFF_01, anm_tutorial_gyoe )
  _OBJ_ANIME_WAIT()
  
  //「それはいい！　～さん！これからの参考になりますよ
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_07, C15R0301_PWSTAFF_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //「よしよし！いきましょう！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_08, C15R0301_PWDADDY_01, POS_DOWN )
  _MSGWIN_CLOSE()

  _CALL ev_pkwd_tutorial_watch_movie
  
  //「……　……
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_09, C15R0301_PWDADDY_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //スタッフの位置を見えないギリギリに移動する
  _OBJ_POS_CHANGE( C15R0301_PWSTAFF_01, 15, 0, 17, DIR_UP )
  _OBJ_ANIME_AUTO( C15R0301_PWSTAFF_01, 15,13, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //「おつかれさまでした！どうでしたか！映画は？
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_10, C15R0301_PWSTAFF_01, POS_DOWN )
  _MSGWIN_CLOSE()
  
  //「……　……
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_11, C15R0301_PWDADDY_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //「ん？どうしたんです？
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_12, C15R0301_PWSTAFF_01, POS_DOWN )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //アニメ：左に1歩
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_walk_l_16f )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( C15R0301_PWSTAFF_01, anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //「フフフッ……あこがれの銀幕に立てたんです…いい夢見せてもらいました…
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_13, C15R0301_PWDADDY_01, POS_UP )
  _MSGWIN_CLOSE()
  
  //「え……？
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_14, C15R0301_PWSTAFF_01, POS_DOWN )
  _MSGWIN_CLOSE()

  //アニメ：下に1歩
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_walk_d_16f )
  _OBJ_ANIME_WAIT()

  //「人には向きと不向きがある…そんなのはわかってるんです…
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_15, C15R0301_PWDADDY_01, POS_UP )
  _MSGWIN_CLOSE()

  //「そ　その　とおりです！チャレンジすることをあきらめちゃダメですよ！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_16, C15R0301_PWSTAFF_01, POS_DOWN )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  _PLAYER_NAME( 0 )

  //「とはいえひとまず私は自分の仕事に戻ります
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_17, C15R0301_PWDADDY_01, POS_UP )
  _MSGWIN_CLOSE()

  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_tutorial_pwdaddy_disappear )
  _TIME_WAIT( 10 )
  _OBJ_ANIME( C15R0301_PWSTAFF_01, anm_staystep_d )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 20 )

  _OBJ_ANIME( C15R0301_PWSTAFF_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //「さてと……そろそろ　まいりましょうか！
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_18, C15R0301_PWSTAFF_01, POS_DOWN )
  _MSGWIN_CLOSE()

  //画面暗転処理
  _MAP_FADE_BLACK_OUT_SLOW()
  
  _OBJ_ANIME_AUTO( C15R0301_PWSTAFF_01, 15,18, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 15,17, FORCE_TYPE_NPC, 8, DIR_UD )

  _MAP_FADE_END_CHECK()
  _OBJ_ANIME_WAIT()
  
  _MAP_CHANGE_NO_FADE( ZONE_ID_C15, 45, 3, 18 , DIR_DOWN )
  //→ev_scene_c15_tutorial_02へ

EVENT_END

_ANIME_LABEL anm_tutorial_first_step
  _ANIME_DATA AC_WALK_U_8F, 6
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_tutorial_gyoe
  _ANIME_DATA AC_MARK_GYOE, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_tutorial_pwstaff_appear
  _ANIME_DATA AC_WALK_U_8F, 3
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_tutorial_pwdaddy_disappear
  _ANIME_DATA AC_WALK_D_8F, 7
  _ANIME_DATA AC_VANISH_ON, 1   //見えなくする
  _ANIME_DATA ACMD_END, 0

ev_pkwd_tutorial_watch_movie:
  //受付にいく
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_tutorial_pwdaddy_go_theater )
  _OBJ_ANIME_WAIT()

  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_tutorial_pwdaddy_go_info )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_tutorial_player_go_info )
  _OBJ_ANIME( C15R0301_PWSTAFF_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //受付：うけつけする
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_08a ,C15R0301_PKWD_SHOW ,POS_UP )
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_staystep_l )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //ホミカ父：さあ　いこう
  _BALLOONWIN_OBJMSG_POS( msg_pw_tutorial_show_08b ,C15R0301_PWDADDY_01 ,POS_UP )
  _MSGWIN_CLOSE()

  //受付にいく
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_tutorial_pwdaddy_go_theater1 )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_tutorial_player_go_theater )
  _OBJ_ANIME_WAIT()

  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  $LWK_HEROZ -= 1
  _BMODEL_ANIME_CREATE( LWK_BM_DOOR_ID, SCR_BMID_DOOR, 15, 8 )
  _BMODEL_ANIME_SET( LWK_BM_DOOR_ID, SCR_BMANM_DOOR_OPEN )
  _BMODEL_ANIME_WAIT( LWK_BM_DOOR_ID )

  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_walk_u )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
  _OBJ_ANIME_WAIT()

  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()

  _BMODEL_ANIME_DELETE( LWK_BM_DOOR_ID )

  _PKWD_SYSTEM_START()
  _PKWD_SHOW_TUTORIAL()
  _PKWD_SYSTEM_END()

  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  //閉まるアニメの1フレーム目で止めておく
  _BMODEL_ANIME_CREATE( LWK_BM_DOOR_ID, SCR_BMID_DOOR, LWK_HEROX, LWK_HEROZ )
  _BMODEL_ANIME_SET( LWK_BM_DOOR_ID, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_STOP( LWK_BM_DOOR_ID )

  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()

  //スクリーンから出てくる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_tutorial_go_out_theater )
  _OBJ_ANIME( C15R0301_PWDADDY_01, anm_pwdaddy_tutorial_go_out_theater )
  _OBJ_ANIME_WAIT()

  //アニメ再開
  _BMODEL_ANIME_SET( LWK_BM_DOOR_ID, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_WAIT( LWK_BM_DOOR_ID )

_RET

_ANIME_LABEL anm_tutorial_player_go_theater
  _ANIME_DATA AC_WALK_R_8F, 7
  _ANIME_DATA AC_WALK_U_8F, 1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_tutorial_pwdaddy_go_theater
  _ANIME_DATA AC_WALK_R_8F, 1
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_tutorial_pwdaddy_go_info
  _ANIME_DATA AC_WALK_U_8F, 11
  _ANIME_DATA AC_WALK_L_8F, 5
  _ANIME_DATA AC_WALK_U_8F, 2
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_tutorial_player_go_info
  _ANIME_DATA AC_WALK_L_8F, 1
  _ANIME_DATA AC_WALK_U_8F, 11
  _ANIME_DATA AC_WALK_L_8F, 6
  _ANIME_DATA AC_WALK_U_8F, 2
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_tutorial_pwdaddy_go_theater1
  _ANIME_DATA AC_WALK_R_8F, 6
  _ANIME_DATA AC_WALK_U_8F, 2
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL anm_tutorial_go_out_theater
  _ANIME_DATA AC_WALK_D_8F, 3
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL anm_pwdaddy_tutorial_go_out_theater
  _ANIME_DATA AC_WALK_D_8F,2
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL anm_player_tutorial_go_out_theater
  _ANIME_DATA AC_WALK_D_8F,2
  _ANIME_DATA AC_WAIT_8F,2
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0


/**************************************************************/
//    ポケウッド：上映受付
/**************************************************************/

EVENT_START ev_pokewood_show

  _TALK_OBJ_START()

  _PKWD_SYSTEM_START()

  $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_FIRST_MENU

  WHILE $LWK_PKWD_SHOW_SEQ != PKWD_SHOW_SEQ_END

    SWITCH $LWK_PKWD_SHOW_SEQ
    CASE PKWD_SHOW_SEQ_GOODBYE      THEN
      //「それでは　またのお越しをお待ちしております」
      _BALLOONWIN_OBJMSG_POS( msg_pw_theater_06, SCWK_TARGET_OBJID, POS_DOWN )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
      $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_END

    CASE PKWD_SHOW_SEQ_FIRST_MENU   THEN
      _CALL ev_pkwd_show_first_menu

    CASE PKWD_SHOW_SEQ_SELECT_MOVIE THEN
      _CALL ev_pkwd_show_select_movie

    CASE PKWD_SHOW_SEQ_WATCH_MOVIE  THEN
      //一度でも見たら撮影できるようになる
      _FLAG_RESET( SYS_FLAG_POKEWOOD_DISABLE_REC )
      _CALL ev_pkwd_show_watch_movie

    CASE PKWD_SHOW_SEQ_AFTER        THEN
      _CALL ev_pkwd_show_after
      $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_END

    DEFAULT
      $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_END

    ENDSWITCH

  ENDWHILE

  _PKWD_SYSTEM_END()

EVENT_END


/**************************************************************/
//  選択メニュー
/**************************************************************/
ev_pkwd_show_first_menu:

  $LWK_PKWD_SHOW_LOOP = TRUE

  WHILE $LWK_PKWD_SHOW_LOOP == TRUE
    _BALLOONWIN_OBJMSG_POS( msg_pw_theater_01, SCWK_TARGET_OBJID, POS_DOWN )
    _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_PKWD_SHOW_MENU )
    _BMPMENU_MAKE_LIST( msg_pw_theater_menu_01, 0 )  //えいがをみる
    _BMPMENU_MAKE_LIST( msg_pw_theater_menu_02, 1 )  //せつめいをきく
    _BMPMENU_MAKE_LIST( msg_pw_theater_menu_03, 2 )  //やめる
    _BMPMENU_START()

    SWITCH $LWK_PKWD_SHOW_MENU
    CASE 0 THEN
      _PKWD_GET_MOVIE_COUNT( LWK_PKWD_SHOW_REC_COUNT )
      IF $LWK_PKWD_SHOW_REC_COUNT == 0 THEN
        _BALLOONWIN_OBJMSG_POS( msg_pw_theater_04, SCWK_TARGET_OBJID, POS_DOWN )
        $LWK_PKWD_SHOW_LOOP = FALSE
        $LWK_PKWD_SHOW_SEQ  = PKWD_SHOW_SEQ_GOODBYE
      ELSE
        $LWK_PKWD_SHOW_LOOP = FALSE
        $LWK_PKWD_SHOW_SEQ  = PKWD_SHOW_SEQ_SELECT_MOVIE
      ENDIF

    CASE 1 THEN
      _BALLOONWIN_OBJMSG_POS( msg_pw_theater_02, SCWK_TARGET_OBJID, POS_DOWN )

    DEFAULT
      $LWK_PKWD_SHOW_LOOP = FALSE
      $LWK_PKWD_SHOW_SEQ  = PKWD_SHOW_SEQ_GOODBYE

    ENDSWITCH
  ENDWHILE
_RET

/**************************************************************/
//
/**************************************************************/
ev_pkwd_show_select_movie:
  //「それでは　ご覧になりたい作品を選んでください」
  _BALLOONWIN_OBJMSG_POS( msg_pw_theater_03, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()
  //上映選択へ
  _PKWD_SELECT_MOVIE( SCR_PKWD_SELECT_MODE_NORMAL, LWK_PKWD_SHOW_REC_POS )

  _DEBUG_PRINT_WK( LWK_PKWD_SHOW_REC_POS )
  IF $LWK_PKWD_SHOW_REC_POS == SCR_PKWD_MOVIE_MAX THEN
    //「それでは　またのお越しをお待ちしております」
    $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_GOODBYE
  ELSE
    //映画鑑賞へ
    $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_WATCH_MOVIE
  ENDIF
_RET


/**************************************************************/
//
/**************************************************************/
ev_pkwd_show_watch_movie:
  //フェスミッション強制終了処理
  _FMISSION_END_FORCE()
  
  //「それでは　まもなく上映です」
  _BALLOONWIN_OBJMSG_POS( msg_pw_theater_05, SCWK_TARGET_OBJID, POS_DOWN )
  _MSGWIN_CLOSE()

  //スクリーンに入る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_door )
  _OBJ_ANIME_WAIT()

  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  $LWK_HEROZ -= 1
  _BMODEL_ANIME_CREATE( LWK_BM_DOOR_ID, SCR_BMID_DOOR, LWK_HEROX, LWK_HEROZ )
  _BMODEL_ANIME_SET( LWK_BM_DOOR_ID, SCR_BMANM_DOOR_OPEN )
  _BMODEL_ANIME_WAIT( LWK_BM_DOOR_ID )

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_in_theater )
  _OBJ_ANIME_WAIT()

  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()

  _BMODEL_ANIME_DELETE( LWK_BM_DOOR_ID )

  _PKWD_SHOW( LWK_PKWD_SHOW_REC_POS, LWK_PKWD_SHOW_FINISH )

  _PKWD_IS_SHOWED_MOVIE( LWK_PKWD_SHOW_REC_POS, SCWK_ANSWER )
  //最後まで上映して、初上映の場合のみファンの処理を行う
  IF $LWK_PKWD_SHOW_FINISH == TRUE && $SCWK_ANSWER == FALSE THEN
    _CALL sub_pkwd_fan_appear
  ENDIF

  //ごほうびイベントチェック
  IF $WK_SCENE_C15_BONUS_EVENT_01 == 0 THEN
    
    // 全てのシナリオのGOODENDチェック
    _PKWD_CHECK_ALL_SUCCESS( SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN

      // 全てのシナリオでGOODEND達成した
      $WK_SCENE_C15_BONUS_EVENT_01 = 1     //ごほうびイベント起動
    ENDIF
  ENDIF

  _PLAYER_POS_GET( LWK_HEROX, LWK_HEROZ )
  //閉まるアニメの1フレーム目で止めておく
  _BMODEL_ANIME_CREATE( LWK_BM_DOOR_ID, SCR_BMID_DOOR, LWK_HEROX, LWK_HEROZ )
  _BMODEL_ANIME_SET( LWK_BM_DOOR_ID, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_STOP( LWK_BM_DOOR_ID )

  //暗転中に自機を下に向けておく
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_d )
  _OBJ_ANIME_WAIT()
  
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()

  //スクリーンから出てくる
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_go_out_theater )
  _OBJ_ANIME_WAIT()

  //アニメ再開
  _BMODEL_ANIME_SET( LWK_BM_DOOR_ID, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_WAIT( LWK_BM_DOOR_ID )

  IF $LWK_PKWD_SHOW_FINISH == TRUE THEN
    $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_AFTER
  ELSE
    //キャンセルの場合は終わりにしてしまう
    $LWK_PKWD_SHOW_SEQ = PKWD_SHOW_SEQ_END
  ENDIF
_RET

_ANIME_LABEL  anm_player_go_door
  _ANIME_DATA AC_WALK_R_8F, 6
  _ANIME_DATA AC_WALK_U_8F, 2
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_in_theater
  _ANIME_DATA AC_WALK_U_8F, 1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_go_out_theater
  _ANIME_DATA AC_WALK_D_8F, 3
