
//======================================================================
//                c09r0101.ev
//
//    スクリプトファイル：c09r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0101.h"
  .include  "c09r0101.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c09r0101
_EVENT_DATA    ev_init_c09r0101
_EVENT_DATA    ev_recover_c09r0101
_EVENT_DATA    ev_c09r0101_bigfour1_01
_EVENT_DATA    ev_pos_c09r0101_enter_01
_EVENT_DATA    ev_pos_c09r0101_enter_02
_EVENT_DATA    ev_pos_c09r0101_warp_01
_EVENT_DATA_END


//------------------------------注意--------------------------------//
//																	//
//	LOCALWORK0 をギミックの制御に使用しています。					//
//		0 = 階段下のPOSイベント有効 	//
//	LOCALWORK1 をギミックの制御に使用しています。					//
//		0 = 階段上のPOSイベント有効 	//
//	LOCALWORK10 をギミックの制御に使用しています。マップ内使用禁止	//
//		555 = POSイベント有効										//
//																	//
//------------------------------------------------------------------//

/************************************************************/
/*					ZONE_CHANGE_LABEL 						*/
/************************************************************/
INIT_EVENT_START	ev_zone_c09r0101
  
INIT_EVENT_END
/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_c09r0101

  // 頂上のPOSを踏んでいない時の処理
  IF $LOCALWORK1 == 0 THEN
    // 頂上のPOSを踏んでいない時の処理
    // シキミを後ろに向かせて配置
    _OBJ_POS_CHANGE( C09R0101_BIGFOUR1_01, 15, 12, 8, DIR_UP )
  ENDIF

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_c09r0101

  // 主人公が頂上にいるときの処理
  IF $LOCALWORK1 == 1 THEN
    // レールOFF
    _FOURKINGS_RAIL_OFF( 1 )
		// カメラ設定を変更
		_FOURKINGS_SET_TOP_CAMERA( 1 )

  ELSE
    // 頂上のPOSを踏んでいない時の処理
    // シキミを後ろに向かせて配置
    _OBJ_POS_CHANGE( C09R0101_BIGFOUR1_01, 15, 12, 8, DIR_UP )
  ENDIF

INIT_EVENT_END


/************************************************************/
/*						四天王（ゴースト）						*/
/************************************************************/
EVENT_START	ev_c09r0101_bigfour1_01

EVENT_END

/************************************************************/
/*					階段下のposイベント					*/
/************************************************************/
EVENT_START	ev_pos_c09r0101_enter_01

  //======================================
  // 演出開始
  //--------------------------------------

  _TIME_WAIT( 5 )

  // もやが晴れる
  _FOURKINGS_GHOST_MIST()

  _TIME_WAIT( 40 )

  // 炎アニメ(fire_a)
  _FOURKINGS_GHOST_FIRE( 0 )
  _TIME_WAIT( 10 )

  // 階段の炎アニメ(fire_b) 4つ
  _FOURKINGS_GHOST_FIRE( 1 )
  _TIME_WAIT( 10 )
  _FOURKINGS_GHOST_FIRE( 2 )
  _TIME_WAIT( 10 )
  _FOURKINGS_GHOST_FIRE( 3 )
  _TIME_WAIT( 10 )
  _FOURKINGS_GHOST_FIRE( 4 )
  _TIME_WAIT( 10 )

  //--------------------------------------
  // 演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

EVENT_END

/************************************************************/
/*					階段上のposイベント					*/
/************************************************************/
EVENT_START	ev_pos_c09r0101_enter_02

  // レールOFF
  _FOURKINGS_RAIL_OFF(1)

	// カメラ設定を変更
	_FOURKINGS_SET_TOP_CAMERA(1)

  //======================================
  // 演出開始
  //--------------------------------------

  _TIME_WAIT( 5 )

  // シキミ振り向く
  _OBJ_ANIME( C09R0101_BIGFOUR1_01, anm_turn_down )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 5 )

  // 本が落ちる⇒暗転
  // 数字は本が落ちるアニメが終了してから暗転までのウェイト
  _FOURKINGS_GHOST_BOOK_FALL( 10 )

  _TIME_WAIT( 5 )

  // ランプアニメ
  _FOURKINGS_GHOST_LAMP()

  _TIME_WAIT( 5 )

  //--------------------------------------
  // 演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

  //=====================================
  //ワープPOSイベントを有効
	$LOCALWORK10 = 555
  //=====================================

EVENT_END

/************************************************************/
/*						ワープ（出口用）					*/
/************************************************************/
EVENT_START	ev_pos_c09r0101_warp_01
	
	//マップチェンジ
	_MAP_CHANGE_WARP( ZONE_ID_C09P01, 31, 48, DIR_UP )
	
EVENT_END


//--------------------------------------------------------------
//	下に振り向く
//--------------------------------------------------------------
_ANIME_LABEL  anm_turn_down
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

