
//======================================================================
//                c09r0101.ev
//
//    スクリプトファイル：c09r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0101.h"
  .include  "c09r0101.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c09r0101
_EVENT_DATA    ev_init_c09r0101
_EVENT_DATA    ev_recover_c09r0101
_EVENT_DATA    ev_c09r0101_bigfour1_01
_EVENT_DATA    ev_pos_c09r0101_enter_01
_EVENT_DATA    ev_pos_c09r0101_enter_02
_EVENT_DATA    ev_pos_c09r0101_warp_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//                                                                  //
//  LOCALWORK0 をギミックの制御に使用しています。                   //
//    0 = 階段下のPOSイベント有効                                   //
//  LOCALWORK1 をギミックの制御に使用しています。                   //
//    0 = 階段上のPOSイベント有効                                   //
//  LOCALWORK10 をギミックの制御に使用しています。マップ内使用禁止  //
//    555 = POSイベント有効                                         //
//                                                                  //
//------------------------------------------------------------------//


/************************************************************/
/*  ZONE_CHANGE_LABEL                                       */
/************************************************************/
INIT_EVENT_START  ev_zone_c09r0101

  //四天王（シキミ）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) THEN
    $LOCALWORK10 = 555
  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_c09r0101
/*
  // ゴースト　音開始
  // 一番上で呼んでください
  _FOURKINGS_SET_SOUND_SYSTEM( 1 )
*/
  //頂上のPOSを踏んでいない時の処理
  IF $LOCALWORK1 == 0 THEN
    //頂上のPOSを踏んでいない時の処理
    //シキミを後ろに向かせて配置
    _OBJ_POS_CHANGE( C09R0101_BIGFOUR1_01, 15, 12, 7, DIR_UP )
  ENDIF

  //四天王（ゴースト）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) THEN

    //配置モデルのアニメをループ再生
    _BMODEL_DIRECT_ANIME_SET_LOOP( SCR_BMID_WARP, 18, 8 )

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  FIELD_RECOVER_LABEL                                     */
/************************************************************/
INIT_EVENT_START  ev_recover_c09r0101
/*
  // ゴースト　音開始
  // 一番上で呼んでください
  _FOURKINGS_SET_SOUND_SYSTEM( 1 )
*/
  //主人公が頂上にいるときの処理
  IF $LOCALWORK1 == 1 THEN
    //レールOFF
    _FOURKINGS_RAIL_OFF( 1 )
    //カメラ設定を変更
    _FOURKINGS_SET_TOP_CAMERA( 1 )

  ELSE
    //頂上のPOSを踏んでいない時の処理
    //シキミを後ろに向かせて配置
    _OBJ_POS_CHANGE( C09R0101_BIGFOUR1_01, 15, 12, 7, DIR_UP )
  ENDIF

  //四天王（ゴースト）倒しているならワープPOSイベントを有効にする
  IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) THEN

    //配置モデルのアニメをループ再生
    _BMODEL_DIRECT_ANIME_SET_LOOP( SCR_BMID_WARP, 18, 8 )

  ENDIF

INIT_EVENT_END

/************************************************************/
/*  四天王（ゴースト）                                      */
/************************************************************/
EVENT_START   ev_c09r0101_bigfour1_01

  _TALK_OBJ_START()

  //ゲームクリア前後で分岐
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    //========ゲームクリア前===============

    //戦闘済みかで分岐
    IF FLAG_OFF( SYS_FLAG_BIGFOUR_GHOSTWIN ) THEN

      //戦闘前---------------------------------------------------

      //シキミ：『りそうを　おいもとめ（バージョンでセリフが異なる）
      _BALLOONWIN_OBJMSG_WB( msg_c09r0101_bigfour1_01w, msg_c09r0101_bigfour1_01b, C09R0101_BIGFOUR1_01, POS_UP )
      _MSGWIN_CLOSE()

      //========================================//
      //戦闘終了後にワープのアニメを再生させるため、マップ構築前に勝利フラグをたてておく
      //負けた場合はC09でリセットされるので問題なし
      //四天王（シキミ）勝利フラグをセット
      _FLAG_SET( SYS_FLAG_BIGFOUR_GHOSTWIN )
      //ワープPOS有効
      $LOCALWORK10 = 555
      //========================================//
      
    {
      //難易度取得ワーク定義
      DEFINE_LOCAL  LCW_DIFFICULTY
      
      //現在の難易度を取得
      _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
      
      //トレーナー戦呼び出し
      
      //むずかしい
      IF $LCW_DIFFICULTY == 2 THEN
        _TRAINER_BTL_SET( TRID_BIGFOUR1_03, 0 )
      
      //ふつう・かんたん
      ELSE
        _TRAINER_BTL_SET( TRID_BIGFOUR1_01, 0 )
      ENDIF

    }
      //敗戦チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
      ELSE
        _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
      ENDIF

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
      //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
      //シキミ：その　しかくを　えましたよ▼
      _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_04 ,C09R0101_BIGFOUR1_01 ,POS_UP )

      ELSE
        //それ以外なら通常メッセージを表示
        //シキミ：みんな　きずつきながらも
      _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_02 ,C09R0101_BIGFOUR1_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ELSE

      //戦闘後---------------------------------------------------

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //シキミ：その　しかくを　えましたよ▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_04 ,C09R0101_BIGFOUR1_01 ,POS_UP )

      ELSE
        //戦闘後メッセージ
        //シキミ：かくごが　ひつよう　ですよね▽
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_03 ,C09R0101_BIGFOUR1_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSE

    //========ゲームクリア後===============

    //戦闘済みかで分岐
    IF FLAG_OFF( SYS_FLAG_BIGFOUR_GHOSTWIN ) THEN

      //戦闘前---------------------------------------------------

      //戦闘前メッセージ メッセージがランダム変化（小説の内容が変化）
      _GET_RND( SCWK_ANSWER, 5 )

      SWITCH $SCWK_ANSWER
      CASE 0 THEN
        //シキミ：『ゆけい　ウルガモス！
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_05a ,C09R0101_BIGFOUR1_01 ,POS_UP )
      CASE 1 THEN
        //シキミ：『１０まんボルトって　しってる？▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_05b ,C09R0101_BIGFOUR1_01 ,POS_UP )
      CASE 2 THEN
        //シキミ：『なあ　あんた
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_05c ,C09R0101_BIGFOUR1_01 ,POS_UP )
      CASE 3 THEN
        //シキミ：『ゴーストタイプを　つかう　じょせい
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_05d ,C09R0101_BIGFOUR1_01 ,POS_UP )
      DEFAULT
        //シキミ：『そう！　コードネームは　ハンサム！▼
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_05e ,C09R0101_BIGFOUR1_01 ,POS_UP )
      ENDSWITCH
      _MSGWIN_CLOSE()

      //========================================//
      //戦闘終了後にワープのアニメを再生させるため、マップ構築前に勝利フラグをたてておく
      //負けた場合はC09でリセットされるので問題なし
      //四天王（シキミ）勝利フラグをセット
      _FLAG_SET( SYS_FLAG_BIGFOUR_GHOSTWIN )
      //ワープPOS有効
      $LOCALWORK10 = 555
      //========================================//

    {
      //難易度取得ワーク定義
      DEFINE_LOCAL  LCW_DIFFICULTY
      
      //現在の難易度を取得
      _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
      
      //トレーナー戦呼び出し
      
      //むずかしい
      IF $LCW_DIFFICULTY == 2 THEN
        _TRAINER_BTL_SET( TRID_BIGFOUR1_04, 0 )
      
      //ふつう・かんたん
      ELSE
        _TRAINER_BTL_SET( TRID_BIGFOUR1_02, 0 )
      ENDIF

    }
      //敗戦チェック
      _TRAINER_LOSE_CHECK( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
        _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
      ELSE
        _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
      ENDIF

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //シキミ：ぜひ！　すてきな　ものがたりを
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_08 ,C09R0101_BIGFOUR1_01 ,POS_UP )

      ELSE
        //それ以外なら通常メッセージを表示
        //シキミ：みんな　きずつきながらも
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_06 ,C09R0101_BIGFOUR1_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ELSE

      //戦闘後---------------------------------------------------

      //戦闘後メッセージ（四天王討伐状況で分岐）
      IF FLAG_ON( SYS_FLAG_BIGFOUR_GHOSTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_EVILWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_FIGHTWIN ) && FLAG_ON( SYS_FLAG_BIGFOUR_ESPWIN ) THEN
        //四天王全員に勝利済みならエレベータへの誘導メッセージを表示
        //シキミ：ぜひ！　すてきな　ものがたりを
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_08 ,C09R0101_BIGFOUR1_01 ,POS_UP )

      ELSE
        //戦闘後メッセージ
        //シキミ：かくごが　ひつよう　ですよね▽
        _BALLOONWIN_OBJMSG_POS( msg_c09r0101_bigfour1_07 ,C09R0101_BIGFOUR1_01 ,POS_UP )

      ENDIF
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

EVENT_END

/************************************************************/
/*  階段下のposイベント                                     */
/************************************************************/
EVENT_START   ev_pos_c09r0101_enter_01

  //======================================
  //演出開始
  //--------------------------------------

  // もやが晴れる
  _FOURKINGS_GHOST_MIST()

  _TIME_WAIT( 31 )

  // 炎アニメ(fire_a)
  _FOURKINGS_GHOST_FIRE( 0 )
  _TIME_WAIT( 35 )

  // 階段の炎アニメ(fire_b) 4つ
  _FOURKINGS_GHOST_FIRE( 1 )
  _TIME_WAIT( 7 )
  _FOURKINGS_GHOST_FIRE( 2 )
  _TIME_WAIT( 7 )
  _FOURKINGS_GHOST_FIRE( 3 )
  _TIME_WAIT( 7 )
  _FOURKINGS_GHOST_FIRE( 4 )

  //--------------------------------------
  //演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

EVENT_END

/************************************************************/
/*  階段上のposイベント                                     */
/************************************************************/
EVENT_START   ev_pos_c09r0101_enter_02

  //レールOFF
  _FOURKINGS_RAIL_OFF( 1 )

  //カメラ設定を変更
  _FOURKINGS_SET_TOP_CAMERA( 1 )

  //======================================
  //演出開始
  //--------------------------------------

  // 本が落ちる⇒暗転
  // 数字は本が落ちるアニメが再生してから暗転までのウェイト
  _FOURKINGS_GHOST_BOOK_FALL( 37 )

  // ランプアニメ
  _FOURKINGS_GHOST_LAMP()

  //--------------------------------------
  //演出終了
  //======================================

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

EVENT_END

/************************************************************/
/*  ワープ（出口用）                                        */
/************************************************************/
EVENT_START	ev_pos_c09r0101_warp_01

  //マップチェンジ
  _MAP_CHANGE_WARP( ZONE_ID_C09P01, 31, 48, DIR_UP )

EVENT_END


