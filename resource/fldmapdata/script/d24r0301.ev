
//======================================================================
//                d24r0301.ev
//
//    スクリプトファイル：d24r0301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d24r0301.h"
  .include  "d24r0301.h"
  .include  "pair_scr_def.h"
  .include  "d24r0101_def.h"
  .include  "d24r0301_def.h"
  
  //@author Mizuguchi_Mai
  //@author suginaka_katsunori //せいそくちサブイベント

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_d24r0301
_EVENT_DATA    ev_init_d24r0301
_EVENT_DATA    ev_scene_d24r0301_pair_start
_EVENT_DATA    ev_pos_d24r0301_swbell_01
_EVENT_DATA    ev_pos_d24r0301_room_01
_EVENT_DATA    ev_d24r0301_swbell_02
_EVENT_DATA	ev_d24r0301_assitantm_01
_EVENT_DATA_END


//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d24r0301
  
  //全滅復帰ならば連れ歩き状態を初期化
  IF $WK_SCENE_D24_PAIR_START == 2 && FLAG_OFF( SYS_FLAG_PAIR ) THEN
    $WK_SCENE_D24_PAIR_START = 1
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_d24r0301

  //初回入室ならベルの位置を変更
  IF $WK_SCENE_D24_PAIR_START == 1 && FLAG_OFF( FE_D24_SWBELL_FIRSTTALK ) THEN
    _OBJ_POS_CHANGE( D24R0301_SWBELL_01, 0, 0, 0, DIR_RIGHT )
  ENDIF
  
INIT_EVENT_END

/**************************************************************/
/*		SCENE_CHANGE：連れ歩き開始						  */
/**************************************************************/
EVENT_START		ev_scene_d24r0301_pair_start
  
  //主人公名代入
  _PLAYER_NAME( 0 )
  
  //初回入室
  IF FLAG_OFF( FE_D24_SWBELL_FIRSTTALK ) THEN
    
    //自転車に乗ってるなら歩行状態へ
    _PLAYER_FORM_GET( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_PLAYER_FORM_CYCLE THEN
      _PLAYER_REQUEST( FIELD_PLAYER_REQBIT_NORMAL )
    ENDIF
    
    //アニメ：主人公自動で移動
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 7,9, FORCE_TYPE_NOT, 8, DIR_LR )
    
    _TIME_WAIT(12)
    
    //階段SE再生
    _SE_PLAY( SEQ_SE_KAIDAN )
    _SE_WAIT()
    
    //ベル動作モデル移動
    _OBJ_POS_CHANGE( D24R0301_SWBELL_01, 4, 0, 9, DIR_RIGHT )
    
    _OBJ_ANIME_WAIT()
    
    //アニメ：ベル隣接
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME_AUTO( D24R0301_SWBELL_01, 6,9, FORCE_TYPE_NOT, 8, DIR_LR )
    _OBJ_ANIME_WAIT()
    
    //ベル：おうい
    _BALLOONWIN_OBJMSG_MF( msg_d24r0301_swbell_01,msg_d24r0301_swbell_02, D24R0301_SWBELL_01, POS_DEFAULT )
    
    //ベル：あのね　あたしね
    _BALLOONWIN_OBJMSG_POS( msg_d24r0301_swbell_03, D24R0301_SWBELL_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：「！」
    _OBJ_ANIME( D24R0301_SWBELL_01, anm_common_gyoe )
    _OBJ_ANIME_WAIT()
    
    //ベル：あ！あんしんしてよう！
    _BALLOONWIN_OBJMSG_POS( msg_d24r0301_swbell_04, D24R0301_SWBELL_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //連れ歩き開始
    _PAIR_TRAINER_SET( D24R0301_SWBELL_01 , PAIR_ID_D24_SWBELL, PAIR_TYPE_FREE_ZONE, TRID_SUPPORT_01, SCRID_D24_SWBELL )
    
    //==================================//
    //初回会話終了
    _FLAG_SET( FE_D24_SWBELL_FIRSTTALK )
    //ヒードランイベント起動
    $WK_SCENE_D24_BELL_COMMENT = 1
    //ローカルライブキャスター・ライバル通話状態を変更（T04ライバル戦まで）
    _PERSON_STATE_SET_RIVAL( RIVAL_STATE_T04_1 )
    //==================================//
  
  //2回目以降
  ELSE
    
    //自転車に乗ってるなら歩行状態へ
    _PLAYER_FORM_GET( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_PLAYER_FORM_CYCLE THEN
      _PLAYER_REQUEST( FIELD_PLAYER_REQBIT_NORMAL )
    ENDIF
  
    //アニメ：ベル隣接
    _OBJ_ANIME( D24R0301_SWBELL_01, anm_bell_come )
    _OBJ_ANIME_WAIT()
  
    //ベル：いっしょに
    _BALLOONWIN_OBJMSG_POS( msg_d24r0301_swbell_19, D24R0301_SWBELL_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //アニメ：主人公隣接
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
    
    //連れ歩き開始
    _PAIR_TRAINER_SET( D24R0301_SWBELL_01 , PAIR_ID_D24_SWBELL, PAIR_TYPE_FREE_ZONE, TRID_SUPPORT_01, SCRID_D24_SWBELL )
  
  ENDIF
  
  //==================================//
  //連れ歩きPOS起動
  $WK_SCENE_D24_PAIR_START = 2
  //スタート地点のベルを非表示に
  _FLAG_SET( FV_D24_PAIR_START_BELL_01 )
  //==================================//
  
EVENT_END

//--------------------------------------------------------------------
//	ベル：隣接
//--------------------------------------------------------------------
_ANIME_LABEL	anm_bell_come
  _ANIME_DATA	AC_MARK_GYOE,1
  _ANIME_DATA	AC_WALK_L_8F,1
  _ANIME_DATA	ACMD_END,0

/**************************************************************/
/*		POS：連れ歩き解除						  */
/**************************************************************/
EVENT_START		ev_pos_d24r0301_swbell_01
   
   //主人公名代入
  _PLAYER_NAME( 0 )
   
  //アニメ：主人公振り向き
  _CALL ev_player_return_anm
  
  //ベル：連れ歩き終了しますか？
  _BALLOONWIN_OBJMSG_POS( msg_d24r0301_swbell_14, PAIR_TRAINER_01, POS_DEFAULT )
  {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    //ベル：ヒードラン部屋を見た
    IF $WK_SCENE_D24_BELL_COMMENT == 3 THEN
      _BALLOONWIN_OBJMSG_POS( msg_d24r0301_swbell_15, PAIR_TRAINER_01, POS_DEFAULT )
      
      //==================================//
      //連れ歩き終了
      $WK_SCENE_D24_PAIR_START = 3
      //スタート地点のベルを非表示に
      _FLAG_SET( FV_D24_PAIR_START_BELL_01 )
      //ゴール地点のベルを表示
      _FLAG_RESET( FV_D24_PAIR_END_BELL_01 )
      //==================================//
      
    //ベル：ヒードラン部屋を見ていない
    ELSE
      _BALLOONWIN_OBJMSG_POS( msg_d24r0301_swbell_16, PAIR_TRAINER_01, POS_DEFAULT )
      
      //==================================//
      //スタート地点のベルを表示
       _FLAG_RESET( FV_D24_PAIR_START_BELL_01 )
       //==================================//
    ENDIF
    
    _MSGWIN_CLOSE()
    
    //アニメ：ベル元の位置に戻る
    _OBJ_ANIME_AUTO( PAIR_TRAINER_01, 8,9, FORCE_TYPE_NOT, 8, DIR_LR )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_l )
    _OBJ_ANIME_WAIT()
    
    //連れ歩き解除
    _PAIR_TRAINER_FREE( SCRID_D24R0301_SWBELL_02, MV_DMY )
    
    //ヒードランイベントをクリアしていなかった場合ゾーンチェンジ
    IF $WK_SCENE_D24_PAIR_START != 3 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
      _OBJ_ANIME_WAIT()
      
      //予約スクリプト
      _RESERVE_SCRIPT( SCRID_RESERVE_D24R0101_EXIT_01 )
      _MAP_CHANGE( ZONE_ID_D24R0101, 29, 4, DIR_LEFT )
      
    ENDIF
   
  //いいえ
  ELSE
    
    //ベル：もうちょっと
    _BALLOONWIN_OBJMSG_POS( msg_d24r0301_swbell_17, PAIR_TRAINER_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
     _PAIR_PLAYER_FOLLOW_ON()  //連れ歩き追随開始
    //アニメ：主人公１歩戻る
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
    _PAIR_PLAYER_FOLLOW_OFF() //連れ歩き追随終了
    
  ENDIF
  }
    
EVENT_END

/**************************************************************/
/*		POS：ヒードラン部屋						  */
/**************************************************************/
EVENT_START		ev_pos_d24r0301_room_01
  
  //主人名名格納
  _PLAYER_NAME( 0 )
  
  //主人公方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //アニメ：ベル「！」・主人公振り向き
  _OBJ_ANIME( PAIR_TRAINER_01, anm_common_gyoe )
  
  _TIME_WAIT(8)
  
  IF $LWK_DIR == DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  ENDIF
  
  _OBJ_ANIME_WAIT()
  
  //ベル：上を向く
  _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  IF $LWK_DIR == DIR_RIGHT THEN
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_r )
  ELSE
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_l )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //ベル：ここって
  _BALLOONWIN_OBJMSG_MF( msg_d24r0301_swbell_05,msg_d24r0301_swbell_06, PAIR_TRAINER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //==================================//
  //ヒードラン部屋POS起動
  $WK_SCENE_D24_BELL_COMMENT = 2
  //==================================//
    
EVENT_END

/**************************************************************/
/*		話しかけ：ベル						  */
/**************************************************************/
EVENT_START		ev_d24r0301_swbell_02
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d24r0301_swbell_18 )
EVENT_END

/**************************************************************/
/*		CALL：振り向きアニメ						  */
/**************************************************************/
ev_player_return_anm:
  
  //主人公方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  SWITCH $LWK_DIR
  CASE DIR_LEFT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_l )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_r )
  CASE DIR_UP THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_u )
  CASE DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_d )
  ENDSWITCH
  
  _OBJ_ANIME_WAIT()
  
_RET

/************************************************************/
/*	せいそくちリストサブイベント						*/
/************************************************************/
EVENT_START	ev_d24r0301_assitantm_01
	//イベント終了前か？
	IF FLAG_OFF( FE_C04R0801_ITEMGET_02 ) THEN

		_TALK_OBJ_START()
		
		//あら？
		_BALLOONWIN_TALKOBJ_MSG(msg_d24r0301_list_01)
		
		//せいそくちリストが埋まっているかチェック
		_SC_GET_ZONE_POKE_CMP_CHECK( ZONE_ID_D24 ,SCR_HABITAT_TYPE_LAND ,FALSE ,SCWK_ANSWER )

		//みたコンプしている場合
		IF $SCWK_ANSWER == TRUE THEN
		
			_BALLOONWIN_TALKOBJ_MSG(msg_d24r0301_list_03)
			_MSGWIN_CLOSE()
			
			_ITEM_EVENT_KEYWAIT( ITEM_TAIMAABOORU, 5 )
			
			//========================================//
			//イベント終了フラグセット
			_FLAG_SET(FE_C04R0801_ITEMGET_02)
			
			//========================================//

			//せいそくちリストの　きのうを
			_BALLOONWIN_TALKOBJ_MSG(msg_d24r0301_list_04)
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		ELSE
			
			//うまってないんだね
			_BALLOONWIN_TALKOBJ_MSG(msg_d24r0301_list_02)
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		ENDIF


	//イベント終了後の場合
	ELSE

		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_d24r0301_list_04 )

	ENDIF

EVENT_END


//--------------------------------------------------------------------
//	☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_staystep_u
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_d
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_l
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_r
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：はてな
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_hatena
	_ANIME_DATA	AC_MARK_HATENA,1
	_ANIME_DATA	ACMD_END,0
