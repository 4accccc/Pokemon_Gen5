//
//    スクリプトファイル：c09r0501用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c09r0501.h"
  .include  "c09r0501.h"
  .include  "c09r0601_def.h"

  //@author fujimura_souichirou]
  //@author Mizuguchi_Mai （トレーナーデータ差し替え）
  //@author suginaka_katsunori //演出調整

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_pos_c09r0501_lighting_01
_EVENT_DATA   ev_c09r0501_swchampion_01
_EVENT_DATA_END

//主人公座標取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
DEFINE_LOCAL  LCW_INDEX
DEFINE_LOCAL  LCW_FRONT
DEFINE_LOCAL  LCW_SIDE
DEFINE_LOCAL	LWK_SEX

//------------------------------注意--------------------------------//
//                                                                  //
//  LOCALWORK0 をギミックの制御に使用しています。                   //
//    0 = POSイベント有効                                           //
//                                                                  //
//------------------------------------------------------------------//

/************************************************************/
/*  POS:チャンピオン（ライトオン／ストッパー）              */
/************************************************************/
EVENT_START ev_pos_c09r0501_lighting_01

  //POS起動１回目か
  IF $LOCALWORK1 == 0 THEN

	_TIME_WAIT( 30 )

	//アイリス：ようこそ
	_BALLOONWIN_OBJMSG_POS( msg_c09r0501_swchampion_00, C09R0501_SWCHAMPION_01, POS_UP )
	_MSGWIN_CLOSE()
	
	//照明が点灯
	_CHAMPION_LIGHTING()
	//ビル影OFF
	_CHAMPION_LIGHT_ATTR_OFF( C09R0501_SWCHAMPION_01 )
	_CHAMPION_LIGHT_ATTR_OFF( MMDL_ID_PLAYER )
	_SE_PLAY( SEQ_SE_SW_CHAMPIRIS_01 )    // 部屋の照明がつく音

	_TIME_WAIT( 60 )

	//チャンピオン移動
	_OBJ_ANIME( C09R0501_SWCHAMPION_01, anm_champion_walk_down_01 )
	_OBJ_ANIME_WAIT()

	//アイリス：まってたよー！
	_BALLOONWIN_OBJMSG_POS( msg_c09r0501_swchampion_01, C09R0501_SWCHAMPION_01, POS_UP )
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()

	//=====================================
	//２回目以降はストッパーとして機能
	$LOCALWORK1 = 1
	//=====================================

  //POS起動２回目以降
  ELSE

	//アイリス：ええー！
	_BALLOONWIN_OBJMSG_POS( msg_c09r0501_swchampion_05, C09R0501_SWCHAMPION_01, POS_UP )
	_MSGWIN_CLOSE()

  ENDIF

_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
_OBJ_ANIME_WAIT()

EVENT_END

/************************************************************/
/*  チャンピオン（アイリス）：話しかけ                      */
/************************************************************/
EVENT_START ev_c09r0501_swchampion_01

_TALK_OBJ_START()

//カメラ操作 //
_CAMERA_START()//カメラ操作開始
_CAMERA_PURGE()//カメラのバインドを解く
_CAMERA_MOVE( 10317,0,466944,1081344,852175,3256320, 60 )
//6477,0,774144,1077248,852175,3022848   8141,0,630784,1077248,852175,3170304

_PLAYER_DIR_GET(SCWK_ANSWER)
SWITCH $SCWK_ANSWER
CASE DIR_LEFT THEN
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_ready_l )
CASE DIR_RIGHT THEN
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_ready_r )
CASE DIR_UP THEN
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_ready_u )
ENDSWITCH
_TIME_WAIT( 24 )
_OBJ_ANIME_AUTO( C09R0501_SWCHAMPION_01, 18, 40, FORCE_TYPE_NOT, 8, DIR_LR )
_CAMERA_WAIT_MOVE()  //カメラ移動待ち
_OBJ_ANIME_WAIT()
_CAMERA_END()		//カメラ操作終了
_OBJ_ANIME( C09R0501_SWCHAMPION_01, anm_staystep_l )
_OBJ_ANIME_WAIT()

_TIME_WAIT( 30 )

//ゲームクリア前後で分岐
IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

	//アイリス：あたしね　つよい　トレーナーとの
	_BALLOONWIN_OBJMSG_POS( msg_c09r0501_swchampion_02, C09R0501_SWCHAMPION_01, POS_UP )
	_MSGWIN_CLOSE()
    
	_OBJ_ANIME( C09R0501_SWCHAMPION_01, anm_walk_l )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
	_OBJ_ANIME_WAIT()

{
  //難易度取得ワーク定義
  DEFINE_LOCAL  LCW_DIFFICULTY
  
  //現在の難易度を取得
  _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
  
  //トレーナー戦呼び出し
  
  //むずかしい
  IF $LCW_DIFFICULTY == 2 THEN
    _TRAINER_BTL_SET( TRID_SWCHAMPION_03, 0 )
  
  //ふつう・かんたん
  ELSE
    _TRAINER_BTL_SET( TRID_SWCHAMPION_01, 0 )
  ENDIF

}
	
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
		_CALL ev_vanish
		_TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
	ELSE
		_TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF

//クリア後（２回目以降）
ELSE

	//アイリス：ここにくるのは　こころの　そこから
	_BALLOONWIN_OBJMSG_POS( msg_c09r0501_swchampion_03, C09R0501_SWCHAMPION_01, POS_UP )
	_MSGWIN_CLOSE()

	_OBJ_ANIME( C09R0501_SWCHAMPION_01, anm_walk_l )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
	_OBJ_ANIME_WAIT()

{
  //難易度取得ワーク定義
  DEFINE_LOCAL  LCW_DIFFICULTY
  
  //現在の難易度を取得
  _KEYSYS_GET_DIFFICULTY( LCW_DIFFICULTY )
  
  //トレーナー戦呼び出し
  
  //むずかしい
  IF $LCW_DIFFICULTY == 2 THEN
    _TRAINER_BTL_SET( TRID_SWCHAMPION_04, 0 )
  
  //ふつう・かんたん
  ELSE
    _TRAINER_BTL_SET( TRID_SWCHAMPION_02, 0 )
  ENDIF

}

	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
		_CALL ev_vanish
		_TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
	ELSE
		_TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF

ENDIF

_TIME_WAIT( 8 )

//アイリス：かてなくて　くやしいよ！▼
_BALLOONWIN_OBJMSG_POS( msg_c09r0501_swchampion_04, C09R0501_SWCHAMPION_01, POS_UP )
_MSGWIN_CLOSE()

_CAMERA_RECV_MOVE(60)

//アニメ：アイリスと主人公振り向き
_OBJ_ANIME( C09R0501_SWCHAMPION_01, anm_staystep_u )
_TIME_WAIT( 8 )
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_u )
_OBJ_ANIME_WAIT()

_CAMERA_WAIT_MOVE()
_CAMERA_BIND()		//カメラのバインドを解く
_CAMERA_END()

//殿堂入り部屋出現
_CHAMPION_HALL_ROOM()

//========================================
//== アニメメモ ==========================
// 
// 総アニメ数 370F
// ドラゴンの石造が沈む 130F ～ 216F
//  壁に穴があいて、はしご用のロープが出てくる  235F ～ 307F
//  はしご用のステップが出てくる 312F ～ 350F

_SE_PLAY( SEQ_SE_SW_CHAMPIRIS_02 )    // 星座板の４つの石が回る音
_SE_PLAY( SEQ_SE_SW_CHAMPIRIS_06 )    // 

_TIME_WAIT( 130 )
_SE_PLAY( SEQ_SE_SW_CHAMPIRIS_03 )    // ドラゴンの石像が沈む音

_TIME_WAIT( 105 )
_SE_PLAY( SEQ_SE_SW_CHAMPIRIS_04 )    // 壁に穴があいて、はしご用のロープが出てくる音

_TIME_WAIT( 77 )
_SE_PLAY( SEQ_SE_SW_CHAMPIRIS_05 )    // はしご用のステップが出てくる音

_TIME_WAIT( 58 )  //殿堂入り部屋出現演出待ち

//========================================

_TIME_WAIT( 16 )  //間

//アニメ：チャンピオン移動（殿堂入り部屋へ）
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_player_work_up_01 )
_TIME_WAIT( 8 )
_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_work_up_01a )
_TIME_WAIT( 8 )
_OBJ_ANIME( C09R0501_SWCHAMPION_01, anm_champion_walk_up_01 )
_OBJ_ANIME_WAIT()
  
// ビル影ON
_CHAMPION_LIGHT_ATTR_ON( C09R0501_SWCHAMPION_01 )
_CHAMPION_LIGHT_ATTR_ON( MMDL_ID_PLAYER )
_CHAMPION_LIGHT_ATTR_ON( MMDL_ID_EVENTOBJ_00 )

//マップチェンジ後以下のスクリプトを起動する
_RESERVE_SCRIPT( SCRID_RESERVE_C09R0601_SWCHAMPION_01 )

//殿堂入り部屋へシーン切り替え
_MAP_CHANGE( ZONE_ID_C09R0601, 8, 19, DIR_UP )

EVENT_END

ev_vanish:

_OBJ_POS_CHANGE( MMDL_ID_PLAYER, 16, 13, 40, DIR_RIGHT )
_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_on )
_OBJ_ANIME_WAIT()

_GET_MY_SEX( LWK_SEX )

SWITCH $LWK_SEX
CASE PM_MALE THEN
	_OBJ_ADD_EX( 15, 40, DIR_RIGHT, MMDL_ID_EVENTOBJ_00, SWHERO, MV_DMY )
CASE PM_FEMALE THEN
	_OBJ_ADD_EX( 15, 40, DIR_RIGHT, MMDL_ID_EVENTOBJ_00, SWHEROINE, MV_DMY )
ENDSWITCH
  // 同時にビル影OFFしておく
	_CHAMPION_LIGHT_ATTR_OFF( MMDL_ID_EVENTOBJ_00 )

//カメラ操作 //
_CAMERA_START()//カメラ操作開始
_CAMERA_PURGE()//カメラのバインドを解く
_CAMERA_MOVE( 10317,0,466944,1081344,852175,3256320, 1 )
_CAMERA_WAIT_MOVE()	//カメラ移動待ち

_RET

//--------------------------------------------------------------------
//主人公：一歩前へ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_vs_champion_stairs_up
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//主人公：チャンピオンの前へ01
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_ready_r
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_ready_l
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_WALK_L_8F,3
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_ready_u
  _ANIME_DATA AC_WALK_L_8F,2
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//主人公：殿堂入り部屋へ01
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_work_up_01
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_WALK_U_8F,21
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_player_work_up_01a
  _ANIME_DATA AC_WALK_U_8F,21
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//チャンピオン：椅子から降りる
//--------------------------------------------------------------------
_ANIME_LABEL  anm_champion_walk_down_01
  _ANIME_DATA AC_WALK_D_8F,4
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//チャンピオン：定位置へa
//--------------------------------------------------------------------
_ANIME_LABEL  anm_champion_walk_a
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_WALK_D_8F,2
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//チャンピオン：定位置へb
//--------------------------------------------------------------------
_ANIME_LABEL  anm_champion_walk_b
  _ANIME_DATA AC_WALK_D_8F,2
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//チャンピオン：殿堂入り部屋へ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_champion_walk_up_01
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_U_8F,20
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL  anm_staystep_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_staystep_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_d
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_walk_u
  _ANIME_DATA AC_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_walk_r
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_walk_l
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//-----------------------------------------------------------
//☆共通処理：非表示にする
//-----------------------------------------------------------
_ANIME_LABEL	anm_vanish_on
	_ANIME_DATA	AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0


