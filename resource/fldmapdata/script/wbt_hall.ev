/**************************************************************/
/*		決勝戦　対戦者用声援スクリプト						  */
/**************************************************************/
ev_yell_final_enemy:

_WBT_GET_VICTORY_COUNT( LWK_WIN_COUNT )

//優勝回数が１以下の場合
IF $LWK_WIN_COUNT <= 1 THEN
	
	//優勝回数1回の場合は２０％
	$LWK_PROBABILITY = 19
	
	//メッセージ表示のコールスクリプト
	_CALL ev_rnd_yell_msg_final_enemy

//優勝回数が５以上の場合
ELSIF $LWK_WIN_COUNT >= 5 THEN

	//優勝回数５回の場合は４０％
	$LWK_PROBABILITY = 39
	
	//メッセージ表示のコールスクリプト
	_CALL ev_rnd_yell_msg_final_enemy

//優勝回数が１０以上の場合
ELSIF $LWK_WIN_COUNT >= 10 THEN

	//優勝回数１０回の場合は６０％
	$LWK_PROBABILITY = 59
	
	//メッセージ表示のコールスクリプト
	_CALL ev_rnd_yell_msg_final_enemy

//優勝回数が３０以上の場合
ELSIF $LWK_WIN_COUNT >= 30 THEN

	//優勝回数３０回の場合は８０％
	$LWK_PROBABILITY = 79
	
	//メッセージ表示のコールスクリプト
	_CALL ev_rnd_yell_msg_final_enemy

//異常処理
ELSE

ENDIF

_RET

