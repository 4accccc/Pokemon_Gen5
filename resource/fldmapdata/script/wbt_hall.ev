//======================================================================
//                wbt_hall.ev
//
//    スクリプトファイル：wbt_hall用
//
//    2011.02.21  tamada@gamefreak.co.jp
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_wbt_hall.h"
  .include	"wbt_lobby_def.h"

//----------------------------------------------------------------------
//               スクリプトテーブル
//----------------------------------------------------------------------
_EVENT_DATA		ev_wbt_hall_01
_EVENT_DATA		ev_debug_wbt_second_game
_EVENT_DATA		ev_debug_wbt_final_game
_EVENT_DATA_END

DEFINE_LOCAL	LWK_WIN_COUNT	//優勝回数取得
DEFINE_LOCAL	LWK_RND			//乱数取得
DEFINE_LOCAL	LWK_MSG			//ランダムメッセージ取得用
DEFINE_LOCAL	LWK_PROBABILITY	//確率取得
DEFINE_LOCAL	LWK_YELL_POSX	//サブウィンのX座標
DEFINE_LOCAL	LWK_YELL_POSY	//サブウィンのY座標
DEFINE_LOCAL	LWK_SUBWIN_NUM	//サブウィンのNo
DEFINE_LOCAL	LWK_WIN_OR_LOSE
DEFINE_LOCAL	LWK_FIRST		//初回イベントかどうかを取得
DEFINE_LOCAL	LWK_CUP			//トーナメントの種類取得
DEFINE_LOCAL	LWK_EFFECT		//アニメ再生するエフェクトを格納
DEFINE_LOCAL	LWK_POKETYPE	//タイプエキスパート判別用
DEFINE_LOCAL	LWK_POSITION	//声援・自分か相手か判別用

/********************************************************************/
/*						FIELD_INIT_LABEL							*/
/********************************************************************/

/********************************************************************/
/*						FIELD_RECOVER_LABEL							*/
/********************************************************************/


/********************************************************************/
/*		ＷＢＴ１回戦												*/
/********************************************************************/
EVENT_START ev_wbt_hall_01

	_CALL ev_first_game
	
	//負けた場合
	IF $LWK_WIN_OR_LOSE != SCR_WBT_BATTLE_RESULT_WIN THEN
	
    //ビーコン発信：WBT敗北
    _WBT_GET_WBT_CUP( SCWK_ANSWER )
    _BEACON_SET_REQ_WBT_LOSE( SCWK_ANSWER, 0 )   //0勝＝１回戦敗北
		//WBT会場　終了処理
		_CALL ev_wbt_hall_exit
	
	//勝った場合
	ELSE
		
    //ビーコン発信：WBT勝利
    _WBT_GET_WBT_CUP( SCWK_ANSWER )
    _BEACON_SET_REQ_WBT_WIN( SCWK_ANSWER, 1 )    //１勝＝１回戦突破
		//２回戦へ
		_CALL ev_second_game
	
		//負けた場合
		IF $LWK_WIN_OR_LOSE != SCR_WBT_BATTLE_RESULT_WIN THEN
		
      //ビーコン発信：WBT敗北
      _WBT_GET_WBT_CUP( SCWK_ANSWER )
      _BEACON_SET_REQ_WBT_LOSE( SCWK_ANSWER, 1 ) //１勝=二回戦敗北
			//WBT会場　終了処理
			_CALL ev_wbt_hall_exit
		
		//勝った場合
		ELSE
		
      //ビーコン発信：WBT勝利
      _WBT_GET_WBT_CUP( SCWK_ANSWER )
      _BEACON_SET_REQ_WBT_WIN( SCWK_ANSWER, 2 )  //２勝=二回戦突破
			//決勝戦へ
			_CALL ev_final_game
			
    		//負けた場合
    		IF $LWK_WIN_OR_LOSE != SCR_WBT_BATTLE_RESULT_WIN THEN

				//プレイヤー負け（相手が勝ち）演出のナンバー指定
				$LWK_WIN_OR_LOSE = SCR_WBT_BATTLE_RESULT_LOSE
				_CALL ev_final_result

        //ビーコン発信：WBT敗北
        _WBT_GET_WBT_CUP( SCWK_ANSWER )
        _BEACON_SET_REQ_WBT_LOSE( SCWK_ANSWER, 2 ) //２勝=決勝で敗北
			//勝った場合
			ELSE
			
				//プレイヤー勝ち演出のナンバー指定
				$LWK_WIN_OR_LOSE = SCR_WBT_BATTLE_RESULT_WIN
				_CALL ev_final_result

				//WBTシステムに状態を通知：勝利！
				_WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_WIN )

        //ビーコン発信：WBT勝利
        _WBT_GET_WBT_CUP( SCWK_ANSWER )
        _BEACON_SET_REQ_WBT_WIN( SCWK_ANSWER, 3 )  //３勝=優勝
			ENDIF

			//WBT会場　終了処理
			_CALL ev_wbt_hall_exit
			
		ENDIF
		
	ENDIF
	
_CAMERA_END()

EVENT_END

/**************************************************************/
//    WBT会場　終了処理
/**************************************************************/
ev_wbt_hall_exit:

	_END_EVENT_BGM()

	_SE_STOP()

	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_WBT_EXIT )
	
	//マップチェンジ
	_WBT_GET_RECEPTION_ID( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_WBT_RECEPTION1 THEN
		_MAP_CHANGE( ZONE_ID_D05R0101, 14, 0, DIR_DOWN )
	ELSIF $SCWK_ANSWER == SCR_WBT_RECEPTION2 THEN
		_MAP_CHANGE( ZONE_ID_D05R0101, 16, 0, DIR_DOWN )
	ENDIF

_RET

/**************************************************************/
/*		ＷＢＴ２回戦から		デバッグ用					  */
/**************************************************************/
EVENT_START		ev_debug_wbt_second_game

//↓↓↓　本当は受付で行う初期化処理をデバッグ用にここで呼び出し
_WBT_SYSTEM_START()
_WBT_SET_WBT_CUP( SCR_WBT_CUP_HODOMOE )
_WBT_SET_BATTLE_RULE( SCR_WBT_RULE_SINGLE )
_WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_1ST )
_WBT_SYSTEM_ENTRY()
//↑↑↑　本当は受付で行う初期化処理をデバッグ用にここで呼び出し

	_WBT_GET_ENEMY_MMDL_CODE( OBJCHRWORK0 )
	_OBJ_ADD_EX( 21,15,DIR_RIGHT,MMDL_ID_EVENTOBJ_00,WKOBJCODE00,MV_DMY )

	//カメラ移動・中央固定　
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//カメラ操作　ステージ中央にカメラを合わせる
	_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()

	_CALL ev_second_game

	//マップチェンジ
	_MAP_CHANGE( ZONE_ID_D05R0101, 15, 0, DIR_DOWN )

	_CAMERA_END()

	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_WBT_EXIT )
  //_WBT_SYSTEM_END()   //とりあえず・受付で後処理が必要な場合は移動する

EVENT_END

/**************************************************************/
/*		ＷＢＴ決勝戦から		デバッグ用					  */
/**************************************************************/
EVENT_START		ev_debug_wbt_final_game

  //↓↓↓　本当は受付で行う初期化処理をデバッグ用にここで呼び出し
  _WBT_SYSTEM_START()
  _WBT_SET_WBT_CUP( SCR_WBT_CUP_HODOMOE )
  _WBT_SET_BATTLE_RULE( SCR_WBT_RULE_SINGLE )
  _WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_2ND )
  _WBT_SYSTEM_ENTRY()
  //↑↑↑　本当は受付で行う初期化処理をデバッグ用にここで呼び出し

	_WBT_GET_ENEMY_MMDL_CODE( OBJCHRWORK0 )
	_OBJ_ADD_EX( 21,15,DIR_RIGHT,MMDL_ID_EVENTOBJ_00,WKOBJCODE00,MV_DMY )

	_CALL ev_final_game

  IF $LWK_WIN_OR_LOSE != SCR_WBT_BATTLE_RESULT_WIN THEN
  //負けた場合
    
    //プレイヤー負け（相手が勝ち）演出のナンバー指定
    $LWK_WIN_OR_LOSE = SCR_WBT_BATTLE_RESULT_LOSE
    _CALL ev_final_result

  ELSE
  //勝った場合
  
    //プレイヤー勝ち演出のナンバー指定
    $LWK_WIN_OR_LOSE = SCR_WBT_BATTLE_RESULT_WIN
    _CALL ev_final_result
    
  ENDIF

	//マップチェンジ
	_MAP_CHANGE( ZONE_ID_D05R0101, 15, 0, DIR_DOWN )

	_CAMERA_END()


	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_WBT_EXIT )
  //_WBT_SYSTEM_END()   //とりあえず・受付で後処理が必要な場合は移動する
EVENT_END

/**************************************************************/
/*		ＷＢＴ１回戦										  */
/**************************************************************/
ev_first_game:

//バックの歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_07)

//トーナメントリスト表示
_WBT_LIST_CALL( SCR_WBT_LIST_1ST_START )

//WBTシステムに状態を通知：1回戦へ
_WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_1ST )

_WBT_GET_WBT_CUP(LWK_CUP)

//初回イベントトーナメントかどうかをチェック
IF $LWK_CUP == SCR_WBT_CUP_HODOMOE_EVENT THEN

	//対戦者・プレイヤー指定座標に表示
	_WBT_GET_ENEMY_MMDL_CODE( OBJCHRWORK0 )
	_OBJ_ADD_EX( 3,15,DIR_RIGHT,MMDL_ID_EVENTOBJ_00,WKOBJCODE00,MV_DMY )
	_OBJ_POS_CHANGE( MMDL_ID_PLAYER, 42, 0, 15, DIR_LEFT )

	//プレイヤー・対戦者非表示
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_vanish_on )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_on )
	_OBJ_ANIME_WAIT()

	_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_ALL)

	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
	
	//カメラ操作　プレイヤー入場口にカメラを合わせる
	_CAMERA_MOVE( 3544,0,970752,2801664,131103,1081344,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()

	//バックの歓声ＳＥ再生
	_SE_PLAY(SEQ_SE_SW_WBT_07)

	//暗転復帰
	_MAP_FADE_BLACK_IN()
	_MAP_FADE_END_CHECK()

	_PLAYER_NAME(1)

	//初挑戦！
	_PLAINWIN_MSG_UP( msg_wbt_announce_13 )
	_PLAINWIN_CLOSE()

	//プレイヤー非表示解除後
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_off )
	_OBJ_ANIME_WAIT()

	//プレイヤー中央のステージまで歩き出す
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_3rd_in )

	//カメラプレイヤー追従
	_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,146 )		//一番最後の引数は移動にかかるフレーム数

	_OBJ_ANIME_WAIT()
	_CAMERA_WAIT_MOVE()

	_TIME_WAIT( 30 )

//それ以外の場合
ELSE

	//対戦者指定座標へ
	_WBT_GET_ENEMY_MMDL_CODE( OBJCHRWORK0 )
	_OBJ_ADD_EX( 3,15,DIR_RIGHT,MMDL_ID_EVENTOBJ_00,WKOBJCODE00,MV_DMY )

	//対戦者非表示
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_vanish_on )
	_OBJ_ANIME_WAIT()

	//カメラ移動・中央固定　
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//カメラ操作　ステージ中央にカメラを合わせる
	_CAMERA_MOVE( 3545,64990,970863,1515520,438303,1015808,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()

	//背景ビジョンにロゴ表示
	_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_ALL)

	//ブラックイン開始
	_MAP_FADE_BLACK_IN_SLOW()

	//カメラ操作　ステージ中央にカメラを合わせる
	_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,48 )	//一番最後の引数は移動にかかるフレーム数

	//プレイヤーをステージ中央まで移動させる
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_1st_in )

	_CAMERA_WAIT_MOVE()

	_MAP_FADE_END_CHECK()

	_OBJ_ANIME_WAIT()

	_TIME_WAIT( 30 )

ENDIF

//カメラを対戦者側に移動
_CAMERA_MOVE( 3544,0,970752,208896,131103,1081344,60 )	//一番最後の引数は移動にかかるフレーム数

//暗転処理
_BLACK_OUT()
_DISP_FADE_END_CHECK()
	
_TIME_WAIT( 60 )
	
//暗転復帰
_BLACK_IN()
_DISP_FADE_END_CHECK()

//対戦者の前口上メッセージ表示　ＭＳＧ表示専用コマンド
_WBT_ANNOUNCE( POS_UP )
_MSGWIN_CLOSE()

//対戦者非表示解除後
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_vanish_off )
_OBJ_ANIME_WAIT()

//対戦者中央のステージまで歩き出す
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_enemy_1st_in )

//カメラ対戦者追従
_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,78 )	//一番最後の引数は移動にかかるフレーム数

_TIME_WAIT( 20 )

//暗転処理
_BLACK_OUT()
_DISP_FADE_END_CHECK()

_TIME_WAIT( 50 )

//暗転復帰
_BLACK_IN()
_DISP_FADE_END_CHECK()

_OBJ_ANIME_WAIT()
_CAMERA_WAIT_MOVE()

//対戦相手の手持ち生成処理
_WBT_SETUP_ENEMY_PARTY()

//ミックスバトルの場合は交換処理へ
IF $LWK_CUP == SCR_WBT_CUP_MIX || $LWK_CUP == SCR_WBT_CUP_MIXMASTER THEN
  _CALL ev_mix_pokemon
ENDIF

//１回戦の対戦者名を格納する
_WBT_SET_ENEMY_NAME( 0 )

//プレイヤー名を格納する
_PLAYER_NAME( 1 )
	
//第１回戦　対戦者 VS プレイヤー
_PLAINWIN_MSG_UP( msg_wbt_announce_01 )
_PLAINWIN_CLOSE()

//VSカット用SE
_SE_PLAY(SEQ_SE_SW_WBT_16)

//背景ビジョンにVS表示
_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_VS)

_TIME_WAIT( 29 )

_SE_PLAY(SEQ_SE_SW_WBT_21)

_TIME_WAIT( 31 )

_SE_PLAY(SEQ_SE_SW_WBT_22)

_TIME_WAIT( 30 )

//１回戦対戦前メッセージの表示　ＭＳＧ表示専用コマンド
_WBT_TRAINER_MSG( SCR_WBT_TRMSG_1ST, MMDL_ID_EVENTOBJ_00 )
_BALLOONWIN_CLOSE()

_SE_STOP()

_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_r )
_OBJ_ANIME_WAIT()

//戦闘開始　バトル専用コマンド
_WBT_TRAINER_BATTLE( LWK_WIN_OR_LOSE )

//バックの歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_07)

//背景ビジョンにロゴ表示
_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_ALL)

//カメラ移動・中央固定　
_CAMERA_START()		//カメラ操作開始
_CAMERA_PURGE()		//カメラのバインドを解く

//カメラ操作　ステージ中央にカメラを合わせる
_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,1 )	//一番最後の引数は移動にかかるフレーム数
_CAMERA_WAIT_MOVE()

_MAP_FADE_BLACK_IN_FORCE()  //仮：乱用していいコマンドではない
_MAP_FADE_END_CHECK()
//結果チェック( _WBT_TRAINER_BATTLE の戻り値LWK_WIN_OR_LOSEをチェック）
IF $LWK_WIN_OR_LOSE == SCR_WBT_BATTLE_RESULT_WIN THEN
//勝った場合
	
	//プレイヤー名を格納
	_PLAYER_NAME(0)

	//歓声ＳＥ再生
	_SE_PLAY(SEQ_SE_SW_WBT_02)
		
	//第１回戦を制したのは！
	_GIZAPLAINWIN_MSG_POS( msg_wbt_announce_06, POS_UP )

  IF $LWK_CUP == SCR_WBT_CUP_CHAMPION || $LWK_CUP == SCR_WBT_CUP_WORLD THEN
    _CALL ev_special_result_msg
  ENDIF

	_GIZAPLAINWIN_CLOSE()

	//対戦者・主人公勝ちメッセージ表示
	_WBT_TRAINER_MSG( SCR_WBT_TRMSG_PLAYER_WIN, MMDL_ID_EVENTOBJ_00 )
	_BALLOONWIN_CLOSE()

	//対戦者退場
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_enemy_1st_out )
	_OBJ_ANIME_WAIT()

	//プレイヤー退場
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_1st_out )
	_OBJ_ANIME_WAIT()

  //対戦者OBJの削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

ELSE
	//負けた場合 
 
	//１回戦の対戦者名を格納する
	_WBT_SET_ENEMY_NAME( 0 )

	//歓声ＳＥ再生
	_SE_PLAY(SEQ_SE_SW_WBT_02)

	//第１回戦を制したのは！
	_GIZAPLAINWIN_MSG_POS( msg_wbt_announce_06, POS_UP )
	_GIZAPLAINWIN_CLOSE()
 
	//対戦負けメッセージの表示　ＭＳＧ表示専用コマンド
	_WBT_TRAINER_MSG( SCR_WBT_TRMSG_PLAYER_LOSE, MMDL_ID_EVENTOBJ_00 )
	_BALLOONWIN_CLOSE()
 
	//プレイヤー退場アニメ
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_lose )
	_OBJ_ANIME_WAIT()

ENDIF

_CAMERA_END()

_RET

/**************************************************************/
/*		ＷＢＴ２回戦										  */
/**************************************************************/
ev_second_game:

//ほかの対戦結果は
_PLAINWIN_MSG_UP( msg_wbt_announce_08 )
_PLAINWIN_CLOSE()

_MAP_FADE_BLACK_OUT_SLOW()

//ビジョンへズームイン
_SE_PLAY(SEQ_SE_SW_WBT_20)

//カメラ操作　ビジョンにカメラをズーム
_CAMERA_MOVE( 3554,0,970572,1507328,172063,352256,18 )	//一番最後の引数は移動にかかるフレーム数

_MAP_FADE_END_CHECK()
_CAMERA_WAIT_MOVE()

//トーナメントリスト表示
_WBT_LIST_CALL( SCR_WBT_LIST_1ST_RESULT )

//WBTシステムに状態を通知：2回戦へ
_WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_2ND )

//対戦者・プレイヤー指定座標に表示
_WBT_GET_ENEMY_MMDL_CODE( OBJCHRWORK0 )
_OBJ_ADD_EX( 3,15,DIR_RIGHT,MMDL_ID_EVENTOBJ_00,WKOBJCODE00,MV_DMY )
_OBJ_POS_CHANGE( MMDL_ID_PLAYER, 31, 0, 15, DIR_LEFT )

//対戦者非表示
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_vanish_on )
_OBJ_ANIME_WAIT()

//カメラ移動・中央固定　
_CAMERA_START()		//カメラ操作開始
_CAMERA_PURGE()		//カメラのバインドを解く

//カメラ操作　ステージ中央にカメラを合わせる
_CAMERA_MOVE( 3554,0,970572,1507328,172063,352256,1 )	//一番最後の引数は移動にかかるフレーム数
_CAMERA_WAIT_MOVE()

//背景ビジョンにロゴ表示
_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_ALL)

//ブラックイン開始
_MAP_FADE_BLACK_IN_SLOW()
	
//歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_02)

//カメラ操作　ステージ中央にカメラを合わせる
_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,30 )	//一番最後の引数は移動にかかるフレーム数

//プレイヤーをステージ中央まで移動させる
_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_2nd_in )

_CAMERA_WAIT_MOVE()

_MAP_FADE_END_CHECK()

//自分側判定代入
$LWK_POSITION = 0

//声援表示・２回戦
_CALL ev_rnd_yell_msg_2nd

_OBJ_ANIME_WAIT()

_TIME_WAIT( 30 )

//カメラを対戦者側に移動
_CAMERA_MOVE( 3544,0,970752,208896,131103,1081344,60 )	//一番最後の引数は移動にかかるフレーム数

//暗転処理
_BLACK_OUT()
_DISP_FADE_END_CHECK()
	
_TIME_WAIT( 60 )
	
//暗転復帰
_BLACK_IN()
_DISP_FADE_END_CHECK()

//対戦者の前口上メッセージ表示　ＭＳＧ表示専用コマンド
_WBT_ANNOUNCE( POS_UP )
_MSGWIN_CLOSE()

//対戦者非表示解除後
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_vanish_off )
_OBJ_ANIME_WAIT()

//歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_07)

//対戦者中央のステージまで歩き出す
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_enemy_2nd_in )

//カメラ対戦者追従
_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,78 )	//一番最後の引数は移動にかかるフレーム数

_TIME_WAIT( 20 )

//暗転処理
_BLACK_OUT()
_DISP_FADE_END_CHECK()

_TIME_WAIT( 50 )

//暗転復帰
_BLACK_IN()
_DISP_FADE_END_CHECK()

//自分側判定代入
$LWK_POSITION = 1

//声援表示・２回戦
_CALL ev_rnd_yell_msg_2nd

_OBJ_ANIME_WAIT()
_CAMERA_WAIT_MOVE()

//対戦相手の手持ち生成処理
_WBT_SETUP_ENEMY_PARTY()

//ミックスバトルの場合は交換処理へ
IF $LWK_CUP == SCR_WBT_CUP_MIX || $LWK_CUP == SCR_WBT_CUP_MIXMASTER THEN
  _CALL ev_mix_pokemon
ENDIF

//２回戦の対戦者名を格納する
_WBT_SET_ENEMY_NAME( 0 )

//プレイヤー名を格納する
_PLAYER_NAME( 1 )

_TIME_WAIT( 30 )

//第２回戦　対戦者 VS プレイヤー
_PLAINWIN_MSG_UP( msg_wbt_announce_02 )
_PLAINWIN_CLOSE()

//VSカット用SE
_SE_PLAY(SEQ_SE_SW_WBT_16)

//背景ビジョンにVS表示
_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_VS)

_TIME_WAIT( 29 )

_SE_PLAY(SEQ_SE_SW_WBT_21)

_TIME_WAIT( 31 )

_SE_PLAY(SEQ_SE_SW_WBT_22)

_TIME_WAIT( 30 )

//２回戦対戦前メッセージの表示　ＭＳＧ表示専用コマンド
_WBT_TRAINER_MSG( SCR_WBT_TRMSG_2ND, MMDL_ID_EVENTOBJ_00 )
_BALLOONWIN_CLOSE()

_SE_STOP()

_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_r )
_OBJ_ANIME_WAIT()

//戦闘開始　バトル専用コマンド
_WBT_TRAINER_BATTLE( LWK_WIN_OR_LOSE )

//バックの歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_03)

//背景ビジョンにロゴ表示
_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_ALL)

//カメラ移動・中央固定　
_CAMERA_START()		//カメラ操作開始
_CAMERA_PURGE()		//カメラのバインドを解く

//カメラ操作　ステージ中央にカメラを合わせる
_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,1 )	//一番最後の引数は移動にかかるフレーム数
_CAMERA_WAIT_MOVE()

_MAP_FADE_BLACK_IN_FORCE()  //仮：乱用していいコマンドではない
_MAP_FADE_END_CHECK()

//歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_02)

//結果チェック( _WBT_TRAINER_BATTLE の戻り値LWK_WIN_OR_LOSEをチェック）
IF $LWK_WIN_OR_LOSE == SCR_WBT_BATTLE_RESULT_WIN THEN
//勝った場合
	
	//プレイヤー名を格納
	_PLAYER_NAME(0)

	//歓声ＳＥ再生
	_SE_PLAY(SEQ_SE_SW_WBT_02)

	//第２回戦を制したのは！
	_GIZAPLAINWIN_MSG_POS( msg_wbt_announce_07, POS_UP )

  IF $LWK_CUP == SCR_WBT_CUP_CHAMPION || $LWK_CUP == SCR_WBT_CUP_WORLD THEN
    _CALL ev_special_result_msg
  ENDIF

	_GIZAPLAINWIN_CLOSE()
	
	//煙幕音
	_SE_PLAY(SEQ_SE_SW_WBT_17)
	
	_WBT_GMK_EXPLOSION( SCR_WBT_VS2 )
	
	_TIME_WAIT( 60 )

	//対戦者・主人公勝ちメッセージ表示
	_WBT_TRAINER_MSG( SCR_WBT_TRMSG_PLAYER_WIN, MMDL_ID_EVENTOBJ_00 )
	_BALLOONWIN_CLOSE()

	//対戦者退場
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_enemy_2nd_out )
	_OBJ_ANIME_WAIT()
	
	//プレイヤー退場
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_2nd_out )
	_OBJ_ANIME_WAIT()

	//対戦者OBJの削除
	_OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

ELSE
	//負けた場合
	//２回戦の対戦者名を格納する
	_WBT_SET_ENEMY_NAME( 0 )

	//歓声ＳＥ再生
	_SE_PLAY(SEQ_SE_SW_WBT_02)

	//第２回戦を制したのは！
	_GIZAPLAINWIN_MSG_POS( msg_wbt_announce_07, POS_UP )
	_GIZAPLAINWIN_CLOSE()

	//煙幕音
	_SE_PLAY(SEQ_SE_SW_WBT_17)

	_WBT_GMK_EXPLOSION( SCR_WBT_VS2 )
	
	_TIME_WAIT( 60 )

	//対戦負けメッセージの表示　ＭＳＧ表示専用コマンド
	_WBT_TRAINER_MSG( SCR_WBT_TRMSG_PLAYER_LOSE, MMDL_ID_EVENTOBJ_00 )
	_BALLOONWIN_CLOSE()

	//プレイヤー退場アニメ
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_lose )
	_OBJ_ANIME_WAIT()

ENDIF

_RET

/**************************************************************/
/*		ＷＢＴ決勝戦										  */
/**************************************************************/
ev_final_game:

//ほかの対戦結果は
_PLAINWIN_MSG_UP( msg_wbt_announce_08a )
_PLAINWIN_CLOSE()

_MAP_FADE_BLACK_OUT_SLOW()

//ビジョンへズームイン
_SE_PLAY(SEQ_SE_SW_WBT_20)

//カメラ操作　ビジョンへズーム
_CAMERA_MOVE( 3554,0,970572,1507328,172063,352256,18 )	//一番最後の引数は移動にかかるフレーム数

_MAP_FADE_END_CHECK()
_CAMERA_WAIT_MOVE()

//決勝戦前のトーナメントリスト表示
_WBT_LIST_CALL( SCR_WBT_LIST_2ND_RESULT )

//WBTシステムに状態を通知：決勝戦
_WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_FINAL )

//対戦者・プレイヤー指定座標に表示
_WBT_GET_ENEMY_MMDL_CODE( OBJCHRWORK0 )
_OBJ_ADD_EX( 3,15,DIR_RIGHT,MMDL_ID_EVENTOBJ_00,WKOBJCODE00,MV_DMY )
_OBJ_POS_CHANGE( MMDL_ID_PLAYER, 42, 0, 15, DIR_LEFT )

//対戦者・プレイヤー非表示
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_vanish_on )
_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_on )
_OBJ_ANIME_WAIT()

_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_ALL)

//カメラ移動・中央固定　
_CAMERA_START()		//カメラ操作開始
_CAMERA_PURGE()		//カメラのバインドを解く

//カメラ操作　プレイヤー入場口にカメラを合わせる
_CAMERA_MOVE( 3544,0,970752,2801664,131103,1081344,1 )	//一番最後の引数は移動にかかるフレーム数
_CAMERA_WAIT_MOVE()

_SE_STOP()

//無音再生
_START_EVENT_BGM_SILENT( 30 )

_WBT_GMK_LIGHT_SET( 0, SCR_WBT_EFFECT_POS_R ) 

//暗転復帰
_MAP_FADE_BLACK_IN()
_MAP_FADE_END_CHECK()

_TIME_WAIT( 30 )

//プレイヤーの前口上メッセージ表示
_CALL ev_introductory_remarks

//バックの歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_07)

//プレイヤー非表示解除後
_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_off )
_OBJ_ANIME_WAIT()

_WBT_GMK_LIGHT_SET( 1, SCR_WBT_EFFECT_POS_R ) 

//BGM復帰
_BGM_NOW_MAP_RECOVER()

//トーナメントの種類を格納
_CALL ev_wbt_get_cup

_WBT_GMK_EFFECT_START( LWK_EFFECT ,SCR_WBT_EFFECT_POS_R)

//チャンピオンズトーナメントの場合のみタイムウェイト
IF $LWK_CUP == SCR_WBT_CUP_CHAMPION THEN

	_TIME_WAIT( 40 )

ENDIF

//歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_01)

//プレイヤー中央のステージまで歩き出す
_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_3rd_in )

//カメラプレイヤー追従
_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,146 )		//一番最後の引数は移動にかかるフレーム数

//声援表示・決勝戦自分
_CALL ev_rnd_yell_msg_3rd_player

_OBJ_ANIME_WAIT()
_CAMERA_WAIT_MOVE()

//煙幕音
_SE_PLAY(SEQ_SE_SW_WBT_18)

_WBT_GMK_EXPLOSION( SCR_WBT_VS1_R )

_TIME_WAIT( 60 )

//トーナメント名をセット
_WBT_GET_WBT_CUP( SCWK_ANSWER )
_WBT_SET_TOURNAMENT_NAME( 0, SCWK_ANSWER )

//～～トーナメント　決勝！
_PLAINWIN_MSG_UP( msg_wbt_announce_04 )
_PLAINWIN_CLOSE()

//カメラを対戦者側に移動
_CAMERA_MOVE( 3544,0,970752,208896,131103,1081344,60 )	//一番最後の引数は移動にかかるフレーム数

//暗転処理
_BLACK_OUT()
_DISP_FADE_END_CHECK()
	
_TIME_WAIT( 60 )

_WBT_GMK_LIGHT_SET( 0, SCR_WBT_EFFECT_POS_L ) 

_SE_STOP()

//暗転復帰
_BLACK_IN()
_DISP_FADE_END_CHECK()

//対戦者の前口上メッセージ表示　ＭＳＧ表示専用コマンド
_WBT_ANNOUNCE( POS_UP )
_MSGWIN_CLOSE()

//対戦者非表示解除後
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_vanish_off )
_OBJ_ANIME_WAIT()

_WBT_GMK_LIGHT_SET( 1, SCR_WBT_EFFECT_POS_L ) 

//トーナメントの種類を格納
_CALL ev_wbt_get_cup

_WBT_GMK_EFFECT_START( LWK_EFFECT ,SCR_WBT_EFFECT_POS_L)

//チャンピオンズトーナメントの場合のみタイムウェイト
IF $LWK_CUP == SCR_WBT_CUP_CHAMPION THEN

_TIME_WAIT( 40 )

ENDIF

//歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_01)

//対戦者中央のステージまで歩き出す
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_enemy_3rd_in )

//カメラ対戦者追従
_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,146 )	//一番最後の引数は移動にかかるフレーム数


//声援表示・決勝戦相手
_CALL ev_rnd_yell_msg_3rd_opponent

_OBJ_ANIME_WAIT()
_CAMERA_WAIT_MOVE()

//煙幕音
_SE_PLAY(SEQ_SE_SW_WBT_18)

_WBT_GMK_EXPLOSION( SCR_WBT_VS1_L )

_TIME_WAIT( 60 )

//対戦相手の手持ち生成処理
_WBT_SETUP_ENEMY_PARTY()

//ミックスバトルの場合は交換処理へ
IF $LWK_CUP == SCR_WBT_CUP_MIX || $LWK_CUP == SCR_WBT_CUP_MIXMASTER THEN
  _CALL ev_mix_pokemon
ENDIF

//決勝戦の対戦者名を格納する
_WBT_SET_ENEMY_NAME( 0 )

//プレイヤー名を格納する
_PLAYER_NAME( 1 )

//決勝戦！　プレイヤーｖｓ対戦者！
_PLAINWIN_MSG_UP( msg_wbt_announce_03 )
_PLAINWIN_CLOSE()

//VSカット用SE
_SE_PLAY(SEQ_SE_SW_WBT_16)

_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_VS)

_TIME_WAIT( 29 )

_SE_PLAY(SEQ_SE_SW_WBT_21)

_TIME_WAIT( 31 )

_SE_PLAY(SEQ_SE_SW_WBT_22)

_TIME_WAIT( 30 )

//決勝戦対戦前メッセージの表示　ＭＳＧ表示専用コマンド
_WBT_TRAINER_MSG( SCR_WBT_TRMSG_3RD, MMDL_ID_EVENTOBJ_00 )
_BALLOONWIN_CLOSE()

_SE_STOP()

_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_r )
_OBJ_ANIME_WAIT()

//煙と花火用SE
_SE_PLAY(SEQ_SE_SW_WBT_19)

_WBT_GMK_EXPLOSION( SCR_WBT_VS3 )

_TIME_WAIT( 30 )

_SE_WAIT()

//戦闘開始　バトル専用コマンド
_WBT_TRAINER_BATTLE( LWK_WIN_OR_LOSE )

//無音再生
_START_EVENT_BGM_SILENT( 1 )

//背景ビジョンにロゴ表示
_WBT_GMK_VISION_CHANGE(SCR_WBT_VISION_ALL)

//カメラ移動・中央固定　
_CAMERA_START()		//カメラ操作開始
_CAMERA_PURGE()		//カメラのバインドを解く

//カメラ操作　ステージ中央にカメラを合わせる
_CAMERA_MOVE( 2648,0,1069056,1515520,131103,962560,1 )	//一番最後の引数は移動にかかるフレーム数
_CAMERA_WAIT_MOVE()

_MAP_FADE_BLACK_IN_FORCE()  //仮：乱用していいコマンドではない
_MAP_FADE_END_CHECK()

_RET

//--------------------------------------------------------------------
//	１回戦用　ステージ入場アニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_1st_in
	_ANIME_DATA	AC_WALK_L_8F,6
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_enemy_1st_in
	_ANIME_DATA	AC_WALK_R_8F,6
	_ANIME_DATA	AC_WALK_R_2F,4
	_ANIME_DATA	AC_WALK_R_8F,7
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	１回戦用　ステージ退場アニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_enemy_1st_out
	_ANIME_DATA	AC_WALK_L_8F,7
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_1st_out
	_ANIME_DATA	AC_WALK_R_8F,7
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	２回戦用　ステージ入場アニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_2nd_in
	_ANIME_DATA	AC_WALK_L_8F,6
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_enemy_2nd_in
	_ANIME_DATA	AC_WALK_R_8F,6
	_ANIME_DATA	AC_WALK_R_2F,4
	_ANIME_DATA	AC_WALK_R_8F,7
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	２回戦用　ステージ退場アニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_enemy_2nd_out
	_ANIME_DATA	AC_WALK_L_8F,7
	_ANIME_DATA	ACMD_END,0
	
_ANIME_LABEL	anm_player_2nd_out
	_ANIME_DATA	AC_WALK_R_8F,7
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	決勝戦用　入場前の非表示アニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_vanish_on
	_ANIME_DATA	AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_vanish_off
	_ANIME_DATA	AC_VANISH_OFF,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	決勝戦用　ステージ入場アニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_3rd_in
	_ANIME_DATA	AC_WALK_L_8F,17
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_enemy_3rd_in
	_ANIME_DATA	AC_WALK_R_8F,17
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	プレイヤー負のアニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_lose
	_ANIME_DATA	AC_WALK_R_8F,7
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	共通アニメ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WAIT_8F,1
	_ANIME_DATA	AC_WALK_R_12F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l
	_ANIME_DATA	AC_WAIT_8F,1
	_ANIME_DATA	AC_WALK_L_12F,1
	_ANIME_DATA	ACMD_END,0


/**************************************************************/
/**************************************************************/
ev_final_result:

//優勝は……
_PLAINWIN_MSG_UP( msg_wbt_announce_05 )
_PLAINWIN_CLOSE()
				
_TIME_WAIT( 30 )

IF $LWK_WIN_OR_LOSE == SCR_WBT_BATTLE_RESULT_WIN THEN
	//プレイヤー名を格納する
	_PLAYER_NAME(0)

ELSE
	//決勝戦の対戦者名を格納する
	_WBT_SET_ENEMY_NAME( 0 )
ENDIF

//優勝演出用SE
_SE_PLAY(SEQ_SE_SW_WBT_15)

IF $LWK_WIN_OR_LOSE == SCR_WBT_BATTLE_RESULT_WIN THEN

	//プレイヤー側が勝利の背景ヴィジョン表示
	_WBT_GMK_VISION_CHANGE( SCR_WBT_VISION_WIN_PLAYER )
ELSE

	//対戦相手側が勝利の背景ヴィジョン表示
	_WBT_GMK_VISION_CHANGE( SCR_WBT_VISION_WIN_ENEMY )

ENDIF

//花吹雪演出
_WBT_GMK_WIN_EFFECT_START()

_TIME_WAIT( 80 )

//バックの歓声ＳＥ再生
_SE_PLAY(SEQ_SE_SW_WBT_07)

//歓声SE再生
_SE_PLAY(SEQ_SE_SW_WBT_03)

//～だー！
_GIZAPLAINWIN_MSG_POS( msg_wbt_announce_09, POS_UP )

//優勝BGM再生
_BGM_PLAY(SEQ_BGM_WBT_FANFARE)

_TIME_WAIT( 120 )
				
_AB_KEYWAIT_MARK()
_GIZAPLAINWIN_CLOSE()

IF $LWK_WIN_OR_LOSE == SCR_WBT_BATTLE_RESULT_WIN THEN

	//対戦者・主人公勝ちメッセージ表示　　　　　　
	_WBT_TRAINER_MSG( SCR_WBT_TRMSG_PLAYER_WIN, MMDL_ID_EVENTOBJ_00 )
ELSE
	//対戦負けメッセージの表示　ＭＳＧ表示専用コマンド
	_WBT_TRAINER_MSG( SCR_WBT_TRMSG_PLAYER_LOSE, MMDL_ID_EVENTOBJ_00 )
ENDIF

_BALLOONWIN_CLOSE()

//トーナメント名をセット
_WBT_GET_WBT_CUP( SCWK_ANSWER )
_WBT_SET_TOURNAMENT_NAME( 0, SCWK_ANSWER )
				
//終了の挨拶
_PLAINWIN_MSG_UP( msg_wbt_announce_10 )
_PLAINWIN_CLOSE()

_TIME_WAIT( 60 )

_RET

/**************************************************************/
/*    WBT・ミックスでのポケモンを交換する流れ */
/**************************************************************/
{
  DEFINE_LOCAL  LWK_LOOP
  DEFINE_LOCAL  LWK_PARTY_MAX
  DEFINE_LOCAL  LWK_SELECT_MONS
  DEFINE_LOCAL  LWK_TARGET_M
  DEFINE_LOCAL  LWK_TARGET_E

ev_mix_pokemon:
  //ミックストーナメント用初期化処理
  _WBT_MIX_INIT()

  //「ミックス開始だ！」
  _GIZAPLAINWIN_MSG_POS( msg_wbt_announce_16, POS_UP )
  //歓声ＳＥ再生
  _SE_PLAY( SEQ_SE_SW_WBT_01 )

  _TIME_WAIT( 30 )
  _MSGWIN_CLOSE()

  $LWK_TARGET_M = SCR_WBT_MIX_TARGET_MINE1
  $LWK_TARGET_E = SCR_WBT_MIX_TARGET_ENEMY1
  _CALL sub_mix_pokemon

  _WBT_GET_BATTLE_RULE( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_WBT_RULE_TRIPLE THEN
    //「ミックス開始だ！」
    _GIZAPLAINWIN_MSG_POS( msg_wbt_announce_25, POS_UP )
    //歓声ＳＥ再生
    _SE_PLAY( SEQ_SE_SW_WBT_01 )

    _TIME_WAIT( 30 )
    _MSGWIN_CLOSE()

    $LWK_TARGET_M = SCR_WBT_MIX_TARGET_MINE2
    $LWK_TARGET_E = SCR_WBT_MIX_TARGET_ENEMY2
    _CALL sub_mix_pokemon

  ENDIF
  //ミックス用のパーティ生成
  _WBT_SETUP_MIX_PARTY()
  _RET


sub_mix_pokemon:
  _WBT_MIX_RANDOM_SELECT( LWK_TARGET_M )
  //「相手が選んだポケモンは～です」
  _WBT_SET_ENEMY_NAME( 0 )
  _WBT_MIX_SELECTED_NAME( 1, LWK_TARGET_M )
  _SYSWIN_MSG( msg_wbt_announce_17, POS_UP )

  $LWK_LOOP = TRUE
  WHILE $LWK_LOOP == TRUE
    _WBT_MIX_INFO_WIN_OPEN()
    //「選んでください」
	_SYSWIN_MSG( msg_wbt_announce_18, POS_UP )
    //選択肢表示
    _BMPMENU_INIT_RIGHT( MENU_X3, MENU_Y3, 0, 0, LWK_SELECT_MONS )
    _WBT_MIX_LIST_START()
    _BMPMENU_START()
    _WBT_MIX_INFO_WIN_CLOSE()

    _WBT_GET_PARTY_MAX( LWK_PARTY_MAX )
    _DEBUG_PRINT_WK( LWK_SELECT_MONS )
    _DEBUG_PRINT_WK( LWK_PARTY_MAX )
    IF $LWK_SELECT_MONS < $LWK_PARTY_MAX THEN
      //結果を保存
      _WBT_MIX_SET_SELECT( LWK_TARGET_E, LWK_SELECT_MONS )
      //「～で　よろしいですね？」
      _WBT_MIX_SELECTED_NAME( 0, LWK_TARGET_E )
      _SYSWIN_MSG( msg_wbt_announce_19, POS_UP )
      _YES_NO_WIN( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_YES THEN
        $LWK_LOOP = FALSE
      ELSE
        //結果をクリア（最大数をセットする）
        _WBT_MIX_SET_SELECT( LWK_TARGET_E, LWK_PARTY_MAX )
      ENDIF
    ELSE
      //「そのポケモンはすでに選択済みです」
      _SYSWIN_MSG( msg_wbt_announce_26, POS_UP )
    ENDIF

  ENDWHILE

  _SYSWIN_CLOSE()

  //「それではミックス開始！」
  _GIZAPLAINWIN_MSG_POS( msg_wbt_announce_23, POS_UP )
  _MSGWIN_CLOSE()
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_enemy_mix_in )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_mix_in )
  _OBJ_ANIME_WAIT()

  _WBT_MIX_SELECTED_NAME( 0, LWK_TARGET_M )
  _SUBWIN_MSG( msg_wbt_yell_mix_01, 3, 3, 1 )
  _WBT_MIX_SELECTED_NAME( 0, LWK_TARGET_E )
  _SUBWIN_MSG( msg_wbt_yell_mix_01, 19, 16, 2 )

  _TIME_WAIT( 60 )

  _SUBWIN_CLOSE( 1 )
  _SUBWIN_CLOSE( 2 )

	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_enemy_mix_out )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_mix_out )
  _OBJ_ANIME_WAIT()

  //「～の～と　～の～を　こうかんしました」
  _PLAYER_NAME( 0 )
  _WBT_MIX_SELECTED_NAME( 1, LWK_TARGET_M )
  _WBT_SET_ENEMY_NAME( 2 )
  _WBT_MIX_SELECTED_NAME( 3, LWK_TARGET_E )
  _SYSWIN_MSG( msg_wbt_announce_24, POS_UP )
  _SYSWIN_CLOSE()
  _RET

}

//--------------------------------------------------------------------
//	ミックストーナメント　ミックス時一歩手前
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_mix_in
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_enemy_mix_in
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_player_mix_out
	_ANIME_DATA	AC_DIR_PAUSE_ON,1
  _ANIME_DATA AC_WALK_R_8F,1
	_ANIME_DATA	AC_DIR_PAUSE_OFF,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_enemy_mix_out
	_ANIME_DATA	AC_DIR_PAUSE_ON,1
  _ANIME_DATA AC_WALK_L_8F,1
	_ANIME_DATA	AC_DIR_PAUSE_OFF,1
	_ANIME_DATA	ACMD_END,0


/**************************************************************/
/*    WBT・特別メッセージ */
/**************************************************************/
ev_special_result_msg:

//生き残ったポケモン数を取得：０の場合はパーフェクトを示す
_WBT_GET_SURVIVAL_COUNT( SCWK_ANSWER )
IF $SCWK_ANSWER == 0 THEN
  _GIZAPLAINWIN_MSG_POS( msg_wbt_announce_15, POS_UP )
ELSE
  _NUMBER( 0, SCWK_ANSWER, 1 )
  _GIZAPLAINWIN_MSG_POS( msg_wbt_announce_14, POS_UP )
ENDIF

_RET

/**************************************************************/
/*		WBT・声援スクリプト									  */
/**************************************************************/
ev_yell_scr:

_WBT_GET_VICTORY_COUNT( SCR_WBT_CUP_NULL, POKETYPE_NULL, LWK_WIN_COUNT )

_DEBUG_PRINT_WK(LWK_WIN_COUNT)

//優勝回数が３０以上の場合
IF $LWK_WIN_COUNT >= 30 THEN
	
	//１００％
	$LWK_PROBABILITY = 99

//優勝回数が１０以上の場合
ELSIF $LWK_WIN_COUNT >= 10 THEN

	//８０％
	$LWK_PROBABILITY = 79

//優勝回数が５以上の場合
ELSIF $LWK_WIN_COUNT >= 5 THEN

	//６０％
	$LWK_PROBABILITY = 59

//優勝回数が０以上の場合
ELSIF $LWK_WIN_COUNT >= 0 THEN

	//４０％
	$LWK_PROBABILITY = 39

//異常処理
ELSE

ENDIF

_DEBUG_PRINT_WK(LWK_PROBABILITY)

_RET

/**************************************************************/
/*		声援　メッセージ表示のコール				  */
/**************************************************************/
ev_rnd_yell_msg_2nd:

SWITCH $LWK_POSITION
CASE 0 THEN	//自分側
	_CALL ev_yell_scr
CASE 1 THEN //相手側は１００％
	$LWK_PROBABILITY = 99	
ENDSWITCH

//声援決め乱数
_GET_RND( LWK_RND,100 )

_DEBUG_PRINT_WK(LWK_RND)

	//========================================/
	//ローカルワークの初期化
	$LOCALWORK14 = 0
	$LOCALWORK15 = 0
	//========================================/
	
	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN
	
		//X座標・Y座標・ナンバー決め
		$LWK_YELL_POSX = 3
		$LWK_YELL_POSY = 3
		$LWK_SUBWIN_NUM = 1
		
		SWITCH $LWK_POSITION
		CASE 0 THEN	//自分側
			_PLAYER_NAME(0)
		CASE 1 THEN //相手側
			_WBT_SET_ENEMY_NAME( 0 )
		ENDSWITCH

		_CALL sub_rnd_yell_msg_2nd
		
		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK14 = 1
		
		//========================================/
	
	ENDIF

	//声援決め乱数　２回目
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)

	//優勝回数に応じた確率で２つ目のメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN
	
		//X座標・Y座標・ナンバー決め
		$LWK_YELL_POSX = 19
		$LWK_YELL_POSY = 16
		$LWK_SUBWIN_NUM = 2
		
		SWITCH $LWK_POSITION
		CASE 0 THEN	//自分側
			_PLAYER_NAME(0)
		CASE 1 THEN //相手側
			_WBT_SET_ENEMY_NAME( 0 )
		ENDSWITCH

		_CALL sub_rnd_yell_msg_2nd
		
		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK15 = 1
		
		//========================================/
	
	ENDIF

	//タイムウェイト
	_TIME_WAIT( 60 )

  IF $LOCALWORK14 == 1 THEN
    _SUBWIN_CLOSE( 1 )
  ENDIF

  IF $LOCALWORK15 == 1 THEN
    _SUBWIN_CLOSE( 2 )
  ENDIF

_RET

/**************************************************************/
/*		声援　メッセージ表示のコール				  */
/**************************************************************/
//決勝戦自分入場時
ev_rnd_yell_msg_3rd_player:

  //優勝回数で確率決定、LWK_PROBABILITYに代入
  _CALL ev_yell_scr

	//プレイヤー名を格納
	_PLAYER_NAME( 0 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )
	
	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//１個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 1
		$LWK_YELL_POSY = 1
    $LWK_SUBWIN_NUM = 1
    _CALL sub_rnd_yell_msg_3rd

		//========================================/
	
		//サブウィンドウチェック
		$LOCALWORK1 = 1
		
		//========================================/
	
	ENDIF

	//タイムウェイト
	_TIME_WAIT( 20 )
	
	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)

	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//２個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 18
		$LWK_YELL_POSY = 16
    $LWK_SUBWIN_NUM = 2
    _CALL sub_rnd_yell_msg_3rd

		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK2 = 1
		
		//========================================/

	ENDIF

	IF $LOCALWORK1 == 1 THEN 
		//サブウィンクローズ
		_SUBWIN_CLOSE( 1 )
	ENDIF

	//タイムウェイト
	_TIME_WAIT( 20 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)

	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//３個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 1
		$LWK_YELL_POSY = 18
    $LWK_SUBWIN_NUM = 3
    _CALL sub_rnd_yell_msg_3rd
	
		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK3 = 1
		
		//========================================/
	
	ENDIF

	IF $LOCALWORK2 == 1 THEN 
		//サブウィンクローズ
		_SUBWIN_CLOSE( 2 )
	ENDIF

	//タイムウェイト
	_TIME_WAIT( 20 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)
	
	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//４個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 18
		$LWK_YELL_POSY = 1
    $LWK_SUBWIN_NUM = 4
    _CALL sub_rnd_yell_msg_3rd

		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK4 = 1
		
		//========================================/

	ENDIF

	IF $LOCALWORK3 == 1 THEN 
		//サブウィンクローズ
		_SUBWIN_CLOSE( 3 )
	ENDIF

	//タイムウェイト
	_TIME_WAIT( 20 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)
	
	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN
	
		//５個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 1
		$LWK_YELL_POSY = 18
		$LWK_SUBWIN_NUM = 5
		
		_CALL sub_rnd_yell_msg_3rd
	
		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK5 = 1
		
		//========================================/

	ENDIF

	IF $LOCALWORK4 == 1 THEN 
		//サブウィンクローズ
		_SUBWIN_CLOSE( 4 )
	ENDIF

	//タイムウェイト
	_TIME_WAIT( 20 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)
	
	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//６個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 19
		$LWK_YELL_POSY = 1
		$LWK_SUBWIN_NUM = 6
	
		_CALL sub_rnd_yell_msg_3rd

		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK6 = 1
		
		//========================================/

	ENDIF

  IF $LOCALWORK5 == 1 THEN 
    //サブウィンクローズ
    _SUBWIN_CLOSE( 5 )
  ENDIF

  //タイムウェイト
  _TIME_WAIT( 20 )

  IF $LOCALWORK6 == 1 THEN 
    //サブウィンクローズ
    _SUBWIN_CLOSE( 6 )
  ENDIF

_RET


/**************************************************************/
/*		声援　メッセージ表示のコール				  */
/**************************************************************/
//決勝戦相手入場時
ev_rnd_yell_msg_3rd_opponent:

	//相手は必ず声援表示
	$LWK_PROBABILITY = 99

	//対戦者名を格納
	_WBT_SET_ENEMY_NAME( 0 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//１個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 1
		$LWK_YELL_POSY = 1
		$LWK_SUBWIN_NUM = 1
		
		_CALL sub_rnd_yell_msg_3rd
		
		//タイムウェイト
		_TIME_WAIT( 20 )

		//========================================/
	
		//サブウィンドウチェック
		$LOCALWORK7 = 1
	
		//========================================/

	ENDIF

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)

	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//２個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 18
		$LWK_YELL_POSY = 18
		$LWK_SUBWIN_NUM = 2
		
		_CALL sub_rnd_yell_msg_3rd

		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK8 = 1
	
		//========================================/

	ENDIF

	IF $LOCALWORK7 == 1 THEN 
		//サブウィンクローズ
		_SUBWIN_CLOSE( 1 )
	ENDIF

	//タイムウェイト
	_TIME_WAIT( 20 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)
		
	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//３個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 18
		$LWK_YELL_POSY = 1
		$LWK_SUBWIN_NUM = 3
		
		_CALL sub_rnd_yell_msg_3rd
	
		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK9 = 1
		
		//========================================/

	ENDIF

	IF $LOCALWORK8 == 1 THEN 
		//サブウィンクローズ
		_SUBWIN_CLOSE( 2 )
	ENDIF

	//タイムウェイト
	_TIME_WAIT( 20 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)

	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//４個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 1
		$LWK_YELL_POSY = 18
		$LWK_SUBWIN_NUM = 4

		_CALL sub_rnd_yell_msg_3rd
	
		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK10 = 1
	
		//========================================/

	ENDIF

	IF $LOCALWORK9 == 1 THEN 
		//サブウィンクローズ
		_SUBWIN_CLOSE( 3 )
	ENDIF
	
	//タイムウェイト
	_TIME_WAIT( 20 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)

	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//５個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 19
		$LWK_YELL_POSY = 5
		$LWK_SUBWIN_NUM = 5
		
		_CALL sub_rnd_yell_msg_3rd

		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK11 = 1
		
		//========================================/

	ENDIF

	IF $LOCALWORK10 == 1 THEN 
		//サブウィンクローズ
		_SUBWIN_CLOSE( 4 )
	ENDIF

	//タイムウェイト
	_TIME_WAIT( 20 )

	//声援決め乱数
	_GET_RND( LWK_RND,100 )

	_DEBUG_PRINT_WK(LWK_RND)

	//優勝回数に応じた確率でメッセージ表示
	IF $LWK_PROBABILITY >= $LWK_RND THEN

		//６個目のメッセージの座標位置・サブウィンナンバー定義
		$LWK_YELL_POSX = 1
		$LWK_YELL_POSY = 19
		$LWK_SUBWIN_NUM = 6
		
		_CALL sub_rnd_yell_msg_3rd

		//========================================/
		
		//サブウィンドウチェック
		$LOCALWORK12 = 1
		
		//========================================/

	ENDIF

  IF $LOCALWORK11 == 1 THEN 
    //サブウィンクローズ
    _SUBWIN_CLOSE( 5 )
  ENDIF

  //タイムウェイト
  _TIME_WAIT( 20 )

  IF $LOCALWORK12 == 1 THEN 
    //サブウィンクローズ
    _SUBWIN_CLOSE( 6 )
  ENDIF

_RET


sub_rnd_yell_msg_2nd:
		//メッセージ決め乱数
		_GET_RND( LWK_MSG,10 )

		SWITCH $LWK_MSG
		CASE 0 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_01 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 1 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_02 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 2 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_03 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 3 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_04 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 4 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_05 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 5 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_06 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 6 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_07 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 7 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_08 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 8 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_09 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 9 THEN
			_SUBWIN_MSG( msg_wbt_yell_2nd_10 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		ENDSWITCH
_RET

sub_rnd_yell_msg_3rd:
		//メッセージ決め乱数
		_GET_RND( LWK_MSG,10 )

		SWITCH $LWK_MSG
		CASE 0 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_01 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 1 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_02 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 2 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_03 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 3 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_04 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 4 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_05 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 5 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_06 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 6 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_07 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 7 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_08 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 8 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_09 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		CASE 9 THEN
			_SUBWIN_MSG( msg_wbt_yell_3rd_10 , LWK_YELL_POSX , LWK_YELL_POSY , LWK_SUBWIN_NUM )
		ENDSWITCH

_RET

/**************************************************************/
/*		前口上スクリプト									  */
/**************************************************************/
ev_introductory_remarks:

_PLAYER_NAME( 0 ) //タグ０にプレイヤー名を登録

_WBT_GET_VICTORY_COUNT( SCR_WBT_CUP_NULL, POKETYPE_NULL, LWK_WIN_COUNT )

//優勝回数が０の場合
IF $LWK_WIN_COUNT == 0 THEN

	//前口上メッセージ表示
	_PLAINWIN_MSG_UP( msg_wbt_player_title_01 )

//優勝回数が１の場合
ELSIF $LWK_WIN_COUNT == 1 THEN

	//前口上メッセージ表示
	_PLAINWIN_MSG_UP( msg_wbt_player_title_02 )

//優勝回数が１００以上の場合
ELSIF $LWK_WIN_COUNT >= 100 THEN

	_PLAINWIN_MSG_UP( msg_wbt_player_title_29 )

//優勝回数が５０以上の場合
ELSIF $LWK_WIN_COUNT >= 50 THEN

	_PLAINWIN_MSG_UP( msg_wbt_player_title_24 )
	
//優勝回数が３０以上の場合
ELSIF $LWK_WIN_COUNT >= 30 THEN

	_PLAINWIN_MSG_UP( msg_wbt_player_title_19 )

//優勝回数が２０以上の場合
ELSIF $LWK_WIN_COUNT >= 20 THEN

	_PLAINWIN_MSG_UP( msg_wbt_player_title_14 )

//優勝回数が１０以上の場合
ELSIF $LWK_WIN_COUNT >= 10 THEN

	_PLAINWIN_MSG_UP( msg_wbt_player_title_09 )

//優勝回数が５以上の場合
ELSIF $LWK_WIN_COUNT >= 5 THEN

	_PLAINWIN_MSG_UP( msg_wbt_player_title_04 )

//優勝回数が２以上の場合
ELSIF $LWK_WIN_COUNT >= 2 THEN

	//前口上メッセージ表示
	_PLAINWIN_MSG_UP( msg_wbt_player_title_03 )

//異常処理
ELSE

ENDIF

_PLAINWIN_CLOSE()

_RET

/**************************************************************/
//入場演出格納処理
/**************************************************************/

ev_wbt_get_cup:

_WBT_GET_WBT_CUP( LWK_CUP )

SWITCH $LWK_CUP
CASE SCR_WBT_CUP_CHAMPION THEN	//チャンピオンズ
	
	//入場エフェクトＳＥ再生・チャンピオンズ用
	_SE_PLAY(SEQ_SE_SW_WBT_13)
	$LWK_EFFECT = SCR_WBT_EFFECT_CHAMP
	
CASE SCR_WBT_CUP_POKETYPE THEN	//タイプエキスパート

	_WBT_GET_TOURNAMENT_POKETYPE( LWK_POKETYPE )
	
	//入場エフェクトＳＥ再生・タイプ用
	_SE_PLAY(SEQ_SE_SW_WBT_04)
	
	SWITCH $LWK_POKETYPE
	CASE POKETYPE_NORMAL THEN	//ノーマル
		$LWK_EFFECT = SCR_WBT_EFFECT_NORMAL
	CASE POKETYPE_HONOO THEN	//ほのお
		$LWK_EFFECT = SCR_WBT_EFFECT_FIRE
	CASE POKETYPE_MIZU THEN	//みず
		$LWK_EFFECT = SCR_WBT_EFFECT_WATER
	CASE POKETYPE_KUSA THEN	//くさ
		$LWK_EFFECT = SCR_WBT_EFFECT_GRASS
	CASE POKETYPE_DENKI THEN	//でんき
		$LWK_EFFECT = SCR_WBT_EFFECT_ELECT
	CASE POKETYPE_KOORI THEN	//こおり
		$LWK_EFFECT = SCR_WBT_EFFECT_ICE
	CASE POKETYPE_KAKUTOU THEN	//かくとう
		$LWK_EFFECT = SCR_WBT_EFFECT_FIGHT
	CASE POKETYPE_DOKU THEN	//どく
		$LWK_EFFECT = SCR_WBT_EFFECT_POISON
	CASE POKETYPE_JIMEN THEN	//じめん
		$LWK_EFFECT = SCR_WBT_EFFECT_GROUND
	CASE POKETYPE_HIKOU THEN	//ひこう
		$LWK_EFFECT = SCR_WBT_EFFECT_FLYING
	CASE POKETYPE_ESPER THEN	//エスパー
		$LWK_EFFECT = SCR_WBT_EFFECT_PSYCHC
	CASE POKETYPE_MUSHI THEN	//むし
		$LWK_EFFECT = SCR_WBT_EFFECT_BUG
	CASE POKETYPE_IWA THEN	//いわ
		$LWK_EFFECT = SCR_WBT_EFFECT_ROCK
	CASE POKETYPE_GHOST THEN	//ゴースト
		$LWK_EFFECT = SCR_WBT_EFFECT_GHOST
	CASE POKETYPE_DRAGON THEN	//ドラゴン
		$LWK_EFFECT = SCR_WBT_EFFECT_DRAGON
	CASE POKETYPE_AKU THEN	//あく
		$LWK_EFFECT = SCR_WBT_EFFECT_DARK
	CASE POKETYPE_HAGANE THEN	//でんき
		$LWK_EFFECT = SCR_WBT_EFFECT_STEEL
	ENDSWITCH

