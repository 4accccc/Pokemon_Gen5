/**************************************************************/
/*		前口上スクリプト									  */
/**************************************************************/
ev_introductory_remarks:

//_WBT_GET_VICTORY_COUNT( LWK_WIN_COUNT )

//優勝回数が０の場合
IF $LWK_WIN_COUNT == 0 THEN

	//前口上メッセージ表示
	_PLAINWIN_MSG_UP( msg_test )
	_PLAINWIN_CLOSE()

//優勝回数が１の場合
ELSIF $LWK_WIN_COUNT == 1 THEN

	//前口上メッセージ表示
	_PLAINWIN_MSG_UP( msg_test )
	_PLAINWIN_CLOSE()

//優勝回数が３以上の場合
ELSIF $LWK_WIN_COUNT >= 3 THEN

	//前口上メッセージ表示
	_PLAINWIN_MSG_UP( msg_test )
	_PLAINWIN_CLOSE()

	//乱数取得
	_GET_RND( LWK_MSG,10 )

//優勝回数が５以上の場合
ELSIF $LWK_WIN_COUNT >= 5 THEN

	//乱数取得
	_GET_RND( LWK_MSG,5 )
	
	//前口上メッセージ表示
	SWITCH $LWK_MSG
	CASE 0 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 1 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 2 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 3 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 4 THEN
		_PLAINWIN_MSG_UP( msg_test )
	ENDSWITCH
	_PLAINWIN_CLOSE()

//優勝回数が１０以上の場合
ELSIF $LWK_WIN_COUNT >= 10 THEN

	//乱数取得
	_GET_RND( LWK_MSG,5 )
	
	//前口上メッセージ表示
	SWITCH $LWK_MSG
	CASE 0 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 1 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 2 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 3 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 4 THEN
		_PLAINWIN_MSG_UP( msg_test )
	ENDSWITCH
	_PLAINWIN_CLOSE()

//優勝回数が１５以上の場合
ELSIF $LWK_WIN_COUNT >= 15 THEN

	//乱数取得
	_GET_RND( LWK_MSG,5 )
	
	//前口上メッセージ表示
	SWITCH $LWK_MSG
	CASE 0 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 1 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 2 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 3 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 4 THEN
		_PLAINWIN_MSG_UP( msg_test )
	ENDSWITCH
	_PLAINWIN_CLOSE()

//優勝回数が２０以上の場合
ELSIF $LWK_WIN_COUNT >= 20 THEN

	//乱数取得
	_GET_RND( LWK_MSG,5 )
	
	//前口上メッセージ表示
	SWITCH $LWK_MSG
	CASE 0 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 1 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 2 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 3 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 4 THEN
		_PLAINWIN_MSG_UP( msg_test )
	ENDSWITCH
	_PLAINWIN_CLOSE()

//優勝回数が３０以上の場合
ELSIF $LWK_WIN_COUNT >= 30 THEN

	//乱数取得
	_GET_RND( LWK_MSG,5 )
	
	//前口上メッセージ表示
	SWITCH $LWK_MSG
	CASE 0 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 1 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 2 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 3 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 4 THEN
		_PLAINWIN_MSG_UP( msg_test )
	ENDSWITCH
	_PLAINWIN_CLOSE()

//優勝回数が５０以上の場合
ELSIF $LWK_WIN_COUNT >= 50 THEN

	//乱数取得
	_GET_RND( LWK_MSG,5 )
	
	//前口上メッセージ表示
	SWITCH $LWK_MSG
	CASE 0 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 1 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 2 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 3 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 4 THEN
		_PLAINWIN_MSG_UP( msg_test )
	ENDSWITCH
	_PLAINWIN_CLOSE()

//優勝回数が１００以上の場合
ELSIF $LWK_WIN_COUNT >= 100 THEN

	//乱数取得
	_GET_RND( LWK_MSG,5 )
	
	//前口上メッセージ表示
	SWITCH $LWK_MSG
	CASE 0 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 1 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 2 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 3 THEN
		_PLAINWIN_MSG_UP( msg_test )
	CASE 4 THEN
		_PLAINWIN_MSG_UP( msg_test )
	ENDSWITCH
	_PLAINWIN_CLOSE()

//異常処理
ELSE

ENDIF

_RET

/**************************************************************/
/*		決勝戦　プレイヤー用声援スクリプト					  */
/**************************************************************/
ev_yell_final_player:

//_WBT_GET_VICTORY_COUNT( LWK_WIN_COUNT )

//優勝回数が１以下の場合
IF $LWK_WIN_COUNT <= 1 THEN
	
	//優勝回数1回の場合は２０％
	$LWK_PROBABILITY = 19
	
	//メッセージ表示のコールスクリプト
	_CALL ev_rnd_yell_msg_final

//優勝回数が５以上の場合
ELSIF $LWK_WIN_COUNT >= 5 THEN

	//優勝回数５回の場合は４０％
	$LWK_PROBABILITY = 39
	
	//メッセージ表示のコールスクリプト
	_CALL ev_rnd_yell_msg_final

//優勝回数が１０以上の場合
ELSIF $LWK_WIN_COUNT >= 10 THEN

	//優勝回数１０回の場合は６０％
	$LWK_PROBABILITY = 59
	
	//メッセージ表示のコールスクリプト
	_CALL ev_rnd_yell_msg_final

//優勝回数が３０以上の場合
ELSIF $LWK_WIN_COUNT >= 30 THEN

	//優勝回数３０回の場合は８０％
	$LWK_PROBABILITY = 79
	
	//メッセージ表示のコールスクリプト
	_CALL ev_rnd_yell_msg_final

//異常処理
ELSE

ENDIF

_RET

/**************************************************************/
/*		決勝戦用　声援メッセージ　コールスクリプト			  */
/**************************************************************/
ev_rnd_yell_msg_final:

//声援決め乱数
_GET_RND( LWK_RND,100 )
	
//優勝回数に応じた確率でメッセージ表示
IF $LWK_RND <= LWK_PROBABILITY THEN

	//１個目のメッセージの座標位置・サブウィンナンバー定義
	$LWK_YELL_POSX = 1
	$LWK_YELL_POSY = 1

	//メッセージ決め乱数
	_GET_RND( LWK_MSG,10 )

	SWITCH $LWK_MSG
	CASE 0 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	CASE 1 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	CASE 2 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	CASE 3 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	CASE 4 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	CASE 5 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	CASE 6 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	CASE 7 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	CASE 8 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	CASE 9 THEN
		_SUBWIN_MSG( msg_test , LWK_YELL_POSX , LWK_YELL_POSY , 1 )
	ENDSWITCH

	//========================================/
	
	//サブウィンドウチェック
	$LOCALWORK1 = 1
	
	//========================================/

ENDIF

//タイムウェイト
_TIME_WAIT( 20 )

//声援決め乱数
_GET_RND( LWK_RND,100 )
	
//優勝回数に応じた確率でメッセージ表示
IF $LWK_RND <= LWK_PROBABILITY THEN

