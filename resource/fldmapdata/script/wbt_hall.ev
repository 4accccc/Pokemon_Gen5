	ENDSWITCH

	//========================================/
	
	//サブウィンドウチェック
	$LOCALWORK2 = 1
	
	//========================================/

ENDIF

IF $LOCALWORK1 == 1 THEN 
	//サブウィンクローズ
	_SUBWIN_CLOSE( 1 )
ENDIF

//タイムウェイト
_TIME_WAIT( 20 )

//声援決め乱数
_GET_RND( LWK_RND,100 )
	
//優勝回数に応じた確率でメッセージ表示
IF $LWK_RND <= LWK_PROBABILITY THEN

