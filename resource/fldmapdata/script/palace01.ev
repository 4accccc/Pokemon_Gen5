/**************************************************************/
/*  ワープポイント                                            */
/**************************************************************/
EVENT_START    ev_palace01_warp_point
  _SYSWIN_MSG( plc_warp_point_01, POS_DOWN )
  _YES_NO_WIN( SCWK_ANSWER )
  _SYSWIN_CLOSE()
  IF $SCWK_ANSWER == SCR_YES THEN
    _RETURN_FROM_HILINK()
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_stepback )
    _OBJ_ANIME_WAIT()
  ENDIF

EVENT_END

//--------------------------------------------------------------------
//
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_stepback
	_ANIME_DATA	AC_WALK_U_16F,1
	_ANIME_DATA	ACMD_END,0


