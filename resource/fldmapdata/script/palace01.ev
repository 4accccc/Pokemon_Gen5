/**************************************************************/
/*  ミッション成功イベント                                    */
/**************************************************************/
EVENT_START ev_scene_palace01_mission_clear
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_oldman1_look_01 )
	_OBJ_ANIME_WAIT()
	
	//パレスじじい：主人公横へ
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_oldman1_move_01 )
	_OBJ_ANIME_WAIT()
	
	//主人公：じじいを見る
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_walk_l )
	_OBJ_ANIME_WAIT()
	
	//おお成功じゃったか
	_BALLOONWIN_OBJMSG( plc_tutorial_mission_02, PALACE01_OLDMAN1_01 )
	_MSGWIN_CLOSE()
	
	//パレスじじい：ハイルツリーをみて
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_stay_walk_u )
	_OBJ_ANIME_WAIT()
	
	//ハイルツリーには人々の思いが集まる
	_BALLOONWIN_OBJMSG( plc_tutorial_mission_05, PALACE01_OLDMAN1_01 )
	_MSGWIN_CLOSE()
	
	//パレスじじい：主人公をみて
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_stay_walk_r )
	_OBJ_ANIME_WAIT()
	
	//さあ受け取るのじゃ！
	_BALLOONWIN_OBJMSG( plc_tutorial_mission_06, PALACE01_OLDMAN1_01 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
	//========================================//
	//ミッション終了後イベントを無効
	$WK_SYS_FES_TUTORIAL = 4
	//========================================//
	
EVENT_END


/**************************************************************/
/*  ミッション失敗イベント                                    */
/**************************************************************/
EVENT_START ev_scene_palace01_mission_fail
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_oldman1_look_01 )
	_OBJ_ANIME_WAIT()
	
	//パレスじじい：主人公横へ
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_oldman1_move_01 )
	_OBJ_ANIME_WAIT()
	
	//主人公：じじいを見る
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_walk_l )
	_OBJ_ANIME_WAIT()
	
	//むむ失敗じゃったか
	_BALLOONWIN_OBJMSG( plc_tutorial_mission_03, PALACE01_OLDMAN1_01 )
	_MSGWIN_CLOSE()
	
	//デルダマ入手
	_ITEM_EVENT_KEYWAIT( ITEM_DERUDAMA, 10 )
	
	//さて約束どおり
	_BALLOONWIN_OBJMSG( plc_tutorial_mission_04, PALACE01_OLDMAN1_01 )
	_MSGWIN_CLOSE()
	
	//パレスじじい：ハイルツリーをみて
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_stay_walk_u )
	_OBJ_ANIME_WAIT()
	
	//ハイルツリーには人々の思いが集まる
	_BALLOONWIN_OBJMSG( plc_tutorial_mission_05, PALACE01_OLDMAN1_01 )
	_MSGWIN_CLOSE()
	
	//パレスじじい：主人公をみて
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_stay_walk_r )
	_OBJ_ANIME_WAIT()
	
	//さあ受け取るのじゃ！
	_BALLOONWIN_OBJMSG( plc_tutorial_mission_06, PALACE01_OLDMAN1_01 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
	//========================================//
	//ミッション終了後イベントを無効
	$WK_SYS_FES_TUTORIAL = 4
	//========================================//
	
EVENT_END


/**************************************************************/
/*  デルパワー登録後イベント                                  */
/**************************************************************/
EVENT_START ev_scene_palace01_power_tutorial
	//パレスじじい：ハイルツリーをみて
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_stay_walk_u )
	_OBJ_ANIME_WAIT()
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_walk_d )
	_OBJ_ANIME_WAIT()
	
	//デルパワーと受け取れたようじゃな
	_BALLOONWIN_OBJMSG( plc_tutorial_power_01, PALACE01_OLDMAN1_01 )
	_MSGWIN_CLOSE()
	
	//デルパワーは…
	_SYSWIN_MSG( plc_tutorial_power_02, POS_DEFAULT )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
	//========================================//
	//ハイリンクチュートリアル完了
	$WK_SYS_FES_TUTORIAL = 6
	//========================================//
	
EVENT_END


/**************************************************************/
/*  じいさん 話しかけ                                         */
/**************************************************************/
EVENT_START ev_palace01_oldman1_01
	_TALK_OBJ_START()
	
	//チュートリアルイベントの進行状況で分岐
	IF $WK_SYS_FES_TUTORIAL == 1 THEN
		//チュートリアルミッション受けるまで
		_BALLOONWIN_OBJMSG_POS( plc_sw_oldman_08, PALACE01_OLDMAN1_01, POS_DOWN )
	ELSIF $WK_SYS_FES_TUTORIAL == 4 THEN
		//デルパワーチュートリアル中
		_BALLOONWIN_OBJMSG_POS( plc_sw_oldman_09, PALACE01_OLDMAN1_01, POS_DOWN )
	ELSE
		//チュートリアル完了後：質問メニューへ
		_CALL	ev_oldman1_guide
	ENDIF
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
EVENT_END


//パレス質問メニュー
ev_oldman1_guide:
	{
	DEFINE_LOCAL  lwk_loop
	DEFINE_LOCAL  lwk_bmpans
	
	WHILE $lwk_loop != 555
	
		//パレスに興味があるのか？
		_BALLOONWIN_OBJMSG_POS( plc_sw_oldman_01, PALACE01_OLDMAN1_01, POS_DOWN )
	
		//メニュー作成
		_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, lwk_bmpans )
		_BMPMENU_MAKE_LIST( plc_sw_oldman_02, 0 )	//フェスミッションとは
		_BMPMENU_MAKE_LIST( plc_sw_oldman_03, 1 )	//デルパワーとは
		_BMPMENU_MAKE_LIST( plc_sw_oldman_04, 10 )	//やめる
		_BMPMENU_START()
		
		SWITCH $lwk_bmpans
		CASE 0 THEN
			//フェスミッションとは
			_BALLOONWIN_OBJMSG_POS( plc_sw_oldman_06, PALACE01_OLDMAN1_01, POS_DOWN )
		CASE 1 THEN
			//デルパワーとは
			_BALLOONWIN_OBJMSG_POS( plc_sw_oldman_07, PALACE01_OLDMAN1_01, POS_DOWN )
		DEFAULT
			//やめる
			$lwk_loop = 555
		ENDSWITCH
	
	ENDWHILE
	
	}
	
	//終了メッセージ
	_BALLOONWIN_OBJMSG_POS( plc_sw_oldman_05, PALACE01_OLDMAN1_01, POS_DOWN )
	
_RET


/**************************************************************/
/*  パレス双子１（左）                                        */
/**************************************************************/
EVENT_START ev_palace01_girl4_01
	_TALK_OBJ_START()
	
	{
	DEFINE_LOCAL  lwk_loop
	DEFINE_LOCAL  lwk_bmpans
	
	//パレス質問メニュー（やめる選択までループ）
	WHILE $lwk_loop != 555
		
		//参加者について知りたい？
		_BALLOONWIN_OBJMSG_POS( plc_sw_girl4_l_01, PALACE01_GIRL4_01, POS_DOWN )
		
		//メニュー作成
		_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, lwk_bmpans )
		//リスト追加
		_BMPMENU_MAKE_LIST( plc_sw_girl4_l_02, 0 )	//参加者とは
		_BMPMENU_MAKE_LIST( plc_sw_girl4_l_03, 1 )	//協力とは
		_BMPMENU_MAKE_LIST( plc_sw_girl4_l_04, 10 )	//やめる
		//メニュー表示
		_BMPMENU_START()
		
		SWITCH $lwk_bmpans
		CASE 0 THEN
			//参加者とは
			_BALLOONWIN_OBJMSG_POS( plc_sw_girl4_l_05, PALACE01_GIRL4_01, POS_DOWN )
		CASE 1 THEN
			//協力とは
			_BALLOONWIN_OBJMSG_POS( plc_sw_girl4_l_06, PALACE01_GIRL4_01, POS_DOWN )
		DEFAULT
			//やめる
			$lwk_loop = 555
		ENDSWITCH
	
	ENDWHILE
	
	}
	
	//終了メッセージ
	_BALLOONWIN_OBJMSG_POS( plc_sw_girl4_l_07 ,PALACE01_GIRL4_01, POS_DOWN )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
EVENT_END


/**************************************************************/
/*  パレス双子２（右）                                        */
/**************************************************************/
EVENT_START ev_palace01_girl4_02
	_TALK_OBJ_START()
	
	{
	DEFINE_LOCAL  lwk_loop
	DEFINE_LOCAL  lwk_bmpans
	
	//パレス質問メニュー（やめる選択までループ）
	WHILE $lwk_loop != 555
		
		//ハイルツリーについて知りたい？
		_BALLOONWIN_OBJMSG_POS( plc_sw_girl4_r_01, PALACE01_GIRL4_02, POS_DOWN )
		
		//メニュー作成
		_BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, 1, lwk_bmpans )
		//リスト追加
		_BMPMENU_MAKE_LIST( plc_sw_girl4_r_02, 0 )	//ミッション種類
		_BMPMENU_MAKE_LIST( plc_sw_girl4_r_03, 1 )	//デルパワー種類
		_BMPMENU_MAKE_LIST( plc_sw_girl4_r_04, 10 )	//やめる
		//メニュー表示
		_BMPMENU_START()
		
		SWITCH $lwk_bmpans
		CASE 0 THEN
			//ミッションの種類
			_BALLOONWIN_OBJMSG_POS( plc_sw_girl4_r_05, PALACE01_GIRL4_02, POS_DOWN )
		CASE 1 THEN
			//デルパワーの種類
			_BALLOONWIN_OBJMSG_POS( plc_sw_girl4_r_06, PALACE01_GIRL4_02, POS_DOWN )
		DEFAULT
			//やめる
			$lwk_loop = 555
		ENDSWITCH
	
	ENDWHILE
	
	}
	
	//終了メッセージ
	_BALLOONWIN_OBJMSG_POS( plc_sw_girl4_r_07, PALACE01_GIRL4_02, POS_DOWN )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	
EVENT_END


