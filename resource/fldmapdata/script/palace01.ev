/**************************************************************/
/*  モノリス                                              */
/**************************************************************/
EVENT_START ev_palace01_monolith
  _TALK_START_SE_PLAY()
  //_CALL sub_monolith_main
  _CALL sub_monolith_swan_main
EVENT_END

//--------------------------------------------------------------
///モノリス　メイン
//--------------------------------------------------------------
sub_monolith_swan_main:
{
  _SYSWIN_MSG( plc_mono_01, POS_DOWN )
  _SYSWIN_CLOSE()
  
  //モノリス呼び出し
  _MAP_FADE_BLACK_OUT()
  _MAP_FADE_END_CHECK()
  _FIELD_CLOSE()

  _CALL_MONOLITH_PROC()

  _FIELD_OPEN()
  _MAP_FADE_BLACK_IN()
  _MAP_FADE_END_CHECK()
      
  //モノリス画面を抜けた時にミッションエントリーしていたならば、待機イベント呼び出し
  _GET_MISSION_ENTRY( SCWK_ANSWER )
  
  SWITCH $SCWK_ANSWER
  CASE SCR_PALACE_MISSION_ENTRY_NORMAL THEN
    //通常パレスミッション
    //_CALL sub_monolith_normal_mission_entry
    _RET
  CASE SCR_PALACE_MISSION_ENTRY_FEST THEN
    //フェスミッション
    _CALL sub_monolith_fest_mission_entry
    _RET
  ENDSWITCH

}
_RET


//--------------------------------------------------------------
///モノリス　フェスミッション受領後
//--------------------------------------------------------------
sub_monolith_fest_mission_entry:
{

  //初回時のみチュートリアルイベントをはさむ
  IF FLAG_OFF( SYS_FLAG_FES_TUTORIAL_CLEAR ) THEN
    _CALL  sub_monolith_tutorial_first_mission
  ENDIF

  // ギミックエフェクトスタート
//  _MISSION_START_GMK_EFFECT()

//  _SYSWIN_MSG( plc_fmission_entry, POS_DOWN )
//  _TIME_WAIT(120) //4秒カウントダウン 
//  _SYSWIN_CLOSE()

  //表フィールドに遷移
  _INTRUDE_MAP_CHANGE_FMISSION_START()
}
_RET


//--------------------------------------------------------------
///モノリス　初回ミッション開催時
//--------------------------------------------------------------
sub_monolith_tutorial_first_mission:
  _OBJ_ANIME( PALACE01_OLDMAN1_01, anm_stay_walk_u )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_walk_d )
  _OBJ_ANIME_WAIT()
  
  _BALLOONWIN_OBJMSG( plc_tutorial_mission_01, PALACE01_OLDMAN1_01 )
  _MSGWIN_CLOSE()

_RET

/**************************************************************/
/*  初回誘導イベント                                          */
/**************************************************************/
EVENT_START ev_scene_palace01_1stguide
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_oldman1_look_01 )
	_OBJ_ANIME_WAIT()
	
	//パレスじじい：主人公横へ
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_oldman1_move_01 )
	_OBJ_ANIME_WAIT()
	
	//主人公：じじいを見る
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_walk_l )
	_OBJ_ANIME_WAIT()
	
	//あらあら誰かしら
	_BALLOONWIN_OBJMSG( plc_tutorial_firststep_01, PALACE01_OLDMAN1_01 )
	_MSGWIN_CLOSE()
	
	//パレスじじい：下を向いて
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_stay_walk_d )
	_OBJ_ANIME_WAIT()
	
	//ここはイッシュの中心にある…
	_BALLOONWIN_OBJMSG( plc_tutorial_firststep_02, PALACE01_OLDMAN1_01 )
	
	//パレスじじい：主人公を見て
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_stay_walk_r )
	//そう言われているわ
	_BALLOONWIN_OBJMSG( plc_tutorial_firststep_03, PALACE01_OLDMAN1_01 )
	_OBJ_ANIME_WAIT()
	_MSGWIN_CLOSE()
	
	//パレスじじい：ハイルツリーをみて
	_OBJ_ANIME( PALACE01_OLDMAN1_01, anm_stay_walk_u )
	_OBJ_ANIME_WAIT()
	
	//ミッションを受けなさい！
	_BALLOONWIN_OBJMSG( plc_tutorial_firststep_04, PALACE01_OLDMAN1_01 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()

  // ヒントメダル開放
  _SET_MEDAL_HINT_ACHIEVE( MDLID_DELPOWER_USE_LV1 )   // デルパワー＋
  _SET_MEDAL_HINT_ACHIEVE( MDLID_FES_JOIN_NUM_LV1 )   // １０にんフェス
  _SET_MEDAL_HINT_ACHIEVE( MDLID_FES_HIGHSCORE_LV1 )  // てんとりハンドレッド
  _SET_MEDAL_HINT_ACHIEVE( MDLID_FES_HOLD_LV1 )       // かいさいＬＶ１
  _SET_MEDAL_HINT_ACHIEVE( MDLID_FES_CLEAR_LV1 )      // たっせいＬＶ１
  _SET_MEDAL_HINT_ACHIEVE( MDLID_FES_JOIN_LV1 )       // さんかＬＶ１
	
	//========================================//
	//初回誘導イベントを無効
	$WK_SYS_FES_TUTORIAL = 1
	//========================================//

EVENT_END

