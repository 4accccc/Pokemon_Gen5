
//======================================================================
//                t01r0302.ev
//
//    スクリプトファイル：t01r0302用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_t01r0302.h"
  .include  "t01r0302.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_bg_t01r0302_pc_01
_EVENT_DATA    ev_t01r0302_girl1_01
_EVENT_DATA    ev_t01r0302_woman1_01
_EVENT_DATA    ev_t01r0302_boy1_01
_EVENT_DATA    ev_t01r0302_boy2_01
_EVENT_DATA_END


/**************************************************************/
/*            FLAG_CHANGE_LABEL                               */
/**************************************************************/
//ev_t01r0302_flag_change:
//  _END

/************************************************************/
/*					ライバルのパソコン						*/
/************************************************************/
EVENT_START   ev_bg_t01r0302_pc_01
	_TALK_START_SE_PLAY()

	_PLAYER_NAME( 0 ) //プレイヤー名を反映
	_SYSWIN_MSG( msg_t01r0302_pc_01, POS_DOWN )
	_LAST_KEYWAIT()
	_SYSWIN_CLOSE()

EVENT_END

/************************************************************/
/*					【講習】WOMAN1							*/
/************************************************************/
EVENT_START   ev_t01r0302_woman1_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_t01r0302_woman1_02 )
EVENT_END


/************************************************************/
/*					【講習】boy1							*/
/************************************************************/
EVENT_START   ev_t01r0302_boy1_01
	_TALK_OBJ_START()
	_BALLOONWIN_OBJMSG_POS(msg_t01r0302_boy1_01 , T01R0302_BOY1_01, POS_DEFAULT )
	_BALLOONWIN_CLOSE()
	_OBJ_ANIME( T01R0302_BOY1_01,anm_boydance)
	_OBJ_ANIME_WAIT()
	_BALLOONWIN_OBJMSG_POS(msg_t01r0302_boy1_02 , T01R0302_BOY1_01, POS_DEFAULT )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

EVENT_END

/************************************************************/
/*					【講習】boy1アニメーション				*/
/************************************************************/
_ANIME_LABEL	anm_boydance
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0


/************************************************************/
/*					【講習】boy2							*/
/************************************************************/
EVENT_START   ev_t01r0302_boy2_01

	_TALK_OBJ_START()
	_BALLOONWIN_TALKOBJ_MSG(msg_t01r0302_boy2_01 )
	_YES_NO_WIN( SCWK_ANSWER )
	//レスにより分岐
	IF $SCWK_ANSWER == SCR_YES THEN
	_BALLOONWIN_TALKOBJ_MSG(msg_t01r0302_boy2_02 )
		//「はい」の処理を書きます
	ELSE
	_BALLOONWIN_TALKOBJ_MSG(msg_t01r0302_boy2_03 )
		//「いいえ」の処理を書きます
	ENDIF
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

EVENT_END


/************************************************************/
/*					【講習】GIRL01							*/
/************************************************************/
EVENT_START   ev_t01r0302_girl1_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_t01r0302_girl1_01 )
EVENT_END

