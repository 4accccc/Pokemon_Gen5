_EVENT_DATA    ev_pos_d27r1301_warp_01
_EVENT_DATA    ev_pos_d27r1301_warp_02
_EVENT_DATA    ev_pos_d27r1301_warp_03
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//																	//
//	特殊な接続に LOCALWORK15 を使用ししています。     //
//	同マップ内の使用を禁止します。									//
//------------------------------------------------------------------//

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*					特殊接続（船首楼）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_warp_01
  
  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //ワープ処理
  _MAP_CHANGE_WARP( ZONE_ID_D27R0301, 11, 5, LWK_DIR )

EVENT_END


/************************************************************/
/*					特殊接続（ブリッジ）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_warp_02

  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //ワープ処理
  _MAP_CHANGE_WARP( ZONE_ID_D27R0401, 7, 15, LWK_DIR )

EVENT_END

/************************************************************/
/*					特殊接続（ゲーチス部屋）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_warp_03

  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //ワープ処理
  _MAP_CHANGE_WARP( ZONE_ID_D27R0601, 8, 9, LWK_DIR )

EVENT_END

