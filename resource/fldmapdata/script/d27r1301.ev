//----------------------------------------------------------------------------
/**
 *	@brief    ワープをゾーンチェンジしないで行う関数
 *
 *	@param	  param_x   移動先X座標
 *	@param	  param_z   移動先Z座標
 */
//-----------------------------------------------------------------------------
pos_warp:
{
  DEFINE_LOCAL  player_dir

  _DEBUG_PRINT_WK( param_x )
  _DEBUG_PRINT_WK( param_z )

  _PLAYER_DIR_GET( player_dir )

  _BLACK_OUT()                      // フェードアウト
  //_OBJ_WARP_OUT( MMDL_ID_PLAYER )   // ワープ消去
  _DISP_FADE_END_CHECK()            // フェードアウト待ち

  _TIME_WAIT( 6 )

  _OBJ_POS_CHANGE( MMDL_ID_PLAYER, param_x, param_y, param_z, player_dir )

  // 落下だと、POSイベントが発動してしまう
  //_OBJ_FALL_IN( MMDL_ID_PLAYER, param_x, param_z, player_dir  ) // 落下
  
  // フェードイン
  _BLACK_IN()
  _DISP_FADE_END_CHECK()            // フェードアウト待ち
}
_RET

