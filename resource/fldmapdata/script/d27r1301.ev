  .text

  .include  "scr_seq_def.h"
  .include  "msg_d27r1301.h"
  .include  "d27r1301.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_d27r1301
_EVENT_DATA    ev_init_d27r1301
_EVENT_DATA    ev_recover_d27r1301
_EVENT_DATA    ev_pos_d27r1301_warp_01
_EVENT_DATA    ev_pos_d27r1301_warp_02
_EVENT_DATA    ev_pos_d27r1301_warp_03
_EVENT_DATA    ev_pos_d27r1301_button_01
_EVENT_DATA    ev_pos_d27r1301_button_02
_EVENT_DATA    ev_pos_d27r1301_button_03
_EVENT_DATA    ev_pos_d27r1301_button_04
_EVENT_DATA    ev_pos_d27r1301_barrier_01
_EVENT_DATA    ev_pos_d27r1301_switch_01
_EVENT_DATA    ev_pos_d27r1301_switch_02
_EVENT_DATA    ev_pos_d27r1301_switch_03
_EVENT_DATA    ev_pos_d27r1301_switch_04
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//																	//
//	特殊な接続に LOCALWORK15 を使用ししています。     //
//	同マップ内の使用を禁止します。									//
//
//
//	LOCALWORK0 ～ LOCALWORK3 をギミックの制御に使用しています。		  //
//    0 = POSイベント有効
//  ボタン1 : LOCALWORK0
//  ボタン2 : LOCALWORK1
//  ボタン3 : LOCALWORK2
//  ボタン4 : LOCALWORK3
//

//------------------------------------------------------------------//

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*					ZONE_CHANGE_LABEL 						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r1301
  
  //スイッチ（１）の見栄えを分岐
  IF $WK_SCENE_D27_SWITCH_01 == 0 THEN
    _HIDE_SHIP_GATE_SET( 3, 0 )
  ELSE
    _HIDE_SHIP_GATE_SET( 3, 1 )
  ENDIF
  
  //スイッチ（２）の見栄えを分岐
  IF $WK_SCENE_D27_SWITCH_02 == 0 THEN
    _HIDE_SHIP_GATE_SET( 2, 0 )
  ELSE
    _HIDE_SHIP_GATE_SET( 2, 1 )
  ENDIF
  
  //スイッチ（３）の見栄えを分岐
  IF $WK_SCENE_D27_SWITCH_03 == 0 THEN
    _HIDE_SHIP_GATE_SET( 1, 0 )
  ELSE
    _HIDE_SHIP_GATE_SET( 1, 1 )
  ENDIF
  
  //スイッチ（４）の見栄えを分岐
  IF $WK_SCENE_D27_SWITCH_04 == 0 THEN
    _HIDE_SHIP_GATE_SET( 0, 0 )
  ELSE
    _HIDE_SHIP_GATE_SET( 0, 1 )
  ENDIF
  
INIT_EVENT_END
/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r1301

  // ゲート状態設定
  _CALL sub_gate_set

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r1301

  // ゲート状態設定
  _CALL sub_gate_set

INIT_EVENT_END

// ゲート(バリアー)の状態をフラグを見て設定
sub_gate_set:
{
/*
  DEFINE_LOCAL state      // ゲートが解除してあるかどうか
  
  //【仮】 フラグが存在しない
  _FLAG_CHECK( FE_XXXX_01, state )
  _HIDE_SHIP_GATE_SET( 0, state )
  //【仮】 フラグが存在しない
  _FLAG_CHECK( FE_XXXX_02, state  )
  _HIDE_SHIP_GATE_SET( 1, state  )
  //【仮】 フラグが存在しない
  _FLAG_CHECK( FE_XXXX_03, state )
  _HIDE_SHIP_GATE_SET( 2, state )
  //【仮】 フラグが存在しない
  _FLAG_CHECK( FE_XXXX_04, state )
  _HIDE_SHIP_GATE_SET( 3, state )
*/
}
_RET

/************************************************************/
/*					特殊接続（船首楼）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_warp_01
  
  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //ワープ処理
  _MAP_CHANGE_WARP( ZONE_ID_D27R0301, 11, 5, LWK_DIR )

EVENT_END


/************************************************************/
/*					特殊接続（ブリッジ）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_warp_02

  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //ワープ処理
  _MAP_CHANGE_WARP( ZONE_ID_D27R0401, 7, 15, LWK_DIR )

EVENT_END

/************************************************************/
/*					特殊接続（ゲーチス部屋）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_warp_03

  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //ワープ処理
  _MAP_CHANGE_WARP( ZONE_ID_D27R0601, 8, 9, LWK_DIR )

EVENT_END

/************************************************************/
/*					バリア解除スイッチ（１）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_switch_01
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BUTTON_OFF( 3 )
  //ゲート解除演出
  _HIDE_SHIP_GATE_OFF( 3 )
  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_04 = 1
  //=====================================

EVENT_END

/************************************************************/
/*					バリア解除スイッチ（２）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_switch_02
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BUTTON_OFF( 2 )
  //ゲート解除演出
  _HIDE_SHIP_GATE_OFF( 2 )
  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_03 = 1
  //=====================================

EVENT_END

/************************************************************/
/*					バリア解除スイッチ（３）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_switch_03
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BUTTON_OFF( 1 )
  //ゲート解除演出
  _HIDE_SHIP_GATE_OFF( 1 )
  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_02 = 1
  //=====================================

EVENT_END

/************************************************************/
/*					バリア解除スイッチ（４）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_switch_04
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BUTTON_OFF( 0 )
  //ゲート解除演出
  _HIDE_SHIP_GATE_OFF( 0 )
  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_01 = 1
  //=====================================

EVENT_END

/************************************************************/
/*						ボタン1(左上)					*/
/************************************************************/
EVENT_START ev_pos_d27r1301_button_01

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK1 = 0
  $LOCALWORK2 = 0
  $LOCALWORK3 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 0 )

EVENT_END
/************************************************************/
/*						ボタン2(左下)					*/
/************************************************************/
EVENT_START ev_pos_d27r1301_button_02

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK0 = 0
  $LOCALWORK2 = 0
  $LOCALWORK3 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 1 )

EVENT_END
/************************************************************/
/*						ボタン3(右上)					*/
/************************************************************/
EVENT_START ev_pos_d27r1301_button_03

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK2 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK0 = 0
  $LOCALWORK1 = 0
  $LOCALWORK3 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 2 )

EVENT_END
/************************************************************/
/*						ボタン4(右下)					*/
/************************************************************/
EVENT_START ev_pos_d27r1301_button_04

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK3 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK0 = 0
  $LOCALWORK1 = 0
  $LOCALWORK2 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 3 )

EVENT_END

/************************************************************/
/*					【仮】バリア演出				*/
/************************************************************/
EVENT_START ev_pos_d27r1301_barrier_01
  
  //アニメ：「！」
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_01 )
  _OBJ_ANIME_WAIT()
  
  //ビリビリSE再生
  _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_08 )
  
  //アニメ：下方向に移動
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_02 )
  _OBJ_ANIME_WAIT()
  
  _SE_WAIT()
  
  
EVENT_END

//--------------------------------------------------------------------
//	主人公：上を向いて「！」
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_barrier_01
  _ANIME_DATA	AC_DIR_U,1
  _ANIME_DATA	AC_MARK_GYOE,1
  _ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	主人公：バリアーに弾かれる
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_barrier_02
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA	AC_STAY_WALK_U_4F,2
  _ANIME_DATA	AC_WALK_D_4F,2
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA	ACMD_END,0

