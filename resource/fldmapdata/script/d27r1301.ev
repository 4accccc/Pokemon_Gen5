/************************************************************/
/*					バリア解除スイッチ（１）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_switch_01
  
  //メッセージ：スイッチを踏んだ！
  _PLAINWIN_MSG_DOWN( msg_d27r1301_switch_01 )
  _MSGWIN_CLOSE()
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BUTTON_OFF( 0 )
  //ゲート解除演出
  _HIDE_SHIP_GATE_OFF( 0 )
  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_01 = 1
  //=====================================
  
  //メッセージ：バリアが解除された！
  IF $WK_SCENE_D27_SWITCH_01 == 1 && $WK_SCENE_D27_SWITCH_02 == 1 && $WK_SCENE_D27_SWITCH_03 == 1 && $WK_SCENE_D27_SWITCH_04 == 1 THEN
    _PLAINWIN_MSG_DOWN( msg_d27r1301_switch_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF

EVENT_END

/************************************************************/
/*					バリア解除スイッチ（２）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_switch_02
  
  //メッセージ：スイッチを踏んだ！
  _PLAINWIN_MSG_DOWN( msg_d27r1301_switch_01 )
  _MSGWIN_CLOSE()
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BUTTON_OFF( 1 )
  //ゲート解除演出
  _HIDE_SHIP_GATE_OFF( 1 )
  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_02 = 1
  //=====================================

  //メッセージ：バリアが解除された！
  IF $WK_SCENE_D27_SWITCH_01 == 1 && $WK_SCENE_D27_SWITCH_02 == 1 && $WK_SCENE_D27_SWITCH_03 == 1 && $WK_SCENE_D27_SWITCH_04 == 1 THEN
    _PLAINWIN_MSG_DOWN( msg_d27r1301_switch_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF

EVENT_END

/************************************************************/
/*					バリア解除スイッチ（３）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_switch_03

  //メッセージ：スイッチを踏んだ！
  _PLAINWIN_MSG_DOWN( msg_d27r1301_switch_01 )
  _MSGWIN_CLOSE()
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BUTTON_OFF( 2 )
  //ゲート解除演出
  _HIDE_SHIP_GATE_OFF( 2 )
  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_03 = 1
  //=====================================

  //メッセージ：バリアが解除された！
  IF $WK_SCENE_D27_SWITCH_01 == 1 && $WK_SCENE_D27_SWITCH_02 == 1 && $WK_SCENE_D27_SWITCH_03 == 1 && $WK_SCENE_D27_SWITCH_04 == 1 THEN
    _PLAINWIN_MSG_DOWN( msg_d27r1301_switch_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF

EVENT_END

/************************************************************/
/*					バリア解除スイッチ（４）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1301_switch_04

  //メッセージ：スイッチを踏んだ！
  _PLAINWIN_MSG_DOWN( msg_d27r1301_switch_01 )
  _MSGWIN_CLOSE()
  
  //ボタン踏んだ処理
  _HIDE_SHIP_BUTTON_OFF( 3 )
  //ゲート解除演出
  _HIDE_SHIP_GATE_OFF( 3 )
  //=====================================
  //POS無効
  $WK_SCENE_D27_SWITCH_04 = 1
  //=====================================

  //メッセージ：バリアが解除された！
  IF $WK_SCENE_D27_SWITCH_01 == 1 && $WK_SCENE_D27_SWITCH_02 == 1 && $WK_SCENE_D27_SWITCH_03 == 1 && $WK_SCENE_D27_SWITCH_04 == 1 THEN
    _PLAINWIN_MSG_DOWN( msg_d27r1301_switch_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF

EVENT_END

/************************************************************/
/*						ボタン1(左上)					*/
/************************************************************/
EVENT_START ev_pos_d27r1301_button_01

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK1 = 0
  $LOCALWORK2 = 0
  $LOCALWORK3 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 0 )

EVENT_END
/************************************************************/
/*						ボタン2(左下)					*/
/************************************************************/
EVENT_START ev_pos_d27r1301_button_02

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK0 = 0
  $LOCALWORK2 = 0
  $LOCALWORK3 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 1 )

EVENT_END
/************************************************************/
/*						ボタン3(右上)					*/
/************************************************************/
EVENT_START ev_pos_d27r1301_button_03

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK2 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK0 = 0
  $LOCALWORK1 = 0
  $LOCALWORK3 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 2 )

EVENT_END
/************************************************************/
/*						ボタン4(右下)					*/
/************************************************************/
EVENT_START ev_pos_d27r1301_button_04

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK3 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK0 = 0
  $LOCALWORK1 = 0
  $LOCALWORK2 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 3 )

EVENT_END

ev_battle_check:	
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

/************************************************************/
/*					バリア演出				*/
/************************************************************/
EVENT_START ev_pos_d27r1301_barrier_01
  
  //アニメ：「！」
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_01 )
  _OBJ_ANIME_WAIT()
  
  //ビリビリSE再生
  _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_08 )
  
  //アニメ：下方向に移動
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_02 )
  _OBJ_ANIME_WAIT()
  
  _SE_WAIT()
  
  
EVENT_END

