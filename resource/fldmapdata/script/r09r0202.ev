
//======================================================================
//                r09r0202.ev
//
//    スクリプトファイル：r09r0202用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_r09r0202.h"
  .include  "r09r0202.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_r09r0202_cleaningm_01
_EVENT_DATA    ev_r09r0202_sunglasses_01
_EVENT_DATA_END


/**************************************************************/
/*            ZONE_CHANGE_LABEL                               */
/**************************************************************/
//ev_zone_r09r0202:
//  _END

/**************************************************************/
/* 清掃員                                             */
/**************************************************************/
EVENT_START   ev_r09r0202_cleaningm_01
	_EASY_BALLOONWIN_TALKOBJ_MSG( msg_r09r0202_cleaningm_01 )
EVENT_END

/**************************************************************/
/*  SUNGLASSES                                            */
/**************************************************************/
EVENT_START   ev_r09r0202_sunglasses_01
  
  //初回話しかけであったならば
  IF FLAG_OFF(SYS_FLAG_FES_SHOCKSHOP1) THEN
  
    _TALK_OBJ_START()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_r09r0202_mission_add_01 )
    _YES_NO_WIN( SCWK_ANSWER )
    
    //はい
    IF $SCWK_ANSWER == SCR_YES THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_r09r0202_mission_add_02 )
    ELSE
      _BALLOONWIN_TALKOBJ_MSG( msg_r09r0202_mission_add_03 )
    ENDIF
    
    _MSGWIN_CLOSE()
    
    //フェスミッション名代入
    _FMISSION_NAME( 0, FMISSION_ID_NPC_SHOCKSHOP_01, 0 )
    
    //フェスミッションが追加されました
    _SE_PLAY( SEQ_SE_FLD_133 )
    _SYSWIN_MSG( msg_r09r0202_mission_add_04, POS_DEFAULT )
    _SE_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
    _BALLOONWIN_TALKOBJ_MSG( msg_r09r0202_mission_add_05 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //==================================//
    //初回会話終了
    _FLAG_SET(SYS_FLAG_FES_SHOCKSHOP1)
    //==================================//
    
  //2回目以降
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r09r0202_mission_add_05 )
  ENDIF
  
EVENT_END
