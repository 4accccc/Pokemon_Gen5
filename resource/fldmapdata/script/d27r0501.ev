  .text

  .include  "scr_seq_def.h"
  .include  "msg_d27r0501.h"
  .include  "d27r0501.h"
  .include  "w21.h" //w21への遷移参照用
  .include  "w21_def.h" //w21への遷移参照用

  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_d27r0501
_EVENT_DATA    ev_init_d27r0501
_EVENT_DATA    ev_recover_d27r0501
_EVENT_DATA    ev_scene_d27r0501_swsage7_01
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
/************************************************************/
/*					ZONE_CHANGE_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r0501
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //W2接続
  IF $LCWK_VERSION == VERSION_B2 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0501_D27R1201_EXIT01, 0, 0, 0 ) 
  //W2接続
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D27R0501_D27R0201_EXIT01, 0, 0, 0 ) 
  ENDIF

INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r0501
  
  //
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r0501

  //

INIT_EVENT_END

/************************************************************/
/*					SCENE_CHANGE：ヴィオ戦  						*/
/************************************************************/
EVENT_START	ev_scene_d27r0501_swsage7_01

  //========================================//
  //ヴィオ・ダークトリニティ表示
  _FLAG_RESET( FV_D27R0501_SWSAGE7_01 )
  _FLAG_RESET( FV_D27R0501_NINJA_01 )
  //========================================//
  
  //アニメ：主人公中央へ移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 12, 17, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //イベント曲再生
  //_START_TEMP_EVENT_BGM( SEQ_BGM_E_7_SAGE )
  
  //七賢人動作モデル生成
  _OBJ_ADD( D27R0501_SWSAGE7_01 )
  
  //アニメ：ヴィオワープして登場・主人公振り向き
  _OBJ_ANIME( D27R0501_SWSAGE7_01, anm_swsage7_warp_in )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ヴィオ：そのポケモンは……
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_02_01 , D27R0501_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ヴィオ：キュレム！
  _GIZAWIN_OBJMSG_POS( msg_d27r0101_sage7_02_02 , D27R0501_SWSAGE7_01, POS_DEFAULT )
  _GIZAWIN_CLOSE()
  
  //ヴィオ：さて……
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_02_04 , D27R0501_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //トレーナー戦
  _TRAINER_BTL_SET( TRID_SWSAGE3_01, 0 )
  _CALL ev_battle_check
  
  //ヴィオ：むぅ！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_02_05 , D27R0501_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル動作モデル生成
  _OBJ_ADD_EX( 12, 20, DIR_UP, MMDL_ID_EVENTOBJ_00, SWRIVAL, MV_DMY )
  
  //アニメ：ライバルワープして登場
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swrival_warp_in )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( D27R0501_SWSAGE7_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //ライバル：ここは……！？
  _BALLOONWIN_OBJMSG_POS( msg_d27r0501_swrival_02_01 , MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル「！」
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //ライバル：あの　ポケモンは……
  _BALLOONWIN_OBJMSG_POS( msg_d27r0501_swrival_02_02 , MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル窓を見る・ヴィオも隣接
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_swrival_look_window )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( D27R0501_SWSAGE7_01, anm_swsage7_look_swrival )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ヴィオ：そうとも
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_02_06 , D27R0501_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル下を見る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ライバル：きまってるだろ！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0501_swrival_02_03 , MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ヴィオ：チョロネコくらい
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_02_07 , D27R0501_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：……しんだ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0501_swrival_02_04 , MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ヴィオ：こじんの
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_02_08 , D27R0501_SWSAGE7_01 ,POS_DEFAULT )
  
  //ヴィオ：……さて
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_02_09 , D27R0501_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：ふざけるな！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0501_swrival_02_05 , MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //キュレム：ヒュララ……
  _VOICE_PLAY(MONSNO_653,0)
  _PLAINWIN_MSG_DOWN( msg_d27r0501_poke10_02_01 )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //ダークトリニティ動作モデル生成
  _OBJ_ADD( D27R0501_NINJA_01 )
  _OBJ_ADD( D27R0501_NINJA_02 )
  
  //アニメ：ダークトリニティ登場
  _OBJ_ANIME( D27R0501_NINJA_01, anm_ninja_coming_01 )
  _OBJ_ANIME( D27R0501_NINJA_02, anm_ninja_coming_01 )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //========================================//
  //ヴィオ・ダークトリニティ非表示
  _FLAG_SET( FV_D27R0501_SWSAGE7_01 )
  _FLAG_SET( FV_D27R0501_NINJA_01 )
  //D27R0701 SCENE_CHANGE無効
  $WK_SCENE_D27R0501_SWSAGE7_01 = 2
  //W21ライバル表示
  _FLAG_RESET( FV_W21_SWRIVAL_01 )
  //W21チェレン表示
  _FLAG_RESET( FV_W21_SWLEADER1_01 )
  //W21イベント進行
  $WK_SCENE_W21_01 = 4
  //プラズマフリゲート・現在地対応
  $WK_SYS_HIDE_SHIP_PLACE = SCR_HIDE_SHIP_PLACE_D10
  //========================================//
  
  //W21に遷移
  
  //マップ差し替え:W21アジト船非表示
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, FALSE , FALSE )
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, FALSE , FALSE )
  
  //ブラックアウト（マップ遷移あり）
	_DEMO_FADEOUT_BLACK_CALL_SINGLE()
	
	//デモ再生処理
	_CALL_3D_DEMO( DEMO3D_ID_PLASMA_SHIP_FLY )
  
  //予約スクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_W21_SWPLAZMA_END_01 )
  //W21マップチェンジ1
  _MAP_CHANGE_NO_FADE( ZONE_ID_W21, 794, 0, 241, DIR_DOWN )
  

EVENT_END

ev_battle_check:	
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

