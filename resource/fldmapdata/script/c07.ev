/**************************************************************/
/*  女の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c07_girl2_01

  _TALK_OBJ_START()

  //女の子：でんせつの　ポケモン　レシラムは（バージョンでセリフが異なる）
  _BALLOONWIN_OBJMSG_WB( msg_c07_girl2_01w, msg_c07_girl2_01b, C07_GIRL2_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

