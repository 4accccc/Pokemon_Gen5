/**************************************************************/
/*               フィールド初期化スクリプト                   */
/**************************************************************/
INIT_EVENT_START ev_zone_c07
{
	DEFINE_LOCAL	LWK_SEASON
	
	_GET_SEASON_ID( LWK_SEASON )

	//別の季節になっている場合はワークを０にする
	SWITCH $WK_OTHER_C07_SEASON
	CASE 1 THEN	//春の場合	
		IF $LWK_SEASON != PMSEASON_SPRING THEN
			$WK_OTHER_C07_SEASON = 0
		ENDIF
	CASE 2 THEN	//夏の場合
		IF $LWK_SEASON != PMSEASON_SUMMER THEN
			$WK_OTHER_C07_SEASON = 0
		ENDIF
	CASE 3 THEN	//秋の場合
		IF $LWK_SEASON != PMSEASON_AUTUMN THEN
			$WK_OTHER_C07_SEASON = 0
		ENDIF
	CASE 4 THEN	//冬の場合
		IF $LWK_SEASON != PMSEASON_WINTER THEN
			$WK_OTHER_C07_SEASON = 0
		ENDIF
	ENDSWITCH
	
	//========================================//
	//C07R0301 サウンドデザイナーイベントをリセット
	_FLAG_RESET( SYS_FLAG_BGM_C07R0301_R10 )
	//========================================//
	
}
INIT_EVENT_END

