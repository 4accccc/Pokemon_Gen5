/************************************************************/
/*		船降りた後のリザーブ						*/
/************************************************************/
EVENT_START	ev_reserve_c03p15_end

	//暗転復帰
	_MAP_FADE_BLACK_IN()
	_DISP_FADE_END_CHECK()
	
	_PLACE_NAME_DISPLAY()	//地名表示演出
	
EVENT_END

/**************************************************************/
/*   C03P15：WOMAN1一言メッセージ                                */
/**************************************************************/
EVENT_START   ev_c03p15_woman1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03p15_woman1_01 )
EVENT_END

/**************************************************************/
/*   C03P1：GENTLEMAN一言メッセージ                                */
/**************************************************************/
EVENT_START   ev_c03p15_gentleman_01
  
  //C05到着前
  IF FLAG_OFF(SYS_FLAG_ARRIVE_C05) THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03p15_gentleman_01 )
  //C05到着後
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03p15_gentleman_02 )
  ENDIF
EVENT_END