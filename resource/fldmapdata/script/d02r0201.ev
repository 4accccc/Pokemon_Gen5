  .text

  .include  "scr_seq_def.h"
  .include  "msg_d02r0201.h"
  .include  "d02r0201.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_d02r0201
_EVENT_DATA   ev_d02r0201_rangerm_01
_EVENT_DATA_END


/************************************************************/
/*  ZONE_CHANGE_SCRIPT                                      */
/************************************************************/
INIT_EVENT_START  ev_zone_d02r0201

INIT_EVENT_END

/**************************************************************/
/*  レンジャー♂：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_d02r0201_rangerm_01

  _TALK_OBJ_START()

  //会話済みか
  IF FLAG_ON( FE_D02R0201_RANGERM_01 ) THEN
    //レンジャー♂：きいたところ　ビリジオンと　いい
    _BALLOONWIN_TALKOBJ_MSG( msg_d02r0201_rangerm_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE
    //レンジャー♂：ソウリュウシティに　でんせつの
    _BALLOONWIN_TALKOBJ_MSG( msg_d02r0201_rangerm_01 )

    //レンジャー♂：このあたりで　つよく　かなしい
    _BALLOONWIN_TALKOBJ_MSG( msg_d02r0201_rangerm_02 )

    //レンジャー♂：きいたところ　ビリジオンと　いい
    _BALLOONWIN_TALKOBJ_MSG( msg_d02r0201_rangerm_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //==================================//
    //初回会話フラグON（以降、会話繰り返し）
    _FLAG_SET( FE_D02R0201_RANGERM_01 )
    //==================================//

  ENDIF

EVENT_END



