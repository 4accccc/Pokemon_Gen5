//    スクリプトファイル：t06r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_t06r0401.h"
  .include  "t06r0401.h"
  .include  "skill_teach_scr_def.h"     //for SCRID_SKILL_LEARN

	//@author ichiraku_katsuhiko //仕組作成
	//@author suginaka_katsunori //演出追加

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_bg_t06r0401_kerudhio
_EVENT_DATA_END

// ローカルワーク
DEFINE_LOCAL  target_poke_pos     // 配布ケルディオの場所

/************************************************************/
/*  BGイベント：配布ケルディオのイベント                    */
/************************************************************/
EVENT_START   ev_bg_t06r0401_kerudhio
{
  _TALK_START_SE_PLAY()
  
  // 条件を満たすケルディオがいるかチェック
  _GET_EVT_POKE_POS( MONSNO_654, FALSE, target_poke_pos, SCWK_ANSWER )

  // 条件をみたしている場合
  // フォルムが0かチェック
  IF $SCWK_ANSWER == TRUE THEN
    DEFINE_LOCAL form_no
    // フォルムナンバー取得
    _GET_PARTY_POKE_FORMNO( form_no, target_poke_pos )
    // フォルムが0以外なら条件を満たさない
    IF $form_no != 0 THEN
      $SCWK_ANSWER = FALSE  // 条件を満たさないことにする
    ENDIF
  ENDIF

  // いる
  IF $SCWK_ANSWER == TRUE THEN
	// BG:がんばんに　３ぼんの　するどく　みごとな　さけめが　きざまれている
   	_PLAINWIN_MSG_DOWN( msg_t06r0401_cliff_01 )
   	_AB_KEYWAIT_MARK()

    _TEMOTI_NICK_NAME( 0, target_poke_pos )
    // SYS:○○が　でたがっているようだ そとに　だしてあげますか？
    _PLAINWIN_MSG_DOWN( msg_t06r0401_cliff_02 )
    _YES_NO_WIN( SCWK_ANSWER )

    // YES
    IF $SCWK_ANSWER == SCR_YES THEN
  	 
  	 _PLAINWIN_CLOSE()
  	 
      // ケルディオイベントメイン
      _CALL func_kerudhio_main

    // NO
    ELSE

      // SYS:モンスターボールの うごきが とまったようだ
      _PLAINWIN_MSG_DOWN( msg_t06r0401_cliff_03 )
      _LAST_KEYWAIT()
      _PLAINWIN_CLOSE()
      // イベント終了

    ENDIF

  ELSE
  // いない
   	// BG:がんばんに　３ぼんの　するどく　みごとな　さけめが　きざまれている
   	_PLAINWIN_MSG_DOWN( msg_t06r0401_cliff_01 )
   	_LAST_KEYWAIT()
   	_PLAINWIN_CLOSE()
   	
  ENDIF
}
EVENT_END

//=============================================================================
//    関数
//=============================================================================
//-----------------------------------------------------------------------------
// ケルディオイベントメイン
//-----------------------------------------------------------------------------
func_kerudhio_main:
{
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  // ボールを投げる
  _CALL func_ball_out

  //鳴き声
  _VOICE_PLAY( MONSNO_KERUDHIO,FORMNO_KERUDHIO_NORMAL )
  _VOICE_WAIT()

  //アニメ：ケルディオ周囲を見渡した後、岩に気づく
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_kyorokyoro )
  _OBJ_ANIME_WAIT()
  
  //アニメ：左から岩に近づく
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_poke11_move01 )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //アニメ：右の方から岩を見る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_poke11_move02 )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  //鳴き声
  _VOICE_PLAY( MONSNO_KERUDHIO,FORMNO_KERUDHIO_NORMAL )

  //アニメ：右の方から岩を見る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_poke11_move03 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //アニメ：主人公をどかして岩の前に行く
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_poke11_move04 )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_move01 )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_poke11_move05 )
  _OBJ_ANIME_WAIT()

  //鳴き声
  _VOICE_PLAY( MONSNO_KERUDHIO,FORMNO_KERUDHIO_NORMAL )
  _VOICE_WAIT()

  //アニメ：しんぴのつるぎを思い出す。
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_poke11_move06 )
  _OBJ_ANIME_WAIT()

  // しんぴのつるぎを覚えているかチェック
  _CHECK_POKE_WAZA( SCWK_ANSWER, WAZANO_SINPINOTURUGI, target_poke_pos )

  IF $SCWK_ANSWER == TRUE THEN
    // 覚えている
    
    // フォルムチェンジ
    _CALL func_form_change

  ELSE
    // 覚えていない

    // SYS:しんぴのつるぎを　おもいだした！
    _SYSWIN_MSG( msg_t06r0401_cliff_04, POS_DOWN )
    _AB_KEYWAIT_MARK()

    //技思い出し処理
    $SCWK_PARAM0 = $target_poke_pos
    $SCWK_PARAM1 = WAZANO_SINPINOTURUGI
    //技おもいだしシーケンス SCWK_ANSWER=TRUEで覚えた
    _CALL func_skill_remember

    // 覚えたかチェック
    IF $SCWK_ANSWER == TRUE THEN
      // 覚えた

      // フォルムチェンジ
      _CALL func_form_change

    ELSE
      // 覚えなかった
      
    ENDIF

  ENDIF

  // ボールに戻る
  _CALL func_ball_in
  
}
_RET
//-----------------------------------------------------------------------------
// ボールから飛び出る
//-----------------------------------------------------------------------------
func_ball_out:
{
  // ボール移動
  _MOVE_BALL( SCR_BALL_ANM_TYPE_OUT, 15, 0, 16, 3, 8 )
  // ボールアニメ
  _START_BALL_ANM( SCR_BALL_ANM_TYPE_OUT, 15, 0, 16 )
  //ボール出現フレーム待ち
  _WAIT_BALL_POKE_APP( SCR_BALL_ANM_TYPE_OUT )
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()
  //ポケを表示
  _OBJ_ADD_EX( 15, 16, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE11, MV_DMY )
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _WAIT_BALL_ANM( SCR_BALL_ANM_TYPE_OUT )
}
_RET
//-----------------------------------------------------------------------------
// ボールに戻る
//-----------------------------------------------------------------------------
func_ball_in:
{
  _START_BALL_ANM( SCR_BALL_ANM_TYPE_IN, 15, 0, 13 )
  //ポケ非表示フレーム待ち
  _WAIT_BALL_POKE_APP( SCR_BALL_ANM_TYPE_IN )
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()
  //ポケ非表示
  _OBJ_DEL(MMDL_ID_EVENTOBJ_00)
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _WAIT_BALL_ANM( SCR_BALL_ANM_TYPE_IN )
  _MOVE_BALL( SCR_BALL_ANM_TYPE_IN, 15, 0, 15, 3, 8 )
}
_RET
//-----------------------------------------------------------------------------
// フォルムチェンジ
//-----------------------------------------------------------------------------
func_form_change:
{
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラパージ
  _CAMERA_MOVE(7768,0,970752,1015808,45056,765952, 40)
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち

  //○○のようすが・・・・？
  _PLAINWIN_MSG_DOWN( msg_t06r0401_cliff_11 )
  _PLAINWIN_CLOSE()

  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  // 思い出しイベント
  _KERUDHIO_GMK_REMEMBER_EVENT()

  // ホワイトフェードアウト
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()

  // エフェクト削除
  _KERUDHIO_GMK_EFFECT_DELETE()

  // フォルムチェンジ後に 動作モデル変更
  _OBJ_DEL(MMDL_ID_EVENTOBJ_00)
  _OBJ_ADD_EX( 15, 13, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE11_FORM, MV_DMY )

  // カットイン
  _CALL_FLD3D_CUTIN( FLDCIID_KERUDHIO )
  // 鳴き声とともにフェードイン
  _VOICE_PLAY( MONSNO_654, 1 )
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _VOICE_WAIT()

  // フォルムチェンジ
  _CHANGE_FORM_NO( target_poke_pos, 1 )

  // SYS:かくごを　きめた　すがたに　なった！
  //○○のようすが・・・・？
  _PLAINWIN_MSG_DOWN( msg_t06r0401_cliff_12 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()

  _CAMERA_RECV_MOVE(30)	//カメラ復帰移動
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  _CAMERA_BIND()		//カメラバインド
  _CAMERA_END()		//カメラ操作終了

}
_RET
//-----------------------------------------------------------------------------
// わざおもいだしルーチン
// 
// skill_teach_scr.evを参考
// 
// @param SCWK_PARAM0   選択したポケモンの位置
// @param SCWK_PARAM1   おもいだすわざのID
//
// @return SCWK_ANSWER  TRUEでおもいだした
//-----------------------------------------------------------------------------
{
  DEFINE_LOCAL select_pos	        // 選択ポケモン
  DEFINE_LOCAL teach_waza_id
	DEFINE_LOCAL waza_pos	// 選択技
	DEFINE_LOCAL waza_id	// 技番号
	DEFINE_LOCAL loop_flag	// 技ループ処理監視
	DEFINE_LOCAL user_result	// 

func_skill_remember:
  
  $select_pos     = $SCWK_PARAM0
  $teach_waza_id  = $SCWK_PARAM1

  // わざの数取得
  _GET_TEMOTI_WAZA_NUM( SCWK_ANSWER, select_pos )

  // わざが空いているのでそのまま設定
  IF $SCWK_ANSWER != 4 THEN 

    _TEMOTI_NICK_NAME( 0, select_pos )

    //"○○はしんぴのつるぎを思い出した！"
    _SYSWIN_MSG( msg_t06r0401_cliff_10 , POS_DEFAULT )
    _ME_PLAY( SEQ_ME_LVUP )
    _ME_WAIT()
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()

    _SET_TEMOTI_WAZA( select_pos , SCWK_ANSWER , teach_waza_id )

    // おもいだした
    $SCWK_ANSWER = TRUE

    _RET
  ENDIF

  // どれをわすれる？
  $loop_flag = TRUE
  WHILE $loop_flag == TRUE

    _CALL   sub_skillteacher_wasure_core

    IF $user_result == TRUE THEN
      $SCWK_ANSWER = TRUE
      $loop_flag = FALSE
    ELSE

      _CALL   sub_skillteacher_wasure_ask_retire
      IF $user_result == TRUE THEN
        $SCWK_ANSWER = FALSE
        $loop_flag = FALSE
      ENDIF

    ENDIF

  ENDWHILE

_RET

/**************************************************************/
/**************************************************************/
sub_skillteacher_wasure_ask_retire:
  //"それでは　しんぴのつるぎをおもいだすのをあきらめますか？"
  _SYSWIN_MSG( msg_t06r0401_cliff_06, POS_DEFAULT )
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN
    //"～は　しんぴのつるぎを　おもいださなかった！"
    _TEMOTI_NICK_NAME( 0, select_pos )
    _SYSWIN_MSG( msg_t06r0401_cliff_07 , POS_DEFAULT )
    _SYSWIN_CLOSE()
    $user_result = TRUE //終了
    _RET
  ENDIF

  $user_result = FALSE //継続
  _RET

/**************************************************************/
/**************************************************************/
sub_skillteacher_wasure_core:
    $user_result = FALSE

		//"○○はすでにわざを４つおぼえている　わざをわすれさせますか？"
    _TEMOTI_NICK_NAME( 0, select_pos )
		_SYSWIN_MSG( msg_t06r0401_cliff_05 , POS_DEFAULT )
    _YES_NO_WIN( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_NO THEN
      _RET
    ENDIF
    
    _SYSWIN_CLOSE()
    _SELECT_WAZA_TEMOTI_POKE( SCWK_ANSWER , waza_pos , select_pos , teach_waza_id )
    IF $SCWK_ANSWER == FALSE THEN
      _RET
    ENDIF

    _GET_TEMOTI_WAZA_ID( waza_id , select_pos , waza_pos )
    _WAZA_NAME( 1 , waza_id )
    //"～をわすれさせて　よろしいですね？"
    _SYSWIN_MSG( msg_t06r0401_cliff_08, POS_DEFAULT )
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_NO THEN
      _RET
    ENDIF
    
    _GET_TEMOTI_WAZA_ID( waza_id , select_pos , waza_pos )
    _TEMOTI_NICK_NAME( 0, select_pos )
    _WAZA_NAME( 1 , waza_id )
    //"1　２　のポカン！"
    _SYSWIN_MSG( msg_t06r0401_cliff_09 , POS_DEFAULT )
    _SYSWIN_MSG( msg_t06r0401_cliff_10 , POS_DEFAULT )
    _ME_PLAY( SEQ_ME_LVUP )
    _ME_WAIT()
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()
    
    _SET_TEMOTI_WAZA( select_pos , waza_pos , teach_waza_id )
    $user_result = TRUE
    _RET
}

