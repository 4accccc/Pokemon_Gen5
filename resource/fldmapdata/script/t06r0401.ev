
//======================================================================
//                t06r0401.ev
//
//    スクリプトファイル：t06r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_t06r0401.h"
  .include  "t06r0401.h"
  .include  "skill_teach_scr_def.h"     //for SCRID_SKILL_LEARN

	//@author ichiraku_katsuhiko //仕組作成

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_bg_t06r0401_kerudhio
_EVENT_DATA_END

// ローカルワーク
DEFINE_LOCAL  target_poke_pos     // 配布ケルディオの場所

/************************************************************/
/*  BGイベント：配布ケルディオのイベント                    */
/************************************************************/
EVENT_START   ev_bg_t06r0401_kerudhio
{

  _TALK_START_SE_PLAY()

  // BG:がんばんに　３ぼんの　するどく　みごとな　さけめが　きざまれている
  _BGWIN_MSG( msg_t06r0401_cliff_01, TYPE_INFO )

  // 条件を満たすケルディオがいるかチェック
  _GET_EVT_POKE_POS( MONSNO_654, TRUE, target_poke_pos, SCWK_ANSWER )
  // いる
  IF $SCWK_ANSWER == TRUE THEN

    _BGWIN_CLOSE()

    _TEMOTI_NICK_NAME( 0, target_poke_pos )
    // SYS:○○が　でたがっているようだ そとに　だしてあげますか？
    _SYSWIN_MSG( msg_t06r0401_cliff_02, POS_DOWN )
    _YES_NO_WIN( SCWK_ANSWER )

    // YES
    IF $SCWK_ANSWER == SCR_YES THEN
  
      // ケルディオイベントメイン
      _CALL func_kerudhio_main

    // NO
    ELSE

      // SYS:モンスターボールの うごきが とまったようだ
      _SYSWIN_MSG( msg_t06r0401_cliff_03, POS_DOWN )
      _LAST_KEYWAIT()
      _SYSWIN_CLOSE()
      // イベント終了

    ENDIF

  ELSE
  // いない
    _LAST_KEYWAIT()
    _BGWIN_CLOSE()
    // イベント終了
  ENDIF
}
EVENT_END

//=============================================================================
//    関数
//=============================================================================
//-----------------------------------------------------------------------------
// ケルディオイベントメイン
//-----------------------------------------------------------------------------
func_kerudhio_main:
{
  // ボールを投げる
  _CALL func_ball_out

  //【仮】鳴き声
  _TIME_WAIT(10)

  //【仮】ケルディオ動き回る
  _TIME_WAIT(10)

  // しんぴのつるぎを覚えているかチェック
  _CHECK_POKE_WAZA( SCWK_ANSWER, WAZANO_SINPINOTURUGI, target_poke_pos )

  IF $SCWK_ANSWER == TRUE THEN
    // 覚えている
    
    // フォルムチェンジ
    _CALL func_form_change

  ELSE
    // 覚えていない

    // SYS:しんぴのつるぎを　おもいだした！
    _SYSWIN_MSG( msg_t06r0401_cliff_04, POS_DOWN )

    //【仮】技思い出し処理
    $SCWK_PARAM0 = $target_poke_pos
    $SCWK_PARAM1 = WAZANO_SINPINOTURUGI
    //技覚えシーケンス SCWK_ANSWER=TRUEで覚えた
    _CHG_COMMON_SCR SCRID_SKILL_LEARN

    // 覚えたかチェック
    IF $SCWK_ANSWER == TRUE THEN
      // 覚えた

      // フォルムチェンジ
      _CALL func_form_change

    ELSE
      // 覚えなかった
      
    ENDIF

  ENDIF

  // ボールに戻る
  _CALL func_ball_in
}
_RET
//-----------------------------------------------------------------------------
// ボールから飛び出る
//-----------------------------------------------------------------------------
func_ball_out:
{
  // ボール移動
  _MOVE_BALL( SCR_BALL_ANM_TYPE_OUT, 15, 0, 15, 3, 8 )
  // ボールアニメ
  _START_BALL_ANM( SCR_BALL_ANM_TYPE_OUT, 15, 0, 15 )
  //ボール出現フレーム待ち
  _WAIT_BALL_POKE_APP( SCR_BALL_ANM_TYPE_OUT )
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()
  //ポケを表示
  _OBJ_ADD_EX( 15, 15, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE11, MV_DMY )
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _WAIT_BALL_ANM( SCR_BALL_ANM_TYPE_OUT )
}
_RET
//-----------------------------------------------------------------------------
// ボールに戻る
//-----------------------------------------------------------------------------
func_ball_in:
{
  _START_BALL_ANM( SCR_BALL_ANM_TYPE_IN, 15, 0, 15 )
  //ポケ非表示フレーム待ち
  _WAIT_BALL_POKE_APP( SCR_BALL_ANM_TYPE_IN )
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()
  //ポケ非表示
  _OBJ_DEL(MMDL_ID_EVENTOBJ_00)
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _WAIT_BALL_ANM( SCR_BALL_ANM_TYPE_IN )
  _MOVE_BALL( SCR_BALL_ANM_TYPE_IN, 15, 0, 15, 3, 8 )
}
_RET
//-----------------------------------------------------------------------------
// フォルムチェンジ
//-----------------------------------------------------------------------------
func_form_change:
{
  // SYS:○○のようすが・・・・？
  _SYSWIN_MSG( msg_t06r0401_cliff_11, POS_DOWN )
  _SYSWIN_CLOSE()

  // 思い出しイベント
  _KERUDHIO_GMK_REMEMBER_EVENT()

  // ホワイトフェードアウト
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()

  // エフェクト削除
  _KERUDHIO_GMK_EFFECT_DELETE()

  // フォルムチェンジ後に 動作モデル変更
  _OBJ_DEL(MMDL_ID_EVENTOBJ_00)
  _OBJ_ADD_EX( 15, 15, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE11_FORM, MV_DMY )

  // 鳴き声とともにフェードイン
  _VOICE_PLAY( MONSNO_654, 1 )
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _VOICE_WAIT()

  // カットイン
  _CALL_FLD3D_CUTIN( FLDCIID_KERUDHIO )

  // フォルムチェンジ
  _CHANGE_FORM_NO( target_poke_pos, 1 )

  // SYS:かくごを　きめた　すがたに　なった！
  _SYSWIN_MSG( msg_t06r0401_cliff_12, POS_DOWN )
  _SYSWIN_CLOSE()
}
_RET


