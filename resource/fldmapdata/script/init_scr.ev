//=====================================================================
//  init_scr.ev
//  初回ゲーム開始時のみで呼ばれる初期化専用スクリプトイベント
//=====================================================================
  .text
  .include "scr_seq_def.h"

//-------------------------------------------------------------
//  スクリプトテーブル
//-------------------------------------------------------------
_EVENT_DATA ev_init_script
_EVENT_DATA ev_init_gameclear_script
_EVENT_DATA ev_init_debug_script
_EVENT_DATA_END

//=====================================================================
//  ゲーム開始スクリプト
//  ※非常駐プログラム類の呼び出しは禁止
//=====================================================================
INIT_EVENT_START  ev_init_script
{
	_CALL	init_flags
	_CALL init_my_answers
  //全滅時の戻り先設定：通常ゲーム開始時は自宅1階から
  _SET_WARP_ID( WARP_ID_T01 )

  _ADD_GOLD( 3000 )   //初期値０円＋３０００円がゲーム開始時の手持ち
}
INIT_EVENT_END


init_flags:
{
	//R03道路：育て屋じいさん
	_FLAG_SET( FV_R03_SODATEYA_01 )

	//バトルサブウェイ　受付、パートナー
	_FLAG_SET( FV_BSUBWAY_RECEIPT_PARTNER )
	//バトルサブウェイ　ホーム、パートナー
	_FLAG_SET( FV_C04R0111_PARTNER )
	//バトルサブウェイ　ホーム、NPC
	_FLAG_SET( FV_C04R0111_NPC )
	
	//C06R101のGIRL1に話しかけるまで、C06のモンスターボールを非表示
	_FLAG_SET( FV_C06_MONSTERBALL )	

	//C06R0201のフキヨセジムクリアと博士と合流までフウロ、博士、ベルを非表示
	_FLAG_SET( FV_C06R0201_SWLEADER6_01 )
	_FLAG_SET( FV_C06R0201_HAKASE2_01 )
	_FLAG_SET( FV_C06R0201_SWBELL_01 )

	//C06のモンスターボールをに話しかけるまで、BOY2とBABYGIRL1を非表示
	_FLAG_SET( FV_C06_GIRLBOY_01 )	
	
	//各ポケセンにいるふしぎな贈り物配達員
	_FLAG_SET( FV_POSTMAN )

	//映画関連ゾロアークイベントの女性（ゾロアーク）。イベント起動で表示。
	_FLAG_SET( FV_R16R0201_WOMAN3 )

	//R14R0201：ツチノカミ
	_FLAG_SET( FV_R14R0201_LEG )

	//リュウラセンの塔のパッケージポケモンを消しておく
	_FLAG_SET(FV_D08R0901_PACKAGE_POKE)

	//ギアステーションのジャッジを非表示
	_FLAG_SET( FV_POKE_JUDGE_01 )
	
	//カナワ民家：バトルサブウェイの落し物初回入手数をセット
	$WK_OTHER_BSEVENT_NUM = 1

	//★SWAN
	//c12r0101のベルとママを非表示
	_FLAG_SET(FV_C12R0101_SWMAMA)
	_FLAG_SET(FV_C12R0101_SWBELL)

  //C04 ライバルとプラズマ団イベント前には非表示
  _FLAG_SET( FV_C04_SWRIVAL_01 )
  _FLAG_SET( FV_C04_SWPLASMAM_01 )

	//c12r0101の表彰状とトロフィーを非表示

	_FLAG_SET(FV_C12R0101_TRORHY1_01)
	_FLAG_SET(FV_C12R0101_TRORHY2_01)
	_FLAG_SET(FV_C12R0101_TRORHY3_01)
	_FLAG_SET(FV_C12R0101_PRIZE1_01)
	_FLAG_SET(FV_C12R0101_PRIZE2_01)

	//d22r0101のbreederを非表示
	_FLAG_SET(FV_D22R0101_BREEDER_01)
	
	//C12のママを非表示
	_FLAG_SET( FV_C12_SWMAMA )
	//C12のライバルを非表示
	_FLAG_SET( FV_C12_SWANLEADER1 )
	
	//C12PC0101：PCの曲をつれてけ曲に設定
	_FLAG_SET( SYS_FLAG_BGM_C12PC0101_GUIDE )
	
	//T06のメダルおやじを非表示
	_FLAG_SET( FV_T06_SUNGLASSES_01 )
	
	//C13
	_FLAG_SET( FV_C13_SWPLAZMA )
	_FLAG_SET( FV_C13R0401_PILOT )
	_FLAG_SET( FV_C13R0401_SWRIVAL )
	
	//C13GYM
	_FLAG_SET( FV_C13GYM0102_SWLEADER2 )
	
	//PC
	_FLAG_SET( FV_PC_MEDALOYAJI )
	
	//C03
	_FLAG_SET( FV_C03_SWCHAMPION_01 ) //アイリス：ジム前イベント後表示
	_FLAG_SET( FV_C03P17_SWCHAMPION_01 )  //アイリス：下水道前イベント起動時表示
	_FLAG_SET( FV_C03P17_SWRIVAL_01 ) //ライバル：下水道前イベント起動時表示
	_FLAG_SET( FV_C03P17_PILOT_01 ) //ライバル：下水道前イベント起動時表示
	_FLAG_SET( FV_C03P01_SWBOSS_01 )  //アクロマ：ジムクリア後表示
	
	//R04
	_FLAG_SET( FV_R04_SWBOSS_01 ) //アクロマ：ジムクリア後表示
	
	//C05
	
	//C05：ヤーコンを非表示に
	_FLAG_SET( FV_C05_SWLEADER5_01 )
	//C05：ライバルを非表示に
	_FLAG_SET( FV_C05_SWRIVAL_01 )
	//C05：SAGE6を非表示に
  _FLAG_SET( FV_C05_SAGE6_01 )

}
_RET


//--------------------------------
// 調査レーダーの自分の回答初期化
//--------------------------------
init_my_answers:
{
	//『ブラックとホワイト どっち？』
	_GET_ROM_VERSION( SCWK_ANSWER )
	SWITCH $SCWK_ANSWER
	CASE VERSION_B2 THEN _SET_MY_ANSWER( QUESTION_ID_WB, 1 )
	CASE VERSION_W2 THEN _SET_MY_ANSWER( QUESTION_ID_WB, 2 )
	ENDSWITCH

	//『男と女 どっち？』
	_GET_MY_SEX( SCWK_ANSWER )
	SWITCH $SCWK_ANSWER
	CASE PM_MALE   THEN _SET_MY_ANSWER( QUESTION_ID_SEX, 1 )
	CASE PM_FEMALE THEN _SET_MY_ANSWER( QUESTION_ID_SEX, 2 )
	ENDSWITCH

	//『ゲームプレイ時間は？』
	_SET_MY_ANSWER( QUESTION_ID_PLAY_TIME, 1 )
}
_RET


//=====================================================================
//  ゲーム開始スクリプト（デバッグ）
//  ※非常駐プログラム類の呼び出しは禁止なのは一緒
//=====================================================================
INIT_EVENT_START  ev_init_debug_script
{
  //初期化時のイベントフラグ設定は共通
	_CALL	init_flags
  //全滅時の戻り先設定：デバッグゲーム開始時はC01から（T02はイベントがあるため）
  _SET_WARP_ID( WARP_ID_C01 )
  //CGear入手済みにする
	_FLAG_SET( FE_CGEAR_GET )
  //メニュー項目「ポケモン」をON
	_FLAG_SET( SYS_FLAG_FIRST_POKE_GET )
  //メニュー項目「ずかん」をON
  _FLAG_SET( SYS_FLAG_ZUKAN_GET )
  //ランニングシューズを入手済みにする
  _GET_SHOES()
}
INIT_EVENT_END


//=====================================================================
//  ゲームクリアスクリプト
//    ゲームクリア後のフラグ状態などを制御する
//  ※非常駐プログラム類の呼び出しは禁止なのは一緒
//=====================================================================
INIT_EVENT_START  ev_init_gameclear_script
{
  //初回ゲームクリア時の処理を呼び出す
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
    //初回なら
    _CALL	ev_first_gameclear
  ELSE
    //初めて殿堂入りした時の処理を呼び出す
    IF FLAG_OFF( SYS_FLAG_CHAMPION_WIN ) THEN
      _CALL	ev_dendouiri
    ENDIF
  ENDIF
  
  //手持ちポケモンを回復させる
  _TEMOTI_POKEMON_KAIFUKU()
  //全滅時の戻り先を自宅にする
  _SET_WARP_ID( WARP_ID_T01 )
  //復帰時の出現先
  _SET_SP_LOCATION_DIRECT( ZONE_ID_T01R0102, DIR_DOWN, 5, 0, 6 )
  //↑で設定した特殊接続先からゲームを開始するリクエスト
  _FLAG_SET( SYS_FLAG_SPEXIT_REQUEST )

  //ライの復活処理
  IF FLAG_ON( FV_D10R0401_POKE10 ) && FLAG_OFF( FE_D10R0401_POKE10_GET ) THEN
    //OBJを消していて、捕まえていなければ復活させる
    _FLAG_RESET( FV_D10R0401_POKE10 )
  ENDIF

     //ドラー未捕獲時の復活処理
  IF FLAG_ON(FV_D04R2301_POKE13) && FLAG_OFF(FE_D04R2301_POKE13_GET) THEN
      //OBJを消していて、捕まえていなければ復活させる
      _FLAG_RESET( FV_D04R2301_POKE13 )
  ENDIF

}
INIT_EVENT_END


//初回ゲームクリア時の処理
ev_first_gameclear:
  //↓ここにクリア後イベントを起動するためのフラグ/ワーク操作を記述

  //ゲームクリアフラグをセット
  _FLAG_SET( SYS_FLAG_GAME_CLEAR )

  //古代の城のマップ変化
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, TRUE, FALSE )

  //ギアステーションのジャッジを表示
  _FLAG_RESET( FV_POKE_JUDGE_01 )
  
  //スカイアローブリッジのストッパーを非表示
  _FLAG_RESET( FV_H01R0201_STOPPER_01 )
  
  //【仮】C05,D05の抜け道ストッパーを無効に
  _FLAG_SET( FV_C05_STOPPER_01 )
  _FLAG_SET( FV_D05_STOPPER_01 )
  $WK_SCENE_D05_STOPPER_01 = 1
  
_RET


//初回殿堂入り時の処理
ev_dendouiri:
  //殿堂入りフラグをセット
  _FLAG_SET( SYS_FLAG_CHAMPION_WIN )

  //研究所にサポートを表示
  //_FLAG_RESET( FV_T01R0401_SUPPORT_AFTER )
  //サポート宅のサポートを非表示
  //_FLAG_SET( FV_T01R0201_SUPPORT )

  //壁紙を追加（２段階目）
  _GET_BOX_WALLPAPER( SCR_BOX_EX_WALLPAPER2 )

_RET


