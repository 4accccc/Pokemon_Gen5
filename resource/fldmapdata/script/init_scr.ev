//--------------------------------
// 調査レーダーの自分の回答初期化
//--------------------------------
init_my_answers:
{
	//『ブラックとホワイト どっち？』
	_GET_ROM_VERSION( SCWK_ANSWER )
	SWITCH $SCWK_ANSWER
	CASE VERSION_B2 THEN _SET_MY_ANSWER( QUESTION_ID_W2B2, 1 )
	CASE VERSION_W2 THEN _SET_MY_ANSWER( QUESTION_ID_W2B2, 2 )
	ENDSWITCH

	//『男と女 どっち？』
	_GET_MY_SEX( SCWK_ANSWER )
	SWITCH $SCWK_ANSWER
	CASE PM_MALE   THEN _SET_MY_ANSWER( QUESTION_ID_SEX, 1 )
	CASE PM_FEMALE THEN _SET_MY_ANSWER( QUESTION_ID_SEX, 2 )
	ENDSWITCH

	//『ゲームプレイ時間は？』
	_SET_MY_ANSWER( QUESTION_ID_PLAY_TIME, 1 )
}
_RET


//=====================================================================
//  ゲーム開始スクリプト（デバッグ）
//  ※非常駐プログラム類の呼び出しは禁止なのは一緒
//=====================================================================
INIT_EVENT_START  ev_init_debug_script
{
  //初期化時のイベントフラグ設定は共通
	_CALL	init_flags
  //全滅時の戻り先設定：デバッグゲーム開始時はC01から（T02はイベントがあるため）
  _SET_WARP_ID( WARP_ID_C01 )
  //CGear入手済みにする
	_FLAG_SET( FE_CGEAR_GET )
  //メニュー項目「ポケモン」をON
	_FLAG_SET( SYS_FLAG_FIRST_POKE_GET )
  //メニュー項目「ずかん」をON
  _FLAG_SET( SYS_FLAG_ZUKAN_GET )
  //ランニングシューズを入手済みにする
  _GET_SHOES()
}
INIT_EVENT_END


//=====================================================================
//  ゲームクリアスクリプト
//    ゲームクリア後のフラグ状態などを制御する
//  ※非常駐プログラム類の呼び出しは禁止なのは一緒
//=====================================================================
INIT_EVENT_START  ev_init_gameclear_script
{
  //初回ゲームクリア時の処理を呼び出す
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
    //初回なら
    _CALL ev_first_gameclear
  ENDIF
  
  //手持ちポケモンを回復させる
  _TEMOTI_POKEMON_KAIFUKU()
  //全滅時の戻り先を自宅にする
  _SET_WARP_ID( WARP_ID_C12 )
  //復帰時の出現先
  _SET_SP_LOCATION_DIRECT( ZONE_ID_C12R0101, DIR_DOWN, 13, 0, 5 )
  //↑で設定した特殊接続先からゲームを開始するリクエスト
  _FLAG_SET( SYS_FLAG_SPEXIT_REQUEST )

  //ドラー未捕獲時の復活処理
  IF FLAG_ON(FV_D04R2301_POKE13) && FLAG_OFF(FE_D04R2301_POKE13_GET) THEN
    //OBJを消していて、捕まえていなければ復活させる
    _FLAG_RESET( FV_D04R2301_POKE13 )
  ENDIF

  //ビリジオン未捕獲時の復活処理
  IF FLAG_ON( FV_R11_POKE6_01 ) && FLAG_OFF( FE_R11_POKE6_GET_01 ) THEN
    //OBJを消していて、捕まえていなければ復活させる（１１番道路）
    _FLAG_RESET( FV_R11_POKE6_01 )
  ENDIF

  //コバルオン未捕獲時の復活処理
  IF FLAG_ON( FV_R13_POKE4_01 ) && FLAG_OFF( FE_R13_POKE4_GET_01 ) THEN
    //OBJを消していて、捕まえていなければ復活させる（１３番道路）
    _FLAG_RESET( FV_R13_POKE4_01 )
  ENDIF

  //テラキオン未捕獲時の復活処理
  IF FLAG_ON( FV_R22_POKE5_01 ) && FLAG_OFF( FE_R22_POKE5_GET_01 ) THEN
    //OBJを消していて、捕まえていなければ復活させる（２２番道路）
    _FLAG_RESET( FV_R22_POKE5_01 )
  ENDIF

  //ラティオス（ラティアス）未捕獲時の復活処理
  IF FLAG_OFF( FE_D01R0101_RATI2_GET_01 ) THEN
    //POSイベントリセット
    $WK_SCENE_D01R0101_RATI2 = 0
  ENDIF

  //ヒードラン未捕獲時の復活処理
  IF FLAG_OFF( FE_D24_POKE485_GET_01 ) && $WK_SCENE_D24_POKE485 == 3 THEN
      //POSイベントリセット
      $WK_SCENE_D24_POKE485 = 1
  ENDIF

  //クレセリア未捕獲時の復活処理
  IF FLAG_OFF( FE_H05_POKE488_GET_01 ) && $WK_SCENE_H05_POKE488 == 3 THEN
    //POSイベントリセット
    $WK_SCENE_H05_POKE488 = 1
  ENDIF

  //ユクシー未捕獲時の復活処理
  IF FLAG_OFF( FE_C02_SPPOKE1_GET_01 )  && $WK_SCENE_C02_SPPOKE1_01 == 3 THEN 
    //POSイベントリセット
    $WK_SCENE_C02_SPPOKE1_01 = 1
  ENDIF

  //エムリット未捕獲時の復活処理
  IF FLAG_OFF( FE_R07R0105_SPPOKE2_GET_01 )  && $WK_SCENE_R07R0105_SPPOKE2_01 == 3 THEN 
    //POSイベントリセット
    $WK_SCENE_R07R0105_SPPOKE2_01 = 1
  ENDIF

  //アグノム未捕獲時の復活処理
  IF FLAG_OFF( FE_R23_SPPOKE3_GET_01 )  && $WK_SCENE_R23_SPPOKE3_01 == 3 THEN 
    //POSイベントリセット
    $WK_SCENE_R23_SPPOKE3_01 = 1
  ENDIF

  //ウルガモス未捕獲時の復活処理
  IF FLAG_ON( FV_D04R2301_POKE13_01 ) && FLAG_OFF( FE_D04R2301_POKE13_GET_01 ) THEN
    //OBJを消していて、捕まえていなければ復活させる
    _FLAG_RESET( FV_D04R2301_POKE13_01 )
  ENDIF

  //レジアイス未捕獲時の復活処理
  IF FLAG_ON( FV_D29R0401_POKE1_01 ) && FLAG_OFF( FE_D29R0401_POKE1_GET_01 ) THEN
    //OBJを消していて、捕まえていなければ復活させる
    _FLAG_RESET( FV_D29R0401_POKE1_01 )
  ENDIF

  //レジロック未捕獲時の復活処理
  IF FLAG_ON( FV_D29R0401_POKE2_01 ) && FLAG_OFF( FE_D29R0401_POKE2_GET_01 ) THEN
    //OBJを消していて、捕まえていなければ復活させる
    _FLAG_RESET( FV_D29R0401_POKE2_01 )
  ENDIF

  //レジスチル未捕獲時の復活処理
  IF FLAG_ON( FV_D29R0401_POKE3_01 ) && FLAG_OFF( FE_D29R0401_POKE3_GET_01 ) THEN
    //OBJを消していて、捕まえていなければ復活させる
    _FLAG_RESET( FV_D29R0401_POKE3_01 )
  ENDIF

  //レジギガス未捕獲時の復活処理
  IF FLAG_ON( FV_D07R0601_POKE4_01 ) && FLAG_OFF( FE_D07R0601_POKE4_GET_01 ) THEN
    //OBJを消していて、捕まえていなければ復活させる
    _FLAG_RESET( FV_D07R0601_POKE4_01 )
  ENDIF

  //黒オノノクス未捕獲時の復活処理
  IF FLAG_ON( FV_D35R0101_POKE_01 ) && FLAG_OFF( FE_D35R0101_POKE_GET_01 ) THEN
    //OBJを消していて、捕まえていなければ復活させる
    _FLAG_RESET( FV_D35R0101_POKE_01 )
  ENDIF

  //ゼクロム（レシラム）未捕獲時の復活処理
  IF FLAG_ON( FV_D08R0901_PACKAGE_POKE ) && FLAG_OFF( FE_PACKAGE_POKE_GET ) && $WK_SCENE_D08R0901_LEGEND == 2 THEN
    //復活したゼクロム（レシラム）と戦って、捕まえていなければ復活させる
    _FLAG_RESET( FV_D08R0901_PACKAGE_POKE )
  ENDIF
  
  //キュレム未捕獲時の復活処理
  IF FLAG_ON(FV_D10R0501_KYUREMU) && FLAG_OFF(FE_D10R0401_POKE10_GET) THEN
    //OBJを消していて、捕まえていなければ復活させる
    _FLAG_RESET( FV_D10R0501_KYUREMU )
    //いでんしのくさびを非表示に
    _FLAG_SET( FV_D10R0501_IDENSHINO_KUSABI )
  ENDIF


}
INIT_EVENT_END


//初回ゲームクリア時の処理
ev_first_gameclear:
  //↓ここにクリア後イベントを起動するためのフラグ/ワーク操作を記述
  
  //ゲームクリアフラグをセット
  _FLAG_SET( SYS_FLAG_GAME_CLEAR )
  
  //C05ストッパー解除
  _FLAG_SET( FV_C05_STOPPER_01 )
  $WK_SCENE_C05_STOPPER_01 = 1
  
  //C12GYM0101
  _FLAG_RESET( FV_C12GYM0201_SWLEADER1_01 )
  
  //C08復興
  _FLAG_RESET( FE_C08_PLAZMA_COME )
  _FLAG_RESET( SYS_FLAG_BGM_C08_PLAZMA )
  _FLAG_RESET( FV_C08_PEOPLE_01 )
  _FLAG_RESET( FV_C08R0101_SWLEADER7_01 )
  _FLAG_SET( FV_C08_SWLEADER7_01 )
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_01, FALSE, FALSE )

  //古代の城のマップ変化
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, TRUE, FALSE )

  //ギアステーションのジャッジを表示
  _FLAG_RESET( FV_POKE_JUDGE_01 )
  
  //スカイアローブリッジのストッパーを非表示
  _FLAG_RESET( FV_H01R0201_STOPPER_01 )
  _FLAG_SET( FV_H01R0201_STOP_01 )
  $WK_SCENE_H01R0201_STOP_01 = 1
  
  //D27の人々をクリア後状態
  _FLAG_SET( FV_D27_BEFORE_PWPLAZMA_01 )
  _FLAG_RESET( FV_D27_AFTER_PWPLAZMA_01 )
  //D27R0101 STOPPER削除
  _FLAG_SET( FV_D27R0101_STOPPER_01 )
  //プラズマフリゲート・内部状態変更
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_02, TRUE, TRUE )
  //プラズマフリゲート・キュレム非表示
  _FLAG_SET( FV_D27R1001_R1301_POKE10_01 )
  
  //ボックス壁紙追加
  _GET_BOX_WALLPAPER( SCR_BOX_EX_WALLPAPER1 )

  //14番道路ゲートのストッパーを非表示
  _FLAG_SET( FV_R14R0101_MAN3_01 )

  //c12:ヒオウギシティにライバルと妹をセット
  _FLAG_RESET( FV_C12_SWRIVAL )
  _FLAG_RESET( FV_C12_SWRIVAL_SISTER )
  $WK_SCENE_SPPOKE_EVENT_01 = 1
  //c12r0202：レパルダス表示
  _FLAG_RESET( FV_C12R0202_POKE32_01 )
  
  //D33:心の空洞にアララギ娘を表示
  _FLAG_RESET( FV_D33R0101_HAKASE2_01 )

  //シリンダーブリッジのストッパーPOS解除
  $WK_SCENE_R09R0101_STOP_01 = 1

  //C03R0502:盗まれていたズルッグが帰ってくる
  _FLAG_RESET( FV_C03R0502_POKE38_01 )
  
  //C12R0101：全国ずかんイベント起動
  $WK_SCENE_C12R0101 = 2
  
  //T04R0301別荘イベント起動
  $WK_SCENE_T04R0301 = 1
  //T04R0301使用人非表示
  _FLAG_SET( FV_T04R0301_LEDY_01 )

  //D26:チャンピオンロードにゾロアーク出現
  $WK_SCENE_D26_POKE23_01 = 1

  //D05:WBTロビー・NPC
  _FLAG_RESET(FV_D05R0101_TRAINERW_01)
  
  //R06R0201：ストッパー非表示
  _FLAG_SET( FV_R06R0201_STOPPER_01 )

_RET


//初回殿堂入り時の処理
ev_dendouiri:

  //研究所にサポートを表示
  //_FLAG_RESET( FV_T01R0401_SUPPORT_AFTER )
  //サポート宅のサポートを非表示
