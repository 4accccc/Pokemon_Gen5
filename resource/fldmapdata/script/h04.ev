/**************************************************************/
/*  ストッパー：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_h04_stop_01
{

  _TALK_OBJ_START()

  //ストッパーとの勝負に勝った後か
  IF $WK_SCENE_H04_STOP_01 == 1 THEN
    //ストッパー：２ねんかん　コツコツと　のばした
    _BALLOONWIN_OBJMSG( msg_h04_stop_05, H04_STOP_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE

    //ストッパー：まてーい！▼
    _BALLOONWIN_OBJMSG( msg_h04_stop_01, H04_STOP_01 )

    //ストッパーと戦う？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい
      //ストッパー：がははは！　おぬしの　ような
      _BALLOONWIN_OBJMSG( msg_h04_stop_03, H04_STOP_01 )
      _MSGWIN_CLOSE()

      //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_GENTLE_05, 0 ) 

      //結果チェック
      _CALL ev_battle_check

      //勝利時
      //========================================//
      //POSイベント進行
      $WK_SCENE_H04_STOP_01 = 1
      //========================================//

      //ストッパー：２ねんかん　コツコツと　のばした
      _BALLOONWIN_OBJMSG( msg_h04_stop_05, H04_STOP_01 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ELSE    //いいえ
      //ストッパー：そうであろう！　９９９れんしょうの
      _BALLOONWIN_OBJMSG( msg_h04_stop_03, H04_STOP_01 )
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

}
EVENT_END

ev_battle_check:
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

/**************************************************************/
/*  POS：ストッパー接近                                       */
/**************************************************************/
EVENT_START   ev_pos_h04_stop_01
{
  //アニメ：ストッパー「！」振り向き
  _OBJ_ANIME( H04_STOP_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()

  //主人公座標取得（レールロケーション取得）
  _GET_PLAYER_RAIL_LOC( LCW_INDEX, LCW_FRONT, LCW_SIDE )

  //アニメ：ストッパー接近
  SWITCH $LCW_SIDE
  CASE 5 THEN
	_OBJ_ANIME( H04_STOP_01, anm_stop_come_5 )
  CASE 6 THEN
	_OBJ_ANIME( H04_STOP_01, anm_stop_come_6 )
  CASE 7 THEN
	_OBJ_ANIME( H04_STOP_01, anm_stop_come_7 )
  CASE 8 THEN

  CASE 9 THEN
	_OBJ_ANIME( H04_STOP_01, anm_stop_come_9 )
  CASE 10 THEN
	_OBJ_ANIME( H04_STOP_01, anm_stop_come_10 )
  CASE 11 THEN
	_OBJ_ANIME( H04_STOP_01, anm_stop_come_11 )
  CASE 12 THEN
	_OBJ_ANIME( H04_STOP_01, anm_stop_come_12 )
  ENDSWITCH

  _OBJ_ANIME_WAIT()

  _PLAYER_DIR_GET(SCWK_ANSWER)
  
  SWITCH $SCWK_ANSWER
  CASE DIR_LEFT THEN
	_OBJ_ANIME( H04_STOP_01, anm_staystep_r )
  CASE DIR_RIGHT THEN
	_OBJ_ANIME( H04_STOP_01, anm_staystep_l )
  ENDSWITCH
  
  _OBJ_ANIME_WAIT()

  //ストッパー：ちょっと　まてーい！▼
  _BALLOONWIN_OBJMSG( msg_h04_stop_02, H04_STOP_01 )

  //ストッパーと戦う？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい
    //ストッパー：がははは！　おぬしの　ような
    _BALLOONWIN_OBJMSG( msg_h04_stop_03, H04_STOP_01 )
    _MSGWIN_CLOSE()

    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_GENTLE_05, 0 ) 

    //結果チェック
    _CALL ev_battle_check

    //勝利時
    //========================================//
    //POSイベント進行
    $WK_SCENE_H04_STOP_01 = 1
    //========================================//

    //ストッパー：２ねんかん　コツコツと　のばした
    _BALLOONWIN_OBJMSG( msg_h04_stop_05, H04_STOP_01 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
	//主人公座標取得（レールロケーション取得）
	_GET_PLAYER_RAIL_LOC( LCW_INDEX, LCW_FRONT, LCW_SIDE )

	//アニメ：ストッパートボトボ退場
	SWITCH $LCW_SIDE
	CASE 5 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_esc_5 )
	CASE 6 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_esc_6 )
	CASE 7 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_esc_7 )
	CASE 8 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_esc_8 )
	CASE 9 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_esc_9 )
	CASE 10 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_esc_10 )
	CASE 11 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_esc_11 )
	CASE 12 THEN
	
	ENDSWITCH
	
	_OBJ_ANIME_WAIT()

  ELSE    //いいえ
	//ストッパー：そうであろう！　９９９れんしょうの
	_BALLOONWIN_OBJMSG( msg_h04_stop_04, H04_STOP_01 )
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()

	_PLAYER_DIR_GET(SCWK_ANSWER)

	//アニメ：主人公押しのけられる
	SWITCH $SCWK_ANSWER
	CASE DIR_LEFT THEN
		_OBJ_ANIME( H04_STOP_01, anm_walk_r )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
	CASE DIR_RIGHT THEN
		_OBJ_ANIME( H04_STOP_01, anm_walk_l )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
	ENDSWITCH

	_OBJ_ANIME_WAIT()

	SWITCH $SCWK_ANSWER
	CASE DIR_LEFT THEN
		_OBJ_ANIME( H04_STOP_01, anm_walk_l )
	CASE DIR_RIGHT THEN
		_OBJ_ANIME( H04_STOP_01, anm_walk_r )
	ENDSWITCH

	_OBJ_ANIME_WAIT()

	//主人公座標取得（レールロケーション取得）
	_GET_PLAYER_RAIL_LOC( LCW_INDEX, LCW_FRONT, LCW_SIDE )

	//アニメ：ストッパー戻る
	SWITCH $LCW_SIDE
	CASE 5 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_back_5 )
	CASE 6 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_back_6 )
	CASE 7 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_back_7 )
	CASE 8 THEN

	CASE 9 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_back_9 )
	CASE 10 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_back_10 )
	CASE 11 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_back_11 )
	CASE 12 THEN
		_OBJ_ANIME( H04_STOP_01, anm_stop_back_12 )
	ENDSWITCH

	_OBJ_ANIME_WAIT()
  
	SWITCH $SCWK_ANSWER
	CASE DIR_LEFT THEN
		_OBJ_ANIME( H04_STOP_01, anm_staystep_r )
	CASE DIR_RIGHT THEN
		_OBJ_ANIME( H04_STOP_01, anm_staystep_l )
	ENDSWITCH
	
	_OBJ_ANIME_WAIT()
  ENDIF
}
EVENT_END

