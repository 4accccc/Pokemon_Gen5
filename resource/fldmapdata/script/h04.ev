/**************************************************************/
/*  ストッパー：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_h04_stop_01
{

  _TALK_OBJ_START()

  //ストッパーとの勝負に勝った後か
  IF $WK_SCENE_H04_STOP_01 == 1 THEN
    //ストッパー：２ねんかん　コツコツと　のばした
    _BALLOONWIN_OBJMSG( msg_h04_stop_05, H04_STOP_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE

    //ストッパー：まてーい！▼
    _BALLOONWIN_OBJMSG( msg_h04_stop_01, H04_STOP_01 )

    //ストッパーと戦う？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい
      //ストッパー：がははは！　おぬしの　ような
      _BALLOONWIN_OBJMSG( msg_h04_stop_03, H04_STOP_01 )
      _MSGWIN_CLOSE()

      //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_GENTLE_05, 0 ) 

      //結果チェック
      _CALL ev_battle_check

      //勝利時
      //========================================//
      //POSイベント進行
      $WK_SCENE_H04_STOP_01 = 1
      //========================================//

      //ストッパー：２ねんかん　コツコツと　のばした
      _BALLOONWIN_OBJMSG( msg_h04_stop_05, H04_STOP_01 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ELSE    //いいえ
      //ストッパー：そうであろう！　９９９れんしょうの
      _BALLOONWIN_OBJMSG( msg_h04_stop_03, H04_STOP_01 )
      _MSGWIN_CLOSE()

    ENDIF

  ENDIF

}
EVENT_END

ev_battle_check:
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

/**************************************************************/
/*  POS：ストッパー接近                                       */
/**************************************************************/
EVENT_START   ev_pos_h04_stop_01
{

  //アニメ：ストッパー「！」振り向き
  _OBJ_ANIME( H04_STOP_01, anm_stop_guide01 )
  _OBJ_ANIME_WAIT()

  //主人公座標取得
  //_PLAYER_POS_GET( LCW_POSX, LCW_POSZ )

  //主人公座標取得（レールロケーション取得）
  _GET_PLAYER_RAIL_LOC( LCW_INDEX, LCW_FRONT, LCW_SIDE )

  //アニメ：ストッパー接近
  IF $LCW_SIDE == 5 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_come_a )
  ELSIF $LCW_SIDE == 6 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_come_b )
  ELSIF $LCW_SIDE == 7 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_come_c )
  ELSIF $LCW_SIDE == 8 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_come_d )
  ELSIF $LCW_SIDE == 9 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_come_e )
  ELSIF $LCW_SIDE == 10 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_come_f )
  ELSIF $LCW_SIDE == 11 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_come_g )
  ENDIF
  _OBJ_ANIME_WAIT()

  //ストッパー：ちょっと　まてーい！▼
  _BALLOONWIN_OBJMSG( msg_h04_stop_01, H04_STOP_01 )

  //ストッパーと戦う？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい
    //ストッパー：がははは！　おぬしの　ような
    _BALLOONWIN_OBJMSG( msg_h04_stop_03, H04_STOP_01 )
    _MSGWIN_CLOSE()

    //トレーナー戦呼び出し
    _TRAINER_BTL_SET( TRID_GENTLE_05, 0 ) 

    //結果チェック
    _CALL ev_battle_check

    //勝利時
    //========================================//
    //POSイベント進行
    $WK_SCENE_H04_STOP_01 = 1
    //========================================//

    //ストッパー：２ねんかん　コツコツと　のばした
    _BALLOONWIN_OBJMSG( msg_h04_stop_05, H04_STOP_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()


  ELSE    //いいえ
    //ストッパー：そうであろう！　９９９れんしょうの
    _BALLOONWIN_OBJMSG( msg_h04_stop_04, H04_STOP_01 )
    _MSGWIN_CLOSE()

    //アニメ：主人公押しのけられる
    _OBJ_ANIME( H04_STOP_01, anm_walk_r )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()

  ENDIF

  //主人公座標取得（レールロケーション取得）
  _GET_PLAYER_RAIL_LOC( LCW_INDEX, LCW_FRONT, LCW_SIDE )

  //アニメ：ストッパー元居た場所へ
  IF $LCW_SIDE == 5 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_back_a )
  ELSIF $LCW_SIDE == 6 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_back_b )
  ELSIF $LCW_SIDE == 7 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_back_c )
  ELSIF $LCW_SIDE == 8 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_back_d )
  ELSIF $LCW_SIDE == 9 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_back_e )
  ELSIF $LCW_SIDE == 10 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_back_f )
  ELSIF $LCW_SIDE == 11 THEN
    _OBJ_ANIME( H04_STOP_01, anm_stop_back_g )
  ENDIF
  _OBJ_ANIME_WAIT()

}
EVENT_END

