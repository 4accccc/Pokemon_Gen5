/**************************************************************/
/*  太った兄さん：話しかけ（橋マニアイベント）                */
/**************************************************************/
EVENT_START   ev_h04_man3_01

  _TALK_OBJ_START()

  //おいしい水を渡す前
  IF $WK_SCENE_BRIDGE_MANIA_01 == 3 THEN

    //太った兄さん：のどが　かわいた……▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h04_bridge_01 )

    //アイテム「おいしいみず」をあげる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //かばんの中の「おいしいみず」を減らす
      _SUB_ITEM( ITEM_OISIIMIZU, 1, SCWK_ANSWER )

      //おいしいみずがある
      IF $SCWK_ANSWER == TRUE THEN

        _MSGWIN_CLOSE()

        //SE再生
        _SE_PLAY( SEQ_SE_ARDEMO_01 )
        _SE_WAIT()

        //太った兄さん：げんき　でてきたー！　ありがとう▼
        _BALLOONWIN_TALKOBJ_MSG( msg_h04_bridge_02 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

		DEFINE_LOCAL	LWK_INDEX
		DEFINE_LOCAL	LWK_FRONT
		DEFINE_LOCAL	LWK_SIDE

		//レール座標の取得
		_GET_PLAYER_RAIL_LOC( LWK_INDEX, LWK_FRONT, LWK_SIDE )

		IF $LWK_FRONT == 0 THEN
			_OBJ_ANIME( H04_MAN3_01, anm_man3_leave1 )
		ELSE
			_OBJ_ANIME( H04_MAN3_01, anm_man3_leave2 )
		ENDIF
		
		_TIME_WAIT( 20 )
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_ou )
		_OBJ_ANIME_WAIT()

		_OBJ_DEL( H04_MAN3_01 )

        //========================================//
        //イベント進行
        $WK_SCENE_BRIDGE_MANIA_01 = 4
        //ビレッジブリッジの橋マニア非表示
        _FLAG_SET( FV_H04_BRIDGE_MANIA_01 )
        //ワンダーブリッジの橋マニア表示
        _FLAG_RESET( FV_H05_BRIDGE_MANIA_01 )
        //========================================//

      //おいしいみずが無い
      ELSE

        //太った兄さん：でも　おいしいみず　ないよね……
        _BALLOONWIN_TALKOBJ_MSG( msg_h04_bridge_03 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //太った兄さん：おいしいみずが　ないと……
      _BALLOONWIN_TALKOBJ_MSG( msg_h04_bridge_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //おいしい水を渡した後
  ELSIF $WK_SCENE_BRIDGE_MANIA_01 == 4 THEN

    //太った兄さん：げんき　でてきたー！　ありがとう▼
    _BALLOONWIN_TALKOBJ_MSG( msg_h04_bridge_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

