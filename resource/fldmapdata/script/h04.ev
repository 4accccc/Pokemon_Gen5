EVENT_START   ev_bg_h04_sign_02
  _EASY_BGWIN_MSG( msg_h04_sign_01, TYPE_ROAD)	//簡易メッセージＢＧ用
EVENT_END
/**************************************************************/
/*  h04 SIGN1の会話用イベントスクリプト                      */
