/************************************************************/
/*  FIELD_INIT_LABEL                                        */
/************************************************************/
INIT_EVENT_START  ev_init_d05r0101

  //優勝した場合はWBTシステム側でWK_SCENE_D05R0101を1とするようにした
  IF $WK_SCENE_D05R0101 == 1 THEN

    //========================================//
    //チェレン、ライバル表示
    _FLAG_RESET( FV_D05R0101_SWLEADER1_01 )
    _FLAG_RESET( FV_D05R0101_SWRIVAL_01 )
    //========================================//

    _OBJ_ADD( D05R0101_SWLEADER1_01 )  //チェレン表示
    _OBJ_ADD( D05R0101_SWRIVAL_01 )  //ライバル表示

    //ヤーコン、チェレン、ライバル再配置
    _OBJ_POS_CHANGE( D05R0101_SWLEADER5_01, 15, 0, 11, DIR_UP )
    _OBJ_POS_CHANGE( D05R0101_SWLEADER1_01, 14, 0, 11, DIR_UP )
    _OBJ_POS_CHANGE( D05R0101_SWRIVAL_01, 14, 0, 9, DIR_DOWN )

  ENDIF

INIT_EVENT_END


/**************************************************************/
/*  RESERVE：WBTチュートリアルイベント                        */
/**************************************************************/
EVENT_START   ev_reserve_d05r0101_tutorial

  //このイベントはD05のx191 z468周辺のPOSを踏むことで起動します

  //アニメ：主人公指定位置へ
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 15, 25, FORCE_TYPE_NPC, 8, DIR_UD )
  _TIME_WAIT( 8 )

  //========================================//
  //ライバルを表示
  _FLAG_RESET( FV_D05R0101_SWRIVAL_01 )
  //========================================//
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  _OBJ_ADD( D05R0101_SWRIVAL_01 )  //ライバル表示
  _OBJ_ANIME_WAIT()

  //アニメ：主人公、ライバル指定位置へ
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_work_a )
  _OBJ_ANIME( D05R0101_SWRIVAL_01, anm_swrival_work_a )
  _OBJ_ANIME_WAIT()

  //ヤーコン：こんかい　おまえたちに
  _BALLOONWIN_OBJMSG_POS( msg_d05r0101_swleader5_01, D05R0101_SWLEADER5_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：チェレン、ヤーコンを見る
  _OBJ_ANIME( D05R0101_SWLEADER1_01, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

  //チェレン：なぜ　ぼくまで……
  _BALLOONWIN_OBJMSG_POS( msg_d05r0101_swleader1_01, D05R0101_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ヤーコン、チェレンを見る
  _OBJ_ANIME( D05R0101_SWLEADER5_01, anm_common_turn_l )
  _OBJ_ANIME_WAIT()

  //ヤーコン：わかるか　チェレン
  _BALLOONWIN_OBJMSG_POS( msg_d05r0101_swleader5_02, D05R0101_SWLEADER5_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //チェレン：やれやれ……
  _BALLOONWIN_OBJMSG_POS( msg_d05r0101_swleader1_02, D05R0101_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：チェレン受付へ
  _OBJ_ANIME( D05R0101_SWLEADER1_01, anm_swleader1_work_a )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( D05R0101_SWLEADER5_01, anm_common_turn_u )

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：あっ　オレも！▼
  _BALLOONWIN_OBJMSG_POS( msg_d05r0101_swrival_01, D05R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ライバル、主人公向かい合う
  _OBJ_ANIME( D05R0101_SWRIVAL_01, anm_common_turn_l )
  _TIME_WAIT( 3 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

  //主人公名代入
  _PLAYER_NAME( 0 )
  //ライバル：《主人公》も　はやくな！▼
  _BALLOONWIN_OBJMSG_POS( msg_d05r0101_swrival_02, D05R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ライバル受付へ
  _OBJ_ANIME( D05R0101_SWRIVAL_01, anm_swrival_work_b )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_u )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 30 )  //間

  //アニメ：チェレン、ライバル会場へ
  _OBJ_ANIME( D05R0101_INFOMATIONW_01, anm_infomationw_work_a )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( D05R0101_SWLEADER1_01, anm_swleader1_work_a )
  _OBJ_ANIME( D05R0101_SWRIVAL_01, anm_swrival_work_c )
  _OBJ_ANIME_WAIT()

  //チェレン、ライバル退場
  _OBJ_DEL( D05R0101_SWLEADER1_01 )
  _OBJ_DEL( D05R0101_SWRIVAL_01 )

  //========================================//
  //チェレン、ライバル非表示
  _FLAG_SET( FV_D05R0101_SWLEADER1_01 )
  _FLAG_SET( FV_D05R0101_SWRIVAL_01 )

  //WBTチュートリアルモードを指定
  _FLAG_SET( SYS_FLAG_WBT_TUTORIAL )
  //ローカルライブキャスター・チェレン通話状態を変更（WBTクリアまで）
  _PERSON_STATE_SET_CHELEN( CHELEN_STATE_WBT_1 )
  //ローカルライブキャスター・ライバル通話状態を変更（WBTクリアまで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_WBT_1 )
  //========================================//

EVENT_END

/**************************************************************/
/*  RESERVE：WBTチュートリアルイベント（トーナメント後）      */
/**************************************************************/
EVENT_START   ev_reserve_d05r0101_tutorial_02

  //アニメ：主人公指定位置へ
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 15, 9, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()

  //ヤーコン：おまえら！
  _BALLOONWIN_OBJMSG_POS( msg_d05r0101_swleader5_04, D05R0101_SWLEADER5_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //========================================//
  //ホミカを表示
  _FLAG_RESET( FV_D05R0101_SWLEADER2_01 )
  //========================================//
  _OBJ_ADD( D05R0101_SWLEADER2_01 )  //ホミカ表示

  //アニメ：ホミカ登場
  _OBJ_ANIME( D05R0101_SWLEADER2_01, anm_swleader2_work_a )
  _TIME_WAIT( 8*4 )

  //アニメ：主人公ら振り向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
  _OBJ_ANIME( D05R0101_SWLEADER5_01, anm_common_turn_r )
  _TIME_WAIT( 3 )
  _OBJ_ANIME( D05R0101_SWRIVAL_01, anm_common_turn_r )
  _OBJ_ANIME( D05R0101_SWLEADER1_01, anm_common_turn_r )
  _OBJ_ANIME_WAIT()

  //主人公名代入
  _PLAYER_NAME( 0 )
  //ホミカ：《主人公》たち　ひさしぶり！▼
  _BALLOONWIN_OBJMSG_POS( msg_d05r0101_swleader2_01, D05R0101_SWLEADER2_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ホミカ退場
  _OBJ_ANIME( D05R0101_SWLEADER2_01, anm_swleader2_work_b )
  _TIME_WAIT( 8*3 )

  //アニメ：ライバル、主人公向かい合う
  _OBJ_ANIME( D05R0101_SWLEADER5_01, anm_common_turn_u )
  _TIME_WAIT( 3 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
  _TIME_WAIT( 3 )
  _OBJ_ANIME( D05R0101_SWRIVAL_01, anm_common_turn_d )
  _OBJ_ANIME( D05R0101_SWLEADER1_01, anm_common_turn_u )
  _OBJ_ANIME_WAIT()

  //ヤーコン：ほら　どうだ！
  _BALLOONWIN_OBJMSG_POS( msg_d05r0101_swleader5_05, D05R0101_SWLEADER5_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ヤーコン退場
  _OBJ_ANIME_AUTO( D05R0101_SWLEADER5_01, 15, 19, FORCE_TYPE_NPC, 8, DIR_UD )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( D05R0101_SWLEADER1_01, anm_common_turn_d )
  _OBJ_ANIME_WAIT()

  //ホミカ、ヤーコン退場
  _OBJ_DEL( D05R0101_SWLEADER2_01 )
  _OBJ_DEL( D05R0101_SWLEADER5_01 )
  
  //マップ差し替え:D05アジト船出現
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_05, TRUE, TRUE )
  //マップ差し替え:C03P15アジト船非表示
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_04, FALSE, FALSE )

  //========================================//
  //ホミカ、ヤーコン非表示
  _FLAG_SET( FV_D05R0101_SWLEADER2_01 )
  _FLAG_SET( FV_D05R0101_SWLEADER5_01 )
  //チェレン、ライバル非表示（外に出ると非表示に）
  _FLAG_SET( FV_D05R0101_SWLEADER1_01 )
  _FLAG_SET( FV_D05R0101_SWRIVAL_01 )
  //アクロマもこのタイミングで非表示に
  _FLAG_SET( FV_D05R0101_SWBOSS_01 )
  //D05 プラズマ団イベントSCENE_CHANGE有効
  $WK_SCENE_D05 = 2
  //プラズマフリゲート・現在地対応
  $WK_SYS_HIDE_SHIP_PLACE = SCR_HIDE_SHIP_PLACE_C05
  //WBTチュートリアルモードを解除
  _FLAG_RESET( SYS_FLAG_WBT_TUTORIAL )
  //C05GYM0101ヤーコン表示
  _FLAG_RESET( FV_C05GYM0101_SWLEADER5_01 )
  //========================================//

EVENT_END

