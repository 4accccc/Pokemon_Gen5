
//======================================================================
//                c08r0301.ev
//
//    スクリプトファイル：c08r0301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c08r0301.h"
  .include  "c08r0301.h"
  .include  "musical_scr_local.h"
  .include "musical_scr_def.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_c08r0301_gentleman_01
_EVENT_DATA   ev_c08r0301_middlewoman1_01
_EVENT_DATA   ev_c08r0301_girl4_01
_EVENT_DATA_END


/**************************************************************/
/* ミュージカルだいすきおじさん                               */
/**************************************************************/
EVENT_START   ev_c08r0301_gentleman_01
{
  _TALK_OBJ_START()

  //プレイヤーネームを格納
  _PLAYER_NAME( 1 )
  
  //所持グッズチェック
  _HAVE_MUSICAL_GOODS( MUSICAL_GOODS_PUREZENTOBAKO, LOCALWORK1 )
  _HAVE_MUSICAL_GOODS( MUSICAL_GOODS_FUSAFUSANOHIGE, LOCALWORK2 )
  _HAVE_MUSICAL_GOODS( MUSICAL_GOODS_AKAIBOUSI, LOCALWORK3 )
  _HAVE_MUSICAL_GOODS( MUSICAL_GOODS_OOKINAFUKURO, LOCALWORK4 )
  
  //グッズを全て所持していたならばイベント終了
  IF $LOCALWORK1 == 1 && $LOCALWORK2 == 1 && $LOCALWORK3 == 1 && $LOCALWORK4 == 1 THEN
    //==================================//
    //C08R0301 グッズ入手イベント終了
    $WK_SCENE_C08R0301 = 1
    //==================================//
  ENDIF
  
  _ITEM_CHK( ITEM_GUZZUKEESU, 1, SCWK_ANSWER )

  //グッズケースを持っている
  IF $SCWK_ANSWER == TRUE THEN

    //グッズを全て収集している
    IF $WK_SCENE_C08R0301 == 1 THEN

      //おじさん：ミュージカルを　たのしんでほしいよ♪
      _BALLOONWIN_OBJMSG( msg_c08r0301_goods_05, C08R0301_GENTLEMAN_01 )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()

    //今日既にイベントを終えたかチェック
    ELSIF FLAG_ON( TMFLG_C08R0301_GOODS ) THEN

      //おじさん：また　あしたに　なれば
      _BALLOONWIN_OBJMSG( msg_c08r0301_goods_04, C08R0301_GENTLEMAN_01 )
      _LAST_KEYWAIT()
      _BALLOONWIN_CLOSE()

    //まだイベントを終えていない
    ELSE

      //おじさん：おや　グッズケースを　もっているね
      _BALLOONWIN_OBJMSG( msg_c08r0301_goods_01, C08R0301_GENTLEMAN_01 )

      //ミュージカルのグッズが欲しい？
      DEFINE_LOCAL SCWK_ANSWER01
      _YES_NO_WIN( SCWK_ANSWER01 )

      IF $SCWK_ANSWER01 == 0 THEN   //はい

        //おじさん：うれしいねえ♪　キミも
        _BALLOONWIN_OBJMSG( msg_c08r0301_goods_02, C08R0301_GENTLEMAN_01 )
        _BALLOONWIN_CLOSE()

        //アイテム名を格納するワークを定義
        DEFINE_LOCAL LCW_GOODS_NAME

        //アイテム入手処理
        IF $LOCALWORK1 == 0 THEN
          $SCWK_TEMP0 = MUSICAL_GOODS_PUREZENTOBAKO
          $SCWK_TEMP1 = TRUE
          _CHG_COMMON_SCR SCRID_MUSICAL_ADD_GOODS

          //おじさん：また　あしたに　なれば
          _BALLOONWIN_OBJMSG( msg_c08r0301_goods_04, C08R0301_GENTLEMAN_01 )
          _LAST_KEYWAIT()
          _BALLOONWIN_CLOSE()

        ELSIF $LOCALWORK2 == 0 THEN
          $SCWK_TEMP0 = MUSICAL_GOODS_FUSAFUSANOHIGE
          $SCWK_TEMP1 = TRUE
          _CHG_COMMON_SCR SCRID_MUSICAL_ADD_GOODS

          //おじさん：また　あしたに　なれば
          _BALLOONWIN_OBJMSG( msg_c08r0301_goods_04, C08R0301_GENTLEMAN_01 )
          _LAST_KEYWAIT()
          _BALLOONWIN_CLOSE()

        ELSIF $LOCALWORK3 == 0 THEN
          $SCWK_TEMP0 = MUSICAL_GOODS_AKAIBOUSI
          $SCWK_TEMP1 = TRUE
          _CHG_COMMON_SCR SCRID_MUSICAL_ADD_GOODS

          //おじさん：また　あしたに　なれば
          _BALLOONWIN_OBJMSG( msg_c08r0301_goods_04, C08R0301_GENTLEMAN_01 )
          _LAST_KEYWAIT()
          _BALLOONWIN_CLOSE()

        ELSIF $LOCALWORK4 == 0 THEN
          $SCWK_TEMP0 = MUSICAL_GOODS_OOKINAFUKURO
          $SCWK_TEMP1 = TRUE
          _CHG_COMMON_SCR SCRID_MUSICAL_ADD_GOODS

          //おじさん：ミュージカルを　たのしんでほしいよ♪
          _BALLOONWIN_OBJMSG( msg_c08r0301_goods_05, C08R0301_GENTLEMAN_01 )
          _LAST_KEYWAIT()
          _BALLOONWIN_CLOSE()

        ENDIF

        //==================================//
        //今日のイベントを終える
        _FLAG_SET ( TMFLG_C08R0301_GOODS )
        //==================================//

      ELSE  //いいえ

        //おじさん：なんと　きみは！▼
        _BALLOONWIN_OBJMSG( msg_c08r0301_goods_03, C08R0301_GENTLEMAN_01 )
        _LAST_KEYWAIT()
        _BALLOONWIN_CLOSE()

      ENDIF

    ENDIF

  //グッズケースを持っていない
  ELSE

    //おじさん：ミュージカルホールに　いってみては？
    _BALLOONWIN_OBJMSG( msg_c08r0301_goods_06, C08R0301_GENTLEMAN_01 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()

  ENDIF
}
EVENT_END

/**************************************************************/
/*  おばさん：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_c08r0301_middlewoman1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08r0301_middlewoman1_01 )
EVENT_END

/**************************************************************/
/*  お嬢様：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c08r0301_girl4_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c08r0301_girl4_01 )
EVENT_END


