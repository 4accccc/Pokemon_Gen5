
//======================================================================
//                d10r0401.ev
//
//    スクリプトファイル：d10r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d10r0401.h"
  .include  "d10r0401.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_d10r0401
_EVENT_DATA    ev_init_d10r0401
_EVENT_DATA    ev_scene_d10r0401_swsage1_01
_EVENT_DATA    ev_d10r0401_swsage1_01
_EVENT_DATA    ev_d10r0401_boss_01
_EVENT_DATA    ev_d10r0401_poke10_01
_EVENT_DATA    ev_d10r0401_poke10_02
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d10r0401
  
  //進行状態で異なる接続を配置
  
  //プラズマフリゲート起動中（d10r0301)
  IF FLAG_ON( FE_D10_PLAZMA_FRIGATE_01 ) THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D10R0401_D10R0201_EXIT01, 25, 0, 25 )
  //プラズマフリゲートいない（d10r0201)
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D10R0401_D10R0301_EXIT01, 25, 0, 25 )
  ENDIF
  
  //バージョンを取得してOBJを変化させる
	_GET_ROM_VERSION( SCWK_ANSWER )
	
	//BlackVERならレシラム
	IF $SCWK_ANSWER == VERSION_B2 THEN
		$OBJCHRWORK0 = POKE10
		$OBJCHRWORK1 = MU_B
		$OBJCHRWORK2 = MU_B
	
	//Whiteならゼクロム
	ELSE
		$OBJCHRWORK0 = POKE10
		$OBJCHRWORK1 = SHIN_B
		$OBJCHRWORK2 = SHIN_B
	ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_d10r0401

  //ゲーチス勝利前だったらNの配置を変更
   IF $WK_SCENE_D10R0401_SWSAGE1_01 == 2 THEN
    _OBJ_POS_CHANGE(D10R0401_BOSS_01,17,0,26,DIR_UP)
   ENDIF

INIT_EVENT_END

/************************************************************/
/*					SCENE_CHANGE：						*/
/************************************************************/
EVENT_START ev_scene_d10r0401_swsage1_01
  
  //========================================//
  //N表示
  _FLAG_RESET( FV_D10R0401_BOSS_01 )
  //ゼクロム・レシラム表示
  _FLAG_RESET( FV_D10R0401_POKE_02 )
  //========================================//
  
  //アニメ：主人公隣接
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 16, 26, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：パワースポット
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_01 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  
  //ゲーチス：いでよキュレム！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_02 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：キュレム接近
  _OBJ_ANIME_AUTO( D10R0401_POKE1_01 , 17, 24, FORCE_TYPE_NOT, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //キュレム：ヒュラララ！
  _VOICE_PLAY(MONSNO_653,0)
	_BALLOONWIN_OBJMSG_POS(msg_d10r0401_poke10_01,D10R0401_POKE1_01 , POS_UR )
	_VOICE_WAIT()
	_AB_KEYWAIT_MARK()
	_BALLOONWIN_CLOSE()
	
	//ゲーチス：わたしには
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_03 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチス右を向く
  _OBJ_ANIME( D10R0401_SWSAGE1_01 , anm_staystep_r)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：わたしには
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_04 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //キュレム：ヒュラッ！
  _VOICE_PLAY(MONSNO_653,0)
  _GIZAPLAINWIN_MSG_POS( msg_d10r0401_poke10_02, POS_DOWN )
	_VOICE_WAIT()
	_AB_KEYWAIT_MARK()
	_GIZAPLAINWIN_CLOSE()
	
	//【仮】デモ予定
	
	// ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
	
	//ブラック：クロスサンダー
  IF $LCWK_VERSION == VERSION_B2 THEN
    _PLAINWIN_MSG_DOWN( msg_d10r0401_boss_01b )
    
  //ホワイト：クロスフレイム
  ELSE
    _PLAINWIN_MSG_DOWN( msg_d10r0401_boss_01w )
  ENDIF
  _MSGWIN_CLOSE()
  
  //【仮】暗転処理
  _BLACK_OUT()
  _DISP_FADE_END_CHECK()
  
  //ゼクロム・レシラムの動作モデル生成
  _OBJ_ADD( D10R0401_NPOKE_01 )
  //N動作モデル生成
  _OBJ_ADD( D10R0401_BOSS_01 )
  
  //暗転復帰
  _BLACK_IN()
  _DISP_FADE_END_CHECK()
  
  //アニメ：ゲーチス下を向く
  _OBJ_ANIME( D10R0401_SWSAGE1_01 , anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //アニメ：N接近
  _OBJ_ANIME_AUTO( D10R0401_BOSS_01 , 17, 26, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //N：おしえてくれた
  _BALLOONWIN_OBJMSG_WB( msg_d10r0401_boss_02b , msg_d10r0401_boss_02w , D10R0401_BOSS_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //ブラック：ババリバリッシュ！
  IF $LCWK_VERSION == VERSION_B2 THEN
    _GIZAPLAINWIN_MSG_POS( msg_d10r0401_mu_01, POS_DOWN )
    //【仮】鳴き声指定仮
    _VOICE_PLAY( MONSNO_653, 0 )
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
  //ホワイト：ンバーニガガッ！
  ELSE
    _GIZAPLAINWIN_MSG_POS( msg_d10r0401_shin_01, POS_DOWN )
    //【仮】鳴き声指定仮
    _VOICE_PLAY( MONSNO_653, 0 )
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
  ENDIF
  
  //ゲーチス：すばらしい
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_06 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  
  //ゲーチス：とはいえ
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_07 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  
  //ゲーチス：だがそれも
  _BALLOONWIN_OBJMSG_WB( msg_d10r0401_swsage01_08b , msg_d10r0401_swsage01_08w , D10R0401_SWSAGE1_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //N：そんな数式は
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_boss_03 , D10R0401_BOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ゲーチス：できますとも！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_09 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  
  //ゲーチス：きゅうしゅうなさい！
  _BALLOONWIN_OBJMSG_WB( msg_d10r0401_swsage01_10b , msg_d10r0401_swsage01_10w , D10R0401_SWSAGE1_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //暗転処理
  _BLACK_OUT()
  _DISP_FADE_END_CHECK()
  
  //ゼクロム・レシラム・キュレムの動作モデル削除
  _OBJ_DEL( D10R0401_NPOKE_01 )
  _OBJ_DEL( D10R0401_POKE1_01 )
  
  //========================================//
  //キュラム・キュロム表示
  _FLAG_RESET( FV_D10R0401_POKE_03 )
  //キュレム・ゼクロム・レシラム非表示
  _FLAG_SET( FV_D10R0401_POKE_01 )
  _FLAG_SET( FV_D10R0401_POKE_02 )
  //========================================//
  
  //キュラム・キュロムの動作モデル生成
  _OBJ_ADD( D10R0401_POKE2_01 )
  
  //暗転復帰
  _BLACK_IN()
  _DISP_FADE_END_CHECK()
  
  //N：まさか
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_boss_04 , D10R0401_BOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ゲーチス：おろかものめ！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_11 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  
  //ゲーチス：さてトレーナーよ
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_12 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  
  //ゲーチス：おや？アナタの
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_13 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //=======================================//
  //SCENE_CHANGE無効
  $WK_SCENE_D10R0401_SWSAGE1_01 = 2
  //=======================================//

EVENT_END

/************************************************************/
/*					CALL：ゲーチス戦						*/
/************************************************************/
ev_vs_swsage1_01:
  
  //【仮】暗転処理
  _BLACK_OUT()
  _DISP_FADE_END_CHECK()
  
  //キュラム・キュロム動作モデル削除
  _OBJ_DEL( D10R0401_POKE2_01 )
  //=======================================//
  //キュラム・キュロム非表示
  _FLAG_SET( FV_D10R0401_POKE_03 )
  //キュレム・ゼクロム・レシラム表示
  _FLAG_RESET( FV_D10R0401_POKE_02 )
  //========================================//
  
  //レシラム・ゼクロム動作モデル生成
  _OBJ_ADD( D10R0401_NPOKE_01 )
  
  //【仮】登場人物位置変更
  _OBJ_POS_CHANGE(MMDL_ID_PLAYER,16,0,26,DIR_UP)
  _OBJ_ANIME( D10R0401_SWSAGE1_01 , anm_dir_d)
  _OBJ_ANIME( D10R0401_BOSS_01 , anm_dir_u)
  _OBJ_ANIME_WAIT()
  
  //暗転復帰
  _BLACK_IN()
  _DISP_FADE_END_CHECK()
  
  //ゲーチス：まさか！
  _BALLOONWIN_OBJMSG_WB( msg_d10r0401_swsage01_15b , msg_d10r0401_swsage01_15w , D10R0401_SWSAGE1_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //【仮】トレーナー戦
  _TRAINER_BTL_SET( TRID_TANPAN_19, 0 )
  //結果チェック
  _CALL ev_battle_check
  
  //ゲーチス：…どういうことだ？
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_16 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチスうろうろ
  _OBJ_ANIME( D10R0401_SWSAGE1_01 , anm_swsage1_lose_walk01)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：みとめるか　ありえるか
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_17 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //N：あえて　こうよびます
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_boss_06 , D10R0401_BOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチス・目をそらして
  _OBJ_ANIME( D10R0401_SWSAGE1_01 , anm_staystep_l)
  _OBJ_ANIME_WAIT()
    
  //ゲーチス：だまれ！
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_swsage01_17 , D10R0401_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //フィールド上にダークトリニティ配置
  _OBJ_ADD_EX( 15, 24, DIR_DOWN, MMDL_ID_EVENTOBJ_00, NINJA, MV_DMY )
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_ninja_coming_01 )
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ：Nさま
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_ninja_01 , MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //N：…うん
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_boss_07 , D10R0401_BOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ダークトリニティ：…はい
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_ninja_02 , MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ダークトリニティ退場
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_ninja_coming_01 )
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ・ゲーチス動作モデル削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  _OBJ_DEL( D10R0401_SWSAGE1_01 )
  
  //【仮】アニメ：Nと主人公向き合う
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r )
  _OBJ_ANIME( D10R0401_BOSS_01 , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //N：アリガトウ
  _BALLOONWIN_OBJMSG_POS( msg_d10r0401_boss_08 , D10R0401_BOSS_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //ブラック
  IF $LCWK_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS(msg_d10r0401_mu_02,D10R0401_NPOKE_01 , POS_DEFAULT )
    _VOICE_PLAY( MONSNO_651, 0 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

  ELSE
    _BALLOONWIN_OBJMSG_POS(msg_d10r0401_shin_02,D10R0401_NPOKE_01 , POS_DEFAULT )
    _VOICE_PLAY( MONSNO_035, 0 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
    
  ENDIF
  
  //N：～も言ってる
  _BALLOONWIN_OBJMSG_WB( msg_d10r0401_boss_09b , msg_d10r0401_boss_09w , D10R0401_BOSS_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //【仮】ゼクロム・レシラム動作モデル削除
  _OBJ_DEL( D10R0401_NPOKE_01 )
  
  //【仮】アニメ：Nと主人公出口方面へ
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_walk_d )
  _OBJ_ANIME( D10R0401_BOSS_01 , anm_walk_d )
  _OBJ_ANIME_WAIT()
  
  //【仮】データ引継ぎ分岐（参照データ・反映データが仮）
  IF $LCWK_VERSION == VERSION_B2 THEN
    _BALLOONWIN_OBJMSG_POS( msg_d10r0401_boss_10 , D10R0401_BOSS_01 ,POS_DEFAULT )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d10r0401_boss_11 , D10R0401_BOSS_01 ,POS_DEFAULT )
  ENDIF
  
  _MSGWIN_CLOSE()
  
  //【仮】アニメ：Nと主人公向き合う
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r )
  _OBJ_ANIME( D10R0401_BOSS_01 , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //N：ポケモンといることで
  _BALLOONWIN_OBJMSG_WB( msg_d10r0401_boss_12b , msg_d10r0401_boss_12w , D10R0401_BOSS_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //【仮】アニメ：Nと主人公出口方面へ
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_walk_d )
  _OBJ_ANIME( D10R0401_BOSS_01 , anm_walk_d )
  _OBJ_ANIME_WAIT()
  
  //【仮】アニメ：Nと主人公向き合う
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r )
  _OBJ_ANIME( D10R0401_BOSS_01 , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //N：キミ！キミと
  _BALLOONWIN_OBJMSG_WB( msg_d10r0401_boss_13b , msg_d10r0401_boss_13w , D10R0401_BOSS_01 , POS_DEFAULT)
  _MSGWIN_CLOSE()
  
  //【仮】アニメ：N退場
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //Ｎ動作モデル削除
  _OBJ_DEL( D10R0401_BOSS_01 )
  
  //接続先を変更
  _SXY_MOVE_EXIT_EVENT( DOOR_ID_D10R0401_D10R0301_EXIT01, 25, 0, 25 )
  _SXY_MOVE_EXIT_EVENT( DOOR_ID_D10R0401_D10R0201_EXIT01, 16, 0, 30 )
  
  //=======================================//
  //D10R0201に接続するように状態を変更
  _FLAG_RESET( FE_D10_PLAZMA_FRIGATE_01 )
  //D10R0401イベント終了
  $WK_SCENE_D10R0401_SWSAGE1_01 = 3
  //D10プラズマ団員を削除
  _FLAG_SET( FV_D10R0101_SWPLAZMAM_01 )
  _FLAG_SET( FV_D10R0101_SWPLAZMAM_03 )
  _FLAG_SET( FV_D10R0101_SWPLAZMAM_04 )
  _FLAG_SET( FV_D10R0301_SWPLAZMAM_02 )
  _FLAG_SET( FV_D10R0401_SWSAGE1_01 )
  _FLAG_SET( FV_D10R0401_BOSS_01 )
  _FLAG_SET( FV_D10R0401_POKE_02 )
  //=======================================//
  
_RET

//--------------------------------------------------------------------
//	ゲーチス：左右ウロウロ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swsage1_lose_walk01
	_ANIME_DATA	AC_WALK_L_16F,1
	_ANIME_DATA	AC_WALK_R_16F,2
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0
	

//--------------------------------------------------------------
//	ダークトリニティ：登場
//--------------------------------------------------------------
_ANIME_LABEL	anm_ninja_coming_01
	_ANIME_DATA	AC_NINJA_ACT0,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------
//	ダークトリニティ：退場
//--------------------------------------------------------------
_ANIME_LABEL	anm_ninja_bye_01
	_ANIME_DATA	AC_NINJA_ACT1,1
	_ANIME_DATA	AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*					話しかけ：ゲーチス						*/
/************************************************************/
EVENT_START ev_d10r0401_swsage1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d10r0401_swsage01_14 )
EVENT_END

/************************************************************/
/*					話しかけ：Ｎ						*/
/************************************************************/
EVENT_START ev_d10r0401_boss_01

  //WB分岐メッセージ
  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG_WB( msg_d10r0401_boss_05w , msg_d10r0401_boss_05b , D10R0401_BOSS_01 , POS_DEFAULT)
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/************************************************************/
/*					話しかけ：キュレム（キュラム・キュロム）						*/
/************************************************************/
EVENT_START ev_d10r0401_poke10_01
  
  _TALK_START_SE_PLAY()
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  DEFINE_LOCAL  LWK_BATTLE_FLAG

  //【仮】シン・ム専用、伝説系MSG、レア無し
  $LWK_BATTLE_FLAG = SCR_WILD_BTL_FLAG_IMMORTAL
  $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_LEGEND
  $LWK_BATTLE_FLAG |= SCR_WILD_BTL_FLAG_NO_RARE
  
  //ブラック
  IF $LCWK_VERSION == VERSION_B2 THEN
    
    //【仮】芝居
    
    _GIZAPLAINWIN_MSG_POS( msg_d10r0401_b_01, POS_DOWN )
    //【仮】鳴き声指定仮
    _VOICE_PLAY( MONSNO_035, 0 )
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
    
    //【仮】戦闘処理（レア・捕獲・逃走なしにする必要あり）
    _WILD_BTL_SET_EX( MONSNO_035, 50, LWK_BATTLE_FLAG )
  ELSE
    
    //【仮】芝居
    
    _GIZAPLAINWIN_MSG_POS( msg_d10r0401_w_01, POS_DOWN )
    //【仮】鳴き声指定仮
    _VOICE_PLAY( MONSNO_035, 0 )
    _AB_KEYWAIT_MARK()
    _GIZAPLAINWIN_CLOSE()
    
    //【仮】戦闘処理（レア・捕獲・逃走なしにする必要あり）
    _WILD_BTL_SET_EX( MONSNO_035, 50, LWK_BATTLE_FLAG )
  ENDIF
  
  //敗戦チェック
  _CALL ev_battle_check
  
  //ゲーチス戦イベント開始
  _CALL ev_vs_swsage1_01

EVENT_END

/************************************************************/
/*					話しかけ：キュレム（クリア後）						*/
/************************************************************/
EVENT_START ev_d10r0401_poke10_02

EVENT_END

ev_battle_check:	
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
_RET

