  .text

  .include  "scr_seq_def.h"
  .include  "msg_d10r0401.h"
  .include  "d10r0401.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_d10r0401
_EVENT_DATA    ev_init_d10r0401
_EVENT_DATA    ev_recover_d10r0401
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*		CALL：特殊接続                             */
/************************************************************/
ev_exit_change:

  //進行状態で異なる接続を配置
  
  //プラズマフリゲート起動中（d10r0301)
  IF FLAG_ON( FE_D10_PLAZMA_FRIGATE_01 ) THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D10R0401_D10R0201_EXIT01, 25, 0, 25 )
  //プラズマフリゲートいない（d10r0201)
  ELSE
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_D10R0401_D10R0301_EXIT01, 25, 0, 25 )
  ENDIF

_RET


/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d10r0401
  
  _CALL ev_exit_change
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d10r0401

  _CALL ev_exit_change
  
INIT_EVENT_END


/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_d10r0401

  //

INIT_EVENT_END

