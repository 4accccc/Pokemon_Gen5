  .include "wbt_scr_define.h"

  .include "wbt_hall_def.h" //リザーブスクリプトID参照

  .include  "d05r0101.h"    //OBJID参照

//----------------------------------------------------------------------
//               スクリプトテーブル
//----------------------------------------------------------------------
_EVENT_DATA		ev_wbt_reception
_EVENT_DATA   ev_wbt_entry_checker
_EVENT_DATA   ev_pos_wbt_reception
_EVENT_DATA   ev_reserve_wbt_exit
_EVENT_DATA_END


/********************************************************************/
/*						FIELD_INIT_LABEL                            */
/********************************************************************/

/********************************************************************/
/*						FIELD_RECOVER_LABEL                         */
/********************************************************************/

/**************************************************************/
/*		ＷＢＴ・受付スクリプト								  */
/**************************************************************/

EVENT_START	ev_wbt_reception

  _TALK_OBJ_START()

  //ＷＢＴ受付メイン処理
  _CALL ev_wbt_main

EVENT_END

/**************************************************************/
/*    ＷＢＴ・ＰＯＳスクリプト                */
/**************************************************************/
EVENT_START   ev_pos_wbt_reception

DEFINE_LOCAL  LWK_POSX
DEFINE_LOCAL  LWK_POSZ

  _PLAYER_POS_GET( LWK_POSX, LWK_POSZ )
  IF $LWK_POSX == 14 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_reception_l )
    _OBJ_ANIME_WAIT()
  ELSIF $LWK_POSX == 16 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_reception_r )
    _OBJ_ANIME_WAIT()
  ENDIF
  //話しかけていないのでちゃんと指定してあげる
  $SCWK_TARGET_OBJID = D05R0101_INFOMATIONW_01

  //ＷＢＴ受付メイン処理
  _CALL ev_wbt_main

EVENT_END

//--------------------------------------------------------------------
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_reception_l
_ANIME_DATA   AC_WALK_R_8F, 1
_ANIME_DATA   AC_STAY_WALK_U_8F,1
_ANIME_DATA   ACMD_END, 0

//--------------------------------------------------------------------
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_reception_r
_ANIME_DATA   AC_WALK_L_8F, 1
_ANIME_DATA   AC_STAY_WALK_U_8F,1
_ANIME_DATA   ACMD_END, 0

/********************************************************************/
//
//
//                      WBT受付メイン
//
//
/********************************************************************/
//FH_02		チャンピオントーナメント参加フラグ	タイムフラグ

ev_wbt_main:

DEFINE_LOCAL	LWK_WBT_LOBBY_SEQ
DEFINE_LOCAL	LWK_WBT_SELECT_TOURNAMENT
DEFINE_LOCAL  LWK_WBT_SELECT_DL
DEFINE_LOCAL	LWK_MENU
DEFINE_LOCAL	LWK_MENU_WHILE
DEFINE_LOCAL	LWK_RULE
DEFINE_LOCAL  LWK_REG
DEFINE_LOCAL	LWK_CHK_RULE
DEFINE_LOCAL	LWK_DL_COUNT

  //WBT制御システム開始：終了するときは必ず対で_WBT_SYSTEM_END()をよぶこと！
  _WBT_SYSTEM_START()
  _WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_RECEPTION )

  $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_FIRST_MENU

  WHILE $LWK_WBT_LOBBY_SEQ != WBT_LOBBY_SEQ_END && $LWK_WBT_LOBBY_SEQ != WBT_LOBBY_SEQ_HALL

    SWITCH $LWK_WBT_LOBBY_SEQ
    CASE WBT_LOBBY_SEQ_FIRST_MENU THEN
      //ようこそ　ワールドバトルトーナメントへ！
      _BALLOONWIN_OBJMSG_POS( msg_wbt_info_02, SCWK_TARGET_OBJID, POS_DL )

      _CALL ev_first_menu

    CASE WBT_LOBBY_SEQ_SELECT_EXPLAIN THEN
      //トーナメント説明

      $LWK_MENU_WHILE = 0

      _CALL ev_explain

      IF $LWK_MENU_WHILE == 1 THEN
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_FIRST_MENU
      ENDIF

    CASE WBT_LOBBY_SEQ_SELECT_TOURNAMENT THEN
      //トーナメント選択
      _CALL ev_select_tournament
      SWITCH $LWK_MENU
      CASE SCR_WBT_TYPE_ALL THEN
        _WBT_SET_TOURNAMENT_TYPE( LWK_MENU )
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_RULE
      CASE SCR_WBT_TYPE_POKETYPE THEN
        _WBT_SET_TOURNAMENT_TYPE( LWK_MENU )
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_POKETYPE
      CASE SCR_WBT_TYPE_CHAMPION THEN
        //チャンピオントーナメントに参加済みの場合
        IF FLAG_ON( FH_02 ) THEN	
          //本日のチャンピオントーナメントは終了しています。
          _BALLOONWIN_OBJMSG_POS( msg_wbt_info_11, SCWK_TARGET_OBJID, POS_DL )
          _LAST_KEYWAIT()
          _MSGWIN_CLOSE()
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
        ELSE
          _WBT_SET_TOURNAMENT_TYPE( LWK_MENU )
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_RULE
        ENDIF

      CASE SCR_WBT_TYPE_DOWNLOAD THEN
        _WBT_SET_TOURNAMENT_TYPE( LWK_MENU )
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_DL
      DEFAULT
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_END
      ENDSWITCH

    CASE WBT_LOBBY_SEQ_SELECT_POKETYPE THEN
      //ポケモンのタイプ選択
      $LWK_MENU = POKETYPE_NULL
      _WBT_SET_TOURNAMENT_POKETYPE( POKETYPE_NULL )
      _CALL ev_select_poketype
      IF $LWK_MENU == POKETYPE_NULL THEN
        //タイプ未選択→トーナメントの選択へ戻る
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
      ELSE
        //タイプ選択→ルール選択へ進む
        _WBT_SET_TOURNAMENT_POKETYPE( LWK_MENU )
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_RULE
      ENDIF

    CASE WBT_LOBBY_SEQ_SELECT_DL THEN
      //DLデータ選択
      $LWK_WBT_SELECT_DL = 0
      _CALL ev_select_download
      IF $LWK_MENU == 0 THEN
        //未選択→トーナメント選択へ戻る
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
      ELSE
        //DLデータ選択→ポケモンのチェック＆選択へ
        $LWK_WBT_SELECT_DL = $LWK_MENU
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_POKE
      ENDIF

    CASE WBT_LOBBY_SEQ_SELECT_RULE THEN
    //バトルルール選択
      $LWK_RULE = SCR_WBT_RULE_NULL
      _CALL ev_select_rule
      IF $LWK_MENU != SCR_WBT_RULE_NULL THEN
        //ルール選択→ポケモンのチェック＆選択へ
        $LWK_RULE = $LWK_MENU
        _WBT_SET_BATTLE_RULE( LWK_RULE )
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_POKE
      ELSE
        //ルール未選択→適宜前のシーケンスに戻る
        _WBT_GET_TOURNAMENT_TYPE( LWK_WBT_SELECT_TOURNAMENT )
        SWITCH $LWK_WBT_SELECT_TOURNAMENT
        CASE SCR_WBT_TYPE_ALL THEN
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
        CASE SCR_WBT_TYPE_POKETYPE THEN
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_POKETYPE
        CASE SCR_WBT_TYPE_CHAMPION THEN
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
        DEFAULT
          //DLなどでここにくることはないはずだが、念のため
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
        ENDSWITCH
      ENDIF

    CASE WBT_LOBBY_SEQ_SELECT_POKE THEN
      $LWK_CHK_RULE = FALSE
      _CALL ev_regist_check
      IF $LWK_CHK_RULE == FALSE THEN
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_END
      ELSE
        $LWK_CHK_RULE = FALSE
        _CALL ev_select_pokemon

        IF $LWK_CHK_RULE == TRUE THEN
          //エントリー
          _WBT_SYSTEM_ENTRY()
          _WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_ENTRY )

          //会場へ入る
          _CALL ev_enter_hall
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_HALL
        ELSE
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
        ENDIF
      ENDIF

    DEFAULT
      //不慮の場合に備える
      $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_END
    ENDSWITCH

  ENDWHILE

	IF $LWK_WBT_LOBBY_SEQ == WBT_LOBBY_SEQ_END THEN
    //やめる場合
		//またの御利用をおまちしております
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_09, SCWK_TARGET_OBJID, POS_DL )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()

    _WBT_SYSTEM_END() //_WBT_SYSTEM_STARTと対
  ELSE
    //仮・本当はこのまま会場イベントへつながるはず
    //_WBT_SYSTEM_END() //_WBT_SYSTEM_STARTと対
  ENDIF

  _RET
	


/**************************************************************/
/**************************************************************/
ev_first_menu:
	//BMPMENU表示
	_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

	_BMPMENU_MAKE_LIST( msg_wbt_menu_yes, 0 )		//参加する
	_BMPMENU_MAKE_LIST( msg_wbt_menu_explain, 1 )	//説明をきく
	_BMPMENU_MAKE_LIST( msg_wbt_menu_no, 2 )		//やめる

	//メニュー表示
	_BMPMENU_START()
		
	//選択結果で分岐
	SWITCH $LWK_MENU
	CASE 0 THEN		//参加する場合
	
    $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
	
	CASE 1 THEN		//説明をきく場合
			
    $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_EXPLAIN
		
	DEFAULT			//やめる場合
		
    $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_END
		
	ENDSWITCH

  _RET
	

/**************************************************************/
/*		トーナメントの参加受付								  */
/**************************************************************/
ev_select_tournament:

//どのトーナメントに参加しますか？
_BALLOONWIN_OBJMSG_POS( msg_wbt_info_10, SCWK_TARGET_OBJID, POS_DL )

//BMPMENU表示
_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

_BMPMENU_MAKE_LIST( msg_wbt_menu_all, SCR_WBT_TYPE_ALL )		//オールトーナメント
_WBT_CHECK_TOURNAMENT( SCR_WBT_TYPE_POKETYPE, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_type, SCR_WBT_TYPE_POKETYPE )		//タイプトーナメント
ENDIF
_WBT_CHECK_TOURNAMENT( SCR_WBT_TYPE_CHAMPION, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_champ, SCR_WBT_TYPE_CHAMPION )		//チャンピオントーナメント
ENDIF
_WBT_CHECK_TOURNAMENT( SCR_WBT_TYPE_DOWNLOAD, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_dl, SCR_WBT_TYPE_DOWNLOAD )		//ダウンロードトーナメント
ENDIF
_BMPMENU_MAKE_LIST( msg_wbt_menu_back, SCR_WBT_TYPE_NULL )		//もどる

//メニュー表示
_BMPMENU_START()

IF $LWK_MENU == EV_WIN_B_CANCEL THEN
  $LWK_MENU = SCR_WBT_TYPE_NULL
ENDIF
_RET

/**************************************************************/
/*		バトルルールの決定									  */
/**************************************************************/
ev_select_rule:

//どのバトルルールで参加しますか？
_BALLOONWIN_OBJMSG_POS( msg_wbt_info_13, SCWK_TARGET_OBJID, POS_DL )

//BMPMENU表示
_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

_BMPMENU_MAKE_LIST( msg_wbt_menu_rule_single, SCR_WBT_RULE_SINGLE )	//シングルバトル
_BMPMENU_MAKE_LIST( msg_wbt_menu_rule_double, SCR_WBT_RULE_DOUBLE )	//ダブルバトル
_BMPMENU_MAKE_LIST( msg_wbt_menu_rule_triple, SCR_WBT_RULE_TRIPLE )	//トリプルバトル
_BMPMENU_MAKE_LIST( msg_wbt_menu_rule_rotation, SCR_WBT_RULE_ROTATION )	//ローテーションバトル
_BMPMENU_MAKE_LIST( msg_wbt_menu_back, SCR_WBT_RULE_NULL )			//もどる

//メニュー表示
_BMPMENU_START()

IF $LWK_MENU == EV_WIN_B_CANCEL THEN
  $LWK_MENU = SCR_WBT_RULE_NULL
ENDIF
_RET

/**************************************************************/
/*		手持ちが足りているかチェック処理					  */
/**************************************************************/
ev_regist_check:

  _WBT_GET_BATTLE_RULE( LWK_RULE )

  SWITCH $LWK_RULE
  CASE SCR_WBT_RULE_SINGLE THEN
    $LWK_REG = REG_WBT_SINGLE
  CASE SCR_WBT_RULE_DOUBLE THEN
    $LWK_REG = REG_WBT_DOUBLE
  CASE SCR_WBT_RULE_TRIPLE THEN
    $LWK_REG = REG_WBT_TRIPLE
  CASE SCR_WBT_RULE_ROTATION THEN
    $LWK_REG = REG_WBT_ROTATION
  ENDSWITCH

  _BTL_UTIL_PARTY_SELECT_CALL( LWK_REG, SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BTL_PARTY_SELECT_CANCEL THEN
    _RET
  ELSIF $SCWK_ANSWER == SCR_BTL_PARTY_SELECT_NG THEN
    _MSGWIN_CLOSE()
    _BTL_UTIL_PARTY_REGULATION_NG_MSG_CALL( LWK_REG )
    _RET
  ENDIF

  $LWK_CHK_RULE = TRUE

_RET

/**************************************************************/
/*		参加するポケモンの選択          */
/**************************************************************/
ev_select_pokemon:

//トーナメントに参加するポケモンを選択してください
_BALLOONWIN_OBJMSG_POS( msg_wbt_info_15, SCWK_TARGET_OBJID, POS_DL )
_MSGWIN_CLOSE()

//ポケモン選択画面表示　　　　　　　　　　　　　　　　　　　　　　　　
  _WBT_SELECT_POKEMON( SCWK_ANSWER )

  IF $SCWK_ANSWER == FALSE THEN
    //キャンセルした場合は何もせずに戻る
    _RET
  ENDIF

//ルールと適用しているかチェック　
_WBT_CHECK_BATTLE_RULE( LWK_CHK_RULE )

IF $LWK_CHK_RULE == TRUE THEN
//問題なしの場合

ELSE
//問題ありの場合

	//参加するポケモンに問題があるようです
	_BALLOONWIN_OBJMSG_POS( msg_wbt_info_error1, SCWK_TARGET_OBJID, POS_DL )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()

ENDIF

_RET

/**************************************************************/
//  エントリー→会場へ入場する
/**************************************************************/
ev_enter_hall:

	//参加受付が終わりました！
	_BALLOONWIN_OBJMSG_POS( msg_wbt_info_17, SCWK_TARGET_OBJID, POS_DL )
	_MSGWIN_CLOSE()

  //_MAP_FADE_BLACK_OUT()
  //_MAP_FADE_END_CHECK()

	////トーナメントリスト表示
	//_WBT_LIST_CALL( SCR_WBT_LIST_1ST_START )
	
  //_MAP_FADE_BLACK_IN()
  //_MAP_FADE_END_CHECK()

	////それでは第一回戦を開始します！
	//_BALLOONWIN_OBJMSG_POS( msg_wbt_info_18, SCWK_TARGET_OBJID, POS_DL )
	//_MSGWIN_CLOSE()
	

  _OBJ_ANIME( SCWK_TARGET_OBJID, anm_infowoman_move_r )
  _OBJ_ANIME_WAIT()

	//誘導アニメ
	//会場へマップ移動
	
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_enter )
  _MAP_FADE_BLACK_OUT_SLOW()
  _OBJ_ANIME_WAIT()
  _MAP_FADE_END_CHECK()
  _MAP_CHANGE_NO_FADE( ZONE_ID_D05R0201, 31, 0, 15, DIR_LEFT )

	//リザーブスクリプト－会場－
	
  _RESERVE_SCRIPT( SCRID_WBT_HALL_01 )

  _RET

//--------------------------------------------------------------------
//  受付嬢    プレイヤーに道をあけるアニメ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_infowoman_move_r
  _ANIME_DATA  AC_WALK_R_8F, 1
  _ANIME_DATA  AC_STAY_WALK_L_8F,1
  _ANIME_DATA  ACMD_END, 0

//--------------------------------------------------------------------
//  プレイヤー　WBT会場へ入っていくアニメ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_enter
  _ANIME_DATA  AC_WALK_U_8F,5
  _ANIME_DATA  ACMD_END, 0

/**************************************************************/
/*		トーナメントの説明									  */
/**************************************************************/
ev_explain:

//どのトーナメントについて説明をいたしましょうか？
_BALLOONWIN_OBJMSG_POS( msg_wbt_info_03, SCWK_TARGET_OBJID, POS_DL )

//BMPMENU表示
_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

_BMPMENU_MAKE_LIST( msg_wbt_menu_explain_all, 0 )	//オールトーナメントについて

_WBT_CHECK_TOURNAMENT( SCR_WBT_TYPE_POKETYPE, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_explain_type, 1 )	//タイプトーナメントについて
ENDIF

_WBT_CHECK_TOURNAMENT( SCR_WBT_TYPE_CHAMPION, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_explain_champ, 2 )	//チャンピオントーナメントについて
ENDIF

_WBT_CHECK_TOURNAMENT( SCR_WBT_TYPE_DOWNLOAD, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_explain_dl, 3 )	//ダウンロードトーナメントについて
ENDIF

_BMPMENU_MAKE_LIST( msg_wbt_menu_explain_rule, 4 )	//バトルルールについて

_BMPMENU_MAKE_LIST( msg_wbt_menu_back, 5 )			//もどる

//メニュー表示
_BMPMENU_START()

	//選択結果で分岐
	SWITCH $LWK_MENU
	CASE 0 THEN		//オールトーナメントについて
	
		//オールトーナメントは！
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_04, SCWK_TARGET_OBJID, POS_DL )
		
	CASE 1 THEN		//タイプトーナメントについて

		//タイプトーナメントは！
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_05, SCWK_TARGET_OBJID, POS_DL )

	CASE 2 THEN		//チャンピオントーナメントについて

		//チャンピオントーナメントは！
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_06, SCWK_TARGET_OBJID, POS_DL )

	CASE 3 THEN		//ダウンロードトーナメントについて

		//ダウンロードトーナメントは！
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_07, SCWK_TARGET_OBJID, POS_DL )

	CASE 4 THEN		//バトルルールについて

		//バトルルールは！
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_08, SCWK_TARGET_OBJID, POS_DL )

	DEFAULT			//もどる・Bボタン

		$LWK_MENU_WHILE = 1

	ENDSWITCH

_RET

/**************************************************************/
/*		タイプトーナメントの参加							  */
/**************************************************************/
ev_select_poketype:

//どのタイプのトーナメントに参加しますか？
_BALLOONWIN_OBJMSG_POS( msg_wbt_info_12, SCWK_TARGET_OBJID, POS_DL )

//BMPMENU表示
_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

_BMPMENU_MAKE_LIST( msg_wbt_menu_normal, POKETYPE_NORMAL )	//ノーマル
_BMPMENU_MAKE_LIST( msg_wbt_menu_honoo, POKETYPE_HONOO )		//ほのお
_BMPMENU_MAKE_LIST( msg_wbt_menu_mizu, POKETYPE_MIZU )		//みず
_BMPMENU_MAKE_LIST( msg_wbt_menu_kusa, POKETYPE_KUSA )		//くさ
_BMPMENU_MAKE_LIST( msg_wbt_menu_denki, POKETYPE_DENKI )		//でんき
_BMPMENU_MAKE_LIST( msg_wbt_menu_koori, POKETYPE_KOORI )		//こおり
_BMPMENU_MAKE_LIST( msg_wbt_menu_kakutou, POKETYPE_KAKUTOU )	//かくとう
_BMPMENU_MAKE_LIST( msg_wbt_menu_doku, POKETYPE_DOKU )		//どく
_BMPMENU_MAKE_LIST( msg_wbt_menu_zimen, POKETYPE_JIMEN )		//じめん
_BMPMENU_MAKE_LIST( msg_wbt_menu_hikou, POKETYPE_HIKOU )		//ひこう
_BMPMENU_MAKE_LIST( msg_wbt_menu_esper, POKETYPE_ESPER )	//エスパー
_BMPMENU_MAKE_LIST( msg_wbt_menu_musi, POKETYPE_MUSHI )		//むし
_BMPMENU_MAKE_LIST( msg_wbt_menu_iwa, POKETYPE_IWA )		//いわ
_BMPMENU_MAKE_LIST( msg_wbt_menu_gorst, POKETYPE_GHOST )	//ゴースト
_BMPMENU_MAKE_LIST( msg_wbt_menu_dragon, POKETYPE_DRAGON )	//ドラゴン
_BMPMENU_MAKE_LIST( msg_wbt_menu_aku, POKETYPE_AKU )		//あく
_BMPMENU_MAKE_LIST( msg_wbt_menu_hagane, POKETYPE_HAGANE )	//はがね
_BMPMENU_MAKE_LIST( msg_wbt_menu_back, POKETYPE_NULL )		//もどる

//メニュー表示
_BMPMENU_START()

//選択結果で分岐
//$LWK_MENU

IF $LWK_MENU == EV_WIN_B_CANCEL THEN
  $LWK_MENU = POKETYPE_NULL
ENDIF
_RET

/**************************************************************/
/*		チャンピオントーナメントの参加						  */
/**************************************************************/
ev_champ:
_RET

/**************************************************************/
/*		ダウンロードトーナメントの参加						  */
/**************************************************************/
ev_select_download:

//ダウンロードトーナメント数を取得する
_WBT_GET_DL_COUNT( LWK_DL_COUNT )

//１つもダウンロードしていない場合
IF $LWK_DL_COUNT == 0 THEN

	//お客様が参加できるトーナメントがないみたいです
	_BALLOONWIN_OBJMSG_POS( msg_wbt_info_14_01, SCWK_TARGET_OBJID, POS_DL )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()

//１つ以上ダウンロードしている場合
ELSE

	//参加できるトーナメントはこちらになります
	_BALLOONWIN_OBJMSG_POS( msg_wbt_info_14, SCWK_TARGET_OBJID, POS_DL )

	//BMPMENU表示
	_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

	SWITCH $LWK_DL_COUNT
		CASE 1 THEN		//ダウンロード数が１の場合
			//ダウンロードデータの名前をセット
			_WBT_SET_DL_NAME( 1, 1 )
			_BMPMENU_MAKE_LIST( msg_wbt_menu_dl01, 1 )	//ダウンロードトーナメント１
		CASE 2 THEN		//ダウンロード数が２の場合
			//ダウンロードデータの名前をセット
			_WBT_SET_DL_NAME( 1, 1 )
			_WBT_SET_DL_NAME( 2, 2 )
			_BMPMENU_MAKE_LIST( msg_wbt_menu_dl01, 1 )	//ダウンロードトーナメント１
			_BMPMENU_MAKE_LIST( msg_wbt_menu_dl02, 2 )	//ダウンロードトーナメント２
		CASE 3 THEN		//ダウンロード数が３の場合
			//ダウンロードデータの名前をセット
			_WBT_SET_DL_NAME( 1, 1 )
			_WBT_SET_DL_NAME( 2, 2 )
			_WBT_SET_DL_NAME( 3, 3 )
			_BMPMENU_MAKE_LIST( msg_wbt_menu_dl01, 1 )	//ダウンロードトーナメント１
			_BMPMENU_MAKE_LIST( msg_wbt_menu_dl02, 2 )	//ダウンロードトーナメント２
			_BMPMENU_MAKE_LIST( msg_wbt_menu_dl03, 3 )	//ダウンロードトーナメント３
	ENDSWITCH

	_BMPMENU_MAKE_LIST( msg_wbt_menu_back, 0 )	//もどる

	//メニュー表示
	_BMPMENU_START()

  //_WBT_SELECT_DL_DATA( LWK_MENU )

ENDIF

_RET

/********************************************************************/
//
//        WBT終了後
//
/********************************************************************/
EVENT_START	ev_reserve_wbt_exit

  $SCWK_TARGET_OBJID = D05R0101_INFOMATIONW_01

  //本当はwbt_hall.ev::ev_wbt_hall_exitで設定した戻り値で分岐する

  //仮当て：「またの　参加を～」
  _BALLOONWIN_OBJMSG_POS( msg_wbt_info_09, SCWK_TARGET_OBJID, POS_DL )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_exit )
  _OBJ_ANIME_WAIT()

EVENT_END

//--------------------------------------------------------------------
//  プレイヤー　WBT終了後
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_exit
  _ANIME_DATA AC_WALK_D_8F,2
  _ANIME_DATA ACMD_END, 0



//======================================================================
//
//
//      WBTエントリーチェッカー
//
//
//======================================================================
/********************************************************************/
//
//      WBTエントリーチェッカー本体
//
/********************************************************************/
DEFINE_LOCAL  LOG_OUT
DEFINE_LOCAL  LWK_SELECT_POS

EVENT_START ev_wbt_entry_checker

  _SE_PLAY( SEQ_SE_PC_LOGIN )
  _PLAYER_NAME( 0 )
  _SYSWIN_MSG( msg_wbt_pc_on, POS_DOWN )

  $LOG_OUT = FALSE

  WHILE $LOG_OUT == FALSE
    _SYSWIN_MSG( msg_wbt_pc_blank, POS_DOWN )
    _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, TRUE, LWK_SELECT_POS )
    _BMPMENU_MAKE_LIST_EX( msg_wbt_pc_menu_01, msg_wbt_pc_info_01, msg_wbt_pc_menu_01 )
    _BMPMENU_MAKE_LIST_EX( msg_wbt_pc_menu_02, msg_wbt_pc_info_02, msg_wbt_pc_menu_02 )
    _BMPMENU_MAKE_LIST_EX( msg_wbt_pc_menu_03, msg_wbt_pc_info_03, msg_wbt_pc_menu_03 )
    _BMPMENU_START()

    _TIME_WAIT(3) //なんとなくPCのまねをしてSE待ち

    SWITCH $LWK_SELECT_POS
    CASE msg_wbt_pc_menu_01 THEN
      _CALL ev_victory_checker
    CASE msg_wbt_pc_menu_02 THEN
      _CALL ev_downloader
    CASE msg_wbt_pc_menu_03 THEN
      $LOG_OUT = TRUE
    DEFAULT
      $LOG_OUT = TRUE
    ENDSWITCH

  ENDWHILE
  _SYSWIN_CLOSE()

EVENT_END

/********************************************************************/
//
//  優勝記録確認画面
//
/********************************************************************/
ev_victory_checker:
  _SYSWIN_MSG( msg_wbt_pc_select_01, POS_DOWN )
  _SYSWIN_CLOSE()
  _WBT_ENTRY_CHECKER_VICTORY_RECORD( SCWK_ANSWER )
  _RET

/********************************************************************/
//
//  ダウンロード
//
/********************************************************************/
ev_downloader:
DEFINE_LOCAL  LOG_OUT_DL

  $LOG_OUT_DL = FALSE
  _SYSWIN_MSG( msg_wbt_pc_select_02, POS_DOWN )

  WHILE $LOG_OUT_DL == FALSE && $LOG_OUT == FALSE
    _SYSWIN_MSG( msg_wbt_pc_blank, POS_DOWN )
    _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, TRUE, LWK_SELECT_POS )
    _BMPMENU_MAKE_LIST_EX( msg_wbt_pc_menu_dl_01, msg_wbt_pc_info_dl_01, msg_wbt_pc_menu_dl_01 )
    _BMPMENU_MAKE_LIST_EX( msg_wbt_pc_menu_dl_02, msg_wbt_pc_info_dl_02, msg_wbt_pc_menu_dl_02 )
    _BMPMENU_MAKE_LIST_EX( msg_wbt_pc_menu_dl_03, msg_wbt_pc_blank,      msg_wbt_pc_menu_dl_03 )
    _BMPMENU_START()

    SWITCH $LWK_SELECT_POS
    CASE msg_wbt_pc_menu_dl_01 THEN
        _CALL ev_downloader_2
    CASE msg_wbt_pc_menu_dl_02 THEN
        _SYSWIN_CLOSE()
        _WBT_ENTRY_CHECKER_DOWNLOAD( SCR_WBT_DL_APP_LIST, SCWK_ANSWER )
        IF $SCWK_ANSWER == TRUE THEN
          $LOG_OUT = TRUE
        ENDIF
    CASE msg_wbt_pc_menu_dl_03 THEN
      $LOG_OUT_DL = TRUE
    DEFAULT
      $LOG_OUT_DL = TRUE
    ENDSWITCH

  ENDWHILE
  _SYSWIN_CLOSE()
  _RET

ev_downloader_2:
DEFINE_LOCAL  LOG_OUT_DL2
  $LOG_OUT_DL2 = FALSE
  _SYSWIN_MSG( msg_wbt_pc_info_dl_00, POS_DOWN )

  WHILE $LOG_OUT_DL2 == FALSE && $LOG_OUT == FALSE

    _SYSWIN_MSG( msg_wbt_pc_blank, POS_DOWN )
    _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, TRUE, LWK_SELECT_POS )
    _BMPMENU_MAKE_LIST( msg_wbt_pc_menu_dl_04, msg_wbt_pc_menu_dl_04 )  //WIFIで
    _BMPMENU_MAKE_LIST( msg_wbt_pc_menu_dl_05, msg_wbt_pc_menu_dl_05 )  //Wirelessで
    _BMPMENU_MAKE_LIST( msg_wbt_pc_menu_03, msg_wbt_pc_menu_03 )        //やめる
    _BMPMENU_START()

    SWITCH $LWK_SELECT_POS
    CASE msg_wbt_pc_menu_dl_04 THEN
        _SYSWIN_CLOSE()
        _WBT_ENTRY_CHECKER_DOWNLOAD( SCR_WBT_DL_APP_WIFI,     SCWK_ANSWER )
        IF $SCWK_ANSWER == TRUE THEN
          $LOG_OUT = TRUE
        ENDIF
    CASE msg_wbt_pc_menu_dl_05 THEN
        _SYSWIN_CLOSE()
        _WBT_ENTRY_CHECKER_DOWNLOAD( SCR_WBT_DL_APP_WIRELESS, SCWK_ANSWER )
        IF $SCWK_ANSWER == TRUE THEN
          $LOG_OUT = TRUE
        ENDIF
    CASE msg_wbt_pc_menu_03 THEN
      $LOG_OUT_DL2 = TRUE
    DEFAULT
      $LOG_OUT_DL2 = TRUE
    ENDSWITCH

  ENDWHILE

  _SYSWIN_CLOSE()

  _RET


