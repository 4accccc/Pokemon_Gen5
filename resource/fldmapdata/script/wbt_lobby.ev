  .text

  .include  "scr_seq_def.h"
  .include  "msg_wbt_lobby.h"

  //.include  "../../../prog/include/poke_tool/poketype_def.h"

  .include "wbt_scr_define.h"

  .include "wbt_hall_def.h" //リザーブスクリプトID参照
  .include "d05r0101_def.h"  //WBTチュートリアルイベント用参照

  .include  "d05r0101.h"    //OBJID参照

//----------------------------------------------------------------------
//               スクリプトテーブル
//----------------------------------------------------------------------
_EVENT_DATA		ev_wbt_reception_l
_EVENT_DATA   ev_wbt_entry_checker
_EVENT_DATA   ev_wbt_reception_r
_EVENT_DATA   ev_reserve_wbt_exit
_EVENT_DATA   ev_init_wbt_lobby
_EVENT_DATA   ev_zone_wbt_lobby
_EVENT_DATA_END



/********************************************************************/
/*						FIELD_INIT_LABEL                            */
/********************************************************************/
INIT_EVENT_START  ev_init_wbt_lobby
  _WBT_SYSTEM_CHECK_ENABLE( SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _CALL ev_init_wbt_lobby_reception
    _CALL ev_init_wbt_lobby_tutorial
  ENDIF
  _CALL ev_init_wbt_lobby_obj
INIT_EVENT_END

//WBT会場から退出するときの受付嬢の位置修正
ev_init_wbt_lobby_reception:
  _WBT_GET_RECEPTION_ID( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_WBT_RECEPTION1 THEN
    $SCWK_TARGET_OBJID = D05R0101_INFOMATIONW_01
    _OBJ_POS_CHANGE( SCWK_TARGET_OBJID, 15, 0, 5, DIR_LEFT )
  ELSIF $SCWK_ANSWER == SCR_WBT_RECEPTION2 THEN
    $SCWK_TARGET_OBJID = D05R0101_INFOMATIONW_02
    _OBJ_POS_CHANGE( SCWK_TARGET_OBJID, 15, 0, 5, DIR_RIGHT )
  ENDIF
  _RET

/********************************************************************/
/*						ZONE_INIT_LABEL                            */
/********************************************************************/
INIT_EVENT_START  ev_zone_wbt_lobby
  //一旦消す
  _FLAG_SET( FV_WBT_LOBBY_LEADER1 )
  _FLAG_SET( FV_WBT_LOBBY_LEADER2 )
  _FLAG_SET( FV_WBT_LOBBY_LEADER3 )

INIT_EVENT_END

//WBT会場から退出するときに対戦者を表示するかどうかの処理
ev_init_wbt_lobby_obj:

  IF FLAG_ON( SYS_FLAG_WBT_TUTORIAL ) THEN
    //チュートリアル時は対戦者を出さない
    _RET
  ENDIF

  _WBT_GET_LOBBY_TRAINER_MMDL( OBJCHRWORK0, OBJCHRWORK1, OBJCHRWORK2 )
  IF $OBJCHRWORK0 != 0 THEN
    _FLAG_RESET( FV_WBT_LOBBY_LEADER1 )
    _OBJ_ADD( D05R0101_WKOBJCODE00 )
  ENDIF
  IF $OBJCHRWORK1 != 0 THEN
    _FLAG_RESET( FV_WBT_LOBBY_LEADER2 )
    _OBJ_ADD( D05R0101_WKOBJCODE01 )
  ENDIF
  IF $OBJCHRWORK2 != 0 THEN
    _FLAG_RESET( FV_WBT_LOBBY_LEADER3 )
    _OBJ_ADD( D05R0101_WKOBJCODE02 )
  ENDIF
  _RET
  
//WBTチュートリアルでシーケンスを進めるかどうか
ev_init_wbt_lobby_tutorial:
  IF FLAG_OFF( SYS_FLAG_WBT_TUTORIAL ) THEN
    _RET
  ENDIF

  //ホドモエイベントカップか？
  _WBT_GET_WBT_CUP( SCWK_ANSWER )
  IF $SCWK_ANSWER != SCR_WBT_CUP_HODOMOE_EVENT THEN
    _RET
  ENDIF

  //優勝した場合か？
  _WBT_SYSTEM_GET_STAGE( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_WBT_STAGE_WIN THEN
    $WK_SCENE_D05R0101 = 1
  ENDIF
_RET

/********************************************************************/
/*						FIELD_RECOVER_LABEL                         */
/********************************************************************/

/**************************************************************/
/*    ＷＢＴ・ＰＯＳスクリプト                */
/**************************************************************/


/**************************************************************/
/*		ＷＢＴ・受付スクリプト（左側）								  */
/**************************************************************/
EVENT_START	ev_wbt_reception_l

  _TALK_OBJ_START()

  IF $WK_SCENE_D05R0101 == 3 THEN
    //しばらくこの受付では参加できないことを知らせるメッセージ
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_19a, SCWK_TARGET_OBJID, POS_DL )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ELSE
    //WBT制御システム開始：終了するときは必ず対で_WBT_SYSTEM_END()をよぶこと！
    _WBT_SYSTEM_START()
    _WBT_SET_RECEPTION_ID( SCR_WBT_RECEPTION1 )

    //ＷＢＴ受付メイン処理
    _CALL ev_wbt_main
  ENDIF

EVENT_END

/**************************************************************/
/*		ＷＢＴ・受付スクリプト（右側）								  */
/**************************************************************/
EVENT_START ev_wbt_reception_r

  _TALK_OBJ_START()

  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN

    //WBT制御システム開始：終了するときは必ず対で_WBT_SYSTEM_END()をよぶこと！
    _WBT_SYSTEM_START()
    _WBT_SET_RECEPTION_ID( SCR_WBT_RECEPTION2 )

    //ＷＢＴ受付メイン処理
    _CALL ev_wbt_main

  ELSE
    //クリアまでこの受付では参加できないことを知らせるメッセージ
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_19, SCWK_TARGET_OBJID, POS_DL )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF

EVENT_END




/********************************************************************/
//
//
//                      WBT受付メイン
//
//
/********************************************************************/
//FH_02		チャンピオントーナメント参加フラグ	タイムフラグ

ev_wbt_main:

DEFINE_LOCAL	LWK_WBT_LOBBY_SEQ
DEFINE_LOCAL	LWK_WBT_SELECT_TOURNAMENT
DEFINE_LOCAL  LWK_WBT_SELECT_DL
DEFINE_LOCAL	LWK_MENU
DEFINE_LOCAL	LWK_MENU_WHILE
DEFINE_LOCAL	LWK_RULE
DEFINE_LOCAL  LWK_REG
DEFINE_LOCAL	LWK_CHK_RULE
DEFINE_LOCAL	LWK_DL_COUNT
DEFINE_LOCAL  LWK_TEMP

  _WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_RECEPTION )

  //ようこそ　ワールドバトルトーナメントへ！
  _BALLOONWIN_OBJMSG_POS( msg_wbt_info_01, SCWK_TARGET_OBJID, POS_DL )

  $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_FIRST_MENU

  WHILE $LWK_WBT_LOBBY_SEQ != WBT_LOBBY_SEQ_END && $LWK_WBT_LOBBY_SEQ != WBT_LOBBY_SEQ_HALL

    _DEBUG_PRINT_WK( LWK_WBT_LOBBY_SEQ )
    SWITCH $LWK_WBT_LOBBY_SEQ
    CASE WBT_LOBBY_SEQ_FIRST_MENU THEN
      //参加受付をなさいますか？
      _BALLOONWIN_OBJMSG_POS( msg_wbt_info_02, SCWK_TARGET_OBJID, POS_DL )

      _CALL ev_first_menu

    CASE WBT_LOBBY_SEQ_SELECT_EXPLAIN THEN
      //トーナメント説明

      $LWK_MENU_WHILE = 0

      _CALL ev_explain

      IF $LWK_MENU_WHILE == 1 THEN
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_FIRST_MENU
      ENDIF

    CASE WBT_LOBBY_SEQ_SELECT_TOURNAMENT THEN
      //トーナメント選択
      _CALL ev_select_tournament
      _WBT_SET_WBT_CUP( LWK_MENU )  //キャンセルの場合はSCR_WBT_CUP_NULLをセット
      $LWK_WBT_SELECT_TOURNAMENT = $LWK_MENU
      SWITCH $LWK_WBT_SELECT_TOURNAMENT
      CASE SCR_WBT_CUP_NULL THEN
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_FIRST_MENU

      CASE SCR_WBT_CUP_HODOMOE_EVENT THEN
        //ホドモエイベントではルール選択せずシングル固定
        _WBT_SET_BATTLE_RULE( SCR_WBT_RULE_SINGLE )
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_POKE

      CASE SCR_WBT_CUP_POKETYPE THEN
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_POKETYPE

      CASE SCR_WBT_CUP_DOWNLOAD THEN
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_DL

      DEFAULT
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_RULE

      ENDSWITCH   //$LWK_WBT_SELECT_TOURNAMENT

    CASE WBT_LOBBY_SEQ_SELECT_POKETYPE THEN
      //ポケモンのタイプ選択
      $LWK_MENU = POKETYPE_NULL
      _WBT_SET_TOURNAMENT_POKETYPE( POKETYPE_NULL )
      _CALL ev_select_poketype
      IF $LWK_MENU == POKETYPE_NULL THEN
        //タイプ未選択→トーナメントの選択へ戻る
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
      ELSE
        //タイプ選択→ルール選択へ進む
        _WBT_SET_TOURNAMENT_POKETYPE( LWK_MENU )
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_RULE
      ENDIF

    CASE WBT_LOBBY_SEQ_SELECT_DL THEN
      //DLデータ選択
      $LWK_WBT_SELECT_DL = 0
      _CALL ev_select_download
      _WBT_SET_DL_DATA( LWK_WBT_SELECT_DL )
      IF $LWK_DL_COUNT == 0 THEN
        //DLデータがなかった→終了
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_END
      ELSIF $LWK_WBT_SELECT_DL == 0 THEN
        //未選択→トーナメント選択へ戻る
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
      ELSE
        //DLデータ選択→ポケモンのチェック＆選択へ
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_POKE
      ENDIF

    CASE WBT_LOBBY_SEQ_SELECT_RULE THEN
    //バトルルール選択
      $LWK_RULE = SCR_WBT_RULE_NULL
      _CALL ev_select_rule
      IF $LWK_MENU != SCR_WBT_RULE_NULL THEN
        //ルール選択→ポケモンのチェック＆選択へ
        $LWK_RULE = $LWK_MENU
        _WBT_SET_BATTLE_RULE( LWK_RULE )
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_POKE
      ELSE
        //ルール未選択→適宜前のシーケンスに戻る
        _WBT_GET_WBT_CUP( LWK_WBT_SELECT_TOURNAMENT )
        IF $LWK_WBT_SELECT_TOURNAMENT == SCR_WBT_CUP_POKETYPE THEN
          //タイプエキスパートの場合のみ、タイプ選択に戻る
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_POKETYPE
        ELSE
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
        ENDIF
      ENDIF

    CASE WBT_LOBBY_SEQ_SELECT_POKE THEN
      $LWK_CHK_RULE = FALSE
      _CALL ev_regist_check
      IF $LWK_CHK_RULE == FALSE THEN
        $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_END
      ELSE
        $LWK_CHK_RULE = FALSE
        _CALL ev_select_pokemon

        IF $LWK_CHK_RULE == TRUE THEN
          //エントリー
          _WBT_SYSTEM_ENTRY()
          _WBT_SYSTEM_SET_STAGE( SCR_WBT_STAGE_ENTRY )

          //会場へ入る
          _CALL ev_enter_hall
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_HALL
        ELSE
          $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
        ENDIF
      ENDIF

    DEFAULT
      //不慮の場合に備える
      $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_END
    ENDSWITCH

  ENDWHILE

	IF $LWK_WBT_LOBBY_SEQ == WBT_LOBBY_SEQ_END THEN
    //やめる場合
		//またの御利用をおまちしております
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_04, SCWK_TARGET_OBJID, POS_DL )
		_LAST_KEYWAIT()
		_MSGWIN_CLOSE()

    _WBT_SYSTEM_END() //_WBT_SYSTEM_STARTと対
  ELSE
    //本当はこのまま会場イベントへつながるはず
    //_WBT_SYSTEM_END() //_WBT_SYSTEM_STARTと対
  ENDIF

  _RET
	


/**************************************************************/
/**************************************************************/
ev_first_menu:
	//BMPMENU表示
	_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

	_BMPMENU_MAKE_LIST( msg_wbt_menu_yes, 0 )		//参加する
	_BMPMENU_MAKE_LIST( msg_wbt_menu_explain, 1 )	//説明をきく
	_BMPMENU_MAKE_LIST( msg_wbt_menu_no, 2 )		//やめる

	//メニュー表示
	_BMPMENU_START()
		
	//選択結果で分岐
	SWITCH $LWK_MENU
	CASE 0 THEN		//参加する場合
	
    $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_TOURNAMENT
	
	CASE 1 THEN		//説明をきく場合
			
    $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_SELECT_EXPLAIN
		
	DEFAULT			//やめる場合
		
    $LWK_WBT_LOBBY_SEQ = WBT_LOBBY_SEQ_END
		
	ENDSWITCH

  _RET
	

/**************************************************************/
/*		トーナメントの参加受付								  */
/**************************************************************/
ev_select_tournament:

//どのトーナメントに参加しますか？
_BALLOONWIN_OBJMSG_POS( msg_wbt_info_10, SCWK_TARGET_OBJID, POS_DL )

//BMPMENU表示
_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

//トーナメント選択・説明選択共通の選択肢生成処理
_CALL sub_make_tournament_list

_BMPMENU_MAKE_LIST( msg_wbt_menu_back, SCR_WBT_CUP_NULL )		//もどる

//メニュー表示
_BMPMENU_START()

IF $LWK_MENU == EV_WIN_B_CANCEL THEN
  $LWK_MENU = SCR_WBT_CUP_NULL
ENDIF
_RET


/**************************************************************/
//トーナメント選択・説明選択共通の選択肢生成処理
/**************************************************************/
sub_make_tournament_list:
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_HODOMOE_EVENT, SCWK_ANSWER ) //ホドモエトーナメント（イベント）
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_hodomoe, SCR_WBT_CUP_HODOMOE_EVENT )
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_HODOMOE, SCWK_ANSWER ) //ホドモエトーナメント
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_hodomoe, SCR_WBT_CUP_HODOMOE )
ENDIF

_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_ISSYU, SCWK_ANSWER ) //イッシュトーナメント
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_issyu, SCR_WBT_CUP_ISSYU )
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_KANTO, SCWK_ANSWER ) //カントートーナメント
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_kanto, SCR_WBT_CUP_KANTO )
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_JOUTO, SCWK_ANSWER ) //ジョウトトーナメント
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_jouto, SCR_WBT_CUP_JOUTO )
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_HOUEN, SCWK_ANSWER ) //ホウエントーナメント
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_houen, SCR_WBT_CUP_HOUEN )
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_SINOU, SCWK_ANSWER ) //シンオウトーナメント
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_sinou, SCR_WBT_CUP_SINOU )
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_WORLD, SCWK_ANSWER ) //ワールドトーナメント
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_world, SCR_WBT_CUP_WORLD )
ENDIF

_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_CHAMPION, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_champ, SCR_WBT_CUP_CHAMPION )		//チャンピオントーナメント
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_RENTALMASTER, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_rental_m, SCR_WBT_CUP_RENTALMASTER )		//レンタルマスタートーナメント
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_MIXMASTER, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_mix_m, SCR_WBT_CUP_MIXMASTER )		//ミックスマスタートーナメント
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_POKETYPE, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_type, SCR_WBT_CUP_POKETYPE )		//タイプエキスパートトーナメント
ENDIF

//以下は受付１追加
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_RENTAL, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_rental, SCR_WBT_CUP_RENTAL )		//レンタルトーナメント
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_MIX, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_mix, SCR_WBT_CUP_MIX )		//ミックストーナメント
ENDIF
_WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_DOWNLOAD, SCWK_ANSWER )
IF $SCWK_ANSWER == TRUE THEN
  _BMPMENU_MAKE_LIST( msg_wbt_menu_dl, SCR_WBT_CUP_DOWNLOAD )		//ダウンロードトーナメント
ENDIF

_RET

/**************************************************************/
/*		バトルルールの決定									  */
/**************************************************************/
ev_select_rule:

//どのバトルルールで参加しますか？
_BALLOONWIN_OBJMSG_POS( msg_wbt_info_13, SCWK_TARGET_OBJID, POS_DL )

//BMPMENU表示
_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

_BMPMENU_MAKE_LIST( msg_wbt_menu_rule_single, SCR_WBT_RULE_SINGLE )	//シングルバトル
_BMPMENU_MAKE_LIST( msg_wbt_menu_rule_double, SCR_WBT_RULE_DOUBLE )	//ダブルバトル
_BMPMENU_MAKE_LIST( msg_wbt_menu_rule_triple, SCR_WBT_RULE_TRIPLE )	//トリプルバトル
_BMPMENU_MAKE_LIST( msg_wbt_menu_rule_rotation, SCR_WBT_RULE_ROTATION )	//ローテーションバトル
_BMPMENU_MAKE_LIST( msg_wbt_menu_back, SCR_WBT_RULE_NULL )			//もどる

//メニュー表示
_BMPMENU_START()

IF $LWK_MENU == EV_WIN_B_CANCEL THEN
  $LWK_MENU = SCR_WBT_RULE_NULL
ENDIF
_RET

/**************************************************************/
/*		手持ちが足りているかチェック処理					  */
/**************************************************************/
ev_regist_check:
{
  //レンタルの場合はチェックはスルー
  _WBT_GET_WBT_CUP( LWK_WBT_SELECT_TOURNAMENT )
  IF $LWK_WBT_SELECT_TOURNAMENT == SCR_WBT_CUP_RENTAL || $LWK_WBT_SELECT_TOURNAMENT == SCR_WBT_CUP_RENTALMASTER THEN
    $LWK_CHK_RULE = TRUE
    _RET
  ENDIF

  // ウィンドウを閉じるか判断する
  IF $LWK_WBT_SELECT_TOURNAMENT != SCR_WBT_CUP_DOWNLOAD THEN
    // ダウンロードトーナメント以外の場合はメッセージウィンドウを閉じる
    _MSGWIN_CLOSE()
  ENDIF

  // パーティー選択
  _WBT_BTL_UTIL_PARTY_SELECT_CALL( SCWK_ANSWER )
  // バトルボックス使用反映（使用しない場合はクリア処理）
  _WBT_SETUP_BTLBOX( SCWK_ANSWER )
  _DEBUG_PRINT_WK( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_BTL_PARTY_SELECT_CANCEL THEN
    _RET
  ELSIF $SCWK_ANSWER == SCR_BTL_PARTY_SELECT_NG THEN

    // NGメッセージを取得
    _WBT_GET_NG_MSG_ID( SCWK_ANSWER )
    SWITCH $SCWK_ANSWER
    CASE msg_wbt_info_ng_download THEN
      //_MSGWIN_CLOSE() ダウンロードは開いたMSGWINがない状態のはず！
      _SYSWIN_MSG( msg_wbt_info_ng_download, POS_DOWN )
      _MSGWIN_CLOSE()
    CASE msg_wbt_info_ng_all_single, msg_wbt_info_ng_all_double, msg_wbt_info_ng_all_triple, msg_wbt_info_ng_all_rotation THEN
      _SYSWIN_MSG( SCWK_ANSWER, POS_DOWN )
      _SYSWIN_MSG( msg_wbt_info_ng_all, POS_DOWN )
      _MSGWIN_CLOSE()
    DEFAULT
      _SYSWIN_MSG( SCWK_ANSWER, POS_DOWN )
      _WBT_GET_REGULATION_ID( LWK_REG )
      _BTL_UTIL_PARTY_REGULATION_NG_MSG_CALL2( LWK_REG )
    ENDSWITCH
    _RET
  ENDIF

  $LWK_CHK_RULE = TRUE
}
_RET

/**************************************************************/
/*		参加するポケモンの選択          */
/**************************************************************/
ev_select_pokemon:

  _WBT_GET_WBT_CUP( LWK_WBT_SELECT_TOURNAMENT )
  IF $LWK_WBT_SELECT_TOURNAMENT == SCR_WBT_CUP_RENTAL || $LWK_WBT_SELECT_TOURNAMENT == SCR_WBT_CUP_RENTALMASTER THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_18a, SCWK_TARGET_OBJID, POS_DL )
    _BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,0,SCWK_ANSWER )
    _BMPMENU_MAKE_LIST( msg_wbt_menu_lot_01, SCR_WBT_RENTAL_TYPE_1 )
    _BMPMENU_MAKE_LIST( msg_wbt_menu_lot_02, SCR_WBT_RENTAL_TYPE_2 )
    _BMPMENU_MAKE_LIST( msg_wbt_menu_lot_03, SCR_WBT_RENTAL_TYPE_3 )
    _BMPMENU_START()

    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_18, SCWK_TARGET_OBJID, POS_DL )
    _MSGWIN_CLOSE()
    //レンタル用の手持ち生成
    _WBT_SETUP_RENTAL_PARTY( SCWK_ANSWER )
  ELSE
    //トーナメントに参加するポケモンを選択してください
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_15, SCWK_TARGET_OBJID, POS_DL )
    _MSGWIN_CLOSE()
  ENDIF

  //回復処理
  _TEMOTI_POKEMON_KAIFUKU()

//ポケモン選択画面表示　　　　　　　　　　　　　　　　　　　　　　　　
  _WBT_SELECT_POKEMON( SCWK_ANSWER )

  IF $SCWK_ANSWER == FALSE THEN
    //キャンセルした場合は何もせずに戻る
    _RET
  ENDIF

  //2011.12.28 ポケモン選択画面でのチェックと同じなのでチェックを削除。
  //キャンセルしていなければLWK_CHK_RULEをTRUEにして返すように変更
  $LWK_CHK_RULE = TRUE
////ルールと適用しているかチェック　
//_WBT_CHECK_BATTLE_RULE( LWK_CHK_RULE )
//
//IF $LWK_CHK_RULE == TRUE THEN
////問題なしの場合
//
//ELSE
////問題ありの場合
//
//	//参加するポケモンに問題があるようです
//	_BALLOONWIN_OBJMSG_POS( msg_wbt_info_error1, SCWK_TARGET_OBJID, POS_DL )
//	_LAST_KEYWAIT()
//	_MSGWIN_CLOSE()
//
//ENDIF

_RET

/**************************************************************/
//  エントリー→会場へ入場する
/**************************************************************/
ev_enter_hall:
  //フェスミッション強制終了
  _FMISSION_END_FORCE()

  //地方トーナメント解除チェック：カントーだけでチェック
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_KANTO, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_notice_01, SCWK_TARGET_OBJID, POS_DL )
  ENDIF
  //ワールドリーダーズ解除チェック
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_WORLD, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_notice_02, SCWK_TARGET_OBJID, POS_DL )
  ENDIF
  //チャンピオン解除チェック
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_CHAMPION, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_notice_03, SCWK_TARGET_OBJID, POS_DL )
  ENDIF
  //レンタルマスター解除チェック
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_RENTALMASTER, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_notice_04, SCWK_TARGET_OBJID, POS_DL )
  ENDIF
  //ミックスマスター解除チェック
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_MIXMASTER, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_notice_05, SCWK_TARGET_OBJID, POS_DL )
  ENDIF

	//参加受付が終わりました！
	_BALLOONWIN_OBJMSG_POS( msg_wbt_info_17, SCWK_TARGET_OBJID, POS_DL )
	_MSGWIN_CLOSE()

  _WBT_GET_RECEPTION_ID( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_WBT_RECEPTION1 THEN
    _OBJ_ANIME( SCWK_TARGET_OBJID, anm_infowoman_l_move )
    _OBJ_ANIME_WAIT()
  ELSE
    _OBJ_ANIME( SCWK_TARGET_OBJID, anm_infowoman_r_move )
    _OBJ_ANIME_WAIT()
  ENDIF

	//誘導アニメ
	//会場へマップ移動
	
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_enter )
  _MAP_FADE_BLACK_OUT_SLOW()
  _OBJ_ANIME_WAIT()
  _MAP_FADE_END_CHECK()
  _MAP_CHANGE_NO_FADE( ZONE_ID_D05R0201, 31, 0, 15, DIR_LEFT )

	//リザーブスクリプト－会場－
	
  _RESERVE_SCRIPT( SCRID_WBT_HALL_01 )

  //ジョインアベニュー：WBTに参加した状態を通知
  _RESORT_SET_RECORD( RESORT_RECORD_ID_WBT )
  //ビーコン：WBTへの参戦を通知
  _BEACON_SET_REQ_WBT_ENTRY( LWK_WBT_SELECT_TOURNAMENT )
  _RET

//--------------------------------------------------------------------
//  受付嬢    プレイヤーに道をあけるアニメ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_infowoman_l_move
  _ANIME_DATA  AC_WALK_U_8F, 1
  _ANIME_DATA  AC_WALK_R_8F, 1
  _ANIME_DATA  AC_STAY_WALK_L_8F,1
  _ANIME_DATA  ACMD_END, 0

//--------------------------------------------------------------------
//  受付嬢    プレイヤーに道をあけるアニメ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_infowoman_r_move
  _ANIME_DATA  AC_WALK_U_8F, 1
  _ANIME_DATA  AC_WALK_L_8F, 1
  _ANIME_DATA  AC_STAY_WALK_R_8F,1
  _ANIME_DATA  ACMD_END, 0

//--------------------------------------------------------------------
//  プレイヤー　WBT会場へ入っていくアニメ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_enter
  _ANIME_DATA  AC_WALK_U_8F,5
  _ANIME_DATA  ACMD_END, 0

/**************************************************************/
/*		トーナメントの説明									  */
/**************************************************************/
ev_explain:

//どのトーナメントについて説明をいたしましょうか？
_BALLOONWIN_OBJMSG_POS( msg_wbt_info_03, SCWK_TARGET_OBJID, POS_DL )

//BMPMENU表示
_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

_BMPMENU_MAKE_LIST( msg_wbt_menu_explain_rule, 100 )	//バトルルールについて

//トーナメント選択・説明選択共通の選択肢生成処理
_CALL sub_make_tournament_list

_BMPMENU_MAKE_LIST( msg_wbt_menu_back, SCR_WBT_CUP_NULL )			//もどる

//メニュー表示
_BMPMENU_START()

	//選択結果で分岐
	SWITCH $LWK_MENU
	CASE 100 THEN		//バトルルールについて
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_rule, SCWK_TARGET_OBJID, POS_DL )

  CASE SCR_WBT_CUP_HODOMOE, SCR_WBT_CUP_HODOMOE_EVENT THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_hodomoe, SCWK_TARGET_OBJID, POS_DL )

  CASE SCR_WBT_CUP_ISSYU THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_issyu, SCWK_TARGET_OBJID, POS_DL )

  CASE SCR_WBT_CUP_KANTO THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_kanto, SCWK_TARGET_OBJID, POS_DL )

  CASE SCR_WBT_CUP_JOUTO THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_jouto, SCWK_TARGET_OBJID, POS_DL )

  CASE SCR_WBT_CUP_HOUEN THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_houen, SCWK_TARGET_OBJID, POS_DL )

  CASE SCR_WBT_CUP_SINOU THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_sinou, SCWK_TARGET_OBJID, POS_DL )

  CASE SCR_WBT_CUP_WORLD THEN
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_world, SCWK_TARGET_OBJID, POS_DL )

	CASE SCR_WBT_CUP_CHAMPION THEN		//チャンピオントーナメント
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_champ, SCWK_TARGET_OBJID, POS_DL )

	CASE SCR_WBT_CUP_RENTALMASTER THEN		//レンタルマスタートーナメント
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_rental_m, SCWK_TARGET_OBJID, POS_DL )

	CASE SCR_WBT_CUP_MIXMASTER THEN		//ミックスマスタートーナメント
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_mix_m, SCWK_TARGET_OBJID, POS_DL )

	CASE SCR_WBT_CUP_POKETYPE THEN		//タイプエキスパートトーナメント
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_poketype, SCWK_TARGET_OBJID, POS_DL )

	CASE SCR_WBT_CUP_RENTAL THEN		//レンタルトーナメント
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_rental, SCWK_TARGET_OBJID, POS_DL )

	CASE SCR_WBT_CUP_MIX THEN		//ミックストーナメント
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_mix, SCWK_TARGET_OBJID, POS_DL )

	CASE SCR_WBT_CUP_DOWNLOAD THEN		//ダウンロードトーナメント
		_BALLOONWIN_OBJMSG_POS( msg_wbt_info_explain_download, SCWK_TARGET_OBJID, POS_DL )

	DEFAULT			//もどる・Bボタン

		$LWK_MENU_WHILE = 1

	ENDSWITCH

_RET

/**************************************************************/
/*		タイプトーナメントの参加							  */
/**************************************************************/
ev_select_poketype:

//どのタイプのトーナメントに参加しますか？
_BALLOONWIN_OBJMSG_POS( msg_wbt_info_12, SCWK_TARGET_OBJID, POS_DL )

//BMPMENU表示
_BMPMENU_INIT_RIGHT( MENU_X1,MENU_Y1,0,1,LWK_MENU )

_BMPMENU_MAKE_LIST( msg_wbt_menu_normal, POKETYPE_NORMAL )	//ノーマル
_BMPMENU_MAKE_LIST( msg_wbt_menu_honoo, POKETYPE_HONOO )		//ほのお
_BMPMENU_MAKE_LIST( msg_wbt_menu_mizu, POKETYPE_MIZU )		//みず
_BMPMENU_MAKE_LIST( msg_wbt_menu_kusa, POKETYPE_KUSA )		//くさ
_BMPMENU_MAKE_LIST( msg_wbt_menu_denki, POKETYPE_DENKI )		//でんき
_BMPMENU_MAKE_LIST( msg_wbt_menu_koori, POKETYPE_KOORI )		//こおり
_BMPMENU_MAKE_LIST( msg_wbt_menu_kakutou, POKETYPE_KAKUTOU )	//かくとう
_BMPMENU_MAKE_LIST( msg_wbt_menu_doku, POKETYPE_DOKU )		//どく
_BMPMENU_MAKE_LIST( msg_wbt_menu_zimen, POKETYPE_JIMEN )		//じめん
_BMPMENU_MAKE_LIST( msg_wbt_menu_hikou, POKETYPE_HIKOU )		//ひこう
_BMPMENU_MAKE_LIST( msg_wbt_menu_esper, POKETYPE_ESPER )	//エスパー
_BMPMENU_MAKE_LIST( msg_wbt_menu_musi, POKETYPE_MUSHI )		//むし
_BMPMENU_MAKE_LIST( msg_wbt_menu_iwa, POKETYPE_IWA )		//いわ
_BMPMENU_MAKE_LIST( msg_wbt_menu_gorst, POKETYPE_GHOST )	//ゴースト
_BMPMENU_MAKE_LIST( msg_wbt_menu_dragon, POKETYPE_DRAGON )	//ドラゴン
_BMPMENU_MAKE_LIST( msg_wbt_menu_aku, POKETYPE_AKU )		//あく
_BMPMENU_MAKE_LIST( msg_wbt_menu_hagane, POKETYPE_HAGANE )	//はがね
_BMPMENU_MAKE_LIST( msg_wbt_menu_back, POKETYPE_NULL )		//もどる

//メニュー表示
_BMPMENU_START()

IF $LWK_MENU == EV_WIN_B_CANCEL THEN
  $LWK_MENU = POKETYPE_NULL
ENDIF
_RET

/**************************************************************/
/*		ダウンロードトーナメントの参加						  */
/**************************************************************/
ev_select_download:

//ダウンロードトーナメント数を取得する
_WBT_GET_DL_COUNT( LWK_DL_COUNT )

//１つもダウンロードしていない場合
IF $LWK_DL_COUNT == 0 THEN

	//お客様が参加できるトーナメントがないみたいです
	_BALLOONWIN_OBJMSG_POS( msg_wbt_info_14_01, SCWK_TARGET_OBJID, POS_DL )
	//_LAST_KEYWAIT()
	//_MSGWIN_CLOSE()

//１つ以上ダウンロードしている場合
ELSE

	//参加できるトーナメントはこちらになります
	_BALLOONWIN_OBJMSG_POS( msg_wbt_info_14, SCWK_TARGET_OBJID, POS_DL )
  _MSGWIN_CLOSE()

  _WBT_SELECT_DL_DATA( SCWK_ANSWER, LWK_WBT_SELECT_DL )

ENDIF

_RET

/********************************************************************/
//
//        WBT終了後
//
/********************************************************************/
EVENT_START	ev_reserve_wbt_exit

  _WBT_GET_RECEPTION_ID( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_WBT_RECEPTION1 THEN
    $SCWK_TARGET_OBJID = D05R0101_INFOMATIONW_01
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_l_exit )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( SCWK_TARGET_OBJID, anm_infowoman_l_return )
    _OBJ_ANIME_WAIT()
  ELSIF $SCWK_ANSWER == SCR_WBT_RECEPTION2 THEN
    $SCWK_TARGET_OBJID = D05R0101_INFOMATIONW_02
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_r_exit )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( SCWK_TARGET_OBJID, anm_infowoman_r_return )
    _OBJ_ANIME_WAIT()
  ENDIF

  _WBT_SYSTEM_GET_STAGE( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WBT_STAGE_1ST THEN
    //初戦敗退
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_20, SCWK_TARGET_OBJID, POS_DL )
    _CALL ev_wbt_get_sourvenir

  CASE SCR_WBT_STAGE_2ND THEN
    //1回戦突破
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_21, SCWK_TARGET_OBJID, POS_DL )
    _CALL ev_wbt_get_sourvenir

  CASE SCR_WBT_STAGE_FINAL THEN
    //準優勝
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_22, SCWK_TARGET_OBJID, POS_DL )
    _CALL ev_wbt_get_sourvenir

  CASE SCR_WBT_STAGE_WIN THEN
    //優勝おめでとうございます！
    _WBT_GET_WBT_CUP( LWK_WBT_SELECT_TOURNAMENT )
    _WBT_SET_TOURNAMENT_NAME( 0, LWK_WBT_SELECT_TOURNAMENT )
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_23, SCWK_TARGET_OBJID, POS_DL )

    _CALL ev_wbt_get_reward

    _CALL ev_wbt_unlock_tournament

    //優勝回数をカウントアップ
    _WBT_INC_VICTORY_COUNT()

  ENDSWITCH

  //念のため
  _BALLOONWIN_OBJMSG_POS( msg_wbt_info_04, SCWK_TARGET_OBJID, POS_DL )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

	//WBTシステム終了
	_WBT_SYSTEM_END() //_WBT_SYSTEM_STARTと対
  
  IF $LWK_WBT_SELECT_TOURNAMENT == SCR_WBT_CUP_HODOMOE_EVENT THEN
    //WBTチュートリアルイベント後半へ
    _RESERVE_SCRIPT( SCRID_RESERVE_D05R0101_TUTORIAL_02 )
  ENDIF
EVENT_END

//--------------------------------------------------------------------
//  プレイヤー　WBT終了後
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_l_exit
  _ANIME_DATA AC_WALK_D_8F,7
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_player_r_exit
  _ANIME_DATA AC_WALK_D_8F,7
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_infowoman_l_return
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END, 0

_ANIME_LABEL  anm_infowoman_r_return
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END, 0



ev_wbt_get_reward:
  //ご褒美取得処理
  _WBT_GET_REWARD( SCWK_ANSWER )
  IF $SCWK_ANSWER != 0 THEN
    //優勝の褒美
    _PLAYER_NAME( 0 )
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_26, SCWK_TARGET_OBJID, POS_DL )
    _MSGWIN_CLOSE()

    _PLAYER_NAME( 0 )
    _NUMBER( 1, SCWK_ANSWER, 2 )
    _SYSWIN_MSG( msg_wbt_info_27, POS_DOWN )
    _ME_PLAY( SEQ_ME_BPGET )
    _ME_WAIT()
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
  ENDIF
  _RET

ev_wbt_get_sourvenir:
  _BALLOONWIN_OBJMSG_POS( msg_wbt_info_28, SCWK_TARGET_OBJID, POS_DL )
  _MSGWIN_CLOSE()
  //残念賞取得処理
  _GET_RND( SCWK_ANSWER, 4 )
  SWITCH $SCWK_ANSWER
  CASE 0 THEN
    $SCWK_ANSWER = ITEM_AKAIKAKERA
  CASE 1 THEN
    $SCWK_ANSWER = ITEM_AOIKAKERA
  CASE 2 THEN
    $SCWK_ANSWER = ITEM_KIIROIKAKERA
  CASE 3 THEN
    $SCWK_ANSWER = ITEM_MIDORINOKAKERA
  ENDSWITCH
  _ITEM_EVENT_KEYWAIT( SCWK_ANSWER, 1 )
  _RET

ev_wbt_unlock_tournament:
  IF $LWK_WBT_SELECT_TOURNAMENT == SCR_WBT_CUP_DOWNLOAD THEN
    //ダウンロードの場合は何もしない
    _RET
  ENDIF

  //WBT関連のメダル達成チェック

  //タイプトーナメント全部の達成チェック
  //スクリプトで記述するロジックとしては複雑なので触らないこと！！！
  IF $LWK_WBT_SELECT_TOURNAMENT == SCR_WBT_CUP_POKETYPE THEN
  {
    DEFINE_LOCAL  LWK_POKETYPE
    DEFINE_LOCAL  LWK_LOOP
    DEFINE_LOCAL  LWK_RESULT
    _WBT_GET_TOURNAMENT_POKETYPE( LWK_POKETYPE )

    $LWK_LOOP = POKETYPE_NORMAL   // == 0
    $LWK_RESULT = TRUE

    WHILE $LWK_LOOP != POKETYPE_NULL && $LWK_RESULT == TRUE
      //_DEBUG_PRINT_WK( 1000 )
      _WBT_GET_VICTORY_COUNT( SCR_WBT_CUP_POKETYPE, LWK_LOOP, SCWK_ANSWER )
      //_DEBUG_PRINT_WK( LWK_LOOP )
      //_DEBUG_PRINT_WK( SCWK_ANSWER )
      IF $LWK_LOOP == $LWK_POKETYPE THEN
        //今回のタイプで初回優勝でなければNG
        IF $SCWK_ANSWER != 0 THEN
          //_DEBUG_PRINT_WK( 1001 )
          $LWK_RESULT = FALSE
        ENDIF
      ELSE
        //今回のタイプ以外で優勝していなければNG
        IF $SCWK_ANSWER == 0 THEN
          //_DEBUG_PRINT_WK( 1002 )
          $LWK_RESULT = FALSE
        ENDIF
      ENDIF
      $LWK_LOOP += 1
    ENDWHILE
    IF $LWK_RESULT == TRUE THEN
          //_DEBUG_PRINT_WK( 1003 )
      _SET_MEDAL_ACHIVE( MDLID_WBT_TYPE_ALL )    //タイプ全部メダル達成
    ENDIF
  }
  ENDIF

  _WBT_GET_VICTORY_COUNT( LWK_WBT_SELECT_TOURNAMENT, POKETYPE_NULL, SCWK_ANSWER )
  IF $SCWK_ANSWER == 0 THEN
    SWITCH $LWK_WBT_SELECT_TOURNAMENT
    CASE SCR_WBT_CUP_HODOMOE, SCR_WBT_CUP_HODOMOE_EVENT THEN
      _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_RENTAL )     //レンタルメダル　ヒント開示
      _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_MIX )        //ミックスメダル　ヒント開示
      _SET_MEDAL_ACHIVE( MDLID_WBT_HODOMOE )    //ホドモエメダル達成
    CASE SCR_WBT_CUP_RENTAL THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_RENTAL )   //レンタルメダル達成
    CASE SCR_WBT_CUP_MIX THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_MIX )    //ミックスメダル達成
    CASE SCR_WBT_CUP_ISSYU THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_ISSHU )  //イッシュメダル達成
    CASE SCR_WBT_CUP_KANTO THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_KANTO )  //カントーメダル達成
    CASE SCR_WBT_CUP_JOUTO THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_JOUTO )  //ジョウトメダル達成
    CASE SCR_WBT_CUP_HOUEN THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_HOUEN )  //ホウエンメダル達成
    CASE SCR_WBT_CUP_SINOU THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_SHINNOU )  //シンオウメダル達成
    CASE SCR_WBT_CUP_WORLD THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_LEADER )  //ワールドリーダーズメダル達成
    CASE SCR_WBT_CUP_CHAMPION THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_CHAMPION )  //チャンピオンメダル達成
    CASE SCR_WBT_CUP_RENTALMASTER THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_RENTAL_MASTER )  //レンタルマスターメダル達成
    CASE SCR_WBT_CUP_MIXMASTER THEN
      _SET_MEDAL_ACHIVE( MDLID_WBT_MIX_MASTER )  //ミックスマスターメダル達成
    ENDSWITCH
  ENDIF


  //地方トーナメント解禁チェック
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_KANTO, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_KANTO ) //カントーメダル　ヒント開示
    _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_JOUTO ) //ジョウトメダル　ヒント開示
    _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_HOUEN ) //ホウエンメダル　ヒント開示
    _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_SHINNOU ) //シンオウメダル　ヒント開示
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_11, SCWK_TARGET_OBJID, POS_DL )
  ENDIF

  //ワールド
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_WORLD, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_LEADER ) //ワールドリーダーズメダル　ヒント開示
    _WBT_SET_TOURNAMENT_NAME( 0, SCR_WBT_CUP_WORLD )
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_24, SCWK_TARGET_OBJID, POS_DL )
  ENDIF
  
  //レンタルマスター
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_RENTALMASTER, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_RENTAL_MASTER ) //レンタルマスターメダル　ヒント開示
    _WBT_SET_TOURNAMENT_NAME( 0, SCR_WBT_CUP_RENTALMASTER )
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_24, SCWK_TARGET_OBJID, POS_DL )
  ENDIF

  //ミックスマスター
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_MIXMASTER, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_MIX_MASTER ) //ミックスマスターメダル　ヒント開示
    _WBT_SET_TOURNAMENT_NAME( 0, SCR_WBT_CUP_MIXMASTER )
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_24, SCWK_TARGET_OBJID, POS_DL )
  ENDIF

  //タイプエキスパート
  _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_POKETYPE, SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_TYPE_ALL ) //タイプメダル全部　ヒント開示
    _WBT_SET_TOURNAMENT_NAME( 0, SCR_WBT_CUP_POKETYPE )
    _BALLOONWIN_OBJMSG_POS( msg_wbt_info_24, SCWK_TARGET_OBJID, POS_DL )
  ENDIF
    
  //チャンピオントーナメント
  _WBT_CHECK_CUP_ENABLE( SCR_WBT_CUP_CHAMPION, SCWK_ANSWER )
  IF $SCWK_ANSWER == FALSE && $LWK_WBT_SELECT_TOURNAMENT == SCR_WBT_CUP_WORLD THEN
    _WBT_CHECK_CUP_UNLOCK( SCR_WBT_CUP_CHAMPION, SCWK_ANSWER )
    IF $SCWK_ANSWER == TRUE THEN
      _SET_MEDAL_HINT_ACHIEVE( MDLID_WBT_CHAMPION ) //チャンピオンメダル  ヒント開示
      _WBT_SET_TOURNAMENT_NAME( 0, SCR_WBT_CUP_CHAMPION )
      _BALLOONWIN_OBJMSG_POS( msg_wbt_info_24, SCWK_TARGET_OBJID, POS_DL )
    ELSE
      _WBT_GET_VICTORY_COUNT( SCR_WBT_CUP_WORLD, POKETYPE_NULL, SCWK_ANSWER )
      $LWK_TEMP = 9  //この時点では優勝回数を更新していないので10から-1して計算する
      $LWK_TEMP -= $SCWK_ANSWER
      _NUMBER( 0, LWK_TEMP, 2 )
      _BALLOONWIN_OBJMSG_POS( msg_wbt_info_25, SCWK_TARGET_OBJID, POS_DL )
    ENDIF
  ENDIF

  _RET



//======================================================================
//
//
//      WBTエントリーチェッカー
//
//
//======================================================================
/********************************************************************/
//
//      WBTエントリーチェッカー本体
//
/********************************************************************/
DEFINE_LOCAL  LOG_OUT
DEFINE_LOCAL  LWK_SELECT_POS

EVENT_START ev_wbt_entry_checker

  _TALK_START_SE_PLAY()

  $LOG_OUT = FALSE

  WHILE $LOG_OUT == FALSE
    _SYSWIN_MSG( msg_wbt_pc_blank, POS_DOWN )
    _BMPMENU_INIT_RIGHT( MENU_X1, MENU_Y1, 0, TRUE, LWK_SELECT_POS )
    _BMPMENU_MAKE_LIST_EX( msg_wbt_pc_menu_01, msg_wbt_pc_info_01, msg_wbt_pc_menu_01 )//優勝記録
    _BMPMENU_MAKE_LIST_EX( msg_wbt_pc_menu_02, msg_wbt_pc_info_02, msg_wbt_pc_menu_02 )//ダウンロード
    _BMPMENU_MAKE_LIST_EX( msg_wbt_pc_menu_03, msg_wbt_pc_info_03, msg_wbt_pc_menu_03 )//やめる
    _BMPMENU_START()

    _TIME_WAIT(3) //なんとなくPCのまねをしてSE待ち

    SWITCH $LWK_SELECT_POS
    CASE msg_wbt_pc_menu_01 THEN
      _CALL ev_victory_checker

    CASE msg_wbt_pc_menu_02 THEN
      _REPORT_EVENT_CALL( SCWK_ANSWER )
      IF $SCWK_ANSWER == SCR_REPORT_OK THEN
        _CALL ev_downloader
      ENDIF

    DEFAULT
      _SYSWIN_CLOSE()
      $LOG_OUT = TRUE
    ENDSWITCH

  ENDWHILE

EVENT_END

/********************************************************************/
//
//  優勝記録確認画面
//
/********************************************************************/
ev_victory_checker:
  _SYSWIN_MSG( msg_wbt_pc_select_01, POS_DOWN )
  _SYSWIN_CLOSE()
  _WBT_ENTRY_CHECKER_VICTORY_RECORD( SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    $LOG_OUT = TRUE
  ENDIF
  _RET

/********************************************************************/
//
//  ダウンロード
//
/********************************************************************/
ev_downloader:
  _SYSWIN_MSG( msg_wbt_pc_select_02, POS_DOWN )
  _SYSWIN_CLOSE()
  _WBT_ENTRY_CHECKER_DOWNLOAD( SCR_WBT_DL_APP_WIFI,     SCWK_ANSWER )
  IF $SCWK_ANSWER == TRUE THEN
    $LOG_OUT = TRUE
  ENDIF
  _RET


