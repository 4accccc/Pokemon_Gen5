//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_d27r1001
_EVENT_DATA    ev_init_d27r1001
_EVENT_DATA    ev_recover_d27r1001
_EVENT_DATA    ev_pos_d27r1001_warp_01
_EVENT_DATA    ev_pos_d27r1001_warp_02
_EVENT_DATA    ev_pos_d27r1001_warp_03
_EVENT_DATA    ev_pos_d27r1001_button_01
_EVENT_DATA    ev_pos_d27r1001_button_02
_EVENT_DATA    ev_pos_d27r1001_button_03
_EVENT_DATA    ev_pos_d27r1001_button_04
_EVENT_DATA    ev_pos_d27r1001_barrier_01
_EVENT_DATA    ev_bg_d27r1001_pass_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//																	//
//	特殊な接続に LOCALWORK15 を使用しています。     //
//	同マップ内の使用を禁止します。									//
//  
//
//	LOCALWORK0 ～ LOCALWORK3 をギミックの制御に使用しています。		  //
//    0 = POSイベント有効
//  ボタン1 : LOCALWORK0
//  ボタン2 : LOCALWORK1
//  ボタン3 : LOCALWORK2
//  ボタン4 : LOCALWORK3
//
//------------------------------------------------------------------//

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*					ZONE_CHANGE_LABEL 						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r1001
  //
INIT_EVENT_END
/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r1001

  // ゲート状態設定
  _CALL sub_gate_set

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r1001

  // ゲート状態設定
  _CALL sub_gate_set

INIT_EVENT_END

// ゲート(バリアー)の状態をフラグを見て設定
sub_gate_set:
{
//パスワード解除済みならゲートを開放
  IF $WK_SCENE_D27R1001_BARRIER_01 == 1 THEN
    _HIDE_SHIP_GATE_SET( 0, 1 )
    _HIDE_SHIP_GATE_SET( 1, 1 )
    _HIDE_SHIP_GATE_SET( 2, 1 )
    _HIDE_SHIP_GATE_SET( 3, 1 )
  ENDIF
}
_RET

/************************************************************/
/*					特殊接続（船首楼）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1001_warp_01
  
  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //ワープ処理
  _MAP_CHANGE_WARP( ZONE_ID_D27R0301, 11, 5, LWK_DIR )

EVENT_END

/************************************************************/
/*					特殊接続（ブリッジ）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1001_warp_02
  
  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //ワープ処理
  _MAP_CHANGE_WARP( ZONE_ID_D27R0401, 7, 15, LWK_DIR )

EVENT_END

/************************************************************/
/*					特殊接続（ゲーチス部屋）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1001_warp_03
  
  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )

  //ワープ処理
  _MAP_CHANGE_WARP( ZONE_ID_D27R0601, 8, 9, LWK_DIR )

EVENT_END

/************************************************************/
/*						ボタン1(左上)					*/
/************************************************************/
EVENT_START ev_pos_d27r1001_button_01

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK0 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK1 = 0
  $LOCALWORK2 = 0
  $LOCALWORK3 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 0 )

EVENT_END
/************************************************************/
/*						ボタン2(左下)					*/
/************************************************************/
EVENT_START ev_pos_d27r1001_button_02

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK1 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK0 = 0
  $LOCALWORK2 = 0
  $LOCALWORK3 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 1 )

EVENT_END
/************************************************************/
/*						ボタン3(右上)					*/
/************************************************************/
EVENT_START ev_pos_d27r1001_button_03

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK2 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK0 = 0
  $LOCALWORK1 = 0
  $LOCALWORK3 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 2 )

EVENT_END
/************************************************************/
/*						ボタン4(右下)					*/
/************************************************************/
EVENT_START ev_pos_d27r1001_button_04

  //=====================================
  //このPOSの起動をさせなくする
  $LOCALWORK3 = 1
  //=====================================

  //=====================================
  //他のPOSは起動できるようにする
  $LOCALWORK0 = 0
  $LOCALWORK1 = 0
  $LOCALWORK2 = 0
  //=====================================

  // ボタンを押下 = パイプ動作
  _HIDE_SHIP_BUTTON( 3 )

EVENT_END

/************************************************************/
/*				  BG：パスワード				*/
/************************************************************/
EVENT_START ev_bg_d27r1001_pass_01
{
  _TALK_START_SE_PLAY()
  IF FLAG_OFF( FE_D27_CARDKEY_01 ) THEN
    
    //カードキーがひつよう　そうだ
    _SYSWIN_MSG( msg_d27r1001_pass_01 , POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  //カードキー所持・未開放
  ELSIF $WK_SCENE_D27R1001_BARRIER_01 == 0 THEN
    
    //【仮】デバッグ用
    _HIDE_SHIP_PASSWORD_ID_GET( LOCALWORK15 )
    _DEBUG_PRINT_WK( LOCALWORK15 )
    
    //パスワードを入れますか？
    _SYSWIN_MSG( msg_d27r1001_pass_02 , POS_DOWN )
    _YES_NO_WIN( SCWK_ANSWER )
    
    //はい
    IF $SCWK_ANSWER == SCR_YES THEN
      _MSGWIN_CLOSE()
    
      //パスワード返り値
      DEFINE_LOCAL  LCW_PASSRESULT
      
      _HIDE_SHIP_PASSWORD_INPUT( LCW_PASSRESULT )
      
      //正解
      IF $LCW_PASSRESULT == TRUE THEN
        
        //バリアが解除された！
        _SYSWIN_MSG( msg_d27r1001_switch_01 , POS_DOWN )
        _AB_KEYWAIT_MARK()
        _MSGWIN_CLOSE()
        
        //バリア解除処理
        _HIDE_SHIP_GATE_OFF( 3 )
        _TIME_WAIT(8)
        _HIDE_SHIP_GATE_OFF( 2 )
        _TIME_WAIT(8)
        _HIDE_SHIP_GATE_OFF( 1 )
        _TIME_WAIT(8)
        _HIDE_SHIP_GATE_OFF( 0 )
        
        //すべてのバリアが解除され
        _SYSWIN_MSG( msg_d27r1001_switch_02 , POS_DOWN )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
        
        //========================================//
        //バリアーPOS無効
        $WK_SCENE_D27R1001_BARRIER_01 = 1
        //パスワード終了
        _FLAG_SET(FE_D27_PASSOPEN_01)
        //========================================//
      
      //不正解
      ELSE
        
        _SYSWIN_MSG( msg_d27r1001_pass_03 , POS_DOWN )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
        
      ENDIF
      
    ENDIF
  
  //パスワード開放後
  ELSE
    //すべてのバリアが解除され
    _SYSWIN_MSG( msg_d27r1001_switch_02 , POS_DOWN )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
}
EVENT_END

/************************************************************/
/*					バリア演出				*/
/************************************************************/
EVENT_START ev_pos_d27r1001_barrier_01
  
  //アニメ：「！」
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_01 )
  _OBJ_ANIME_WAIT()
  
  //ビリビリSE再生
  _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_08 )
  
  //アニメ：下方向に移動
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_player_barrier_02 )
  _OBJ_ANIME_WAIT()
  
  _SE_WAIT()
  
  
EVENT_END

