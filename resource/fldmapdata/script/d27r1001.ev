_EVENT_DATA_END

//------------------------------注意--------------------------------//
//																	//
//	特殊な接続に LOCALWORK15 を使用しています。     //
//	デバッグ情報に LOCALWORK10 を使用しています。     //
//	同マップ内の使用を禁止します。									//
//  
//
//	LOCALWORK0 ～ LOCALWORK3 をギミックの制御に使用しています。		  //
//    0 = POSイベント有効
//  ボタン1 : LOCALWORK0
//  ボタン2 : LOCALWORK1
//  ボタン3 : LOCALWORK2
//  ボタン4 : LOCALWORK3
//
//------------------------------------------------------------------//

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*					ZONE_CHANGE_LABEL 						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r1001
  IF $WK_SCENE_D27R0601_SWSAGE1_01 == 4 THEN
    //D27R0601（隠し部屋）イベントを終えていたら元プラズマ団員を非表示に
   _FLAG_SET( FV_D27R1001_SWPLAZMAM_01 )
  ENDIF
INIT_EVENT_END
/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r1001
  
  IF $WK_SCENE_D27R0601_SWSAGE1_01 < 2 && $WK_SCENE_D27R1001_SWSAGE7_01 == 1 THEN
    _OBJ_POS_CHANGE(D27R1001_SWSAGE7_01,15,0,16,DIR_UP)
  ENDIF

  // ゲート状態設定
  _CALL sub_gate_set

INIT_EVENT_END
/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r1001

  // ゲート状態設定
  _CALL sub_gate_set

INIT_EVENT_END

// ゲート(バリアー)の状態をフラグを見て設定
sub_gate_set:
{
//パスワード解除済みならゲートを開放
  IF $WK_SCENE_D27R1001_BARRIER_01 == 1 THEN
    _HIDE_SHIP_GATE_SET( 0, 1 )
    _HIDE_SHIP_GATE_SET( 1, 1 )
    _HIDE_SHIP_GATE_SET( 2, 1 )
    _HIDE_SHIP_GATE_SET( 3, 1 )
  ENDIF
}
_RET

/************************************************************/
/*					SCENE_CHANGE：元プラズマ団				*/
/************************************************************/
EVENT_START	ev_scene_d27r1001_plazmam_01

  //アニメ：「！」
  _OBJ_ANIME( D27R1001_SWPLAZMAM_01, anm_common_gyoe )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //アニメ：元プラズマ団員接近
  _OBJ_ANIME( D27R1001_SWPLAZMAM_01 ,anm_walk_l )
  _OBJ_ANIME_WAIT()
  
  //元プラズマ団員：おっと！
  _BALLOONWIN_OBJMSG_POS( msg_d27r1001_swplazmam1_02_01 , D27R1001_SWPLAZMAM_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：元プラズマ団員下を見る
  _OBJ_ANIME( D27R1001_SWPLAZMAM_01 ,anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //元プラズマ団員：ロット様に
  _BALLOONWIN_OBJMSG_POS( msg_d27r1001_swplazmam1_02_02 , D27R1001_SWPLAZMAM_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：元プラズマ団員主人公を見る
  _OBJ_ANIME( D27R1001_SWPLAZMAM_01 ,anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //元プラズマ団員：ああ！
  _BALLOONWIN_OBJMSG_POS( msg_d27r1001_swplazmam1_02_03 , D27R1001_SWPLAZMAM_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //=====================================
  //D27R1001 SCENE_CHANGE無効
  $WK_SCENE_D27R1001_PLAZMAM_01 = 2
  //=====================================
EVENT_END

/************************************************************/
/*					話しかけ：元プラズマ団				*/
/************************************************************/
EVENT_START	ev_d27r1001_swplazmam_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r1001_swplazmam1_02_04 )
EVENT_END

/************************************************************/
/*					話しかけ：ヴィオ				*/
/************************************************************/
EVENT_START	ev_d27r1001_swsage7_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_sage7_03_02 )
EVENT_END

/************************************************************/
/*					POS：ヴィオ戦				*/
/************************************************************/
EVENT_START	ev_pos_d27r1001_swsage7_01
  
  //=====================================
  //ヴィオ表示
  _FLAG_RESET( FV_D27R1001_SWSAGE7_01 )
  //=====================================
  
  //カメラ操作　キュレム追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  //カメラ操作
  _CAMERA_MOVE( 9688,0,970752,1015808,0,716800,28 )
  _CAMERA_WAIT_MOVE()
  
  //メッセージ：そのそうちは
  _PLAINWIN_MSG_DOWN( msg_d27r0101_sage7_03_01 )
  _MSGWIN_CLOSE()
  
  //ヴィオ動作モデル生成
  _OBJ_ADD( D27R1001_SWSAGE7_01 )
  
  //イベント曲再生
  _START_TEMP_EVENT_BGM( SEQ_BGM_E_7_SAGE )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  $LCW_POSZ += 2
  //アニメ：ヴィオ登場
  _OBJ_ANIME_AUTO( D27R1001_SWSAGE7_01 , LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 16, DIR_LR)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (20)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  _OBJ_ANIME_WAIT()
  
  //ヴィオ：その　そうちは
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_03_03 , D27R1001_SWSAGE7_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //トレーナー戦
  _TRAINER_BTL_SET( TRID_SWSAGE3_02, 0 )
  
  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
  ELSE
    //=====================================
    //ヴィオ非表示
    _FLAG_SET( FV_D27R1001_SWSAGE7_01 )
    //=====================================
    _TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF
  
  //アニメ：ヴィオ後退
  _OBJ_ANIME( D27R1001_SWSAGE7_01 , anm_swsage7_backstep)
  _OBJ_ANIME_WAIT()
  
  //ヴィオ：むうう！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_sage7_03_02 , D27R1001_SWSAGE7_01 ,POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //=====================================
  //D27R1001 POS無効
  $WK_SCENE_D27R1001_SWSAGE7_01 = 1
  //D27R0401 SCENE_CHANGE有効
  $WK_SCENE_D27R0401_SWBOSS_01 = 1
  //=====================================
  
EVENT_END

//--------------------------------------------------------------------
//	ロット：あとずさる
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swsage7_backstep
  _ANIME_DATA AC_DIR_PAUSE_ON,1
  _ANIME_DATA	AC_WALK_D_16F,1
  _ANIME_DATA AC_DIR_PAUSE_OFF,1
  _ANIME_DATA	ACMD_END,0

/************************************************************/
/*					BG：キュレム前装置				*/
/************************************************************/
EVENT_START	ev_bg_d27r1001_panel_01
  
  _TALK_START_SE_PLAY()
  
  _SYSWIN_MSG( msg_d27r1001_machine1_02_01 , POS_DOWN )
  
  //クリア前の場合キー待ち記号を表示
  IF FLAG_OFF( FV_D27R1001_R1301_POKE10_01 )  THEN
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
  ELSE
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
  
  //クリア前の場合キュレムの鳴き声を再生
  IF FLAG_OFF( FV_D27R1001_R1301_POKE10_01 )  THEN
    _VOICE_PLAY(MONSNO_653,0)
    _PLAINWIN_MSG_DOWN( msg_d27r1001_poke10_02_01 )
    _VOICE_WAIT()
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
  
EVENT_END

/************************************************************/
/*					BG：キュレム前装置				*/
/************************************************************/
EVENT_START	ev_bg_d27r1001_panel_02
  
  _TALK_START_SE_PLAY()
  
  _SYSWIN_MSG( msg_d27r1001_machine2_02_01 , POS_DOWN )
  
  //クリア前の場合キー待ち記号を表示
  IF FLAG_OFF( FV_D27R1001_R1301_POKE10_01 )  THEN
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()
  ELSE
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
  
  //クリア前の場合キュレムの鳴き声を再生
  IF FLAG_OFF( FV_D27R1001_R1301_POKE10_01 )  THEN
    _VOICE_PLAY(MONSNO_653,0)
    _PLAINWIN_MSG_DOWN( msg_d27r1001_poke10_02_01 )
    _VOICE_WAIT()
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
  
EVENT_END

/************************************************************/
/*					POS：ストッパープラズマ団（アクロマ戦前）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1001_stopper_01

  //アニメ：ストッパー「！」
  _OBJ_ANIME( D27R1001_STOPPER_01 , anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D27R1001_STOPPER_01 , anm_staystep_d )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ストッパー
  _BALLOONWIN_OBJMSG_POS( msg_d27r1001_swplazmam_stop_01 , D27R1001_STOPPER_01 ,POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //アニメ：主人公１歩戻る
  _OBJ_ANIME( D27R1001_STOPPER_01 , anm_staystep_r )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_walk_r )
  _OBJ_ANIME_WAIT()
  
EVENT_END

/************************************************************/
/*					POS：ストッパープラズマ団（アクロマ戦後）				*/
/************************************************************/
EVENT_START	ev_pos_d27r1001_stopper_02

  //アニメ：ストッパー「！」
  _OBJ_ANIME( D27R1001_STOPPER_01 , anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D27R1001_STOPPER_01 , anm_staystep_d )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ストッパー
  _BALLOONWIN_OBJMSG_POS( msg_d27r1001_swplazmam_stop_02 , D27R1001_STOPPER_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //退場処理
  _CALL ev_d27_stopper_bye
  
EVENT_END

/************************************************************/
/*					話しかけ：ストッパープラズマ団				*/
/************************************************************/
EVENT_START	ev_d27r1001_stopper_03

  IF $WK_SCENE_D27R10R13_STOPPER == 0 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r1001_swplazmam_stop_01 )
  ELSE
    _TALK_START_SE_PLAY()
    
    //アニメ：ストッパー「！」
    _OBJ_ANIME( D27R1001_STOPPER_01 , anm_common_gyoe )
    _OBJ_ANIME_WAIT()
    
    //ストッパー：じつは
    _BALLOONWIN_OBJMSG_POS( msg_d27r1001_swplazmam_stop_02 , D27R1001_STOPPER_01 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //退場処理
    _CALL ev_d27_stopper_bye
  
  ENDIF
  
EVENT_END

/************************************************************/
/*					CALL：ストッパープラズマ団				*/
/************************************************************/
ev_d27_stopper_bye:

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //アニメ：ストッパー退場
  IF $LCW_POSX == 9 THEN
    _OBJ_ANIME( D27R1001_STOPPER_01 , anm_stopper_bye_x9)
  ELSE
    _OBJ_ANIME_AUTO( D27R1001_STOPPER_01 , 13, 19, FORCE_TYPE_NOT, 4, DIR_LR)
  ENDIF
  _TIME_WAIT(8)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //ストッパー動作モデル削除
  _OBJ_DEL( D27R1001_STOPPER_01 )
  
  //=====================================
  //D27R1301ストッパー削除
  _FLAG_SET( FV_D27R1001_STOPPER_01 )
  //D27R1301 POS無効
  $WK_SCENE_D27R10R13_STOPPER = 2
  //=====================================
  
_RET

//--------------------------------------------------------------------
//	ストッパー：退場x9
//--------------------------------------------------------------------
_ANIME_LABEL	anm_stopper_bye_x9
	_ANIME_DATA	AC_WALK_D_4F,1
	_ANIME_DATA	AC_WALK_R_4F,5
	_ANIME_DATA	AC_WALK_D_4F,7
	_ANIME_DATA	ACMD_END,0

