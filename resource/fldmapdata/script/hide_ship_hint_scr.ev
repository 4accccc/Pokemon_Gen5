/*  プラズマカード入手処理                         */
/**************************************************************/
EVENT_START ev_d27_hint_07
  _TALK_OBJ_START()
  _HIDE_SHIP_PASSWORD_ID_GET( LCWK_PASSID )
  
  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  $LCWK_MSGID = msg_hide_ship_hint7_01
  $LCWK_MSGID += $LCWK_PASSID
  
  //戦闘前
  IF FLAG_OFF( FE_D27_HINT_07 ) THEN

     //B2
     IF $LCWK_VERSION == VERSION_B2 THEN
       _OBJ_ANIME( D27R1001_HINT_07, anm_common_gyoe )
       _OBJ_ANIME_WAIT()
       //トレーナー曲再生
       _TRAINER_BGM_SET(  TRID_SWPLAZMAW_05 )
     //W2
     ELSE
       _OBJ_ANIME( D27R2201_HINT_07, anm_common_gyoe )
       _OBJ_ANIME_WAIT()
       //トレーナー曲再生
       _TRAINER_BGM_SET(  TRID_SWPLAZMAW_07 )
     ENDIF
    
     //戦闘前メッセージ
     _BALLOONWIN_TALKOBJ_MSG( msg_hide_ship_hint7_start )
     _MSGWIN_CLOSE()
     
     //B2
     IF $LCWK_VERSION == VERSION_B2 THEN
       //トレーナー戦呼び出し
       _TRAINER_BTL_SET( TRID_SWPLAZMAW_05, 0 )
     //W2
     ELSE
       //トレーナー戦呼び出し
       _TRAINER_BTL_SET( TRID_SWPLAZMAW_07, 0 )
     ENDIF
     
     //結果チェック
     _CALL ev_battle_check
     
     _BALLOONWIN_TALKOBJ_MSG( LCWK_MSGID )
     _MSGWIN_CLOSE()
     
     //キーカード入手処理
     _ITEM_EVENT_KEYWAIT( ITEM_PURAZUMAKAADO, 1 )
     
     //D27カードキー所持
      _FLAG_SET(FE_D27_CARDKEY_01)
     
     _BALLOONWIN_TALKOBJ_MSG( msg_hide_ship_hint7_05 )
     _LAST_KEYWAIT()
     _MSGWIN_CLOSE()
    
    //========================================//
    //戦闘終了フラグセット
    _FLAG_SET( FE_D27_HINT_07 )
    //========================================//
    
  //戦闘後
  ELSE
    _BALLOONWIN_TALKOBJ_MSG( msg_hide_ship_hint7_05 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  ENDIF
  
EVENT_END

ev_battle_check:	
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
			_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF
_RET

