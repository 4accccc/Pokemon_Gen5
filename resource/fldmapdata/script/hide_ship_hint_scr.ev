/**************************************************************/
/*  ヒント1                         */
/**************************************************************/
EVENT_START ev_d27_hint_01
   _TALK_OBJ_START()
  _HIDE_SHIP_PASSWORD_ID_GET( LCWK_PASSID )
  
  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  $LCWK_MSGID = msg_hide_ship_hint1_01
  $LCWK_MSGID += $LCWK_PASSID
  
  //戦闘前
  IF FLAG_OFF( FE_D27_HINT_01 ) THEN
    
    //B2
    IF $LCWK_VERSION == VERSION_B2 THEN
      _OBJ_ANIME( D27R1001_HINT_01, anm_common_gyoe )
      _OBJ_ANIME_WAIT()
      //トレーナー曲再生
      _TRAINER_BGM_SET(  TRID_SWPLAZMAM_15 )
    //W2
    ELSE
      _OBJ_ANIME( D27R2101_HINT_01, anm_common_gyoe )
      _OBJ_ANIME_WAIT()
      //トレーナー曲再生
      _TRAINER_BGM_SET(  TRID_SWPLAZMAM_22 )
    ENDIF
     
     //戦闘前メッセージ
     _BALLOONWIN_TALKOBJ_MSG( msg_hide_ship_hint1_start )
     _MSGWIN_CLOSE()
     
     //B2
     IF $LCWK_VERSION == VERSION_B2 THEN
       //トレーナー戦呼び出し
       _TRAINER_BTL_SET( TRID_SWPLAZMAM_15, 0 )
     //W2
     ELSE
       //トレーナー戦呼び出し
       _TRAINER_BTL_SET( TRID_SWPLAZMAM_22, 0 )
     ENDIF
     
     //結果チェック
     _CALL ev_battle_check
     
     _BALLOONWIN_TALKOBJ_MSG( LCWK_MSGID )
     _LAST_KEYWAIT()
     _MSGWIN_CLOSE()
    
    //========================================//
    //戦闘終了フラグセット
