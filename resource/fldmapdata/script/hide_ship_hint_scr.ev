_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
DEFINE_LOCAL LCWK_PASSID
DEFINE_LOCAL LCWK_MSGID
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/**************************************************************/
/*  POS：ヒント01b                         */
/**************************************************************/
EVENT_START ev_pos_d27_hint_01b
  
  _HIDE_SHIP_PASSWORD_ID_GET( LCWK_PASSID )
  
  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //ヒントメッセージのIDを足して代入
  $LCWK_MSGID = msg_hide_ship_hint1_01
  $LCWK_MSGID += $LCWK_PASSID
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  $LCW_POSX -= 1
  
  //アニメ：「！」
  _OBJ_ANIME( D27R1001_HINT_01, anm_common_gyoe )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_l )
  _OBJ_ANIME_WAIT()
  
  //トレーナー曲再生
  _TRAINER_BGM_SET(  TRID_SWPLAZMAM_15 )
  
  //アニメ：隣接
  _OBJ_ANIME_AUTO( D27R1001_HINT_01, LCW_POSX,LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  
  //戦闘前メッセージ
  _BALLOONWIN_OBJMSG_POS( msg_hide_ship_hint1_start , D27R1001_HINT_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //トレーナー戦呼び出し
  _TRAINER_BTL_SET( TRID_SWPLAZMAM_15, 0 )
  
  //結果チェック
  _CALL ev_battle_check
  
  //ヒントメッセージ
  _BALLOONWIN_OBJMSG_POS( LCWK_MSGID , D27R1001_HINT_01 ,POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //========================================//
  //戦闘終了フラグセット
  _FLAG_SET( FE_D27_HINT_01 )
  //POSを無効
  $WK_SCENE_D27_HINT_01 = 1
  //========================================//
  
EVENT_END

