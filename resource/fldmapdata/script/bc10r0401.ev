	  $LWK_PRICE = 20000
  ENDSWITCH

  _ITEM_NAME( 0, LWK_ITEM )
  _NUMBER( 1, LWK_PRICE, 5 )

  $LWK_MSG1 = msg_bc10r0401_shop_b_01
