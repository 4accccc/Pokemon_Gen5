_EVENT_DATA   ev_bc10r0401_middlewoman1_01
_EVENT_DATA   ev_bc10r0401_middleman1_01
_EVENT_DATA   ev_bc10r0401_badman_01
_EVENT_DATA   ev_bc10r0401_woman3_01
_EVENT_DATA   ev_bc10r0401_oldman1_01
_EVENT_DATA_END

//無限ダンジョンの状態を取得する用変数
DEFINE_LOCAL  LWK_DUNGEON_STATUS


/**************************************************************/
/*            フィールド初期化スクリプト                      */
/**************************************************************/
INIT_EVENT_START ev_zone_bc10r0401

INIT_EVENT_END

/**************************************************************/
/* ショップ01                                                 */
/**************************************************************/
EVENT_START   ev_bc10r0401_shopm1_01
  _TALK_OBJ_START()
  _BLACK_CITY_SHOP0_CALL( )
EVENT_END

/**************************************************************/
/* ショップ02                                                  */
/**************************************************************/
EVENT_START   ev_bc10r0401_shopm1_02
  _TALK_OBJ_START()
  _BLACK_CITY_SHOP1_CALL( )
EVENT_END

/**************************************************************/
/* ショップ03                                                 */
/**************************************************************/
EVENT_START   ev_bc10r0401_shopm1_03
  _TALK_OBJ_START()
  _BLACK_CITY_SHOP2_CALL( )
EVENT_END

/**************************************************************/
/* ショップ04                                                 */
/**************************************************************/
EVENT_START   ev_bc10r0401_shopm1_04
  _TALK_OBJ_START()
  _BLACK_CITY_SHOP3_CALL( )
EVENT_END

/**************************************************************/
/*  ＢＣのボス（ジェントルマン）：話しかけ                    */
/**************************************************************/
EVENT_START   ev_bc10r0401_gentleman_01

  //無限ダンジョンの進行具合で台詞が分岐
  _INFINITY_DUNGEON_GET_DUNGEON_STATUS( LWK_DUNGEON_STATUS )

  //初期状態
  IF $LWK_DUNGEON_STATUS <= 4 THEN

    //ＢＣボス：ようこそ……
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_bc10r0401_gentleman_01 )

  //エリア05クリア後
  ELSIF $LWK_DUNGEON_STATUS >= 5 && $LWK_DUNGEON_STATUS <= 9 THEN

    //ＢＣボス：おまえの
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_bc10r0401_gentleman_02 )

  //エリア10クリア後
  ELSIF $LWK_DUNGEON_STATUS >= 10 THEN

    //ＢＣボス：くろのまてんろうの　バンジロウに
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_bc10r0401_gentleman_03 )

  ENDIF

EVENT_END

