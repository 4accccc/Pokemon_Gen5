//======================================================================
//                t02r0101
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "../../../prog/include/msg/script/msg_t02r0101.h"
  .include  "t02r0101.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_t02r0101_middlewoman1_01
_EVENT_DATA   ev_t02r0101_woman1_01
_EVENT_DATA   ev_t02r0101_boy1_01
_EVENT_DATA   ev_t02r0101_poke35_01
_EVENT_DATA   ev_t02r0101_girl1_01
_EVENT_DATA_END

//選択ポケモン格納変数定義
DEFINE_LOCAL LWK_CHOICE
//キャンセルしたか結果格納変数定義
DEFINE_LOCAL LWK_SELECT_RESULT
//要望と一致してるかチェック結果格納変数定義
DEFINE_LOCAL LWK_TRADE_CHECK

//------------------------------注意--------------------------------//
//                                                                  //
//  繰り返し交換イベントに LOCALWORK0 を使用しています。            //
//  同マップ内の使用を禁止します。                                  //
//                                                                  //
//------------------------------------------------------------------//


/**************************************************************/
/*  おばさん：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_t02r0101_middlewoman1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_middlewoman1_01 )
EVENT_END

/**************************************************************/
/*  女性：話しかけ                                            */
/**************************************************************/
EVENT_START   ev_t02r0101_woman1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_woman1_01 )
EVENT_END

/**************************************************************/
/*  男の子：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_t02r0101_boy1_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_boy1_01 )
EVENT_END

/**************************************************************/
/*  ヒヤップ：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_t02r0101_poke35_01
  _EASY_TALK_POKEVOICE( MONSNO_597, msg_t02r0101_poke35_01 )
EVENT_END

/**************************************************************/
/*  女の子：話しかけ（ポケモン交換）                          */
/**************************************************************/
EVENT_START   ev_t02r0101_girl1_01

  _TALK_OBJ_START()

  //ポケモン対戦（１回目）前
  IF FLAG_OFF( FE_T02R0101_BTL_WIN_01 ) && FLAG_OFF( FE_T02R0101_BTL_WIN_02 ) THEN

    //ポケモン交換前
    IF FLAG_OFF( FE_T02R0101_POKETRADE_01 ) && $LOCALWORK0 == 0 THEN

      //ポケモン交換１回目へ
      _CALL ev_poketrade_01

    //ポケモン交換後＋マップチェンジ前
    ELSIF FLAG_ON( FE_T02R0101_POKETRADE_01 ) && $LOCALWORK0 == 1 THEN

      //女の子：あたしの　エイパム
      _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    //ポケモン交換後＋マップチェンジ後
    ELSE

      //女の子：ツンベアー！　つよくなったわ！▽
      _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_05 )

      //女の子：ポケモンしょうぶ　おねがいできる？
      _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_06 )

      //女の子と戦う？
      _YES_NO_WIN( SCWK_ANSWER )

      IF $SCWK_ANSWER == SCR_YES THEN   //はい

        //女の子：ツンベアーを　どう　そだてたか▽
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_07 )
        _MSGWIN_CLOSE()

        //トレーナー戦呼び出し
        _TRAINER_BTL_SET( TRID_MINI_24, 0 )

        //結果チェック
        _TRAINER_LOSE_CHECK( SCWK_ANSWER )
        IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
          _TRAINER_WIN()
        ELSE
          _TRAINER_LOSE()
        ENDIF

        //========================================//
        //戦闘に勝利
        _FLAG_SET( FE_T02R0101_BTL_WIN_01 )
        //========================================//

        //ポケモン交換２回目へ
        _CALL ev_poketrade_02

      ELSE  //いいえ

        //女の子：そうよね……いつもいつも
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_08 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ENDIF

  //ポケモン対戦（２回目）前
  ELSIF FLAG_ON( FE_T02R0101_BTL_WIN_01 ) && FLAG_OFF( FE_T02R0101_BTL_WIN_02 ) THEN

    //ポケモン交換前
    IF FLAG_OFF( FE_T02R0101_POKETRADE_02 ) && $LOCALWORK0 == 0 THEN

      //ポケモン交換２回目へ
      _CALL ev_poketrade_02

    //ポケモン交換後＋マップチェンジ前
    ELSIF FLAG_ON( FE_T02R0101_POKETRADE_02 ) && $LOCALWORK0 == 1 THEN

      //女の子：あたしの　ジュペッタ
      _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_11 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    //ポケモン交換後＋マップチェンジ後
    ELSE

      //女の子：ユキノオー！　つよくなったわ！▽
      _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_13 )

      //女の子：ポケモンしょうぶ　おねがいできる？
      _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_16 )

      //女の子と戦う？
      _YES_NO_WIN( SCWK_ANSWER )

      IF $SCWK_ANSWER == SCR_YES THEN   //はい

        //女の子：ユキノオーを　どう　そだてたか▽
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_17 )
        _MSGWIN_CLOSE()

        //トレーナー戦呼び出し
        _TRAINER_BTL_SET( TRID_MINI_25, 0 )

        //結果チェック
        _TRAINER_LOSE_CHECK( SCWK_ANSWER )
        IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
          _TRAINER_WIN()
        ELSE
          _TRAINER_LOSE()
        ENDIF

        //========================================//
        //戦闘に勝利
        _FLAG_SET( FE_T02R0101_BTL_WIN_02 )
        //========================================//

        //女の子：ね！　あたし　あなたと
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_15 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ELSE  //いいえ

        //女の子：そうよね……いつもいつも
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_08 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ENDIF

  //ポケモン対戦（２回後）
  ELSE

    //女の子：ね！　あたし　あなたと
    _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_15 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END


//ポケモン交換１回目
ev_poketrade_01:

   //女の子：ね！　よかったらなんだけど▼
  _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_01 )

  //ツンベアーとエイパムを交換する？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == 0 THEN    //はい

    _MSGWIN_CLOSE()

    //ポケモン選択画面開く
    _SELECT_TEMOTI_POKE( LWK_SELECT_RESULT, LWK_CHOICE, 0 )

    //ポケモンを選択したか
    IF $LWK_SELECT_RESULT == TRUE THEN

      //選択したポケモンが交換可能かチェック
      _FIELD_POKE_TRADE_CHECK( LWK_TRADE_CHECK, FLD_TRADE_POKE_30_ETEBOOSU, LWK_CHOICE )

      //交換可能であるか
      IF $LWK_TRADE_CHECK == FLD_TRADE_ENABLE THEN

        //女の子：うれしい！　ではさっそく
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_02 )
        _MSGWIN_CLOSE()

        //交換処理
        _FIELD_POKE_TRADE ( FLD_TRADE_POKE_30_ETEBOOSU, LWK_CHOICE )

        //女の子：あたしの　エイパム
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_03 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

        //==================================//
        //交換完了
        _FLAG_SET ( FE_T02R0101_POKETRADE_01 )
        //ローカルワーク進行
        $LOCALWORK0 = 1
        //==================================//

      //条件と一致しなかった
      ELSE

        //女の子：そうよね……　あなたにとって
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_04 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    //選択キャンセル
    ELSE

      //女の子：そうよね……　あなたにとって
      _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSE    //いいえ

    //女の子：そうよね……　あなたにとって
    _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_04 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

_RET

//ポケモン交換２回目
ev_poketrade_02:

   //女の子：おもしろかった！
  _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_09 )

  //ユキノオーとジュペッタを交換する？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == 0 THEN    //はい

    _MSGWIN_CLOSE()

    //ポケモン選択画面開く
    _SELECT_TEMOTI_POKE( LWK_SELECT_RESULT, LWK_CHOICE, 0 )

    //ポケモンを選択したか
    IF $LWK_SELECT_RESULT == TRUE THEN

      //選択したポケモンが交換可能かチェック
      _FIELD_POKE_TRADE_CHECK( LWK_TRADE_CHECK, FLD_TRADE_POKE_31_HUUDHIN, LWK_CHOICE )

      //交換可能であるか
      IF $LWK_TRADE_CHECK == FLD_TRADE_ENABLE THEN

        //女の子：うれしい！　ではさっそく
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_10 )
        _MSGWIN_CLOSE()

        //交換処理
        _FIELD_POKE_TRADE ( FLD_TRADE_POKE_31_HUUDHIN, LWK_CHOICE )

        //女の子：あたしの　ジュペッタ
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_11 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

        //==================================//
        //交換完了
        _FLAG_SET ( FE_T02R0101_POKETRADE_02 )
        //ローカルワーク進行
        $LOCALWORK0 = 1
        //==================================//

      //条件と一致しなかった
      ELSE

        //女の子：そうよね……　あなたにとって
        _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_12 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    //選択キャンセル
    ELSE

      //女の子：そうよね……　あなたにとって
      _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_12 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  ELSE    //いいえ

    //女の子：そうよね……　あなたにとって
    _BALLOONWIN_TALKOBJ_MSG( msg_t02r0101_girl1_12 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

_RET


