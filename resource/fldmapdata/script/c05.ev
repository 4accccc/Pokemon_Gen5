/* 			RIVAL：話しかけ			  */
/**************************************************************/
EVENT_START		ev_c05_swrival_01
  //ライバル名タグに代入
  _RIVAL_NAME(1)
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05_swrival_04 )
EVENT_END

/**************************************************************/
/* 			SAGE6：話しかけ			  */
/**************************************************************/
EVENT_START		ev_c05_sage6_01
  
  _TALK_START_SE_PLAY()
  
  //ロット：ここに入るなら
  _BALLOONWIN_OBJMSG_POS( msg_c05_sage6_05,C05_SAGE6_01, POS_DEFAULT ) 

  {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //いいえ
  IF $SCWK_ANSWER == SCR_NO THEN
    
    //ロット：おひきとりを
    _BALLOONWIN_OBJMSG_POS( msg_c05_sage6_04,C05_SAGE6_01, POS_DEFAULT ) 
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  //はい
  ELSE
    _CALL ev_c05_sage6_btl
  ENDIF
  }
EVENT_END

/**************************************************************/
/* 			CALL：七賢人戦闘処理～ポケモンハウスへ			  */
/**************************************************************/
ev_c05_sage6_btl:
  
  //ロット：ではまいるぞ
  _BALLOONWIN_OBJMSG_POS( msg_c05_sage6_03,C05_SAGE6_01, POS_DEFAULT ) 
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //【仮】戦闘処理（トレーナーIDが仮）
  _TRAINER_BTL_SET( TRID_SWRIVAL_04, 0 )
  
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
  
  //ロット：すまない
  _BALLOONWIN_OBJMSG_POS( msg_c05_sage6_06,C05_SAGE6_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //========================================//
  //ライバルOBJ表示
  _FLAG_RESET(FV_C05_SWRIVAL_01)
  //========================================//
  
  //ライバル動作OBJ生成
  _OBJ_ADD(C05_SWRIVAL_01)
  
  //ライバル位置調整
  _OBJ_POS_CHANGE(C05_SWRIVAL_01,185,2,398,DIR_RIGHT)
  
  //アニメ：ライバル戻る
  _OBJ_ANIME( C05_SWRIVAL_01, anm_rival_back_sage )
  _OBJ_ANIME_WAIT()
  
  //ライバル名タグに代入
  _RIVAL_NAME(1)
  
  //ライバル：にげられた！
  _BALLOONWIN_OBJMSG_POS( msg_c05_swrival_03,C05_SWRIVAL_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME( C05_HAKAIM_01, anm_staystep_l )
  _OBJ_ANIME( C05_SAGE6_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //ロット：そちらは？
  _BALLOONWIN_OBJMSG_POS( msg_c05_sage6_07,C05_SAGE6_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //アニメ：ロット室内に移動
  _OBJ_ANIME( C05_SAGE6_01, anm_walk_u )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //ロットの動作OBJ削除
  _OBJ_DEL(C05_SAGE6_01)
  
  //アニメ：主人公移動
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_pleyer_in_pokehouse )
  _OBJ_ANIME( C05_SWRIVAL_01, anm_rival_in_pokehouse )
  _OBJ_ANIME_WAIT()
  
  
  //========================================//
  //C05元プラズマ団戦闘終了
  $WK_SCENE_C05 = 2
  //C05ロット非表示
  _FLAG_SET( FV_C05_SAGE6_01 )
  //元プラズマ団非表示
  _FLAG_SET( FV_C05_HAKAIM_01 )
  //========================================//
  
  //予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_C05R0501_SAGE6_01 )
	
	//C12PC0101マップチェンジ
	_MAP_CHANGE( ZONE_ID_C05R0501, 7, 25, DIR_UP )
  
_RET

//--------------------------------------------------------------------
//	ライバル：8倍速で戻って来る
//--------------------------------------------------------------------
_ANIME_LABEL	anm_rival_back_sage
	_ANIME_DATA	AC_WALK_R_4F,10
	_ANIME_DATA	ACMD_END,0

