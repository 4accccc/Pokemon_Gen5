//======================================================================
//                wheel_scr.ev
//
//    スクリプトファイル：wheel_scr用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_wheel_scr.h"
//  .include  "wheel_scr_local.h"

  .include  "../../../prog/include/system/timezone.h" //時間帯定義

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------
//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_wheel_ride
_EVENT_DATA_END

DEFINE_LOCAL  reg_return

{ //WHEEL_RIDE
DEFINE_LOCAL  lwk_entry_id
DEFINE_LOCAL  lwk_tr_id
DEFINE_LOCAL  lwk_flag_id
DEFINE_LOCAL  lwk_1st_f
DEFINE_LOCAL  lwk_2nd_f
DEFINE_LOCAL  lwk_npc_id    // SWANパートナーID(0～5) NPC4人と隠しキャラ2人

//==============================================================
/// 
///
///       観覧車トレーナー対戦イベント               
///
///
//==============================================================
EVENT_START   ev_wheel_ride
{
  _DEBUG_PRINT_WK( WK_OTHER_AMUSEMENT_PARTNER )

  SWITCH $WK_OTHER_AMUSEMENT_PARTNER
  CASE SCR_AMUSEMENT_PARTNER_LCC THEN

    DEFINE_LOCAL lwk_date
    // LCC隠しキャラとのデートがあるかチェック
    _PERSON_STATE_CHECK_SECRET_DATE( lwk_date )

    IF $lwk_date == SCR_PERSON_SECRET_DATE_GIVE THEN
      // 落し物イベント
      _CALL sub_idol_talk

    ELSE
      // 通常の観覧車イベント
      _GET_MY_SEX( SCWK_ANSWER )
      $lwk_npc_id = 4
      $lwk_npc_id += $SCWK_ANSWER

      // LCC隠しキャラのフラグは固定
      $lwk_flag_id = FE_AMUSEMENT_LCC_TALK

      // 会話
      _CALL sub_wheel_talk_swan

    ENDIF


    // LCC隠しキャラとデート終了
    _PERSON_STATE_SET_SECRET_DATE_END()

  CASE SCR_AMUSEMENT_PARTNER_NPC THEN
    
    // 初期化
    {
      //曜日を取得
      _GET_WEEK( SCWK_ANSWER )
      SWITCH $SCWK_ANSWER
        CASE RTC_WEEK_TUESDAY THEN
        // 火曜はライバル
        $lwk_npc_id = 0
      CASE RTC_WEEK_WEDNESDAY THEN
        // 水曜日はベル
        $lwk_npc_id = 1
      CASE RTC_WEEK_FRIDAY THEN
        // 金曜日はN
        $lwk_npc_id = 2
        // Nと観覧車乗ったフラグを立てる
        _FLAG_SET( FE_C04WHEEL_N_MEET )
      CASE RTC_WEEK_SATURDAY THEN
        // 土曜日はチェレン
        $lwk_npc_id = 3
      DEFAULT
        $lwk_npc_id = 0
      ENDSWITCH

      $lwk_flag_id = FE_AMUSEMENT_NPC01_TALK
      $lwk_flag_id += $lwk_npc_id
    }

    // 会話
    _CALL sub_wheel_talk_swan
    //一日一回フラグを立てる
    _FLAG_SET( TMFLG_AMUSEMENT_NPC )
  DEFAULT
  // WBと同じ処理
    _CALL sub_wheel_talk_wb
  ENDSWITCH

}
EVENT_END

//==============================================================
//サブルーチン：SWANキャラ話しかけ
//==============================================================
sub_wheel_talk_swan:
{
  DEFINE_LOCAL  i_scene_id

  _FLAG_CHECK( lwk_flag_id, lwk_2nd_f )

  _DEBUG_PRINT_WK( lwk_flag_id )
  _DEBUG_PRINT_WK( lwk_npc_id )
  _DEBUG_PRINT_WK( lwk_2nd_f )

  _TALK_OBJ_START()

  // 挨拶メッセージ
  _WHEEL_NPC_MSG( msg_wheel_rival_01, lwk_npc_id, lwk_2nd_f )  
  _BALLOONWIN_CLOSE()

  // 入り口まで移動
  _START_EVENT_BGM( SEQ_BGM_E_KANRANSYA )			//イベント曲再生	
  _OBJ_ANIME( SCWK_TARGET_OBJID, anm_move_to_entrance )
  _OBJ_ANIME_WAIT()

  //デモ再生
  // sceene_id:9  ライバル
  // sceene_id:10 ベル
  // sceene_id:11 N
  // sceene_id:12 チェレン
  // sceene_id:13 LCC隠しキャラ 男
  // sceene_id:14 LCC隠しキャラ 女
  $i_scene_id = 9
  $i_scene_id += $lwk_npc_id    // 0～5が入っている

  // ※LCC隠しキャラのみ初回と2回目以降のデモがある
  IF $WK_OTHER_AMUSEMENT_PARTNER == SCR_AMUSEMENT_PARTNER_LCC THEN
    IF $lwk_2nd_f == TRUE THEN
      // 2回目以降ならデモを2回目以降にする
      $i_scene_id += 2
    ENDIF
  ENDIF

  // デモ再生
  _DEMO_FADEOUT_BLACK_CALL()
  _CALL_3D_DEMO_EX( DEMO3D_ID_F_WHEEL, i_scene_id )

	//暗転中にトレーナーの位置を変更
	_OBJ_POS_CHANGE( MMDL_ID_PLAYER, 54, 1, 16, DIR_UP )
	_OBJ_POS_CHANGE( SCWK_TARGET_OBJID, 54, 1, 15, DIR_DOWN )
  _TURN_HERO_SITE()

  _DEMO_FADEIN_BLACK_CALL()
	_END_EVENT_BGM()  //BGM戻す


  {
    DEFINE_LOCAL lwk_date

    // デートが何回目か
    _PERSON_STATE_CHECK_SECRET_DATE( lwk_date )

    // LCC隠しキャラなら
    IF $WK_OTHER_AMUSEMENT_PARTNER == SCR_AMUSEMENT_PARTNER_LCC THEN
      _GET_ZENKOKU_ZUKAN_FLAG( SCWK_ANSWER )
      // 全国図鑑を持っている かつ デートが2回目以降
      IF $SCWK_ANSWER == TRUE && $lwk_date == SCR_PERSON_SECRET_DATE_REGULAR THEN
        // 交換
        _CALL sub_wheel_trade
      ENDIF
    ENDIF
  }

  // お別れメッセージ
  _WHEEL_NPC_MSG( msg_wheel_rival_02, lwk_npc_id, lwk_2nd_f )  
  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()

  // 画面外へ移動
  _OBJ_ANIME_AUTO( SCWK_TARGET_OBJID, 45, 15, FORCE_TYPE_NOT, 8, DIR_UD )
  // LCC隠しキャラなら
  IF $WK_OTHER_AMUSEMENT_PARTNER == SCR_AMUSEMENT_PARTNER_LCC THEN
    // 少したったら左向く
    _TIME_WAIT( 20 )
	  _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_l )
  ENDIF
  _OBJ_ANIME_WAIT()
  _OBJ_DEL( SCWK_TARGET_OBJID )
  
  //========================================/
  // 初回フラグをたてる
  _FLAG_SET( lwk_flag_id )

  // JAの履歴差し込み 「観覧車に乗った」
  _RESORT_SET_RECORD( RESORT_RECORD_ID_WHEEL )

  // メダル
  _CALL medal_get

  //========================================/

}
_RET

//==============================================================
//サブルーチン：LLC隠しキャラのポケモン交換イベント
//==============================================================
sub_wheel_trade:
{
  DEFINE_LOCAL msg_id
  DEFINE_LOCAL fld_trade_poke_no
  DEFINE_LOCAL trade_monsno   // 交換でもらうポケモンナンバー

  // 性別でメッセージ変更
  _GET_MY_SEX( SCWK_ANSWER )
  IF $SCWK_ANSWER == PM_MALE THEN
    $msg_id = msg_wheel_swidol_w_05
  ELSE
    $msg_id = msg_wheel_swidol_m_05
  ENDIF

  // 交換ポケモンNO
  // 性別でもらうポケモン変更
  _GET_MY_SEX( SCWK_ANSWER )
  IF $SCWK_ANSWER == PM_MALE THEN
    $fld_trade_poke_no = FLD_TRADE_POKE_13_NYAASU
  ELSE
    $fld_trade_poke_no = FLD_TRADE_POKE_1_MANKII
  ENDIF

  // 交換回数を足す
  $fld_trade_poke_no += $WK_OTHER_LCC_TRADE_CNT

  // 交換でもらうポケモンナンバー取得
  _FIELD_POKE_GET_TRADE_MONSNO( trade_monsno, fld_trade_poke_no  )

  // 交換でもらうポケモン名をタグにセット
  _MONS_NAME( 1, trade_monsno )
  // プレイヤー名をタグにセット
  _PLAYER_NAME( 0 )

  // 交換要求メッセージ
  _BALLOONWIN_TALKOBJ_MSG( msg_id )
  // YES NO
  _YES_NO_WIN( SCWK_ANSWER )

  _BALLOONWIN_CLOSE()

  // はい
  IF $SCWK_ANSWER == 0 THEN
    DEFINE_LOCAL lwk_select   // 選択ポケモン
    DEFINE_LOCAL select_monso   // 選択ポケモン種族名
    DEFINE_LOCAL lwk_result   // キャンセルしたか
    DEFINE_LOCAL i_loop

    // ポケモンを選択するまでループ
    $i_loop = TRUE
    WHILE $i_loop == TRUE
    {
      // ポケモン選択画面開く
      _SELECT_TEMOTI_POKE( lwk_result, lwk_select, 0 )

      // ポケモンを選択した
      IF $lwk_result == TRUE THEN
        DEFINE_LOCAL lwk_trade_check

        // 選択したポケモンが交換可能かチェック
        _FIELD_POKE_TRADE_CHECK( lwk_trade_check, fld_trade_poke_no, lwk_select )

        // 観覧車専用の交換不可でないなら交換OKにする
        //  ダメタマゴと合体キュレムを交換不可にしている
        IF $lwk_trade_check != FLD_TRADE_DISABLE_AMUSEMENT THEN

          // 交換にだすポケモン名をセット
          _TEMOTI_MONS_NAME( 2, lwk_select )
          // 交換でもらうポケモン名をタグにセット
          _MONS_NAME( 1, trade_monsno )

          // このポケモンでいいですか？
          _SYSWIN_MSG( msg_wheel_trade_sys_01, POS_DOWN )
          _YES_NO_WIN( SCWK_ANSWER )
          _SYSWIN_CLOSE()

          IF $SCWK_ANSWER == SCR_YES THEN // はい
            // ループ終了
            $i_loop = FALSE
          ENDIF

        ELSE

          // このポケモンは交換にだせません。
          _SYSWIN_MSG( msg_wheel_trade_sys_02, POS_DOWN )
          _SYSWIN_CLOSE()
        ENDIF

      ELSE
        // ポケモンを選択しなくても
        // ループ終了
        $i_loop = FALSE
      ENDIF
    }
    ENDWHILE

    // ポケモンを選択した
    // =この時点で交換できるポケモンしか選択されていない
    IF $lwk_result == TRUE THEN

      // 交換でもらうポケモン名をタグにセット
      _MONS_NAME( 1, trade_monsno )
      // プレイヤー名をタグにセット
      _PLAYER_NAME( 0 )

      // 交換成立メッセージ
      $msg_id += 1
      _BALLOONWIN_TALKOBJ_MSG( msg_id )
      _BALLOONWIN_CLOSE()

      //選んだポケモンの種族ナンバーを取得
      _GET_PARTY_POKE_PARAM( select_monso, lwk_select, SCR_POKEPARA_MONSNO )

      // 交換処理
      _FIELD_POKE_TRADE( fld_trade_poke_no, lwk_select )

			//==================================//
      // 交換完了 カウントアップ
      $WK_OTHER_LCC_TRADE_CNT += 1
      IF $WK_OTHER_LCC_TRADE_CNT >= 12 THEN
         $WK_OTHER_LCC_TRADE_CNT = 0
      ENDIF

      // 交換完了フラグを設定
      _PERSON_STATE_SET_TRADE( select_monso )

			//==================================//

      // ここで終了
      _RET

    ENDIF

  // いいえ
  ELSE
  ENDIF

  // 交換でもらうポケモン名をタグにセット
  _MONS_NAME( 1, trade_monsno )
  // プレイヤー名をタグにセット
  _PLAYER_NAME( 0 )

  // 交換不成立メッセージ
  $msg_id += 2
  _BALLOONWIN_TALKOBJ_MSG( msg_id )
  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()

}
_RET

//==============================================================
//サブルーチン：交換ポケモン選択
//==============================================================
sub_wheel_poke_select:
{
  DEFINE_LOCAL lwk_select   // 選択ポケモン
  DEFINE_LOCAL select_monso   // 選択ポケモン種族名
  DEFINE_LOCAL lwk_result   // キャンセルしたか

  // ポケモン選択画面開く
  _SELECT_TEMOTI_POKE( lwk_result, lwk_select, 0 )



}
_RET

//==============================================================
//サブルーチン：WBのときの話しかけ
//==============================================================
sub_wheel_talk_wb:
{
  DEFINE_LOCAL  i_season

  //登録ID取得
  _GET_WHEEL_TRAINER_ENTRY_ID( lwk_entry_id )

  //トレーナーID取得
  _GET_WHEEL_TRAINER_TR_ID( lwk_entry_id, lwk_tr_id )

  //初回終了フラグチェック
  _TRAINER_FLAG_CHECK( lwk_tr_id, lwk_1st_f )
  
  //2回目以降かのフラグチェック
  _GET_SEASON_ID( i_season )
  $lwk_flag_id = FE_AMUSEMENT_TR01_TALK
  $lwk_flag_id += $i_season
  _FLAG_CHECK( lwk_flag_id, lwk_2nd_f )

  _TALK_OBJ_START()
  _CALL sub_wheel_ride_main
}
_RET

//==============================================================
//サブルーチン：対戦イベントメイン
//==============================================================
sub_wheel_ride_main:
{
  DEFINE_LOCAL  i_ret
  DEFINE_LOCAL  i_scene_id

  _DEBUG_PRINT_WK( lwk_entry_id )
  _DEBUG_PRINT_WK( lwk_1st_f )
  _DEBUG_PRINT_WK( lwk_2nd_f )

  //一日一回フラグチェック
  _FLAG_CHECK( TMFLG_AMUSEMENT_TR_BTL, i_ret )
  IF $i_ret == TRUE THEN
    //またね
    _WHEEL_TRAINER_MSG( msg_wheel_spring_f_05, lwk_entry_id, lwk_2nd_f )  
    _LAST_KEYWAIT()
	  _BALLOONWIN_CLOSE()
    _RET
  ENDIF
  
  //勝負に勝てたら一緒に乗ってあげる
	_WHEEL_TRAINER_MSG( msg_wheel_spring_f_01, lwk_entry_id, lwk_1st_f )
	_YES_NO_WIN( i_ret )

  IF $i_ret == SCR_NO THEN
    //断った
    _WHEEL_TRAINER_MSG( msg_wheel_spring_f_03, lwk_entry_id, lwk_1st_f )  
    _LAST_KEYWAIT()
	  _BALLOONWIN_CLOSE()
    _RET
  ENDIF

  //じゃあ、勝負しよう
  _WHEEL_TRAINER_MSG( msg_wheel_spring_f_02, lwk_entry_id, lwk_1st_f )  
  _BALLOONWIN_CLOSE()

  //バトル呼び出し
 	_TRAINER_BTL_SET( lwk_tr_id, 0 )
	//敗戦チェック
	_TRAINER_LOSE_CHECK( i_ret )
	IF $i_ret == SCR_BATTLE_RESULT_LOSE THEN
		_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
    _RET
  ELSE
    _TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ENDIF
  
  //負けたから一緒に乗ってあげる
  _WHEEL_TRAINER_MSG( msg_wheel_spring_f_04, lwk_entry_id, lwk_1st_f )  
  _BALLOONWIN_CLOSE()
 
  //入り口まで移動
  _START_EVENT_BGM( SEQ_BGM_E_KANRANSYA )			//イベント曲再生	
  _OBJ_ANIME( SCWK_TARGET_OBJID, anm_move_to_entrance )
  _OBJ_ANIME_WAIT()

  //デモ再生
  $i_scene_id = $lwk_entry_id
  $i_scene_id += 1
	
  _DEMO_FADEOUT_BLACK_CALL()
  _CALL_3D_DEMO_EX( DEMO3D_ID_F_WHEEL, i_scene_id )

	//暗転中にトレーナーの位置を変更
	_OBJ_POS_CHANGE( SCWK_TARGET_OBJID, 54, 1, 15, DIR_DOWN )
  _TURN_HERO_SITE()

  _DEMO_FADEIN_BLACK_CALL()
	_END_EVENT_BGM()  //BGM戻す

  //また一緒に乗ろうね
  _WHEEL_TRAINER_MSG( msg_wheel_spring_f_05, lwk_entry_id, lwk_1st_f )  
  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()
  
  ////////////////////////////////////////////////
  //フラグセット
  
  // JAの履歴差し込み 「観覧車に乗った」
  _RESORT_SET_RECORD( RESORT_RECORD_ID_WHEEL )
  
  //一日一回フラグを立てる
  _FLAG_SET( TMFLG_AMUSEMENT_TR_BTL )

  //対戦済みフラグチェック
  _TRAINER_FLAG_CHECK( lwk_tr_id, i_ret )
  IF $i_ret == TRUE THEN
    //2回目の対戦終了フラグ
    _FLAG_SET( lwk_flag_id )
  ELSE
    //対戦済みフラグを立てる
    _TRAINER_FLAG_SET( lwk_tr_id )
  ENDIF

  // メダル
  _CALL medal_get
}
_RET

//--------------------------------------------------------------------
//観覧車入り口へ移動
//--------------------------------------------------------------------
_ANIME_LABEL	anm_move_to_entrance
	_ANIME_DATA	AC_WALK_U_16F,1
	_ANIME_DATA	ACMD_END,0

} //WHEEL_RIDE_END


medal_get:
{
  DEFINE_LOCAL  ret_tr01
  DEFINE_LOCAL  ret_tr02
  DEFINE_LOCAL  ret_tr03
  DEFINE_LOCAL  ret_tr04
  DEFINE_LOCAL  ret_tr_id

  _GET_MY_SEX( SCWK_ANSWER )
  IF $SCWK_ANSWER == 0 THEN
    _GET_WHEEL_TRAINER_TR_ID( 0, ret_tr_id )
    _TRAINER_FLAG_CHECK( ret_tr_id, ret_tr01 )
    _GET_WHEEL_TRAINER_TR_ID( 2, ret_tr_id )
    _TRAINER_FLAG_CHECK( ret_tr_id, ret_tr02 )
    _GET_WHEEL_TRAINER_TR_ID( 4, ret_tr_id )
    _TRAINER_FLAG_CHECK( ret_tr_id, ret_tr03 )
    _GET_WHEEL_TRAINER_TR_ID( 6, ret_tr_id )
    _TRAINER_FLAG_CHECK( ret_tr_id, ret_tr04 )
  ELSE
    _GET_WHEEL_TRAINER_TR_ID( 1, ret_tr_id )
    _TRAINER_FLAG_CHECK( ret_tr_id, ret_tr01 )
    _GET_WHEEL_TRAINER_TR_ID( 3, ret_tr_id )
    _TRAINER_FLAG_CHECK( ret_tr_id, ret_tr02 )
    _GET_WHEEL_TRAINER_TR_ID( 5, ret_tr_id )
    _TRAINER_FLAG_CHECK( ret_tr_id, ret_tr03 )
    _GET_WHEEL_TRAINER_TR_ID( 7, ret_tr_id )
    _TRAINER_FLAG_CHECK( ret_tr_id, ret_tr04 )
  ENDIF

  // 全員と乗った判定
  IF $ret_tr01 == TRUE && $ret_tr02 == TRUE && $ret_tr03 == TRUE && $ret_tr04 == TRUE && FLAG_ON( FE_AMUSEMENT_NPC01_TALK ) && FLAG_ON( FE_AMUSEMENT_NPC02_TALK ) && FLAG_ON( FE_AMUSEMENT_NPC03_TALK ) && FLAG_ON( FE_AMUSEMENT_NPC04_TALK ) && FLAG_ON( FE_AMUSEMENT_LCC_TALK ) THEN
    // 全員と観覧車のったメダル
    _SET_MEDAL_ACHIVE( MDLID_KANRANSHA )
  ENDIF

}
_RET

/**************************************************************/
/*		落し物イベント										  */
/**************************************************************/
sub_idol_talk:
{
	DEFINE_LOCAL	LWK_SEX

  _TALK_OBJ_START()
	
	//プレイヤー名を格納する
	_PLAYER_NAME(0)
	
	_OBJ_ANIME( SCWK_TARGET_OBJID, anm_gyoe )
	_OBJ_ANIME_WAIT()
	
	//わっ　わたし　ちがい　ますから！
	_BALLOONWIN_OBJMSG_MF( msg_wheel_swidol_w_08_01, msg_wheel_swidol_m_08_01, SCWK_TARGET_OBJID, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_GET_MY_SEX(LWK_SEX)
	
	//～～は　？？？？？に
	_SE_PLAY(SEQ_SE_ARDEMO_01)

	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_SYSWIN_MSG( msg_wheel_swidol_w_08_02, POS_DOWN )
	CASE PM_FEMALE THEN
		_SYSWIN_MSG( msg_wheel_swidol_m_08_02, POS_DOWN )
	ENDSWITCH
	_SYSWIN_CLOSE()
	_SE_WAIT()
	
	//アイテムを減らす
	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_SUB_ITEM( ITEM_WASUREMONO_1,1,SCWK_ANSWER )
	CASE PM_FEMALE THEN
		_SUB_ITEM( ITEM_WASUREMONO,1,SCWK_ANSWER )
	ENDSWITCH

	//ありがとう
	_BALLOONWIN_OBJMSG_MF( msg_wheel_swidol_w_08_03, msg_wheel_swidol_m_08_03, SCWK_TARGET_OBJID, POS_DEFAULT )
	_MSGWIN_CLOSE()

	SWITCH $LWK_SEX
	CASE PM_MALE THEN
		_SYSWIN_MSG( msg_wheel_swidol_w_08_04, POS_DOWN )
	CASE PM_FEMALE THEN
		_SYSWIN_MSG( msg_wheel_swidol_m_08_04, POS_DOWN )
	ENDSWITCH
  //ライブキャスター登録SE再生
  _SE_PLAY( SEQ_SE_SW_LC_NO )
  _SE_WAIT()
	_SYSWIN_CLOSE()


	//ありがとう
	_BALLOONWIN_OBJMSG_MF( msg_wheel_swidol_w_08_05, msg_wheel_swidol_m_08_05, SCWK_TARGET_OBJID, POS_DEFAULT )
  _LAST_KEYWAIT()
	_MSGWIN_CLOSE()


  _PLAYER_DIR_GET( SCWK_ANSWER )

  // 画面外へ移動
	SWITCH $SCWK_ANSWER
	CASE DIR_RIGHT THEN
    _OBJ_ANIME_AUTO( SCWK_TARGET_OBJID, 45, 16, FORCE_TYPE_NOT, 8, DIR_UD )
	DEFAULT
    _OBJ_ANIME_AUTO( SCWK_TARGET_OBJID, 45, 15, FORCE_TYPE_NOT, 8, DIR_UD )
	ENDSWITCH

  // 少したったら左向く
  _TIME_WAIT( 20 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_l )
  _OBJ_ANIME_WAIT()
	
	_OBJ_DEL( SCWK_TARGET_OBJID )
}
_RET

//--------------------------------------------------------------------
//☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL  anm_dir_u
  _ANIME_DATA AC_DIR_U,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_dir_d
  _ANIME_DATA AC_DIR_D,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_dir_l
  _ANIME_DATA AC_DIR_L,1
  _ANIME_DATA ACMD_END,0

_ANIME_LABEL  anm_dir_r
  _ANIME_DATA AC_DIR_R,1
  _ANIME_DATA ACMD_END,0
 
_ANIME_LABEL	anm_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

