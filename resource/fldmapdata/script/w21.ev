  .text

  .include  "scr_seq_def.h"
  .include  "msg_w21.h"
  .include  "w21.h"
  .include  "w21_def.h"  //タラップ表示イベント用参照

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_w21
_EVENT_DATA    ev_init_w21
_EVENT_DATA    ev_recover_w21
_EVENT_DATA    ev_pos_w21_swrival_01
_EVENT_DATA    ev_reserve_w21_swplazma_end_01
_EVENT_DATA    ev_w21_swleader1_01
_EVENT_DATA    ev_reserve_w21_swleader8_01
_EVENT_DATA_END

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
/************************************************************/
/*					ZONE_CHANGE_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_zone_w21
  
  //プラズマフリゲートイベント進行中以外は接続を移動させる
  IF $WK_SCENE_W21_01 != 3 THEN
    _SXY_MOVE_EXIT_EVENT( DOOR_ID_W21_D27R0101_EXIT01, 787, -3, 247 )
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_w21

  //シズイ登場イベント起動
  IF $WK_SCENE_W21_01 == 2 THEN
    _OBJ_POS_CHANGE(W21_SWRIVAL_01,794,-5,242,DIR_UP)
    _OBJ_POS_CHANGE(W21_SWLEADER8_01,795,-5,241,DIR_LEFT)
    
  //乗船2回目後イベント
  ELSIF $WK_SCENE_W21_01 == 4 && FLAG_OFF(FV_W21_SWRIVAL_01) THEN
    _OBJ_POS_CHANGE(W21_SWRIVAL_01,795,-5,243,DIR_UP)
  
  //乗船2回目後（D10到着前）
  ELSIF $WK_SCENE_W21_01 == 5 && FLAG_OFF(FV_W21_SWLEADER1_01) THEN
    _OBJ_POS_CHANGE(W21_SWLEADER1_01,794,-5,242,DIR_RIGHT)
  
  ENDIF

INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_w21
  //
INIT_EVENT_END

/************************************************************/
/*					POS：プラズマフリゲート発見  						*/
/************************************************************/
EVENT_START	ev_pos_w21_swrival_01
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //========================================//
  //W21ライバル表示
  _FLAG_RESET( FV_W21_SWRIVAL_01 )
  //W21シズイ表示
  _FLAG_RESET( FV_W21_SWLEADER8_01 )
  //========================================//
  
  //カメラ操作　プラズマフリゲートにフォーカス
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,52531200,-327759,15736832,48 )
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  _TIME_WAIT( 80 )
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (48)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()    //カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()   //カメラ操作終了
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  //ライバル動作モデル生成
  _OBJ_ADD(W21_SWRIVAL_01)
  _SE_WAIT()
  
  //アニメ：ライバル「！」
  _OBJ_ANIME( W21_SWRIVAL_01 , anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  IF $LCW_POSZ >= 242 THEN
    $LCW_POSZ -= 1
  ELSE
    $LCW_POSZ += 1
  ENDIF
  
  //アニメ：ライバル登場
  _OBJ_ANIME_AUTO( W21_SWRIVAL_01 , LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  IF $LCW_POSZ >= 242 THEN
    _OBJ_ANIME( W21_SWRIVAL_01 , anm_staystep_d )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  ELSE
    _OBJ_ANIME( W21_SWRIVAL_01 , anm_staystep_u )
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  ENDIF
  
  _OBJ_ANIME_WAIT()
  
  //ライバル：みつけたな！
  _BALLOONWIN_OBJMSG_POS( msg_w21_swrival_01 , W21_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  //カメラ操作　博士中心に
  _CAMERA_MOVE( 9688,0,970752,52445184,-327759,15892480,64 )
  
  //アニメ：ライバル隣接
  _OBJ_ANIME_AUTO( W21_SWRIVAL_01 , 796, 242, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT(24)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r )
  _OBJ_ANIME_WAIT()
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //ライバル：しかし
  _BALLOONWIN_OBJMSG_POS( msg_w21_swrival_02 , W21_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()

  //？？？：ちょっとまっとき！
  _PLAINWIN_MSG_DOWN( msg_w21_swleader8_01 )
  _MSGWIN_CLOSE()
  
  // メッセージBG面以外のフェード
  // この後にマップチェンジを必ず呼ばなければならない
  _MAP_FADE_OUT_MSG_ENABLE( MSG_FADE_BLACK, 1 )

  //？？？：画面暗転中のメッセージ
  _PLAINWIN_MSG_DOWN( msg_w21_swleader8_08 )
  _MSGWIN_CLOSE()
  
  //マップ差し替え:W21アジト船タラップ表示
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, FALSE , FALSE )
  _CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, TRUE , TRUE )
  
  //========================================//
  //W21シズイイベント進行
  $WK_SCENE_W21_01 = 2
  //========================================//
  
  //予約スクリプト
  _RESERVE_SCRIPT( SCRID_RESERVE_W21_SWLEADER8_01 )
  //D05マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_W21, 794, 0, 240, DIR_DOWN )

EVENT_END

/************************************************************/
/*					RESERVE：シズイ搭乗  						*/
/************************************************************/
EVENT_START	ev_reserve_w21_swleader8_01

  // メッセージBG面以外のフェード
  // この後にマップチェンジを必ず呼ばなければならない
  _MAP_FADE_IN_MSG_ENABLE( MSG_FADE_BLACK, 1 )

  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //シズイ：これで
  _BALLOONWIN_OBJMSG_POS( msg_w21_swleader8_02 , W21_SWLEADER8_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：あんた
  _BALLOONWIN_OBJMSG_POS( msg_w21_swrival_03 , W21_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //シズイ：おうともよ
  _BALLOONWIN_OBJMSG_POS( msg_w21_swleader8_03 , W21_SWLEADER8_01 ,POS_DEFAULT )
  
  //シズイ：でも　おはんらが
  _BALLOONWIN_OBJMSG_POS( msg_w21_swleader8_04 , W21_SWLEADER8_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：……あんがとよ
  _BALLOONWIN_OBJMSG_POS( msg_w21_swrival_04 , W21_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //シズイ：ええか
  _BALLOONWIN_OBJMSG_POS( msg_w21_swleader8_05 , W21_SWLEADER8_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：シズイ船方向を見る
  _OBJ_ANIME( W21_SWLEADER8_01 , anm_staystep_r)
  _OBJ_ANIME_WAIT()
  
  //シズイ：さわいで
  _BALLOONWIN_OBJMSG_POS( msg_w21_swleader8_06 , W21_SWLEADER8_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：シズイ左方向を見る
  _OBJ_ANIME( W21_SWLEADER8_01 , anm_staystep_l)
  _OBJ_ANIME_WAIT()
  
  //シズイ：きをつけて
  _BALLOONWIN_OBJMSG_POS( msg_w21_swleader8_07 , W21_SWLEADER8_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //カメラ操作　プラズマフリゲートにフォーカス
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,52002816,-327759,15826944,16 )
  
  //アニメ：シズイ退場
  _OBJ_ANIME( W21_SWLEADER8_01 , anm_swleader8_bye_01)
  _TIME_WAIT( 16 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_l)
  _OBJ_ANIME( W21_SWRIVAL_01 , anm_staystep_l)
  _TIME_WAIT( 16 )
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  //シズイ動作モデル削除
  _OBJ_DEL( W21_SWLEADER8_01 )
  
  _OBJ_ANIME_WAIT()
  _SE_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //ライバル：なんだよー
  _BALLOONWIN_OBJMSG_POS( msg_w21_swrival_05 , W21_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公・ライバル向き合う
  _OBJ_ANIME( W21_SWRIVAL_01 , anm_staystep_u)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //ライバル：とはいえ
  _BALLOONWIN_OBJMSG_POS( msg_w21_swrival_06 , W21_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  _OBJ_ANIME( W21_SWRIVAL_01 , anm_swrival_bye_01)
  _TIME_WAIT( 28 )
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  //ライバル動作モデル削除
  _OBJ_DEL( W21_SWRIVAL_01 )
  _OBJ_ANIME_WAIT()
  _SE_WAIT()
  
  
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (16)
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //接続配置変更
  _SXY_MOVE_EXIT_EVENT( DOOR_ID_W21_D27R0101_EXIT01, 800, -5, 241 )
  
  //========================================//
  //W21シズイイベント終了
  $WK_SCENE_W21_01 = 3
  //W21シズイ非表示
  _FLAG_SET( FV_W21_SWRIVAL_01 )
  //W21ライバル非表示
  _FLAG_SET( FV_W21_SWLEADER8_01 )
  //D27搭乗二回目
  _FLAG_RESET(FV_D27R0101_SWRIVAL_01)
  _FLAG_RESET(FV_D27R0101_SWPLAZMA_02)
  _FLAG_SET(FV_D27R0101_SWPLAZMA_01)
  _FLAG_SET(FV_D27R0101_SWLEADER1_01)
  //========================================//
  
  // ROMバージョン取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //乗船2回目イベント起動
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    //========================================//
     $WK_SCENE_D27R0101_SECONDW_01 = 0
     $WK_SCENE_D27R0101_SECONDB_01 = 1
     $WK_SCENE_D27R1301_PLAZMAM_01 = 1
     $WK_SCENE_D27R1001_PLAZMAM_01 = 1
     //========================================//
  ELSE
    //========================================//
     $WK_SCENE_D27R0101_SECONDW_01 = 1
     $WK_SCENE_D27R0101_SECONDB_01 = 0
     $WK_SCENE_D27R1301_PLAZMAM_01 = 1
     $WK_SCENE_D27R1001_PLAZMAM_01 = 1
     //========================================//
  ENDIF
  
EVENT_END
//--------------------------------------------------------------------
//	シズイ退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader8_bye_01
  _ANIME_DATA	AC_WALK_L_8F,4
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	ライバル退場01
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swrival_bye_01
	_ANIME_DATA	AC_WALK_U_4F,1
	_ANIME_DATA	AC_WALK_R_4F,6
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*					RESERVE：  						*/
/************************************************************/
EVENT_START	ev_reserve_w21_swplazma_end_01
  
  //暗転復帰
  _MAP_FADE_BLACK_IN()
  _DISP_FADE_END_CHECK()
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )

  //ライバル：とぶのかよ！？
  _BALLOONWIN_OBJMSG_POS( msg_w21_swrival_07 , W21_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン登場
  _OBJ_ANIME_AUTO( W21_SWLEADER1_01 , 793, 242, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT(8)
  _OBJ_ANIME( W21_SWRIVAL_01 , anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //チェレン：ゴメン……
  _BALLOONWIN_OBJMSG_POS( msg_w21_swleader1_01 , W21_SWLEADER1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：じゃそちらは
  _BALLOONWIN_OBJMSG_POS( msg_w21_swrival_08 , W21_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル上を見る
  _OBJ_ANIME( W21_SWRIVAL_01 , anm_staystep_u )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ライバル：だってあのポケモン
  _BALLOONWIN_OBJMSG_POS( msg_w21_swrival_09 , W21_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  _OBJ_ANIME( W21_SWRIVAL_01 , anm_swrival_bye_02 )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( W21_SWLEADER1_01 , anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_l )
  _TIME_WAIT( 24 )
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _OBJ_DEL( W21_SWRIVAL_01 )
  _OBJ_ANIME_WAIT()
  _SE_WAIT()
  
  
  //アニメ：チェレン・主人公を見る
  _OBJ_ANIME( W21_SWLEADER1_01 , anm_swleader1_look_player_01 )
  _OBJ_ANIME_WAIT()
  
  //チェレン：キュレム！
  _BALLOONWIN_OBJMSG_POS( msg_w21_swleader1_02 , W21_SWLEADER1_01 ,POS_DEFAULT )
  
  //どうやって
  _BALLOONWIN_OBJMSG_WB( msg_w21_swleader1_03b , msg_w21_swleader1_03w , W21_SWLEADER1_01 , POS_DEFAULT)
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //========================================//
  //W21イベント終了
  $WK_SCENE_W21_01 = 5
  //D10R0101 POSイベント起動
  $WK_SCENE_D10R0101_SWPLAZMA_01 = 1
  //W21ライバル非表示
  _FLAG_SET( FV_W21_SWRIVAL_01 )
  //D10マップ差し替え
  _FLAG_SET( FE_D10_PLAZMA_FRIGATE_01 )
  //========================================//
  
EVENT_END

