_EVENT_DATA    ev_bg_c04_board_01
_EVENT_DATA    ev_bg_c04_board_02
_EVENT_DATA    ev_bg_c04_board_03
_EVENT_DATA    ev_bg_c04_board_04
_EVENT_DATA    ev_bg_c04_board_05
_EVENT_DATA    ev_bg_c04_board_06
