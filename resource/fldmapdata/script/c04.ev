/**************************************************************/
/*  POS：ライバルイベント（プラズマ団戦）                     */
/**************************************************************/
EVENT_START   ev_pos_c04_swrival_01

  //==================================//
  //POSイベント終了
  $WK_SCENE_C04_SWRIVAL = 2
  //ローカルライブキャスター・ライバル通話状態を変更（C04ゲート前イベント終了まで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_C04_3 )
  //==================================//

	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
	
	//カメラ操作
	_CAMERA_MOVE( 9688,0,970752,26705920,65551,28737536,20 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()

  _START_EVENT_BGM( SEQ_BGM_E_PLASMA )

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：まてよ！　オマエら
  _BALLOONWIN_OBJMSG_POS( msg_c04_swrival_01, C04_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：プラズマ団全員振り向き（下にいるヤツから振り向き）
  _OBJ_ANIME( C04_SWPLAZMAM_02, anm_staystep_u )
  _TIME_WAIT( 6 )
  _OBJ_ANIME( C04_SWPLAZMAM_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  _TIME_WAIT( 40 )

  _OBJ_ANIME( C04_SWPLAZMAM_02, anm_dir_r )
  _OBJ_ANIME( C04_SWPLAZMAM_01, anm_dir_r )
  _OBJ_ANIME_WAIT()

  //プラズマ団男：……べつに
  _BALLOONWIN_OBJMSG_POS( msg_c04_swplazmam1_01, C04_SWPLAZMAM_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ライバルがプラズマ団に近づく
  _OBJ_ANIME( C04_SWRIVAL_01, anm_walk_l )
  _OBJ_ANIME_WAIT()

  //ライバル：なにも　していない
  _BALLOONWIN_OBJMSG_POS( msg_c04_swrival_02, C04_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //プラズマ団男：やれやれ……
  _BALLOONWIN_OBJMSG_POS( msg_c04_swplazmam1_02, C04_SWPLAZMAM_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：プラズマ団２人の移動
  _OBJ_ANIME( C04_SWPLAZMAM_04, anm_walk2_r )
  _TIME_WAIT( 3 )
  _OBJ_ANIME( C04_SWPLAZMAW_01, anm_walk2_r )
  _OBJ_ANIME_WAIT()

  //アニメ：プラズマ団がライバルを取り囲む
  _OBJ_ANIME( C04_SWPLAZMAM_04, anm_staystep_d )
  _TIME_WAIT( 3 )
  _OBJ_ANIME( C04_SWPLAZMAW_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //間（ライバルがきょろきょろする）
  _OBJ_ANIME(  C04_SWRIVAL_01, anm_meet )
  _OBJ_ANIME_WAIT()
  _TIME_WAIT( 8 )

  //アニメ：ライバルが主人公を見る
  _OBJ_ANIME( C04_SWRIVAL_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //主人公名代入
  _PLAYER_NAME( 0 )
  //ライバル：そこに　いるんだろ▼
  _BALLOONWIN_OBJMSG_POS( msg_c04_swrival_03, C04_SWRIVAL_01, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //アニメ：ライバルがプラズマ団男04と向かい合う
  _OBJ_ANIME( C04_SWRIVAL_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

	_CAMERA_RECV_MOVE(20)
	_CAMERA_WAIT_MOVE()
	_CAMERA_BIND()		//カメラのバインドを解く
	_CAMERA_END()

  _END_EVENT_BGM()

EVENT_END

/**************************************************************/
/*  ライバル（ライバルイベント中）                            */
/**************************************************************/
EVENT_START   ev_c04_swrival_01

  _TALK_OBJ_START()
  //主人公名代入
  _PLAYER_NAME( 0 )
  
  //ライバル名代入
  _RIVAL_NAME( 1 )
  
  //ライバル：はんぶんずつ　かたずけるぜ！
  _BALLOONWIN_TALKOBJ_MSG( msg_c04_swrival_04 )
  _MSGWIN_CLOSE()

  //アニメ：ライバルがプラズマ団男04へ向き直す
  _OBJ_ANIME( C04_SWRIVAL_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()

EVENT_END

/**************************************************************/
/*  プラズマ団男04（ライバルイベント中）                      */
/**************************************************************/
EVENT_START   ev_c04_swplazmam_04

  _TALK_START_TURN_NOT()
  //プラズマ団男04：……！　オレが
  _BALLOONWIN_TALKOBJ_MSG( msg_c04_swplazmam4_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  プラズマ団男02（ライバルイベント中）                      */
/**************************************************************/
EVENT_START	ev_c04_swplazmam_02
_TALK_OBJ_START()

_TRAINER_BGM_SET( TRID_SWPLAZMAM_03 )

//へへへ
_BALLOONWIN_TALKOBJ_MSG( msg_c04_swplazmam2_01 )
_MSGWIN_CLOSE()

//トレーナー戦呼び出し
_TRAINER_BTL_SET( TRID_SWPLAZMAM_03, 0 )
//敗戦チェック
_TRAINER_LOSE_CHECK( SCWK_ANSWER )

IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
	//========================================/
	//イベント進行状況にプラス1
	$WK_SCENE_C04_SWRIVAL += 1
	//========================================/
	_TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ

ELSE
	//========================================//
	//負けたらリセット
	$WK_SCENE_C04_SWRIVAL = 2
	//========================================//
	_TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
ENDIF

//まじかよ！
_BALLOONWIN_TALKOBJ_MSG( msg_c04_swplazmam2_03 )
_MSGWIN_CLOSE()

//アニメ：負けたプラズマ団後退
_OBJ_ANIME_AUTO( C04_SWPLAZMAM_02, 405, 439, FORCE_TYPE_NPC, 8, DIR_LR )
_OBJ_ANIME_WAIT()
_OBJ_ANIME( C04_SWPLAZMAM_02, anm_staystep_r )
_OBJ_ANIME_WAIT()

//アニメ：ライバルの方のアニメ進行
_OBJ_ANIME_AUTO( C04_SWPLAZMAM_04, 405, 437, FORCE_TYPE_NPC, 8, DIR_LR )
_TIME_WAIT( 3 )
_OBJ_ANIME( C04_SWRIVAL_01, anm_staystep_l )
_OBJ_ANIME_WAIT()
_OBJ_ANIME( C04_SWPLAZMAM_04, anm_staystep_r )
_OBJ_ANIME_WAIT()

_TRAINER_BGM_SET( TRID_SWPLAZMAW_12 )

_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
_OBJ_ANIME( C04_SWPLAZMAW_01, anm_staystep_u )
_OBJ_ANIME_WAIT()

//プラズマ団女01：つぎは　アタシ
_BALLOONWIN_OBJMSG_POS( msg_c04_swplazmaw1_02, C04_SWPLAZMAW_01, POS_DEFAULT )
_MSGWIN_CLOSE()

//トレーナー戦呼び出し
_TRAINER_BTL_SET( TRID_SWPLAZMAW_12, 0 )

IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN

	//========================================/
	//イベント進行状況にプラス1
	$WK_SCENE_C04_SWRIVAL += 1
	//========================================/
	_TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ

ELSE
	
	//========================================//
	//負けたらリセット
	$WK_SCENE_C04_SWRIVAL = 2
	//========================================//
	_TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）

ENDIF

//勝利後メッセージ
//プラズマ団女01：これでは
_BALLOONWIN_OBJMSG_POS( msg_c04_swplazmaw1_03, C04_SWPLAZMAW_01, POS_DEFAULT )
_MSGWIN_CLOSE()

//アニメ：負けたプラズマ団後退
_OBJ_ANIME_AUTO( C04_SWPLAZMAW_01, 405, 440, FORCE_TYPE_NPC, 8, DIR_LR )
_OBJ_ANIME_WAIT()
_OBJ_ANIME( C04_SWPLAZMAW_01, anm_staystep_r )
_OBJ_ANIME_WAIT()

_CALL ev_pos_c04_swrival_02

EVENT_END

/**************************************************************/
/*  プラズマ団女01（ライバルイベント中）                      */
/**************************************************************/
EVENT_START	ev_c04_swplazmaw_01
_TALK_OBJ_START()

_TRAINER_BGM_SET( TRID_SWPLAZMAW_12 )

//なんてこと
_BALLOONWIN_TALKOBJ_MSG( msg_c04_swplazmaw1_01 )
_MSGWIN_CLOSE()

//トレーナー戦呼び出し
_TRAINER_BTL_SET( TRID_SWPLAZMAW_12, 0 )
//敗戦チェック
_TRAINER_LOSE_CHECK( SCWK_ANSWER )

IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
	//========================================/
	//イベント進行状況にプラス1
	$WK_SCENE_C04_SWRIVAL += 1
	//========================================/
	_TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ

ELSE
	//========================================//
	//負けたらリセット
	$WK_SCENE_C04_SWRIVAL = 2
	//========================================//
	_TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
ENDIF

//これでは　２ねんまえと
_BALLOONWIN_TALKOBJ_MSG( msg_c04_swplazmaw1_03 )
_MSGWIN_CLOSE()

//アニメ：負けたプラズマ団後退
_OBJ_ANIME_AUTO( C04_SWPLAZMAW_01, 405, 440, FORCE_TYPE_NPC, 8, DIR_LR )
_OBJ_ANIME_WAIT()
_OBJ_ANIME( C04_SWPLAZMAW_01, anm_staystep_r )
_OBJ_ANIME_WAIT()

//アニメ：ライバルの方のアニメ進行
_OBJ_ANIME_AUTO( C04_SWPLAZMAM_04, 405, 437, FORCE_TYPE_NPC, 8, DIR_LR )
_TIME_WAIT( 3 )
_OBJ_ANIME( C04_SWRIVAL_01, anm_staystep_l )
_OBJ_ANIME_WAIT()
_OBJ_ANIME( C04_SWPLAZMAM_04, anm_staystep_r )
_OBJ_ANIME_WAIT()

_TRAINER_BGM_SET( TRID_SWPLAZMAM_03 )

//自機座標取得
_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

//アニメ：プラズマ団主人公に隣接
IF $LCW_POSX == 408 && $LCW_POSZ == 440 THEN
	$LCW_POSZ -= 1
	_OBJ_ANIME_AUTO( C04_SWPLAZMAM_02, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR )
	_OBJ_ANIME_WAIT()
ENDIF

//自機方向取得
_PLAYER_DIR_GET( LWK_DIR )
SWITCH $LWK_DIR
CASE DIR_LEFT THEN
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
	_OBJ_ANIME( C04_SWPLAZMAM_02, anm_staystep_d )
CASE DIR_DOWN THEN
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	_OBJ_ANIME( C04_SWPLAZMAM_02, anm_staystep_r )
ENDSWITCH
_OBJ_ANIME_WAIT()

//プラズマ団男02：つぎは　オレだ！　▼
_BALLOONWIN_OBJMSG_POS( msg_c04_swplazmam2_02, C04_SWPLAZMAM_02, POS_DEFAULT )
_MSGWIN_CLOSE()

//トレーナー戦呼び出し
_TRAINER_BTL_SET( TRID_SWPLAZMAM_03, 0 )

IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
	//========================================/
	//イベント進行状況にプラス1
	$WK_SCENE_C04_SWRIVAL += 1
	//========================================/
	_TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
ELSE
	//========================================//
	//負けたらリセット
	$WK_SCENE_C04_SWRIVAL = 2
	//========================================//
	_TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
ENDIF

//勝利後メッセージ
//プラズマ団男02：まじかよ！　▼
_BALLOONWIN_OBJMSG_POS( msg_c04_swplazmam2_03, C04_SWPLAZMAM_02, POS_DEFAULT )
_MSGWIN_CLOSE()

//アニメ：負けたプラズマ団後退
_OBJ_ANIME_AUTO( C04_SWPLAZMAM_02, 405, 439, FORCE_TYPE_NPC, 8, DIR_LR )
_OBJ_ANIME_WAIT()
_OBJ_ANIME( C04_SWPLAZMAM_02, anm_staystep_r )
_OBJ_ANIME_WAIT()

_CALL ev_pos_c04_swrival_02

EVENT_END

/**************************************************************/
/*    ライバルイベント２（プラズマ団全滅）                    */
/**************************************************************/
EVENT_START   ev_pos_c04_swrival_02

  //==================================//
  //POSイベント終了
  $WK_SCENE_C04_SWRIVAL = 4
  //==================================//

  //アニメ：ライバルの方のアニメ進行
  _OBJ_ANIME_AUTO( C04_SWPLAZMAM_01, 405, 438, FORCE_TYPE_NPC, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C04_SWPLAZMAM_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX, LCW_POSZ )
  //アニメ：主人公ライバルに隣接
  IF $LCW_POSX == 408 && $LCW_POSZ == 440 THEN
    _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 407, 439, FORCE_TYPE_NPC, 8, DIR_UD )
    _OBJ_ANIME_WAIT()
  ENDIF

  //自機方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  //アニメ：主人公が下を向いていた場合は振り向き
  IF $LWK_DIR == DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME_WAIT()
  ENDIF

  //プラズマ団男：まいったね！
  _BALLOONWIN_OBJMSG_POS( msg_c04_swplazmam1_03, C04_SWPLAZMAM_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  _TIME_WAIT( 15 )

  //暗転
  _BLACK_OUT_SLOW()
  _DISP_FADE_END_CHECK()

  //プラズマ団×４削除
  _OBJ_DEL( C04_SWPLAZMAM_01 )
  _OBJ_DEL( C04_SWPLAZMAM_02 )
  _OBJ_DEL( C04_SWPLAZMAM_04 )
  _OBJ_DEL( C04_SWPLAZMAW_01 )

  _START_EVENT_BGM_SILENT( 40 )

  _TIME_WAIT( 45 )

  //========================================//
  //暗転中にプラズマ団を非表示
  _FLAG_SET( FV_C04_SWPLASMAM_01 )
  //========================================//

  //暗転復帰
  _BLACK_IN_SLOW()
  _DISP_FADE_END_CHECK()

  _TIME_WAIT( 45 )

  //ライバルゆっくり１歩前へ
  _OBJ_ANIME( C04_SWRIVAL_01, anm_walk_l_16f )
  _OBJ_ANIME_WAIT()

  _START_EVENT_BGM(SEQ_BGM_E_EMOTION)

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //ライバル：オレさ　プラズマだんに
  _BALLOONWIN_OBJMSG_POS( msg_c04_swrival_05, C04_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ライバル主人公と向き合う
  _OBJ_ANIME_AUTO( C04_SWRIVAL_01, 406, 439, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( C04_SWRIVAL_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()

  //ライバル：たすかったよ
  _BALLOONWIN_OBJMSG_POS( msg_c04_swrival_06, C04_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //回復処理
  _TEMOTI_POKEMON_KAIFUKU()
  _SE_PLAY( SEQ_SE_RECOVERY )
  _SE_WAIT()

  //ライバル名代入
  _RIVAL_NAME( 1 )
  //主人公名代入
  _PLAYER_NAME( 0 )
  //システム：かいふく　してくれた！
  _SYSWIN_MSG( msg_c04_swrival_07, POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _SYSWIN_CLOSE()

  //ライバル：たすかったよ
  _BALLOONWIN_OBJMSG_POS( msg_c04_swrival_08, C04_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //アニメ：ライバルポケセンへ
  _OBJ_ANIME_AUTO( C04_SWRIVAL_01, 411, 440, FORCE_TYPE_NPC, 8, DIR_UD )
  _TIME_WAIT( 20 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME_AUTO( C04_SWRIVAL_01, 411, 447, FORCE_TYPE_NPC, 8, DIR_UD )
  _OBJ_ANIME_WAIT()

  //ライバル削除
  _OBJ_DEL( C04_SWRIVAL_01 )

  //========================================//
  //ライバルを非表示
  _FLAG_SET( FV_C04_SWRIVAL_01 )
  //ローカルライブキャスター・ライバル通話状態を変更（C05橋上イベントまで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_C04_4 )
  //========================================//

  _END_EVENT_BGM()

EVENT_END

/**************************************************************/
/*  SWHEROINE(SWHERO)イベント01                               */
/**************************************************************/
EVENT_START   ev_c04_swheroine_01
{

  //初めて話しかけたか
  IF FLAG_OFF( FE_C04_SWHEROINE_01 ) THEN
    _TALK_OBJ_START()
    //ヒロイン：あの　ギアステーションって（主人公が女の子の場合は男口調）
    _BALLOONWIN_OBJMSG_MF( msg_c04_heroine_01, msg_c04_hero_01, C04_SWHEROINE_01, POS_DOWN )

    //========================================//
    //２度目以降から下のセリフに
    _FLAG_SET( FE_C04_SWHEROINE_01 )
    //========================================//

  ELSE
    _TALK_OBJ_START()
    //ヒロイン：じゅんびオーケー　よね▼（主人公が女の子の場合は男口調）
    _BALLOONWIN_OBJMSG_MF( msg_c04_heroine_03, msg_c04_hero_03, C04_SWHEROINE_01, POS_DOWN )

  ENDIF

  _YES_NO_WIN( SCWK_ANSWER )

  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    //ヒロイン：ありがとう！▼（主人公が女の子の場合は男口調）
    _BALLOONWIN_OBJMSG_MF( msg_c04_heroine_04, msg_c04_hero_04, C04_SWHEROINE_01, POS_DOWN )
    _MSGWIN_CLOSE()

    //アニメ：ヒロイン向き直す
    _OBJ_ANIME( C04_SWHEROINE_01, anm_staystep_u )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
    _OBJ_ANIME_WAIT()

    //ヒロイン：ということで　サブウェイマスターに（主人公が女の子の場合は男口調）
    _BALLOONWIN_OBJMSG_MF( msg_c04_heroine_05, msg_c04_hero_05, C04_SWHEROINE_01, POS_DOWN )
    _MSGWIN_CLOSE()
    
    //アニメ：ノボリ・クダリ振り向き
    _OBJ_ANIME( C04_TBOSSBL_01, anm_staystep_r )
    _OBJ_ANIME( C04_TBOSS_01, anm_staystep_l )
    _OBJ_ANIME_WAIT()
    
    _TIME_WAIT( 30 )
    
    _OBJ_ANIME( C04_TBOSSBL_01, anm_staystep_d )
    _OBJ_ANIME( C04_TBOSS_01, anm_staystep_d )
    _OBJ_ANIME_WAIT()

	//暗転処理
	_BLACK_OUT()
	_DISP_FADE_END_CHECK()
	
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
	
	//カメラ操作
	_CAMERA_MOVE( 9688,0,970752,27688960,65551,30310400,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()

	//対戦ポジションに移動
	_OBJ_POS_CHANGE( MMDL_ID_PLAYER, 420, 1, 461, DIR_RIGHT )
	_OBJ_POS_CHANGE( C04_SWHEROINE_01, 420, 1, 463, DIR_RIGHT )
	_OBJ_POS_CHANGE( C04_TBOSSBL_01, 424, 1, 463, DIR_LEFT )
	_OBJ_POS_CHANGE( C04_TBOSS_01, 424, 1, 461, DIR_LEFT )
	
	_TIME_WAIT( 60 )
	
	//暗転復帰
	_BLACK_IN()
	_DISP_FADE_END_CHECK()

    //ノボリ：このような　ばしょでの
    _BALLOONWIN_OBJMSG_POS( msg_c04_tbossbl_02, C04_TBOSSBL_01, POS_DOWN )
    _MSGWIN_CLOSE()

    //クダリ：ルールを　まもって
    _BALLOONWIN_OBJMSG_POS( msg_c04_tboss_02, C04_TBOSS_01, POS_UP )
    _MSGWIN_CLOSE()

    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME( C04_SWHEROINE_01, anm_walk_r )
    _OBJ_ANIME( C04_TBOSSBL_01, anm_walk_l )
    _OBJ_ANIME( C04_TBOSS_01, anm_walk_l )
    _OBJ_ANIME_WAIT()

  _GET_MY_SEX( LCW_SEX )
  
  //マルチバトル
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA && $LCW_SEX == PM_MALE THEN
    //初期３匹で草タイプを選択・主人公は♂
    _TRAINER_MULTI_BTL_SET( TRID_HEROINE_01, TRID_BCHAMP_1_01, TRID_BCHAMP2_1_01 ) 
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA && $LCW_SEX == PM_FEMALE THEN
    //初期３匹で草タイプを選択・主人公は♀
    _TRAINER_MULTI_BTL_SET( TRID_HERO_01, TRID_BCHAMP_1_01, TRID_BCHAMP2_1_01 ) 
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO  && $LCW_SEX == PM_MALE THEN
    //初期３匹で炎タイプを選択・主人公は♂
    _TRAINER_MULTI_BTL_SET( TRID_HEROINE_02, TRID_BCHAMP_1_01, TRID_BCHAMP2_1_01 ) 
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO  && $LCW_SEX == PM_FEMALE THEN
    //初期３匹で炎タイプを選択・主人公は♀
    _TRAINER_MULTI_BTL_SET( TRID_HERO_02, TRID_BCHAMP_1_01, TRID_BCHAMP2_1_01 ) 
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_MIZU  && $LCW_SEX == PM_MALE THEN
    //初期３匹で水タイプを選択・主人公は♂
    _TRAINER_MULTI_BTL_SET( TRID_HEROINE_03, TRID_BCHAMP_1_01, TRID_BCHAMP2_1_01 ) 
  ELSE
    //初期３匹で水タイプを選択・主人公は♀
    _TRAINER_MULTI_BTL_SET( TRID_HERO_03, TRID_BCHAMP_1_01, TRID_BCHAMP2_1_01 ) 
  ENDIF

  //敗戦チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
	
	//カメラ操作
	_CAMERA_MOVE( 9688,0,970752,27688960,65551,30310400,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()

	/*手持ちが0匹だったら*/
	_GET_PARTY_POKE_COUNT( SCWK_TEMP0, POKECOUNT_MODE_BATTLE_ENABLE )
	IF $SCWK_TEMP0 == 0 THEN
		_TEMOTI_POKEMON_KAIFUKU() /*回復処理*/
	ENDIF

    _TRAINER_WIN()      //勝ち(1)ならトレーナー勝利処理へ
  ELSE
    _TRAINER_LOSE()     //負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
  ENDIF

	_TIME_WAIT( 30 )

    //勝利後メッセージ
    //ノボリ：ブラボー！！▼
    _BALLOONWIN_OBJMSG_POS( msg_c04_tbossbl_03, C04_TBOSSBL_01, POS_DOWN )
    _MSGWIN_CLOSE()

    _OBJ_ANIME( C04_TBOSS_01, anm_staystep_l )
    _OBJ_ANIME_WAIT()

    //クダリ：ぼく　クダリ▼
    _BALLOONWIN_OBJMSG_POS( msg_c04_tboss_03, C04_TBOSS_01, POS_UP )
    _MSGWIN_CLOSE()

    //ノボリ：ぜひ！　ぜひ！　つぎは
    _BALLOONWIN_OBJMSG_POS( msg_c04_tbossbl_04, C04_TBOSSBL_01, POS_DOWN )
    _MSGWIN_CLOSE()

    //アニメ：ノボリとクダリ移動
    _OBJ_ANIME_AUTO( C04_TBOSS_01, 422, 459, FORCE_TYPE_NPC, 8, DIR_UD )
    _TIME_WAIT( 2 )
    _OBJ_ANIME_AUTO( C04_TBOSSBL_01, 422, 460, FORCE_TYPE_NPC, 8, DIR_UD )
    _TIME_WAIT( 16 )
    _OBJ_ANIME( C04_SWHEROINE_01, anm_dir_u )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_u )
    _OBJ_ANIME_WAIT()

    _OBJ_ANIME( C04_TBOSSBL_01, anm_dir_u )
    _OBJ_ANIME_WAIT()

    _OBJ_DEL( C04_TBOSS_01 )

    //階段SE
    _SE_PLAY( SEQ_SE_KAIDAN ) 
    _SE_WAIT()
    
    _OBJ_ANIME_AUTO( C04_TBOSSBL_01, 422, 459, FORCE_TYPE_NPC, 8, DIR_UD )
	  _OBJ_ANIME_WAIT()
	
	_OBJ_DEL( C04_TBOSSBL_01 )
	
    //階段SE
    _SE_PLAY( SEQ_SE_KAIDAN ) 
	_SE_WAIT()

    _TIME_WAIT( 15 )

	//ヒロイン・主人公に隣接
    _OBJ_ANIME_AUTO( C04_SWHEROINE_01, 422, 461, FORCE_TYPE_NPC, 8, DIR_LR )
	_OBJ_ANIME_WAIT()

    _OBJ_ANIME( C04_SWHEROINE_01, anm_staystep_l )
    _TIME_WAIT( 10 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
    _OBJ_ANIME_WAIT()
      
    //主人公名代入
    _PLAYER_NAME( 0 )
    //ヒロイン：つよかった……！（主人公が女の子の場合は男口調）
    _BALLOONWIN_OBJMSG_MF( msg_c04_heroine_06, msg_c04_hero_06, C04_SWHEROINE_01, POS_DOWN )
    _MSGWIN_CLOSE()

    //アイテム入手：バトルレコーダー
    _ITEM_EVENT_KEYWAIT( ITEM_BATORUREKOODAA, 1 )

    //ヒロイン：バトルレコーダーを　もっていると（主人公が女の子の場合は男口調）
    _BALLOONWIN_OBJMSG_MF( msg_c04_heroine_07, msg_c04_hero_07, C04_SWHEROINE_01, POS_DOWN )
    _MSGWIN_CLOSE()

    //アニメ：ヒロイン退場
    _OBJ_ANIME_AUTO( C04_SWHEROINE_01, 422, 459, FORCE_TYPE_NPC, 8, DIR_UD )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_u )
    _OBJ_ANIME_WAIT()
    _SE_PLAY( SEQ_SE_KAIDAN ) 
    _OBJ_DEL( C04_SWHEROINE_01 )
    _SE_WAIT()

	_CAMERA_RECV_MOVE(16)
	_CAMERA_WAIT_MOVE()
	_CAMERA_BIND()		//カメラのバインドを解く
	_CAMERA_END()

    //========================================//
    //ヒロイン、ノボリとクダリを非表示
    _FLAG_SET( FV_C04_SWHEROINE_01 )
    //========================================//

  //いいえ
  ELSE

    //あっ　そうか！（主人公が女の子の場合は男口調）
    _BALLOONWIN_OBJMSG_MF( msg_c04_heroine_02, msg_c04_hero_02, C04_SWHEROINE_01, POS_DOWN )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //アニメ：ヒロイン向き直す
    _OBJ_ANIME( C04_SWHEROINE_01, anm_staystep_u )
    _OBJ_ANIME_WAIT()

  ENDIF

}
EVENT_END

/**************************************************************/
/* ノボリ：話しかけ                                           */
/**************************************************************/
EVENT_START   ev_C04_tbossbl_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c04_tbossbl_01 )
EVENT_END

/**************************************************************/
/* クダリ：話しかけ                                           */
/**************************************************************/
EVENT_START   ev_C04_tboss_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c04_tboss_01 )
EVENT_END

/**************************************************************/
/*  鉄道員：話しかけ（迷子ポケモンイベント）                  */
/**************************************************************/
EVENT_START   ev_c04_railman_01

  _TALK_OBJ_START()

  //鉄道員：えっ！　カナワタウンで
  _BALLOONWIN_TALKOBJ_MSG( msg_c04_railman_01 )
  _MSGWIN_CLOSE()

  _TIME_WAIT( 4 )

  //アニメ：鉄道員ヤナップと向かい合う
  _OBJ_ANIME( C04_RAILMAN_01, anm_staystep_r )
  _OBJ_ANIME( C04_POKE33_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()

  //鉄道員：ずいぶん　とおくから　きたんだなあ▼
  _BALLOONWIN_TALKOBJ_MSG( msg_c04_railman_02 )
  _MSGWIN_CLOSE()

  //自機方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  SWITCH $LWK_DIR
  CASE DIR_UP THEN
    _OBJ_ANIME( C04_RAILMAN_01, anm_staystep_d )
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( C04_RAILMAN_01, anm_staystep_l )
  ENDSWITCH
  _OBJ_ANIME_WAIT()

  //鉄道員：わかった！　ぼくが　カナワタウンに
  _BALLOONWIN_TALKOBJ_MSG( msg_c04_railman_03 )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  //アニメ：鉄道員とヤナップ退場
  IF $LCW_POSZ == 438 THEN
    _OBJ_ANIME_AUTO( C04_RAILMAN_01, 411, 437, FORCE_TYPE_NPC, 8, DIR_LR )
    _OBJ_ANIME_AUTO( C04_POKE33_01, 412, 437, FORCE_TYPE_NPC, 8, DIR_LR )
    _TIME_WAIT( 8 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME_WAIT()
  ELSE
    _OBJ_ANIME_AUTO( C04_RAILMAN_01, 411, 438, FORCE_TYPE_NPC, 8, DIR_UD )
    _OBJ_ANIME_AUTO( C04_POKE33_01, 412, 438, FORCE_TYPE_NPC, 8, DIR_UD )
    _TIME_WAIT( 16 )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
    _OBJ_ANIME_WAIT()
  ENDIF
  _OBJ_DEL( C04_RAILMAN_01 )
  _OBJ_DEL( C04_POKE33_01 )

  _TIME_WAIT( 8 )

  //========================================//
  //ライモンシティに駅員とヤナップ非表示
  _FLAG_SET( FV_C04_RAILMAN_01 )
  _FLAG_SET( FV_C04_POKE33_01 )
  //カナワタウンにヤナップ表示
  _FLAG_RESET( FV_T05_POKE33_01 )
  //========================================//

EVENT_END

/**************************************************************/
/*  ヤナップ：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_c04_poke33_01
  _EASY_TALK_POKEVOICE( MONSNO_593, msg_c04_poke33_01 )
EVENT_END

