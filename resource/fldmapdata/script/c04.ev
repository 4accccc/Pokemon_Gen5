_EVENT_DATA    ev_pos_c04_swrival_01      //ライモンジムクリア後に発生
_EVENT_DATA    ev_c04_swrival_01
_EVENT_DATA    ev_c04_swplazmam_04
_EVENT_DATA    ev_c04_swplazmam_02
_EVENT_DATA    ev_c04_swplazmaw_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/************************************************************/
/*					ZONE_CHANGE_SCRIPT						*/
/************************************************************/
INIT_EVENT_START	ev_zone_c04
	
	//ギアステーション内階段降りる演出用にワークをリセット
	$WK_OTHER_STATION_CONNECT = 1

	//ビッグスタジアム／リトルコートの処理を初期化
	$WK_OTHER_SPORTS_EVENT = SPORTS_EVENT_NONE
	_FLAG_RESET( FE_SPORTS_PLAYING )

	//ミュージカルファンの表示状態をリセット
	_FLAG_SET( FV_MUSICAL_FUN_01 )
	_FLAG_SET( FV_MUSICAL_FUN_02 )
	_FLAG_SET( FV_MUSICAL_FUN_03 )
	_FLAG_SET( FV_MUSICAL_FUN_04 )
	_FLAG_SET( FV_MUSICAL_FUN_05 )
	_FLAG_SET( FV_MUSICAL_FUN_06 )
	_FLAG_SET( FV_MUSICAL_FUN_07 )
	_FLAG_SET( FV_MUSICAL_FUN_08 )
	_FLAG_SET( FV_MUSICAL_FUN_09 )
	_FLAG_SET( FV_MUSICAL_FUN_10 )

	//ミュージカルスタイリストの助言メッセージをリセット
	_FLAG_SET( FE_C04R0201_STYLIST_TALK )

INIT_EVENT_END


/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START	ev_init_c04
	
	

INIT_EVENT_END


/************************************************************/
/*	予約スクリプト：ギアステーションから出てくるアニメ		*/
/************************************************************/
EVENT_START	ev_reserve_c04_exit

	_PLACE_NAME_DISPLAY()	//地名表示演出

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_exit_player_walk_out )
	_OBJ_ANIME_WAIT()
	
EVENT_END

//--------------------------------------------------------------------
//主人公：一歩前へ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_exit_player_walk_out
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

//サポートミュージカル誘導イベントの起動方法チェック用ワークを定義
//値が１ならPOSイベント起動
DEFINE_LOCAL	LWK_GUIDE_POS


