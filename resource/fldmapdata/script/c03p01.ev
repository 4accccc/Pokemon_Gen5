/*  看板2                                                     */
/**************************************************************/
EVENT_START   ev_bg_c03p01_sign_02
  _EASY_BGWIN_MSG( msg_c03p01_sign2_01, TYPE_POST)    //簡易メッセージＢＧ用
EVENT_END


