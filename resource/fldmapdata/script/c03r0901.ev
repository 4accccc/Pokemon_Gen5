  .text

  .include  "scr_seq_def.h"
  .include  "msg_c03r0901.h"
  .include  "c03r0901.h"
  .include  "skill_teach_scr_def.h"     //for SCRID_SKILL_LEARN

  //@author fujimura_souichirou（移植作業）
  //@author suginaka_katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_c03r0901_musician_01
_EVENT_DATA   ev_c03r0901_waiter_01
_EVENT_DATA   ev_c03r0901_businessman_01
_EVENT_DATA   ev_c03r0901_sunglasses_01
_EVENT_DATA	ev_c03r0901_veteranw_01
_EVENT_DATA	ev_pos_c03r0901_fes_01
_EVENT_DATA_END


DEFINE_LOCAL	LWK_POSX
DEFINE_LOCAL	LWK_POSZ


/**************************************************************/
/*  MUSICIAN  C03R0901                                        */
/**************************************************************/
EVENT_START   ev_c03r0901_musician_01

    DEFINE_LOCAL target_poke_pos
    DEFINE_LOCAL is_event_start

    _TALK_START_SE_PLAY()

    // イベント起動条件
    // １．いにしえのうたを覚えていない配布メロエッタがいる
    // ２．フェスのミッションが追加されていない
    $is_event_start = 0
    // ↑の変数が
    // 0:条件を満たさないのでイベント起動しない
    // 1:１の条件を満たす
    // 2:２の条件を満たす = いにしえのうたを思い出さない

    //１．いにしえのうたを覚えていない配布メロエッタがいるか？
    _GET_EVT_POKE_POS( MONSNO_655, TRUE, target_poke_pos, is_event_start )

    //２．フェスのミッションは追加されてるか
    IF $is_event_start == FALSE THEN
    {
      // 配布メロエッタがいる
      _GET_EVT_POKE_POS( MONSNO_655, FALSE, target_poke_pos, SCWK_ANSWER )

      // フェスが追加されていない
      IF $SCWK_ANSWER == TRUE && FLAG_OFF( FE_C03R0901_MELODY ) THEN
        $is_event_start = 2
      ENDIF
    }
    ENDIF

    // イベント開始
    IF $is_event_start != 0 THEN
      _BALLOONWIN_TALKOBJ_MSG( msg_c03r0901_musician_02 )
      _BALLOONWIN_CLOSE()

      //BGM停止
      _START_EVENT_BGM( SEQ_BGM_SILENCE_FIELD )

      //自機を定位置に移動
      _CALL player_move

      //カメラ移動
      _CAMERA_START()
      _CAMERA_PURGE()   //対象物とカメラのバインドを解く
      _CAMERA_MOVE( 9688, 0, 970752, 360448, 0, 425984, 30 )
      _CAMERA_WAIT_MOVE()   //カメラ移動待ち
	 
	    //お客さんの方向を変える
	    _CALL visitor_move
	 
      //対象メロエッタのニックネームをタグ０番にセット
      _TEMOTI_NICK_NAME( 0, target_poke_pos )

	    //前口上メッセージ表示
	    _PLAINWIN_MSG_DOWN( msg_c03r0901_narrator_00 )
	    _PLAINWIN_CLOSE()
	 
      //ボール投げるアニメ
      _CALL ball_out
      
      //BGMの再生
      _START_EVENT_BGM( SEQ_BGM_E_INISHIE )
      //ギターアニメ開始
      _OBJ_ANIME( SCWK_TARGET_OBJID, anm_guitar_move_1 )

      // メロエッタ ICAアニメ開始
      _MERO_GMK_START_ANIME( MMDL_ID_EVENTOBJ_00 )
      
      //ダンス開始
      _DEBUG_PRINT_WK(1)
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_merodhia_01 )
      
      //ウェイト：カメラ移動開始まで
      _TIME_WAIT( MERODHIA_CAMERA_WAIT ) 

      //カメラ移動
      _CAMERA_MOVE( 9569,0,957688,339968,172032,393216, 120 )

      //ウェイト：ステップフォルムに変化まで
      _TIME_WAIT( MERODHIA_STER_ANIME ) 
      
      // 調整用
      _TIME_WAIT( 8 ) 

      //ステップフォルムのアニメ
      _OBJ_ANIME_WAIT()
      _DEBUG_PRINT_WK(2)
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_merodhia_02 )
      _OBJ_ANIME( SCWK_TARGET_OBJID, anm_guitar_move_2 )

      //ウェイト：ボイスフォルムに変化まで
      _TIME_WAIT( MERODHIA_VOICE_ANIME ) 

      //ボイスフォルムのアニメ
      _OBJ_ANIME_WAIT()
      _DEBUG_PRINT_WK(3)
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_merodhia_03 )
      _OBJ_ANIME( SCWK_TARGET_OBJID, anm_guitar_move_3 )

      //メロエッタICAアニメ終了チェック
      _MERO_GMK_IS_ANIME_END()

      // アニメ終了チェック
      _DEBUG_PRINT_WK(4)
      _OBJ_ANIME_WAIT()
      _DEBUG_PRINT_WK(5)

      _BGM_WAIT()
      
      _END_EVENT_BGM()

      //カットインエフェクト再生
      _CALL_FLD3D_CUTIN( FLDCIID_MERODIA )

      //メロエッタきめポーズを通常に戻す（アニメ更新）
      _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_merodhia_normal )
      _OBJ_ANIME_WAIT()

      // いにしえのうたを覚えていないときのみ
      IF $is_event_start == 1 THEN
        //対象メロエッタのニックネームをタグ０番にセット
        _TEMOTI_NICK_NAME( 0, target_poke_pos )
        //「○○は古の歌をおもいだした」
        _SYSWIN_MSG( msg_c03r0901_narrator_01, POS_DOWN )
        _SYSWIN_CLOSE()
      ENDIF
      
      //メロエッタ下降
      _MERO_GMK_DOWN()

      //カメラ移動（メロエッタ中心）
      _CAMERA_MOVE( 9688,0,970752,360448,0,491520, 25 )
      _CAMERA_WAIT_MOVE()   //カメラ移動待ち
      
      // いにしえのうたを覚えていないときのみ
      IF $is_event_start == 1 THEN

        //技を覚えさせる処理
        _CALL learn_skill
      ELSE

        //ボールに戻るアニメ
        _CALL ball_in

        // お客の向きを戻す
        _OBJ_ANIME( C03R0901_VETERANW_01, anm_staystep_u )
        _OBJ_ANIME( C03R0901_BUSINESSMAN_01, anm_staystep_d )
        _OBJ_ANIME_WAIT()
        
        //========================================//
    	   _FLAG_SET(FE_C03R0901_MELODY)
    	   //========================================//
	   
	   IF FLAG_OFF( SYS_FLAG_FES_KINOMI_M ) THEN
	       $LOCALWORK10 = 1
	   ENDIF
	   
      ENDIF
      
    		//ギタリストメッセージ
    		_BALLOONWIN_TALKOBJ_MSG( msg_c03r0901_musician_04 )
    		_LAST_KEYWAIT()
    		_BALLOONWIN_CLOSE()

    ELSE
      _CALL last_message
    ENDIF
EVENT_END

last_message:
  DEFINE_LOCAL last_msg

  IF FLAG_ON( FE_C03R0901_MELODY ) THEN
    //イベント見たことがある
    $last_msg = msg_c03r0901_musician_05
  ELSE
     //イベント見たことがない
    $last_msg = msg_c03r0901_musician_01
  ENDIF
      
  _BALLOONWIN_TALKOBJ_MSG( last_msg )
  _LAST_KEYWAIT()
  _BALLOONWIN_CLOSE()
_RET

//自機の動き
player_move:
{
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 5, 9, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
}  
_RET

//お客の動き
visitor_move:
{
  _OBJ_ANIME( C03R0901_BUSINESSMAN_01, anm_staystep_l )
  _OBJ_ANIME( C03R0901_VETERANW_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
}
_RET

//技を覚える処理
learn_skill:
{
  //SCWK_PARAM0：ポケモン位置　SCWK_PARAM1：覚えさせる技ＩＤ
  $SCWK_PARAM0 = $target_poke_pos
  $SCWK_PARAM1 = WAZANO_INISIENOUTA
  //技覚えシーケンス SCWK_ANSWER=TRUEで覚えた
  _CHG_COMMON_SCR SCRID_SKILL_LEARN
  //覚えた？
  IF $SCWK_ANSWER == TRUE THEN

  ENDIF

  //ボールに戻るアニメ
  _CALL ball_in

  // お客の向きを戻す
  _OBJ_ANIME( C03R0901_VETERANW_01, anm_staystep_u )
  _OBJ_ANIME( C03R0901_BUSINESSMAN_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //========================================//
  _FLAG_SET(FE_C03R0901_MELODY)
  //========================================//
	   
  IF FLAG_OFF( SYS_FLAG_FES_KINOMI_M ) THEN
       $LOCALWORK10 = 1
  ENDIF

  //覚えた後の子芝居
  IF $SCWK_ANSWER == TRUE THEN

    //ギタリストメッセージ
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r0901_musician_03 )
    //_BALLOONWIN_CLOSE()
    //メッセージ間ウェイト
    _TIME_WAIT( 8 )

  ENDIF
}
_RET

ball_out:
  _MOVE_BALL( SCR_BALL_ANM_TYPE_OUT, 5, 2, 7, 3, 8 )
  _START_BALL_ANM( SCR_BALL_ANM_TYPE_OUT, 5, 2, 7 )
  //ボール出現フレーム待ち
  _WAIT_BALL_POKE_APP( SCR_BALL_ANM_TYPE_OUT )
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()
  //ポケを表示
  _OBJ_ADD_EX( 5, 7, DIR_DOWN, MMDL_ID_EVENTOBJ_00, POKE12, MV_DMY )
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _WAIT_BALL_ANM( SCR_BALL_ANM_TYPE_OUT )
_RET

ball_in:

  //カメラもどし
  _CAMERA_MOVE( 9688,0,970752,360448,0,622592, 25 )
  _CAMERA_WAIT_MOVE() //カメラ移動待ち
  _CAMERA_BIND()    //カメラバインド
  _CAMERA_END()   //カメラ操作終了

  _START_BALL_ANM( SCR_BALL_ANM_TYPE_IN, 5, 3, 7 )
  //ポケ非表示フレーム待ち
  _WAIT_BALL_POKE_APP( SCR_BALL_ANM_TYPE_IN )
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()
  //ポケ非表示
  _OBJ_DEL(MMDL_ID_EVENTOBJ_00)
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _WAIT_BALL_ANM( SCR_BALL_ANM_TYPE_IN )
  _MOVE_BALL( SCR_BALL_ANM_TYPE_IN, 5, 3, 7, 3, 8 )

  //自機3歩前
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_move_front )
  _OBJ_ANIME_WAIT()

_RET

fes_append:
  _PLAYER_POS_GET( LWK_POSX, LWK_POSZ )

  //ギタリストメッセージ
  _BALLOONWIN_TALKOBJ_MSG( msg_c03r0901_musician_04 )
  _AB_KEYWAIT_MARK()
  _BALLOONWIN_CLOSE()

_RET

//--------------------------------------------------------------------
//語り部アニメ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_guitar_move_1
  _ANIME_DATA AC_STAY_WALK_D_8F,67
  _ANIME_DATA ACMD_END,0
_ANIME_LABEL  anm_guitar_move_2
  _ANIME_DATA AC_STAY_WALK_D_8F,33
  _ANIME_DATA ACMD_END,0
_ANIME_LABEL  anm_guitar_move_3
  _ANIME_DATA AC_STAY_WALK_D_8F,30
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//自機定位置へ　上から話しかけたとき
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_move_down
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_D_8F,5
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//自機定位置へ　下から話しかけたとき
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_move_up
  _ANIME_DATA AC_WALK_D_8F,4
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//自機定位置へ　右から話しかけたとき
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_move_left
  _ANIME_DATA AC_WALK_D_8F,4
  _ANIME_DATA AC_WALK_L_8F,1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//自機定位置へ　左から話しかけたとき
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_move_right
  _ANIME_DATA AC_WALK_D_8F,4
  _ANIME_DATA AC_WALK_R_8F,1
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//　メロエッタアニメ（最初）
//--------------------------------------------------------------------
_ANIME_LABEL  anm_merodhia_01
  _ANIME_DATA AC_MELODYER_SHAKE,8
  _ANIME_DATA AC_MELODYER_SPIN,7
  _ANIME_DATA ACMD_END,0
//--------------------------------------------------------------------
//　メロエッタアニメ（ステップフォルム）
//--------------------------------------------------------------------
_ANIME_LABEL  anm_merodhia_02
  _ANIME_DATA AC_MELODYER_STEP,11
  _ANIME_DATA ACMD_END,0
//--------------------------------------------------------------------
//　メロエッタアニメ（最後）
//--------------------------------------------------------------------
_ANIME_LABEL  anm_merodhia_03
  _ANIME_DATA AC_MELODYER_SPIN,5
  _ANIME_DATA AC_MELODYER_SPIN_POSE,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//　メロエッタ戻し
//--------------------------------------------------------------------
_ANIME_LABEL  anm_merodhia_normal
  _ANIME_DATA AC_DIR_D,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//自機定位置へ　左から話しかけたとき
//--------------------------------------------------------------------
_ANIME_LABEL  anm_player_move_front
  _ANIME_DATA AC_WALK_U_8F,3
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_staystep_u
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_d
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_l
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_r
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
	

/**************************************************************/
/*  WAITER（アイテム入手）  C03R0901                          */
/**************************************************************/
EVENT_START   ev_c03r0901_waiter_01
  //モーモーミルク入手
  _EASY_TALK_ITEM_EVENT( ITEM_MOOMOOMIRUKU, 1, FE_C03R0901_ITEMGET, msg_c03r0901_waiter_01, msg_c03r0901_waiter_02, msg_c03r0901_waiter_03 )
EVENT_END

/**************************************************************/
/*  ビジネスマン：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_c03r0901_businessman_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03r0901_bussinesman_01 )
EVENT_END

/**************************************************************/
/*  黒服：話しかけ                                            */
/**************************************************************/
EVENT_START   ev_c03r0901_sunglasses_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03r0901_sunglasses_01 )
EVENT_END

/************************************************************/
/*	ベテラントレーナー♀：話しかけ					*/
/************************************************************/
EVENT_START	ev_c03r0901_veteranw_01

	//メロエッタイベント起動前の場合
	IF FLAG_OFF( FE_C03R0901_MELODY ) THEN
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03r0901_mission_add_01 )
	ELSE
	
		IF FLAG_OFF( SYS_FLAG_FES_KINOMI_M ) THEN
			_TALK_OBJ_START()
			_BALLOONWIN_OBJMSG_POS( msg_c03r0901_mission_add_02 ,C03R0901_VETERANW_01 ,POS_DEFAULT )
			_MSGWIN_CLOSE()

			//フェスミッション名格納
			_FMISSION_NAME( 0, FMISSION_ID_ITEM_KINOMI_MOVIE, 0 )

			//フェスミッションが追加されました
			_SE_PLAY( SEQ_SE_FLD_133 )
			_SYSWIN_MSG( msg_c03r0901_mission_add_03, POS_DEFAULT )
			_SE_WAIT()
			_AB_KEYWAIT_MARK()
			_MSGWIN_CLOSE()

			//========================================//
			//フェスミッションオープンフラグON
			_FLAG_SET( SYS_FLAG_FES_KINOMI_M )
			
			$LOCALWORK10 = 2
			
			//========================================//

			_BALLOONWIN_OBJMSG_POS( msg_c03r0901_mission_add_04 ,C03R0901_VETERANW_01 ,POS_DEFAULT )
			_LAST_KEYWAIT()
			_MSGWIN_CLOSE()
		
		ELSE
			_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c03r0901_mission_add_04 )
		ENDIF
	
	ENDIF

EVENT_END

/************************************************************/
/*	FES用　POSイベント								*/
/************************************************************/
EVENT_START	ev_pos_c03r0901_fes_01

	_PLAYER_POS_GET( LWK_POSX, LWK_POSZ )
	
	SWITCH $LWK_POSX
	CASE 4 THEN
		$LWK_POSX = 3
	CASE 5 THEN
		$LWK_POSX = 4
	CASE 6 THEN
		$LWK_POSX = 5
	ENDSWITCH

	_OBJ_ANIME( C03R0901_VETERANW_01, anm_dir_r )
	_OBJ_ANIME_WAIT()
	
	_OBJ_ANIME( C03R0901_VETERANW_01, anm_common_gyoe )
	_OBJ_ANIME_WAIT()

	//ベテラントレーナー近づいてくる
	_OBJ_ANIME_AUTO( C03R0901_VETERANW_01, LWK_POSX, LWK_POSZ, FORCE_TYPE_NOT, 8, DIR_UD )
	_OBJ_ANIME_WAIT()

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	_OBJ_ANIME_WAIT()
	
	_BALLOONWIN_OBJMSG_POS( msg_c03r0901_mission_add_02 ,C03R0901_VETERANW_01 ,POS_DEFAULT )
	_MSGWIN_CLOSE()

	//フェスミッション名格納
	_FMISSION_NAME( 0, FMISSION_ID_ITEM_KINOMI_MOVIE, 0 )

	//フェスミッションが追加されました
	_SE_PLAY( SEQ_SE_FLD_133 )
	_SYSWIN_MSG( msg_c03r0901_mission_add_03, POS_DEFAULT )
	_SE_WAIT()
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()

	//========================================//
	//フェスミッションオープンフラグON
	_FLAG_SET( SYS_FLAG_FES_KINOMI_M )
	//========================================//

	_BALLOONWIN_OBJMSG_POS( msg_c03r0901_mission_add_04 ,C03R0901_VETERANW_01 ,POS_DEFAULT )
	_AB_KEYWAIT_MARK()
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME_AUTO( C03R0901_VETERANW_01, 2, 8, FORCE_TYPE_NOT, 8, DIR_LR )
	_OBJ_ANIME_WAIT()
	
	//========================================//
	$LOCALWORK10 = 2
	//========================================//

EVENT_END
