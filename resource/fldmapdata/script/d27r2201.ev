_EVENT_DATA    ev_d27r2201_baker_01
_EVENT_DATA    ev_d27r2201_swplazmam_01
_EVENT_DATA    ev_d27r2201_swplazmaw_01
_EVENT_DATA    ev_d27r2201_swplazmaw_02
_EVENT_DATA    ev_d27r2201_swplazmam_02
_EVENT_DATA    ev_d27r2201_swplazmam_03
_EVENT_DATA    ev_scene_d27r2201_announce_01
_EVENT_DATA_END

/************************************************************/
/*	SWPLAZMAW：ゼクロムレシラム図鑑登録イベント						*/
/************************************************************/
EVENT_START ev_d27r2201_swplazmaw_02
  
  //初回会話
  IF FLAG_OFF( FE_D27_LEGEND_ZUKAN_LOOK ) THEN
    
    _TALK_OBJ_START()
    
    //SWPLAZMAW：レシラム
    _BALLOONWIN_TALKOBJ_MSG( msg_d27r2201_swplazmaw_pic_01 )
    _BALLOONWIN_CLOSE()
    
    
    //ポケモンウィンドウ表示
    _DISP_POKE_WIN( MONSNO_650, 0, 0, 0 )
    //図鑑登録処理
    _SET_ZUKAN_FLAG( ZUKANCTRL_MODE_SEE, MONSNO_650 )
    
    //システム：登録された
    _SYSWIN_MSG( msg_d27r2201_swplazmaw_pic_02 , POS_DEFAULT )
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()
    
    //SWPLAZMAW：ゼクロム
    _BALLOONWIN_TALKOBJ_MSG( msg_d27r2201_swplazmaw_pic_03 )
    _BALLOONWIN_CLOSE()
    
    //ポケモンウィンドウ表示
    _DISP_POKE_WIN( MONSNO_651, 0, 0, 0 )
    //図鑑登録処理
    _SET_ZUKAN_FLAG( ZUKANCTRL_MODE_SEE, MONSNO_651 )
    
    //システム：登録された
    _SYSWIN_MSG( msg_d27r2201_swplazmaw_pic_04 , POS_DEFAULT )
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()
    
    //SWPLAZMAW：レシラム
    _BALLOONWIN_TALKOBJ_MSG( msg_d27r2201_swplazmaw_pic_05 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()
    
    //========================================/
    //図鑑登録イベント終了
    _FLAG_SET( FE_D27_LEGEND_ZUKAN_LOOK )
    //========================================/
    
  //2回目以降
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r2201_swplazmaw_pic_05 )
  ENDIF
EVENT_END

/**************************************************************/
/*  プラズマ団員：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_d27r2201_baker_01
  
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r2201_baker_01 )
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r2201_baker_end_01 )
  ENDIF
  
EVENT_END


