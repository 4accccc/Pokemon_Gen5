EVENT_END


/**************************************************************/
/*  SCENE_CHANGE：船内放送                                      */
/**************************************************************/
EVENT_START   ev_scene_d27r2201_announce_01
  
  //アナウンスSE再生
  _SE_PLAY( SEQ_SE_SW_PLAZMASHIP_09 )
  _SE_WAIT()
  
  _PLAINWIN_MSG_DOWN( msg_d27r2201_announce_01 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()
  
  //========================================/
  //D27船内放送SCENE_CHANGE無効
  $WK_SCENE_D27_ANNOUNCE = 2
  //========================================/
EVENT_END
