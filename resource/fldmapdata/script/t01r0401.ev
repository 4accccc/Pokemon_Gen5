/*  チラチーノ：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_t01r0401_poke60_01
  _EASY_TALK_POKEVOICE( MONSNO_534, msg_t01r0401_poke_01 )
EVENT_END

