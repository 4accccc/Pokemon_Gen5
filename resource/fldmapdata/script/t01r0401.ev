/************************************************************/
INIT_EVENT_START   ev_zone_t01r0401

  //==================================//
  //ローカルライブキャスター・博士通話状態を変更
  _PERSON_STATE_SET_DOCTOR( DOCTOR_STATE_RESEARCHINSTITUTE )
  //==================================//

INIT_EVENT_END

