EVENT_START   ev_bg_t01r0401_note_01
  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_t01r0401_photo_06 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
EVENT_END

/**************************************************************/
/*  アララギ娘：話しかけ（図鑑評価）                          */
/**************************************************************/
EVENT_START   ev_t01r0401_hakase2_01

  _TALK_OBJ_START()

  //会話するのは初めてか？
  IF FLAG_OFF( FE_T01R0401_HAKASE2_TALK ) THEN

    //アララギ娘：わざわざ　きてくれたのね！
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase2_01 )
    
    //図鑑評価（アララギ娘）へ
    _GLOBAL_CALL SCRID_ZUKAN_DAUGHTER

    //========================================//
    //会話済みフラグON
    _FLAG_SET( FE_T01R0401_HAKASE2_TALK )
    //========================================//

  ELSE

    //アララギ娘：さいきんの　ちょうしは　どう？▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase2_02 )

    //図鑑評価（アララギ娘）へ
    _GLOBAL_CALL SCRID_ZUKAN_DAUGHTER

  ENDIF

  _CALL ev_talk

EVENT_END

ev_talk:

DEFINE_LOCAL	LWK_TALK
$LWK_TALK = 0

//ひかるおまもりチェック
_ITEM_CHK( ITEM_HIKARUOMAMORI, 1, SCWK_ANSWER )

//まるいおまもりを持っている場合
IF $SCWK_ANSWER == TRUE THEN

	//許可証話を聞いていない場合
	IF FLAG_OFF( FE_T01R0401_TALK_04 ) THEN
		$LWK_TALK = 4
	ENDIF
	
ENDIF

//まるいおまもりチェック
_ITEM_CHK( ITEM_MARUIOMAMORI, 1, SCWK_ANSWER )

//まるいおまもりを持っている場合
IF $SCWK_ANSWER == TRUE THEN

	//許可証話を聞いていない場合
	IF FLAG_OFF( FE_T01R0401_TALK_03 ) THEN
		$LWK_TALK = 3
	ENDIF
	
ENDIF

//きょかしょうチェック
_ITEM_CHK( ITEM_KYOKASYOU, 1, SCWK_ANSWER )

//許可証を持っている場合
IF $SCWK_ANSWER == TRUE THEN

	//許可証話を聞いていない場合
	IF FLAG_OFF( FE_T01R0401_TALK_02 ) THEN
		$LWK_TALK = 2
	ENDIF

//許可証を持っていない場合
ELSE

	//許可証持っていない話を聞いていない場合
	IF FLAG_OFF( FE_T01R0401_TALK_01 ) THEN
		$LWK_TALK = 1
	ENDIF
	
ENDIF

SWITCH $LWK_TALK
CASE 0 THEN	//何も話がない

CASE 1 THEN	//初回・許可証を持っていない話
	_BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase2_06 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	//========================================//
	_FLAG_SET(FE_T01R0401_TALK_01)
	//========================================//
	
CASE 2 THEN	//初回・許可証を持っている話
	_BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase2_03 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	//========================================//
	_FLAG_SET(FE_T01R0401_TALK_02)
	//========================================//
	
CASE 3 THEN	//初回・まるいおまもり話
	_BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase2_04 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	//========================================//
	_FLAG_SET(FE_T01R0401_TALK_03)
	//========================================//
	
CASE 4 THEN	//初回・ひかるおまもり話
	_BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase2_05 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
	//========================================//
	_FLAG_SET(FE_T01R0401_TALK_04)
	//========================================//

ENDSWITCH

_RET

/**************************************************************/
/*  アララギ父：話しかけ（図鑑評価）                          */
/**************************************************************/
EVENT_START   ev_t01r0401_hakase1_01

  _TALK_OBJ_START()

  //主人公名代入
  _PLAYER_NAME( 0 )

  //会話するのは初めてか？
  IF FLAG_OFF( FE_T01R0401_HAKASE1_TALK ) THEN

    //アララギ父：ポケモンと　であっておるか？▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase1_01 )
    
    //図鑑評価（アララギ娘）へ
    _GLOBAL_CALL SCRID_ZUKAN_FATHER

    //========================================//
    //会話済みフラグON
    _FLAG_SET( FE_T01R0401_HAKASE1_TALK )
    //========================================//

  ELSE

    //アララギ父：よお　《主人公》！▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase1_02 )

    //図鑑評価（アララギ父）へ
    _GLOBAL_CALL SCRID_ZUKAN_FATHER

  ENDIF

  //つりざおを入手しているか？
  IF FLAG_OFF( SYS_FLAG_SUGOI_TSURI_GET ) THEN
    
	_OBJ_ANIME( T01R0401_HAKASE1_01, anm_common_gyoe )
	_OBJ_ANIME_WAIT()
	
	//そうだったよ　ヒオウギシティ
	_BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase1_03 )
	_MSGWIN_CLOSE()
	
	//すごいつりざおを入手
	_ITEM_EVENT_KEYWAIT( ITEM_SUGOITURIZAO, 1 )
	
	//その　すごいつりざおを　つかえば
	_BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase1_04 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
    
	//========================================//
	//すごいつりざおフラグON・せいそくちリストのつり解禁
	_FLAG_SET( SYS_FLAG_SUGOI_TSURI_GET )
	//========================================//

  ENDIF

EVENT_END

/**************************************************************/
/*  ミルホッグ：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_t01r0401_poke29_01
  _EASY_TALK_POKEVOICE( MONSNO_538, msg_t01r0401_poke29_01 )
EVENT_END

//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0


