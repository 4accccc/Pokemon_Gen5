EVENT_END

/**************************************************************/
/*  アララギ娘：話しかけ（図鑑評価）                          */
/**************************************************************/
EVENT_START   ev_t01r0401_hakase2_01

  _TALK_OBJ_START()

  //会話するのは初めてか？
  IF FLAG_OFF( FE_T01R0401_HAKASE2_TALK ) THEN

    //アララギ娘：わざわざ　きてくれたのね！
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase2_01 )
    
    //図鑑評価（アララギ娘）へ
    _GLOBAL_CALL SCRID_ZUKAN_DAUGHTER
	
    _ITEM_CHK( ITEM_KYOKASYOU, 1, SCWK_ANSWER )
    
    //きょかしょうをもっていない場合
    IF $SCWK_ANSWER == FALSE THEN
    
        _OBJ_ANIME( T01R0401_HAKASE2_01, anm_common_gyoe )
        _OBJ_ANIME_WAIT()
    
        //アララギ娘：イッシュ図鑑にとうろくされる
        _BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase2_06 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()
    
    ENDIF
    
    //========================================//
    //会話済みフラグON
    _FLAG_SET( FE_T01R0401_HAKASE2_TALK )
    //========================================//

  ELSE

    //アララギ娘：さいきんの　ちょうしは　どう？▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase2_02 )

    //図鑑評価（アララギ娘）へ
    _GLOBAL_CALL SCRID_ZUKAN_DAUGHTER

  ENDIF

EVENT_END

/**************************************************************/
/*  アララギ父：話しかけ（図鑑評価）                          */
/**************************************************************/
EVENT_START   ev_t01r0401_hakase1_01

  _TALK_OBJ_START()

  //主人公名代入
  _PLAYER_NAME( 0 )

  //会話するのは初めてか？
  IF FLAG_OFF( FE_T01R0401_HAKASE1_TALK ) THEN

    //アララギ父：ポケモンと　であっておるか？▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase1_01 )
    
    //図鑑評価（アララギ娘）へ
    _GLOBAL_CALL SCRID_ZUKAN_FATHER

    //========================================//
    //会話済みフラグON
    _FLAG_SET( FE_T01R0401_HAKASE1_TALK )
    //========================================//

  ELSE

    //アララギ父：よお　《主人公》！▼
    _BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase1_02 )

    //図鑑評価（アララギ父）へ
    _GLOBAL_CALL SCRID_ZUKAN_FATHER

  ENDIF

  //つりざおを入手しているか？
  IF FLAG_OFF( SYS_FLAG_SUGOI_TSURI_GET ) THEN
    
	_OBJ_ANIME( T01R0401_HAKASE1_01, anm_common_gyoe )
	_OBJ_ANIME_WAIT()
	
	//そうだったよ　ヒオウギシティ
	_BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase1_03 )
	_MSGWIN_CLOSE()
	
	//すごいつりざおを入手
	_ITEM_EVENT_KEYWAIT( ITEM_SUGOITURIZAO, 1 )
	
	//その　すごいつりざおを　つかえば
	_BALLOONWIN_TALKOBJ_MSG( msg_t01r0401_hakase1_04 )
	_LAST_KEYWAIT()
	_MSGWIN_CLOSE()
    
	//========================================//
	//すごいつりざおフラグON・せいそくちリストのつり解禁
	_FLAG_SET( SYS_FLAG_SUGOI_TSURI_GET )
	//すごいつりざおヒントメダル取得
  _SET_MEDAL_HINT_ACHIEVE( MDLID_FISHING_LV1 )
	//========================================//

  ENDIF

EVENT_END

