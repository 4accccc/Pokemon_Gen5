//----------------------------------------------------------------------------
//	獣道呼び出しIDワーク
//-----------------------------------------------------------------------------
DEFINE_LOCAL  LWK_ANIMAL_TRAIL_ID

//--------------------------------------------------------------------
// 獣道呼び出し関数
//--------------------------------------------------------------------
animal_trail_call:
{
  // 進入確認メッセージ
  _SYSWIN_MSG( msg_animal_trail_01, POS_DOWN )

  // 確認
  _YES_NO_WIN( SCWK_ANSWER )

  // メッセージ終了
  _SYSWIN_CLOSE()
  _SE_WAIT()

  IF $SCWK_ANSWER == SCR_YES THEN
    // 移動呼び出し
    _SE_PLAY( SEQ_SE_KAIDAN )
    _WARP_ANIMAL_TRAIL( LWK_ANIMAL_TRAIL_ID )
  ENDIF
}
_RET

//----------------------------------------------------------------------------
//	獣道01
//-----------------------------------------------------------------------------
EVENT_START  ev_animal_trail_01
  $LWK_ANIMAL_TRAIL_ID = 0
  _CALL animal_trail_call

  // メダル:けものみちのたつじん
  _FLAG_SET( MDL_FLAG_ANIMALTRAIL_01 )
EVENT_END

