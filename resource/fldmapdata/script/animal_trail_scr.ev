	.text

  .include	"scr_seq_def.h"
  .include  "animal_trail_scr_def.h"
  .include  "../../../prog/include/msg/script/msg_animal_trail_scr.h"

//--------------------------------------------------------------------
//		スクリプトテーブル ※ 獣道の数（20個）だけ必要です
//--------------------------------------------------------------------
_EVENT_DATA		ev_animal_trail_01
_EVENT_DATA		ev_animal_trail_02
_EVENT_DATA		ev_animal_trail_03
_EVENT_DATA		ev_animal_trail_04
_EVENT_DATA		ev_animal_trail_05
_EVENT_DATA		ev_animal_trail_06
_EVENT_DATA		ev_animal_trail_07
_EVENT_DATA		ev_animal_trail_08
_EVENT_DATA		ev_animal_trail_09
