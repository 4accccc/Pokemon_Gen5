// èbìπåƒÇ—èoÇµä÷êî
//--------------------------------------------------------------------
animal_trail_call:
{
  // êiì¸ämîFÉÅÉbÉZÅ[ÉW
  _SYSWIN_MSG( msg_animal_trail_01, POS_DOWN )

  // ämîF
  _YES_NO_WIN( SCWK_ANSWER )

  // ÉÅÉbÉZÅ[ÉWèIóπ
	_SYSWIN_CLOSE()

  IF $SCWK_ANSWER == SCR_YES THEN
    // à⁄ìÆåƒÇ—èoÇµ
    _WARP_ANIMAL_TRAIL( LWK_ANIMAL_TRAIL_ID )
  ENDIF
}
_RET

