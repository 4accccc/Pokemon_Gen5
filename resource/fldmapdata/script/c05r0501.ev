  .include  "oldc05r0501.h"
  .include  "oldc05r0501_def.h"
  
  //@author Mizuguchi_Mai
  //@author fujimura_souichirou（クリア後のライバル戦）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_reserve_c05r0501_sage6_01
_EVENT_DATA    ev_c05r0501_sage6_01
_EVENT_DATA    ev_c05r0501_swgoddes1_01
_EVENT_DATA    ev_c05r0501_swgoddes2_01
_EVENT_DATA    ev_c05r0501_hakaim_01
_EVENT_DATA    ev_c05r0501_hakaim_02
_EVENT_DATA    ev_c05r0501_hakaim_03
_EVENT_DATA    ev_c05r0501_hakaiw_01
_EVENT_DATA    ev_c05r0501_poke31_01
_EVENT_DATA    ev_c05r0501_poke41_01
_EVENT_DATA    ev_c05r0501_poke38_01
_EVENT_DATA    ev_c05r0501_poke17_01
_EVENT_DATA    ev_c05r0501_poke22_01
_EVENT_DATA    ev_c05r0501_swrival_01
_EVENT_DATA    ev_zone_c05r0501
_EVENT_DATA    ev_scene_c05r0501_link_event
_EVENT_DATA    ev_reserve_c05r0501_link_event_ret
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//------------------------------注意--------------------------------//
//
//  LOCALWORK15をリンクイベントで使用。
//                                                                  //
//------------------------------------------------------------------//



/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_c05r0501
  
  //データコンバートフラグチェック
  _DATACONV_GET_FLAG( DATACONV_FLAG_GAME_CLEAR, LOCALWORK15 )
  
  _DEBUG_PRINT_WK(LOCALWORK15)
  
  IF $LOCALWORK15 == 1 && $WK_SYS_LINK_EVENT_06 == 0 && $WK_SCENE_C05R0501_LINK_EVENT == 1 THEN
    
    //========================================//
    //ゾロア非表示に
    _FLAG_SET(FV_C05R0501_POKE22_01)
    //リンクイベントに関与しないNPC非表示に
    _FLAG_SET(FV_C05R0501_PEAPLE_01)
    //ゾロアークを表示
    _FLAG_RESET(FV_C05R0501_POKE23_01)
    //SCENE_CHANGE起動
    $WK_SCENE_C05R0501_LINK_EVENT = 2
    //========================================//
    
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*		SCENE_CHANGE：リンクイベント                             */
/************************************************************/
EVENT_START   ev_scene_c05r0501_link_event

  //アニメ：ゾロアーク接近
  _OBJ_ANIME_AUTO( C05R0501_POKE23_01, 7, 21, FORCE_TYPE_NPC, 16, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  _BALLOONWIN_OBJMSG_POS(msg_c05r0501_memory_01,C05R0501_POKE23_01 , POS_DEFAULT )
  _VOICE_PLAY( MONSNO_530, 0 )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  _MAP_FADE_BLACK_OUT_SLOW()
  //過去イベント・ホドモエ起動
  _RESERVE_SCRIPT( SCRID_RESERVE_OLDC05R0501_EVENT_01 )
  _MAP_FADE_END_CHECK()
  //マップチェンジ
  _MAP_CHANGE_NO_FADE( ZONE_ID_OLDC05R0501, 7, 0, 18, DIR_DOWN )
  
EVENT_END

/************************************************************/
/*		SCENE_CHANGE：リンクイベント                             */
/************************************************************/
EVENT_START   ev_reserve_c05r0501_link_event_ret
   
  //ブラックイン
  _MAP_FADE_BLACK_IN_SLOW()
  _MAP_FADE_END_CHECK()

  //========================================//
  //SCENE_CHANGE無効
  $WK_SCENE_C05R0501_LINK_EVENT = 3
  //リンクイベント起動終了
  $WK_SYS_LINK_EVENT_06 = 1
  //リンクイベントに関与しないNPCを表示
  _FLAG_RESET(FV_C05R0501_PEAPLE_01)
  //========================================//
  
  //ゾロア未入手ならゾロア表示
  IF FLAG_OFF( FE_C05R0501_POKE22_GET ) THEN
    //========================================//
    _FLAG_RESET(FV_C05R0501_POKE22_01)
    //========================================//
  ENDIF
  
EVENT_END

//=============================================================
// RESERVE：初回入室時イベント
//=============================================================
EVENT_START ev_reserve_c05r0501_sage6_01

  //アニメ：主人公中央へ
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 7, 20, FORCE_TYPE_NPC, 8, DIR_LR)
  
  _TIME_WAIT(16)
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()

  //フィールド上にライバル配置
  _OBJ_ADD_EX( 7, 25, DIR_UP, MMDL_ID_EVENTOBJ_00, SWRIVAL, MV_DMY )
  
  _OBJ_ANIME_WAIT()
  
  //アニメ：ライバル主人公脇へ
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 20, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ロット：あらためて
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_01,C05R0501_SAGE6_01, POS_UL ) 
  _MSGWIN_CLOSE()

  //主人公名代入
  _PLAYER_NAME( 0 )
  //ライバル名タグに代入
  _RIVAL_NAME( 1 )
  
  //ライバル：なあ、おまえも
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_swrival_01,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //ロット：正しく言うなら
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_02,C05R0501_SAGE6_01, POS_UL ) 
  _MSGWIN_CLOSE()
  
  //ライバル：オレは
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_swrival_02,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //アニメ：ロット「！」
  _OBJ_ANIME( C05R0501_SAGE6_01,anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //ロット：そうであったか
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_03,C05R0501_SAGE6_01, POS_UL ) 
  _MSGWIN_CLOSE()
  
  //アニメ：ライバルその場歩き
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,anm_swrival_steystep_u )
  _OBJ_ANIME_WAIT()

  //ライバル：あやまるだけかよ！
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_swrival_03,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //ライバル：オレのポケモンは！？
  _GIZAWIN_OBJMSG_POS( msg_c05r0501_swrival_04 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ロット：おまえのポケモンは？
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_05,C05R0501_SAGE6_01, POS_UL ) 
  _MSGWIN_CLOSE()
  
   //主人公名代入
  _PLAYER_NAME( 0 )
  
  //ライバル：もういいって！
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_swrival_05,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 25, FORCE_TYPE_NPC, 8, DIR_LR)
  _TIME_WAIT(8)
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ライバル動作OBJ消す
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ロット：なんとおろかで　あったか
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_06,C05R0501_SAGE6_01, POS_UL ) 
  
  //主人公名代入
  _PLAYER_NAME( 0 )
  
  //ロット：ごらんの通りだ
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_07,C05R0501_SAGE6_01, POS_UL ) 

  {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //いいえ
  IF $SCWK_ANSWER == SCR_NO THEN
    
    //ロット：きがかわったら
    _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_11,C05R0501_SAGE6_01, POS_UL ) 
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  //はい
  ELSE
    _CALL ev_c05r0501_poke22_get
  ENDIF
  }
  
  //========================================//
  //じめんジムストッパー解除
  _FLAG_SET(FV_C05_STOPPER_02)
  //リンクイベント起動条件をセット（初回入室を終えていないと起動しない）
  $WK_SCENE_C05R0501_LINK_EVENT = 1
  //========================================//
EVENT_END

/**************************************************************/
/* 			SAGE6：話しかけ			  */
/**************************************************************/
EVENT_START		ev_c05r0501_sage6_01
  
  //ゾロアを貰っていない
  IF FLAG_OFF( FE_C05R0501_POKE22_GET ) THEN
  
    _TALK_OBJ_START()
    
    //ロット：ゾロアを
    _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_08,C05R0501_SAGE6_01, POS_UL ) 

    {
    _YES_NO_WIN( SCWK_ANSWER )
    
    //いいえ
    IF $SCWK_ANSWER == SCR_NO THEN
      
      //ロット：気が変わったら
      _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_11,C05R0501_SAGE6_01, POS_UL ) 
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
    
    //はい
    ELSE
      _CALL ev_c05r0501_poke22_get
    ENDIF
    }
  
  //ゾロア入手後
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05r0501_sage6_13 )

  ENDIF
  
EVENT_END

/**************************************************************/
/* 			CALL：ゾロア入手処理			  */
/**************************************************************/
ev_c05r0501_poke22_get:

  //手持ちポケモンをカウントして回答を分岐する
  {
  DEFINE_LOCAL LWK_POKE_COUNT
  _GET_PARTY_POKE_COUNT (LWK_POKE_COUNT,POKECOUNT_MODE_TOTAL)
  
  //手持ちがいっぱいなら
  IF $LWK_POKE_COUNT == 6 THEN
    //ロット：これ以上連れて歩けない
    _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_10,C05R0501_SAGE6_01, POS_DEFAULT ) 
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //手持ちに空きがある
  ELSE
  
    //おお！たのむぞ！
    _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_09,C05R0501_SAGE6_01, POS_UL ) 
    _MSGWIN_CLOSE()
    
    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
    
    //アニメ：ゾロア主人公に隣接
    
    //初回入室時のケース
    IF $LCW_POSX == 7 && $LCW_POSZ == 20 THEN
      _OBJ_ANIME_AUTO( C05R0501_POKE22_01, 7, 19, FORCE_TYPE_NPC, 8, DIR_UD)
    //ロットに左から話しかけたケース
    ELSIF $LCW_POSX == 6 && $LCW_POSZ == 18 THEN
      _OBJ_ANIME_AUTO( C05R0501_POKE22_01, 6, 17, FORCE_TYPE_NPC, 8, DIR_UD)
    //それ以外のケース（主人公の右に隣接）
    ELSE
      $LCW_POSX += 1
      _OBJ_ANIME_AUTO( C05R0501_POKE22_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD)
    ENDIF
    
    _OBJ_ANIME_WAIT()
    
    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
    
    //アニメ：主人公とゾロア向き合う
    
    //初回入室時のケース
    IF $LCW_POSX == 7 && $LCW_POSZ == 20 THEN
      _OBJ_ANIME( C05R0501_POKE22_01, anm_staystep_d)
    //ロットに左から話しかけたケース
    ELSIF $LCW_POSX == 6 && $LCW_POSZ == 18 THEN
      _OBJ_ANIME( C05R0501_POKE22_01, anm_staystep_d)
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
    //それ以外のケース（主人公の右に隣接）
    ELSE
      _OBJ_ANIME( C05R0501_POKE22_01, anm_staystep_l)
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r)
    ENDIF
    
    _OBJ_ANIME_WAIT()
    
    _TIME_WAIT( 32 )
    
    //ゾロア動作モデル削除
    _OBJ_DEL(C05R0501_POKE22_01)
    
    //ポケモン入手処理
    _ADD_POKEMON_TO_PARTY( SCWK_ANSWER, MONSNO_529, 0, 25 )
    
    //主人公名代入
    _PLAYER_NAME( 0 )
    
    //手に入れた
    _ME_PLAY( SEQ_ME_POKEGET )
    _SYSWIN_MSG(msg_c05r0501_poke_01, POS_DEFAULT)
    _ME_WAIT()
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()
    
    //アニメ：主人公ロットに向き合う
    IF $LCW_POSX == 6 && $LCW_POSZ == 18 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r)
    ELSIF $LCW_POSX == 7 && $LCW_POSZ == 17 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d)
    ELSIF $LCW_POSX == 7 && $LCW_POSZ == 19 THEN
      _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u)
    ENDIF
    
    _OBJ_ANIME_WAIT()
    
    //データコンバート・クリアチェック
    _DATACONV_GET_FLAG( DATACONV_FLAG_GAME_CLEAR, LOCALWORK15 )
    
    //ロット：そのゾロアは(クリアデータあり）
    IF $LOCALWORK15 >= 1 THEN
      _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_12,C05R0501_SAGE6_01, POS_UL ) 
    
    //ロット：そのゾロアは(クリアデータなし）
    ELSE
      _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_12a,C05R0501_SAGE6_01, POS_UL ) 
    ENDIF
    
    
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //========================================//
    //ポケモン入手イベント終了
    _FLAG_SET(FE_C05R0501_POKE22_GET)
    //ゾロア非表示に
    _FLAG_SET(FV_C05R0501_POKE22_01)
    //========================================//
    
  ENDIF
  
  }

_RET

ball_in:

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  _START_BALL_ANM( SCR_BALL_ANM_TYPE_IN, 8, 3, 18 )
  //ポケ非表示フレーム待ち
  _WAIT_BALL_POKE_APP( SCR_BALL_ANM_TYPE_IN )
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()
  //ポケ非表示
  _OBJ_DEL(C05R0501_POKE22_01)
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _WAIT_BALL_ANM( SCR_BALL_ANM_TYPE_IN )
  _MOVE_BALL( SCR_BALL_ANM_TYPE_IN, LCW_POSX, 3, LCW_POSZ, 3, 8 )
_RET

//--------------------------------------------------------------------
//	ライバル：高速その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swrival_steystep_u
	_ANIME_DATA	AC_STAY_WALK_U_4F,2
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/* 			GODDES1：話しかけ			  */
/**************************************************************/
EVENT_START		ev_c05r0501_swgoddes1_01
  //ゲームクリア前
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05r0501_goddess1_01 )
  //クリア後
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05r0501_goddess1_02 )
  ENDIF
EVENT_END


