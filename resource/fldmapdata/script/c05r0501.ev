/* 			POKE17：話しかけ（ミネズミ			  */
/**************************************************************/
EVENT_START		ev_c05r0501_poke17_01
  _EASY_TALK_POKEVOICE( MONSNO_537, msg_c05r0501_poke4_01 )
EVENT_END

