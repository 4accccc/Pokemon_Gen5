_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

//=============================================================
// RESERVE：ポケモンセンターガイドイベント
//=============================================================
EVENT_START ev_reserve_c05r0501_sage6_01

  //アニメ：主人公中央へ
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 7, 20, FORCE_TYPE_NPC, 8, DIR_LR)
  
  _TIME_WAIT(16)

  //フィールド上にライバル配置
  _OBJ_ADD_EX( 7, 25, DIR_UP, MMDL_ID_EVENTOBJ_00, SWRIVAL, MV_DMY )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  _OBJ_ANIME_WAIT()
  
  //アニメ：ライバル主人公脇へ
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 20, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ロット：あらためて
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_01,C05R0501_SAGE6_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //ライバル名タグに代入
  _RIVAL_NAME(1)
  
  //ライバル：なあ、おまえも
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_swrival_01,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //ロット：正しく言うなら
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_02,C05R0501_SAGE6_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //ライバル：オレは
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_swrival_02,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //アニメ：ロット「！」
  _OBJ_ANIME( C05R0501_SAGE6_01,anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //ロット：そうであったか
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_03,C05R0501_SAGE6_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //アニメ：ライバルその場歩き
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00,anm_swrival_steystep_u )
  _OBJ_ANIME_WAIT()

  //ライバル：あやまるだけかよ！
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_swrival_03,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //ライバル：オレのポケモンは！？
  _GIZAWIN_OBJMSG_POS( msg_c05r0501_swrival_04 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ロット：おまえのポケモンは？
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_05,C05R0501_SAGE6_01, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
   //主人公名代入
  _PLAYER_NAME( 0 )
  
  //ライバル：もういいって！
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_swrival_05,MMDL_ID_EVENTOBJ_00, POS_DEFAULT ) 
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 6, 25, FORCE_TYPE_NPC, 8, DIR_LR)
  _TIME_WAIT(8)
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //ライバル動作OBJ消す
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //ロット：なんとおろかで　あったか
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_06,C05R0501_SAGE6_01, POS_DEFAULT ) 
  
  //主人公名代入
  _PLAYER_NAME( 0 )
  
  //ロット：ごらんの通りだ
  _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_07,C05R0501_SAGE6_01, POS_DEFAULT ) 

  {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //いいえ
  IF $SCWK_ANSWER == SCR_NO THEN
    
    //ロット：きがかわったら
    _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_11,C05R0501_SAGE6_01, POS_DEFAULT ) 
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
  
  //はい
  ELSE
    _CALL ev_c05r0501_poke22_get
  ENDIF
  }
  
  //========================================//
  //じめんジムストッパー解除
  _FLAG_SET(FV_C05_STOPPER_02)
  //========================================//
EVENT_END

/**************************************************************/
/* 			SAGE6：話しかけ			  */
/**************************************************************/
EVENT_START		ev_c05r0501_sage6_01
  
  //ゾロアを貰っていない
  IF FLAG_OFF( FE_C05R0501_POKE22_GET ) THEN
  
    _TALK_START_SE_PLAY()
    
    //ロット：ゾロアを
    _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_08,C05R0501_SAGE6_01, POS_DEFAULT ) 

    {
    _YES_NO_WIN( SCWK_ANSWER )
    
    //いいえ
    IF $SCWK_ANSWER == SCR_NO THEN
      
      //ロット：気が変わったら
      _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_11,C05R0501_SAGE6_01, POS_DEFAULT ) 
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()
    
    //はい
    ELSE
      _CALL ev_c05r0501_poke22_get
    ENDIF
    }
  
  //ゾロア入手後
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05r0501_sage6_13 )
  ENDIF
  
EVENT_END

/**************************************************************/
/* 			CALL：ゾロア入手処理			  */
/**************************************************************/
ev_c05r0501_poke22_get:

  //手持ちポケモンをカウントして回答を分岐する
  {
  DEFINE_LOCAL LWK_POKE_COUNT
  _GET_PARTY_POKE_COUNT (LWK_POKE_COUNT,POKECOUNT_MODE_TOTAL)
  
  //手持ちがいっぱいなら
  IF $LWK_POKE_COUNT == 6 THEN
    //ロット：これ以上連れて歩けない
    _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_10,C05R0501_SAGE6_01, POS_DEFAULT ) 
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //手持ちに空きがある
  ELSE
  
    //おお！たのむぞ！
    _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_09,C05R0501_SAGE6_01, POS_DEFAULT ) 
    _MSGWIN_CLOSE()
    
    //ポケモンモンスターボールに入る
    //_CALL ball_in
    
    //【仮】ゾロア動作モデル削除
    _OBJ_DEL(C05R0501_POKE22_01)
    
    //ポケモン入手処理
    _ADD_POKEMON_TO_PARTY( SCWK_ANSWER, MONSNO_529, 0, 25 )
    
    //【仮】手に入れた（メッセージ仮）
    _ME_PLAY( SEQ_ME_POKEGET )
    _SYSWIN_MSG(msg_c05r0501_sage6_09, POS_DEFAULT)
    _ME_WAIT()
    _AB_KEYWAIT_MARK()
    _SYSWIN_CLOSE()
    
    //ロット：そのゾロアは
    _BALLOONWIN_OBJMSG_POS( msg_c05r0501_sage6_12,C05R0501_SAGE6_01, POS_DEFAULT ) 
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()
    
    //========================================//
    //ポケモン入手イベント終了
    _FLAG_SET(FE_C05R0501_POKE22_GET)
    //ゾロア非表示に
    _FLAG_SET(FV_C05R0501_POKE22_01)
    //========================================//
    
  ENDIF
  
  }

_RET

ball_in:

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  _START_BALL_ANM( SCR_BALL_ANM_TYPE_IN, 8, 3, 18 )
  //ポケ非表示フレーム待ち
  _WAIT_BALL_POKE_APP( SCR_BALL_ANM_TYPE_IN )
  _WHITE_OUT()
  _DISP_FADE_END_CHECK()
  //ポケ非表示
  _OBJ_DEL(C05R0501_POKE22_01)
  _WHITE_IN()
  _DISP_FADE_END_CHECK()
  _WAIT_BALL_ANM( SCR_BALL_ANM_TYPE_IN )
  _MOVE_BALL( SCR_BALL_ANM_TYPE_IN, LCW_POSX, 3, LCW_POSZ, 3, 8 )
_RET

