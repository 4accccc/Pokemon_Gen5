    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05r0501_goddess2_01 )
  //クリア後
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c05r0501_goddess2_02 )
  ENDIF
EVENT_END

