  //@author fujimura_souichirou（ＢＧメッセージ設置）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_pos_d27r0601_warp_01
_EVENT_DATA    ev_zone_d27r0601
_EVENT_DATA    ev_init_d27r0601
_EVENT_DATA    ev_recover_d27r0601
_EVENT_DATA    ev_scene_d27r0601_swsage1_01
_EVENT_DATA    ev_d27r0601_ninja_01
_EVENT_DATA    ev_d27r0601_ninja_02
_EVENT_DATA    ev_d27r0601_ninja_03
_EVENT_DATA    ev_d27r0601_swrival_01
_EVENT_DATA    ev_d27r0601_poke32_01
_EVENT_DATA    ev_pos_d27r0601_stopper_01
_EVENT_DATA    ev_bg_d27r0601_monitor_01
_EVENT_DATA    ev_bg_d27r0601_monitor_02
_EVENT_DATA    ev_bg_d27r0601_monitor_03
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//																	//
//	特殊な接続に LOCALWORK15 を使用ししています。     //
//	同マップ内の使用を禁止します。									//
//------------------------------------------------------------------//

//バージョン取得
DEFINE_LOCAL LCWK_VERSION
//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*					ZONE_CHANGE_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_zone_d27r0601
  
  //

INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_init_d27r0601
  
  //ダークトリニティ戦終了後
  IF $WK_SCENE_D27R0601_SWSAGE1_01 == 4 && FLAG_OFF( FV_D27R0601_SWRIVAL_01 ) THEN
    _OBJ_POS_CHANGE(D27R0601_SWRIVAL_01,8,0,6,DIR_RIGHT)
  //ダークトリニティ戦終了前
  ELSIF $WK_SCENE_D27R0601_SWSAGE1_01 >= 2 && FLAG_OFF( FV_D27R0601_SWRIVAL_01 ) THEN
    _OBJ_POS_CHANGE(D27R0601_SWRIVAL_01,8,0,6,DIR_RIGHT)
  
  ENDIF
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_RECOVER_LABEL  						*/
/************************************************************/
INIT_EVENT_START	ev_recover_d27r0601

  //

INIT_EVENT_END

/************************************************************/
/*					SCENE_CHANGE：  						*/
/************************************************************/
INIT_EVENT_START	ev_scene_d27r0601_swsage1_01
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //========================================//
  //ダークトリニティ・ライバル表示
  _FLAG_RESET( FV_D27R0601_NINJA_01 )
  _FLAG_RESET( FV_D27R0601_SWRIVAL_01 )
  //========================================//
  
  //アニメ：主人公中央に移動
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER , 11, 7, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //カメラ操作　ゲーチスを中央に
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,753664,0,212992,80 )
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //ゲーチス：……きましたか
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_swsage01_03_01 , D27R0601_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチス振り返る
  _OBJ_ANIME( D27R0601_SWSAGE1_01 ,anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：アクロマめ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_swsage01_03_02 , D27R0601_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチス1歩右へ
  _OBJ_ANIME_AUTO( D27R0601_SWSAGE1_01 , 12, 2, FORCE_TYPE_NOT, 16, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：さてアナタは
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_swsage01_03_03 , D27R0601_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチス1歩下へ
  _OBJ_ANIME_AUTO( D27R0601_SWSAGE1_01 , 12, 3, FORCE_TYPE_NOT, 16, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：キュレムが
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_swsage01_03_04 , D27R0601_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチス1歩下へ
  _OBJ_ANIME_AUTO( D27R0601_SWSAGE1_01 , 13, 5, FORCE_TYPE_NOT, 16, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：キュレムはからっぽ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_swsage01_03_05 , D27R0601_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (40)
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //アニメ：ゲーチス1歩下へ
  _OBJ_ANIME_AUTO( D27R0601_SWSAGE1_01 , 13, 7, FORCE_TYPE_NOT, 16, DIR_LR)
  _TIME_WAIT( 40 )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_r)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス：そうです！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_swsage01_03_06 , D27R0601_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ダークトリニティ動作モデル生成
  _OBJ_ADD( D27R0601_NINJA_01 )
  
  //アニメ：ダークトリニティ出現
  _OBJ_ANIME( D27R0601_NINJA_01 , anm_ninja_coming_01)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D27R0601_NINJA_01 , anm_staystep_r)
  _OBJ_ANIME( D27R0601_SWSAGE1_01 , anm_staystep_l)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ：ゲーチスさま
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja1_03_01 , D27R0601_NINJA_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ゲーチス：いよいよ！
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_swsage01_03_07 , D27R0601_SWSAGE1_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ゲーチス退場
  _OBJ_ANIME( D27R0601_SWSAGE1_01 , anm_swsage1_bye_01)
  _TIME_WAIT( 32 )
  _OBJ_ANIME( D27R0601_NINJA_01 , anm_staystep_d)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
  //ゲーチス動作モデル削除
  _OBJ_DEL( D27R0601_SWSAGE1_01 )
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _SE_WAIT()
  
  //ライバル動作モデル生成
  _OBJ_ADD( D27R0601_SWRIVAL_01 )
  
  //アニメ：ライバルワープパネルに登場
  _OBJ_ANIME( D27R0601_SWRIVAL_01 ,anm_swrival_warp_in )
  _OBJ_ANIME_WAIT()
  
  //アニメ：ダークトリニティふりむく
  _OBJ_ANIME( D27R0601_NINJA_01 ,anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER ,anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //ライバル：まてよ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_03_01 , D27R0601_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ダークトリニティ：……ああ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja1_03_02 , D27R0601_NINJA_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //レパルダス動作モデル生成
  _OBJ_ADD_EX( 10, 6, DIR_LEFT, MMDL_ID_EVENTOBJ_00, POKE32, MV_DMY )
  
  //レパルダス：グルルゥー！
  _VOICE_PLAY(MONSNO_653,0)
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_poke32_03_01 , MMDL_ID_EVENTOBJ_00 ,POS_DEFAULT )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル「！」
  _OBJ_ANIME( D27R0601_SWRIVAL_01 ,anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ：5ねんまえ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja1_03_03 , D27R0601_NINJA_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル：そんな
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_03_02 , D27R0601_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ダークトリニティ：もろいな
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja1_03_04 , D27R0601_NINJA_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ダークトリニティと主人公向き合う
  _OBJ_ANIME( D27R0601_NINJA_01 ,anm_staystep_d )
  _OBJ_ANIME( MMDL_ID_PLAYER ,anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //トレーナー戦
  _TRAINER_BTL_SET( TRID_NINJA_01, 0 )
  _CALL ev_battle_check
  
  _OBJ_ADD( D27R0601_NINJA_02 )
  _OBJ_ADD( D27R0601_NINJA_03 )
  
  //アニメ：ダークトリニティ出現
  _OBJ_ANIME( D27R0601_NINJA_02 , anm_ninja_coming_01)
  _OBJ_ANIME( D27R0601_NINJA_03 , anm_ninja_coming_01)
  _OBJ_ANIME_WAIT()
  
  
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja2_03_00 , D27R0601_NINJA_02 ,POS_DEFAULT )
  _MSGWIN_CLOSE()

  //========================================//
  //ゲーチス非表示
  _FLAG_SET( FV_D27R0601_SWSAGE1_01 )
  //D27R0701 SCENE_CHANGE無効
  $WK_SCENE_D27R0601_SWSAGE1_01 = 2
  //D27R0701 STOPPER有効
  $WK_SCENE_D27R0601_STOPPER_01 = 1
  //ヴィオ非表示
  _FLAG_SET( FV_D27R1001_SWSAGE7_01 )
  _FLAG_SET( FV_D27R1301_SWSAGE7_01 )
  //========================================//

INIT_EVENT_END

//--------------------------------------------------------------------
//	ライバル：ワープして登場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swrival_warp_in
  _ANIME_DATA	AC_WARP_DOWN,1
  _ANIME_DATA	AC_WALK_U_8F,3
  _ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	ゲーチス：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swsage1_bye_01
  _ANIME_DATA	AC_WALK_D_8F,2
  _ANIME_DATA	AC_WALK_L_8F,2
  _ANIME_DATA	AC_WALK_D_8F,4
	_ANIME_DATA	ACMD_END,0


/**************************************************************/
/* ダークトリニティ（１）：話しかけ                                         */
/**************************************************************/
EVENT_START   ev_d27r0601_ninja_01
  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja1_03_07 , D27R0601_NINJA_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
EVENT_END

/**************************************************************/
/* ダークトリニティ（２）：話しかけ                                         */
/**************************************************************/
EVENT_START   ev_d27r0601_ninja_02
  
  //戦闘済みかチェック
  _TRAINER_FLAG_CHECK( TRID_NINJA_02, SCWK_ANSWER )
  
  IF $SCWK_ANSWER == FALSE THEN
    _TALK_OBJ_START()
    
    _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja2_03_01 , D27R0601_NINJA_02 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //戦闘処理
    _TRAINER_BTL_SET( TRID_NINJA_02, 0 )
    _CALL ev_battle_check
    
    _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja2_03_02 , D27R0601_NINJA_02 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    //========================================//
    //トレーナー戦進行状況に++
    $WK_SCENE_D27R0601_SWSAGE1_01 += 1
    //トレーナーフラグセット
    _TRAINER_FLAG_SET( TRID_NINJA_02 )
    //========================================//
    
    //全員に勝ったなら終了イベントを起動
    IF $WK_SCENE_D27R0601_SWSAGE1_01 == 4 THEN
      _CALL ev_d27r0601_ninjabtl_end
    ENDIF
  
  //戦闘後
  ELSE
  
    //条件で会話分岐
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0601_ninja2_03_02 )
    
  ENDIF
  
EVENT_END

/**************************************************************/
/* ダークトリニティ（３）：話しかけ                                         */
/**************************************************************/
EVENT_START   ev_d27r0601_ninja_03
  
  //戦闘済みかチェック
  _TRAINER_FLAG_CHECK( TRID_NINJA_03, SCWK_ANSWER )
  
  IF $SCWK_ANSWER == FALSE THEN
    _TALK_OBJ_START()
    
    _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja3_03_01 , D27R0601_NINJA_03 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //戦闘処理
    _TRAINER_BTL_SET( TRID_NINJA_03, 0 )
    _CALL ev_battle_check
    
    _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja3_03_02 , D27R0601_NINJA_03 ,POS_DEFAULT )
    _MSGWIN_CLOSE()
    //========================================//
    //トレーナー戦進行状況に++
    $WK_SCENE_D27R0601_SWSAGE1_01 += 1
    //トレーナーフラグセット
    _TRAINER_FLAG_SET( TRID_NINJA_03 )
    //========================================//
    
    //全員に勝ったなら終了イベントを起動
    IF $WK_SCENE_D27R0601_SWSAGE1_01 == 4 THEN
      _CALL ev_d27r0601_ninjabtl_end
    ENDIF
  
  //戦闘後
  ELSE
  
    //条件で会話分岐
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0601_ninja2_03_02 )
    
  ENDIF
EVENT_END

/**************************************************************/
/* CALL：ダークトリニティ戦終了イベント */
/**************************************************************/
ev_d27r0601_ninjabtl_end:
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u)
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ：……まあいい
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja1_03_05 , D27R0601_NINJA_01 ,POS_DEFAULT )
  
  //ダークトリニティ：ライバルの方を向く
  _OBJ_ANIME( D27R0601_NINJA_01 , anm_staystep_l)
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ：オマエ……
  _BALLOONWIN_OBJMSG_POS( msg_d27r0601_ninja1_03_06 , D27R0601_NINJA_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //【仮】ボール投げ演出
  
  //アニメ：ダークトリニティ退場
  _OBJ_ANIME( D27R0601_NINJA_01 , anm_ninja_bye_01)
  _OBJ_ANIME( D27R0601_NINJA_02 , anm_ninja_bye_01)
  _OBJ_ANIME( D27R0601_NINJA_03 , anm_ninja_bye_01)
  _OBJ_ANIME_WAIT()
  
  //ダークトリニティ動作モデル削除
  _OBJ_DEL( D27R0601_NINJA_01 )
  _OBJ_DEL( D27R0601_NINJA_02 )
  _OBJ_DEL( D27R0601_NINJA_03 )
  
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_l)
  _OBJ_ANIME_WAIT()
  
  //ライバル：なあ
  _BALLOONWIN_OBJMSG_POS( msg_d27r0101_swrival_03_03 , D27R0601_SWRIVAL_01 ,POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //========================================//
  //D27R0701 STOPPER無効
  $WK_SCENE_D27R0601_STOPPER_01 = 2
  //ダークトリニティ非表示
  _FLAG_SET( FV_D27R0601_NINJA_01 )
  //W21チェレン非表示
  _FLAG_SET( FV_W21_SWLEADER1_01 )
  //========================================//
  
_RET

/************************************************************/
/*					話しかけ：ライバル				*/
/************************************************************/
EVENT_START	ev_d27r0601_swrival_01
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //条件で会話分岐
  
  //ダークトリニティ戦終了前
  IF $WK_SCENE_D27R0601_SWSAGE1_01 < 4 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swrival_03_02 )
    
  //ダークトリニティ戦終了後
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_d27r0101_swrival_03_03 )
  ENDIF
  
EVENT_END

/************************************************************/
/*					話しかけ：レパルダス				*/
/************************************************************/
EVENT_START	ev_d27r0601_poke32_01
  _EASY_TALK_POKEVOICE( MONSNO_547, msg_d27r0601_poke32_03_01 )
EVENT_END


/************************************************************/
/*					【仮】POS：STOPPER				*/
/************************************************************/
EVENT_START	ev_pos_d27r0601_stopper_01
  
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_walk_u)
  _OBJ_ANIME_WAIT()
  
EVENT_END

/************************************************************/
/*					特殊接続				*/
/************************************************************/
EVENT_START	ev_pos_d27r0601_warp_01
  
  //ROMのバージョンを取得
  _GET_ROM_VERSION( LCWK_VERSION )
  
  //進入方向取得
  _PLAYER_DIR_GET( LWK_DIR )
  
  //バージョンごとに異なるマップに移動
  
  //B2
  IF $LCWK_VERSION == VERSION_B2 THEN
    _MAP_CHANGE_WARP( ZONE_ID_D27R1001, 4, 10, LWK_DIR )
  //W2
  ELSE
    _MAP_CHANGE_WARP( ZONE_ID_D27R1301, 4, 10, LWK_DIR )
  ENDIF
  
EVENT_END

/**************************************************************/
/*  ＢＧ：モニター01                                          */
/**************************************************************/
EVENT_START   ev_bg_d27r0601_monitor_01

  _TALK_START_SE_PLAY()
  //ＢＧ：イッシュちほうの
  _PLAINWIN_MSG_DOWN( msg_d27r0601_monitor_01 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  ＢＧ：モニター02                                          */
/**************************************************************/
EVENT_START   ev_bg_d27r0601_monitor_02

  _TALK_START_SE_PLAY()
  //ＢＧ：ふねに　かんする　データが
  _PLAINWIN_MSG_DOWN( msg_d27r0601_monitor_02 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()

EVENT_END

/**************************************************************/
/*  ＢＧ：モニター03                                          */
/**************************************************************/
EVENT_START   ev_bg_d27r0601_monitor_03

  _TALK_START_SE_PLAY()

  //クリア前
  IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    //ＢＧ：だんいんの　こえが　きこえる……！？
    _PLAINWIN_MSG_DOWN( msg_d27r0601_monitor_03 )
    _LAST_KEYWAIT()
    _PLAINWIN_CLOSE()

  ELSE

    //ＢＧ：スノーノイズ　じょうたい　だ……
    _PLAINWIN_MSG_DOWN( msg_d27r0601_monitor_04 )
    _LAST_KEYWAIT()
    _PLAINWIN_CLOSE()

  ENDIF

EVENT_END


//--------------------------------------------------------------
//	ダークトリニティ：登場
//--------------------------------------------------------------
_ANIME_LABEL	anm_ninja_coming_01
	_ANIME_DATA	AC_NINJA_ACT0,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------
//	ダークトリニティ：退場
//--------------------------------------------------------------
_ANIME_LABEL	anm_ninja_bye_01
	_ANIME_DATA	AC_NINJA_ACT1,1
	_ANIME_DATA	AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

ev_battle_check:	
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    
    //ダークトリニティ戦1人目後なら
    IF $WK_SCENE_D27R0601_SWSAGE1_01 == 1 THEN
      //レパルダス動作モデル削除
      _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
    ENDIF
    
			_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
			_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF
_RET

//--------------------------------------------------------------------
//	☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
