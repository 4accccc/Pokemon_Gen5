
//======================================================================
//                t04r0101.ev
//
//    スクリプトファイル：t04r0101用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_t04r0101.h"
  .include  "t04r0101.h"
  
  //@author Mizuguchi_Mai

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_init_t04r0101
_EVENT_DATA    ev_reserve_t04r0101_first
_EVENT_DATA    ev_bg_t04r0101_board_01
_EVENT_DATA    ev_t04r0101_informationw_01
_EVENT_DATA    ev_pos_t04r0101_stopper_01
_EVENT_DATA    ev_t04r0101_stopper_02
_EVENT_DATA    ev_t04r0101_girl4_01
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*					FIELD_INIT_LABEL						*/
/************************************************************/
INIT_EVENT_START	ev_init_t04r0101
//
INIT_EVENT_END

/**************************************************************/
/* 			受付嬢：話しかけ			  */
/**************************************************************/
EVENT_START		ev_t04r0101_informationw_01
  IF $WK_SCENE_T04R101_STOPPER_01 == 0 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t04r0101_infomationw_01 )
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t04r0101_infomationw_02 )
  ENDIF
EVENT_END

/**************************************************************/
/* 			GIRL4：話しかけ			  */
/**************************************************************/
EVENT_START		ev_t04r0101_girl4_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t04r0101_girl4_01 )
EVENT_END

/**************************************************************/
/* 			ストッパー：話しかけ			  */
/**************************************************************/
EVENT_START		ev_t04r0101_stopper_02
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_t04r0101_cleaningm_02 )
EVENT_END

/**************************************************************/
/* 			ストッパー：POS起動			  */
/**************************************************************/
EVENT_START		ev_pos_t04r0101_stopper_01

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //主人公にふりむき
  _OBJ_ANIME( T04R0101_STOPPER_01, anm_stopper_lookpleyer_l )
  _OBJ_ANIME_WAIT()
  
  $LCW_POSX += 2
  
   //アニメ：おじさん隣接
  _OBJ_ANIME_AUTO( T04R0101_STOPPER_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 4, DIR_UD)
  _OBJ_ANIME_WAIT()
  
  //ストッパー：メッセージ
  _BALLOONWIN_OBJMSG_POS( msg_t04r0101_cleaningm_01,T04R0101_STOPPER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //主人公1歩戻る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
  //アニメ：おじさん戻る
  _OBJ_ANIME_AUTO( T04R0101_STOPPER_01, 18, 8, FORCE_TYPE_NPC, 4, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( T04R0101_STOPPER_01, anm_staystep_d)
  _OBJ_ANIME_WAIT()
  
EVENT_END

//--------------------------------------------------------------------
//	ストッパー：振り向き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_stopper_lookpleyer_l
  _ANIME_DATA	AC_WALK_D_4F,1
  _ANIME_DATA	AC_WALK_U_4F,2
  _ANIME_DATA	AC_WALK_D_4F,2
  _ANIME_DATA	AC_WALK_U_4F,2
  _ANIME_DATA	AC_WALK_D_4F,1
  _ANIME_DATA	AC_STAY_WALK_L_8F,1
  _ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

/************************************************************/
/*					誘導初回イベント						*/
/************************************************************/
EVENT_START	ev_reserve_t04r0101_first

EVENT_END

/**************************************************************/
/*  マリンチューブ掲示板(サザナミ側)                        */
/**************************************************************/
EVENT_START ev_bg_t04r0101_board_01
  _TALK_START_SE_PLAY()
	
	_PLAINWIN_MSG_DOWN( msg_t04r0101_board_01 )
	_MSGWIN_CLOSE()
	
	_CALL_MARINE_TUBE_BOARD(0)
EVENT_END

//--------------------------------------------------------------------
//	☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_staystep_u
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_d
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_l
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_r
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：はてな
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_hatena
	_ANIME_DATA	AC_MARK_HATENA,1
	_ANIME_DATA	ACMD_END,0
