
//======================================================================
//                r22.ev
//
//    スクリプトファイル：r22用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_r22.h"
  .include  "r22.h"

  //@author suginaka_katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_pos_r22_poke5_01
_EVENT_DATA   ev_r22_poke5_01
_EVENT_DATA	ev_bg_r22_sign1_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/**************************************************************/
/*POS：アクロマ登場                                           */
/**************************************************************/
EVENT_START	ev_pos_r22_poke5_01

	//いま　あなたが　であった
	_PLAINWIN_MSG_UP( msg_r22_swboss_01 )
	_PLAINWIN_CLOSE()

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_common_gyoe )
	_OBJ_ANIME_WAIT()

	//自機方向取得
	_PLAYER_DIR_GET( LWK_DIR )
	
	SWITCH $LWK_DIR
	CASE DIR_LEFT THEN
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_r )
	CASE DIR_UP THEN
		_OBJ_ANIME( MMDL_ID_PLAYER, anm_common_turn_d )
	ENDSWITCH
	_OBJ_ANIME_WAIT()

	//==================================//
	//アクロマ表示
	_FLAG_RESET( FV_R22_SWBOSS_01 )
	//==================================//
	_OBJ_ADD( R22_SWBOSS_01 )

	//自機座標取得
	_PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 
	
	_START_EVENT_BGM( SEQ_BGM_E_ACHROMA )

	SWITCH $LWK_DIR
	CASE DIR_LEFT THEN
		$LCW_POSX += 2
		$LCW_POSZ = 138
	CASE DIR_UP THEN
		_OBJ_POS_CHANGE( R22_SWBOSS_01, 723, 0, 146, DIR_UP )
		$LCW_POSZ += 2
	ENDSWITCH
	
	//アクロマ主人公に近づく
	_OBJ_ANIME_AUTO( R22_SWBOSS_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
	_OBJ_ANIME_WAIT()

	//自機座標取得
	_PLAYER_POS_GET( LCW_POSX, LCW_POSZ ) 

	SWITCH $LWK_DIR
	CASE DIR_LEFT THEN
		IF $LCW_POSZ != 138 THEN
			_OBJ_ANIME_AUTO( R22_SWBOSS_01, 729, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_UD )
			_OBJ_ANIME_WAIT()
			_OBJ_ANIME( R22_SWBOSS_01, anm_common_turn_l )
			_OBJ_ANIME_WAIT()
		ENDIF
	CASE DIR_UP THEN
		IF $LCW_POSX == 724 THEN
			_OBJ_ANIME( R22_SWBOSS_01, anm_common_turn_u )
			_OBJ_ANIME_WAIT()
		ENDIF
	ENDSWITCH

	//アクロマ：ひさしぶり　ですね！▼
	_BALLOONWIN_OBJMSG_POS( msg_r22_swboss_08, R22_SWBOSS_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//アニメ：アクロマ下を向く
	SWITCH $LCW_POSX
	CASE 727 THEN
		_OBJ_ANIME( R22_SWBOSS_01, anm_common_turn_d )
	CASE 723,724 THEN
		_OBJ_ANIME( R22_SWBOSS_01, anm_common_turn_r )
	ENDSWITCH
	_OBJ_ANIME_WAIT()

	//アクロマ：きっと　プラズマだんに　たいして
	_BALLOONWIN_OBJMSG_POS( msg_r22_swboss_02, R22_SWBOSS_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//アニメ：アクロマ。プレイヤーの方を向く
	SWITCH $LCW_POSX
	CASE 727 THEN
		_OBJ_ANIME( R22_SWBOSS_01, anm_common_turn_l )
	CASE 723,724 THEN
		_OBJ_ANIME( R22_SWBOSS_01, anm_common_turn_u )
	ENDSWITCH
	_OBJ_ANIME_WAIT()

	//アクロマ：あなｔの　まえに　あらわれたのは
	_BALLOONWIN_OBJMSG_POS( msg_r22_swboss_03, R22_SWBOSS_01, POS_DEFAULT )
	
	//プラズマ団と対抗する？
	_YES_NO_WIN( SCWK_ANSWER )

	IF $SCWK_ANSWER == SCR_YES THEN   //はい

		//アクロマ：じぶんの　ポケモンをまもれる▽
		_BALLOONWIN_OBJMSG_POS( msg_r22_swboss_04, R22_SWBOSS_01, POS_DEFAULT )
		_MSGWIN_CLOSE()

	ELSE    //いいえ

		//アクロマ：それも　ありでしょう！▼
		_BALLOONWIN_OBJMSG_POS( msg_r22_swboss_05, R22_SWBOSS_01, POS_DEFAULT )
		_MSGWIN_CLOSE()

	ENDIF

	//アニメ：アクロマ。プレイヤーに近づく
	SWITCH $LCW_POSX
	CASE 727 THEN
		_OBJ_ANIME( R22_SWBOSS_01, anm_walk_l )
	CASE 723,724 THEN
		_OBJ_ANIME( R22_SWBOSS_01, anm_walk_u )
	ENDSWITCH
	_OBJ_ANIME_WAIT()

	//アイテム「アクロママシーン」入手 
	_ITEM_EVENT_KEYWAIT( ITEM_AKUROMAMASIIN, 1 )

	//アクロマ：なにかの　やくに　たつでしょう！▼
	_BALLOONWIN_OBJMSG_POS( msg_r22_swboss_06, R22_SWBOSS_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//アニメ：アクロマ退場
	SWITCH $LCW_POSX
	CASE 727 THEN
		_CAMERA_MOVE( 9688,0,970752,47939584,-65551,9076736,40 )	//一番最後の引数は移動にかかるフレーム数
		_OBJ_ANIME_AUTO( R22_SWBOSS_01, 730, 138, FORCE_TYPE_NPC, 8, DIR_UD )
		_OBJ_ANIME_WAIT()
		_OBJ_ANIME( R22_SWBOSS_01, anm_walk_r_16f )
	CASE 723,724 THEN
		_CAMERA_MOVE( 9688,0,970752,47480832,0,9535488,40 )	//一番最後の引数は移動にかかるフレーム数
		_OBJ_ANIME_AUTO( R22_SWBOSS_01, 724, 144, FORCE_TYPE_NPC, 8, DIR_LR )
		_OBJ_ANIME_WAIT()
		_OBJ_ANIME( R22_SWBOSS_01, anm_walk_d_16f )
	ENDSWITCH
	_OBJ_ANIME_WAIT()
	_CAMERA_WAIT_MOVE()

	//アクロマ：そういえば！▼
	_BALLOONWIN_OBJMSG_POS( msg_r22_swboss_07, R22_SWBOSS_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	_OBJ_ANIME( R22_SWBOSS_01, anm_swboss_anime )
	_OBJ_ANIME_WAIT()	
	
	_CAMERA_RECV_MOVE(30)
	SWITCH $LCW_POSX
	CASE 727 THEN
		_OBJ_ANIME_AUTO( R22_SWBOSS_01, 737, 138, FORCE_TYPE_NPC, 8, DIR_LR )
	CASE 723,724 THEN
		_OBJ_ANIME_AUTO( R22_SWBOSS_01, 724, 150, FORCE_TYPE_NPC, 8, DIR_UD )
	ENDSWITCH
	_CAMERA_WAIT_MOVE()
	_CAMERA_BIND()		//カメラのバインドを解く
	_CAMERA_END()
	_OBJ_ANIME_WAIT()
	
	_OBJ_DEL( R22_SWBOSS_01 )
  
	_END_EVENT_BGM()
  
	//W21アジト船表示（タラップなし）
	_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_06, TRUE , TRUE )
	_CHANGE_MAPREPLACE_FLAG( MAPREPLACE_ID_07, FALSE , FALSE )

	//==================================//
	
	//アクロマ非表示
	_FLAG_SET( FV_R22_SWBOSS_01 )
	//フラグON（D32のイワパレスイベント用）
	_FLAG_SET( FE_R22_SWBOSS_ITEM_01 )
	//プラズマフリゲート・現在地対応
	$WK_SYS_HIDE_SHIP_PLACE = SCR_HIDE_SHIP_PLACE_W21
	//W21 POS起動
	$WK_SCENE_W21_01 = 1
	//POS無効
	$WK_SCENE_R22_POKE5 = 2
	//ローカルライブキャスター・ライバル通話状態を変更（W21まで）
  _PERSON_STATE_SET_RIVAL( RIVAL_STATE_W21_0 )
	//========================================//

EVENT_END

/**************************************************************/
/*  テラキオン：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
/**************************************************************/
EVENT_START   ev_r22_poke5_01

	_TALK_OBJ_START()

	//テラキオン：ぐるるおおーっ！
	_VOICE_PLAY( MONSNO_646, 0 ) 
	_GIZAPLAINWIN_MSG_POS( msg_r22_poke5_01, POS_UP )
	_VOICE_WAIT()
	_AB_KEYWAIT_MARK()
	_GIZAPLAINWIN_CLOSE()

	//テラキオンを見たことがあるか
	IF FLAG_OFF( FE_R22_POKE5_MEET_01 ) THEN

		//戦闘開始
		{
		DEFINE_LOCAL flag
		$flag = SCR_WILD_BTL_FLAG_LEGEND    //メッセージを変更
		_WILD_BTL_SET_EX( MONSNO_646, 45, flag ) // Lv.45 テラキオン
		}
		
	ELSE

		//戦闘開始
		{
		DEFINE_LOCAL flag
		$flag = SCR_WILD_BTL_FLAG_LEGEND    //メッセージを変更
		_WILD_BTL_SET_EX( MONSNO_646, 65, flag ) // Lv.65 テラキオン
		}

	ENDIF

	_WILD_LOSE_CHECK( SCWK_ANSWER )
	
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

		//==================================//
		//テラキオン非表示
		_FLAG_SET( FV_R22_POKE5_01 )
		//==================================//
		_OBJ_DEL( R22_POKE5_01 )   //テラキオンを消す

		_WILD_WIN()
	ELSE
		_WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
	ENDIF

	//テラキオンを捕獲した？
	_WILD_RETRY_CHECK( SCWK_ANSWER )
	
	SWITCH $SCWK_ANSWER
	CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合
		//==================================//
		//テラキオンを捕獲した
		_FLAG_SET( FE_R22_POKE5_GET_01 )
		//==================================//
	CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合
	ENDSWITCH

	//テラキオンを捕獲できなかった場合の分岐
	IF FLAG_OFF( FE_R22_POKE5_GET_01 ) THEN

		//システム：ポケモンは　どうろの　さきへ
		_SYSWIN_MSG( msg_r22_poke5_02, POS_DOWN )
		_AB_KEYWAIT_MARK()
		_SYSWIN_CLOSE()
	ENDIF
	//========================================//
	
	//テラキオン発見
	_FLAG_SET( FE_R22_POKE5_MEET_01 )

	//========================================//

EVENT_END

//--------------------------------------------------------------------
//☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_gyoe
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン右                 
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_r
  _ANIME_DATA AC_STAY_WALK_R_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン左                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_l
  _ANIME_DATA AC_STAY_WALK_L_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン上                        
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_u
  _ANIME_DATA AC_STAY_WALK_U_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//共通：ターン下                         
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_turn_d
  _ANIME_DATA AC_STAY_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：1歩歩く 16F:
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d_16f
	_ANIME_DATA	AC_WALK_D_16F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u_16f
	_ANIME_DATA	AC_WALK_U_16F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r_16f
	_ANIME_DATA	AC_WALK_R_16F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l_16f
	_ANIME_DATA	AC_WALK_L_16F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_swboss_anime
	_ANIME_DATA	AC_SWBOSS_POINT_FINGER_D,1
	_ANIME_DATA	ACMD_END,0
	
_ANIME_LABEL	anm_swboss_leave
	_ANIME_DATA	AC_WALK_D_8F,3
	_ANIME_DATA	AC_WALK_D_16F,1
	_ANIME_DATA	ACMD_END,0
	
/**************************************************************/
/*	R22		道路掲示板							  */
/**************************************************************/
EVENT_START  ev_bg_r22_sign1_01
	_EASY_BGWIN_MSG(msg_r22_sign1_01 , TYPE_ROAD)
EVENT_END
