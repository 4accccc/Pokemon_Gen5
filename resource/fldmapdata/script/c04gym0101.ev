/************************************************************/
/*CALL：カミツレショーアップ						*/
/************************************************************/
ev_swleader04_show:

	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く
	
	//BGMをカメラ操作と同時に無音
	_START_EVENT_BGM_SILENT( BGM_FADE_LONG )
	
	//カメラ操作 カミツレにズーム（カメラ移動の時間を要調整）
	_CAMERA_MOVE( 3672,0,970752,1015808,426031,258048,70 )
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	//BGM再生
	_START_EVENT_BGM( SEQ_BGM_ERECTRIC_GYM_02 )
	
	//カミツレにスポットライトが当たる
	_GYM_ELEC_SET_SPOTLIGHT( TRUE , C04GYM0101_LEADER4_01, GYM_ELEC_SPOTLIGHT_CENTER )
	_TIME_WAIT( 12 )
	_GYM_ELEC_SET_SPOTLIGHT( TRUE , C04GYM0101_LEADER4_01, GYM_ELEC_SPOTLIGHT_LEFT )
	_TIME_WAIT( 12 )
	_GYM_ELEC_SET_SPOTLIGHT( TRUE , C04GYM0101_LEADER4_01, GYM_ELEC_SPOTLIGHT_RIGHT )
	_TIME_WAIT( 12 )
	
	//カミツレ一歩前に出て演技
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_swleader04_show_anime )
	_OBJ_ANIME_WAIT()

  //ディスプレイにカミツレを写す
	_GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_DISPLAY_BOSS )
	_TIME_WAIT( 32 )
	
  //スポットライトをけす
	_GYM_ELEC_SET_SPOTLIGHT( FALSE, C04GYM0101_LEADER4_01, GYM_ELEC_SPOTLIGHT_CENTER )
	_GYM_ELEC_SET_SPOTLIGHT( FALSE, C04GYM0101_LEADER4_01, GYM_ELEC_SPOTLIGHT_LEFT )
	_GYM_ELEC_SET_SPOTLIGHT( FALSE, C04GYM0101_LEADER4_01, GYM_ELEC_SPOTLIGHT_RIGHT )
	
  //もしも戦っていた場合は、ライトアップ演出を出す
	IF FLAG_ON( FE_C04GYM0101_CLEAR ) THEN
    _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_LIGHTUP_BOSS_START )
  ENDIF

	//影フェードアウトイベントを行う
	_GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_TR_END )
	_GYM_ELEC_CALL_FADEOUT_EVENT(  GYM_ELEC_EVENT_SEQ_TR03_BTL_END )
	_GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_NORMAL )
	
	//自機にカメラを戻す
	_CAMERA_DEF_MOVE (90) 
	_CAMERA_WAIT_MOVE()
	_CAMERA_BIND()		//カメラバインド
	_CAMERA_END()		//カメラ操作終了
	
_RET

//--------------------------------------------------------------------
//	ジム勝利：カミツレ演技
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader04_show_anime
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_SWLEADER4_ACT0,1
	_ANIME_DATA	ACMD_END,0


/************************************************************/
/*POS：カミツレと退場						*/
/************************************************************/
EVENT_START	ev_pos_c04gym0101_last
	_CALL ev_swleader04_end
EVENT_END
/************************************************************/
/*CALL：ジム勝利でカミツレと退場						*/
/************************************************************/
ev_swleader04_end:
	{
	
	//プレイヤーネーム代入
	_PLAYER_NAME( 0 )
	
	//勝った直後からずっと連れ歩きはくどいので
	//出口手前のPOSから開始
	
	//カミツレとモデル全員ワープ
	_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 14, 3, 24, DIR_DOWN )
	_OBJ_POS_CHANGE( C04GYM0101_TRAINER_02, 15, 3, 24, DIR_DOWN )
	_OBJ_POS_CHANGE( C04GYM0101_TRAINER_03, 16, 3, 24, DIR_DOWN )
	_OBJ_POS_CHANGE( C04GYM0101_LEADER4_01, 15, 3, 26, DIR_DOWN )
	
	//カミツレ歩いて来る
	_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_swleader04_gymend_come_playar01 )
	_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_swleader04_gymend_come_playar01 )
	_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_swleader04_gymend_come_playar01 )
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_swleader04_gymend_come_playar01 )
	_OBJ_ANIME_WAIT()
	
	//主人公振り向く
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_up )
	_OBJ_ANIME_WAIT()
	
	//【仮】カミツレひとこと（メッセージラベルが仮）
	_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_crowd_03 , C04GYM0101_LEADER4_01 , POS_DEFAULT)
	_BALLOONWIN_CLOSE()
	
	//
	//主人公の座標を見て移動
	DEFINE_LOCAL  LCW_POSX
	DEFINE_LOCAL  LCW_POSZ
	_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

	//プレイヤーが通る3グリッド分を用意
	SWITCH $LCW_POSX
	CASE 14 THEN
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_swleader04_gymend_come_playar02_right )
	_TIME_WAIT( 16 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gymend_right )
	_OBJ_ANIME_WAIT()
		
	CASE 15 THEN
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_swleader04_gymend_come_playar02_center )
	_TIME_WAIT( 24 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gymend_center )
	_OBJ_ANIME_WAIT()
		
	CASE 16 THEN
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_swleader04_gymend_come_playar02_left )
	_TIME_WAIT( 16 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gymend_left )
	_OBJ_ANIME_WAIT()
		
	DEFAULT //正面に立った時と同じ処理
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_swleader04_gymend_come_playar02_left )
	_TIME_WAIT( 24 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_gymend_left )
	_OBJ_ANIME_WAIT()
	
	ENDSWITCH
	
	//拍手演出再生
  _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_BOSS_END )
	
	//観客から歓声があがる
	_SUBWIN_MSG( msg_c04gym0101_crowd_01 , 3 , 5 , 1 ) 
	_TIME_WAIT( 10 )
	_SUBWIN_MSG( msg_c04gym0101_crowd_02 , 19 , 8 , 2 )
	_TIME_WAIT( 10 )
	_SUBWIN_MSG( msg_c04gym0101_crowd_03 , 2 , 15 , 3 )
	_TIME_WAIT( 30 )
	_SUBWIN_CLOSE( 1 )
	_TIME_WAIT( 5 )
	_SUBWIN_CLOSE( 2 )
	_TIME_WAIT( 5 )
	_SUBWIN_CLOSE( 3 )
	_SE_WAIT()
	
	//モデル達も一歩前へ
	_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_girls_gymend_come_down )
	_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_girls_gymend_come_down )
	_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_girls_gymend_come_down )
	_OBJ_ANIME_WAIT()
	
	//全員退場
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_all_gymend_goto_down )
	_TIME_WAIT( 4 )
	_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_all_gymend_goto_down )
	_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_all_gymend_goto_down )
	_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_all_gymend_goto_down )
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_all_gymend_goto_down )
	
	//観客から歓声があがる
	_SUBWIN_MSG( msg_c04gym0101_crowd_04 , 22 , 6 , 1 ) 
	_TIME_WAIT( 10 )
	_SUBWIN_MSG( msg_c04gym0101_crowd_05 , 2 , 9 , 2 )
	_TIME_WAIT( 10 )
	_SUBWIN_MSG( msg_c04gym0101_crowd_06 , 19 , 13 , 3 )
	_TIME_WAIT( 30 )
	_SUBWIN_CLOSE( 1 )
	_TIME_WAIT( 5 )
	_SUBWIN_CLOSE( 2 )
	_TIME_WAIT( 5 )
	_SUBWIN_CLOSE( 3 )
	
	//アニメ待ち
	_OBJ_ANIME_WAIT()
	
	//カミツレと主人公向き合う
	//プレイヤーが通る3グリッド分を用意
	SWITCH $LCW_POSX
	CASE 14 THEN
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_staystep_left )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_right )
	_OBJ_ANIME_WAIT()
		
	CASE 15 THEN
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_staystep_right )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_left )
	_OBJ_ANIME_WAIT()
		
	CASE 16 THEN
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_staystep_right )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_left )
	_OBJ_ANIME_WAIT()
		
	DEFAULT //正面に立った時と同じ処理
	_OBJ_ANIME( C04GYM0101_LEADER4_01, anm_staystep_right )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_left )
	_OBJ_ANIME_WAIT()
	
	ENDSWITCH

	//【仮】カミツレひとこと（メッセージラベルが仮）
	_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_crowd_03 , C04GYM0101_LEADER4_01 , POS_DEFAULT)
	_BALLOONWIN_CLOSE()

  //終わる
  _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_NORMAL )
	
	//========================================//
	//このPOSの起動をさせなくする
	$WK_SCENE_C04GYM0101_SHOWEND = 2
	//================================================//

	}
_RET

