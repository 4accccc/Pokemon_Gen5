  .include  "c04gym0101.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_c04gym0101_leader4_01
_EVENT_DATA		ev_zone_c04gym0101
_EVENT_DATA		ev_init_c04gym0101
_EVENT_DATA		ev_pos_c04gym0101_show1
_EVENT_DATA		ev_pos_c04gym0101_show2
_EVENT_DATA		ev_pos_c04gym0101_show3
_EVENT_DATA		ev_c04gym0101_trainer_01
_EVENT_DATA		ev_c04gym0101_trainer_02
_EVENT_DATA		ev_c04gym0101_trainer_03
_EVENT_DATA		ev_c04gym0101_guide_01
_EVENT_DATA		ev_bg_c04gym0101_statue_01
_EVENT_DATA		ev_pos_c04gym0101_last
_EVENT_DATA_END


//------------------------！注意！------------------------------//
//																//
//		LOCALWORK11～13までをジムギミックの制御に使用			//
//		ゾーン内での使用を禁止します							//
//																//
//--------------------------------------------------------------//


/************************************************************/
/*					ジムギミック初期化						*/
/************************************************************/
INIT_EVENT_START	ev_zone_c04gym0101

	//【仮】進行状況によってジムギミックを初期化（参照する変数が仮）
	//クリア時
	IF $LOCALWORK11 == 4 THEN
		_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_START )
	
	//トレーナーを一人も倒していない
	ELSIF $LOCALWORK11 == 0 THEN
		_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_START )
	
	//トレーナーを一人倒した
	ELSIF $LOCALWORK11 == 1 THEN
		_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_TR01_BTL_END )
	
	//トレーナーを二人倒した
	ELSIF $LOCALWORK11 == 2 THEN
		_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_TR02_BTL_END )
	
	//トレーナーを三人倒した
	ELSIF $LOCALWORK11 == 3 THEN
		_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_TR03_BTL_END )
	
	//例外は初期状態に
	ELSE
		_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_START  )
	ENDIF

  	_DEBUG_PRINT_WK( SCWK_ANSWER )
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL						*/
/************************************************************/
INIT_EVENT_START	ev_init_c04gym0101
	
	//【仮】進行状況によってOBJを移動（参照する変数が仮）
	
	//クリア時
	IF $LOCALWORK11 == 4 THEN
		//全員初期位置
		
	//トレーナーを一人も倒していない
	ELSIF $LOCALWORK11 == 0 THEN
		//全員初期位置
	
	//トレーナーを一人倒した
	ELSIF $LOCALWORK11 == 1 THEN
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 14, 6, 2, DIR_DOWN )
	
	//トレーナーを二人倒した
	ELSIF $LOCALWORK11 == 2 THEN
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 14, 6, 2, DIR_DOWN )
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_02, 14, 6, 2, DIR_DOWN )
	
	//トレーナーを三人倒した
	ELSIF $LOCALWORK11 == 3 THEN
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 14, 6, 2, DIR_DOWN )
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_02, 14, 6, 2, DIR_DOWN )
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_03, 14, 6, 2, DIR_DOWN )
		_OBJ_POS_CHANGE( C04GYM0101_LEADER4_01, 15, 6, 2, DIR_DOWN )
	
	//例外は初期状態に
	ELSE
		//全員初期位置
	ENDIF

INIT_EVENT_END

/************************************************************/
/*				環境ＳＥ初期化（セーブ復帰用）					*/
/************************************************************/
INIT_EVENT_START	ev_recover_c04gym0101
	//セーブ復帰なら実行
	_CHECK_CONTINUE_RECOVER( SCWK_ANSWER )
	IF $SCWK_ANSWER == TRUE THEN
		_GYM_ELEC_RECOVER()
	ENDIF
	INIT_EVENT_END

/************************************************************/
/*						ジムリーダー						*/
/************************************************************/
EVENT_START	ev_c04gym0101_leader4_01
	_TALK_OBJ_START()

	//バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_04 )

	//ジムバッジフラグで分岐
	IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前なら、ジムリーダー戦イベント
		_CALL		ev_leader4_btl

	ELSE
	
		//バッジ入手後ならシナリオ進行でメッセージ分岐
	
		IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
		//クリア前
			
			//バッジ入手後、H02の開通フラグで分岐
			IF $WK_SCENE_R05 >= 3 THEN
				//開通後、一言メッセージ
				_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_07 )
				_LAST_KEYWAIT()
				_BALLOONWIN_CLOSE()
			
			ELSE
				//開通前、一言メッセージ（橋を渡れるようにしておくわ）
				_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_06 )
				_LAST_KEYWAIT()
				_BALLOONWIN_CLOSE()
			
			ENDIF
		
		ELSE
		//クリア後
			_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_end_01 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
		
		ENDIF
	


	ENDIF


EVENT_END


//ジムリーダー戦
ev_leader4_btl:
	//リーダー：戦闘前メッセージ
	_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_01 )
	_BALLOONWIN_CLOSE()

	//トレーナー戦呼び出し
	_TRAINER_BTL_SET( TRID_LEADER4_02, 0 )
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
		_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
		_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF

	//リーダー：戦闘後メッセージ→続けてバッジ入手へ
	_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_02 )
	_BALLOONWIN_CLOSE()

  //リーダー戦勝利時の情報登録
  _SET_GYM_VICTORY_INFO( BADGE_ID_04 )
	//バッジ入手処理
	_SET_BADGE_FLAG( BADGE_ID_04 )		//バッジフラグon

	{
	
	//バッジ入手演出再生
	_ME_PLAY( SEQ_ME_BADGE )
	
	//性別が格納されるローカル変数を定義
	DEFINE_LOCAL SCWK_SEX
	_GET_MY_SEX(SCWK_SEX)
	
	//男性だった場合
	IF $SCWK_SEX == PM_MALE THEN
		_CALL_FLD3D_CUTIN( FLDCIID_GYM04 )
	//女性だった場合
	ELSE
		_CALL_FLD3D_CUTIN( FLDCIID_GYM04F )
	ENDIF
	
	//ME待ち
	_ME_WAIT()
		
	}

	//～～はボルトバッジを入手した！
	_PLAYER_NAME( 0 )
	_SYSWIN_MSG( msg_c04gym0101_leader_03 , POS_DEFAULT )
	_SYSWIN_CLOSE()

	//ボルトバッジがあれば！
	_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_04 )
	_BALLOONWIN_CLOSE()

	//わざマシン入手処理
	_ITEM_EVENT_KEYWAIT( ITEM_WAZAMASIN72, 1 )

	//リーダー：わざマシンの解説
	_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_05 )

	//リーダー：橋を渡れるようにしておくわ
	_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_06 )
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()

//================================================//

	//R05ライバル戦闘POSイベントを有効にする
	$WK_SCENE_R05 = 1
	
	//R05にチャンピオンと少年たちを表示させる
	_FLAG_RESET( FV_R05_CHAMPION )

	//マップ遷移後、ジムリーダーを非表示にする
	_FLAG_SET( FV_C04GYM0101_LEADER4 )

	//ジムトレーナーの視線無効
	_TRAINER_FLAG_SET( TRID_PRINCE_01 )
	_TRAINER_FLAG_SET( TRID_PRINCESS_01 )

	//観覧車トレーナーを表示
	_FLAG_RESET( FV_AMUSEMENT_TRAINER )

	//電光掲示板：臨時ニュースフラグをセット
	_FLAG_SET( SYS_FLAG_ELBOARD_C04GYMWIN )

//================================================//

	_RET


/************************************************************/
/*						POS：モデル（１）					*/
/************************************************************/
//ジムギミックposイベント：ショー開始POS１
EVENT_START	ev_pos_c04gym0101_show1
	
	{
	//【仮】起動条件
	IF $LOCALWORK11 == 0 THEN
		
		//【仮】スポットライトON
		//_GYM_ELEC_SET_SPOTLIGHT( TRUE , C04GYM0101_TRAINER_01 )
		
		//戦闘を既に終えているかチェック
		DEFINE_LOCAL LWK_TRAINER_FLAG
		_TRAINER_FLAG_CHECK( TRID_PRINCESS_08 , LWK_TRAINER_FLAG )
		
		//まだ勝利していない
		IF $LWK_TRAINER_FLAG == FALSE THEN
		
			//視線曲再生・[!]アイコン表示
			_OBJ_ANIME( C04GYM0101_TRAINER_01,anm_tr_gyoe )
			_OBJ_ANIME_WAIT()
			_TRAINER_BGM_SET( TRID_PRINCESS_08 )
		
		ENDIF

		//主人公の座標を見て移動
		DEFINE_LOCAL  LCW_POSX
		DEFINE_LOCAL  LCW_POSZ
		_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

		//プレイヤーが通る3グリッド分を用意
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_com_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_com_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_com_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_com_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
		
		//まだ勝利していない
		IF $LWK_TRAINER_FLAG == FALSE THEN
		
			//【仮】メッセージラベルが仮
			_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_prince1_04 , C04GYM0101_TRAINER_01 , POS_DEFAULT)
			_BALLOONWIN_CLOSE()
		
			//戦闘処理
			_TRAINER_BTL_SET( TRID_PRINCESS_08, 0 )
		
			//結果チェック
			_TRAINER_LOSE_CHECK( SCWK_ANSWER )
			IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
				//【仮】スポットライトオフ
				//_GYM_ELEC_SET_SPOTLIGHT( FALSE , C04GYM0101_TRAINER_01 )
				_TRAINER_WIN()
			ELSE
				_TRAINER_LOSE()
			ENDIF
		
		ENDIF

		//影フェードアウトイベントを行う
		_GYM_ELEC_CALL_FADEOUT_EVENT( 1 )
		
		//トレーナー退場
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_bye_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_bye_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
		
		//OBJをカミツレのそばにワープさせる
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 14, 6, 2, DIR_DOWN )
		
		//========================================//
		//【仮】このPOSの起動をさせなくする
		$LOCALWORK11 = 1
		//========================================//
	ENDIF
	}

EVENT_END

/************************************************************/
/*						POS：モデル（２）					*/
/************************************************************/
//ジムギミックposイベント：ショー開始POS２
EVENT_START	ev_pos_c04gym0101_show2
	{
	
	//【仮】起動条件
	IF $LOCALWORK12 == 0 THEN
		
		//【仮】スポットライトON
		//_GYM_ELEC_SET_SPOTLIGHT( TRUE , C04GYM0101_TRAINER_02 )
		
		//戦闘を既に終えているかチェック
		DEFINE_LOCAL LWK_TRAINER_FLAG
		_TRAINER_FLAG_CHECK( TRID_PRINCESS_09 , LWK_TRAINER_FLAG )
		
		//まだ勝利していない
		IF $LWK_TRAINER_FLAG == FALSE THEN
		
			//視線曲再生・[!]アイコン表示
			_OBJ_ANIME( C04GYM0101_TRAINER_02,anm_tr_gyoe )
			_OBJ_ANIME_WAIT()
			_TRAINER_BGM_SET( TRID_PRINCESS_09 )
		
		ENDIF

		//主人公の座標を見て移動
		DEFINE_LOCAL  LCW_POSX
		DEFINE_LOCAL  LCW_POSZ
		_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

		//プレイヤーが通る3グリッド分を用意
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_com_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_com_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_com_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_com_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
		
		//まだ勝利していない
		IF $LWK_TRAINER_FLAG == FALSE THEN
		
			//【仮】メッセージラベルが仮
			_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_prince1_04 , C04GYM0101_TRAINER_02 , POS_DEFAULT)
			_BALLOONWIN_CLOSE()
		
			//戦闘処理
			_TRAINER_BTL_SET( TRID_PRINCESS_09, 0 )
		
			//結果チェック
			_TRAINER_LOSE_CHECK( SCWK_ANSWER )
			IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
				//【仮】スポットライトオフ
				//_GYM_ELEC_SET_SPOTLIGHT( FALSE , C04GYM0101_TRAINER_01 )
				_TRAINER_WIN()
			ELSE
				_TRAINER_LOSE()
			ENDIF
		
		ENDIF

		//影フェードアウトイベントを行う
		_GYM_ELEC_CALL_FADEOUT_EVENT( 2 )
		
		//トレーナー退場
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_bye_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_bye_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
		
		//OBJをカミツレのそばにワープさせる
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_02, 15, 6, 2, DIR_DOWN )
		
		//========================================//
		//【仮】このPOSの起動をさせなくする
		$LOCALWORK12 = 1
		//========================================//
	ENDIF
	
	}

EVENT_END


/************************************************************/
/*						POS：モデル（３）					*/
/************************************************************/
//ジムギミックposイベント：ショー開始POS３
EVENT_START	ev_pos_c04gym0101_show3
	{
	
	//【仮】起動条件
	IF $LOCALWORK13 == 0 THEN
		
		//【仮】スポットライトON
		//_GYM_ELEC_SET_SPOTLIGHT( TRUE , C04GYM0101_TRAINER_03 )
		
		//戦闘を既に終えているかチェック
		DEFINE_LOCAL LWK_TRAINER_FLAG
		_TRAINER_FLAG_CHECK( TRID_PRINCESS_10 , LWK_TRAINER_FLAG )
		
		//まだ勝利していない
		IF $LWK_TRAINER_FLAG == FALSE THEN
		
			//視線曲再生・[!]アイコン表示
			_OBJ_ANIME( C04GYM0101_TRAINER_03,anm_tr_gyoe )
			_OBJ_ANIME_WAIT()
			_TRAINER_BGM_SET( TRID_PRINCESS_10 )
		
		ENDIF

		//主人公の座標を見て移動
		DEFINE_LOCAL  LCW_POSX
		DEFINE_LOCAL  LCW_POSZ
		_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

		//プレイヤーが通る3グリッド分を用意
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_com_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_com_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_com_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_com_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
		
		//まだ勝利していない
		IF $LWK_TRAINER_FLAG == FALSE THEN
		
			//【仮】メッセージラベルが仮
			_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_prince1_04 , C04GYM0101_TRAINER_03 , POS_DEFAULT)
			_BALLOONWIN_CLOSE()
		
			//戦闘処理
			_TRAINER_BTL_SET( TRID_PRINCESS_10, 0 )
		
			//結果チェック
			_TRAINER_LOSE_CHECK( SCWK_ANSWER )
			IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
				//【仮】スポットライトオフ
				//_GYM_ELEC_SET_SPOTLIGHT( FALSE , C04GYM0101_TRAINER_03 )
				_TRAINER_WIN()
			ELSE
				_TRAINER_LOSE()
			ENDIF
		
		ENDIF

		//【仮】カミツレショーアップ演出
		_CALL	ev_swleader04_show
		
		//トレーナー退場
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_bye_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_bye_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
		
		//OBJをカミツレのそばにワープさせる
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_03, 16, 6, 2, DIR_DOWN )
		
		//========================================//
		//【仮】このPOSの起動をさせなくする
		$LOCALWORK13 = 1
		//========================================//
	ENDIF
	}
	
EVENT_END


//スイッチを踏んだ時のシステムメッセージ（共通）
//いらないけれど、POS踏んだときの確認用メッセージとして使用
ev_swich_message:
	_PLAYER_NAME( 0 )
	//コースが変わった！
	_SYSWIN_MSG( msg_c04gym0101_point_01 , POS_DOWN )
	_LAST_KEYWAIT()
	_SYSWIN_CLOSE()
	_RET

//--------------------------------------------------------------
//	トレーナー[!]マーク
//--------------------------------------------------------------
	_ANIME_LABEL	anm_tr_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------
//	トレーナー接近(左）
//--------------------------------------------------------------
	_ANIME_LABEL	anm_tr_com_left
	_ANIME_DATA	AC_WALK_D_8F,2
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------
//	トレーナー接近(中央）
//--------------------------------------------------------------
	_ANIME_LABEL	anm_tr_com_center
	_ANIME_DATA	AC_WALK_D_8F,3
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------
//	トレーナー接近(右）
//--------------------------------------------------------------
	_ANIME_LABEL	anm_tr_com_right
	_ANIME_DATA	AC_WALK_D_8F,2
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------
//	トレーナー去る(左）
//--------------------------------------------------------------
	_ANIME_LABEL	anm_tr_bye_left
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	AC_WAIT_2F,1
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	AC_WAIT_2F,1
	_ANIME_DATA	AC_DIR_U,1
