  .text

  .include  "scr_seq_def.h"
  .include  "../../message/dst/script/msg_c04gym0101.h"
  .include  "c04gym0101.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_c04gym0101_leader4_01
_EVENT_DATA		ev_zone_c04gym0101
_EVENT_DATA		ev_init_c04gym0101
_EVENT_DATA		ev_pos_c04gym0101_show1
_EVENT_DATA		ev_pos_c04gym0101_show2
_EVENT_DATA		ev_pos_c04gym0101_show3
_EVENT_DATA		ev_c04gym0101_trainer_01
_EVENT_DATA		ev_c04gym0101_trainer_02
_EVENT_DATA		ev_c04gym0101_trainer_03
_EVENT_DATA		ev_c04gym0101_guide_01
_EVENT_DATA		ev_bg_c04gym0101_statue_01
_EVENT_DATA		ev_pos_c04gym0101_last
_EVENT_DATA		ev_recover_c04gym0101
_EVENT_DATA_END


//------------------------！注意！------------------------------//
//																//
//		LOCALWORK11～13までをジムギミックの制御に使用			//
//		ゾーン内での使用を禁止します							//
//																//
//--------------------------------------------------------------//


/************************************************************/
/*					ジムギミック初期化						*/
/************************************************************/
INIT_EVENT_START	ev_zone_c04gym0101

	//進行状況によってジムギミックを初期化
	//クリア時
	IF FLAG_ON( FE_C04GYM0101_CLEAR ) THEN
		
		//================================================//
		//POSを初期化
		$WK_SCENE_C04GYM0101_SHOW = 0

		//================================================//
		
		_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_START )
	//未クリア時は進行状況に合わせてジムギミックを変更
	ELSE
		//入室時初期状態
		IF $WK_SCENE_C04GYM0101_SHOW == 0 THEN
			_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_START )
		
		//トレーナーを一人倒した
		ELSIF $WK_SCENE_C04GYM0101_SHOW == 1 THEN
			_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_TR01_BTL_END )
		
		//トレーナーを二人倒した
		ELSIF $WK_SCENE_C04GYM0101_SHOW == 2 THEN
			_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_TR02_BTL_END )
		
		//トレーナーを三人倒した
		ELSIF $WK_SCENE_C04GYM0101_SHOW == 3 THEN
			_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_TR03_BTL_END )

	  //ジムクリア退場演出前
		ELSIF $WK_SCENE_C04GYM0101_SHOW == 4 THEN
			_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_BOSS_BTL_END )
		
		//例外は初期状態に
		ELSE
			_GYM_ELEC_INIT( GYM_ELEC_EVENT_SEQ_START  )
		ENDIF
	ENDIF
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_LABEL						*/
/************************************************************/
INIT_EVENT_START	ev_init_c04gym0101
	
	//進行状況によってOBJを移動
	
	//クリア時
	IF $WK_SCENE_C04GYM0101_SHOW == 0 THEN
		//全員初期位置
	
	//トレーナーを一人倒した
	ELSIF $WK_SCENE_C04GYM0101_SHOW == 1 THEN
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 9, 6, 2, DIR_RIGHT )
	
	//トレーナーを二人倒した
	ELSIF $WK_SCENE_C04GYM0101_SHOW == 2 THEN
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 9, 6, 2, DIR_RIGHT )
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_02, 9, 6, 3, DIR_RIGHT )
	
	//トレーナーを三人倒した
	ELSIF $WK_SCENE_C04GYM0101_SHOW == 3 THEN
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 9, 6, 2, DIR_RIGHT )
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_02, 9, 6, 3, DIR_RIGHT )
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_03, 21, 6, 2, DIR_LEFT )
		_OBJ_POS_CHANGE( C04GYM0101_LEADER4_01, 15, 6, 4, DIR_DOWN )
	
	//ジムクリア退場演出前
	ELSIF $WK_SCENE_C04GYM0101_SHOW == 4 THEN
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 9, 6, 2, DIR_RIGHT )
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_02, 9, 6, 3, DIR_RIGHT )
		_OBJ_POS_CHANGE( C04GYM0101_TRAINER_03, 21, 6, 2, DIR_LEFT )
		_OBJ_POS_CHANGE( C04GYM0101_LEADER4_01, 15, 6, 4, DIR_DOWN )
	
	//例外は初期状態に
	ELSE
		//全員初期位置
	ENDIF
	

INIT_EVENT_END

/************************************************************/
/*				復帰用                            					*/
/************************************************************/
INIT_EVENT_START	ev_recover_c04gym0101
	//セーブ復帰なら実行
	_CHECK_CONTINUE_RECOVER( SCWK_ANSWER )
	IF $SCWK_ANSWER == TRUE THEN
		_GYM_ELEC_RECOVER()
	ENDIF

  //クリア後はカミツレショーアップ時に緑ビームがでるので復帰処理
	IF $WK_SCENE_C04GYM0101_SHOW == 3 THEN
	  IF FLAG_ON( FE_C04GYM0101_CLEAR ) THEN
      _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_LIGHTUP_BOSS_RECOVER )
    ENDIF
  ENDIF

	INIT_EVENT_END

/************************************************************/
/*						ジムリーダー						*/
/************************************************************/
EVENT_START	ev_c04gym0101_leader4_01
	_TALK_OBJ_START()

	//バッジフラグ取得
	_GET_BADGE_FLAG( SCWK_TEMP0, BADGE_ID_04 )

	//ジムバッジフラグで分岐
	IF $SCWK_TEMP0 == 0 THEN
		//バッジ入手前なら、ジムリーダー戦イベント
		_CALL		ev_leader4_btl

	ELSE
	
		//バッジ入手後ならシナリオ進行でメッセージ分岐
	
		IF FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
		//クリア前
			
			//バッジ入手後、H02の開通フラグで分岐
			IF $WK_SCENE_R05 >= 3 THEN
				//開通後、一言メッセージ
				_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_07 )
				_LAST_KEYWAIT()
				_BALLOONWIN_CLOSE()
			
			ELSE
				//開通前、一言メッセージ（橋を渡れるようにしておくわ）
				_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_06 )
				_LAST_KEYWAIT()
				_BALLOONWIN_CLOSE()
			
			ENDIF
		
		ELSE
		//クリア後
			_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_leader_end_01 )
			_LAST_KEYWAIT()
			_BALLOONWIN_CLOSE()
		
		ENDIF
	


	ENDIF


EVENT_END


//ジムリーダー戦
ev_leader4_btl:
	//リーダー：戦闘前メッセージ
	_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_leader_01 , C04GYM0101_LEADER4_01 , POS_DOWN)
	_BALLOONWIN_CLOSE()

	//トレーナー戦呼び出し
	_TRAINER_BTL_SET( TRID_LEADER4_02, 0 )
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
		
		_CAMERA_START()		//カメラ操作開始
		_CAMERA_PURGE()		//カメラのバインドを解く
		
		//カメラ操作 カミツレにズーム
		_CAMERA_MOVE( 3672,0,970752,1015808,426031,258048,1 )
		_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	
		//モデル達はカミツレの方を向く
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_dir_d )
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_dir_d )
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_dir_d )
		_OBJ_ANIME_WAIT()
		
		_TRAINER_WIN()
	ELSE
		_TRAINER_LOSE()
	ENDIF

  //勝ち演出
  _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_DISPLAY_HERO )
  _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_LIGHTUP_BOSS_START )

	//リーダー：戦闘後メッセージ→続けてバッジ入手へ
	_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_leader_02 , C04GYM0101_LEADER4_01 , POS_DOWN)
	_BALLOONWIN_CLOSE()

  //リーダー戦勝利時の情報登録
  _SET_GYM_VICTORY_INFO( BADGE_ID_04 )
	//バッジ入手処理
	_SET_BADGE_FLAG( BADGE_ID_04 )		//バッジフラグon

	{
	
	//バッジ入手演出再生
	_ME_PLAY( SEQ_ME_BADGE )
	
	//性別が格納されるローカル変数を定義
	DEFINE_LOCAL SCWK_SEX
	_GET_MY_SEX(SCWK_SEX)
	
	//男性だった場合
	IF $SCWK_SEX == PM_MALE THEN
		_CALL_FLD3D_CUTIN( FLDCIID_GYM04 )
	//女性だった場合
	ELSE
		_CALL_FLD3D_CUTIN( FLDCIID_GYM04F )
	ENDIF
	
	//ME待ち
	_ME_WAIT()
		
	}
	
	//ファン盛り上がり演出（興奮）
	_GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_BOSS_END )

	//～～はボルトバッジを入手した！
	_PLAYER_NAME( 0 )
	_SYSWIN_MSG( msg_c04gym0101_leader_03 , POS_DOWN )
	_SYSWIN_CLOSE()

	//ボルトバッジがあれば！
	_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_leader_04 , C04GYM0101_LEADER4_01 , POS_DOWN)
	_BALLOONWIN_CLOSE()
	
	//ファン盛り上がり（普通）
	_GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_NORMAL )

	//わざマシン入手処理
	_ITEM_EVENT_KEYWAIT( ITEM_WAZAMASIN72, 1 )
	
	//ファン盛り上がり演出（興奮）
	_GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_BOSS_END )
	
	//リーダー：わざマシンの解説
	_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_leader_05 , C04GYM0101_LEADER4_01 , POS_DOWN)

	//リーダー：橋を渡れるようにしておくわ
	_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_leader_06 , C04GYM0101_LEADER4_01 , POS_DOWN)
	_LAST_KEYWAIT()
	_BALLOONWIN_CLOSE()
	
	//自機にカメラを戻す
	_CAMERA_DEF_MOVE (30) 
	_CAMERA_WAIT_MOVE()
	_CAMERA_BIND()		//カメラバインド
	_CAMERA_END()		//カメラ操作終了

	//ファン盛り上がり（普通）
	_GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_NORMAL )

	//================================================//

		//ジムクリア状態にする
		_FLAG_SET( FE_C04GYM0101_CLEAR )
		//退場演出POSを起動
		$WK_SCENE_C04GYM0101_SHOWEND = 1
		
	//================================================//

	_RET


/************************************************************/
/*						POS：モデル（１）					*/
/************************************************************/
//ジムギミックposイベント：ショー開始POS１
EVENT_START	ev_pos_c04gym0101_show1
	
	{
	//スポットライトON
	_GYM_ELEC_SET_SPOTLIGHT( TRUE , C04GYM0101_TRAINER_01, GYM_ELEC_SPOTLIGHT_NORMAL )
	_TIME_WAIT( 16 )
	
	//まだジムをクリアしてしていない
	IF FLAG_OFF( FE_C04GYM0101_CLEAR ) THEN
	
		//視線曲再生・[!]アイコン表示
		_OBJ_ANIME( C04GYM0101_TRAINER_01,anm_tr_gyoe )
		_OBJ_ANIME_WAIT()
		_TRAINER_BGM_SET( TRID_PRINCESS_08 )
	

		//主人公の座標を見て移動
		DEFINE_LOCAL  LCW_POSX
		DEFINE_LOCAL  LCW_POSZ
		_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

		//プレイヤーが通る3グリッド分を用意
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_com_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_com_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_com_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_com_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
	
		//メッセージラベルが仮
		_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_princess1_01 , C04GYM0101_TRAINER_01 , POS_DEFAULT)
		_BALLOONWIN_CLOSE()
	
		//戦闘処理
		_TRAINER_BTL_SET( TRID_PRINCESS_08, 0 )
	
		//結果チェック
		_TRAINER_LOSE_CHECK( SCWK_ANSWER )
		IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()
		ELSE
			_TRAINER_LOSE()
		ENDIF
	
	//ジムクリア済み演出
	ELSE
	
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_com_center_end )
		_OBJ_ANIME_WAIT()
	
	ENDIF
	
	//スポットライトオフ
	_GYM_ELEC_SET_SPOTLIGHT( FALSE , C04GYM0101_TRAINER_01, GYM_ELEC_SPOTLIGHT_NORMAL )
	//影フェードアウトイベントを行う
  _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_TR_END )
	_GYM_ELEC_CALL_FADEOUT_EVENT( GYM_ELEC_EVENT_SEQ_TR01_BTL_END )
  _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_NORMAL )
	
	//まだジムをクリアしてしていない
	IF FLAG_OFF( FE_C04GYM0101_CLEAR ) THEN
	
		//トレーナー退場
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_bye_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_bye_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
	
	//ジムクリア済み演出
	ELSE
		
		_OBJ_ANIME( C04GYM0101_TRAINER_01, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
	
	ENDIF
	
	//OBJをカミツレのそばにワープさせる
	_OBJ_POS_CHANGE( C04GYM0101_TRAINER_01, 9, 6, 2, DIR_RIGHT )
	
	//========================================//
	//このPOSの起動をさせなくする
	$WK_SCENE_C04GYM0101_SHOW = 1
	//========================================//
	}

EVENT_END

/************************************************************/
/*						POS：モデル（２）					*/
/************************************************************/
//ジムギミックposイベント：ショー開始POS２
EVENT_START	ev_pos_c04gym0101_show2
	{
	
	//スポットライトON
	_GYM_ELEC_SET_SPOTLIGHT( TRUE , C04GYM0101_TRAINER_02, GYM_ELEC_SPOTLIGHT_NORMAL )
	_TIME_WAIT( 16 )
	
	//まだジムをクリアしていない
	IF FLAG_OFF( FE_C04GYM0101_CLEAR ) THEN
	
		//視線曲再生・[!]アイコン表示
		_OBJ_ANIME( C04GYM0101_TRAINER_02,anm_tr_gyoe )
		_OBJ_ANIME_WAIT()
		_TRAINER_BGM_SET( TRID_PRINCESS_09 )

		//主人公の座標を見て移動
		DEFINE_LOCAL  LCW_POSX
		DEFINE_LOCAL  LCW_POSZ
		_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

		//プレイヤーが通る3グリッド分を用意
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr02_com_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr02_com_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr02_com_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr02_com_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
	
		//メッセージラベルが仮
		_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_princess2_01 , C04GYM0101_TRAINER_02 , POS_DEFAULT)
		_BALLOONWIN_CLOSE()
	
		//戦闘処理
		_TRAINER_BTL_SET( TRID_PRINCESS_09, 0 )
	
		//結果チェック
		_TRAINER_LOSE_CHECK( SCWK_ANSWER )
		IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()
		ELSE
			_TRAINER_LOSE()
		ENDIF
		
	//ジムクリア済み演出
	ELSE
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr02_com_center_end )
		_OBJ_ANIME_WAIT()
	
	ENDIF

	//スポットライトオフ
	_GYM_ELEC_SET_SPOTLIGHT( FALSE , C04GYM0101_TRAINER_02, GYM_ELEC_SPOTLIGHT_NORMAL )
	//影フェードアウトイベントを行う
  _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_TR_END )
	_GYM_ELEC_CALL_FADEOUT_EVENT( GYM_ELEC_EVENT_SEQ_TR02_BTL_END )
  _GYM_ELEC_SET_EFFECT( GYM_ELEC_EFFECT_FAN_NORMAL )
	
	//まだジムをクリアしていない
	IF FLAG_OFF( FE_C04GYM0101_CLEAR ) THEN
	
		//トレーナー退場
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_bye_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_bye_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
	
	//ジムクリア済み演出
	ELSE
		_OBJ_ANIME( C04GYM0101_TRAINER_02, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
	
	ENDIF
	
	//OBJをカミツレのそばにワープさせる
	_OBJ_POS_CHANGE( C04GYM0101_TRAINER_02, 9, 6, 3, DIR_RIGHT )
	
	//========================================//
	//このPOSの起動をさせなくする
	$WK_SCENE_C04GYM0101_SHOW = 2
	//========================================//

	}

EVENT_END


/************************************************************/
/*						POS：モデル（３）					*/
/************************************************************/
//ジムギミックposイベント：ショー開始POS３
EVENT_START	ev_pos_c04gym0101_show3
	{
	
	//スポットライトON
	_GYM_ELEC_SET_SPOTLIGHT( TRUE , C04GYM0101_TRAINER_03, GYM_ELEC_SPOTLIGHT_NORMAL )
	_TIME_WAIT( 16 )
	
	//まだジムをクリアしていない
	IF FLAG_OFF( FE_C04GYM0101_CLEAR ) THEN
	
		//視線曲再生・[!]アイコン表示
		_OBJ_ANIME( C04GYM0101_TRAINER_03,anm_tr_gyoe )
		_OBJ_ANIME_WAIT()
		_TRAINER_BGM_SET( TRID_PRINCESS_10 )
	
		//主人公の座標を見て移動
		DEFINE_LOCAL  LCW_POSX
		DEFINE_LOCAL  LCW_POSZ
		_PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

		//プレイヤーが通る3グリッド分を用意
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr03_com_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr03_com_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr03_com_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr03_com_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
		
		//メッセージラベルが仮
		_BALLOONWIN_OBJMSG_POS( msg_c04gym0101_princess3_01 , C04GYM0101_TRAINER_03 , POS_DEFAULT)
		_BALLOONWIN_CLOSE()
	
		//戦闘処理
		_TRAINER_BTL_SET( TRID_PRINCESS_10, 0 )
	
		//結果チェック
		_TRAINER_LOSE_CHECK( SCWK_ANSWER )
		IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
			_TRAINER_WIN()
		ELSE
			_TRAINER_LOSE()
		ENDIF
		
		//トレーナー退場
		SWITCH $LCW_POSX
		CASE 14 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_bye_left )
		_OBJ_ANIME_WAIT()
			
		CASE 15 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
			
		CASE 16 THEN
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_bye_right )
		_OBJ_ANIME_WAIT()
			
		DEFAULT //正面に立った時と同じ処理
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr_bye_center )
		_OBJ_ANIME_WAIT()
		
		ENDSWITCH
		
	//ジムクリア済み演出（３人目のみ別のアニメにしている）
	ELSE
		_OBJ_ANIME( C04GYM0101_TRAINER_03, anm_tr03_com_center_end )
		_OBJ_ANIME_WAIT()
	ENDIF
	
	//スポットライトオフ
	_GYM_ELEC_SET_SPOTLIGHT( FALSE , C04GYM0101_TRAINER_03, GYM_ELEC_SPOTLIGHT_NORMAL )
	

	//OBJをカミツレのそばにワープさせる
	_OBJ_POS_CHANGE( C04GYM0101_TRAINER_03, 21, 6, 2, DIR_LEFT )

	//カミツレショーアップ演出
	_CALL	ev_swleader04_show
	
	//========================================//
	//このPOSの起動をさせなくする
	$WK_SCENE_C04GYM0101_SHOW = 3

	//========================================//
	
	//未クリア時
	IF FLAG_OFF( FE_C04GYM0101_CLEAR ) THEN
		//========================================//
		//ゾーンBGM変更フラグをセット
		_FLAG_SET( SYS_FLAG_BGM_C04GYM0101_SHOW )
		//========================================//
	ENDIF
}

EVENT_END

