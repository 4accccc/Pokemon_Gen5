	//ジムクリア前
	IF FLAG_OFF( FE_C04GYM0101_CLEAR ) THEN
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_princess2_02 )
	//ジムクリア後
	ELSE
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c04gym0101_princess2_03 )
	ENDIF
	
