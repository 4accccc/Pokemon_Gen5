/*					ジムギミック初期化						*/
/************************************************************/
INIT_EVENT_START	ev_zone_c04gym0101
	//ジムギミック初期化コマンド　引数(0)ならトレーナー対戦前(1)なら対戦後
  //_GYM_ELEC_INIT( TR_SW1, TR_SW2 )
  _DEBUG_PRINT_WK( SCWK_ANSWER )
INIT_EVENT_END


