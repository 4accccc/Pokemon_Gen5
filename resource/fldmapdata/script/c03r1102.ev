  .text

  .include  "scr_seq_def.h"
  .include  "msg_c03r1102.h"
  .include  "c03r1102.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_scene_c03r1102_commendation_01
_EVENT_DATA    ev_scene_c03r1102_commendation_02
_EVENT_DATA    ev_c03r1102_people_01
_EVENT_DATA    ev_c03r1102_people_02
_EVENT_DATA    ev_c03r1102_people_03
_EVENT_DATA_END

/**************************************************************/
/*  メダル表彰イベント */
/**************************************************************/
EVENT_START   ev_scene_c03r1102_commendation_01
{
  //「！」
  _PLAYER_NAME( 0 )
  _OBJ_ANIME( C03R1102_PEOPLE_01 , anm_people01_gyoe )
  _TIME_WAIT(12)
  _OBJ_ANIME( C03R1102_PEOPLE_02 , anm_dir_u )
  _OBJ_ANIME( C03R1102_PEOPLE_03 , anm_dir_u )
  _OBJ_ANIME_WAIT()
  
  //PEOPLE01：こっちこっち
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_01 , C03R1102_PEOPLE_01, POS_UP )
  _BALLOONWIN_CLOSE()
  
  //主人公下へ
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_walk_to_peaple01 )
  _OBJ_ANIME_WAIT()
  
  //エレベータ到着音
  _SE_PLAY( SEQ_SE_FLD_87 )
  _SE_WAIT()
  
  //ドア開ける
  DEFINE_LOCAL	DOOR_ANIME_ID
  _BMODEL_ANIME_CREATE( DOOR_ANIME_ID, SCR_BMID_DOOR, 7, 1 )
  _BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_OPEN )
  _BMODEL_ANIME_WAIT( DOOR_ANIME_ID )
  
  //SUNGLASSES配置
  _OBJ_ADD_EX( 7, 1, DIR_DOWN, MMDL_ID_EVENTOBJ_00, SUNGLASSES, MV_DMY )
  
  //会長来る
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_oldman_comming )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //ドア閉じる
  _BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_WAIT( DOOR_ANIME_ID )
  _BMODEL_ANIME_DELETE( DOOR_ANIME_ID )
  
  //SUNGLASSES：はじめましょう
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_02 , MMDL_ID_EVENTOBJ_00, POS_UP )
  _BALLOONWIN_CLOSE()
  
  //会長・主人公移動
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00 , anm_oldman_goto_desk )
  _TIME_WAIT(32)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_goto_desk )
  _TIME_WAIT(40)
  _OBJ_ANIME( C03R1102_PEOPLE_01 , anm_staystep_d )
  _TIME_WAIT(48)
  _OBJ_ANIME( C03R1102_PEOPLE_02 , anm_staystep_d )
  _OBJ_ANIME( C03R1102_PEOPLE_03 , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //SUNGLASSES：ゆうしゅうな せいせきを おさめ…
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_03 , MMDL_ID_EVENTOBJ_00, POS_DOWN )
  
  //【仮】歓声があがる（ウィンドウ位置が仮）
  _SUBWIN_MSG( msg_mdloyj_prizegoal_sub_01 , 3 , 5 , 1 ) 
  _TIME_WAIT( 10 )
  _SUBWIN_MSG( msg_mdloyj_prizegoal_sub_02 , 19 , 8 , 2 )
  _TIME_WAIT( 10 )
  _SUBWIN_MSG( msg_mdloyj_prizegoal_sub_03 , 2 , 15 , 3 )
  _TIME_WAIT( 30 )
  _SUBWIN_CLOSE( 1 )
  _TIME_WAIT( 5 )
  _SUBWIN_CLOSE( 2 )
  _TIME_WAIT( 5 )
  _SUBWIN_CLOSE( 3 )
  
   //SUNGLASSES：きねんに さしあげます
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_04 , MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  
  //システムメッセージ：手に入れた
  _PLAYER_NAME( 0 )
  _SYSWIN_MSG( msg_mdloyj_titleget_sys , POS_DOWN )
  _SYSWIN_CLOSE()
  
  //【仮】カットイン（コマンドがまだない）
  
  //SUNGLASSES：これからもがんばって
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_end , MMDL_ID_EVENTOBJ_00, POS_DOWN )
  _MSGWIN_CLOSE()
  
  //================================================//

  //ゴールイン終了
  $WK_SCENE_MEDAL_EVENT = 3
  
	//================================================//
}
EVENT_END

