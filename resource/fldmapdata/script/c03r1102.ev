  _OBJ_ANIME( C03R1102_MEDALMAN_01 , anm_oldman_goto_desk )
  _TIME_WAIT(32)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_goto_desk )
  _TIME_WAIT(40)
  _OBJ_ANIME( C03R1102_PEOPLE_01 , anm_staystep_d )
  _TIME_WAIT(48)
  _OBJ_ANIME( C03R1102_PEOPLE_02 , anm_staystep_d )
  _OBJ_ANIME( C03R1102_PEOPLE_03 , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //SUNGLASSES：ゆうしゅうな せいせきを おさめ…
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizecomp_03 , C03R1102_MEDALMAN_01, POS_DOWN )
  
  //歓声があがる
  _SUBWIN_MSG( msg_mdloyj_prizecomp_sub_01 , 6 , 0 , 1 )
  _TIME_WAIT( 10 )
  _SUBWIN_MSG( msg_mdloyj_prizecomp_sub_02 , 8 , 5 , 2 )
  _TIME_WAIT( 10 )
  _SUBWIN_MSG( msg_mdloyj_prizecomp_sub_03 , 11 , 10 , 3 )
  _TIME_WAIT( 30 )
  _SUBWIN_CLOSE( 1 )
  _TIME_WAIT( 5 )
  _SUBWIN_CLOSE( 2 )
  _TIME_WAIT( 5 )
  _SUBWIN_CLOSE( 3 )
  
   //SUNGLASSES：きねんに さしあげます
  _PLAYER_NAME( 0 )
