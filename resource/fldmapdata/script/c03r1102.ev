_EVENT_DATA_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c03r1102

  IF $WK_SCENE_MEDAL_EVENT == 5 THEN
    _OBJ_POS_CHANGE( C03R1102_MEDALMAN_01, 7, 0, 13, DIR_UP )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  メダル表彰イベント */
/**************************************************************/
EVENT_START   ev_scene_c03r1102_commendation_01

  //================================================//
  //MEDALMAN表示
  _FLAG_RESET( FV_C03R1102_MEDALMAN_01 )
  //================================================//

{
  //「！」
  _PLAYER_NAME( 0 )
  _OBJ_ANIME( C03R1102_PEOPLE_01 , anm_people01_gyoe )
  _TIME_WAIT(12)
  _OBJ_ANIME( C03R1102_PEOPLE_02 , anm_dir_u )
  _OBJ_ANIME( C03R1102_PEOPLE_03 , anm_dir_u )
  _OBJ_ANIME_WAIT()
  
  //PEOPLE01：こっちこっち
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_01 , C03R1102_PEOPLE_01, POS_UP )
  _BALLOONWIN_CLOSE()
  
  //主人公下へ
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_walk_to_peaple01 )
  _OBJ_ANIME_WAIT()
  
  //エレベータ到着音
  _SE_PLAY( SEQ_SE_FLD_87 )
  _SE_WAIT()
  
  //MEDALMAN生成
  _OBJ_ADD( C03R1102_MEDALMAN_01 )
  
  //ドア開ける
  DEFINE_LOCAL	DOOR_ANIME_ID
  _BMODEL_ANIME_CREATE( DOOR_ANIME_ID, SCR_BMID_DOOR, 7, 1 )
  _BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_OPEN )
  _BMODEL_ANIME_WAIT( DOOR_ANIME_ID )
  
  //会長来る
  _OBJ_ANIME( C03R1102_MEDALMAN_01 , anm_oldman_comming )
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_staystep_u )
  _OBJ_ANIME_WAIT()

  //ドア閉じる
  _BMODEL_ANIME_SET( DOOR_ANIME_ID, SCR_BMANM_DOOR_CLOSE )
  _BMODEL_ANIME_WAIT( DOOR_ANIME_ID )
  _BMODEL_ANIME_DELETE( DOOR_ANIME_ID )
  
  //SUNGLASSES：はじめましょう
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_02 , C03R1102_MEDALMAN_01, POS_UP )
  _BALLOONWIN_CLOSE()
  
  //会長・主人公移動
  _OBJ_ANIME( C03R1102_MEDALMAN_01 , anm_oldman_goto_desk )
  _TIME_WAIT(32)
  _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_goto_desk )
  _TIME_WAIT(40)
  _OBJ_ANIME( C03R1102_PEOPLE_01 , anm_staystep_d )
  _TIME_WAIT(48)
  _OBJ_ANIME( C03R1102_PEOPLE_02 , anm_staystep_d )
  _OBJ_ANIME( C03R1102_PEOPLE_03 , anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //SUNGLASSES：ゆうしゅうな せいせきを おさめ…
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_03 , C03R1102_MEDALMAN_01, POS_DOWN )
  
  //歓声があがる
  _SUBWIN_MSG( msg_mdloyj_prizegoal_sub_01 , 21 , 3 , 1 )
  _TIME_WAIT( 10 )
  _SUBWIN_MSG( msg_mdloyj_prizegoal_sub_02 , 5 , 5 , 2 )
  _TIME_WAIT( 10 )
  _SUBWIN_MSG( msg_mdloyj_prizegoal_sub_03 , 6 , 1 , 3 )
  _TIME_WAIT( 30 )
  _SUBWIN_CLOSE( 1 )
  _TIME_WAIT( 5 )
  _SUBWIN_CLOSE( 2 )
  _TIME_WAIT( 5 )
  _SUBWIN_CLOSE( 3 )
  
   //SUNGLASSES：きねんに さしあげます
  _PLAYER_NAME( 0 )
  _MEDAL_NAME( 1, MDLID_GOAL )
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_04 , C03R1102_MEDALMAN_01, POS_DOWN )
  _MSGWIN_CLOSE()
  
  {
  
  //ME再生
  _ME_PLAY( SEQ_ME_MD_FAN03 )
  
  //バッジ入手演出再生
  //カットインID取得
  _GET_MEDAL_CIID( MDLID_GOAL, LOCALWORK15 )
  _CALL_FLD3D_CUTIN( LOCALWORK15 )
  
  //ME待ち
  _ME_WAIT()
  
  }
  
  //システムメッセージ：手に入れた
  _PLAYER_NAME( 0 )
  _SYSWIN_MSG( msg_mdloyj_titleget_sys , POS_DOWN )
  _SYSWIN_CLOSE()
  
  //SUNGLASSES：これからもがんばって
  _PLAYER_NAME( 0 )
  _BALLOONWIN_OBJMSG_POS( msg_mdloyj_prizegoal_end , C03R1102_MEDALMAN_01, POS_DOWN )
  _MSGWIN_CLOSE()
  
  //================================================//

  //ゴールイン終了
  $WK_SCENE_MEDAL_EVENT = 3
  //メダル獲得処理
  _GET_MEDAL( MDLID_GOAL, TRUE ) 
  
  //MEDALMAN非表示
  _FLAG_SET( FV_C03R1102_MEDALMAN_01 )
	//================================================//
}
EVENT_END

