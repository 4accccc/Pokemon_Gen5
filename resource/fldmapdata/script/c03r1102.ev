//--------------------------------------------------------------------
//	PEOPLE01「！」表示して上を向く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_people01_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	PLAYER、PEOPLE01の方へ歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_walk_to_peaple01
	_ANIME_DATA	AC_WALK_D_8F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	OLDMAN01登場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_oldman_comming
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	OLDMAN01デスクへ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_oldman_goto_desk
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	AC_WALK_L_8F,2
	_ANIME_DATA	AC_WALK_D_8F,9
	_ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	PLAYERデスクへ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_goto_desk
	_ANIME_DATA	AC_WALK_L_8F,3
	_ANIME_DATA	AC_WALK_D_8F,6
	_ANIME_DATA	AC_WALK_R_8F,2
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0
/**************************************************************/
/*  C03 PEOPLE01の会話（男）                      */
/**************************************************************/
EVENT_START   ev_c03r1102_people_01
{ 

  _TALK_OBJ_START()
  
  //メダルランクチェック
  DEFINE_LOCAL	LWK_NEDAL_RANK
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_RANK, LWK_NEDAL_RANK )
  SWITCH $LWK_NEDAL_RANK
  CASE SCR_MEDALRANK_COPPER THEN
     //銅
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_01 , C03R1102_PEOPLE_01, POS_DEFAULT )
  CASE SCR_MEDALRANK_SILVER THEN
    //銀
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_02 , C03R1102_PEOPLE_01, POS_DEFAULT )
  CASE SCR_MEDALRANK_GOLD THEN
    //金
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_03 , C03R1102_PEOPLE_01, POS_DEFAULT )
  CASE SCR_MEDALRANK_BW THEN
    //白黒
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_04 , C03R1102_PEOPLE_01, POS_DEFAULT )
  //デフォルト
  DEFAULT
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_05 , C03R1102_PEOPLE_01, POS_DEFAULT )
  ENDSWITCH

}
EVENT_END

/**************************************************************/
/*  C03 PEOPLE01の会話（女）                      */
/**************************************************************/
EVENT_START   ev_c03r1102_people_02
{
  _TALK_OBJ_START()
  
    DEFINE_LOCAL	LWK_SELECT
    DEFINE_LOCAL	LWK_REPEAT
		WHILE $LWK_REPEAT != 1

			_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_01 , C03R1102_PEOPLE_02, POS_DEFAULT )

			//メニュー開く
			_BMPMENU_INIT_RIGHT(MENU_X1, MENU_Y1, 0, 1, LWK_SELECT )
	
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_01, 0 )	//メダルラリー
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_02, 1 )	//メダル
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_03, 2 )	//ヒントメダル
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_04, 3 )	//メダルボックス
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_05, 4 )	//イチオシとうろく
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_06, 5 )	//なんでもないです
	
			//メニュー表示
			_BMPMENU_START()

			SWITCH $LWK_SELECT
			CASE 0 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win01 , C03R1102_PEOPLE_02, POS_DEFAULT )
			CASE 1 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win02 , C03R1102_PEOPLE_02, POS_DEFAULT )
			CASE 2 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win03 , C03R1102_PEOPLE_02, POS_DEFAULT )
			CASE 3 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win04 , C03R1102_PEOPLE_02, POS_DEFAULT )
			CASE 4 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win05 , C03R1102_PEOPLE_02, POS_DEFAULT )
			DEFAULT
				_LAST_KEYWAIT()
				_MSGWIN_CLOSE()
				//========================================/
				//繰り返し脱出
				$LWK_REPEAT = 1
				//========================================/
			ENDSWITCH
			
		ENDWHILE
}
EVENT_END

/**************************************************************/
/*  C03 PEOPLE01の会話（ミドル）                      */
/**************************************************************/
EVENT_START   ev_c03r1102_people_03

  //メダル授与状態で分岐
  
  //未授与
  IF $WK_SCENE_MEDAL_EVENT <= 1 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG(msg_mdlnpc_fan_03)
  //ゴールイン
  ELSIF $WK_SCENE_MEDAL_EVENT >= 3 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG(msg_mdlnpc_fan_02)
  //フルコンプリート
  ELSIF $WK_SCENE_MEDAL_EVENT >= 4 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG(msg_mdlnpc_fan_01)
  ENDIF
  
EVENT_END

