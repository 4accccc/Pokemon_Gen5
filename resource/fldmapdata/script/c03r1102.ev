/**************************************************************/
/*  C03 MEDALMANの会話                      */
/**************************************************************/
EVENT_START   ev_c03r1102_medalman_01
  
  //プレイヤー名格納
  _PLAYER_NAME( 0 )
  
  //ゴール
  IF $WK_SCENE_MEDAL_EVENT == 3 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_prizegoal_end )
  
  //コンプリート
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_mdloyj_prizecomp_end )
  ENDIF

EVENT_END
/**************************************************************/
/*  C03 PEOPLE01の会話（OL）                      */
/**************************************************************/
EVENT_START   ev_c03r1102_people_01
{ 

  _TALK_OBJ_START()
  
  //メダルランクチェック
  DEFINE_LOCAL	LWK_NEDAL_RANK
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_RANK, LWK_NEDAL_RANK )
  //ランク名格納
  _MEDAL_RANK_NAME( 1, LWK_NEDAL_RANK )
  
  //メダル取得変数
  DEFINE_LOCAL  MEDAL_CHC_TITLE_GET
  //取得したメダル数取得
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_TITLE_GET, MEDAL_CHC_TITLE_GET )
  //取得したメダル数代入
  _NUMBER( 0, MEDAL_CHC_TITLE_GET, 3 )
  
  SWITCH $LWK_NEDAL_RANK
  CASE SCR_MEDALRANK_COPPER THEN
     //銅
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_01 , C03R1102_PEOPLE_01, POS_DEFAULT )
  CASE SCR_MEDALRANK_SILVER THEN
    //銀
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_02 , C03R1102_PEOPLE_01, POS_DEFAULT )
  CASE SCR_MEDALRANK_GOLD THEN
    //金
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_03 , C03R1102_PEOPLE_01, POS_DEFAULT )
  CASE SCR_MEDALRANK_BW THEN
    //白黒
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_04 , C03R1102_PEOPLE_01, POS_DEFAULT )
  //デフォルト
  DEFAULT
    _BALLOONWIN_OBJMSG_POS( msg_mdlnpc_rank_05 , C03R1102_PEOPLE_01, POS_DEFAULT )
  ENDSWITCH
  
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
}
EVENT_END

/**************************************************************/
/*  C03 PEOPLE01の会話（CLEANINGM）                      */
/**************************************************************/
EVENT_START   ev_c03r1102_people_02
{
  _TALK_OBJ_START()
  
    DEFINE_LOCAL	LWK_SELECT
    DEFINE_LOCAL	LWK_REPEAT
		WHILE $LWK_REPEAT != 1

			_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_01 , C03R1102_PEOPLE_02, POS_DOWN )

			//メニュー開く
			_BMPMENU_INIT_RIGHT(MENU_X1, MENU_Y1, 0, 1, LWK_SELECT )
	
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_01, 0 )	//メダルラリー
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_02, 1 )	//メダル
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_03, 2 )	//ヒントメダル
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_04, 3 )	//メダルボックス
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_05, 4 )	//イチオシとうろく
			_BMPMENU_MAKE_LIST( msg_mdlnpc_help_02_06, 5 )	//なんでもないです
	
			//メニュー表示
			_BMPMENU_START()

			SWITCH $LWK_SELECT
			CASE 0 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win01 , C03R1102_PEOPLE_02, POS_DEFAULT )
			CASE 1 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win02 , C03R1102_PEOPLE_02, POS_DEFAULT )
			CASE 2 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win03 , C03R1102_PEOPLE_02, POS_DEFAULT )
			CASE 3 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win04 , C03R1102_PEOPLE_02, POS_DEFAULT )
			CASE 4 THEN
				_BALLOONWIN_OBJMSG_POS( msg_mdlnpc_help_win05 , C03R1102_PEOPLE_02, POS_DEFAULT )
			DEFAULT
				_MSGWIN_CLOSE()
				//========================================/
				//繰り返し脱出
				$LWK_REPEAT = 1
				//========================================/
			ENDSWITCH
			
		ENDWHILE
}
EVENT_END

/**************************************************************/
/*  C03 PEOPLE01の会話（GENTLEMAN）                      */
/**************************************************************/
EVENT_START   ev_c03r1102_people_03

  //メダル授与状態で分岐
  
  //未授与
  IF $WK_SCENE_MEDAL_EVENT <= 1 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG(msg_mdlnpc_fan_03)
  //ゴールイン
  ELSIF $WK_SCENE_MEDAL_EVENT == 3 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG(msg_mdlnpc_fan_02)
  //フルコンプリート
  ELSIF $WK_SCENE_MEDAL_EVENT == 5 THEN
    _EASY_BALLOONWIN_TALKOBJ_MSG(msg_mdlnpc_fan_01)
  ENDIF
  
EVENT_END

/**************************************************************/
/*  石像 */
/**************************************************************/
EVENT_START   ev_bg_c03r1102_statue_01
  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_mdlbg_01 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()
EVENT_END

/**************************************************************/
/*  グラフ */
/**************************************************************/
EVENT_START   ev_bg_c03r1102_graph_01
{

  //主人公名格納
  _PLAYER_NAME( 0 )

  //メダル取得変数
  DEFINE_LOCAL  MEDAL_CHC_TITLE_GET
  //取得したメダル数取得
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_TITLE_GET, MEDAL_CHC_TITLE_GET )
  //取得したメダル数代入
  _NUMBER( 1, MEDAL_CHC_TITLE_GET, 3 )

  //メダルランクチェック
  DEFINE_LOCAL	LWK_NEDAL_RANK
  _GET_MEDAL_COUNT( SCR_MEDALCOUNT_RANK, LWK_NEDAL_RANK )
  //ランク名格納
  _MEDAL_RANK_NAME( 2, LWK_NEDAL_RANK )
  

  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_mdlbg_02 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()
}
EVENT_END

/**************************************************************/
/*  額縁 */
/**************************************************************/
EVENT_START   ev_bg_c03r1102_frame_01
  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_mdlbg_03 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()
EVENT_END

/************************************************************/
/*            クラウン１（ヒウンラリー）                  */
/************************************************************/
EVENT_START   ev_c03r1102_clown_01

  _TALK_OBJ_START()
  //ライモンラリー・メダル事務局通過（1回のみ）
  IF $WK_SCENE_C03_RALLY_01 != 6 && FLAG_OFF( FE_C03_RALLYPOINT_01 )THEN
    _SE_PLAY( SEQ_SE_FLD_41 ) //正解SE
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r1202_rally_01 )

    //========================================//
    //クリア後メッセージ表示終了
    _FLAG_SET( FE_C03_RALLYPOINT_01 )
    //========================================//
    //C04イベント進行
    $WK_SCENE_C03_RALLY_01 += 1
    //========================================//

    _SE_WAIT()
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE
    //以降のメッセージ
    _BALLOONWIN_TALKOBJ_MSG( msg_c03r1202_rally_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END


