/*  おばさん：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_c04r0501_middlewoman_01

  //ゲームクリア後か
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
    //おばさん：ポケモンを　うばわれた　ひとですけど
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c04r0501_middleman2_02 )

