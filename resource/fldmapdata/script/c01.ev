EVENT_END

/**************************************************************/
/*  C01 FISING  アイテム入手イベントスクリプト                */
/**************************************************************/
EVENT_START   ev_c01_fising_01
  //アイテム「おおきなしんじゅ」入手
  _EASY_TALK_ITEM_EVENT( ITEM_OOKINASINZYU, 1, FE_C01_ITEMGET_01, msg_c01_fising_01, msg_c01_fising_02, msg_c01_fising_02 )
EVENT_END

/**************************************************************/
/*  C01 BADMAN  アイテム入手イベント                          */
/**************************************************************/
EVENT_START   ev_c01_badman_01
  //アイテム「ダークボール×５」入手
  _EASY_TALK_ITEM_EVENT( ITEM_DAAKUBOORU, 5, FE_C01_ITEMGET_02, msg_c01_badman1_01, msg_c01_badman1_02, msg_c01_badman1_02 )
EVENT_END

/**************************************************************/
/*  ブリーダー♂：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_c01_breederm_01

  //季節と時間帯を取得
  _GET_SEASON_ID( SCWK_SEASON )
  _GET_TIMEZONE( LWK_TIMEZONE )

  //夏だった場合
  IF $SCWK_SEASON == PMSEASON_SUMMER THEN

    //夜の場合
    IF $LWK_TIMEZONE == TIMEZONE_NIGHT || $LWK_TIMEZONE == TIMEZONE_MIDNIGHT THEN

      //ブリーダー：このごろ　はやりといえば
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c01_badman2_03 )

    //昼の場合
    ELSE

      //ブリーダー：さいきん　よるになると
      _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c01_badman2_02 )

    ENDIF

  ELSE

    //ブリーダー：なつが　まちどおしいな
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c01_badman2_01 )

  ENDIF

EVENT_END

