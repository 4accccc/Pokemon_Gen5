/**************************************************************/
/*  女の子：話しかけ（ランダムメッセージ）                    */
/**************************************************************/
EVENT_START   ev_c01_babygirl1_01

  _TALK_OBJ_START()

  //乱数で0～3幅でセリフの順番を決める
  _GET_RND( LOCALWORK0, 3 )

  IF $LOCALWORK0 == 0 THEN

    //女の子：くさタイプの　ポケモンは
    _BALLOONWIN_TALKOBJ_MSG( msg_c01_babygirl1_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSIF $LOCALWORK0 == 1 THEN

    //女の子：みずタイプの　ポケモンは
    _BALLOONWIN_TALKOBJ_MSG( msg_c01_babygirl1_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSIF $LOCALWORK0 == 2 THEN

    //女の子：ほのおタイプの　ポケモンは
    _BALLOONWIN_TALKOBJ_MSG( msg_c01_babygirl1_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

/**************************************************************/
/*  女性02：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c01_woman2_02
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c01_woman2a_01 )
EVENT_END

/**************************************************************/
/*  保育士：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c01_woman3_01

  _TALK_OBJ_START()

  //保育士：あなたの　メダルボックス……▼
  _BALLOONWIN_TALKOBJ_MSG( msg_c01_woman3_01 )

  //もっとも獲得比率の高いメダルカテゴリを取得
  _GET_MOST_GET_MEDALCATEGORY( LWK_CATEGORY )

  //『とくべつ』メダルの比率が高い場合
  IF $LWK_CATEGORY == 4 THEN

    //保育士：きんいろの『とくべつ』メダルが
    _BALLOONWIN_TALKOBJ_MSG( msg_c01_woman3_06 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //『ちょうせん』メダルの比率が高い場合
  ELSIF $LWK_CATEGORY == 3 THEN

    //保育士：むらさきの『ちょうせん』メダルが
    _BALLOONWIN_TALKOBJ_MSG( msg_c01_woman3_05 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //『せんとう』メダルの比率が高い場合
  ELSIF $LWK_CATEGORY == 1 THEN

    //保育士：あおい『せんとう』のメダルが
    _BALLOONWIN_TALKOBJ_MSG( msg_c01_woman3_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //『おたのしみ』メダルの比率が高い場合
  ELSIF $LWK_CATEGORY == 2 THEN

    //保育士：ピンクの『おたのしみ』メダルが
    _BALLOONWIN_TALKOBJ_MSG( msg_c01_woman3_04 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //『ぼうけん』メダルの比率が高い場合
  ELSIF $LWK_CATEGORY == 0 THEN

    //保育士：オレンジの『ぼうけん』メダルが
    _BALLOONWIN_TALKOBJ_MSG( msg_c01_woman3_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

/************************************************************/
/*	DANPEI	一言メッセージ							*/
/************************************************************/
EVENT_START	ev_c01_glassese_01

	_TALK_OBJ_START()
	
	//ポケモンしょうぶも　たのしめる
	_BALLOONWIN_TALKOBJ_MSG_POS( msg_c01_glasses_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( C01_GLASSESE_01, anm_staystep_u )
	_OBJ_ANIME_WAIT()

	//ドアアニメ再生
	_BMODEL_ANIME_CREATE( SCWK_ANSWER, SCR_BMID_DOOR, 788, 586 )
	_BMODEL_ANIME_SET( SCWK_ANSWER, SCR_BMANM_DOOR_OPEN )
	_BMODEL_ANIME_WAIT( SCWK_ANSWER )

	_OBJ_ANIME( C01_GLASSESE_01, anm_walk_u )
	_OBJ_ANIME_WAIT()

	_OBJ_DEL( C01_GLASSESE_01 )

	_BMODEL_ANIME_SET( SCWK_ANSWER, SCR_BMANM_DOOR_CLOSE )
	_BMODEL_ANIME_WAIT( SCWK_ANSWER )
	_BMODEL_ANIME_DELETE( SCWK_ANSWER )

	//========================================//
	
	//ダンペイのバニシュセット
	_FLAG_SET(FV_C01_GLASSESE_01)
	
	//========================================//

EVENT_END

