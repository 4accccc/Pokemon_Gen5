//季節と時間変数
DEFINE_LOCAL SCWK_SEASON
DEFINE_LOCAL LWK_TIMEZONE

//メダルカテゴリ取得用変数
DEFINE_LOCAL LWK_CATEGORY

//------------------------------注意--------------------------------//
//                                                                  //
//  クイズイベントに LOCALWORK0 を使用しています。                  //
//  同マップ内の使用を禁止します。                                  //
//                                                                  //
//------------------------------------------------------------------//


/************************************************************/
/*  ZONE_CHANGE_SCRIPT                                      */
/************************************************************/
INIT_EVENT_START  ev_zone_c01

  //季節と時間帯を取得
  _GET_SEASON_ID( SCWK_SEASON )
  _GET_TIMEZONE( LWK_TIMEZONE )

  //夏だった場合
  IF $SCWK_SEASON == PMSEASON_SUMMER THEN
    //夜のにのみマッギョが出現
    IF $LWK_TIMEZONE == TIMEZONE_NIGHT || $LWK_TIMEZONE == TIMEZONE_MIDNIGHT THEN
      //========================================//
      //マッギョ表示
      _FLAG_RESET( FV_C01_POKE44_01 )
      //========================================//

    //昼の場合はマッギョを非表示
    ELSE
      //========================================//
      //マッギョ非表示
      _FLAG_SET( FV_C01_POKE44_01 )
      //========================================//

    ENDIF

  //それ以外の季節
  ELSE

    //========================================//
    //マッギョ非表示
    _FLAG_SET( FV_C01_POKE44_01 )
    //========================================//

  ENDIF

  //ラティオス（ラティアス）と戦闘していない？　→「夢の跡地」のイベント準備
  IF FLAG_OFF( FE_D01R0101_RATI2_GET_01 ) && $WK_SCENE_D01R0101_RATI2 != 6 THEN

    //========================================//
    //イベント進行
    $WK_SCENE_D01R0101_RATI2 = 0
    //========================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  C01 SIGN1用イベントスクリプト                             */
/**************************************************************/
EVENT_START   ev_bg_c01_sign1_01
  _EASY_BGWIN_MSG( msg_c01_sign1_01, TYPE_TOWN )
EVENT_END

