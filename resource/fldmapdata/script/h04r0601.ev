
//======================================================================
//                h04r0601.ev
//
//    スクリプトファイル：h04r0601用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_h04r0601.h"
  .include  "h04r0601.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_h04r0601_woman3_01
_EVENT_DATA   ev_h04r0601_poke39_01
_EVENT_DATA_END


/**************************************************************/
/*  女性：話しかけ（回復処理）                                */
/**************************************************************/
EVENT_START   ev_h04r0601_woman3_01
{

  //体力の満タンではないポケモンのための変数定義
  DEFINE_LOCAL LWK_PARTY_NUM  //手持ちポケモンの数
  DEFINE_LOCAL LWK_COUNT_NUM  //WHILE文のカウンタ
  DEFINE_LOCAL LWK_RET_HP     //HPチェックの帰り値
  DEFINE_LOCAL LWK_RET_PP     //PPチェックの帰り値
  DEFINE_LOCAL LWK_DAME       //HPかPPが満タンではないポケモンの数

  _TALK_OBJ_START()

  //手持ちのポケモンの数を確認（ひんし、タマゴのポケモンは除外）
  _GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_BATTLE_ENABLE )

  //手持ちのポケモンの中にHPかPPが満タンではないポケモンがいるか確認（繰り返し処理）
  WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

    //指定POSのポケモンのHPを取得
    _CHECK_TEMOTI_HP( LWK_RET_HP, LWK_COUNT_NUM )

    //指定POSのポケモンのPPを取得
    _CHECK_TEMOTI_PP( LWK_RET_PP, LWK_COUNT_NUM )

    //チェックしたポケモンのHP（またはPP）が満タンではないのならば
    IF $LWK_RET_HP == FALSE || $LWK_RET_PP == FALSE THEN
      //HPかPPが満タンではないポケモンの数に＋１
      $LWK_DAME += 1

    ENDIF

    //カウント
    $LWK_COUNT_NUM += 1

  ENDWHILE

  //手持ちにHPかPPが満タンではないポケモンがいた場合
  IF $LWK_DAME >= 1 THEN

    //女性：あら　あなたの　ポケモン
    _BALLOONWIN_TALKOBJ_MSG( msg_h04r0601_woman3_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //暗転して手持ちポケモンを回復
    _BLACK_OUT()
    _DISP_FADE_END_CHECK()
    _TEMOTI_POKEMON_KAIFUKU()   //回復処理
    _ME_PLAY( SEQ_ME_ASA )
    _ME_WAIT()
    _BLACK_IN()
    _DISP_FADE_END_CHECK()

  //手持ちのポケモンはHPもPPも満タン
  ELSE

    //女性：あなたも　あなたの　ポケモンも
    _BALLOONWIN_TALKOBJ_MSG( msg_h04r0601_woman3_01 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

}
EVENT_END

/**************************************************************/
/*  ゴチミル：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_h04r0601_poke39_01
  _EASY_TALK_POKEVOICE( MONSNO_607, msg_h04r0601_poke39_01 )
EVENT_END


