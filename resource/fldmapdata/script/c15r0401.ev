
//======================================================================
//                c15r0401.ev
//
//    スクリプトファイル：c15r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c15r0401.h"
  .include  "c15r0401.h"

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_init_c15r0401
_EVENT_DATA    ev_reserve_c15r0401_sunglasses_01
_EVENT_DATA_END


/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_c15r0401

  IF $WK_SCENE_C15_BONUS_EVENT_01 == 1 THEN
    _OBJ_POS_CHANGE( C15R0401_SUNGLASSES_01, 12, 0, 16, DIR_LEFT )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/* サングラスイベント（予約スクリプト）                       */
/*  ポケウッドごほうびイベント後にくる                        */
/**************************************************************/
EVENT_START    ev_reserve_c15r0401_sunglasses_01

  //タグ０にプレイヤー名
  _PLAYER_NAME( 0 )

  //サングラス：ここは　ウッドウさんが　みとめた
  _BALLOONWIN_OBJMSG_POS( msg_c15r0401_end_14, C15R0401_SUNGLASSES_01, POS_DOWN )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()

  // 退室
  _OBJ_ANIME( C15R0401_SUNGLASSES_01, anm_exit )
  _OBJ_ANIME_WAIT()
	// 削除
  _OBJ_POS_CHANGE( C15R0401_SUNGLASSES_01, 12, 0, 30, DIR_LEFT )

  //==================================//
  // C15ごほうびイベント終了
  $WK_SCENE_C15_BONUS_EVENT_01 = 2
  //==================================//

EVENT_END

//--------------------------------------------------------------
//	退室
//--------------------------------------------------------------
_ANIME_LABEL  anm_exit
  _ANIME_DATA AC_WALK_R_8F, 7
  _ANIME_DATA ACMD_END, 0

