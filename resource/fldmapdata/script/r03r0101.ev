//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_r03r0101_woman3_02
_EVENT_DATA    ev_r03r0101_middlewoman2_01
_EVENT_DATA    ev_r03r0101_woman3_01
_EVENT_DATA    ev_r03r0101_babygirl1_01
_EVENT_DATA    ev_r03r0101_babyboy1_01
_EVENT_DATA    ev_r03r0101_babyboy1_02
_EVENT_DATA    ev_r03r0101_poke33_01
_EVENT_DATA    ev_r03r0101_poke34_01
_EVENT_DATA    ev_r03r0101_poke35_01
_EVENT_DATA_END

//------------------------------注意--------------------------------//
//                                                                  //
//  LOCALWORK1を使用しました。同マップ内の使用を禁止します。        //
//  LOCALWORK1⇒回復処理を行った後1                                 // 
//                                                                  //
//------------------------------------------------------------------//


/**************************************************************/
/*  R03R0101 WOMAN3（回復処理）                               */
/**************************************************************/
EVENT_START   ev_r03r0101_woman3_02
{

  //体力の満タンではないポケモンのための変数定義
  DEFINE_LOCAL LWK_PARTY_NUM  //手持ちポケモンの数
  DEFINE_LOCAL LWK_COUNT_NUM  //WHILE文のカウンタ
  DEFINE_LOCAL LWK_RET_HP     //HPチェックの帰り値
  DEFINE_LOCAL LWK_RET_PP     //PPチェックの帰り値
  DEFINE_LOCAL LWK_DAME       //HPかPPが満タンではないポケモンの数

  _TALK_OBJ_START()

  //手持ちのポケモンの数を確認
  _GET_PARTY_POKE_COUNT( LWK_PARTY_NUM, POKECOUNT_MODE_TOTAL )

  //手持ちのポケモンの中にHPかPPが満タンではないポケモンがいるか確認（繰り返し処理）
  WHILE $LWK_PARTY_NUM > $LWK_COUNT_NUM

    //指定POSのポケモンのHPを取得
    _CHECK_TEMOTI_HP( LWK_RET_HP, LWK_COUNT_NUM )

    //指定POSのポケモンのPPを取得
    _CHECK_TEMOTI_PP( LWK_RET_PP, LWK_COUNT_NUM )

    //チェックしたポケモンのHP（またはPP）が満タンではないのならば
    IF $LWK_RET_HP == FALSE || $LWK_RET_PP == FALSE THEN
      //HPかPPが満タンではないポケモンの数に＋１
      $LWK_DAME += 1

    ENDIF

    //カウント
    $LWK_COUNT_NUM += 1

  ENDWHILE
  
  //手持ちにHPかPPが満タンではないポケモンがいた場合
  IF $LWK_DAME >= 1 THEN

    //やすんでいきなさい
    _BALLOONWIN_OBJMSG( msg_r03r0101_woman3a_02,R03R0101_WOMAN3_02 )
    _BALLOONWIN_CLOSE()

    //暗転して手持ちポケモンを回復
    _BLACK_OUT()
    _DISP_FADE_END_CHECK()
    _TEMOTI_POKEMON_KAIFUKU()   //回復処理
    _ME_PLAY( SEQ_ME_ASA )
    _ME_WAIT()
    _BLACK_IN()
    _DISP_FADE_END_CHECK()
    
    //元気ね
    _BALLOONWIN_OBJMSG( msg_r03r0101_woman3a_01,R03R0101_WOMAN3_02 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()

  //入室して２回目以降の話しかけ
  ELSE

    //元気ね
    _BALLOONWIN_OBJMSG( msg_r03r0101_woman3a_01,R03R0101_WOMAN3_02 )
    _LAST_KEYWAIT()
    _BALLOONWIN_CLOSE()

  ENDIF

}
EVENT_END

/**************************************************************/
/*  おばさん：話しかけ                                        */
/**************************************************************/
EVENT_START   ev_r03r0101_middlewoman2_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r03r0101_middlewoman2_01 )
EVENT_END

/**************************************************************/
/*  保育師：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_r03r0101_woman3_01

  _TALK_OBJ_START()

  //保育師：あなた　ポケモンの　とくせい
  _BALLOONWIN_TALKOBJ_MSG( msg_r03r0101_woman3_01 )

  //特性「ほのおのからだ」を知っている？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN  //はい

    //保育師：さすがね！　３ばんどうろ　だと
    _BALLOONWIN_TALKOBJ_MSG( msg_r03r0101_woman3_02 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ELSE

    //保育師：じゃあ　きいて！　とくせいが
    _BALLOONWIN_TALKOBJ_MSG( msg_r03r0101_woman3_03 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END

