  .text

  .include  "scr_seq_def.h"
  .include  "../../../prog/include/msg/script/msg_r01.h"
  .include  "r01.h"

  //@author fujimura_souichirou
  //@aithor suginaka_katsunori//データコンバートイベント

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_bg_r01_board_01
_EVENT_DATA   ev_bg_r01_board_02
_EVENT_DATA   ev_bg_r01_board_03
_EVENT_DATA   ev_r01_girl1_01
_EVENT_DATA   ev_r01_man1_01
_EVENT_DATA		ev_r01_fishing_01
_EVENT_DATA		ev_pos_r01_swbell_01
_EVENT_DATA		ev_zone_r01
_EVENT_DATA_END

/**************************************************************/
/*			ゾーンチェンジラベル							  */
/**************************************************************/
INIT_EVENT_START	ev_zone_r01
	
	DEFINE_LOCAL	LWK_CONV
	
	//ゲームをクリアしているかチェック
	_DATACONV_GET_FLAG( DATACONV_FLAG_GAME_CLEAR, LWK_CONV )
	
	//BWをクリアしている場合
	IF $LWK_CONV == TRUE THEN
	
		//今作をクリアしている場合
		IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN
	
			//ベルと戦闘前か？
			IF $WK_SCENE_R01_CONV == 0 THEN
		
				$WK_SCENE_R01_CONV = 1
		
			ENDIF
		
		ENDIF
	
	ENDIF

INIT_EVENT_END

/**************************************************************/
/*  看板01                                                    */
/**************************************************************/
EVENT_START  ev_bg_r01_board_01
  _EASY_BGWIN_MSG( msg_r01_sign1_01, TYPE_ROAD )
EVENT_END

/**************************************************************/
/*  看板02                                                    */
/**************************************************************/
EVENT_START  ev_bg_r01_board_02
  _EASY_BGWIN_MSG( msg_r01_sign2_01, TYPE_ROAD )
EVENT_END

/**************************************************************/
/*  看板03                                                    */
/**************************************************************/
EVENT_START  ev_bg_r01_board_03
  _EASY_BGWIN_MSG( msg_r01_sign3_01, TYPE_INFO )
  _FLAG_SET( MDL_FLAG_BOARD_R01_03 )
EVENT_END

/**************************************************************/
/*  女の子：話しかけ（アイテム入手）                          */
/**************************************************************/
EVENT_START   ev_r01_girl1_01
  //アイテム「キズぐすり」入手
  _EASY_TALK_ITEM_EVENT( ITEM_KIZUGUSURI, 1, FE_C03R0501_ITEMGET_01, msg_r01_girl1_01, msg_r01_girl1_02, msg_r01_girl1_02 )
EVENT_END

/**************************************************************/
/* 男性：話しかけ                                             */
/**************************************************************/
EVENT_START   ev_r01_man1_01

  //コンバート分岐
  //ゲームをクリアしているかチェック
  _DATACONV_GET_FLAG( DATACONV_FLAG_GAME_CLEAR, LWK_CONV )
  //BWをクリアしている場合
  IF $LWK_CONV == TRUE THEN
	//旧主人公名を代入
	_DATACONV_SET_NAME(DATACONV_ID_SYSTEM,0)
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r01_man1_02 )
  //クリアしていない場合
  ELSE
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r01_man1_01 )
  ENDIF
  
EVENT_END

/**************************************************************/
/* 釣り人：話しかけ                                           */
/**************************************************************/
EVENT_START   ev_r01_fishing_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r01_fishing_01 )
EVENT_END

/**************************************************************/
/*	データコンバートＰＯＳイベント							  */
/**************************************************************/
EVENT_START		ev_pos_r01_swbell_01

	DEFINE_LOCAL	LWK_POSX
	DEFINE_LOCAL	LWK_POSZ

	//ベル出現
	_OBJ_ADD_EX( 788,721,DIR_DOWN,MMDL_ID_EVENTOBJ_00,SWBELL,MV_DMY )

	//おうい！/ねえねえ！
	_GET_MY_SEX(SCWK_ANSWER)
	SWITCH $SCWK_ANSWER
	CASE PM_MALE THEN
		_PLAINWIN_MSG_UP( msg_r01_swbell_01 )
	CASE PM_FEMALE THEN
		_PLAINWIN_MSG_UP( msg_r01_swbell_02 )
	ENDSWITCH

	_PLAINWIN_CLOSE()

	//イベント曲再生
	_START_EVENT_BGM( SEQ_BGM_E_BERU )
	
	//ベル：主人公に隣接　主人公：！マーク
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_gyoe )
	_OBJ_ANIME_WAIT()
	
	_OBJ_POS_GET( MMDL_ID_PLAYER,LWK_POSX,LWK_POSZ )
	_PLAYER_DIR_GET(SCWK_ANSWER)
	_OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 788, 730, FORCE_TYPE_NPC, 8, DIR_UD )
	
	SWITCH $LWK_POSX
	CASE 786 THEN
		IF $SCWK_ANSWER != DIR_UP THEN
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_786 )
		ELSE
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_786u )
		ENDIF
	CASE 787 THEN
		IF $SCWK_ANSWER != DIR_UP THEN
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_787 )
		ELSE
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_787u )
		ENDIF
	CASE 788 THEN
		IF $SCWK_ANSWER != DIR_UP THEN
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_u )
		ELSE
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_dir_u )
		ENDIF
	CASE 789 THEN
		IF $SCWK_ANSWER != DIR_UP THEN
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_789 )
		ELSE
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_789u )
		ENDIF
	CASE 790 THEN
		IF $SCWK_ANSWER != DIR_UP THEN
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_790 )
		ELSE
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_790u )
		ENDIF
	CASE 791 THEN
		IF $SCWK_ANSWER != DIR_UP THEN
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_791 )
		ELSE
			_OBJ_ANIME( MMDL_ID_PLAYER, anm_player_come_791u )
		ENDIF
	ENDSWITCH
	
	_OBJ_ANIME_WAIT()
	
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_kyorokyoro )
	_OBJ_ANIME_WAIT()
	
	//ここ　なつかしいなあ
	_BALLOONWIN_OBJMSG_POS( msg_r01_swbell_03 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_stay_d )
	_OBJ_ANIME_WAIT()

	//旧主人公名を代入
	_DATACONV_SET_NAME(DATACONV_ID_SYSTEM,1)

	//あのひ……
	_BALLOONWIN_OBJMSG_POS( msg_r01_swbell_04 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 789, 731, FORCE_TYPE_NPC, 8, DIR_LR )
	_TIME_WAIT( 15 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_r )
	_OBJ_ANIME_WAIT()

	//旧主人公名を代入
	_DATACONV_SET_NAME(DATACONV_ID_SYSTEM,1)

	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_stay_l )
	_OBJ_ANIME_WAIT()

	//ねえ　旧主人公！
	_BALLOONWIN_OBJMSG_POS( msg_r01_swbell_05 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_u )
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_stay_u )
	_OBJ_ANIME_WAIT()
	
	//せーの！
	_BALLOONWIN_OBJMSG_POS( msg_r01_swbell_06 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_u )
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_walk_u )
	_OBJ_ANIME_WAIT()
	
	_TIME_WAIT( 30 )
	
	_OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_stay_l )
	_TIME_WAIT( 10 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_r )
	_OBJ_ANIME_WAIT()

	//旧主人公名を代入
	_DATACONV_SET_NAME(DATACONV_ID_SYSTEM,1)

	//なんてね
	_BALLOONWIN_OBJMSG_POS( msg_r01_swbell_07 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//変数を定義
	DEFINE_LOCAL	LWK_TYPE
	DEFINE_LOCAL	LWK_TRAINER
	
	//旧主人公の初期タイプを取得
	_DATACONV_GET_WORK( DATACONV_WORK_FIRST_POKETYPE, LWK_TYPE )
	
	SWITCH $LWK_TYPE
	CASE FIRST_POKETYPE_KUSA THEN
		$LWK_TRAINER = TRID_SUPPORT_02
	CASE FIRST_POKETYPE_HONOO THEN
		$LWK_TRAINER = TRID_SUPPORT_03
	CASE FIRST_POKETYPE_MIZU THEN
		$LWK_TRAINER = TRID_SUPPORT_04
	ENDSWITCH
	
	//トレーナー戦呼び出し
	_TRAINER_BTL_SET( LWK_TRAINER, 0 )
	//敗戦チェック
	_TRAINER_LOSE_CHECK( SCWK_ANSWER )
	IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
		_TRAINER_WIN()			//勝ち(1)ならトレーナー勝利処理へ
	ELSE
		_TRAINER_LOSE()			//負け(0)ならトレーナー敗北処理へ(ここでスクリプト終了します）
	ENDIF

	//旧主人公名を代入
	_DATACONV_SET_NAME(DATACONV_ID_SYSTEM,1)

	//うふふ！
	_BALLOONWIN_OBJMSG_POS( msg_r01_swbell_08 , MMDL_ID_EVENTOBJ_00, POS_DEFAULT )
	_MSGWIN_CLOSE()

	_OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 789, 721, FORCE_TYPE_ALL, 8, DIR_UD )
	_TIME_WAIT( 20 )
	_OBJ_ANIME( MMDL_ID_PLAYER, anm_stay_u )
	_OBJ_ANIME_WAIT()
	
	_OBJ_DEL( MMDL_ID_EVENTOBJ_00 )

	_END_EVENT_BGM()

	//========================================/
	
	//イベント終了
	$WK_SCENE_R01_CONV = 2
	
	//========================================/

EVENT_END

