
//======================================================================
//                oldc01r0501.ev
//
//    スクリプトファイル：oldc01r0501用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_oldc01r0501.h"
  .include  "oldc01r0501.h"
  
  .include  "c01gym0101.h"
  .include  "c01gym0101_def.h"

//@author Suginaka Katsunori

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_reserve_oldc01r0501_event_01
_EVENT_DATA_END


/**************************************************************/
/*			過去イベント	コーン・ポッド・デント			  */
/**************************************************************/
EVENT_START		ev_reserve_oldc01r0501_event_01

	_CAMERA_START()		//カメラ操作開始
	_CAMERA_PURGE()		//カメラのバインドを解く

	//カメラ操作　ちょっと上のほうを初期位置にする
	_CAMERA_MOVE( 9694,0,970535,491520,294912,229376,1 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_OBJ_ANIME( MMDL_ID_PLAYER, anm_vanish_on )
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_01, anm_vanish_on )
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_02, anm_vanish_on )
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_03, anm_vanish_on )
	_OBJ_ANIME_WAIT()

	_MAP_FADE_BLACK_IN()

	//カメラ操作　デフォ位置に移動
	_CAMERA_MOVE( 9694,0,970795,491520,0,229376,60 )	//一番最後の引数は移動にかかるフレーム数
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_MAP_FADE_END_CHECK()

	//デント：ポッドきいてる？
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1c_01 , OLDC01R0501_OLD_LEADER1C_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ポッド：それだけどさ
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1a_01 , OLDC01R0501_OLD_LEADER1A_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//コーン：まあ　そうでしょうね
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1b_01 , OLDC01R0501_OLD_LEADER1B_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//デント：そうかなあ…
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1c_02 , OLDC01R0501_OLD_LEADER1C_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ポッド：だーかーら
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1a_02 , OLDC01R0501_OLD_LEADER1A_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//コーン：かんがえすぎ　だけど
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1b_02 , OLDC01R0501_OLD_LEADER1B_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//デント：ふたりとも……
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1c_03 , OLDC01R0501_OLD_LEADER1C_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ポッド；いいたいことは　わかる
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1a_03 , OLDC01R0501_OLD_LEADER1A_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//ニンジャ１のバニシュをリセット・特殊アニメ
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_01, anm_ninja_come )
	_OBJ_ANIME_WAIT()
	
	//ニンジャ：だったら相手をしてやる
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_ninja1_01 , OLDC01R0501_OLD_NINJA_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//ニンジャ２・３も表示
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_02, anm_ninja_come )
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_03, anm_ninja_come )
	_OBJ_ANIME_WAIT()

	_CAMERA_MOVE( 9688,0,970752,667648,0,229376,30 )	//一番最後の引数は移動にかかるフレーム数

	//３つ子！マーク　デントのみ遅れる
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1A_01, anm_gyoe )
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1B_01, anm_gyoe )
	_TIME_WAIT( 10 )
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1C_01, anm_hatena )
	_OBJ_ANIME_WAIT()	

	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1A_01, anm_stay_r )
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1B_01, anm_stay_r )
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1C_01, anm_leader1c_move_01 )
	_OBJ_ANIME_WAIT()
	
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	//コーン：その　すがた
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1b_03 , OLDC01R0501_OLD_LEADER1B_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ニンジャ：きまぐれ　うさばらし
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_ninja3_01 , OLDC01R0501_OLD_NINJA_03, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ポッド　その場歩き
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1A_01, anm_stay_r )
	_OBJ_ANIME_WAIT()
	
	//ポッド：３ｖｓ３か！
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1a_04 , OLDC01R0501_OLD_LEADER1A_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//全員一歩前に出つつ、暗転
	_BLACK_OUT()
	
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1A_01, anm_walk_r )
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1B_01, anm_walk_r )
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_01, anm_walk_l )
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_02, anm_walk_l )
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_03, anm_walk_l )	
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1C_01, anm_walk_r )
	_OBJ_ANIME_WAIT()
	
	_DISP_FADE_END_CHECK()

	_TIME_WAIT( 90 )
		
	//暗転復帰
	_BLACK_IN()
	_DISP_FADE_END_CHECK()
	
	//三つ子　ゆっくり１歩下がる
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1A_01, anm_back_l )
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1B_01, anm_back_l )
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1C_01, anm_back_l )
	_OBJ_ANIME_WAIT()
	
	_TIME_WAIT( 30 )

	//ニンジャ：たあいも　ない
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_ninja1_02 , OLDC01R0501_OLD_NINJA_01, POS_DEFAULT )
	_MSGWIN_CLOSE()

	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_02, anm_stay_d )
	_OBJ_ANIME_WAIT()

	//ニンジャ：こいつら　いがいの　ジムリーダーには
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_ninja2_01 , OLDC01R0501_OLD_NINJA_02, POS_DEFAULT )
	_MSGWIN_CLOSE()

	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_03, anm_stay_u )
	_OBJ_ANIME_WAIT()

	//ニンジャ：さて　ゲーチスさまが
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_ninja3_02 , OLDC01R0501_OLD_NINJA_03, POS_DEFAULT )
	_MSGWIN_CLOSE()

	//ニンジャ１～３　消えるアニメ
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_01, anm_ninja_leave )
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_02, anm_ninja_leave )
	_OBJ_ANIME( OLDC01R0501_OLD_NINJA_03, anm_ninja_leave )
	_OBJ_ANIME_WAIT()
	
	//カメラ操作　デフォ位置に移動
	_CAMERA_MOVE( 9694,0,970795,491520,0,229376,30 )	//一番最後の引数は移動にかかるフレーム数	
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち

	_TIME_WAIT( 30 )

	//ポッド　左を向く
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1A_01, anm_stay_l )
	_OBJ_ANIME_WAIT()

	//ポッド：なんだよ　なんだよこれ！
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1a_05 , OLDC01R0501_OLD_LEADER1A_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//デント　上を向く
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1C_01, anm_stay_u )
	_OBJ_ANIME_WAIT()
	
	//デント：だって　あっとうてきで
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1c_04 , OLDC01R0501_OLD_LEADER1C_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//コーン：みとめざるを　えません
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1b_04 , OLDC01R0501_OLD_LEADER1B_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//デント：そうだね　ポッド　コーン
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1c_05 , OLDC01R0501_OLD_LEADER1C_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ポッド・コーン　向かい合う
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1A_01, anm_stay_d )
	_OBJ_ANIME( OLDC01R0501_OLD_LEADER1B_01, anm_stay_l )
	_OBJ_ANIME_WAIT()
	
	//ポッド：まさか　おまえに
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1a_06 , OLDC01R0501_OLD_LEADER1A_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//コーン：もちろん　コーンも
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1b_05 , OLDC01R0501_OLD_LEADER1B_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//デント：そうですね　ジムリーダーをやめて
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1c_06 , OLDC01R0501_OLD_LEADER1C_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//ポッド：みつご　だもんな
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1a_07 , OLDC01R0501_OLD_LEADER1A_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	//コーン：では　かわりの
	_BALLOONWIN_OBJMSG_POS( msg_oldc01r0501_old_leader1b_06 , OLDC01R0501_OLD_LEADER1B_01, POS_DEFAULT )
	_MSGWIN_CLOSE()
	
	_CAMERA_MOVE( 9694,0,970535,491520,294912,229376,30 )

	//画面暗転処理
	_MAP_FADE_BLACK_OUT_SLOW()
	_MAP_FADE_END_CHECK()
	
	_CAMERA_WAIT_MOVE()	//カメラ移動待ち
	
	//予約スクリプト
	_RESERVE_SCRIPT( SCRID_RESERVE_C01GYM0101_LINK_EVENT_RET )

	_CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
	_CAMERA_END()		//カメラ操作終了

	//マップチェンジ
	_MAP_CHANGE_NO_FADE( ZONE_ID_C01GYM0101, 11, 0, 3 ,  DIR_UP )

EVENT_END


//--------------------------------------------------------------------
//	☆共通処理：歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_stay_u
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stay_d
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stay_l
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_stay_r
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：ギョエ・はてな
//--------------------------------------------------------------------
_ANIME_LABEL	anm_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_hatena
	_ANIME_DATA	AC_MARK_HATENA,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：１歩下がる
//--------------------------------------------------------------------
_ANIME_LABEL	anm_back_l
	_ANIME_DATA	AC_DIR_PAUSE_ON,1
	_ANIME_DATA	AC_WALK_L_12F,1
	_ANIME_DATA	AC_DIR_PAUSE_OFF,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：非表示
//--------------------------------------------------------------------
_ANIME_LABEL	anm_vanish_on
	_ANIME_DATA	AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆三つ子：演技
//--------------------------------------------------------------------
_ANIME_LABEL	anm_leader1c_move_01
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_leader1a_move_01
	_ANIME_DATA	AC_WALK_L_16F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_leader1c_move_02
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_leader1a_move_02
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆ニンジャ：出現・退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_ninja_come
	_ANIME_DATA	AC_VANISH_OFF,1
	_ANIME_DATA	AC_NINJA_ACT0,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_ninja_leave
	_ANIME_DATA	AC_NINJA_ACT1,1
	_ANIME_DATA	AC_VANISH_ON,1
	_ANIME_DATA	ACMD_END,0
