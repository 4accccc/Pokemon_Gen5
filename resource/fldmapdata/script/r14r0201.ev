//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_oldman_gyoe
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0

/**************************************************************/
/*  SCENE_CHANGE：伝承イベント                                 */
/**************************************************************/
EVENT_START   ev_scene_r14r0201_boy2_01
  
  //カメラ操作　イベント追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,3375104,32795,3244032,40 )

  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  
  //アニメ：主人公がX50なら中央に移動
  IF $LCW_POSX == 50 THEN
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_look_boy2_x50 )
  ELSE
    _OBJ_ANIME( MMDL_ID_PLAYER , anm_player_look_boy2_x51 )
  ENDIF
  _OBJ_ANIME_WAIT()

  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //兄：ランドロスさまの
  _BALLOONWIN_OBJMSG_POS( msg_r14r0201_boy1_01 , R14R0201_BOY1_01 , POS_UR)
  _MSGWIN_CLOSE()
  
  //アニメ：BOY2主人公の隣へ
  _OBJ_ANIME( R14R0201_BOY2_01, anm_r14r0210_boy2_playtag_01 )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( R14R0201_BOY1_01, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //弟：しってるよ！
	_BALLOONWIN_OBJMSG_WB( msg_r14r0201_boy2_01w , msg_r14r0201_boy2_01b , R14R0201_BOY2_01 , POS_DR)
	_AB_KEYWAIT_MARK()
	_BALLOONWIN_CLOSE()
  
  //アニメ：BOY1隣接
  _OBJ_ANIME( R14R0201_BOY1_01, anm_r14r0210_boy1_playtag_01 )
  _OBJ_ANIME_WAIT()
  
  //兄：ならいいんだよ
  _BALLOONWIN_OBJMSG_POS( msg_r14r0201_boy1_02 , R14R0201_BOY1_01 , POS_UR)
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (34)
  
  //アニメ：BOY1・BOY2退場
  _OBJ_ANIME( R14R0201_BOY1_01, anm_r14r0210_boy1_playtag_02 )
  _TIME_WAIT( 2 )
  _OBJ_ANIME( R14R0201_BOY2_01, anm_r14r0210_boy2_playtag_02 )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  
  _OBJ_ANIME_WAIT()
  //BOY2非表示に
  _OBJ_DEL( R14R0201_BOY2_01 )
  
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //アニメ：BOY1退場
  _OBJ_ANIME( R14R0201_BOY1_01, anm_r14r0210_boy1_playtag_03 )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _OBJ_DEL( R14R0201_BOY1_01 )
  _SE_WAIT()
  
  //アニメ：GIRL1隣接
  _OBJ_ANIME( R14R0201_GIRL1_01, anm_r14r0210_girl1_comeing_01 )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //姉：ほこらは
  _BALLOONWIN_OBJMSG_POS( msg_r14r0201_girl1_01 , R14R0201_GIRL1_01 , POS_UL)
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //アニメ：GIRL1退場
  _OBJ_ANIME( R14R0201_GIRL1_01, anm_r14r0210_girl1_bye_01 )
  _TIME_WAIT( 16 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //階段SE再生
  _SE_PLAY( SEQ_SE_KAIDAN )
  _OBJ_DEL( R14R0201_GIRL1_01 )
  _SE_WAIT()
  
  //==================================//
  //豊穣の社伝承イベント終了
  $WK_SCENE_R14R0201_BOY2_01 = 1
  //伝承イベント動作モデル非表示
  _FLAG_SET( FV_OMUSUTAA_01 )
  //==================================//
EVENT_END

