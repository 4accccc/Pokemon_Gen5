/**************************************************************/
/*  お嬢様：話しかけ  （買い物お願いお嬢様）                  */
/**************************************************************/
EVENT_START   ev_r09r0201_girl4_01

  _TALK_OBJ_START()

  //お使いを頼まれていない
  IF $WK_OTHER_R9R0201_ITEMBUY == 0 && FLAG_OFF( TMFLG_R9R0201_ITEMBUY_CLEAR ) THEN

    //お嬢様：わたし……　おじょうさま　よ▼
    _BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_girl4_01 )

    //すごいキズぐすりを買ってくる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN  //はい

      //お嬢様：ありがとう！
      _BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_girl4_02 )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      //主人公名代入
      _PLAYER_NAME( 0 )
      //メッセージ：1200円　を　うけとった！
      _SYSWIN_MSG( msg_r09r0201_girl4_03, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //1200円増やす（所持金が最大でもこの処理）
      _ADD_GOLD( 1200 ) 

      //========================================//
      //タイムフラグON、ワーク制御
      _FLAG_SET( TMFLG_R9R0201_ITEMBUY )
      $WK_OTHER_R9R0201_ITEMBUY = 1
      //========================================//

    ELSE    //いいえ

      //お嬢様：わたしの　たのみを　ことわれる
      _BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_girl4_04 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //イベント中
  ELSIF $WK_OTHER_R9R0201_ITEMBUY == 1 && FLAG_OFF( TMFLG_R9R0201_ITEMBUY_CLEAR ) THEN

    //お嬢様：それとも　もう　かってきてくれた？
    _BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_girl4_05 )

    //すごいキズぐすりを買ってきた？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN  //はい

      //アイテムチェック（すごいキズぐすり）
      _ITEM_CHK( ITEM_SUGOIKIZUGUSURI, 1, SCWK_ANSWER )

      //すごいキズグスリを買ってきて、なおかつ日付が変わっていない
      IF $SCWK_ANSWER == FALSE && FLAG_ON( TMFLG_R9R0201_ITEMBUY ) THEN

        //お嬢様：すぐに　かってきてくれて　ありがと！▼
        _BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_girl4_07 )
        _AB_KEYWAIT_MARK()
        _MSGWIN_CLOSE()

        //アイテム（ちからのねっこ）を取得【仮】取得アイテムは仮です
        _ITEM_EVENT_NOWAIT( ITEM_TIKARANONEKKO, 1 )

        //========================================//
        //タイムフラグ（イベントクリア）ON
        _FLAG_SET( TMFLG_R9R0201_ITEMBUY_CLEAR )
        //タイムフラグ（イベント中）OFF
        _FLAG_RESET( TMFLG_R9R0201_ITEMBUY )
        //ワーク制御
        $WK_OTHER_R9R0201_ITEMBUY = 0
        //========================================//

      //すごいキズグスリを買ってきたが、日付が変わっている
      ELSIF $SCWK_ANSWER == FALSE && FLAG_OFF( TMFLG_R9R0201_ITEMBUY ) THEN

        //お嬢様：ずいぶん　まった　きがするけど▼
        _BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_girl4_08 )
        _AB_KEYWAIT_MARK()
        _MSGWIN_CLOSE()

        //アイテム（ちからのこな）を取得【仮】取得アイテムは仮です
        _ITEM_EVENT_NOWAIT( ITEM_TIKARANOKONA, 1 )

        //========================================//
        //タイムフラグ（イベントクリア）ON
        _FLAG_SET( TMFLG_R9R0201_ITEMBUY_CLEAR )
        //タイムフラグ（イベント中）OFF
        _FLAG_RESET( TMFLG_R9R0201_ITEMBUY )
        //ワーク制御
        $WK_OTHER_R9R0201_ITEMBUY = 0
        //========================================//

      //すごいキズぐすりを買ってきていない
      ELSE

        //お嬢様：バッグに　ないみたいね▼
        _BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_girl4_09 )
        _LAST_KEYWAIT()
        _MSGWIN_CLOSE()

      ENDIF

    ELSE    //いいえ

      //お嬢様：おねがいね！　まってるから……
      _BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_girl4_10 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //イベントクリア
  ELSIF FLAG_ON( TMFLG_R9R0201_ITEMBUY_CLEAR ) THEN

    //お嬢様：まんきつ　しちゃった
    _BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_girl4_11 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END


