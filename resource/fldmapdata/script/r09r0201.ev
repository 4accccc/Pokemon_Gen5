/**************************************************************/
/*  ウェイトレス：話しかけ（タイムセール）                    */
/**************************************************************/
EVENT_START   ev_r09r0201_waitress_01

//タイムセール用変数
DEFINE_LOCAL  LWK_ITEM_GOLD
DEFINE_LOCAL  LWK_GOLD_CHK
DEFINE_LOCAL  LWK_BAG_CHK

  //時間と曜日取得
  _GET_TIMEZONE( LWK_TIMEZONE )
  _GET_WEEK( LWK_WEEKCK )

  //今は夕方か
  IF $LWK_TIMEZONE == TIMEZONE_EVENING THEN

    //曜日でタイムセールスの品分岐
    SWITCH $LWK_WEEKCK
    CASE RTC_WEEK_SUNDAY THEN     //日曜日
      _CALL ev_r09r0201_waitress_call_02

    CASE RTC_WEEK_MONDAY THEN     //月曜日
      _CALL ev_r09r0201_waitress_call_01

    CASE RTC_WEEK_TUESDAY THEN    //火曜日
      _CALL ev_r09r0201_waitress_call_02

    CASE RTC_WEEK_WEDNESDAY THEN  //水曜日
      _CALL ev_r09r0201_waitress_call_01

    CASE RTC_WEEK_THURSDAY THEN   //木曜日
      _CALL ev_r09r0201_waitress_call_02

    CASE RTC_WEEK_FRIDAY THEN     //金曜日
      _CALL ev_r09r0201_waitress_call_01

    CASE RTC_WEEK_SATURDAY THEN   //土曜日
      _CALL ev_r09r0201_waitress_call_02

    ENDSWITCH

  ELSE

  //ウェイトレス：ゆうがたが　まちどおしいです
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_r09r0201_waitress_01 )

  ENDIF

EVENT_END


//タイムセール（月水金）
ev_r09r0201_waitress_call_01:

  //アイテム「モンスターボール」の値段（10%OFF）
  $LWK_ITEM_GOLD  = 180

  _TALK_OBJ_START()
  //ウェイトレス：あの　モンスターボールがッ！▼
  _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_02, R09R0201_WAITRESS_01, POS_DEFAULT )

  //所持金の表示
  _GOLD_WIN_OPEN( MENU_X1, MENU_Y1 )

  //モンスターボールを買う？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN  //はい

    //バッグ空きチェック
    _ADD_ITEM_CHK( ITEM_MONSUTAABOORU, 1, LWK_BAG_CHK )
    //金額チェック
    _CHECK_GOLD( LWK_GOLD_CHK, LWK_ITEM_GOLD )

    //お金が足りない
    IF $LWK_GOLD_CHK == 0 THEN
      _GOLD_WIN_CLOSE()

      //ウェイトレス：おかねが　たりないですってー！！
      _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_07, R09R0201_WAITRESS_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    //バッグがいっぱい
    ELSIF $LWK_BAG_CHK == 0 THEN
      _GOLD_WIN_CLOSE()

      //ウェイトレス：これいじょう　もてないですってー！！
      _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_08, R09R0201_WAITRESS_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    //購入条件は満たしている
    ELSE

      //レジ音再生
      _SE_PLAY( SEQ_SE_SYS_22 )
      _SUBTRACT_GOLD( LWK_ITEM_GOLD )
      _GOLD_WIN_UPDATE()
      _SE_WAIT()

      //ウェイトレス：１０パーセントオフの　１８０円！
      _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_05, R09R0201_WAITRESS_01, POS_DEFAULT )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      //金額ウィンドウを消す
      _GOLD_WIN_CLOSE()

      //アイテム「モンスターボール」入手
      _ITEM_EVENT_SUCCESS_KEYWAIT( ITEM_MONSUTAABOORU, 1 )

    ENDIF

  ELSE    //いいえ（買い物しない）

    //金額ウィンドウを消す
    _GOLD_WIN_CLOSE()

    //ウェイトレス：あたしの　みせば　を……！▼
    _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_04, R09R0201_WAITRESS_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

_RET


//タイムセール（火木土日）
ev_r09r0201_waitress_call_02:

  //アイテム「キズぐすり」の値段（10%OFF）
  $LWK_ITEM_GOLD  = 270

  _TALK_OBJ_START()
  //ウェイトレス：あの　キズぐすりがッ！▼
  _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_03, R09R0201_WAITRESS_01, POS_DEFAULT )

  //所持金の表示
  _GOLD_WIN_OPEN( MENU_X1, MENU_Y1 )

  //キズぐすりを買う？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN  //はい

    //バッグ空きチェック
    _ADD_ITEM_CHK( ITEM_KIZUGUSURI, 1, LWK_BAG_CHK )
    //金額チェック
    _CHECK_GOLD( LWK_GOLD_CHK, LWK_ITEM_GOLD )

    //お金が足りない
    IF $LWK_GOLD_CHK == 0 THEN
      _GOLD_WIN_CLOSE()

      //ウェイトレス：おかねが　たりないですってー！！
      _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_07, R09R0201_WAITRESS_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    //バッグがいっぱい
    ELSIF $LWK_BAG_CHK == 0 THEN
      _GOLD_WIN_CLOSE()

      //ウェイトレス：これいじょう　もてないですってー！！
      _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_08, R09R0201_WAITRESS_01, POS_DEFAULT )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    //購入条件は満たしている
    ELSE

      //レジ音再生
      _SE_PLAY( SEQ_SE_SYS_22 )
      _SUBTRACT_GOLD( LWK_ITEM_GOLD )
      _GOLD_WIN_UPDATE()
      _SE_WAIT()

      //ウェイトレス：１０パーセントオフの　２７０円！
      _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_06, R09R0201_WAITRESS_01, POS_DEFAULT )
      _AB_KEYWAIT_MARK()
      _MSGWIN_CLOSE()

      //金額ウィンドウを消す
      _GOLD_WIN_CLOSE()

      //アイテム「キズぐすり」入手
      _ITEM_EVENT_SUCCESS_KEYWAIT( ITEM_KIZUGUSURI, 1 )

    ENDIF

  ELSE    //いいえ（買い物しない）

    //金額ウィンドウを消す
    _GOLD_WIN_CLOSE()

    //ウェイトレス：あたしの　みせば　を……！▼
    _BALLOONWIN_OBJMSG_POS( msg_r09r0201_waitress_04, R09R0201_WAITRESS_01, POS_DEFAULT )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

_RET


