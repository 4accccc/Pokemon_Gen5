
//======================================================================
//                d24r0401.ev
//
//    スクリプトファイル：d24r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d24r0401.h"
  .include  "d24r0401.h"
  .include  "pair_scr_def.h"

  //@author fujimura_souichirou
  //@author Mizuguchi_Mai（ベルイベント）

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_d24r0401
_EVENT_DATA   ev_pos_d24r0401_poke485_01
_EVENT_DATA   ev_d24r0401_poke485_01
_EVENT_DATA   ev_pos_d24r0401_swbell_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_PLAYER_POSX
DEFINE_LOCAL  LCW_POSZ
/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_d24r0401

  //ヒードランを呼び出した状態でゾーンチェンジした場合、再度POSイベントから
  IF $WK_SCENE_D24_POKE485 == 2 && FLAG_OFF( FV_D24_POKE485 ) THEN

    //==================================//
    //ヒードラン非表示
    _FLAG_SET( FV_D24_POKE485 )
    //POS再配置
    $WK_SCENE_D24_POKE485 = 1
    //==================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  POS：ベルコメント                                       */
/**************************************************************/
EVENT_START   ev_pos_d24r0401_swbell_01
  
  //主人公名代入
  _PLAYER_NAME( 0 )
  
  //アニメ：ベル「！」
  _OBJ_ANIME( PAIR_TRAINER_01, anm_common_gyoe )
  _TIME_WAIT( 8 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  $LCW_PLAYER_POSX = $LCW_POSX
  
  IF $LCW_POSX == 11 THEN
    $LCW_POSX -= 1
  ELSE
    $LCW_POSX += 1
  ENDIF
  
  //アニメ：主人公・ベル部屋中央部に移動
  _OBJ_ANIME_AUTO( PAIR_TRAINER_01, LCW_POSX,15, FORCE_TYPE_NOT, 8, DIR_LR )
  _TIME_WAIT( 16 )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, LCW_PLAYER_POSX,16, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  //ベル：ここって…
  _BALLOONWIN_OBJMSG_POS( msg_d24r0401_swbell_01, PAIR_TRAINER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ベル戻る
  _OBJ_ANIME_AUTO( PAIR_TRAINER_01, LCW_POSX,16, FORCE_TYPE_NOT, 8, DIR_LR )
  _OBJ_ANIME_WAIT()
  
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //アニメ；主人公とベル向き合う
  IF $LCW_POSX == 11 THEN
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_r )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  ELSE
    _OBJ_ANIME( PAIR_TRAINER_01, anm_staystep_l )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  ENDIF
  _OBJ_ANIME_WAIT()
  
  //ベル：ヒードランってのは
  _BALLOONWIN_OBJMSG_POS( msg_d24r0401_swbell_02, PAIR_TRAINER_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //==================================//
  //ヒードラン部屋イベント完了
  $WK_SCENE_D24_BELL_COMMENT = 3
  //==================================//
    
EVENT_END

/**************************************************************/
/*  POS：ヒードラン登場                                       */
/**************************************************************/
EVENT_START   ev_pos_d24r0401_poke485_01

  //システム：かざんのおきいしが
  _SYSWIN_MSG( msg_d24r0401_poke485_01, POS_DOWN )

  //「かざんのおきいし」をここに置く？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい

    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    _TIME_WAIT ( 8 )  //間

    //==================================//
    //ヒードラン表示
    _FLAG_RESET( FV_D24_POKE485 )
    //POSイベント進行
    $WK_SCENE_D24_POKE485 = 2
    //==================================//

    //ヒードラン：ごぼぼっ　ごぼぼぼ！
    _VOICE_PLAY( MONSNO_485, 0 ) 
    _PLAINWIN_MSG_UP( msg_d24r0401_poke485_02 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _PLAINWIN_CLOSE()

    //ヒードラン落下
    _OBJ_ADD( D24R0401_POKE485_01 )
    _OBJ_FALL_IN( D24R0401_POKE485_01, 10, 12, DIR_DOWN )

    _TIME_WAIT ( 60 )  //落下待ち

  ELSE    //いいえ

    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //アニメ：主人公一歩後ろに下がる
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_d )
    _OBJ_ANIME_WAIT()

  ENDIF

EVENT_END

/**************************************************************/
/*  ヒードラン：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
/**************************************************************/
EVENT_START   ev_d24r0401_poke485_01

  _TALK_START_SE_PLAY()

  //ヒードラン：ごぼぼっ　ごぼぼぼ！
  _VOICE_PLAY( MONSNO_485, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_d24r0401_poke485_02, POS_DOWN )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  // Lv.68 ヒードラン
  _WILD_BTL_SET_LEGEND( MONSNO_485, 68 )

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //ヒードラン非表示
    _FLAG_SET( FV_D24_POKE485 )
    //POSイベント進行
    $WK_SCENE_D24_POKE485 = 3
    //==================================//
    _OBJ_DEL( D24R0401_POKE485_01 )   //ヒードランを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //ヒードランを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合
    //==================================//
    //ヒードランを捕獲した
    _FLAG_SET( FE_D24_POKE485_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

  ENDSWITCH

  //ヒードランを捕獲できなかった場合の分岐
  IF FLAG_OFF( FE_D24_POKE485_GET_01 ) THEN

    //システム：ヒードランは　かざんの　おくに
    _SYSWIN_MSG( msg_d24r0401_poke485_03, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDIF

EVENT_END


//--------------------------------------------------------------------
//	☆共通処理：1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_walk_d
	_ANIME_DATA	AC_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_u
	_ANIME_DATA	AC_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_r
	_ANIME_DATA	AC_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_walk_l
	_ANIME_DATA	AC_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：方向転換
//--------------------------------------------------------------------
_ANIME_LABEL	anm_dir_u
	_ANIME_DATA	AC_DIR_U,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_d
	_ANIME_DATA	AC_DIR_D,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_l
	_ANIME_DATA	AC_DIR_L,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_dir_r
	_ANIME_DATA	AC_DIR_R,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	☆共通処理：その場歩き
//--------------------------------------------------------------------
_ANIME_LABEL	anm_staystep_u
	_ANIME_DATA	AC_STAY_WALK_U_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_d
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_l
	_ANIME_DATA	AC_STAY_WALK_L_8F,1
	_ANIME_DATA	ACMD_END,0

_ANIME_LABEL	anm_staystep_r
	_ANIME_DATA	AC_STAY_WALK_R_8F,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_gyoe
	_ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	ACMD_END,0
	
//--------------------------------------------------------------------
//	☆共通処理：はてな
//--------------------------------------------------------------------
_ANIME_LABEL	anm_common_hatena
	_ANIME_DATA	AC_MARK_HATENA,1
	_ANIME_DATA	ACMD_END,0

