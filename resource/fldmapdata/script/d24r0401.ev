
//======================================================================
//                d24r0401.ev
//
//    スクリプトファイル：d24r0401用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_d24r0401.h"
  .include  "d24r0401.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_d24r0401
_EVENT_DATA   ev_pos_d24r0401_poke485_01
_EVENT_DATA   ev_d24r0401_poke485_01
_EVENT_DATA_END

//主人公方向取得変数
DEFINE_LOCAL  LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_d24r0401

  //ヒードランを呼び出した状態でゾーンチェンジした場合、再度POSイベントから
  IF FLAG_OFF( FV_D24_POKE485 ) && $WK_SCENE_D24_POKE485 == 2 THEN

    //==================================//
    //ヒードラン非表示
    _FLAG_SET( FV_D24_POKE485 )
    //POS再配置
    $WK_SCENE_D24_POKE485 = 1
    //==================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  POS：ヒードラン登場                                       */
/**************************************************************/
EVENT_START   ev_pos_d24r0401_poke485_01

  //システム：かざんのおきいしが
  _SYSWIN_MSG( msg_d24r0401_poke485_01, POS_DOWN )

  //「かざんのおきいし」をここに置く？
  _YES_NO_WIN( SCWK_ANSWER )

  IF $SCWK_ANSWER == SCR_YES THEN   //はい

    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    _TIME_WAIT ( 8 )  //間

    //==================================//
    //ヒードラン表示
    _FLAG_RESET( FV_D24_POKE485 )
    //POSイベント進行
    $WK_SCENE_D24_POKE485 = 2
    //==================================//

    //ヒードラン：ごぼぼっ　ごぼぼぼ！
    _VOICE_PLAY( MONSNO_485, 0 ) 
    _PLAINWIN_MSG_UP( msg_d24r0401_poke485_02 )
    _VOICE_WAIT()
    _AB_KEYWAIT_MARK()
    _PLAINWIN_CLOSE()

    //ヒードラン落下
    _OBJ_ADD( D24R0401_POKE485_01 )
    _OBJ_FALL_IN( D24R0401_POKE485_01, 10, 12, DIR_DOWN )

    _TIME_WAIT ( 60 )  //落下待ち

  ELSE    //いいえ

    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //アニメ：主人公一歩後ろに下がる
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_d )
    _OBJ_ANIME_WAIT()

  ENDIF

EVENT_END

/**************************************************************/
/*  ヒードラン：話しかけ（戦闘／倒した場合は殿堂入り後復帰）  */
/**************************************************************/
EVENT_START   ev_d24r0401_poke485_01

  _TALK_START_SE_PLAY()

  //ヒードラン：ごぼぼっ　ごぼぼぼ！
  _VOICE_PLAY( MONSNO_485, 0 ) 
  _GIZAPLAINWIN_MSG_POS( msg_d24r0401_poke485_02, POS_DOWN )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _GIZAPLAINWIN_CLOSE()

  // Lv.70 ヒードラン
  _WILD_BTL_SET_LEGEND( MONSNO_485, 70 )

  _WILD_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN       //勝った

    //==================================//
    //ヒードラン非表示
    _FLAG_SET( FV_D24_POKE485 )
    //POSイベント進行
    $WK_SCENE_D24_POKE485 = 3
    //==================================//
    _OBJ_DEL( D24R0401_POKE485_01 )   //ヒードランを消す

    _WILD_WIN()
  ELSE
    _WILD_LOSE()    //負けなら敗北処理へ（ここでスクリプト終了）
  ENDIF

  //ヒードランを捕獲した？
  _WILD_RETRY_CHECK( SCWK_ANSWER )
  SWITCH $SCWK_ANSWER
  CASE SCR_WILD_BTL_RET_CAPTURE THEN      //捕まえた場合
    //==================================//
    //ヒードランを捕獲した
    _FLAG_SET( FE_D24_POKE485_GET_01 )
    //==================================//

  CASE SCR_WILD_BTL_RET_ESCAPE, SCR_WILD_BTL_RET_WIN THEN   //勝利した場合、あるいは逃げた場合

  ENDSWITCH

  //ヒードランを捕獲できなかった場合の分岐
  IF FLAG_OFF( FE_D24_POKE485_GET_01 ) THEN

    //システム：ヒードランは　かざんの　おくに
    _SYSWIN_MSG( msg_d24r0401_poke485_03, POS_DOWN )
    _LAST_KEYWAIT()
    _SYSWIN_CLOSE()

  ENDIF

EVENT_END


//--------------------------------------------------------------------
//☆共通処理：下に1歩歩く
//--------------------------------------------------------------------
_ANIME_LABEL  anm_walk_d
  _ANIME_DATA AC_WALK_D_8F,1
  _ANIME_DATA ACMD_END,0

//--------------------------------------------------------------------
//☆共通処理：ギョエ
//--------------------------------------------------------------------
_ANIME_LABEL  anm_common_gyoe
  _ANIME_DATA AC_MARK_GYOE,1
  _ANIME_DATA ACMD_END,0


