/**************************************************************/
/*  POS：迷子ポケモン04                         */
/**************************************************************/
EVENT_START ev_pos_d22r0101_pokesearch_04

  //ヨーテリー鳴く
  _VOICE_PLAY(MONSNO_591,0)
  _PLAINWIN_MSG_DOWN(msg_d22r0101_poke_01)
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  //ライバルワープ
  _OBJ_POS_CHANGE(D22R0101_SWRIVAL_01,35,2,11,DIR_RIGHT)
  
  //アニメ：ライバル高速で隣接
  _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch04_rival_come )
  
  _TIME_WAIT(48)
  
  //進入方向によって主人公の演出を分岐
  _PLAYER_DIR_GET( LWK_DIR )
  SWITCH $LWK_DIR
  CASE DIR_RIGHT THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
	CASE DIR_DOWN THEN
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
	DEFAULT  //本来ここにはこないが念のため
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  ENDSWITCH
  
  _OBJ_ANIME_WAIT()
  
  //ライバル名格納
  _RIVAL_NAME(1)
  
  //メッセージ：いまのこえ
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_09,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //アニメ：ライバル右方向に移動
  IF $LCW_POSZ == 12 THEN
    _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch04_goto_kusa_z12 )
  ELSE
    _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch04_goto_kusa )
  ENDIF
  _TIME_WAIT( 4*4 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：オレはこのあたり
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_10,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //========================================//
  //POSイベント無効
  $WK_SCENE_D22R0101 = 4
  //========================================//
EVENT_END

