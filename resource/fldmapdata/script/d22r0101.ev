/**************************************************************/
/*  POS：迷子ポケモン02                         */
/**************************************************************/
EVENT_START ev_pos_d22r0101_pokesearch_02

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  $LCW_POSZ += 2
  
  //ライバル近くにワープ
  _OBJ_POS_CHANGE(D22R0101_SWRIVAL_01,21,2,42,DIR_UP)
  
  //アニメ：ライバル隣接
  _OBJ_ANIME_AUTO( D22R0101_SWRIVAL_01, LCW_POSX, LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR)
  _TIME_WAIT(24)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //ライバル名格納
  _RIVAL_NAME(1)
  
  //メッセージ：むこうにはいなかった
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_07,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル去る
  IF $LCW_POSX == 21 THEN
    _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch02_rivalbye_z21 )
  ELSE
    _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch02_rivalbye )
  ENDIF
  _TIME_WAIT( 8 )
  //アニメ：主人公見送る
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  _OBJ_POS_CHANGE(D22R0101_SWRIVAL_01,22,3,22,DIR_UP)

  //========================================//
  //POSイベント無効
  $WK_SCENE_D22R0101 = 2
  //========================================//
EVENT_END

