//	！！！	イベントで　LOCALWORK15　を使用しています	！！！
//	！！！	同マップ内での使用を禁止します				！！！

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d22r0101
  
//
  
INIT_EVENT_END

/************************************************************/
/*					FIELD_INIT_SCRIPT						*/
/************************************************************/
INIT_EVENT_START ev_init_d22r0101

	//イベントの値によってライバルの初期位置を変更する
  IF $WK_SCENE_D22R0101 == 2 THEN
    _OBJ_POS_CHANGE( D22R0101_SWRIVAL_01, 22, 2, 32, DIR_DOWN )
  ELSIF $WK_SCENE_D22R0101 == 3 THEN
    _OBJ_POS_CHANGE( D22R0101_SWRIVAL_01, 22, 3, 13, DIR_DOWN )
  ELSIF $WK_SCENE_D22R0101 == 4 THEN
    _OBJ_POS_CHANGE( D22R0101_SWRIVAL_01, 47, 2, 13, DIR_DOWN )
  ELSE
  //この処理に来た時は何も行わない
  
  ENDIF
	
	//値によってBREEDERたちの位置を変更
  IF $WK_SCENE_D22R0101 < 5 && $WK_SCENE_D22R0101 != 0 THEN
   _OBJ_POS_CHANGE( D22R0101_BREEDERM_01, 43, 2, 46, DIR_LEFT )
   _OBJ_POS_CHANGE( D22R0101_BREEDERW_01, 43, 2, 45, DIR_LEFT )
   _OBJ_POS_CHANGE( D22R0101_POKE31_02, 44, 2, 46, DIR_LEFT )
  ELSIF $WK_SCENE_D22R0101 == 5 THEN
   _OBJ_POS_CHANGE( D22R0101_BREEDERM_01, 46, 2, 42, DIR_DOWN )
   _OBJ_POS_CHANGE( D22R0101_BREEDERW_01, 47, 2, 42, DIR_DOWN )
   _OBJ_POS_CHANGE( D22R0101_POKE31_02, 45, 2, 40, DIR_RIGHT )
   _OBJ_POS_CHANGE( D22R0101_POKE31_01, 47, 2, 40, DIR_LEFT )
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  POS：ライバル戦                         */
/**************************************************************/
EVENT_START ev_pos_d22r0101_pokesearch_01
  
  //プレイヤー位置取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 

  //ライバル近くにワープ
  _OBJ_POS_CHANGE(D22R0101_SWRIVAL_01,33,2,LCW_POSZ,DIR_LEFT)
  
  $LCW_POSX -= 1
  _OBJ_ANIME_AUTO( D22R0101_SWRIVAL_01, LCW_POSX,LCW_POSZ, FORCE_TYPE_NPC, 8, DIR_LR)
  
  //ライバル曲再生
	_START_TEMP_EVENT_BGM( SEQ_BGM_E_HUE )
	
  _OBJ_ANIME_WAIT()
  
  //ライバル名格納
  _RIVAL_NAME(1)
  
  //SWRIVAL：オマエも
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_01,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //ライバル戦呼び出し　最初の３匹によって分岐
  IF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_KUSA THEN
    //初期３匹で草タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_04, 0 )
  ELSIF $WK_SYS_FIRST_POKETYPE == FIRST_POKETYPE_HONOO THEN
    //初期３匹で炎タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_05, 0 )
  ELSE
    //初期３匹で水タイプを選択
    _TRAINER_BTL_SET( TRID_SWRIVAL_06, 0 )
  ENDIF
  
  //結果チェック
  _TRAINER_LOSE_CHECK( SCWK_ANSWER )
  IF $SCWK_ANSWER == SCR_BATTLE_RESULT_WIN THEN
    _OBJ_POS_CHANGE( D22R0101_SWRIVAL_01, 42, 2, 46, DIR_UP )
    _OBJ_POS_CHANGE( MMDL_ID_PLAYER, 42, 2, 45, DIR_DOWN )
    _TRAINER_WIN()
  ELSE
    _TRAINER_LOSE()
  ENDIF
  
  
  //ライバル名格納
  _RIVAL_NAME(1)
  
  //メッセージ：なかなか
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_02,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //メッセージ：渡した
  _PLAYER_NAME(0)
  _SE_PLAY(SEQ_SE_ARDEMO_01)
  _SYSWIN_MSG( msg_d22r0101_swrival_03 , POS_DEFAULT )
  _SYSWIN_CLOSE()
  _SE_WAIT()
  
  
  //SWRIVAL：アイツめ
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_04,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()

  //========================================//
  //BREEDER表示
  _FLAG_RESET(FV_D22R0101_BREEDER_01)
  //========================================//

  //アニメ：ブリーダー隣接
  _OBJ_ADD(D22R0101_BREEDERW_01)
  _OBJ_ANIME_AUTO( D22R0101_BREEDERW_01, 44, 45, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT(4)
  _OBJ_ADD(D22R0101_BREEDERM_01)
  _OBJ_ANIME_AUTO( D22R0101_BREEDERM_01, 44, 46, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ADD(D22R0101_POKE31_02)
  _OBJ_ANIME_AUTO( D22R0101_POKE31_02, 45, 46, FORCE_TYPE_NPC, 8, DIR_UD)
  _TIME_WAIT(24)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //BREEDERM：わかいねー
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederm_01,D22R0101_BREEDERM_01, POS_DR )
  _MSGWIN_CLOSE()
  
  //ライバル名格納
  _RIVAL_NAME(1)
  
  //SWRIVAL：だれ
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_05,D22R0101_SWRIVAL_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //BREEDERM：ぼくは
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederm_02,D22R0101_BREEDERM_01, POS_DR )
  _MSGWIN_CLOSE()
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  //アニメ：おくさん隣接
  _OBJ_ANIME_AUTO( D22R0101_BREEDERW_01, 43,45, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //BREEDERW：これを
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederw_01,D22R0101_BREEDERW_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //キズぐすり入手処理
	_ITEM_EVENT_KEYWAIT(ITEM_KIZUGUSURI, 1)
	
	//アニメ：おくさんライバルに隣接
  _OBJ_ANIME_AUTO( D22R0101_BREEDERW_01, 43,46, FORCE_TYPE_NPC, 8, DIR_LR)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D22R0101_BREEDERW_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：あなたにも
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederw_07,D22R0101_BREEDERW_01, POS_UR )
  _MSGWIN_CLOSE()
  
  _TIME_WAIT( 12 )
  
  //アニメ：おくさん元の位置に戻る
  _OBJ_ANIME_AUTO( D22R0101_BREEDERW_01, 44,45, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( D22R0101_BREEDERW_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：キズぐすり
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederw_02,D22R0101_BREEDERW_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //メッセージ：ところで
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederm_03,D22R0101_BREEDERM_01, POS_DR )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル「！」
  _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_common_gyoe )
  _OBJ_ANIME_WAIT()
  
  //ライバル名格納
  _RIVAL_NAME(1)
	
	//メッセージ：なんだそれ！
	_BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_06,D22R0101_SWRIVAL_01, POS_DL )
  _MSGWIN_CLOSE()
  
  //アニメ：主人公振り返る・ライバル退場
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch01_rivalbye )
  _OBJ_ANIME_WAIT()
  
  _OBJ_ANIME( D22R0101_BREEDERM_01, anm_common_hatena )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //メッセージ：なぜかれは
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederm_04,D22R0101_BREEDERM_01, POS_DR )
  _MSGWIN_CLOSE()
  
  //メッセージ：あたしに
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederw_03,D22R0101_BREEDERW_01, POS_UR )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //ライバル初期位置にワープ
  _OBJ_POS_CHANGE(D22R0101_SWRIVAL_01,25,2,44,DIR_UP)

  //========================================//
  //POSイベント無効
  $WK_SCENE_D22R0101 = 1
  //========================================//
EVENT_END

