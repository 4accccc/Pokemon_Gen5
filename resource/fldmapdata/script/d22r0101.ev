/**************************************************************/
/*  POS：迷子ポケモン05                         */
/**************************************************************/
EVENT_START ev_pos_d22r0101_pokesearch_05
  
  //カメラ操作　ベル追従
  _CAMERA_START()		//カメラ操作開始
  _CAMERA_PURGE()		//カメラのバインドを解く
  _CAMERA_MOVE( 9688,0,970752,3375104,131103,1343488,40 )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 51, 23, FORCE_TYPE_NPC, 8, DIR_UD)
  _OBJ_ANIME_WAIT()
  _OBJ_ANIME( MMDL_ID_PLAYER,anm_staystep_u )
  _OBJ_ANIME( D22R0101_POKE31_01, anm_poke31_backstep)
  _OBJ_ANIME( D22R0101_SWPLAZMAM_01, anm_leftwalk)
  _OBJ_ANIME_WAIT()
  
  _CAMERA_WAIT_MOVE()	//カメラ移動待ち
  
  //ヨーテリー鳴く
  _VOICE_PLAY(MONSNO_591,0)
  _BALLOONWIN_OBJMSG_POS(msg_d22r0101_poke_02,D22R0101_POKE31_01, POS_UL )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _BALLOONWIN_CLOSE()

  //ライバル名格納
  _RIVAL_NAME(1)
	
  //SWRIVAL：みつかったか！
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_12,D22R0101_SWRIVAL_01, POS_UL )
  _MSGWIN_CLOSE()
  
  //アニメ：プラズマ団下を向く
  _OBJ_ANIME( D22R0101_SWPLAZMAM_01, anm_staystep_d )
  _OBJ_ANIME_AUTO( D22R0101_SWRIVAL_01, 42, 12, FORCE_TYPE_NPC, 4, DIR_LR)
  _OBJ_ANIME_WAIT()
  
  //SWPLAZMAM：クッ　プラズマ団を知っているか
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swplazmam2_01,D22R0101_SWPLAZMAM_01, POS_UR )
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい選択時
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swplazmam2_02,D22R0101_SWPLAZMAM_01, POS_UR )
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swplazmam2_03,D22R0101_SWPLAZMAM_01, POS_UR )
  ENDIF
  
  //SWPLAZMAM：まあいい
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swplazmam2_04,D22R0101_SWPLAZMAM_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //ボール動作モデル生成
  _OBJ_ADD_EX(51,20,DIR_DOWN,MMDL_ID_EVENTOBJ_00,MONSTERBALL,MV_DMY)
  _TIME_WAIT( 4 )
  
  //ボール移動
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 51, 23, FORCE_TYPE_NPC, 4, DIR_UD)
  _TIME_WAIT( 16 )
  //SE再生
  _SE_PLAY( SEQ_SE_W003_01 ) 
  _OBJ_ANIME_WAIT()
  _SE_WAIT()
  
  //動作モデル削除
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  
  //やつあたり入手処理
	_ITEM_EVENT_KEYWAIT(ITEM_WAZAMASIN21, 1)
  
  //SWPLAZMAM：よし　ひとまずたいさん！
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swplazmam2_05,D22R0101_SWPLAZMAM_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //自機にカメラを戻す
  _CAMERA_DEF_MOVE (32)
  
  //アニメ：プラズマ団退場
  _OBJ_ANIME( D22R0101_SWPLAZMAM_01, anm_swplazmam_goto_out_x51 )
  _TIME_WAIT( 4 * 5)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()
  
  //アニメ：ヨーテリーはしゃぐ
  _OBJ_ANIME( D22R0101_POKE31_01, anm_pokeserch05_poke_x51 )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //カメラ待ち
  _CAMERA_WAIT_MOVE()
  _CAMERA_BIND()		//カメラバインド　主人公位置をカメラが追従するようになります
  _CAMERA_END()		//カメラ操作終了
  
  //ハーデリア：わん！
  _VOICE_PLAY(MONSNO_591,0)
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_poke_03,D22R0101_POKE31_01, POS_UL )
  _VOICE_WAIT()
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()

  //ライバルワープ
  _OBJ_POS_CHANGE(D22R0101_SWRIVAL_01,46,2,14,DIR_DOWN)
  _OBJ_POS_CHANGE(D22R0101_BREEDERM_01,46,2,15,DIR_DOWN)
  
  //アニメ：BREEDERMとライバル隣接
  _OBJ_ANIME( D22R0101_BREEDERM_01, anm_pokeserch05_goto_poke02 )
  _TIME_WAIT( 4 )
  _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch05_goto_poke03 )
  _TIME_WAIT(80)
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  _OBJ_ANIME_WAIT()

  //ライバル名格納
  _RIVAL_NAME(1)

  //BREEDERM：おーヨーテリー
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederm_05,D22R0101_BREEDERM_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ヨーテリーBREEDERMに隣接
  _OBJ_ANIME( D22R0101_POKE31_01, anm_pokeserch05_poke_to_breeder_x51 )
  _TIME_WAIT( 8*6 )
  _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //SWRIVAL：だってにんげんは
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_13,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル退場
  _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch05_goto_out )
  _TIME_WAIT(8)
  _OBJ_ANIME( D22R0101_BREEDERM_01, anm_staystep_l )
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //ライバル動作モデル削除
  _OBJ_DEL( D22R0101_SWRIVAL_01 )
  _OBJ_DEL( D22R0101_SWPLAZMAM_01 )
  

  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_d )
  //アニメ：主人公とブリーダー向き合う
  _OBJ_ANIME( D22R0101_BREEDERM_01, anm_staystep_u )
  _OBJ_ANIME_WAIT()
  
  //BREEDERM：ふむう
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_breederm_06,D22R0101_BREEDERM_01, POS_DL )
  _MSGWIN_CLOSE()

  //暗転
	_BLACK_OUT_SLOW()
	
	//アニメ：ブリーダー退場
	_OBJ_ANIME( D22R0101_BREEDERM_01, anm_pokeserch05_breeder_bye )
	_TIME_WAIT( 8 )
	_OBJ_ANIME( D22R0101_POKE31_01, anm_pokeserch05_poke31_bye )
  _OBJ_ANIME_WAIT()
  
	_DISP_FADE_END_CHECK()
	
	//ヨーテリー・BREEDERMワープ
  _OBJ_POS_CHANGE( D22R0101_BREEDERM_01, 46, 2, 42, DIR_DOWN )
  _OBJ_POS_CHANGE( D22R0101_BREEDERW_01, 47, 2, 42, DIR_DOWN )
  _OBJ_POS_CHANGE( D22R0101_POKE31_02, 45, 2, 40, DIR_RIGHT )
  _OBJ_POS_CHANGE( D22R0101_POKE31_01, 47, 2, 40, DIR_LEFT )
	
	//暗転復帰
	_BLACK_IN_SLOW()
	_DISP_FADE_END_CHECK()
  
  //========================================//
  //POSイベント無効
  $WK_SCENE_D22R0101 = 5
  
  //T06のアテグ誘導POSを有効
  $WK_SCENE_T06 = 3
  
  //D22R0101ライバル非表示
  _FLAG_SET(FV_D22R0101_SWRIVAL_01)
  _FLAG_SET(FV_D22R0101_SWPLAZMA_01)
  
  //========================================//
EVENT_END

