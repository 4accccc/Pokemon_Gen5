/**************************************************************/
/*  POS：迷子ポケモン03                         */
/**************************************************************/
EVENT_START ev_pos_d22r0101_pokesearch_03

  //ライバル近くにワープ
  _OBJ_POS_CHANGE(D22R0101_SWRIVAL_01,22,3,19,DIR_UP)

  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ )
  
  IF $LCW_POSZ == 11 THEN
    _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch03_rival_come_z11 )
    _TIME_WAIT( 8*5 )
  ELSIF $LCW_POSZ == 12 THEN
    _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch03_rival_come_z12 )
    _TIME_WAIT( 8*4 )
  ELSIF $LCW_POSZ == 13 THEN
    _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_pokeserch03_rival_come_z13 )
    _TIME_WAIT( 8*3 )
  ENDIF
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //SWRIVAL：おい！いいもの
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_16,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //マヒなおし入手処理
	_ITEM_EVENT_KEYWAIT(ITEM_MAHINAOSI, 1)
  
  //ライバル名格納
  _RIVAL_NAME(1)
  
  //SWRIVAL：マヒした
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_17,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アニメ：ライバル「…」
  _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_rival_tenten )
  _OBJ_ANIME_WAIT()
  
  //アニメ：ライバル向きなおす
  _OBJ_ANIME( D22R0101_SWRIVAL_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //SWRIVAL：ポケモンがかってに
  _BALLOONWIN_OBJMSG_POS( msg_d22r0101_swrival_18,D22R0101_SWRIVAL_01, POS_DEFAULT )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  //========================================//
  //POSイベント無効
  $WK_SCENE_D22R0101 = 3
  //========================================//
EVENT_END

