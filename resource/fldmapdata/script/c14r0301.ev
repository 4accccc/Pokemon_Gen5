
//======================================================================
//                c14r0301.ev
//
//    スクリプトファイル：c14r0301用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c14r0301.h"
  .include  "c14r0301.h"

  //@author fujimura_souichirou

//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA   ev_zone_c14r0301
_EVENT_DATA   ev_c14r0301_man3_01
_EVENT_DATA   ev_c14r0301_girl4_01
_EVENT_DATA   ev_c14r0301_boy4_01
_EVENT_DATA_END


/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START  ev_zone_c14r0301

  //殿堂入り済みの場合はカップル出現
  IF FLAG_ON( SYS_FLAG_GAME_CLEAR ) THEN

    //========================================//
    //男性非表示
    _FLAG_SET( FV_C14R0301_MAN3_01 )
    //カップル表示
    _FLAG_RESET( FV_C14R0301_GIRL4_01 )
    _FLAG_RESET( FV_C14R0301_BOY4_01 )
    //========================================//

  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  男性：話しかけ                                            */
/**************************************************************/
EVENT_START   ev_c14r0301_man3_01
  _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_man3_01 )
EVENT_END

/**************************************************************/
/*  お嬢様：話しかけ                                          */
/**************************************************************/
EVENT_START   ev_c14r0301_girl4_01

  //鐘を鳴らした後か
  IF $WK_SCENE_C14R0301_BOY4_01 == 7 THEN

    //お嬢様：あなたは　ステキな　ひと
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_girl4_02 )

  ELSE

    //お嬢様：ハネムーンで　ここを　えらぶなんて
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_girl4_01 )

  ENDIF

EVENT_END

/**************************************************************/
/*  お坊ちゃま：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_c14r0301_boy4_01

  _TALK_OBJ_START()

  //タワーオブヘブンの鐘イベント・前
  IF $WK_SCENE_C14R0301_BOY4_01 == 0 THEN

    //お坊ちゃま：この　へやに　７ばんどうろの
    _BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_boy4_01 )

    //タワーオブヘブンの鐘を鳴らしてあげる？
    _YES_NO_WIN( SCWK_ANSWER )

    IF $SCWK_ANSWER == SCR_YES THEN   //はい

      //お坊ちゃま：いいね！　きみ！▼
      _BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_boy4_02 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

      //========================================//
      //イベント進行
      $WK_SCENE_C14R0301_BOY4_01 = 1
      //========================================//
      //トレーナー表示（タワーオブヘブン）
      _FLAG_RESET( FV_R07R0101_WAITRESS_01 )
      _FLAG_RESET( FV_R07R0102_WOMAN3_01 )
      _FLAG_RESET( FV_R07R0103_OL_01 )
      _FLAG_RESET( FV_R07R0104_MAID_01 )
    //========================================//

    ELSE    //いいえ

      //お坊ちゃま：そんなこと　いわずにさ　ぼくたちを
      _BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_boy4_03 )
      _LAST_KEYWAIT()
      _MSGWIN_CLOSE()

    ENDIF

  //タワーオブヘブンの鐘イベント・中
  ELSIF $WK_SCENE_C14R0301_BOY4_01 >= 1 && $WK_SCENE_C14R0301_BOY4_01 <= 5 THEN

    //お坊ちゃま：７ばんどうろ　から　ここまで
    _BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_boy4_04 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  //タワーオブヘブンの鐘イベント・後
  ELSIF $WK_SCENE_C14R0301_BOY4_01 == 6 THEN

    //お坊ちゃま：ああ　きみ！　かねの　おとだけど
    _BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_boy4_05 )
    _AB_KEYWAIT_MARK()
    _MSGWIN_CLOSE()

    //どうぐ入手処理：げんきのかけら
    _ITEM_EVENT_KEYWAIT( ITEM_GENKINOKAKERA, 1 )
    
    //お坊ちゃま：ポケモンだったら　６ひきまで
    _BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_boy4_06 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

    //========================================//
    //イベント進行
    $WK_SCENE_C14R0301_BOY4_01 = 7
    //========================================//

  //お礼受け取り済み
  ELSIF $WK_SCENE_C14R0301_BOY4_01 == 7 THEN

    //お坊ちゃま：ポケモンだったら　６ひきまで
    _BALLOONWIN_TALKOBJ_MSG( msg_c14r0301_boy4_06 )
    _LAST_KEYWAIT()
    _MSGWIN_CLOSE()

  ENDIF

EVENT_END




