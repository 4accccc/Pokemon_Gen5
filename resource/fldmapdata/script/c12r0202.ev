
//======================================================================
//                c12r0202.ev
//
//    スクリプトファイル：c12r0202用
//
//======================================================================

  .text

  .include  "scr_seq_def.h"
  .include  "msg_c12r0202.h"
  .include  "c12r0202.h"
  .include  "pair_scr_def.h"
  
  //@author Mizuguchi_Mai
  //@author fujimura_souichirou
  //@author suginaka_katsunori　スクリプト修正
  
//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA    ev_zone_c12r0202
_EVENT_DATA    ev_c12r0202_rivalsister_01
_EVENT_DATA    ev_c12r0202_poke32_01
_EVENT_DATA    ev_bg_c12r0202_map_01
_EVENT_DATA_END

//先頭のポケモン名取得
DEFINE_LOCAL LWK_FRONT

/**************************************************************/
/*  ZONE_CHANGE_LABEL                                         */
/**************************************************************/
INIT_EVENT_START   ev_zone_c12r0202

  //ヒオウギジムクリア後からタウンマップ入手まで不在状態？
  //タウンマップをライバルに届けるまで不在状態
  IF $WK_SCENE_D22R0101 == 0 && $WK_SCENE_C12_WHITE_MEET == 6 THEN

    //========================================//
    //ライバル妹非表示
    _FLAG_SET( FV_C12R0202_RIVALSISTER_01 )
    //========================================//

  ELSE

    //========================================//
    //ライバル妹表示
    _FLAG_RESET( FV_C12R0202_RIVALSISTER_01 )
    //========================================//

  ENDIF

  //もしレパルダスが非表示なら？
  IF FLAG_ON( FV_C12R0202_POKE32_01 ) THEN
  
  	//キュレム戦闘済みで、ライバル妹と会話している場合は表示
  	IF FLAG_ON( FE_D10R0401_POKE10_MEET ) && FLAG_ON( FE_C12R0202_RIVALSISTER_TAL ) THEN
  		_FLAG_RESET(FV_C12R0202_POKE32_01)
  	ENDIF
  
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*  ライバルの妹：話しかけ                                    */
/**************************************************************/
EVENT_START   ev_c12r0202_rivalsister_01
{
  //主人公名代入
  _PLAYER_NAME( 0 )

  //殿堂入り回数を取得
  _GET_RECORD( RECID_DENDOU_CNT, LOCALWORK15 )

  //ポケモン入手前
  IF $WK_SCENE_C12_WHITE_MEET == 1 THEN
    
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0202_rivalsister_00 )
  
  //ポケモン入手後から、ヒオウギジムクリアまで
  ELSIF $WK_SCENE_C12GYM_OPEN <= 2 && FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN
    
    _CALL ev_pokename
    
    //ライバル妹：あ、主人公さん！   
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0202_rivalsister_01a )

  //タウンマップをライバルに渡すまで
  ELSIF $WK_SCENE_D22R0101 == 0 && FLAG_OFF( SYS_FLAG_GAME_CLEAR ) THEN

    _CALL ev_pokename

    //ライバル妹：
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0202_rivalsister_02 )
    
  ELSIF $WK_SCENE_C12GYM_OPEN == 3 && FLAG_OFF( SYS_FLAG_GAME_CLEAR )  THEN

    _CALL ev_pokename

    //ライバル妹：
    _EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0202_rivalsister_03 )

  //チャンピオンロードでライバルと戦った後なら
  ELSIF $WK_SCENE_D09R1401_SWRIVAL_01 == 1 THEN

    _CALL ev_pokename

	IF FLAG_ON( FE_D10R0401_POKE10_MEET ) && FLAG_ON( FE_C12R0202_RIVALSISTER_TAL ) && FLAG_OFF( FV_C12R0202_POKE32_01 )  THEN

		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0202_rivalsister_05 )
	
	ELSE
	
		_EASY_BALLOONWIN_TALKOBJ_MSG( msg_c12r0202_rivalsister_04 )
		
		//========================================//
		
		//ライバル妹との会話フラグセット
		_FLAG_SET(FE_C12R0202_RIVALSISTER_TAL)
		
		//========================================//
	
	ENDIF
  
  ENDIF
}
EVENT_END

ev_pokename:

  //手持ちポケモンの位置を取得
  _GET_PARTY_FRONT_POKEMON( LWK_FRONT, POKECOUNT_MODE_BATTLE_ENABLE )
  //先頭ポケモンの名前を格納
  _TEMOTI_MONS_NAME( 1, LWK_FRONT )

_RET

/**************************************************************/
/*  レパルダス：話しかけ                                      */
/**************************************************************/
EVENT_START   ev_c12r0202_poke32_01

    _EASY_TALK_POKEVOICE( MONSNO_547, msg_c12r0202_rpoke32_01 )

EVENT_END

/**************************************************************/
/*  BG：地図                                        */
/**************************************************************/
EVENT_START   ev_bg_c12r0202_map_01
  _TALK_START_SE_PLAY()
  _PLAINWIN_MSG_DOWN( msg_c12r0202_map_01 )
  _LAST_KEYWAIT()
  _PLAINWIN_CLOSE()
EVENT_END
