//--------------------------------------------------------------
//               スクリプト本体
//--------------------------------------------------------------

//--------------------------------------------------------------
//               スクリプトテーブル
//--------------------------------------------------------------
_EVENT_DATA		ev_bg_d02r0101_stone_01
_EVENT_DATA		ev_bg_d02r0101_sign1_01
_EVENT_DATA		ev_pos_d02r0101_swleader1_01
_EVENT_DATA		ev_pos_d02r0101_swleader1_02
_EVENT_DATA		ev_d02r0101_swleader1_03
_EVENT_DATA		ev_d02r0101_girl4_01
_EVENT_DATA		ev_d02r0101_man2_01
_EVENT_DATA		ev_d02r0101_man1_01
_EVENT_DATA		ev_d02r0101_mountain_01
_EVENT_DATA		ev_d02r0101_assistantw_01
_EVENT_DATA    ev_zone_d02r0101
_EVENT_DATA_END

//話しかけた方向取得変数
DEFINE_LOCAL LWK_DIR
DEFINE_LOCAL  LCW_POSX
DEFINE_LOCAL  LCW_POSZ
DEFINE_LOCAL  LCW_SWLEADE1_POSX
DEFINE_LOCAL  LCW_SWLEADE1_POSZ

//------------------------------注意--------------------------------//
//下記のローカルワークを使用しているため注意して下さい。

// LOCALWORK15→チェレン戻り位置設定
//------------------------------------------------------------------//

/************************************************************/
/*		ZONE_CHANGE                             */
/************************************************************/
INIT_EVENT_START   ev_zone_d02r0101

  //イベント進行状態を見てライブキャスターの状態をセット
  IF $WK_SCENE_D02R0101_SWLEADER1 == 0  THEN
    //==================================//
    //ローカルライブキャスター・チェレン通話状態を変更
    _PERSON_STATE_SET_CHELEN( CHELEN_STATE_YAGURUMA )
    //==================================//
  ENDIF

INIT_EVENT_END

/**************************************************************/
/*		POS：チェレン連れ歩き						  */
/**************************************************************/
EVENT_START		ev_pos_d02r0101_swleader1_01
    //連れ歩いている
  IF FLAG_ON(SYS_FLAG_PAIR) THEN
    _CALL ev_d02r0101_pairend_01
  
  //連れ歩いていない
  ELSE
    _CALL ev_d02r0101_pairstart_01
  ENDIF
EVENT_END

/**************************************************************/
/*		POS：チェレン連れ歩き						  */
/**************************************************************/
EVENT_START		ev_pos_d02r0101_swleader1_02
  
  //主人公・ライバル名代入
  _PLAYER_NAME( 0 )
  
  //連れ歩き解除
  _PAIR_TRAINER_FREE( SCRID_D02R0101_SWLEADER1_03, MV_DMY )
  
  _OBJ_ANIME_AUTO( MMDL_ID_PLAYER, 43,30, FORCE_TYPE_NOT, 8, DIR_UD )
  _OBJ_ANIME( D02R0101_SWLEADER1_01, anm_swleader1_meet_sage5 )
  _OBJ_ANIME_WAIT()
  
  //アスラフィールド上に配置
  _OBJ_ADD_EX( 43, 41, DIR_UP, MMDL_ID_EVENTOBJ_00, SAGE5, MV_DMY )
  
  //アニメ：アスラ登場
  _OBJ_ANIME_AUTO( MMDL_ID_EVENTOBJ_00, 43,32, FORCE_TYPE_NOT, 4, DIR_UD )
  _OBJ_ANIME_WAIT()
  
  //アスラ：しょあ！
  _GIZAWIN_OBJMSG_POS( msg_d02r0101_sage5_01 , MMDL_ID_EVENTOBJ_00, POS_DL )
  _GIZAWIN_CLOSE()
  
  //アニメ：主人公・チェレン振り向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_player_look_sage5 )
  _OBJ_ANIME( D02R0101_SWLEADER1_01, anm_player_look_sage5 )
  _OBJ_ANIME_WAIT()
  
  //アスラ：わしは
  _BALLOONWIN_OBJMSG_POS( msg_d02r0101_sage5_02, MMDL_ID_EVENTOBJ_00, POS_DL )
  _MSGWIN_CLOSE()
  
  //チェレン：プラズマ団は
  _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_14, D02R0101_SWLEADER1_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //アスラ：まてまて！
  _BALLOONWIN_OBJMSG_POS( msg_d02r0101_sage5_03, MMDL_ID_EVENTOBJ_00, POS_DL )
  
  //アスラ：あやまちて　あらためざる
  _BALLOONWIN_OBJMSG_POS( msg_d02r0101_sage5_04, MMDL_ID_EVENTOBJ_00, POS_DL )
  _MSGWIN_CLOSE()
  
  //アニメ：アスラ退場
  _OBJ_ANIME( MMDL_ID_EVENTOBJ_00, anm_sage5_bye )
  _TIME_WAIT( 16 )
  //アニメ：主人公・チェレン見送り
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_r )
  _OBJ_ANIME( D02R0101_SWLEADER1_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
  //チェレン：……なんだろう
  _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_15, D02R0101_SWLEADER1_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン主人公を見る
  _OBJ_ANIME( D02R0101_SWLEADER1_01, anm_staystep_l )
  _OBJ_ANIME_WAIT()
  
  //チェレン：それはともかく
  _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_16, D02R0101_SWLEADER1_01, POS_DEFAULT )
  _MSGWIN_CLOSE()
  
  //アイテム入手処理：アップグレード
	_ITEM_EVENT_KEYWAIT(ITEM_APPUGUREEDO, 1)
	
	//チェレン：じゃ　また！
	_BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_17, D02R0101_SWLEADER1_01, POS_UR )
  _MSGWIN_CLOSE()
  
  //アニメ：チェレン退場
  _OBJ_ANIME( D02R0101_SWLEADER1_01, anm_swleader1_bye )
  _OBJ_ANIME_WAIT()
  
  //チェレン・アスラ動作モデル削除
  _OBJ_DEL( D02R0101_SWLEADER1_01 )
  _OBJ_DEL( MMDL_ID_EVENTOBJ_00 )
  _OBJ_DEL( D02R0101_MAN2_01 )
  
  //==================================//
  //D02R0101 POS無効
  $WK_SCENE_D02R0101_SWLEADER1 = 1
  _FLAG_SET( FV_D02R0101_SWLEADER1_01 )
  _FLAG_SET( FV_D02R0101_STOPPER_01 )
  //ローカルライブキャスター・チェレン通話状態を変更（デフォルト設定）
  _PERSON_STATE_SET_CHELEN( CHELEN_STATE_GYM )
  //C12GYM0101 チェレン表示
  _FLAG_RESET( FV_C12GYM0201_SWLEADER1_01 )
  //==================================//
  
EVENT_END

//--------------------------------------------------------------------
//	主人公・チェレン：アスラに振り向く
//--------------------------------------------------------------------
_ANIME_LABEL	anm_player_look_sage5
  _ANIME_DATA	AC_MARK_GYOE,1
	_ANIME_DATA	AC_STAY_WALK_D_8F,1
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	チェレン：七賢人と出会う
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader1_meet_sage5
  _ANIME_DATA	AC_WALK_U_8F,2
  _ANIME_DATA	AC_WALK_R_8F,1
  _ANIME_DATA	AC_WALK_U_8F,2
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	チェレン：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_swleader1_bye
  _ANIME_DATA	AC_WALK_R_8F,7
	_ANIME_DATA	ACMD_END,0

//--------------------------------------------------------------------
//	チェレン：退場
//--------------------------------------------------------------------
_ANIME_LABEL	anm_sage5_bye
  _ANIME_DATA	AC_WALK_U_8F,1
  _ANIME_DATA	AC_WALK_R_8F,8
	_ANIME_DATA	ACMD_END,0


/**************************************************************/
/*		チェレン話しかけ
/**************************************************************/
EVENT_START		ev_d02r0101_swleader1_03
  _TALK_START_SE_PLAY()
  
   //主人公・チェレン名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )

  //話しかけるごとに0～4のセリフを順番に表示（4で終わり）
  $SCWK_TEMP0 = msg_d02r0101_swleader1_05
  $SCWK_TEMP0 += $WK_OTHER_D02R0101_PAIR
  
  _TALK_OBJ_START()
  _BALLOONWIN_OBJMSG( SCWK_TEMP0, PAIR_TRAINER_01 )
  _LAST_KEYWAIT()
  _MSGWIN_CLOSE()
  
  IF $WK_OTHER_D02R0101_PAIR != 4 THEN
    $WK_OTHER_D02R0101_PAIR += 1
  ENDIF
  
EVENT_END

//連れ歩き開始スクリプト
ev_d02r0101_pairstart_01:

  //主人公・チェレン名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //自機座標取得
  _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
  //チェレン座標取得
  _OBJ_POS_GET( D02R0101_SWLEADER1_01,LCW_SWLEADE1_POSX,LCW_SWLEADE1_POSZ ) 
    
  IF $LCW_POSZ != $LCW_SWLEADE1_POSZ || $LOCALWORK15 == 0 THEN
    _DEBUG_PRINT_WK( 99 )
    _OBJ_ANIME_AUTO( D02R0101_SWLEADER1_01, 68, LCW_POSZ, FORCE_TYPE_NOT, 8, DIR_LR )
    _OBJ_ANIME_WAIT()
  ENDIF
    
  IF $LCW_POSZ != $LCW_SWLEADE1_POSZ THEN
    _OBJ_ANIME( D02R0101_SWLEADER1_01, anm_staystep_r )
    _OBJ_ANIME_WAIT()
  ENDIF
  
  IF FLAG_OFF( FE_D02R0101_SWLEADER1_FIRST ) THEN
    //一緒に行こう！（初回会話）
    _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_01, D02R0101_SWLEADER1_01, POS_UP )
  ELSE
    //ヤグルマの森で（離脱後会話）
    _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_12, D02R0101_SWLEADER1_01, POS_UP )
  ENDIF
  
   {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_03, D02R0101_SWLEADER1_01, POS_UP )
    _MSGWIN_CLOSE()
    
    //自転車に乗ってるなら歩行状態へ
    _PLAYER_FORM_GET( SCWK_ANSWER )
    IF $SCWK_ANSWER == SCR_PLAYER_FORM_CYCLE THEN
      _PLAYER_REQUEST( FIELD_PLAYER_REQBIT_NORMAL )
    ENDIF
    
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
    
    //連れ歩き開始
    _PAIR_TRAINER_SET( D02R0101_SWLEADER1_01, PAIR_ID_D02R0101_SWLEADER1, PAIR_TYPE_ONE_ZONE, TRID_SWLEADER1_1_02, PAIR_ID_D02R0101_SWLEADER1 )
    //==================================//
    //初回会話完了フラグ
    _FLAG_SET(FE_D02R0101_SWLEADER1_FIRST)
    //入室イベント初期化
    $LOCALWORK15 = 0
    //==================================//
    
  //いいえ
  ELSE
    
    //アニメ：チェレン芝居
    _OBJ_ANIME( D02R0101_SWLEADER1_01, anm_swleader1_act )
    _OBJ_ANIME_WAIT()

    _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_02, D02R0101_SWLEADER1_01, POS_UP )
    _MSGWIN_CLOSE()
    
    //アニメ：主人公戻す
    _OBJ_ANIME( D02R0101_SWLEADER1_01, anm_dir_r )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
    
    //==================================//
    //入室イベント終了状態（マップ遷移で初期化）
    $LOCALWORK15 = 1
    //==================================//

  ENDIF
  }
_RET

//連れ歩き中終了処理
ev_d02r0101_pairend_01:

  //主人公・チェレン名代入
  _PLAYER_NAME( 0 )
  _RIVAL_NAME( 1 )
  
  //アニメ：主人公振り向き
  _OBJ_ANIME( MMDL_ID_PLAYER, anm_staystep_l )
  _OBJ_ANIME( PAIR_TRAINER_01, anm_dir_r )
  _OBJ_ANIME_WAIT()
  
  //チェレン：いちどそとにでる？
  _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_04, PAIR_TRAINER_01, POS_DEFAULT )
  
   {
  _YES_NO_WIN( SCWK_ANSWER )
  
  //はい
  IF $SCWK_ANSWER == SCR_YES THEN
    _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_02, PAIR_TRAINER_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    //連れ歩き解除
    _PAIR_TRAINER_FREE( SCRID_D02R0101_SWLEADER1_03, MV_DMY )
    
    //アニメ：主人公戻す・チェレン戻る
    
    //自機座標取得
    _PLAYER_POS_GET( LCW_POSX,LCW_POSZ ) 
    
    _OBJ_ANIME_AUTO( D02R0101_SWLEADER1_01,67,69, FORCE_TYPE_NOT, 8, DIR_LR )
    _OBJ_ANIME_WAIT()
    _OBJ_ANIME( D02R0101_SWLEADER1_01, anm_staystep_r )
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_r )
    _OBJ_ANIME_WAIT()
  
  //いいえ
  ELSE
    _BALLOONWIN_OBJMSG_POS( msg_d02r0101_swleader1_03, PAIR_TRAINER_01, POS_DEFAULT )
    _MSGWIN_CLOSE()
    
    _PAIR_PLAYER_FOLLOW_ON()  //連れ歩き追随開始
    //アニメ：主人公戻す
    _OBJ_ANIME( MMDL_ID_PLAYER, anm_walk_l )
    _OBJ_ANIME_WAIT()
    _PAIR_PLAYER_FOLLOW_OFF() //連れ歩き追随終了
    
  ENDIF
  }
_RET

/**************************************************************/
/*  STOPPER                                            */
/**************************************************************/
EVENT_START   ev_d02r0101_man2_01

  _TALK_OBJ_START()
  _BALLOONWIN_TALKOBJ_MSG( msg_d02r0101_stop_01 )
  _AB_KEYWAIT_MARK()
  _MSGWIN_CLOSE()
  
  _OBJ_ANIME( D02R0101_MAN2_01, anm_staystep_r )
  _OBJ_ANIME_WAIT()
  
EVENT_END

