		<rotate_z frame_step="1" data_size="1" data_head="0"/>
		<translate_x frame_step="1" data_size="1" data_head="949"/>
		<translate_y frame_step="1" data_size="1" data_head="949"/>
		<translate_z frame_step="1" data_size="1" data_head="952"/>
	</node_anm>
</node_anm_array>

</body>

