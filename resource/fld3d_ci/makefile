
#------------------------------------------------------------------------------
#
#	フィールドカットインコンバート
#
#------------------------------------------------------------------------------

# 共通定義を利用
include mkdefine

# sub_makefile
MKFILE_RES 				= makefile_res 		# カットインデータ(imdなど）をコンバート
MKFILE_TEX_DEPEND = makefile_depend	# 差替えテクスチャ用の依存関係などを生成
MKFILE_TEX 				= makefile_tex 		# makefile_dependで作った依存関係を元にテクスチャリソースをコンバート

#------------------------------------------------------------------------------
#※コピー先へのパスを書く（通常はPROJECT_ARCDIRでよい）
#------------------------------------------------------------------------------
#共通ルールファイルのインクルード
include $(PROJECT_RSCDIR)\macro_define

.PHONY:	do-build clean

ifeq	($(CONVERTUSER),true)	#コンバート対象者のみ、コンバートのルールを有効にする
.SUFFIXES:	
endif

#------------------------------------------------------------------------------
#	make do-build ルール
#------------------------------------------------------------------------------
do-build:
	$(MAKE) -f $(MKFILE_RES)
	$(MAKE) -f $(MKFILE_TEX_DEPEND)
	$(MAKE) -f $(MKFILE_TEX)

#------------------------------------------------------------------------------
#	make clean ルール
#------------------------------------------------------------------------------
clean:
	$(MAKE) -f $(MKFILE_RES) clean
	$(MAKE) -f $(MKFILE_TEX_DEPEND) clean
	$(MAKE) -f $(MKFILE_TEX) clean

