	</row>
	<row id="pw_event0_react_hero_2">
		<language name="JPN" width="256">[1:00:トレーナー名:1]『もう　おわりだ……</language>
		<language name="JPN_KANJI" width="256">[1:00:トレーナー名:1]『もう　終わりだ……</language>
