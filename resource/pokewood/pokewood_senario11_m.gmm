	<row id="pw_event1_hero_4">
		<language name="JPN" width="256">[1:00:トレーナー名:1]『もんだい……？</language>
		<language name="JPN_KANJI" width="256">[1:00:トレーナー名:1]『問題……？</language>
	</row>
	<row id="pw_event1_enemy_4">
		<language name="JPN" width="256">Ｅ『にんげんと　ポケモンだ……▼
