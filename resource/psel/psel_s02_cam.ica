		<translate_x frame_step="1" data_size="410" data_head="0"/>
		<translate_y frame_step="1" data_size="410" data_head="410"/>
		<translate_z frame_step="1" data_size="410" data_head="820"/>
	</node_anm>
</node_anm_array>

</body>

