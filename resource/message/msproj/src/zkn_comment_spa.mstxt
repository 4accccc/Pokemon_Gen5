				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カイリュー</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_150"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Pokémon creado por recombinación
genética de MEW. Se dice que es el
más salvaje de los Pokémon.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
