				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_238"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Analiza todo tocándolo con los
labios. Así puede recordar las
cosas que le gustan y disgustan.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
