				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_383"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ha estado durmiendo en magma
subterráneo desde que luchó
contra KYOGRE en tiempos remotos.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
