				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ゴマゾウ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_232"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Se enrolla sobre sí mismo y se
lanza rodando contra el enemigo.
Puede derribar casas de un golpe.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Se enrolla sobre sí mismo y se
