			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_235"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Marca su territorio usando su
cola a modo de pincel. Ha hecho
más de 5000 marcas diferentes.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
