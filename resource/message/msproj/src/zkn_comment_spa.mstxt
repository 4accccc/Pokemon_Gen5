			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_386"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Surgió a raíz de la mutación de
ADN de un virus alienígena que
cayó a la Tierra en un meteorito.</Text>
