			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_236"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Famoso por su disposición a la
lucha. Siempre tiene heridas por
luchar con enemigos más grandes.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
