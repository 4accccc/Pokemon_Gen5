				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_385"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Se dice que puede otorgar
cualquier deseo durante una
semana cada mil años.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Se dice que puede otorgar
cualquier deseo durante una
semana cada mil años.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
