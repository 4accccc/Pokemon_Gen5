				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_237"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Gira a gran velocidad al luchar.
La fuerza centrífuga multiplica su
poder de destrucción por diez.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
