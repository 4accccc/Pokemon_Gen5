	<TextRow
		Label="ZKN_COMMENT_SPA_00_381"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Es un Pokémon muy inteligente.
Puede adelantar a aviones a
reacción plegando las alas.</Text>
