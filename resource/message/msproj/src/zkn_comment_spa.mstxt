	<TextRow
		Label="ZKN_COMMENT_SPA_00_488"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>En las noches de media luna, la
aurora de su cola se extiende y
ondea más hermosa que nunca.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
