	<TextRow
		Label="ZKN_COMMENT_SPA_00_380"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Su cuerpo está cubierto de un
plumón que refleja la luz de
forma que se vuelve invisible.</Text>
