			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_233"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Fue mejorado para posibilitar
la exploración de otros planetas.
Pero no estaba a la altura.</Text>
