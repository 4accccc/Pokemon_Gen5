		<CommentCell
			Language="JPN">
			<Comment>エアームド</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_SPA_00_228"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Tiene suficiente inteligencia para
cazar en manada. Se comunica con
los demás a través de gritos.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
