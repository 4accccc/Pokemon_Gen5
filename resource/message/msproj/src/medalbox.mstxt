	<TextRow
		Label="MSG_MEDALBOX_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このメダルを　イチオシに　とうろくし
ほかの　プレイヤーに　こうかいします</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
