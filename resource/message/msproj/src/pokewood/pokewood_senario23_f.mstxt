	<TextRow
		Label="pw_event8_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『どうしたの？▼
わたしに　にげられそうだから
あせってるの？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:10" />
			<Status>Editing</Status>
