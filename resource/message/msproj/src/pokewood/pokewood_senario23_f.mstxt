	<TextRow
		Label="pw_event5_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もんばん『フーン▼
……やっぱ　キミ
おひめさま　だけ　あるのかもね▽
けっこう　きが　つよいし</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
