	<TextRow
		Label="pw_event9_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もんばん『そのようだね
じゃあ　はやく　いきなよ</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>門番『そのようだね
じゃあ　はやく　行きなよ</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
