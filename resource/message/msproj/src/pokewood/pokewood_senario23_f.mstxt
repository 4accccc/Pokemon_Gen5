	<TextRow
		Label="pw_event2_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『よーし！
とびらを　こわせたわよね！？▽
これで　でられるんでしょうね！？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-21T10:56:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
