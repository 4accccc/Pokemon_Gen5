	<TextRow
		Label="pw_event8_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『……　あ……　のさ
とびらの　ことだけど……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
