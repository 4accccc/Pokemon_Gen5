				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『わたしに
そんなくち　きくなんて　なまいき！▼
いいわよ！
こわせば　いいんでしょ　こわせば！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]姫『私に
そんな口　きくなんて　生意気！▼
いいわよ！
壊せば　いいんでしょ　壊せば！</Text>
			<TextModifiedBy
				User="mori:W00269"
