				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event9_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『へへへ……
たしかに　とびらは　こわれたけどさ▽
もんばんの　ボクが　まだ　いるもん</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T10:31:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T10:31:56" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『へへへ……
確かに　扉は　壊れたけどさ▽
門番の　ボクが　まだ　いるもん</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T11:48:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T11:48:18" />
		</LanguageCell>
