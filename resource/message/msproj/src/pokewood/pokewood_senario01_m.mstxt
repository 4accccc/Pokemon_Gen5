				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチクマン『よかろうっ！！▼
わがはいの　あくのおうぎ！
くらうが　よいわーっ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:57:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:57:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハチクマン『よかろうっ！！▼
我輩の　悪の奥義！
くらうが　よいわーっ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:57:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
