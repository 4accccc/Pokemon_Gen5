				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]キッド『ひー！　こわい！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:PokemonNickname Idx="0" ]キッド『ひー！　怖い！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:26" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチクマン『ファー　ファファファ！
なさけないぞ！　[Name:PokemonNickname Idx="0" ]キッド！▼
きさまのような　やつに　わがはいの
おうぎを　つかうまでも　ない！▼
これでも　くらうが　いいわ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハチクマン『ファー　ファファファ！
情けないぞ！　[Name:PokemonNickname Idx="0" ]キッド！▼
貴様のような　やつに　我輩の
奥義を　使うまでも　ない！▼
これでも　くらうが　いいわ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:37" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチクマン『ファー　ファファファ！▼
なんだ！　そのポケモンさばき　は！
おはなしにも　ならぬわっ！▼
きさまの　ような　こぞうとは
たたかう　きにも　ならぬ！▼
もうよい！　さらばだ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハチクマン『ファー　ファファファ！▼
なんだ！　そのポケモンさばき　は！
お話にも　ならぬわっ！▼
貴様の　ような　小僧とは
戦う気にも　ならぬ！▼
もうよい！　さらばだ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:37" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]キッド『あれ……
ぼく　こんな　はずじゃ……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:PokemonNickname Idx="0" ]キッド『あれ……
ぼく　こんな　はずじゃ……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あくのかいじん　ハチクマンに
あいてにも　されなかった▽
[Name:PokemonNickname Idx="0" ]キッド……▼
とくに　かつやくも　ない　かれが
だれなのか　しりたいものが▽
いるはずも　ない……▼
ともかく……▼
ありがとう！
[Name:PokemonNickname Idx="0" ]キッド！▼
さらば！
[Name:PokemonNickname Idx="0" ]キッド！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-07T11:00:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-07T11:00:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>悪の怪人　ハチクマンに
相手にも　されなかった▽
[Name:PokemonNickname Idx="0" ]キッド……▼
特に　活躍も　ない　彼が
だれなのか　知りたい者が▽
いるはずも　ない……▼
ともかく……▼
ありがとう！
[Name:PokemonNickname Idx="0" ]キッド！▼
さらば！
[Name:PokemonNickname Idx="0" ]キッド！</Text>
			<TextModifiedBy
