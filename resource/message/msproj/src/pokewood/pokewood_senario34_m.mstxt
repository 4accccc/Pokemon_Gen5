		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『どういうことだっ！！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
