				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｆー００『グゴ……　グゴ……</Text>
