	<TextRow
		Label="pw_event0_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょしゅ『[Name:TrainerName Idx="1" ]はかせ……
いや　[Name:TrainerName Idx="1" ]……▼
もう　オマエに　ついていくのが
イヤに　なったんだよっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:26:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:26:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>助手『[Name:TrainerName Idx="1" ]博士……
いや　[Name:TrainerName Idx="1" ]……▼
もう　オマエに　ついていくのが
イヤに　なったんだよっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:26:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:26:10" />
		</LanguageCell>
