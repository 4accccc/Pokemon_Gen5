	<TextRow
		Label="pw_turn_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『ふうん
みなれない　ニンゲン……▼
ケンキューインに　にているけど
めずらしい　しゅるい　だわ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T08:23:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T08:23:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『ふうん
見慣れない　ニンゲン……▼
ケンキューインに　似ているけど
珍しい　種類　だわ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T08:23:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T08:23:37" />
		</LanguageCell>
		<AttributeCell
