				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『[Name:TrainerName Idx="1" ]
こんどは　あのニンゲンを▽
くじょ　なさい</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『[Name:TrainerName Idx="1" ]
今度は　あのニンゲンを▽
駆除なさい</Text>
