	</TextRow>
	<TextRow
		Label="pw_event0_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]はかせ『ポケモン！？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
