				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_turn_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『あの　ニンゲン
ためらって　いるのね▼
おなじ　ニンゲンを
きずつける　ことを▼
よわい　いきものに
よくある　しゅうせい</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『あの　ニンゲン
ためらって　いるのね▼
同じ　ニンゲンを
傷つける　ことを▼
弱い　生き物に
よくある　習性</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
