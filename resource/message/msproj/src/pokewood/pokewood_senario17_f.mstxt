			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_7"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]はかせ『クッ……
みつかった……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:11" />
			<Status>Editing</Status>
