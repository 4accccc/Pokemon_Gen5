	</TextRow>
	<TextRow
		Label="pw_event7_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『チャンスね
ヒューマンボールを　なげるわ</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T13:01:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T13:01:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『チャンスね
ヒューマンボールを　投げるわ</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T13:01:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T13:01:06" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
