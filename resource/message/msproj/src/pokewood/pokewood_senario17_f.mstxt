				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_turn_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]はかせ『あいては　にんげん
きずつける　わけには　いかない……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]博士『相手は　人間
傷つける　わけには　いかない……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_turn_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『あの　ニンゲン
ためらって　いるのね……▽
おなじ　しゅぞくで　ある▽
ニンゲンを　きずつける　ことを……▼
フン……　よわい　いきものに
よく　ある　おろかな　しゅうせい……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T02:39:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T02:39:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『あの　ニンゲン
ためらって　いるのね……▽
同じ　種族で　ある▽
ニンゲンを　傷つける　ことを……▼
フン……　弱い　生き物に
よくある　おろかな　習性ね……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T02:39:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T02:39:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_turn_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]はかせ『きみは
なんとも　おもわないの！？▼
じぶんと　おなじ　ポケモンを
きずつける　ことが！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T06:58:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T06:58:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]博士『きみは
なんとも　思わないの！？▼
自分と　同じ　ポケモンを
傷つける　ことが！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T06:58:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
