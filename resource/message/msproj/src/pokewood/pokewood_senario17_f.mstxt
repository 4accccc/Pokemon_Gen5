		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]博士『ポケモン！？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
