				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『こら　まちなさい！
そこの　のらニンゲン！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T08:23:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T08:23:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『こら　待ちなさい！
そこの　野良ニンゲン！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T08:23:37" />
			<Status>Editing</Status>
