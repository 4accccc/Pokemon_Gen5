				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_turn_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『ニンゲンに　したがう
ポケモンの　つらよごし……▽
まとめて　くじょ　たいしょうよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T09:07:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T09:07:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『ニンゲンに　従う
ポケモンの　面汚し……▽
まとめて　駆除対象よ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-14T09:07:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
