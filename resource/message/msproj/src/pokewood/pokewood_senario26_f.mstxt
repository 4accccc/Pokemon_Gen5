				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>グアイ『かぞく　だって……？
</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
