				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ロドリゲス『かぞく……？
</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
