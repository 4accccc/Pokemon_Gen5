		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『キャンッ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-01T07:01:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
