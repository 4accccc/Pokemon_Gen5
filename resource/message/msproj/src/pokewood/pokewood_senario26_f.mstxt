	</TextRow>
	<TextRow
		Label="pw_event0_react_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『そんな！　らんぼうな！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
