				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event3_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『さあ！
ここ　まで　おいついたわ！▼
かくごは　いいでしょうね？　　
とっつかまえて　やる！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-02-14T07:55:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-02-14T07:55:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『さあ！
ここまで　追いついたわ！▼
覚悟は　いいでしょうね？
とっつかまえて　やる！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-02-14T07:55:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
