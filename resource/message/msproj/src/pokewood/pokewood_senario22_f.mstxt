				Time="2011-10-28T11:05:24" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event8_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『ほーら
お・い・つ・い・た！▼
さあ　かんねんなさい！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『ほーら
お・い・つ・い・た！▼
さあ　観念なさい！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
