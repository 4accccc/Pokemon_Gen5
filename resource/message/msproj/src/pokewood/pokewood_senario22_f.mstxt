				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『むかっ……！▼
あなたの　おかねも　かんむりも
すべて　とりあげてやるわ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『むかっ……！▼
あなたの　お金も　冠も
すべて　取り上げてやるわ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『うっわ　よわ！
よわすぎるわ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
