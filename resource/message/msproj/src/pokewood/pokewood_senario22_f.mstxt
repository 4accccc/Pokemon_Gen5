	</TextRow>
	<TextRow
		Label="pw_event1_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『やだ！
だんだん　こっちに　来てる！▼
いそいで　たおさなきゃ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
