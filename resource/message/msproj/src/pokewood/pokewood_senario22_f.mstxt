				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event3_react_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『はあ？　おかね？
こどものくせに　なにいってるの？▼
ほ　ほしくなんて　ないけどね</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『はあ？　お金？
子供のくせに　何いってるの？▼
ほ　欲しくなんて　ないけどね</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:17" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『ああ……
ちちうえの　いうこと　きいて　おけば▽
こんなとびらに　はいらなくて▽
すんだのに▼
だれも　たすけに　きてくれない
じぶんで　でないと　いけないのね</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]姫『ああ……
父上の　言うこと　きいて　おけば▽
こんな扉に　入らなくて　済んだのに▼
だれも　助けに　きてくれない
自分で　出ないと　いけないのね</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
