	</TextRow>
	<TextRow
		Label="pw_event3_react_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『もう　ダメだー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T05:56:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T05:56:36" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]姫『もう　ダメだー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T05:56:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
