				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『ムカッ……！▼
あなたの　おかねも　かんむりも
すべて　とりあげてやるわ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『ムカッ……！▼
あなたの　お金も　冠も
すべて　取り上げてやるわ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:17" />
