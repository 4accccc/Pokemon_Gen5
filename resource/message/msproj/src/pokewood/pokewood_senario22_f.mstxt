				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event3_react_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『そうは　いかないわ！</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-28T11:05:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-28T11:05:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]姫『そうは　いかないわ！</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-28T11:05:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
