	<TextRow
		Label="pw_event4_enemy_2">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『あく……は……
ゆる……さ……ない……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T13:14:56" />
