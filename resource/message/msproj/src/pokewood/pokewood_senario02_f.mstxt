	<TextRow
		Label="pw_event0_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチクマン『ヌ……
そのこえは……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハチクマン『ヌ……
その声は……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
