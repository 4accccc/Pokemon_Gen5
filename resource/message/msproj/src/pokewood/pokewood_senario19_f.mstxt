	<TextRow
		Label="pw_event5_enemy_5">
		<LanguageCell
			Language="JPN">
			<Text>ミゲル『へっ？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T03:44:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
