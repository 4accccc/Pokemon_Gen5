	<TextRow
		Label="pw_briefing_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]とつぜんの　きりに　みまわれ
[Ctrl1:xcenter ]ある　やどやで　やすむことにした
[Ctrl1:xcenter ]きままな　たびびと　[Name:TrainerName Idx="1" ]</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T05:54:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]突然の　霧に　見舞われ
[Ctrl1:xcenter ]ある　宿屋で　休むことにした
[Ctrl1:xcenter ]気ままな　旅人　[Name:TrainerName Idx="1" ]
</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T05:54:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あらすじ♂</Comment>
			<CommentModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]まよなかの　こと……
[Ctrl1:xcenter ]ふきつな　あかいきりは
[Ctrl1:xcenter ]へやの　なかにまで　たちこめた</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-09-20T09:40:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:35:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]真夜中の　こと……
[Ctrl1:xcenter ]不吉な　赤い霧は
[Ctrl1:xcenter ]部屋の　中にまで　立ちこめた</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-09-27T12:00:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:36:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]そして　そこから　あらわれた
[Ctrl1:xcenter ]かげが　ひとつ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-11T13:40:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:52:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]そして　そこから　現れた
[Ctrl1:xcenter ]影が　ひとつ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-11T13:41:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
