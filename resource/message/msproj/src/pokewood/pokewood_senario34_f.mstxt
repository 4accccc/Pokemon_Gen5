			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『しんじつでしょ……</Text>
			<TextModifiedBy
				User="mori:W00269"
