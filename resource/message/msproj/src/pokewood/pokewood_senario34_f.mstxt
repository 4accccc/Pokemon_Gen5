				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_6"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょしゅ『ええい！　うるさいっ！！▼
わたしの　パンチが　ひを　ふくのだ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>助手『ええい！　うるさいっ！！▼
私の　パンチが　火を　ふくのだ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_hero_7"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『やめてーッ！！！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『止めてーッ！！！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_hero_8"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……たびかさなる　ダメージで
Ｆー００は　エネルギーもれを　おこし▽
とても　きけんな　じょうたい　だった▼
じょしゅの　ひよわなパンチで　さえ
しげきが　つよすぎた……▼
……Ｆー００の　からだは　ばくはつし
わたしたちは　けんきゅうしょ　ごと▽
ふきとばされてしまった……▼
かろうじて　いのちを　とりとめた
じょしゅは　びょういんへ　はこばれた▼
しかし　わたしは　Ｆー００への
おもいが　わすれられず▽
いまも　ずっと　ここに　いる……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……度重なる　ダメージで
Ｆー００は　エネルギーもれを　起こし▽
とても　危険な　状態だった▼
助手の　ひよわなパンチで　さえ
ショックが　強すぎたのだ……▼
……Ｆー００の　身体は　爆発し
私たちは　研究所ごと▽
吹き飛ばされてしまった……▼
かろうじて　命を　取り留めた
助手は　病院へ　運ばれた▼
しかし　私は　Ｆー００への
思いが　忘れられず▽
今も　ずっと　ここに　いる……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_hero_0">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『まて……
Ｆー００を……　かえせ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『待て……
Ｆー００を……　返せ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event7_enemy_0">
		<LanguageCell
			Language="JPN">
			<Text>じょしゅ『[Name:TrainerName Idx="1" ]！！
おまえが　わるいんだからな！！▼
わたしは　Ｆー００を　うって
この　けんきゅうしょを▽
たてなおすんだっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>助手『[Name:TrainerName Idx="1" ]！！
お前が　悪いんだからな！！▼
私は　Ｆー００を　売って
この　研究所を▽
立て直すんだっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event7_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『Ｆー００を……
ともだちを……　かえせ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『Ｆー００を……
友達を……　かえせ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event7_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>……じょしゅに　うらぎられ
Ｆー００も　うしなった　わたしは▽
けんきゅうしょを　さった……▼
そして　もう　にどと
ロボットの　けんきゅうに▽
たずさわることは　なかった……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……助手に　裏切られ
Ｆー００も　失った　私は▽
研究所を　去った……▼
そして　もう二度と
ロボットの　研究に ▽
携わることは　なかった……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:50" />
		</LanguageCell>
	</TextRow>
</MessageStudioText>