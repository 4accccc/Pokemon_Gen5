	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="pw_briefing_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]しおかぜ　ただよう　はとばに
[Ctrl1:xcenter ]いっせきの　ごうかきゃくせん</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:53:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]潮風　ただよう　波止場
[Ctrl1:xcenter ]巨大な　豪華客船</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:54:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あらすじ♂</Comment>
			<CommentModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]つきあかりに　てらされた
[Ctrl1:xcenter ]じょうせんを　いそぐ　じょうきゃく</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:53:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:35:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]月明りに　てらされ
[Ctrl1:xcenter ]乗船を　急ぐ　乗客</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:54:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:36:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]ひとごみ　まぎれる　あやしいかげ
[Ctrl1:xcenter ]そう　それは　じけんの　まくあけ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:53:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:52:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]人ごみ　まぎれる　怪しい影</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:53:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:55:16" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_004"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]だが　しかし！！
[Ctrl1:xcenter ]かげあるところに　ひかりあり！

[Ctrl1:xcenter ]あのヒーローが　あらわれた！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:54:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:00:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]だが　しかし！！
[Ctrl1:xcenter ]影あるところに　光あり！

[Ctrl1:xcenter ]あのヒーローが　現れた！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:54:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:04" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_005"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]そう！　ヒーローの　なは！

[Ctrl1:xcenter ][Name:PokemonNickname ]キッド！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:54:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]そう！　ヒーローの　名は！
[Ctrl1:xcenter ][Name:PokemonNickname ]キッド！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T03:54:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
