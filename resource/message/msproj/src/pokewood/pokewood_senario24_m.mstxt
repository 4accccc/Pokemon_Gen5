	<TextRow
		Label="pw_event5_hero_8">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『お……　おめでとう？？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:30:49" />
