				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『おほほ……
ひとりごとは　よくないわよ？▽
さびしい　にんげんの　しょうこ　だもの</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『おほほ……
独り言は　良くないわよ？▽
寂しい　人間の　証拠だもの</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:53" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『くっそー！！
あらためて　いっておくぞ！▼
ぜったい　ぼくの　ほうが
カッコイイに　きまってるからな！▼
だって　ぼくは　おうじさま　だよ？
おまえとは　うまれも　そだちも　ちがう
うまれつきの　エリートだもん！▼
しょくじも　きょういくも　パンだって
さいこうレベルで　そだってきたんだぜ？▼
どこの　だれとも　わからない　おまえとは
そもそも　グレードが　ちがうんだ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:30:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:30:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『くっそー！！
あらためて　言っておく！▼
絶対　ぼくの　ほうが
カッコイイに　決まってるだろ！▼
だって　ぼくは　王子様　だよ？▼
お前とは　生まれも　育ちも
違う　生粋の　エリートだもん！▼
服も　食事も　教育だって
最高レベルで　育ってきたんだぜ？▼
どこの　だれとも　分からない　お前とは
そもそも　グレードが　違うんだ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:30:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:30:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『ムキーッ！！
あんた　いいかげんに　しなさいよ！！▼
スネかじりの　バカおうじ　より
がんばって　なりあがってきた▽
まほうクイーンの　わたしのほうが▽
おいたちふくめて　カッコイイ　うえに▽
かくも　うえに　きまってるじゃない！▼
それにねえ　さいこうレベルの
せいかつして　そだつ　こどもが▽
あんたみたいな　ボンクラじゃ▽
まるで　かねの　ムダづかいじゃない！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『ムキーッ！！
あんた　いい加減に　しなさいよ！！▼
スネかじりの　バカ王子　より
頑張って　成り上がってきた▽
まほうクイーンの　私のほうが▽
生い立ち含めて　カッコイイ　上に▽
格も　上に　決まってるじゃない！▼
それにねえ　最高レベルの
生活して　育つ　子供が▽
あんたみたいな　ボンクラじゃ▽
まるで　金の　ムダ使いじゃない！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『なんだとー！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
