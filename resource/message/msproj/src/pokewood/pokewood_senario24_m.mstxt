				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『はあ……
はあ……　う……▼
もんばん『ど　どうしたんだ？▼
[Name:TrainerName Idx="1" ]おうじ『なんか……
ぼく　くるしくて……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『はあ……
はあ……　う……▼
もんばん『ど　どうしたんだ？▼
[Name:TrainerName Idx="1" ]王子『なんか……
僕　苦しくて……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
