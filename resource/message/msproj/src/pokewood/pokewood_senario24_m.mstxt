	<TextRow
		Label="pw_event5_hero_7"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もんばん『お……　おめでとう？？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
			<Status>Editing</Status>
