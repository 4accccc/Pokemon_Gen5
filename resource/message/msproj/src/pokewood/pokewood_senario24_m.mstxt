			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『おほほ……
できるものなら　やってごらんなさいな！</Text>
			<TextModifiedBy
