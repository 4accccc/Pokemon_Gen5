		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event9_react_hero_0">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『うーん……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
