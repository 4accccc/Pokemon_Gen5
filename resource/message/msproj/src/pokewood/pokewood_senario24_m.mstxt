		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>%MYNAME王子1『そっちこそ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
			<Status>Editing</Status>
