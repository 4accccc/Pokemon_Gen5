				Time="2011-11-16T10:09:31" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event9_react_hero_0">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『うーん……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『うーん……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event9_react_enemy_0">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『もう　いいじゃない……
すめば　みやこと　いうでしょう？▼
くらくて　さむくて　ジメジメした
まほうのオリでも　いずれ　なれるわよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T10:10:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T10:10:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『もう　いいじゃない……
住めば　都と　いうでしょう？▼
暗くて　寒くて　ジメジメした
魔法のオリでも　いずれ　慣れるわよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T10:10:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T10:10:29" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event9_react_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『まだまだ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『まだまだ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event9_react_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『かんべんしてよ　もう……
わたし　そろそろ　かえって▽
メイク　おとしたいんだけど……▼
ちょうじかんの　おけしょうは
おはだの　コンディションに▽
ひびくんだからさあ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『勘弁してよ　もう……
わたし　そろそろ　帰って▽
メイク　落したいんだけど……▼
長時間の　お化粧は
お肌の　コンディションに▽
ひびくんだからさあ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event9_react_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『そっちこそ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『そっちこそ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event9_react_enemy_2">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『ざんねん　ながら
そういうわけにも　いかないのよ▼
あなたのような　わかい　にんげんの
エネルギーを　すわないと▽
おはだに　できた　シミや　クマが▽
とれないんですもの……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『残念　ながら
そういうわけにも　いかないのよ▼
あなたのような　若い人間の
エネルギーを　吸わないと▽
お肌に　できた　シミと　クマが▽
取れないんですもの……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:31" />
		</LanguageCell>
	</TextRow>
