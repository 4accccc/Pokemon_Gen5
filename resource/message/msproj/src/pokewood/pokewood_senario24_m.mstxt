				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『はあ……
はあ……　う……▼
もんばん『ど　どうしたんだ？▼
[Name:TrainerName Idx="1" ]おうじ『なんか……
ボク……　くるしくて……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
