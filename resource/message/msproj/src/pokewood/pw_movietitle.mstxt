<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="pw_plot_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいじんに　ねらわれる　ゆうえんち
そこに　せいぎのみかたが　とうじょう</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:51:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:47:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怪人に　ねらわれる　遊園地
そこに　正義の味方が　登場</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:51:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:47:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション１－１</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T13:00:33" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ごうかきゃくせんの　とまる　はとばに
あくの　かいじんが　しゅつげん</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-30T02:14:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>豪華客船の　停まる　波止場に
悪の　怪人が　出現</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-30T02:13:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション１－２</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-15T12:16:40" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あくのかいじん　VS　ヒーローの
うんめいを　かけた　たたかい</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-30T02:14:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>悪の怪人　VS　ヒーローの
運命を　かけた　戦い</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-30T02:14:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション１－３</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T13:00:40" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆめの　エネルギーを　めぐって
ぶつかる　ひみつけいじと　かいとう</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T02:27:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夢の　エネルギーを　めぐって
衝突する　秘密刑事と　怪盗</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T02:27:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション２－１</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T10:53:36" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_004"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいとうからの　ちょうせんじょう
それは　こうみょうな　ワナ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T02:27:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怪盗からの　挑戦状
それは　巧妙な　ワナ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T02:27:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション２－２

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T10:53:47" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_005"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいとうの　つぎなる　えもの
ねらわれた　けいじの　いもうと</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T02:28:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怪盗の　次なる　獲物
ねらわれた　刑事の　妹</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:22:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション２－３

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T10:53:53" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_006"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひみつけいじと　かいとうの
ついせきげきが　ついに　けっちゃく</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T02:28:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>秘密刑事と　怪盗の
追跡劇が　ついに　決着</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T02:28:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション２－４

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T10:54:00" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_007"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だいとかいに　ＵＦＯ　しゅつげん
しゅつどうする　イッシュぼうえいたい</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-30T02:15:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:23:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大都会に　ＵＦＯ　出現
出動する　イッシュ防衛隊</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:22:46" />
