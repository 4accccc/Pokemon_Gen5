	<TextRow
		Label="pw_plot_012"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パトロールちゅうに　なぞの　ひめい
きゅうこうする　イッシュぼうえいたい</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-30T02:19:29" />
			<Status>Editing</Status>
