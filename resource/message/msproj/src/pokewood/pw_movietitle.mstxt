<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="pw_plot_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいじんに　ねらわれる　ゆうえんち
そこに　せいぎのみかたが　とうじょう</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:51:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:47:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怪人に　ねらわれる　遊園地
そこに　正義の味方が　登場</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:51:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:47:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション１－１</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T13:00:33" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_001">
		<LanguageCell
			Language="JPN">
			<Text>ごうかきゃくせんの　とまる　はとば
そこに　あらわれる　かいじん</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-15T12:17:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>豪華客船の　停まる　波止場
怪人が　出現</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-15T12:18:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション１－２</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-15T12:16:40" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_002">
		<LanguageCell
			Language="JPN">
			<Text>かいじん　VS　ヒーローの
うんめいを　かけた　たたかい</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-15T12:19:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怪人　VS　ヒーローの
運命を　かけた　戦い</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-15T12:19:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面
あらすじ
アクション１－３</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T13:00:40" />
		</CommentCell>
	</TextRow>
