				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_020"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーたちの　れんあいもよう
ゆうえんちで　さいかいする　ふたり</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:48:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーたちの　恋愛模様
遊園地で　再会する　ふたり</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:48:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:52:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_021"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まほうせかいの　クイーンの　ワナ
あやしいとびらの　むこうへ
</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-15T02:52:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>魔法世界の　クイーンの　ワナ
怪しい扉の　向こうへ
</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-15T02:47:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_022"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とじこめられた　まほうのオリ
もんばんとの　であい</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-15T02:44:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>閉じこめられた　魔法のオリ
門番との　出会い</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-15T02:44:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_023"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もとのせかいに　つながる　とびら
うんめいを　かけた　せんたく</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-15T02:51:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>元の世界に　つながる　扉を
運命を　かけた　選択
</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-15T02:51:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_024"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ＯＬとの　おおゲンカ
あやしいボールが　まねく　ひげき</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T02:31:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＯＬとの　大ゲンカ
怪しいボールが　招く　悲劇</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:24:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_025"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あやしい　ほうもんしゃ
ぬすまれる　ＯＬと　ボール</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-04T07:45:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怪しい　訪問者
盗まれる　ＯＬと　ボール</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-04T07:46:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_026"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょだいな　ＯＬ　しゅつげん
パニックに　おちいる　まち
</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T06:48:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>巨大な　ＯＬ　出現
パニックに　おちいる　街</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T06:48:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_027"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょだいかした　ＯＬの　うんめい
うんめいの　カギは　「あい」</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T06:49:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>巨大化した　ＯＬの　運命
運命の　カギは　「ＬＯＶＥ」</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-15T02:53:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_028"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにもの？　どこから？　なんのため？
ひとの　かたちをした　かいぶつ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T12:35:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>何者？　何処から？　何のため？
人の　形をした　怪物</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T13:25:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_029"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まよなかの　ゆうえんちを
ひめいと　ぜつぼうが　みたす！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T13:26:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>真夜中の　遊園地を
悲鳴と　絶望が　満たす！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T13:26:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_030"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうたいふめい　りかいふのう！
いじげんからの　ほうもんしゃ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T13:26:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正体不明　理解不能！
異次元からの　訪問者</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T13:26:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_031"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんさいはつめいかの　じっけん
こころをもつ　ロボットの　たんじょう　</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:27:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>天才発明家の　実験
心を持つ　ロボットの　誕生</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:27:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_032"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんさいはつめいかと　ロボット
つかのまの　こころの　こうりゅう</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T12:04:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>天才発明家と　ロボット
つかの間の　心の　交流</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T12:06:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_033"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うらぎられた　てんさいはつめいかと
ぼうそうする　ロボットの　ゆくえ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:26:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>裏切られた　天才発明家と
暴走する　ロボットの　行方</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:26:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_034"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんさいはつめいかと　ロボット
さいごのおもいで　えいえんのわかれ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:26:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>天才発明家と　ロボット
最後の思い出　　永遠の別れ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:26:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_035"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆうれいが　しゅつぼつする　むら
ちょうさする　ゴーストイレイザー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:53:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>幽霊が　出没する　村
調査する　ゴーストイレイザー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:54:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_036"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とりつかれた　しょうじょ
たちむかう　ゴーストイレイザー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:59:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とりつかれた　少女
立ち向かう　ゴーストイレイザー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:59:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_037"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひほうに　ひそむ　あくりょう
なぞをとく　ゴーストイレイザー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:53:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>秘宝に　潜む　悪霊
なぞを　解く　ゴーストイレイザー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T06:25:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_038"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふっかつした　はかいの　まじん
はめつを　とめる　ゴーストイレイザー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:53:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>復活した　破壊の魔神
破滅を止める　ゴーストイレイザー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>台本トップ画面

あらすじ

</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T12:56:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="pw_plot_039"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチクマン　ふっかつ？
ゆめの　けっせんは　そらをこえて</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T05:57:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハチクマン　復活？
夢の決戦は　空を超えて</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T10:15:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-06-02T10:54:39" />
		</LanguageCell>
		<CommentCell
