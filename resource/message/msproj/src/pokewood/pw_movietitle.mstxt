	<TextRow
		Label="pw_select_01">
		<LanguageCell
			Language="JPN">
			<Text>このさくひんを　かんしょう
しますか？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-07-20T11:57:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
