				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『もうっ……▼
あの作業員が　じゃまで
うまくポケモンが　つかえない……▼</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『もうっ……▼
あの人が　作業員で
うまくポケモンが　使えない……▼</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしん『きこえるか！　[Name:TrainerName Idx="1" ]！
しみんが　いる　なかで　Ｍ・Ｂと▽
たたかうのは　きけんだっ！▼
まず　かれを　にがすことを
ゆうせん　するんだっ！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>通信『聞こえるか！　[Name:TrainerName Idx="1" ]！
市民が　いる　中で　Ｍ・Ｂと▽
戦うのは　危険だっ！▼
まず　彼を　逃がすことを
優先するんだっ！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:13" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ラジャー！！▼
さて……
どうにかして　あのひとを▽
ここから　にがさないと……▼
まずは　Ｍ・Ｂの　ちゅういを
ひいて　じかんを　かせぐか……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ラジャー！！▼
さて……
どうにかして　あの人を▽
ここから　逃がさないと……▼
まずは　Ｍ・Ｂの　注意を
ひいて　時間を　かせぐか……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:13" />
		</LanguageCell>
		<AttributeCell
