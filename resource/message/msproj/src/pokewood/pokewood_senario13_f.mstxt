				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとこ『やー！　たすかっただよー！
あんな　でっけえ　バケモンを▽
やっつけるなんて！▼
いやー　アンタ　すげーな！！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>男『やー！　助かっただよー！
あんな　でっけえ　バケモンを▽
やっつけるなんて！▼
いやー　アンタ　すげーな！！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
