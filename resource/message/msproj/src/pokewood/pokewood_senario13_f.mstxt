	<TextRow
		Label="pw_event0_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしん『どうした？　[Name:TrainerName Idx="1" ]！
なにか　あったのかっ！？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
