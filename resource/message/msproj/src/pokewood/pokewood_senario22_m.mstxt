	</TextRow>
	<TextRow
		Label="pw_event3_react_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『そうは　いくか！</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-28T11:05:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
