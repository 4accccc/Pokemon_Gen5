	</TextRow>
	<TextRow
		Label="pw_event7_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『まけました……
わたしまけましたわ……</Text>
