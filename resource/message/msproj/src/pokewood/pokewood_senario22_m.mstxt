				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『やれやれ……
おしろで　ぬくぬく　くらして　ないで▽
どっか　たびでも　してきたら？▼
そうね……　わたしの　しりあいで
くろかみ　びじんで　すごく　つよい▽
おねえさんが　いるから▽
しょうかい　してあげましょうか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『やれやれ……
お城で　ぬくぬく　暮らして　ないで▽
どっか　旅でも　してきたら？▼
そうね……　私の　知り合いで
黒髪美人で　すごく　強い▽
お姉さんが　いるから▽
紹介して　あげましょうか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『えっ！▼
くろかみ！？　びじん！？
そのうえ　おねーさん　ですって！！▼
い　いいんですか？
ぜひぜひ　おねがい　しますっ！▼
わーい！　わーい！
くろかみ！　びじん！　おねーさん！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『えっ！▼
黒髪！？　美人！？
そのうえ　おねーさん　ですって！！▼
い　いいんですか？
ぜひぜひ　お願い　しますっ！▼
わーい！　わーい！
黒髪！　美人！　おねーさん！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_enemy_3">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『やれやれ▼
あなたみたいな　ガキは　わたしの
まほうの　せかいには　いらないわ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『やれやれ▼
あなたみたいな　ガキは　私の
魔法の　世界には　いらないわ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event7_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうして　[Name:TrainerName Idx="1" ]おうじは
しゅぎょうの　たび……▼
というか　おねえさんに　あうための▽
たびへ　でたのであった……▼
まあ　けっかてきに　とびら　から
ぶじに　でられたのだから▽
これで　よかったのかも　しれない……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こうして　[Name:TrainerName Idx="1" ]王子は
修行の　旅……▼
というか　おねえさんに　あうための▽
旅へ　出たのであった……▼
まあ　結果的に　扉から
無事に　出られたのだから▽
これで　良かったのかも　しれない……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event8_hero_0">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『うう　つかれた……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-28T11:05:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-28T11:05:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『うう　疲れた……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-28T11:05:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-28T11:05:24" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event8_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『ほーら
お・い・つ・い・た！▼
さあ　かんねんなさい！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『ほーら
お・い・つ・い・た！▼
さあ　観念なさい！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event8_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『うわーっ！
ちちうえ　たすけてーっ！▼
こ　こんなことなら　いいつけを　きいて
よるのさんぽ　やめときゃ　よかった！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『うわーっ！
父上　助けてーっ！▼
こ　こんなことなら　言いつけを　聞いて
夜の散歩　やめときゃ　良かった！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T03:37:39" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event8_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『おほほ……
あなたが　おうじ　だってことは▽
はじめからは　わかっていたのよ▼
おやの　いいつけも　まもらず
よなかに　フラフラ　あそびまわる▽
どうしようもない　アホおうじ　ってことも▼
あなたが　ここに　くることも
おみとおしなのよ……▼
そして　ここで　このくにの　あとつぎが
いなくなれば　あらそいが　おきるわね</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『おほほ……
あなたが　王子だってことは▽
初めからは　分かってたのよ▼
親の　言いつけも　守らず
夜中に　フラフラ　遊びまわる▽
どうしようもない　アホ王子　ってことも▼
あなたが　ここに　来ることも
お見通しなのよ……▼
そして　ここで　この国の　跡継ぎが
いなくなれば　争いが　起きるわね</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event8_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『なんだって！？
そ　そんなわけ　ないだろ？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『何だって！？
そ　そんなわけ　ないだろ！？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event8_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『あら……▼
あなたみたいな　バカとは　いえ
あとつぎを　まもれないような　おうを▽
こくみんは　しんらい　するかしら？
それに　あなたの　おとうさまは
あなたを　さがしまわって▽
つかれはてて　しまうことでしょうよ▼
その　すきを　ついて　だいじんが
おうのざを　いただく　ってわけ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『あら……▼
あなたみたいな　バカとは　いえ
世継ぎも　守れないような　王を▽
国民は　信頼するかしら？
それに　あなたの　お父様は
あなたを　探し回って▽
疲れ果てて　しまうことでしょうよ▼
そのスキを　ついて　大臣が
下克上……　それでフィニッシュよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event8_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『おまえ……
だいじんに　やとわれて　いたのか！！▼
くそっ！！　ちちうえ！　ちちうえー！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『おまえ……
大臣に　やとわれて　いたのか！！▼
くそっ！！　父上！　父上ー！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event8_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『おほほ……
おとうさまの　しんぱい　している
よゆうなんて　ないと　おもうけど？▼
あなたは　きょうから　わたしのしたで
めしつかいとして　えいえんに　はたくの▼
ほら……　さっさと　あるくんだよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『おほほ……
お父様の　心配を　している
余裕なんて　ないと　思うけど？▼
あなたは　今日から　私の下で
ドレイとして　永遠に　働くの▼
ほら……　さっさと　歩くんだよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event8_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……とらえられた　[Name:TrainerName Idx="1" ]おうじは
ジュジュベの　やかたで▽
しぬまで　はたらかされたと　いう……▼
よなかに　あやしいとびらを　みつけても
けっして　あけないほうが　いいのだ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……とらえられた　[Name:TrainerName Idx="1" ]王子は
ジュジュベの　館で▽
死ぬまで　働かせたと　いう……▼
夜中に　怪しい扉を　見つけても
決して　開けないほうが　いいのだ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-23T08:32:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event9_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『やったっ！
ぜんぶ　たおしたぜ！▼
これで　でられる……　あれ！？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『やったっ！
ぜんぶ　倒したぜ！▼
これで　出られる……　あれ！？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event9_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『どこだっ！？
くそーっ！　でぐちは　どこだ！▽
とびらは　どこなんだー！？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]おうじ『どこだっ！？
くそーっ！　でぐちは　どこだ！▽
とびらは　どこなんだー！？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event9_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『むだ　だって
いったでしょう……？▼
もとの　せかいに　かえる　とびらは
ここには　ないんだから</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『無駄　だって
言ったでしょう……？▼
元の世界に　帰る　扉は
ここには　ないんだから</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event9_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『あばれないでよ▼
あなた　しょうぶも　そこそこ　つよいし
ほんとうの　とびらを　さがされても▽
めんどう　だわね……▼
とりあえず　まほうのオリに
とじこめちまいましょう</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『暴れないでよ▼
あなた　勝負も　そこそこ　強いし
本当の　扉を　探されても▽
面倒だわね……▼
とりあえず　魔法のオリに
閉じ込めちまいましょう</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event9_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まほうのオリ『ガシャーン！▼
[Name:TrainerName Idx="1" ]おうじ『うわーっ！
やめろ！！　ここから　だせーっ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>魔法のオリ『ガシャーン！▼
[Name:TrainerName Idx="1" ]王子『うわーっ！
やめろ！！　ここから　出せーっ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event9_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>まほうクイーン　ジュジュベの　しもべを
たおしたにも　かかわらず▽
まほうのオリの　なかに▽
とじこめられて　しまった▽
[Name:TrainerName Idx="1" ]おうじ……▼
はたして　[Name:TrainerName Idx="1" ]おうじは　ぶじに
もとの　せかいに　かえれるのか！？▼
われわれに　できるのは
そうなることを　いのるだけ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まほうクイーン　ジュジュベの　僕を
倒したにも　かかわらず▽
魔法のオリの　中に▽
閉じ込められて　しまった▽
[Name:TrainerName Idx="1" ]王子……▼
果たして　[Name:TrainerName Idx="1" ]王子は　無事に
元の世界に　帰れるのか！？▼
我々に　出来るのは
そうなることを　祈るだけ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:18" />
		</LanguageCell>
	</TextRow>
</MessageStudioText>