				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event3_react_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『もう　ダメだー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T05:56:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T05:56:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『もう　ダメだー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T05:56:37" />
			<Status>Editing</Status>
