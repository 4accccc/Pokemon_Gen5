	<TextRow
		Label="pw_event0_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチクマン『ファファファ！！▼
さあ！　かくごは　よいか！？
[Name:PokemonNickname Idx="0" ]ガール！！</Text>
