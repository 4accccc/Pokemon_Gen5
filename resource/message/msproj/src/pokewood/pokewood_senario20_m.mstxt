				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『えへへ</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『えへへ</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『……▼
（ああ……
どんなに　きびしい　ことを　いっても▽
ヘラヘラしている　あの　えがお……▼
ハッ！　ワタクシ　いつのまにか
あの　ひとの　ことを……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『……▼
（ああ……
どんなに　厳しい事を　いっても▽
ヘラヘラしている　あの　笑顔……▼
ハッ！　ワタクシ　いつの間にか
あの人の　事を……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『バルバラさん
どうか　したんですか？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『バルバラさん
どうか　したんですか？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_3">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『と　ともだち　からなら
つきあってあげても　よくってよ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『と　友達からなら
付き合ってあげても　良くってよ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:51:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:51:38" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_4">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『ふう……▼
（なにかしら……　ふしぎ
いっしょにいて　やすらかな▽
きもちになれる　とのがた……▼
こんなの　はじめて……ですわ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『ふう……▼
（何かしら……　不思議
一緒にいて　安らかな▽
気持ちになれる　殿方……▼
こんなの　初めて……ですわ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_5">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶが　ちからだけで
きまるわけでは　ないように▼
ひとと　ひととの　かんけいも
つねに　つよいものが▽
かつとも　かぎらない</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝負が　力だけで
決まる訳では　ないように▼
人と　人との　関係も
常に　強い者が▽
勝つとも　限らない</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_6">
		<LanguageCell
			Language="JPN">
			<Text>みぎの　ほほを　ひっぱたかれれば
わらって　ひだりの　ほほを　だす▽
それもまた　あいの　かたち！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>右の　ほほを　ひっぱたかれれば
笑って　左の　ほほを　出す▽
それもまた　愛の形！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event3_hero_0">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ハァ　ハァ……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ハァ　ハァ……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event3_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『なんですの？
もう　ねを　あげて　しまうのですか？▼
またしても　きたいはずれですわ……
ワタクシに　ふさわしい　とのがたは▽
どこに　いらっしゃるのかしら……？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『何ですの？
もう　音を上げて　しまうのですか？▼
またしても　期待外れですわ……
ワタクシに　相応しい　殿方は▽
どこに　いらっしゃるのかしら……？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event3_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『そんなあ
バルバラさん……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『そんなあ
バルバラさん……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event3_enemy_2">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『おきのどく　ですが
ワタクシ　ぼうやのような▽
へいぼんな　とのがたに　きょうみは▽
ございません　ことよ！▼
２どと　あうことも　ありませんわ
いきましょう　ドーブルちゃん！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『お気の毒ですが
ワタクシ　坊やのような▽
平凡な　殿方に　興味は▽
ございません　ことよ！▼
２度と　会うことも　ありませんわ
行きましょう　ドーブルちゃん！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event3_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドーブル『ブルゥ！　ブブルッ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドーブル『ブルゥ！　ブブルッ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event3_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶの　けっかが
ひととおりでは　ないように▼
ひとと　ひととの　かんけいも
つねに　おもいどおりに▽
いくとは　かぎらない</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝負の　結果が
一通りでは　ないように▼
人と　人との　関係も
常に　思い通りに▽
いくとは　限らない</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event3_hero_5">
		<LanguageCell
			Language="JPN">
			<Text>あいてのことを　おもえばこそ
つらい　わかれを　うけいれる▽
それもまた　あいの　かたち！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手の事を　思えばこそ
辛い　別れを　受け入れる▽
それもまた　愛の形！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event4_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドーブル『ブ……ブルブル……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドーブル『ブ……ブルブル……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『なっ　なんですの？
ワタクシの　ドーブルちゃんを▽
たおして　しまうなんて！▼
あなた　どうかしてるんじゃなくて？
２どと　あいたく　ありませんわ！▼
ばか！　だいきらい！　ですわ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-07T08:12:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-07T08:12:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『なっ　何ですの？
ワタクシの　ドーブルちゃんを▽
倒して　しまうなんて！▼
あなた　どうかしてるんじゃなくて？
２度と　会いたく　ありませんわ！▼
ばか！　大嫌い！　ですわ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-07T08:12:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-07T08:12:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ばか……？
だいきらい……？▼
バルバラさん　きびしい……！
そこが　また　いい……！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:43:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:43:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ばか……？
大嫌い……？▼
バルバラさん　厳しい……！
そこが　また　良い……！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶの　せかいに
ばんくるわせが　あるように▼
ひとと　ひととの　かんけいも
なにがおこるか　わからない</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝負の　世界に
番狂わせが　あるように▼
人と　人との　関係も
何が起こるか　分からない</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>つらい　しうちを　うけたとしても
よろこんで　うけとめる▽
それもまた　あいの　かたち！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>辛い　仕打ちを　受けたとしても
喜んで　受け止める▽
それもまた　愛の形！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_0">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『ぼうや　あなたって
ほんとうに　わけが　わかりませんわ</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
