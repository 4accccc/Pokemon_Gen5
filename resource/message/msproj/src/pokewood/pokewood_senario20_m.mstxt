				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_turn_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『バルバラさんの　ポケモン
すごく　アグレッシブ……！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:51:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:51:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『バルバラさんの　ポケモン
すごく　アグレッシブ……！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:51:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:51:38" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_turn_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『あらあら　ワタクシの
ドーブルちゃんに　タジタジですの？▼
それでは　ワタクシに　ふさわしい
とのがたには　なれなくってよ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『あらあら　ワタクシの
ドーブルちゃんに　タジタジですの？▼
それでは　ワタクシに　相応しい
殿方には　なれなくってよ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_turn_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『もっと　はげしく
ぶつかってきて　ください！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『もっと　激しく
ぶつかってきて　ください！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『こんなところに　よびだして
なにを　いうかと　おもえば▽
つきあってください　ですって？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『こんな所に　呼び出して
何の　言うかと　思えば▽
付き合ってください　ですって？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-05T07:37:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-05T07:37:15" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ぼ　ぼく……
はじめて　みた　ときから▽
あなたに　むちゅうで……▽
ずっと　みていました！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ぼ　僕……
初めて　みた　時から▽
あなたに　夢中で……▽
ずっと　みていました！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『ワタクシが　あなたと？
なにかの　じょうだんで　なくて？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『ワタクシが　あなたと？
なにかの　冗談で　なくて？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ほ　ほんきです！
こたえて　もらうまで　かえりません！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ほ　本気です！
答えて　もらうまで　帰りません！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『ふうん……▼
（ぼうやのクセに　なまいきね
こうなったら　てっていてきに▽
イジメぬいて　さしあげますことよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『ふうん……▼
（坊やのクセに　生意気ね
こうなったら　徹底的に▽
イジメぬいて　さしあげますことよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_3">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『じゃあ　こうしましょう！
ポケモンしょうぶで　ワタクシたち▽
ふたりの　あいしょうを▽
たしかめるのは　どう？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『じゃあ　こうしましょう！
ポケモン勝負で　ワタクシたち▽
ふたりの　相性を▽
確かめるのは　どう？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T07:08:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『は　はい！　やります！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『は　はい！　やります！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_4">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『あら　いい　へんじね▼
（フフフ……　たのしみだわ……
ワタクシ　とのがたが▽
おちこむ　すがたを　みるのが▽
たまらなく　すきでしてよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『あら　いい　返事ね▼
（フフフ……　楽しみだわ……
ワタクシ　殿方が▽
落ち込む　姿を　みるのが▽
たまらなく　好きでしてよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_5">
		<LanguageCell
			Language="JPN">
			<Text>ドーブル『ブルッ　ブルルフ……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドーブル『ブルッ　ブルルフ……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T02:24:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_6">
		<LanguageCell
			Language="JPN">
			<Text>バルバラ『では　はじめますわよ！▼
（ドーブルちゃんも
やるきマンマン　ですわ▼
いままで　ワタクシに
こくはくしてきた　とのがた……▼
ひとりのこらず　ズタボロにして
プライドを　へしおってきましたのよ▼
ぼうやは　どれだけ
たえられる　かしら……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バルバラ『では　はじめますわよ！▼
（ドーブルちゃんも
やる気マンマン　ですわ▼
今まで　ワタクシに
告白してきた　殿方……▼
ひとり残らず　ズタボロにして
プライドを　へし折ってきましたのよ▼
坊やは　どれだけ
耐えられる　かしら……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_7">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『バ　バルバラさん！
はじめるまえに　ひとつだけ▽
おねがいが　あります！▽
もし　ぼくが　かったら……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T11:45:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『バ　バルバラさん！
始める前に　ひとつだけ▽
お願いが　あります！▽
もし　僕が　勝ったら……</Text>
			<TextModifiedBy
