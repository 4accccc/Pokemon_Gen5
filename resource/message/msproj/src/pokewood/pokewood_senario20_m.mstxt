	<TextRow
		Label="pw_event2_hero_0">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『あちゃー！
まけちゃったー！▼
バルバラさんは　つよいなあ！
まったく　かなわないですよ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
