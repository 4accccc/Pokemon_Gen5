	<TextRow
		Label="pw_event6_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]『で　きみ……
なんで　こんなことを　したの？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T11:59:24" />
			<Status>Editing</Status>
