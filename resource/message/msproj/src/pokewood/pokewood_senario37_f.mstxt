	<TextRow
		Label="pw_event3_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]『こどもの　ようすが…？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T12:53:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
