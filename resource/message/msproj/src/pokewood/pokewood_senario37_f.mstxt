	<TextRow
		Label="pw_turn_hero_0">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『うっ……
くうきが　よどんでいる……▼
いっきに　かたを　つけないと……
のみこまれそうだ……▽
かくじつに　しとめないと……
</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-03T11:23:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-03T11:23:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『うっ……
空気が　よどんでいる……▼
いっきに　かたを　つけないと……
飲みこまれそうだ……▽
確実に　仕留めよう……
</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-03T11:23:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-03T11:23:53" />
		</LanguageCell>
	</TextRow>
