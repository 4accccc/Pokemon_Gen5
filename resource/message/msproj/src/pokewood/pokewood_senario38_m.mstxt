				Time="2011-11-16T10:10:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event9_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『まさか……？
