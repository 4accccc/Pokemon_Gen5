	<TextRow
		Label="pw_turn_enemy_5">
		<LanguageCell
			Language="JPN">
			<Text>いらいぬし『しとめちゃって　ください
[Name:TrainerName Idx="1" ]さーん</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:10:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
