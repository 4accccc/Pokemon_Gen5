				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_react_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]『はかいのまじん　だ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T12:53:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
