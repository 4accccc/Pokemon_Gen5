		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『まさか……？
お前は……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:10:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
