	<TextRow
		Label="pw_event6_enemy_4">
		<LanguageCell
			Language="JPN">
			<Text>おとこのひと『や　やめろ！
ウワァーッ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-18T01:43:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
