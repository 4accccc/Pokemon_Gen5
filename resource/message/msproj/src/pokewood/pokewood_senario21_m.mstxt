				Time="2011-11-17T11:05:55" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event8_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ん　んん……？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-17T11:05:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-17T11:05:55" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ん　んん……？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-17T11:05:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-17T11:05:55" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event8_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>……めざめると　いつも　どおり
げんきな　マリアが　いた……▼
しかし　ふたたび　ねむりに　おちると
ゆうえんちに　ドーブルが　いて▽
また　ポケモンしょうぶが　はじまる▼
そこで　また　ゆめから　さめると……
げんきな　マリアが　いて……▼
いったい　どちらが
げんじつ　なのだろうか？▼
どちらも　ゆめ……？
どちも　げんじつ……？▼
……まあ　どうでも　いいか……▼
わたしに　とっては　マリアが
そんざいする　せかいが▽
しんじつ　なのだから……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T13:22:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T13:22:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……目覚めると　いつも　どおり
元気な　マリアが　いた……▼
しかし　再び　眠りに　おちると
遊園地に　ドーブルが　いて▽
また　ポケモン勝負が　始まる▼
そこで　また　夢から　覚めると……
元気な　マリアが　いて……▼
いったい　どちらが
現実　なのだろうか？▼
どちらも　夢……？
どちも　現実……？▼
……まあ　どうでも　いいか……▼
わたしに　とっては　マリアが
存在する　世界が▽
真実　なのだから……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T13:22:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T13:22:05" />
		</LanguageCell>
	</TextRow>
