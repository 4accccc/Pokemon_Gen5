	<TextRow
		Label="pw_event0_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドーブル『ゆうれいが　いるんですから
ポケモンだって　しゃべりますよ</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-10-31T04:20:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-10-31T04:20:56" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドーブル『幽霊が　いるんですから
ポケモンだって　しゃべりますよ</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-03T11:23:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
