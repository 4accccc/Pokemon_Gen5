		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『夢……？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-11T12:14:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
