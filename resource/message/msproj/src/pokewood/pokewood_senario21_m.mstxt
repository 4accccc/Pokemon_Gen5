	<TextRow
		Label="pw_event0_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ゆうれいって
きおくを　なくすのか？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-10-31T04:20:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
