	<TextRow
		Label="pw_event8_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ゆめ……？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-11T12:14:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
