	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="pw_briefing_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]は　わがままな
[Ctrl1:xcenter ]こまった　おうじさま
[Ctrl1:xcenter ]
[Ctrl1:xcenter ]きょうも　おうさまの
[Ctrl1:xcenter ]いいつけに　そむいて
[Ctrl1:xcenter ]よるおそく　にわを　さんぽしていた
</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-06T03:19:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]は　わがままな
[Ctrl1:xcenter ]こまった　王子様
[Ctrl1:xcenter ]
[Ctrl1:xcenter ]今日も　王様の
[Ctrl1:xcenter ]言いつけに　そむいて
[Ctrl1:xcenter ]夜おそく　庭を　散歩していた
</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-06T03:19:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あらすじ♂</Comment>
			<CommentModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]ふと　きがつくと
[Ctrl1:xcenter ]にわの　おくに　あやしい
[Ctrl1:xcenter ]とびらが　ひとつ……
</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-06T03:22:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:35:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]ふと　気がつくと
[Ctrl1:xcenter ]庭の　おくに　怪しい
[Ctrl1:xcenter ]とびらが　ひとつ……
</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-06T03:22:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:36:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]おうじが
[Ctrl1:xcenter ]とびらを　あけると
[Ctrl1:xcenter ]
[Ctrl1:xcenter ]そこには　みたこともない
[Ctrl1:xcenter ]ぶきみな　ふうけいが
[Ctrl1:xcenter ]ひろがるばかり……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-06T03:26:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:52:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]王子が
[Ctrl1:xcenter ]扉を　開けると
[Ctrl1:xcenter ]
[Ctrl1:xcenter ]そこには　見たこともない
[Ctrl1:xcenter ]ぶきみな　風景が
[Ctrl1:xcenter ]広がるばかり……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-06T03:25:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:55:16" />
		</LanguageCell>
	</TextRow>
