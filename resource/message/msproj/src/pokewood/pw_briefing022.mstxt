<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="pw_briefing_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]は　とあるくにの
[Ctrl1:xcenter ]ワガママで　ゆうめいな　おうじさま

[Ctrl1:xcenter ]きょうも　また　おうさまの
[Ctrl1:xcenter ]いいつけに　そむいて　よるもおそくに
[Ctrl1:xcenter ]おしろの　にわを　さんぽしていました</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T13:19:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]は　とある国の
[Ctrl1:xcenter ]ワガママで　有名な　王子様

[Ctrl1:xcenter ]今日も　また　王様の
[Ctrl1:xcenter ]言いつけに　背いて　夜も遅くに
[Ctrl1:xcenter ]お城の　庭を　散歩していました</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T13:20:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あらすじ♂</Comment>
			<CommentModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]ふと　きがつくと
[Ctrl1:xcenter ]ひろい　にわの　おくに　みなれない
[Ctrl1:xcenter ]あやしい　しろいとびらが　ひとつ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T13:22:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:35:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]ふと　気がつくと
[Ctrl1:xcenter ]広い庭の　奥に　見慣れない
[Ctrl1:xcenter ]怪しい　白い扉が　ひとつ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T13:22:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:36:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]おもわず　[Name:TrainerName Idx="1" ]おうじは
[Ctrl1:xcenter ]その　しろい　とびらを　あけました

[Ctrl1:xcenter ]すると……

[Ctrl1:xcenter ]とびらのむこうには　みたこともない
[Ctrl1:xcenter ]ぶきみな　ふうけいが
[Ctrl1:xcenter ]ひろがるばかり……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T13:23:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:52:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]思わず　[Name:TrainerName Idx="1" ]王子は
[Ctrl1:xcenter ]その　白い扉を　開けました

[Ctrl1:xcenter ]すると……

[Ctrl1:xcenter ]扉の向こうには　見たこともない
[Ctrl1:xcenter ]不気味な　風景が
[Ctrl1:xcenter ]広がるばかり……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T13:24:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:55:16" />
		</LanguageCell>
	</TextRow>
