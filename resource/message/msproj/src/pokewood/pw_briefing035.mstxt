	<TextRow
		Label="pw_briefing_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]これは　とある　はつめいかに
[Ctrl1:xcenter ]おきた　できごとで　ある……
</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T10:27:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]これは　とある　発明家に
[Ctrl1:xcenter ]起きた　出来事で　ある……
</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T10:34:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あらすじ♂</Comment>
