	<TextRow
		Label="pw_turn_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『よし……
そろそろ　テスト　しゅうりょうだ……▼
でんじほうで　ＵＦＯを　とめろ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『よし……
そろそろ　テスト　終了だ……▼
でんじほうで　ＵＦＯを　停めろ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
