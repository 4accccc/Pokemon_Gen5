	<TextRow
		Label="pw_event3_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『どうした　[Name:TrainerName Idx="1" ]……
テストは　まだ　おわっていない▼
さっさと　たつんだ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:26:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:26:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『どうした　[Name:TrainerName Idx="1" ]……
テストは　まだ　終わっていない▼
さっさと　立つんだ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:26:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:26:38" />
