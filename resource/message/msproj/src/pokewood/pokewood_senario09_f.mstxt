				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『そのとおり……
ＵＦＯは　バトルプログラムによって▽
おまえを　こうげき　しつづけるぞ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『その通り……
ＵＦＯは　バトルプログラムによって▽
お前を　攻撃　し続けるぞ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『そんな……
きけんは　ないんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『そんな……
危険は　ないんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『それも　テストの　うちだ……▼
ああ……
それと　ちゅういが　ひとつ……▼
このＵＦＯは　まだ　ボディの
そうこうが　ふかんぜんだ……▼
でんじほう　いがいの　ダメージを
うけると　こわれてしまうからな▽
ちゅうい　してくれ……　</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『それも　テストの　うちだ……▼
ああ……
それと　注意が　ひとつ……▼
このＵＦＯは　まだ　ボディの
そうこうが　不完全だ……▼
でんじほう　以外の　ダメージを
受けると　壊れてしまうからな▽
注意　してくれ……　</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:57" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
