				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『わかってる……
ちょっとした　ミスだろう……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-04T12:02:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
