				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょしゅ『なにを　のんきなことを！
はやく　さがしに　いかないとッ！▼
Ｆー００は　テストだんかいで
なにを　するか　わかりません！▼
それに　じこにでも　あったら
どうするんですかッ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-16T03:08:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-16T03:08:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>助手『何を　のんきな　ことを！
早く　探しに　行かないとッ！▼
Ｆー００は　テスト段階で
何を　するか　分かりません！▼
それに　事故にでも　あったら
どうするんですかッ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-16T03:08:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-16T03:08:58" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょしゅ『さあ！　はかせっ！
はやく　さがしにいかないと！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:40" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>助手『さあ！　博士っ！
早く　探しにいかないと！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:40" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……　……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『……　……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……わたしたちは　ひっしで
Ｆー００を　おいかけた……▼
そして　そのさきで　みたのは
あばれまわる　Ｆー００だった……▼
たのしそうに　ビルや　くるまを
こわす　Ｆー００……▼
やがて　けいかんが　あらわれ
Ｆー００は　こわされた……▼
……わたしは　Ｆー００の
せきにんを　とることになり▽
けいさつに　つかまった……▼
あれから　２０ねん……▼
わたしは　あんな　ロボットを
つくって　しまったことを▽
とても　こうかい　している……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:40" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……私は　必死で
Ｆー００を　追いかけた……▼
そして　その先で　見たのは
暴れまわる　Ｆー００だった……▼
楽しそうに　ビルや　車を
壊す　Ｆー００……▼
やがて　警官が　現れ
Ｆー００は　壊された……▼
……私は　Ｆー００の
責任を　取ることになり▽
警察に　つかまった……▼
あれから　２０年……▼
私は　あんな　ロボットを
造って　しまったことを▽
とても　後悔　している……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:40" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｆー００『イタイ……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
