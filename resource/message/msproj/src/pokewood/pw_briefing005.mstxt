	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="pw_briefing_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]メカポリスに　たいほされた
[Ctrl1:xcenter ][Name:PokemonNickname ]ニンジャは　ごそうちゅうに
[Ctrl1:xcenter ]だっしゅつし　とうそうした</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T05:17:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]メカポリスに　逮捕された
[Ctrl1:xcenter ][Name:PokemonNickname ]ニンジャは　護送中に
[Ctrl1:xcenter ]脱出し　逃走した</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T05:17:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あらすじ♂</Comment>
			<CommentModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]それから　まもなくして
[Ctrl1:xcenter ]メカポリスに　おくられた　よこくじょう</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-25T07:04:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:35:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]それから　間もなくして
[Ctrl1:xcenter ]メカポリスに　送られた　予告状</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-25T07:00:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:36:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ][Name:PokemonNickname ]ニンジャは　だいたんにも
[Ctrl1:xcenter ]なんごくの　ひほう
[Ctrl1:xcenter ]レインボーパールを　ぬすむと
[Ctrl1:xcenter ]よこくして　きたのだった！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T05:17:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:52:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ][Name:PokemonNickname ]ニンジャは　大胆にも
[Ctrl1:xcenter ]南国の　秘宝　レインボーパールを
[Ctrl1:xcenter ]盗むと　予告　してきたのだった！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-26T05:17:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:55:16" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_004"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]レインボーパールを　まもるため
[Ctrl1:xcenter ]きゅうこうせよ　メカポリス！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-25T07:05:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:00:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]レインボーパールを　守るため
[Ctrl1:xcenter ]急行せよ　メカポリス！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-25T07:05:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:04" />
		</LanguageCell>
	</TextRow>
