	</TextRow>
	<TextRow
		Label="pw_event0_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ゆうれいって
きおくを　なくすの？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-10-31T04:20:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-10-31T04:20:55" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ゆうれいって
