	<TextRow
		Label="pw_event0_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドーブル『あのー　こうふんの　ところ
すみませんが　ちょっと　いいすか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-24T03:38:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-24T03:38:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドーブル『……あのー　興奮の　ところ
すみませんが　ちょっと　いいすか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-24T03:38:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-24T03:38:13" />
