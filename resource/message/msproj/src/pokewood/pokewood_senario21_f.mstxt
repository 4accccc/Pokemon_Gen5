		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アントニオ『……　……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-17T11:05:54" />
