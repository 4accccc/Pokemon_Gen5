				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとこ『わたしは　セリザワ
この　とちの　オーナーだ……▼
ここで　なにを　していようと
かまわんだろう……？▼
それよりも　なんだね？　キミは？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:45:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:45:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>男『私は　セリザワ
この土地の　オーナーだ……▼
ここで　何を　していようと
構わんだろう……？▼
それよりも　だれだね？　キミは？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:45:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:45:13" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『わたしは　[Name:TrainerName Idx="1" ]！
イッシュぼうえいたい　クルーです！▼
セリザワさんと　いいましたね……
そのＭ・Ｂは　あなたのもの　ですか？　</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:45:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:45:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『私は　[Name:TrainerName Idx="1" ]！
イッシュ防衛隊　クルーです！▼
セリザワさんと　言いましたね……
そのＭ・Ｂは　あなたのもの　ですか？　</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:45:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:45:13" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>セリザワ『イッシュぼうえいたい……▼
そうか　あれは　キミが……▼
……ちょうど　いいねェ▼
わたしの　けいかくを　じゃました
あげく　Ｍ・Ｂを　はかい　してくれた▽
れいを　しなければ　いかんなァ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>セリザワ『イッシュ防衛隊……▼
そうか　あれは　キミが……▼
……ちょうど　いいねェ▼
私の　プランを　邪魔した
挙句　Ｍ・Ｂを　破壊してくれた▽
礼を　しなければ　いかんなァ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T09:38:24" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『なんだって……？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
