	</TextRow>
	<TextRow
		Label="pw_event6_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしん『[Name:TrainerName Idx="1" ]！　おうとうせよ！
おうとうせよ！　[Name:TrainerName Idx="1" ]！！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>通信『[Name:TrainerName Idx="1" ]！　応答せよ！
応答せよ！　[Name:TrainerName Idx="1" ]！！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
