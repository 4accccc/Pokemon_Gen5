	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]ガール『はあっ？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:23:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T09:23:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:PokemonNickname Idx="0" ]ガール『はあっ？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
