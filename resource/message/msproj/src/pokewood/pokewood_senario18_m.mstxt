	</TextRow>
	<TextRow
		Label="pw_event2_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『どういうこと！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
