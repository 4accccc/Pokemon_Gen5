				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]はかせ『フッ……
わたしは　じかん　てんそうきを▽
せっけいした　てんさい　かがくしゃだ▼
これくらいの　トラブルは
そうていの　はんいない　だ……！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T06:58:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T06:58:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]博士『フッ……
わたしは　時間転送機を▽
設計した　天才科学者だ▼
これくらいの　トラブルは
想定の　範囲内だ……！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T06:58:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T06:58:26" />
		</LanguageCell>
		<AttributeCell
