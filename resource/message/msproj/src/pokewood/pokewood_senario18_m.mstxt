				Time="2011-11-27T12:10:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『フン……▼
まあ　むしポケモンと　しては
かんしゃ　するわ　ごせんぞさま▼
ダメな　ニンゲンの　おかげで
みらいが　こう　なったんだもの</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T02:40:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T02:40:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『フン……▼
まあ　むしポケモンと　しては
感謝するわ　ご先祖様▼
ダメな　ニンゲンの　おかげで
未来が　こう　なったんだもの</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T02:40:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2012-02-01T02:40:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]はかせ『おまえらのせいだ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]博士『お前達のせいだ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:22" />
		</LanguageCell>
		<AttributeCell
