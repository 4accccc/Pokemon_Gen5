	<TextRow
		Label="pw_event7_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『…………！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『…………！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
