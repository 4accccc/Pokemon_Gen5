	<TextRow
		Label="pw_event1_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『やっと　これで……
われわれの　たびも　おわる……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T10:47:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T10:47:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>E『やっと　これで……
我々の旅も　終わる……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T10:47:57" />
			<Status>Editing</Status>
