	<TextRow
		Label="pw_event3_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……ウウッ！！
ヤダよっ！！　やめてーっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:26:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
