				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ひとは　ゆうしゅうよ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『人は　優秀よ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
