	<TextRow
		Label="pw_event4_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『よって　おまえを　わたしの
ぶかに　することに　した……</Text>
			<TextModifiedBy
				User="mori:W00269"
