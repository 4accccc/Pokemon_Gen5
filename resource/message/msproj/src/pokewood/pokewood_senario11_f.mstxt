	<TextRow
		Label="pw_event2_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『どうしたんだろう……
そらが……　ゆれている……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-30T05:10:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-30T05:10:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『どうしたんだろう……
空が　ゆれている……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-30T05:10:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-30T05:10:41" />
		</LanguageCell>
