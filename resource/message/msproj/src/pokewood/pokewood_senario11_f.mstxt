	<TextRow
		Label="pw_event5_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『くっ……▼
にんげんや　ポケモンを
どうする　つもりよっ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
