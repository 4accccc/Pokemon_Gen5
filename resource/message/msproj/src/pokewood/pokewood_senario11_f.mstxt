	<TextRow
		Label="pw_event1_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……どういう　こと？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
