				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『……UFOが　たおされたことで
マザーシップが　このほしを▽
きけんと　はんだん　したのだ……▼
……これで　われわれは　ふたたび
うちゅうくうかんを　あても　なく▽
さまようことに　なった……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>E『……UFOが　倒されたことで
マザーシップが　この星を▽
危険と　判断したのだ……▼
……これで　我々は　再び
宇宙空間を　あても　なく▽
さまようことに　なった……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『なあ　E……▼
あなたが　いうように　このほしには
すでに　たくさんの　にんげん……▽
そしてポケモンが　くらしている……▼
……だけどさ　これから　さきも
あたらしい　せいぶつが　うまれてくる▽
かのうせいだって　あるでしょ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『E……▼
あなたの　言うように　この星には
すでに　多くの　人間……▽
そしてポケモンが　暮らしている……▼
……だけどさ　これから先も
新しい　生物が　生まれてくる▽
可能性だって　あるでしょ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『それが　どうした……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>E『それが　どうした……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『だから……
いままで　このほしに　いなかった▽
きみたち　エイリアンが▽
ここで　いきていこうと　したって▽
わるいこと　なんかじゃ　ない……▼
……でも　じぶんたちの　つごうだけで
ほかの　いきものたちを▽
ほろぼしてしまおう　なんて▽
みとめるわけには　いかないよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-30T05:10:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-30T05:10:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『だから……
今まで　この星に　いなかった▽
君たち　エイリアンが▽
ここで　生きていこうと　したって▽
悪いこと　なんかじゃ　ない……▼
……でも　自分たちの　都合だけで
ほかの　生物たちを▽
滅ぼしてしまう　なんて▽
認めるわけには　いかないよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『……では　どうすると　いうのだ？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>E『……では　どうすると　いうのだ？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『わたしたち　にんげん……
そして　ポケモンと　エイリアン……▼
……みんなが　いっしょに　くらせる
ほうほうを　さがせば　いいじゃない？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『私たち　人間……
そして　ポケモンと　エイリアン……▼
……みんなが　一緒に　暮らせる
方法を　探せばいいじゃない？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『そうか……▼
だが　その　ていあんは　ておくれだな
わたしたちも　マザーシップと　ともに▽
このほしを　さらねば　ならない……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>E『そうか……▼
だが　その提案は　手遅れだな……
私たちも　マザーシップと　ともに▽
この星を　去らねば　ならない……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_5"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『そんな……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『そんな……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
