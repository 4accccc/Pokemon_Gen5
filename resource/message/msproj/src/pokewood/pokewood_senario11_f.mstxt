				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『りそうを　かたるのは　いい……▼
だが　おまえたちの　ような▽
おろかで　かとうな　せいぶつに▽
りそうが　じつげんできるのか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T03:50:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>E『理想を　語るのは　いい……
だが　お前たちの　ような▽
おろかで　下等な　生物に▽
理想が　実現できるのか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T10:47:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T10:47:57" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ひとは　ゆうしゅうよ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『人は　優秀よ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
