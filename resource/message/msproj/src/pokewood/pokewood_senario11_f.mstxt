	<TextRow
		Label="pw_event1_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『さあ……　くるぞ……
ははなる　マザーシップが……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
