		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ち……違う！！
私は　そんな！！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
