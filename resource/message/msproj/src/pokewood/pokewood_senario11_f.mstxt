				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『そして……
このほしは　われわれの▽
らくえんとして　うまれかわる……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
