	<TextRow
		Label="pw_event6_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]『あのねえ　そんなの
さいしょから　おみとおしです！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T12:53:12" />
