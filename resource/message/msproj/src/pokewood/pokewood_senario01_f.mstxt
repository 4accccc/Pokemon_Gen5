				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチクマン『ヌ……　なにものだ！
</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハチクマン『ヌ……　何者だ！
</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『しんじつと　りそうの　ししゃ
[Name:PokemonNickname Idx="0" ]ガール　とうじょう！▼
ちょっと　ハチクマンさん！▼
アナタの　イタズラ！
ほっとけ　ないよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>？？？『真実と　理想の　使者
[Name:PokemonNickname Idx="0" ]ガール　登場！▼
ちょっと　ハチクマンさん！
▼
アナタの　イタズラ！
ほっとけ　ないよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:25" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆうえんちのきゃく『わー！　なんだ！
ヒーローショーでも　やってるのか？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>遊園地の客『わー！　何だ！
ヒーローショーでも　やってるのか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-07T11:00:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-07T11:00:58" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチクマン『わがはいの　ポケモンを
たったの　いちげきだと……▽
やるな！　[Name:PokemonNickname Idx="0" ]ガール！▼
だが　しかし！　だが　しかし！▼
わがはいの　あくのおうぎで
きさまを　ひざまづかせて　やろう！▼
さあ！　かくごは　よいかッ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:32:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:32:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハチクマン『我輩の　ポケモンを
たったの　一撃で……▽
やるな！　[Name:PokemonNickname Idx="0" ]ガール！▼
だが　しかし！　だが　しかし！▼
我輩の　悪の奥義で
貴様を　ひざまづかせて　やろう！▼
さあ！　覚悟は　よいかッ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T09:00:36" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]ガール『のぞむところよ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
