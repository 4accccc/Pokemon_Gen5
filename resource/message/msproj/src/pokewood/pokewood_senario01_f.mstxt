	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]ガール『ひぃ……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
