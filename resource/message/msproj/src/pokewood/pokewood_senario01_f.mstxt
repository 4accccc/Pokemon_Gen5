	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]ガール『ひー！　こわい！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:PokemonNickname Idx="0" ]ガール『ひー！　怖い！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-18T07:52:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
