		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『何でだよー？
ちゃんと　壊れただろー！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-21T10:56:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
