				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『もえてるねえ……
そのきあいが　あれば　ひょっとしたら▽
ひょっとするかもな……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『燃えてるねえ……
その気合が　あれば　ひょっとしたら▽
ひょっとするかもな……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『ていうかさ……
もうボク　めんどうくさいよー▽
とびらとか　どうでもいいよー▼
ねえー　ぬいぐるみー
おこづかい　あげるからさー▽
なんとか　にがしてくれないかなー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『ていうかさ……
もう　ボク　面倒臭いよー▽
扉とか　どうでもいいよー▼
ねえー　ぬいぐるみー
お小遣い　あげるからさー▽
なんとか　逃がしてくれないかなー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『ゲー！　ばいしゅう　かよ！▼
まったく　いっこくのおうじが　これじゃ
にんげんのみらいは　まっくらだね！▼
そもそも　ボク　ぬいぐるみ　なんだぜ
かねの　つかいみちなんて　ないよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『ゲー！　買収かよ！▼
まったく　一国の王子が　これじゃ
人間の未来は　真っ暗だね！▼
それに　ボクは　ぬいぐるみ　なんだぜ
人間とは　通貨が　違うんだから！▼
ボクを　抱きこみたいんだったら
ぬいぐるみマネーで　耳そろえて来な！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T12:30:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T12:30:42" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『ムカーッ！！▼
たかが　ぬいぐるみの　くせに
そんな　くち　きくなんて　なまいきな！▼
もう　いいよ！　たのまないよ！！
じぶんで　こわせば　いいんだろ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]おうじ『ムカーッ！！▼
たかが　ぬいぐるみの　くせに
そんな口　聞くなんて　生意気な！▼
それに　一体　何なんだよ
ぬいぐるみマネー　っていうのは！▼
もう　いいよ！　頼まないよ！！
自分で　壊せば　いいんだろ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『なあ……
きみは　なぜ　つかまったの？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『なあ……
君は　なぜ　捕まったの？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:25" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『うーん……
あんまり　おぼえてないけど……▼
きっと　キミと　にたような
りゆう　だったかもねー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『うーん……
あんまり　覚えてないけど……▼
きっと　キミと　似たような
理由だったかもねー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『ふーん……▼
ぬいぐるみの　くせに　くろうしてるんだ
だから　ボロボロで　きたないのか……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『ふーん……▼
ぬいぐるみの　くせに　苦労してるんだ
だから　ボロボロで　汚いのか……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『ひとこと　よけいだよ！▼
それに　ボクは　うまれつき
ぬいぐるみの　わけじゃない！▼
もともと　ボクも　キミと　おなじ
にんげん　だったんだからな▼
ジュジュベさまに　かけられた
まほうで　すがたを　かえられて▽
えいえんに　もんばんを　する▽
しごとを　あたえられたんだ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『一言　余計だよ！▼
それに　ボクは　生まれつき
ぬいぐるみの　わけじゃない！▼
もともと　ボクも　キミと　同じ
人間　だったんだからな▼
ジュジュベ様に　かけられた
魔法で　姿を　変えられて▽
永遠に　門番を　する▽
仕事を　与えられたんだ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『ひどいよ！　それ！
そんなの　にげれば　いいじゃないか！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『ひどいよ！　それ！
そんなの　逃げれば　いいじゃないか！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『そうだね……
そうしたい　ような　きも　するけど……▼
キミと　ちがって　ボクは
ポケモンも　もってないし▼
からだが　ワタで　できてるから
あまり　うまく　うごけないし……▼
そもそも　どうやって　ジュジュベさまに
たちむかえばいいか　わからないね</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『そうだね……
そうしたい　ような　気も　するけど……▼
キミと　違って　ボクは
ポケモンも　持ってないし▼
身体が　ワタで　出来てるから
あまり　うまく　動けないし……▼
そもそも　どうやって　ジュジュベさまに
立ち向かえばいいか　分からないしね</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event7_react_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『どうでも　いいやー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
