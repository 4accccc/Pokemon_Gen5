	<TextRow
		Label="pw_event1_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『ぬいぐるみ！▼
そこで　ボーっと　みてるなら
てつだって　くれても　いいだろ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-21T10:56:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
