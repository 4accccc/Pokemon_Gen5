				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『まほうの　とびらに
まけてしまった　ものは……▼
……　……　……▼
とびらに　かけられてる　まほうを
うつされて　ソイツも　とびらに▽
かわって　しまうのさ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『魔法の　扉に
負けてしまった　者は……▼
……　……　……▼
扉に　かけられてる　魔法を
うつされて　ソイツも　扉に▽
変わって　しまうのさ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『な！
なんだよ　それ……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『な！
何だよ　それ……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『ことばの　とおりさ
いまの　すがたから　すこしずつ▽
とびらに　かわってくんだよ▼
……おうじさまの　キミなら　きっと
ゴージャスな　かざりの　ついた▽
とびらに　なるだろうね……▽
きっと　いいねだんで　うれるとおもうよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『言葉の　通りさ
今の　姿から　少しずつ▽
扉に　変わっていくんだよ▼
……王子様の　キミなら　きっと
ゴージャスな　飾りの　ついた▽
立派な　扉に　なるだろうね……▽
きっと　いい値段で　売れると思うよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『イヤだー！！
とびらになんて　なりたくないよ！▼
まいにち　まいにち
とじたり　しまったり▽
とじたり　しまったり▽
するだけの　せいかつなんて！▽
たえられないよー！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『イヤだー！！
扉になんて　なりたくないよ！▼
毎日　毎日
閉じたり　閉まったり▽
閉じたり　閉まったり▽
するだけの　生活なんて！▽
耐えられないよー！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『……　……▼
いまのじゃあ　いちども
ひらいて　ないよな……？▼
……まあ　そんなふうに　ボケて
いられるのも　いまのうち　だぜー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T03:35:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T03:35:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『……　……▼
今のじゃあ　一度も
開いて　ないよな……？▼
……まあ　そんな風に　ボケて
いられるのも　今のうちだぜー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T03:35:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T03:35:28" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-22T09:55:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-22T09:55:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-22T09:55:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-22T09:55:16" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_5">
		<LanguageCell
			Language="JPN">
			<Text>……こうして　くろとびらに　まけた
[Name:TrainerName Idx="1" ]おうじは　じぶんが▽
とびらに　かえられてしまいました▼
きっと　いまごろ　そのとびらは
どこかの　いえの　とびらと　して▽
やくめを　はたして　いるのでしょう……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T03:35:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T03:35:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……こうして　黒扉に　負けた
[Name:TrainerName Idx="1" ]王子は　自分が▽
扉に　変えられてしまいました▼
きっと　今ごろ　その扉は
どこかの家の　扉と　して▽
役目を　果たして　いるのでしょう……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T03:35:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T03:35:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『なー　ぬいぐるみー
なー　もう　いいじゃないかよー▽
いいかげん　ヒント　おしえてよー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『なー　ぬいぐるみー
もう　いいじゃないかよー▽
いいかげん　ヒント　教えてよー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『だからさあ
ボクは　もんばん　なんだって！▼
それに　ヒントなんて　ないさ▼
そもそもさあ　かりに　ここから
でられたと　してもだよ▼
ジュジュベさまの　せかいから
にげられるわけじゃ　ないんだぜ？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『だからさあ
ボクは　門番　なんだって！▼
それに　ヒントなんて　ないさ▼
そもそもさあ　仮に　ここから
出られたと　してもだよ▼
ジュジュベ様の　世界から
逃げられるわけじゃ　ないんだぜ？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『それは　それ！▼
このまま　だまって　こんなオリに
とじこめられてるなんて　イヤなの！！▼
こんな　くらくて　ジメジメした　とこ
おそだちのいい　プリンスの▽
ボクに　ふさわしくないだろ？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『それは　それ！▼
このまま　だまって　こんなオリに
閉じ込められてるなんて　イヤなの！！▼
こんな　暗くて　ジメジメした　とこ
お育ちのいい　プリンスの▽
ボクに　相応しくないだろ？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『あっ　そう……▼
そのプライドは　いけすかないけど
なんとなく　こんじょうは　かんじるね</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『あっ　そう……▼
そのプライドは　いけ好かないけど
何となく　根性は　感じるね</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T01:14:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]おうじ『ボクは　やる！▼
おうじさまの　プライドに　かけて
このとびら　ぜったいに　こわす！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]王子『ボクは　やる！▼
王子様の　プライドに　かけて
この扉　絶対に　壊す！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T04:04:12" />
		</LanguageCell>
