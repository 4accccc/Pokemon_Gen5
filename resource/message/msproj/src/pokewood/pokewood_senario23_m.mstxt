	<TextRow
		Label="pw_event9_enemy_5">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『フッ……　おそい……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T10:31:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
