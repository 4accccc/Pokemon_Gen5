		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『フッ……　遅い……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-25T10:31:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
