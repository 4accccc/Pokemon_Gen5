	<TextRow
		Label="pw_event2_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『いや　ダメだね……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
