			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『くっ！</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-10T17:40:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-10T17:40:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『くっ！</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-10T17:40:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
