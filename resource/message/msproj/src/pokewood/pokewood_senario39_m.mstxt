	<TextRow
		Label="pw_event1_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『なにを　いっている？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-11T07:59:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
