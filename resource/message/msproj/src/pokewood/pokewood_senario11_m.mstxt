	<TextRow
		Label="pw_event0_enemy_5"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『まもなく　マザーシップが
このほしに　おりてくる……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『間もなく　マザーシップが
この星に　降りてくる……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
