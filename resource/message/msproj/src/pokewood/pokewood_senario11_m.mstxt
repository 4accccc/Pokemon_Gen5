		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ち……ちがう！！
オレは　そんな！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:08:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
