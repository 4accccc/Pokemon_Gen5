	<TextRow
		Label="pw_event0_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>E『おろかなる　にんげんよ……
ごくろう　だったな……</Text>
			<TextModifiedBy
				User="mori:W00269"
