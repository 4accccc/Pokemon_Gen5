				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとこ『へへへ……
からだが　しほんの　さぎょういんを▽
なめてもらっちゃ　こまるべ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>男『へへへ……
体が　資本の　作業員を▽
なめてもらっちゃ　困るべ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……しつれい　ですが
きかせて　ください……▼
そもそも　あの　Ｍ・Ｂは
あなたのポケモン　なんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『……失礼ですが
聞かせて　ください……▼
そもそも　あの　Ｍ・Ｂは
あなたのポケモン　なんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとこ『オイオイ　ちがうよ！
んな　バケモン　オラんじゃねえよ！▼
ありゃよ　ボールがよ　このハーバーの
すみっこに　おちてたんだ！▼
……んだから　つい　ひろって
ちょこっと　なげてみたらよ！▽
あんな　バケモンが　でてきたんだ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>男『オイオイ　違うよ！
んな　バケモン　オラんじゃねえよ！▼
ありゃよ　ボールがよ　ハーバーの
すみっこに　落ちてたんだ！▼
……んだから　つい　拾って
ちょこっと　投げてみたらよ！▽
あんな　バケモンが　出てきたんだ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『なるほど……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『なるほど……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとこ『でも　ちょっと　ヘンなのは
それ　ひろった　ばしょ　はよ▽
あのハーバーの　なかでも▽
かんけいしゃ　せんように　なってる▽
つうろ　なんだよなあ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おとこ『でも　ちょっと　ヘンなのは
それ　ひろった場所　はよ▽
あのハーバーの　中でも▽
関係者専用に　なってる▽
通路なんだよなあ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event6_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『わかりました……
ありがとうございます……▼
（Ｍ・Ｂ……▼
あれは　ポケモンでは　ない……
はかいの　ための　へいきだ……▼
だれが　あんな
きけんな　ものを　つくったんだ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『分かりました……
ありがとうございます……▼
（Ｍ・Ｂ……▼
あれは　ポケモンでは　ない……
破壊のための　兵器だ……▼
だれが　あんな
危険な物を　造ったんだ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
