				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_turn_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょういん『おいそぎ　ください
まもなく　しゅっこう　いたします</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
