	<TextRow
		Label="pw_event0_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『そんなっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
