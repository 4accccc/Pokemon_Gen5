	<TextRow
		Label="pw_event1_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モニカ『なんで　こんな……
なんで　わたしが　こんなことに！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-03T07:19:32" />
