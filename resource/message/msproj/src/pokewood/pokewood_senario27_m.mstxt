		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ちょっと！！
いったい　どういうことだ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:17" />
			<Status>Editing</Status>
