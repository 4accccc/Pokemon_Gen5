				Time="2011-10-29T08:20:36" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event3_hero_5">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『グアイさん！
ちょっと　まってください！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T06:59:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T06:59:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『グアイさん！
ちょっと　待ってださい！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T06:59:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T06:59:53" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event3_hero_6">
		<LanguageCell
			Language="JPN">
			<Text>……ボールから　とびだす　モニカ▼
そのからだは　ビルよりも
きょだいに　なっていた……▼
グアイが　いうには
どうにか　あばれる　かのじょを
とめることは　できたけど▽
おおきな　からだは　そのまんま▼
ああ……　ボクは　いったい
どうすれば　いいんだよ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T06:59:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T06:59:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……ボールから　飛び出す　モニカ▼
その身体は　どういうわけだか
ビルよりも　巨大に　なっていた▼
どうにか　暴れる　彼女を
止めることは　できたけど▽
大きな　身体は　そのまんま▼
ああ……　ボクは　いったい
どうすれば　いいんだよ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T06:59:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T06:59:53" />
		</LanguageCell>
	</TextRow>
