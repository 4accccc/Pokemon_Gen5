				Time="2011-10-27T05:44:06" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_turn_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>あせるしみん『オイ！！　いそげっ！！
はやく　にげないと　ふみつぶされるぞ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T06:03:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T06:03:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あせる市民『オイ！！　急げっ！！
早く　逃げないと　ふみつぶされるぞ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T06:03:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-27T06:03:54" />
		</LanguageCell>
	</TextRow>
