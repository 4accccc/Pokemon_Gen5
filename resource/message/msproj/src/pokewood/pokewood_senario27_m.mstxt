	<TextRow
		Label="pw_event0_react_enemy_0">
		<LanguageCell
			Language="JPN">
			<Text>グアイ『なんだって　いいんだ！
こえでも　かけて　あんしんさせろ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:36" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グアイ『なんだって　いいんだ！
声でも　かけて　安心させろ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:36" />
