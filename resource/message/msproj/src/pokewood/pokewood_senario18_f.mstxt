	<TextRow
		Label="pw_event7_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『…………！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
