	</TextRow>
	<TextRow
		Label="pw_event2_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『ば……　ばくはつ！？</Text>
			<TextModifiedBy
				User="mori:W00269"
