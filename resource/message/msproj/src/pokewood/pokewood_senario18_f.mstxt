			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]博士『レディアン
きみの　わたしへの　信頼▽
ムダには　しないわ！▼
任せてちょうだい！</Text>
