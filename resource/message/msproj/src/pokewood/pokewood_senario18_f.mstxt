	<TextRow
		Label="pw_event4_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]はかせ『かならず
れきしを　かえてやるわ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
