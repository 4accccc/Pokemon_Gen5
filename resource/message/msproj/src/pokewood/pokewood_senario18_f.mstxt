				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『りかい　できない▼
ニンゲンは　むしポケモンに
りようされて　はじめて▽
いみのある　いきもの▼
ひとりでは　なにもできない</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『理解　できない▼
ニンゲンは　むしポケモンに
利用されて　はじめて▽
意味のある　生き物▼
ひとりでは　何もできない</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T12:10:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]はかせ『たしかに
ひとりでは　なにも　できない▽
だからこそ　たすけあう▼
じょしゅの　ストレンジや
[Name:PokemonNickname Idx="0" ]……▽
それに　カラテオーさん　だって！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T13:03:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T13:03:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]博士『確かに
ひとりでは　何も　できない▽
だからこそ　助け合う▼
助手の　ストレンジや
[Name:PokemonNickname Idx="0" ]……▽
それに　カラテオーさん　だって！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T13:03:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-27T13:03:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
