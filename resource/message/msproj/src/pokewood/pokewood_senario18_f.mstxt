	<TextRow
		Label="pw_turn_enemy_5"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レディアン『いそげ！
てんそうきの　げんかいが　ちかい！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レディアン『急げ！
時間転送機の　限界が　近い！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
