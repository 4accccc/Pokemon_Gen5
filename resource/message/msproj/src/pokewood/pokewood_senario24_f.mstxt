		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『もしかして……
かえれない……の？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T10:23:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T10:23:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]姫『もしかして……
帰れない……の？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-06T10:23:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
