				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『ふざけないで！
わたしのほうが　かわいいに▽
きまってる　でしょ！？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『ふざけないで！
私のほうが　可愛いに▽
決まってる　でしょ！？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬいぐるみ『おい　[Name:TrainerName Idx="1" ]！
とびらは　ふたつ　あるぜ！▽
そして　キミが　とおって　きたのは▽
しろいほうの　とびらだよな▼
[Name:TrainerName Idx="1" ]ひめ『つまり……？▼
ぬいぐるみ『しろいほうの　とびらは
たおすのは　まったほうが　いい▽
まず　くろいほうだけ　たおすんだ▼
[Name:TrainerName Idx="1" ]ひめ『なるほど！
かえるための　とびらは▽
のこして　おくのね？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬいぐるみ『おい　[Name:TrainerName Idx="1" ]！
扉は　ふたつ　あるぜ！▽
キミが　通ってきたのは▽
白いほうの　扉だよな▼
[Name:TrainerName Idx="1" ]姫『つまり……？▼
ぬいぐるみ『白いほうの　扉を
倒すのは　待ったほうがいい▽
まず　黒い扉だけ　倒すんだ▼
[Name:TrainerName Idx="1" ]姫『なるほど！
帰るための　扉は▽
残して　おくのね？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『あら……
なにを　ひとりで　ゴチャゴチャと▽
しゃべって　いるのかしら？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『あら……
何を　一人で　ゴチャゴチャと▽
しゃべっているのかしら？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
			<Status>Editing</Status>
