				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろいとびら『ガチャアアーン……！▼
[Name:TrainerName Idx="1" ]ひめ『し……
しろいとびらを　こわした！　けど……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白い扉『ガチャアアーン……！▼
[Name:TrainerName Idx="1" ]姫『し……
白い扉を　壊した！　けど……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
