				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もんばん『おい……
くだらねえなあ……</Text>
