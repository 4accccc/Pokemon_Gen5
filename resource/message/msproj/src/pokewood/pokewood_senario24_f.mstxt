	<TextRow
		Label="pw_event3_react_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『それは　すごい！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
