				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『おほほ……
ひとりごとは　よくないわよ？▽
さびしい　にんげんの　しょうこ　だもの</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:52" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『おほほ……
独り言は　良くないわよ？▽
寂しい　人間の　証拠だもの</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:52" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『あーっ！　もーっ！！
あらためて　いっておくわ！▼
ぜったい　わたしの　ほうが
カワイイに　きまってるんだからね！▼
だって　わたしは　おひめさま　よ！
あなたとは　うまれも　そだちも▽
ちがう　うまれつきの　エリートよ！▼
そもそも　あなた　いったい　いくつよ！
かわいいなんて　とし　じゃないでしょ！▼
かわいいとか　じょし　って　よべるのは
わたしみたいな　じゅうだい　だけよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:30:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:30:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]姫『あーっ！　もーっ！！
あらためて　言っておくわ！▼
絶対　私の　ほうが
カワイイに　決まってるんだからね！▼
だって　私は　お姫様　よ！
あなたとは　生まれも　育ちも▽
違う　生粋の　エリートよ！▼
そもそも　あなた　一体　幾つよ！
カワイイなんて　年じゃないでしょ！▼
カワイイとか　女子って　呼べるのは
私みたいな　十代だけなんですー！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:30:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T05:30:48" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュジュベ『ムキーッ！！
あんた　いいかげんに　しなさいよ！！▼
スネかじりの　バカひめ　より
がんばって　なりあがってきた▽
まほうクイーンの　わたしのほうが▽
けなげで　カワイイに　きまってるわ！▼
しかも　なに？　わかさが　ウリ？
わらわせるんじゃないわよ！！▽
あんたも　じきに　オバサンよ！▼
ダラダラいきてる　あんたが
わたしと　おなじ　とし　になったら▽
ずうずうしくて　あつかましいだけの▽
ただのオバサンにしか　なれないわ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:52" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュジュベ『ムキーッ！！
あんた　いい加減に　しなさいよ！！▼
スネかじりの　バカ姫　より
頑張って　成り上がってきた▽
まほうクイーンの　私のほうが▽
けなげで　カワイイに　決まってるわ！▼
しかも　何？　若さが　ウリ？
笑わせるんじゃないわよ！！▽
あんたも　あっという間に　オバサンよ！▼
ダラダラ生きてる　あんたが
私と　同じ歳に　なったら▽
ずうずうしくて　厚かましいだけの▽
ただのオバサンにしか　なれないわ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:52" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event2_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]ひめ『なんですってー！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-24T03:08:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
