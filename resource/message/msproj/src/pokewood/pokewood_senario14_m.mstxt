	<TextRow
		Label="pw_event1_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『グロロロ……▼
さあ　[Name:TrainerName Idx="1" ]……
ちからを　しめすのだ……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
