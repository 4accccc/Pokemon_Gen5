				Time="2011-10-14T09:40:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『グロロロ……
それを　しりたくば……▽
ワシのバンギラスが　はなつ▽
いちげきを　こらえてみせよ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T10:56:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T10:56:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>？？？『グロロロ……
それを　知りたくば……▽
ワシのバンギラスが　放つ▽
一撃を　こらえてみせよ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-26T04:26:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
