		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『オレが……　なぜ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T06:45:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
