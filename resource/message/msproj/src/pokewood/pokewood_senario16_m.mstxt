	<TextRow
		Label="pw_event5_enemy_5"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ストレンジ『[Name:TrainerName Idx="1" ]　はかせ……▼
なんて……　ことだ……</Text>
			<TextModifiedBy
				User="mori:W00269"
