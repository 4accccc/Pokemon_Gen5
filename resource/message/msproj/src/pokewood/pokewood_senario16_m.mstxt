	<TextRow
		Label="pw_event6_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ストレンジ『ちょっと　はかせ！
はかせ……！　は……か……▼
……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ストレンジ『ちょっと　博士！
博士……！　は……か……▼
……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
