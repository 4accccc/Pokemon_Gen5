	<TextRow
		Label="pw_briefing_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]よるの　とばりが　おりる　まちかど
[Ctrl1:xcenter ]ビルを　はしる　あやしい　かげ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T05:11:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]夜の　とばりが　おりる　街角
[Ctrl1:xcenter ]ビルを　はしる　怪しい　影</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-19T05:11:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あらすじ♂</Comment>
			<CommentModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_002">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]あくと　せいぎ……
[Ctrl1:xcenter ]ひかりと　かげ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T07:18:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T07:18:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]悪と　正義……
[Ctrl1:xcenter ]光と　影……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-23T08:46:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T07:18:10" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]あいいれぬ　ふたり……
[Ctrl1:xcenter ]その　けっちゃくが　いま……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T07:18:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:52:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]相容れぬ　ふたり……
[Ctrl1:xcenter ]その　決着が　今……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-22T07:18:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:55:16" />
		</LanguageCell>
	</TextRow>
