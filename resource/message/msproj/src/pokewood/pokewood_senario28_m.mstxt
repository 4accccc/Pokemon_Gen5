	<TextRow
		Label="pw_event8_enemy_4">
		<LanguageCell
			Language="JPN">
			<Text>モニカ『きょねんの　なつに
いっしょに　ここに　きたよね？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T12:08:21" />
