	<TextRow
		Label="pw_event5_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『モニカ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
