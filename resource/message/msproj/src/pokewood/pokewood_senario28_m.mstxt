	<TextRow
		Label="pw_event5_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>モニカ『[Name:TrainerName Idx="1" ]……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
