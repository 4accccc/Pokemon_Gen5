	<TextRow
		Label="pw_event1_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『こころの　ちから？
モニカを　こうげき　するんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:02" />
			<Status>Editing</Status>
