				Time="2011-10-20T06:30:02" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_enemy_0">
		<LanguageCell
			Language="JPN">
			<Text>モニカ『ちょっと！　ちょっと！
かんたんに　あきらめないでよ！▼
あんた　わたしのこいびと　でしょ！
ほうほうが　ないか　かんがえてよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モニカ『ちょっと！！ちょっと！！
簡単に　諦めないでよ！▼
あんた　私の恋人　でしょ！
方法が　ないか　考えてよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『なんとかするよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『なんとかするよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:02" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>モニカ『だったら　はやくなんとかしてっ！
こんな　はずかしい　すがたじゃ▽
わたし　いきてられないわっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モニカ『だったら　早くなんとかしてっ！
こんな　恥ずかしい　姿じゃ▽
私　生きてられないわっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『まずは　おちついて</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『まずは　落ち着いて</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_enemy_2">
		<LanguageCell
			Language="JPN">
			<Text>モニカ『しってるわよ……▼
でも　どうしたら　いいのか
わかんないんだもんっ！！▽
じぶんが　こわいんだもん！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モニカ『知ってるわよ……▼
でも　どうしたら　いいのか
分かんないんだもんっ！！▽
自分が　こわいんだもん！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_0">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『グアイさん……▼
いったい　どうすれば　モニカは
もとに　もどるんでしょう……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『グアイさん……▼
いったい　どうすれば　モニカは
元に　戻るんでしょう……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_0">
		<LanguageCell
			Language="JPN">
			<Text>グアイ『ボールに　かけられた
のろいを　とく　ほうほう　か……▼
そうだな……▼
のろいとは　つまるところ
こころの　ちから　だ……▼
だから　ボールの　のろいよりも
つよい　こころのちからを▽
かのじょに　しめすことが▽
できれば　きっと……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グアイ『ボールに　かけられた
呪いを　解く　方法か……▼
そうだな……▼
呪いとは　つまるところ
心の　力だ……▼
だから　ボールの　呪いよりも
強い　心の力を▽
彼女に　示すことが▽
できれば　きっと……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『こころの　ちから？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『心の　力？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:49" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>グアイ『そうだ……▼
たとえば　かのじょに　たいする
とても　つよい　きもち……▽
つよい　あいを　つたえられたら……▼
だが……▼
それは　[Name:TrainerName Idx="1" ]くん……
キミにしか　できないことだな……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グアイ『そうだ……▼
例えば　彼女に　対する
とても　強い　気持ち……▽
強い　愛を　伝えられたら……▼
だが……▼
それは　[Name:TrainerName Idx="1" ]くん……
キミにしか　できないことだな……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:42" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……　……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
