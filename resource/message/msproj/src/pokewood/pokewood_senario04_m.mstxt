				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]ニンジャ『あぶねえっ！
いきなり　なに　すんだよ！？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-11T03:35:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-11T03:35:55" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:PokemonNickname Idx="0" ]ニンジャ『危ねえっ！
いきなり　何　すんだよ！？</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-11T03:35:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-11T03:35:55" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『はんざいは　ゆるさない
じつりょく　こうしで　せいあつする！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メカポリス『犯罪は　許さない
実力行使で　制圧する！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:30" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]ニンジャ『なんだよ！？
オレは　ポケモン　つかって▽
ぬすみを　してるってのに▼
オマエだけ　そんな　ぶき　つかって
ズルい　じゃねえかよ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T13:04:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T13:04:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:PokemonNickname Idx="0" ]ニンジャ『何だよ！？
オレは　ポケモン　使って▽
盗みを　してるってのに▼
オマエだけ　そんな　武器　使って
ズルい　じゃねえかよ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T13:04:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T13:04:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_2">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『フム……　なるほど
あくにんに　ケチを　つけられては▽
わたしの　せいぎに　きずが　つく▼
ここは　ポケモンを　つかい
ヤツを　たいほ　すべきだな</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T13:04:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T13:04:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メカポリス『フム……　なるほど
悪人に　ケチを　つけられては▽
私の　正義に　傷が　付く▼
ここは　ポケモンを　使い
ヤツを　逮捕　すべきだな</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T13:04:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T13:04:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]ニンジャ『こ……　こんな
らんぼうな　けいじに……</Text>
			<TextModifiedBy
