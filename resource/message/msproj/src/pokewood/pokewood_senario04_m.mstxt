	<TextRow
		Label="pw_event7_enemy_2">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『おのれ！
ゆるさんぞ　[Name:PokemonNickname Idx="0" ]ニン……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
