<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="pw_briefing_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]えがおの　たえない　ゆうえんち
[Ctrl1:xcenter ]みんなの　りそうの　ゆうえんち

[Ctrl1:xcenter ]だが　そんな　ばしょに　
[Ctrl1:xcenter ]あやしい　かげが　ひとつ……
[Ctrl1:xcenter ]そう　それは　じけんの　まくあけ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-17T04:13:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]笑顔の　たえない　遊園地
[Ctrl1:xcenter ]みんなの　理想の　遊園地

[Ctrl1:xcenter ]だが　そんな　場所に　
[Ctrl1:xcenter ]怪しい　影が　ひとつ……
[Ctrl1:xcenter ]そう　それは　事件の　幕開け……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-17T04:14:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あらすじ♂</Comment>
			<CommentModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:59:18" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]だが　しかし！！

[Ctrl1:xcenter ]かげあるところに　ひかりあり！

[Ctrl1:xcenter ]あのヒーローが　あらわれた！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-17T04:13:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:31:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]だが　しかし！！

[Ctrl1:xcenter ]影あるところに　光あり！

[Ctrl1:xcenter ]あのヒーローが　現れた！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-09-17T04:15:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:32:26" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]そう！　ヒーローの　なは！

[Ctrl1:xcenter ][Name:PokemonNickname ]キッド！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-02-07T03:43:46" />
			<Status>Editing</Status>
