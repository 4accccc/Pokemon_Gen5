				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしん『……まもなく
デコイＵＦＯと　ともに▽
そちらに　とうちゃくする……▼
ただ……
よそういじょうに　にげおくれた▽
しみんのかずが　おおい……▼
このまま　そちらに　むかって
マザーシップが　あらわれると▽
かれらに　きけんが　およぶだろう……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T10:24:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T10:24:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>通信『……間もなく
デコイＵＦＯと　ともに▽
そちらに　到着する……▼
ただ……
予想以上に　逃げ遅れた▽
市民の数が　多い……▼
このまま　そちらに　向かって
マザーシップが　現れれば▽
彼らに　危険が　及ぶだろう……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T10:24:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T10:24:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_5"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『そんなっ！
どうにか　ならないんですか？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『そんなっ！
どうにか　ならないんですか？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_6"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしん『しらん……▼
わたしは　わたしの　さくせんを
かくじつに　じっこうする……▼
もくてきのため　ならば　たしょうの
ぎせいは　うけいれるしかない……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T10:24:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T10:24:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>通信『知らん……▼
私は　私の　作戦を
確実に　実行する……▼
目的のため　ならば　多少の
ぎせいは　受け入れるしかない……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T10:24:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T10:24:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_react_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『そうなのか……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
