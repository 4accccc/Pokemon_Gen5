	<TextRow
		Label="pw_event4_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『Ｅ　か……▼
す……　すまない……
オレは……　もう　うごけない……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-25T07:12:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
