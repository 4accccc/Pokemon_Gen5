	<TextRow
		Label="pw_event1_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にげまどうしみん『はやく　にげろ！！
ＵＦＯに　つかまったら　おわりだぞ！</Text>
