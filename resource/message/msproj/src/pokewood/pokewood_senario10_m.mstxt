	<TextRow
		Label="pw_event4_hero_5"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『Ｅは　どうするんだ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-25T07:12:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
