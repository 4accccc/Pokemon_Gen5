				Time="2011-11-10T11:47:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_2">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『[Name:PokemonNickname Idx="0" ]クノイチ……！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メカポリス『[Name:PokemonNickname Idx="0" ]クノイチ……！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>じしょう　せいきの　おおどろぼう
[Name:PokemonNickname Idx="0" ]クノイチは▽
ふてきな　すてぜりふと　ともに▽
よるの　とばりに　きえた</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自称　世紀の　大泥棒
[Name:PokemonNickname Idx="0" ]クノイチは▽
不敵な　捨て台詞と　ともに▽
夜の　とばりに　消えた</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>そして　すうねんご……▼
ダイナミックエンジンを　あくようし
おおがねもちに　なった▽
[Name:PokemonNickname Idx="0" ]クノイチは▽
こくさいコップさえ　てが　だせない▽
かげの　おおものと　なった……▼
くやしかろう　メカポリス！
おかねの　ちからは　おそろしい！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T07:21:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T07:21:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そして　数年後……▼
ダイナミックエンジンを　悪用し
大金持ちに　なった▽
[Name:PokemonNickname Idx="0" ]クノイチは▽
国際コップさえ　手が出せない▽
影の　大物と　なった……▼
悔しかろう　メカポリス！
お金の　力は　恐ろしい！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T07:21:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-22T07:21:18" />
		</LanguageCell>
	</TextRow>
