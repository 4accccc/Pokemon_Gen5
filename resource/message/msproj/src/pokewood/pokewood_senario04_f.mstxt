	<TextRow
		Label="pw_event7_enemy_2">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『おのれ！
ゆるさんぞ　[Name:PokemonNickname Idx="0" ]クノ……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T13:14:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
