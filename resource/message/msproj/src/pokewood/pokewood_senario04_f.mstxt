				Time="2011-10-21T05:37:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]クノイチ『メカポリス！
アタシを　にがしたことを▽
いっしょう　こうかい　しなさい！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T11:47:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T11:47:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:PokemonNickname Idx="0" ]クノイチ『メカポリス！
アタシを　逃がしたことを▽
一生　後悔　しなさい！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T11:47:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
