				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]クノイチ『クソッ！
こんな　クズてつ　けいじに……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-11T03:35:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-11T03:35:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:PokemonNickname Idx="0" ]クノイチ『クソッ！
こんな　クズ鉄　刑事に……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-11T03:35:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-11T03:35:53" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>じしょう　せいきの　おおどろぼう
[Name:PokemonNickname Idx="0" ]クノイチは▽
メカポリスの　てにより▽
ぶじ　けいむしょへ　ぶちこまれた▼
このよに　せいぎが　あるかぎり
けっして　あくは　さかえない！▼
せいあつせよ　メカポリス！
なさけは　むよう　こくさいコップ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T12:53:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T12:53:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自称　世紀の　大泥棒
[Name:PokemonNickname Idx="0" ]クノイチは▽
メカポリスの　手により▽
無事　刑務所へ　ぶちこまれた▼
この世に　正義が　あるかぎり
決して　悪は　栄えない！▼
制圧せよ　メカポリス！
情けは　無用　国際コップ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T12:53:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T12:53:49" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_0">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『ウッ！
わたしと　したことが……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メカポリス『ウッ！
私と　したことが……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]クノイチ『フン！
ひみつけいじだか▽
なんだか　しらないけど▽
どうってこと　ないね！▼
この　ダイナミックエンジンは
アタシのもの！　じゃあねぇ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T11:47:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T11:47:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:PokemonNickname Idx="0" ]クノイチ『フン！
秘密刑事だか▽
なんだか　知らないけど▽
どうってこと　ないね！▼
この　ダイナミックエンジンは
アタシのもの！　じゃあねぇ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T11:47:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T11:47:51" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『ストップ！　まてっ！
[Name:PokemonNickname Idx="0" ]クノイチ！▼
クッ！　レーダーを
ごさどうさせる　スモークか！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メカポリス『ストップ！　待てっ！
[Name:PokemonNickname Idx="0" ]クノイチ！▼
クッ！　レーダーを
誤作動させる　スモークか！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:37:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
