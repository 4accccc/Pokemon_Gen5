	<TextRow
		Label="pw_event4_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『そんなっ！！
ちょっと　まって！　おねえちゃん！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『そんなっ！！
ちょっと　まって！　おねえちゃん！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
