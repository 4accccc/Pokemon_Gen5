		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょしゅ『はかせっ！！
[Name:TrainerName Idx="1" ]はかせーっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:56:06" />
