		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ウ……　ウウッ……▼
ウワァーーーーッ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:56:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
