	<TextRow
		Label="pw_event3_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょしゅ『ダメですっ！！
ちかづいては　きけんですっ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
