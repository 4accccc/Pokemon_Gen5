				Time="2011-08-02T10:36:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]ある　むら　からの　

[Ctrl1:xcenter ]ゆうれいに　かんする

[Ctrl1:xcenter ]ちょうさ　いらい</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:58:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:52:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]ある村　からの　

[Ctrl1:xcenter ]幽霊に　関わる

[Ctrl1:xcenter ]調査依頼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:58:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:55:16" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_004"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]ここ　すうじつ　ゆうれいを

[Ctrl1:xcenter ]もくげき　した　ひとが

[Ctrl1:xcenter ]たすう　いると　いう</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:58:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:00:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]ここ　数日　幽霊の

[Ctrl1:xcenter ]目撃した　人が

[Ctrl1:xcenter ]多数いる　という</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:58:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:04" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_005"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]むらびとの　なかには

[Ctrl1:xcenter ]ゆうれいに とりつかれた

[Ctrl1:xcenter ]ものも　いると　いう
</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:58:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]村人の　中には

[Ctrl1:xcenter ]幽霊に 取りつかれた

[Ctrl1:xcenter ]者も　いる　という</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:58:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:12" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_006"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]これより　ゆうれいが

[Ctrl1:xcenter ]たすう　もくげき　されている

[Ctrl1:xcenter ]ぼちの　ちょうさを

[Ctrl1:xcenter ]かいし　する</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:58:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]これより　幽霊が

[Ctrl1:xcenter ]多数　目撃されている

[Ctrl1:xcenter ]墓地の　調査を

[Ctrl1:xcenter ]開始する</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-29T09:58:49" />
