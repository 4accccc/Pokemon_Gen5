				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『さっさと　はじめるぞ……▼
ただしい　データが　とれるまで
ぜったいに　かえさんからな……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『さっさと　始めるぞ……▼
正確な　データが　取れるまで
絶対　帰さんからな……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……こうして　[Name:TrainerName Idx="1" ]は
ポケモンに　かわって▽
ＵＦＯの　テストを　はじめた……▼
しかし　しょせん　[Name:TrainerName Idx="1" ]は
なまみの　にんげん　である……▼
Ｅの　のぞむ　テストの　けっかは
なかなか　えられなかった……▼
……ふたりが　なんども　テストを
くりかえしている　うちに▽
たいりょうの　ＵＦＯが　しゅうらい▽
じんるいは　めつぼうしていた……　</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……こうして　[Name:TrainerName Idx="1" ]は
ポケモンに　代わって▽
ＵＦＯの　テストを　始めた……▼
しかし　しょせん　[Name:TrainerName Idx="1" ]は
生身の　人間　である……▼
Ｅの　望む　テストの　結果は
なかなか　得られなかった……▼
……ふたりが　何度も　テストを
繰り返している　うちに▽
大量の　ＵＦＯが　襲来▽
人類は　滅亡していた……　</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
