	<TextRow
		Label="pw_event4_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『まってください……▼
もう　オレには　たたかえる
ポケモンも　いませんよ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
