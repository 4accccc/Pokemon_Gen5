	<TextRow
		Label="pw_event1_react_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『なにを　グズグズしている？
はやく　いわれた　とおりに　しろ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『何を　グズグズしている？
早く　言われた　通りに　しろ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
