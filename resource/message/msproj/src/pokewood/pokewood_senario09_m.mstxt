				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_turn_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『よし……
そろそろ　テスト　しゅうりょうだ……▼
でんじほうで　ＵＦＯを　とめろ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『よし……
そろそろ　テスト　終了だ……▼
でんじほうで　ＵＦＯを　停めろ！</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……なんで
あなたが　ＵＦＯを……？▼
しかも　こんな　ばしょで
いったい　なにを　はじめるんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『……何で
あなたが　ＵＦＯを……？▼
しかも　こんな場所で
一体　何を　始めるんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『……いまから　わたしが
かいはつした　デコイＵＦＯの▽
のうりょくを　テストする……▼
じゅんびは　いいな？　[Name:TrainerName Idx="1" ]？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『……今から　私が
開発した　デコイＵＦＯの▽
能力テストを　開始する……▼
準備は　いいな？　[Name:TrainerName Idx="1" ]？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『え……？▼
テストって……？
デコイＵＦＯって……？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『え……？▼
テストって？
デコイＵＦＯ　って……？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『しつもんは　あとに　しろ……▼
おまえは　わたしの　しじに
したがって　いればいい……▼
ポケモンは　もっているな？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『質問は　後に　しろ……▼
お前は　私が　指示に
従っていればいい……▼
ポケモンは　持っているな？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『え……？
ＵＦＯと　たたかうんですか？</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『え……？
ＵＦＯと　戦うんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:58" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『そのとおり……
ＵＦＯは　プログラムに　よって▽
おまえたちを　こうげき　しつづける</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『その通り……
ＵＦＯは　プログラムに　よって▽
お前たちを　攻撃　し続ける</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『そんな……
きけんは　ないんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『そんな……
危険は　ないんですか？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T09:25:58" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｅ『あるに　きまっているだろう
それも　テストの　うちだ……▼
ああ……
それと　ちゅういが　ひとつ……▼
このＵＦＯは　まだ　ボディぶぶんの
コーティングが　ふかんぜんだ……▼
でんじほう　いがいの　ダメージを
うけると　こわれて　しまうからな▽
くれぐれも　ちゅういしろよ……　</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｅ『あるに　決まっているだろう
それも　テストの　うちだ……▼
ああ……
それと　注意が　ひとつ……▼
このＵＦＯは　まだ　ボディ面の
コーティングが　不完全だ……▼
でんじほう　以外の　ダメージを
受けると　壊れてしまうからな▽
くれぐれも　注意しろよ……　</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-30T08:50:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……はあ</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『……はあ</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
