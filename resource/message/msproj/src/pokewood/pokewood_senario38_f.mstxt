			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-10T09:12:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こえ『つよき者のみ
