	<TextRow
		Label="pw_event7_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こえ『みごと……
おぬしの　ような　つわものを▽
まっていた……</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T17:38:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
