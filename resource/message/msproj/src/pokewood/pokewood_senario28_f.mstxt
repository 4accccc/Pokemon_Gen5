	</TextRow>
	<TextRow
		Label="pw_event6_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『おねえちゃん……
ちょっと……　どこ　いくのよ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
