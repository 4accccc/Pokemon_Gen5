	<TextRow
		Label="pw_event8_hero_5">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『いつのこと……？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
