	<TextRow
		Label="pw_event4_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『いいから　おねえちゃん！▼
アタシの……▼
アタシの　はなしを　きいてよっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-03T07:55:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
