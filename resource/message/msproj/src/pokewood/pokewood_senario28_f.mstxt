		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『おこらないでよ……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
