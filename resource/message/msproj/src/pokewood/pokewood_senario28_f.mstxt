				Time="2011-12-26T13:04:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_enemy_0">
		<LanguageCell
			Language="JPN">
			<Text>モニカ『ちょっと！　ちょっと！
サラッと　あきらめないでよ！▼
あんた　わたしの　かぞく　でしょ！
ほうほうが　ないか　かんがえて！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T12:08:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T12:08:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モニカ『ちょっと！！ちょっと！！
簡単に　あきらめないでよ！▼
あんた　私の家族　でしょ！
方法が　ないか　考えて！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T12:08:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-28T12:08:20" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『なんとかするよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-20T06:30:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『何とかするよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T07:54:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T07:54:32" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>モニカ『おねがい　はやく　してっ！！
こんな　はずかしい　すがたじゃ▽
わたし　いきてられないよっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-26T13:17:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-26T13:17:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モニカ『お願い　早く　してっ！！
こんな　恥ずかしい　姿じゃ▽
私　生きてられないよっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-26T13:17:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-26T13:17:13" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『まずは　おちついて！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:52" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『まずは　落ち着いて！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:09:52" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_react_enemy_2">
		<LanguageCell
			Language="JPN">
			<Text>モニカ『わかってるわよ！▼
でも　ふあんで　しかたないのよ！
じぶんが　こわいのよ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-30T13:18:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-30T13:18:47" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モニカ『分かってるわよ！▼
でも　不安で　仕方ないのよ！
自分が　怖いのよ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-30T13:18:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-30T13:18:47" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_0">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『グアイさん……▼
いったい　どうすれば
おねえちゃんは　もとに　もどるの……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『グアイさん……▼
いったい　どうすれば
お姉ちゃんは　元に　戻るの……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_0">
		<LanguageCell
			Language="JPN">
			<Text>グアイ『ボールに　かけられた
のろいを　とく　ほうほう　か……▼
そうだな……▼
のろいとは　つまるところ
こころの　ちから　だ……▼
だから　ボールの　もつ　のろいよりも
つよいこころの　ちからを　かのじょに▽
しめすことが　できれば　きっと……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-21T07:04:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2012-01-21T07:04:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グアイ『ボールに　かけられた
のろいを　解く　方法か……▼
そうだな……▼
のろいとは　詰まるところ
心の　力だ……▼
だから　ボールが　宿す　のろいよりも
強い心の　力を　彼女に▽
示すことが　できれば　きっと……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-26T13:17:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-26T13:17:13" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『こころの　ちから？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『心の　力？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-26T09:55:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>グアイ『そうだ……▼
たとえば　かのじょに　たいする
とても　つよい　きもち……▽
つよい　あいを　つたえられたら……▼
だが……▼
それは　[Name:TrainerName Idx="1" ]……
キミにしか　できないことかもな……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T09:06:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T09:06:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グアイ『そうだ……▼
例えば　彼女に　対する
とても　強い　気持ち……▽
強い　愛を　伝えられたら……▼
だが……▼
それは　[Name:TrainerName Idx="1" ]……
キミにしか　出来ないことかもな……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T09:06:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-27T09:06:54" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……　……</Text>
