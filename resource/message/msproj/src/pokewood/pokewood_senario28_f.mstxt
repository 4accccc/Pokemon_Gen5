	<TextRow
		Label="pw_event7_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……　……　……▼
グアイさん……▼
やっぱり　そのモンスターボールを
アタシに　ください……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
