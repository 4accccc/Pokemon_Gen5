		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『お姉ちゃん……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
