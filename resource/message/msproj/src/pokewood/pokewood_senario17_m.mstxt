	<TextRow
		Label="pw_event7_hero_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]はかせ『ああ……
やってしまった……！
にんげんを　たおして……
なんて　ことを……</Text>
			<TextModifiedBy
				User="mori:W00269"
