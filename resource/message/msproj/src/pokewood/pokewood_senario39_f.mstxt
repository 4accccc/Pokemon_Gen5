				Time="2012-01-06T12:43:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_react_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]『せかいを　まもって！</Text>
