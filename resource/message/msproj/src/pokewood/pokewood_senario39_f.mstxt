		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『反省　して！</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-14T09:13:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
