	<TextRow
		Label="pw_turn_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>アーカム『さてさて　いつまで
たえられるのかなー？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-20T08:56:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
