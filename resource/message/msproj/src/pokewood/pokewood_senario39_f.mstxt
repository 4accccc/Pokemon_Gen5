				Time="2011-11-20T09:15:18" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event4_react_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『わからない！</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-03T11:35:32" />
