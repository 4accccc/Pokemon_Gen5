	<TextRow
		Label="pw_event6_hero_3">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『それが　りゆうで
はかいを　くりかえすの……？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T12:25:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
