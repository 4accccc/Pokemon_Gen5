				Time="2011-11-20T09:15:18" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event5_react_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『せかいを　まもって！</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-14T09:13:39" />
