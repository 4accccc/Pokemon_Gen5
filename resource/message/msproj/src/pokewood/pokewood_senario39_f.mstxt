	<TextRow
		Label="pw_event5_react_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『せかいから　きえて！</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
