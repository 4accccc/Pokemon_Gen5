				Time="2011-11-16T10:10:56" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_4">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『アーカム……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:10:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:10:56" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『アーカム……</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:10:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:10:56" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event0_enemy_4">
		<LanguageCell
			Language="JPN">
			<Text>アーカム『どうだい？
はかいの　まじんは？▼
なかなか　れいぎ　ただしいでしょ？▼
それに　ひとなつっこくて　とっても
ゆかいなヤツ　なんだよー▼
キミは　まじんを　とめに　きたんだろ？
さてさて　かれを　とめられるかな？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-20T08:56:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-20T08:56:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アーカム『どうだい？
破壊の　魔神は？▼
なかなか　礼儀正しい　でしょ？▼
それに　人なつっこくて　とっても
ゆかいなヤツ　なんだよー▼
キミは　魔神を　止めに来たんだろ？
さてさて　彼を　止められるかな？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-20T08:56:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-20T08:56:58" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まじん『るるるーん♪　るるるーん♪▼
そなた　きに　いったで　ごじゃる
そなたなら　オイラの　ハートが▽
わかりそうで　ごじゃる♪</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T12:25:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T12:25:56" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>魔神『るるるーん♪　るるるーん♪▼
そなた　気に　入ったで　ごじゃる
そなたなら　オイラの　ハートが▽
分かりそうで　ごじゃる♪</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T12:25:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T12:25:56" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『なにを　いっているの？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-14T16:40:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-14T16:40:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『何を　言っているの？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-14T18:39:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-14T18:39:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>まじん『オイラの　クエスチョンに
こたえるので　ごじゃる♪▼
こたえを　まちがっても　だいじょうぶ！
ブチこわすだけで　ごじゃるよぉぉぉ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:10:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:10:56" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>魔神『オイラの　クエスチョンに
答えるので　ごじゃる♪▼
答を　間違っても　大丈夫！
ブチ壊すだけで　ごじゃるよぉぉぉ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-20T08:09:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-20T08:09:18" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_event1_hero_2">
		<LanguageCell
			Language="JPN">
			<Text>あせる　ひとびと『みんな！　みろっ！
あのバケモンが　まちを　こわすんだ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T13:09:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T13:09:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あせる　人々『みんな！　見ろっ！
あのバケモンが　街を　壊すんだ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T13:09:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
