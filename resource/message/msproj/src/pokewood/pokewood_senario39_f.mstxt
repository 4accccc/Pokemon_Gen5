	<TextRow
		Label="pw_event0_enemy_3">
		<LanguageCell
			Language="JPN">
			<Text>アーカム『ククククッ
おひさしぶり　だね！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-11-16T10:10:56" />
