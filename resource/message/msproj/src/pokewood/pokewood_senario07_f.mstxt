	<TextRow
		Label="pw_event1_hero_1">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]クノイチ『フン！
こんなに　たのしい　しょうぶ▽
ひさしぶりねぇ……！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T11:48:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
