	<TextRow
		Label="pw_event7_enemy_3">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『[Name:PokemonNickname Idx="0" ]クノイチ
まてー！　またんかー！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
