		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]クノイチ『メカポリス！
みそこなったよ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-10T11:48:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
