	<TextRow
		Label="pw_event3_hero_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『グアイさん！
いったい　どうしたら　いいんですか！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:36" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『グアイさん！
いったい　どうしたら　いいんですか！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-29T08:20:36" />
