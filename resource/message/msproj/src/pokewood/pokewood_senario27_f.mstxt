				Time="2011-10-14T09:40:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event0_hero_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『あのボールが
かってに　ひらいたんだもん！▽
アタシ　なにも　してないっ！！▼
それより　はやく　おねえちゃんを
ボールのなかに　しまってよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『あのボールが
勝手に　開いたんだもん！▽
アタシ　何も　してないっ！！▼
それより　早く　お姉ちゃんを
ボールの中に　閉まってよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-10-19T05:28:16" />
		</LanguageCell>
		<AttributeCell
