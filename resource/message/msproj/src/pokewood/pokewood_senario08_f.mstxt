				Time="2011-10-14T09:40:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_event4_hero_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしん『[Name:TrainerName Idx="1" ]……
ざんねんだが……▼
……　それは　できない……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>通信『[Name:TrainerName Idx="1" ]……
残念だが……▼
……　それは　できない……</Text>
			<TextModifiedBy
				User="mori:W00269"
				Time="2011-10-14T09:40:17" />
