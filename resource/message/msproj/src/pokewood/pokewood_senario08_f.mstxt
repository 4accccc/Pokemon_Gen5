	<TextRow
		Label="pw_event4_hero_0"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『くっ！　ここまでね！▼
こうなったら　ほんぶに
きゅえんを　たのむしか……</Text>
			<TextModifiedBy
				User="mori:W00269"
