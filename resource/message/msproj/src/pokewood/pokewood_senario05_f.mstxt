	<TextRow
		Label="pw_event0_enemy_1">
		<LanguageCell
			Language="JPN">
			<Text>メカポリス『どういう　ことだ！？
[Name:PokemonNickname Idx="0" ]クノイチ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-21T05:47:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
