	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="pw_briefing_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]まほうのくにの　じょおう
[Ctrl1:xcenter ]ジュジュベが　つくりだした
[Ctrl1:xcenter ]ふしぎな　とびらを　とおって
[Ctrl1:xcenter ]あやしいくにに　まよいこんだ
[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]おうじ</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-06T10:10:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]魔法の国の　女王
[Ctrl1:xcenter ]ジュジュベが　作りだした
[Ctrl1:xcenter ]不思議な　扉を　通って
[Ctrl1:xcenter ]怪しい国に　迷い込んだ
[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]王子</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-06T10:10:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あらすじ♂</Comment>
			<CommentModifiedBy
				User="mori:W00269"
				Time="2011-08-02T11:01:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]ジュジュベが　あやつる
[Ctrl1:xcenter ]たくさんの　まほうの　とびら

[Ctrl1:xcenter ]どれを　とおれば　おしろに
[Ctrl1:xcenter ]かえれるのか……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-07T09:31:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:35:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]ジュジュベが　あやつる
[Ctrl1:xcenter ]たくさんの　魔法の扉

[Ctrl1:xcenter ]どれを　通れば　お城に
[Ctrl1:xcenter ]帰れるのか……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-07T09:32:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:36:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="pw_briefing_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl1:xcenter ]ちかろうに　とじこめられた
[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]おうじが
[Ctrl1:xcenter ]ふと　みあげると

[Ctrl1:xcenter ]そこには　どこかで
[Ctrl1:xcenter ]みたことのあるような　すがたが……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-07T09:32:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:52:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl1:xcenter ]地下ろうに　閉じこめられた
[Ctrl1:xcenter ][Name:TrainerName Idx="1" ]王子が
[Ctrl1:xcenter ]ふと　見上げると

[Ctrl1:xcenter ]そこには　どこかで
[Ctrl1:xcenter ]見たことのあるような　姿が……</Text>
			<TextModifiedBy
				User="sato_hitomi:W00231"
				Time="2011-10-07T09:32:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="mori:W00269"
				Time="2011-08-02T10:55:16" />
		</LanguageCell>
	</TextRow>
