				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_158"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へんかわざを　せんせいで
だすことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>変化技を　先制で
だすことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
