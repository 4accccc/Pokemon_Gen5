	<TextRow
		Label="TOKUSEIINFO_068"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ピンチのとき　むしの
いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
