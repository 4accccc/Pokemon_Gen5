	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_053"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうぐを　ひろってくる
ことが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
