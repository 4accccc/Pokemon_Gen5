	<TextRow
		Label="TOKUSEIINFO_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くさくて　あいてが
ひるむ　ことがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>臭くて　相手が
ひるむ　ことがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せんとうに　でると
あめを　ふらす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>戦闘に　でると
雨を　降らす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっとずつ
すばやく　なっていく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちょっとずつ
素早く　なっていく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_004"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいての　こうげきが
きゅうしょに　あたらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手の　攻撃が
急所に　当たらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_005"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちげきで
たおされない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一撃で　倒されない。
</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_006"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だれも　ばくはつが
できなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>だれも　爆発が
できなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_007"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まひ　じょうたいに
ならない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まひ状態に
ならない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_008"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すなあらしで
かいひりつが　あがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂あらしで
回避率が　あがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_009"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さわった　あいてを
まひさせる　ことがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>触った　相手を
まひさせる　ことがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_010"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんきを　うけると
かいふくする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>でんきを　受けると
回復する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_011"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みずを　うけると
かいふくする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みずを　受けると
回復する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_012"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メロメロ　じょうたいに
ならない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メロメロ　状態に
ならない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
