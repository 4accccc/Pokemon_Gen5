	<TextRow
		Label="TOKUSEIINFO_059"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんきで　ポワルンが
へんかする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
