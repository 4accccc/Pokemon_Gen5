		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_027"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふれると　どく　まひ
ねむりに　することがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>触れると　どく　まひ
ねむりに　することがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
