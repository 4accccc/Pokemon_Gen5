	<TextRow
		Label="TOKUSEIINFO_056"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふれると　メロメロに
することがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
