	<TextRow
		Label="TOKUSEIINFO_016"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うけた　わざの　タイプに
へんかする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
