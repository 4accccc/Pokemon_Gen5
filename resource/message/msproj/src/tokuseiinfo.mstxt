			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねんちゃくして
道具を　守る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
