			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_032"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わざの　ついかこうかが
でやすい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>技の　追加効果が
でやすい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_033"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あめのとき　すばやさが
あがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雨のとき　素早さが
あがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_034"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はれのとき　すばやさが
あがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>晴れのとき　素早さが
あがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_035"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やせいの　ポケモンに
そうぐう　しやすくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>野生の　ポケモンに
遭遇しやすくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_036"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてと　おなじ
とくせいに　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手と　同じ
特性に　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_037"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぶつり　こうげきの
いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>物理攻撃の
威力が　あがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_038"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふれた　あいてに　どくを
おわせる　ことがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>触れた　相手に　毒を
おわせる　ことがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:50:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T13:22:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEIINFO_039"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひるまない。
</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T14:01:46" />
		</LanguageCell>
		<LanguageCell
