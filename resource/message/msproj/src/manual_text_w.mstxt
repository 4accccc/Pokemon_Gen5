	<TextRow
		Label="man_txt_title_no_008_009">
		<LanguageCell
			Language="JPN">
			<Text>メダルラリー</Text>
			<TextModifiedBy
				User="tanaka_ryota:W00283"
				Time="2012-01-12T08:00:27" />
			<Status>Editing</Status>
