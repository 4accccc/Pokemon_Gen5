	<TextRow
		Label="MDL_HINT_APPLICATION_009"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンミュージカルで
ステキに　ドレスアップすれば
たかいひょうかを　もらえるよ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
