	<TextRow
		Label="MDL_HINT_FIELD_041"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>のどが　かわいた　ときは
べんりな　じどうはんばいきを
つかってみよう</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>のどが　渇いた時は
便利な　自動販売機を
使ってみよう</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
