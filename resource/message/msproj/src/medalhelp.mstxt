	<TextRow
		Label="MDL_HINT_APPLICATION_013"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミュージカルグッズを
ぜんぶ　あつめて
オシャレに　なろう！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミュージカルグッズを
全部　集めて
オシャレに　なろう！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_HINT_APPLICATION_014"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ともだちコードを　こうかんすれば
たいせんも　こうかんも
さらに　べんりになる！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ともだちコードを　交換すれば
通信対戦も　通信交換も
さらに　便利になる！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
