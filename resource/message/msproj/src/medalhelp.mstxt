	</TextRow>
	<TextRow
		Label="MDL_HINT_FIELD_049"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とんで　とんで
とびまくれ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>飛んで　飛んで
飛びまくれ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_HINT_FIELD_050"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃまする　いわは　ことごとく
あなに　おとしてやるのだ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>邪魔する　岩は　ことごとく
穴に　落としてやるのだ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_HINT_FIELD_051"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なし</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なし</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_HINT_FIELD_052"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２ほんの　ぼうが　さししめす
まだみぬ　たからを　さがしもとめて
みぎへ　ひだりへ　ちゅういを　こらせ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２本の　棒が　指し示す
まだ見ぬ　宝を　探し求めて
右へ　左へ　注意を　こらせ！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_HINT_FIELD_053"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとくな　けいじばんの
おとくな　じょうほうを
たくさん　チェックしよう！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お得な　掲示板の
お得な　情報を
たくさん　チェックしよう！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_HINT_FIELD_054"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なし</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なし</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:54" />
		</LanguageCell>
