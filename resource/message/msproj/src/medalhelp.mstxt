	<TextRow
		Label="MDL_HINT_APPLICATION_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしんこうかんで
いろいろな　ポケモンを
あつめよう！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
