	<TextRow
		Label="MDL_HINT_FIELD_006"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　まえに　みちはなく
きみの　うしろに　みちが　できる！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>君の　前に　道はなく
君の　後ろに　道が　できる！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
