				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_HINT_APPLICATION_071"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おもいでリンク　それは
かこと　みらいを　つなげる
ふしぎな　ノスタルジー</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:55" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おもいでリンク　それは
過去と　未来を　つなげる
不思議な　ノスタルジー</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-11-23T06:24:55" />
			<Status>Editing</Status>
