	<TextRow
		Label="MDL_HINT_FIELD_014"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>べんりな　じてんしゃを
かっこよく　のりこなせ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>便利な　じてんしゃを
かっこよく　乗りこなせ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
