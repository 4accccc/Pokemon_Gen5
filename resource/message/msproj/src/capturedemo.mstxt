<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_cappture_demo_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モンスターボールを　つかうまえに
たいりょくを　へらすと　いいよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T12:00:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モンスターボールを　使う前に
体力を　減らすと　いいよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T12:00:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ボール使用前
※swanで修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T12:00:22" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T03:53:57" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_cappture_demo_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベル　は
モンスターボールを　つかった！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
