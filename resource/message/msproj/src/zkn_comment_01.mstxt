<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="ZKN_COMMENT_01_000_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text />
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text />
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_001_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うまれてから　しばらくの　あいだは
せなかの　タネから　えいようを
もらって　おおきく　そだつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれてから　しばらくの　あいだは
背中の　タネから　栄養をもらって
大きく　育つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_002_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せなかの　つぼみが　ふくらみだすと
あまい　においが　ただよいはじめる。
たいりんの　はなが　さく　まえぶれ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>背中の　つぼみが　膨らみだすと
甘い　においが　漂いはじめる。
大輪の　花が　咲く　前触れ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_003_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あめの　ふった　よくじつは　せなかの
はなの　かおりが　つよまる。かおりに
さそわれ　ポケモンが　あつまる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雨の降った　翌日は
背中の　花の　香りが　強まる。
香りに　誘われ　ポケモンが　集まる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_004_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒトカゲの　しっぽの　ほのおは
いのちの　ともしび。げんきな　ときは
ほのおも　ちからづよく　もえあがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒトカゲの　しっぽの　炎は
命の　ともしび。元気な　ときは
炎も　力強く　燃え上がる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_005_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リザードが　くらす　いわやまを
よなかに　みあげると　しっぽの
ほのおが　ほしのように　みえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リザードが　暮らす　岩山を
夜中に　見上げると
しっぽの　炎が　星のように　見える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_006_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くるしい　たたかいを　けいけんした
リザードンほど　ほのおの　おんどが
たかくなると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>苦しい　戦いを　経験した
リザードンほど　炎の　温度が
高くなると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_007_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうらに　とじこもり　みを　まもる。
あいての　すきを　みのがさず
みずを　ふきだして　はんげきする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甲羅に　閉じこもり　身を守る。
相手の　すきを　見逃さず
水を　吹き出して　反撃する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_008_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちまんねんの　じゅみょうを　もつと
いわれている。ふさふさの　しっぽは
ながいきの　シンボルとして　にんき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１万年の　寿命を　持つと
言われている。ふさふさの　しっぽは
長生きの　シンボルとして人気。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_009_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうらの　ロケットほうから　ふきだす
すいりゅうは　ぶあつい　てっぱんも
いっぱつで　つらぬく　はかいりょく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甲羅の　ロケット砲から　吹き出す
水流は　分厚い　鉄板も
一発で　貫く　破壊力。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_010_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あかい　しょっかくから　においを
だして　てきを　おいはらう。
だっぴを　くりかえし　おおきくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>赤い　触角から　においを出して
敵を　追い払う。
脱皮を　繰り返し　大きくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_011_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうてつのように　かたい　カラで
やわらかい　なかみを　まもっている。
しんかするまで　じっと　たえている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼鉄のように　硬い　殻で
やわらかい　中身を　守っている。
進化するまで　じっと　耐えている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_012_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなの　ミツが　だいこうぶつ。
わずかな　かふんで　はなばたけの
ばしょを　さがしだすことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>花の　ミツが　大好物。
わずかな　花粉で　花畑の
場所を　探し出すことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_013_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいにち　じぶんと　おなじ　おもさの
はっぱを　たべる。あたまの　ハリで
おそってきた　てきを　げきたい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>毎日　自分と　同じ　重さの
葉っぱを　食べる。頭の　針で
襲ってきた　敵を　撃退。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_014_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんてきに　みつからないように
はっぱの　うらや　えだの　すきまに
かくれて　しんかの　ときを　まつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>天敵に　見つからないように
葉っぱの　裏や　枝の　すきまに
隠れて　進化の　ときを　待つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_015_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうそくで　とびまわり　どくバリで
こうげきしたあと　すぐに　とびさる
せんぽうが　とくいわざだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高速で　飛びまわり　毒針で
攻撃したあと　すぐに　飛び去る
戦法が　得意技だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_016_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たたかいを　このまない　おとなしい
せいかくだが　へたに　てを　だすと
きょうれつに　はんげきされるぞ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>戦いを　好まない　大人しい
性格だが　下手に　手を　出すと
強烈に　反撃されるぞ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_017_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひろい　なわばりを　とびまわりながら
えものを　さがす。はったつした
あしの　ツメで　えものを　しとめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>広い　縄張りを　飛び回りながら
獲物を　探す。発達した
足の　ツメで　獲物を　しとめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_018_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ピジョットが　ちからいっぱい
はばたくと　たいぼくも　しなるほどの
きょうふうを　まきおこす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ピジョットが　力いっぱい
羽ばたくと　大木も　しなるほどの
強風を　巻き起こす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_019_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　ばしょにも　すみついて
いきていける　せいめいりょく。
けいかいしんが　とても　つよい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんな　場所にも　住みついて
生きていける　生命力。
警戒心が　とても　強い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_020_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>のびつづける　まえばを　けずるため
かたい　ものを　かじる　しゅうせい。
ブロックべいも　かじって　こわす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伸び続ける　前歯を　削るため
硬い　物を　かじる　習性。
ブロック塀も　かじって　壊す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_021_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさな　つばさを　いそがしく
はばたかせて　とぶ。くさむらにいる
えものを　くちばしで　さがしだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　翼を　忙しく
羽ばたかせて　飛ぶ。草むらにいる
獲物を　クチバシで　探し出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_022_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　つばさで　１にちじゅう
とびまわる　たいりょくの　もちぬし。
するどい　くちばしで　たたかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　翼で　１日中
飛び回る　体力の　持ち主。
鋭い　クチバシで　戦う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_023_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとを　まったく　たてずに　くさちの
なかを　すすむ。ゆだんしている
えものに　はいごから　おそいかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>音を　まったく　立てずに　草地の
中を　進む。油断している獲物に
背後から　襲いかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_024_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなかの　もようで　てきを　いかく。
もように　おびえて　うごけなくなった
すきに　からだで　しめつける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お腹の　模様で　敵を　威嚇。
模様に　おびえて　動けなくなった
すきに　体で　絞めつける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_025_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よわった　なかまの　ピカチュウに
でんきをながし　ショックをあたえて
げんきを　わけることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>弱った　仲間の　ピカチュウに
電気を流し　ショックを与えて
元気を　分けることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_026_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽが　アースの　やくめをはたして
でんきを　じめんに　にがすので
じぶんじしんは　しびれたりしない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽが　アースの　役目をはたして
電気を　地面に　逃がすので
自分自身は　しびれたりしない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_027_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あめが　ほとんど　ふらない
かんそうした　とちに　せいそく。
からだを　まるめて　みを　まもる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雨が　ほとんど　降らない
乾燥した　土地に　生息。
体を　丸めて　身を　守る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_028_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだを　まるめて　せなかから
たいあたり。するどい　トゲトゲが
おおきな　ダメージを　あたえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を　丸めて　背中から　体当たり。
鋭い　トゲトゲが
大きな　ダメージを　与える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_029_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たたかいを　このまない　せいかく。
どくバリから　ぶんぴつされる　どくは
ひとしずくでも　いのちとりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>戦いを　好まない　性格。
毒針から　分泌される　毒は
一滴でも　命取りだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_030_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きけんを　かんじると　ぜんしんの
トゲを　さかだてる。ニドリーノに
くらべて　トゲの　そだちが　おそい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>危険を　感じると　全身のトゲを
逆立てる。ニドリーノに　比べて
トゲの　育ちが　遅い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_031_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よろいのように　かたい　ウロコが
ぜんしんを　つつむ。すあなの
こどもを　いのちがけで　まもる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よろいのように　硬い　ウロコが
全身を　包む。
巣穴の　子供を　命がけで　守る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_032_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くさむらの　うえに　みみだけ　だして
まわりの　けはいを　さぐる。
もうどくの　ツノで　みを　まもる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>草むらの　上に　耳だけ　出して
まわりの　気配を　探る。
猛毒の　ツノで　身を　守る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_033_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きしょうが　あらい　ポケモン。
あいてに　つきさした　しょうげきで
ツノから　もうどくが　にじみでる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気性が　荒い　ポケモン。
相手に　突き刺した　衝撃で
ツノから　猛毒が　にじみ出る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_034_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　いちげきは　でんちゅうを
まるで　マッチぼうのように
まっぷたつに　へしおってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　一撃は　電柱を
まるで　マッチ棒のように
真っ二つに　へし折ってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_035_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まんげつのよる　ピッピが　あつまって
ダンスを　おどるようすを　みると
しあわせに　なれると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>満月の夜　ピッピが　集まって
ダンスを　踊る様子を　見ると
幸せに　なれると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_036_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１キロさきで　おちた　はりのおとを
ききわける　みみと　ようじんぶかさで
めったに　ひとまえに　あらわれない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１キロ先で　落ちた　針の音を
聞き分ける　耳と　用心深さで
滅多に　人前に　現われない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_037_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほのおの　たまを　あやつる。
せいちょうすると　６ほんの　しっぽは
さきが　わかれて　さらに　ふえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>炎の　玉を　操る。
成長すると　６本の　しっぽは
先が　分かれて　さらに　増える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_038_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>９ほんの　しっぽには　しんぴてきな
ちからが　やどっていると　つたわる。
１０００ねん　いきつづけるらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>９本の　しっぽには　神秘的な
力が　宿っていると　伝わる。
１０００年　生き続けるらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_039_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つぶらな　ひとみが　ゆれるとき
だれもが　ねむくなってしまう
こもりうたを　うたいはじめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>つぶらな　ひとみが　ゆれるとき
だれもが　眠くなってしまう
子守歌を　歌いはじめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_040_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キメこまやかな　たいもうは
ごくじょうの　はだざわり。
いきを　すいこんで　ふくらむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キメ細やかな　体毛は
極上の　肌触り。
息を　吸い込んで　ふくらむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_041_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くちからだす　ちょうおんぱの
はんしゃで　まわりの　ようすや
じぶんの　いばしょを　しらべている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>口から出す　超音波の反射で
まわりの　様子や
自分の　居場所を　調べている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_042_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんなに　かたい　ひふでも　つらぬく
するどいキバには　ちいさな　あなが
あって　そこから　ちを　すいまくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんなに　硬い　皮膚でも　貫く
鋭いキバには　小さな　穴があって
そこから　血を　吸いまくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_043_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひるまは　ねっこの　あしを　じめんに
うめて　うごかないことが　おおい。
よる　あるきまわって　タネを　まく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昼間は　根っこの　足を　地面に
埋めて　動かないことが　多い。
夜　歩き回って　タネを　まく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_044_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くちから　たれている　ミツは
２キロ　はなれていても　はなが
まがるほど　もうれつに　くさい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>口から　たれている　ミツは
２キロ　離れていても　鼻が
まがるほど　猛烈に　くさい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_045_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなびらの　おおきさは　せかいいち。
ひどい　アレルギーを　ひきおこす
どくかふんを　ばらまいて　あるく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>花びらの　大きさは　世界一。
ひどい　アレルギーを　引き起こす
毒花粉を　ばらまいて　歩く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_046_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とうちゅうかそうと　よばれる
キノコを　せなかに　はやしている。
パラスと　ともに　おおきく　そだつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>冬虫夏草と　呼ばれる
キノコを　背中に　生やしている。
パラスと　ともに　大きく　育つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_047_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだよりも　おおきな　キノコが
パラセクトを　あやつっている。
どくの　ほうしを　ばらまく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体よりも　大きな　キノコが
パラセクトを　操っている。
毒の　胞子を　ばらまく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_048_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさな　めが　たくさん　あつまって
おおきな　めに　なっている。
よるになると　あかりに　あつまる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　目が　たくさん　集まって
大きな　目に　なっている。
夜になると　明かりに　集まる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_049_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はばたいて　りんぷんを　まきちらす。
りんぷんが　からだに　つくと　どくの
せいぶんが　ひふに　しみこんでくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>羽ばたいて　りんぷんを　まき散らす。
りんぷんが　体に　つくと　毒の
成分が　皮膚に　染み込んでくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_050_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちちゅうで　くらしている　ポケモン。
くらい　ちかに　いるため
あかるい　たいようが　にがて。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地中で　暮らしている　ポケモン。
暗い　地下に　いるため
明るい　太陽が　苦手。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_051_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３つの　あたまが　たがいちがいに
うごいて　どんなに　かたい　ちそうも
ちか１００キロまで　ほりすすむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３つの　頭が　互い違いに　動いて
どんなに　硬い　地層も
地下１００キロまで　掘り進む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_052_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よなかに　こうどうする　しゅうせい。
きらきら　ひかるものを　みつけると
まけないくらい　ひとみが　かがやく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夜中に　行動する　習性。
キラキラ　光るものを　見つけると
負けないくらい　ひとみが　輝く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_053_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きぐらいが　たかい　ポケモン。
マニアの　あいだでは　ひたいの
ほうせきの　サイズが　わだいになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気位が　高い　ポケモン。
マニアの　あいだでは　額の
宝石の　サイズが　話題になる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_054_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふしぎな　のうりょくを　もてあまし
いつも　ずつうに　なやまされている。
たまに　ふしぎなちからを　つかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不思議な　能力を　持てあまし
いつも　頭痛に　悩まされている
たまに　不思議な力を　使う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_055_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てのひらの　はったつした　みずかきを
つかって　ダイナミックに　そして
ゆうがに　およぐ　すがたをみかける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手のひらの　発達した　水かきを
使って　ダイナミックに　そして
優雅に　泳ぐ　姿を見かける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_056_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きのうえで　せいかつしている。
むれの　１ぴきが　おこりはじめると
ぜんいんが　いみもなく　あばれだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>木の上で　生活している。
群れの　１匹が　怒り出すと
全員が　意味もなく　暴れだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_057_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しせんが　あっただけで　おこり
にげだしたら　また　おこり
たたきのめしても　まだ　おこる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>視線が　合っただけで　怒り
逃げ出したら　また　怒り
たたきのめしても　まだ　怒る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_058_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちゅうじつな　せいかくの　ポケモン。
トレーナーの　めいれいが　あるまでは
いっぽも　うごかない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>忠実な　性格の　ポケモン。
トレーナーの　命令が　あるまでは
一歩も　動かない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_059_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いふうどうどうとした　すがたは
ふるくから　ひとびとの　こころを
とりこにしてきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>威風堂々とした　姿は
古くから　人々の　心を
虜にしてきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_060_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ないぞうが　すけて　みえるほど
ひふが　うすい。はえたばかりの
あしは　あるくことが　にがて。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>内臓が　透けて　見えるほど
皮膚が　薄い。生えたばかりの
足は　歩くことが　苦手。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_061_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなかの　うずまきは　びみょうに
うねっているので　みつめていると
だんだん　ねむくなってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お腹の　渦巻きは　微妙に
うねっているので　見つめていると
だんだん　眠くなってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_062_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうじんな　きんにくを　もつ。
たいへいようを　やすむことなく
およぎつづけることが　できるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強じんな　筋肉を　持つ。
太平洋を　休むことなく
泳ぎ続けることが　できるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_063_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょうのうりょくを　つかったあとは
のうみそが　つかれてしまうので
１にちに　１８じかんも　ねむるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>超能力を　使った後は
脳みそが　疲れてしまうので
１日に　１８時間も　眠るのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_064_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぎんのスプーンを　みつめて
せいしんを　とういつ　していると
はっさんする　アルファは　がふえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>銀のスプーンを　見つめて
精神を　統一　していると
発散する　アルファ波　が増える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_065_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうてに　もつ　スプーンは
フーディンの　ちょうのうりょくで
うみだしたモノと　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両手に　持つ　スプーンは
フーディンの　超能力で
生み出したモノと　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_066_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こがらな　からだだけど　ちからもち。
イシツブテなら　なんびきも　まとめて
かるがると　もちあげ　なげとばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小柄な　体だけど　力持ち。
イシツブテなら　何匹も　まとめて
軽々と　持ち上げ　投げ飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_067_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだを　きたえるために　よろこんで
おもい　にもつを　はこぶので
ひとのかわりに　ちからしごとをする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を　鍛えるために　喜んで
重い　荷物を　運ぶので
人の代わりに　力仕事をする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_068_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>４ほんの　ちからづよい　うでは
めにも　とまらぬ　はやさで
パンチや　チョップを　たたきこむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>４本の　力強い　腕は
目にも　止まらぬ　速さで
パンチや　チョップを　たたき込む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_069_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうおん　たしつの　とちを　このむ。
ツルを　のばして　えものを　とらえる
ときの　うごきは　とても　すばやい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高温　多湿の　土地を　好む。
ツルを　伸ばして　獲物を　捕らえる
ときの　動きは　とても　素早い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_070_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょくぶつに　そっくりな　ポケモン。
ゆだんして　ちかよってきた　えものに
どくのこなを　あびせて　つかまえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>植物に　そっくりな　ポケモン。
油断して　近寄って来た　獲物に
毒の粉を　あびせて　捕まえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_071_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミツのような　かおりの　えきたいを
くちに　ためているが　それは
なんでも　とかす　ようかいえきだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミツのような　香りの　液体を
口に　ためているが　それは
なんでも　溶かす　溶解液だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_072_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　ほとんどが　みずなので
なみに　ながされ　すなはまに
うちあげられると　ひからびてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　ほとんどが　水なので
波に　流され　砂浜に
打ち上げられると　干からびてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_073_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>８０ぽんの　しょくしゅを　のばして
どくの　ほういもうを　つくりだす。
つかまると　にげるのは　むずかしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>８０本の　触手を　伸ばして
毒の　包囲網を　作り出す。
捕まると　逃げるのは　難しい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_074_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じっとしていると　いしころ　にしか
みえないので　つい　ふみつけると
げんこつを　ふりまわして　おこる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジッとしていると　石ころ　にしか
見えないので　つい　踏みつけると
ゲンコツを　振りまわして　怒る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_075_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やまみちを　ころがって　いどう。
いきおいが　ついてくると　どんな
ポケモンでも　とめるのは　たいへん。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>山道を　転がって　移動。
勢いが　ついてくると　どんな
ポケモンでも　止めるのは　大変。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_076_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんせきの　ような　かたい　からだは
ダイナマイトでも　きずつかない。
１ねんに　１どだけ　だっぴする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>岩石の　ような　硬い　体は
ダイナマイトでも　傷つかない。
１年に　１度だけ　脱皮する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_077_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うまれたばかりでは　たつのがやっと。
だが　はしるほどに　あしこしは
きたえられて　そくどが　ましていく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれたばかりでは　立つのがやっと。
だが　走るほどに　足腰は
鍛えられて　速度が　増していく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_078_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんりょくで　かけぬけるとき
もえる　たてがみが　きらめいて
よりいっそう　うつくしく　みえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全力で　駆け抜けるとき
燃える　たてがみが　きらめいて
より一層　美しく　見える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_079_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うごきは　のろいが　しっぽを　つかう
つりが　とくい。どんかんなので
しっぽを　かまれても　いたくない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>動きは　ノロいが　しっぽを　使う
釣りが　得意。鈍感なので
しっぽを　かまれても　痛くない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_080_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼんやりしている　ヤドランだが
シェルダーが　つよく　しっぽを
かむとき　なにかが　ひらめくらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼんやりしている　ヤドランだが
シェルダーが　強く　しっぽを
かむとき　なにかが　ひらめくらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_081_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さゆうにある　ユニットを
こうそくで　かいてん　させるほどに
だせる　じりょくが　つよくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>左右にある　ユニットを
高速で　回転　させるほどに
出せる　磁力が　強くなる</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_082_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいようの　こくてんが　ふえると
なぜか　レアコイルが　おおくなり
テレビが　きれいに　うつらなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太陽の　黒点が　増えると
なぜか　レアコイルが　多くなり
テレビが　きれいに　映らなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_083_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>クキが　なくなると　いきていけない。
だから　クキを　ねらう　あいてとは
いのちがけで　たたかうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>クキが　なくなると　生きていけない。
だから　クキを　ねらう　相手とは
命がけで　戦うのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_084_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２つの　あたまの　のうみそは
テレパシーのような　ちからで
きもちを　つうじあわせているらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２つの　頭の　脳みそは
テレパシーのような　力で
気持ちを　通じ合わせているらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_085_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかのときに　ドードーの　あたまの
どちらかが　ぶんれつした　ちんしゅ。
じそく６０キロいじょうで　はしる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>進化のときに　ドードーの　頭の
どちらかが　分裂した　珍種。
時速６０キロ以上で　走る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_086_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひょうざんで　くらす　ポケモン。
あたまの　とがった　でっぱりで
こおりを　わって　うみを　およぐ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>氷山で　暮らす　ポケモン。
頭の　とがった　でっぱりで
氷を　割って　海を　泳ぐ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_087_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんが　まっしろな　たいもうに
おおわれているため　ゆきの　なかでは
てんてきに　みつからないのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身が　真っ白な　体毛に
おおわれているため　雪の　中では
天敵に　見つからないのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_088_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どぶがわの　ヘドロが　つきからの
エックスせんを　あびて　うまれた。
きたない　ばしょに　あらわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドブ川の　ヘドロが　月からの
エックス線を　浴びて　生まれた。
汚い　場所に　現われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_089_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだから　もうどくの　たいえきが
しみでている。その　えきに　ふれた
くさきは　あっというまに　かれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体から　猛毒の　体液が
染み出ている。その　液に　触れた
草木は　あっというまに　枯れる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_090_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２まいの　カラを　あけしめすることで
うしろむきに　およぐ。どんなときでも
おおきな　ベロは　だしっぱなし。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２枚の　殻を　開け閉めすることで
後ろ向きに　泳ぐ。どんなときでも
大きな　ベロは　出しっぱなし。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_091_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カラを　しっかりと　とじて　みを
まもりながら　トゲを　とばして
てきを　げきたいする　せんぽう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>殻を　しっかりと　閉じて　身を
守りながら　トゲを　飛ばして
敵を　撃退する　戦法。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_092_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ガスから　うまれた　せいめいたい。
どくをふくんだ　ガスの　からだに
つつまれると　だれでも　きぜつする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ガスから　生まれた　生命体。
毒を含んだ　ガスの　体に
包まれると　だれでも　気絶する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_093_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くらやみにまぎれ　ガスのてを　のばし
ひとのかたを　たたくのが　すき。
さわられると　ふるえが　とまらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>くらやみにまぎれ　ガスの手を　伸ばし
人の肩を　たたくのが　好き。
触られると　震えが　止まらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_094_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くらやみに　うかぶ　えがおの
しょうたいは　ひとに　のろいを
かけて　よろこぶ　ゲンガーだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>くらやみに　浮かぶ　笑顔の
正体は　人に　のろいを
かけて　喜ぶ　ゲンガーだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_095_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　いわをも　くらいながら
じめんのなかを　ほりすすむ。
そのスピードは　じそく８０キロ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　岩をも　食らいながら
地面の中を　掘り進む。
そのスピードは　時速８０キロ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_096_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つきでた　はなを　ひくひくさせると
みている　ユメが　わかるという。
だいこうぶつは　たのしい　ユメだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>突き出た　鼻を　ひくひくさせると
見ている　夢が　わかるという。
大好物は　楽しい　夢だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_097_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふりこを　めのまえで　ゆらされると
たったいま　めざめたばかりの　ひとも
３びょうごには　ねむってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>振り子を　目の前で　ゆらされると
たった今　目覚めたばかりの　人も
３秒後には　眠ってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_098_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すなはまに　あなを　ほって　くらす。
ハサミは　たたかいで　とれても
また　はえてきて　もとどおり。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂浜に　穴を　掘って　暮らす。
ハサミは　戦いで　取れても
また　生えてきて　元通り。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_099_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきいほうの　ハサミの　パワーは
１まんばりき。しかし　おもすぎるため
ねらいを　つけることが　にがてだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きいほうの　ハサミの　パワーは
１万馬力。しかし　重すぎるため
ねらいを　つけることが　苦手だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_100_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モンスターボールに　そっくり。
まちがって　さわると　かんでんしたり
ときには　ばくはつするので　きけん。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モンスターボールに　そっくり。
間違って　触ると　感電したり
ときには　爆発するので　危険。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_101_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんきエネルギーを　ためすぎて
ぱんぱんに　ふくらんだ　マルマインが
かぜに　ながされてくることが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>電気エネルギーを　ためすぎて
ぱんぱんに　膨らんだ　マルマインが
風に　流されてくることが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_102_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テレパシーで　かいわをしているため
タマタマを　ひきはなそうとしても
すぐに　あつまって　６ぴきになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テレパシーで　会話をしているため
タマタマを　引き離そうとしても
すぐに　集まって　６匹になる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_103_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あるく　ねったいうりんと　よばれる。
おおきくなった　あたまの　ひとつが
じめんに　おちると　タマタマになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>歩く　熱帯雨林と　呼ばれる。
大きくなった　頭の　ひとつが
地面に　落ちると　タマタマになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_104_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しにわかれた　ははおやを　おもいだし
ないてしまうとき　あたまに　かぶった
ホネが　からからと　おとを　たてる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>死に別れた　母親を　思い出し
泣いてしまうとき　頭に　かぶった
ホネが　からからと　音を　立てる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_105_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うまれたときから　いつも　もっている
ホネを　じざいに　つかいこなす。
せいかくは　きょうぼうだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれたときから　いつも　持っている
ホネを　自在に　使いこなす。
性格は　凶暴だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_106_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あしが　２ばいの　ながさに　のびる。
はじめて　たたかう　あいては
その　まあいの　ひろさに　おどろく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>足が　２倍の　長さに　伸びる。
はじめて　戦う　相手は
その　間合いの　広さに　驚く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_107_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うでを　ねじりながら　くりだす
パンチは　コンクリートも　ふんさい。
３ぷん　たたかうと　ひとやすみする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腕を　ねじりながら　繰り出す
パンチは　コンクリートも　粉砕。
３分　戦うと　ひとやすみする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_108_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２メートルもある　したを　のばすと
しっぽが　ふるえるので　このふたつは
つながっている　かのうせいが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２メートルもある　舌を　伸ばすと
しっぽが　震えるので　この２つは
つながっている　可能性が　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_109_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くうきよりも　かるい　ガスを
からだに　ためて　うかんでいる。
ガスは　くさいうえに　ばくはつする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>空気より　軽い　ガスを
体に　ためて　浮かんでいる。
ガスは　くさい上に　爆発する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_110_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゴミから　はっせいする　ガスを
たべて　おおきくなる。ごくまれに
３つごの　マタドガスが　みつかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゴミから　発生する　ガスを
食べて　大きくなる。ごくまれに
３つ子の　マタドガスが　見つかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_111_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　たいあたりで　こわせる
ちからもちだが　あたまが　わるいので
ひとのしごとを　てつだうのは　むり。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　体当たりで　壊せる
力持ちだが　頭が　悪いので
人の仕事を　手伝うのは　無理。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_112_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うしろあしだけで　たつようになり
まえあしが　じゆうになって　ちのうが
はったつしたが　ものわすればかりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>後ろ足だけで　立つようになり
前足が　自由になって
知能が　発達したが　物忘ればかりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_113_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きずついた　ポケモンや　ひとがいると
えいようまんてんの　タマゴをうみ
わけあたえる　やさしい　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>傷ついた　ポケモンや　人がいると
栄養満点の　タマゴを生み
分け与える　優しい　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_114_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんを　おおう　あおいツルには
さらに　こまかな　けがはえていて
さわると　とても　くすぐったい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身を　おおう　青いツルには
さらに　細かな　毛が生えていて
触ると　とても　くすぐったい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_115_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなかの　ふくろで　こそだてをする。
あんぜんな　ときだけ　こどもを
ふくろから　だして　あそばせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お腹の　袋で　子育てをする。
安全な　ときだけ　子供を
袋から　出して　遊ばせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_116_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サンゴの　かげに　すみかを　つくる。
きけんを　かんじると　くちから
まっくろい　スミを　はいて　にげる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サンゴの　陰に　住処を　作る。
危険を　感じると　口から
真っ黒い　墨を　吐いて　逃げる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_117_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トゲが　てきから　みを　まもる。
ひれや　ホネが　かんぽうやくの
ざいりょうとして　ちょうほうされる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トゲが　敵から　身を　守る。
ヒレや　ホネが　漢方薬の
材料として　重宝される。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_118_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きれいな　ひれを　たなびかせ
およぐ　すがたは　とても　かれいだが
ツノの　ひとつきは　きょうりょく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きれいな　ヒレを　たなびかせ
泳ぐ　姿は　とても　華麗だが
ツノの　一突きは　強力。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_119_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あきになると　プロポーズのため
からだに　あぶらが　のってきて
とても　きれいないろに　へんかする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>秋になると　プロポーズのため
体に　脂が　のってきて
とても　きれいな色に　変化する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_120_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あかい　コアが　あるかぎり　からだが
ちぎれても　すぐに　さいせいする。
まよなか　コアが　てんめつする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>赤い　コアが　ある限り　体が
ちぎれても　すぐに　再生する。
真夜中　コアが　点滅する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_121_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　ちゅうしんにある　あかい
コアから　よぞらに　むかって
なぞの　でんぱを　はっしんしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　中心にある　赤いコアから
夜空に　向かって　ナゾの　電波を
発信している。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_122_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆびさきを　こまかく　ふるわせて
くうきちゅうの　ぶんしの　うごきを
とめて　みえないかべを　つくるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>指先を　細かく　ふるわせて
空気中の　分子の　動きを
止めて　見えない壁を　作るのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_123_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうての　するどい　カマは
かたいものを　きればきるほど
さらに　きれあじを　ましていく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両手の　鋭い　カマは
硬いものを　切れば切るほど
さらに　切れ味を　増していく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_124_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なきごえは　まるで　にんげんの
ことばのように　きこえるが
いみは　まったく　りかいできない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鳴き声は　まるで　人間の
言葉のように　聞こえるが
意味は　まったく　理解できない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_125_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すこしでも　いりょくを　たかめるため
パンチのまえに　うでを　まわすが
そのすきに　にげられたりも　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>少しでも　威力を　高めるため
パンチの前に　腕を　回すが
そのすきに　逃げられたりも　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_126_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ブーバーが　しんこきゅう　すると
からだのまわりに　かげろうができ
すがたは　ぼやけて　みえにくくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ブーバーが　深呼吸　すると
体のまわりに　陽炎ができ
姿は　ぼやけて　見えにくくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_127_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２ほんの　ツノで　えものを　はさんで
ちぎれるまで　はなさない。ちぎれない
ときは　かなたまで　なげとばすのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２本の　ツノで　獲物を　挟んで
ちぎれるまで　離さない。ちぎれない
ときは　かなたまで　投げ飛ばすのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_128_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えものに　ねらいを　さだめると
いっちょくせんに　とっしんする。
あらっぽい　せいかくで　ゆうめい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>獲物に　ねらいを　定めると
一直線に　突進する。
荒っぽい　性格で　有名。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_129_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながねん　いきた　コイキングは
はねるだけで　やまをも　こえるが
わざのいりょくは　よわいまま。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長年　生きた　コイキングは
跳ねるだけで　山をも　越えるが
技の威力は　弱いまま。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_130_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちど　あばれだした　ギャラドスは
あらしが　ふきすさんでいようとも
どんなものでも　やきつくしてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一度　暴れだした　ギャラドスは
あらしが　吹きすさんでいようとも
どんなものでも　焼きつくしてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_131_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとや　ポケモンを　せなかに　のせて
うみを　わたることが　だいすき。
ひとの　ことばを　りかいできる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人や　ポケモンを　背中に　乗せて
海を　渡ることが　大好き。
人の　言葉を　理解できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_132_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんの　さいぼうを　くみかえて
みたものの　かたち　そっくりに
へんしんする　のうりょくを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身の　細胞を　組み替えて
見たものの　形　そっくりに
変身する　能力を　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_133_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いでんしが　ふきそくなため
さまざまな　りゆうに　よって　すぐに
すがたかたちが　かわってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>遺伝子が　不規則なため
様々な　理由に　よって　すぐに
姿かたちが　変わってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_134_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　さいぼうの　つくりが
みずの　ぶんしに　にているので
みずに　とけることも　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　細胞の　作りが
水の　分子に　似ているので
水に　溶けることも　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_135_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんじょうが　たかぶると
でんきを　おびて　まっすぐになった
たいもうを　なんぼんも　とばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>感情が　たかぶると
電気を　帯びて　真っ直ぐになった
体毛を　何本も　飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_136_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すいこんだ　いきは　たいないの
ほのおぶくろで　１７００どに　まで
ねっせられて　ほのおと　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>吸い込んだ　息は　体内の
炎袋で　１７００度に　まで
熱せられて　炎と　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_137_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいこうの　かがくりょくで
うみだされた　じんこうの　ポケモン。
でんしくうかんを　いどうできる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最高の　科学力で
生み出された　人工の　ポケモン。
電子空間を　移動できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_138_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げんだいの　すぐれた　かがくりょくで
かせきから　ふっかつした　ポケモン。
こだいの　うみを　およいでいた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>現代の　優れた　科学力で
化石から　復活した　ポケモン。
古代の　海を　泳いでいた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_139_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>らせんじょうの　カラが　おおきく
なりすぎたことが　げんいんで
ぜつめつしたと　かんがえられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>らせん状の　殻が　大きく
なりすぎたことが　原因で
絶滅したと　考えられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_140_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３おくねんまえの　すなはまで
くらしていたと　かんがえられている。
かたい　カラが　みを　まもる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３億年前の　砂浜で
暮らしていたと　考えられている。
硬い　殻が　身を　守る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_141_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えものが　りくじょうせいかつを
はじめたため　カブトプスも　りくに
あがったと　かんがえられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>獲物が　陸上生活を　はじめたため
カブトプスも　陸に　上がったと
考えられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_142_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうりゅうじだいの　おおぞらを
とびまわっていた　ポケモン。
のこぎりのような　キバを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>恐竜時代の　大空を
飛び回っていた　ポケモン。
ノコギリのような　キバを　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_143_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まんぷくになると　ゆびすら
うごかすのが　めんどうに　なるので
おなかに　のっても　だいじょうぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>満腹になると　指すら
動かすのが　面倒に　なるので
お腹に　乗っても　大丈夫。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_144_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんせつの　とりポケモン。
くうきちゅうの　すいぶんを　こおらせ
ふぶきを　つくりだすことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伝説の　とりポケモン。
空気中の　水分を　凍らせ
吹雪を　作り出すことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_145_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かみなりぐもの　なかに　いると
いわれる　でんせつの　ポケモン。
カミナリを　じざいに　あやつる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雷雲の　中に　いると
言われる　伝説の　ポケモン。
雷を　自在に　操る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_146_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんせつの　とりポケモンの　１ぴき。
ファイヤーが　すがたを　みせると
はるが　おとずれると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伝説の　とりポケモンの　１匹。
ファイヤーが　姿を　見せると
春が　訪れると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_147_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もくげきしゃが　すくないために
まぼろしのポケモンと　よばれていた。
だっぴした　かわが　みつかっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目撃者が　少ないために
幻のポケモンと　呼ばれていた。
脱皮した　皮が　見つかっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_148_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんが　オーラに　つつまれるとき
まわりの　てんきが　いっぺんする。
うみや　みずうみに　すむという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身が　オーラに　包まれるとき
まわりの　天気が　一変する。
海や　湖に　住むという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_149_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひろい　うみの　どこかに　すみかが
あると　いわれている。なんぱした
ふねを　りくまで　みちびいてくれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>広い　海の　どこかに　住処が
あると　言われている。難破した
船を　陸まで　導いてくれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_150_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミュウの　いでんしを　くみかえて
うみだされた。ポケモンで　いちばん
きょうぼうな　こころを　もつという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミュウの　遺伝子を　組み替えて
生み出された。ポケモンで　一番
凶暴な　心を　持つという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_151_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あらゆる　わざを　つかうため
ポケモンの　せんぞと　かんがえる
がくしゃが　たくさん　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あらゆる　技を　使うため
ポケモンの　先祖と　考える
学者が　たくさん　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_152_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　はっぱで　まわりの
おんどや　しつどを　さぐる。
ひざしを　あびることが　だいすき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　葉っぱで　まわりの
温度や　湿度を　探る。
日差しを　浴びることが　大好き。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_153_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くびまわりの　つぼみから　におう
スパイシーな　かおりは
かいだ　ひとを　げんきに　させる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>首回りの　つぼみから　におう
スパイシーな　香りは
かいだ　人を　元気に　させる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_154_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メガニウムが　はきだす　いきには
かれた　くさばなを　よみがえらせる
ふしぎな　ちからが　ひめられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メガニウムが　吐き出す　息には
枯れた　草花を　よみがえらせる
不思議な　力が　秘められている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_155_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おくびょうな　せいかく。
おどろくと　せなかの　ほのおが
いちだんと　つよく　もえあがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おくびょうな　性格。
驚くと　背中の　炎が
一段と　強く　燃え上がる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_156_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほのおの　ねつで　あいてを　いかく。
たたかう　たいせいになると
ほのおの　いきおいが　ます。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>炎の　熱で　相手を　威嚇。
戦う　体勢になると
炎の　勢いが　増す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_157_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほのおの　ばくふうで　こうげき。
しゃくねつの　ほのおで　かげろうを
つくりだし　すがたを　かくす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>炎の　爆風で　攻撃。
しゃく熱の　炎で　陽炎を
作り出し　姿を　隠す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_158_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はったつした　あごを　もち
なんにでも　かみつく　しゅうせい。
トレーナーも　ちゅういが　ひつよう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>発達した　アゴを　持ち
なんにでも　かみつく　習性。
トレーナーも　注意が　必要。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_159_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちど　かみつくと　キバが
ぬけるまで　ぜったいに　はなさない。
ぬけた　キバは　すぐに　はえてくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一度　かみつくと　キバが
抜けるまで　絶対に　離さない。
抜けた　キバは　すぐに　生えてくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_160_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふだんは　ゆっくりとした　うごきだが
えものに　かみつくときは
めにも　とまらない　スピードだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>普段は　ゆっくりとした　動きだが
獲物に　かみつくときは
目にも　止まらない　スピードだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_161_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とても　しんけいしつな　せいかく。
とおくまで　みわたせるように
しっぽを　つかって　せのびをする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とても　神経質な　性格。
遠くまで　見渡せるように
しっぽを　使って　背伸びをする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_162_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ははおやは　ほそながい　からだで
こどもを　つつみこみ　ねむらせる。
はやい　うごきで　てきを　おいこむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>母親は　細長い　体で
子供を　包み込み　眠らせる。
早い　動きで　敵を　追い込む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_163_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せいかくに　ときを　つげることから
せかいの　ことわりを　わきまえた
ちえのかみさま　とする　くにもある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正確に　時を　告げることから
世界の　ことわりを　わきまえた
知恵の神様　とする　国もある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_164_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とくしゅな　つくりの　りょうめは
わずかな　ひかりさえ　あれば
くらやみでも　ひるのように　みえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>特殊な　作りの　両目は
わずかな　光さえ　あれば
くらやみでも　昼のように　見える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_165_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むれを　つくらないと　ふあんで
うごけなくなるほど　おくびょう。
においで　きもちを　つたえあう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>群れを　作らないと　不安で
動けなくなるほど　おくびょう。
においで　気持ちを　伝え合う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_166_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほしあかりを　エネルギーにする。
よぞらの　ほしの　かずが　ふえると
せなかの　もようが　おおきくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>星明りを　エネルギーにする。
夜空の　星の　数が　増えると
背中の　模様が　大きくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_167_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほそくて　じょうぶな　いとを
はりめぐらして　わなを　しかける。
えものが　かかるまで　じっと　まつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>細くて　丈夫な　糸を
張り巡らして　ワナを　仕掛ける。
獲物が　かかるまで　じっと　待つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_168_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えものの　からだに　いとを　つけて
わざと　にがす。いとを　たどれば
なかまごと　つかまえられるからだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>獲物の　体に　糸を　つけて
わざと　逃がす。糸を　たどれば
仲間ごと　捕まえられるからだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_169_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうあしも　はねに　なったことで
とぶのが　うまくなったかわりに
あるいたりするのは　へたになった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両足も　羽に　なったことで
飛ぶのが　うまくなった代わりに
歩いたりするのは　下手になった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_170_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プラスと　マイナスの　でんきを
しょくしゅの　さきから　ながす。
てきを　かんでんさせてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラスと　マイナスの　電気を
触手の　先から　流す。
敵を　感電させてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_171_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかいを　およぐ　ランターンの
あかりは　すいめんまで　とどく。
しんかいのほし　と　よばれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深海を　泳ぐ　ランターンの
明かりは　水面まで　届く。
深海の星　と　呼ばれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_172_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほほの　でんきぶくろは　ちいさく
ちょっとでも　でんきが　あふれると
じぶんじしんが　しびれてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほほの　電気袋は　小さく
ちょっとでも　電気が　あふれると
自分自身が　しびれてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_173_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながれぼしの　おおい　よるに
ピィを　みかけることが　おおいので
ほしにのってくる　といわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>流れ星の　多い　夜に
ピィを　見かけることが　多いので
星に乗って来る　と言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_174_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やわらかく　だんりょくせいのある
からだは　いちど　はずむと
ぜんぜん　とまれなくなってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やわらかく　弾力性のある
体は　一度　弾むと
全然　止まれなくなってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_175_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みんなの　かんじた　やさしさや
うれしさを　しあわせに　かえている。
カラのなかは　しあわせ　ばかりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みんなの　感じた　優しさや
うれしさを　幸せに　変えている。
殻の中は　幸せ　ばかりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_176_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しあわせを　わけあたえるため
こころやさしい　ひとを　さがしもとめ
せかいじゅうを　とびまわっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>幸せを　分け与えるため
心優しい　人を　捜し求め
世界中を　飛び回っている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_177_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サボテンの　つぼみや　トゲを
きように　よけながら　ついばむ。
とびはねるようにして　いどうする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サボテンの　つぼみや　トゲを
器用に　避けながら　ついばむ。
飛び跳ねるようにして　移動する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_178_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かこと　みらいを　みとおせる。
まいにち　たいようの　うごきを
みつづけている　ふしぎな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>過去と　未来を　見通せる。
毎日　太陽の　動きを　見続けている
不思議な　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_179_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふわふわの　たいもうは　せいでんきが
たまると　２ばいに　ふくらむ。
さわると　かんでんしてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふわふわの　体毛は　静電気が
たまると　２倍に　膨らむ。
触ると　感電してしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_180_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいもうに　ためた　でんきが
まんたんになると　しっぽが　ひかる。
ふれると　しびれる　けを　とばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体毛に　ためた　電気が
満タンになると　しっぽが　光る。
触れると　しびれる　毛を　飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_181_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　さきが　ひかりかがやく。
むかしの　ひとたちは　その　あかりを
つかって　あいずを　おくりあった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　先が　光り輝く
昔の　人たちは　その　明かりを
使って　合図を　送りあった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_182_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおあめの　きせつが　おわると
あたたかい　ひざしに　さそわれた
キレイハナが　おどりはじめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大雨の　季節が　終わると
暖かい　日差しに　誘われた
キレイハナが　踊りはじめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_183_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽのさきに　つまった　あぶらは
みずに　うくので　どんな　ながれの
はげしい　かわでも　おぼれない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの先に　つまった　脂は
水に　浮くので　どんな　流れの
激しい　川でも　おぼれない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_184_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちにちじゅう　みずの　なかで
すごせるのは　くうきを　たっぷり
すいこんで　ためておけるからだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１日中　水の　中で
過ごせるのは　空気を　たっぷり
吸い込んで　ためておけるからだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_185_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうげき　されないように　ひたすら
きのまねをしているが　みずはにがてで
あめになると　どこかに　にげだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>攻撃　されないように　ひたすら
木のマネをしているが　水は苦手で
雨になると　どこかに　逃げ出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_186_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ニョロトノを　リーダーに　グループが
つくられる。ニョロトノの　なきごえが
ニョロモたちを　したがわせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ニョロトノを　リーダーに　グループが
作られる。ニョロトノの　鳴き声が
ニョロモたちを　従わせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_187_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かぜに　ながされて　ただよう。
のやまに　ハネッコが　あつまりだすと
はるが　おとずれると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>風に　流されて　漂う。
野山に　ハネッコが　集まりだすと
春が　訪れると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_188_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きおんが　たかくなると　はなひらく。
そらに　うかんで　ひざしを
いっぱい　あびようとする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気温が　高くなると　花開く。
空に　浮かんで　日差しを
いっぱい　浴びようとする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_189_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きせつふうに　ながされて
せかいを　いっしゅうしてしまう。
とちゅうで　わたほうしを　ばらまく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>季節風に　流されて
世界を　１周してしまう。
途中で　綿胞子を　ばらまく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_190_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てよりも　じゆうじざいに　うごく
しっぽを　たくみに　あやつりながら
たかい　きのうえで　くらしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手よりも　自由自在に　動く
しっぽを　巧みに　操りながら
高い　木の上で　暮らしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_191_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あるあさ　とつぜん　ふってくる。
なつが　さむかった　つぎの　としは
かずが　ばくはつてきに　ふえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ある朝　突然　降ってくる。
夏が　寒かった　次の　年は
数が　爆発的に　増える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_192_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたたかい　ひざしが　エネルギー。
たいようを　おいかけて　いどうする
しゅうせいで　しられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暖かい　日差しが　エネルギー。
太陽を　追いかけて　移動する
習性で　知られている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_193_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハネを　こうそくで　はためかせて
くうちゅうで　ていし　しながら
じぶんの　なわばりを　みはっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハネを　高速で　はためかせて
空中で　停止　しながら
自分の　縄張りを　見張っている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_194_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちじょうを　あるくときは　ひふが
かんそう　しないように　どくの
ねんまくで　からだを　おおっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地上を　歩くときは　皮膚が
乾燥　しないように　毒の　粘膜で
体を　おおっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_195_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふなぞこや　かわのいわに　あたまを
ぶつけまくっても　きにせず　きままに
およいでいる　のんきな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>船底や　川の岩に　頭を
ぶつけまくっても　気にせず　気ままに
泳いでいる　のんきな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_196_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんの　たいもうは　びんかん。
わずかな　くうきの　ゆれも　かんじて
これからの　てんきを　あててしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身の　体毛は　敏感。
わずかな　空気の　揺れも　感じて
これからの　天気を　当ててしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_197_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つきの　はどうを　からだに　あびると
わっかもようが　ほのかに　かがやき
ふしぎな　ちからに　めざめるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>月の　波動を　体に　浴びると
輪っか模様が　ほのかに　輝き
不思議な　力に　目覚めるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_198_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヤミカラスを　みかけて　ふよういに
あとを　つけていくと　まよわされ
やまみちに　おいてけぼりに　される。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヤミカラスを　見かけて　不用意に
後を　つけていくと　迷わされ
山道に　置いてけぼりに　される。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_199_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シェルダーに　かまれたことによって
ノーベルしょうを　じゅしょうした
かがくしゃなみの　ちのうを　えた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シェルダーに　かまれたことによって
ノーベル賞を　受賞した　科学者並の
知能を　得た。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_200_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まよなか　ひとを　おどろかせては
こわがるこころを　あつめて　じぶんの
エネルギーに　している　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>真夜中　人を　驚かせては
怖がる心を　集めて　自分の
エネルギーに　している　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_201_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１ぴきで　いても　なにも　おきないが
２ひき　いじょうで　ならぶと
なにかの　ちからが　めばえるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１匹で　いても　なにも　起きないが
２匹　以上で　並ぶと
なにかの　力が　芽生えるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_202_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろい　しっぽを　ひっしになって
かくすのは　しっぽに　ひみつがある
しょうこだと　かんぐられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒い　しっぽを　必死になって
隠すのは　しっぽに　秘密がある
証拠だと　勘ぐられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_203_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　あたまにも　ちいさな
のうがあり　うしろを　むいたままでも
ほんのうで　たたかうことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　頭にも　小さな
脳があり　後ろを　向いたままでも
本能で　戦うことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_204_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きのみに　そっくり。まちがわれて
とりポケモンに　つつかれてしまうが
かたい　カラで　まもられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>木の実に　そっくり。間違われて
とりポケモンに　つつかれてしまうが
硬い　殻で　守られている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_205_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうてつの　カラで　まもられている。
すきまから　めだまが　のぞいているが
なかみの　しょうたいは　なぞのまま。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼鉄の　殻で　守られている。
すきまから　目玉が　のぞいているが
中身の　正体は　ナゾのまま。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_206_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽで　じめんを　ほって
めいろのような　すあなを　つくる。
はねで　すこしだけ　とべる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽで　地面を　掘って
迷路のような　巣穴を　作る。
羽で　少しだけ　飛べる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_207_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そらを　すべるように　とんできて
かおに　はりつき　おどろかせてから
どくバリで　こうげき　してくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>空を　滑るように　飛んできて
顔に　はりつき　驚かせてから
毒針で　攻撃　してくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_208_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つちと　いっしょに　のみこんだ
はがねが　たまっていって　からだが
へんかしたとも　かんがえられる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>土と　一緒に　飲み込んだ
鋼が　たまっていって　体が
変化したとも　考えられる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_209_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさな　ポケモンが　にげだすほどの
こわいかおが　ぎゃくに　かわいいと
じょせいに　にんきの　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　ポケモンが　逃げ出すほどの
怖い顔が　逆に　かわいいと
女性に　人気の　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_210_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かおに　にあわず　おくびょう。
しかし　ひとたび　おこりはじめると
おおきな　キバで　はんげきする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>顔に　似合わず　おくびょう。
しかし　ひとたび　怒りはじめると
大きな　キバで　反撃する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_211_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんの　どくバリを
しほうはっぽうに　うちだす。
まるい　からだは　およぎが　にがて。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身の　毒針を
四方八方に　撃ち出す。
丸い　体は　泳ぎが　苦手。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_212_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めだまもようの　ついた　はさみを
ふりあげて　いかくする　だけでなく
そのまま　ふりおろすので　きけんだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目玉模様の　ついた　ハサミを
振り上げて　威嚇する　だけでなく
そのまま　振り下ろすので　危険だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_213_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうらの　なかに　きのみを　ためる。
そのうち　きのみは　はっこうして
おいしい　ジュースに　なるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甲羅の　中に　木の実を　ためる。
そのうち　木の実は　発酵して
おいしい　ジュースに　なるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_214_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまいミツが　だいすきで
ひとりじめ　するため　じまんのツノを
つかって　あいてを　ぶんなげる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甘いミツが　大好きで
独り占め　するため　自慢のツノを
使って　相手を　ぶん投げる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_215_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ずるがしこく　いっぴきが　おやを
おびきよせ　もういっぴきが　タマゴを
とるという　チームプレーも　みせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ずるがしこく　１匹が　親を
誘き寄せ　もう１匹が　タマゴを
取るという　チームプレーも　見せる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_216_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまい　ミツを　てのひらに
しみこませて　いつも　なめている。
ヒメグマによって　あじが　ちがう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甘い　ミツを　手のひらに
染み込ませて　いつも　なめている。
ヒメグマによって　味が　違う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_217_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばりにある　おいしい　きのみや
くだものの　なる　き　には
ツメで　きずあとを　つける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張りにある　おいしい　木の実や
果物の　なる　木　には
ツメで　傷跡を　つける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_218_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようがんで　できた　からだを　もつ。
たえず　うごいていないと　からだが
ひえて　かたまってしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>溶岩で　できた　体を　持つ。
絶えず　動いていないと　体が
冷えて　固まってしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_219_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいおんは　やく１まんど。
マグマが　かたまって　できた　カラの
すきまから　ほのおを　ふきだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体温は　約１万度。
マグマが　固まって　できた　殻の
すきまから　炎を　吹き出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_220_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>においに　びんかんで　こおりのしたに
うもれた　キノコや　きのみの　ほかに
おんせんさえも　さぐりあててしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>においに　敏感で　氷の下に
埋もれた　キノコや　木の実の　ほかに
温泉さえも　探り当ててしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_221_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながい　たいもうに　おおわれていて
さむさに　つよく　こおりの　キバは
ゆきがふると　さらに　ふとくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長い　体毛に　おおわれていて
寒さに　強く　氷の　キバは
雪が降ると　さらに　太くなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_222_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みなみの　きれいな　うみには
たくさんの　サニーゴが　いる。
よごれた　うみでは　いきられない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>南の　きれいな　海には
たくさんの　サニーゴが　いる。
汚れた　海では　生きられない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_223_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くちから　いきおいよく　ふきだす
みずは　ふかい　うみのなか　からでも
ねらった　えものに　かならずあたる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>口から　勢いよく　吹き出す
水は　深い　海の中　からでも
ねらった　獲物に　かならず当たる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_224_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いわあなに　もぐりこむのが　すき。
そのまま　くちだけだして　えものに
スミを　ふきかけることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>岩穴に　潜り込むのが　好き。
そのまま　口だけ出して　獲物に
スミを　吹きかけることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_225_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽで　エサを　つつんで　はこぶ。
やまで　そうなんした　ひとに
エサを　わけあたえる　しゅうせい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽで　エサを　包んで　運ぶ。
山で　遭難した　人に
エサを　分け与える　習性。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_226_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆうぜんと　うみを　およぐうちに
たべのこしを　ねらった　テッポウオが
ひれに　くっつくが　きにしていない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>悠然と　海を　泳ぐうちに
食べ残しを　ねらった　テッポウオが
ヒレに　くっつくが　気にしていない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_227_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てつのような　かたい　よろいに
おおわれている。じそく３００キロの
スピードで　おおぞらを　とびまわる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鉄のような　硬い　よろいに
おおわれている。時速３００キロの
スピードで　大空を　飛び回る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_228_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さまざまな　なきごえを　つかいわけ
なかまと　コミュニケーションしながら
かりを　おこなう　かしこさをもつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>様々な　鳴き声を　使い分け
仲間と　コミュニケーションしながら
狩りを　おこなう　賢さを持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_229_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おこったときに　くちから　ふきだす
ほのおには　どくそも　まじっていて
やけどになると　いつまでも　うずく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怒ったときに　口から　吹き出す
炎には　毒素も　混じっていて
やけどになると　いつまでも　うずく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_230_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいていどうくつに　すんでいる。
キングドラが　みうごきすると
きょだいな　うずしおが　うまれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海底洞くつに　住んでいる。
キングドラが　身動きすると
巨大な　渦潮が　生まれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_231_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだは　ちいさいが　ちからもち。
おとなの　ひとを　かるがると
せなかに　のせて　あるいてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体は　小さいが　力持ち。
大人の　人を　軽々と
背中に　乗せて　歩いてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_232_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだを　まるめて　かいてんしながら
とっしんする　こうげき。いちげきで
みんかを　ばらばらに　ふきとばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を　丸めて　回転しながら
突進する　攻撃。一撃で　民家を
バラバラに　吹き飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_233_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わくせい　かいはつが　できるように
バージョンアップ　されたのだが
まだまだ　むずかしかった　ようだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>惑星　開発が　できるように
バージョンアップ　されたのだが
まだまだ　難しかった　ようだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_234_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツノを　みつめていると　わっかの
ちゅうしんに　すいこまれそうな
ふしぎな　きぶんに　なってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツノを　見つめていると　輪っかの
中心に　吸い込まれそうな
不思議な　気分に　なってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_235_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽを　ふでのように　つかって
なわばりに　マークを　えがく。
その　しゅるいは　５０００いじょう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽを　筆のように　使って
縄張りを　マークで　描く。
その　種類は　５０００以上。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_236_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>けんかっぱやいことで　ゆうめい。
じぶんよりも　おおきな　あいてに
いどみかかるので　きずが　たえない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ケンカっぱやいことで　有名。
自分よりも　大きな　相手に
挑みかかるので　傷が　絶えない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_237_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コマのように　かいてんしながら
たたかう。えんしんりょくの　パワーで
はかいりょくは　１０ばいだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コマのように　回転しながら　戦う。
遠心力の　パワーで
破壊力は　１０倍だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_238_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　くちびるで　ふれてみて
たしかめる。すきな　ものも　きらいな
ものも　くちびるが　おぼえている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　唇で　触れてみて
確かめる。好きな　物も　嫌いな　物も
唇が　覚えている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_239_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツノの　あいだには　よわいけれど
でんきが　ながれているので　うっかり
てを　いれると　しびれてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツノの　あいだには　弱いけれど
電気が　流れているので　うっかり
手を　入れると　しびれてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_240_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マグマのような　けつえきが
たいないに　ながれているため
たいおんは　６００どにも　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マグマのような　血液が
体内に　流れているため
体温は　６００度にも　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_241_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミルタンクの　ミルクを　のんで
そだった　こどもは　けんこうで
たくましい　おとなに　なるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミルタンクの　ミルクを　飲んで
育った　子供は　健康で
たくましい　大人に　なるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_242_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハピナスの　うむ　タマゴには
しあわせが　つまっていて　ひとくち
たべると　だれでも　えがおになれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハピナスの　生む　タマゴには
幸せが　つまっていて　ひとくち
食べると　だれでも　笑顔になれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_243_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カミナリと　ともに　おちてきたと
いわれている。せなかの　あまぐもから
カミナリを　うちだすことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雷と　ともに　落ちてきたと
言われている。背中の　雨雲から
雷を　撃ち出すことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_244_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エンテイが　ほえると
せかいの　どこかの　かざんが
ふんかすると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エンテイが　ほえると
世界の　どこかの　火山が
噴火すると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_245_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいじゅうを　かけめぐり
よごれた　みずを　きよめている。
きたかぜと　ともに　はしりさる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界中を　駆け巡り
汚れた　水を　清めている。
北風と　ともに　走り去る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_246_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つちを　たべる　ポケモン。
おおきな　やまを　たいらげると
せいちょうのため　ねむりはじめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>土を　食べる　ポケモン。
大きな　山を　たいらげると
成長のため　眠りはじめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_247_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんばんのような　かたい　からだ。
あっしゅくした　ガスを　ふんしゃして
まるで　ロケットのように　とびだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>岩盤のような　硬い　体。
圧縮した　ガスを　噴射して
まるで　ロケットのように　飛び出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_248_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バンギラスが　あばれると
やまが　くずれ　かわが　うまるため
ちずを　かきかえる　ことになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バンギラスが　暴れると
山が　崩れ　川が　埋まるため
地図を　書き換える　ことになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_249_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふかい　かいこうの　そこで　ねむる。
ルギアが　はばたくと　４０にち
あらしが　つづくと　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深い　海溝の　底で　眠る。
ルギアが　羽ばたくと　４０日
あらしが　続くと　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_250_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なないろの　つばさを　もつ。
ホウオウを　みた　ものは　えいえんの
しあわせが　やくそくされるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>七色の　翼を　持つ。
ホウオウを　見た　者は
永遠の　幸せが　約束されるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_251_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じかんを　こえる　ちからを　つかう。
へいわな　じだいにだけ
すがたを　みせると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>時間を　越える　力を　使う。
平和な　時代にだけ
姿を　見せると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_252_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あしの　うらには　ちいさな　トゲが
たくさん　ついているので　かべや
てんじょうを　あるくことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>足の　裏には　小さな　トゲが
たくさん　ついているので
壁や　天井を　歩くことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_253_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みつりんに　せいそくする。
えだから　えだへ　とびうつりながら
いどうして　えものに　せっきんする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>密林に　生息する。
枝から　枝へ　飛び移りながら
移動して　獲物に　接近する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_254_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うでに　はえた　はっぱは　たいぼくも
すっぱり　きりたおす　きれあじ。
みつりんの　たたかいでは　むてき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腕に　生えた　葉っぱは　大木も
スッパリ　切り倒す　切れ味。
密林の　戦いでは　無敵。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_255_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないで　ほのおが　もえているので
だきしめると　とても　あたたかい。
１０００どの　ひのたまを　とばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内で　炎が　燃えているので
抱きしめると　とても　温かい。
１０００度の　火の玉を　飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_256_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１びょうかんに　キックを　１０ぱつ
くりだす　あしわざの　もちぬし。
するどい　なきごえで　いかくする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１秒間に　キックを　１０発
繰り出す　足技の　持ち主。
鋭い　鳴き声で　威嚇する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_257_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てくびから　ふきだした　ほのおで
こぶしを　つつみこんだ　パンチは
あいてを　くろこげに　してしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手首から　吹き出した　炎で
こぶしを　包み込んだ　パンチは
相手を　黒コゲに　してしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_258_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　ひれで　みずの　ながれを
かんじて　まわりの　ようすを　しる。
いわを　もちあげる　ちからもち。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　ヒレで　水の　流れを
感じて　まわりの　様子を　知る。
岩を　持ち上げる　力持ち。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_259_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬかるんだ　あしばでも　しっかり
あるける　じょうぶな　あしこし。
どろに　からだを　うめて　ねむる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬかるんだ　足場でも　しっかり
歩ける　丈夫な　足腰。
泥に　体を　埋めて　眠る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_260_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおがたせんを　ひっぱって　およぐ
パワーの　もちぬし。ふとい　うでの
ひとふりで　あいてを　たたきのめす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大型船を　引っ張って　泳ぐ
パワーの　持ち主。太い　腕の
一振りで　相手を　たたきのめす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_261_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しつこい　せいかくの　ポケモン。
めをつけた　えものが　ヘトヘトに
つかれるまで　おいかけまわす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しつこい　性格の　ポケモン。
目をつけた　獲物が　ヘトヘトに
疲れるまで　追いかけ回す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_262_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むれで　えものを　おいつめる。
すぐれた　トレーナーの　めいれいには
ぜったいに　さからわない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>群れで　獲物を　追いつめる。
優れた　トレーナーの　命令には
絶対に　逆らわない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_263_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジグザグに　あるいて　くさかげや
じめんに　うまっている　たからものを
みつけるのが　とくいな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジグザグに　歩いて　草陰や
地面に　埋まっている　宝物を
見つけるのが　得意な　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_264_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じそく１００キロで　えものに
おそいかかるが　まっすぐにしか
はしれないので　しっぱいも　おおい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>時速１００キロで　獲物に
襲いかかるが　真っ直ぐにしか
走れないので　失敗も　多い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_265_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とりポケモンに　よく　ねらわれるが
おしりの　トゲから　どくをだし
ひっしになって　ていこうする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とりポケモンに　よく　ねらわれるが
おしりの　トゲから　毒を出し
必死になって　抵抗する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_266_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いとを　きのえだに　まきつけている。
いとについた　あまみずを　のみながら
しんかの　ときを　まっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>糸を　木の枝に　巻きつけている。
糸についた　雨水を　飲みながら
進化の　ときを　待っている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_267_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みために　よらず　こうげきてきで
かふんあつめの　じゃまを　すると
ほそながい　くちを　つきさしてくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>見た目に　よらず　攻撃的で
花粉集めの　邪魔を　すると
細長い　口を　突き刺してくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_268_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マユに　こもっている　あいだに
うけた　こうげきは　しんかしても
わすれずに　かならず　しかえしする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マユに　こもっている　あいだに
受けた　攻撃は　進化しても
忘れずに　かならず　仕返しする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_269_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はばたくたびに　どくのこなが　まう。
よるの　あいだに　がいろじゅの
はっぱを　くいちらかすことも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>羽ばたくたびに　毒の粉が　舞う。
夜の　あいだ　街路樹の　葉っぱを
食い散らかすことも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_270_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みずくさに　そっくりな　ポケモン。
およげない　ポケモンを　はっぱに
のせて　むこうぎしまで　はこぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>水草に　そっくりな　ポケモン。
泳げない　ポケモンを　葉っぱに
乗せて　向こう岸まで　運ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_271_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つりびとを　みつけると
すいちゅうから　つりいとを　ひっぱり
ジャマして　よろこぶ　いたずらもの。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>釣り人を　見つけると
水中から　釣り糸を　引っ張り
ジャマして　喜ぶ　いたずらもの。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_272_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようきな　おんがくを　きくと
からだじゅうに　ちからが　みなぎり
おどらずには　いられなくなるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>陽気な　音楽を　聴くと
体中に　力が　みなぎり
踊らずには　いられなくなるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_273_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えだに　ぶらさがっていると
きのみに　そっくり。ついばもうとした
ポケモンを　おどろかせて　よろこぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>枝に　ぶらさがっていると
木の実に　そっくり。ついばもうとした
ポケモンを　驚かせて　喜ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_274_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コノハナが　かなでる　くさぶえの
ねいろは　ひとを　ふあんにさせる。
もりの　おくに　すんでいる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コノハナが　奏でる　草笛の　音色は
人を　不安にさせる。
森の　奥に　住んでいる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_275_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はっぱの　うちわを　あおぐと
ふうそく３０メートルの　とっぷうが
まきおこり　みんかを　ふきとばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>葉っぱの　ウチワを　あおぐと
風速３０メートルの　突風が
巻き起こり　民家を　吹き飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_276_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよい　あいてにも　ゆうかんに
たちむかう　こんじょうの　もちぬし。
あたたかい　とちを　めざして　とぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強い　相手にも　勇敢に
立ち向かう　根性の　持ち主。
暖かい　土地を　目指して　飛ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_277_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょうくうを　せんかいしながら
えものを　さがし　まっさかさまに
きゅうこうかして　つかまえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>上空を　旋回しながら
獲物を　探し　真っ逆さまに
急降下して　捕まえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_278_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょうしょう　きりゅうに　のって
グライダーのように　おおぞらを　まい
くちばしに　はさんだ　エサをはこぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>上昇　気流に　乗って
グライダーのように　大空を　舞い
クチバシに　挟んだ　エサを運ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_279_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くちのなかに　ちいさなポケモンや
タマゴをいれて　あんぜんな　ばしょに
とどけてくれる　そらの　はこびや。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>口の中に　小さなポケモンや
タマゴを入れて　安全な　場所に
届けてくれる　空の　運び屋。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_280_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あかいツノで　ひとや　ポケモンの
あたたかな　きもちを　キャッチすると
ぜんしんが　ほのかに　あつくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>赤いツノで　人や　ポケモンの
温かな　気持ちを　キャッチすると
全身が　ほのかに　熱くなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_281_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーが　よろこぶと
キルリアに　エネルギーが　みちあふれ
たのしそうに　くるくると　おどる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーが　喜ぶと
キルリアに　エネルギーが　満ちあふれ
楽しそうに　くるくると　踊る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_282_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーを　まもるためなら
サイコパワーを　つかいきり　ちいさな
ブラックホールを　つくりだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーを　守るためなら
サイコパワーを　使いきり　小さな
ブラックホールを　作り出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_283_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すいめんを　すべるように　あるく。
あたまの　さきから　あまい　においを
だして　えものを　さそう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>水面を　滑るように　歩く。
頭の　先から　甘い　においを
出して　獲物を　誘う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_284_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めだまもようの　しょっかくを　もつ。
４まいの　はねで　うかびあがり
ぜんごさゆうに　うごくことができる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目玉模様の　触角を　持つ。
４枚の　ハネで　浮かび上がり
前後左右に　動くことができる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_285_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　てっぺんから　どくほうしを
ふきだす。ほうしを　すいこむと
からだの　ふしぶしが　いたくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　てっぺんから　毒胞子を
吹き出す。胞子を　吸い込むと
体の　節々が　痛くなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_286_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みじかい　うでは　パンチを　だすとき
ぐーんと　のびる。プロボクサー
かおまけの　テクニックを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>短い　腕は　パンチを　出すとき
グーンと　伸びる。プロボクサー
顔負けの　テクニックを　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_287_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１にちのうち　ほとんどの　じかんを
ねころがって　すごす。その　ようすを
みていると　ねむけに　おそわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１日のうち　ほとんどの　時間を
寝転がって　過ごす。その　様子を
見ていると　眠気に　襲われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_288_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんぞうが　１０ばいの　テンポで
こどう　しているため
ひとときも　じっとしていられない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>心臓が　１０倍の　テンポで
鼓動　しているため
ひとときも　じっとしていられない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_289_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいいち　ぐうたらな　ポケモン。
ねころがっているだけに　みえるが
はんげきの　パワーを　ためている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界一　ぐうたらな　ポケモン。
寝転がっているだけに　見えるが
反撃の　パワーを　ためている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_290_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じめんの　したで　せいちょうする。
ほとんど　みえない　めの　かわりに
しょっかくで　ようすを　さぐる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地面の　下で　成長する。
ほとんど　見えない　目の　代わりに
触角で　様子を　探る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_291_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまりに　こうそくで　うごくため
すがたが　みえなくなる　ことがある。
じゅえきに　あつまってくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あまりに　高速で　動くため
姿が　見えなくなる　ことがある。
樹液に　集まってくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_292_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬけがらが　たましいを　やどした。
せなかの　すきまから　のぞきこむと
たましいを　すわれてしまうらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>抜け殻が　魂を　宿した。
背中の　すきまから　のぞき込むと
魂を　吸われてしまうらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_293_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふだんは　ささやくような　なきごえ。
ふあんになると　ジェットきと　おなじ
おんりょうで　なきつづける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>普段は　ささやくような　鳴き声。
不安になると　ジェット機と　同じ
音量で　鳴き続ける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_294_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおごえの　しょうげきはで
トラックを　ひっくりかえしてしまう。
あしを　ふみならして　パワーアップ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大声の　衝撃波で
トラックを　ひっくりかえしてしまう。
足を　踏みならして　パワーアップ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_295_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バクオングの　とおぼえは　１０キロ
さきまで　とどく。からだじゅうの
あなから　さまざまな　おとを　だす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バグオングの　とおぼえは　１０キロ
先まで　届く。体中の　穴から
様々な　音を　出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_296_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふとい　きのみきに　ぶつかって
からだを　きたえる。すみかの　そばは
へしおられた　きが　たくさんある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太い　木の幹に　ぶつかって
体を　鍛える。住処の　そばは
へし折られた　木が　たくさんある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_297_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　おおきな　ポケモンたちと
ちからくらべをすることが　だいすき。
はりてで　トラックを　ふっとばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　大きな　ポケモンたちと
力比べをすることが　大好き。
張り手で　トラックを　ぶっ飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_298_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゴムボールのように　よく　はずむ
しっぽを　ふりまわし　じぶんよりも
おおきな　あいてに　たちむかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゴムボールのように　よく　弾む。
しっぽを　振り回し　自分よりも
大きな　相手に　立ち向かう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_299_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ピンチになると　じりょくを　つよめ
まわりにある　てつの　かたまりを
ひきよせて　みをまもることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ピンチになると　磁力を　強め
まわりにある　鉄の　塊を
引き寄せて　身を守ることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_300_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うごくものを　つい　おってしまう。
じぶんの　しっぽを　おいかけて
おなじ　ばしょを　グルグル　まわる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>動くものを　つい　追ってしまう。
自分の　しっぽを　追いかけて
同じ　場所を　グルグル　回る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_301_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うつくしい　けなみを　もち
じょせいトレーナーに　だいにんき。
きまった　すみかを　もたない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>美しい　毛並みを　持ち
女性トレーナーに　大人気。
決まった　住処を　持たない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_302_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうくつの　くらやみに　ひそむ。
ほうせきを　たべているうちに
めが　ほうせきに　なってしまった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>洞くつの　くらやみに　潜む。
宝石を　食べているうちに
目が　宝石に　なってしまった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_303_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツノが　へんけいして　できた
おおあごが　あたまに　ついている。
てっこつを　かみきってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツノが　変形して　できた
大アゴが　頭に　ついている。
鉄骨を　かみきってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_304_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふだんは　やまおくで　くらしているが
おなかが　すくと　ふもとに　あらわれ
せんろや　くるまを　たべてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>普段は　山奥で　暮らしているが
お腹が　すくと　ふもとに　現われ
線路や　車を　食べてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_305_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てっこうせきを　ほりだして　たべる。
はがねの　からだを　ぶつけあって
なわばりあらそいをする　しゅうせい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鉄鉱石を　掘り出して　食べる。
鋼の　体を　ぶつけ合って
縄張り争いをする　習性。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_306_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はがねの　ツノで　かたい　がんばんを
つきくずしながら　しょくりょうの
てつを　さがして　トンネルを　ほる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼の　ツノで　硬い　岩盤を
突き崩しながら　食料の
鉄を　探して　トンネルを　掘る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_307_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつもは　やまおくで　しゅぎょう。
めいそうをして　せいしんりょくを
たかめると　からだが　うかびあがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつもは　山奥で　修行。
めいそうをして　精神力を　高めると
体が　浮かび上がる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_308_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにも　たべずに　ただひたすらに
せいしんを　とぎすませると
あいてのオーラが　みえるようになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なにも　食べずに　ただひたすらに
精神を　研ぎ澄ませると
相手のオーラが　見えるようになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_309_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいもうに　ためた　でんきを　つかい
きんにくを　しげきすることで
しゅんぱつりょくを　たかめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体毛に　ためた　電気を　使い
筋肉を　刺激することで
瞬発力を　高める。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_310_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たてがみから　ほうでんしている。
ずじょうに　かみなりぐもを　つくり
いなずまを　おとして　こうげきする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たてがみから　放電している。
頭上に　雷雲を　作り
稲妻を　落として　攻撃する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_311_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひばなの　ボンボンを　つくって
なかまを　おうえんする。
でんちゅうから　でんきを　すいとる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>火花の　ボンボンを　作って
仲間を　応援する。
電柱から　電気を　吸い取る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_312_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なかまを　おうえんする　しゅうせい。
まけそうになると　からだから　だす
ひばなの　かずが　どんどん　ふえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仲間を　応援する　習性。
負けそうになると　体から　出す
火花の　数が　どんどん　増える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_313_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よるになると　おしりを　ひからせ
なかまと　かいわする。イルミーゼの
だす　あまい　かおりが　だいすき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夜になると　おしりを　光らせ
仲間と　会話する。イルミーゼの
出す　甘い　香りが　大好き。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_314_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまい　かおりで　バルビートを
ゆうどうして　よぞらに
ひかりの　サインを　えがく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甘い　香りで　バルビートを
誘導して　夜空に
光の　サインを　描く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_315_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げんきな　ロゼリアほど　はなから
いい　かおりを　かもしだし　かいだ
ひとを　とても　リラックスさせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>元気な　ロゼリアほど　花から
いい　香りを　醸し出し　かいだ
人を　とても　リラックスさせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_316_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　ほとんどが　いぶくろ。
きょうりょくな　いえきで　のみこんだ
ものを　たちまち　しょうかする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　ほとんどが　胃袋。
強力な　胃液で　飲み込んだ　ものを
たちまち　消化する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_317_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　まるのみしてしまう。
けあなから　もうどくの　たいえきを
ぶんぴつして　てきに　あびせかける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　まるのみしてしまう。
毛穴から　猛毒の　体液を
分泌して　敵に　浴びせかける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_318_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばりに　はいってきた　あいてを
しゅうだんで　こうげき。するどい
キバは　ボートの　そこも　かみきる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張りに　入って来た　相手を
集団で　攻撃。鋭い　キバは
ボートの　底も　かみきる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_319_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てっぱんも　かみちぎる　キバを　もち
およぐ　そくどは　じそく１２０キロ。
べつめいは　うみのギャング。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鉄板も　かみちぎる　キバを　持ち
泳ぐ　速度は　時速１２０キロ。
別名は　海のギャング。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_320_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はれた　ひは　すなはまに　あがり
ボールのように　はずんで　あそぶ。
はなから　みずを　ふきあげる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>晴れた　日は　砂浜に　上がり
ボールのように　弾んで　遊ぶ。
鼻から　水を　吹き上げる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_321_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちばん　おおきい　ポケモン。
いきつぎせずに　３０００メートルの
ふかさまで　もぐることが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一番　大きい　ポケモン。
息つぎせずに　３０００メートルの
深さまで　潜ることが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_322_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゃくねつの　マグマを　せなかの
コブに　ためている。あめに　あたると
マグマが　ひえて　うごきが　にぶる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しゃく熱の　マグマを　背中の
コブに　ためている。雨に　当たると
マグマが　冷えて　動きが　鈍る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_323_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せなかに　かざんを　もつ　ポケモン。
たいないの　マグマが　ふえると
ふるえた　あとに　だいばくはつする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>背中に　火山を　持つ　ポケモン。
体内の　マグマが　増えると
震えた　後に　大爆発する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_324_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうらの　なかで　せきたんを　もやし
エネルギーに　している。ピンチの
ときは　くろい　ススを　ふきだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甲羅の　中で　石炭を　燃やし
エネルギーに　している。ピンチの
ときは　黒い　ススを　吹き出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_325_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽを　バネのかわりに　いつも
とびはねている。はねる　しんどうで
しんぞうを　こどう　させているのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽを　バネの代わりに　いつも
跳びはねている。跳ねる　振動で
心臓を　鼓動　させているのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_326_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろしんじゅで　サイコパワーを
ぞうふくさせる。ふしぎな　ステップで
あいての　こころを　あやつる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒真珠で　サイコパワーを
増幅させる。不思議な　ステップで
相手の　心を　操る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_327_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなじ　ブチもようの　パッチールは
いない。フラフラした　あしどりで
あいての　ねらいを　はずす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>同じ　ブチ模様の　パッチールは
いない。フラフラした　足取りで
相手の　ねらいを　外す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_328_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さばくに　つくった　すりばちがたの
あなの　そこで　えものが　はまって
おちてくるのを　まちつづける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂漠に　作った　すり鉢型の
穴の　底で　獲物が　はまって
落ちてくるのを　待ち続ける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_329_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はねを　はげしく　しんどうさせて
ちょうおんぱを　だす。にんげんも
ずつうを　おこすほど　きょうりょく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハネを　激しく　振動させて
超音波を　出す。人間も　頭痛を
起こすほど　強力。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_330_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうれつな　ハネの　はばたきで
すなあらしを　おこす。
さばくのせいれい　と　よばれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強烈な　ハネの　羽ばたきで
砂あらしを　起こす。
砂漠の精霊と　呼ばれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_331_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さばくに　せいそく。たいないに
すいぶんを　ためることで　みずを
のまずに　３０にちかん　いきられる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂漠に　生息。体内に
水分を　ためることで　水を　飲まずに
３０日間　生きられる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_332_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よるになると　かつどうを　はじめる。
さばくの　あつさに　つかれはてた
えものを　みつけだし　とらえるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夜になると　活動を　はじめる。
砂漠の　暑さに　疲れ果てた
獲物を　見つけ出し　捕らえるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_333_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんも　まわりも　きれいでないと
おちつかない　せいかくの　ポケモン。
よごれをみつけると　はねでふきとる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分も　まわりも　きれいでないと
落ち着かない　性格の　ポケモン。
汚れを見つけると　羽でふき取る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_334_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こころが　かよいあった　ひとがいると
やわらかく　うつくしい　はねで
そっと　つつみこみ　ハミングする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>心が　通い合った　人がいると
やわらかく　美しい　羽で
そっと　包み込み　ハミングする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_335_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんせだいにも　わたって
ハブネークと　たたかってきた。
するどい　ツメが　さいだいの　ぶき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>何世代にも　渡って
ハブネークと　戦ってきた。
鋭い　ツメが　最大の　武器。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_336_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せんぞだいだい　ザングースと
たたかってきた。しっぽの　やいばを
いわで　とぎ　たたかいに　そなえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>先祖代々　ザングースと　戦ってきた。
しっぽの　刃を　岩で　研ぎ
戦いに　備える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_337_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まんげつの　よるになると　かっぱつに
かつどうするため　つきの　みちかけと
かんけいしていると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>満月の　夜になると　活発に
活動するため　月の　満ち欠けと
関係していると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_338_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいようの　ぶんしんと　うわさされる
しんしゅの　ポケモン。からだを
かいてんさせて　ひかりを　はなつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太陽の　分身と　ウワサされる
新種の　ポケモン。体を　回転させて
光を　放つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_339_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬるぬるの　からだは　つかみにくい。
ある　ちほうでは　どろが　かたまって
ドジョッチが　うまれたと　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬるぬるの　体は　つかみにくい。
ある　地方では　泥が　固まって
ドジョッチが　生まれたと　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_340_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばりいしきが　とても　つよく
がいてきが　ちかづくと　はげしく
じめんを　ゆらして　おそいかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張り意識が　とても　強く
外敵が　近づくと　激しく
地面を　揺らして　襲いかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_341_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　かんきょうにも　てきおうする
つよい　せいめいりょくの　もちぬし。
はさんだ　えものは　はなさない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんな　環境にも　適応する
強い　生命力の　持ち主。
挟んだ　獲物は　離さない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_342_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いけに　すむ　ほかの　ポケモンを
ハサミで　つまみあげ　いけの　そとへ
ほうりだしてしまう　あばれんぼう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>池に　住む　ほかの　ポケモンを
ハサミで　つまみ上げ　池の　外へ
放り出してしまう　暴れん坊。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_343_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっぽんあしで　かいてんしながら
いどうする。こだいの　いせきから
みつかった　めずらしい　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一本足で　回転しながら　移動する。
古代の　遺跡から　見つかった
珍しい　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_344_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こだいの　どろにんぎょうが
かいこうせんを　あびたことで
いのちが　やどり　ポケモンとなった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古代の　泥人形が
怪光線を　浴びたことで
命が　宿り　ポケモンとなった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_345_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>およそ　１おくねんまえの　かいていで
くらしていた　こだいの　ポケモン。
かがくの　ちからで　ふっかつした。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>およそ　１億年前の　海底で
暮らしていた　古代の　ポケモン。
科学の　力で　復活した。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_346_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたたかい　うみの　あさせに　いる。
しおが　ひくと　すなはまに　もぐった
えものを　ほりだして　たべる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暖かい　海の　浅瀬に　いる。
潮が　引くと　砂浜に　潜った
獲物を　掘り出して　食べる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_347_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かせきから　ふっかつした　ポケモンの
せんぞの　いっしゅ。うみで　くらし
ツメで　えものを　つかまえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>化石から　復活した　ポケモンの
先祖の　一種。海で　暮らし
ツメで　獲物を　捕まえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_348_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかして　ちじょうで　くらすように
なった。ぜんしんが　がんじょうな
よろいに　おおわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>進化して　地上で　暮らすように
なった。全身が　頑丈な
よろいに　おおわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_349_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みすぼらしく　みにくい　ポケモンだが
しぶとい　せいめいりょくを　もち
わずかな　みずだけでも　いきのびる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みすぼらしく　醜い　ポケモンだが
しぶとい　生命力を　持ち
わずかな　水だけでも　生き延びる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_350_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にじいろと　いわれる　きれいな
ウロコは　みるほうこうを　かえると
さまざまな　いろに　へんかする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>にじ色と　言われる　きれいな
ウロコは　見る方向を　変えると
様々な　色に　変化する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_351_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんきによって　すがたが　かわる。
みずの　ぶんしと　そっくりなことが
さいきんになって　はっけんされた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>天気によって　姿が　変わる。
水の　分子と　そっくりなことが
最近になって　発見された。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_352_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　いろを　じゆうに　かえる
のうりょくを　もつ。おなかにある
ギザギザもよう　だけは　かわらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　色を　自由に　変える
能力を　持つ。お腹にある
ギザギザ模様　だけは　変わらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_353_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うらみの　かんじょうが　だいすき。
うらみを　もつ　ひとが　すむ　いえの
のきしたに　ずらりと　ぶらさがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>恨みの　感情が　大好き。
恨みを　持つ　人が　住む　家の
軒下に　ずらりと　ぶらさがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_354_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すてられた　ぬいぐるみに　おんねんが
やどり　ポケモンになった。じぶんを
すてた　こどもを　さがしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>捨てられた　ぬいぐるみに　おんねんが
宿り　ポケモンになった。自分を
捨てた　子供を　捜している。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_355_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こどもの　なきごえが　だいすきで
ぶあつい　かべも　とおりぬけて
わるいこを　おどろかせ　なかせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>子供の　泣き声が　大好きで
分厚い　壁も　通り抜けて
悪い子を　驚かせ　泣かせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_356_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さまよっている　ひとだまを　みつけ
からっぽの　たいないに　すいこむ。
すいこまれて　どうなるかは　なぞ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さ迷っている　人魂を　見つけ
からっぽの　体内に　吸い込む。
吸い込まれて　どうなるかは　ナゾ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_357_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつも　おなじ　くだものばかり
たべていたら　のどもとに　とても
おいしい　くだものが　はえてきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつも　同じ　果物ばかり
食べていたら　のど元に　とても
おいしい　果物が　生えてきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_358_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なきごえは　からだの　くうどうで
ひびきあって　きれいな　ねいろになり
てきをおどろかせ　おいはらっていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鳴き声は　体の　空洞で
響き合って　きれいな　音色になり
敵を驚かせ　追い払っていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_359_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツノが　わざわいを　かんちすると
うわさされ　ねらわれたため
やまおくに　すがたを　けした。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツノが　災いを　感知すると
ウワサされ　ねらわれたため
山奥に　姿を　消した。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_360_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なかまたちと　おしくらまんじゅうを
やることで　がまんづよく　そだつ。
あまい　くだものが　だいこうぶつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仲間たちと　おしくらまんじゅうを
やることで　我慢強く　育つ。
甘い　果物が　大好物。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_361_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　はっぱの　したに
すうひきの　ユキワラシが　あつまり
なかよく　くらしているという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　葉っぱの　下に
数匹の　ユキワラシが　集まり
仲良く　暮らしているという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_362_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くうきちゅうの　すいぶんを
いっしゅんで　こおらせることで
えものが　にげられないように　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>空気中の　水分を
一瞬で　凍らせることで
獲物が　逃げられないように　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_363_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りゅうひょうの　うえを　コロコロと
ころがって　かいがんに　たどりつく。
およぐには　ふべんな　たいけい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>流氷の　上を　コロコロと
転がって　海岸に　たどり着く。
泳ぐには　不便な　体型。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_364_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　はなの　うえで　まわす
クセを　もつ。まわしながら　においや
かんしょくを　おぼえるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　鼻の　上で　回す
クセを　持つ。回しながら　においや
感触を　覚えるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_365_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　こおりを　キバで　くだく。
あつい　しぼうは　さむさだけでなく
てきの　こうげきも　はねかえす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　氷を　キバで　砕く。
厚い　脂肪は　寒さだけでなく
敵の　攻撃も　はね返す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_366_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっしょうに　１こだけ　つくる
しんじゅは　サイコパワーを
ぞうふくする　さようが　あるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一生に　１個だけ　作る
真珠は　サイコパワーを
増幅する　作用が　あるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_367_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかいに　せいそくする　ポケモン。
こざかなの　かたちをした　しっぽで
えものを　おびきよせ　つかまえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深海に　生息する　ポケモン。
小魚の　形をした　しっぽで
獲物を　誘き寄せ　捕まえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_368_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うみの　そこで　くらしているが
はるになると　からだの　ピンクいろが
なぜか　あざやかに　いろづく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海の　底で　暮らしているが
春になると　体の　ピンク色が
なぜか　鮮やかに　色づく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_369_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかいちょうさで　はっけんされた
めずらしい　ポケモン。１おくねんの
あいだ　すがたが　かわっていない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深海調査で　発見された
珍しい　ポケモン。１億年の　あいだ
姿が　変わっていない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_370_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたたかい　うみに　せいそくする。
ラブカスを　みつけた　カップルは
えいえんの　あいが　つづくという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暖かい　海に　生息する。
ラブカスを　見つけた　カップルは
永遠の　愛が　続くという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_371_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおぞらを　とぶことを　ゆめみて
まいにち　とぶ　れんしゅうのために
がけから　とびおりている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大空を　飛ぶことを　夢見て
毎日　飛ぶ　練習のために
ガケから　飛び降りている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_372_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かたい　カラの　なかでは　さいぼうが
へんかを　はじめている。しんかする
しゅんかんに　カラが　はがれおちる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>硬い　殻の　中では　細胞が
変化を　始めている。進化する
瞬間に　殻が　はがれ落ちる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_373_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そらを　とぶことを　ねがいつづけた
けっか　からだの　さいぼうが
へんかして　つばさが　はえてきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>空を　飛ぶことを　願い続けた　結果
体の　細胞が　変化して
翼が　生えてきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_374_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じりょくの　はちょうで　なかまと
かいわする。むれになった　ダンバルは
いっしみだれぬ　うごきを　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>磁力の　波長で　仲間と　会話する。
群れになった　ダンバルは
一糸乱れぬ　動きを　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_375_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２ひきの　ダンバルが　がったいした。
はがねの　ボディは　ジェットきと
しょうとつしても　きずつかない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２匹の　ダンバルが　合体した。
鋼の　ボディは　ジェット機と
衝突しても　傷つかない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_376_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メタングが　がったいして　うまれた。
４つの　のうを　もつ　メタグロスは
スーパーコンピュータなみの　ちのう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メタングが　合体して　生まれた。
４つの　脳を　持つ　メタグロスは
スーパーコンピューター並の　知能。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_377_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんが　いわで　できている。
たたかいで　からだが　かけても
いわを　くっつけて　なおしてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身が　岩で　できている。
戦いで　体が　欠けても
岩を　くっつけて　治してしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_378_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひょうがきに　できた　こおりで
からだが　つくられている。マイナス
２００どの　れいきを　あやつる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>氷河期に　できた　氷で
体が　作られている。
マイナス２００度の　冷気を　操る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_379_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんまんねんも　ちかの　あつりょくで
きたえられた　きんぞくの　ボディは
きずひとつ　つかない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>何万年も　地下の　圧力で
鍛えられた　金属の　ボディは
傷ひとつ　つかない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_380_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひかりを　くっせつさせる　うもうで
ぜんしんを　つつみこみ　すがたを
みえなくする　のうりょくを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>光を　屈折させる　羽毛で
全身を　包み込み　姿を
見えなくする　能力を　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_381_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たかい　ちのうを　もつ　ポケモン。
うでを　おりたたんで　とべば
ジェットきを　おいこす　スピードだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高い　知能を　持つ　ポケモン。
腕を　折りたたんで　飛べば
ジェット機を　追い越す　スピードだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_382_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおあめを　ふらせる　のうりょくで
うみを　ひろげたと　いわれている。
かいこうの　そこで　ねむっていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大雨を　降らせる　能力で
海を　広げたと　言われている。
海溝の　底で　眠っていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_383_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおむかし　カイオーガとの　しとうの
すえに　ちかマグマの　なかで
ねむっていた　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大昔　カイオーガと　死闘の　末に
地下マグマの　中で
眠っていた　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_384_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くもより　はるかうえの　オゾンそうに
せいそくしているため　ちじょうから
すがたを　みることは　できない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雲より　はるか上の　オゾン層に
生息しているため　地上から
姿を　見ることは　できない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_385_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１０００ねんかんで　７にちだけ
めを　さまし　どんな　ねがいごとでも
かなえる　ちからを　つかうという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１０００年間で　７日だけ
目を　覚まし　どんな　願い事でも
かなえる　力を　使うという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_386_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いんせきに　ふちゃくしていた
うちゅうウイルスの　ＤＮＡが
へんいして　うまれた　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いん石に　付着していた
宇宙ウイルスの　ＤＮＡが
変異して　生まれた　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_387_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つちで　できた　せなかの　こうらを
さわって　ほどよく　しめっていたなら
その　ナエトルは　とても　げんきだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>土で　できた　背中の　甲羅を
触って　ほどよく　湿っていたなら
その　ナエトルは　とても　元気だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_388_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きれいな　みずが　わきでる　ばしょを
しっていて　なかまの　ポケモンを
せなかに　のせて　そこまで　はこぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きれいな　水が　わき出る　場所を
知っていて　仲間の　ポケモンを
背中に　乗せて　そこまで　運ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_389_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドダイトスの　せなかで　うまれて
ドダイトスの　せなかで　いっしょうを
まっとうする　ポケモンも　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドダイトスの　背中で　生まれて
ドダイトスの　背中で　一生を
全うする　ポケモンも　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_390_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とても　みがるな　ポケモン。
まわりが　もえないように　おしりの
ほのおを　けしてから　ねむる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とても　身軽な　ポケモン。
まわりが　燃えないように　おしりの
炎を　消してから　眠る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_391_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　ほのおの　いきおいを
うまく　コントロールして　じぶんの
とくいな　まあいで　たたかうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　炎の　勢いを
うまく　コントロールして
自分の　得意な　間合いで　戦うのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_392_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てあしに　ほのおを　まとった
どくとくの　かくとうわざを　つかい
どんな　あいてにも　たちむかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手足に　炎を　まとった
独特の　格闘わざを　使い
どんな　相手にも　立ち向かう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_393_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あるくのは　にがてで　こけたりするが
ポッチャマの　プライドは　たかく
きにせず　どうどうと　むねを　はる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>歩くのは　苦手で　こけたりするが
ポッチャマの　プライドは　高く
気にせず　堂々と　胸を　はる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_394_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　ポッタイシも　じぶんが
いちばん　えらいと　かんがえるため
むれを　つくることは　ふかのうだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの　ポッタイシも　自分が
一番　偉いと　考えるため
群れを　作ることは　不可能だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_395_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プライドを　きずつける　ものは
りゅうひょうをも　せつだんする
つばさで　まっぷたつに　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プライドを　傷つける　者は
流氷をも　切断する　翼で
真っ二つに　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_396_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むれを　つくることで　１ぴきでの
よわさを　カバーしあっているが
むれが　おおきくなると　もめだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>群れを　作ることで　１匹での
弱さを　カバーし合っているが
群れが　大きくなると　もめだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_397_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　よわさを　わきまえており
いつも　むれで　くらしている。
いっぴきになると　やかましく　なく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の　弱さを　わきまえており
いつも　群れで　暮らしている。
１匹になると　やかましく　鳴く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_398_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　からだが　きずつこうとも
こうげきを　やめなくなった。
とさかの　かたちを　きにしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の　体が　傷つこうとも
攻撃を　やめなくなった。
トサカの　形を　気にしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_399_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビッパと　コラッタの　まえば
どちらが　のびるのが　はやいのか
くらべたところ　ひきわけ　だった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビッパと　コラッタの　前歯
どちらが　伸びるのが　早いのか
比べたところ　引き分け　だった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_400_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビーダルが　ダムを　つくった
かわは　はんらん　することがないので
ちかくの　ひとから　かんしゃされる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビーダルが　ダムを　作った
川は　はんらん　することがないので
近くの　人から　感謝される。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_401_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あしが　みじかく　こけそうになるたび
かたい　しょっかくが　こすれあって
もっきんのような　おとが　ひびく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>足が　短く　こけそうになるたび
硬い　触角が　こすれあって
木琴のような　音が　響く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_402_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へんげんじざいの　なきごえを
きそいあわせる　なきくらべ　という
あそびを　たのしむ　むらがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>変幻自在の　鳴き声を
競い合わせる　鳴き比べ　という
遊びを　楽しむ　村がある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_403_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだを　うごかすたびに　きんにくが
のびちぢみして　でんきが　うまれる。
ピンチになると　からだが　かがやく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を　動かすたびに　筋肉が
伸び縮みして　電気が　生まれる。
ピンチになると　体が　輝く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_404_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>するどい　ツメの　さきには　つよい
でんきが　ながれており　ほんのすこし
かするだけで　あいてをきぜつさせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋭い　ツメの　先には　強い　電気が
流れており　ほんの少し　かするだけで
相手を気絶させる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_405_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かべのむこうも　みえる　ちからで
にげた　えものを　おいつめるほかにも
まいごの　こどもを　さがしたりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>壁の向こうも　見える　力で
逃げた　獲物を　追いつめるほかにも
迷子の　子供を　捜したりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_406_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おんどの　へんかに　びんかんで
あたたかい　ひざしを　かんじるとき
つぼみは　かならず　ひらくという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>温度の　変化に　敏感で
暖かい　日差しを　感じるとき
つぼみは　かならず　開くという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_407_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうての　どくの　せいぶんは
それぞれ　ちがう　しゅるいだが
どっちを　さされても　しにかける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両手の　毒の　成分は
それぞれ　違う　種類だが
どっちを　刺されても　死にかける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_408_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>およそ　１おくねんまえの　ポケモン。
ジャングルで　うまれそだち　じゃまな
じゅもくは　ずつきで　へしおった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>およそ　１億年前の　ポケモン。
ジャングルで　生まれ育ち　邪魔な
樹木は　頭突きで　へしおった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_409_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまを　はげしく　ぶつけあっても
ずがいこつは　あつさ　３０センチも
あるので　きぜつ　したりしない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭を　激しく　ぶつけ合っても
頭がい骨は　厚さ　３０センチも
あるので　気絶　したりしない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_410_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ばつぐんの　ぼうぎょりょくを　もつ。
そのため　とくに　あらそうこともなく
くさや　きのみを　たべて　すごす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>抜群の　防御力を　持つ。
そのため　特に　争うこともなく
草や　木の実を　食べて　過ごす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_411_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よこいちれつに　ならぶと　どんな
ポケモンでも　とっぱ　できない。
そうやって　こどもを　まもっていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>横一列に　並ぶと　どんな
ポケモンでも　突破　できない。
そうやって　子供を　守っていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_412_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだをつつむ　ざいりょうが　ない
ばしょで　うまれても　ミノムッチは
いつのまにか　ミノを　まとっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を包む　材料が　ない　場所で
生まれても　ミノムッチは
いつのまにか　ミノを　まとっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_413_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかするとき　まわりにある
ざいりょうを　からだに　とりこむため
おおくの　バリエーションが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>進化するとき　まわりにある
材料を　体に　取り込むため
多くの　バリエーションが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_414_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなのミツが　だいすきだが
じぶんでは　あつめず　ミツハニーから
よこどり　ばかりを　かんがえている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>花のミツが　大好きだが
自分では　集めず　ミツハニーから
横取り　ばかりを　考えている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_415_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うまれたときから　３びき　いっしょ。
ビークインに　よろこんでもらうため
いつも　はなのミツを　あつめている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれたときから　３匹　一緒。
ビークインに　喜んでもらうため
いつも　花のミツを　集めている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_416_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さまざまな　フェロモンを　だして
どうたいに　いる　こどもたちを
じざいにあやつり　てきとたたかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>様々な　フェロモンを　出して
胴体に　いる　子供たちを
自在に操り　敵と戦う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_417_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たまった　でんきを　わけあたえようと
ほほぶくろを　こすりあわせる
パチリスを　みかけることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たまった　電気を　分け与えようと
ほほ袋を　こすり合わせる
パチリスを　見かけることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_418_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽを　スクリューのように　まわし
すいちゅうを　およぐだけでなく
まとわりつく　かいそうも　きれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽを　スクリューのように　回し
水中を　泳ぐだけでなく
まとわりつく　海草も　切れる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_419_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうしまちに　おおく　みられ
おぼれた　ひとを　たすけたり
とった　えものを　はこんでいる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>漁師町に　多く　見られ
おぼれた　人を　助けたり
取った　獲物を　運んでいる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_420_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさな　たまには　えいようが
つまっているだけでなく　おいしいので
ムックルに　ついばまれたりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　玉には　栄養が
つまっているだけでなく　おいしいので
ムックルに　ついばまれたりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_421_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよい　ひざしを　かんじとると
とざしていた　はなびらを　ひろげ
ぜんしんで　にっこうを　あびる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強い　日差しを　感じとると
閉ざしていた　花びらを　広げ
全身で　日光を　浴びる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_422_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やわらかい　からだを　つよくおすと
むらさきいろの　なぞの　えきたいが
にじみでるので　ようちゅうい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やわらかい　体を　強く押すと
紫色の　ナゾの　液体が
にじみ出るので　要注意。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_423_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むかしは　じょうぶな　カラで
せなか　ぜんたいを　おおっていた。
さいぼうに　その　なごりが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昔は　丈夫な　殻で
背中　全体を　おおっていた。
細胞に　その　名残が　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_424_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２ほんに　わかれた　しっぽは
いろんなことが　きように　できるので
ほとんど　てを　つかわなくなった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２本に　分かれた　しっぽは
いろんなことが　器用に　できるので
ほとんど　手を　使わなくなった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_425_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あてもなく　うかぶ　ようすから
まよえる　たましいの　みちしるべ　と
つたえる　むかしばなしも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あてもなく　浮かぶ　様子から
迷える　魂の　道しるべ　と
伝える　昔話も　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_426_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆうぐれ　むれになって　おおぞらを
かぜに　ながされていくが　きづくと
いつのまにか　きえてしまっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夕暮れ　群れになって　大空を
風に　流されていくが　気づくと
いつのまにか　消えてしまっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_427_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつも　まるめている　みみを
いきおいよく　のばすと　おおきな
いわも　かんたんに　こわせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつも　丸めている　耳を
勢いよく　伸ばすと　大きな
岩も　簡単に　壊せる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_428_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みみは　とても　デリケートらしく
やさしく　ていねいに　さわらないと
しなやかな　あしで　けられてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>耳は　とても　デリケートらしく
優しく　丁寧に　触らないと
しなやかな　足で　けられてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_429_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅもんのような　なきごえだが
まれに　あいてを　しあわせにする
こうかも　ひめているという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じゅもんのような　鳴き声だが
まれに　相手を　幸せにする
効果も　秘めているという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_430_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドンカラスが　ひくいこえで　なくと
すぐさま　ヤミカラスが　あつまるため
よるをまねくもの　とも　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドンカラスが　低い声で　鳴くと
すぐさま　ヤミカラスが　集まるため
夜を招くもの　とも　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_431_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーが　エサを　くれないと
はなのあなに　ツメをひっかける
ひどい　いちめんを　ひめている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーが　エサを　くれないと
鼻の穴に　ツメをひっかける
ひどい　一面を　秘めている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_432_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうたいを　しっぽで　しばりつけて
じぶんを　おおきく　みせている。
めがあうと　いつまでも　にらみあう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>胴体を　しっぽで　縛りつけて
自分を　大きく　見せている。
目が合うと　いつまでも　にらみ合う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_433_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とびはねると　くちのなかにある
たまが　あちこちに　はんしゃして
すずのような　ねいろと　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>跳びはねると　口の中にある
玉が　あちこちに　反射して
鈴のような　音色と　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_434_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おしりからとばす　くさい　しるの
においは　はんけい２キロに　ひろがり
まわりの　ポケモンは　いなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おしりから飛ばす　くさい　汁の
においは　半径２キロに　広がり
まわりの　ポケモンは　いなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_435_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　さきから　ひどい　においの
えきたいを　とばして　こうげきするが
うえから　ねらわれると　とまどう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　先から　ひどい　においの
液体を　飛ばして　攻撃するが
上から　ねらわれると　とまどう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_436_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおむかしの　ドーミラーは
かがみのように　はんしゃしていたと
かんがえる　けんきゅうかも　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大昔の　ドーミラーは
鏡のように　反射していたと
考える　研究家も　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_437_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>べつせかいへの　あなを　あけて
そこから　あめを　ふらしていた。
そのため　ほうさくのかみ　とされる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>別世界への　穴を　開けて
そこから　雨を　降らしていた。
そのため　豊作の神　とされる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_438_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんそうした　くうきを　このむ。
すいぶんを　ちょうせつ　するときに
だす　みずが　なみだに　みえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>乾燥した　空気を　好む。
水分を　調節　するときに
出す　水が　涙に　見える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_439_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めにみえる　あいての　かおや
うごきの　モノマネを　することで
どんな　きもちか　わかろうとする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目に見える　相手の　顔や
動きの　モノマネを　することで
どんな　気持ちか　わかろうとする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_440_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさないしを　かかえるのが　すき。
あいての　あしもとを　あるきまわって
ついつい　ころばすことも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　石を　抱えるのが　好き。
相手の　足元を　歩き回って
ついつい　転ばすことも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_441_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベロは　にんげんのものに　そっくり。
そのため　にんげんの　はなすことばを
じょうずに　まねることが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベロは　人間のものに　そっくり。
そのため　人間の　話す言葉を
上手に　真似ることが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_442_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつも　わるさばかり　していたら
ふしぎな　じゅつで　ほんたいを
かなめいしに　しばりつけられた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつも　悪さばかり　していたら
不思議な　術で　本体を
要石に　縛りつけられた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_443_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおぐちを　つかった　こうげきは
いりょく　じゅうぶんだが　まだ
うまくたたかえず　じぶんもきずつく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大口を　使った　攻撃は
威力　十分だが
まだ　うまく戦えず　自分も傷つく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_444_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひかりかがやく　ものが　だいすきで
どうくつの　なかで　みつけた
たからを　じぶんのすに　ためこむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>光り輝く　ものが　大好きで
洞くつの　中で　見つけた
宝を　自分の巣に　ため込む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_445_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうそくで　かけぬけると　つばさは
くうきの　やいばを　うみだし
まわりのきは　せつだん　されている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高速で　駆け抜けると　翼は
空気の　刃を　生み出し
まわりの木は　切断　されている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_446_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひっしに　エサを　たべているうちに
からだの　けのしたに　かくしていた
エサのことを　わすれてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>必死に　エサを　食べているうちに
体の　毛の下に　隠していた
エサのことを　忘れてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_447_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よろこびや　いかりと　いった
かんじょうを　なみのかたち　として
みわける　ふしぎなちからを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>喜びや　怒りと　いった
感情を　波の形　として
見分ける　不思議な力を　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_448_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きたえられた　ルカリオは　はどうを
つかい　１キロさきに　だれがいるのか
どんなきもちか　さえも　わかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鍛えられた　ルカリオは　波動を
使い　１キロ先に　だれがいるのか
どんな気持ちか　さえも　わかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_449_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなの　あなを　ぴたりと　とじてから
すなのなかを　あるくように　すすむ。
１０ぴきていどの　むれで　くらす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鼻の　穴を　ピタリと　閉じてから
砂の中を　歩くように　進む。
１０匹程度の　群れで　暮らす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_450_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いがいと　おこりっぽい　ポケモンで
くちを　おおきく　あけることで
まわりに　つよさを　アピールする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>意外と　怒りっぽい　ポケモンで
口を　大きく　開けることで
まわりに　強さを　アピールする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_451_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽのはさみが　とじると　どうじに
はりのさきから　どくが　にじみだす。
１ねん　なにもたべずに　たえられる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽのハサミが　閉じると　同時に
針の先から　毒が　にじみだす。
１年　何も食べずに　耐えられる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_452_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もうどくを　つかわなくても　じまんの
ちからで　あいてを　バラバラにする
がんじょうな　からだの　もちぬし。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>猛毒を　使わなくても　自慢の
力で　相手を　バラバラにする。
頑丈な　体の　持ち主。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_453_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せいせいどうどうと　たたかうことは
すくないが　それも　いきのびるため。
マスコットとして　にんきが　たかい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正々堂々と　戦うことは　少ないが
それも　生き延びるため。
マスコットとして　人気が　高い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_454_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>のどもとに　どくぶくろを　もつ。
のどを　ならすと　たまった　どくは
ねりこまれ　きょうりょくになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>のど元に　毒袋を　持つ。
のどを　鳴らすと　たまった　毒は
練り込まれ　強力になる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_455_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっちたいに　はえる　きにまきつき
あまいかおりの　だえきで　えものを
おびきよせては　ひとくちで　たべる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>湿地帯に　生える　木に巻きつき
甘い香りの　だ液で　獲物を
誘き寄せては　ひとくちで　食べる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_456_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　よこがわにある　ラインは
たいようのひかりを　ためておける。
よるになると　あざやかに　かがやく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　横側にある　ラインは
太陽の光を　ためておける。
夜になると　鮮やかに　輝く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_457_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながい　ひれを　あしのように
つかって　かいていを　はっている。
ランターンと　えものを　とりあう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長い　ヒレを　足のように
使って　海底を　はっている。
ランターンと　獲物を　取り合う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_458_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テッポウオと　たわむれながら
すいめんを　はねている　ようすを
みるための　ツアーが　おこなわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テッポウオと　たわむれながら
水面を　跳ねている　様子を
見るための　ツアーが　行われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_459_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にんげんに　きょうみが　あるのか
ゆきやまで　あしあとを　みつけると
そのまわりに　あつまってくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人間に　興味が　あるのか
雪山で　足跡を　見つけると
そのまわりに　集まって来る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_460_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆきのはなが　さくころ　どこからか
すがたを　あらわし　はながちると
また　どこかに　すがたを　かくす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雪の花が　咲くころ　どこからか
姿を　現し　花が散ると
また　どこかに　姿を　隠す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_461_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかして　さらに　ずるがしこくなり
ツメで　いしに　サインをつけて
コミュニケーションを　はかっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>進化して　さらに　ずる賢くなり
ツメで　石に　サインをつけて
コミュニケーションを　はかっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_462_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジバコイルを　かがくりょくで
しんか　させようと　こころみる
しゅうだんが　いたが　しっぱいした。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジバコイルを　科学力で
進化　させようと　試みる
集団が　いたが　失敗した。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_463_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながいしたは　いつも　だえきまみれ。
だえきには　ものをとかす　せいぶんが
ふくまれており　さわると　しびれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長い舌は　いつも　だ液まみれ。
だ液には　物を溶かす　成分が
含まれており　触ると　しびれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_464_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きんにくを　ちからを　こめて
しゅんかんてきに　ふくらませることで
てにした　いしを　ふんしゅつできる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>筋肉を　力を　込めて
瞬間的に　膨らませることで
手にした　石を　噴出できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_465_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょくぶつで　できた　うでは
ほうっておくと　からみついてくる。
きってもきっても　すぐに　はえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>植物で　できた　腕は
放っておくと　絡みついてくる。
切っても切っても　すぐに　生える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_466_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいての　こうげきを　きにせず
ちかづいては　しっぽを　おしつけて
こうあつの　でんりゅうを　ながす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手の　攻撃を　気にせず
近づいては　しっぽを　押しつけて
高圧の　電流を　流す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_467_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せっし２０００どの　ひのたまを
うちだすとき　ブーバーンの　からだは
ねつのため　ほのかに　しろくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>摂氏２０００度の　火の玉を
撃ち出すとき　ブーバーンの　体は
熱のため　ほのかに　白くなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_468_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おたがいの　そんざいを　みとめあい
むだに　あらそわない　ひとのために
さまざまな　めぐみを　わけあたえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お互いの　存在を　認め合い
無駄に　争わない　人のために
様々な　恵みを　分け与える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_469_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あごの　ちからは　けたはずれ。
こうそくで　とんで　すれちがいざまに
あいてを　かみちぎるのが　とくい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アゴの　力は　けたはずれ
高速で　飛んで　すれ違いざまに
相手を　かみちぎるのが　得意。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_470_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きほんてきに　あらそわない。
さいぼうが　しょくぶつに　ちかくなり
たいないで　こうごうせいが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>基本的に　争わない。
細胞が　植物に　近くなり
体内で　光合成が　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_471_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいおんを　コントロールすることで
しゅういの　くうきを　こおらせて
ダイヤモンドダストを　ふらせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体温を　コントロールすることで
周囲の　空気を　凍らせて
ダイヤモンドダストを　降らせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_472_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わずかな　かぜのながれに　うまく
のると　いちども　はばたくことなく
このほしを　いっしゅう　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わずかな　風の流れに　うまく
乗ると　１度も　羽ばたくことなく
この星を　１周　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_473_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１まんねん　まえの　じめんから
こおりづけの　マンムーが　みつかり
しかも　めざめたので　さわがれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１万年　前の　地面から
氷漬けの　マンムーが　見つかり
しかも　目覚めたので　騒がれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_474_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いじげんでも　かつやく　できるよう
プログラムを　しゅうせい　したが
ねらいどおりには　いかなかった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>異次元でも　活躍　できるよう
プログラムを　修正　したが
ねらい通りには　いかなかった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_475_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だれかを　まもろうと　したとき
ひじをのばし　かたなのように
へんか　させて　はげしく　たたかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>だれかを　守ろうと　したとき
ひじを伸ばし　刀のように
変化　させて　激しく　戦う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_476_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チビノーズと　よばれる　ちいさな
３つの　ユニットを　じりょくで
じゆうじざいに　あやつっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チビノーズと　呼ばれる　小さな
３つの　ユニットを　磁力で
自由自在に　操っている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_477_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だんりょくのある　からだの　なかに
いきばのない　たましいを　とりこんで
あのよに　つれていくと　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>弾力のある　体の　中に
行き場のない　魂を　取り込んで
あの世に　連れていくと　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_478_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マイナス５０どの　いきを　ふきかけ
こおらせた　えものを　ひみつの
ばしょに　かざっていると　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マイナス５０度の　息を　吹きかけ
凍らせた　獲物を　秘密の
場所に　飾っていると　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_479_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんきのような　からだは　いちぶの
きかいに　はいりこむことが　できる。
そして　そのからだで　いたずらする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>電気のような　体は　一部の
機械に　入り込むことが　できる。
そして　その体で　いたずらする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_480_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ユクシーが　とびまわったことで
ひとびとに　ものごとを　かいけつする
ちえ　というものが　うまれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ユクシーが　飛び回ったことで
人々に　物事を　解決する
知恵　というものが　生まれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_481_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エムリットが　とびまわったことで
ひとびとに　いきるときの　よろこび
かなしみ　というものが　うまれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エムリットが　飛び回ったことで
人々に　生きるときの　喜び
悲しみ　というものが　生まれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_482_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アグノムが　とびまわったことで
ひとびとに　なにかを　するための
けつい　というものが　うまれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アグノムが　飛び回ったことで
人々に　なにかを　するための
決意　というものが　生まれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_483_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ディアルガの　しんぞうが　うごくと
じかんは　ながれていくと　されている
シンオウの　でんせつ　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ディアルガの　心臓が　動くと
時間は　流れていくと　されている。
シンオウの　伝説　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_484_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パルキアが　こきゅうを　するたびに
くうかんは　あんていすると　される
シンオウの　でんせつの　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パルキアが　呼吸を　するたびに
空間は　安定すると　される。
シンオウの　伝説の　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_485_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんじょうな　はがねの　からだだが
じぶんが　はっする　こうねつの　ため
ところどころ　とけてしまっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頑丈な　鋼の　体だが
自分が　発する　高熱の　ため
ところどころ　溶けてしまっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_486_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とくしゅな　ひょうざんや　がんせき
マグマから　じぶんの　すがたに　にた
ポケモンを　つくったと　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>特殊な　氷山や　岩石　マグマから
自分の　姿に　似た　ポケモンを
つくったと　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_487_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あばれもの　ゆえ　おいだされたが
やぶれたせかいと　いわれる　ばしょで
しずかに　もとのせかいを　みていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暴れ者　ゆえ　追い出されたが
破れた世界と　言われる　場所で
静かに　元の世界を　見ていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_488_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みかづきに　ちかい　よるほど
しっぽから　のびる　オーロラは
ながく　うつくしくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>三日月に　近い　夜ほど
しっぽから　伸びる　オーロラは
長く　美しくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_489_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたたかい　うみを　ただよっている。
どんな　とおくに　ながされても
うまれた　ばしょに　かならずもどる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暖かい　海を　漂っている。
どんな　遠くに　流されても
生まれた　場所に　かならず戻る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_490_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うまれたときから　そなわっている
ふしぎな　ちからを　つかうと　どんな
ポケモンとも　こころが　かよいあう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれたときから　備わっている
不思議な　力を　使うと　どんな
ポケモンとも　心が　通い合う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_491_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんを　まもるために　まわりの
ひとや　ポケモンに　あくむをみせるが
ダークライに　わるぎは　ないのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分を　守るために　まわりの
人や　ポケモンに　悪夢を見せるが
ダークライに　悪気は　ないのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_492_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとに　やさしく　だきしめられ　
ありがとうの　きもちを　かんじると
ぜんしんの　はなが　ひらきだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人に　優しく　抱きしめられ
ありがとうの　気持ちを　感じると
全身の　花が　開きだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_493_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにも　ない　ばしょに　あった
タマゴのなかから　すがたを　あらわし
せかいを　うみだしたと　されている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なにも　ない　場所に　あった
タマゴの中から　姿を　現し
世界を　生み出したと　されている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_494_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうりを　もたらす　ポケモン。
ビクティニを　つれた　トレーナーは
どんな　しょうぶにも　かてるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝利を　もたらす　ポケモン。
ビクティニを　連れた　トレーナーは
どんな　勝負にも　勝てるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_495_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちのうが　たかく　とても　れいせい。
たいようの　ひかりを　たっぷり
あびると　うごきが　するどくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>知能が　高く　とても　冷静。
太陽の　光を　たっぷり　浴びると
動きが　鋭くなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_496_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じめんを　すべるように　はしる。
すばやい　うごきで　てきを　まどわせ
つるのムチで　しとめるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地面を　滑るように　走る。
素早い　動きで　敵を　まどわせ
つるのムチで　しとめるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_497_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にらむだけで　あいての　うごきを
とめてしまう。たいようエネルギーを
たいないで　ぞうふくさせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>にらむだけで　相手の　動きを
止めてしまう。太陽エネルギーを
体内で　増幅させる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_498_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てきの　こうげきを　みがるに　よけて
はなから　ひのたまを　うちだす。
ほのおで　きのみを　やいて　たべる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>敵の　攻撃を　身軽に　避けて
鼻から　火の玉を　撃ち出す。
炎で　木の実を　焼いて　食べる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_499_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないの　ほのおが　もえあがると
うごきの　キレと　スピードが　ます。
ピンチになると　けむりを　ふきだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内の　炎が　燃え上がると
動きの　キレと　スピードが　増す。
ピンチになると　煙を　吹き出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_500_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あごの　ほのおで　こぶしを　もやして
ほのおの　パンチを　くりだす。
とても　なかまおもいの　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アゴの　炎で　こぶしを　燃やして
炎の　パンチを　繰り出す。
とても　仲間思いの　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_501_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなかの　ホタチで　たたかう。
こうげきを　うけとめてから　すかさず
きりつけて　はんげきするのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お腹の　ホタチで　戦う。
攻撃を　受け止めてから　すかさず
切りつけて　反撃するのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_502_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながれるような　たちさばきで
２まいの　ホタチを　あつかう　わざは
きびしい　しゅぎょうで　みにつける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>流れるような　太刀さばきで
２枚の　ホタチを　あつかう　技は
厳しい　修業によって　身につける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_503_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よろいに　しこまれた　つるぎの
ひとふりで　あいてを　たおす。
ひとにらみで　てきを　だまらせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よろいに　仕込まれた　剣の　一振りで
相手を　倒す。
ひとにらみで　敵を　黙らせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_504_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほほの　ふくろに　エサを　ためこみ
なんにちも　みはりを　つづける。
しっぽで　なかまに　あいずする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほほの　袋に　エサを　ため込み
何日も　見張りを　続ける。
しっぽで　仲間に　合図する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_505_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほっぺの　ふくろに　ためた　きのみの
タネを　とばして　こうげき。てきを
はっけんすると　しっぽを　たてる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほほ袋に　ためた　木の実の　タネを
飛ばして　攻撃。
敵を　発見すると　しっぽを　立てる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_506_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよい　あいてにも　ゆうかんに
たちむかうが　ふりな　たたかいを
さける　ちのうの　たかい　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強い　相手にも　勇敢に　立ち向かうが
不利な　戦いを　避ける
知能の　高い　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_507_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マントのように　からだを　おおう
くろい　たいもうは　とても　かたい。
うけた　ダメージを　へらしてくれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マントのように　体を　おおう
黒い　体毛は　とても　硬い。
受けた　ダメージを　減らしてくれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_508_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふぶきで　とざされた　やまに　はいり
そうなんした　ひとを　たすける。
ながい　けが　さむさを　ふせぐ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>吹雪で　閉ざされた　山に　入り
遭難した　人を　助ける。
長い　毛が　寒さを　防ぐ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_509_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとの　ものを　あそびで　ぬすむ。
ぬすまれた　ひとも　あいくるしい
しぐさに　つい　ゆるしてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人の　物を　遊びで　盗む。
盗まれた　人も　愛くるしい　仕草に
つい　許してしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_510_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんしゅつきぼつな　ポケモン。
うつくしい　スタイルと　けなみが
おおくの　トレーナーを　ひきつける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>神出鬼没な　ポケモン。
美しい　スタイルと　毛並みが
多くの　トレーナーを　ひきつける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_511_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふかい　もりで　くらす　ポケモン。
あたまに　はえた　はっぱを　たべると
つかれが　うそのように　きえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深い　森で　暮らす　ポケモン。
頭に　生えた　葉っぱを　食べると
疲れが　ウソのように　消える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_512_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きしょうが　はげしく　トゲの　ついた
しっぽを　ふりまわして　たたかう。
あたまの　はっぱは　とても　にがい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気性が　激しく　トゲの　ついた
しっぽを　振り回して　戦う。
頭の　葉っぱは　とても　苦い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_513_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　ふさは　おこると　おんどが
あがり　３００ど　いじょうになる。
きのみを　ふさで　やいて　たべる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　ふさは　怒ると　温度が　上がり
３００度　以上になる。
木の実を　ふさで　焼いて　食べる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_514_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまいものが　だいこうぶつ。
たいないの　ほのおを　もやす
エネルギーに　なるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甘いものが　大好物。
体内の　炎を　燃やす
エネルギーに　なるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_515_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　ふさに　ためた　みずは
えいよう　たっぷり。しょくぶつに
かけると　おおきく　そだつのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　ふさに　ためた　水は
栄養　たっぷり。
植物に　かけると　大きく　育つのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_516_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　ふさに　みずを　ためる。
ちょすいりょうが　へると　しっぽで
みずを　すいあげて　ほきゅうする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　ふさに　水を　ためる。
貯水量が　減ると　しっぽで
水を　吸い上げて　補給する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_517_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ムンナに　ゆめを　たべらてしまうと
ゆめの　ないようを　わすれてしまう。
つねに　くうちゅうに　うかんでいる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ムンナに　夢を　食べられてしまうと
夢の　内容を　忘れてしまう。
つねに　空中に　浮かんでいる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_518_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おでこから　でている　けむりの
なかには　ひとや　ポケモンの　みた
ゆめが　たくさん　つまっているのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おでこから　出ている　煙の　中には
人や　ポケモンの　見た　夢が
たくさん　詰まっているのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_519_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーの　めいれいを　よく　きく
せいかくだが　むずかしい　しじは
りかい　できない　こともある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーの　命令を　よく　聞く
性格だが　難しい　指示は
理解　できない　こともある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_520_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんなに　とおく　はなれても
トレーナーの　もとに　かならず
もどってくる　ことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんなに　遠く　離れても
トレーナーの　もとに　かならず
もどってくる　ことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_521_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オスは　あたまの　かざりを　ゆらして
あいてを　いかくする。メスの　ひこう
のうりょくは　オスを　うわまわる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オスは　頭の　飾りを　揺らして
相手を　威嚇する。
メスの　飛行能力は　オスを　上回る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_522_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほうでんすると　たてがみが　ひかる。
たてがみの　ひかりかたで　なかまと
コミュニケーションを　とっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>放電すると　たてがみが　光る。
たてがみの　光り方で　仲間と
コミュニケーションを　とっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_523_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いなずまのような　しゅんぱつりょく。
ゼブライカが　ぜんそくりょくで
はしると　らいめいが　ひびきわたる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>稲妻のような　瞬発力。
ゼブライカが　全速力で　走ると
雷鳴が　響きわたる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_524_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>６かくけいの　みみを　もつ。
ちていで　あっしゅくされた　からだは
てつに　まけないくらい　かたい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>６角形の　耳を　持つ。
地底で　圧縮された　体は
鉄に　負けないくらい　硬い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_525_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パワーが　みなぎると　オレンジいろの
けっしょうが　ひかり　かがやく。
ほらあなで　ちかすいを　さがす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パワーが　みなぎると　オレンジ色の
結晶が　光り　輝く。
洞穴で　地下水を　探す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_526_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないの　コアで　エネルギーを
あっしゅくして　うちだす　こうげきは
やまを　ふきとばす　いりょく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内の　コアで　エネルギーを
圧縮して　撃ち出す　攻撃は
山を　吹き飛ばす　威力。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_527_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くらい　もりや　ほらあなで　くらす。
はなの　あなから　ちょうおんぱを
だして　あたりの　ようすを　さぐる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暗い　森や　洞穴で　暮らす。
鼻の　穴から　超音波を　出して
あたりの　様子を　探る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_528_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いろいろな　しゅうはすうの　おんぱを
はなの　あなから　はっしゃする。
いわを　はかいする　おんぱも　だす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いろいろな　周波数の　音波を
鼻の　穴から　発射する。
岩を　破壊する　音波も　出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_529_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちちゅうを　ほりすすむ　スピードは
じそく５０キロいじょう。ちじょうを
はしる　じどうしゃと　いいしょうぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地中を　掘り進む　スピードは
時速５０キロ以上。
地上を　走る　自動車と　いい勝負。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_530_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はがねに　しんかした　ドリルは
てっぱんを　つらぬく　はかいりょく。
トンネルこうじで　だいかつやくする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼に　進化した　ドリルは
鉄板を　つらぬく　破壊力。
トンネル工事で　大活躍する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_531_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みみの　しょっかくで　あいてに
ふれると　しんぞうの　おとで
たいちょうや　きもちが　わかるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>耳の　触角で　相手に　触れると
心臓の　音で
体調や　気持ちが　わかるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_532_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かくざいを　ふりまわして　たたかう。
おもい　かくざいを　くも　なく
もつようになると　しんかは　ちかい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>角材を　振り回して　戦う。
重い　角材を　苦も　なく
持つようになると　進化は　近い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_533_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きたえあげた　きんにくの　からだは
プロレスラーが　たばに　なって
こうげきしても　びくとも　しない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鍛え上げられた　筋肉の　体は
プロレスラーが　束に　なって
攻撃しても　びくとも　しない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_534_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コンクリートを　つくる　ぎじゅつは
２０００ねんまえに　ローブシンから
おそわったと　かんがえられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コンクリートを　作る　技術は
２０００年前に　ローブシンから
教わったと　考えられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_535_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんだかい　けいかいおんを
ほほの　しんどうで　はっせいさせて
なかまに　きけんを　しらせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甲高い　警戒音を
ほほの　振動で　発生させて
仲間に　危険を　知らせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_536_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　コブを　しんどうさせると
すいちゅうが　なみたつ　だけでなく
じめんも　じしんのように　ゆれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　コブを　振動させると
水中が　波立つ　だけでなく
地面も　地震のように　揺れる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_537_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　コブから　しんけいを
マヒさせる　えきたいを　とばす。
しんどうで　あいてを　くるしめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　コブから　神経を　マヒさせる
液体を　飛ばす。
振動で　相手を　苦しめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_538_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おびを　しめると　パワーアップする。
やせいの　ナゲキは　つるくさを
あんで　じぶんの　おびを　つくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>帯を　締めると　パワーアップする。
野生の　ナゲキは　つる草を　編んで
自分の　帯を　作る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_539_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ダゲキが　しゅぎょうする　やまから
おおいわや　たいぼくに　こぶしを
うちつける　おとが　きこえてくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ダゲキが　修業する　山から
大岩や　大木に　こぶしを
打ちつける　音が　聞こえてくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_540_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タマゴから　かえると　ハハコモリに
ふくを　つくってもらい　きせられる。
フードで　あたまを　かくして　ねる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タマゴから　かえると　ハハコモリに
服を　作ってもらい　着せられる。
フードで　頭を　隠して　寝る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_541_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>クルマユの　すむ　もりは　くさきが
よく　そだつ。クルマユが　おちばを
えいようぶんに　かえているのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>クルマユの　住む　森は　草木が
よく　育つ。クルマユが　落ち葉を
栄養分に　変えているのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_542_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさい　ポケモンを　みつけると
うでの　カッターと　ねんちゃくいとで
はっぱの　ふくを　ぬう　しゅうせい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さい　ポケモンを　見つけると
腕の　カッターと　粘着糸で
葉っぱの　服を　縫う　習性。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_543_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かみついて　もうどくを　あたえる。
てんてきの　おおきな　とりポケモンも
からだが　しびれて　うごけなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>かみついて　猛毒を　与える。
天敵の　大きな　とりポケモンも
体が　しびれて　動けなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_544_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かたい　カラに　まもられている。
タイヤのように　かいてんして
てきに　はげしく　たいあたりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>硬い　殻に　守られている。
タイヤのように　回転して
敵に　激しく　体当たりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_545_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばやい　うごきで　てきを　おいつめ
あたまの　ツノで　こうげきする。
とどめを　さすまで　ようしゃしない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>素早い　動きで　敵を　追い詰め
頭の　ツノで　攻撃する。
とどめを　刺すまで　容赦しない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_546_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おそわれると　からだから　わたを
とばす。てきが　わたを　モンメンと
まちがえている　すきに　にげるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>襲われると　体から　綿を　飛ばす。
敵が　綿を　モンメンと
間違えている　すきに　逃げるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_547_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんなに　ほそい　すきまでも
かぜのように　くぐりぬけてしまう。
しろい　けだまを　のこしていく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんなに　細い　すきまでも
風のように　潜り抜けてしまう。
白い　毛玉を　残していく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_548_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　はっぱを　かじると
とても　にがいが　つかれた　からだを
げんきにする　こうかが　あるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　葉っぱを　かじると
とても　苦いが　疲れた　体を
元気にする　効果が　あるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_549_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うつくしい　はなを　さかせるのは
ベテラントレーナーでも　むずかしい。
セレブに　にんきの　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>美しい　花を　咲かせるのは
ベテラントレーナーでも　難しい。
セレブに　人気の　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_550_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あかと　あおの　バスラオは　すぐに
ケンカするほど　なかが　わるい。
とても　らんぼうな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>赤と　青の　バスラオは
すぐに　ケンカするほど　仲が　悪い。
とても　乱暴な　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_551_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さばくの　すなの　なかで　せいかつ。
たいように　あたためられた　すなが
たいおんの　ていかを　ふせぐのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂漠の　砂の　中で　生活。
太陽に　暖められた　砂が
体温の　低下を　防ぐのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_552_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すうひきで　むれを　つくる。
がんきゅうを　カバーする　まくが
すなあらしから　めを　まもる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>数匹で　群れを　作る。
眼球を　カバーする　膜が
砂あらしから　目を　守る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_553_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>であった　えものは　にがさない。
じどうしゃの　ボディを　くいちぎる
きょうりょくな　あごを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>出会った　獲物は　逃がさない。
自動車の　ボディを　食いちぎる
強力な　アゴを　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_554_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないで　ほのおが　もえていると
おちつかなく　はしりまわっている。
ほのおが　ちいさくなると　ねむる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内で　炎が　燃えていると
落ち着かなく　走り回っている。
炎が　小さくなると　眠る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_555_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないで　１４００どの　ほのおを
もやすことで　ダンプカーを　パンチで
はかいするほどの　パワーを　つくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内で　１４００度の　炎を
燃やすことで　ダンプカーを　パンチで
破壊するほどの　パワーを　作る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_556_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アップテンポの　おどりと　おとで
はなの　タネを　ねらう　てんてきの
とりポケモンを　おいはらうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アップテンポの　踊りと　音で
花の　タネを　ねらう　天敵の
とりポケモンを　追い払うのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_557_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いしを　とかす　えきたいを　くちから
ぶんぴつするので　かたい　いしでも
かんたんに　あなを　あけられるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>石を　溶かす　液体を　口から
分泌するので　硬い　石でも
簡単に　穴を　開けられるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_558_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばりを　とりあって　イワパレス
どうしが　はげしく　たたかう。
いわを　こわされた　ほうが　まけ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張りを　取り合って
イワパレス　同士が　激しく　戦う。
岩を　壊された　方が　負け。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_559_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かわを　くびまで　ひきあげて
ぼうぎょの　しせい。ゴムのような
だんりょくで　ダメージを　へらす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>皮を　首まで　引き上げて
防御の　姿勢。ゴムのような　弾力で
ダメージを　減らす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_560_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばりに　はいってきた　あいてを
しゅうだんで　たたきのめす。くちから
さんせいの　たいえきを　とばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張りに　入ってきた　相手を
集団で　たたきのめす。
口から　酸性の　体液を　飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_561_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こだいとしを　まもっていた　きおくを
のこしているため　いつも　おなじ
ルートを　とんでいるらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古代都市を　守っていた　記憶を
残しているため　いつも　同じ
ルートを　飛んでいるらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_562_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もっている　マスクは　デスマスが
にんげんだった　ときの　かお。
たまに　みつめては　ないている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持っている　マスクは
デスマスが　人間だった　ときの　顔。
たまに　見つめては　泣いている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_563_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちかづいた　にんげんを　のみこんで
ミイラに　してしまうという　うわさ。
きんかいを　このんで　たべる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>近づいた　人間を　飲み込んで
ミイラに　してしまうという　ウワサ。
金塊を　好んで　食べる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_564_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こだいの　かせきから　ふっかつした。
ふかさ　１０００メートルまで
せんすいすることが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古代の　化石から　復活した。
深さ　１０００メートルまで
潜水することが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_565_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うみと　りくちで　せいかつする。
はりてで　タンカーの　ふなぞこに
あなを　あける　パワーの　もちぬし。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海と　陸地で　生活する。
張り手で　タンカーの　船底に
穴を　開ける　パワーの　持ち主。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_566_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とりポケモンの　そせんと　いわれる。
とぶことは　できず　えだから　えだへ
とびうつり　せいかつしていたらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とりポケモンの　祖先と　言われる。
飛ぶことは　できず　枝から　枝へ
飛び移り　生活していたらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_567_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちじょうで　じょそうを　つけてから
とびたつ。なかまと　きょうりょくして
えものを　しとめる　ちのうを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地上で　助走を　つけてから
飛び立つ。仲間と　協力して
獲物を　しとめる　知能を　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_568_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふえいせいな　ばしょを　このむ。
ゲップのように　はきだす　ガスを
すいこむと　１しゅうかん　ねこむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不衛生な　場所を　好む。
ゲップのように　吐き出す　ガスを
吸い込むと　１週間　寝込む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_569_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひだりうでで　あいてを　しめつけて
くちから　はきだす　あくしゅうの
どくガスで　とどめを　さすのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>左腕で　相手を　絞めつけて
口から　吐き出す　悪臭の　毒ガスで
とどめを　刺すのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_570_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいての　すがたに　ばけてみせて
おどろかせる。むくちな　こどもに
ばけている　ことが　おおいらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手の　姿に　化けてみせて
驚かせる。無口な　子供に
化けている　ことが　多いらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_571_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてを　ばかす　ことで　むれの
あんぜんを　まもってきた　ポケモン。
なかまの　けっそくが　かたい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手を　化かす　ことで　群れの
安全を　守ってきた　ポケモン。
仲間同士の　結束が　固い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_572_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽで　おたがいの　からだを
なでて　あいさつ。しっぽの　ていれを
かかさず　いつも　きれいにしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽで　お互いの　体を
なでて　あいさつ。しっぽの　手入れを
欠かさず　いつも　きれいにしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_573_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろい　たいもうは　とくべつな
あぶらで　コーティングされているので
てきの　こうげきを　うけながすのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白い　体毛は　特別な　脂で
コーティングされているので
敵の　攻撃を　受け流すのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_574_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リボンのような　しょっかくで
サイコパワーを　ぞうふくさせる。
なにかを　じっと　みつめている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リボンのような　触角で
サイコパワーを　増幅させる。
なにかを　じっと　見つめている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_575_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいみんじゅつで　ポケモンや　ひとを
あやつる。ねむったまま　ゴチミルに
つれさられる　むかしばなしも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>催眠術で　ポケモンや　人を　操る。
眠ったまま　ゴチミルに　連れ去られる
昔話が　各地に　残っている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_576_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうりょくな　サイコパワーの
えいきょうで　くうかんが　ねじれて
しゅういに　ほしぞらが　うつるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強力な　サイコパワーの　影響で
ゴチルゼルの　周囲の　空間が　ねじれ
何万光年も　遠くの　星空が　映る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_577_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サイコパワーを　ほうしゅつして
おそってきた　てきを　げきたい。
テレパシーで　なかまと　かいわする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サイコパワーを　放出して
襲ってきた　敵を　撃退。
テレパシーで　仲間と　会話する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_578_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２つに　ぶんれつした　のうみそを
もっているため　いきなり　ちがう
こうどうを　とることが　あるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２つに　分裂した　脳みそを
持っているため　いきなり　違う
行動を　とることが　あるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_579_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ランクルス　どうしが　あくしゅすると
のうみそが　ネットワークで　つながり
サイコパワーが　ぞうふくされるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ランクルス　同士が　握手すると
脳みそが　ネットワークで　つながり
サイコパワーが　増幅されるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_580_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せんすいが　とくいな　とりポケモン。
こうぶつの　みずゴケを　たべるため
すいちゅうを　およぎまわる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>潜水が　得意な　とりポケモン。
好物の　みずゴケを　食べるため
水中を　泳ぎまわる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_581_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よあけと　ともに　スワンナたちは
おどりはじめる。まんなかで　おどる
スワンナが　むれの　リーダー。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夜明けと　ともに　スワンナたちは
踊りはじめる。真ん中で　踊る
スワンナが　群れの　リーダー。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_582_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マイナス５０どの　いきを　はく。
ゆきの　けっしょうを　つくって
あたりに　ゆきを　ふらせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マイナス５０度の　息を　吐く。
雪の　結晶を　作って
あたりに　雪を　降らせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_583_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆきやまに　せいそくする　ポケモン。
おおむかし　ひょうがきの　ときに
みなみの　とちへ　いどうしてきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雪山に　生息する　ポケモン。
大昔　氷河期の　ときに
南の　土地に　移動してきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_584_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みずを　たいりょうに　のみこんで
たいないで　ゆきぐもを　つくる。
もうふぶきで　てきを　くるしめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>水を　大量に　飲み込んで
体内で　雪雲を　作る。
猛吹雪で　敵を　苦しめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_585_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいもうが　のやまの　くさと　おなじ
いろと　かおりに　かわる。てきいを
かんじると　くさむらに　かくれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体毛が　野山の　草と
同じ　色と　香りに　変わる。
敵意を　感じると　草むらに　隠れる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_586_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きせつに　よって　すみかを　かえる。
ひとびとは　メブキジカの　ツノで
きせつの　うつりかわりを　かんじる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>季節によって　住処を　変える。
人々は　メブキジカの　ツノで
季節の　移り変わりを　感じる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_587_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほほの　でんきぶくろで　つくった
でんきを　まくの　うちがわに　ためて
かっくうしながら　でんきを　はなつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほほの　電気袋で　作った　電気を
膜の　内側に　ためて
滑空しながら　電気を　放つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_588_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チョボマキと　いっしょに　いるときに
でんきてきな　しげきを　うけると
しんかする　ふしぎな　ポケモンだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チョボマキと　一緒に　いるときに
電気的な　刺激を　受けると
進化する　不思議な　ポケモンだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_589_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうそくで　とびまわり　するどい
やりで　あいてを　つく。ふりな
あいてにも　ゆうかんに　たちむかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高速で　飛び回り　鋭い　やりで
相手を　突く。不利な　相手にも
勇敢に　立ち向かう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_590_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モンスターボールに　にた　もようで
さそい　どくほうしを　ふきかける。
なぜ　にているかは　なぞである。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モンスターボールに　似た　模様で
誘い　毒胞子を　吹きかける。
なぜ　似ているかは　ナゾである。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_591_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょううでの　モンスターボールに
にた　カサを　ゆらゆらと　うごかして
えものを　さそう　ダンスを　おどる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両腕の　モンスターボールに　似た
カサを　ゆらゆらと　動かして
獲物を　誘う　ダンスを　踊る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_592_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うすい　ベールのような　うでで
あいての　からだを　しばりつけたまま
うみの　そこへ　しずんでいくのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>薄い　ベールのような　腕で
相手の　体を　縛りつけたまま
海の　底へ　沈んでいくのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_593_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ブルンゲルの　すみかに　まよいこんだ
ふねは　しずめられて　のりくみいんの
いのちは　すいとられて　しまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ブルンゲルの　住処に　迷い込んだ
船は　沈められて　乗組員の　命は
吸い取られて　しまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_594_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ママンボウの　からだを　おおう
とくしゅな　ねんまくには
きずを　なおす　こうかが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ママンボウの　体を　おおう
特殊な　粘膜には
傷を　治す　効果が　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_595_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まちなかで　くらす　バチュルは
みんかの　コンセントから　でんきを
すいとる　すべを　おぼえている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>街中で　暮らす　バチュルは
民家の　コンセントから　電気を
吸い取る　術を　覚えている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_596_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てきに　おそわれると　でんきを
おびた　いとを　たくさん　はきだして
でんきの　バリアを　つくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>敵に　襲われると　電気を　帯びた
糸を　たくさん　吐き出して
電気の　バリアを　作る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_597_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きけんを　さっちすると　トゲを
いっせいに　はっしゃして　はんげき。
その　すきに　ころがって　にげる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>危険を　察知すると　トゲを
いっせいに　発射して　反撃。
その　すきに　転がって　逃げる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_598_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３ほんの　トゲつきの　しょくしゅを
ふりまわして　たたかう。おおいわを
ふんさいする　はかいりょくだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３本の　トゲつき　触手を　振り回して
戦う。鋼の　トゲは　たたきつけると
大岩を　粉砕する　破壊力だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_599_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２つの　からだは　くみあわせが
きまっている。べつの　からだとは
かみあわずに　はなれてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２つの　体は　組み合わせが
決まっている。別の　体とは
かみ合わずに　離れてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_600_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいてんほうこうを　かえる　ことで
なかまに　きもちを　つたえている。
おこるほど　かいてんが　はやくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>回転方向を　変える　ことで
仲間に　気持ちを　伝えている。
怒るほど　回転が　速くなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_601_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あかい　コアは　エネルギータンクの
やくわり。チャージした　エネルギーを
トゲから　しゅういに　うちだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>赤い　コアは　エネルギータンクの
役割。チャージした　エネルギーを
トゲから　周囲に　撃ち出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_602_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１ぴきの　でんりょくは　ちいさいが
たくさんの　シビシラスが　つながると
カミナリと　おなじ　いりょくになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１匹の　電力は　小さいが
たくさんの　シビシラスが　つながると
雷と　同じ　威力になる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_603_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まるい　もようが　はつでん　きかん。
あいてに　まきついてから　もようを
おしつけて　でんきを　ながすのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>丸い　模様が　発電　器官。
相手に　巻きついてから　模様を
押しつけて　電気を　流すのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_604_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うでの　ちからで　うみから　はいだし
みずべの　えものに　おそいかかる。
いっしゅんで　うみへ　ひきずりこむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腕の　力で　海から　はい出し
水辺の　獲物に　襲いかかる。
一瞬で　海へ　引きずり込む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_605_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよい　サイコパワーを　あやつる。
サイコパワーで　あいての　のうみそを
しめつけて　ずつうを　おこさせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強力な　サイコパワーを　操る。
サイコパワーで　相手の　脳みそを
絞めつけて　頭痛を　起こさせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_606_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいての　きおくを　そうさする。
３しょくの　ゆびを　てんめつさせて
なかまと　かいわしている　らしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手の　記憶を　操作する。
３色の　指を　点滅させて
仲間と　会話している　らしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_607_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒトモシの　ともす　あかりは
ひとや　ポケモンの　せいめいりょくを
すいとって　もえているのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒトモシの　灯す　明かりは
人や　ポケモンの　生命力を
吸い取って　燃えているのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_608_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふきつな　ポケモンと　こわがられる。
ししゃの　たましいを　もとめて
まちなかを　フラフラと　さまよう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不吉な　ポケモンと　怖がられる。
死者の　魂を　求めて
街中を　フラフラと　さまよう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_609_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たましいを　すいとって　もやす。
ほのおを　ゆらして　あいてを
さいみんじょうたいに　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>魂を　吸い取って　燃やす。
腕の　炎を　揺らして
相手を　催眠状態に　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_610_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きのみを　キバで　くだいて　たべる。
なんかいも　はえかわることで
つよく　するどい　キバに　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>木の実を　キバで　砕いて　食べる。
何回も　生え変わることで
強く　鋭い　キバに　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_611_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おれた　キバは　はえかわらないので
たたかいが　おわると　かわらの
いわで　キバを　たんねんに　みがく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>折れた　キバは　生え変わらないので
戦いが　終わると　河原の　岩で
キバを　丹念に　磨く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_612_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やさしい　せいかくだが　なわばりを
あらす　ものには　ようしゃしない。
てつを　きる　キバで　いどみかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>優しい　性格だが　縄張りを　荒らす
者には　容赦しない。
鉄を　切る　キバで　挑みかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_613_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぐあいが　わるくなると　はなみずが
みずっぽくなり　こおりわざの
いりょくが　おちてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>具合が　悪くなると
鼻水が　水っぽくなり　こおり技の
威力が　落ちてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_614_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はく　いきを　じざいに　こおらせる。
およぎが　とくいで　きたの　うみを
およぎまわり　えものを　つかまえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>吐く　息を　自在に　凍らせる。
泳ぎが　得意で　北の　海を
泳ぎまわり　獲物を　捕まえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_615_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいおんが　あがると　すいじょうきに
なって　すがたを　けす。たいおんが
さがると　もとの　こおりに　もどる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体温が　上がると　水蒸気に　なって
姿を　消す。体温が　下がると
元の　氷に　戻る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_616_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てきに　おそわれると　カラの　ふたを
とじて　ぼうぎょ。ふたの　すきまから
ベトベトした　どくえきを　とばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>敵に　襲われると　殻の　ふたを
閉じて　防御。ふたの　すきまから
ベトベトした　毒液を　飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_617_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだが　かわくと　よわってしまう。
うすい　まくを　なんじゅうも　まいて
かんそうを　ふせいでいるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体が　乾くと　弱ってしまう。
薄い　膜を　何重も　巻いて
乾燥を　防いでいるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_618_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひふが　かたいので　すもうとりに
ふまれても　へいき。でんきを
ながすとき　わらいがおに　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>皮膚が　硬いので
相撲取りに　踏まれても　平気。
電気を　流すとき　笑い顔に　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_619_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながれるような　れんぞく　こうげきを
くりだして　てきを　あっとうする。
するどい　ツメで　てきを　きりさく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>流れるような　連続　攻撃を
繰り出して　敵を　圧倒する。
鋭い　ツメで　敵を　切り裂く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_620_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うでの　たいもうを　ムチのように
あつかう。りょううでの　こうげきは
めにも　とまらぬ　はやさ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腕の　体毛を　ムチのように
あつかう。両腕の　攻撃は
目にも　止まらぬ　速さ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_621_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にっこうを　つばさで　うけて
からだを　あたためる。たいおんが
さがると　うごけなくなってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>日光を　翼で　受けて　体を　温める。
体温が　下がると
動けなくなってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_622_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないで　もえる　エネルギーに
よって　かつどうしているが　どんな
エネルギーなのかは　ふめいである。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内で　燃える　エネルギーに　よって
活動しているが　どんな
エネルギーなのかは　不明である。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_623_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マッハの　スピードで　そらを　とぶ。
むねの　ふういんを　はがすと
エネルギーが　ぼうそうしてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マッハの　スピードで　空を　飛ぶ。
胸の　封印を　はがすと
エネルギーが　暴走してしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_624_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんが　はものの　ポケモン。
たたかいで　はこぼれすると　かわらの
てごろな　いしで　はを　とぐ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身が　刃物の　ポケモン。
戦いで　刃こぼれすると　
河原の　石で　刃を　とぐ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_625_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コマタナの　むれを　ひきいている。
ボスの　ざを　うばいあい　たたかう。
やぶれると　むれを　おいだされる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コマタナの　群れを　率いている。
ボスの　座を　奪い合い　戦う。
敗れると　群れを　追い出される。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_626_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はげしい　ずつきを　くらわせても
ふさふさの　たいもうが　ダメージを
きゅうしゅうして　くれるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>激しい　頭突きを　食らわせても
ふさふさの　体毛が
ダメージを　吸収して　くれるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_627_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きゃくりょくで　きのみを　くだく。
どんなに　つよい　あいてでも
ゆうかんに　たちむかう　しゅうせい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>脚力で　きのみを　砕く。
どんなに　強い　相手でも
勇敢に　立ち向かう　習性。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_628_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なかまのため　きけんを　かえりみず
たたかう。じどうしゃを　つかんだまま
おおぞらを　まう　ことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仲間のため　危険を　かえりみず
戦う。自動車を　つかんだまま
大空を　舞う　ことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_629_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つばさが　ちいさいため　とべない。
しんかの　ときが　ちかづくと
じぶんから　ガイコツを　ぬぎすてる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>翼が　小さいため　飛べない。
進化の　ときが　近づくと
自分から　ガイコツを　脱ぎ捨てる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_630_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほねを　ひろい　あつめて　すづくり。
よわった　えものを　あしで　つかみ
ほねの　すまで　かるがると　はこぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>骨を　拾い　集めて　巣作り。
弱った　獲物を　脚で　つかみ
骨の　巣まで　軽々と　運ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_631_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　あなから　くうきを　すって
たいないで　ほのおを　もやす。
アイアントの　てんてき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　穴から　空気を　吸って
体内で　炎を　燃やす。
アイアントの　天敵。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_632_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はがねの　よろいを　みにまとう。
てんてきの　クイタランの　こうげきを
しゅうだんで　ふせぎ　はんげきする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼の　よろいを　身にまとう。
天敵の　クイタランの　攻撃を
集団で　防ぎ　反撃する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_633_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんにでも　かみつく　しゅうせい。
たべられるものは　なんでも　たべる。
うかつに　ちかよると　きけんだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんにでも　かみつく　習性。
食べられるものは　なんでも　食べる。
うかつに　近寄ると　危険だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_634_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばりの　エサを　たべつくすと
ほかの　とちへ　いどうする。
２つの　あたまは　なかが　わるい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張りの　エサを　食べつくすと
ほかの　土地へ　移動する。
２つの　頭は　仲が　悪い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_635_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>６まいの　はねで　そらを　とびつづけ
うごくものを　てきと　おもいこみ
おそう　きょうぼうな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>６枚の　羽で　空を　飛び続け
動くものを　敵と　思い込み　襲う
凶暴な　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_636_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいようから　うまれた　ポケモンと
しんじられてきた。しんかするとき
ぜんしんが　ほのおに　つつまれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太陽から　生まれた　ポケモンと
信じられてきた。進化するとき
全身が　炎に　包まれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_637_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かざんばいで　ちじょうが　まっくらに
なったとき　ウルガモスの　ほのおが
たいようの　かわりに　なったという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>火山灰で　地上が　真っ暗に
なったとき　ウルガモスの　炎が
太陽の　代わりに　なったという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_638_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンを　まもるため　にんげんと
あらそった　でんせつの　ポケモン。
ちんちゃく　れいせいな　せいかく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンを　守るため
人間と　争った　伝説の　ポケモン。
沈着　冷静な　性格。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_639_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にんげん　どうしの　せんそうによって
すみかを　うしなった　ポケモンたちを
まもるため　にんげんと　たたかった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人間　同士の　戦争によって
住処を　失った　ポケモンたちを
守るため　人間と　戦った。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_640_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なかまを　まもるため　にんげんに
たたかいを　いどんだ　ポケモン。
でんせつで　かたりつがれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仲間を　守るため
人間に　戦いを　挑んだ　ポケモン。
伝説で　語り継がれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_641_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くものような　エネルギーたいに
かはんしんが　つつまれている。
じそく３００キロで　そらを　とぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雲のような　エネルギー体に
下半身が　包まれている。
時速３００キロで　空を　飛ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_642_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ボルトロスが　とおりすぎた　とちには
カミナリの　おちた　むすうの　あとが
やけこげとなって　のこっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボルトロスが　通り過ぎた　土地には
雷の　落ちた　無数の　跡が
焼け焦げとなって　残っている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_643_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんわに　とうじょうする　ポケモン。
しっぽから　ほのおを　ふきあげて
すべての　ものを　やきつくす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>神話に　登場する　ポケモン。
しっぽから　炎を　吹き上げて
すべての　ものを　焼きつくす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_644_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽで　でんきを　つくりだす。
ぜんしんを　かみなりぐもに　かくして
イッシュちほうの　そらを　とぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽで　電気を　作り出す。
全身を　雷雲に　隠して
イッシュ地方の　空を　飛ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_645_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ランドロスの　おとずれる　とちは
さくもつが　たくさん　みのるため
はたけのかみさま　と　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ランドロスが　訪れる　土地は
作物が　たくさん　実るため
畑の神様　と　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_646_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうりょくな　れいとうエネルギーを
たいないで　つくりだすが　もれだした
れいきで　からだが　こおっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強力な　冷凍エネルギーを
体内で　作り出すが　漏れ出した
冷気で　体が　凍っている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_647_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひづめから　みずを　ふきだすことで
すいめんを　すべるように　いどう。
とくいの　あしわざで　たたかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ひづめから　水を　吹き出すことで
水面を　滑るように　移動。
得意の　足技で　戦う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_648_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とくしゅな　はっせいほうで　うたう
メロディは　きいた　ものの
かんじょうを　じざいに　あやつる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>特殊な　発声法で　歌う　メロディは
聞いた　者の　感情を
自在に　操る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_649_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３おくねんまえに　さいきょうの
ハンターとして　おそれられていた。
プラズマだんに　かいぞうされた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３億年前に　最強の　ハンターとして
恐れられていた。
プラズマ団に　改造された。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_650_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text />
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text />
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_201_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１ぴきで　いても　なにも　おきないが
２ひき　いじょうで　ならぶと
なにかの　ちからが　めばえるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１匹で　いても　なにも　起きないが
２匹　以上で　並ぶと
なにかの　力が　芽生えるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_201_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１ぴきで　いても　なにも　おきないが
２ひき　いじょうで　ならぶと
なにかの　ちからが　めばえるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
