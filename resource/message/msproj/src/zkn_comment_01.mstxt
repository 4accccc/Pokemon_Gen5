	<TextRow
		Label="ZKN_COMMENT_01_586_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きせつに　よって　すみかを　かえる。
ひとびとは　アントレスの　ツノで
きせつの　うつりかわりを　かんじる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>季節によって　住処を　変える。
人々は　アントレスの　ツノで
季節の　移り変わりを　感じる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_586_002"
