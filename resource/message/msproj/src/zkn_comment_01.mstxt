<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="ZKN_COMMENT_01_000_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text />
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text />
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_001_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うまれてから　しばらくの　あいだは
せなかの　タネから　えいようを
もらって　おおきく　そだつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれてから　しばらくの　あいだは
背中の　タネから　栄養をもらって
大きく　育つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_002_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せなかの　つぼみが　ふくらみだすと
あまい　においが　ただよいはじめる。
たいりんの　はなが　さく　まえぶれ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>背中の　つぼみが　膨らみだすと
甘い　においが　漂いはじめる。
大輪の　花が　咲く　前触れ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_003_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あめの　ふった　よくじつは　せなかの
はなの　かおりが　つよまる。かおりに
さそわれ　ポケモンが　あつまる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雨の降った　翌日は
背中の　花の　香りが　強まる。
香りに　誘われ　ポケモンが　集まる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_004_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒトカゲの　しっぽの　ほのおは
いのちの　ともしび。げんきな　ときは
ほのおも　ちからづよく　もえあがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒトカゲの　しっぽの　炎は
命の　ともしび。元気な　ときは
炎も　力強く　燃え上がる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_005_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リザードが　くらす　いわやまを
よなかに　みあげると　しっぽの
ほのおが　ほしのように　みえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リザードが　暮らす　岩山を
夜中に　見上げると
しっぽの　炎が　星のように　見える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_006_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くるしい　たたかいを　けいけんした
リザードンほど　ほのおの　おんどが
たかくなると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>苦しい　戦いを　経験した
リザードンほど　炎の　温度が
高くなると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_007_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうらに　とじこもり　みを　まもる。
あいての　すきを　みのがさず
みずを　ふきだして　はんげきする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甲羅に　閉じこもり　身を守る。
相手の　すきを　見逃さず
水を　吹き出して　反撃する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_008_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちまんねんの　じゅみょうを　もつと
いわれている。ふさふさの　しっぽは
ながいきの　シンボルとして　にんき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１万年の　寿命を　持つと
言われている。ふさふさの　しっぽは
長生きの　シンボルとして人気。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_009_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうらの　ロケットほうから　ふきだす
すいりゅうは　ぶあつい　てっぱんも
いっぱつで　つらぬく　はかいりょく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甲羅の　ロケット砲から　吹き出す
水流は　分厚い　鉄板も
一発で　貫く　破壊力。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_010_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あかい　しょっかくから　においを
だして　てきを　おいはらう。
だっぴを　くりかえし　おおきくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>赤い　触角から　においを出して
敵を　追い払う。
脱皮を　繰り返し　大きくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_011_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうてつのように　かたい　カラで
やわらかい　なかみを　まもっている。
しんかするまで　じっと　たえている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼鉄のように　硬い　殻で
やわらかい　中身を　守っている。
進化するまで　じっと　耐えている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_012_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなの　ミツが　だいこうぶつ。
わずかな　かふんで　はなばたけの
ばしょを　さがしだすことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>花の　ミツが　大好物。
わずかな　花粉で　花畑の
場所を　探し出すことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_013_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいにち　じぶんと　おなじ　おもさの
はっぱを　たべる。あたまの　ハリで
おそってきた　てきを　げきたい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>毎日　自分と　同じ　重さの
葉っぱを　食べる。頭の　針で
襲ってきた　敵を　撃退。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_014_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんてきに　みつからないように
はっぱの　うらや　えだの　すきまに
かくれて　しんかの　ときを　まつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>天敵に　見つからないように
葉っぱの　裏や　枝の　すきまに
隠れて　進化の　ときを　待つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_015_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうそくで　とびまわり　どくバリで
こうげきしたあと　すぐに　とびさる
せんぽうが　とくいわざだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高速で　飛びまわり　毒針で
攻撃したあと　すぐに　飛び去る
戦法が　得意技だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_016_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たたかいを　このまない　おとなしい
せいかくだが　へたに　てを　だすと
きょうれつに　はんげきされるぞ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>戦いを　好まない　大人しい
性格だが　下手に　手を　出すと
強烈に　反撃されるぞ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_017_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひろい　なわばりを　とびまわりながら
えものを　さがす。はったつした
あしの　ツメで　えものを　しとめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>広い　縄張りを　飛び回りながら
獲物を　探す。発達した
足の　ツメで　獲物を　しとめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_018_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ピジョットが　ちからいっぱい
はばたくと　たいぼくも　しなるほどの
きょうふうを　まきおこす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ピジョットが　力いっぱい
羽ばたくと　大木も　しなるほどの
強風を　巻き起こす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_019_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１にちじゅう　エサを　さがしている。
キバは　しぬまで　のびつづけるので
かたいものを　かじって　けずる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１日中　エサを　探している。
キバは　死ぬまで　伸び続けるので
硬いものを　かじって　削る。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_020_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いがいと　きょうぼうな　ポケモン。
ながく　のびた　キバは　ぶあつい　
コンクリートも　かんたんに　けずる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>意外と　凶暴な　ポケモン。
長く　伸びた　キバは　分厚い　
コンクリートも　簡単に　削る。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_021_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさな　つばさを　いそがしく
はばたかせて　とぶ。くさむらにいる
えものを　くちばしで　さがしだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　翼を　忙しく
羽ばたかせて　飛ぶ。草むらにいる
獲物を　クチバシで　探し出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_022_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　つばさで　１にちじゅう
とびまわる　たいりょくの　もちぬし。
するどい　くちばしで　たたかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　翼で　１日中
飛び回る　体力の　持ち主。
鋭い　クチバシで　戦う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_023_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとを　まったく　たてずに　くさちの
なかを　すすむ。ゆだんしている
えものに　はいごから　おそいかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>音を　まったく　立てずに　草地の
中を　進む。油断している獲物に
背後から　襲いかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_024_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなかの　もようで　てきを　いかく。
もように　おびえて　うごけなくなった
すきに　からだで　しめつける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お腹の　模様で　敵を　威嚇。
模様に　おびえて　動けなくなった
すきに　体で　絞めつける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_025_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よわった　なかまの　ピカチュウに
でんきをながし　ショックをあたえて
げんきを　わけることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>弱った　仲間の　ピカチュウに
電気を流し　ショックを与えて
元気を　分けることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_026_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽが　アースの　やくめをはたして
でんきを　じめんに　にがすので
じぶんじしんは　しびれたりしない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽが　アースの　役目をはたして
電気を　地面に　逃がすので
自分自身は　しびれたりしない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_027_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふかいあなを　ほって　せいかつ。
きけんが　せまると　からだを　まるめ
てきの　こうげきを　じっと　たえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深い穴を　掘って　生活。
危険が　迫ると　体を　丸め
敵の　攻撃を　じっと　耐える。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_028_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トゲは　ひふが　かたくなったもの。
からだを　まるめて　トゲトゲを
さすように　あいてを　こうげきする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トゲは　皮膚が　硬くなったもの。
体を　丸めて　トゲトゲを
刺すように　相手を　攻撃する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_029_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たたかいを　このまない　せいかく。
どくバリから　ぶんぴつされる　どくは
ひとしずくでも　いのちとりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>戦いを　好まない　性格。
毒針から　分泌される　毒は
一滴でも　命取りだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_030_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きけんを　かんじると　ぜんしんの
トゲを　さかだてる。ニドリーノに
くらべて　トゲの　そだちが　おそい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>危険を　感じると　全身のトゲを
逆立てる。ニドリーノに　比べて
トゲの　育ちが　遅い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_031_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よろいのように　かたい　ウロコが
ぜんしんを　つつむ。すあなの
こどもを　いのちがけで　まもる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よろいのように　硬い　ウロコが
全身を　包む。
巣穴の　子供を　命がけで　守る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_032_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くさむらの　うえに　みみだけ　だして
まわりの　けはいを　さぐる。
もうどくの　ツノで　みを　まもる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>草むらの　上に　耳だけ　出して
まわりの　気配を　探る。
猛毒の　ツノで　身を　守る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_033_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きしょうが　あらい　ポケモン。
あいてに　つきさした　しょうげきで
ツノから　もうどくが　にじみでる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気性が　荒い　ポケモン。
相手に　突き刺した　衝撃で
ツノから　猛毒が　にじみ出る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_034_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　いちげきは　でんちゅうを
まるで　マッチぼうのように
まっぷたつに　へしおってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　一撃は　電柱を
まるで　マッチ棒のように
真っ二つに　へし折ってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_035_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まんげつの　よる　どこから　ともなく
あつまり　ピッピたちは　おどりだす。
つきのひかりを　あびて　うかぶのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>満月の　夜　どこから　ともなく
集まり　ピッピたちは　踊りだす。
月の光を　浴びて　浮かぶのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_036_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１キロさきに　おちた　はりの　おとも
きこえるほど　みみが　いいので
ふだんは　しずかな　ところに　いる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１キロ先に　落ちた　針の　音も
きこえるほど　耳が　いいので
普段は　静かな　ところに　いる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_037_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>６ほんの　シッポは　そだつごとに
けなみが　よくなり　うつくしくなる。
だきしめると　ほんのり　あたたかい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>６本の　シッポは　育つごとに
毛並みが　よくなり　美しくなる。
抱きしめると　ほんのり　暖かい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_038_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>９ほんの　ながい　シッポ　それぞれに
じんつうりきが　こめられており
１０００ねん　いきることが　できる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>９本の　長い　シッポ　それぞれに
神通力が　こめられており
１０００年　生きることが　できる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_039_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つぶらな　ひとみを　みつめていると
ねむらずには　いられないほどの
ここちよい　うたを　うたいはじめる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>つぶらな　ひとみを　みつめていると
眠らずには　いられないほどの
心地よい　歌を　歌いはじめる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_040_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きめこまやかな　たいもうは
てざわりが　よすぎて　うっかり
さわると　はなれられなくなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きめこまやかな　体毛は
手触りが　よすぎて　うっかり
触ると　離れられなくなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_041_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょうおんぱを　だして　まわりの
ようすを　たしかめながら　とぶので
りょうめが　なくても　だいじょうぶ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>超音波を　だして　周りの
様子を　確かめながら　飛ぶので
両目が　なくても　大丈夫。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_042_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まよなか　かっぱつに　とびまわり
ねらいをつけた　えものに　キバを
さし　しぬほど　ちを　すいまくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>真夜中　活発に　飛び回り
ねらいをつけた　獲物に　キバを
刺し　死ぬほど　血を　吸いまくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_043_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひるまは　ねっこの　あしを　じめんに
うめて　うごかないことが　おおい。
よる　あるきまわって　タネを　まく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昼間は　根っこの　足を　地面に
埋めて　動かないことが　多い。
夜　歩き回って　タネを　まく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_044_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くちから　たれている　ミツは
２キロ　はなれていても　はなが
まがるほど　もうれつに　くさい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>口から　たれている　ミツは
２キロ　離れていても　鼻が
まがるほど　猛烈に　くさい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_045_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなびらの　おおきさは　せかいいち。
ひどい　アレルギーを　ひきおこす
どくかふんを　ばらまいて　あるく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>花びらの　大きさは　世界一。
ひどい　アレルギーを　引き起こす
毒花粉を　ばらまいて　歩く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_046_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とうちゅうかそうと　よばれる
キノコを　せなかに　はやしている。
パラスと　ともに　おおきく　そだつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>冬虫夏草と　呼ばれる
キノコを　背中に　生やしている。
パラスと　ともに　大きく　育つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_047_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだよりも　おおきな　キノコが
パラセクトを　あやつっている。
どくの　ほうしを　ばらまく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体よりも　大きな　キノコが
パラセクトを　操っている。
毒の　胞子を　ばらまく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_048_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさな　めが　たくさん　あつまって
おおきな　めに　なっている。
よるになると　あかりに　あつまる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　目が　たくさん　集まって
大きな　目に　なっている。
夜になると　明かりに　集まる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_049_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はばたいて　りんぷんを　まきちらす。
りんぷんが　からだに　つくと　どくの
せいぶんが　ひふに　しみこんでくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>羽ばたいて　りんぷんを　まき散らす。
りんぷんが　体に　つくと　毒の
成分が　皮膚に　染み込んでくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_050_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちちゅうで　くらしている　ポケモン。
くらい　ちかに　いるため
あかるい　たいようが　にがて。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地中で　暮らしている　ポケモン。
暗い　地下に　いるため
明るい　太陽が　苦手。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_051_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３つの　あたまが　たがいちがいに
うごいて　どんなに　かたい　ちそうも
ちか１００キロまで　ほりすすむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３つの　頭が　互い違いに　動いて
どんなに　硬い　地層も
地下１００キロまで　掘り進む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_052_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よなかに　こうどうする　しゅうせい。
きらきら　ひかるものを　みつけると
まけないくらい　ひとみが　かがやく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夜中に　行動する　習性。
キラキラ　光るものを　見つけると
負けないくらい　ひとみが　輝く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_053_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きぐらいが　たかい　ポケモン。
マニアの　あいだでは　ひたいの
ほうせきの　サイズが　わだいになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気位が　高い　ポケモン。
マニアの　あいだでは　額の
宝石の　サイズが　話題になる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_054_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ずつうで　ふだん　ねむっている
のうさいぼうが　しげき　されると
ふしぎな　ちからが　つかえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭痛で　普段　眠っている
脳細胞が　刺激　されると
不思議な　力が　使える。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_055_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひたいが　あやしく　かがやくとき
ゴルダックは　もてる　ちからを
１００パーセント　はっき　できる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>額が　あやしく　輝くとき
ゴルダックは　持てる　力を
１００パーセント　発揮できる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_056_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きのうえで　せいかつしている。
むれの　１ぴきが　おこりはじめると
ぜんいんが　いみもなく　あばれだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>木の上で　生活している。
群れの　１匹が　怒り出すと
全員が　意味もなく　暴れだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_057_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しせんが　あっただけで　おこり
にげだしたら　また　おこり
たたきのめしても　まだ　おこる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>視線が　合っただけで　怒り
逃げ出したら　また　怒り
たたきのめしても　まだ　怒る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_058_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーに　とても　ちゅうじつで
うっかり　ちかづくと　はげしく
ほえたて　まちのそとに　おいはらう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーに　とても　忠実で
うっかり　近づくと　激しく
ほえたて　街の外に　追い払う。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_059_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっちゅうやで　１００００キロの
きょりを　かけぬける　すがたは
おおくの　ひとを　みりょうしてきた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一昼夜で　１００００キロの
距離を　駆けぬける　姿は
多くの　人を　魅了してきた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_060_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ないぞうが　すけて　みえるほど
ひふが　うすい。はえたばかりの
あしは　あるくことが　にがて。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>内臓が　透けて　見えるほど
皮膚が　薄い。生えたばかりの
足は　歩くことが　苦手。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_061_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなかの　うずまきは　びみょうに
うねっているので　みつめていると
だんだん　ねむくなってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お腹の　渦巻きは　微妙に
うねっているので　見つめていると
だんだん　眠くなってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_062_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうじんな　きんにくを　もつ。
たいへいようを　やすむことなく
およぎつづけることが　できるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強じんな　筋肉を　持つ。
太平洋を　休むことなく
泳ぎ続けることが　できるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_063_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょうのうりょくを　つかったあとは
のうみそが　つかれてしまうので
１にちに　１８じかんも　ねむるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>超能力を　使った後は
脳みそが　疲れてしまうので
１日に　１８時間も　眠るのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_064_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぎんのスプーンを　みつめて
せいしんを　とういつ　していると
はっさんする　アルファは　がふえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>銀のスプーンを　見つめて
精神を　統一　していると
発散する　アルファ波　が増える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_065_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうてに　もつ　スプーンは
フーディンの　ちょうのうりょくで
うみだしたモノと　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両手に　持つ　スプーンは
フーディンの　超能力で
生み出したモノと　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_066_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こがらな　からだだけど　ちからもち。
イシツブテなら　なんびきも　まとめて
かるがると　もちあげ　なげとばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小柄な　体だけど　力持ち。
イシツブテなら　何匹も　まとめて
軽々と　持ち上げ　投げ飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_067_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだを　きたえるために　よろこんで
おもい　にもつを　はこぶので
ひとのかわりに　ちからしごとをする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を　鍛えるために　喜んで
重い　荷物を　運ぶので
人の代わりに　力仕事をする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_068_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>４ほんの　ちからづよい　うでは
めにも　とまらぬ　はやさで
パンチや　チョップを　たたきこむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>４本の　力強い　腕は
目にも　止まらぬ　速さで
パンチや　チョップを　たたき込む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_069_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうおん　たしつの　とちを　このむ。
ツルを　のばして　えものを　とらえる
ときの　うごきは　とても　すばやい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高温　多湿の　土地を　好む。
ツルを　伸ばして　獲物を　捕らえる
ときの　動きは　とても　素早い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_070_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょくぶつに　そっくりな　ポケモン。
ゆだんして　ちかよってきた　えものに
どくのこなを　あびせて　つかまえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>植物に　そっくりな　ポケモン。
油断して　近寄って来た　獲物に
毒の粉を　あびせて　捕まえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_071_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミツのような　かおりの　えきたいを
くちに　ためているが　それは
なんでも　とかす　ようかいえきだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミツのような　香りの　液体を
口に　ためているが　それは
なんでも　溶かす　溶解液だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_072_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　ほとんどが　みずなので
なみに　ながされ　すなはまに
うちあげられると　ひからびてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　ほとんどが　水なので
波に　流され　砂浜に
打ち上げられると　干からびてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_073_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>８０ぽんの　しょくしゅを　のばして
どくの　ほういもうを　つくりだす。
つかまると　にげるのは　むずかしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>８０本の　触手を　伸ばして
毒の　包囲網を　作り出す。
捕まると　逃げるのは　難しい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_074_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じっとしていると　いしころ　にしか
みえないので　つい　ふみつけると
げんこつを　ふりまわして　おこる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジッとしていると　石ころ　にしか
見えないので　つい　踏みつけると
ゲンコツを　振りまわして　怒る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_075_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やまみちを　ころがって　いどう。
いきおいが　ついてくると　どんな
ポケモンでも　とめるのは　たいへん。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>山道を　転がって　移動。
勢いが　ついてくると　どんな
ポケモンでも　止めるのは　大変。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_076_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんせきの　ような　かたい　からだは
ダイナマイトでも　きずつかない。
１ねんに　１どだけ　だっぴする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>岩石の　ような　硬い　体は
ダイナマイトでも　傷つかない。
１年に　１度だけ　脱皮する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_077_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うまれたばかりでは　たつのがやっと。
だが　はしるほどに　あしこしは
きたえられて　そくどが　ましていく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれたばかりでは　立つのがやっと。
だが　走るほどに　足腰は
鍛えられて　速度が　増していく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_078_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんりょくで　かけぬけるとき
もえる　たてがみが　きらめいて
よりいっそう　うつくしく　みえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全力で　駆け抜けるとき
燃える　たてがみが　きらめいて
より一層　美しく　見える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_079_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うごきは　のろいが　しっぽを　つかう
つりが　とくい。どんかんなので
しっぽを　かまれても　いたくない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>動きは　ノロいが　しっぽを　使う
釣りが　得意。鈍感なので
しっぽを　かまれても　痛くない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_080_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼんやりしている　ヤドランだが
シェルダーが　つよく　しっぽを
かむとき　なにかが　ひらめくらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼんやりしている　ヤドランだが
シェルダーが　強く　しっぽを
かむとき　なにかが　ひらめくらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_081_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さゆうにある　ユニットから　だす
でんじはで　じゅうりょくを
さえぎって　そらに　うかぶのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>左右にある　ユニットから　だす
電磁波で　重力を
さえぎって　空に　浮かぶのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_082_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３びきの　コイルが　つながって
つよくなった　でんじはは　まわりの　
すいぶんを　かんそう　させるほど。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３匹の　コイルが　つながって
強くなった　電磁波は　周りの　
水分を　乾燥　させるほど。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_083_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>クキが　なくなると　いきていけない。
だから　クキを　ねらう　あいてとは
いのちがけで　たたかうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>クキが　なくなると　生きていけない。
だから　クキを　ねらう　相手とは
命がけで　戦うのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_084_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２つの　あたまの　のうみそは
テレパシーのような　ちからで
きもちを　つうじあわせているらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２つの　頭の　脳みそは
テレパシーのような　力で
気持ちを　通じ合わせているらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_085_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかのときに　ドードーの　あたまの
どちらかが　ぶんれつした　ちんしゅ。
じそく６０キロいじょうで　はしる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>進化のときに　ドードーの　頭の
どちらかが　分裂した　珍種。
時速６０キロ以上で　走る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_086_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さむくなるほど　げんきになって
こおりの　うかぶ　つめたい　うみを
うれしそうに　およぎまわる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>寒くなるほど　元気になって
氷の　浮かぶ　冷たい　海を
うれしそうに　泳ぎまわる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_087_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りゅうせんけいの　からだは　みずの
ていこうも　すくなく　８ノットの
スピードで　つめたい　うみをおよぐ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>流線型の　体は　水の
抵抗も　少なく　８ノットの
スピードで　冷たい　海を泳ぐ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_088_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヘドロが　ポケモンに　なった。
きたない　ばしょに　あつまって
からだの　ばいきんを　ふやしていく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヘドロが　ポケモンに　なった。
汚い　場所に　集まって
体の　ばい菌を　増やしていく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_089_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とっても　くさい！　からだの
せいぶんは　もうどくで　ベトベトンが
とおると　どんな　くさきも　かれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とっても　くさい！　体の
成分は　猛毒で　ベトベトンが
通ると　どんな　草木も　枯れる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_090_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２まいの　カラを　あけしめすることで
うしろむきに　およぐ。どんなときでも
おおきな　ベロは　だしっぱなし。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２枚の　殻を　開け閉めすることで
後ろ向きに　泳ぐ。どんなときでも
大きな　ベロは　出しっぱなし。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_091_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カラを　しっかりと　とじて　みを
まもりながら　トゲを　とばして
てきを　げきたいする　せんぽう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>殻を　しっかりと　閉じて　身を
守りながら　トゲを　飛ばして
敵を　撃退する　戦法。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_092_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ガスから　うまれた　せいめいたい。
どくをふくんだ　ガスの　からだに
つつまれると　だれでも　きぜつする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ガスから　生まれた　生命体。
毒を含んだ　ガスの　体に
包まれると　だれでも　気絶する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_093_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くらやみにまぎれ　ガスのてを　のばし
ひとのかたを　たたくのが　すき。
さわられると　ふるえが　とまらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>くらやみにまぎれ　ガスの手を　伸ばし
人の肩を　たたくのが　好き。
触られると　震えが　止まらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_094_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くらやみに　うかぶ　えがおの
しょうたいは　ひとに　のろいを
かけて　よろこぶ　ゲンガーだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>くらやみに　浮かぶ　笑顔の
正体は　人に　のろいを
かけて　喜ぶ　ゲンガーだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_095_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　くちで　あけて
たくさんの　つちを　のみこみながら
ながい　トンネルを　つくっていく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　口で　あけて
たくさんの　土を　飲みこみながら
長い　トンネルを　つくっていく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_096_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つきでた　はなを　ひくひくさせると
みている　ユメが　わかるという。
だいこうぶつは　たのしい　ユメだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>突き出た　鼻を　ひくひくさせると
見ている　夢が　わかるという。
大好物は　楽しい　夢だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_097_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふりこを　めのまえで　ゆらされると
たったいま　めざめたばかりの　ひとも
３びょうごには　ねむってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>振り子を　目の前で　ゆらされると
たった今　目覚めたばかりの　人も
３秒後には　眠ってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_098_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すなはまに　あなを　ほって　くらす。
ハサミは　たたかいで　とれても
また　はえてきて　もとどおり。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂浜に　穴を　掘って　暮らす。
ハサミは　戦いで　取れても
また　生えてきて　元通り。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_099_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきいほうの　ハサミの　パワーは
１まんばりき。しかし　おもすぎるため
ねらいを　つけることが　にがてだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きいほうの　ハサミの　パワーは
１万馬力。しかし　重すぎるため
ねらいを　つけることが　苦手だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_100_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モンスターボールに　そっくり。
まちがって　さわると　かんでんしたり
ときには　ばくはつするので　きけん。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モンスターボールに　そっくり。
間違って　触ると　感電したり
ときには　爆発するので　危険。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_101_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんきエネルギーを　ためすぎて
ぱんぱんに　ふくらんだ　マルマインが
かぜに　ながされてくることが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>電気エネルギーを　ためすぎて
ぱんぱんに　膨らんだ　マルマインが
風に　流されてくることが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_102_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テレパシーで　かいわをしているため
タマタマを　ひきはなそうとしても
すぐに　あつまって　６ぴきになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テレパシーで　会話をしているため
タマタマを　引き離そうとしても
すぐに　集まって　６匹になる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_103_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あるく　ねったいうりんと　よばれる。
おおきくなった　あたまの　ひとつが
じめんに　おちると　タマタマになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>歩く　熱帯雨林と　呼ばれる。
大きくなった　頭の　ひとつが
地面に　落ちると　タマタマになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_104_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しにわかれた　ははおやを　おもいだし
ないてしまうとき　あたまに　かぶった
ホネが　からからと　おとを　たてる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>死に別れた　母親を　思い出し
泣いてしまうとき　頭に　かぶった
ホネが　からからと　音を　立てる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_105_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うまれたときから　いつも　もっている
ホネを　じざいに　つかいこなす。
せいかくは　きょうぼうだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれたときから　いつも　持っている
ホネを　自在に　使いこなす。
性格は　凶暴だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_106_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あしが　２ばいの　ながさに　のびる。
はじめて　たたかう　あいては
その　まあいの　ひろさに　おどろく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>足が　２倍の　長さに　伸びる。
はじめて　戦う　相手は
その　間合いの　広さに　驚く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_107_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うでを　ねじりながら　くりだす
パンチは　コンクリートも　ふんさい。
３ぷん　たたかうと　ひとやすみする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腕を　ねじりながら　繰り出す
パンチは　コンクリートも　粉砕。
３分　戦うと　ひとやすみする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_108_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながい　ベロは　だえきまみれで
なめられると　ぴりぴり　しびれる。
ベロが　のびると　しっぽが　ちぢむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長い　ベロは　だえきまみれで
なめられると　ぴりぴり　しびれる。
ベロが　伸びると　しっぽが　縮む。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_109_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うすい　バルーンじょうの　からだに
もうどくの　ガスが　つまっているので
ときどき　だいばくはつを　おこす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>薄い　バルーン状の　体に
猛毒の　ガスが　詰まっているので
ときどき　大爆発を　起こす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_110_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゴミからでる　どくガスを　すいこみ
たいないで　まぜあわて　さらに
きょうれつな　においを　まきちらす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゴミからでる　毒ガスを　吸いこみ
体内で　混ぜ合わせ　さらに
強烈な　臭いを　まきちらす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_111_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　たいあたりで　こわせる
ちからもちだが　あたまが　わるいので
ひとのしごとを　てつだうのは　むり。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　体当たりで　壊せる
力持ちだが　頭が　悪いので
人の仕事を　手伝うのは　無理。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_112_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うしろあしだけで　たつようになり
まえあしが　じゆうになって　ちのうが
はったつしたが　ものわすればかりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>後ろ足だけで　立つようになり
前足が　自由になって
知能が　発達したが　物忘ればかりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_113_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きずついた　ポケモンや　ひとがいると
えいようまんてんの　タマゴをうみ
わけあたえる　やさしい　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>傷ついた　ポケモンや　人がいると
栄養満点の　タマゴを生み
分け与える　優しい　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_114_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たくさんの　うごめく　ツルに
おおわれて　しょうたいふめい。
あおいツルは　いっしょう　のびる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たくさんの　うごめく　ツルに
被われて　正体不明。
青いツルは　一生　伸びる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_115_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなかの　ふくろで　こそだてをする。
あんぜんな　ときだけ　こどもを
ふくろから　だして　あそばせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お腹の　袋で　子育てをする。
安全な　ときだけ　子供を
袋から　出して　遊ばせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_116_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サンゴの　かげに　すみかを　つくる。
きけんを　かんじると　くちから
まっくろい　スミを　はいて　にげる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サンゴの　陰に　住処を　作る。
危険を　感じると　口から
真っ黒い　墨を　吐いて　逃げる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_117_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トゲが　てきから　みを　まもる。
ひれや　ホネが　かんぽうやくの
ざいりょうとして　ちょうほうされる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トゲが　敵から　身を　守る。
ヒレや　ホネが　漢方薬の
材料として　重宝される。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_118_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きれいな　ひれを　たなびかせ
およぐ　すがたは　とても　かれいだが
ツノの　ひとつきは　きょうりょく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きれいな　ヒレを　たなびかせ
泳ぐ　姿は　とても　華麗だが
ツノの　一突きは　強力。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_119_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あきになると　プロポーズのため
からだに　あぶらが　のってきて
とても　きれいないろに　へんかする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>秋になると　プロポーズのため
体に　脂が　のってきて
とても　きれいな色に　変化する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_120_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あかい　コアが　あるかぎり
からだは　ちぎれても　いっしゅんで
もとどおりに　じこさいせい　できる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>赤い　コアが　あるかぎり
体は　ちぎれても　一瞬で
元通りに　自己再生　できる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_121_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なないろに　かがやく　コアから
うちゅうに　むけて　でんぱを　だし
なにかしらの　こうしんを　している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>七色に　輝く　コアから
宇宙に　向けて　電波を　だし
なにかしらの　交信を　している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_122_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆびさきを　こまかく　ふるわせて
くうきちゅうの　ぶんしの　うごきを
とめて　みえないかべを　つくるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>指先を　細かく　ふるわせて
空気中の　分子の　動きを
止めて　見えない壁を　作るのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_123_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうての　するどい　カマは
かたいものを　きればきるほど
さらに　きれあじを　ましていく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両手の　鋭い　カマは
硬いものを　切れば切るほど
さらに　切れ味を　増していく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_124_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なきごえは　まるで　にんげんの
ことばのように　きこえるが
いみは　まったく　りかいできない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鳴き声は　まるで　人間の
言葉のように　聞こえるが
意味は　まったく　理解できない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_125_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エレブーに　カミナリを　ためこませ
いつでも　つかえるように　する
けんきゅうが　すすめられている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エレブーに　雷を　貯めこませ
いつでも　使えるように　する
研究が　進められている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_126_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゃくねつの　ほのおを　ふきだすと
からだの　まわりに　かげろうが　でき
ブーバーの　すがたが　ぼやける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しゃく熱の　炎を　吹きだすと
体の　周りに　陽炎が　でき
ブーバーの　姿が　ぼやける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_127_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パワフルな　ツノを　ふりまわす。
２ほんの　ツノで　はさんだ　えものは
ちぎれるまで　ぜったい　はなさない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パワフルな　ツノを　ふりまわす。
２本の　ツノで　挟んだ　獲物は
ちぎれるまで　絶対　離さない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_128_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えものに　ねらいを　さだめると
いっちょくせんに　とっしんする。
あらっぽい　せいかくで　ゆうめい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>獲物に　ねらいを　定めると
一直線に　突進する。
荒っぽい　性格で　有名。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_129_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながねん　いきた　コイキングは
はねるだけで　やまをも　こえるが
わざのいりょくは　よわいまま。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長年　生きた　コイキングは
跳ねるだけで　山をも　越えるが
技の威力は　弱いまま。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_130_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちど　あばれだした　ギャラドスは
あらしが　ふきすさんでいようとも
どんなものでも　やきつくしてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一度　暴れだした　ギャラドスは
あらしが　吹きすさんでいようとも
どんなものでも　焼きつくしてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_131_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にんげんの　ことばを　りかいする
たかい　ちのうを　もっているため
ぜつめつの　きけんに　ひんしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人間の　言葉を　理解する
高い　知能を　持っているため
絶滅の　危険に　ひんしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_132_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんの　さいぼうを　くみかえて
みたもの　そっくりに　へんしんするが
ちからが　ぬけると　もとにもどる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身の　細胞を　組み換えて
みたもの　そっくりに　変身するが
力が　抜けると　元に戻る。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_133_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふあんていな　いでんしの　おかげで
さまざまな　しんかの　かのうせいを
ひめている　とくしゅな　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不安定な　遺伝子の　おかげで
さまざまな　進化の　可能性を
秘めている　特殊な　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_134_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　さいぼうの　つくりが
みずの　ぶんしに　にているため
みずに　とけると　みえなくなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　細胞の　つくりが
水の　分子に　似ているため
水に　溶けると　みえなくなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_135_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないに　でんきを　ためることで
さかだてた　ぜんしんの　たいもうを
ミサイルのように　つぎつぎ　とばす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内に　電気を　ためることで
逆立てた　全身の　体毛を
ミサイルのように　次々　飛ばす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_136_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すいこんだ　くうきを　たいないの
ほのおぶくろに　おくりこみ
１７００どの　ほのおにして　ふく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>吸いこんだ　空気を　体内の
炎袋に　送りこみ
１７００度の　炎にして　吹く。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_137_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいこうの　かがくりょくで
うみだされた　じんこうの　ポケモン。
でんしくうかんを　いどうできる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最高の　科学力で
生み出された　人工の　ポケモン。
電子空間を　移動できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_138_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げんだいの　すぐれた　かがくりょくで
かせきから　ふっかつした　ポケモン。
こだいの　うみを　およいでいた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>現代の　優れた　科学力で
化石から　復活した　ポケモン。
古代の　海を　泳いでいた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_139_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>らせんじょうの　カラが　おおきく
なりすぎたことが　げんいんで
ぜつめつしたと　かんがえられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>らせん状の　殻が　大きく
なりすぎたことが　原因で
絶滅したと　考えられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_140_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３おくねんまえの　すなはまで
くらしていたと　かんがえられている。
かたい　カラが　みを　まもる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３億年前の　砂浜で
暮らしていたと　考えられている。
硬い　殻が　身を　守る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_141_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えものが　りくじょうせいかつを
はじめたため　カブトプスも　りくに
あがったと　かんがえられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>獲物が　陸上生活を　はじめたため
カブトプスも　陸に　上がったと
考えられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_142_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうりゅうじだいの　おおぞらを
とびまわっていた　ポケモン。
のこぎりのような　キバを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>恐竜時代の　大空を
飛び回っていた　ポケモン。
ノコギリのような　キバを　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_143_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まんぷくになると　ゆびすら
うごかすのが　めんどうに　なるので
おなかに　のっても　だいじょうぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>満腹になると　指すら
動かすのが　面倒に　なるので
お腹に　乗っても　大丈夫。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_144_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんせつの　とりポケモン。
くうきちゅうの　すいぶんを　こおらせ
ふぶきを　つくりだすことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伝説の　とりポケモン。
空気中の　水分を　凍らせ
吹雪を　作り出すことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_145_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かみなりぐもの　なかに　いると
いわれる　でんせつの　ポケモン。
カミナリを　じざいに　あやつる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雷雲の　中に　いると
言われる　伝説の　ポケモン。
雷を　自在に　操る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_146_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんせつの　とりポケモンの　１ぴき。
ファイヤーが　すがたを　みせると
はるが　おとずれると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伝説の　とりポケモンの　１匹。
ファイヤーが　姿を　見せると
春が　訪れると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_147_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もくげきしゃが　すくないために
まぼろしのポケモンと　よばれていた。
だっぴした　かわが　みつかっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目撃者が　少ないために
幻のポケモンと　呼ばれていた。
脱皮した　皮が　見つかっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_148_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんが　オーラに　つつまれるとき
まわりの　てんきが　いっぺんする。
うみや　みずうみに　すむという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身が　オーラに　包まれるとき
まわりの　天気が　一変する。
海や　湖に　住むという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_149_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひろい　うみの　どこかに　すみかが
あると　いわれている。なんぱした
ふねを　りくまで　みちびいてくれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>広い　海の　どこかに　住処が
あると　言われている。難破した
船を　陸まで　導いてくれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_150_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミュウの　いでんしを　くみかえて
うみだされた。ポケモンで　いちばん
きょうぼうな　こころを　もつという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミュウの　遺伝子を　組み替えて
生み出された。ポケモンで　一番
凶暴な　心を　持つという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_151_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あらゆる　わざを　つかうため
ポケモンの　せんぞと　かんがえる
がくしゃが　たくさん　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あらゆる　技を　使うため
ポケモンの　先祖と　考える
学者が　たくさん　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_152_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　はっぱで　まわりの
おんどや　しつどを　さぐる。
ひざしを　あびることが　だいすき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　葉っぱで　まわりの
温度や　湿度を　探る。
日差しを　浴びることが　大好き。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_153_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くびまわりの　つぼみから　におう
スパイシーな　かおりは
かいだ　ひとを　げんきに　させる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>首回りの　つぼみから　におう
スパイシーな　香りは
かいだ　人を　元気に　させる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_154_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メガニウムが　はきだす　いきには
かれた　くさばなを　よみがえらせる
ふしぎな　ちからが　ひめられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メガニウムが　吐き出す　息には
枯れた　草花を　よみがえらせる
不思議な　力が　秘められている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_155_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おくびょうな　せいかく。
おどろくと　せなかの　ほのおが
いちだんと　つよく　もえあがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おくびょうな　性格。
驚くと　背中の　炎が
一段と　強く　燃え上がる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_156_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほのおの　ねつで　あいてを　いかく。
たたかう　たいせいになると
ほのおの　いきおいが　ます。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>炎の　熱で　相手を　威嚇。
戦う　体勢になると
炎の　勢いが　増す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_157_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほのおの　ばくふうで　こうげき。
しゃくねつの　ほのおで　かげろうを
つくりだし　すがたを　かくす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>炎の　爆風で　攻撃。
しゃく熱の　炎で　陽炎を
作り出し　姿を　隠す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_158_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はったつした　あごを　もち
なんにでも　かみつく　しゅうせい。
トレーナーも　ちゅういが　ひつよう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>発達した　アゴを　持ち
なんにでも　かみつく　習性。
トレーナーも　注意が　必要。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_159_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちど　かみつくと　キバが
ぬけるまで　ぜったいに　はなさない。
ぬけた　キバは　すぐに　はえてくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一度　かみつくと　キバが
抜けるまで　絶対に　離さない。
抜けた　キバは　すぐに　生えてくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_160_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふだんは　ゆっくりとした　うごきだが
えものに　かみつくときは
めにも　とまらない　スピードだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>普段は　ゆっくりとした　動きだが
獲物に　かみつくときは
目にも　止まらない　スピードだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_161_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とても　しんけいしつな　せいかく。
とおくまで　みわたせるように
しっぽを　つかって　せのびをする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とても　神経質な　性格。
遠くまで　見渡せるように
しっぽを　使って　背伸びをする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_162_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ははおやは　ほそながい　からだで
こどもを　つつみこみ　ねむらせる。
はやい　うごきで　てきを　おいこむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>母親は　細長い　体で
子供を　包み込み　眠らせる。
早い　動きで　敵を　追い込む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_163_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せいかくに　ときを　つげることから
せかいの　ことわりを　わきまえた
ちえのかみさま　とする　くにもある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正確に　時を　告げることから
世界の　ことわりを　わきまえた
知恵の神様　とする　国もある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_164_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とくしゅな　つくりの　りょうめは
わずかな　ひかりさえ　あれば
くらやみでも　ひるのように　みえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>特殊な　作りの　両目は
わずかな　光さえ　あれば
くらやみでも　昼のように　見える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_165_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むれを　つくらないと　ふあんで
うごけなくなるほど　おくびょう。
においで　きもちを　つたえあう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>群れを　作らないと　不安で
動けなくなるほど　おくびょう。
においで　気持ちを　伝え合う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_166_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほしあかりを　エネルギーにする。
よぞらの　ほしの　かずが　ふえると
せなかの　もようが　おおきくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>星明りを　エネルギーにする。
夜空の　星の　数が　増えると
背中の　模様が　大きくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_167_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほそくて　じょうぶな　いとを
はりめぐらして　わなを　しかける。
えものが　かかるまで　じっと　まつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>細くて　丈夫な　糸を
張り巡らして　ワナを　仕掛ける。
獲物が　かかるまで　じっと　待つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_168_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えものの　からだに　いとを　つけて
わざと　にがす。いとを　たどれば
なかまごと　つかまえられるからだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>獲物の　体に　糸を　つけて
わざと　逃がす。糸を　たどれば
仲間ごと　捕まえられるからだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_169_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>４まいに　ふえた　はねを　つかい
さらに　はやく　しずかに　とんで
えものに　きづかれず　しのびよる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>４枚に　増えた　羽を　使い
さらに　速く　静かに　飛んで
獲物に　気づかれず　忍びよる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_170_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プラスと　マイナスの　でんきを
しょくしゅの　さきから　ながす。
てきを　かんでんさせてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラスと　マイナスの　電気を
触手の　先から　流す。
敵を　感電させてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_171_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかいを　およぐ　ランターンの
あかりは　すいめんまで　とどく。
しんかいのほし　と　よばれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深海を　泳ぐ　ランターンの
明かりは　水面まで　届く。
深海の星　と　呼ばれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_172_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほほの　でんきぶくろは　ちいさく
ちょっとでも　でんきが　あふれると
じぶんじしんが　しびれてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほほの　電気袋は　小さく
ちょっとでも　電気が　あふれると
自分自身が　しびれてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_173_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ピィを　よく　みかける　ばしょは
ながれぼしが　おちた　ばしょと
じもとでは　うわさ　されている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ピィを　よく　みかける　場所は
流れ星が　落ちた　場所と
地元では　うわさ　されている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_174_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんのり　あまい　かおりが　して
よく　はずむ　やわらかい　からだは
いちど　はずみだすと　とまらない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほんのり　甘い　香りが　して
よく　弾む　柔らかい　体は
一度　弾みだすと　止まらない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_175_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みんなの　かんじた　やさしさや
うれしさを　しあわせに　かえている。
カラのなかは　しあわせ　ばかりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みんなの　感じた　優しさや
うれしさを　幸せに　変えている。
殻の中は　幸せ　ばかりだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_176_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しあわせを　わけあたえるため
こころやさしい　ひとを　さがしもとめ
せかいじゅうを　とびまわっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>幸せを　分け与えるため
心優しい　人を　捜し求め
世界中を　飛び回っている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_177_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サボテンの　つぼみや　トゲを
きように　よけながら　ついばむ。
とびはねるようにして　いどうする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サボテンの　つぼみや　トゲを
器用に　避けながら　ついばむ。
飛び跳ねるようにして　移動する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_178_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かこと　みらいを　みとおせる。
まいにち　たいようの　うごきを
みつづけている　ふしぎな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>過去と　未来を　見通せる。
毎日　太陽の　動きを　見続けている
不思議な　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_179_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さむくなり　せいでんきが　たまると
たいもうが　２ばいに　ふくれあがり
シッポの　さきが　ほんのり　ひかる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>寒くなり　静電気が　たまると
体毛が　２倍に　ふくれあがり
シッポの　先が　ほんのり　光る。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_180_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うぶげすら　はえなくなった　ぶぶんの
ひふは　ゴムのように　でんきを　
さえぎるので　じぶんは　しびれない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>産毛すら　はえなくなった　部分の
皮膚は　ゴムのように　電気を　
さえぎるので　自分は　しびれない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_181_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シッポの　さきは　まぶしく　ひかり
とおく　はなれた　がいこくまで
とどき　うみのみちしるべ　となる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シッポの　先は　まぶしく　光り
遠く　離れた　外国まで
届き　海の道標　となる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_182_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおあめの　きせつが　おわると
あたたかい　ひざしに　さそわれた
キレイハナが　おどりはじめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大雨の　季節が　終わると
暖かい　日差しに　誘われた
キレイハナが　踊りはじめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_183_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あぶらが　つまっている　シッポが
うきぶくろの　かわりと　なるので
ながれの　はやい　かわも　へいき。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>脂が　詰まっている　シッポが
浮き袋の　代わりと　なるので
流れの　速い　川も　平気。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_184_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながい　みみは　すぐれた　センサー。
みずのなかの　おとを　ききわけて
なにが　うごいているのか　わかる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長い　耳は　優れた　センサー。
水の中の　音を　ききわけて
なにが　動いているのか　わかる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_185_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうげき　されないように　ひたすら
きのまねをしているが　みずはにがてで
あめになると　どこかに　にげだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>攻撃　されないように　ひたすら
木のマネをしているが　水は苦手で
雨になると　どこかに　逃げ出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_186_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ニョロトノを　リーダーに　グループが
つくられる。ニョロトノの　なきごえが
ニョロモたちを　したがわせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ニョロトノを　リーダーに　グループが
作られる。ニョロトノの　鳴き声が
ニョロモたちを　従わせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_187_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かぜに　ながされて　ただよう。
のやまに　ハネッコが　あつまりだすと
はるが　おとずれると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>風に　流されて　漂う。
野山に　ハネッコが　集まりだすと
春が　訪れると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_188_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きおんが　たかくなると　はなひらく。
そらに　うかんで　ひざしを
いっぱい　あびようとする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気温が　高くなると　花開く。
空に　浮かんで　日差しを
いっぱい　浴びようとする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_189_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きせつふうに　ながされて
せかいを　いっしゅうしてしまう。
とちゅうで　わたほうしを　ばらまく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>季節風に　流されて
世界を　１周してしまう。
途中で　綿胞子を　ばらまく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_190_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てよりも　じゆうじざいに　うごく
しっぽを　たくみに　あやつりながら
たかい　きのうえで　くらしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手よりも　自由自在に　動く
しっぽを　巧みに　操りながら
高い　木の上で　暮らしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_191_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ある　あさ　とつぜん　ふってくる。
よわいのを　しっており　しんかまで
ひたすら　えいようを　ためこむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ある　朝　突然　降ってくる。
弱いのを　知っており　進化まで
ひたすら　栄養を　ためこむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_192_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あびた　ひざしを　エネルギーに
へんかん　するため　ひるまは　ずっと
たいようの　ほうを　むいている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>浴びた　日差しを　エネルギーに
変換　するため　昼間は　ずっと
太陽の　方を　向いている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_193_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうそくで　はばたくことで
くうちゅうを　じゆうじざいに　とぶ。
きゅうていし　だって　へっちゃら。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高速で　羽ばたくことで
空中を　自由自在に　飛ぶ。
急停止　だって　へっちゃら。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_194_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちじょうを　あるくときは　ひふが
かんそう　しないように　どくの
ねんまくで　からだを　おおっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地上を　歩くときは　皮膚が
乾燥　しないように　毒の　粘膜で
体を　おおっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_195_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふなぞこや　かわのいわに　あたまを
ぶつけまくっても　きにせず　きままに
およいでいる　のんきな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>船底や　川の岩に　頭を
ぶつけまくっても　気にせず　気ままに
泳いでいる　のんきな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_196_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんの　こまやかな　たいもうで
くうきの　ながれを　かんじて　てきの
かんがえや　てんこうを　よそくする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身の　細やかな　体毛で
空気の　流れを　感じて　敵の
考えや　天候を　予測する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_197_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つきの　はどうを　あびると
ぜんしんの　わっかもようが　ひかり
ふしぎな　ちからに　あふれるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>月の　波動を　浴びると
全身の　輪っか模様が　光り
不思議な　力に　あふれるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_198_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヤミカラスを　みかけて　ふよういに
あとを　つけていくと　まよわされ
やまみちに　おいてけぼりに　される。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヤミカラスを　見かけて　不用意に
後を　つけていくと　迷わされ
山道に　置いてけぼりに　される。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_199_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シェルダーに　かまれたことによって
ノーベルしょうを　じゅしょうした
かがくしゃなみの　ちのうを　えた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シェルダーに　かまれたことによって
ノーベル賞を　受賞した　科学者並の
知能を　得た。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_200_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まよなか　ひとを　おどろかせては
こわがるこころを　あつめて　じぶんの
エネルギーに　している　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>真夜中　人を　驚かせては
怖がる心を　集めて　自分の
エネルギーに　している　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_201_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１ぴきで　いても　なにも　おきないが
２ひき　いじょうで　ならぶと
なにかの　ちからが　めばえるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１匹で　いても　なにも　起きないが
２匹　以上で　並ぶと
なにかの　力が　芽生えるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_202_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろい　しっぽを　ひっしになって
かくすのは　しっぽに　ひみつがある
しょうこだと　かんぐられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒い　しっぽを　必死になって
隠すのは　しっぽに　秘密がある
証拠だと　勘ぐられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_203_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　あたまにも　ちいさな
のうがあり　うしろを　むいたままでも
ほんのうで　たたかうことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　頭にも　小さな
脳があり　後ろを　向いたままでも
本能で　戦うことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_204_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きのみに　そっくり。まちがわれて
とりポケモンに　つつかれてしまうが
かたい　カラで　まもられている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>木の実に　そっくり。間違われて
とりポケモンに　つつかれてしまうが
硬い　殻で　守られている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_205_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうてつの　カラで　まもられている。
すきまから　めだまが　のぞいているが
なかみの　しょうたいは　なぞのまま。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼鉄の　殻で　守られている。
すきまから　目玉が　のぞいているが
中身の　正体は　ナゾのまま。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_206_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くらいばしょに　めいろを　つくる。
だれかに　みられると　シッポで
じめんを　ほって　にげようとする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暗い場所に　迷路を　つくる。
だれかに　みられると　シッポで
地面を　掘って　逃げようとする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_207_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねらった　えものに　はりついて
おどろきとまどっている　あいだに
シッポの　トゲを　さしこんでくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねらった　獲物に　はりついて
驚き戸惑っている　あいだに
シッポの　トゲを　刺しこんでくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_208_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つちと　いっしょに　のみこんだ
はがねが　からだを　へんかさせて
ダイヤモンドより　かたくなった。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>土と　一緒に　飲みこんだ
鋼が　体を　変化させて
ダイヤモンドより　固くなった。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_209_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさな　ポケモンが　にげだすほどの
こわいかおが　ぎゃくに　かわいいと
じょせいに　にんきの　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　ポケモンが　逃げ出すほどの
怖い顔が　逆に　かわいいと
女性に　人気の　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_210_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かおに　にあわず　おくびょう。
しかし　ひとたび　おこりはじめると
おおきな　キバで　はんげきする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>顔に　似合わず　おくびょう。
しかし　ひとたび　怒りはじめると
大きな　キバで　反撃する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_211_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんの　どくバリを
しほうはっぽうに　うちだす。
まるい　からだは　およぎが　にがて。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身の　毒針を
四方八方に　撃ち出す。
丸い　体は　泳ぎが　苦手。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_212_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めだまもようの　ついた　はさみを
ふりあげて　いかくする　だけでなく
そのまま　ふりおろすので　きけんだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目玉模様の　ついた　ハサミを
振り上げて　威嚇する　だけでなく
そのまま　振り下ろすので　危険だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_213_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツボのような　こうらの　なかに
ためこんだ　きのみは　いつのまか
ドロドロの　ジュースに　かわる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツボのような　甲羅の　中に
ためこんだ　きのみは　いつのまか
ドロドロの　ジュースに　変わる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_214_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんなに　おもい　あいてでも
じまんの　ツノを　つかい　じめんごと
とおくまで　ほうりなげてしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんなに　重い　相手でも
自慢の　ツノを　使い　地面ごと
遠くまで　放り投げてしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_215_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ずるがしこい　ポケモンで　ゆびに
かくした　ながい　ツメを　いきなり
のばして　あいてを　ひるませる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ずるがしこい　ポケモンで　指に
隠した　長い　ツメを　いきなり
伸ばして　相手を　ひるませる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_216_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまい　ミツを　てのひらに
しみこませて　いつも　なめている。
ヒメグマによって　あじが　ちがう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甘い　ミツを　手のひらに
染み込ませて　いつも　なめている。
ヒメグマによって　味が　違う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_217_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばりにある　おいしい　きのみや
くだものの　なる　き　には
ツメで　きずあとを　つける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張りにある　おいしい　木の実や
果物の　なる　木　には
ツメで　傷跡を　つける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_218_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようがんで　できた　からだを　もつ。
たえず　うごいていないと　からだが
ひえて　かたまってしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>溶岩で　できた　体を　持つ。
絶えず　動いていないと　体が
冷えて　固まってしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_219_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいおんは　やく１まんど。
マグマが　かたまって　できた　カラの
すきまから　ほのおを　ふきだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体温は　約１万度。
マグマが　固まって　できた　殻の
すきまから　炎を　吹き出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_220_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなさきを　こすりあわせ　じめんを
ほりながら　エサを　さがしている。
たまに　おんせんを　ほりあてる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鼻先を　こすりあわせ　地面を
掘りながら　エサを　探している。
たまに　温泉を　掘り当てる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_221_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きゅうかくに　すぐれ　こおっている
じめんの　したに　うもれた
キノコだって　さがしだすのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きゅう覚に　優れ　凍っている
地面の　下に　埋もれた
キノコだって　探しだすのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_222_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みなみの　きれいな　うみをこのむ。
よごれた　うみだと　サンゴの　えだは
いろがくすみ　ボロボロになるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>南の　きれいな　海を好む。
汚れた　海だと　サンゴの　枝は
色がくすみ　ボロボロになるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_223_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くちから　ふきだす　すいりゅうは
１００メートルさきで　うごく
えものに　だって　めいちゅうする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>口から　吹きだす　水流は
１００メートル先で　動く
獲物に　だって　命中する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_224_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなに　はいりたがる　せいしつで
いわあなや　ツボを　このみ　そこから
スミを　ふきだして　こうげきする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>穴に　入りたがる　性質で
岩穴や　ツボを　好み　そこから
スミを　吹きだして　攻撃する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_225_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１にちじゅう　エサを　はこぶ。
やまで　そうなんした　ひとがいると
エサを　わけあたえ　たすけてる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１日中　エサを　運ぶ。
山で　遭難した　人がいると
エサを　わけあたえ　助けてる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_226_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>およいで　スピードが　のってくると
なみのうえに　とびだし　そのまま
１００メートルも　かっくう　する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>泳いで　スピードが　のってくると
波の上に　飛びだし　そのまま
１００メートルも　滑空　する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_227_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんじょうで　おもそうな　てつの
からだだが　うすくて　かるいので
じそく３００キロで　とべる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頑丈で　重そうな　鉄の
体だが　薄くて　軽いので
時速３００キロで　とべる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_228_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さまざまな　なきごえを　つかいわけ
なかまと　コミュニケーションしながら
かりを　おこなう　かしこさをもつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>様々な　鳴き声を　使い分け
仲間と　コミュニケーションしながら
狩りを　おこなう　賢さを持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_229_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おこったときに　くちから　ふきだす
ほのおには　どくそも　まじっていて
やけどになると　いつまでも　うずく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怒ったときに　口から　吹き出す
炎には　毒素も　混じっていて
やけどになると　いつまでも　うずく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_230_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいていどうくつに　すんでいる。
キングドラが　みうごきすると
きょだいな　うずしおが　うまれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海底洞くつに　住んでいる。
キングドラが　身動きすると
巨大な　渦潮が　生まれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_231_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだは　ちいさいが　ちからもち。
おとなの　ひとを　かるがると
せなかに　のせて　あるいてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体は　小さいが　力持ち。
大人の　人を　軽々と
背中に　乗せて　歩いてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_232_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだを　まるめて　かいてんしながら
とっしんする　こうげき。いちげきで
みんかを　ばらばらに　ふきとばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を　丸めて　回転しながら
突進する　攻撃。一撃で　民家を
バラバラに　吹き飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_233_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わくせい　かいはつが　できるように
バージョンアップ　されたのだが
まだまだ　むずかしかった　ようだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>惑星　開発が　できるように
バージョンアップ　されたのだが
まだまだ　難しかった　ようだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_234_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツノを　みつめていると　わっかの
ちゅうしんに　すいこまれそうな
ふしぎな　きぶんに　なってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツノを　見つめていると　輪っかの
中心に　吸い込まれそうな
不思議な　気分に　なってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_235_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽを　ふでのように　つかって
なわばりに　マークを　えがく。
その　しゅるいは　５０００いじょう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽを　筆のように　使って
縄張りを　マークで　描く。
その　種類は　５０００以上。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_236_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>けんかっぱやいことで　ゆうめい。
じぶんよりも　おおきな　あいてに
いどみかかるので　きずが　たえない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ケンカっぱやいことで　有名。
自分よりも　大きな　相手に
挑みかかるので　傷が　絶えない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_237_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コマのように　かいてんしながら
たたかう。えんしんりょくの　パワーで
はかいりょくは　１０ばいだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コマのように　回転しながら　戦う。
遠心力の　パワーで
破壊力は　１０倍だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_238_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　くちびるで　ふれてみて
たしかめる。すきな　ものも　きらいな
ものも　くちびるが　おぼえている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　唇で　触れてみて
確かめる。好きな　物も　嫌いな　物も
唇が　覚えている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_239_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょううでを　ぐるぐる　まわして
でんきを　はっせい　させると
ツノのあいだが　あおじろく　ひかる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両腕を　ぐるぐる　まわして
電気を　発生させると
ツノのあいだが　青白く　光る。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_240_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こがらだが　たいおんは　６００ど。
いきを　すったり　はいたりするたび　
くちと　はなから　ひのこが　もれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小柄だが　体温は　６００度。
息を　吸ったり　吐いたりするたび　
口と　鼻から　火の粉が　漏れる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_241_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミルタンクの　ミルクを　のんで
そだった　こどもは　けんこうで
たくましい　おとなに　なるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミルタンクの　ミルクを　飲んで
育った　子供は　健康で
たくましい　大人に　なるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_242_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハピナスの　うむ　タマゴには
しあわせが　つまっていて　ひとくち
たべると　だれでも　えがおになれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハピナスの　生む　タマゴには
幸せが　つまっていて　ひとくち
食べると　だれでも　笑顔になれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_243_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カミナリと　ともに　おちてきたと
いわれている。せなかの　あまぐもから
カミナリを　うちだすことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雷と　ともに　落ちてきたと
言われている。背中の　雨雲から
雷を　撃ち出すことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_244_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エンテイが　ほえると
せかいの　どこかの　かざんが
ふんかすると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エンテイが　ほえると
世界の　どこかの　火山が
噴火すると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_245_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいじゅうを　かけめぐり
よごれた　みずを　きよめている。
きたかぜと　ともに　はしりさる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界中を　駆け巡り
汚れた　水を　清めている。
北風と　ともに　走り去る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_246_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちてい　おくふかくで　うまれる。
まわりの　つちを　たいらげると
ちじょうに　あらわれ　サナギになる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地底　奥深くで　生まれる。
周りの　土を　たいらげると
地上に　現われ　サナギになる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_247_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないで　あっしゅく　させた
ガスを　いきおいよく　ふんしゅつさせ
とんで　あばれまわる　サナギだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内で　圧縮　させた
ガスを　勢いよく　噴出させ
飛んで　暴れまわる　サナギだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_248_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じひびきを　ならしながら　あるくと
おおきな　やまでさえ　くずれ
まわりの　ちけいは　かわってしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地響きを　鳴らしながら　歩くと
大きな　山でさえ　崩れ
周りの　地形は　変わってしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_249_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふかい　かいこうの　そこで　ねむる。
ルギアが　はばたくと　４０にち
あらしが　つづくと　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深い　海溝の　底で　眠る。
ルギアが　羽ばたくと　４０日
あらしが　続くと　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_250_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なないろの　つばさを　もつ。
ホウオウを　みた　ものは　えいえんの
しあわせが　やくそくされるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>七色の　翼を　持つ。
ホウオウを　見た　者は
永遠の　幸せが　約束されるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_251_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じかんを　こえる　ちからを　つかう。
へいわな　じだいにだけ
すがたを　みせると　いわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>時間を　越える　力を　使う。
平和な　時代にだけ
姿を　見せると　言われている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_252_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あしの　うらには　ちいさな　トゲが
たくさん　ついているので　かべや
てんじょうを　あるくことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>足の　裏には　小さな　トゲが
たくさん　ついているので
壁や　天井を　歩くことが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_253_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みつりんに　せいそくする。
えだから　えだへ　とびうつりながら
いどうして　えものに　せっきんする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>密林に　生息する。
枝から　枝へ　飛び移りながら
移動して　獲物に　接近する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_254_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うでに　はえた　はっぱは　たいぼくも
すっぱり　きりたおす　きれあじ。
みつりんの　たたかいでは　むてき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腕に　生えた　葉っぱは　大木も
スッパリ　切り倒す　切れ味。
密林の　戦いでは　無敵。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_255_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないで　ほのおが　もえているので
だきしめると　とても　あたたかい。
１０００どの　ひのたまを　とばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内で　炎が　燃えているので
抱きしめると　とても　温かい。
１０００度の　火の玉を　飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_256_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１びょうかんに　キックを　１０ぱつ
くりだす　あしわざの　もちぬし。
するどい　なきごえで　いかくする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１秒間に　キックを　１０発
繰り出す　足技の　持ち主。
鋭い　鳴き声で　威嚇する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_257_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てくびから　ふきだした　ほのおで
こぶしを　つつみこんだ　パンチは
あいてを　くろこげに　してしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手首から　吹き出した　炎で
こぶしを　包み込んだ　パンチは
相手を　黒コゲに　してしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_258_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　ひれで　みずの　ながれを
かんじて　まわりの　ようすを　しる。
いわを　もちあげる　ちからもち。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　ヒレで　水の　流れを
感じて　まわりの　様子を　知る。
岩を　持ち上げる　力持ち。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_259_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬかるんだ　あしばでも　しっかり
あるける　じょうぶな　あしこし。
どろに　からだを　うめて　ねむる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬかるんだ　足場でも　しっかり
歩ける　丈夫な　足腰。
泥に　体を　埋めて　眠る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_260_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおがたせんを　ひっぱって　およぐ
パワーの　もちぬし。ふとい　うでの
ひとふりで　あいてを　たたきのめす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大型船を　引っ張って　泳ぐ
パワーの　持ち主。太い　腕の
一振りで　相手を　たたきのめす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_261_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しつこい　せいかくの　ポケモン。
めをつけた　えものが　ヘトヘトに
つかれるまで　おいかけまわす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しつこい　性格の　ポケモン。
目をつけた　獲物が　ヘトヘトに
疲れるまで　追いかけ回す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_262_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むれで　えものを　おいつめる。
すぐれた　トレーナーの　めいれいには
ぜったいに　さからわない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>群れで　獲物を　追いつめる。
優れた　トレーナーの　命令には
絶対に　逆らわない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_263_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジグザグに　あるいて　くさかげや
じめんに　うまっている　たからものを
みつけるのが　とくいな　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジグザグに　歩いて　草陰や
地面に　埋まっている　宝物を
見つけるのが　得意な　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_264_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じそく１００キロで　えものに
おそいかかるが　まっすぐにしか
はしれないので　しっぱいも　おおい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>時速１００キロで　獲物に
襲いかかるが　真っ直ぐにしか
走れないので　失敗も　多い。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_265_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とりポケモンに　よく　ねらわれるが
おしりの　トゲから　どくをだし
ひっしになって　ていこうする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とりポケモンに　よく　ねらわれるが
おしりの　トゲから　毒を出し
必死になって　抵抗する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_266_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いとを　きのえだに　まきつけている。
いとについた　あまみずを　のみながら
しんかの　ときを　まっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>糸を　木の枝に　巻きつけている。
糸についた　雨水を　飲みながら
進化の　ときを　待っている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_267_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みために　よらず　こうげきてきで
かふんあつめの　じゃまを　すると
ほそながい　くちを　つきさしてくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>見た目に　よらず　攻撃的で
花粉集めの　邪魔を　すると
細長い　口を　突き刺してくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_268_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マユに　こもっている　あいだに
うけた　こうげきは　しんかしても
わすれずに　かならず　しかえしする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マユに　こもっている　あいだに
受けた　攻撃は　進化しても
忘れずに　かならず　仕返しする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_269_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はばたくたびに　どくのこなが　まう。
よるの　あいだに　がいろじゅの
はっぱを　くいちらかすことも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>羽ばたくたびに　毒の粉が　舞う。
夜の　あいだ　街路樹の　葉っぱを
食い散らかすことも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_270_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みずくさに　そっくりな　ポケモン。
およげない　ポケモンを　はっぱに
のせて　むこうぎしまで　はこぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>水草に　そっくりな　ポケモン。
泳げない　ポケモンを　葉っぱに
乗せて　向こう岸まで　運ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_271_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つりびとを　みつけると
すいちゅうから　つりいとを　ひっぱり
ジャマして　よろこぶ　いたずらもの。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>釣り人を　見つけると
水中から　釣り糸を　引っ張り
ジャマして　喜ぶ　いたずらもの。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_272_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようきな　おんがくを　きくと
からだじゅうに　ちからが　みなぎり
おどらずには　いられなくなるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>陽気な　音楽を　聴くと
体中に　力が　みなぎり
踊らずには　いられなくなるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_273_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えだに　ぶらさがっていると
きのみに　そっくり。ついばもうとした
ポケモンを　おどろかせて　よろこぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>枝に　ぶらさがっていると
木の実に　そっくり。ついばもうとした
ポケモンを　驚かせて　喜ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_274_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コノハナが　かなでる　くさぶえの
ねいろは　ひとを　ふあんにさせる。
もりの　おくに　すんでいる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コノハナが　奏でる　草笛の　音色は
人を　不安にさせる。
森の　奥に　住んでいる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_275_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はっぱの　うちわを　あおぐと
ふうそく３０メートルの　とっぷうが
まきおこり　みんかを　ふきとばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>葉っぱの　ウチワを　あおぐと
風速３０メートルの　突風が
巻き起こり　民家を　吹き飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_276_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよい　あいてにも　ゆうかんに
たちむかう　こんじょうの　もちぬし。
あたたかい　とちを　めざして　とぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強い　相手にも　勇敢に
立ち向かう　根性の　持ち主。
暖かい　土地を　目指して　飛ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_277_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じょうくうを　せんかいしながら
えものを　さがし　まっさかさまに
きゅうこうかして　つかまえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>上空を　旋回しながら
獲物を　探し　真っ逆さまに
急降下して　捕まえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_278_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きりたった　がけに　すを　つくり
うみかぜを　りようして　ひろいそらを
じょうしょうし　かっくう　するのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きりたった　がけに　巣を　作り
海風を　利用して　広い空を
上昇し　滑空　するのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_279_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいめん　すれすれを　とんで
おおきな　くちばしで　かいすいごと
エサを　すくいとって　はこぶのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海面　すれすれを　飛んで
大きな　くちばしで　海水ごと
エサを　すくいとって　運ぶのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_280_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あかいツノで　ひとや　ポケモンの
あたたかな　きもちを　キャッチすると
ぜんしんが　ほのかに　あつくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>赤いツノで　人や　ポケモンの
温かな　気持ちを　キャッチすると
全身が　ほのかに　熱くなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_281_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーが　よろこぶと
キルリアに　エネルギーが　みちあふれ
たのしそうに　くるくると　おどる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーが　喜ぶと
キルリアに　エネルギーが　満ちあふれ
楽しそうに　くるくると　踊る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_282_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーを　まもるためなら
サイコパワーを　つかいきり　ちいさな
ブラックホールを　つくりだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーを　守るためなら
サイコパワーを　使いきり　小さな
ブラックホールを　作り出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_283_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すいめんを　すべるように　あるく。
あたまの　さきから　あまい　においを
だして　えものを　さそう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>水面を　滑るように　歩く。
頭の　先から　甘い　においを
出して　獲物を　誘う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_284_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めだまもようの　しょっかくを　もつ。
４まいの　はねで　うかびあがり
ぜんごさゆうに　うごくことができる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目玉模様の　触角を　持つ。
４枚の　ハネで　浮かび上がり
前後左右に　動くことができる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_285_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　てっぺんから　どくほうしを
ふきだす。ほうしを　すいこむと
からだの　ふしぶしが　いたくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　てっぺんから　毒胞子を
吹き出す。胞子を　吸い込むと
体の　節々が　痛くなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_286_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みじかい　うでは　パンチを　だすとき
ぐーんと　のびる。プロボクサー
かおまけの　テクニックを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>短い　腕は　パンチを　出すとき
グーンと　伸びる。プロボクサー
顔負けの　テクニックを　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_287_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１にちに　はっぱを　３まいも
たべれば　まんぞくで　それいがいは
２０じかんも　ねむっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１日に　はっぱを　３枚も
食べれば　満足で　それ以外は
２０時間も　眠っている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_288_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんぞうの　こどうが　はやく
ぜんしんの　ちが　たぎっているため
１びょうも　じっと　していられない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>心臓の　鼓動が　速く
全身の　血が　たぎっているため
１秒も　じっと　していられない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_289_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねころがったまま　せいかつ　する。
まわりに　たべる　くさが　なくなると
ようやく　ねがえりをして　うごく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>寝転がったまま　生活　する。
周りに　食べる　草が　なくなると
ようやく　寝返りをして　動く。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_290_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じめんの　したで　せいちょうする。
ほとんど　みえない　めの　かわりに
しょっかくで　ようすを　さぐる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>地面の　下で　成長する。
ほとんど　見えない　目の　代わりに
触角で　様子を　探る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_291_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまりに　こうそくで　うごくため
すがたが　みえなくなる　ことがある。
じゅえきに　あつまってくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あまりに　高速で　動くため
姿が　見えなくなる　ことがある。
樹液に　集まってくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_292_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬけがらが　たましいを　やどした。
せなかの　すきまから　のぞきこむと
たましいを　すわれてしまうらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>抜け殻が　魂を　宿した。
背中の　すきまから　のぞき込むと
魂を　吸われてしまうらしい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_293_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふだんは　ささやくような　なきごえ。
ふあんになると　ジェットきと　おなじ
おんりょうで　なきつづける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>普段は　ささやくような　鳴き声。
不安になると　ジェット機と　同じ
音量で　鳴き続ける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_294_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおごえの　しょうげきはで
トラックを　ひっくりかえしてしまう。
あしを　ふみならして　パワーアップ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大声の　衝撃波で
トラックを　ひっくりかえしてしまう。
足を　踏みならして　パワーアップ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_295_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バクオングの　とおぼえは　１０キロ
さきまで　とどく。からだじゅうの
あなから　さまざまな　おとを　だす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バグオングの　とおぼえは　１０キロ
先まで　届く。体中の　穴から
様々な　音を　出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_296_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふとい　きのみきに　ぶつかって
からだを　きたえる。すみかの　そばは
へしおられた　きが　たくさんある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太い　木の幹に　ぶつかって
体を　鍛える。住処の　そばは
へし折られた　木が　たくさんある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_297_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　おおきな　ポケモンたちと
ちからくらべをすることが　だいすき。
はりてで　トラックを　ふっとばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　大きな　ポケモンたちと
力比べをすることが　大好き。
張り手で　トラックを　ぶっ飛ばす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_298_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えいようが　つまった　おおきな
シッポを　ふりまわして　じぶんより
てごわい　あいてにも　たちむかう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>栄養が　詰まった　大きな
シッポを　振り回して　自分より
手強い　相手にも　たちむかう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_299_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつも　きたを　むいている
じしゃくの　はなで　まわりの　てつを
ひきよせて　まもりを　かためるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつも　来たを　向いている
磁石の　鼻で　周りの　鉄を
引き寄せて　守りを　固めるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_300_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　シッポを　おいかけて
あそんでいると　めを　まわすといった
かわいらしい　いちめんを　みせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の　シッポを　追いかけて
遊んでいると　目を　回すといった
可愛らしい　一面を　みせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_301_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きまった　すみかを　もたないのは
いごこちが　よく　きれいな　ばしょを
さがして　ねどこに　しているから。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>決まった　すみかを　持たないのは
居心地が　よく　きれいな　場所を
探して　寝床に　しているから。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_302_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうくつの　くらやみに　ひそむ。
ほうせきを　たべているうちに
めが　ほうせきに　なってしまった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>洞くつの　くらやみに　潜む。
宝石を　食べているうちに
目が　宝石に　なってしまった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_303_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツノが　へんけいして　できた
おおあごが　あたまに　ついている。
てっこつを　かみきってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツノが　変形して　できた
大アゴが　頭に　ついている。
鉄骨を　かみきってしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_304_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はがねの　からだを　つくるために
てっこうせきを　たべている。ときどき
レールも　たべてしまう　こまりもの。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼の　体を　つくるために
鉄鉱石を　食べている。ときどき
レールも　食べてしまう　困りもの。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_305_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばり　あらそいのため　コドラが
はがねのからだを　ぶつけあうと
もじどおり　ひばなが　とびちるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張り　争いのため　コドラが
鋼の体を　ぶつけあうと
文字通り　火花が　飛び散るのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_306_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はがねの　ツノで　かたい　がんばんを
つきくずしながら　しょくりょうの
てつを　さがして　トンネルを　ほる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼の　ツノで　硬い　岩盤を
突き崩しながら　食料の
鉄を　探して　トンネルを　掘る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_307_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつもは　やまおくで　しゅぎょう。
めいそうをして　せいしんりょくを
たかめると　からだが　うかびあがる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつもは　山奥で　修行。
めいそうをして　精神力を　高めると
体が　浮かび上がる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_308_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにも　たべずに　ただひたすらに
せいしんを　とぎすませると
あいてのオーラが　みえるようになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なにも　食べずに　ただひたすらに
精神を　研ぎ澄ませると
相手のオーラが　見えるようになる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_309_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいもうに　ためた　でんきを　つかい
きんにくを　しげきすることで
しゅんぱつりょくを　たかめる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体毛に　ためた　電気を　使い
筋肉を　刺激することで
瞬発力を　高める。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_310_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たてがみから　ほうでんしている。
ずじょうに　かみなりぐもを　つくり
いなずまを　おとして　こうげきする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たてがみから　放電している。
頭上に　雷雲を　作り
稲妻を　落として　攻撃する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_311_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひばなの　ボンボンを　つくって
なかまを　おうえんする。
でんちゅうから　でんきを　すいとる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>火花の　ボンボンを　作って
仲間を　応援する。
電柱から　電気を　吸い取る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_312_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なかまを　おうえんする　しゅうせい。
まけそうになると　からだから　だす
ひばなの　かずが　どんどん　ふえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仲間を　応援する　習性。
負けそうになると　体から　出す
火花の　数が　どんどん　増える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_313_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よるになると　おしりを　ひからせ
なかまと　かいわする。イルミーゼの
だす　あまい　かおりが　だいすき。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夜になると　おしりを　光らせ
仲間と　会話する。イルミーゼの
出す　甘い　香りが　大好き。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_314_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまい　かおりで　バルビートを
ゆうどうして　よぞらに
ひかりの　サインを　えがく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甘い　香りで　バルビートを
誘導して　夜空に
光の　サインを　描く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_315_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みぎてと　ひだりてで　２しゅるいの
どくを　つかいわけて　こうげきする。
かおりが　つよいほど　げんきだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>右手と　左手で　２種類の
毒を　使いわけて　攻撃する。
香りが　強いほど　元気だ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_316_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　ほとんどが　いぶくろ。
きょうりょくな　いえきで　のみこんだ
ものを　たちまち　しょうかする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　ほとんどが　胃袋。
強力な　胃液で　飲み込んだ　ものを
たちまち　消化する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_317_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　まるのみしてしまう。
けあなから　もうどくの　たいえきを
ぶんぴつして　てきに　あびせかける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　まるのみしてしまう。
毛穴から　猛毒の　体液を
分泌して　敵に　浴びせかける。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_318_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばりに　はいってきた　あいてを
しゅうだんで　こうげき。するどい
キバは　ボートの　そこも　かみきる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張りに　入って来た　相手を
集団で　攻撃。鋭い　キバは
ボートの　底も　かみきる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_319_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てっぱんも　かみちぎる　キバを　もち
およぐ　そくどは　じそく１２０キロ。
べつめいは　うみのギャング。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鉄板も　かみちぎる　キバを　持ち
泳ぐ　速度は　時速１２０キロ。
別名は　海のギャング。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_320_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいにち　１トンの　エサをたべる。
はなから　ためこんだ　かいすいを
いきおいよく　ふきだして　あそぶ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>毎日　１トンの　エサを食べる。
鼻から　ためこんだ　海水を
勢いよく　吹きだして　遊ぶ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_321_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　からだを　なみのうえで
ジャンプさせ　しょうげきを　うみだし
あいてを　きぜつ　させることがある。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　体を　波の上で
ジャンプさせ　衝撃を　生みだし
相手を　気絶　させることがある。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_322_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１２００どの　マグマを　たいないに
ためこんでいる。ほのおの　わざを
つかうと　コブは　ちいさく　しぼむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１２００度の　マグマを　体内に
ためこんでいる。炎の　技を
使うと　コブは　小さく　しぼむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_323_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せなかの　コブの　かざんは
１０ねんごとに　だいふんか　するが
はげしく　おこっても　ふんかする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>背中の　コブの　火山は
１０年ごとに　大噴火　するが
激しく　怒っても　噴火する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_324_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうらの　なかで　せきたんを　もやし
エネルギーに　している。ピンチの
ときは　くろい　ススを　ふきだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甲羅の　中で　石炭を　燃やし
エネルギーに　している。ピンチの
ときは　黒い　ススを　吹き出す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_325_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シッポを　バネがわりに　して
とびはねることで　しんぞうを
うごかしているので　とまると　しぬ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シッポを　バネがわりに　して
飛び跳ねることで　心臓を
動かしているので　止まると　死ぬ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_326_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろしんじゅで　サイコパワーを
つよめ　きみょうな　ステップで
あいての　こころを　あやつるぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒真珠で　サイコパワーを
強め　奇妙な　ステップで
相手の　心を　操るぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_327_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなじ　ブチもようの　パッチールは
いない。フラフラした　あしどりで
あいての　ねらいを　はずす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>同じ　ブチ模様の　パッチールは
いない。フラフラした　足取りで
相手の　ねらいを　外す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_328_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜったいに　だっしゅつ　ふかのうな
すりばちじょうの　すあなを　つくって
えものが　おちてくるのを　まつ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>絶対に　脱出　不可能な
すりばち状の　巣穴を　つくって
獲物が　落ちてくるのを　待つ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_329_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２まいの　ハネを　こうそくで
しんどうさせて　だす　ちょうおんぱは
はげしい　ずつうを　ひきおこす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２枚の　ハネを　高速で
振動させて　だす　超音波は
激しい　頭痛を　ひきおこす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_330_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さばくのせいれい　と　よばれる。
はばたくことで　まきおこした
すなあらしの　なかに　かくれている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂漠の精霊　と　呼ばれる。
はばたくことで　巻き起こした
砂あらしの　中に　隠れている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_331_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さばくに　せいそく。たいないに
すいぶんを　ためることで　みずを
のまずに　３０にちかん　いきられる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂漠に　生息。体内に
水分を　ためることで　水を　飲まずに
３０日間　生きられる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_332_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よるになると　かつどうを　はじめる。
さばくの　あつさに　つかれはてた
えものを　みつけだし　とらえるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夜になると　活動を　はじめる。
砂漠の　暑さに　疲れ果てた
獲物を　見つけ出し　捕らえるのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_333_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとの　あたまの　うえに
ちょこんと　のって　ぼうしのように
ふるまうのが　なぜか　だいすき。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人の　頭の　上に
ちょこんと　乗って　帽子のように
ふるまうのが　なぜか　大好き。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_334_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はれたひ　わたぐもに　まぎれながら
おおぞらを　じゆうに　とびまわり
うつくしい　ソプラノで　うたう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>晴れた日　綿雲に　まぎれながら
大空を　自由に　飛びまわり
美しい　ソプラノで　歌う。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_335_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハブネークとは　いんねんの　あいだ。
であうと　すかさず　まえあしの
ツメを　ひろげて　いかくするのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハブネークとは　因縁の　あいだ。
であうと　すかさず　前足の
ツメを　広げて　威嚇するのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_336_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シッポの　かたなは　いつも　いわで
といでいるので　きれあじ　ばつぐん。
ザングースとは　いんねんの　あいだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シッポの　刀は　いつも　岩で
研いでいるので　切れ味　ばつぐん。
ザングースとは　因縁の　あいだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_337_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つきの　みちかけと　パワーの
ぞうげんが　かんけい　しているらしく
まんげつの　よる　かっぱつになる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>月の　満ち欠けと　パワーの
増減が　関係　しているらしく
満月の　夜　活発になる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_338_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいようエネルギーが　パワーの
みなもと　なので　ひるまは　つよい。
かいてんすると　からだが　ひかる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太陽エネルギーが　パワーの
源　なので　昼間は　強い。
回転すると　体が　光る。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_339_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬるぬるの　からだは　つかみにくい。
ある　ちほうでは　どろが　かたまって
ドジョッチが　うまれたと　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬるぬるの　体は　つかみにくい。
ある　地方では　泥が　固まって
ドジョッチが　生まれたと　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_340_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なわばりいしきが　とても　つよく
がいてきが　ちかづくと　はげしく
じめんを　ゆらして　おそいかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>縄張り意識が　とても　強く
外敵が　近づくと　激しく
地面を　揺らして　襲いかかる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_341_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんなに　みずが　よごれた
かわでも　てきおうして　ふえていく
タフな　せいめいりょくの　もちぬし。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんなに　水が　汚れた
川でも　適応して　増えていく
タフな　生命力の　持ち主。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_342_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうせんてきな　ポケモンで　じぶんの
なわばりから　あらゆる　ポケモンを
ハサミで　つまんで　なげとばすぞ！</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>好戦的な　ポケモンで　自分の
縄張りから　あらゆる　ポケモンを
ハサミで　つまんで　投げ飛ばすぞ！</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_343_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こだいの　いせきから　はっけん。
かいてん　しながら　いどうして
なかまを　みつけ　むれを　なす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古代の　遺跡から　発見。
回転　しながら　移動して
仲間を　みつけ　群れを　なす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_344_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２まんねんまえの　こだいじんが
つくった　ドロにんぎょうから
うまれたらしい　ナゾの　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２万年前の　古代人が
つくった　ドロ人形から
生まれたらしい　ナゾの　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_345_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>およそ　１おくねんまえの　かいていで
くらしていた　こだいの　ポケモン。
かがくの　ちからで　ふっかつした。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>およそ　１億年前の　海底で
暮らしていた　古代の　ポケモン。
科学の　力で　復活した。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_346_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたたかい　うみの　あさせに　いる。
しおが　ひくと　すなはまに　もぐった
えものを　ほりだして　たべる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暖かい　海の　浅瀬に　いる。
潮が　引くと　砂浜に　潜った
獲物を　掘り出して　食べる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_347_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かせきから　ふっかつした　ポケモンの
せんぞの　いっしゅ。うみで　くらし
ツメで　えものを　つかまえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>化石から　復活した　ポケモンの
先祖の　一種。海で　暮らし
ツメで　獲物を　捕まえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_348_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかして　ちじょうで　くらすように
なった。ぜんしんが　がんじょうな
よろいに　おおわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>進化して　地上で　暮らすように
なった。全身が　頑丈な
よろいに　おおわれている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_349_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みすぼらしく　みにくい　ポケモンだが
しぶとい　せいめいりょくを　もち
わずかな　みずだけでも　いきのびる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みすぼらしく　醜い　ポケモンだが
しぶとい　生命力を　持ち
わずかな　水だけでも　生き延びる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_350_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にじいろと　いわれる　きれいな
ウロコは　みるほうこうを　かえると
さまざまな　いろに　へんかする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>にじ色と　言われる　きれいな
ウロコは　見る方向を　変えると
様々な　色に　変化する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_351_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きおんや　しつどが　さいぼうに
えいきょう　するため　てんきによって
すがたが　かわってしまう　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気温や　湿度が　細胞に
影響　するため　天気によって
姿が　変わってしまう　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_352_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　いろを　じゆうに　かえる
のうりょくを　もつ。おなかにある
ギザギザもよう　だけは　かわらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　色を　自由に　変える
能力を　持つ。お腹にある
ギザギザ模様　だけは　変わらない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_353_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だれかが　だれかを　うらむ
くらく　かなしい　きもちを
すいとって　じわじわ　つよくなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>だれかが　だれかを　恨む
暗く　哀しい　気持ちを
吸い取って　じわじわ　強くなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_354_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すてられた　ヌイグルミに　うらみが
たまって　ポケモンに　なった。
じぶんをすてた　こどもを　さがすぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>捨てられた　ヌイグルミに　恨みが
たまって　ポケモンに　なった。
自分を捨てた　こどもを　探すぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_355_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こどもの　なきごえが　だいすきで
ぶあつい　かべも　とおりぬけて
わるいこを　おどろかせ　なかせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>子供の　泣き声が　大好きで
分厚い　壁も　通り抜けて
悪い子を　驚かせ　泣かせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_356_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さまよっている　ひとだまを　みつけ
からっぽの　たいないに　すいこむ。
すいこまれて　どうなるかは　なぞ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さ迷っている　人魂を　見つけ
からっぽの　体内に　吸い込む。
吸い込まれて　どうなるかは　ナゾ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_357_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　はっぱで　そらをとんで
こどもたちに　だいにんきの　くびに
できる　あまい　くだものを　くばる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　はっぱで　空を飛んで
こどもたちに　大人気の　首に
できる　甘い　くだものを　配る。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_358_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なきごえは　からだの　くうどうで
ひびきあって　きれいな　ねいろになり
てきをおどろかせ　おいはらっていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鳴き声は　体の　空洞で
響き合って　きれいな　音色になり
敵を驚かせ　追い払っていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_359_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツノで　さっちした　わざわいを
ひとに　しらせようとして
やまおくから　すがたを　あらわす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツノで　察知した　災いを
人に　知らせようとして
山奥から　姿を　表す。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_360_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なかまたちと　おしくらまんじゅうを
やることで　がまんづよく　そだつ。
あまい　くだものが　だいこうぶつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仲間たちと　おしくらまんじゅうを
やることで　我慢強く　育つ。
甘い　果物が　大好物。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_361_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　はっぱの　したに
すうひきの　ユキワラシが　あつまり
なかよく　くらしているという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　葉っぱの　下に
数匹の　ユキワラシが　集まり
仲良く　暮らしているという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_362_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くうきちゅうの　すいぶんを
いっしゅんで　こおらせることで
えものが　にげられないように　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>空気中の　水分を
一瞬で　凍らせることで
獲物が　逃げられないように　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_363_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まだ　じょうずに　およげず
ころがったほうが　はやく　うごける。
うれしいと　みんなで　てをたたく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まだ　上手に　泳げず
転がったほうが　速く　動ける。
うれしいと　みんなで　手をたたく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_364_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まるければ　モンスターボールでも
タマザラシでも　はなのうえに　のせて
じゆうじざいに　くるくる　まわすぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>丸ければ　モンスターボールでも
タマザラシでも　鼻の上に　乗せて
自由自在に　くるくる　回すぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_365_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぶあつい　しぼうは　さむさ　いがいに
てきの　こうげきも　よせつけない。
じまんのキバで　こおりを　くだくぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>分厚い　脂肪は　寒さ　以外に
敵の　こうげきも　よせつけない。
自慢のキバで　氷を　砕くぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_366_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっしょうに　１こだけ　つくる
しんじゅは　サイコパワーを
ぞうふくする　さようが　あるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一生に　１個だけ　作る
真珠は　サイコパワーを
増幅する　作用が　あるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_367_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかいに　せいそくする　ポケモン。
こざかなの　かたちをした　しっぽで
えものを　おびきよせ　つかまえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深海に　生息する　ポケモン。
小魚の　形をした　しっぽで
獲物を　誘き寄せ　捕まえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_368_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うみの　そこで　くらしているが
はるになると　からだの　ピンクいろが
なぜか　あざやかに　いろづく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海の　底で　暮らしているが
春になると　体の　ピンク色が
なぜか　鮮やかに　色づく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_369_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかいちょうさで　はっけんされた
めずらしい　ポケモン。１おくねんの
あいだ　すがたが　かわっていない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>深海調査で　発見された
珍しい　ポケモン。１億年の　あいだ
姿が　変わっていない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_370_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたたかい　うみに　せいそくする。
ラブカスを　みつけた　カップルは
えいえんの　あいが　つづくという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暖かい　海に　生息する。
ラブカスを　見つけた　カップルは
永遠の　愛が　続くという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_371_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおぞらを　とぶことを　ゆめみて
まいにち　とぶ　れんしゅうのために
がけから　とびおりている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大空を　飛ぶことを　夢見て
毎日　飛ぶ　練習のために
ガケから　飛び降りている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_372_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かたい　カラの　なかでは　さいぼうが
へんかを　はじめている。しんかする
しゅんかんに　カラが　はがれおちる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>硬い　殻の　中では　細胞が
変化を　始めている。進化する
瞬間に　殻が　はがれ落ちる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_373_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そらを　とぶことを　ねがいつづけた
けっか　からだの　さいぼうが
へんかして　つばさが　はえてきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>空を　飛ぶことを　願い続けた　結果
体の　細胞が　変化して
翼が　生えてきた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_374_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいぼう　すべてが　じしゃくで
からだから　じりょくを　はっしんし
なかまと　かいわ　している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>細胞　すべてが　磁石で
体から　磁力を　発信し
仲間と　会話　している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_375_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２ひきの　ダンバルが　がったいした。
２つの　のうみそが　れんけつしたので
サイコパワーは　より　つよくなった。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２匹の　ダンバルが　合体した。
２つの　脳みそが　連結したので
サイコパワーは　より　強くなった。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_376_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>４つの　のうみそが　つらなり
スーパーコンピューターより　すごい
けいさんで　あいてを　ぶんせきする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>４つの　脳みそが　連なり
スーパーコンピューターより　すごい
計算で　相手を　分析する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_377_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんしんが　いわで　できている。
たたかいで　からだが　かけても
いわを　くっつけて　なおしてしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全身が　岩で　できている。
戦いで　体が　欠けても
岩を　くっつけて　治してしまう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_378_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひょうがきに　できた　こおりで
からだが　つくられている。マイナス
２００どの　れいきを　あやつる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>氷河期に　できた　氷で
体が　作られている。
マイナス２００度の　冷気を　操る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_379_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんまんねんも　ちかの　あつりょくで
きたえられた　きんぞくの　ボディは
きずひとつ　つかない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>何万年も　地下の　圧力で
鍛えられた　金属の　ボディは
傷ひとつ　つかない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_380_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひかりを　くっせつさせる　うもうで
ぜんしんを　つつみこみ　すがたを
みえなくする　のうりょくを　もつ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>光を　屈折させる　羽毛で
全身を　包み込み　姿を
見えなくする　能力を　持つ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_381_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たかい　ちのうを　もつ　ポケモン。
うでを　おりたたんで　とべば
ジェットきを　おいこす　スピードだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高い　知能を　持つ　ポケモン。
腕を　折りたたんで　飛べば
ジェット機を　追い越す　スピードだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_382_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおあめを　ふらせる　のうりょくで
うみを　ひろげたと　いわれている。
かいこうの　そこで　ねむっていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大雨を　降らせる　能力で
海を　広げたと　言われている。
海溝の　底で　眠っていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_383_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおむかし　カイオーガとの　しとうの
すえに　ちかマグマの　なかで
ねむっていた　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大昔　カイオーガと　死闘の　末に
地下マグマの　中で
眠っていた　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_384_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くもより　はるかうえの　オゾンそうに
せいそくしているため　ちじょうから
すがたを　みることは　できない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雲より　はるか上の　オゾン層に
生息しているため　地上から
姿を　見ることは　できない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_385_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１０００ねんかんで　７にちだけ
めを　さまし　どんな　ねがいごとでも
かなえる　ちからを　つかうという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１０００年間で　７日だけ
目を　覚まし　どんな　願い事でも
かなえる　力を　使うという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_386_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いんせきに　ふちゃくしていた
うちゅうウイルスの　ＤＮＡが
へんいして　うまれた　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いん石に　付着していた
宇宙ウイルスの　ＤＮＡが
変異して　生まれた　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_387_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つちで　できた　せなかの　こうらを
さわって　ほどよく　しめっていたなら
その　ナエトルは　とても　げんきだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>土で　できた　背中の　甲羅を
触って　ほどよく　湿っていたなら
その　ナエトルは　とても　元気だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_388_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きれいな　みずが　わきでる　ばしょを
しっていて　なかまの　ポケモンを
せなかに　のせて　そこまで　はこぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きれいな　水が　わき出る　場所を
知っていて　仲間の　ポケモンを
背中に　乗せて　そこまで　運ぶ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_389_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドダイトスの　せなかで　うまれて
ドダイトスの　せなかで　いっしょうを
まっとうする　ポケモンも　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドダイトスの　背中で　生まれて
ドダイトスの　背中で　一生を
全うする　ポケモンも　いる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_390_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とても　みがるな　ポケモン。
まわりが　もえないように　おしりの
ほのおを　けしてから　ねむる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とても　身軽な　ポケモン。
まわりが　燃えないように　おしりの
炎を　消してから　眠る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_391_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　ほのおの　いきおいを
うまく　コントロールして　じぶんの
とくいな　まあいで　たたかうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　炎の　勢いを
うまく　コントロールして
自分の　得意な　間合いで　戦うのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_392_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てあしに　ほのおを　まとった
どくとくの　かくとうわざを　つかい
どんな　あいてにも　たちむかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手足に　炎を　まとった
独特の　格闘わざを　使い
どんな　相手にも　立ち向かう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_393_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あるくのは　にがてで　こけたりするが
ポッチャマの　プライドは　たかく
きにせず　どうどうと　むねを　はる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>歩くのは　苦手で　こけたりするが
ポッチャマの　プライドは　高く
気にせず　堂々と　胸を　はる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_394_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　ポッタイシも　じぶんが
いちばん　えらいと　かんがえるため
むれを　つくることは　ふかのうだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの　ポッタイシも　自分が
一番　偉いと　考えるため
群れを　作ることは　不可能だ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_395_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プライドを　きずつける　ものは
りゅうひょうをも　せつだんする
つばさで　まっぷたつに　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プライドを　傷つける　者は
流氷をも　切断する　翼で
真っ二つに　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_396_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むれを　つくることで　１ぴきでの
よわさを　カバーしあっているが
むれが　おおきくなると　もめだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>群れを　作ることで　１匹での
弱さを　カバーし合っているが
群れが　大きくなると　もめだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_397_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　よわさを　わきまえており
いつも　むれで　くらしている。
いっぴきになると　やかましく　なく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の　弱さを　わきまえており
いつも　群れで　暮らしている。
１匹になると　やかましく　鳴く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_398_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　からだが　きずつこうとも
こうげきを　やめなくなった。
とさかの　かたちを　きにしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の　体が　傷つこうとも
攻撃を　やめなくなった。
トサカの　形を　気にしている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_399_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビッパと　コラッタの　まえば
どちらが　のびるのが　はやいのか
くらべたところ　ひきわけ　だった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビッパと　コラッタの　前歯
どちらが　伸びるのが　早いのか
比べたところ　引き分け　だった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_400_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビーダルが　ダムを　つくった
かわは　はんらん　することがないので
ちかくの　ひとから　かんしゃされる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビーダルが　ダムを　作った
川は　はんらん　することがないので
近くの　人から　感謝される。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_401_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あしが　みじかく　こけそうになるたび
かたい　しょっかくが　こすれあって
もっきんのような　おとが　ひびく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>足が　短く　こけそうになるたび
硬い　触角が　こすれあって
木琴のような　音が　響く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_402_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へんげんじざいの　なきごえを
きそいあわせる　なきくらべ　という
あそびを　たのしむ　むらがある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>変幻自在の　鳴き声を
競い合わせる　鳴き比べ　という
遊びを　楽しむ　村がある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_403_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだを　うごかすたびに　きんにくが
のびちぢみして　でんきが　うまれる。
ピンチになると　からだが　かがやく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を　動かすたびに　筋肉が
伸び縮みして　電気が　生まれる。
ピンチになると　体が　輝く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_404_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>するどい　ツメの　さきには　つよい
でんきが　ながれており　ほんのすこし
かするだけで　あいてをきぜつさせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋭い　ツメの　先には　強い　電気が
流れており　ほんの少し　かするだけで
相手を気絶させる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_405_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かべのむこうも　みえる　ちからで
にげた　えものを　おいつめるほかにも
まいごの　こどもを　さがしたりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>壁の向こうも　見える　力で
逃げた　獲物を　追いつめるほかにも
迷子の　子供を　捜したりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_406_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まわりの　おんどへんかに　びんかん。
あたたかくなると　つぼみが　ひらき
どくをふくんだ　かふんを　ばらまく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>周りの　温度変化に　敏感。
暖かくなると　つぼみが　開き
毒を含んだ　花粉を　ばらまく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_407_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまい　かおりで　えものを　さそい
りょううでの　どくのムチを　つかって
さしたり　しめたりして　しとめる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>甘い　香りで　獲物を　誘い
両腕の　毒のムチを　使って
刺したり　締めたりして　仕留める。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_408_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>およそ　１おくねんまえの　ポケモン。
ジャングルで　うまれそだち　じゃまな
じゅもくは　ずつきで　へしおった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>およそ　１億年前の　ポケモン。
ジャングルで　生まれ育ち　邪魔な
樹木は　頭突きで　へしおった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_409_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまを　はげしく　ぶつけあっても
ずがいこつは　あつさ　３０センチも
あるので　きぜつ　したりしない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭を　激しく　ぶつけ合っても
頭がい骨は　厚さ　３０センチも
あるので　気絶　したりしない。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_410_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ばつぐんの　ぼうぎょりょくを　もつ。
そのため　とくに　あらそうこともなく
くさや　きのみを　たべて　すごす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>抜群の　防御力を　持つ。
そのため　特に　争うこともなく
草や　木の実を　食べて　過ごす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_411_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よこいちれつに　ならぶと　どんな
ポケモンでも　とっぱ　できない。
そうやって　こどもを　まもっていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>横一列に　並ぶと　どんな
ポケモンでも　突破　できない。
そうやって　子供を　守っていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_412_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだをつつむ　ざいりょうが　ない
ばしょで　うまれても　ミノムッチは
いつのまにか　ミノを　まとっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を包む　材料が　ない　場所で
生まれても　ミノムッチは
いつのまにか　ミノを　まとっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_413_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんかするとき　まわりにある
ざいりょうを　からだに　とりこむため
おおくの　バリエーションが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>進化するとき　まわりにある
材料を　体に　取り込むため
多くの　バリエーションが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_414_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなのミツが　だいすきだが
じぶんでは　あつめず　ミツハニーから
よこどり　ばかりを　かんがえている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>花のミツが　大好きだが
自分では　集めず　ミツハニーから
横取り　ばかりを　考えている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_415_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３びきセットの　ポケモン。
ねむるとき　ミツハニーが　１００ひき
あつまり　おおきな　すをつくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３匹セットの　ポケモン。
眠るとき　ミツハニーが　１００匹
集まり　大きな　巣をつくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_416_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうたいは　こどもたちの　すあな。
いろんな　フェロモンを　だして
こどもたちを　じゆうに　あやつる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>胴体は　こどもたちの　巣穴。
いろんな　フェロモンを　だして
こどもたちを　自由に　操る。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_417_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たまった　でんきを　わけあたえようと
ほほぶくろを　こすりあわせる
パチリスを　みかけることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たまった　電気を　分け与えようと
ほほ袋を　こすり合わせる
パチリスを　見かけることも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_418_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くびの　うきぶくろを　ふくらませ
すいめんから　かおを　だして
あたりの　ようすを　うかがっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>首の　浮き袋を　ふくらませ
水面から　顔を　だして
辺りの　様子を　うかがっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_419_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうしまちに　おおく　くらし
おぼれた　ひとを　たすけたり
とった　えものを　はこんでいる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>漁師町に　多く　暮らし
おぼれた　人を　助けたり
捕った　獲物を　運んでいる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_420_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさな　たまには　えいようが
つまっているだけでなく　おいしいので
ムックルに　ついばまれたりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　玉には　栄養が
つまっているだけでなく　おいしいので
ムックルに　ついばまれたりする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_421_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよい　ひざしを　かんじとると
とざしていた　はなびらを　ひろげ
ぜんしんで　にっこうを　あびる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強い　日差しを　感じとると
閉ざしていた　花びらを　広げ
全身で　日光を　浴びる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_422_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やわらかい　からだを　つよくおすと
むらさきいろの　なぞの　えきたいが
にじみでるので　ようちゅうい。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やわらかい　体を　強く押すと
紫色の　ナゾの　液体が
にじみ出るので　要注意。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_423_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むかしは　じょうぶな　カラで
せなか　ぜんたいを　おおっていた。
さいぼうに　その　なごりが　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昔は　丈夫な　殻で
背中　全体を　おおっていた。
細胞に　その　名残が　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_424_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２ほんに　わかれた　しっぽは
いろんなことが　きように　できるので
ほとんど　てを　つかわなくなった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２本に　分かれた　しっぽは
いろんなことが　器用に　できるので
ほとんど　手を　使わなくなった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_425_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たましいの　みちしるべと　いわれる。
フワンテを　もっていた　こどもは
とつぜん　きえて　いなくなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>魂の　道標と　いわれる。
フワンテを　持っていた　こどもは
突然　消えて　いなくなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_426_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとや　ポケモンを　はこぶ。
ただし　かぜに　ながされてしまうので
いきさきを　きめられない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人や　ポケモンを　運ぶ。
ただし　風に　流されてしまうので
行き先を　決められない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_427_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつも　まるめている　みみを
いきおいよく　のばすと　おおきな
いわも　かんたんに　こわせる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつも　丸めている　耳を
勢いよく　伸ばすと　大きな
岩も　簡単に　壊せる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_428_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>けいかいしんが　とても　つよい。
きけんを　かんじると　かろやかに
とびはねて　はしりさってしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>警戒心が　とても　強い。
危険を　感じると　軽やかに
飛び跳ねて　走り去ってしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_429_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅもんのような　なきごえだが
まれに　あいてを　しあわせにする
こうかも　ひめているという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じゅもんのような　鳴き声だが
まれに　相手を　幸せにする
効果も　秘めているという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_430_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドンカラスが　ひくいこえで　なくと
すぐさま　ヤミカラスが　あつまるため
よるをまねくもの　とも　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドンカラスが　低い声で　鳴くと
すぐさま　ヤミカラスが　集まるため
夜を招くもの　とも　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_431_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーが　エサを　くれないと
はなのあなに　ツメをひっかける
ひどい　いちめんを　ひめている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーが　エサを　くれないと
鼻の穴に　ツメをひっかける
ひどい　一面を　秘めている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_432_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうたいを　しっぽで　しばりつけて
じぶんを　おおきく　みせている。
めがあうと　いつまでも　にらみあう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>胴体を　しっぽで　縛りつけて
自分を　大きく　見せている。
目が合うと　いつまでも　にらみ合う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_433_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とびはねると　くちのなかにある
たまが　あちこちに　はんしゃして
すずのような　ねいろと　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>跳びはねると　口の中にある
玉が　あちこちに　反射して
鈴のような　音色と　なる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_434_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おしりからとばす　くさい　しるの
においは　はんけい２キロに　ひろがり
まわりの　ポケモンは　いなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おしりから飛ばす　くさい　汁の
においは　半径２キロに　広がり
まわりの　ポケモンは　いなくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_435_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっぽの　さきから　ひどい　においの
えきたいを　とばして　こうげきするが
うえから　ねらわれると　とまどう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっぽの　先から　ひどい　においの
液体を　飛ばして　攻撃するが
上から　ねらわれると　とまどう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_436_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふるい　おはかから　みつかる。
せなかの　もようには　しんぴてきな
ちからが　やどっていると　いわれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古い　お墓から　みつかる。
背中の　模様には　神秘的な
力が　宿っていると　いわれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_437_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまぐもを　よべる　ポケモンとして
おおむかしから　まつられていた。
ときどき　じめんに　うめられている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雨雲を　呼べる　ポケモンとして
大昔から　まつられていた。
ときどき　地面に　埋められている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_438_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんそうした　くうきを　このむ。
すいぶんを　ちょうせつ　するときに
だす　みずが　なみだに　みえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>乾燥した　空気を　好む。
水分を　調節　するときに
出す　水が　涙に　見える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_439_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めにみえる　あいての　かおや
うごきの　モノマネを　することで
どんな　きもちか　わかろうとする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目に見える　相手の　顔や
動きの　モノマネを　することで
どんな　気持ちか　わかろうとする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_440_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちいさないしを　かかえるのが　すき。
あいての　あしもとを　あるきまわって
ついつい　ころばすことも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>小さな　石を　抱えるのが　好き。
相手の　足元を　歩き回って
ついつい　転ばすことも　ある。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_441_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベロは　にんげんのものに　そっくり。
そのため　にんげんの　はなすことばを
じょうずに　まねることが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベロは　人間のものに　そっくり。
そのため　人間の　話す言葉を
上手に　真似ることが　できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_442_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつも　わるさばかり　していたら
ふしぎな　じゅつで　ほんたいを
かなめいしに　しばりつけられた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつも　悪さばかり　していたら
不思議な　術で　本体を
要石に　縛りつけられた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_443_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおぐちを　つかった　こうげきは
いりょく　じゅうぶんだが　まだ
うまくたたかえず　じぶんもきずつく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大口を　使った　攻撃は
威力　十分だが
まだ　うまく戦えず　自分も傷つく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_444_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひかりかがやく　ものが　だいすきで
どうくつの　なかで　みつけた
たからを　じぶんのすに　ためこむ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>光り輝く　ものが　大好きで
洞くつの　中で　見つけた
宝を　自分の巣に　ため込む。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_445_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうそくで　かけぬけると　つばさは
くうきの　やいばを　うみだし
まわりのきは　せつだん　されている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高速で　駆け抜けると　翼は
空気の　刃を　生み出し
まわりの木は　切断　されている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_446_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひっしに　エサを　たべているうちに
からだの　けのしたに　かくしていた
エサのことを　わすれてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>必死に　エサを　食べているうちに
体の　毛の下に　隠していた
エサのことを　忘れてしまうのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_447_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんじょうで　かたちが　かわる
はどうを　だしあって　なかまどうし
コミュニケーションを　とっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>感情で　形が　変わる
波動を　だしあって　仲間同士
コミュニケーションを　とっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_448_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あらゆる　ものが　だす　はどうを
よみとることで　１キロさきに　いる
あいての　きもちも　りかいできる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あらゆる　ものが　だす　波動を
読みとることで　１キロ先に　いる
相手の　気持ちも　理解できる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_449_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなの　あなを　ぴたりと　とじてから
すなのなかを　あるくように　すすむ。
１０ぴきていどの　むれで　くらす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鼻の　穴を　ピタリと　閉じてから
砂の中を　歩くように　進む。
１０匹程度の　群れで　暮らす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_450_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いがいと　おこりっぽい　ポケモンで
くちを　おおきく　あけることで
まわりに　つよさを　アピールする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>意外と　怒りっぽい　ポケモンで
口を　大きく　開けることで
まわりに　強さを　アピールする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_451_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんそうした　とちに　くらし
いちねんかん　なにも　たべずに
えものを　まちぶせ　できる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>乾燥した　土地に　暮らし
一年間　なにも　食べずに
獲物を　待ちぶせ　できる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_452_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じまんの　パワーで　あいてを
ばらばらに　できるのに　さらに
もうどくで　とどめを　さすのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自慢の　パワーで　相手を
ばらばらに　できるのに　さらに
猛毒で　とどめを　刺すのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_453_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どくぶくろを　ふくらませて　ならし
あたりに　ぶきみな　おとが　ひびかせ
あいてが　ひるむと　どくづきをする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>毒袋を　ふくらませて　鳴らし
辺りに　不気味な　音が　響かせ
相手が　ひるむと　どくづきをする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_454_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドクロッグが　たたかいの　まえに
のどを　ならすのは　どくぶくろに
ためこんだ　どくを　ねりこむためだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドクロッグが　戦いの　前に
のどを　鳴らすのは　毒袋に
ためこんだ　毒を　練りこむためだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_455_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょくしゅで　きのえだに　まきつき
だえきの　あまい　かおりで　えものが
さそわれてくるのを　まっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>触手で　木の枝に　巻きつき
だ液の　甘い　香りで　獲物が
誘われてくるのを　待っている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_456_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　よこがわにある　ラインは
たいようのひかりを　ためておける。
よるになると　あざやかに　かがやく。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　横側にある　ラインは
太陽の光を　ためておける。
夜になると　鮮やかに　輝く。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_457_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながい　ひれを　あしのように
つかって　かいていを　はっている。
ランターンと　えものを　とりあう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長い　ヒレを　足のように
使って　海底を　はっている。
ランターンと　獲物を　取り合う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_458_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せなかの　もようは　ちいきによって
ことなっている。テッポウオの　むれに
まざって　およぐことが　おおい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>背中の　模様は　地域によって
異なっている。テッポウオの　群れに
混ざって　泳ぐことが　多い。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_459_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にんげんに　きょうみが　あるのか
ゆきやまで　あしあとを　みつけると
そのまわりに　あつまってくる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人間に　興味が　あるのか
雪山で　足跡を　見つけると
そのまわりに　集まって来る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_460_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆきのはなが　さくころ　どこからか
すがたを　あらわし　はながちると
また　どこかに　すがたを　かくす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雪の花が　咲くころ　どこからか
姿を　現し　花が散ると
また　どこかに　姿を　隠す。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_461_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツメで　いしに　サインをのこし
コミュニケーションを　とりながら
れいけいプレイで　てきを　おいこむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツメで　石に　サインを残し
コミュニケーションを　とりながら
連携プレイで　敵を　追いこむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_462_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよすぎる　じりょくを　だして
ジバコイルどうし　ひきよせあって
まったく　うごけなくなったりする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強すぎる　磁力を　だして
ジバコイル同士　引き寄せあって
まったく　動けなくなったりする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_463_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だえきには　どんな　ものを　とかす
せいぶんが　たっぷり　ふくまれており
なめられると　いつまでも　しびれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>だえきには　どんな　物を　溶かす
成分が　たっぷり　含まれており
なめられると　いつまでも　しびれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_464_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きんにくを　ちからを　こめて
しゅんかんてきに　ふくらませることで
てにした　いしを　ふんしゅつできる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>筋肉を　力を　込めて
瞬間的に　膨らませることで
手にした　石を　噴出できる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_465_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うでを　たべられても　へっちゃら。
さいせいのうりょくが　たかいので
あっ　というまに　もとどおりになる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腕を　食べられても　へっちゃら。
再生能力が　高いので
あっ　というまに　元通りになる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_466_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてに　シッポのさきを　おしつけ
しゅんじに　２まんボルト　いじょうの
こうあつ　でんりゅうを　おくりこむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手に　シッポの先を　押しつけ
瞬時に　２万ボルト　以上の
高圧　電流を　送りこむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_467_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うでのさきから　せっし２０００どの
ひのたまを　うちだすとき　からだは
ねつのため　ほのかに　しろくなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腕の先から　摂氏２０００度の
火の玉を　撃ちだすとき　体は
熱のため　ほのかに　白くなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_468_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おたがいの　そんざいを　みとめあい
むだに　あらそわない　ひとのために
さまざまな　めぐみを　わけあたえる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お互いの　存在を　認め合い
無駄に　争わない　人のために
様々な　恵みを　分け与える。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_469_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうそくで　とんで　すれちがった
あいての　くびを　いっしゅんで
かみちぎる　たたかいかたを　このむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高速で　飛んで　すれ違った
相手の　首を　一瞬で
かみちぎる　戦い方を　好む。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_470_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょくぶつの　ような　さいぼうになり
たいないで　こうごうせいを　して
きれいな　くうきを　つくりだせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>植物の　ような　細胞になり
体内で　光合成を　して
きれいな　空気を　つくりだせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_471_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいおんを　さげることで　ぜんしんの
たいもうを　こおらせて　するどく
とがった　ハリのようにして　とばす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体温を　さげることで　全身の
体毛を　凍らせて　鋭く
とがった　ハリのようにして　飛ばす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_472_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとをたてずに　そらを　まい
えものに　ちかづくと　いっしゅんで
きゅうしょを　ひとつき　するぞ！</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>音をたてずに　空を　舞い
獲物に　近づくと　一瞬で
急所を　一突き　するぞ！</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_473_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひょうがきの　おわりに　きおんが
たかくなると　おおくの　マンムーが
すがたを　けしたと　いわれている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>氷河期の　終わりに　気温が
高くなると　多くの　マンムーが
姿を　消したと　いわれている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_474_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いじげんでも　かつやく　できるよう
プログラムを　しゅうせい　したが
ねらいどおりには　いかなかった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>異次元でも　活躍　できるよう
プログラムを　修正　したが
ねらい通りには　いかなかった。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_475_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だれかを　まもろうと　したとき
ひじをのばし　かたなのように
へんか　させて　はげしく　たたかう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>だれかを　守ろうと　したとき
ひじを伸ばし　刀のように
変化　させて　激しく　戦う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_476_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チビノーズと　よばれる　３つの
ユニットを　じりょくを　つかって
じゆうじざいに　あやつっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チビノーズと　呼ばれる　３つの
ユニットを　磁力を　使って
自由自在に　操っている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_477_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だんりょくのある　からだの　なかに
いきばのない　たましいを　とりこんで
あのよに　つれていくと　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>弾力のある　体の　中に
行き場のない　魂を　取り込んで
あの世に　連れていくと　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_478_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マイナス５０どの　いきを　ふきかけ
こおらせた　えものを　ひみつの
ばしょに　かざっていると　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マイナス５０度の　息を　吹きかけ
凍らせた　獲物を　秘密の
場所に　飾っていると　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_479_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんきのような　からだは　いちぶの
きかいに　はいりこむことが　できる。
そして　そのからだで　いたずらする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>電気のような　体は　一部の
機械に　入り込むことが　できる。
そして　その体で　いたずらする。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_480_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ユクシーが　とびまわったことで
ひとびとに　ものごとを　かいけつする
ちえ　というものが　うまれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ユクシーが　飛び回ったことで
人々に　物事を　解決する
知恵　というものが　生まれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_481_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エムリットが　とびまわったことで
ひとびとに　いきるときの　よろこび
かなしみ　というものが　うまれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エムリットが　飛び回ったことで
人々に　生きるときの　喜び
悲しみ　というものが　生まれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_482_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アグノムが　とびまわったことで
ひとびとに　なにかを　するための
けつい　というものが　うまれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アグノムが　飛び回ったことで
人々に　なにかを　するための
決意　というものが　生まれた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_483_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ディアルガの　しんぞうが　うごくと
じかんは　ながれていくと　されている
シンオウの　でんせつ　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ディアルガの　心臓が　動くと
時間は　流れていくと　されている。
シンオウの　伝説　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_484_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パルキアが　こきゅうを　するたびに
くうかんは　あんていすると　される
シンオウの　でんせつの　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パルキアが　呼吸を　するたびに
空間は　安定すると　される。
シンオウの　伝説の　ポケモン。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_485_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんじょうな　はがねの　からだだが
じぶんが　はっする　こうねつの　ため
ところどころ　とけてしまっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頑丈な　鋼の　体だが
自分が　発する　高熱の　ため
ところどころ　溶けてしまっている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_486_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とくしゅな　ひょうざんや　がんせき
マグマから　じぶんの　すがたに　にた
ポケモンを　つくったと　いわれる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>特殊な　氷山や　岩石　マグマから
自分の　姿に　似た　ポケモンを
つくったと　言われる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_487_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あばれもの　ゆえ　おいだされたが
やぶれたせかいと　いわれる　ばしょで
しずかに　もとのせかいを　みていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暴れ者　ゆえ　追い出されたが
破れた世界と　言われる　場所で
静かに　元の世界を　見ていた。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_488_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みかづきに　ちかい　よるほど
しっぽから　のびる　オーロラは
ながく　うつくしくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>三日月に　近い　夜ほど
しっぽから　伸びる　オーロラは
長く　美しくなる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_489_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたたかい　うみを　ただよっている。
どんな　とおくに　ながされても
うまれた　ばしょに　かならずもどる。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暖かい　海を　漂っている。
どんな　遠くに　流されても
生まれた　場所に　かならず戻る。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_490_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うまれたときから　そなわっている
ふしぎな　ちからを　つかうと　どんな
ポケモンとも　こころが　かよいあう。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれたときから　備わっている
不思議な　力を　使うと　どんな
ポケモンとも　心が　通い合う。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_491_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんを　まもるために　まわりの
ひとや　ポケモンに　あくむをみせるが
ダークライに　わるぎは　ないのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分を　守るために　まわりの
人や　ポケモンに　悪夢を見せるが
ダークライに　悪気は　ないのだ。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_492_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとに　やさしく　だきしめられ　
ありがとうの　きもちを　かんじると
ぜんしんの　はなが　ひらきだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人に　優しく　抱きしめられ
ありがとうの　気持ちを　感じると
全身の　花が　開きだす。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_493_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにも　ない　ばしょに　あった
タマゴのなかから　すがたを　あらわし
せかいを　うみだしたと　されている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なにも　ない　場所に　あった
タマゴの中から　姿を　現し
世界を　生み出したと　されている。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_494_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビクティニが　むげんに　うみだす
エネルギーを　わけあたえてもらうと
ぜんしんに　パワーが　あふれだす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビクティニが　無限に　生みだす
エネルギーを　わけあたえてもらうと
全身に　パワーが　あふれだす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_495_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいようの　ひかりを　あびると
いつもよりも　すばやく　うごける。
てよりも　ツルを　うまくつかう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太陽の　光を　浴びると
いつもよりも　すばやく　動ける。
手よりも　ツルを　うまく使う。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_496_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだが　よごれると　はっぱで
こうごうせいが　できなくなるので
いつも　せいけつに　している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体が　汚れると　はっぱで
光合成が　できなくなるので
いつも　清潔に　している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_497_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジャローダの　けだかい　ひとみで
いすくめられても　へいきな　つよい
あいてにだけ　ほんきを　だす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジャローダの　気高い　ひとみで
射すくめられても　平気な　強い
相手にだけ　本気を　だす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_498_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やいた　きのみを　たべるのが
だいすきだが　こうふんしすぎて
ときどき　まっくろこげに　しちゃう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>焼いた　きのみを　食べるのが
大好きだが　興奮しすぎて
ときどき　真っ黒焦げに　しちゃう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_499_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たべるほどに　もやすものが　ふえて
いぶくろないの　ほのおが　つよまり
パワーも　どんどん　あふれだすのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>食べるほどに　燃やすものが　増えて
胃袋内の　炎が　強まり
パワーも　どんどん　あふれだすのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_500_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒゲの　ほのおが　もえあがるのは
きあいが　はいった　あかし。
かずおおくの　わざを　つかいこなす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒゲの　炎が　燃えあがるのは
気合が　はいった　証。
数多くの　技を　使いこなす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_501_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなかに　できる　ホタチは
たたかうとき　だけでなく　かたい
きのみを　わるときにも　つかう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おなかに　できる　ホタチは
戦うとき　だけでなく　固い
きのみを　割るときにも　使う。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_502_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きびしい　しゅぎょうの　すえ
フタチマルごとに　ことなる　かたの
ホタチさばきを　しゅうとく　する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>厳しい　修行の　すえ
フタチマルごとに　異なる　型の
ホタチさばきを　習得する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_503_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てきが　まばたきする　あいだに
まえあしに　ついた　アシガタナで
あいてを　きりつけ　もとにもどせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>敵が　瞬きする　あいだに
前足に　ついた　アシガタナで
相手を　切りつけ　元に戻せる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_504_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>けいかいしんが　つよく　かならず
いっぴきは　みはりを　しているのだが
うしろからの　てきには　きづかない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>警戒心が　強く　必ず
一匹は　見張りを　しているのだが
後ろからの　敵には　気づかない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_505_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいないの　はっこうぶっしつで
めだまや　からだを　ひからせ
おそってきた　てきを　ひるませる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体内の　発行物質で
目玉や　体を　光らせ
襲ってきた　敵を　ひるませる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_506_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆうもうな　ポケモンだが　あいての
つよさを　たしかめて　たたかいを
さける　かしこさも　あわせもつ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勇猛な　ポケモンだが　相手の
強さを　確かめて　戦いを
避ける　賢さも　併せ持つ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_507_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーを　たすけながら
ほかの　ポケモンの　せわもする
とても　ちゅうじつな　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーを　助けながら
他の　ポケモンの　世話もする
とても　忠実な　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_508_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながい　たいもうに　つつまれると
ふゆやまでも　ひとばん　へいきなほど
あたたかく　とても　ここちよい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長い　体毛に　包まれると
冬山でも　一晩　平気なほど
暖かく　とても　心地よい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_509_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かわいらしい　しぐさで　ゆだんさせ
だいじな　ものを　ぬすむのは　ひとの
こまった　ようすを　みたいから。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>かわいらしい　仕草で　油断させ
大事な　ものを　盗むのは　人の
困った　様子を　みたいから。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_510_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うつくしい　スタイルは　ぜんしんの
はったつした　きんにくの　おかげ。
おともたてずに　よるを　かけぬける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>美しい　スタイルは　全身の
発達した　筋肉の　おかげ。
音もたてずに　夜を　駆けぬける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_511_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きのみを　さがすのが　じょうずで
あちこちで　あつめて　なかまに　
わけあたえる　やさしさを　もつ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きのみを　探すのが　上手で
あちこちで　集めて　仲間に
わけあたえる　優しさを　もつ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_512_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トゲのついた　シッポを　ふりまわし
たたきつけて　あいてを　こうげき。
あたまの　はっぱは　とても　にがい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トゲのついた　シッポを　振り回し
たたきつけて　相手を　攻撃。
頭の　はっぱは　とても　苦い。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_513_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちのうが　たかく　きのみは
やいてから　たべる　しゅうせい。
ひとの　てつだいを　このんでいる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>知能が　高く　きのみは
焼いてから　食べる　しゅうせい。
人の　手伝いを　好んでいる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_514_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうふんすると　あたまや　シッポから
ひのこが　まいあがって　あつくなる。
なぜか　あまいものが　だいこうぶつ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>興奮すると　頭や　シッポから
火の粉が　舞いあがって　熱くなる。
なぜか　甘いものが　大好物。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_515_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまのふさに　ためこんだ　みずは
えいよう　たっぷり。シッポをつかって
その　みずを　くさきに　かけている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の房に　ためこんだ　水は
栄養　たっぷり。シッポを使って
その　水を　草木に　かけている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_516_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みずが　きれいな　ばしょを　このむ。
あたまに　ためこんだ　みずがへると
シッポから　すいあげて　ほきゅう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>水が　きれいな　場所を　好む。
頭に　ためこんだ　水が減ると
シッポから　吸いあげて　補給。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_517_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わるい　ゆめに　うなされている
ポケモンや　ひとの　まえに　あらわれ
そのゆめを　たべてしまう　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>悪い　夢に　うなされている
ポケモンや　人の　前に　現われ
その夢を　食べてしまう　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_518_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おでこから　でる　ゆめのけむりは
たべた　ゆめの　ないようによって
さまざまな　いろに　かわるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おでこから　でる　ゆめのけむりは
食べた　夢の　内容によって
さまざまな　色に　変わるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_519_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とても　わすれっぽい　ポケモンで
トレーナーに　めいれい　されたのに
あたらしい　めいれいを　まっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とても　忘れっぽい　ポケモンで
トレーナーに　命令　されたのに
新しい　命令を　待っている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_520_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいの　どこに　いても
じぶんの　すの　ばしょは　わかるので
トレーナーとも　はぐれたりしない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界の　どこに　いても
自分の　巣の　場所は　わかるので
トレーナーとも　はぐれたりしない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_521_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　かざりを　ゆらして
いかく　してくる　オスだが
とぶのは　メスよりも　へただ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　飾りを　揺らして
いかく　してくる　オスだが
飛ぶのは　メスよりも　へただ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_522_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほうでんすると　たてがみが　ひかる。
たてがみが　かがやく　かいすうや
リズムで　なかまと　かいわしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>放電すると　たてがみが　光る。
たてがみが　輝く　回数や
リズムで　仲間と　会話している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_523_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はげしい　きしょうの　もちぬし。
あらぶると　たてがみから　かみなりを
しほうはっぽうに　ほうでんする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>激しい　気性の　持ち主。
荒ぶると　たてがみから　雷を
四方八方に　放電する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_524_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ろっかくけいの　あなは　みみ。
おとの　なるほうに　あるいていく
しゅうせいを　もっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>六角形の　穴は　耳。
音の　なるほうに　歩いていく
習性を　持っている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_525_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げんきだと　コアが　とびだしてくる。
からだの　むきを　かえることなく
ぜんごさゆうに　すばやく　うごける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>元気だと　コアが　飛びだしてくる。
体の　向きを　変えることなく
戦後左右に　すばやく　動ける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_526_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とりこんだ　たいようこうせんを
エネルギーコアで　はんのう　させて
ひかりのたまとして　うちだしてくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>取りこんだ　太陽光線を
エネルギーコアで　反応　させて
光の玉として　撃ちだしてくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_527_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コロモリの　はなを　くっつけた
からだに　ハートがたの　あとがつくと
いいことが　おこると　いわれている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コロモリの　鼻を　くっつけた
体に　ハート型の　跡がつくと
いいことが　起こると　いわれている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_528_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コンクリートも　こわせるほどの
つよい　ちょうおんぱを　だすとき
シッポが　はげしく　ふるえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コンクリートも　壊せるほどの
強い　超音波を　だすとき
シッポが　激しく　震える。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_529_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだを　スピンさせることで
じそく５０キロの　スピードのまま
まっすぐ　じめんを　ほりすすむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体を　スピンさせることで
時速５０キロの　スピードのまま
まっすぐ　地面を　掘り進む。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_530_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はがねになった　ツメと　あたまで
ドリルを　つくり　どんなに
ぶあつい　てっぱんも　つらぬく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼になった　ツメと　頭で
ドリルを　つくり　どんなに
分厚い　鉄板も　貫く。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_531_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みみの　しょっかくで　あいての
たいちょうや　タマゴから　ポケモンが
いつ　でてくるのかも　わかるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>耳の　触覚で　相手の
体調や　タマゴから　ポケモンが
いつ　でてくるのかも　わかるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_532_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つねに　かくざいを　もちあるき
どぼくこうじを　てつだう。そだつと
おおきな　かくざいに　もちかえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>常に　角材を　持ち歩き
土木工事を　手伝う。育つと
大きな　角材に　持ち替える。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_533_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きたえあげた　きんにくの　もちぬし。
てっこつを　たくみに　あやつって
いっけんやを　かいたい　してくれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鍛えあげた　筋肉の　持ち主。
鉄骨を　たくみに　操って
一軒家を　解体してくれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_534_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちからに　たよらず　えんしんりょくを
うまく　いかして　コンクリートを
ふりまわす　わざを　つかいこなせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>力に　頼らず　遠心力を
うまく　活かして　コンクリートを
振り回せ　技を　使いこなせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_535_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほほの　しんどうまくを　ふるわせ
ひとには　きこえない　おんぱを　だし
なかまたちに　きけんを　つたえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほほの　振動膜を　震わせ
人には　きこえない　音波を　だし
仲間たちに　危険を　伝える。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_536_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すいちゅうと　りくちで　くらしつつ
ながく　ねばねばする　ベロをつかって
あいての　うごきを　ふうじこめる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>水中と　陸地で　暮らしつつ
長く　ねばねばする　ベロを使って
相手の　動きを　封じこめる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_537_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コブに　ちからを　いれることで
バイブレーションが　はっせいして
パンチの　いりょくが　アップする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コブに　力を　いれることで
バイブレーションが　発生して
パンチの　威力が　アップする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_538_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんより　おおきな　あいてと
であうと　むしょうに　なげたくなる。
つよくなると　おびを　とりかえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分より　大きな　相手と
出会うと　無性に　投げたくなる。
強くなると　帯を　取り替える。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_539_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうの　からてチョップを
もとめて　やまおくに　こもって
ねむることなく　しゅぎょうする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強の　からてチョップを
求めて　山奥に　こもって
眠ることなく　修行する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_540_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はっぱから　ふくを　つくるので
ファッションデザイナーから
マスコットとして　にんきがある。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はっぱから　服を　つくるので
ファッションデザイナーから
マスコットとして　人気がある。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_541_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うすぐらく　じめじめした　ばしょを
このみ　じぶんの　まわりにある
おちばを　たべて　いちにち　すごす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>薄暗く　じめじめした　場所を
好み　自分の　周りにある
落ち葉を　食べて　一日　過ごす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_542_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おさない　ポケモンを　みつけると
くちから　だす　ねんちゃくいとで
はっぱの　ふくを　ぬってあげる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>幼い　ポケモンを　みつけると
口から　だす　粘着糸で
はっぱの　服を　縫ってあげる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_543_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまと　シッポの　しょっかくで
くうきのゆれを　かんじとり　えものの
いちや　ようすを　はあくしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭と　シッポの　触覚で
空気の揺れを　感じ取り　獲物の
位置や　様子を　把握している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_544_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じっとして　しんかの　エネルギーを
ためているが　てきが　ちかづくと
どくのトゲを　さすため　うごきだす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じっとして　進化の　エネルギーを
ためているが　敵が　近づくと
毒のトゲを　刺すため　動きだす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_545_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えものを　くびのツメで　はさみこみ
みうごきを　とれなくしてから
もうどくを　あたえ　とどめを　さす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>獲物を　首のツメで　挟みこみ
身動きを　とれなくしてから
猛毒を　与え　とどめを　刺す。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_546_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゅうだんで　いると　おちつくのか
なかまを　みつけると　くっついて
いつのまにか　くものように　なる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>集団で　いると　落ち着くのか
仲間を　みつけると　くっついて
いつのまにか　雲のように　なる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_547_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つむじかぜと　ともに　あらわれて
いえのなかの　かぐを　うごかしたり
わたを　のこす　いたずらをする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>つむじかぜと　ともに　現われて
家の　仲の　家具を　動かしたり
綿を　残す　いたずらをする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_548_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬけおちても　すぐに　はえてくる
あたまの　はっぱは　とても　にがいが
かじれば　すぐ　げんきに　なれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>抜け落ちても　すぐに　生えてくる
頭の　はっぱは　とても　苦いが
かじれば　すぐ　元気に　なれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_549_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまの　はなかざりから　はっする
かおりを　かぐと　リラックスできるが
ていれが　とても　むずかしい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭の　花飾りから　発する
香りを　かぐと　リラックスできるが
手入れが　とても　難しい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_550_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とても　らんぼうで　いつも　あかと
あおの　バスラオは　あらそっている。
たべると　いがいと　おいしいらしい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とても　乱暴で　いつも　あかと
あおの　バスラオは　争っている。
食べると　意外と　おいしいらしい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_551_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいおんを　さげないように
さばくの　あつい　すなに　もぐり
かくれながら　せいかつ　している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体温を　さげないように
砂漠の　熱い　砂に　潜り
隠れながら　生活　している。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_552_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うすい　まくで　おおわれている
りょうめは　まよなかでも　みえる。
すうひきの　むれで　くらしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>薄い　膜で　被われている
両目は　真夜中でも　みえる。
数匹の　群れで　暮らしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_553_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とても　きょうぼうな　ポケモン。
めのまえで　うごくものは　すべて
おそいかかり　かみくだこうとする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とても　凶暴な　ポケモン。
目の前で　動くものは　すべて
襲いかかり　かみくだこうとする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_554_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねるときは　てあしを　ひっこめ
たいないで　もえている　６００どの
ほのおも　ちいさくなり　おちつくよ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>寝るときは　手足を　ひっこめ
体内で　燃えている　６００度の
炎も　小さくなり　落ち着くよ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_555_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はげしい　たたかいで　きずつくと
いわのように　かたまり　もっこうして
こころを　とぎすませるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>激しい　戦いで　傷つくと
岩のように　固まり　黙考して
心を　研ぎ澄ませるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_556_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リズミカルに　からだを　ゆすると
マラカスに　にた　おとが　なりひびき
おどろいた　ポケモンは　にげだす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リズミカルに　体を　揺すると
マラカスに　似た　音が　鳴り響き
驚いた　ポケモンは　逃げだす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_557_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てごろな　サイズの　いしが　あると
くちから　えきたいを　ぶんぴつして
なかに　はいるための　あなをあける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>てごろな　サイズの　石が　あると
口から　液体を　分泌して
中に　入るための　穴をあける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_558_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いい　いわが　とれる　ばしょを
テリトリーに　したがる。せなかの
いわを　こわされると　おいだされる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いい　岩が　採れる　場所を
テリトリーに　したがる。背中の
岩を　壊されると　追いだされる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_559_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんじょうな　ずがいこつが　じまん。
いきなり　ずつきを　かましてくるが
おもさで　じぶんも　フラフラしてる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頑丈な　ずがいこつが　自慢。
いきなり　頭突きを　かましてくるが
重さで　自分も　フラフラしてる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_560_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だっぴした　かわを　ずりあげて
ダメージを　へらしつつ　キック！
とさかが　おおきいほど　えらそうだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>脱皮した　皮を　ずりあげて
ダメージを　　減らしつつ　キック！
とさかが　大きいほど　偉そうだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_561_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こだいとしの　まもりがみ。
いつも　おなじルートを　じゅんかいし
しんにゅうしゃを　みはっていた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古代都市の　守り神。
いつも　同じルートを　巡回し
侵入者を　見張っていた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_562_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おはかに　まいそうされた　ひとの
たましいが　ポケモンに　へんかした。
しぬまえの　きおくが　のこっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お墓に　埋葬された　人の
魂が　ポケモンに　変化した。
死ぬ前の　記憶が　残っている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_563_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんものの　かんおけと　まちがえ
ちかよってきた　はかドロボウを
からだの　なかに　とじこめてしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本物の　かんおけと　間違え
近寄ってきた　墓ドロボウを
体の　中に　閉じこめてしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_564_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カセキから　ふっかつした　ポケモン。
たっしゃに　およいで　ふかさ
１０００メートルまで　もぐっていた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>化石から　復活した　ポケモン。
達者に　泳いで　深さ
１０００メートルまで　潜っていた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_565_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はったつした　まえあしで　あいてを
ひっぱたき　きぜつさせると　カラや
ホネまで　まるごと　かみくだいた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>発達した　前足で　相手を
ひっぱたき　気絶させると　カラや
ホネまで　まるごと　かみくだいた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_566_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こだいの　かせきから　ふっかつした。
きのうえで　くらしているが　とべず
えだから　えだを　とびうつっていた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古代の　化石から　復活した。
木の上で　暮らしているが　飛べず
枝から　枝を　飛び移っていた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_567_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とぶよりも　はしるほうが　とくいで
じそく４０キロで　かけぬけた
いきおいで　おおぞらに　はばたく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>飛ぶよりも　走るほうが　得意で
時速４０キロで　駆けぬけた
勢いで　大空に　羽ばたく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_568_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さらなる　ゴミを　もとめて
ポイすてをする　ひとを　つけまわす。
いつも　どくガスを　はきだしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さらなる　ゴミを　求めて
ポイ捨てをする　人を　つけまわす。
いつも　毒ガスを　吐きだしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_569_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゴミを　すいとっては　たいないで
あたらしい　しゅるいの　どくガスや
どくの　えきたいを　うみだしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゴミを　吸いとっては　体内で
新しい　種類の　毒ガスや
毒の　液体を　生みだしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_570_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてそっくりに　ばけているように
みせかけ　だましたり　おどろかして
そのすきに　にげだすことが　おおい。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手そっくりに　化けているように
みせかけ　だましたり　驚かして
そのすきに　逃げだすことが　多い。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_571_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゾロアークを　とらえようとした
ひとを　マボロシの　けしきのなかに
とじこめ　こらしめた　といわれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゾロアークを　捕らえようとした
人を　マボロシの　景色の中に
閉じこめ　こらしめた　といわれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_572_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おたがいの　シッポで　あいてを
とことん　きれいに　してあげるのが
チラーミィどうしの　あいさつ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お互いの　シッポで　相手を
とことん　きれいに　してあげるのが
チラーミィ同士の　あいさつ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_573_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チラチーノの　からだは　とくべつな
あぶらで　おおわれており　パンチなど
あいての　こうげきを　うけながす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チラチーノの　体は　特別な
脂で　被われており　パンチなど
相手の　攻撃を　受け流す。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_574_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　じっと　みつめている。
かんさつに　むちゅうに　なってしまい
こうげきに　きづかないことも　ある。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　じっと　みつめている。
観察に　夢中に　なってしまい
攻撃に　きづかないことも　ある。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_575_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほしあかりが　かがやく　よるに
ねている　こどもたちを　あやつって
あそぶ　はなしが　おおく　のこる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>星明かりが　輝く　夜に
寝ている　こどもたちを　操って
遊ぶ　話が　多く　残る。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_576_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほしの　うごきから　みらいを　よむ。
トレーナーの　じゅみょうを　しった
ゴチルゼルは　さけび　かなしむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>星の　動きから　未来を　読む。
トレーナーの　寿命を　知った
ゴチルゼルは　叫び　悲しむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_577_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだが　とくしゅな　えきたいに
つつまれているので　どんな　きびしい
じょうきょうでも　へいきなのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体が　特殊な　液体に
包まれているので　どんな　厳しい
状況でも　平気なのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_578_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぶんれつした　２つの　のうみそで
おなじことを　かんがえると　だせる
サイコパワーは　さいこうと　なる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>分裂した　２つの　脳みそで
同じことを　考えると　だせる
サイコパワーは　最高と　なる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_579_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はっきした　サイコパワーを　つかい
とくしゅな　えきたいで　つくられた
うでを　あやつり　いわを　くだく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>発揮した　サイコパワーを　使い
特殊な　液体で　つくられた
腕を　操り　岩を　砕く。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_580_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とぶよりも　およぐのが　とくいで
すいちゅうに　もぐっては　だいすきな
みずゴケを　うれしそうに　たべる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>飛ぶよりも　泳ぐのが　得意で
水中に　潜っては　大好きな
水ゴケを　うれしそうに　食べる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_581_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆうがな　みかけに　よらず
つばさで　ちからづよく　はばたき　
すうせんキロ　とびつづけられる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>優雅な　みかけに　よらず
翼で　力強く　羽ばたき　
数千キロ　飛び続けられる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_582_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あさひを　あびた　つららから
うまれたと　されている　ポケモン。
マイナス５０どの　いきを　はく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>朝日を　浴びた　氷柱から
生まれたと　されている　ポケモン。
マイナス５０度の　息を　吐く。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_583_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたりの　くうきを　ひやして
こおりの　つぶを　はっせい　させて
てきの　からだを　こおりつかせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>辺りの　空気を　冷やして
氷の　粒を　発生　させて
敵の　体を　氷つかせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_584_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいりょうの　みずを　のみこんで
からだのなかで　ゆきぐもに　かえる。
おこると　もうふぶきを　まきおこす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大量の　水を　飲みこんで
体の中で　雪雲に　変える。
怒ると　猛吹雪を　まきおこす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_585_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きせつが　かわったとき　だけでなく
きおんや　しつどに　よっても
からだのいろは　すこし　へんかする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>季節が　変わったとき　だけでなく
気温や　湿度に　よっても
体の色は　少し　変化する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_586_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きせつの　うつりかわりと　ともに
すみかを　かえるので　メブキジカが
はるをはこぶと　いう　ひともいる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>季節の　移り変わりと　ともに
すみかを　変えるので　メブキジカが
春を運ぶと　いう　人もいる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_587_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まくを　ひろげて　そらを　とびつつ
ほほの　でんきぶくろに　ためこんだ
でんきで　あいてを　かんでんさせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>膜を　広げて　空を　飛びつつ
ほほの　電気袋に　ためこんだ
電気で　相手を　感電させる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_588_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チョボマキを　おそっているときに
でんきエネルギーを　あびると
なぜだか　しんか　してしまうのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チョボマキを　襲っているときに
電気エネルギーを　浴びると
なぜだか　進化　してしまうのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_589_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チョボマキから　うばった　カラで
からだを　おおい　ガードしながら
２ほんの　ヤリで　つついてくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チョボマキから　奪った　カラで
体を　覆い　ガードしながら
２本の　ヤリで　突いてくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_590_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モンスターボール　そっくりの
もようで　ポケモンを　さそいこみ
どくのほうしを　ふきかけてくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モンスターボール　そっくりの
模様で　ポケモンを　誘いこみ
毒の胞子を　吹きかけてくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_591_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうての　かさを　うごかし
えものを　さそう　ダンスを　おどる。
じめじめした　ばしょを　このむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両手の　かさを　動かし
獲物を　誘う　ダンスを　踊る。
じめじめした　場所を　好む。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_592_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベールの　ような　てあしを　まきつけ
しびれさせると　８０００メートルの
しんかいに　つれこんで　ころすのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベールの　ような　手足を　巻きつけ
しびれさせると　８０００メートルの
深海に　連れこんで　殺すのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_593_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだの　ほとんどが　かいすい。
かいていには　ブルンゲルが　しずめた
ふねで　できた　しろが　あるという。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体の　ほとんどが　海水。
海底には　ブルンゲルが　沈めた
船で　できた　城が　あるという。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_594_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きずついたり　よわった　ポケモンを
ヒレで　やさしく　かかえながら
とくしゅな　ねんまくで　なおすのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>傷ついたり　弱った　ポケモンを
ヒレで　優しく　抱えながら
特殊な　粘膜で　治すのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_595_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんでは　でんきを　つくれないので
ほかの　おおきな　ポケモンに
とりつき　せいでんきを　すいとる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分では　電気を　つくれないので
他の　大きな　ポケモンに
とりつき　静電気を　吸いとる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_596_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんきを　おびた　いとで　つくる
バリアは　あいてを　しびれさせるので
まもるだけでなく　ぶきにもなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>電気を　帯びた　糸で　つくる
バリアは　相手を　しびれさせるので
守るだけでなく　武器にもなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_597_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほらあなの　てんじょうに　つきささり
いわの　てつぶんを　すいとる。
きけんがせまると　トゲを　うちだす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>洞穴の　天井に　突きささり
岩の　鉄分を　吸いとる。
危険がせまると　トゲを　撃ちだす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_598_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３ぼんの　しょくしゅを　たたきつけ
さらに　トゲを　とばして　あいてを
あとかたのこらず　ふんさいする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３本の　触手を　たたきつけ
さらに　トゲを　飛ばして　相手を
跡形残らず　粉砕する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_599_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かならず　きまった　くみあわせの
２つの　からだを　かいてん　させて
エネルギーを　うみだしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>必ず　決まった　組み合わせの
２つの　体を　回転　させて
エネルギーを　生みだしている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_600_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちびギアと　でかギアに　わかれた。
こうげきのため　とばした　ちびギアが
もどってこないと　しんでしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちびギアと　でかギアに　わかれた。
攻撃のため　飛ばした　ちびギアが
戻ってこないと　死んでしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_601_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちびギアを　こうそくかいてん　させ
あかいコアに　ためた　エネルギーを
ちびギアに　こめて　いっきにはなつ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちびギアを　高速回転　させ
あかいコアに　ためた　エネルギーを
ちびギアに　こめて　一気に放つ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_602_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よわい　でんきしか　だせないので
たくさんの　シビシラスで　あつまり
きょうりょくな　でんきを　はなつ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>弱い　電気しか　だせないので
たくさんの　シビシラスで　集まり
強力な　電気を　放つ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_603_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてに　まきつき　まるい
はんてんから　でんきを　ながして
しびれたところを　まるかじりする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手に　巻きつき　丸い
はん点から　電気を　流して
しびれたところを　まるかじりする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_604_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きゅうばんに　なっている　くちで
はりついて　キバを　さしこみ
きょうりょくな　でんきを　ながす。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>吸盤に　なっている　口で
はりついて　キバを　刺しこみ
強力な　電気を　流す。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_605_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>５０ねんまえ　ＵＦＯが
ついらくしたと　うわさされる
さばくから　やってきたと　いわれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>５０年前　ＵＦＯが
墜落したと　うわさされる
砂漠から　やってきたと　いわれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_606_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆびさきを　てんめつ　させて
かいわするらしいが　その　パターンは
まだ　かいどく　できていない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>指先を　点滅　させて
会話するらしいが　その　パターンは
まだ　解読　できていない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_607_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふだん　ほのおは　きえているが
ひとや　ポケモンの　せいめいりょくを
すいとると　ほのおは　きらめく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>普段　炎は　消えているが
人や　ポケモンの　生命力を
吸いとると　炎は　きらめく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_608_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たましいを　すいとり　ひをともす。
ひとが　しぬのを　まつため
びょういんを　うろつくようになった。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>魂を　吸いとり　火を灯す。
人が　死ぬのを　待つため
病院を　うろつくようになった。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_609_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たましいを　すいとって　もやす。
ほのおを　ゆらして　あいてを
さいみんじょうたいに　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>魂を　吸い取って　燃やす。
腕の　炎を　揺らして
相手を　催眠状態に　する。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_610_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　キバは　まだ　もろく
おれたりするが　はえかわるごとに
かたく　じょうぶに　なっていく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　キバは　まだ　もろく
折れたりするが　生え変わるごとに
硬く　丈夫に　なっていく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_611_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キバは　にどと　はえかわらないので
たたかいおわると　かわらの　いわを
つかって　たんねんに　みがきあげる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キバは　二度と　生え変わらないので
戦い終わると　川原の　岩を
使って　丹念に　磨きあげる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_612_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キバの　はかいりょくは　ばつぐん。
ふとくかたい　こうてつの　はしらも
いとも　かんたんに　きりさけるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キバの　破壊力は　抜群。
太く硬い　鋼鉄の　柱も
いとも　簡単に　切りさけるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_613_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなみずは　けんこうの　バロメータ。
ちょうしが　いいと　ねばりづよくなり
こおりの　わざの　いりょくも　ます。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鼻水は　健康の　バロメータ。
調子が　いいと　粘り強くなり
氷の　技の　威力も　増す。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_614_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きたの　つめたい　うみを　このむ。
くちから　はきだした　いきをこおらせ
うみのうえに　みちをつくり　あるく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>北の　冷たい　海を　好む。
口から　吐きだした　息を凍らせ
海の上に　道をつくり　歩く。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_615_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こおりの　けっしょうで　できた
クサリをつかい　えものを　からめとり
マイナス１００どに　こおらせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>氷の　結晶で　できた
クサリを使い　獲物を　絡め取り
マイナス１００度に　凍らせる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_616_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カブルモと　いっしょに　いるときに
でんきてきな　しげきを　うけると
おたがいの　からだが　しんかする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カブルモと　一緒に　いるときに
電気的な　刺激を　受けると
お互いの　体が　進化する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_617_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からだが　かんそうすると　よわるので
ねんまくで　おおって　まもりつつ
どくえきを　とばして　たたかう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>体が　乾燥すると　弱るので
粘膜で　覆って　守りつつ
毒液を　飛ばして　戦う。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_618_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてが　しびれてくれないときは
よそうがいの　すばやさで　からだを
くねらせ　とびはね　にげるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手が　しびれてくれないときは
予想外の　すばやさで　体を
くねらせ　飛び跳ね　逃げるのだ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_619_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わざをくりだす　スピードが　じまん。
たとえ　パワーは　ひくくても
てかずの　おおさで　カバーする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>技を繰りだす　スピードが　自慢。
たとえ　パワーは　低くても
手数の　多さで　カバーする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_620_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうての　たいもうを　ムチのように
つかいこなし　れんぞくこうげきを
はじめると　だれにも　とめられない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>両手の　体毛を　ムチのように
使いこなし　連続攻撃を
はじめると　だれにも　止められない。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_621_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドリュウズや　イワークが　ほった
せまい　トンネルを　はしりまわって
するどいツメで　えものを　とらえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドリュウズや　イワークが　掘った
狭い　トンネルを　走りまわって
するどいツメで　獲物を　捕らえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_622_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こだいの　かがくりょくに　よって
ねんどから　つくられた　ポケモン。
すうせんねん　うごきつづける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古代の　科学力に　よって
粘土から　つくられた　ポケモン。
数千年　動き続ける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_623_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンや　ひとを　まもるために
こだいじんに　よって　うみだされた。
なぞの　エネルギーで　かつどうする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンや　人を　守るために
古代人に　よって　生みだされた。
なぞの　エネルギーで　活動する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_624_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんが　きずついても　きにせず
しゅうだんで　ぜんしんの　はものを
くいこませ　あいてを　こうげきする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分が　傷ついても　気にせず
集団で　全身の　刃物を
食いこませ　相手を　攻撃する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_625_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すうひきの　コマタナを　たたかわせ
きずつき　うごけなくなった　えものを
まっぷたつにする　こわい　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>数匹の　コマタナを　戦わせ
傷つき　動けなくなった　獲物を
まっぷたつにする　怖い　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_626_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みさかいなく　とっしん　しており
かれらの　テリトリーに　はいると
れっしゃでも　ふきとばされてしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>見境なく　突進　しており
かれらの　テリトリーに　はいると
列車でも　吹き飛ばされてしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_627_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　あいてに　たちむかうのは
ゆうかん　ではなく　むぼうだから。
でも　そうして　きたえ　つよくなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　相手に　立ち向かうのは
勇敢　ではなく　無謀だから。
でも　そうして　鍛え　強くなる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_628_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なかまの　ためなら　どれだけ
きずつこうとも　たたかいを　やめない
ゆうかんな　おおぞらの　せんし。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仲間の　ためなら　どれだけ
傷つこうとも　戦いを　やめない
勇敢な　大空の　戦士。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_629_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つばさは　ちいさく　まだ　とべない。
バルジーナが　あつめてきた
ガイコツで　おしりを　まもっている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>翼は　小さく　まだ　飛べない。
バルジーナが　集めてきた
ガイコツで　おしりを　守っている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_630_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおぞらで　えんをえがきつつ　とび
えものを　みつけると　おそいかかって
すまで　かるがると　はこんでいく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大空で　円を描きつつ　飛び
獲物を　みつけると　遅いかかって
巣まで　軽々と　運んでいく。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_631_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シッポから　とりこんだ　くうきを
ほのおにかえて　ベロのように　つかい
アイアントを　とかして　たべるぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シッポから　取りこんだ　空気を
炎に変えて　ベロのように　使い
アイアントを　溶かして　食べるぞ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_632_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんてきの　クイタランに　たいして
みんなで　やくわりぶんたん　しながら　
はんげきして　すから　おいはらう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>天敵の　クイタランに　対して
みんなで　役割分担　しながら　
反撃して　巣から　追い払う。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_633_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まわりの　ようすが　わからないので
てあたりしだいに　ぶつかっては
うごくものに　かみつき　たべまくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>周りの　様子が　わからないので
手当り次第に　ぶつかっては
動くものに　かみつき　食べまくる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_634_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２つの　あたまは　なかが　わるく
あいてより　おおく　たべることで
しゅどうけんを　にぎろうと　する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２つの　頭は　仲が　悪く
相手より　多く　食べることで
主導権を　握ろうと　する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_635_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うごく　ものに　はんのうして
おそいかかり　３つの　あたまで
くらいつくす　おそろしい　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>動く　ものに　反応して
襲いかかり　３つの　頭で
食らい尽くす　恐ろしい　ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_636_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいようから　うまれたと　いわれる。
しんかするとき　ツノから　ふきだした
ほのおで　ぜんしんを　つつみこむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太陽から　生まれたと　いわれる。
進化するとき　ツノから　吹きだした
炎で　全身を　包みこむ。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_637_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいようの　けしんと　される。
さむさが　きびしい　ふゆに　あらわれ
ふるえる　ポケモンたちを　すくった。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太陽の　化身と　される。
寒さが　厳しい　冬に　現われ
震える　ポケモンたちを　救った。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_638_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はがねの　こころと　からだを　もつ。
ひとが　ポケモンを　きずつけたとき
なかまとともに　ひとを　こらしめた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鋼の　心と　体を　持つ。
人が　ポケモンを　傷つけたとき
仲間とともに　人を　こらしめた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_639_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんせつで　かたられる　ポケモン。
ポケモンを　まもるため　じまんの
パワーで　しろを　こわした。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伝説で　語れられる　ポケモン。
ポケモンを　守るため　自慢の
パワーで　城を　壊した。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_640_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばやい　みのこなしで　あいてを
ほんろうして　ポケモンを　まもると
でんせつで　つたえられている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すばやい　身のこなしで　相手を
ほんろうして　ポケモンを　守ると
伝説で　伝えられている。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_641_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しほうはっぽうを　とびまわる。
このときに　だす　かぜは　つよすぎて
どんなものでも　ふきとばしてしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>四方八方を　飛びまわる。
このときに　だす　風は　強すぎて
どんなものでも　吹きとばしてしまう。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_642_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおぞらを　とびまわりながら
あちこちに　カミナリを　おとして
やまかじを　おこすので　きらわれる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大空を　飛びまわりながら
あちこちに　カミナリを　落として
山火事を　起こすので　嫌われる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_643_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほのおで　せかいを　もやしつくせる
でんせつの　ポケモン。しんじつの
せかいを　きずく　ひとを　たすける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>炎で　世界を　燃やし尽くせる
伝説の　ポケモン。真実の
世界を　築く　人を　たすける。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T08:54:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_644_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いなずまで　せかいを　やきつくせる
でんせつの　ポケモン。りそうの
せかいを　つくる　ひとを　ほさする。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>稲妻で　世界を　焼き尽くせる
伝説の　ポケモン。理想の
世界を　つくる　人を　補佐する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_645_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かぜや　かみなりを　とりこみ　かえた
エネルギーが　つちに　えいようを
あたえて　だいちを　ゆたかに　する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>風や　雷を　取りこみ　変えた
エネルギーが　土に　栄養を
与えて　大地を　豊かに　する。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_646_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うしなった　からだを　しんじつと
りそうで　うめてくれる　えいゆうを
まつ　こおりの　でんせつポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>失った　体を　真実と
理想で　埋めてくれる　英雄を
待つ　氷の　伝説ポケモン。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2012-01-16T06:08:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_647_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かくごを　きめることで　ぜんしんに
ちからが　みなぎって　すばやくなり
とびはねると　ざんぞうが　みえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>覚悟を　決めることで　全身に
力が　みなぎって　すばやくなり
飛び跳ねると　残像が　みえる。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_648_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メロエッタの　かなでる　せんりつは
まわりの　ポケモンを　よこばせたり
かなしませるほどの　パワーがある。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メロエッタの　奏でる　旋律は
周りの　ポケモンを　喜ばたり
悲しませるほどの　パワーがある。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_649_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３おくねんまえに　いた　ポケモン。
プラズマだんに　かいぞう　され
せなかに　ほうだいを　つけられた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３億年前に　いた　ポケモン。
プラズマ団に　改造　され
背中に　砲台を　つけられた。</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nishino:W00221"
				Time="2011-12-26T09:03:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_650_000"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text />
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text />
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_01_201_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１ぴきで　いても　なにも　おきないが
２ひき　いじょうで　ならぶと
なにかの　ちからが　めばえるという。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T03:31:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
