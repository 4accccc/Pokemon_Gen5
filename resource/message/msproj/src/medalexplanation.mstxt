				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_EXP_FIELD_006"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュの　だいちを　２０００かい
ふみしめた　そこそこの
けんきゃくを　たたえる　メダル。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッシュの　大地を　２０００回
踏みしめた　そこそこの
健脚を　称える　メダル。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
