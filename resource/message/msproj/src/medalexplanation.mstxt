	<TextRow
		Label="MDL_EXP_BATTLE_046"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２０にんの　トレーナーを
むげんダンジョンで　たおした
やや　つよい　あかしの　メダル。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
