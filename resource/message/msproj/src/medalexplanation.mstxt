			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_EXP_FIELD_042"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュちほうの　すべての　はしに
もれなく　おとずれた
はしずきの　ための　メダル。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッシュ地方の　すべての　橋に
もれなく　訪れた
橋好きの　ための　メダル。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
