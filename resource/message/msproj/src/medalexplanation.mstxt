	<TextRow
		Label="MDL_EXP_APPLICATION_019"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぐるぐるこうかんで　たくさん　あそび
タマゴを　とりかえっこした
ワクワクかんの　あかしの　メダル。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぐるぐる交換で　たくさん　遊び
タマゴを　取りかえっこした
ワクワク感の　証しの　メダル。</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-12T14:08:08" />
			<Status>Editing</Status>
