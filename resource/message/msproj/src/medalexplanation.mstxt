				Time="2011-10-12T14:08:08" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MDL_EXP_FIELD_076"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めったに　みることが　できない
ダイヤモンドダストを　みた
しょうめいの　メダル。</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-25T06:15:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-25T06:15:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>めったに　見ることが　できない
ダイヤモンドダストを　見た
証明 の　メダル。</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-25T06:15:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-25T06:15:29" />
		</LanguageCell>
		<AttributeCell
