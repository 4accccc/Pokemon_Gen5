			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="str_topic_6_caption"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みんなが　どんな　しゅみを
もっているのか　ちょうさします</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みんながどんな趣味を
持っているのか調査します</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
