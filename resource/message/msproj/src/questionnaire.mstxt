	<TextRow
		Label="str_topic_0_caption"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ブラック２・ホワイト２を
どのように　あそんでいるか　ちょうさします</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ブラック２・ホワイト２を
どのように遊んでいるか調査します</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="str_topic_1_caption"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　まわりには　どんなひとが
おおいのか　ちょうさします</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の周りには　どんな人が
多いのか調査をします</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="str_topic_2_caption"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　すきな　ポケモンで
どんな　あそびをしてるのか　ちょうさします</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の好きなポケモンで
どんな　遊びをしてるのか　調査します</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="str_topic_3_caption"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　りそうや　みんなの　たいせつに
しているものを　ちょうさします</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の理想や　みんなの大切に
しているものを　調査します</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="str_topic_4_caption"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　ひとが　すきなのか
その　けいこうを　ちょうさします</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんな人が好きなのか
その傾向を調査します</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="str_topic_5_caption"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みんなの　しょうらいの　もくひょうや
なりたいものを　ちょうさします</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みんなの　将来の目標や
なりたいものを調査します</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-13T10:20:29" />
