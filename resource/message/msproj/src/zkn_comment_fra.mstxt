			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_057"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il grogne quand on le toise,
rugit quand on s'enfuit et devient
fou de rage quand on le frappe.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
