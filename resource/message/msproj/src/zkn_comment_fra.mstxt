				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イルミーゼ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_315"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Plus le ROSELIA est en bonne santé
et plus son parfum est agréable et
relaxant pour son entourage.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Plus le ROSELIA est en bonne santé
et plus son parfum est agréable et
relaxant pour son entourage.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
