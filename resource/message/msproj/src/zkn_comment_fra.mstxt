		<CommentCell
			Language="JPN">
			<Comment>マイナン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_313"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il communique avec ses pairs en
allumant son postérieur la nuit. Il
adore le doux parfum de LUMIVOLE.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il communique avec ses pairs en
allumant son postérieur la nuit. Il
adore le doux parfum de LUMIVOLE.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
