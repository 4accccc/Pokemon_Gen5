	<TextRow
		Label="ZKN_COMMENT_FRA_00_492"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Les fleurs qui couvrent son corps
s'ouvrent quand il est câliné avec
amour et perçoit de la gratitude.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
