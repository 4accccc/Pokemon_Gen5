			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_270"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il ressemble à une plante aquatique
et fait la navette pour les
Pokémon qui ne savent pas nager.</Text>
