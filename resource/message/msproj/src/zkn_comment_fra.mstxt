	<TextRow
		Label="ZKN_COMMENT_FRA_00_491"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Menacé, ce Pokémon se protège
en créant des cauchemars dans
l'esprit de ses ennemis.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
