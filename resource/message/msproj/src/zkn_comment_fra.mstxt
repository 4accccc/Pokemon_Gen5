			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_058"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Un Pokémon très loyal. Il
restera immobile jusqu'à ce que
son Dresseur lui donne un ordre.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
