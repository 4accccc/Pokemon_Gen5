			<Comment>レジロック</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_378"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Son corps est fait de glace datant
de l'ère glaciaire. Il contrôle un
air gelé de -200 °C.</Text>
