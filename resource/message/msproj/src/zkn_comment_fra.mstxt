	<TextRow
		Label="ZKN_COMMENT_FRA_00_266"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il attend d'évoluer dans son cocon
de soie accroché aux branches et
se nourrit d'eau de pluie.</Text>
