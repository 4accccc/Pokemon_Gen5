		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ゴローン
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_076"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Aucun explosif ne pourrait entamer
sa carapace de pierre. Il mue une
fois par an.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Aucun explosif ne pourrait entamer
sa carapace de pierre. Il mue une
fois par an.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
