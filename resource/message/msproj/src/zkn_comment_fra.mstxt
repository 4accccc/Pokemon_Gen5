	<TextRow
		Label="ZKN_COMMENT_FRA_00_485"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Son corps est composé d'acier brut
dont certaines parties ont fondu
à cause de sa propre chaleur.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
