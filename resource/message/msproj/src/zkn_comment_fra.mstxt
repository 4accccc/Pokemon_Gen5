	<TextRow
		Label="ZKN_COMMENT_FRA_00_488"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Les nuits où le premier croissant
de lune est visible, l'arc de sa
queue se déploie de façon superbe.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
