				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ヨーギラス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_247"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Son corps est dur comme la pierre
souterraine. Il file comme une
fusée en expulsant des gaz.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Son corps est dur comme la pierre
souterraine. Il file comme une
fusée en expulsant des gaz.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>サナギラス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_248"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Lorsqu'il est en colère, il abat des
montagnes et enterre des fleuves.
On doit alors modifier les cartes.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Lorsqu'il est en colère, il abat des
montagnes et enterre des fleuves.
On doit alors modifier les cartes.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>バンギラス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_249"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il dort dans une faille des grands
fonds. Ses battements d'ailes
génèrent une tempête de 40 jours.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il dort dans une faille des grands
fonds. Ses battements d'ailes
génèrent une tempête de 40 jours.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ルギア</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_250"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ses plumes possèdent sept 
couleurs. On prétend que sa vue
apporte la joie éternelle.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ses plumes possèdent sept 
couleurs. On prétend que sa vue
apporte la joie éternelle.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ホウオウ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_251"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il a le pouvoir de voyager dans le
temps. Cependant, on dit qu'il
n'apparaît qu'en temps de paix.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il a le pouvoir de voyager dans le
temps. Cependant, on dit qu'il
n'apparaît qu'en temps de paix.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>セレビィ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_252"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ses plantes de pieds sont
couvertes d'épines lui permettant
de marcher au mur et au plafond.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ses plantes de pieds sont
couvertes d'épines lui permettant
de marcher au mur et au plafond.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>キモリ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_253"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il vit dans les jungles denses. 
Il saute de branche en branche
pour approcher de sa proie.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il vit dans les jungles denses. 
Il saute de branche en branche
pour approcher de sa proie.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ジュプトル</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_254"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Les feuilles sur ses bras peuvent
trancher des troncs épais. C'est
le meilleur combattant des jungles.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Les feuilles sur ses bras peuvent
trancher des troncs épais. C'est
le meilleur combattant des jungles.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ジュカイン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_255"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ses câlins réchauffent car il
renferme une fournaise. Il envoie
des boules de feu à 1 000 °C.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ses câlins réchauffent car il
renferme une fournaise. Il envoie
des boules de feu à 1 000 °C.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>アチャモ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_256"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ce maître du coup de pied peut
donner 10 coups par seconde. Ses
cris aigus intimident l'ennemi.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ce maître du coup de pied peut
donner 10 coups par seconde. Ses
cris aigus intimident l'ennemi.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ワカシャモ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_257"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Des flammes fusent de ses
poignets et ses coups brûlent
l'ennemi.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
