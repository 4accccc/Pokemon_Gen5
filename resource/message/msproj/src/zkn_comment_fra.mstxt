				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ロゼリア
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_316"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il est principalement composé d'un
estomac dont les sucs digestifs
dissolvent tout ce qu'il avale.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il est principalement composé d'un
estomac dont les sucs digestifs
dissolvent tout ce qu'il avale.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ゴクリン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_317"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il avale tout en une bouchée. Ses
follicules sécrètent des fluides
toxiques qui endorment l'ennemi.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il avale tout en une bouchée. Ses
follicules sécrètent des fluides
toxiques qui endorment l'ennemi.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>マルノーム</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_318"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il attaque en banc quand on
menace son territoire. Ses dents
aiguisées peuvent couler un navire.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il attaque en banc quand on
menace son territoire. Ses dents
aiguisées peuvent couler un navire.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>キバニア</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_319"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ses crocs lacèrent des feuilles
d'acier. Il nage à 120 km/h. On
l'appelle “tyran des mers".</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ses crocs lacèrent des feuilles
d'acier. Il nage à 120 km/h. On
l'appelle “tyran des mers".</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>サメハダー</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff00</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_320"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Par beau temps, il se pose sur les
plages pour jouer et rebondir. Il
expulse de l'eau par son évent.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Par beau temps, il se pose sur les
plages pour jouer et rebondir. Il
expulse de l'eau par son évent.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ホエルコ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_321"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Le plus grand des Pokémon. Il peut
plonger à une profondeur de 
3 000 m en retenant son souffle.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Le plus grand des Pokémon. Il peut
plonger à une profondeur de 
3 000 m en retenant son souffle.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ホエルオー</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_322"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Son dos bossu renferme une lave
bouillonnante. Elle refroidit par 
temps de pluie, ce qui le ralentit.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Son dos bossu renferme une lave
bouillonnante. Elle refroidit par 
temps de pluie, ce qui le ralentit.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ドンメル</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_323"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il porte des volcans sur son dos.
Quand le magma remonte, il
frissonne et entre en éruption.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il porte des volcans sur son dos.
Quand le magma remonte, il
frissonne et entre en éruption.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>バクーダ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_324"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il tire son énergie du charbon qu'il
brûle dans sa carapace et crache
de la suie noire en cas de danger.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il tire son énergie du charbon qu'il
brûle dans sa carapace et crache
de la suie noire en cas de danger.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>コータス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_325"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il utilise sa queue comme un 
ressort et bondit partout. Chaque
nouveau choc fait battre son cœur.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il utilise sa queue comme un 
ressort et bondit partout. Chaque
nouveau choc fait battre son cœur.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
