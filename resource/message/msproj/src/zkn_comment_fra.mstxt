	<TextRow
		Label="ZKN_COMMENT_FRA_00_267"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Malgré les apparences, il est très
agressif et attaque avec sa trompe
quand on le dérange.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
