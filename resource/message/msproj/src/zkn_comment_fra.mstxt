			<Comment>ソルロック</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_339"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Son corps glissant est difficile à
attraper. On dit qu'il a été créé
dans de la boue solidifiée.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Son corps glissant est difficile à
attraper. On dit qu'il a été créé
dans de la boue solidifiée.</Text>
