	<TextRow
		Label="ZKN_COMMENT_FRA_00_490"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il est né avec le pouvoir incroyable
de créer des liens avec n'importe
quel Pokémon.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
