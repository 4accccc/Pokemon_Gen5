			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_269"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il disperse un nuage de poudre
toxique à chaque coup d'aile. Il
aime les feuilles d'arbres urbains.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
