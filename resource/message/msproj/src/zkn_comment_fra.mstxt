			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_071"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Sa bouche sécrète un fluide à
l'odeur de miel, qui s'avère être
un acide extrêmement corrosif.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
