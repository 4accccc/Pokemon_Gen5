			<Comment>ニョロボン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_063"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>L'utilisation de ses pouvoirs
mentaux le fatigue tellement
qu'il dort 18 heures par jour.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
