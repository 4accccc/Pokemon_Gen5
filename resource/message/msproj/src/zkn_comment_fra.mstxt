				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ライボルト</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_FRA_00_311"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il absorbe l'énergie des poteaux
électriques et encourage ses amis
avec des pompons d'étincelles. </Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il absorbe l'énergie des poteaux
électriques et encourage ses amis
avec des pompons d'étincelles. </Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
