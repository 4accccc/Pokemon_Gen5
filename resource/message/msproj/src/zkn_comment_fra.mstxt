	<TextRow
		Label="ZKN_COMMENT_FRA_00_263"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il marche en zigzaguant et n'a
pas son pareil pour trouver des
objets dans l'herbe ou sous terre.</Text>
