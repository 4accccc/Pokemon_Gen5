	<TextRow
		Label="msg_sys_gpower_use00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:Undefined Idx="1"]を
つかいますか？
ひつよう　[Digit:3digits Idx="2"]こ／もってる　[Digit:3digits Idx="3"]こ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:Undefined Idx="1"]を
使いますか？
必要　[Digit:3digits Idx="2"]個／持ってる　[Digit:3digits Idx="3"]個</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>1：デルパワー名
2：消費するアイテム数(1-999)
3：もっているアイテム数(1-999)</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
