	<TextRow
		Label="MSG_MB_CHILD_SEL_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンを　６ひき　えらんで
タッチペンをつかって　みぎのわくに
スライドさせて　ください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
