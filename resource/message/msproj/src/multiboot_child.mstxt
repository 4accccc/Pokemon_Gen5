<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="MSG_MB_CHILD_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ロードしています
しばらく　おまちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ロードしています
しばらく　お待ちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>このタイミングで
漢字対応はできないため、
必ずひらがなを表示になります</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_CHILD_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ただしい　ソフトが　ささっていません
でんげんをきり　ただしい　ソフトを
さしてから　ポケシフターを
きどうしなおして　ください▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正しい　ソフトが　ささっていません
電源を切り　正しい　ソフトを
さしてから　ポケシフターを
起動し直してください▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>06
メッセージを調整</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_CHILD_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケシフター　きどうちゅう……
まもなく　はじまります</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケシフター　起動中……
まもなく　始まります</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_CHILD_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レポートに　かきこんでいます
でんげんを　きらないでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レポートに　書き込んでいます
電源を　切らないでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
