			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="BI_BattleRecorderChapterSkip"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>スキップ　しています！
しばらく　おまちください</Text>
