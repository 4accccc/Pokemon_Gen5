	<TextRow
		Label="BI_BattleRecorderChaptetKey"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちじ　ていしちゅう……
しばらく　おまちください！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
