				Time="2011-05-20T09:30:20" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="BI_BattleRecorderStopBreak"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プレイデータが　こわれて　いるので
さいせいを　ちゅうだん　します！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プレイデータが　壊れているので
再生を　中断します！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
