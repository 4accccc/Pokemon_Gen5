				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_208"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　もたせると
こうかばつぐんの　わざを
うけたとき　ＨＰを　かいふくする。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　持たせると
効果バツグンの　技を
受けたとき　ＨＰを　回復する。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_209"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　もたせると
ピンチのとき　いちどだけ
わざの　めいちゅうりつが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　持たせると
ピンチのとき　１度だけ
技の　命中率が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_210"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　もたせると
ピンチのとき　いちどだけ
こうどうが　はやくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　持たせると
ピンチのとき　１度だけ
行動が　早くなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_211"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　もたせると
ぶつりわざを　うけたとき
あいてにも　ダメージを　あたえる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　持たせると
物理技を　受けたとき
相手にも　ダメージを　あたえる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_212"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　もたせると
とくしゅわざを　うけたとき
あいてにも　ダメージを　あたえる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　持たせると
特殊技を　受けたとき
相手にも　ダメージを　あたえる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_213"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キラキラ　ひかるこな。　もたせると
ひかりが　あいてを　まどわして
わざが　めいちゅう　しにくくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キラキラ　光る粉。　持たせると
光が　相手を　惑わして
技が　命中しにくくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_214"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせた　ポケモンの　のうりょくが
さがったとき　いちどだけ　もとの
じょうたいに　もどす。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせた　ポケモンの　能力が
さがったとき　１度だけ　もとの
状態に　もどす。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_215"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かたくて　おもい　ギプス。
もたせると　すばやさは　さがるが
ふつうより　つよく　そだちやすい。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>硬くて　重い　ギプス。
持たせると　素早さは　さがるが
ふつうより　強く　育ちやすい。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_216"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせた　ポケモンは　せんとうに
でなくても　けいけんちを
わけてもらえる　べんりな　そうち。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせた　ポケモンは　戦闘に
でなくても　経験値を
わけてもらえる　便利な　装置。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_217"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かるくて　するどい　ツメ。
もたせると　あいてより　さきに
こうどう　できることが　ある。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>軽くて　鋭い　ツメ。
持たせると　相手より　先に
行動できることが　ある。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_218"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここちよい　ねいろの　すず。
もたせた　ポケモンは　こころが
やすらぎ　なつきやすくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>心地よい　音色の　鈴。
持たせた　ポケモンは　こころが
やすらぎ　なつきやすくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_219"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせた　ポケモンが　じゆうに
わざを　だせなくなったときに
いちどだけ　かいふくする。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせた　ポケモンが　自由に
技を　だせなくなったときに
１度だけ　回復する。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_220"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっと　こだわった　ハチマキ。
もたせると　こうげきは　あがるが
おなじ　わざしか　だせなくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちょっと　こだわった　ハチマキ。
持たせると　攻撃は　あがるが
同じ　技しか　だせなくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_221"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせると　こうげきして
ダメージを　あたえたときに
あいてを　ひるませることが　ある。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせると　攻撃して
ダメージを　あたえたときに
相手を　ひるませることが　ある。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_222"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぎんいろに　かがやく　こな。
もたせると　むしタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>銀色に　輝く　粉。
持たせると　むしタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_223"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせた　ポケモンが　いちどでも
せんとうに　かおを　だすと
おかねが　２ばい　もらえる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせた　ポケモンが　１度でも
戦闘に　顔を　だすと
お金が　２倍　もらえる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_224"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちばん　まえの　ポケモンに
もたせると　やせいポケモンが
でて　きにくくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１番　前の　ポケモンに
持たせると　野生ポケモンが
でて　きにくくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_225"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ラティオス　または　ラティアスに
もたせると　とくこうと　とくぼうが
あがる　ふしぎな　たま。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ラティオス　または　ラティアスに
持たせると　特攻と　特防が
あがる　不思議な　珠。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_226"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パールルに　もたせると
とくこうが　あがる　キバ。
するどく　ぎんいろに　ひかる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パールルに　持たせると
特攻が　あがる　キバ。
鋭く　銀色に　光る。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_227"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パールルに　もたせると
とくぼうが　あがる　ウロコ。
うすい　ピンクいろに　ひかる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パールルに　持たせると
特防が　あがる　ウロコ。
うすい　ピンク色に　光る。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_228"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせた　ポケモンは　やせいの
ポケモンとの　せんとうから
ぜったいに　にげられる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせた　ポケモンは　野生の
ポケモンとの　戦闘から
絶対に　逃げられる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_229"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　もたせると
そのあいだ　しんか　しなくなる
ふしぎな　いし。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　持たせると
そのあいだ　進化しなくなる
不思議な　石。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_230"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせると　ひんしに　なりそうな
わざを　うけても　ＨＰを　１だけ
のこして　たえることが　ある。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせると　ひんしに　なりそうな
技を　受けても　ＨＰを　１だけ
残して　耐えることが　ある。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_231"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しあわせが　つまった　タマゴ。
もたせた　ポケモンは　もらえる
けいけんちが　すこし　ふえる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しあわせが　つまった　タマゴ。
持たせた　ポケモンは　もらえる
経験値が　少し　ふえる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_232"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃくてんが　みえる　レンズ。
もたせた　ポケモンの　わざが
きゅうしょに　あたりやすくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>弱点が　みえる　レンズ。
持たせた　ポケモンの　技が
急所に　当たりやすくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_233"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とくしゅな　きんぞくの　まく。
もたせると　はがねタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>特殊な　金属の　膜。
持たせると　はがねタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_234"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせると　ポケモンの　ＨＰが
せんとうの　あいだ　すこしずつ
かいふくする。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせると　ポケモンの　ＨＰが
戦闘の　あいだ　少しずつ
回復する。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_235"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かたくて　じょうぶな　ウロコ。
ドラゴンタイプの　ポケモンが
もっていることが　ある。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>硬くて　丈夫な　ウロコ。
ドラゴンタイプの　ポケモンが
持っていることが　ある。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_236"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ピカチュウに　もたせると
こうげきと　とくこうの　いりょくが
あがる　ふしぎな　たま。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ピカチュウに　持たせると
攻撃と　特攻の　威力が
あがる　不思議な　玉。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_237"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さわると　サラサラする　すな。
もたせると　じめんタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さわると　サラサラする　砂。
持たせると　じめんタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_238"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜったいに　われない　いし。
もたせると　いわタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>絶対に　割れない　石。
持たせると　いわタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_239"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せいめいが　やどる　タネ。
もたせると　くさタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生命が　宿る　タネ。
持たせると　くさタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_240"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あやしく　みえる　メガネ。
もたせると　あくタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怪しく　みえる　メガネ。
持たせると　あくタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_241"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きが　ひきしまる　おび。
もたせると　かくとうタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気が　ひきしまる　帯。
持たせると　かくとうタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_242"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうりょくな　じしゃく。
もたせると　でんきタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強力な　磁石。
持たせると　でんきタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_243"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しずくの　かたちの　ほうせき。
もたせると　みずタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しずくの　形の　宝石。
持たせると　みずタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_244"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながく　とがった　くちばし。
もたせると　ひこうタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長く　とがった　くちばし。
持たせると　ひこうタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_245"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どくのある　ちいさな　ハリ。
もたせると　どくタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どくのある　ちいさな　ハリ。
持たせると　どくタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_246"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねつを　よせつけない　こおり。
もたせると　こおりタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>熱を　よせつけない　氷。
持たせると　こおりタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_247"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あやしくて　ぶきみな　おふだ。
もたせると　ゴーストタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>怪しくて　不気味な　お札。
持たせると　ゴーストタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_248"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねんりきを　こめた　スプーン。
もたせると　エスパータイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>念力を　こめた　スプーン。
持たせると　エスパータイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_249"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ものを　もやす　ねんりょう。
もたせると　ほのおタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ものを　燃やす　燃料。
持たせると　ほのおタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_250"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かたくて　するどい　キバ。
もたせると　ドラゴンタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>硬くて　鋭い　キバ。
持たせると　ドラゴンタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_251"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はだざわりの　よい　スカーフ。
もたせると　ノーマルタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はだざわりの　よい　スカーフ。
持たせると　ノーマルタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_252"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なかに　いろんな　じょうほうが
つまった　とうめいな　きかい。
シルフ　カンパニーせい。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>中に　いろんな　情報が
つまった　透明な　機械。
シルフ　カンパニー製。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_253"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせた　ポケモンが　こうげきして
あいてに　ダメージを　あたえたとき
ＨＰを　すこし　かいふく　できる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせた　ポケモンが　攻撃して
相手に　ダメージを　あたえたとき
ＨＰを　少し　回復できる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_254"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふしぎな　かおりの　おこう。
もたせると　みずタイプの
わざの　いりょくが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不思議な　香りの　御香。
持たせると　みずタイプの
技の　威力が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_255"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせると　おこうの　ふしぎな
かおりが　あいてを　まどわせて
わざが　めいちゅう　しにくくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせると　御香の　不思議な
香りが　相手を　まどわせて
技が　命中　しにくくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_256"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こううんを　よぶ　グローブ。
ラッキーに　もたせると　わざが
きゅうしょに　あたりやすくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>幸運を　よぶ　グローブ。
ラッキーに　持たせると　技が
急所に　当たりやすくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_257"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メタモンに　もたせると　ぼうぎょが
あがる　ふしぎなこな。
とても　こまかくて　かたい。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メタモンに　持たせると　防御が
あがる　不思議な粉。
とても　こまかくて　硬い。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_258"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにかの　かたい　ホネ。
カラカラ　または　ガラガラに
もたせると　こうげきが　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なにかの　硬い　ホネ。
カラカラ　または　ガラガラに
持たせると　攻撃が　あがる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_259"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とても　ながくて　かたい　クキ。
カモネギに　もたせると　わざが
きゅうしょに　あたりやすくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とても　長くて　硬い　クキ。
カモネギに　持たせると　技が
急所に　当たりやすくなる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_260"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせて　コンテストに　さんかすると
その　ポケモンは　いつもより
かっこよく　みられる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>持たせて　コンテストに　参加すると
その　ポケモンは　いつもより
かっこよく　みられる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_261"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もたせて　コンテストに　さんかすると
その　ポケモンは　いつもより
うつくしく　みられる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
