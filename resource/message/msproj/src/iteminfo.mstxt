				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_094"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くさむらや　どうくつ　などで
つかうと　あまいにおいに　さそわれて
やせいポケモンが　あらわれる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>草むらや　どうくつ　などで
使うと　あまいにおいに　誘われて
野生ポケモンが　あらわれる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_095"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きのみを　そだてる　ちほうでは
ふかふかのつちに　まいて　つかう。
マニアが　たかく　かってくれる。</Text>
