	<TextRow
		Label="ITEMINFO_501"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼうけんちゅうに　さつえいした
きねんしゃしんを　かざる　アルバム。
</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
