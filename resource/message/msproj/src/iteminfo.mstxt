			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_462"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンウォッチ　ちぢめて
ポケッチを　もらうために　ひつような
ひきかえけん。　３まい　ひつよう。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
