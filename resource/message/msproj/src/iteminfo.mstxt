	<TextRow
		Label="ITEMINFO_611"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つかうと　みかたの　ポケモンの
とくせいを　はつどう　させる。
</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>使うと　味方の　ポケモンの
特性を　発動させる。
</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
