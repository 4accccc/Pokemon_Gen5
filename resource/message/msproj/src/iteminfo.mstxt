				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_572"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおむかし　うみに　すんでいた
こだい　ポケモンの　カセキ。
せなかの　いちぶ　らしい。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大昔　海に　すんでいた
古代ポケモンの　カセキ。
せなかの　一部らしい。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_573"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とりポケモンの　そせんと　いわれる
こだい　ポケモンの　カセキ。
つばさの　いちぶ　らしい。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とりポケモンの　祖先と　いわれる
古代ポケモンの　カセキ。
つばさの　一部らしい。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_574"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リバティガーデンとうに　いくための
とくべつな　チケット。
ヒウンシティから　ふねに　のれる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リバティガーデン島に　行くための
特別な　チケット。
ヒウンシティから　船に　乗れる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_575"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>デルパワーを　はっせいさせる
ときにつかう　イッシュの　パワーが
とじこめられた　ふしぎな　たま。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>デルパワーを　発生させる
ときに使う　イッシュの　パワーが
とじこめられた　不思議な　玉。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_576"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハイリンクのもりで　いつのまにか
バッグに　あらわれる　ゆめのボール。
どんな　ポケモンも　つかまえられる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハイリンクの森で　いつのまにか
バッグに　現れる　夢のボール。
どんな　ポケモンも　捕まえられる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_577"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　きを　ひかせる　どうぐ。
やせいポケモンとの　せんとうから
ぜったいに　にげられる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンの　気を　ひかせる　道具。
野生ポケモンとの　戦闘から
絶対に　逃げられる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_578"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミュージカルで　ポケモンに　つける
いろとりどりの　グッズを　たくさん
しまえる　きれいで　すてきなケース。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミュージカルで　ポケモンに　つける
いろとりどりの　グッズを　たくさん
収納する　きれいで　すてきなケース。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_579"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あれくるう　うみを　ものともせず
じゆうに　とびまわっていたと　される
ポケモンの　あたまの　ホネ。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>荒れ狂う　海を　ものともせず
自由に　とびまわっていたと　される
ポケモンの　頭の　ホネ。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_580"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたりいったいに　いい　かおりが
ひろがる　めずらしい　キノコ。
マニアが　たかく　かってくれる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたりいったいに　いい　香りが
ひろがる　珍しい　キノコ。
マニアが　高く　買ってくれる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_581"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キラキラと　きんいろに　ひかる
じゅんきんせいの　おおきな　たま。
マニアが　たかく　かってくれる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キラキラと　金色に　光る
純金製の　おおきな　玉。
マニアが　高く　買ってくれる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_582"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きれいな　ぎんいろに　ひかる
とても　おおつぶの　しんじゅ。
マニアが　たかく　かってくれる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きれいな　銀色に　光る
とても　大粒の　真珠。
マニアが　高く　買ってくれる。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
