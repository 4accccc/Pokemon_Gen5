	<TextRow
		Label="ITEMINFO_011"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つかまえた　やせいポケモンが
とても　なつきやすくなる
いごこちの　いい　ボール。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>捕まえた　野生ポケモンが
とても　なつきやすくなる
いごこちの　いい　ボール。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
