				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_087"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　めずらしい　キノコ。
いちぶの　マニアの　あいだでは
とても　にんきが　たかい。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おおきな　珍しい　キノコ。
一部の　マニアの　あいだでは
とても　人気が　高い。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
