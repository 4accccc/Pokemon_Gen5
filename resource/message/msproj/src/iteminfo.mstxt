			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_013"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よるや　どうくつなど　くらいところで
ポケモンが　つかまえやすくなる
ちょっと　かわった　ボール。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夜や　どうくつなど　暗いところで
ポケモンが　捕まえやすくなる
ちょっと　変わった　ボール。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="ITEMINFO_014"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つかまえた　ポケモンの　ＨＰと
じょうたい　いじょうを　かいふくする
ちょっと　やさしい　ボール。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>捕まえた　ポケモンの　ＨＰと
状態異常を　回復する
ちょっと　やさしい　ボール。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
