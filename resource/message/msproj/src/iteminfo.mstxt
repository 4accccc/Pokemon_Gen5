	<TextRow
		Label="ITEMINFO_627"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かくとくした　メダルを　しゅうのうし
メダルに　かんけいのある　じょうほうを
きろくする　べんりな　どうぐ。</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
