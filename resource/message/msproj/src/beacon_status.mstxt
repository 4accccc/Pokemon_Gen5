	<TextRow
		Label="msg_beacon_050"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アクションIDと並びを同一にするための
ダミーメッセージです</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
