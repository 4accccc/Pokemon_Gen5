			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="DATACONV_STR_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>データコンバートを
キャンセル　しました▽
しゅうりょう　します▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:20:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>データコンバートを
キャンセル　しました▽
終了します▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:20:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
