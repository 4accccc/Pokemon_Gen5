	<TextRow
		Label="DATACONV_STR_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おもいでリンク　きどうちゅう！
しばらく　おまちください</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00293"
				Time="2011-11-02T06:54:29" />
