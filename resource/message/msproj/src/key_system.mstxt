			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="DATACONV_STR_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>データコンバートが　かんりょうしました▼</Text>
			<TextModifiedBy
