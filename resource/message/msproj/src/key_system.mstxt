				Time="2011-06-24T01:37:18" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="KEYSYS_STR_20"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キーによる　せっていの　へんこうを
おこなうことが　できます</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:50:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
