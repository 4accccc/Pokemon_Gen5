			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-15T12:41:31" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-07T10:06:40" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="DATACONV_STR_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おもいでリンクが　かんりょうしました▼</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00293"
				Time="2011-11-02T06:55:59" />
