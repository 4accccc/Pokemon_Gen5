	<TextRow
		Label="DATACONV_STR_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>データコンバート　きどうちゅう！
しばらく　おまちください</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
