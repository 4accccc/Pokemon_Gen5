	<TextRow
		Label="KEYSYS_STR_19"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケットモンスターブラック・ホワイトと
キーの　そうじゅしんが　できます</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00226"
				Time="2011-08-29T06:20:36" />
			<Status>Editing</Status>
