	<TextRow
		Label="KEYSYS_STR_19"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケットモンスター　ブラック２　か
ポケットモンスター　ホワイト２　と▽
キーの　そうじゅしんが　できます</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00293"
				Time="2011-11-02T08:45:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケットモンスター　ブラック２　か
ポケットモンスター　ホワイト２　と▽
キーの　送受信が　できます</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00293"
				Time="2011-11-02T08:45:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:16:19" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="KEYSYS_STR_20"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キーによる　せっていの　へんこうを
おこなうことが　できます</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:50:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キーによる　設定の　変更を
おこなうことが　できます</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:51:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="KEYSYS_STR_21"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メイン　メニューに
もどります</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-07T07:43:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メイン　メニューに
戻ります</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00226"
				Time="2011-08-29T06:20:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="KEYSYS_STR_22"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せきがいせんつうしんを　おこないます
ＤＳを　むかいあわせに　してください</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:16:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>赤外線通信を　おこないます
ＤＳを　向かい合わせに　してください</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:12:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
		</LanguageCell>
	</TextRow>
