	<TextRow
		Label="DATACONV_STR_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おもいでリンク　きどうちゅう！
しばらく　おまちください</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00293"
				Time="2011-11-02T06:54:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おもいでリンク　起動中！
しばらく　お待ちください</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00293"
				Time="2011-11-02T06:54:37" />
			<Status>Editing</Status>
