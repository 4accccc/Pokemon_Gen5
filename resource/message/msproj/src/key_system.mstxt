				Time="2011-07-07T10:06:40" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="DATACONV_STR_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんかいと　ことなる　レポートを
コンバートしようと　しています
コンバートを　ぞっこう　しますか？</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00226"
				Time="2011-08-29T04:40:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>前回と　異なる　レポートを
コンバートしようと　しています
コンバートを　続行しますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:07:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-15T12:41:31" />
		</CommentCell>
		<AttributeCell
			Name="Width">
