	<TextRow
		Label="DATACONV_STR_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ワイヤレスつうしんを　かいしします
よろしいですか？</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-15T12:36:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ワイヤレス通信を　開始します
よろしいですか？</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-15T12:36:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-15T12:36:00" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-07T10:06:40" />
		</AttributeCell>
