				Time="2011-07-07T10:06:40" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="DATACONV_STR_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケットモンスター　ブラックか
ポケットモンスター　ホワイトの
「ゲームシンクせってい」で
みることが　できる
ゲームシンクＩＤコード　を
にゅうりょく　してください▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:21:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケットモンスター　ブラックか
ポケットモンスター　ホワイトの
「ゲームシンク設定」で　
みることが　できる
ゲームシンクＩＤコード　を
入力して　ください▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:21:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:21:44" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-07T10:06:40" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="DATACONV_STR_11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゲームシンクＩＤコード　が
まちがって　いるようです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:15:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゲームシンクＩＤコード　が
間違っているようです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T07:15:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
		</LanguageCell>
