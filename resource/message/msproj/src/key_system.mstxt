				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="DATACONV_STR_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ただしい　ソフトが　ささっていません
でんげんをきり　ただしい　ソフトを
さしてから　おもいでリンクを
きどうしなおして　ください▼
おもいでリンクを　しゅうりょうします▼</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00293"
				Time="2011-11-04T01:45:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正しい　ソフトが　ささっていません
電源を切り　正しい　ソフトを
さしてから　おもいでリンクを
起動し直してください▼
おもいでリンクを　終了します▼</Text>
			<TextModifiedBy
				User="mizuguchi_mai:W00293"
				Time="2011-11-04T01:45:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-06-24T01:37:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>子機に正しいソフトが刺さっていない</Comment>
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-15T12:41:01" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-24T08:17:21" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-07T10:06:40" />
		</AttributeCell>
		<ExtraCell
