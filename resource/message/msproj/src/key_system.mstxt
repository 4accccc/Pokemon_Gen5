				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="DATACONV_STR_11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゲームシンクＩＤコード　が
まちがって　いるようです</Text>
