	<TextRow
		Label="DATACONV_LISTINFO_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むかし　セッカシティの
ジムだった　ばしょで▽
ハチクが　まっているようだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T02:29:43" />
