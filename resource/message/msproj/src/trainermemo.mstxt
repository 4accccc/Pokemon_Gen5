				Time="2011-05-20T09:30:25" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="trmemo_01_T_02_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>「タマゴのようす」
ときどき　うごいている
みたい。　うまれるまで
もう　ちょっとかな？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>「タマゴの様子」
ときどき　動いている
みたい。　うまれるまで
もう　ちょっとかな？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
