				Time="2011-05-20T09:30:26" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="dwc_message_0017"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｗｉ－Ｆｉコネクションの
せっていを　おこなうには
ほんたいせっていの
インターネットの　こうもくまで
いどうして　ください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｗｉ－Ｆｉコネクションの
設定を　行うには
本体設定の
インターネットの　項目まで
移動してください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>DSiはWiFi設定を
本体でしか行えない</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</AttributeCell>
