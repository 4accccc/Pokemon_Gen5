	<TextRow
		Label="dwc_message_0015"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レポートに　かきこんでいます
でんげんを　きらないでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
