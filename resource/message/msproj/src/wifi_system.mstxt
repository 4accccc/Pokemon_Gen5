				Time="2011-05-20T09:30:26" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="dwc_error_0002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｗｉ－Ｆｉコネクションが
こみあっている　か
サービスが
ていし　しているために
せつぞく　できません
しばらく　まって
やりなおして　ください
（[Digit:5digits Idx="0"]）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｗｉ－Ｆｉコネクションが
混み合っているか
サービスが
停止しているために
接続できません
しばらく　待って
やりなおして　ください
（[Digit:5digits Idx="0"]）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>専用ウインドウ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>192</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="dwc_error_0003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おきゃくさま　の
Ｗｉ－ＦｉコネクションＩＤは
ながい　あいだ
しよう　されなかったため
さくじょ　されました

くわしくは　ガイドブックを
ごらん　ください（[Digit:5digits Idx="0"]）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お客様の
Ｗｉ－ＦｉコネクションＩＤは
長い間
使用されなかったため
削除されました

詳しくは　ガイドブックを
ご覧ください（[Digit:5digits Idx="0"]）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>専用ウインドウ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>192</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="dwc_error_0004"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　ソフトの
Ｗｉ－Ｆｉコネクション　サービスは
しゅうりょう　しました

ごりよう　ありがとう　ございました
（[Digit:5digits Idx="0"]）</Text>
