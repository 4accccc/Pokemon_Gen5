	<TextRow
		Label="mes_tower_tr_248_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　ための　フルコースが
あったら　みんな　よろこばないかな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
