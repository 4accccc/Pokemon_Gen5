	<TextRow
		Label="mes_tower_tr_025_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほいくえんじが　かちました！
ありがとうございまちた！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
