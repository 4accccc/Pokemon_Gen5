	</TextRow>
	<TextRow
		Label="mes_tower_tr_005_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミに　ドッキ　ドキドキ！
わたしは　ボッロ　ボロボロ……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミに　ドッキ　ドキドキ！
私は　ボッロ　ボロボロ……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
