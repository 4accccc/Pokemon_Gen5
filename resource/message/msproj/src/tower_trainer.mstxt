	<TextRow
		Label="mes_tower_tr_115_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ボクハ　マケラレナインダヨ……
モウ　ベンキョウハ　シタクナインダ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>僕ハ　負ケラレナインダヨ……
モウ　勉強ハ　シタクナインダ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
