		</ExtraCell>
	</TextRow>
	<TextRow
		Label="mes_tower_tr_260_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よーし！！　やっちゃうわよー！
わたし　はりきっちゃうわよー！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よーし！！　やっちゃうわよー！
あたし　張り切っちゃうわよー！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
