		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふひゃひゃひゃ……　やったズラ
じっけん　だいせいこうだズラ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
