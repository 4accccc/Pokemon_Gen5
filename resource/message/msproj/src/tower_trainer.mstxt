			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="mes_tower_tr_148_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パパや　ママみたいには　なれないから
スキンヘッドとして　いきてくんだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パパや　ママみたいには　なれないから
スキンヘッドとして　生きてくんだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カロン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="mes_tower_tr_149_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほしクズに　なっちまった　あいぼうの
ポケモンが　オレの　パートナーよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>星クズに　なっちまった　相棒の
ポケモンが　オレの　パートナーよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ぼうそうぞく１

ザビエル</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</CommentCell>
		<ExtraCell
