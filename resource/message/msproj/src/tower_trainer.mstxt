	<TextRow
		Label="mes_tower_tr_043_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまたせでーす　ポケモンしょうぶの
えいこうを　おもちしましたー</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お待たせでーす　ポケモン勝負の
栄光を　お持ちしましたー</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
