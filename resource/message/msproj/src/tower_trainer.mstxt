	<TextRow
		Label="mes_tower_tr_033_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒュルリラ～　ヒュルリラ～
くものように　ながれながされ～</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒュルリラ～　ヒュルリラ～
雲の　ように　流れ流され～</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
