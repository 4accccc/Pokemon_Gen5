	<TextRow
		Label="mes_tower_tr_261_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレの　ステップに　むちゅうで
しゅうちゅう　できなかったな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
