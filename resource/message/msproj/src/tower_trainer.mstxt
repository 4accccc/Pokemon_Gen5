	</TextRow>
	<TextRow
		Label="mes_tower_tr_150_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ブォン！！　ブォン　ブォン！！
ブオォォーンッ！！　ブォン！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ブォン！！　ブォン　ブォン！！
ブオォォーーンッ！！　ブォン！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
