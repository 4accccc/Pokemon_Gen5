		</ExtraCell>
	</TextRow>
	<TextRow
		Label="mes_tower_tr_157_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てじな　やから　タネも　しかけも
たくさん　あるんや</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手品　やから　タネも　仕掛けも
沢山　あるんや</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
