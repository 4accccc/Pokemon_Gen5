	<TextRow
		Label="mes_tower_tr_262_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまたせしました　みなさまのアイドル
クラウン　クラウンで　ございまーす</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
