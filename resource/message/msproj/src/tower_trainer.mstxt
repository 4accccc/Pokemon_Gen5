		</ExtraCell>
	</TextRow>
	<TextRow
		Label="mes_tower_tr_259_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アアン！　カロリーが　きれたわ！
だれか　カロリーを　ちょうだい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アアン！　カロリーが　切れたわ！
だれか　カロリーを　ちょうだい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
