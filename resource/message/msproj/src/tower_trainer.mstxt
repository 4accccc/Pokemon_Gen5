	<TextRow
		Label="mes_tower_tr_259_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ああん　もう　おなかが　すいて
パワーが　でないわ　どうしましょ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ああん　もう　お腹が　空いて
パワーが　出ないわ　どうしましょ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ベーカリー１

タマカヅラ</Comment>
