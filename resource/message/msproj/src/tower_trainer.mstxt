		</ExtraCell>
	</TextRow>
	<TextRow
		Label="mes_tower_tr_003_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おぅ！　おぅー！
いえす　うぃー　きゃん！？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
