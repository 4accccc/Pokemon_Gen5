				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="mes_tower_tr_150_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おで　しゃべるの　とても　にがて……
だから　バイク　かわり　しゃべる……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
