	</TextRow>
	<TextRow
		Label="mes_tower_tr_148_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>スキンヘッドの　ぼくを　みたら
パパも　ママも　かなしむのかな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>スキンヘッドの　ぼくを　みたら
パパも　ママも　悲しむのかな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
