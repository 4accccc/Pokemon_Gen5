			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_142"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Un Pokémon che vagava nei cieli
nell'era dei dinosauri. Le sue zanne
sono affilate come lame.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
