	<TextRow
		Label="ZKN_COMMENT_ITA_00_493"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Si dice che sia nato da un uovo in
mezzo al nulla e che poi abbia
dato origine al mondo.</Text>
