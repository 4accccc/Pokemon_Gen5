				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ソーナノ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_361"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Si dice che gli SNORUNT vivano in
armonia riuniti sotto gigantesche
foglie.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
