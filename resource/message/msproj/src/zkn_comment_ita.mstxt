				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ジーランス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_370"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Vive nei mari caldi. Si dice che le
coppie che trovano questo Pokémon
riceveranno in dono l'eterno amore.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Vive nei mari caldi. Si dice che le
coppie che trovano questo Pokémon
riceveranno in dono l'eterno amore.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ラブカス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_371"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Sogna di poter volare un giorno e,
pertanto, si allena regolarmente
gettandosi da alture.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Sogna di poter volare un giorno e,
pertanto, si allena regolarmente
gettandosi da alture.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>タツベイ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_372"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Nella sua dura corazza le cellule
hanno cominciato a cambiare.
Quando si evolve, la corazza cade.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Nella sua dura corazza le cellule
hanno cominciato a cambiare.
Quando si evolve, la corazza cade.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>コモルー</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_373"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il suo forte desiderio di volare ha
provocato una mutazione cellulare
e gli sono spuntate le ali.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il suo forte desiderio di volare ha
provocato una mutazione cellulare
e gli sono spuntate le ali.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ボーマンダ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_374"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Comunica con i suoi simili mediante
onde magnetiche. I gruppi di BELDUM
si muovono in perfetta sintonia.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Comunica con i suoi simili mediante
onde magnetiche. I gruppi di BELDUM
si muovono in perfetta sintonia.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ダンバル</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_375"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>È sorto dalla fusione di due BELDUM.
Il suo corpo d'acciaio non viene
scalfito neanche se urta un jet.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>È sorto dalla fusione di due BELDUM.
Il suo corpo d'acciaio non viene
scalfito neanche se urta un jet.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>メタング</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_376"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>È formato dalla fusione di due
METANG. Ha quattro cervelli e
l'intelligenza di un supercomputer.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>È formato dalla fusione di due
METANG. Ha quattro cervelli e
l'intelligenza di un supercomputer.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>メタグロス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_377"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>È formato interamente da rocce.
Se si staccano nella lotta, ne cerca
altre per sostituirle.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>È formato interamente da rocce.
Se si staccano nella lotta, ne cerca
altre per sostituirle.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レジロック</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_378"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il suo corpo è costituito da ghiac-
cio dell'era glaciale. Mantiene
l'aria a una temperatura di -200°C.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il suo corpo è costituito da ghiac-
cio dell'era glaciale. Mantiene
l'aria a una temperatura di -200°C.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レジアイス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_379"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>La pressione subita sottoterra
per decine di migliaia di anni ha
reso il suo corpo resistentissimo.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>La pressione subita sottoterra
per decine di migliaia di anni ha
reso il suo corpo resistentissimo.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レジスチル</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_380"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Questo Pokémon ha il corpo
ricoperto di piume che riflettono la
luce e lo rendono invisibile.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Questo Pokémon ha il corpo
ricoperto di piume che riflettono la
luce e lo rendono invisibile.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ラティアス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_381"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Pokémon molto intelligente.
Ripiegando indietro le ali, riesce a
volare più veloce di un jet.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Pokémon molto intelligente.
Ripiegando indietro le ali, riesce a
volare più veloce di un jet.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ラティオス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_382"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Si dice che abbia ampliato i mari
provocando piogge torrenziali. Si è
assopito in una fossa marina.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Si dice che abbia ampliato i mari
provocando piogge torrenziali. Si è
assopito in una fossa marina.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カイオーガ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_383"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Dopo una lotta colossale contro
KYOGRE, si è addormentato sotto
terra in mezzo al magma.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Dopo una lotta colossale contro
KYOGRE, si è addormentato sotto
terra in mezzo al magma.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>グラードン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_384"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Vive nello strato di ozono oltre le
nuvole e non può essere avvistato
da terra.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Vive nello strato di ozono oltre le
nuvole e non può essere avvistato
da terra.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レックウザ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_385"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ha l'abilità di realizzare ogni
desiderio, ma soltanto per
una settimana ogni 1000 anni.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ha l'abilità di realizzare ogni
desiderio, ma soltanto per
una settimana ogni 1000 anni.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ジラーチ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_386"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>È il risultato della mutazione gene-
tica di un virus alieno, giunto sulla
terra con un meteorite.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>È il risultato della mutazione gene-
tica di un virus alieno, giunto sulla
terra con un meteorite.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>デオキシス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_387"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il guscio sulla sua schiena è fatto
di terra. Se un TURTWIG è in forma,
il suo guscio è umido.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il guscio sulla sua schiena è fatto
di terra. Se un TURTWIG è in forma,
il suo guscio è umido.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ナエトル
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_388"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Sa come trovare sorgenti inconta-
minate, dove porta i Pokémon amici
tenendoli sulla schiena.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Sa come trovare sorgenti inconta-
minate, dove porta i Pokémon amici
tenendoli sulla schiena.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ハヤシガメ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_389"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Sul dorso di TORTERRA nascono
Pokémon che vi trascorrono tutta
la vita.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Sul dorso di TORTERRA nascono
Pokémon che vi trascorrono tutta
la vita.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ドダイトス
・シンオウ図鑑プラチナ版
・ビオトープの要素</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_390"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>È molto agile. Prima di addormentar-
si spegne la fiamma sulla coda per
scongiurare il rischio di incendi.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>È molto agile. Prima di addormentar-
si spegne la fiamma sulla coda per
scongiurare il rischio di incendi.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ヒコザル
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_391"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Controlla abilmente l'intensità
delle fiamme sulla sua coda per
tenere i nemici alla distanza ideale.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Controlla abilmente l'intensità
delle fiamme sulla sua coda per
tenere i nemici alla distanza ideale.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>モウカザル
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_392"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Con mani e piedi infuocati, usa
speciali mosse di lotta. Affronta
qualsiasi nemico.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Con mani e piedi infuocati, usa
speciali mosse di lotta. Affronta
qualsiasi nemico.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ゴウカザル
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_393"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Quando cammina risulta goffo e cade
spesso. Poiché è molto orgoglioso,
continua come se nulla fosse.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Quando cammina risulta goffo e cade
spesso. Poiché è molto orgoglioso,
continua come se nulla fosse.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポッチャマ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_394"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Poiché ogni esemplare si considera
il più importante, i PRINPLUP non
riescono mai a creare un gruppo.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Poiché ogni esemplare si considera
il più importante, i PRINPLUP non
riescono mai a creare un gruppo.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポッタイシ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_395"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Chi osa ferirlo nell'orgoglio, viene
colpito dalle sue ali tanto possenti
da fendere un banco di ghiaccio.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Chi osa ferirlo nell'orgoglio, viene
colpito dalle sue ali tanto possenti
da fendere un banco di ghiaccio.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>エンペルト
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_396"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Da soli sono deboli, quindi si
muovono in gruppo. Tuttavia, se
sono troppi finiscono per litigare.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Da soli sono deboli, quindi si
muovono in gruppo. Tuttavia, se
sono troppi finiscono per litigare.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ムックル
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_397"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Conscio della propria debolezza,
vive in gruppo. Quando è da solo,
STARAVIA emette forti versi.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Conscio della propria debolezza,
vive in gruppo. Quando è da solo,
STARAVIA emette forti versi.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ムクバード
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_398"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Non smette di attaccare neanche
quando è ferito. Si preoccupa che
la sua cresta sia sempre in ordine.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Non smette di attaccare neanche
quando è ferito. Si preoccupa che
la sua cresta sia sempre in ordine.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ムクホーク
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_399"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Uno studio ha rivelato che gli inci-
sivi di BIDOOF crescono allo stesso
ritmo di quelli di RATTATA.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Uno studio ha rivelato che gli inci-
sivi di BIDOOF crescono allo stesso
ritmo di quelli di RATTATA.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ビッパ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_400"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Un fiume in cui BIBAREL ha costruito
una diga non straripa mai, cosa mol-
to apprezzata da chi ci vive vicino.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Un fiume in cui BIBAREL ha costruito
una diga non straripa mai, cosa mol-
to apprezzata da chi ci vive vicino.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ビーダル
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_401"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ha le zampe corte. Quando inciampa
le sue antenne si urtano, produ-
cendo un suono simile allo xilofono.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ha le zampe corte. Quando inciampa
le sue antenne si urtano, produ-
cendo un suono simile allo xilofono.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>コロボーシ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_402"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>C'è un villaggio che organizza una
gara basata sulle melodie incredi-
bilmente varie di questo Pokémon.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>C'è un villaggio che organizza una
gara basata sulle melodie incredi-
bilmente varie di questo Pokémon.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>コロトック
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_403"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Produce elettricità contraendo e
rilassando i muscoli. Quando si
sente minacciato si illumina.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Produce elettricità contraendo e
rilassando i muscoli. Quando si
sente minacciato si illumina.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>コリンク
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_404"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>I suoi artigli rilasciano una forte
corrente elettrica e con un solo
graffio manda KO i nemici.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>I suoi artigli rilasciano una forte
corrente elettrica e con un solo
graffio manda KO i nemici.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ルクシオ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_405"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Vede attraverso le pareti per indi-
viduare le prede e i suoi cuccioli
smarriti.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Vede attraverso le pareti per indi-
viduare le prede e i suoi cuccioli
smarriti.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レントラー
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_406"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>La sua gemma, sensibile agli sbalzi
di temperatura, si schiude quando
avverte i caldi raggi del sole.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>La sua gemma, sensibile agli sbalzi
di temperatura, si schiude quando
avverte i caldi raggi del sole.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>スボミー
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_407"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Le due diverse tossine sulle mani
di ROSERADE hanno un effetto quasi
letale quando il Pokémon colpisce.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Le due diverse tossine sulle mani
di ROSERADE hanno un effetto quasi
letale quando il Pokémon colpisce.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ロズレイド
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_408"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Abitava nella giungla già 100 milioni
di anni fa. Abbatte gli alberi che lo
ostacolano con delle testate.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Abitava nella giungla già 100 milioni
di anni fa. Abbatte gli alberi che lo
ostacolano con delle testate.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ズガイドス
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_409"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Anche se si prendono a testate,
due RAMPARDOS non vanno KO perché
il loro cranio è molto spesso.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Anche se si prendono a testate,
due RAMPARDOS non vanno KO perché
il loro cranio è molto spesso.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ラムパルド
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_410"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ha una corazza molto spessa. Di
conseguenza può procurarsi erba
e bacche senza dover combattere.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ha una corazza molto spessa. Di
conseguenza può procurarsi erba
e bacche senza dover combattere.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>タテトプス
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_411"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Se si mettono uno di fianco all'al-
tro nessun nemico riesce a passa-
re. Proteggono così i loro cuccioli.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Se si mettono uno di fianco all'al-
tro nessun nemico riesce a passa-
re. Proteggono così i loro cuccioli.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>トリデプス
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_412"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Anche se dove nasce non ci sono
materiali per fare bozzoli, si ritro-
va sempre coperto da un manto.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Anche se dove nasce non ci sono
materiali per fare bozzoli, si ritro-
va sempre coperto da un manto.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ミノムッチ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_413"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Quando si evolve assorbe i materiali
che ha intorno. Per questo motivo
ne esistono molte varianti.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Quando si evolve assorbe i materiali
che ha intorno. Per questo motivo
ne esistono molte varianti.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ミノマダム
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_414"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Anche se ama il nettare dei fiori,
non lo raccoglie. Preferisce
rubarlo ai COMBEE.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Anche se ama il nettare dei fiori,
non lo raccoglie. Preferisce
rubarlo ai COMBEE.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ガーメイル
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_415"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Il trio è insieme dalla nascita.
È sempre impegnato a portare il
nettare dei fiori a VESPIQUEN.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Il trio è insieme dalla nascita.
È sempre impegnato a portare il
nettare dei fiori a VESPIQUEN.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ミツハニー
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_416"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Rilascia vari feromoni per farsi
obbedire dalle larve che trasporta
mentre combatte.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Rilascia vari feromoni per farsi
obbedire dalle larve che trasporta
mentre combatte.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ビークイン
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_417"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Talvolta due esemplari si sfregano
le guance per condividere
l'elettricità immagazzinata.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Talvolta due esemplari si sfregano
le guance per condividere
l'elettricità immagazzinata.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>パチリス
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_418"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Usa le sue due code come eliche per
spostarsi nell'acqua e con esse ta-
glia anche le alghe che s'impigliano.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Usa le sue due code come eliche per
spostarsi nell'acqua e con esse ta-
glia anche le alghe che s'impigliano.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ブイゼル
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_419"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Si vede spesso vicino ai porti dove
si pesca. Porta in salvo le persone
e trascina via le prede.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Si vede spesso vicino ai porti dove
si pesca. Porta in salvo le persone
e trascina via le prede.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>フローゼル
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_420"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>La pallina, oltre a contenere so-
stanze nutritive, è molto gustosa.
STARLY cerca spesso di beccarla.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>La pallina, oltre a contenere so-
stanze nutritive, è molto gustosa.
STARLY cerca spesso di beccarla.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>チェリンボ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_421"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Quando splende il sole, ama aprire
i suoi petali per assorbire i raggi
solari con tutto il corpo.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Quando splende il sole, ama aprire
i suoi petali per assorbire i raggi
solari con tutto il corpo.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>チェリム
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_422"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Se si esercita una forte pressione
sul suo corpo, ne fuoriesce un
misterioso liquido viola.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Se si esercita una forte pressione
sul suo corpo, ne fuoriesce un
misterioso liquido viola.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カラナクシ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_423"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>In passato portava sulla schiena
un robusto carapace. Ne rimangono
tracce nelle sue cellule.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>In passato portava sulla schiena
un robusto carapace. Ne rimangono
tracce nelle sue cellule.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>トリトドン
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_424"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>È talmente abile nel maneggiare gli
oggetti con le sue due code che
solo raramente usa le mani.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>È talmente abile nel maneggiare gli
oggetti con le sue due code che
solo raramente usa le mani.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>エテボース
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_425"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Fluttua qua e là senza motivo e
per questo una leggenda lo defini-
sce “Guida degli spiriti vaganti".</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Fluttua qua e là senza motivo e
per questo una leggenda lo defini-
sce “Guida degli spiriti vaganti".</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>フワンテ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
