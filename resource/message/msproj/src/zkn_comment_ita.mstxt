				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ユキワラシ
・シンオウ図鑑プラチナ版</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_362"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Impedisce alla preda di scappare
congelando all'istante l'umidità
nell'aria.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Impedisce alla preda di scappare
congelando all'istante l'umidità
nell'aria.</Text>
