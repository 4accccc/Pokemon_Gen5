			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_ITA_00_345"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Viveva sul fondo marino 100 milioni
di anni fa ed è stato rigenerato
in laboratorio.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
