	<TextRow
		Label="msg_connect_06_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つごうの　わるくなってしまった
メンバーが　います</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>都合の　悪くなってしまった
メンバーが　います</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
