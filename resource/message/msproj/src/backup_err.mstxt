<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_load_err"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>データを　よめませんでした
でんげんを　きって
カードを　さしこみなおしてください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>データを　読めませんでした
電源を　切って
カードを　差し込み直してください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>フラッシュの読み取りが出来なかった</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_write_err"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>データを　かけませんでした

でんげんを　きって
カードを　さしこみなおしてください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>データを　書けませんでした

電源を　切って
カードを　差し込み直してください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>書き込みできなかった</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_flash_err"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>データを　かけませんでした

バックアップきのうの　こしょう
または　じゅみょうが　きました
セーブすることは　できませんが
ゲームを　あそぶことはできます

でんげんを　きってください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>データを　書けませんでした

バックアップ機能の　故障
または　寿命が　きました
セーブすることは　できませんが
ゲームを　遊ぶことはできます

電源を　切ってください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>書き込み寿命</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>