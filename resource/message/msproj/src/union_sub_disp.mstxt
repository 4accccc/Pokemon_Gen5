	<TextRow
		Label="msg_union_appeal_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいせん　したいひとは
マークを　タッチして！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
