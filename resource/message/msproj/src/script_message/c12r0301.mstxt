	</TextRow>
	<TextRow
		Label="msg_c12r0301_02_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>その　ポケモンを　だいじにするんだよ▼
そのコが　きっと　あんたに
あたらしい　せかいを　みせてくれるよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その　ポケモンを　大事にするんだよ▼
そのコが　きっと　あんたに
新しい　世界を　みせてくれるよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
