	<TextRow
		Label="msg_c12r0301_01_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おう！　[Name:TrainerName Idx="0" ]！▼
おおう！　ポケモンと　いっしょか
そりゃ　よかったなあ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おう！　[Name:TrainerName Idx="0" ]！▼
おおう！　ポケモンと　一緒か
そりゃ　よかったなあ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ポケモン入手後
・0＝主人公名前</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
