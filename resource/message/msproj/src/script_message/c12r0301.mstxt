	<TextRow
		Label="msg_c12r0301_01_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おう！　[Name:TrainerName Idx="0" ]！▼
きょうも　[Name:TrainerName Idx="1" ]に
ポケモンを　じまん　されるのかい？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おう！　[Name:TrainerName Idx="0" ]！▼
今日も　[Name:TrainerName Idx="1" ]に
ポケモンを　自慢されるのかい？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ポケモン入手前
・0＝主人公名前
・1＝ライバル名前</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN1</Text>
