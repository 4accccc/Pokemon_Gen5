			<Text>256</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-23T02:55:57" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d05_badman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　トレーナーが　つどうのか？
どんな　たたかいに　なるのか！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T06:39:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-23T03:51:49" />
		</LanguageCell>
