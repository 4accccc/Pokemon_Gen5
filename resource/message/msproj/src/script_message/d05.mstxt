	<TextRow
		Label="msg_d05_swleader1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『ぼくも　いきますよ▼
ほんとうに　プラズマだんが
ふっかつ　なのか　しらべないと！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-22T05:11:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-22T04:58:32" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレン『ぼくも　いきますよ▼
本当に　プラズマ団が
復活なのか　しらべないと！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-22T05:11:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-22T05:11:04" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・画面左へ移動
・続けてswboss_02</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-23T08:36:57" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:38:56" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-22T04:58:38" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
