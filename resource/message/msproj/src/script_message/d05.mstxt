	</TextRow>
	<TextRow
		Label="msg_d05_swleader1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『あんなことが　できるのは
まさか……！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-22T05:16:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
