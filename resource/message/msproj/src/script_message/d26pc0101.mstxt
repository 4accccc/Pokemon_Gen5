<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d26pc0101_veteranm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パートナーの　おかげで
ジムバッジを　８つ　あつめた▼
なのに　ボクの　ふがいなさで
チャンピオンロードで　あしどめさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T11:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T13:33:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パートナーの　おかげで
ジムバッジを　８つ　集めた▼
なのに　ボクの　ふがいなさで
チャンピオンロードで　足止めさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T11:57:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T13:33:47" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T13:33:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T11:58:17" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T11:56:20" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d26pc0101_trainerw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まず　ながく　けわしい
チャンピオンロードを　ぬける▼
つぎに　してんのうを　ひとりずつで
いいから　たおせるように　なる▼
そうやって　できることを　ふやして
チャンピオンに　ちかづくのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T10:33:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T13:36:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まず　長く　険しい
チャンピオンロードを　抜ける▼
次に　四天王を　一人ずつで
いいから　倒せるように　なる▼
そうやって　できることを　増やして
チャンピオンに　近づくのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T10:33:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T13:37:58" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T13:35:54" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RANGERW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T11:56:58" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T11:56:21" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>