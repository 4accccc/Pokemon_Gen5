	<TextRow
		Label="msg_c16_owner_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっと　きみきみ！▼</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-07T03:24:19" />
			<Status>Editing</Status>
