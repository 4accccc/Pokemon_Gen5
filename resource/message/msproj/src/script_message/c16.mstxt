	<TextRow
		Label="msg_c16_secretary_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はじめまして▼
あなたの　ことを　なんと
およびすれば　よいでしょう？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T04:18:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はじめまして▼
あなたの　ことを　なんと
お呼びすれば　よいでしょう？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T04:24:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
