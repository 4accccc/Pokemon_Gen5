	<TextRow
		Label="msg_c16_pilot_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オー　ノー！
のりたくなったら　はなしかけてよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
