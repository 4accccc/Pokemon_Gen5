		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T10:16:08" />
		</CommentCell>
		<AttributeCell
