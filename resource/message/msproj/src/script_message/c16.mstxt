				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c16_secretary_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとを　よぶためには
べんりで　やくだつ　しせつを▽
つくるのが　よいでしょう▼
そう！　おみせ　です！▼
おみせを　つくるには
ゆめを　もって▼
この　まちへ　やってきた　ひとを
「しょうたい」すると　できあがます▼
……おや？
だれか　いらしたみたいです▼
さっそく
「しょうたい」して　みましょう</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-28T07:51:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人を　呼ぶためには
便利で　役立つ　施設を▽
つくるのが　よいでしょう▼
そう！　お店です！▼
お店を　つくるには
夢を　もって▼
この街へ　やってきた　人を
「しょうたい」すると　できあがます▼
……おや？
だれか　いらしたみたいです▼
さっそく
「しょうたい」して　みましょう</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-28T07:51:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T10:16:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OL</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T04:17:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c16_secretary_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まずは　おみせを　たてましょう▼
まちを　あるくひとに　はなしかけて
「しょうたいする」を　えらんで▽
おみせを　つくって　もらいましょう</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-28T07:51:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まずは　お店を　たてましょう▼
街を　歩く人に　話しかけて
「しょうたいする」を　選んで▽
お店を　つくって　もらいましょう</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-28T07:51:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T10:16:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OL</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T04:17:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c16_secretary_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おめでとうございます！
りっぱな　おみせが　たちましたね▼
おみせを　つくっても　おきゃくさまが
こなければ　いみが　ありません▼
つぎは　おきゃくさまに
おみせを　しょうかい　しましょう▼
おきゃくさまに　はなしかけて
「あんないする」を　しましょう▼
……おや？　また
どなたか　いらっしゃったようです▽
さっそく　「あんない」　してみましょう</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-28T07:51:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おめでとうございます！
立派な　お店が　建ちましたね▼
お店を　つくっても　お客さまが
こなければ　意味が　ありません▼
つぎは　お客さまに
お店を　紹介しましょう▼
お客さまに　話しかけて
「あんないする」を　しましょう▼
……おや？　また
どなたか　いらっしゃったようです▽
さっそく　「あんない」　してみましょう</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-28T07:51:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T10:16:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OL</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T04:17:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c16_secretary_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おきゃくさまを　おみせに
「あんない」して　あげましょう</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-28T07:51:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お客さまを　お店に
「あんない」して　あげましょう</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-28T07:51:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T10:16:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OL</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T04:17:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c16_secretary_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おめでとうございます！▼
おきゃくさまを
おみせに　ごあんないして▽
まちの　にんきが　あがりました▼
まちや　おみせの　にんきを　あげて
ゆうめいに　していきましょう▼
おきゃくさまを　よぶ　コツは
とにかく　つうしんを　することです▼
Ｃギアを　オンにして
すれちがって　みたり▼
ユニオンルームや
グローバルターミナル　などの▽
つうしん　しせつへ　いってみましょう▼
それでは　わたくしどもは
[Name:ResortMayor ]の　ひしょとして▽
こちらの　へやで　おまちしています▼
いろいろと　サポートを　いたしますので
ぜひ　いらして　くださいね▼
それでは▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T04:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おめでとうございます！▼
お客さまを
おみせに　ご案内して▽
街の　人気が　あがりました▼
街や　お店の　人気を　あげて
有名に　していきましょう▼
お客さまを　呼ぶ　コツは
とにかく　通信を　することです▼
Ｃ－ＧＥＡＲを　ＯＮにして
すれちがって　みたり▼
ユニオンルームや
グローバルターミナル　などの▽
通信施設へ　行ってみましょう▼
それでは　わたくしどもは
[Name:ResortMayor ]の　秘書として▽
こちらの　へやで　お待ちしています▼
いろいろと　サポートを　いたしますので
ぜひ　いらして　くださいね▼
それでは▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T04:29:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T12:25:33" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>0：市長名</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-23T08:42:05" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OL</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T04:17:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
