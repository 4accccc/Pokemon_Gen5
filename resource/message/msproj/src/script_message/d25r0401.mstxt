	<TextRow
		Label="msg_d25r0401_book1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とおく　シンオウちほう　に
クレセリアと　いう　ポケモンあり▼
みかづきの　ように　かがやく
はねは　わるい　ゆめを　けすなり</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T07:01:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>遠く　シンオウ地方に
クレセリアと　いう　ポケモンあり▼
みかづきの　ように　輝く
はねは　悪い　夢を　消すなり</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:05:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ
・GRIDX＝7～10、GRIDZ＝9</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T12:13:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>本棚</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:41:28" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T06:01:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
