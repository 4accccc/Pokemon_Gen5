	<TextRow
		Label="msg_c04r1001_woman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こころが　つうじあってる……！
そんなふうに　みえるわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
