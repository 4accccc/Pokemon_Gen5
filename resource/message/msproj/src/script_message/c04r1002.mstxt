	<TextRow
		Label="msg_c04r1001_woman1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おたがいのことを　わかりはじめた……
なんとなく　そんな　かんじかしら？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おたがいのことを　わかりはじめた……
なんとなく　そんな　感じかしら？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
