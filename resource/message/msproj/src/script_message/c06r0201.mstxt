	<TextRow
		Label="msg_c06r0201_swleader6_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ね　ひこうきに　のる？
アタシ　はやく　とびたいな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
