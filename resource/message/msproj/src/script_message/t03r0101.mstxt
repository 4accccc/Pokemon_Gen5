	<TextRow
		Label="msg_t03r0101_middlewoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここは　カゴメタウン▼
おはようから　おやすみまで
きそく　ただしく　くらす　まちよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここは　カゴメタウン▼
おはようから　おやすみまで
規則　正しく　暮らす　町よ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
