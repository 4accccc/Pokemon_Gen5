	<TextRow
		Label="msg_c13_swleader2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ホミカ『あんたら……
もしかして　プラズマだん？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:34:09" />
