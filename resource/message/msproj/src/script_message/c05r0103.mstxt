<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c05r0103_gentleman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これを　あげましょっ！
どうぐの　ふうせんを　あげましょっ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:29:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これを　あげましょっ！
道具の　風船を　あげましょっ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:32:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No541「ふうせん」</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:31:05" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GENTLEMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:26:00" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0103_gentleman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふうせんを　もたせた　ポケモンは
ぷかぷか　うかべるっ！▼
なにか　ダメージを　うけるまで
じめんタイプの　わざを　かわせるよ▼
そっ！　わたしは
ふうせん　おじさん　なのさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:33:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:27:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふうせんを　持たせた　ポケモンは
ぷかぷか　浮かべるっ！▼
なにか　ダメージを　受けるまで
じめんタイプの　技を　交わせるよ▼
そっ！　わたしは
ふうせん　おじさん　なのさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:33:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:27:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:30:01" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GENTLEMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:26:01" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0103_boy4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふうせん　ふうせん　ふうせん！
ライブキャスターミニゲーム！▼
ぼくの　こうきな　しゅみは
ライブキャスターでの　ミニゲームさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:32:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:27:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふうせん　ふうせん　ふうせん！
ライブキャスターミニゲーム！▼
ぼくの　こうきな　しゅみは
ライブキャスターでの　ミニゲームさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:32:33" />
