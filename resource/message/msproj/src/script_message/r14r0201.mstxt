	<TextRow
		Label="msg_r14r0201_girl1_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おじいちゃんが　いってたよーっ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
