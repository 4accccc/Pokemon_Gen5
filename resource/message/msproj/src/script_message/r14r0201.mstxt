				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r14r0201_boy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ランドロスさまの　ほこらに
イタズラ　すると▽
おおあらしに　なるんだぞー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
