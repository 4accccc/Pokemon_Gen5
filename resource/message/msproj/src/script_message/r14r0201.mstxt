			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r14r0201_girl1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トルネロスと　ボルトロスが
また　ここに　きたら[Ctrl2:LineFeed ]
ランドロスさまが　でてくるかも[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
