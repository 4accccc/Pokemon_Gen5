			<Text>弟</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r14r0201_boy1_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まてよ　ばかっ！[Ctrl2:PageClear ]</Text>
