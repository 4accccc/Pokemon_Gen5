				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r14r0201_mission_add_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くっさい　くっさい　こやしが
おいしい　やさいを　そだてるのさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T05:54:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T03:43:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>くっさい　くっさい　こやしが
美味しい　野菜を　育てるのさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T05:54:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T03:44:05" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・mission_add_02表示後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T05:54:30" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T05:54:38" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
