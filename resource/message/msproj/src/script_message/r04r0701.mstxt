	<TextRow
		Label="msg_r04r0701_veteranw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おや！　げんきいっぱいの
トレーナーと　ポケモンだね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T07:54:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T07:54:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おや！　元気一杯の
トレーナーと　ポケモンだね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T07:54:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T07:54:53" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：White2ver
・HP/PP満タン時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:20:36" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>VETERANW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T07:54:53" />
		</AttributeCell>
		<AttributeCell
