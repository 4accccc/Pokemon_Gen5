	<TextRow
		Label="msg_r04r0701_veteranw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うん？　なんだか　くたびれてない？
いいから　やすんでいきなよ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T07:54:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T07:54:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うん？　なんだか　くたびれてない？
いいから　休んでいきなよ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T07:54:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T07:54:53" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：White2ver
・HP/PP満タンでない時
　続けて画面暗転して回復処理</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:20:34" />
		</CommentCell>
		<AttributeCell
