				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r13_poke4_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンは　どうろの　さきへ
はしりさって　しまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンは　道路の　先へ
走り去ってしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・戦闘後
・倒した場合のメッセージ
・復帰処理の仕様は保留</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:39" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE4
ポケモン・コバルオン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r13_salvage_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにを　しているか　だって？▼
たからさがし　だよ
た・か・ら・さ・が・し！▼
たからさがしは　たのしいよ
たまに　すなはまに　うまっていてね▽
さっきも　おたからを　みつけたんだ▼
だけど　すでに　みつけた　モノだから
きみに　ゆずってあげるよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なにを　しているか　だって？▼
宝探し　だよ
た・か・ら・さ・が・し！▼
宝探しは　楽しいよ
たまに　砂浜に　うまっていてね▽
さっきも　お宝を　みつけたんだ▼
だけど　すでに　みつけた　ものだから
君に　ゆずってあげるよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・初回会話
・アイテム入手処理
※入手アイテムの調整を検討</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:16:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
