	<TextRow
		Label="msg_r13_salvage_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あしたも　ここで　たからさがし▼
なにか　みつかるかも　しれないから
ヒマなら　くると　いいんじゃないか</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
