	<TextRow
		Label="msg_r13_sys_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キャモメは　うれしそうに
そらへ　とびさった！▼
……おや？
なにか　おちている▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
