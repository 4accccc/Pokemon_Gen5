	<TextRow
		Label="msg_r13_poke4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こふおおおおーっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こふおおおおーっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:00" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・GRIDX＝684、GRIDZ＝197、下向き（暫定）
・あわせて鳴き声再生
・その後、戦闘へ
</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T04:03:56" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE4
ポケモン・コバルオン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:38:00" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
