<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t02pc0101_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パソコンの　ボックスを　みて
これまでの　たびを　おもいだしてるの▼
あのコは　いつ　であって
このコは　あそこで　つかまえて……▼
つれてあるく　ポケモンを　かえて
また　あの　ばしょに　いこうかな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:45:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パソコンの　ボックスを　みて
これまでの　旅を　おもいだしてるの▼
あのコは　いつ　出会って
このコは　あそこで　捕まえて……▼
連れて歩く　ポケモンを　換えて
また　あの　場所に　行こうかな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:45:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:43:55" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1
女性１</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T12:00:49" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t02pc0101_girl2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしも　いちねんまえ
アララギはかせ　から　ポケモンを▽
たくされて　たびに　でたんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:59:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:59:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしも　一年前
アララギ博士から　ポケモンを▽
託されて　旅に　でたんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T12:01:23" />
			<Status>Editing</Status>
