	<TextRow
		Label="msg_t02pc0101_girl2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしも　いちねんまえ
アララギはかせ　から　ポケモンを▽
たくされて　たびに　でたんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
