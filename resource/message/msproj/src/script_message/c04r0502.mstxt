<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c04r0502_boy4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいにち　きまった　じかんに
ベースボールや　アメフトが　はじまる▽
それが　ビッグスタジアム　なのさ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>毎日　決まった　時間に
ベースボールや　アメフトが　始まる▽
それが　ビッグスタジアム　なのさ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T07:19:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY4
お坊ちゃま</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c04r0502_girl4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リトルコートでは
バスケットボールや　テニスの▽
しあいが　ありますのよ　</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リトルコートでは
バスケットボールや　テニスの▽
試合が　ありますのよ　</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T07:19:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL4
お嬢様</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c04r0502_lady_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら……？▼
おやまあ！▼
あなたの　[Name:PokemonName Idx="0" ]さん　たら
あなたのことが　おすきみたいですね！▽
うれしいから　これを　さしあげます▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら……？▼
おやまあ！▼
あなたの　[Name:PokemonName Idx="0" ]さん　たら
あなたのことが　お好きみたいですね！▽
うれしいから　これを　差しあげます▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・先頭のポケモンのなつき度が
　７０以上ならこのメッセージ
　６９以下→lady_03
・メッセージ表示後にアイテム入手処理
　No218「やすらぎのすず」
・アイテム取得後はlady_02
・0＝先頭のポケモン名（ひんし/タマゴを除く）</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LADY
淑女</Text>
