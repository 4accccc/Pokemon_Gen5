	<TextRow
		Label="msg_c04gym0101_princess1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたと　あなたのポケモン
とっても　シャイニング！▼
わたしも　みならわなきゃ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
