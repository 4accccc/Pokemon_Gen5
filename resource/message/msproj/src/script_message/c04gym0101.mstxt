				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c04gym0101_leader_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たいようと　つき　ではなく▼
たいようと　たいよう　なら
その　まぶしさは　むげんだい！▼
わたしは　ポケモンと
そんな　かんけいに　なりたいわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T10:06:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>太陽と　月ではなく▼
太陽と　太陽なら
その　まぶしさは　無限大！▼
わたしは　ポケモンと
そんな　関係に　なりたいわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T10:07:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・msg_c04gym0101_leader_05
　表示後に再度会話
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T10:18:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER4
ジムリーダー・カミツレ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T03:15:50" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
