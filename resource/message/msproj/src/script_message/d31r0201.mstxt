	<TextRow
		Label="msg_d31r0201_assistantw_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなた　いちばん　うえの
エリアも　クリアしたんだってね……▼
すごいわ……！　まさに
くもの　うえの　ひとって　かんじね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-08T10:02:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-22T02:54:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなた　一番　上の
エリアも　クリアしたんだってね……▼
すごいわ……！　まさに
雲の上の人って　感じね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-08T10:02:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-22T02:54:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・エリア10クリア後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-13T01:26:59" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>科学者女　黒の摩天楼</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-22T02:54:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-13T01:25:35" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T09:17:34" />
		</AttributeCell>
