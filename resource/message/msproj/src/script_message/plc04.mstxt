<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="plc04_man01_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……デルダマを　さがしていたら
こんなところに　きてしまった▼
よく　ポケモンセンターの
いりぐちに　おちてるんだけどな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……デルダマを　探していたら
こんな所に　来てしまった▼
よく　ポケモンセンターの
入り口に　落ちてるんだけどな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>？？？</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN
座標は４１１，４６２

男</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="plc04_man02_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　なんだ　よくみたら
ぼく　やきゅうせんしゅに　なってるぞ！▽
なんだこれー！？▼
どうしよう　がっこうに
いかなきゃ　いけないのに！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　なんだ　良くみたら
ぼく　野球選手に　なってるぞ！▽
何だこれー！？▼
どうしよう　学校に
行かなきゃ　いけないのに！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>BASEBALLM
座標は４０３，４３７
男</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
	</TextRow>
