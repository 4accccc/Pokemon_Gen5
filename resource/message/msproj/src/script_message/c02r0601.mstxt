			<Text>WAITRESS
ウエートレス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T06:12:59" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
