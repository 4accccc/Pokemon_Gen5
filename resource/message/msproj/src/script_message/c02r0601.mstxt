	<TextRow
		Label="msg_c02r0601_sys_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName ]は
ハンカチを　てわたした！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T06:32:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T06:32:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName ]は
ハンカチを　手渡した！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T06:53:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
