			Name="Character">
			<Text>MAN3</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T06:28:47" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02r0601_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わはは！　わしの　ミルホッグは
けなみが　よくて　かっこいいだろ！▼
こうして　カフェソーコに　きて
まいしゅう　じまん　してるんだ▼
こいつの　いかりのまえば　は
ちょっとした　もんだぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T06:34:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T06:29:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わはは！　わしの　ミルホッグは
毛並みが　よくて　かっこいいだろ！▼
こうして　カフェソーコに　来て
毎週　自慢してるんだ▼
こいつの　いかりのまえば　は
ちょっとした　もんだぞ！</Text>
			<TextModifiedBy
