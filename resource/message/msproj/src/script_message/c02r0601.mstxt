	<TextRow
		Label="msg_c02r0601_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このカフェは　まいしゅう
すいようび　どようびが　サービスデー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
