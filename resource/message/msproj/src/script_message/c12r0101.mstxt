	<TextRow
		Label="msg_c12r0101_darumaka_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ママが　むかし　もらったらしい
ポケモン　ダルマッカの　にんぎょう▼
ななころび　やおき</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T04:03:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T03:52:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ママが　昔　もらったらしい
ポケモン　ダルマッカの　人形▼
七転び八起き</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
