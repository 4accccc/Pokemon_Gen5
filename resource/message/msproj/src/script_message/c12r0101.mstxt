	<TextRow
		Label="msg_c12r0101_swmama_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ええー！！
ちょっと　おどろき……！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ええー！！
ちょっと　おどろき……！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・いいえ選択時
・一歩退いてからメッセージ
　その後もとの位置に戻ってswmama_04</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWMAMA
スワン主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:27:21" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
