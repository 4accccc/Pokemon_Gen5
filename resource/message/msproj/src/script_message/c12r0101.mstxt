			<Text>スワン主人公ママ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12r0101_swmama_cure_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ママ『あたしも　わかいころは
あちこちの　ポケモンセンターを▽
