		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！
ただいまー！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T09:44:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
