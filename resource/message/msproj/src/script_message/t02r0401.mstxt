	<TextRow
		Label="msg_t02r0401_girl4_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あとひとつ……▼
あとひとつ　きけば
こころ　はずんで▽
けんばんを　おどらせられるのに！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:00:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あとひとつ……▼
あとひとつ　聴けば
心　弾んで▽
けん盤を　躍らせられるのに！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:08:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
