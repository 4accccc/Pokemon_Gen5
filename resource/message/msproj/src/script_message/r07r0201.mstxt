	<TextRow
		Label="msg_r07r0201_mountain_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンこうかん　することで
トレーナーは　しりあいに　なれるな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
