<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r07r0201_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おぬし！　ポケモンの
エモンガは　つかまえたか？▼
もし　つかまえているなら
わしの　ギガイアスと
おぬしの　エモンガを▽
こうかん　しないか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-08T04:47:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おぬし！　ポケモンの
エモンガは　捕まえたか？▼
もし　捕まえているなら
わしの　ギガイアスと
おぬしの　エモンガを▽
交換しないか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-08T04:48:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ポケモン交換前
・はい/いいえの選択肢表示
　はい→ポケモン選択画面
　いいえ→mountain_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:48:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0201_mountain_01a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うむ！　それでは
ポケモンこうかん　かいし！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うむ！　それでは
ポケモン交換　開始！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択
　ポケモン選択画面で条件を満たすポケモンを選択
　メッセージ表示後に「、交換デモ開始</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:30:23" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0201_mountain_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おお！　おお！　なんとも
キュートな　ポケモン　だ！▼
おぬしも　ギガイアスを
たいせつに　してくれよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-08T04:48:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おお！　おお！　なんとも
キュートな　ポケモン　だ！▼
おぬしも　ギガイアスを
大切に　してくれよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-08T04:48:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・交換デモ終了後、以下のメッセージを自動表示</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:48:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:30:23" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0201_mountain_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おいおい！▼
わしが　こうかん　してほしいのは
エモンガ　だぞ……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:47:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おいおい！▼
わしが　交換してほしいのは
エモンガ　だぞ……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:48:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ポケモン交換</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:48:14" />
		</CommentCell>
