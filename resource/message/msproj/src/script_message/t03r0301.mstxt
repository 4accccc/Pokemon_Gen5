	<TextRow
		Label="msg_t03_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よるは　もちろん
ひるまも　そとに　でなければ▽
なんの　きけんも　ないのよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T05:59:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T05:59:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夜は　もちろん
昼間も　外に　でなければ▽
なんの　危険も　ないのよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T05:59:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T05:59:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・どの時間帯もここにいる
・swanで追加</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T05:54:18" />
		</CommentCell>
		<AttributeCell
