<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c09r0701_veteranm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんど　してんのうに
はばまれた　としても！▼
おれは　ポケモンと
まえを　むきつづける！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:10:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>幾度　四天王に
はばまれた　としても！▼
おれは　ポケモンと
前を　向き続ける！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:10:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:05:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>VETERANM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:05:09" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T11:54:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c09r0701_trainerw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>してんのう　それぞれが　くりだす
ポケモンの　タイプを　はあくすること▽
それが　しょうりの　ちかみち！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:12:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:11:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>四天王　それぞれが　繰りだす
ポケモンの　タイプを　把握すること▽
それが　勝利の　近道！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:13:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:12:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:11:20" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:10:59" />
		</AttributeCell>
		<AttributeCell
