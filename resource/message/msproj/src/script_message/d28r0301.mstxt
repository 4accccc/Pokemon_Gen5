<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d28r0301_mission_add_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　わざを　おしえるため
おれは　かけらを　あつめてるのさ▼
かけらは　つちけむりから　みつかるよ
まれに　ポケモンが　でてくるけどね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T13:00:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　技を　教えるため
おれは　かけらを　集めてるのさ▼
かけらは　土煙から　みつかるよ
まれに　ポケモンが　でてくるけどね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T13:02:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・フェス用システムフラグがOFFなら
　続けてmission_add_02
・GRIDX＝15、GRIDZ＝7を中心に
　ウロウロ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T03:40:56" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>VETERANM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T02:58:48" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d28r0301_mission_add_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハイリンクに　フェスミッションの
『おたから　はっくつ！』が▽
ついか　されました</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T02:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T02:58:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハイリンクに　フェスミッションの
『おたから　はっくつ！』が▽
追加されました</Text>
