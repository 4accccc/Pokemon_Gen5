	<TextRow
		Label="msg_r12r0101_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……すみません
せいふくを　わすれちゃって</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
