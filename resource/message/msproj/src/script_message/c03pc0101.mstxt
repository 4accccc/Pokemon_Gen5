	<TextRow
		Label="msg_geonet_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アナタ　ジオネット　しってる？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
