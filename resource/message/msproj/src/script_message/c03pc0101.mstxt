	<TextRow
		Label="msg_c03pc0101_businessman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんばったら　くたびれる！
くたびれたら　やすめば　いいじゃない▽
ひとも　ポケモンも　おなじだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T07:58:04" />
