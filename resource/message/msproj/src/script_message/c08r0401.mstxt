			Name="Character">
			<Text>TRAINERW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T12:10:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>