<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="plc07_man01_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼく　ほんとうは　おとこのこ　なんだ
なのに　さっき　かがみをみたら……▼
なんで？　こんなすがたに！？
これも　ハイリンクの　ちから？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼく　本当は男の子なんだ
なのに　さっき鏡を見たら……▼
なんで？　こんな姿に！？
これも　ハイリンクの力？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>？？？</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITRESS
１７８，１８７
女の外見
セリフは男</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="plc07_man02_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……うーん　また　ここにきちゃった
さっきまで　ぐっすり　ねてたはずなのに▼
ここは　ゆめのせかい　かなぁ
ゆめのせかいは　いつも　しろくろだなぁ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……うーん　また　ここに来ちゃった
さっきまで　ぐっすり　寝てたはずなのに▼
ここは　夢の世界　かなぁ
夢の世界は　いつも　白黒だなぁ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN2
１８０，１６９
男</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
	</TextRow>
