	<TextRow
		Label="msg_d12r0101_policeman02_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミの　ポケモンが　たたかいで
キズついたときは　おしえてくれ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミの　ポケモンが　戦いで
キズついたときは　教えてくれ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
