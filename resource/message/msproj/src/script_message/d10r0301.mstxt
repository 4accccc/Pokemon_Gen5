	<TextRow
		Label="msg_d10r0301_swrival_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チョット　まってな▼
むかしの　なかまを　きずつけないよう
せっとく　するんだとよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-19T08:14:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チョット　待ってな▼
昔の　仲間を　傷つけないよう
説得するんだとよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-19T08:15:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
