				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d10r0301_hakaim1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……じぶんに　えらそうなことを
いう　しかくは　ありません▼
むかしは　じぶんも
ポケモンを　うばっていたのですから</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T11:32:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……自分に　偉そうなことを
いう　資格は　ありません▼
昔は　自分も
ポケモンを　奪っていたのですから</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T11:32:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ゲーチス戦終了後
　ゲームクリアまで</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</CommentCell>
		<AttributeCell
			Name="Character">
