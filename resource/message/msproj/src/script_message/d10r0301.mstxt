				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d10r0301_swplazmam1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだん『はいはい
じーさん　いいこと　いったね▼
バカか！▼
うらぎりものの　ことばなんか
きくわけ　ないだろ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-19T13:15:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマ団『はいはい
じーさん　いいこと　いったね▼
バカか！▼
裏切り者の　言葉なんか
きくわけ　ないだろ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-19T13:15:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
