	<TextRow
		Label="msg_d10r0301_swrival_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チョット　まってな▼
むかしの　なかまを　きずつけないよう
せっとく　するんだってさ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-08T12:33:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チョット　待ってな▼
昔の　仲間を　傷つけないよう
説得するんだってさ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-08T12:33:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてsage6_01</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-08T12:33:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</AttributeCell>
