	<TextRow
		Label="msg_d10r0301_swplazmam3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うらぎりものの　しちけんじん　め！
ボコボコにして　ほめてもらうぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T07:59:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>裏切り者の　七賢人め！
ボコボコにして　ほめてもらうぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T07:59:55" />
			<Status>Editing</Status>
