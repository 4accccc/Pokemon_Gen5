	<TextRow
		Label="msg_d10r0301_swplazmam1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだん『なに　いってんだ？
いたい　めに　あいたいのか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマ団『なに　いってんだ？
痛い目に　あいたいのか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
