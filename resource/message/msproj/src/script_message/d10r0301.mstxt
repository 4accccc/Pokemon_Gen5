	<TextRow
		Label="msg_d10r0301_swrival_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『ああ　じょうとう　だね▼
オレは　うばわれた　ポケモンを
とりもどすため　たたかっている▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『ああ　上等だね▼
オレは　奪われた　ポケモンを
取り戻すため　戦っている▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてswrival_06</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
