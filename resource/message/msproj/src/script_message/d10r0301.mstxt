				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d10r0301_swrival_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ロットの　じいさん！
もとプラズマだん！▼
オマエら　なんのため
ポケモンと　いっしょに　いる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ロットの　じいさん！
元プラズマ団！▼
オマエら　なんのため
ポケモンと　一緒に　いる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ロットたちを見てメッセージ表示
・ロットたちに？マーク後
　再度前を向く
・続けて</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d10r0301_swrival_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だいじな　ものを　まもるためだろ！▼
たいせつな　ポケモンが！
じぶんの　しんねんが！　きずついても▽
たたかうときって　ないのかよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大事な　ものを　守るためだろ！▼
大切な　ポケモンが！
自分の　信念が！　傷ついても▽
戦うときって　ないのかよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてswrival_07</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d10r0301_swplazmam1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだん『おこさまが
かっこいいこと　いってんなよ！▼
とにかく　プラズマフリゲートに
だれも　ちかづけるんじゃない！▽
こいつら　まとめて　しまつしろ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマ団『お子様が
かっこいいこと　いってんなよ！▼
とにかく　プラズマフリゲートに
だれも　近づけるんじゃない！▽
こいつら　まとめて　始末しろ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T11:09:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T09:50:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・プラズマ団その１、その２
　ライバル、主人公前に移動する
・続けてswrival_08</Comment>
