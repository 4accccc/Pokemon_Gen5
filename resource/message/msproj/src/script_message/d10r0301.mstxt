	<TextRow
		Label="msg_d10r0301_swplazmam1_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さすがだな！　モンスターボールで
ポケモンを　しばりつけてるもんな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-13T11:22:19" />
			<Status>Editing</Status>
