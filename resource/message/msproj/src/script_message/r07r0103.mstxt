<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r07r0103_ol__01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かねの　ねいろが　きこえなければ
しあわせに　なれず……▽
そうすれば　あの　ふたりも……▼
ということで　さきに　いかせない！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:24:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鐘の音色が　きこえなければ
幸せに　なれず……▽
そうすれば　あの　二人も……▼
ということで　先に　行かせない！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:25:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・セイガイハ新婚イベントで
　はいを選択すると出現
・表示後、トレーナー戦闘へ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:00:26" />
		</CommentCell>
