			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T13:01:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：クリア後
・退場する</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T13:01:17" />
		</CommentCell>
