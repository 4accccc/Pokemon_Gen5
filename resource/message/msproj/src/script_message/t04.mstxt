	<TextRow
		Label="msg_t04_trainerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ワールドバトルトーナメント……
シロナさんも　さんか　するのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:51:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
