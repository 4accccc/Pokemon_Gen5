<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t04_swrival_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『まてよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:27:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:10:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『待てよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:27:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:10:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・posイベント
・GRIDX=751～574、GRIDZ=299で起動
・画面下からメッセージ表示
　その後ライバル登場
・続けてswrival_02
・1＝ライバル名</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:04" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:58:29" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04_swrival_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どれだけ　つよくなったか
あいてして　やるからさ　みせてみろよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:38:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どれだけ　強くなったか
相手してるからさ　みせてみろよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:38:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・メッセージ後、ポケモン勝負へ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:30:45" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:58:29" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04_swrival_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……なるほど
それなりに　きたえているよな▼
それなら　もし　プラズマだんと
なにか　あったとしても▽
ポケモンを　まもれるよな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:36:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『……なるほど
それなりに　鍛えているよな▼
それなら　もし　プラズマ団と
なにか　あったとしても▽
ポケモンを　守れるよな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:39:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・フィールドに復帰して
・続けてswrival_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:40:23" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:58:29" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04_swrival_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まっ　プラズマだんの　あいては
オレが　するけどな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:36:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まっ　プラズマ団の　相手は
オレが　するけどな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:39:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・別方向をむいてメッセージ表示
・続けてswrival_05</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:40:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:58:29" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04_swrival_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>というわけで　[Name:TrainerName ]！▼
おまえは　ポケモンずかんを
がんばって　うめてろ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:39:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>というわけで　[Name:TrainerName ]！▼
おまえは　ポケモン図鑑を
がんばって　うめてろ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:39:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・メッセージ表示後、画面上
　r13r0201に消えて行く
・画面から消えると、操作可能に
・0＝主人公名</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:40:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:58:29" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
