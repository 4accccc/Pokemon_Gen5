				Time="2012-01-07T08:44:45" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04_sage7_end_11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいていいせきに　ついて
しりたい　ことは　あつまった▼
では　さらばだ！▼
てきながら　あっぱれな
ポケモントレーナー　め！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-13T05:23:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T13:01:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海底遺跡に　ついて
欲しい　情報は　集まった▼
では　さらばだ！▼
敵ながら　天晴れな
ポケモントレーナー　め！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T04:53:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T13:01:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：クリア後
・退場する
　画面外に消えると主人公操作可能に</Comment>
