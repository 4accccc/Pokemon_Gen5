	<TextRow
		Label="msg_t04_swrival_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おたがい　どれだけ　ポケモンを
そだてたか　たしかめようぜッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-19T10:06:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おたがい　どれだけ　ポケモンを
育てたか　確かめようぜッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-19T10:06:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:28:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・メッセージ後、ポケモン勝負へ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T01:30:45" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
