	</TextRow>
	<TextRow
		Label="msg_t04_swrival_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かつのは　オレたち　だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T11:27:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
