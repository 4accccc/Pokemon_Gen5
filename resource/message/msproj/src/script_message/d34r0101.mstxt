<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d34r0101_swbell_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンだあ……！▼
こんなところに　かくれているなんて
すごい　ポケモン　なのかも？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T06:15:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンだあ……！▼
こんなところに　隠れているなんて
すごい　ポケモン　なのかも？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T06:15:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・隠し穴マップ
・GRIDX＝15、GRIDZ＝15まで誘導
　ベルはGRIDX＝16、GRIDZ＝15
・続けてswbell_13</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-08T11:08:39" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-08T11:08:39" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T06:15:31" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d34r0101_swbell_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごいね！　だいはっけん！
だいはっけん　だよお！▼
ほかにも　かくしあなが　あるか
いろんな　きを　しらべてみるね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T12:22:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-08T11:08:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごいね！　大発見！
大発見　だよお！▼
他にも　隠し穴が　あるか
いろんな　木を　調べてみるね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T06:15:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-08T11:08:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・隠し穴マップ
・主人公と向き合ってメッセージ表示
・メッセージ表示後、ベルだけ退場
　画面外に消えると主人公操作可能に</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-08T11:08:39" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-08T11:08:39" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T06:15:32" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
