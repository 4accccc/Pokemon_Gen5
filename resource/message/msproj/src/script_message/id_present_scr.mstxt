	</TextRow>
	<TextRow
		Label="msg_id_present_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おう　いいですネ▼
では　どれだけ　おおくの　ひとと
ポケモンこうかん　したか▽
わたしが　チェックするヨ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おう　いいですネ▼
では　どれだけ　多くの　人と
ポケモン交換　したか▽
わたしが　チェックするヨ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
