<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_id_present_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンこうかん　で
せかいと　つながる！▽
せかいは　ひろがる！▼
いろんな　ひと　と
ポケモンこうかん　すれば▽
アナタ　ハッピーに　なれるヨ！▼
なぜなら　わたしが
いい　ものを　あげるからネ！▼
というわけで　トレーナーさん▼
アナタ　いろんな　ひとと
ポケモンこうかん　してますカ？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモン交換で
世界と　つながる！▽
世界は　ひろがる！▼
いろんな　人と
ポケモン交換すれば▽
アナタ　ハッピーに　なれるヨ！▼
なぜなら　わたしが
いい　ものを　あげるからネ！▼
というわけで　トレーナーさん▼
アナタ　いろんな　人と
ポケモン交換　してますカ？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回
・はい/いいえ
　はい→present_03
　いいえ→present_04</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_id_present_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コンニチハ！　トレーナーさん▼
アナタ　いろんな　ひとと
ポケモンこうかん　してますカ？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
