	<TextRow
		Label="msg_id_present_11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんと！　ワンダフル！
アナタ　[Digit:2digits Idx="0" ]にん　いじょうと▽
こうかん　したのネ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
