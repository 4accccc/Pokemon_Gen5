	<TextRow
		Label="msg_id_present_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いろんな　ひとと
ポケモンこうかん　してみてヨ！▼
わたしが
いい　ものを　あげるし▽
なにより　たのしいヨ！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いろんな　人と
ポケモン交換　してみてヨ！▼
わたしが
いい　ものを　あげるし▽
なにより　楽しいヨ！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
