	<TextRow
		Label="msg_id_present_13"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アナタ　ほんとうに　すごいネ！
うれしいから　これも　あげるヨ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
