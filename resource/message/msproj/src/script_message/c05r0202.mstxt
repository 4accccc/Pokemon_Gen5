<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c05r0202_boy3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくが　なまえを　つけた
ポケモンを　だいじに　してよね！▽
どうぐも　もたせたんだから！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:49:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくが　名前を　つけた
ポケモンを　大事に　してよね！▽
道具も　持たせたんだから！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:49:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・下記動作モデルと一歩あけて配置
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T08:18:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY3</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:45:39" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0202_girl3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごーい！　むせんだと　とおくでも
ポケモンこうかんが　できるのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:47:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:44:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごーい！　無線だと　遠くでも
ポケモン交換が　できるのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:49:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:44:20" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・上記動作モデルと一歩あけて配置
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T08:18:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL3</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:45:43" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0202_lady_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がいこくに　あそびに　きて
いきなり　ポケモンこうかん……▼
こどもって　すぐ　ともだちを　つくる
さいのうの　もちぬし　なのね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:54:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:53:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>外国に　遊びに　来て
いきなり　ポケモン交換……▼
こどもって　すぐ　友達を　つくる
才能の　持ち主なのね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:54:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:53:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T08:18:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LADY</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-02T07:53:00" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>