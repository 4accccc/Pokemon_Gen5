	<TextRow
		Label="msg_d08_hakase1_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おっと！
かたい　はなしに　なったね▼
こんな　ときは
あまいもの　だよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:15:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T03:55:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おっと！
かたい　話に　なったね▼
こんな　ときは
甘いもの　だよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:15:37" />
			<Status>Editing</Status>
