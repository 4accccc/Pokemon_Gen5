		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d08_hakase1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アララギ『おお！
おまえさんも　きたのかい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T05:02:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T03:15:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アララギ『おお！
おまえさんも　来たのかい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T05:02:21" />
			<Status>Editing</Status>
