	<TextRow
		Label="msg_d08_champion_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『ああ　そうなのだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
