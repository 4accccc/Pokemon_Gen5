		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それでは　また　あおうぞ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T05:21:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T05:20:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それでは　また　会おうぞ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T05:21:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T05:21:07" />
		</LanguageCell>
