	<TextRow
		Label="msg_r06r0301_middlewoman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　あなたの　ポケモン
げんき　いっぱいって　かんじね！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　あなたの　ポケモン
元気一杯って　感じね！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
