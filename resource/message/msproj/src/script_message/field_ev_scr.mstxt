				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_fld_ev_spray_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>スプレーの　こうかが　きれた！
つづけて　つかいますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T04:10:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>スプレーの　効果が　切れた！
続けて　使いますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T04:10:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>アイテム「むしよけスプレー」系の効果が切れて
スプレーの個数が1個以上のとき</Comment>
			<CommentModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-08-16T07:23:26" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_fld_ev_spray_03"
		Style="Large">
