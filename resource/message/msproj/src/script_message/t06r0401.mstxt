	<TextRow
		Label="msg_t06r0401_cliff_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>仮メッセージ▼
かたい　がんばんに　３つの
おおきな　きれつが　はいっている……</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:47:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T06:34:56" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仮メッセージ▼
かたい　がんばんに　３つの
おおきな　きれつが　はいっている……</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:47:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T06:35:32" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ケルディオイベント用
・起動条件を満たしている場合はcliff_02へ
・満たしていない場合はイベント終了</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:48:23" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BG
</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:46:42" />
		</AttributeCell>
