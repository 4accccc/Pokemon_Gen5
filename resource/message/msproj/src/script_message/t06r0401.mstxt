<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t06r0401_cliff_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんばんに　３ぼんの　するどく
みごとな　さけめが　きざまれている！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-19T10:35:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T06:34:56" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>岩盤に　３本の　するどく
みごとな　裂け目が　刻まれている！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-19T10:35:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T06:35:32" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ケルディオイベント用
・起動条件を満たしている場合はcliff_02へ
・満たしていない場合はイベント終了</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:48:23" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BG
</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:46:42" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T06:22:01" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t06r0401_cliff_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モンスターボールに　はいっている
[Name:PokemonNickname ]が▽
でたがっている　ようだ……！▼
そとに　だして　あげますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-19T10:27:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:50:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モンスターボールに　入っている
[Name:PokemonNickname ]が▽
でたがっている　ようだ……！▼
外に　だして　あげますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-19T10:27:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:51:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ケルディオイベント用
・0＝ポケモンニックネーム
・はい/いいえ選択肢分岐
　　はい　⇒ボールから飛び出す演出
　　　　　　　小芝居後、cliff_04へ
　　いいえ⇒cliff_03へ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:55:32" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SYS</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T02:48:35" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T06:22:04" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t06r0401_cliff_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モンスターボールの
うごきが　とまったようだ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
