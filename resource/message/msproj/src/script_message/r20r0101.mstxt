<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r20r0101_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんにちは！　ヒウンシティいきの
ふねは　タチワキシティから　でてます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんにちは！　ヒウンシティ行きの
船は　タチワキシティから　出航です</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW
受付嬢</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r20r0101_trainerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆれる　くさむらに　ひそむ
タブンネという　ポケモン▼
どうして　あんなに　たくさんの
けいけんちが　もらえるのだろう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T03:53:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>揺れる　草むらに　潜む
タブンネという　ポケモン▼
どうして　あんなに　たくさんの
経験値が　もらえるのだろう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T03:53:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T03:53:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r20r0101_girl2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あるいていると　くさむらが　ゆれる！
ポケモンの　かくれんぼ　だよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T03:51:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T03:50:36" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あるいていると　くさむらが　ゆれる！
ポケモンの　かくれんぼ　だよね！</Text>
