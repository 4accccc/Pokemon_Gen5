<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r20r0101_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんにちは！　ヒウンシティいきの
ふねは　タチワキシティから　でてます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんにちは！　ヒウンシティ行きの
船は　タチワキシティから　出航です</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW
受付嬢</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r20r0101_trainerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょいと　コンビナートに　いって
ほのおポケモンを　つかまえようかな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T05:52:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちょいと　コンビナートに　行って
ほのおポケモンを　捕まえようかな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T05:52:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・重複情報</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T05:52:39" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERM</Text>
