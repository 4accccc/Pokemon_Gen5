		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r20r0101_infomationw_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よく　いうでしょ
たびはみちづれ　よはなさけ　って！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T07:31:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T07:30:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よく　いうでしょ
旅は道連れ　世は情け　って！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T07:31:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T07:31:32" />
		</LanguageCell>
