	</TextRow>
	<TextRow
		Label="msg_h03_badrider1_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オイ！　そこの　テメーっ！
ちょっと　ツラ　かせやァ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オイ！　そこの　テメーっ！
ちょっと　ツラ　かせやァ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
