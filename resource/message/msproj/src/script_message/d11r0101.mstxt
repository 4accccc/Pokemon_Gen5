			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T12:57:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBOSS
アクロマ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
