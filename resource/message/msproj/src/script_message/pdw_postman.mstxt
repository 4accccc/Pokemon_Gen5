<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_pdw_postman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これは　あなたの
ポケモンの　みた　ゆめが▽
げんじつに　なった　カケラ　です▼
おわたし　します▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これは　あなたの
ポケモンの　みた　夢が▽
現実に　なった　カケラ　です▼
お渡しします▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>配達員に話しかけたときのメッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>？？？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_pdw_postman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいの　ゆめの　カケラは
すべて　おわたし　しました▼
また　ポケモンが　ゆめを　みたら
ここに　くると　いいでしょう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今回の　夢の　カケラは
すべて　お渡ししました▼
また　ポケモンが　夢を　みたら
ここに　来ると　いいでしょう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>配達員に話しかけたとき、配達員スロットが
すでに空っぽだったときのメッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>？？？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_pdw_postman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　ポケモンが　ゆめを　みたら
ここに　くると　いいでしょう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　ポケモンが　夢を　みたら
ここに　来ると　いいでしょう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>受け取ったあとの挨拶メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>？？？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_pdw_postman_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]は
どうぐ　を　うけとった！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]は
道具を　受け取った！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>アイテムをうけとったとき
0＝主人公名
1＝道具名</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>？？？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_pdw_postman_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……「[Name:Item Idx="0" ]」が
バッグに　いっぱいの　ようですね▼
「[Name:Item Idx="0" ]」を　へらしたら
のこりの　カケラを　わたしましょう▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……「[Name:Item Idx="0" ]」が
バッグに　一杯の　ようですね▼
「[Name:Item Idx="0" ]」を　減らしたら
残りの　カケラを　わたしましょう▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>どうぐを受け取ろうとしたときに
すでにそのどうぐがいっぱいだったときのメッセージ
０：どうぐの名前</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>？？？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
	</TextRow>
