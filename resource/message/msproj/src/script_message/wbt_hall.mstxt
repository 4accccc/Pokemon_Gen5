	<TextRow
		Label="msg_wbt_announce_08a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それでは　ほかの　たいせんけっかを
ビジョンにて　ごかくにん　くださいッ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
