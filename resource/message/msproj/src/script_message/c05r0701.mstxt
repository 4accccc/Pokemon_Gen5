	<TextRow
		Label="msg_c05r0701_trainew_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トーナメントに　かちぬけば　ＢＰ！
つまり　バトルポイントが　もらえる！▼
だから　ＢＰを　ためて
いいモノに　こうかん　するんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T11:53:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-19T03:02:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トーナメントに　勝ち抜けば　ＢＰ！
つまり　バトルポイントが　もらえる！▼
だから　ＢＰを　貯めて
いいモノに　交換するんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T11:53:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-19T03:02:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・GRIDX＝8、GRIDZ＝11</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-19T02:56:59" />
		</CommentCell>
