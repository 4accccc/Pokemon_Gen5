				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0701_girl4_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　トレーナーさん
わざわざ　きてくださるなんて！▼
ほんじつも　わたくしの　おねがい
きいて　くださる　かしら？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　トレーナーさん
わざわざ　来てくださるなんて！▼
本日も　わたくしの　お願い
きいて　くださる　かしら？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・2回目以降
　クエストを受けていても日が変われば
　このメッセージから開始
・このメッセージ表示段階で
　技マシンで覚えられる技の中からランダムで選択
・はい/いいえ
　はい→girl4_03 or girl4_03a
　いいえ→girl4_04</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL4
お嬢様</Text>
			<TextModifiedBy
