	<TextRow
		Label="msg_t06r0301_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もっと　たくさんの　ポケモンと
いっしょなのも　たのしいかもね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
