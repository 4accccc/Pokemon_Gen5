				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plwc10_16_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたくし　きがかわったわ▼
あなたのほかに　ステキなヒトを
みつけてしまったの……▽
ごめんあそばせ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたくし　気が変わったわ▼
あなたの他に　ステキなヒトを
見つけてしまったの……▽
ごめんあそばせ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
