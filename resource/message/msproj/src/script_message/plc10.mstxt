			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plwc10_16_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シオリ『このまちは　つよいヒトが
いないから　なんだか　タイクツね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シオリ『この街は　強いヒトが
いないから　なんだか　タイクツね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
