				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plwc10_09_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トモタカ『どうも　こんにちは▼
さいきん　しごとが
はかどらなくて　こまりものです▼
ブラックシティなら　バリバリ
しごとが　できそう　なんですけど……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トモタカ『どうも　こんにちは▼
最近　仕事が
はかどらなくて　困りものです▼
ブラックシティなら　バリバリ
仕事が　できそう　なんですけど……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
