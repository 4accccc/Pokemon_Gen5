	<TextRow
		Label="plwc10_16_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>れいを　いうわ
あたらしい　であいが　たのしみね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>礼を　言うわ
新しい　出会いが　楽しみね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
