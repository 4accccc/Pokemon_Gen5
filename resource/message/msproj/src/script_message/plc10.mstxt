				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plbc10_14_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒロミ『ホワイトフォレストに　いくの！▼
いっかしょに　とどまるより
いろんな　ところ　みたいしね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒロミ『ホワイトフォレストに　行くの！▼
一箇所に　とどまるより
いろんな　ところ　見たいしね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
