				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plwc10_17_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ！　ゴメン！▼
やっぱり　ちがうブラックシティに
いくことにしたよ　ソーリー</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
