				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plwc10_14_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むー　おねがいしたのにー！
しょんぼり……</Text>
