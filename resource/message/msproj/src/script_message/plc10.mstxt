	<TextRow
		Label="plwc10_30_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はっきりとした　そのこたえ
それも　うつくしいわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
