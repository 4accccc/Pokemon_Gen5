				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plbc10_21_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トシノブ『これから
ホワイトフォレストに　いくんだ▼
しぜんに　みをゆだねる　せいかつ
たのしみだな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トシノブ『これから
ホワイトフォレストに　行くんだ▼
自然に　身をゆだねる　生活
楽しみだな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
