		<LanguageCell
			Language="JPN">
			<Text>きが　かわった！
ちがうまちに　たびだつことにした！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
