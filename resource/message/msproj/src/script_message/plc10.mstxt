				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plbc10_12_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レナ『……うん▼
ここは　さわがしくて
こころが　やすまらないわ……</Text>
