	<TextRow
		Label="plbc10_16_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>れいをいうわ▼
ゆっくり　ポケモンとのくらしを
たのしんでみる</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>礼をいうわ▼
ゆっくり　ポケモンとの暮らしを
楽しんでみる</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
