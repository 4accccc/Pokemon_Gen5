				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plbc10_13_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カルロス『じゅうぶん　だいとかいを
あじわったし　もう　いいかなー！▼
きみさ　ホワイトフォレストに
ぼくを　つれていって　くれないかな？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カルロス『じゅうぶん　大都会を
味わったし　もう　いいかなー！▼
きみさ　ホワイトフォレストに
ぼくを　連れていって　くれないかな？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
