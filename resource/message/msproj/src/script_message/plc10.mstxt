	<TextRow
		Label="plbc10_08_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そんなー……
つぎは　おねがいしますね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
