				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plwc10_03_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タクロウ『そっちの　ブラックシティ
すげー　かがやいてるな▽
オレも　そっちに　いきたいぜ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タクロウ『そっちの　ブラックシティ
すげー　輝いてるな▽
オレも　そっちに　行きたいぜ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
