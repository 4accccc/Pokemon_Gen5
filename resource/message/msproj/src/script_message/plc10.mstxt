				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plbc10_07_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タクマ『うでだめしも　じゅうぶんだ
そろそろ　しゅぎょうが　したいな！▼
よかったら　ホワイトフォレストに
おれを　つれていって　くれないか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タクマ『腕試しも　じゅうぶんだ
そろそろ　修行が　したいな！▼
よかったら　ホワイトフォレストに
おれを　連れていって　くれないか？</Text>
