				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plwc10_15_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツネカズ『ぶんめいの　しんか！
それを　まぢかで　かんじられる……▽
ブラックシティが　わたしは　すきだ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツネカズ『文明の　進化！
それを　間近で　感じられる……▽
ブラックシティが　わたしは　好きだ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
