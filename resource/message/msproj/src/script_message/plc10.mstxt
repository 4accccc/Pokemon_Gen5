			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plbc10_07_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>う……　ごめん
べつのひとに　さそわれていた</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
