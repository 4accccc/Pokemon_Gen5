				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plwc10_26_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ああ　やっぱり
べつの　ブラックシティに▽
いくことにしたよ▼
そこに　ぼくのもとめる
こたえが　ある！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ああ　やっぱり
別の　ブラックシティに▽
行くことにしたよ▼
そこに　ぼくの求める
答えが　ある！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
