	</TextRow>
	<TextRow
		Label="plwc10_09_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うーん　そうですか……
ひが　わるかったって　ことで！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うーん　そうですか……
日が　悪かったって　ことで！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
