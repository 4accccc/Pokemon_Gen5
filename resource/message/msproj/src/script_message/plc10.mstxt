	<TextRow
		Label="plbc10_23_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うれしいな▼
ホワイトフォレストでの　くらし
たのしみだよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
