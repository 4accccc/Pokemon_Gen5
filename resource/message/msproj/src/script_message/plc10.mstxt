				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plwc10_17_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒトシ『もう　ゆったりとした
せいかつに　あきちゃったんだよね▼
きみの　ブラックシティに
つれていってくれない？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒトシ『もう　ゆったりとした
生活に　飽きちゃったんだよね▼
きみの　ブラックシティに
連れていってくれない？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
