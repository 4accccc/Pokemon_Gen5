	<TextRow
		Label="plwc10_25_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ブラックシティで　トレーナーとしての
うでまえを　きわめてみせる！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
