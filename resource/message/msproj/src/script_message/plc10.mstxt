	<TextRow
		Label="plbc10_21_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ごめん　やっぱり
ほかのひとに　ついていくことにしたよ▽
わるいね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
