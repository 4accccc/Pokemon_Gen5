	<TextRow
		Label="plbc10_27_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いやーん！▼
じゅうじつした　まいにち！
たのしみだわ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いやーん！▼
