	<TextRow
		Label="plbc10_13_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おー！　サンキューだよ！
じゃー　ホワイトフォレストへ　おさき！▽
また　あとでねー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おー！　サンキューだよ！
じゃー　ホワイトフォレストへ　お先！▽
また　あとでねー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
