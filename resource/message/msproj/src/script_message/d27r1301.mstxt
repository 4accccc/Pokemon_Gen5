	<TextRow
		Label="msg_d27r1301_barrier_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あぶない！
バリアは　でんりゅうで　ビリビリだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T03:24:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T03:24:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>危ない！　バリアには
高圧電流が　流れている！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T03:24:12" />
			<Status>Editing</Status>
