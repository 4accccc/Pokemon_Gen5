		<CommentCell
			Language="JPN">
			<Comment>イベント
・Black2ver
・カードキー（仮）を持っていない</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-08T08:19:35" />
		</CommentCell>
