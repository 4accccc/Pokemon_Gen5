	<TextRow
		Label="msg_d27r1301_pass_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうちが　ある……▼
パスワードを　いれるみたいだが
カードキーが　ひつよう　みたいだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T09:15:16" />
			<Status>Editing</Status>
