			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シキミ『……破れた世界
そこに　ただ１匹で　いた　ポケモン▽
なんて　幻想的な　光景！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
