				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04r0401_shirona_spring_02_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シロナ『……ポケモンも　ひとも
その　いのちを　かがやかせるには▼
ぜんしんぜんれいで
つよい　あいてに　いどむことなの▼
だから　あたしも　きみと
たたかいたいけど　いいかしら？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シロナ『……ポケモンも　人も
その命を　輝かせるには▼
全身全霊で
強い　相手に　挑むことなの▼
だから　あたしも　きみと
戦いたいけど　いいかしら？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・春イベント：パターン2
・はい/いいえ選択肢表示
・はい→spring_02_02
　いいえ→spring_02_03</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SHIRONA
シロナ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
