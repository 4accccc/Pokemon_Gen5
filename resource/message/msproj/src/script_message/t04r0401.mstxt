				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04r0401_shirona_summer_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シロナ『……うーん▼
むずかしいわね▼
あれこれ　よくばっちゃって
たくさんの　みずぎを　もってきたら▽
どれに　するか　えらべないの……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シロナ『……うーん▼
難しいわね▼
あれこれ　よくばっちゃって
たくさんの　水着を　持ってきたら▽
どれに　するか　選べないの……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
