	</TextRow>
	<TextRow
		Label="msg_t04r0401_shirona_first_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うふふ
れいせいな　はんだん……　ね▼
じゅんびが　できたら
はなしかけてくれると　うれしいな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うふふ
冷静な　判断……　ね▼
準備が　できたら
話しかけてくれると　うれしいな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
