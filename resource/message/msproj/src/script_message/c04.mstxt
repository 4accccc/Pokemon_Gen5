	<TextRow
		Label="msg_c04_tboss_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>クダリ『ルールを　まもって
あんぜん　うんてん！▼
めざすは　しょうり！
しゅっぱつ　しんこう！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
