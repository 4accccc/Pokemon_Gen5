				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c04_heroine_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あの　ギアステーションって
ちかてつの　なかで▽
ポケモンしょうぶが　できるの！▼
でね　うでだめしに　きたら
なんと　サブウェイマスターが　いたの！▼
すごくない？　だって
ギアステーションで　いちばん　つよい▽
トレーナー　なんだよ！▼
しかも　２ｖｓ２なら　とくべつに
ここで　あいて　してくれる　って！▼
すっごい　チャンスでしょ！
おねがい！　いっしょに　たたかって？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あの　ギアステーションって
地下鉄の　中で▽
ポケモン勝負が　できるの！▼
でね　腕試しに　来たら
なんと　サブウェイマスターが　いたの！▼
すごくない？　だって
ギアステーションで　一番　強い▽
トレーナー　なんだよ！▼
しかも　２ｖｓ２なら　特別に
ここで　相手してくれる　って！▼
すっごい　チャンスでしょ！
お願い！　一緒に　戦って？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：主人公♂
・ギアステーション前
　GRIDX=422、GRIDZ=461.上向き
・はい/いいえの選択肢表示
・はい　→heroine_04
　いいえ→heroine_02</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HEROINE</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c04_heroine_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ　そうか！
じゅんびが　できていないのね▼
じゃあ　ふたりを　ひきとめておくから
いっしょに　たたかおうよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ　そうか！
準備が　できていないのね▼
じゃあ　二人を　ひきとめておくから
一緒に　戦おうよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
