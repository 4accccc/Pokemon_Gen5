			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c04_hero_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ　そうか！
じゅんびが　できていないのか▼
じゃあ　ふたりを　ひきとめておくから
いっしょに　たたかおうよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
