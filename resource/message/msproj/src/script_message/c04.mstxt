	<TextRow
		Label="msg_c04_heroine_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ありがとう！▼
あっ　あたし　？？？？？
ちからと　いきを　あわせようね！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ありがとう！▼
あっ　あたし　？？？？？
