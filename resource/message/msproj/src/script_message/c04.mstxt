	<TextRow
		Label="msg_c04_tboss_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>クダリ『ぼく　クダリ▼
きみたちに　まけちゃった▼
だけど　おもしろかった！
また　あそぼうよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>クダリ『ぼく　クダリ▼
きみたちに　負けちゃった▼
だけど　おもしろかった！
また　遊ぼうよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
