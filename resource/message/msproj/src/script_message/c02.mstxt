	<TextRow
		Label="msg_c02_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ただの　そうこ　だったのに
こんなに　にんきが　でるなんて……▽
おばさん　かちかんが　ゆらいじゃうわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
