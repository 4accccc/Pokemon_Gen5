				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02_black_02a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『カゴのみを　ポケモンに
もたせておけば　ねむらされても▽
ポケモンは　かいふくして　めざめる▼
ついでに　アドバイス▼
シッポウシティの　ジムリーダーは
ノーマルタイプの　つかいて▼
かくとうタイプの　ポケモンが　いると
かなり　ゆうり　かもね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレン『カゴのみを　ポケモンに
持たせておけば　眠らされても▽
ポケモンは　回復して　目覚める▼
ついでに　アドバイス▼
シッポウシティの　ジムリーダーは
ノーマルタイプの　使い手▼
かくとうタイプの　ポケモンが　いると
かなり　有利かもね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後、自動で表示
・メッセージ表示後、ライバルだけ画面左へ移動
・画面外に消えると、主人公操作可能</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>友達♂
チェレン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02_boss_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｎ『[Ctrl2:CtrlSpeed mode="1"]ボクは……　ダレにも
みえない　ものが　みたいんだ▼
ボールの　なかの
ポケモンたちの　りそう▼
トレーナーという
ありかたの　しんじつ▼
そして　ポケモンが
かんぜんと　なった　みらい……▼
キミも　みたいだろう？[Ctrl2:CtrlSpeed mode="0"]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｎ『[Ctrl2:CtrlSpeed mode="1"]ボクは……　ダレにも
みえない　ものが　みたいんだ▼
ボールの　中の
ポケモンたちの　理想▼
トレーナーという
在り方の　真実▼
そして　ポケモンが
完全となった　未来……▼
キミも　みたいだろう？[Ctrl2:CtrlSpeed mode="0"]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ジムの前のPOSを踏むと
　画面左から出現
・主人公に隣接してメッセージ表示
・はい/いいえの選択
　どちらを選んだか保存しておく</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>N</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02_boss_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｎ『[Ctrl2:CtrlSpeed mode="1"]そうかい▼
では　ボクと
ボクの　トモダチで▽
みらいを　みることが　できるか▽
キミで　たしかめさせて　もらうよ[Ctrl2:CtrlSpeed mode="0"]▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
