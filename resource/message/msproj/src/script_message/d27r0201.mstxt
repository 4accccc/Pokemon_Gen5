				Time="2011-08-17T09:19:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-25T11:50:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・Black2ver
・アジト船：2回目
　マップ切り替えでイベント開始
・続けてswrival_02_02</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-25T11:52:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-25T11:44:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
