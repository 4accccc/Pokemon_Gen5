	<TextRow
		Label="msg_d27r0201_switch_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すべての　バリアが　かいじょ　され
さきに　すすめるように　なった！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T11:02:37" />
