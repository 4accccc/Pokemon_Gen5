	<TextRow
		Label="msg_d27r0201_barrier_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あぶない！
バリアは　でんりゅうで　ビリビリだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T03:54:37" />
