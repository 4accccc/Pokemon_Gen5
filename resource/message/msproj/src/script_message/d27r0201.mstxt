				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d27r0201_switch_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すべての　バリアが　かいじょ　され
さきに　すすめるように　なった！</Text>
