				Time="2011-08-17T09:18:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-25T11:47:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『……バリアだ▼</Text>
			<TextModifiedBy
