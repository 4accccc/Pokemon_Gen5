	<TextRow
		Label="msg_d20r0501_sys_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かべが　うごき
さきに　すすめるように　なった！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
