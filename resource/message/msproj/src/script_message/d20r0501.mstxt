	<TextRow
		Label="msg_d20r0501_sys_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かべが　うごき
さきに　すすめるように　なった！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>壁が　動き
先に　進めるように　なった！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>システム</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>システム</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d20r0501_sys_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここから　のぼれそうだ！▼
うえの　かいに　すすみますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここから　昇れそうだ！▼
上の階に　進みますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>システム</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d20r0501_bg1_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆうき　あるものよ
おうの　ことばに　みみを　かたむけよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:47:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:46:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勇気　あるものよ
王の　言葉に　耳を　かたむけよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:46:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:46:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ
・考古学者イベント後
・swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:47:36" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_d20r0501_bg2_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そすうを　りかい　するものは
せかいの　しんりを　りかいする</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:47:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:46:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>素数を　理解する者は
世界の　真理を　理解する</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:46:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:46:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ
・考古学者イベント後
・swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:47:39" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_d20r0501_bg3_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おうは　ゆうきを　もつ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T07:46:23" />
			<Status>Editing</Status>
