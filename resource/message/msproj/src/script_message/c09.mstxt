	<TextRow
		Label="msg_c09_veteranm2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンリーグは
すべての　トレーナーに　とって▽
さいだいの　なんかん！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
