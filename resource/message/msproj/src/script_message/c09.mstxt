				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c09_veteranm1_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅんびを　おこたるな！▼
あちらの　いりぐちを　ぬけて
ポケモンの　かいふくなど▽
できるかぎりの　よういを　するのだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>準備を　怠るな！▼
あちらの　入り口を　ぬけて
ポケモンの　回復など▽
できるかぎりの　用意を　するのだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・いいえ選択時</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>VETERANM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T11:59:07" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
