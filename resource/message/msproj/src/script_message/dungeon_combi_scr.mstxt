<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_dungeon_a_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やあ　オレ　ホラって　いうんだ▼
いきなりだが　ここで
あったのも　なにかの　えん▽
アンタに　おねがいが　あるんだぜ！▼
オレ　ホラには　アナっていう
パートナーが　いるんだが▼
そいつに　ひごろの
かんしゃの　きもちを▽
つたえたくてな……▼
でも　じぶんの　くちで
いうのは　はずかしいだろ？▼
だから　アンタに　おねがいするぜ！
「おまえ　さいこうの▽
あいぼう　だぜ！」▽
って　アナに　つたえてくれ！▼
アイツの　いばしょは　しらないが
「ちかすいの　わきあがる▽
ほらあなが　ぜっこうの▽
あなばスポット　だぜ！」▼
とか　いっていたから
そういう　ところに　いそうだな▽
じゃあ　たのんだぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-03T04:32:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T12:15:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やあ　オレ　ホラって　いうんだ▼
