			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T12:17:22" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>BACKPACKERM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T12:19:08" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
