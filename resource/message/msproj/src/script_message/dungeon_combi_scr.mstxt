<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_dungeon_a_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やあ　オレ　ダンって　いうんだ▼
いきなりだが　ここで
あったのも　なにかの　えん▽
アンタに　おねがいが　あるんだぜ！▼
オレ　ダンには　ジョンっていう
あいぼうが　いるんだが▼
そいつに　ひごろの
かんしゃの　きもちを▽
つたえたくてな……▼
でも　じぶんの　くちで
いうのは　はずかしいだろ？▼
だから　アンタに　おねがいするぜ！
「おまえ　さいこうの▽
あいぼう　だぜ！」▽
って　ジョンに　つたえてくれ！▼
アイツの　いばしょは　しらないが
「ちかすいの　わきあがる▽
ほらあなが　ぜっこうの▽
あなばスポット　だぜ！」▼
とか　いっていたから
そういう　ところに　いそうだな▽
じゃあ　たのんだぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T12:15:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T12:15:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>no data</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T12:17:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T12:17:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T12:15:44" />
		</CommentCell>
		<AttributeCell
