	<TextRow
		Label="msg_c05r0302_fighterw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ライモンの　ジムリーダー
カミツレさんの　かみつスケジュール▽
さすが　にんきモデル　だよねえ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:47:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ライモンの　ジムリーダー
カミツレさんの　かみつスケジュール▽
さすが　人気モデル　だよねえ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T08:19:28" />
			<Status>Editing</Status>
