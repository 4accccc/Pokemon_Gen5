				User="matsumiya:W00224"
				Time="2012-01-10T05:10:45" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d03_sign1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このさき　リゾートデザート
いわゆる　ひとつの　さばくです</Text>
