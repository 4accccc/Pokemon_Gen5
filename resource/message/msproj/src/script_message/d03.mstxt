<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d03_middleman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リゾートデザートは　ひろいし
てごわい　ポケモンは　でてくるし▽
うでだめしには　もってこいだな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T06:09:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リゾートデザートは　広大だし
てごわい　ポケモンは　でてくるし▽
腕試しには　もってこいだな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T06:13:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・下記動作モデルと隣接して配置
　GRIDX=386、GRIDZ=490
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T01:44:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:10:43" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d03_boy3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゲートを　ぬけて　そのまま
まっすぐ　すすめば▽
こだいのしろに　いけるはずです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T01:42:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゲートを　抜けて　そのまま
まっすぐ　進めば▽
古代の城に　行けるはずです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T01:42:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・上記動作モデルと隣接して配置
　GRIDX=385、GRIDZ=490
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T01:42:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY3
少年（聡明）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
