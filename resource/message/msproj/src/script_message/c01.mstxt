	<TextRow
		Label="msg_c01_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら！？
あなたの　メダルボックス……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T12:20:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
