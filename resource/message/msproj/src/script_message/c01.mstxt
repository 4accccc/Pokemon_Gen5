	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c01_glasses_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンしょうぶも　たのしめる
おいしい　レストランっす！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:33:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンしょうぶも　たのしめる
おいしい　レストランっす！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:33:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanではストッパー処理を削除
・メッセージ繰り返し</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:32:55" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>DANPEI
ダンペイ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c01_leader1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……え？　ぼくが　このまちの
ジムリーダー　ですけど▽
きみは……？▼
そうですか　ジムに　ちょうせん▼
それで　きみ……
さいしょに　えらんだ▽
ポケモンは　なんですか？▼
[Name:PokemonName Idx="0" ]か……　なるほど
[Name:Type Idx="1" ]タイプが　にがて　なんですね▼
きちんと　たいさく　しておいたほうが
いいと　おもいますよ▼
それでは　なかで　まっていますね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:34:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……え？　ぼくが　この街の
ジムリーダー　ですけど▽
きみは……？▼
そうですか　ジムに挑戦▼
それで　きみ……
最初に　選んだ▽
ポケモンは　なんですか？▼
[Name:PokemonName Idx="0" ]か……　なるほど
[Name:Type Idx="1" ]タイプが　苦手なんですね▼
きちんと　対策しておいたほうが
いいと　思いますよ▼
それでは　中で　待っていますね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:35:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・？マーク表示後にメッセージ表示
・表示後、ジム方面に移動
・画面外に消えると、主人公、操作可能に
・0＝最初に選んだポケモン
・1＝最初に選んだポケモンのタイプ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER1
デント（草）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c01_stop_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおう！
ひかりかがやく　ジムバッジ！▼
それが　８こも！　もっている
おぬしまで　まぶしいわい！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:40:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おおう！
光り輝く　ジムバッジ！▼
それが　８こも！　持っている
おぬしまで　まぶしいわい！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:40:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanではストッパー処理を削除</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:35:48" />
		</CommentCell>
		<AttributeCell
