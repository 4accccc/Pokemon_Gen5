	</TextRow>
	<TextRow
		Label="msg_c01_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わざマシンは　なんどでも
つかえるでしょ！▼
だから　あれこれ　ためしてるけど
やっぱり　まよっちゃうのよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T09:39:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わざマシンは　何度でも
使えるでしょ！▼
だから　あれこれ　試行錯誤してるけど
やっぱり　迷っちゃうのよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T09:39:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
