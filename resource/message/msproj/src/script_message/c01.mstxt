			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T09:45:20" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BREEDERW
ブリーダー♀</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
