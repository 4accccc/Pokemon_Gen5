				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c01_leader1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……え？　ぼくが　このまちの
ジムリーダー　ですけど[Ctrl2:LineFeed ]
きみは……？[Ctrl2:PageClear ]
そうですか　ジムに　ちょうせん[Ctrl2:PageClear ]
それで　きみ……
さいしょに　えらんだ[Ctrl2:LineFeed ]
ポケモンは　なんですか？[Ctrl2:PageClear ]
[Name:PokemonName Idx="0" ]か……　なるほど
[Name:Type Idx="1" ]タイプが　にがて　なんですね[Ctrl2:PageClear ]
きちんと　たいさく　しておいたほうが
いいと　おもいますよ[Ctrl2:PageClear ]
それでは　なかで　まっていますね[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……え？　ぼくが　この街の
ジムリーダー　ですけど[Ctrl2:LineFeed ]
きみは……？[Ctrl2:PageClear ]
そうですか　ジムに挑戦[Ctrl2:PageClear ]
それで　きみ……
最初に　選んだ[Ctrl2:LineFeed ]
ポケモンは　なんですか？[Ctrl2:PageClear ]
[Name:PokemonName Idx="0" ]か……　なるほど
[Name:Type Idx="1" ]タイプが　苦手なんですね[Ctrl2:PageClear ]
きちんと　対策しておいたほうが
いいと　思いますよ[Ctrl2:PageClear ]
それでは　中で　待っていますね[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・？マーク表示後にメッセージ表示
・表示後、ジム方面に移動
・画面外に消えると、主人公、操作可能に
・0＝最初に選んだポケモン
・1＝最初に選んだポケモンのタイプ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER1
デント（草）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
