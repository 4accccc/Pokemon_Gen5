				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanではストッパー処理を削除</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:35:48" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
