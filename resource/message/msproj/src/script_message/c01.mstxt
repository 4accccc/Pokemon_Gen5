				Time="2012-01-10T08:43:39" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01_badman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なつが　まちどおしいな
あの　よるの　こうけいを　みたいね</Text>
