	<TextRow
		Label="msg_c01_glasses_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンしょうぶも　たのしめる
おいしい　レストランっす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-05T12:17:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモン勝負も　楽しめる
おいしい　レストランっす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-05T12:17:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・話しかけ時
・表示後、建物内に入ると
　主人公操作可能</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-05T12:17:01" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>DANPEI
ダンペイ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T08:43:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
