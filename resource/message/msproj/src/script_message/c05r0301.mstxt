				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0301_girl4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わざわざ　きてくださって
かんしゃ　いたしますわ！▼
あなたは　トレーナーさん？▼
……　……　……
……　……　……▼
まあ　ポケモンずかん　を！
それは　ステキ　ですわ！▼
それでは　わたくしの　おねがい
きいて　くださる　かしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わざわざ　きてくださって
感謝いたしますわ！▼
あなたは　トレーナーさん？▼
……　……　……
……　……　……▼
まあ　ポケモン図鑑　を！
それは　ステキ　ですわ！▼
それでは　わたくしの　お願い
きいて　くださる　かしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・初回
・はい/いいえ
　はい→girl4_03 or girl4_03a
　いいえ→girl4_04
・このメッセージ表示段階で
　技マシンで覚えられる技の中からランダムで選択</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL4
お嬢様</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0301_girl4_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　トレーナーさん
わざわざ　きてくださるなんて！▼
ほんじつも　わたくしの　おねがい
きいて　くださる　かしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　トレーナーさん
わざわざ　来てくださるなんて！▼
本日も　わたくしの　お願い
きいて　くださる　かしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・2回目以降
　クエストを受けていても日が変われば
　このメッセージから開始
・このメッセージ表示段階で
　技マシンで覚えられる技の中からランダムで選択
・はい/いいえ
　はい→girl4_03 or girl4_03a
　いいえ→girl4_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL4
お嬢様</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:50:15" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
