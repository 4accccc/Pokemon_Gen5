	<TextRow
		Label="msg_c01gym0101_leader1_20a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イヤッホー！▼
きょうだいで　いちばん　つよい
オレさまと　あそぼうぜ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-30T01:57:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
