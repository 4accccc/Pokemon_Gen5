	<TextRow
		Label="msg_c01gym0101_leader1_04b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コーン『そうなんだよね▼
そして　あなたが　さいしょに
えらんだ　パートナーは▽
[Name:Type Idx="0" ]タイプ　なんだよね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-30T02:01:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
