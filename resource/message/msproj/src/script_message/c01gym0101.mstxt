				Time="2012-01-09T02:34:06" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c01gym0101_leader1c_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくはですね
くさタイプの　ポケモンが　すきな▽
デントと　もうします▼
ジムリーダーを　していましたが
さらに　しょうじん　するため▼
いまは　レストランで　はたらきつつ
ポケモンと　くらす　まいにち　です▼
どうでしょう？　ぼくと　くんで
ダブルバトルを　してもらえませんか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T10:11:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T09:09:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくはですね
くさタイプの　ポケモンが　好きな▽
デントと　申します▼
ジムリーダーを　していましたが
さらに　精進するため▼
いまは　レストランで　働きつつ
ポケモンと　暮らす　毎日です▼
どうでしょう？　ぼくと　組んで
ダブルバトルを　してもらえませんか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T10:16:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T09:09:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・初回
・はい/いいえの選択肢表示
　はい　→leader1c_02
　いいえ→leader1c_03
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T10:04:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER1C
デント（草）</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T09:08:40" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T02:34:06" />
		</AttributeCell>
