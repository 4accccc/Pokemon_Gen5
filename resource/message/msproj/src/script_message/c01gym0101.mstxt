				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c01gym0101_leader1c_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　ぼくで　よろしければ
パートナーとして　まごころを　こめて▽
たたかいに　いどませて　いただきます▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T10:11:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T09:26:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ　はい　ぼくで　よろしければ
真心を　こめて▽
お相手させて　いただきます▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T10:03:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T09:26:53" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択時
・画面暗転、ステージ上にセット
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T10:03:53" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER1C
デント（草）</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T09:08:54" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
