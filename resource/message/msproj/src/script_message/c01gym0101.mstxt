		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER1c
ポッド（火）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
