	<TextRow
		Label="msg_c01gym0101_leader1a_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イヤッホー！▼
きょうだいで　いちばん　つよい
オレさまが　かたせてやるぜ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T10:02:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T09:26:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イヤッホー！▼
兄弟で　一番　強い
オレさまが　勝たせてやるぜ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T10:02:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
