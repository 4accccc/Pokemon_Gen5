	<TextRow
		Label="msg_c03r0801_girl2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしね　あたしね！
ポケモンと　いっしょに　のれる▽
このふねが　だいすき！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしね　あたしね！
ポケモンと　いっしょに　乗れる▽
この船が　だいすき！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
