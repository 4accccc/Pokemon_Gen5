	<TextRow
		Label="msg_c03r0801_gentleman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すまん　すまん
ついつい　はなしこんで　しまった▽
たのしかったよ　ありがとう！</Text>
