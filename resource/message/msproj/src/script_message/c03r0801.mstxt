	<TextRow
		Label="msg_c03r0801_trainerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うみの　むこうには
まだまだ　ポケモンが　いるんだ！▽
ワクワクが　とまらないね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海の　向こうには
まだまだ　ポケモンが　いるんだ！▽
ワクワクが　とまらないね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
