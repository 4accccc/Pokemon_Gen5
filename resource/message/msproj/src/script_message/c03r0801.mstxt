	<TextRow
		Label="msg_c03r0801_girl2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ！　きてき！▼
ちょっと　おはなし　しただけなのに
もう　こんな　じかんに　なっちゃった！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T07:56:27" />
