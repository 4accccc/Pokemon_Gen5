	<TextRow
		Label="msg_c03r0801_hint_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうはねー……▼
ふねの　ひだりがわには　[Digit:1digit Idx="0" ]にん
ふねの　みぎがわには　[Digit:1digit Idx="1" ]にん　いるよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
