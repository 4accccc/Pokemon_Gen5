	<TextRow
		Label="msg_c03r0801_hint_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　きが　むいたら　はなしかけてよ
おじさんが　いつでも　ヒント　だすよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
