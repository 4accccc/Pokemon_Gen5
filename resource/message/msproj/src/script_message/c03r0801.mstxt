				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0801_girl2_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めずらしかった？
わたしの　ポケモン！▼
なかでも　ミノマダムは
わたしの　おきにいりなの！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>珍しかった？
わたしの　ポケモン！▼
中でも　ミノマダムは
わたしの　お気に入りなの！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
