			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0801_businessman_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しごとの　あいまに
いい　しょうぶが　できたよ</Text>
			<TextModifiedBy
