				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0801_girl4_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ワルツの　ステップで　ロイヤルに
ポケモンしょうぶを　えんしゅつよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
