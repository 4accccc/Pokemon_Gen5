	<TextRow
		Label="msg_c03r0801_boy4_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こどもを　おいて　かんぱんで
あいを　かたりあう　パパとママ▽
どうかと　おもうよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T08:13:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>子供を　おいて　甲板で
愛を　語り合う　パパとママ▽
どうかと　思うよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T08:13:39" />
			<Status>Editing</Status>
