	<TextRow
		Label="msg_c03r0801_man3_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……こんなに　しゃべってしまったか
ごめんごめん　でも▽
すごく　たのしかった　ありがとう！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……こんなに　しゃべってしまったか
ごめんごめん　でも▽
すごく　楽しかった　ありがとう！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>お客さん
・長い話後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN3</Text>
			<TextModifiedBy
