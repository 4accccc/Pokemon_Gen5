	<TextRow
		Label="msg_c03r0801_lady_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うみの　うえでの　たいせんというのも
ふぜいが　あって　いいわね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T08:34:42" />
			<Status>Editing</Status>
