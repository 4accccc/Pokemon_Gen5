	<TextRow
		Label="msg_c03r0801_hint_01b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうはねー……▼
ふねの　ひだりがわには　[Digit:1digit Idx="0" ]にん　いて
ふねの　みぎがわには……　いないね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
