	<TextRow
		Label="msg_h01r0201_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんにちは！　こちらから
スカイアローブリッジを　こえると▽
ヤグルマのもり　シッポウシティ　です</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんにちは！　こちらから
スカイアローブリッジを　越えると▽
ヤグルマの森　シッポウシティ　です</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
