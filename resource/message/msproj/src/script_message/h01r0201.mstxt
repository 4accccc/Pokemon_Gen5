	<TextRow
		Label="msg_h01r0201_woman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すっごく　あるいちゃった！
あしが　パンパンよ▼
……　……　……
……　……　……▼
……あのう　あんまり　みないでね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すっごく　歩いちゃった！
脚が　パンパンよ▼
……　……　……
……　……　……▼
……あのう　あんまり　みないでね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
