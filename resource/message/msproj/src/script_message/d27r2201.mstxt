	<TextRow
		Label="msg_d27r2201_swplazmaw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひゅー！
あんた　やるじゃん！▼
じゃあ　あたいは
これを　あげるじゃん！▼</Text>
