			<Comment>♀
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T04:07:34" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LADY</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T04:05:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
