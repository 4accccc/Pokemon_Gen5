	<TextRow
		Label="msg_c07r0401_gentleman_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むむ？　タマゴの　そだちぐあいは
ちょっと　はんだんが　むずかしいね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>むむ？　タマゴの　育ち具合の
判断は　ちょっと　難しいね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
