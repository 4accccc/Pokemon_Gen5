	<TextRow
		Label="msg_c07r0401_gentleman_14"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いやー　きみには
いいものを　みせてもらった！▼
これからも　あいじょう　こめて
ポケモンを　そだててほしいね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いやー　きみには
いいものを　みせてもらった！▼
これからも　愛情　こめて
ポケモンを　育ててほしいね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
