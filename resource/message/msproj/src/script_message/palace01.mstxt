			<Comment>双子娘3：会話終了</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL4</Text>
			<TextModifiedBy
