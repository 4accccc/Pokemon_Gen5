				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_girl4_02_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せつぞくの　しかたは？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
