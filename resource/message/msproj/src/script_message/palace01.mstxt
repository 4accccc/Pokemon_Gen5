	<TextRow
		Label="plc_mono_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　ハイルツリーを　しらべた▼</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-10-25T08:01:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
