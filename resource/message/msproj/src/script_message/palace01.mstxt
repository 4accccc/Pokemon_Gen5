				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_girl4_03_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンが　ゆめから　さめたとき
このもりに　きてください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
