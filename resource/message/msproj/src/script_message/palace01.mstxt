	<TextRow
		Label="plc_sw_girl4_l_07">
		<LanguageCell
			Language="JPN">
			<Text>ぼうけんしゃが　ちからを
あわせれば　ハイリンクに▼
より　おおきな　ちからが
あつまると　おもうわ</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-26T08:31:34" />
			<Status>Editing</Status>
