				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_firststep_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ　ハイリンクへ▼
……　……　……
……おや？▼
そのようすだと　ここが　どこか
わからない　ようじゃな▼</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:15:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:02:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ　ハイリンクへ▼
……　……　……
……おや？▼
その様子だと　ここが　どこか
わからない　ようじゃな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:19:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:21:35" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●初回訪問イベント
初めてハイリンクに来た時に起動
！マーク出してから</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:13:39" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment />
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:21:45" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_firststep_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここは　ハイリンク……
ひとと　ひとを　つなぐ▽
ふしぎな　ばしょじゃ▼
ちかくにいる　ぼうけんしゃと
きょうりょくし　たすけあう　ために▽
ちからを　みがく　ばしょ　でもある▼</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:45:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:02:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここは　ハイリンク……
人と　人を　つなぐ▽
不思議な　場所じゃ▼
近くにいる　冒険者と
協力し　助けあう　ために▽
力を　磨く　場所でもある▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:20:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:21:35" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●初回訪問イベント
爺さん下を向いてから</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:40:41" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment />
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:21:45" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_firststep_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……　……　……ふむ
ことばでは　つたわらない　であろう▼
おぬしも　ぼうけんしゃ　なら
ちからを　みがくのが　よいな……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:21:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:02:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……　……　……ふむ
言葉では　伝わらない　であろう▼
おぬしも　冒険者なら
力を　磨くのが　よいな……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:20:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:21:35" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●初回訪問イベント
主人公を見てから</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:42:38" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment />
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:21:45" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_firststep_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まずは　この　ハイルツリーに
はなしかけて　ミッションを　うけるのじゃ▼
そして　ハイルツリーに
おぬしの　ちからを　とどけてみせよ！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:47:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:02:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まずは　この　ハイルツリーに
話しかけて　ミッションを　受けるのじゃ▼
そして　ハイルツリーに
おぬしの　力を　届けてみせよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:21:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:21:35" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●初回訪問イベント
上を向いてから


→メッセージ送り後、フリームーブ</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:42:46" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment />
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:21:45" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_mission_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うむ　ミッションを
うけることが　できたようじゃな▼
まずは　きのみさがし　か……
はじめての　おまえさんには▽
ちょうどよい　ミッションじゃ▼
よいか！　まちや　みちに
ひかる　ばしょが　あるはずだ▼
そこに　きのみが　おちている！
よおく　しらべて　さがすのだぞ▼
ミッションが　おわったら
また　もどってくるがよい▽
あたらしい　ちからを　さずけよう……▼
はなしは　おわりだ
さあゆけ！　いってくるのだ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:22:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-06T13:39:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うむ　ミッションを
受けることが　できたようじゃな▼
まずは　きのみさがし　か……
はじめての　おまえさんには▽
ちょうどよい　ミッションじゃ▼
よいか！　街や　道に
光る　場所が　あるはずだ▼
そこに　きのみが　落ちている！
よおく　調べて　探すのだぞ▼
ミッションが　おわったら
また　戻ってくるがよい▽
新しい　力を　授けよう……▼
話は　終わりだ
さあゆけ！　いってくるのだ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:22:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:00:00" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●チュートリアルミッション開始前イベント

→メッセージ送り後、ミッション開始</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:02:54" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment />
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:02:58" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_mission_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おお　もどってきたか……▼
むむ
すばらしい　すばらしいぞ！▽
ミッションを　せいこう　させたな！▼
よしよし　やくそく　どおり
あたらしい　ちからを　さずけよう……▼
とは　いってもな
わしが　あたえるのでは　ない▽
ハイルツリーから　うけとるのだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:23:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:12:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おお　戻ってきたか……▼
むむ！
すばらしい　すばらしいぞ！▽
ミッションを　成功させたな！▼
よしよし　約束どおり
新しい　力を　授けよう……▼
とは　いってもな
わしが　与えるのでは　ない▽
ハイルツリーから　受け取るのだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:24:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:35:03" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●チュートリアルミッション成功して戻ってきた
！マーク出してから

→plc_tutorial_mission_05</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:33:49" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_mission_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おお　もどってきたか……▼
……むむ
ざんねん　だったな▽
ミッションは　しっぱい　だったか……▼
さいしょは　むずかしい　だろうが
なんども　ちょうせん　してみるがよい▽
すこしずつ　うまく　なるじゃろう▼
よし　がんばった　おぬしに
これを　やろう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:25:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:25:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おお　戻ってきたか……▼
……むむ
残念だったな▽
ミッションは　失敗だったか……▼
最初は　難しい　だろうが
何度も　挑戦してみるがよい▽
少しずつ　うまく　なるじゃろう▼
よし　がんばった　おぬしに
これを　やろう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:24:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:35:03" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●チュートリアルミッション失敗して戻ってきた
！マーク出してから

→デルダマ入手処理（10個）</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:33:49" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_mission_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さて　やくそく　どおり
あたらしい　ちからを　さずけよう……▼
とは　いってもな
わしが　あたえるのでは　ない▽
ハイルツリーから　うけとるのだ▼</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:33:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:30:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さて　約束どおり
新しい　力を　授けよう……▼
とは　いってもな
わしが　与えるのでは　ない▽
ハイルツリーから　受け取るのだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:25:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:35:03" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●チュートリアルミッション失敗して戻ってきた
デルダマ入手後

→plc_tutorial_mission_05</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:33:51" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_mission_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハイルツリーには　ひとびとの
おもいが　あつまる▼
その　おもいが　きょうめいし
ぼうけんしゃを　たすける▽
デルパワー　となるのじゃ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:26:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:21:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハイルツリーには　人々の
思いが　集まる▼
その思いが　共鳴し
冒険者を　助ける▽
デルパワー　となるのじゃ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:25:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:35:03" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●チュートリアルミッションから戻ってきた
上を向いてから

→plc_tutorial_mission_06</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:34:39" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_mission_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まあ　うけとってみれば　わかるだろう
さあ　ハイルツリーに　はなしかけて▽
デルパワーを　うけとるのじゃ！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:48:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:34:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まあ　受け取ってみれば　わかるだろう
さあ　ハイルツリーに　話しかけて▽
デルパワーを　受け取るのじゃ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T12:26:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:35:03" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●チュートリアルミッションから戻ってきた
主人公を見てから

→メッセージ送り後、フリームーブ</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:34:51" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_power_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>デルパワーを　うけとれた　ようじゃな▼
これで　おぬしも
りっぱな　ぼうけんしゃ　じゃ▼
デルパワーを　つかえば
ちかくにいる　ぼうけんしゃを▽
たすけることが　できるのじゃ！▼
ただし　デルパワーを　つかうには
デルダマが　ひつよう　じゃぞ▼
ときどき　ミッションを　うけて
デルダマを　あつめるのが　よいだろう▼
……さてさて
おしえられるのも　ここまでじゃ▼
あとは　おぬしが　かんがえ
こうどうして　おぼえる　のじゃ▼
すばらしい　ぼうけんの
たびに　なることを　いのろう……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:14:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:36:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>デルパワーを　受け取れた　ようじゃな▼
これで　おぬしも
立派な　冒険者じゃ▼
デルパワーを　使えば
近くにいる　冒険者を▽
助けることが　できるのじゃ！▼
ただし　デルパワーを　使うには
デルダマが　必要じゃぞ▼
ときどき　ミッションを　受けて
デルダマを　集めるのが　よいだろう▼
……さてさて
教えられるのも　ここまでじゃ▼
あとは　おぬしが　考え
行動して　覚える　のじゃ▼
すばらしい　冒険の
旅に　なることを　いのろう……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:14:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:47:48" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●デルパワーを登録して戻ってきた
上を向いてから

→plc_tutorial_power_02</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:49:28" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_tutorial_power_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>デルパワーは　Ｃギアの
すれちがいログから　つかえます▼
すれちがいログの　がめんにある
みどりいろの　さんかくマークを▽
タッチしてみて　ください</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:14:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:49:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>デルパワーは　Ｃ－ＧＥＡＲの
すれ違いログから　使えます▼
すれ違いログの　画面にある
緑色の　さんかくマークを▽
タッチしてみて　ください</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-25T05:17:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:51:35" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●デルパワーを登録して戻ってきた
システムウインドウで

→メッセージ送り後、フリームーブ</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:49:54" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment />
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-13T12:51:36" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T02:16:51" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
