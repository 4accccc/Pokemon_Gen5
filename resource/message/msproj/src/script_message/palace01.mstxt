	<TextRow
		Label="plc_mono_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　ハイルツリーを　しらべた▼</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-10-25T08:01:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-10-25T07:57:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の　ハイルツリーを　調べた▼</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-10-25T08:01:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
