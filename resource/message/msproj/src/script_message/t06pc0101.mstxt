	<TextRow
		Label="msg_t06pc0101_man2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとこと　アドバイス！
キズぐすりは　いつも　おおめにね！▼
もうひとこと　アドバイス！
モンスターボールも　たくさんね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T03:09:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一言　アドバイス！
キズぐすりは　いつも　多めにね！▼
もう一言　アドバイス！
モンスターボールも　たくさんね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T03:09:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN2
青年お洒落</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
