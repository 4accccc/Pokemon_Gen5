	<TextRow
		Label="msg_oldc01r0501_old_bigfour3_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レンブ『おお　きいたぞ！
やくしゃ　ふっき　するそうだな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-04T09:14:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-04T08:59:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レンブ『おお　きいたぞ！
役者復帰　するそうだな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T03:48:32" />
			<Status>Editing</Status>
