	<TextRow
		Label="msg_oldc01r0501_old_bigfour3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ししょうッ！！
よばれて　まいりましたぞ！▼</Text>
			<TextModifiedBy
