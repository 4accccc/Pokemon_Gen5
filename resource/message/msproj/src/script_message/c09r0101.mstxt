		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c09r0101_bigfour1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アタシの　ポケモン
そして　ちょうせんしゃの　ポケモン▼
みんな　きずつきながらも
たたかってくれて……　ありがとうね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T09:34:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アタシの　ポケモン
そして　挑戦者の　ポケモン▼
みんな　傷つきながらも
戦ってくれて……　ありがとうね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T09:34:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：クリア前
・戦闘後：フィールド</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>四天王：ゴースト
シキミ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
