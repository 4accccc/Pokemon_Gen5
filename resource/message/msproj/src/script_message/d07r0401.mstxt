	<TextRow
		Label="msg_d07r0401_fossil_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　あしたに　なれば
カセキの　いっこぐらい　みつかるから▽
よければ　あそびに　くるべ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
