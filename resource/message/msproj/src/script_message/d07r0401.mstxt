				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d07r0401_fossil_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうやって　なんにもないところを
さがすと　いいものが　みつかるべよ！▼
ほら！　さっきも　カセキが
みつかったからよ　もってけよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こうやって　なんにもないところを
探すと　いいものが　みつかるべよ！▼
ほら！　さっきも　カセキが
みつかったからよ　持ってけよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・クリア後＋アイテム入手前
・以下のアイテムをランダムで１個入手
　No099「ねっこのカセキ」
　No100「ツメのカセキ」
　No101「かいのカセキ」
　No102「こうらのカセキ」
　No103「ひみつのコハク」
　No104「たてのカセキ」
　No105「ずがいのカセキ」</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:41" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d07r0401_fossil_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　あしたに　なれば
カセキの　いっこぐらい　みつかるから▽
よければ　あそびに　くるべ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　明日に　なれば
カセキの　１個ぐらい　みつかるから▽
よければ　遊びに　来るべ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・クリア後＋アイテム入手後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:41" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d07r0401_workman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どーも　こんにちは！
おじさん　じゅうきマニア　だよ！▼
と　いうわけで　キミ！
はたらく　くるまは　すきかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どーも　こんにちは！
おじさん　じゅうきマニア　だよ！▼
と　いうわけで　キミ！
はたらく　くるまは　すきかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:48:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:48:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=52、GRIDX＝13
・はい/いいえの選択肢表示
　はい　→
　いいえ→
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:39:28" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:31" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d07r0401_workman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おお！　やっぱり！？
いいよね！　はたらく　くるま！▼
そんな　キミに　いきなり　だけど
クイズ　だしちゃうよ！▼
クイズは　ぜんぶで　５もん！
ぜんもん　せいかい　したら▽
プレゼント　あげちゃうかもよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おお！　やっぱり！？
いいよね！　はたらく　くるま！▼
そんな　キミに　いきなり　だけど
クイズ　だしちゃうよ！▼
クイズは　ぜんぶで　５もん！
ぜんもん　せいかい　したら▽
プレゼント　あげちゃうかもよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:48:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:48:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択時
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:39:42" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:35" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d07r0401_workman2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えっ！？　ゴメン
よく　きこえなかったんだけど▼
もう１ど　きくよ！
はたらく　くるまは　すきかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:38:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>えっ！？　ゴメン
よく　きこえなかったんだけど▼
もう１ど　きくよ！
はたらく　くるまは　すきかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T12:48:49" />
			<Status>Editing</Status>
