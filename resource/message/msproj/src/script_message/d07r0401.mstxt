	<TextRow
		Label="msg_d07r0401_fossil_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうやって　なんにもないところを
さがすと　いいものが　みつかるべよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こうやって　なんにもないところを
探すと　いいものが　みつかるべよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
