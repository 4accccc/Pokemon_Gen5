	<TextRow
		Label="msg_d09r1401_bigfour3_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『そうとも▼
そして　だれも
じぶんからは　にげられない▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
