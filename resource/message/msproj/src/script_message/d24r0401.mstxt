				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d24r0401_swbell_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒードランってのは　ぜんしんを
マグマの　ような　けつえきが▽
ながれている　ポケモンなんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T02:04:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:30:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒードランってのは　全身を
マグマの　ような　血液が▽
流れている　ポケモンなんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T02:04:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:32:31" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・振り向き</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:30:23" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:24:16" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T05:58:23" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d24r0401_poke485_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かざんのおきいしが
はんのう　している……▽
ここに　おいてみますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:59:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>かざんのおきいしが
反応している……▽
ここに　置いてみますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:59:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・ver
・No「かざんのおきいし」所有時で
　pos（GRIDX＝9～11、GRIDZ＝16）
・はい/いいえの選択肢表示
　はい　→poke485_02
　いいえ→終了</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T12:06:45" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TPOKE
ポケモン・ヒードラン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:59:51" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
