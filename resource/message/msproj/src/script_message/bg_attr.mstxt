	</TextRow>
	<TextRow
		Label="bg_msg_shoprack1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いろとりどりの　ポケモン　グッズが
にぎやかに　ならべられている！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>色とりどりの　ポケモン　グッズが
にぎやかに　並べられている！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>配置モデル
普通の棚１</Text>
