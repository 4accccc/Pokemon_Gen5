	<TextRow
		Label="msg_t07r0101_03_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュちほうを　おうだんする
ひこうきの　ためだけに　できたのが▽
この　ヤマジタウンさ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
