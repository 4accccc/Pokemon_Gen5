	<TextRow
		Label="msg_h01r0101_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>スカイアローブリッジは
ひたすら　じょうぶさを　もとめて▽
つくられた　はし　なんだってよ▼
どんな　ポケモンたちが
どんな　きもちで　つくったんだろうな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T03:02:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>スカイアローブリッジは
ひたすら　強度を　求めて▽
造られた　橋なんだってよ▼
どんな　ポケモンたちが
どんな　気持ちで　造ったんだろうな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T03:02:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T02:23:53" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN
山男</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T04:05:59" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
