	<TextRow
		Label="msg_r09r0101_man3_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シリンダーブリッジだが
ちょうさの　けっか▽
４９３４にん　のれるのが　わかった！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T02:56:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
