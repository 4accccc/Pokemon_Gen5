<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r09r0101_boy2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュに　ある　すべての
はしを　わたりおえたとき▽
アイツが　すがたを　みせる！▼
という　としでんせつを　つくりたいな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T02:40:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッシュに　ある　すべての
橋を　渡り終えたとき▽
アイツが　姿を　みせる！▼
という　都市伝説を　つくりたいな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T02:40:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・橋ゲート
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T09:18:58" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY2
活発</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r09r0101_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ショッピングモールの　そうこに
ロトムという　ポケモンを　つれていく▽
トレーナーが　いるけど……▽
みんな　なにを　しているのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T06:01:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ショッピングモールの　倉庫に
ロトムという　ポケモンを　連れていく▽
トレーナーが　いるけど……▽
みんな　なにを　しているのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T06:01:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・橋ゲート
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T09:18:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2
お洒落（金髪）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r09r0101_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ストップ！▼
シリンダーブリッジ　だがな
いま　なんにん　のれるか▽
ためしている　さいちゅう　なんだ！▼
そうよ！　いまは　これいじょう
ひとは　はいれないんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T03:02:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T02:49:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ストップ！▼
シリンダーブリッジ　だがな
今　何人まで　乗れるのか▽
試している　最中なんだ！▼
そうよ！　今は　これ以上
人は　入れないんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T03:02:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T03:01:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ストッパー＝クリアまで
・話しかけ
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T03:00:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN3</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T03:00:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
