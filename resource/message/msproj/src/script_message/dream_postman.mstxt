	<TextRow
		Label="msg_dream_postman_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おあずかり　してる　プレゼントは
もう　ありません▼
またの　ごりようを
おまちして　おります</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
