			<Text>SAGE6
元プラズマ団・七賢人ロット</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:51:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-23T06:32:22" />
		</AttributeCell>
