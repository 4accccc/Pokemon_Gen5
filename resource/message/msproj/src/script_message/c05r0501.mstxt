				User="matsumiya:W00224"
				Time="2011-05-23T05:54:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:51:47" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
