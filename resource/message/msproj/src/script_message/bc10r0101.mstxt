<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_bc10r0101_man2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いいか！　かねもうけは
けっして　わるいことじゃ　ない！▼
きたない　かねもうけと
きれいな　かねもうけが　あるんだぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:26:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いいか！　金もうけは
決して　悪いことじゃ　ない！▼
汚い　金もうけと
きれいな　金もうけが　あるんだぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:28:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:14:42" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0101_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>のぞみのモノを　てにいれるため
どれだけ　ほんきに　なれるか？▽
それが　だいじなこと　なんだから！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:28:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>望みのモノを　手に入れるため
どれだけ　本気に　なれるか？▽
それが　大事なこと　なんだから！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:28:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:14:42" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
