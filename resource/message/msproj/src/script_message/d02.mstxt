	<TextRow
		Label="msg_d02_sign1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このさき　ヤグルマのもり
……どくけしは　おもちですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
