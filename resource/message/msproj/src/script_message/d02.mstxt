<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d02_girl1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンたちが　あるきつづけて
いつのまにか　できたのが　もりのみち▼
そっちを　あるけば　なんだか
ポケモンきぶんを　あじわえるでしょ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T07:48:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンたちが　歩き続けて
いつのまにか　できたのが　森の道▼
そっちを　歩けば　なんだか
ポケモン気分を　味わえるでしょ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T07:49:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ調整</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T07:35:51" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d02_fighterw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よう！　たびの　トレーナー！▼
きみも　たのもしい　ポケモンに
ためしのいわを　くだかせてみな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T07:51:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よう！　旅の　トレーナー！▼
きみも　頼もしい　ポケモンに
試しの岩を　砕かせてみな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T07:51:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでイベント変更</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T07:36:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERW</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d02_fighterw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いわくだきは　ときどき
あいての　ぼうぎょを　さげる　わざ▼
ジムリーダー　アロエさんの　すきな
ノーマルタイプの　ポケモンに▽
こうかは　バツグンさ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いわくだきは　ときどき
相手の　防御を　さげる　技▼
ジムリーダー　アロエさんの　好きな
ノーマルタイプの　ポケモンに▽
効果は　バツグンさ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T07:36:00" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERW</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d02_rock_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ためしのいわが　ある……▼
[Name:PokemonNickname Idx="0" ]に
こわさせて　みますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:38:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>試しの岩が　ある……▼
[Name:PokemonNickname Idx="0" ]に
壊させて　みますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:38:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ
・手持ちリストに格闘ポケモンがいるとき
・はい/いいえの選択肢
・0＝ポケモンニックネーム</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T07:37:53" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>特殊な岩</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d02_rock_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonNickname Idx="0" ]は
ためしのいわを　こわそうとした！▼
いわの　いちぶが　くだけ
すなと　なって　おちた！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-06T09:46:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
