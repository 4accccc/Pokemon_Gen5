				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d02r0201_rangerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ソウリュウシティに　でんせつの
ドラゴンポケモンを　つれた▽
えいゆうが　あらわれたころの　はなし▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:50:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ソウリュウシティに　伝説の
ドラゴンポケモンを　連れた▽
英雄が　現れたころの　話▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:49:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ビリジオン不在時にココに出現
・続けてrangerm_02
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:53:06" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RANGERM
ポケモンレンジャー♂</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d02r0201_rangerm_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このあたりで　つよく　かなしい
さけびごえが　ひびくと▼
あざやかな　みどりの　ポケモンが
つむじかぜの　ように　かけぬけたんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:50:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:40:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>このあたりで　強く　悲しい
叫び声が　響くと▼
あざやかな　緑の　ポケモンが
旋風の　ように　駆け抜けたんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:50:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:43:40" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてrangerm_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:46:04" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RANGERM
ポケモンレンジャー♂</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:40:26" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d02r0201_rangerm_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きいたところ　ビリジオンと　いい
あらそいから　ポケモンを　まもるため▼
ひとに　たたかいを　いどんだ
でんせつの　ポケモン　らしいね▼
プラズマだんとの　あらそいに
せかいが　すさみ　なかまの　すみかが▽
なくなるのを　おそれたのかな……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:52:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:40:56" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きいたところ　ビリジオンと　いい
争いから　ポケモンを　守るため▼
人に　戦いを　挑んだ
伝説の　ポケモン　らしいね▼
プラズマ団との　争いに
世界が　荒廃し　仲間の　すみかが▽
なくなるのを　おそれたのかな……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:52:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:43:40" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・以降、会話のたびに繰り返し</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:43:56" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RANGERM
ポケモンレンジャー♂</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T08:40:26" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>