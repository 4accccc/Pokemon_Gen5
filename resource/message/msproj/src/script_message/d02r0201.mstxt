	<TextRow
		Label="msg_d02r0201_poke6_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンは　もりの　おくへ
はしりさって　しまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T10:42:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンは　森の奥へ
走り去って　しまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T10:42:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・ポケモンを倒した場合</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T10:42:58" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE6
ポケモン・ビリジオン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T10:41:52" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
