<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r07r0105_sppoke2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふしぎな　けはいが　する……！
あたりを　しらべますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不思議な　気配が　する……！
周囲を　調べますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・d33イベント後にPOSを踏む
　GRIDX＝、GRIDZ＝
・はい/いいえの選択肢表示
　はい　→poke_02
　いいえ→終了
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:05:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・エムリット</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:52" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0105_sppoke2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょううん！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きょううん！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・画面？から飛来して待機
・会話するとメッセージ表示とあわせて鳴き声再生
・続けて戦闘に
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:05:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・エムリット</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0105_sppoke2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エムリットは
どこかに　とびさっていった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:05:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エムリットは
どこかに　飛び去っていった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:05:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:37" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・捕獲以外で戦闘終了した場合
・殿堂入りで復帰
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:05:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・エムリット</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:04:56" />
		</AttributeCell>
		<ExtraCell
