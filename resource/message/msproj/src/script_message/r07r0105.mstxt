	<TextRow
		Label="msg_r07r0105_champion_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わしの～
だいじに　してくれよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
