	<TextRow
		Label="msg_c04r0701_rangerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>けいじばんの　ニュース……
どんな　ひとが　かいているんだろ？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
