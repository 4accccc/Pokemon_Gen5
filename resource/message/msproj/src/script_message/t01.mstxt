	<TextRow
		Label="msg_t01_black_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『たびをしても
マイペースは　かわらないね　ベルは▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
