<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t01_bigman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かがくの　ちからって　すげー！▼
いまなら　せきがいせんつうしん　で
ポケモンの　こうかんや　たいせんが▽
あっ！　というま　だってよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:23:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>科学の　力って　すげー！▼
今なら　赤外線通信で
ポケモンの　交換や　対戦が▽
あっ！　というま　だってよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:23:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:23:49" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BIGMAN
太った青年</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T07:09:32" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t01_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンと　たびを　することで
ひとって　かわるものかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:15:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンと　旅を　することで
人って　変わるものかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:16:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい/いいえの選択肢表示
　はいだと文字モード切替
・以下、海外版
ポケモンと　たびを　することで
ひとって　かわるものかしら？
※swanでBW海外版の内容に
　メッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:24:00" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2
女性</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T07:09:53" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t01_woman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうよね！　たびをして　いろいろ
かんがえて　ひとは　かわるわね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:15:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そうよね！　旅をして　いろいろ
考えて　人は　変わるわね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:16:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択時
・以下、海外版
そうよね！　たびをして　いろいろ
かんがえて　ひとは　かわるわね！
※swanでBW海外版の内容に
　メッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:23:58" />
		</CommentCell>
