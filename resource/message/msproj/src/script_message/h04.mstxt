	<TextRow
		Label="msg_h04_oldman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひるは　にっこうよく……
よるは　げっこうよく……▽
しぜんが　しみいるわい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昼は　日光浴……
夜は　月光浴……▽
自然が　染み入るわい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
