				Time="2011-11-12T10:16:55" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_h04_girl2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとの　ひみつは　まもらないと
じぶんの　ひみつが　もれちゃうもの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T10:15:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T10:13:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>他人の　秘密は　守らないと
自分の　秘密が　漏れちゃうもの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T10:15:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
