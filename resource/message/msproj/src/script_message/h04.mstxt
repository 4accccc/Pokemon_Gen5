		<LanguageCell
			Language="JPN_KANJI">
			<Text>タンボ『ピー　ピィー
ピピピの　ピー……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
