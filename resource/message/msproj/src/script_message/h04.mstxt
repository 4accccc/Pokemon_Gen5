	<TextRow
		Label="msg_h04_guitar_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ソン『どうだい！　このおと！
きみの　たましい（ハート）に▽
ひびいて　こないかい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ソン『どうだい！　この音！
君の　魂（ハート）に▽
響いて　来ないかい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
