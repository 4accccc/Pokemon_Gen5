	<TextRow
		Label="msg_r14_sage2_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジャロ『リュウラセンのとうに　きた
つよき　ポケモントレーナーよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジャロ『リュウラセンの塔に　来た
強き　ポケモントレーナーよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=714、GRIDZ=343
・続けて条件に応じて分岐</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
