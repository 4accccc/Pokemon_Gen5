	</TextRow>
	<TextRow
		Label="msg_n01r0101_sage6_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くんしは　ぎに　さとり
しょうじんは　りに　さとる▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:01:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>君子は　義に　さとり
小人は　利に　さとる▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:05:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてsage7_01</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>七賢人６</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
