	<TextRow
		Label="msg_n01r0101_sage2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんに　したがう　ものは　いき
てんに　さからう　ものは　ほろぶ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:01:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>天に　従う者は　存し
天に　逆らう者は　滅ぶ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:05:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・七賢人６人（ゲーチス以外）、横並びで配置
・配置順は
　６・４・２・１・３・５
・続けてsage3_01</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>七賢人２</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
