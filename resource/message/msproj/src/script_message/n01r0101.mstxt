	</TextRow>
	<TextRow
		Label="msg_n01r0101_sage4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いちを　しりて
にを　しらず▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一を知りて　二を知らず▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:05:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてsage5_01</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
