	<TextRow
		Label="msg_c05r0102_espw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんを　たかめるには
じぶんよりも　すごい　ひとたちの▽
たたかいを　さんこうに　することね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:30:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分を　より　高めるには
自分よりも　すごい　人たちの▽
戦いを　参考に　することね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:31:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:30:40" />
		</LanguageCell>
