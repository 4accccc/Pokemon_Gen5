	<TextRow
		Label="msg_c01r0102_girl3_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ショウロ『あっ　トレーナーさん！▼
おねえちゃんの　おてつだい
どうも　ありがとうです！▼
これは　あたしからです
えんりょせずに　もらってください▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ショウロ『あっ　トレーナーさん！▼
お姉ちゃんの　お手伝い
どうも　ありがとうです！▼
これは　あたしからです
遠慮せずに　もらってください▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・Cギア入手後
　！マーク表示後、主人公に隣接
・アイテム入手処理
　No437「ともだちてちょう」</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ＧＩＲＬ3
パソコン管理者</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
