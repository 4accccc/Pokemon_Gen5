	<TextRow
		Label="msg_c01r0102_cgear_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｃギアの　きのうが
せいげんされますが　よろしいですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｃ－ＧＥＡＲの　機能が
制限されますが　よろしいですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>システムメッセージ
・いいえを選択したときの再確認</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
