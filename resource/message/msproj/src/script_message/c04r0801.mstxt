			<Comment>♀</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW
受付嬢</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
