	<TextRow
		Label="msg_c04r0801_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このさき　１６ばんどうろ
そして　ワンダーブリッジです！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
