	</TextRow>
	<TextRow
		Label="msg_d07_sign1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このさき　ネジやま
……やせいポケモンに　ちゅうい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>このさき　ネジ山
……野生ポケモンに　注意！</Text>
