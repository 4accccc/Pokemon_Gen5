	<TextRow
		Label="msg_c03r1302_woman2a_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カミツレさんが　きてると
ステキよね！　しびれちゃう！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
