	<TextRow
		Label="msg_r13r0201_dancer_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　ひでんを　つかってもらい
みちを　きりひらくのが　すきなんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T07:25:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　秘伝を　使ってもらい
道を　切り拓くのが　好きなんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T07:26:13" />
