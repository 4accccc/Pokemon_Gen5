	<TextRow
		Label="msg_r04r0601_fighterm_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いろんな　ところに　いって
いろんな　ひとと　はなす▽
そうすりゃ　いいこと　あるヨ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:30:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T07:57:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いろんな　ところに　行って
いろんな　人と　話す▽
そうすりゃ　いいこと　あるヨ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:30:34" />
			<Status>Editing</Status>
