			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0601_trainerm_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　[Name:PokemonName ]！
