	<TextRow
		Label="msg_h04r0201_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビレッジサンドに　やみつき　でさ
まいにち　こうして　たべにくるのさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T07:22:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビレッジサンドに　夢中でさ
毎日　こうして　食べにくるのさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T07:22:21" />
			<Status>Editing</Status>
