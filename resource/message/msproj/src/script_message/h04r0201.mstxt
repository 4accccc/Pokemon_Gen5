	<TextRow
		Label="msg_h04r0201_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビレッジサンドに　やみつき　でさ
まいにち　こうして　たべにくるのさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T07:22:07" />
			<Status>Editing</Status>
