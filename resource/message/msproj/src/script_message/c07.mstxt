				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c07_girl2_01b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんせつの　ポケモン　ゼクロムは
えいゆうに　ちしきを　あたえ▽
てきには　いなびかりで　はむかう▼
その　えいゆうと　ポケモンの
おやこの　ような　すがたは▽
たしかに　こうごうしかったわね……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T11:14:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伝説のポケモン　ゼクロムは
英雄に　知識を　与え▽
敵対者に　稲光で　刃向かう▼
その英雄と　ポケモンの
親子の　ような　姿は▽
確かに　神々しかったわね……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T11:14:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・Black2ver
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T11:14:54" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL2
少女（活発）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
