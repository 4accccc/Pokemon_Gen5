				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c07_ambrella_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かぜや　ゆきに　さらされても
かわらず　そびえる　とう……▼
その　そんざいは　ひとに
ゆめや　りそうを　わすれるな！▽
そう　つたえているのかも……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T11:18:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>風雪に　さらされても
変わらず　そびえる　塔……▼
その存在は　人に
夢や　理想を　忘れるな！▽
そう　伝えているのかも……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-11T11:26:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:45:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>AMBRELLA
パラソル</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c07_man3_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんせつの　ポケモンは
しんじつを　もとめる　えいゆうを▽
たすけ　くにを　つくる……▼
そして　にくたいが　ほろぶと
ライトストーンと　なり　あらたな▽
えいゆうの　たんじょうを　まつ……▼
ちいさいときに　きいた　あの　はなし
ほんとう　だったんだね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T07:41:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伝説の　ポケモンは
真実を　求める　英雄を助ける▼
そして　肉体が　滅ぶと
ライトストーンと　なり　新たな▽
英雄の　誕生を　待つという……▼
小さいときに　きいた　あの話
本当だったんだね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T07:42:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・White2ver
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-02T11:10:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN3</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
