	</TextRow>
	<TextRow
		Label="msg_r16r0201_narrator_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンは　もりの　おくに
すがたを　けしてしまった…</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
