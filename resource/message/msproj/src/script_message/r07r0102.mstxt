	<TextRow
		Label="msg_r07r0101_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いまの　あたし　むてき　よ！
にくしみで　まんたん　だもの！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:15:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いまの　あたし　無敵よ！
憎しみで　満タン　だもの！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:15:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・セイガイハ新婚イベントで
　はいを選択すると出現
・表示後、トレーナー戦闘へ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:00:22" />
		</CommentCell>
