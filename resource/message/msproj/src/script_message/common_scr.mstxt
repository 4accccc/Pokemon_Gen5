	<TextRow
		Label="msg_common_gameover_myhome_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おかあさん『あらあら！
あなたも　ポケモンも[Ctrl2:LineFeed ]
げんき　いっぱいね！[Ctrl2:PageClear ]
そうだ！　さっき
はかせから　きいたんだけど……[Ctrl2:PageClear ]
ポケモンの　たいりょく
えっと　ＨＰが　なくなってきたら[Ctrl2:PageClear ]
こまめに　ポケモンセンターで
かいふく　させるか[Ctrl2:PageClear ]
とおくに　ぼうけん　するときは
フレンドリィショップで[Ctrl2:LineFeed ]
キズぐすりを　かっておくのが[Ctrl2:LineFeed ]
きほん　らしいわよ[Ctrl2:PageClear ]
それじゃ　おうえん　しているわ！[Ctrl2:PageClear ]
きを　つけて！
いってらっしゃい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おかあさん『あらあら！
あなたも　ポケモンも　元気いっぱいね！[Ctrl2:PageClear ]
そうだ！　さっき
博士から　聞いたんだけど……[Ctrl2:PageClear ]
ポケモンの体力
えっと　ＨＰが　なくなってきたら[Ctrl2:PageClear ]
こまめに　ポケモンセンターで
回復させるか[Ctrl2:PageClear ]
遠くに　冒険するときは
フレンドリィショップで[Ctrl2:LineFeed ]
キズぐすりを　買っておくのが[Ctrl2:LineFeed ]
基本らしいわよ[Ctrl2:PageClear ]
それじゃ　応援しているわ！[Ctrl2:PageClear ]
気をつけて！
いってらっしゃい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ゲームオーバー自宅復帰時</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_common_gameover_pc_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まずは　ポケモンを
かいふく　させましょう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まずは　ポケモンを
回復　させましょう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
