	<TextRow
		Label="msg_wbt_info_11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんじつの　トーナメントは
すべて　しゅうりょう　しています▼
またの　おこしを　おまちしております</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本日の　トーナメントは
すべて　終了しています▼
またの　ご来場を　お待ちしております</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>
・削除対象
</Comment>
