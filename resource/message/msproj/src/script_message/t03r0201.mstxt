				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_swbel_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベル『あのね　さいきん
ジャイアントホールの　ちかくでも▼
いっしゅんだけ　マイナス５０どを
けいそく　したんだって！▼
って　チェレンが
おしえて　くれたんだけど▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:25:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:25:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベル『あのね　最近
ジャイアントホールの　近くでも▼
一瞬だけ　マイナス５０度を
計測したんだって！▼
って　チェレンが
教えて　くれたんだけど▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T03:58:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:29:40" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ベルト主人公向き合ってメッセージ表示
・続けてhakase2_02</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:14:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:28:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_hakase2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アララギ『いまは　いけないけれどね
・理由▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:33:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:29:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アララギ『今は　行けないけれどね
・理由▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T11:41:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:29:45" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・続けてoldwoman1_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:14:40" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>アララギ博士</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:28:49" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_oldwoman1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むかしむかしの　ことじゃ▼
ジャイアントホール　とは
そらから　おおきな　いんせきが▽
ふってきて　できた　あな　らしいな▼
その　いんせき　にはな
おっそろしい　ポケモンが▽
ひそんで　おったそうな……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:15:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:29:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昔々の　ことじゃ▼
ジャイアントホール　とは
空から　大きな　いん石が▽
降ってきて　できた　穴らしいな▼
その　いん石　にはな
おっそろしい　ポケモンが▽
潜んで　おったそうな……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T11:41:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:29:45" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・続けてhakase2_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:14:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDWOMAN1</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:28:44" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_hakase2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アララギ『……いんせき　ね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:09:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:09:36" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アララギ『……いん石　ね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T11:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:09:45" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アララギ、正面を向いたまま
・続けてoldwoman1_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:26:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>アララギ博士</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:09:30" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_oldwoman1_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたりが　やみに　つつまれると▼
ポケモンは　こごえるような
つめたい　かぜと　ともに　あらわれ▼
あたりを　いてつかせては
ひとや　ポケモンを　とっては　くらう……▼
そう　おそれられて　いたんじゃ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T11:45:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたりが　やみに　包まれると▼
ポケモンは　凍えるような
冷たい　風と　ともに　現われ▼
辺りを　凍てつかせては
人や　ポケモンを　とっては　食らう……▼
そう　恐れられて　いたんじゃ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T11:45:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・続けてswbel_02</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:21:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDWOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_swbel_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベル『ポケモンが　ひとを
た　たべちゃうのお！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:16:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:51:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベル『ポケモンが　人を
た　食べちゃうのお！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T11:42:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:51:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ベルに！マーク表示してから
・続けてoldwoman1_05</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:21:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:53:43" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_oldwoman1_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃから　むかしの　もんは
ポケモンが　はいって　これないように▽
まちを　へいで　かこったり▼
ひが　くれたら　そとに　でるのを
きんじて　うちで　すごすよう▽
まちの　おきてを　きめたのじゃ……▼
むかしばなしは
これで　おしまい　じゃ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:10:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:50:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じゃから　昔の　もんは
ポケモンが　入って　これないように▽
町を　塀で　囲ったり▼
日が　暮れたら　外に　でるのを
禁じて　うちで　過ごすよう▽
町の　おきてを　決めたのじゃ……▼
昔話は
これで　おしまい　じゃ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T11:43:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:51:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・続けてhakase2_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:21:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDWOMAN1</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:50:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_hakase2_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アララギ『とても　きょうみぶかい
おはなし　ありがとう　ございました▼
こんごの　わたしの　けんきゅうに
とても　やくだちます▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:29:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:55:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アララギ『とても　興味深い
お話　ありがとう　ございました▼
今後の　わたしの　研究に
とても　役立ちます▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T11:41:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:55:05" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・続けてhakase2_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:21:05" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>アララギ博士</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T09:55:00" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_hakase2_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>では　みんな
おいとま　しましょう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T11:45:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:20:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>では　みんな
おいとま　しましょう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
