<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t03r0201_oldwoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぐごご……　ぐごごご………▼
……ん　んんう？
なんじゃ？　おまえさんは？▼
バーさんの　はなしでも
ききに　きたんか……？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぐごご……　ぐごごご………▼
……ん　んんう？
なんじゃ？　おまえさんは？▼
バーさんの　話でも
聞きに　来たんか……？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・朝になるといなくなる
・消すタイミングはzoneチェンジ＋時間参照
・はい/いいえの選択肢表示
　はい　→oldwoman1_02
　いいえ→_oldwoman1_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-01T03:07:46" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDWOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_oldwoman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>んん……　じゃあ　はなしてやろう……▼
この　カゴメタウンの　うらには……
でっかい　あなが　あいとるんじゃ▼
そのあなはな　むかし　むかし……▼
ふあ……　だめじゃ　ねむい……▼
そらから　おおきな……▼
……が　ふってきて　できた……▼
そして　その……　なかには
よにも　おそろしい……▼
……　……　よにも……▼
ぐう……　ぐう……　ぐごご……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>んん……　じゃあ　話してやろう……▼
この　カゴメタウンの　裏には……
でっかい　穴が　開いとるんじゃ▼
その穴はな　昔々……▼
ふあ……　だめじゃ　眠いわ……▼
空から　大きな……
……が　降って　出来た……▼
そして　その……　中には
世にも　恐ろしい……▼
……　……　世にも……▼
ぐう……　ぐう……　ぐごご……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・朝になるといなくなる
・消すタイミングはzoneチェンジ＋時間参照</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-01T03:07:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDWOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0201_oldwoman1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふあ……　ああ　そうかい……
じゃあ　ワシは　ねる……▼
おやすみな……　ぐう……
ぐう……　ぐう……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふあ……　ああ　そうかい……
じゃあ　ワシは　寝る……▼
おやすみな……　ぐう……
ぐう……　ぐう……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・イベント終了</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-01T03:08:00" />
		</CommentCell>
