	<TextRow
		Label="msg_t03r0201_oldwoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カゴメの　むかしばなしを
ききたいのは　アンタら　かね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
