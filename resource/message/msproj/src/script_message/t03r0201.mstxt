			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:11:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カゴメの　昔話を
ききたいのは　アンタら　かね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T08:10:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T10:11:13" />
		</LanguageCell>
