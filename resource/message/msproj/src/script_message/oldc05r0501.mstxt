	<TextRow
		Label="msg_oldc01r0501_old_kahaim1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>その１『もういちど　プラズマだんに
もどるよう　せっとく　されたんだよね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-05T03:20:34" />
			<Status>Editing</Status>
