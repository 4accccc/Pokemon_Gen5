				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c06r0301collect_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かくじつに　わざマシンを　くれるひと▼
それは　ジムリーダーよね！▼
って　もう　しっているわよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T03:24:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-27T06:08:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>確実に　わざマシンを　くれる人▼
それは　ジムリーダーよね！▼
って　もう　知っているわよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T03:25:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
