	<TextRow
		Label="msg_d07r0601_poke4_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レジギガスは　こうどうの
どこかへ　すがたを　けした……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T10:16:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T10:16:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レジギガスは　坑道の
どこかへ　姿を　消した……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T10:16:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T10:16:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・捕獲以外で戦闘終了した場合
・殿堂入りで復帰</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T10:16:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
