	<TextRow
		Label="msg_r15r0201_veteranw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１３ばんどうろ　いがいにも
いろいろ　さがしあるいて▽
ようやく　であえた　パートナーさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:56:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１３番道路　以外にも
いろいろ　捜し歩いて▽
ようやく　であえた　パートナーさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:57:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ調整</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:52:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>VETERANW</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r15r0201_poke39_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちゅあん♪</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:59:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:58:36" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちゅあん♪</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:59:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:59:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・あわせて鳴き声再生
・上記動作モデルに隣接
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:57:47" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE39
ポケモン・ゴチミル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:58:27" />
		</AttributeCell>
	</TextRow>
