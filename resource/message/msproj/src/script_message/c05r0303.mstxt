	<TextRow
		Label="msg_c05r0303_trainerw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほら！　マッギョ！　ヒヤップ！
あたしの　だいじな　ポケモンたち！▽
きょうは　ゆっくり　くつろぎな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T11:05:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほら！　マッギョ！　ヒヤップ！
あたしの　大事な　ポケモンたち！▽
今日は　ゆっくり　くつろぎな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T05:54:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T05:54:35" />
		</CommentCell>
