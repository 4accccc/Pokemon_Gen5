	<TextRow
		Label="msg_c05r0303_waiter_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふいの　ほうもんしゃ！
そんな　あなたには　これを▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T11:10:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:57:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不意の　訪問者！
そんな　あなたには　これを▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T11:10:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:57:51" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX＝1、GRIDZ＝3、右向き
・アイテム入手処理
　No229「かわらずのいし」</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-08T03:29:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITER</Text>
			<TextModifiedBy
