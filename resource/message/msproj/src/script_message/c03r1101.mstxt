		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フィーリングチェックで　もらえる
ハートスイーツ……　いいですよね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
