		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　おつかれさま！！▼
いまの　マッサージで
あなたに　とても　なついたみたい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
