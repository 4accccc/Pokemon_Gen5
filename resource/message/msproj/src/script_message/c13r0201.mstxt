	<TextRow
		Label="msg_c13r0201_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こどもは　わたしの　せんせい
ポケモンは　あなたの　せんせい▽
いろんなことを　おしえてくれるもの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T02:42:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-14T08:56:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こどもは　わたしの　先生
ポケモンは　あなたの　先生▽
いろんなことを　教えてくれるもの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T02:42:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-14T08:56:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-14T08:50:43" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN3
保育士</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-14T08:50:01" />
		</AttributeCell>
	</TextRow>
