	</TextRow>
	<TextRow
		Label="msg_c13r0201_middlewoman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やけどに　なった　ポケモンは
ＨＰは　へっていくし▼
こうげきりょくも　さがっちゃうしで
てんやわんや　ですもんね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-14T08:55:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やけどに　なった　ポケモンは
ＨＰは　減っていくし▼
攻撃力も　さがっちゃうしで
てんやわんや　ですもんね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-14T08:55:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN1
→WOMAN3</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-14T08:53:35" />
