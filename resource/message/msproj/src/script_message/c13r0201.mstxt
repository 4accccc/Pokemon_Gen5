<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c13r0201_workman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほのおタイプの　ブーバーとか
コンビナートにも　ポケモンが　いる▼
ポケモンを　きたえるには　むいてるし
ワシも　ときどき　あそびに　いくよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T10:40:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほのおタイプの　ブーバーとか
コンビナートにも　ポケモンが　いる▼
ポケモンを　鍛えるには　向いてるし
ワシも　時々　遊びに行くよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T10:40:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c13r0201_middlewoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーさん！▼
もしもですよ　もしも
ポケモンが　やけどに　なったら▽
これを　つかってあげてね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T10:40:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーさん！▼
もしもですよ　もしも
ポケモンが　やけどに　なったら▽
これを　使ってあげてね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T10:40:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手処理
　No019「やけどなおし」</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c13r0201_middlewoman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やけどに　なった　ポケモンは
ＨＰは　へっていくし▼
こうげきりょくも　さがっちゃうしで
てんやわんや　ですからね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T10:40:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やけどに　なった　ポケモンは
ＨＰは　減っていくし▼
攻撃力も　さがっちゃうしで
てんやわんや　ですからね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T10:41:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN1</Text>
			<TextModifiedBy
