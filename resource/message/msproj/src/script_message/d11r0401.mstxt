<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d11r0401_assistantm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げすいどうに　あふれる　どくを
くすりに　かえる　じっけん……▼
これが　かんぜんに　せいこうすれば
どくタイプの　ポケモンから▽
どんどん　くすりが　つくれるんだ▼
さて……
きょうの　じっけんは……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T02:44:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>下水道に　あふれる　毒を
薬に　変える　実験……▼
これが　完全に　成功すれば
どくタイプの　ポケモンから▽
どんどん　薬が　つくれるんだ▼
さて……
今日の　実験は……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T02:44:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・部屋の中央に配置
・続けてのメッセージ
　60％→assistantm_02
　30％→assistantm_03
　10％→assistantm_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T09:35:33" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:19:32" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d11r0401_assistantm_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいの　じっけんは
ふつう　だったな▼
きみ　この
どくけしを　あげるよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:41:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:40:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今回の　実験は
普通　だったな▼
きみ　この
どくけしを　あげるよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T02:47:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:40:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No018「どくけし」</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:39:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:38:28" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d11r0401_assistantm_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいの　じっけんは
うまく　いったぞ！▼
きみ　この
なんでもなおしを　あげるよ▼</Text>
