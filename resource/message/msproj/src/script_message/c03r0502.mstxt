	</TextRow>
	<TextRow
		Label="msg_c03r0502_engineer_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つづきが　ありますよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
