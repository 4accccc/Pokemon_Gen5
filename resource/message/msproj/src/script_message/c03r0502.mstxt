				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0502_engineer_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タイトルメニューに　ボタンを　１コ
あたらしく　よういしましたよ！▼
レポートを　しっかり　かいてから
タイトルがめんに　もどってください！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タイトルメニューに　ボタンを　１個
新しく　用意しましたよ！▼
レポートを　しっかり　書いてから
タイトル画面に　戻ってください！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
