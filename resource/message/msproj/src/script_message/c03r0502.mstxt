	<TextRow
		Label="msg_c03r0502_engineer_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ざんねんですが…
ただしい　パスワードを▽
おぼえていない　みたいですね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
