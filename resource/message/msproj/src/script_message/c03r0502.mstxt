				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0502_businessman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モンスタボールが　できるまえからも
ひとと　ポケモンは　なかよくて▽
これからも　ずっと　そうなのかな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T11:55:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T09:18:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モンスタボールが　できる前からも
人と　ポケモンは　仲良くて▽
これからも　ずっと　そうなのかな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T11:55:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T09:18:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・クリア後
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T09:28:23" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T09:18:23" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-20T01:39:32" />
		</AttributeCell>
		<ExtraCell
