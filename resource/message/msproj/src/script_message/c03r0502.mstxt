	<TextRow
		Label="msg_c03r0502_engineer_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしの　てんそうマシンは
やくに　たちましたか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
