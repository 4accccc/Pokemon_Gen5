<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d29r0601_monument_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つきと　ともに
ここを　まもるものの　へや</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T08:53:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>月と　ともに
ここを　守るものの　部屋</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T08:53:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レジ型石版
・入り口付近に配置
・午後の間であることを示唆</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:41:20" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T06:16:32" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff80ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0601_monument_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ただしい　ばしょの　こたえは
ふたつに　わけられた▼
ゆうき　ある　ものよ
わたしの　もつ　こたえを　おしえよう▼
めだまから　みぎに９を
そして　したに●を　しらべるのだ▼
もうひとつの　こたえは
たいようが　あるときに　わかる</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T08:43:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正しい　場所の　答えは
二つに　わけられた▼
勇気ある　者よ
私が　知る　答えを　教えよう▼
めだまから　右に９を
そして　下に●を　調べるのだ▼
もう一つの　答えは
太陽が　あるときに　わかる</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T08:43:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レジ型石版
・奥に配置
・岩山の間へのヒント</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T06:16:34" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff80ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0601_monument_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいは　２つに　わかれる
あさと　よる……　しろと　くろ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T09:06:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界は　２つに　わかれる
朝と　夜……　白と　黒……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T09:06:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レジ型石版
・奥に配置
・世界観を広げるメッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T06:16:34" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff80ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0601_monument_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>がんせき　こおり　マグマ　から
まもる　ものを　うみだした……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T09:03:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>岩石　氷　マグマ　から
守るものを　うみだした……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T09:03:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レジ型石版
・奥に配置
・世界観を広げるメッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:40:09" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
