	<TextRow
		Label="msg_t01r0302_boy1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほらね　なかなかでしょ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
