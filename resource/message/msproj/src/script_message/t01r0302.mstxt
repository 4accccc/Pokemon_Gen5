	<TextRow
		Label="msg_t01r0302_pc_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:Type Idx="0"]はパソコンの
がめんを　チェックした！▼
たんけんの　こころえ　その１
Ｘボタンで　メニューが　ひらく！▼
たんけんの　こころえ　その２
レポートを　えらぶと　きろく　できる！▼
あとは　なにも　かかれていない……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:Type Idx="0"]はパソコンの
モニタを　チェックした！▼
探検の　心得　その１
Ｘボタンで　メニューが　ひらく！▼
探検の　心得　その２
レポートを　選ぶと　記録できる！▼
あとは　なにも　かかれていない……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ＢＧメッセージ
・プラチナと同じメッセージ
・0＝主人公名</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>パソコン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
