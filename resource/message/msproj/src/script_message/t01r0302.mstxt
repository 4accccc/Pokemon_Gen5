	<TextRow
		Label="msg_t01r0302_boy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このメッセージは　テストようです▼
ぼくねー　おどるのすきなんだよ！
ちょっとユーみててー！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
