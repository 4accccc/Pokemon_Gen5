	<TextRow
		Label="msg_deoxys_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うちゅうから　ふってきた
ふしぎな　いんせきが　ある……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>宇宙から　降ってきた
不思議な　いん石が　ある……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
