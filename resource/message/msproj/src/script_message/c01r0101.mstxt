	<TextRow
		Label="msg_c01r0101_bigman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>デント　ポッド　コーンの　３にん▼
しゅぎょう　しなおすために
ジムリーダーを　やめたのって▽
そうとうな　かくご　だったろうな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T07:49:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>デント　ポッド　コーンの　３人▼
修行しなおすために
ジムリーダーを　やめたのって▽
相当な　覚悟だったろうな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T07:49:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T02:58:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BIGMAN
太った青年</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
