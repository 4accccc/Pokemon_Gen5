				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01r0101_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちかごろ　ゆめのあとちで
ふしぎな　ポケモンの　そんざいを▽
かんじる　ひとが　いるんですって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-11T11:46:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちかごろ　夢の跡地で
不思議な　ポケモンの　存在を▽
感じる　人が　いるんですって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
