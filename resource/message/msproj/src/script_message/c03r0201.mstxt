	<TextRow
		Label="msg_c03r0201_juggling_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オー！　いるじゃん！
なんだか　インスパイアされたね！[Ctrl2:PageClear ]
ありがとう！
おれいは　どれが　いいかな？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
