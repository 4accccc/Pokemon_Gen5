	<TextRow
		Label="msg_c03r0201_sunglasses_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いまは　わかて　ゆうぼうかぶの
さくひんを　てんじ　しております</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:17:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今は　若手有望株の
作品を　展示しております</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:18:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:17:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0201_lady_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒウンシティはね　ジムそのものが
アーティさんの　げいじゅつ　なのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:18:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒウンシティはね　ジムそのものが
アーティさんの　芸術なのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:18:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:17:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LADY</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
