				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0201_juggling_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみが　えらんだ　ポケモン
ミーの　リクエストと　ちがうよー！▼
ミーが　かきたいのは　タイプが
[Name:Type Idx="0" ]の　ポケモンよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみが　選んだ　ポケモン
ミーの　リクエストと　ちがうよー！▼
ミーが　描きたいのは　タイプが
[Name:Type Idx="0" ]の　ポケモンよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・選んだけど一致していない
・0＝ポケモンのタイプ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN
←JUGGLING</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-11T05:43:35" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0201_juggling_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オー！
この　タマゴの　フォルム……▼
いいねえ！　ゾクゾクくるねえ！
しびれるねえ！　ふるえちゃうねえ！▼
って　タマゴの　タイプは
ミーにも　わからないよー！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オー！
この　タマゴの　フォルム……▼
いいねえ！　ゾクゾクくるねえ！
しびれるねえ！　震えちゃうねえ！▼
って　タマゴの　タイプは
ミーにも　わからないよー！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・選んだけどタマゴ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN
←JUGGLING</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-11T05:43:35" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
