<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r03r0201_badman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そだてて　もらっていた
ポケモンを　ひきとったらよ▼
あずけたときに　おぼえていたのと
ちがう　わざを　おぼえてたぜ！▼
ポケモンが　おぼえられる　わざは
４つまでだから　ちゅうい　しないとな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>育てて　もらっていた
ポケモンを　引き取ったらよ▼
預けたときに　覚えていたのと
違う　技を　覚えてたぜ！▼
ポケモンが　覚えられる　技は
４つまでだから　注意しないとな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・育て屋用のgmmは
　sodateya.gmm参照</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
