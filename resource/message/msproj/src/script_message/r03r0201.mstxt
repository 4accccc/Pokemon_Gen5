<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r03r0201_badman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そだてやさんに　あずけていても
ポケモンは　わざを　おぼえていく！▼
だから　あずけたままだと　だいじな
わざを　わすれているかも　しれないぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T08:08:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>育て屋さんに　預けていても
ポケモンは　技を　覚えていく！▼
だから　預けたままだと　大事な
技を　忘れているかも　しれないぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T08:08:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・育て屋用のgmmは
　sodateya.gmm参照
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T08:07:31" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r03r0201_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そだてやさんに　あずけていても
ポケモンは　しんか　しないのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T08:06:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T08:05:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>育て屋さんに　預けていても
ポケモンは　進化しないのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T08:06:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T08:05:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanで新規作成</Comment>
