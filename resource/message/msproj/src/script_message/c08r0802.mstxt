	<TextRow
		Label="msg_c08r0802_babyboy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼく　おもうんだけど
ポケモンが　いっしょに　いるから▽
かったり　まけたり　できるんだよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼく　おもうんだけど
ポケモンが　いっしょに　いるから▽
かったり　まけたり　できるんだよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
