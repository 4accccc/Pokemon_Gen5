<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_n01r0301_ninja_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｎさまが　しんじつの　えいゆうか
おまえとの　たたかいで　わかる▼
おまえが　ポケモンと
ともに　あゆむ　いまの　せかいを▽
まもりたいのか……　それもわかる▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｎさまが　真実の　英雄か
おまえとの　戦いで　わかる▼
おまえが　ポケモンと
共に　歩む　今の　世界を▽
守りたいのか……　それもわかる▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・WHITEver
・pos（GRIDX=3~5、GRIDZ=13）を踏むと
　登場芝居をして
　GRIDX=4、GRIDZ=10に出現しメッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
