	<TextRow
		Label="msg_policeman_02_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はしゃぎすぎて　ころんだり
しないようにな▼
きゃくに　ケガされると
おじさん　こまっちゃうから</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はしゃぎすぎて　転んだり
しないようにな▼
客に　ケガされると
おじさん　困っちゃうから</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
