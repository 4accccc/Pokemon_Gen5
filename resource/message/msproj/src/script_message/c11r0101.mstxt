	<TextRow
		Label="msg_policeman_02_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おじさんも　きみの　としごろには
おんなのこに　キャーキャー▽
いわれてたんだぞ　はっは</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おじさんも　きみの　年ごろには
女の子に　キャーキャー▽
言われてたんだぞ　はっは</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
