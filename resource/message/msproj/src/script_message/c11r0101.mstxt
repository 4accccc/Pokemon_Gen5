				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>2カ国とこうかん
POS</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ガードマン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
