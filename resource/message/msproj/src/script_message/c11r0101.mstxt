	<TextRow
		Label="msg_policeman_02_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきんじゃ　きみ　みたいな
グローバルな　トレーナーが▽
おおい　みたいだな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
