	<TextRow
		Label="msg_policeman_02_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンずかんも　もう
だいぶ　うまったんじゃないか？▽
いやあ　たいしたもんだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
