	</TextRow>
	<TextRow
		Label="msg_d27r0401_swboss_03_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたくしは　しりあいに　たのまれ
けんきゅうを　てつだっていたのです！▼
わたくしの　のぞみは
ポケモンの　ちからを　ひきだすこと！▼
それが　できうるなら
しゅだんは　なんでも　いいのです！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T09:07:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T06:46:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>前振りその２</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T06:49:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T06:46:54" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アジト船３回目</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T06:46:54" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBOSS
アクロマ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T06:46:54" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
