	<TextRow
		Label="msg_d27r0401_swboss_03_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アクロマ『きましたね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T09:05:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T06:46:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アクロマ『待ってましたよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T06:46:33" />
			<Status>Editing</Status>
