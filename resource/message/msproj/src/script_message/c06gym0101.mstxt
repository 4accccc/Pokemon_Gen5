	<TextRow
		Label="msg_c06gym0101_glasses_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いてて……▼
ああ　もうしわけないっすね！▼
おわびに　この　おいしいみず
うけとって　くださいっすよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いてて……▼
ああ　申し訳ないっすね！▼
おわびに　この　おいしいみず
受け取って　くださいっすよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
