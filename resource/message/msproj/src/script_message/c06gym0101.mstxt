<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c06gym0101_leader_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ウフフ
おまちしてました▼
アタシ　じまんの　フキヨセジム
たいほうで　とぶのは　たのしかった？▼
じゃあね　つぎは　アタシと
もっと　たのしいこと　しましょう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T11:18:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ウフフ
お待ちしてました▼
アタシ　自慢の　フキヨセジム
大砲での　特訓は　楽しかった？▼
じゃあね　今度は　アタシと
もっと　楽しいこと　しましょう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T11:19:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・戦闘前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER6
ジムリーダー・フウロ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:57:00" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c06gym0101_leader_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アナタって　すごい
ポケモントレーナー　なのね！▼
ひさしぶりに　ほんきで
ポケモンしょうぶ　できて▽
アタシも　ポケモンも　しあわせ▼
これは　リーグこうにんの　ジムバッジ
アナタに　にあうと　うれしいな▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アナタって　すごい
ポケモントレーナー　なのね！▼
ひさしぶりに　本気で
ポケモン勝負　できて▽
アタシも　ポケモンも　しあわせ▼
これは　リーグ公認の　ジムバッジ
アナタに　似合うと　うれしいな▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・戦闘後メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER6
ジムリーダー・フウロ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:57:00" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c06gym0101_leader_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]は　フウロから
ジェットバッジを　もらった！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
