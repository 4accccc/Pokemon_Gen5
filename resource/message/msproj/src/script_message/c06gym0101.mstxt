				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c06gym0101_glasses_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わざと　ふきとばされるのも
ポケモンの　わざを　くらったようで▽
なんだか　たのしいんすよね！▼
ああ！　ジムリーダーに　しょうり
おめでとうございます！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わざと　ふきとばされるのも
ポケモンの　技を　くらったようで▽
なんだか　楽しいんすよね！▼
ああ！　ジムリーダーに　勝利
おめでとう　ございます！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T12:03:22" />
			<Status>Editing</Status>
