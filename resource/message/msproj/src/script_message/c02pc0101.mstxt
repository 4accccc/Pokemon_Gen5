<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c02pc0101_girl2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いま　いっしょに　いるのは
たくさん　であったなかから　きめた▽
おきにいりの　ポケモンたちよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T09:28:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今一緒に　いるのは
たくさん　出会った中から　決めた▽
お気に入りの　ポケモンたちよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T09:29:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T04:07:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL2
少女２活発</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c02pc0101_backpackerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はくぶつかんに　ある　ホネは
ネジやまで　みつかった　そうだね▼
ネジやまでは　ほかにも　いろいろ
カセキが　みつかると　きいたよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T09:22:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シッポウ博物館に　ある　ホネは
ネジ山で　みつかったそうだね▼
ネジ山では　他にも　いろいろ
カセキが　みつかると　きいたよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T09:21:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T04:07:30" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BACKPACKERM
バックパッカー♂</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02pc0101_boy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふー！　パソコンの
「ヘルプをみる」を　ぜんぶ　よんだぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T09:20:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふー！　パソコンの
「ヘルプをみる」を　全ページ　読破！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T09:20:56" />
