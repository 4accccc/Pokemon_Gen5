				Time="2012-01-18T02:18:26" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#008000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_fm_npc_btl03_06">
		<LanguageCell
			Language="JPN">
			<Text>わたしの　しゅぎょう　あいては
むずかしかった　ようですね▼
でも　よいのです
あなたも　いずれ　つよくなる！▽
また　たたかおう！　さらば！▼</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-12-26T10:40:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-12-24T08:12:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>私の　修行相手は
難しかった　ようですね▼
でも　良いのです
あなたも　いずれ　強くなる！▼
また　戦おう！　さらば！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-12-26T10:41:00" />
			<Status>Editing</Status>
