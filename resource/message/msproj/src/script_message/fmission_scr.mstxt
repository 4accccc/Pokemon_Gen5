	<TextRow
		Label="msg_fm_npc_btl03_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモントレーナーの　みちは
おわりなき　しゅぎょうの　みち……▽
さあ　おてあわせ　ねがおう！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T11:56:07" />
			<Status>Editing</Status>
