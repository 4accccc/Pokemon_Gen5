	<TextRow
		Label="msg_fm_npc_btl02_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんとうの　つよさとは　なにか……
おねがいです！！▽
わたしと　しょうぶ　してください！</Text>
