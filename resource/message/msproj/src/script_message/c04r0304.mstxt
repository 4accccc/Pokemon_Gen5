	<TextRow
		Label="msg_c04r0304_baseballm1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにか　うまく　なりたければ
まいにち　まいにち▽
くりかえし　やるだけだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T09:26:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なにか　うまく　なりたければ
毎日　毎日▽
繰り返し　やるだけだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T09:26:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ調整</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T09:26:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BASEBALLM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T09:00:24" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c04r0304_baseballm2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
