	<TextRow
		Label="msg_hyouka_i06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１００を　こえる　ポケモン……▼
それぞれに　ちがった　とくちょうで
みていて　うれしくなっちゃうわ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
