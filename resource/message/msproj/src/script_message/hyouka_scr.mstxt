<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_hyouka_hakase2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンずかんの　ようすを
チェック　しましょうか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-03T06:02:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモン図鑑の　様子を
チェック　しましょうか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-03T06:03:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>アララギ博士：娘
・はい/いいえの選択肢
　はい　→hakase2_02
　　　　　→hakase2_02a
　いいえ→hakase2_03
※swanで調整</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-03T06:00:42" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>アララギ博士：娘</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_hyouka_hakase2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どれどれ……▼
イッシュちほうで　みつけた
ポケモンの　かずは　[Digit:3digits Idx="0" ]　ね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どれどれ……▼
イッシュ地方で　みつけた
ポケモンの　数は　[Digit:3digits Idx="0" ]　ね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>アララギ博士：娘
・はい選択時
・みつけた匹数に応じてメッセージ分岐
・0＝３桁の数字

・メッセージ表示後にME再生
・みつけた匹数に応じて再生MEを分岐</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-03T06:03:31" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>アララギ博士：娘</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
