				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_hyouka_i01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すこしは　ポケモンずかん　らしく
なってきたわね！　いい　かんじよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
