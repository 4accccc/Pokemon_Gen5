	<TextRow
		Label="msg_hyouka_hakase_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なるほど！▼
つかまえた　ポケモンの　かずは
[Digit:3digits Idx="0" ]　か……</Text>
