	<TextRow
		Label="msg_hyouka_hakase_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンずかんの　ようすを
みせに　きてくれたのかね！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-03T06:24:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモン図鑑の　様子を
みせに　きてくれたのかね！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-03T06:25:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>アララギ博士：父
・はい/いいえの選択肢
　はい　→hakase_02
　いいえ→hakase_03</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
