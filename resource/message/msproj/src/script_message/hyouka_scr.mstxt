	<TextRow
		Label="msg_hyouka_z04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そだてやさんに　いっておるかい？▼
タマゴから　うまれることでしか
つかまえられない　ポケモンもいると▽
きいたことが　あるからね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
