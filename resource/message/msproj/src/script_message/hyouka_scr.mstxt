	<TextRow
		Label="msg_hyouka_hakase_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なるほど！▼
つかまえた　ポケモンの　かずは
[Digit:3digits Idx="0" ]　か……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
