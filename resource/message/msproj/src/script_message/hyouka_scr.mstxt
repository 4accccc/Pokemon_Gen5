	<TextRow
		Label="msg_hyouka_i07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だいぶ　りっぱな　ポケモンずかんね！
あとひといきで　ページが　うまりそう▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>だいぶ　立派な　ポケモン図鑑ね！
あとひといきで　ページが　埋まりそう▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
