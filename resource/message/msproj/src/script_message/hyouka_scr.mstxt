	<TextRow
		Label="msg_hyouka_i02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みつけにくい　ポケモンも　いるから
あきらめずに　くさむらを　あるいてね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
