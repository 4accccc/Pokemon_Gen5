	<TextRow
		Label="msg_hyouka_hakase_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうか……▼
ずかんを　みてほしくなったら
また　ここに　きたまえ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
