	<TextRow
		Label="msg_hyouka_z11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　きまった　ばしょで
レベルアップすることで▽
しんかする　ポケモンも　おるそうだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
