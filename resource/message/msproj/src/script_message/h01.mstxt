				Time="2011-07-26T12:10:24" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T04:05:38" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_h01_girl2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここの　カーブ！　ぎゅうっとなって
ぬけたら　スパーン　となるやろ！▼
って　コガネシティの
ほうげん　つたわってる？</Text>
