	<TextRow
		Label="msg_r08r0101_guide_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３ひきは　おやがわり　となり
いきるために　ひつような▽
ちしきや　わざを　つたえたという……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T05:12:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３匹は　親がわり　となり
生きるために　必要な▽
知識や　技を　伝えたという……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T05:12:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてguide_06</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T05:14:02" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>事情通老人</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:35:22" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
