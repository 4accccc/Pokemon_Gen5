				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r08r0101_guide_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおう…！
その　ポケモンは　まさか…！[Ctrl2:PageClear ]
まっかな　たてがみに
みずみずしい　しっぽ[Ctrl2:LineFeed ]
そして　りっぱな　１ほんのツノ…！[Ctrl2:PageClear ]
ふるい　いいつたえの　とおりじゃ！[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おおう…！
その　ポケモンは　まさか…！[Ctrl2:PageClear ]
真っ赤な　たてがみに
みずみずしい　しっぽ[Ctrl2:LineFeed ]
そして　立派な　１本のツノ…！[Ctrl2:PageClear ]
古い　言い伝えの　とおりじゃ！[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●老人は画面上（ケルディオ）を向いたまま、セリフ。
●主人公は老人を見る。

●この後msg_r08r0101_guide_09へ。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>事情通老人</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r08r0101_guide_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとが　はじめた　いくさが　もとで
この　もりが　やけてしまったとき[Ctrl2:PageClear ]
１ひきの　おさない　ポケモンが
おやと　はぐれてしまった…[Ctrl2:PageClear ]
おやが　いなければ　その　ポケモンは
いきていけないと　おもったのじゃろう[Ctrl2:PageClear ]
コバルオン　テラキオン　ビリジオンは
その　おさない　ポケモンの[Ctrl2:LineFeed ]
おやがわりと　なったのじゃ[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人が　はじめた　戦が　もとで
この森が　焼けてしまったとき[Ctrl2:LineFeed ]
１匹の　幼い　ポケモンが[Ctrl2:LineFeed ]
親と　はぐれてしまった…[Ctrl2:PageClear ]
親が　いなければ　その　ポケモンは
生きていけないと　思ったのじゃろう[Ctrl2:PageClear ]
コバルオン　テラキオン　ビリジオンは
その　幼い　ポケモンの[Ctrl2:LineFeed ]
親代わりと　なったのじゃ[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●老人が（GRIDX=25/GRIDZ=38）に移動。
●画面上を向いたまま、このセリフ。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>事情通老人</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r08r0101_guide_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３ひきは　このこの　おやがわりとなり
いきるために　ひつような[Ctrl2:LineFeed ]
ちしきや　わざを　つたえたという…[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３匹は　この子の　親がわりとなり
生きるために　必要な[Ctrl2:LineFeed ]
知識や　技を　伝えたという…[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●老人が画面左（ケルディオ）を向いて、セリフ。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>事情通老人</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r08r0101_guide_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やがて　おさなかった　ポケモンは
すくすくと　せいちょうし[Ctrl2:LineFeed ]
３ひきをも　しのぐほどの　ちからを[Ctrl2:LineFeed ]
みにつける　ほどに　なったのじゃ[Ctrl2:PageClear ]
ところが…
あるとき　その　わかい　ポケモンは[Ctrl2:LineFeed ]
もりから　すがたを　けしたのじゃ[Ctrl2:PageClear ]
りゆうは　だれにも　わからなかった
わしが　おもうに…[Ctrl2:LineFeed ]
わかものは　いつでも　むてっぽうで[Ctrl2:LineFeed ]
ぼうけんに　あこがれるものじゃ…[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やがて　幼かった　ポケモンは
すくすくと　成長し[Ctrl2:LineFeed ]
３匹をも　しのぐほどの　力を[Ctrl2:LineFeed ]
みにつけたと　いわれるほどになった[Ctrl2:PageClear ]
ところが…
あるとき　その　若い　ポケモンは[Ctrl2:LineFeed ]
森から　姿を　消したのじゃ[Ctrl2:PageClear ]
理由は　だれにも　わからなかった
わしが　思うに…[Ctrl2:LineFeed ]
若者は　いつでも　無鉄砲で[Ctrl2:LineFeed ]
冒険に　あこがれるものじゃ…[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●老人が主人公の隣（GRIDX=25/GRIDZ=40）に
戻ってきてから、セリフ。


●老人のセリフの後、手持ちチェック
　・伝説３匹が揃っている
　　　→ボールを投げて順番に伝説の３匹が出現。
　・伝説３匹が欠けている
　　　→msg_r08r0101_guide_07</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>事情通老人</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r08r0101_guide_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しばらくぶりの　さいかいを
よろこんでいるように　みえるが…[Ctrl2:PageClear ]
３ひきが　ケルディオに
なにかを　つたえようと[Ctrl2:LineFeed ]
しておるのかのう…？[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しばらくぶりの　再会を
喜んでいるように　みえるが…[Ctrl2:PageClear ]
３匹が　ケルディオに
なにかを　伝えようと[Ctrl2:LineFeed ]
しておるのかのう…？[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●コンテ９
・イベント進行を確認</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>事情通老人</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r08r0101_narrator_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コバルオン　テラキオン　ビリジオンは
[Name:PokemonNickname Idx="0" ]に[Ctrl2:LineFeed ]
あたらしい　わざ　しんぴのつるぎを[Ctrl2:LineFeed ]
おしえようとしている！[Ctrl2:PageClear ]
[Name:PokemonNickname Idx="0" ]に　しんぴのつるぎを
おぼえさせますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コバルオン　テラキオン　ビリジオンは
[Name:PokemonNickname Idx="0" ]に[Ctrl2:LineFeed ]
新しい　技　しんぴのつるぎを[Ctrl2:LineFeed ]
教えようとしている！[Ctrl2:PageClear ]
[Name:PokemonNickname Idx="0" ]に　しんぴのつるぎを
覚えさせますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●コンテ１０
・新技を習得させるか確認

０：ケルディオのニックネーム

・「はい／いいえ」選択肢
　はい→技の空きチェック
　いいえ→msg_r08r0101_guide_08</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ナレーター</Text>
			<TextModifiedBy
