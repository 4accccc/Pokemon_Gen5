				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c13gym0102_swleader_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あーあ
まけてんなよな　ホミカ！▼
ってか
あんたが　つよい　ってことか▼
まっ　くやしーけど
ぜんぶ　だしきったし▽
すがすがしーし　スッキリしたし！▼
これ！
あたしに　かった　あかし！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T03:13:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あーあ
負けてんなよな　ホミカ！▼
ってか
あんたが　強い　ってことか▼
まっ　くやしーけど
全部　だしきったし▽
すがすがしーし　スッキリしたし！▼
これ！
あたしに　勝った　証！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T03:13:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・戦闘後メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER2
ジムリーダー・ホミカ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:34:03" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c13gym0102_swleader_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]は　ホミカから
トキシックバッジを　もらった！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T08:11:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]は　ホミカから
トキシックバッジを　もらった！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T08:11:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ファンファーレ＋バッジ入手処理</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
