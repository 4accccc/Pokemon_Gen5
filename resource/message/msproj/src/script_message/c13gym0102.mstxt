	<TextRow
		Label="msg_c13gym0102_swleader2_ng"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まわりの　おとが　おおきすぎて
[Name:TrainerName Idx="0" ]の　こえが　きこえない！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>周囲の　音が　大きすぎて
[Name:TrainerName Idx="0" ]の　声が　きこえない！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T02:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・他のトレーナーに勝利前で
　戦闘できない
・0＝主人公名前</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER2
ジムリーダー・ホミカ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:34:03" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c13gym0102_swleader2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いくよ！　あんたの　りせい
ブッとばすから！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T03:37:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いくよ！　あんたの　理性
ブッとばすから！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T03:37:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・戦闘前メッセージ
・ギザウインで</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T04:55:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER2
ジムリーダー・ホミカ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:34:03" />
		</AttributeCell>
		<AttributeCell
