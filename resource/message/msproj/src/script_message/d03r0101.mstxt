<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d03r0101_fighterm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リゾートデザートで　きたえるため
はるばる　きたのだが……▼
みずタイプの　ポケモンが　いれば
らくに　すすめるのになあ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T02:16:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リゾートデザートで　特訓するため
はるばる　来たのだが……▼
みずタイプの　ポケモンが　いれば
楽に　進めるのになあ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T02:16:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ゲート近くに配置
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T04:53:47" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERM
格闘家♂</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d03r0101_sunglasses_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わざわざ　はなしかけてきた
ひとは　きみで　ふたりめ！▼
ものすごく　かんどう　しました！
これを　あげましょう！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わざわざ　話しかけてきた
人は　君で　２人目！▼
ものすごく　感動しました！
これを　あげましょう！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=75、GRIDZ=48に配置
・アイテム入手処理
　No237「やわらかいすな」入手処理
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T04:53:48" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES
サングラス</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d03r0101_sunglasses_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やわらかいすなを　もたせた
ポケモンは　じめんタイプの　わざの▽
いりょくが　ますんだよね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やわらかいすなを　持たせた
ポケモンは　じめんタイプの　技の▽
威力が　増すんだよね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・「やわらかいすな」入手後、自動でメッセージ
・以降、遺跡（＝d04r0101）に入るまでは
　このメッセージ繰り返し</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES
サングラス</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d03r0101_sunglasses_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　こだいのしろは
おおむかしの　えいゆうが▽
ドラゴンポケモンを　したがえて▽
つくった　くにの　あとち　らしいね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T04:54:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　古代の城は
大昔の　英雄が▽
ドラゴンポケモンを　従えて▽
建国した　城の　跡地らしいね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T04:54:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・d04r0101に入ってからはこのメッセージ
※swanではメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T04:54:23" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES
サングラス</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d03r0101_backpackerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おお！　すなのうみ！　ここは
ゴーゴーゴーグル　いらないんですね▼
ホウエンの　さばくに　あった
げんえいのとうは　きえました▼
イッシュの　さばくからも
こだいのしろは　すなに　うもれて▽
きえつつ　ありますね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T02:04:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おお！　砂の海！　ここは
ゴーゴーゴーグル　いらないんですね▼
ホウエンの　砂漠に　あった
幻影の塔は　消えました▼
イッシュの　砂漠からも
古代の城は　砂に　埋もれて▽
消えつつ　ありますね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T02:04:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・すごい端に配置してくれれば
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T02:04:45" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BACKPACKERM
バックパッカ-♂</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d03r0101_mission_add_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうだいな　さばく！
うもれた　おしろ！▼
ある！　ここには　ぜったい
おたからが　ある！▼
そう　ちょっかん　した
あのひから　いちねんが　たちました▼
いまだ　おたからは　みつかりませんが
いまも　ゆめを　おいかけつづける……▼
そんな　まいにちが
たのしくて　しかたがないのです！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:55:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T02:44:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>広大な　砂漠！
埋もれた　お城！▼
ある！　ここには　絶対
お宝が　ある！▼
そう　直感した
あの日から　一年が　経ちました▼
いまだ　お宝は　みつかりませんが
いまも　夢を　追いかけつづける……▼
そんな　毎日が
楽しくて　しかたがないのです！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:56:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T02:44:57" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・フェス用システムフラグがOFF</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T02:44:27" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RANGERM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T02:44:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d03r0101_mission_add_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハイリンクに　フェスミッションの
『[Name:FesMissionName ]』が▽
ついか　されました</Text>
