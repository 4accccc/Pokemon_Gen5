	<TextRow
		Label="msg_d03r0101_hakase2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちなみに　しょうたいは
ヒヒダルマっていう　ポケモンね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T01:59:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
