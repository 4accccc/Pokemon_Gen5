	<TextRow
		Label="msg_d03r0101_hakase2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンぞうの　ことを　しって
きげんを　しらべに　きたの！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモン像の　ことを　知って
起源を　調べに　来たの！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
