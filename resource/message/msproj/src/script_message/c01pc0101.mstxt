	<TextRow
		Label="msg_c01pc0101_man2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おれなら　もったいなくて
ジムリーダー　やめないけどなー</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:42:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おれなら　もったいなくて
ジムリーダー　辞めないけどなー</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:42:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T07:17:29" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN2
青年お洒落</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
