				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01pc0101_middleman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンを　つかまえているかい？▼
たくさん　いたほうが
ポケモンずかんや　ボックスを▽
ながめる　たのしみが　うまれる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T07:23:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンを　捕まえているかい？▼
たくさん　いたほうが
ポケモン図鑑や　ボックスを▽
ながめる　楽しみも　うまれる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T07:24:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T07:17:28" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN2
太ったおじさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T08:44:21" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01pc0101_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　シェイミ！▼
シェイミと　いえば
グラシデアのはな　よね！▼
あたし　たくさん　もっているから
あなたにも　わけてあげるね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　シェイミ！▼
シェイミと　いえば
グラシデアのはな　よね！▼
あたし　たくさん　持っているから
あなたにも　わけてあげるね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・手持ちにシェイミ（配布フラグ）がいて
　「グラシデアのはな」持っていないとき
・メッセージ表示後、アイテム入手処理
　No466「グラシデアのはな」</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:51:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T08:44:33" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c01pc0101_woman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むかしからね　シンオウちほう　では
ありがとう　って　きもちを▼
つたえるときに　グラシデアのはなを
ブーケにして　あげていたの▽
なんだか　いい　はなし　でしょう！▼
だって　グラシデアのはなを　つかえば
ことばに　ださなくても▼
ありがとう　って　きもちを
つたえられるのって　すてきよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昔からね　シンオウ地方では
ありがとう　って　気持ちを▼
伝えるときに　グラシデアのはなを
ブーケにして　あげていたの▽
なんだか　いい　話でしょう！▼
だって　グラシデアのはなを　使えば
言葉に　ださなくても▼
ありがとう　って　気持ちを
伝えられるのって　すてきよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・手持ちにシェイミがいて
　「グラシデアのはな」持っているとき</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:50:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T08:44:34" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c01pc0101_woman2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>グラシデアのはな　しってる？▼
むかしからね　シンオウちほう　では
ありがとう　って　きもちを▼
つたえるときに　グラシデアのはなを
ブーケにして　あげていたのよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グラシデアのはな　知ってる？▼
昔からね　シンオウ地方では
ありがとう　って　気持ちを▼
伝えるときに　グラシデアのはなを
ブーケにして　あげていたのよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:49:57" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・手持ちにシェイミがいないとき</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:50:16" />
		</CommentCell>
