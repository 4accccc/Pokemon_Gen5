<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c05r0403_veteranm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……トレーナーか▼
あいつが　けんざいなら　まよわず
しょうぶを　いどんで　いたのにな▼
かわりと　いっては　なんだが
これでも　うけとってくれたまえ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T11:49:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……トレーナーか▼
あいつが　健在なら　迷わず
勝負を　挑んで　いたのにな▼
代わりと　いっては　なんだが
これでも　受け取ってくれたまえ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T05:51:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No296「おおきなねっこ」
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T05:52:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>VETERANM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T11:47:34" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
