<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r04r1001_waitress_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ね！　ポケモンなきごえモノマネ
ぜひ　きいていってください！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:52:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ね！　ポケモン鳴き声モノマネ
ぜひ　きいていってください！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:35:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：White2ver
・はい/いいえの選択肢表示
　はい　→waitress_02
　いいえ→waitress_03
・手持ちポケモンが1種類のときは
　続けてwaitress_08</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:22:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITRESS</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:27:25" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:43:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r1001_waitress_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>では　あなたが　つれている
ポケモンの　なきごえを……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:52:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:52:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>では　あなたが　連れている
ポケモンの　鳴き声を……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:35:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:52:06" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：White2ver
・はい選択時
・続けて鳴き声再生
　手持ちの中から
　タマゴを除いてランダム抽出
・再生後waitress_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITRESS</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:52:06" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:43:15" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r1001_waitress_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんもの　ソックリですよ？
きいて　くれないんですか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:52:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:52:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本物　ソックリですよ？
きいて　くれないんですか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:52:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:52:06" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：White2ver
・いいえ選択時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:22:25" />
