<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c08gym0101_veteranm_09_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いかなるときも　うえを　めざす！
まいあがる　ドラゴンの　ように！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:36:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いかなる時も　上を　目指す！
舞い上がる　ドラゴンの　ように！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:37:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・戦闘前メッセージ
尻尾にいるトレーナー</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:42:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text />
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-09T06:29:27" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c08gym0101_veteranm_09_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このうえには　おれより　つよい
トレーナーが　まっているぞ▼
みぎには　こうげきじゅうしの
トレーナー▼
ひだりには　ぼうぎょじゅうしの
トレーナーが　まっている▼
とちらかの　トレーナーを
たおせば　うえに　すすめるぞ▼
どちらと　たたかうか
じぶんの　みちだ▽
じぶんで　きめるんだな</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-20T03:53:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この上には　おれより　強い
トレーナーが　待っているぞ▼
右には　攻撃重視の
トレーナー▼
左には　防御重視の
トレーナーが　待っている▼
どちらかの　トレーナーを
倒せば　上に　進めるぞ▼
どちらと　戦うか
自分の　道だ▽
自分で　決めるんだな</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-20T03:53:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・戦闘後メッセージ
尻尾にいるトレーナー</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:43:05" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text />
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-09T06:29:29" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c08gym0101_veteranm_10_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうげきこそ　さいだいの　ぼうぎょ！
ちからこそ　すべてさ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:42:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>攻撃こそ　最大の　防御！
力こそ　全てさ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:42:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・戦闘前メッセージ
右足にいるトレーナー</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:43:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text />
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-09T06:29:29" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c08gym0101_veteranm_10_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このうえの　トレーナーは
ふだんとは　ちがう　バトルを▽
いどんでくるぞ▼
みぎは　トリプルバトル
ひだりは　ローテーションバトルだ▼
じぶんの　とくいな　バトルを
えらぶと　いい▼
でも　ちゅういしろよ▼
てもちの　ポケモンが
3びきいじょう　いないと▽
たいせんを　うけてくれないからな</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-20T03:53:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この上の　トレーナーは
普段とは　違う　バトルを▽
挑んでくるぞ▼
右は　トリプルバトル
左は　ローテーションバトルだ▼
自分の　得意な　バトルを
選ぶと　いい▼
でも　注意しろよ▼
手持ちの　ポケモンが
3匹以上　いないと▽
対戦を　受けてくれないからな</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-20T03:53:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・戦闘後メッセージ
右足にいるトレーナー</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:45:33" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text />
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-09T06:29:29" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c08gym0101_veteranw_07_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼうぎょこそ　さいだいの　こうげき！
てっぺきのまもりを　おみせするわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:46:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>防御こそ　最大の　攻撃！
鉄壁の守りを　お見せするわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:46:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・戦闘前メッセージ
左足にいるトレーナー</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:46:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text />
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-09T06:29:29" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c08gym0101_veteranw_07_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このうえの　トレーナーは
ふだんとは　ちがう　バトルを▽
いどんでくるわよ▼
みぎは　トリプルバトル
ひだりは　ローテーションバトルね▼
あなたが　どちらを　えらぶか
たのしみね▼
でも　ちゅういしてね▼
てもちの　ポケモンが
3びきいじょう　いないと▽
たいせんを　うけてくれないわよ</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-20T05:53:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この上の　トレーナーは
普段とは　違う　バトルを▽
挑んでくるわよ▼
右は　トリプルバトル
左は　ローテーションバトルね▼
あなたが　どちらを　選ぶか
楽しみね▼
でも　注意してね▼
手持ちの　ポケモンが
3匹以上　いないと▽
対戦を　受けてくれないわよ</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-20T05:53:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・戦闘後メッセージ
左足にいるトレーナー</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-06-15T10:48:09" />
		</CommentCell>
		<AttributeCell
