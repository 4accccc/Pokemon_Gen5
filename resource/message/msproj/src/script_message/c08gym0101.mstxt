	<TextRow
		Label="msg_c08gym0101_veteranm_11_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トリプルバトル……！▼
３びきの　はかいりょくを
さらに　たかめる　くみあわせだぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-09T03:45:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トリプルバトル……！▼
３匹の　破壊力を
さらに　高める　組み合わせだぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-09T03:48:04" />
