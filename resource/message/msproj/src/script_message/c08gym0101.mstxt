	<TextRow
		Label="msg_c08gym0101_veteranm_11_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おれと　たたかうなら
げんきな　ポケモンを▽
３びきいじょう　つれてくるんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-09T03:40:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おれと　戦うなら
元気な　ポケモンを▽
３匹以上　連れてくるんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-09T03:40:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：右腕トレーナー
・所持ポケモンが3匹以下の場合の注意</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-09T03:46:26" />
		</CommentCell>
