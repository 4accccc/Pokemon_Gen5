	<TextRow
		Label="msg_c08gym0101_veteranw_07_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼうぎょこそ　すべて！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-09T03:27:56" />
			<Status>Editing</Status>
