	<TextRow
		Label="msg_c08gym0101_swleader7_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしい▼
きみと　であい
たたかえたこと　かんしゃする▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T10:18:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
