			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c08gym0101_veteranm_10_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうげきこそ　すべて！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-09T03:24:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
