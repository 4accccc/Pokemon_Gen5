				Time="2011-06-07T10:22:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>DANPEI
ダンペイ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T08:43:31" />
		</AttributeCell>
		<AttributeCell
