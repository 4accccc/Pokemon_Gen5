	<TextRow
		Label="msg_c04r0303_fottoballm16_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かつことが　すべてじゃあ　ない▼
かつために　あきらめず
どりょくすることが　すべてなんだよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
