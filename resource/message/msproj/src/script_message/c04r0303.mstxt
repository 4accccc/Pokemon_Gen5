			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c04r0303_fottoballm12_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アメフトって　ありとあらゆる
フォーメーションを　ばっちり▽
おぼえないと　ダメなんだぜ！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アメフトって　ありとあらゆる
フォーメーションを　ばっちり▽
覚えないと　ダメなんだぜ！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
