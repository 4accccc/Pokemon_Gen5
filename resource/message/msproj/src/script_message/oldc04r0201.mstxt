	<TextRow
		Label="msg_oldc04r0201_old_champion_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しかくいメガネは　エレガント
かおに　つけると　いい　グッズ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:46:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:29:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しかくいメガネは　エレガント
顔に　つけると　いい　グッズ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T07:08:42" />
			<Status>Editing</Status>
