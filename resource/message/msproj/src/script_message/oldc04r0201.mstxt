	<TextRow
		Label="msg_oldc04r0201_old_champion_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>グッズの　よこじまネクタイ
からだに　つければ　クール！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:46:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:41:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グッズの　よこじまネクタイ
体に　つければ　クール！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T07:09:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:41:38" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・右に２歩＋上に２歩、その場振り向きしてから
・続けて</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T07:01:45" />
		</CommentCell>
