	<TextRow
		Label="msg_oldc04r0201_old_champion_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こしに　まいた　ちゃいろバックル！
こりゃまた　なんとも　クール！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:50:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:29:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腰に　まいた　ちゃいろバックル！
こりゃまた　なんとも　クール！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T07:09:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
