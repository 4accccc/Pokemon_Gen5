	<TextRow
		Label="msg_oldc04r0201_old_champion_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キュートな　ブルーのかみどめを
みみに　つけてみたりして？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:45:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:29:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キュートな　ブルーのかみどめを
耳に　つけてみたりして？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T07:08:38" />
