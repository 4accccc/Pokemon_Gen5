	<TextRow
		Label="msg_r07r0301_oldman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あらしに　なっとる　みちに　いけば
くさむらで　とびだしてくるじゃろう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あらしに　なっとる　道に　いけば
くさむらで　飛び出してくるじゃろう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
