<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r07r0301_oldwoman_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やさいを　たっぷり　にこんで
おいしい　スープを　つくるんじゃー</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>野菜を　たっぷり　煮込んで
おいしい　スープを　つくるんじゃー</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●移動ポケモンイベント起動前のセリフ。
●台所に立っている。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldman_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りょうりを　している　ときは
おしゃべりが　とまるからな▽
わしも　らくちん　なんじゃよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:03:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>料理を　している　ときは
おしゃべりが　とまるからな▽
わしも　らくちん　なんじゃよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:03:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●移動ポケモンイベント起動前のセリフ。
●テーブルの右脇に配置。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おじいさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldwoman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わけえ　からってな
つめてー　あめに　うたれとったら▽
カゼさんに　なっちまうぞー▼
スープでも　のむかー？
くちに　あうか　わからんがのー</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:05:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わけえ　からってな
つめてー　雨に　うたれとったら▽
カゼさんに　なっちまうぞー▼
スープでも　飲むかー？
口に　合うか　わからんがのー</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:05:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・主人公をテーブルまで移動させてから、セリフ。
・「はい／いいえ」選択肢
●はい　→msg_r07r0301_oldwoman_02
●いいえ→msg_r07r0301_oldwoman_03</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldwoman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それで　ええのじゃー
わかい　うちは　えんりょなんか▽
するもんじゃ　ねえぞー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:08:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それで　ええのじゃー
わかい　うちは　遠慮なんか▽
するもんじゃ　ねえぞー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:05:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●「はい」の場合
・喋った後、台所まで移動。

●ｗの場合はmsg_r07r0301_oldwoman_04w
●ｂの場合はmsg_r07r0301_oldwoman_04b</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldwoman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そう　いわんと　すこし　のめばええー▼
ばあちゃんの　はなしに
すこし　つきあって　くれんかのー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そう　いわんと　すこし　飲めばええー▼
ばあちゃんの　話に
すこし　つきあって　くれんかのー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:05:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●「いいえ」の場合
・喋った後、台所まで移動。

●ｗの場合はmsg_r07r0301_oldwoman_04w
●ｂの場合はmsg_r07r0301_oldwoman_04b</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldwoman_04w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュちほう　にはなー
こんな　らいうを　おこす▽
ボルトロス　って　なまえの▽
ポケモンさんが　おるんじゃよー▼
このちほうを　ぐるぐる　とびまわって
すんげー　かぜと　かみなりを▽
ごろんごろん　ならすんじゃー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:10:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッシュ地方　にはなー
こんな　雷雨を　起こす▽
ボルトロス　って　名前の▽
ポケモンさんが　おるんじゃよー▼
この地方を　ぐるぐる　飛びまわって
すんげー　風と　カミナリを▽
ごろんごろん　鳴らすんじゃー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:06:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●ｗのセリフ
・喋ったあと主人公の隣（上）まで移動。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldwoman_04b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュちほう　にはなー
こんな　おおあらしを　おこす▽
トルネロス　って　なまえの▽
ポケモンさんが　おるんじゃよー▼
このちほうを　ぐるぐる　とびまわって
すんげー　かぜと　あめを▽
ざんざか　ふらしているんじゃー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:10:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッシュ地方　にはなー
こんな　おおあらしを　起こす▽
トルネロス　って　名前の▽
ポケモンさんが　おるんじゃよー▼
この地方を　ぐるぐる　飛びまわって
すんげー　風と　雨を▽
ざんざか　ふらしているんじゃー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:06:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●ｂのセリフ
・喋ったあと主人公の隣（上）まで移動。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
