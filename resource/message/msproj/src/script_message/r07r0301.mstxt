				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldwoman_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どこぞの　だれかが
ポケモンさんを　こらしめたようじゃー▼
もしかしたら
あの　ポケモンさんかのー？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:09:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どこぞの　だれかが
ポケモンさんを　こらしめたようじゃー▼
もしかしたら
あの　ポケモンさんかのー？</Text>
			<TextModifiedBy
