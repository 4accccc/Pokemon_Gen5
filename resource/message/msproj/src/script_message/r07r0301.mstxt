		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldwoman_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほれ　のんでみなさいー
あったまるぞー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:08:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほれ　飲んでみなさいー
温まるぞー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:06:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・喋った後、小さなアクション（手渡し）
・主人公も応じてアクション</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_narration_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やさいが　たっぷりの　スープ！
とっても　おいしい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:08:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>野菜が　たっぷりの　スープ！
とっても　おいしい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:08:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・「！」表示後、メッセージ。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ナレーション</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldwoman_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だいじに　そだてとった　さくもつが
おおあめで　ダメに　なるんよー▼
ほんとに　こまった　ポケモンじゃー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:09:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大事に　育てとった　作物が
大雨で　ダメに　なるんよー▼
ほんとに　こまった　ポケモンじゃー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:06:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・続けてこのセリフ。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0301_oldwoman_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つかまえようと　おもってもなー
あっちこっち　とびまわっとって▽
みつけたー　おもっても▽
すぐに　にげて　しまうんじゃー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:10:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>捕まえようと　おもってもなー
あっちこっち　飛びまわっとって▽
みつけたー　おもっても▽
すぐに　逃げて　しまうんじゃー▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:06:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・フキダシを出し直して、このセリフを喋る。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
