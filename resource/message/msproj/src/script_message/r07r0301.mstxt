	<TextRow
		Label="msg_r07r0301_oldwoman_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つかまえようと　おもってもなー
あっちこっち　とびまわっとって[Ctrl2:LineFeed ]
みつけたー　おもっても[Ctrl2:LineFeed ]
すぐに　にげて　しまうんじゃー[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>捕まえようと　おもってもなー
あっちこっち　飛びまわっとって[Ctrl2:LineFeed ]
みつけたー　おもっても[Ctrl2:LineFeed ]
すぐに　逃げて　しまうんじゃー[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・フキダシを出し直して、このセリフを喋る。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
