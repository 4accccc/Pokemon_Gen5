<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c03p13_boy2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リバティガーデンとう　かあ▼
むかしの　おおがねもちが
ビクティニって　ポケモンを▽
かくまって　いたんだって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T05:33:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リバティガーデン島　かあ▼
昔の　大金持ちが
ビクティニって　ポケモンを▽
かくまって　いたんだって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T05:33:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T09:56:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c03p13_veteranm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふぉふぉふぉ！　ビクティニの
ちからを　あくようして　つよくなろう▼
そんなことを　たくらむから
プラズマだんは　ほろんだんじゃろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T02:54:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふぉふぉふぉ！　ビクティニの
能力を　悪用して　強くなろう▼
そんなことを　たくらむから
プラズマ団は　滅んだんじゃろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T02:54:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T09:56:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>VETERANM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c03p13_captain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ごうかきゃくせんと　くらべれば
とても　ちいさな　ふねですが▼
おおうなばらを　すすむ　ロマンに
ふねの　サイズは　かんけいないです▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>豪華客船と　くらべれば
とても　小さな　船ですが▼
大海原を　航海する　ロマンに
船の　サイズは　関係ないのです▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=20、GIRIDZ=13
・話し掛けると、振り向いてセリフ
・続けてcaptain_02
※swanで処理変更</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T07:19:48" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>PILOT
船長</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p13_captain_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リバティガーデンとうへ
いかれますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T05:37:23" />
