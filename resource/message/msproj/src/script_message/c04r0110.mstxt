				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c04r0110_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おともだちの
せんたくを　まっています</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T09:19:14" />
			<Status>Editing</Status>
