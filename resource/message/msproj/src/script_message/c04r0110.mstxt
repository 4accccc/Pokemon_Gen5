	<TextRow
		Label="msg_c04r0110_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょうせんを　ちゅうし　しますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
