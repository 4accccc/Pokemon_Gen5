	<TextRow
		Label="msg_c04r0110_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レポートを　かいて
ちゅうだん　しますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
