				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r16_swbell_13"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごいね！　だいはっけん！
だいはっけん　だよお！▼
ほかにも　かくしあなが　あるか
あたしも　しらべてみるねえ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T12:51:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T12:50:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごいね！　大発見！
大発見　だよ！▼
他にも　隠し穴が　あるか
あたしも　調べてみるねえ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T11:03:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T12:50:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・かくしあな発見時にはい/いいえで
　はい選択時
・マップ移動するとベルもついてきて
　！マーク表示後に、このメッセージ表示
・表示後、ベルだけ外にでていく
</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T12:50:28" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T12:50:28" />
		</AttributeCell>
