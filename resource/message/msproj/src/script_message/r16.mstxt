	<TextRow
		Label="msg_r16_swbell_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごおい！
じゃあ　すぐに　みつかるかも▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T12:50:28" />
