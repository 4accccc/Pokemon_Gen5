	</TextRow>
	<TextRow
		Label="msg_d06_leader_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヤーコン『またせたな[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
