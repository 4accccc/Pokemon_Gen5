			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wifi_counter_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｗｉ－Ｆｉコネクションを
