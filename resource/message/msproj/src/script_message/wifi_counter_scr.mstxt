			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｗｉ－Ｆｉコネクションを
ご利用ですか？</Text>
