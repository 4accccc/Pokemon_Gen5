	<TextRow
		Label="msg_gts_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ＧＴＳで　ポケモン　こうかんを
おこないますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
