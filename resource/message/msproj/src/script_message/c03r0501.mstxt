	<TextRow
		Label="msg_c03r0501_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミスターロック……
なぞの　ひと……▼
あら？　いま　わたくし
なにか　いいましたっけ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T09:40:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミスターロック……
なぞの　ひと……▼
あら？　いま　わたくし
なにか　いいましたっけ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T09:40:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・GRIDX=3、GRIDZ=3
※swanでメッセージ修正
※要調整</Comment>
