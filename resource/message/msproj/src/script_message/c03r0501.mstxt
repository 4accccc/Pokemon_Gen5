<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c03r0501_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おれの　ことを　しんぱいして
こうかんする　ポケモンに▽
おだいじに　となづけた　あいつ……▼
いまも　げんきに　しているだろうか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おれの　ことを　心配して
交換する　ポケモンに▽
おだいじに　となづけた　あいつ……▼
今も　達者に　しているだろうか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・swanでメッセージ変更</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T03:07:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
