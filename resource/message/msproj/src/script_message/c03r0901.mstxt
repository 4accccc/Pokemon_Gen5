				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0901_mission_add_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとりで　はたらく　おかあさんの
おてつだいを　しないとね▼
ヒウンシティで　であった
ポケモンたちと　ちからを　あわせて▼
メロエッタの　うた　おどり……
ふしぎな　メロディ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-19T06:06:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T01:25:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一人で　働く　お母さんの
お手伝いを　しないとね▼
ヒウンシティで　出会った
ポケモンたちと　力を　合わせて
メロエッタの　歌　踊り……
不思議な　メロディ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-19T06:06:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-12-19T01:25:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・イベント終了
　以後このメッセージ繰り返し
※swan新規</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-19T05:50:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-19T05:49:33" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
