	</TextRow>
	<TextRow
		Label="msg_t06_champion_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アデク『おう　こっちだ！
では　しゅぎょう　しようか！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T03:39:12" />
