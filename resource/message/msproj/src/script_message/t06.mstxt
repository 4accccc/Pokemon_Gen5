<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t06_champion_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アデク『そうだ！　[Name:TrainerName Idx="0" ]
おまえさんの　ポケモンは　げんきか？▼
トレーナーの　おまえさんのため
がんばってくれるのは　ポケモンだ▽
いつだって　いたわってやらんとな！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アデク『そうだ！　[Name:TrainerName Idx="0" ]
おまえさんの　ポケモンは　元気か？▼
トレーナーの　おまえさんのため
がんばってくれるのは　ポケモンだ▽
いつだって　いたわってやらんとな！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アデク配置（local　13、23）右向き
・pos（local　9.22～9.25）
　アデクに！マーク表示後、
　振り向いてメッセージ
・続けてchampion_02</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CHAMPION
アデク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:28:36" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t06_champion_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わしの　いえは　まだまだ　さき▼
ポケセンに　いくか　どうかは
おまえさんに　まかせるわい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T12:12:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わしの　家は　まだまだ　先▼
ポケセンに　よるか　どうかは
おまえさんに　任せるわい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T12:12:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・表示後、右→上方向に移動
・画面外に消えると主人公操作可能に</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CHAMPION
アデク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:28:36" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t06_champion_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アデク『おう　こっちだ！
では　しゅぎょう　しようか！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T03:39:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アデク『おう　こっちだ！
では　修行しようか！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T03:39:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・寺子屋（＝t06r0101）付近
　pos（local 15、29）右向き
・posを踏むとイベント発動
・表示後、主人公移動してアデクに隣接
・続けてchampion_04</Comment>
