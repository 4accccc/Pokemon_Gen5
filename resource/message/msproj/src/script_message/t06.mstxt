	<TextRow
		Label="msg_t06_champion_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほほう！
ともだちの　タウンマップか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T07:11:32" />
