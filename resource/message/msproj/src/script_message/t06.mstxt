	</TextRow>
	<TextRow
		Label="msg_t06_boy1a_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アデクさんに　おしえてもらったこと
きみも　しりたい？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T04:55:27" />
