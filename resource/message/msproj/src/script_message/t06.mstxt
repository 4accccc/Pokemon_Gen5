	<TextRow
		Label="msg_t06_champion_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なるほど！
ともだちの　タウンマップか▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なるほど！
友達の　タウンマップか▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・！マーク表示後にメッセージ表示
・続けてchampion_06</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CHAMPION
アデク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
