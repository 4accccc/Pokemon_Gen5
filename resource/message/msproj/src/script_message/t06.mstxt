				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t06_champion_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２０ばんどうろ　なら
みちなりに　すすめば　すぐだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T03:25:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２０番道路なら
道なりに　進めば　すぐだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T07:18:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・pos（local 17、29）上向きに移動して
　メッセージ表示
　表示後、所定の位置に戻ると
　主人公操作可能になる
・寺子屋へのストッパー：posを踏んだとき
・牧場イベントクリアまで繰り返し</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CHAMPION
アデク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:28:37" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t06_champion_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２０ばんどうろ　なら
みちなりに　すすめば　すぐだ！▼
さあ！　タウンマップを　とどけてこい
それまで　ここで　まっているぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T03:25:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２０番道路なら
道なりに　進めば　すぐだ！▼
さあ！　タウンマップを　届けてこい
それまで　ここで　待っているぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・牧場イベントクリアまで繰り返し
・寺子屋へのストッパー：会話</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CHAMPION
アデク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:28:37" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
