<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d33r0101_event_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふしぎな　けはいが　する……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T02:32:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T02:31:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不思議な　気配が　する……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T02:32:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T02:32:00" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・条件を満たしているときに洞窟に入ると
　このメッセージ表示、続けて主人公を
　所定pos、GRIDX＝？、GRIDZ＝？に誘導
・続けてsppoke1_01
※このままだとポケモンの紹介ができない</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T02:37:02" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>イベント</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T02:31:48" />
		</AttributeCell>
	</TextRow>
