<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_bc10r0301_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いなか　ね……▼
ふべんな　ばしょで　がんばる
じぶんが　すきとか　オレには　むり！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:39:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>田舎ね……▼
不便な　場所で　がんばる
自分が　好きとか　オレには　無理！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:39:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正
※swanでマップ削除</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T06:54:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
