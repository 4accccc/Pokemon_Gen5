				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0301_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しぜんと　のんびり？
そんな　つまらないじんせい　ゴメンだぜ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自然と　のんびり？
そんな　つまらない人生　ゴメンだぜ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
