	<TextRow
		Label="msg_pokewood_rec_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どのきゃくほんを　えらびますか？</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-01T04:38:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの脚本を選びますか？</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-01T04:38:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
