	<TextRow
		Label="msg_pw_studio_08">
		<LanguageCell
			Language="JPN">
			<Text>ＯＫ！　じゃあ　さくひんに
しゅつえんする　ポケモンは　どうする？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-11T10:23:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＯＫ！　じゃあ　さくひんに
しゅつえんする　ポケモンは　どうする？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-11T10:23:44" />
