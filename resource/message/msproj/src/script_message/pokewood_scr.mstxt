	<TextRow
		Label="msg_pokewood_rec_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どのきゃくほんを　えらびますか？</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-01T04:38:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの脚本を選びますか？</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-01T04:38:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>？？？</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>？？？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_pokewood_rec_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それでは　またのきかいを
おまちしています！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-01T04:39:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それでは　またの機会を
お待ちしています！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-01T04:40:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>？？？</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>？？？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_pokewood_rec_03">
		<LanguageCell
			Language="JPN">
			<Text>「[Name:Undefined ]」で
いいですか？</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-01T04:41:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
