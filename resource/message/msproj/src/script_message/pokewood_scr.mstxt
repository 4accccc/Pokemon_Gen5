				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_pokewood_rec_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それでは　またのきかいを
おまちしています！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-01T04:39:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それでは　またの機会を
お待ちしています！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-01T04:40:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
