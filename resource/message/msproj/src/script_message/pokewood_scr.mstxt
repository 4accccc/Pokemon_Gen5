<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_pw_studio_01">
		<LanguageCell
			Language="JPN">
			<Text>ポケウッド　スタジオへ　ようこそ！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:36:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:13:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケウッド　スタジオへ　ようこそ！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:37:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:13:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_02">
		<LanguageCell
			Language="JPN">
			<Text>ヘイ！　[Name:TrainerName ]　じゃないか！！
まえに　キミが　しゅつえんした▽
えいがは　だいヒット　したろ！▼
おかげで　きゃくほんかが　ぞくへんの
だいほんを　かいたんだぜ！▼
ぜひぜひ　チャレンジ　して
また　だいヒットを　とばしてくれよ！　な！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:14:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:14:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヘイ！　[Name:TrainerName ]　じゃないか！！
まえに　キミが　しゅつえんした▽
えいがは　大ヒット　したろ！▼
おかげで　きゃくほんかが　ぞくへんの
台本を　かいたんだぜ！▼
ぜひぜひ　チャレンジ　して
また　大ヒットを　とばしてくれよ！　な！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:14:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:14:02" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_03">
		<LanguageCell
			Language="JPN">
			<Text>えいが　さつえいに　チャレンジするかい？</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>えいが　さつえいに　チャレンジするかい？</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:10" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここ　ポケウッドでは　えいがを
つくることが　できるんだ！▼
だいほんで　きめられた
きょうえんしゃと　えんぎを　して▽
さくひんの　かんせいに▽
ひつような　じょうけんを▽
みたせば　クランク　アップ！▼
さいしんの　ＶＦＸぎじゅつで
あっという　まに　えいがが▽
かんせい　するのさ！▼
イイ　さくひんの　かんせいに
ひつような　じょうけんは▽
だいほんに　よって▽
ちがうから　きを　つけてくれよ！▼
かんせいした　えいがは　ポケウッドに
シアターで　じょうえい　されるから▽
チェック　してくれよな！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:48:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここ　ポケウッドでは　映画を
つくることが　できるんだ！▼
台本で　決められた
共演者と　演技を　して▽
作品の　完成に▽
必要な　条件を▽
満たせば　クランク　アップ！▼
最新鋭の　ＶＦＸ技術で
あっという　間に　映画が▽
完成　するのさ！▼
イイ　作品の　完成に　必要な
条件は　台本に　よって▽
気を　つけてくれよ！▼
完成した　映画は　ポケウッドに
シアターで　上映　されるから▽
チェック　してくれよな！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:48:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:32" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_05">
		<LanguageCell
			Language="JPN">
			<Text>ＷＡＯ！　いま　こうかいちゅうの
さくひんで　スクリーンが▽
いっぱい　だぜ！▼
あたらしい　さくひんを　とるには
いま　こうかいしてる　なかから▽
いっぽん　こうかいを▽
しゅうりょう　しなきゃ▽
ならないんだ！　いいかい？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:56:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＷＡＯ！　いま　公開中の
作品で　シアターの▽
スクリーンは　いっぱい　だぜ！▼
新作を　撮るには
今　公開してる　中から▽
一本　公開を　終了しなきゃ▽
ならないんだ！　いいかい？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:56:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:46" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_06">
		<LanguageCell
			Language="JPN">
			<Text>ＯＫ！　じゃあ　こうかいを
しゅうりょう　する▽
さくひんを　きめてくれよ！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:57:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＯＫ！　じゃあ　公開を
終了　する▽
作品を　決めてくれよ！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:57:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:55" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_07">
		<LanguageCell
			Language="JPN">
			<Text>ＯＫ！　じゃあ　まず　さつえいする
さくひんの　だいほんを▽
えらんで　くれよ！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-11T10:23:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＯＫ！　じゃあ　まず　撮影する
作品の　台本を▽
選んで　くれよ！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:49:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:55" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_08">
		<LanguageCell
			Language="JPN">
			<Text>ＯＫ！　じゃあ　さくひんに
しゅつえんする　ポケモンは　どうする？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-11T10:23:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＯＫ！　じゃあ　作品に
出演する　ポケモンは　どうする？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:49:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:15:55" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_09">
		<LanguageCell
			Language="JPN">
			<Text>ＯＫ！　ＯＫ！　じゃあ　さくひんに
しゅつえんする　ポケモンを　きめてくれ！▼</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:18:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:17:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＯＫ！　ＯＫ！　じゃあ　作品に
出演する　ポケモンを　決めてくれ！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:50:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:17:37" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_10">
		<LanguageCell
			Language="JPN">
			<Text>ＯＫ！　ＯＫ！　じゃあ　この　さくひんに
しゅつえんできる　ポケモンキャストを▼
しょうかいするぜ！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:18:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:17:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＯＫ！　ＯＫ！　じゃあ　この　作品に
出演できる　ポケモンキャストを▼
紹介するぜ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:50:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:17:32" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_11">
		<LanguageCell
			Language="JPN">
			<Text>そうか！　じゃあ　また　きてくれよな！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:17:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:17:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そうか！　じゃあ　また　きてくれよな！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:17:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:17:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_12">
		<LanguageCell
			Language="JPN">
			<Text>ＯＫ！　それじゃあ　さっそく　えいがの
さつえいを　はじめようぜ！▼
レッツ！　シューティングっ！！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:18:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:18:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＯＫ！　それじゃあ　早速　映画の
撮影を　はじめようぜ！▼
レッツ！　シューティングっ！！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T11:50:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:18:01" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_13">
		<LanguageCell
			Language="JPN">
			<Text>さつえい　おつかれ！▼
さっそくだけど　とった　えいがが
どんな　さくひんに　なるか▽
きに　なるだろ！？▼
となりに　いる　こに
はなしけて　みてくれよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T13:26:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T13:16:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>撮影　お疲れ！▼
早速だけど　撮った　映画が
どんな　作品に　なるか▽
気に　なるだろ！？▼
となりに　いる　子に
話しかけて　みてくれよ！</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T13:26:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T13:16:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>撮影終了時のセリフ</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-07-13T13:16:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_pw_studio_sel_01">
