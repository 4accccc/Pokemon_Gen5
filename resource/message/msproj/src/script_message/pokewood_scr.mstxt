	<TextRow
		Label="msg_pw_studio_10">
		<LanguageCell
			Language="JPN">
			<Text>ＯＫ！　ＯＫ！　じゃあ　この　さくひんに
しゅつえんできる　ポケモンキャストを▼
しょうかいするぜ！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:18:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:17:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＯＫ！　ＯＫ！　じゃあ　この　さくひんに
しゅつえんできる　ポケモンキャストを▼
しょうかいするぜ！</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-07-04T12:18:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
