	</TextRow>
	<TextRow
		Label="msg_r06r0101_assistantm4_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てにいれた　シキジカに
ニックネームを　つけますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T10:18:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T10:18:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手に入れた　シキジカに
ニックネームを　つけますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T10:19:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T10:18:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>システム
・はい／いいえの選択肢表示
　はい　→名前入力画面に
　いいえ→終了
・1=ポケモン名</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T10:20:47" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>システム</Text>
