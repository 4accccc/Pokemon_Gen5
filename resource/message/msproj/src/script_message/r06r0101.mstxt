			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r06r0101_assistantm4_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たくさんの　ポケモンを
つれて　おられるの　ですね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T10:20:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T10:19:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たくさんの　ポケモンを
連れて　おられるの　ですね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:15:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T10:22:46" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
