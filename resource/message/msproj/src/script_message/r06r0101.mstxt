	</TextRow>
	<TextRow
		Label="msg_r06r0101_assistantm4_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName ]は
シキジカを　てにいれた！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T10:18:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
