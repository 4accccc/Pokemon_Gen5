	<TextRow
		Label="msg_r06r0101_planter_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ガラスに　さわると　ほんのりつめたい▼
ケースの　なかでは　しょくぶつが
かわいい　みを　つけてる！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
