	<TextRow
		Label="msg_c03r0101_assistantm_01_19"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょうさは　ぶじに　おわったようだな
ちょうさないようを　ほうこくしてくれ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
