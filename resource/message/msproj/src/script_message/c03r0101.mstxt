				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0101_assistantm_01_31"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これからは　じぶんの　しりたいことを
すきなだけ　しらべてくれたまえ▼
こんごも　キミの　かつやくに
きたいしているぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これからは　自分の　知りたいことを
好きなだけ　調べてくれたまえ▼
今後も　キミの　活躍に
期待しているぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
