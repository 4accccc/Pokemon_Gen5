	<TextRow
		Label="msg_c03r0101_girl2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さっき　アンケートを　こたえたら
アンケートようしを　もらえたわよ▼
ぜんぶの　アンケートに
こたえてみようかな……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さっき　アンケートを　答えたら
アンケート用紙を　もらえたわよ▼
全部の　アンケートに
答えてみようかな……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
