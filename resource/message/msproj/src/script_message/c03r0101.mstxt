	<TextRow
		Label="msg_c03r0101_boy4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いま　にんきがある
えいがって　なんだろう？▼
[Name:TrainerName Idx="1" ]たいいんは
