	<TextRow
		Label="msg_c03r0101_woman2_23"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんきたいいんの　アナタ！
ちょっと　まって！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
