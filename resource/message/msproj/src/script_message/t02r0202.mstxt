				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0202_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　ポケモンずかん　には
よわいポケモン　つよいポケモン▼
かっこいいポケモン　かわいいポケモン
たくさんの　ポケモンが　いるのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T09:08:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたの　ポケモン図鑑　には
弱いポケモン　強いポケモン▼
かっこいいポケモン　可愛いポケモン
たくさんの　ポケモンが　いるのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T09:08:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T09:08:49" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1
女性１</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T06:55:07" />
		</AttributeCell>
		<AttributeCell
