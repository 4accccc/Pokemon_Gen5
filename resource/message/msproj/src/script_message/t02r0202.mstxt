	<TextRow
		Label="msg_t02r0202_man1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つかってこそ　どうぐ！　だけど
あつめて　たのしいのも　どうぐ！▼
きみは　どっちの　かんがえ　かな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T07:00:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T06:59:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>使ってこそ　道具！　だけど
集めて　楽しいのも　道具！▼
君は　どっちの　考え　かな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T07:00:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T07:00:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T06:54:46" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN1
青年１</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T06:55:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
