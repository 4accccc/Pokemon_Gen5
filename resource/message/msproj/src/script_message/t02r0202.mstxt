	<TextRow
		Label="msg_t02r0202_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんでも　はいる　すごい
バッグを　もっているんだ！▼
キズぐすりも　たくさん
かって　いれておきなよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんでも　入る　すごい
バッグを　持っているんだ！▼
キズぐすりも　たくさん
買って　入れておきなよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ変更予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:39:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>青年１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
