	<TextRow
		Label="msg_h01r0301_fising_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　どの　どの　ポケモンか
オレに　おしえてくれよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
