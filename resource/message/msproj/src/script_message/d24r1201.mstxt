	<TextRow
		Label="msg_d26r1201_swbell_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うん！　じゃあ　もうちょっと
しらべて　まわろうよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T05:15:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T03:37:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うん！　じゃあ　もうちょっと
調査して　まわろうよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T05:15:29" />
