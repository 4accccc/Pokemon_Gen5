<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t02r0102_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ある　ひとは　いいました
いろんな　かんがえが　あるから▽
あらそいが　うまれるのだと……▼
べつの　ひとは　いいました
いろんな　かんがえが　あるから▽
せかいが　ひろがるのだと……▼
きっと　どちらも　せいかい　なのね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:45:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ある人は　いいました
いろんな　考えが　あるから▽
争いが　うまれるのだと……▼
別の人は　いいました
いろんな　考えが　あるから▽
世界が　広がるのだと……▼
きっと　どちらも　正解なのね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:45:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:47:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1
女性１</Text>
