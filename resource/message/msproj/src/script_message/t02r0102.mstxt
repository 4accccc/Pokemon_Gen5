<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t02r0102_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうしても　いけんが　あわないときは
ポケモンしょうぶ！　なんだけど▽
だんなに　てかげん　されてるかも……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T08:51:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どうしても　意見が　合わないときは
ポケモン勝負！　なんだけど▽
だんなに　手加減　されてるかも……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T08:52:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T08:52:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1
女性１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0102_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなじ　しゅぞくの　ポケモンでも
いっぴきずつ　ちゃんと　みると▽
せいかくも　つよさも　バラバラだね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T08:47:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>同じ　種族の　ポケモンでも
１匹ずつ　ちゃんと　みると▽
性格も　強さも　バラバラだね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T08:51:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
