	<TextRow
		Label="msg_c03r0401_girl1_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒウンシティは　ひろくて
ぐるぐる　めが　まわっちゃうよ▽
あたしだって　まいごに　なるわ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
