		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d02r0101_swleader1_17"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃ　また！▼</Text>
			<TextModifiedBy
