	<TextRow
		Label="msg_d02r0101_hakaim_stop1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まちがった　かちかんを
ハカイするため　なら……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>間違った　価値観を
ハカイするため　なら……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・c02ジムバッジ取得で削除
・GRIDX=78、GRIDZ=73</Comment>
