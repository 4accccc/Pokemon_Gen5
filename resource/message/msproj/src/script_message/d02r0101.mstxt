	<TextRow
		Label="msg_d02r0101_hakaiw_stop2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしたちと　かんがえが　ちがうなら
ぜんりょくで　ジャマしちゃうかも！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしたちと　考えが　異なるなら
全力で　排除しちゃうかも！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・c02ジムバッジ取得で削除
・GRIDX=78、GRIDZ=78</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ＨＡＫＡＩＷ
プラズマ団♀</Text>
