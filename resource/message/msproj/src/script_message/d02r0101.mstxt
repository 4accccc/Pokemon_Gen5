				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d02r0101_list_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……まだまだ
であいが　すくないようね▼
ヤグルマのもりの　ポケモン
すべてと　であったら　おしえて</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-13T03:20:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
