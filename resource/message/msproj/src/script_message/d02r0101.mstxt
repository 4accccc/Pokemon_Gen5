	<TextRow
		Label="msg_d02r0101_leader3_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それじゃあ
アロエねえさんの　ため　やりますか！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それじゃあ
アロエねえさんの　ため　やりますか！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
