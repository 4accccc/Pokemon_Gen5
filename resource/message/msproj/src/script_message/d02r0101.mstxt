		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d02r0101_swleader1_17"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃ　また！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-06T09:18:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
