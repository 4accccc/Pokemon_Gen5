	<TextRow
		Label="msg_d02r0101_sage5_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　プラズマだんで
しちけんじん　だった　アスラ▼</Text>
			<TextModifiedBy
