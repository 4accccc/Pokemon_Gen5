	<TextRow
		Label="msg_d02r0101_hakaim1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだん『ざんねん！
おれは　なにも　もっていない▼
とりかえす　つもりなら
なかまを　さがすことだな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
