				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d02r0101_assistantw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もりで　くらす　ポケモンたちも
こもれびが　すきだと　いいのにね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-06T09:13:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
