				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d02r0101_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　もりのみち　だけどよ▼
きった　きは　ホドモエシティから
せかいに　とどけられるんだと</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　森の道　だけどよ▼
切った　木は　ホドモエシティから
世界に　届けられるんだと</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
