	<TextRow
		Label="msg_d29r0301_workman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おう！　トレーナー
この　トロッコに　のるかい？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T10:40:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おう！　トレーナー
この　トロッコに　乗るかい？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T10:40:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい/いいえの選択肢表示
　はい　→workman2_02
　いいえ→workman2_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T10:42:36" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T10:40:31" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T06:17:20" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0301_workman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おう！
