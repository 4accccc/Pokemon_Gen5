	<TextRow
		Label="msg_n01r0401_boss_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｎ『……ここは
ボクの　せかい　だった　ばしょ</Text>
			<TextModifiedBy
