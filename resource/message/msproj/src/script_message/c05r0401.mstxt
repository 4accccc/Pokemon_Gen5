	<TextRow
		Label="msg_c05r0401_gentleman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ホドモエが　すっかり　さまがわりして
わし　たまげたの　なんのって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:21:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:21:47" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ホドモエが　すっかり　様変わりして
わし　たまげたの　なんのって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:22:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:22:01" />
		</LanguageCell>
		<CommentCell
