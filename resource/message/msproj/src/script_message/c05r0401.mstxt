			<Comment>♂
・swanで追加</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:21:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GENTLEMAN</Text>
