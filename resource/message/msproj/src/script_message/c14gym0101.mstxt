	<TextRow
		Label="msg_c14gym0101_swleader8_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほな　いっとこかい！
ついてくると　えーよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T09:21:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-01T06:16:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほな　行っとこかい！
ついてくると　えーよ！▼</Text>
			<TextModifiedBy
