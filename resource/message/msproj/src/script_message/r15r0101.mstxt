	</TextRow>
	<TextRow
		Label="msg_r15r0101_backpackerw_01b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとは　とかいと　いなかを
いったりきたり　しながら▽
じぶんの　いばしょを　さがすの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:25:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人は　都会と　田舎を
行ったり来たり　しながら▽
自分の　居場所を　探すの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:59:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BACKPACKERW
バックパッカー♀</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T09:26:06" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:58:58" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
