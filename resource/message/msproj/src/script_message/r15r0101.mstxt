	<TextRow
		Label="msg_r15r0101_middleman1_01b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュのなんかん
くろのまてんろうに　しろのじゅどう▽
いったい　なんなんだろうね……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:58:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッシュの難関
黒の摩天楼に　白の樹洞▽
一体　なんなんだろうね……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:58:51" />
			<Status>Editing</Status>
