	<TextRow
		Label="msg_r15r0101_infomationw_01b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゲートを　ぬければ……
さあ　どこに　つながってるかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:26:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゲートを　抜ければ……
さあ　どこに　つながってるかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:26:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:59:06" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW
受付嬢</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:58:57" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
