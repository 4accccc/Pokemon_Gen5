	<TextRow
		Label="msg_r15r0101_backpackerw_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ホワイトフォレストは
しぜんに　あこがれた　ひとが▽
よく　ひっこしてくるのよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ホワイトフォレストは
自然に　あこがれた　人が▽
よく　引っ越してくるのよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
