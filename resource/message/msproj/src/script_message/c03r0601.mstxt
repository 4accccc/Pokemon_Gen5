	<TextRow
		Label="msg_c03r0601_middleman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>４ばんどうろの　いせきは　すごいな！
どんなものでも　はっけんは　いいの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T05:35:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>４番道路の　遺跡は　すごいな！
どんなものでも　発見は　いいの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T05:36:35" />
			<Status>Editing</Status>
