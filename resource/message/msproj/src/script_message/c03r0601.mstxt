	<TextRow
		Label="msg_c03r0601_middleman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>４ばんどうろも　すっかり　かわった！
かわると　なんだか　ワクワクするの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T05:35:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>４番道路も　すっかり　変わった！
変化って　なんだか　ワクワクするの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T05:36:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・WHITEver
※仮メッセージ</Comment>
			<CommentModifiedBy
