	<TextRow
		Label="resort_drill_sel_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここって　なに？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-23T12:05:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:30:41" />
