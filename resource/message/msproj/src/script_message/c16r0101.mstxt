	<TextRow
		Label="resort_prize_owner_info_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　きみに
プレゼントが　あるんだ▼
きみの　しごとを　たすける
あたらしい　ひしょを　スカウト　したよ▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-18T11:00:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きょうは　きみに
