				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_drill_sel_ans_12"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほいくじょでは
ポケモンの　タマゴを　あたためて▼
ふだん　より　はやく
ふか　させることが　できます▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-23T12:44:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>保育所　では
ポケモンの　タマゴを　温めて▼
普段　より　早く
ふか　させることが　できます▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-24T10:08:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>保育所</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-05T10:49:33" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:52:51" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_drill_sel_ans_13"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうじょうでは
ポケモンを　きたえて　つよくします▼
ポケモンの　レベルや
ポケモンの　つよさの　きそポイントを▽
あげることが　できます▼
ポケモンの　レベルを　あげたとき
しんかや　わざを　おぼえることは▽
できないので　ごちゅうい　ください▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-12-15T12:50:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>道場　では
ポケモンを　鍛えて　強くします▼
ポケモンの　レベルや
ポケモンの　強さの　基礎ポイントを▽
あげることが　できます▼
ポケモンの　レベルを　あげたとき
進化や　技を　覚えることは▽
できないので　ご注意　ください▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-24T10:08:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>道場</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-05T10:48:30" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:52:51" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_drill_sel_ans_14"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふるどうぐや　では
ほりだしものを　うっています▼
ほりだしものを　かんていすると
めずらしい　どうぐが▽
みつかる　なんてことも……？▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-26T11:35:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古道具屋　では
掘り出し物を　売っています▼
掘り出し物を　鑑定すると
珍しい　道具が▽
みつかる　なんてことも……？▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-26T11:35:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>古道具屋</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-05T10:48:38" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:52:51" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_drill_sel_ans_15"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カフェ　では
ポケモンと　しょくじが　できます▼
しょくじを　した　ポケモンが
よろこんで　なつきやすく　なります▼
また　しょくじの　こうかに　より
レベルや　つよさの　きそポイントを▽
あげることが　できます▼
ポケモンの　レベルを　あげたとき
しんかや　わざを　おぼえることは▽
できないので　ごちゅうい　ください▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-12-15T12:49:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カフェ　では
ポケモンと　食事が　できます▼
食事を　した　ポケモンが
喜んで　なつきやすく　なります▼
また　食事の　効果に　より
レベルや　強さの　基礎ポイントを▽
あげることが　できます▼
ポケモンの　レベルを　あげたとき
進化や　技を　覚えることは▽
できないので　ご注意　ください▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:53:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カフェ</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-05T10:48:44" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:52:51" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_drill_sel_ans_16"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>びようしつ　では
ポケモンを　きれいに　します▼
カットや　メイクを　することで
ポケモンは　よろこび▽
なつきやすく　なります▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T10:56:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>美容室　では
ポケモンを　きれいに　します▼
カットや　メイクを　することで
ポケモンは　喜び▽
なつきやすく　なります▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-24T10:09:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>美容室</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-05T10:48:50" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:52:51" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff0000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_drill_sel_ans_17"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:ResortTown ]で　たてられる
おみせは　７つの　しゅるいが　あります▼
まちに　しょうたいした　とき
じゅうにん　やりたい　しゅるいの▽
おみせが　たてられます▼
おみせに　ひとを　あんないして
にんきを　あげると　ランクアップして▽
おみせは　おおきく　なります▼
また　だい２ひしょに　はなしかけると
はってん　しやすい　おみせを▽
アドバイスして　くれますよ▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-24T09:57:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:ResortTown ]で　建てられる
お店は　７つの　種類が　あります▼
街に　招待した　とき
住人が　やりたい　種類の▽
お店が　建てられます▼
お店に　人を　案内して
人気を　あげると　ランクアップして▽
お店は　大きく　なります▼
また　第２秘書に　話しかけると
発展しやすい　お店を▽
アドバイスして　くれますよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T10:57:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>お店について
保育所が無い状態

0：街名</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-05T11:46:11" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:52:51" />
		</AttributeCell>
