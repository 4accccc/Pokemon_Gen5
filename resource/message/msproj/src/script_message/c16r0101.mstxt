		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>回答６
「おすすめを　おしえる」って？</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:30:27" />
		</AttributeCell>
