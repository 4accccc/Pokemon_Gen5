			<CellData>#ff0000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_drill_sel_ans_11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなや　では
きのみを　かうことが　できます▼
おみせに　よって　きのみの
しゅるいは　かわることが　あります▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-26T11:42:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>花屋　では
きのみを　買うことが　できます▼
お店に　よって　きのみの　種類は
かわることが　あります▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-26T11:42:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>花屋</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-05T10:49:27" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:52:51" />
		</AttributeCell>
