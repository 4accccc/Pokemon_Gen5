				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_prize_owner_info_03_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしい！！▼
[Name:ResortTown Idx="2" ]は、もう
[Name:ResortMayor Idx="1" ]　のまちだ！▽
あとのことは　たのんだよ▼
もっと　もっと　ひとを
たのしませる　まちに　しておくれ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:14:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すばらしい！！▼
[Name:ResortTown Idx="2" ]は、もう
[Name:ResortMayor Idx="1" ]　の街だ！▽
後のことは　頼んだよ▼
もっと　もっと　ひとを
楽しませる　街に　しておくれ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:14:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>街命名権獲得 入力後


1：市長名
2：街名</Comment>
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-28T10:19:30" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>選択肢７</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_prize_owner_info_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　きみに
プレゼントが　あるんだ▼
アベニューの　ネオンを
じゆうに　かえられる　ようにしたよ▼
ネオンを　かえれば　まちの
ふんいきも　がらっと　かわるよ▼
ネオンで　まちに　きた　ひとを
もっと　よろこばしちゃってよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T05:23:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きょうは　きみに
プレゼントが　あるんだ▼
アベニューの　ネオンを
自由に　変えられる　ようにしたよ▼
ネオンを　変えれば　街の
雰囲気も　がらっと　変わるよ▼
ネオンで　街に　来た　人を
もっと　喜ばしちゃってよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T05:23:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ネオン変更</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-23T13:37:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>選択肢７</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_prize_owner_info_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　きみに
じょげんが　あるんだ▼
きみも　すきなひとを
ひしょに　したいだろう？▼
まちゆく　ひとを
ひしょに　してみないか▼
やりかたは　かんたんだよ▼
はなしかけて　
「スカウトする」を　えらぶんだ▼
この　まちの　みりょくが
あいての　りそうより　たかければ▽
きっと　せいこう　するよ▼
だから　もっと　もっと
まちを　はってん　させちゃってよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T05:24:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きょうは　きみに
助言が　あるんだ▼
きみも　好きな　人を
秘書に　したいだろう？▼
街往く　人を
秘書に　してみないか▼
やりかたは　簡単だよ▼
話しかけて　
「スカウトする」を　選ぶんだ▼
この街の　魅力が
あいての　理想より　高ければ▽
きっと　成功するよ▼
だから　もっと　もっと
街を　発展させちゃってよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T05:27:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>スカウト起動</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-23T13:37:27" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>選択肢７</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_prize_owner_info_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　きみに
ビッグな　プレゼントが　あるんだ▼
きみの　でんどういりを　きねんして
おみせも　リニューアルしたぞ▼
あたらしい　サービスや
しなものが　ふえているから▽
のぞいてみると　いいよ▼
あと　ポケモンの
タマゴって　しっているかい？▼
ポケモンの　タマゴを　ふかを
たすける　おみせも　たてられるように▽
なったから　ためして　みてね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T05:25:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きょうは　きみに
ビッグな　プレゼントが　あるんだ▼
きみの　殿堂入りを　記念して
お店も　リニューアルしたぞ▼
新しい　サービスや
品物が　増えているから▽
のぞいてみると　いいよ▼
あと　ポケモンの
タマゴって　知っているかい？▼
ポケモンの　タマゴを　ふかを
たすける　お店も　建てられるように▽
なったから　試してて　みてね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T05:25:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>殿堂開放</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-15T13:54:30" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>選択肢７</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
