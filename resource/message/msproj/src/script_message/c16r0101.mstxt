				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_prize_owner_info_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　きみに
プレゼントが　あるんだ▼
きみの　しごとを　たすける
あたらしい　ひしょを　スカウト　したよ▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-18T11:00:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今日は　きみに
プレゼントが　あるんだ▼
きみの　仕事を　たすける
新しい　秘書を　スカウト　したよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T05:20:58" />
