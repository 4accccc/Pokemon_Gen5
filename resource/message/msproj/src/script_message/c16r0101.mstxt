	<TextRow
		Label="resort_drill_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:ResortMayor Idx="0" ]！
ごしつもん　ありますか？</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:29:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:ResortMayor Idx="0" ]！
ごしつもん　ありますか？</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:29:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
