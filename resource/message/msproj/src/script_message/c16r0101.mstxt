		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お店に　ついて
知りたいこと　ありますか？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-12-06T03:03:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-04T15:15:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>質問文</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-05T11:45:41" />
