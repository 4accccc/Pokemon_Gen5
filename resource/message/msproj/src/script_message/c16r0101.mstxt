	<TextRow
		Label="resort_drill_sel_ans_11">
		<LanguageCell
			Language="JPN">
			<Text>はなや　では
きのみを　かうことが　できます▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-15T10:33:31" />
