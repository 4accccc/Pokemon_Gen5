	<TextRow
		Label="resort_prize_owner_info_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　きみに
プレゼントが　あるんだ▼
きみの　しごとを　たすける
あたらしい　ひしょを　スカウトしたよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T10:57:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今日は　きみに
プレゼントが　あるんだ▼
きみの　仕事を　たすける
新しい　秘書を　スカウトしたよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T10:57:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>第３秘書追加</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-23T13:37:39" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>選択肢７</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:52:51" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#0080c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_prize_owner_info_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　きみに
プレゼントが　あるんだ▼
きみの　しごとを　たすける
あたらしい　ひしょを　スカウトしたよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T10:57:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-06T11:31:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今日は　きみに
プレゼントが　あるんだ▼
きみの　仕事を　たすける
新しい　秘書を　スカウトしたよ▼</Text>
