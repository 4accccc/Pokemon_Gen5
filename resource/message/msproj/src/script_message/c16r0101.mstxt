	<TextRow
		Label="resort_drill_sel_ans_18"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おみせに　ついて
しりたいこと　ありますか？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
