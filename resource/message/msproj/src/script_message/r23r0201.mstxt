<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r23r0201_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほう！　こんなところに
きゃくじんが　くるとは！▼
せめてもの　おもてなし　だ
これを　もっておゆき▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T09:21:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほう！　こんなところに
客人が　くるとは！▼
せめてもの　おもてなし　だ
これを　持っておゆき▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T09:21:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No354「わざマシン３５」</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T09:13:57" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T03:58:12" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T05:55:26" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r23r0201_oldman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンリーグに　いどみつづけ
そして　やぶれつづけ……▽
いまは　わたしと　いっぴき　だけ▼
あいつを　のこして
さきに　しねないね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T02:21:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T09:14:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンリーグに　挑みつづけ
そして　破れつづけ……▽
いまは　わたしと　一匹　だけ▼
あいつを　残して
先に　死ねないね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T02:21:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T09:17:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T09:15:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T09:14:04" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T05:55:25" />
		</AttributeCell>
	</TextRow>
