	</TextRow>
	<TextRow
		Label="msg_d29r0901_monument_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろがねの　ちからを　もって
ここを　まもる　もの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T05:45:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:26:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鉄の　力を　もって
ここを　守る　もの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T05:44:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:26:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レジ型石版
・レジの背後（POSX15・POSZ9）に配置
・レジスチルであることを表示</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:27:15" />
		</CommentCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
