<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d29r0901_poke57_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろがねの　ちからを　かんじさせる
ポケモンの　ぞうが　うごきだした！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T05:48:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鉄の　力を　感じさせる
ポケモンの　像が　動きだした！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T05:48:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・続けて</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・レジスチル</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0901_poke57_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じ・じ・ぜ・じ・ぞ</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じ・じ・ぜ・じ・ぞ</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・あわせて鳴き声再生
・続けて戦闘に</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・レジスチル</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0901_poke57_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レジスチルは　いせきの
おくふかくへ　きえてしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:52:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レジスチルは　遺跡の
奥深くへ　消えてしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:52:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・捕獲以外で戦闘終了した場合
・マップ再読み込み時に復帰</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:53" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・レジスチル</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:09:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0901_monument_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろがねのま</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T05:42:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:26:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鉄の間</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T05:42:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:26:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>レジ型石版
・入り口付近（POSX15・POSZ50）に配置
・鉄の間であることを表示</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:27:10" />
