	<TextRow
		Label="msg_c12pc0101_white_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベル『では　ポケモンセンターの
あんないを　するね！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
