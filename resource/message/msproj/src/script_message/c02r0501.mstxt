				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02r0501_trainerw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツタージャね！
じゃあ　これを　あげる！▼
ポケモンに　もたせると　くさタイプの
わざの　いりょくが　あがるんだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツタージャね！
じゃあ　これを　あげる！▼
ポケモンに　持たせると　くさタイプの
技の　威力が　あがるんだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ツタージャ(草）選択
・アイテム入手処理
　No239「きせきのタネ」</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERW</Text>
			<TextModifiedBy
