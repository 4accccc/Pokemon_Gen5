	<TextRow
		Label="msg_c02r0501_trainerw_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おしえてくれる　きになったら
また　はなしかけてね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
