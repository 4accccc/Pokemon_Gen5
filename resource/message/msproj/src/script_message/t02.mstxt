				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t02_boss_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｎ『[Ctrl2:CtrlSpeed mode="1"]モンスターボールに
とじこめられている　かぎり……▼
ポケモンは　かんぜんな
そんざいには　なれない▼
ボクは　ポケモンという
トモダチの　ため▽
せかいを　かえねば　ならない[Ctrl2:CtrlSpeed mode="0"]▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｎ『[Ctrl2:CtrlSpeed mode="1"]モンスターボールに
閉じ込められている　かぎり……▼
ポケモンは　完全な
存在には　なれない▼
ボクは　ポケモンという
トモダチの　ため▽
世界を　変えねば　ならない[Ctrl2:CtrlSpeed mode="0"]▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・戦闘後、フィールドに復帰したとき
　このメッセージを表示
・メッセージ表示後、N、2番道路へ
・画面外に消えるとblack_05表示</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>Ｎ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
