	<TextRow
		Label="msg_t02_boodle_03a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいほう？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
