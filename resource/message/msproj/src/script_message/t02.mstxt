	<TextRow
		Label="msg_t02_boss_03a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Ctrl2:CtrlSpeed mode="1"]そうだね　[Name:TrainerName Idx="0"]だったか▼
キミの　ポケモンの　こえを
もっと　きかせてもらおう！[Ctrl2:CtrlSpeed mode="0"]▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Ctrl2:CtrlSpeed mode="1"]そうだね　[Name:TrainerName Idx="0"]だったか▼
キミの　ポケモンの　声を
もっと　聴かせてもらおう！[Ctrl2:CtrlSpeed mode="0"]▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・メッセージ表示後
　ポケモン勝負へ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>Ｎ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
