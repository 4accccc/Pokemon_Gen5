			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t02_hakaim_stop_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みなさま……　これから
だいじな　おはなしを　します▼
もうしばらく　おまちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
