<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t01_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？▼
あなたと　あなたのポケモン
どことなく　にてるって　かんじ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？▼
あなたと　あなたのポケモン
どことなく　似てるって　感じ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T10:52:22" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>女性１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t01_oldman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おじいちゃんが
いいことを　おしえてあげよう▼
いいかね？　いちどに　つれあるける
ポケモンは　６ひきまで　なんじゃ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おじいちゃんが
いいことを　教えてあげよう▼
いいかね？　一度に　連れ歩ける
ポケモンは　６匹まで　なんじゃ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T10:52:23" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>老人１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t01_oldwoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンは　ひとのため
ちからのかぎり　がんばる▼
ひとは　そんな　ポケモンのため
あいをもって　せっする▼
それが　おたがいの　かんけいだよ
わたしは　そう　おもってるよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンは　人のため
ちからのかぎり　がんばる▼
人は　そんな　ポケモンのため
愛をもって　接する▼
それが　お互いの　関係だよ
わたしは　そう思ってるよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T10:52:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>老婆１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t01_bigman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしい　けしきと
すてきな　ねいろ……▼
ぼかぁ　しあわせきぶんに　なれる
ここが　ずっと　すきなんだなぁ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>素晴らしい　景色と
素敵な　音色……▼
ぼかぁ　幸せ気分に　なれる
ここが　ずっと　好きなんだなぁ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・t02r0401近辺
　ISSのヒント
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:50:22" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BIGMAN
太った青年</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t01_girl1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしの　タブンネちゃん！▼
あたしと　であうため
ゆれる　くらむらから　でてきたの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:52:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしの　タブンネちゃん！▼
あたしと　出会うため
揺れる　草むらから　でてきたの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:52:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・下記動作モデルを隣接して配置</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:53:01" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
