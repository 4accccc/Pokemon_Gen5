	<TextRow
		Label="msg_r06r0203_poke4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こふおおおおーっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T08:23:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こふおおおおーっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T08:23:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・GRIDX=7、GRIDZ=4
・r13で戦闘し倒したりした場合
　殿堂入りでココに復帰（暫定）</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T08:25:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE4
ポケモン・コバルオン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T08:25:50" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
