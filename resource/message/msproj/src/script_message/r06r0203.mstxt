<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r06r0203_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんじゅうねんも　さがしもとめた
でんせつの　ポケモン　コバルオン……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T12:43:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T03:41:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>何十年も　探し求めた
伝説の　ポケモン　コバルオン……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T03:48:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T03:41:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・手持ちにコバルオンが
　いる　→oldman_02
　いない→oldman_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:49:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN1</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T03:40:55" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r06r0203_oldman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おお……　おお……！
コバルオン　ではないか……！▼
そうか　そうか
おまえさん　こやつらに……▼
ポケモンと　ひとが
おたがいに　わかりあい　たすけあう▽
そんな　せかいに　なったことを▼
そんな　にんげんが　いることを
つたえられたんだな……！▼
ひとと　ポケモンだけでは　ない……
いきものは　おたがいに　みとめあい▼
しんらいしあって　いきていくことが
いちばん　なんじゃ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:45:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T03:45:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おお……　おお……！
コバルオン　ではないか……！▼
そうか　そうか
おまえさん　こやつらに……▼
ポケモンと　人が
お互いに　わかりあい　助け合う▽
そんな　世界に　なったことを▼
そんな　人間が　いることを
伝えられたんだな……！▼
人と　ポケモンだけでは　ない……
生きるものは　お互いに　認めあい▼
信頼しあって　生きていくことが
一番なんじゃ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:45:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T03:45:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・いる
・一度！マークを表示する</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:55:05" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN1</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T03:47:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r06r0203_oldman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いまだ　にんげんを　にくんでいるのか▼
それとも　ポケモンと　ひとが　ともに
くらす　いまの　せかいを　みて▽
なにか　おもっているのだろうか……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:57:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T12:41:35" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>未だ　人間を　憎んでいるのか▼
それとも　ポケモンと　人が　ともに
暮らす　今の　世界を　みて▽
なにか　思っているのだろうか……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:57:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T12:41:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・いない</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T12:41:31" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN1</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T12:41:24" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r06r0203_poke4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こふおおおおーっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:49:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:49:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こふおおおおーっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:49:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:49:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・GRIDX=7、GRIDZ=4
・r13で戦闘し倒したりした場合
　殿堂入りでココに復帰（暫定）</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:49:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE4
ポケモン・コバルオン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T09:49:26" />
		</AttributeCell>
		<ExtraCell
