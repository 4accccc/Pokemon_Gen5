<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r07r0104_maid_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まさか　したの　３にんが
やぶれてしまう　だなんて……▼
とはいえ　これいじょう
すすむのは　むり▼
あなたは　あの　カップルのため
あたしは　あたしのため　たたかう▽
どちらが　つよいか　わかるでしょ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:29:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まさか　下の　３人が
敗れてしまう　だなんて……▼
とはいえ　これ以上
進むのは　無理▼
あなたは　あの　カップルのため
あたしは　あたしのため　戦う▽
どちらが　強いか　わかるでしょ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:29:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・セイガイハ新婚イベントで
　はいを選択すると出現
・表示後、トレーナー戦闘へ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:00:28" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAID
maid_03</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T04:16:50" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07r0104_maid_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そっか……▼
あたしたち　じぶんのことだけで
そばにいる　ポケモンの　ことすら▽
かんがえて　いなかったわね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:29:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T04:23:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そっか……▼
あたしたち　自分のことだけで
そばにいる　ポケモンの　ことすら▽
考えて　いなかったわね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:29:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T05:16:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・セイガイハ新婚イベント
・メッセージ表示後、階段前から移動</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:00:28" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAID
maid_03</Text>
			<TextModifiedBy
