	<TextRow
		Label="msg_r04r0901_trainerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくはね　ポケモンの
こうげきに　こだわってるね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T07:56:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T07:56:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくはね　ポケモンの
攻撃に　こだわってるね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T07:56:03" />
			<Status>Editing</Status>
