	<TextRow
		Label="msg_c06r0101_boy2_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーさんが　フキヨセの
ジムバッジを　もっていたら▽
すごく　いいことを　おしえてあげる！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
