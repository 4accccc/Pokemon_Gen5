	<TextRow
		Label="msg_c08pc0101_lady_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ソウリュウシティでの
ゆったりとした　ときのながれ……▽
としおいた　わたしに　ぴったりね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-03T03:43:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ソウリュウシティでの
ゆったりとした　時の流れ……▽
年老いた　私に　ぴったりね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-03T03:43:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・White2ver＋氷マップになる前
※swanでメッセージ修正予定</Comment>
