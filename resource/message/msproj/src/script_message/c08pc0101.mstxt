	<TextRow
		Label="msg_c08pc0101_lady_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ソウリュウシティでの
ゆったりとした　ときのながれ……[Ctrl2:LineFeed ]
としおいた　わたしに　ぴったりね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ソウリュウシティでの
ゆったりとした　時の流れ……[Ctrl2:LineFeed ]
年老いた　私に　ぴったりね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
