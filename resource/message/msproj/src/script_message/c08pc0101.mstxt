	<TextRow
		Label="msg_c08pc0101_gentleman_01b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まったく　おなじ　にんげんでも
すむ　せかいに　よっては▽
おおきく　かわるのだろうな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-03T03:43:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まったく　同じ　人間でも
住む　世界に　よっては▽
大きく　変わるのだろうな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-03T03:43:27" />
			<Status>Editing</Status>
