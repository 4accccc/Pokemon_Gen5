	<TextRow
		Label="msg_c08pc0101_boy2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シャガさんが　ポケモンと　たびをするなら
ポケモンが　うけた　いたみを▽
じぶんの　いたみとして　かんじろ　だって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T06:35:38" />
			<Status>Editing</Status>
