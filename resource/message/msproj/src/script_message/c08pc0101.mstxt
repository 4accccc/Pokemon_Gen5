	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c08pc0101_lady_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ソウリュウシティでの
ゆったりとした　ときのながれ……▽
としおいた　わたしに　ぴったりね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-03T03:43:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ソウリュウシティでの
ゆったりとした　時の流れ……▽
年老いた　私に　ぴったりね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-03T03:43:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・White2ver
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-10T09:08:27" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LADY
淑女</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c08pc0101_lady_01b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>のこされた　じかんを
たっぷりと　ゼイタクに　くらす……▽
それができるのが　ソウリュウシティね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-03T03:43:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>残された　時間を
たっぷりと　ゼイタクに　暮らす……▽
それができるのが　ソウリュウシティね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-03T03:43:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・Black2ver
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-10T09:07:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LADY
淑女</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
