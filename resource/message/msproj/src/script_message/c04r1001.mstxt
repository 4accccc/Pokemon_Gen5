	<TextRow
		Label="msg_c04r1001_trainerm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ワルビルの　いろちがい……
いやあ　どぎもを　ぬかれたねえ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-11T02:49:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ワルビルの　色違い……
いやあ　度肝を　抜かれたねえ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-11T02:49:23" />
			<Status>Editing</Status>
