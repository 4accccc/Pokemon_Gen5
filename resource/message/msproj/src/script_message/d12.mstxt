	<TextRow
		Label="msg_d12_police01_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきんは　かんこうきゃくが
すくなくなったから　たいくつだ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:54:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最近は　観光客が
少なくなったから　退屈だ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:54:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●再上陸のセリフ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POLICEMAN</Text>
