			<CellData>#ff00ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d12_sign_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゆうの　ひかりを　ともす　とうだい[Ctrl2:PageClear ]
かんけいしゃ　いがいの
たちいりを　きんし　します</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自由の　光を　ともす　灯台[Ctrl2:PageClear ]
関係者　以外の
立ち入りを　禁止します</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
