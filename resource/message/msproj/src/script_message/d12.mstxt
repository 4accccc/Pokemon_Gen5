	<TextRow
		Label="msg_d12_police01_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミのような　つよい　トレーナーが
いてくれて　ほんとうに　たすかった！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
