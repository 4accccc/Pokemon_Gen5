	<TextRow
		Label="msg_d12_sign_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だい２　さんばし
かんこうせん　のりばは▽
だい１　さんばしに　なります</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
