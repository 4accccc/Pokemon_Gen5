	<TextRow
		Label="msg_d12_visitor04_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しまを　せんきょして
なにを　しようと　してるんだ……？▽
まったく　アヤシイ　れんちゅうだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:49:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>島を　占拠して
なにを　しようと　してるんだ……？▽
まったく　アヤシイ　連中だ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:53:30" />
			<Status>Editing</Status>
