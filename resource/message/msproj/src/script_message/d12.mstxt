	<TextRow
		Label="msg_d12_sign_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゆうの　ひかりを　ともす　とうだい▼
かんけいしゃ　いがいの
たちいりを　きんし　します</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
