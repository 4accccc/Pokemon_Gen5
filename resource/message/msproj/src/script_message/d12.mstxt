				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d12_visitor04_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ　あんたの　その　ポケモン……
しょうりポケモン　ビクティニ！？▼
なに　あんた
かって　かって　かちまくり　なの！？▽
あやかりてえ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:37:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あ　あんたの　その　ポケモン……
しょうりポケモン　ビクティニ！？▼
なに　あんた
勝って　勝って　勝ちまくり　なの！？▽
あやかりてえ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:37:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
