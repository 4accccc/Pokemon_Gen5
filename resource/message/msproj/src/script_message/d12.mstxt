	<TextRow
		Label="msg_d12_sign_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……２００ねんまえ
だいふごうが　しまを　かいとり▼
ひとと　ポケモンが
じゆうに　くらせる▽
せかいを　ねがって▽
リバティガーデンとう　と　なづけました</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:54:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……２００年前
大富豪が　島を　買い取り▼
人と　ポケモンが
自由に　暮らせる▽
世界を　願って▽
リバティガーデン島と　なづけました</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:54:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:13:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>看板・桟橋左</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d12_sign_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だい２　さんばし
かんこうせん　のりばは▽
だい１　さんばしに　なります</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:53:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>第２桟橋
観光船　乗り場は▽
第１桟橋に　なります</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:52:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:13:05" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>看板・桟橋右</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d12_sign_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゆうの　ひかりを　ともす　とうだい▼
かんけいしゃ　いがいの
たちいりを　きんし　します</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:52:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自由の　光を　ともす　灯台▼
関係者　以外の
立ち入りを　禁止します</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:52:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:13:05" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>看板・灯台前</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
