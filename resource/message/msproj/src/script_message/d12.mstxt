	<TextRow
		Label="msg_d12_mariner_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒウンシティに　もどりますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒウンシティに　もどりますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=293、GRIDZ=749、左向き
・破壊中のセリフ
・はい/いいえの選択肢表示
　はい　→mariner_02
　いいえ→mariner_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:50:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>PILOT
船長</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d12_mariner_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すぐに　しゅっこうしますので
じょうせんして　おまちください▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:47:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すぐに　出航しますので
乗船して　お待ちください▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:48:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択
・このあと画面暗転
　ヒウンシティに戻ります
※船の出港デモはカット</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:50:29" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>PILOT
船長</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d12_mariner_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒウンシティに　もどりたいときは
いつでも　こえを　かけてください！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒウンシティに　もどりたいときは
いつでも　声を　かけてください！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
