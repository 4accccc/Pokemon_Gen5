<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c07gym0101_leader_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチク『そのむかし　ケガをして
おちこんでいた　わたしに▽
アデクさんは　いわれた▼
ほかのひとや　ポケモンと　ともにあり
その　ささえに　よって▽
じぶんが　つよくなる……▽
そういう　つよさも　ある　と▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T02:51:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハチク『その昔　ケガをして
おちこんでいた　わたしに▽
アデクさんは　いわれた▼
他の人や　ポケモンと　共にあり
その支えに　よって▽
自分が　強くなる……▽
そういう　強さも　ある　と▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T02:51:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてleader_02
※swanでメッセージ変更
※出現条件未定、ポケウッドと連動予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:05:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER7
元ジムリーダー・ハチク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:49:41" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c07gym0101_leader_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジムリーダーを　つとめ
その　いみ　なんとなく　わかった▼
そして　わたしも
ささえる　つよさを　ひろめたい……▽
そう　ねがうように　なった▼
やくしゃの　みちに　うちこむことで
みんなに　ポケモンと　いきることへの▽
あこがれを　もってもらいたいのだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T02:55:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T02:52:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジムリーダーを　務め
その意味　なんとなく　わかった▼
そして　わたしも　だれかを
支える　強さを　広めたい……▽
そう　願うように　なった▼
役者の　道に　打ち込むことで
みんなに　ポケモンと　生きることへの▽
あこがれを　もってもらいたいのだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:06:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T02:52:20" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・主人公とは別方向を向いて
・続けてleader_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:05:19" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER7
元ジムリーダー・ハチク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T02:52:04" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c07gym0101_leader_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おしえることは　おそわること……
さて　しゅぎょうの　じかんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:04:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T02:57:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>教えることは　教わること……
さて　修行の　時間だ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:07:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:04:58" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・再度、主人公と向き合ってメッセージ
・表示後、退場する
　画面外に消えると操作可能に</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:09:01" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER7
元ジムリーダー・ハチク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T02:57:55" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c07gym0101_glasses_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やっぱ　いいっすねえ……！▼
ジムの　おくで　たたずむ
つわものの　すがた……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:55:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やっぱ　いいっすねえ……！▼
ジムの　奥で　たたずむ
剛の者の　姿……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:56:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ハチクがいるとき
※swanでメッセージ変更</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:53:49" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>DANPEI
ダンペイ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c07gym0101_glasses_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あー　もうしわけ　ないっすねえ▼
ハチクさん　あらためて
やくしゃに　ちょうせん　するって▽
ポケウッドで　ふんとう　してるっす！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:54:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:53:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あー　申し訳ないっすねえ▼
ハチクさん　改めて
役者に　挑戦するって▽
ポケウッドで　奮闘してるっす！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:54:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:53:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ハチクがいないとき
※swanでメッセージ変更</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:53:55" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>DANPEI
ダンペイ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:53:40" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
