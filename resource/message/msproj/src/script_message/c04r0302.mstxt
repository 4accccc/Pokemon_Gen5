	<TextRow
		Label="msg_c04r0302_girl4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しあいの　ときの
プロの　かおって　すてきー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
