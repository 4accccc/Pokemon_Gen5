	<TextRow
		Label="msg_c01r0501_boy3_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>では　もんだい　です▼
どくを　なおす　ポケモンの　どうぐは
つぎのうち　どれでしょう？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>では　問題です▼
どくを　治す　ポケモンの道具は
次のうち　どれでしょう？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
