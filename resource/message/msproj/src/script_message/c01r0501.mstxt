	<TextRow
		Label="msg_c01r0501_boy3_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ピンポーン！▼
せいかい　です！
つぎの　もんだい　です▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
