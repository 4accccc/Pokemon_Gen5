				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c01r0501_trainerm_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんどは　わざに　ついて
アドバイスを　もらいたい▼
とくせい　ふゆうの　ポケモンに
じめんタイプの　わざを　つかうまえに▼
つかっておくと　いい　わざを
さがして　いるんだけど……▼
うちおとす　じゅうりょく　いえき
この　３つの　わざの　うち▽
どれを　つかうと　いいかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-21T03:47:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T12:00:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんどは　技に　ついて
アドバイスを　もらいたい▼
特性　ふゆうの　ポケモンに
じめんタイプの　技を　使う前に▼
使っておくと　いい　技を
探して　いるんだけど……▼
うちおとす　じゅうりょく　いえき
この　３つの　技の　うち▽
どれを　選ぶと　いいかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-21T03:47:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T12:18:00" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>選択肢
１：うちおとす
２：じゅうりょく
３：いえき</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T12:00:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T11:59:49" />
		</AttributeCell>
