			Language="JPN">
			<Comment>ＢＧメッセージ
・まひ選択
・続けてboard_02表示</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>黒板</Text>
