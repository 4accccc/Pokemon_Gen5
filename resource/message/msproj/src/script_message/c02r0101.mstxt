				Time="2012-01-12T06:50:57" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c02r0101_fan4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あこがれの　かぐに　かこまれる！
まさに　ドリームワールド！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:42:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:32:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あこがれの　家具に　囲まれる！
まさに　ドリームワールド！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:41:57" />
