	<TextRow
		Label="msg_c02r0101_fan1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたし　シタンさんに
でしいり　しようかな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:48:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:31:40" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたし　シタンさんに
弟子入り　しようかな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:48:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:48:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・出現条件＝未定
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:32:29" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:29:49" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T06:50:55" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c02r0101_fan2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シタンさんの　かぐは　ぜっぴん！
まさに　ゆめのような　かぐ　だね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:29:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:29:04" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シタンさんの　家具は　絶品！
まさに　夢のような　家具だね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:41:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:29:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・出現条件＝未定
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:32:30" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY4</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:27:59" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T06:50:57" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c02r0101_fan3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぶきようでも　つくりつづければ
かぐは　つくれるんですって……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:40:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:39:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不器用でも　創り続ければ
家具は　創れるんですって……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-11T11:36:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:40:59" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・出現条件＝未定
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:32:31" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:30:03" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
