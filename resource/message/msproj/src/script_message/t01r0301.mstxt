<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t01r0301_middleman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレンのパパ『ん？　きみがもつ
それは　ヒオウギの　ジムバッジ！▼
……　……　……
……　……　……▼
なんと　きみが！　わたしの
むすこが　ジムリーダーに　なって▽
はじめての　チャレンジャー！！▼
ありがとう！　いやいや　だって
ちょうせんしゃが　いなければ▽
ジムリーダーも　ただの　トレーナー！▼
つまり　きみのおかげで　チェレンは
ジムリーダーに　なれたんだよ！▽
ということで　これは　わたしから！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-15T11:01:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレンのパパ『ん？　きみが持つ
それは　ヒオウギの　ジムバッジ！▼
……　……　……
……　……　……▼
なんと　きみが！　わたしの
息子が　ジムリーダーに　なって▽
初めての　チャレンジャー！！▼
ありがとう！　いやいや　だって
挑戦者が　いなければ▽
ジムリーダーも　ただの　トレーナー！▼
つまり　きみのおかげで　チェレンは
ジムリーダーに　なれたんだよ！▽
ということで　これは　わたしから！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-15T11:01:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No043「きのみジュース」
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T08:43:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN2
・チェレンの父</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T08:45:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
