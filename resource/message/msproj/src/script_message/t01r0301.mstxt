				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t01r0301_middleman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレンのパパ『たびは　いいよ！▼
きみは　これまで　たびをして
じぶんの　しらなかった　ものに▽
どれだけ　ふれたか　かぞえたかい？▼
その　かずの　ぶんだけ
きみは　かわったんだろうね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T09:00:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T08:39:36" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレンのパパ『旅は　いいよ！▼
きみは　これまで　旅をして
自分の　知らなかった　ものに▽
どれだけ　ふれたか　数えたかい？▼
その数の　分だけ
きみは　変わったんだろうね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T09:01:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T08:39:36" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T09:40:30" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN2
・チェレンの父</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T08:45:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t01r0301_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレンのママ『あら……
あなた　[Name:TrainerName Idx="1" ]に　にてる……かも▼
[Name:TrainerName ]　っていうんだ
へえ！　あなたも　ポケモンずかんを！▼
みんな　そうやって
おおきく　なっていくのよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T09:17:06" />
