	<TextRow
		Label="msg_c03r1001_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここからだと　テレビ　みにくいよね
ユーには　かんけい　ないけどさ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここからだと　テレビ　観にくいよね
ユーには　関係ないけどさ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
