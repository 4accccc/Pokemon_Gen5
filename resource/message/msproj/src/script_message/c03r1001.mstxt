	<TextRow
		Label="msg_c03r1001_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンと　ワシ！
どちらかが　わらいだせば　つられて
いっしょに　わらうのさ！　グフフ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T04:31:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンと　ワシ！
どちらかが　笑いだせば　つられて
一緒に　笑うのさ！　グフフ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T04:31:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T04:31:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN
山男</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
