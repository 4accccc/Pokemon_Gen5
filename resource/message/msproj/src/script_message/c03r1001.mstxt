<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c03r1001_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンが　よろこんでくれれば
ワシも　うれしくて　わらう！▼
ワシが　わらっているのを　みれば
ポケモンも　うれしくなるだろう！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンが　喜んでくれれば
ワシも　うれしくて　笑う！▼
ワシが　笑っているのを　みれば
ポケモンも　うれしくなるだろう！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ調整予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T03:19:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN
山男</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c03r1001_poke_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……ぐふぐふぐふ！</Text>
