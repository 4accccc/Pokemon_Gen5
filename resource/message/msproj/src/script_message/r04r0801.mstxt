	<TextRow
		Label="msg_r04r0801_boy2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　チュリネと
ぼくの　モンメンを▽
こうかん　してほしいな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T11:11:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T06:58:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　チュリネと
ぼくの　モンメンを▽
交換　してほしいな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T11:11:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T09:56:57" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：White2ver
・ポケモン交換前
・はい/いいえの選択肢表示
　はい→ポケモン選択画面
　いいえ→girl2_02</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:20:53" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T06:58:23" />
		</AttributeCell>
		<ExtraCell
