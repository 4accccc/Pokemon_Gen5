				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0801_boy2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンこうかん！
ポケモンこうかん！▼
せきがいせんで
ポケモンが　いったりきたり！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T06:58:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T06:58:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモン交換！
ポケモン交換！▼
赤外線で
ポケモンが　行ったり来たり！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T09:57:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T09:56:57" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：White2ver
・はい選択
　ポケモン選択画面で条件を満たすポケモンを選択
　メッセージ表示後に、交換デモ開始</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:20:55" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T06:58:23" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0801_boy2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　チュリネと
ぼくの　モンメンだったのが▼
きみの　モンメンと
ぼくの　チュリネに　なりました！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T11:11:56" />
			<Status>Editing</Status>
