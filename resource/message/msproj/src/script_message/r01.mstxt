<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r01_girl1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　ポケモンさん
たいりょくは　ばっちり　かしら？▼
どうろの　まんなかで　ポケモンさんの
たいりょくが　へると▽
たいへんだから　これを　あげる▼
あなたの　バッグの
かいふくポケットに　いれておいてね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T12:15:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたの　ポケモンさん
体力は　ばっちり　かしら？▼
道路の　真ん中で
ポケモンさんの　体力が　減ると▽
大変だから　これを　あげる▼
あなたの　バッグの
回復ポケットに　いれておいてね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T12:16:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手処理
　No017「キズぐすり」
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T11:17:34" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>少女</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r01_girl1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンさんの　たいりょくが　へると
たたかう　げんきが　なくなっちゃうから▼
ムリせず　こまめに
ポケモンさんを　やすませてね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T12:15:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンさんの　体力が　減ると
戦う　元気が　なくなっちゃうから▼
ムリせず　こまめに
ポケモンさんを　休ませてね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T12:16:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・会話後「キズぐすり」入手後
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:52:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>少女</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r01_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カノコしゅっしんの　トレーナーが
２ねんまえ　すごいことを　してさ！▼
プラズマだんと　たたかい
イッシュを　すくったんだよね！▼
おれさ
その　トレーナーに▼
やせいポケモンと　たたかいたいとき
あるいは　つかまえたいときは▼
くさむらに　はいれば　いいってこと
おしえて　あげたんだよね▼
つまり　おれも　イッシュを　すくった
にんげんの　ひとり　ってことだよな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T11:17:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カノコ出身の　トレーナーが
２年前　すごいことを　してさ！▼
プラズマ団と　戦い
イッシュを　救ったんだよね！▼
おれさ
その　トレーナーに▼
野生ポケモンと　戦いたいとき
あるいは　捕まえたいときは▼
草むらに　入れば　いいってこと
教えて　あげたんだよね▼
つまり　おれも　イッシュを　救った
人間の　一人　ってことだよな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T11:17:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T11:12:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>青年</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r01_fishing_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　さきにいる　ポケモンも
ぜーんぶ　つってみたいものだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:59:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:58:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この先にいる　ポケモンも
ぜーんぶ　釣ってみたいものだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:59:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:58:32" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX＝781、GRIDZ＝707
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:58:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FISHING</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T10:58:56" />
		</AttributeCell>
	</TextRow>
