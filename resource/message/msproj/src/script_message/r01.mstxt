	<TextRow
		Label="msg_r01_black_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『アララギはかせ
おまたせ　しました[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
