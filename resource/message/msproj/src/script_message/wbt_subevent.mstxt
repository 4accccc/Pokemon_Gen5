				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_14"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチク　ね！　いまでは
ポケウッドで　だいかつやくの▽
ムービースター　だな▼
とはいえ　もともと
やくしゃ　だったんだけどな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T11:23:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハチク　ね！　いまでは
ポケウッドで　大活躍の▽
ムービースター　だな▼
とはいえ　元々
役者　だったんだけどな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:38:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・キャラ紹介
・msg_wbt_subev_sunglasses_02へ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:50:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:46:30" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:15:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#00ff00</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_15"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>グリーンは
オーキドはかせの　まご　だろ▼
あとは　なんだっけ▼
もとチャンピオンで　トキワシティの
ジムリーダー　だよ　たしか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T04:07:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グリーンは
オーキド博士の　孫だろ▼
あとは　なんだっけ▼
元チャンピオンで　トキワシティの
ジムリーダー　だよ　たしか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:38:35" />
			<Status>Editing</Status>
