	<TextRow
		Label="msg_wbt_subev_sunglasses_info_21"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タケシね！
ニビシティの　ジムリーダーだよ▼
いわタイプの　つかいてで
かたい　まもりが　じまんらしい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
