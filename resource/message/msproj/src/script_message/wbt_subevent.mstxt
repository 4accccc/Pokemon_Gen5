				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_gsleader9_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アンズ『あなたの　ゆうしょうを
すごいと　おもう　きもちと▽
まけて　くやしい　きもち……▼
はんにんまえの　トレーナーである
じぶんを　のりこえるため▼
ちちうえと　しゅぎょうをし
あらためて　あなたに　いどむわ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T04:53:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アンズ『あなたの　優勝を
すごいと　思う　気持ちと▽
負けて　くやしい　気持ち……▼
半人前の　トレーナーである
自分を　のりこえるため▼
父上と　修行をし
あらためて　あなたに　挑むわ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:17:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・優勝後イベント用</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GSLEADER9
アンズ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T12:39:34" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:31:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_rsleader1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツツジ『ひの　うちどころの　ない
まるで　トレーナーの　みほん▽
そういうべき　たたかいかた　でしたわ▼
ゆうしょう　なさるのも　なっとく！
あなたのこと　もっと　しりたいです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T04:45:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツツジ『非の　打ち所の　ない……
まるで　トレーナーの　見本▽
そういうべき　戦い方　でしたわ▼
優勝なさるのも　納得！
あなたのこと　もっと　知りたいです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:18:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・優勝後イベント用</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RSLEADER1
ツツジ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T12:39:37" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:31:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_rsleader2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トウキ『いちい　だった
キミの　じつりょく……▽
まさに　ビッグウェーブ！！▼
ボクと　なみのり　しないか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:19:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トウキ『一位　だった
キミの　実力……▽
まさに　ビッグウェーブ！！▼
ボクと　なみのり　しないか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:19:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・優勝後イベント用</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RSLEADER2
トウキ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T12:39:40" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:31:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_rsleader3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テッセン『わっはははは！
すごい　ゆうしょう　であった！▼
きみの　たたかいぶりには
かんどうして　わらってしまうぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:19:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テッセン『わっはははは！
すごい　優勝であった！▼
きみの　戦いぶりには
感動して　笑ってしまうぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:19:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・優勝後イベント用</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RSLEADER3
テッセン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T12:39:44" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:31:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_rsleader4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アスナ『あなたの　つよさって
じぶんらしさを　だせてることかな▼
あなたの　ゆうしょうで
みんなが　もりあがっていたよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T11:35:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アスナ『あなたの　強さって
自分らしさを　だせてることかな▼
あなたの　優勝で
みんなが　盛りあがっていたよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T08:53:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
