			Name="Character">
			<Text>DPLEADER4
スモモ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T12:40:17" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:31:14" />
		</AttributeCell>
		<ExtraCell
