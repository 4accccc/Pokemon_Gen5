		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER1A
ポッド</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T12:37:53" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
