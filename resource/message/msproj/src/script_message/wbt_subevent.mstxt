				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_24"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリカさま！▼
タマムシシティで
ジムリーダーを　なさる　おじょうさま！▼
しゅみは　いけばな　だっけ？
いねむりの　ほうが　おおそうだけど▼
そういう　のびのびした　ところが
かのじょの　みりょく　なんだよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:08:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エリカさま！▼
タマムシシティで
ジムリーダーを　なさる　お嬢さま！▼
趣味は　生け花　だっけ？
いねむりの　ほうが　多そうだけど▼
そういう　天衣無縫な　ところが
彼女の　魅力なんだよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:45:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・キャラ紹介
・msg_wbt_subev_sunglasses_02へ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:50:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:46:30" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:15:56" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#00ff00</CellData>
			<CellModifiedBy
