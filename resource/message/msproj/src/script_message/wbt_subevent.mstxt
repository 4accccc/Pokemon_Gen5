				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベルちゃんね！
アララギはかせの　じょしゅ　だな！▼
カノコタウン　しゅっしんで
チェレンたちと　いっしょに▽
ぼうけんの　たびを　はじめたんだよ！▼
じぶんでは　けんそん　しているが
かなり　つよい　トレーナーだぜ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:34:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベルちゃんね！
アララギ博士の　助手だな！▼
カノコタウン　出身で
チェレンたちと　いっしょに▽
冒険の　旅を　はじめたって！▼
自分では　けんそん　しているが
かなり　強い　トレーナーだぜ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T08:56:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・キャラ紹介
・msg_wbt_subev_sunglasses_02へ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:50:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:46:30" />
		</AttributeCell>
