	<TextRow
		Label="msg_wbt_subev_sunglasses_info_45"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アダン！▼
ミクリの　ししょうでも　ある
ルネシティの　ジムリーダーだ▼
ま　ダンディ　なんだろうな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T09:59:44" />
			<Status>Editing</Status>
