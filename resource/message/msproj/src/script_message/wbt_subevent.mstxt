	<TextRow
		Label="msg_wbt_subev_sunglasses_info_32"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シジマね▼
おくさんに　たるんできたと　いわれる
タンバシティの　ジムリーダー　だ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
