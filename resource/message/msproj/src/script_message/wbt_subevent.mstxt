				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シズイは　セイガイハシティの
ジムリーダー　だな！▼
それにしても　うみのおとこ　って
しょくぎょう　ではないよな……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T11:19:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シズイは　セイガイハシティの
ジムリーダー　だな！▼
それにしても　海の男　って
職業では　ないよな……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:33:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
