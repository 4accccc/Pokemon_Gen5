				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_25"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ナツメさま！▼
ヤマブキシティが　ほこる
ちょうのうりょくしゃで　ジムリーダー！▼
いやー　かのじょは
イメージてきに　さま　だよな！▼
ああ！　みらいよち　されてえ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T11:55:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ナツメさま！▼
ヤマブキシティが　ほこる
超能力者で　ジムリーダー！▼
いやー　彼女は
イメージ的に　さま　だよな！▼
ああ！　みらいよち　されてえ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:46:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・キャラ紹介
・msg_wbt_subev_sunglasses_02へ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:50:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:46:30" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
