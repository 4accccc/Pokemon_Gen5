	<TextRow
		Label="msg_wbt_subev_sunglasses_info_27"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サカキ　ね……▼
いろんな　ウワサを　きくけれど
くわしいことは　ぞんじません▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:09:38" />
			<Status>Editing</Status>
