				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_gsleader5_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シジマ『うーむ！
きみと　たたかえて　よかった▼
ゆうしょう　する　トレーナーは
なにか　もっていると　いうものだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T04:32:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シジマ『うーむ！
きみと　戦えて　よかった▼
優勝する　トレーナーは
なにか　持っていると　いうものだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:12:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・優勝後イベント用</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GSLEADER5
シジマ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T12:39:20" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:31:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_gsleader6_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミカン『あなたの　やさしさと
ポケモンの　つよさが　あわさって▽
つかんだ　ゆうしょう　ですよね▼
あ　あの……
これからも　ポケモンと　いっしょに▽
……がんばって　くださいね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:16:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミカン『あなたの　優しさと
ポケモンの　強さが　あわさって▽
つかんだ　優勝ですよね▼
あ　あの……
これからも　ポケモンと　一緒に▽
……がんばって　くださいね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:16:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・優勝後イベント用</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T08:57:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GSLEADER6
ミカン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T12:39:24" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:31:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
