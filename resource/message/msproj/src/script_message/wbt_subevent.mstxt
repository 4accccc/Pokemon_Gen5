	<TextRow
		Label="msg_wbt_subev_sunglasses_info_43"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フウは　トクサネシティの
ジムリーダー　だな▼
ふたごの　ランちゃんと　いっしょに
ダブルバトル　してくるよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
