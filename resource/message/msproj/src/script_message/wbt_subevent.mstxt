				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_29"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツクシ　ね▼
あるく　ひゃっかじてん　とも
よばれる　ジムリーダーだね▼
おっと！　いるのは
ヒワダシティ　だったっけ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:47:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツクシ　ね▼
歩く　百科事典とも
呼ばれる　ジムリーダーだね▼
おっと！　いるのは
ヒワダシティ　だったっけ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:47:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・キャラ紹介
・msg_wbt_subev_sunglasses_02へ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:50:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
