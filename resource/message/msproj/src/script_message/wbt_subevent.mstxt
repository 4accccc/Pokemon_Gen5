	<TextRow
		Label="msg_wbt_subev_rgleader7_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サカキ『……いっておく▼
どれだけ　つよくても
いつかは　まけるのだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T08:46:56" />
