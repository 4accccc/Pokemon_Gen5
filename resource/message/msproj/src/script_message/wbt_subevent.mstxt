	<TextRow
		Label="msg_wbt_subev_echampion_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミクリ『はいぼくの　りゆう……
それは……！▼
みずの　イリュージョン！！
それが　たりていなかったのです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-15T04:20:16" />
			<Status>Editing</Status>
