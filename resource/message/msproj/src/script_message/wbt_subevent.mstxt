		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　トレーナーについて
しりたいか　きめてくれよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-14T11:49:30" />
			<Status>Editing</Status>
