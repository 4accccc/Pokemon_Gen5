				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_48"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メリッサさん！▼
あの　ひとは　はでな　みためで
ごかい　されやすいが▽
こころやさしい　ジムリーダーさ！▼
ヨスガシティ　ちかくの
ロストタワーで　ねむる　ポケモンの▽
たましいを　なぐさめたりさ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-24T03:08:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メリッサさん！▼
あの人は　派手な　みためで
誤解されやすいが▽
心優しい　ジムリーダーさ！▼
ヨスガシティ　近くの
ロストタワーで　眠る　ポケモンの▽
魂を　なぐさめたりさ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:55:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:20" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・キャラ紹介
・msg_wbt_subev_sunglasses_02へ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:50:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:46:30" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:15:56" />
		</AttributeCell>
		<ExtraCell
