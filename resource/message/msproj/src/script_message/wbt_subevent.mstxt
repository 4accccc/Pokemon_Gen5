				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_18"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミクリは　ホウエンちほうの
チャンピオン　だな！▽
もとは　ジムリーダーだったんだ▼
なぜ　ダイゴから　かわったんだろ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T03:57:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミクリは　ホウエン地方の
チャンピオン　だな！▽
元は　ジムリーダーだったんだ▼
なぜ　ダイゴから　変わったんだろ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T07:39:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:45:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・キャラ紹介
・msg_wbt_subev_sunglasses_02へ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:50:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SUNGLASSES</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-29T09:46:30" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-13T07:15:56" />
		</AttributeCell>
		<ExtraCell
