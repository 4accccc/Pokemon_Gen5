	<TextRow
		Label="msg_wbt_subev_sunglasses_info_44"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ランちゃんね！▼
トクサネシティの　ジムリーダーを
ふたごである　フウと　やってるよ！▼
ふたご　だけあって
ダブルバトルが　とくい　なんだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T10:09:15" />
			<Status>Editing</Status>
