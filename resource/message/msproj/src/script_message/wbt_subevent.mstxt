	</TextRow>
	<TextRow
		Label="msg_wbt_subev_sunglasses_info_34"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヤナギ　ね▼
チョウジタウンの　ジムリーダーで
しぶい　じいさん　だよな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
