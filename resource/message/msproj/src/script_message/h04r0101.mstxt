<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_h04r0101_oldman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　ビレッジブリッジは　わしの
ヒイヒイヒイヒイおじいさん　たちが▼
ドテッコツたちと　ちからを　あわせ
つくった　はし　なんじゃよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T07:08:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　ビレッジブリッジは　わしの
ヒイヒイヒイヒイおじいさん　たちが▼
ドテッコツたちと　協力し合って
造った　橋なんじゃよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T07:09:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T07:08:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
