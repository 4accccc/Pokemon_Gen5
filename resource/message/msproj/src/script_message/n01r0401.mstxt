				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_n01r0401_boss_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　しろの　いちばん　おく……
ボクにとって　たいせつな　ばしょで▽
キミと　むきあわねば　ならない……！▼
さあ
ついてきたまえ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T07:54:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T11:16:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この城の　一番　奥……
ボクにとって　大切な　場所で▽
キミと　向き合わねば　ならない……！▼
さあ
ついてきたまえ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T07:54:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T11:18:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・メッセージ表示後
　GRIDX＝13、GRIDZ＝20まで移動
・続けてboss_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T12:13:39" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOSS
Ｎ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T09:22:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#408080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_n01r0401_boss_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いや▼
ボクが　あんない　するより
キミが　ここで　なにに▽
きょうみを　しめすのか……？▼
ということだ　キミ！▼
この　しろの　いちばん　おくまで
ボクを　つれていくんだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T07:55:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T11:16:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いや▼
ボクが　案内するより
キミが　ここで　なにに▽
興味を　示すのか……？▼
ということだ　キミ！▼
この城の　一番　奥まで
ボクを　連れていくんだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T07:55:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T11:18:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・このメッセージ表示後
　Ｎ、主人公の後ろに移動
　連れ歩き開始</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T12:13:34" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOSS
Ｎ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T09:22:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#408080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
