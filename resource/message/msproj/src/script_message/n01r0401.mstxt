	<TextRow
		Label="msg_n01r0401_boss_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここは……▼
プラズマだんの　しろ▼
ゲーチスの　ゆめのあと……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T05:17:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T10:59:40" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここは……▼
プラズマ団の　城▼
ゲーチスの　夢の跡……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T05:17:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T10:59:40" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・右を向いて
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T07:50:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOSS
Ｎ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-03T09:22:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#408080</CellData>
			<CellModifiedBy
