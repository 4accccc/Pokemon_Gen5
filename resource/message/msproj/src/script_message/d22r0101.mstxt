				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d22r0101_swrival_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『なかなか　だな▼
ポケモンの　ちからを　ひきだせるよう
ちょっとは　かんがえているし▼
これなら　オレの
サポートとして　たよれる▼
で　なにしに　きたんだ？▼
えっ……
タウンマップ！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T05:28:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『なかなか　だな▼
ポケモンの　力を　ひきだせるよう
ちょっとは　考えているし▼
これなら　オレの
サポートとして　頼れる▼
で　なにしに　来たんだ？▼
えっ……
タウンマップ！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T05:28:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・戦闘後、フィールドに戻ると
　自動でメッセージ表示
・続けてswrival_03
・1＝ライバル名</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ライバル</Text>
			<TextModifiedBy
