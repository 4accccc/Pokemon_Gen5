	<TextRow
		Label="msg_r04r0201_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そんなに　げんきなら　すなあらしでも
どこにだって　いけるね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T08:03:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T08:03:35" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そんなに　元気なら　砂あらしでも
どこにだって　行けるね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T08:03:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T08:03:35" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・HP/PP満タン時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:14:43" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T08:03:35" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
