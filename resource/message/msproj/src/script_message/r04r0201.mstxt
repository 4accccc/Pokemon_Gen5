				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0201_middlewoman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よし！
ちょっと　やすんでいきなよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:28:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T08:03:35" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よし！
ちょっと　休んでいきなよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:28:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T08:03:35" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・HP/PP満タンでない時
　続けて画面暗転して回復処理</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:14:46" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN2</Text>
