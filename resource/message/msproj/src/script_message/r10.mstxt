	<TextRow
		Label="msg_r10_black_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『……ストップ▼
[Name:TrainerName Idx="0" ]！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
