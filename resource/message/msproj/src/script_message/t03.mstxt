				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t03_waitress_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よのなか　たくさんの　ひとがいて
そのひとの　かずだけ　こせいや▽
かんがえが　あるんだよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世の中　沢山の　人がいて
その人の　数だけ　個性や▽
考えが　あるんだよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
