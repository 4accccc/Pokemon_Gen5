	<TextRow
		Label="resort_mouthcomm_q_15"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　つよさで
だいじなのは　どれ？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
