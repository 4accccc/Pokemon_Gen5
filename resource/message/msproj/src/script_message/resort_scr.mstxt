	<TextRow
		Label="resort_mouthcomm_sys_01_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とっても　むずかしい　しつもん　なの
あなた　こたえられる？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
