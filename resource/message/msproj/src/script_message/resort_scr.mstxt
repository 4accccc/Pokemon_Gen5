			Language="JPN">
			<Comment>初期挨拶</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-17T07:57:29" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>性格は？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
