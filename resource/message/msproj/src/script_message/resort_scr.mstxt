	<TextRow
		Label="resort_service_info_rest_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おいしい　ごはんに　のみものが
ついた　おとくな　セット。
ポケモンの　レベルが　１つ　あがる。</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-21T04:58:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おいしい　ごはんに　飲み物が
ついた　お得な　セット。
ポケモンの　レベルが　１つ　あがる。</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-21T04:58:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T07:35:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ふしぎなランチ</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-28T19:03:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>レストラン用説明１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T09:06:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_service_info_rest_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とっても　おいしい　のみもの。
のんだ　ポケモンが
ちょっぴり　なつく。</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-21T06:25:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とっても　おいしい　飲み物。
飲んだ　ポケモンが
ちょっぴり　なつく。</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-21T06:25:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T07:35:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>なつきドリンク</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-11-27T18:05:39" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>レストラン用説明２</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
