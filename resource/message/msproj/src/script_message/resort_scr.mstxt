	<TextRow
		Label="resort_mouthcomm_sys_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんな　すてきな　ばしょには
すきな　ひとと　いたいよね？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T08:57:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんな　すてきな　場所には
好きな人と　いたいよね？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T08:57:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
