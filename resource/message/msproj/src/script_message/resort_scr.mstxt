				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>クチコミ：噂　
恋人いる</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#00ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_mouthcomm_t_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっと　ちょっと
きいて　きいて！▼
[Name:TrainerName Idx="0" ]さんって……
すきなひとが　いない　らしいわ▼
ういた　うわさが　ないひと　よね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
