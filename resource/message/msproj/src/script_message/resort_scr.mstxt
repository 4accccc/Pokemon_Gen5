	</TextRow>
	<TextRow
		Label="resort_secretary_talk_02_m"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……[Name:ResortType ]！
すばらしい！▼
[Name:ResortType ]を
[Name:ResortTown Idx="1" ]に　ひらいたら▼
きっと　おきゃくさまが　おしよせる
にんきの　おみせに　なるでしょう▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-02-02T04:23:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……[Name:ResortType ]！
素晴らしい！▼
[Name:ResortType ]を
[Name:ResortTown Idx="1" ]に　ひらいたら▼
きっと　お客さまが　おしよせる
人気の　お店に　なるでしょう▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-02-02T04:23:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>0：店舗種類名
1：街名</Comment>
			<CommentModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-15T07:01:56" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T09:03:47" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#00ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_secretary_talk_03_m"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……すばらしい　みらいが
たくさん　みえます▼
この　なかで　ズバリ！
なにを　えらびますか？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-27T11:53:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……すばらしい　未来が
たくさん　みえます▼
この中で　ズバリ！
何を　選びますか？</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-14T08:29:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T09:03:47" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#00ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_secretary_talk_04_m"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>では　ひしょの　やくわりを
こうたい　します▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-02-01T06:59:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>では　秘書の　役割を
交代　します▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-02-01T06:59:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T09:03:47" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#00ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_secretary_talk_05_m"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>では　おみせを
ならびかえます▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-02-01T07:00:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>では　お店を
並びかえます▼</Text>
