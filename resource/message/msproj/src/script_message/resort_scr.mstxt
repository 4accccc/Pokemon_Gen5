	<TextRow
		Label="resort_mouthcomm_t_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっと　ちょっと
きいて　きいて！▼
[Name:TrainerName Idx="0" ]さんって……
