	<TextRow
		Label="resort_service_info_rest_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっぴり　ごうかな　ごはんに
デザートが　ついた　メニュー。
ポケモンの　レベルが　１つ　あがる。</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2012-01-21T05:00:00" />
			<Status>Editing</Status>
