				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_mouthcomm_sys_07_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここって　すきなひとと　くるには
さいこうの　ばしょ　よね▼
『すきなひと』に　ついて
うわさを　あつめているんだけど……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
