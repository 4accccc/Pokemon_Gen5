			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_secretary_talk_01_f"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ズバリ！
[Name:ResortShop ]です▼
[Name:ResortShop ]を
[Name:ResortTown Idx="1" ]にひらいたら▽
あっというまに　にんきに　なるでしょう▼</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-09-02T09:30:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ズバリ！
[Name:ResortShop ]です▼
[Name:ResortShop ]を
[Name:ResortTown Idx="1" ]に　ひらいたら▽
あっというまに　人気に　なるでしょう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T06:43:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>0：店舗種類名
1：街名</Comment>
