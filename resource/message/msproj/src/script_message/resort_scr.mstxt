				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#00ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_mouthcomm_sys_01_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたし　すえっこで
おにいちゃんが　ふたり　いるんだけど▼
あまえんぼうに　みえるって
よく　いわれるの▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
