	<TextRow
		Label="resort_mouthcomm_sys_01_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとの　せいかくの　タイプは
ざっくり　２つに　わけられると　おもうの▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-27T16:41:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人の　性格の　タイプは
ざっくり　２つに　わけられると　おもうの▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-27T16:41:19" />
			<Status>Editing</Status>
