			<CellData>#00ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_secretary_talk_10_m"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げんざい　ランク　[Digit:2digits Idx="0" ]
[Name:ResortTitle Idx="2" ]　です▼</Text>
