	</TextRow>
	<TextRow
		Label="resort_mouthcomm_q_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みためと　なかみで
あなたなら　どっちを　とる？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T08:29:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>見た目と　中身で
あなたなら　どっちを　とる？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T08:29:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
