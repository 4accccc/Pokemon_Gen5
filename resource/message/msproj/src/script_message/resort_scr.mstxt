				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_mouthcomm_sys_01_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたし　おんなのひとの　ともだちが
いちばん　おおいの▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
