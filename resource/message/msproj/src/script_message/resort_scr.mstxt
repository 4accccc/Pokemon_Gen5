				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="resort_mouthcomm_sys_01_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたし　すえっこで
おにいちゃんが　ふたり　いるんだけど▼
あまえんぼうに　みえるって
よく　いわれるの▼</Text>
			<TextModifiedBy
				User="shimoyamada:W00184"
				Time="2011-09-30T05:25:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたし　末っ子で
お兄ちゃんが　二人　いるんだけど▼
甘えん坊に　みえるって
よく　いわれるの▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T08:57:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
