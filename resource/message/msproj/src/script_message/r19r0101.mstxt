	<TextRow
		Label="msg_r19r0101_infomationw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンと　いっしょ　なんだ！▼
わたし……
じぶんのことの　ように　うれしいよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
