<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d11r0501_assistantw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げすいどうに　たまった　どくを
くすりに　かえる　じっけん……▼
これが　１００％　せいこうすれば
どくタイプの　ポケモンから▽
どんどん　くすりが　つくれるの！▼
ではでは
ほんじつの　じっけんけっかは……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T02:37:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>下水道に　たまった　どくを
薬に　変える　実験……▼
これが　１００％　成功すれば
どくタイプの　ポケモンから▽
どんどん　薬を　つくれるの！▼
ではでは
本日の　実験結果は……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-29T03:43:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・部屋の中央に配置
・続けてのメッセージ
　60％→assistantw_02
　30％→assistantw_03
　10％→assistantw_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T09:35:41" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:46:04" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
