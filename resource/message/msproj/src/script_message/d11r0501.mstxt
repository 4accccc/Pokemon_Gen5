<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d11r0501_assistantw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げすいどうに　たまった　どくを
くすりに　かえる　じっけん……▼
これが　１００％　せいこうすれば
どくタイプの　ポケモンから▽
どんどん　くすりが　つくれるの！▼
ではでは
ほんじつの　じっけんけっかは……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T02:37:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>下水道に　たまった　どくを
薬に　変える　実験……▼
これが　１００％　せいこうすれば
どくタイプの　ポケモンから▽
どんどん　薬を　つくれるの！▼
ではでは
本日の　実験結果は……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T12:24:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・部屋の中央に配置
・続けてのメッセージ
　80％→assistantm_02
　15％→assistantm_03
　　5％→assistantm_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:46:32" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:46:04" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d11r0501_assistantw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいの　じっけんけっかは
ふつう　ね……▼
ねえ　きみ！
この　どくけしを　あげるよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T02:40:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:46:04" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今回の　実験結果は
普通ね……▼
ねえ　きみ！
この　どくけしを　あげるよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T02:37:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:46:04" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手処理
　No017「キズぐすり」</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:47:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM</Text>
