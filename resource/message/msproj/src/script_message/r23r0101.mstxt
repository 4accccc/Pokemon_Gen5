	<TextRow
		Label="msg_r23r0101_trainerw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うん！　あなたと　ポケモンの
コンビなら　どこまでも　いけるわ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:02:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うん！　あなたと　ポケモンの
コンビなら　どこまでも　行けるわ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:03:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・HP/PP満タン時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T03:54:42" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T05:02:03" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
