				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03_swchampion_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アイリス『こっちこっち！
じゃあ　いってみよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T08:17:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T08:11:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アイリス『こっちこっち！
じゃあ　行ってみよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T08:17:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T08:11:54" />
		</LanguageCell>
		<CommentCell
