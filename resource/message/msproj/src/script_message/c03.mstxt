			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03_businessman4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げんきが　いちばん　だけど
むりやり　げんきを　だすぐらいなら▽
やすんだって　いいんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:34:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>元気が　一番だけど
むりやり　元気を　だすぐらいなら▽
休むんだって　いいんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:34:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
