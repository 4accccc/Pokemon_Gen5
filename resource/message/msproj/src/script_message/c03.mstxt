				Time="2011-09-20T07:33:31" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN
ビジネスマン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
