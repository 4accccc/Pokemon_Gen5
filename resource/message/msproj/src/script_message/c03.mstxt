	</TextRow>
	<TextRow
		Label="msg_c03_businessman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんなに　ひとが　おおいと
みんな　おなじ　かおに　みえちゃう</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:33:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんなに　人が　多いと
みんな　同じ　顔に　みえちゃう</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:33:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
