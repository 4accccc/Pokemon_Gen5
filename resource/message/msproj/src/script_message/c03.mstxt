	<TextRow
		Label="msg_c03_ol1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒウンシティって　とても
たくさんの　ひとが　いるでしょ▼
じぶんにしか　きょうみのない
ひとも　たまに　いるのよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒウンシティって　とても
たくさんの　人が　いるでしょ▼
自分にしか　興味のない
人も　たまに　いるのよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
