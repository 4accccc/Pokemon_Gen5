<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c03_inventor_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヤッホー！
アタシは　マコモ▼
アナタ　イッシュちほうの
すべての　ポケモンと　であうんでしょ？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヤッホー！
アタシは　マコモ▼
アナタ　イッシュ地方の
すべての　ポケモンと　であうんでしょ？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・c03p15からマップ切り替えでイベント発動
・主人公に隣接してメッセージ表示
・続けて</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTW
発明家</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c03_inventor_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ　いきなり　ゴメンね
アタシ　アララギはかせの　ともだちよ▼
でね　かのじょから
アナタの　てだすけを　たのまれていて▽
Ｃギアを　つかえるように　するね！▼
Ｃギアとは　せきがいせんや
むせん　Ｗｉ－Ｆｉなど▽
つうしんに　かんけいする　デバイスよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ　いきなり　ゴメンね
アタシ　アララギ博士の　友達よ▼
でね　彼女から
アナタの　てだすけを　頼まれていて▽
Ｃ－ＧＥＡＲを　使えるように　するね！▼
Ｃ－ＧＥＡＲとは　赤外線や
無線　Ｗｉ－Ｆｉなど▽
通信に　関係する　デバイスよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・！マーク表示してから
・続けてcgear_01</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTW
発明家</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
