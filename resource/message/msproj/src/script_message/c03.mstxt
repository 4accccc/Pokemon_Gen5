	<TextRow
		Label="msg_c03_ol1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとに　かこまれて　いきるには
みんなを　すきに　なるか▽
じぶんだけ　すきでいるか　なのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T11:12:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人に　囲まれて　生きるには
みんなを　好きに　なるか▽
自分だけ　好きでいるか　なのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T11:13:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T11:13:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OL
</Text>
			<TextModifiedBy
