	<TextRow
		Label="msg_c03_cgear_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｃギアの　でんげんを　いれて
つうしんを　はじめますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｃ－ＧＥＡＲの　電源を入れて
通信を　始めますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>システムメッセージ
・はい/いいえの選択肢表示
・はい　→Ｃギアをアクティブで起動
　いいえ→Ｃギアをパッシブで起動</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
