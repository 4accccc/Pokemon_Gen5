			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03_businessman5_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　わざを　かえるか
もたせる　どうぐを　かえるか……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:35:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンの　技を　変えるか
持たせる　道具を　変えるか……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:36:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
