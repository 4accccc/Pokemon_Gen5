<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c03_swchampion_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アイリス『こっちが　サムピア！▼
ヒウンで　あやしいと　いえば
スリムストリート　か▽
ここかなと　おもうんだ▼
じゅんびが　できたら
この　さきに　きてみて！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T04:38:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アイリス『こっちが　サムピア！▼
ヒウンで　怪しいと　いえば
スリムストリート　か▽
ここかなと　思うんだ▼
準備が　できたら
この先に　来てみて！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T04:37:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・c03p07イベント後に出現
・posイベント
・メッセージ表示後、c03p09へ移動
　画面外に消えると主人公操作可能に</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWCHAMPION
アイリス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:56:44" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03_businessman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベッドで　ねむりに　つくとき▼
ぼくの　ポケモンの　こうげきが
きゅうしょに　あたったとき▼
ぼくの　じんせいは　いろんな
よろこびに　あふれておるのです！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:25:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベッドで　眠りに　つくとき▼
ぼくの　ポケモンの　攻撃が
きゅうしょに　あたったとき▼
ぼくの　人生は　いろんな
喜びに　あふれておるのです！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:25:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:25:53" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN
ビジネスマン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03_businessman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　たたかう　ビジネスマン！
あきらめなければ　いつか　かつ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:27:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>私は　闘う　ビジネスマン！
あきらめなければ　いつか　勝つ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T07:27:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
