	<TextRow
		Label="msg_c04r0201_owner_demo_swan_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やあ　はじめまして！▼
わたしは　この　ミュージカルの
オーナーです　よろしく！▼</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
