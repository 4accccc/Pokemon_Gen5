	<TextRow
		Label="msg_c04r0201_owner_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>では　ぶたいで　あえる　ひを
たのしみに　しておりますよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>では　舞台で　会える　日を
楽しみに　しておりますよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
