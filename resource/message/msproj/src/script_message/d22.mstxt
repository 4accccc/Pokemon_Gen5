	<TextRow
		Label="msg_d22_boy2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくも　アデクさんに
ポケモンを　おそわろうかな▼
アデクさんって　すごーく
つよい　トレーナー　なんだぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-14T03:00:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくも　アデクさんに
ポケモンを　教わろうかな▼
アデクさんって　すごーく
強い　トレーナー　なんだぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-14T03:01:11" />
