			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c14r0601_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いどうする　ためでは　なく
みる　ための　つうろ　じゃな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T04:14:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-01T06:28:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>移動する　ためでは　なく
みる　ための　通路じゃな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T04:14:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-01T06:28:41" />
