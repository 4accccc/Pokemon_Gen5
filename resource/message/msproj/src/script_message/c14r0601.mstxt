	<TextRow
		Label="msg_c14r0601_ambrella_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>からげんき！　からげんき！
どく　まひ　やけどの　ときは▽
こうげきりょくが　２ばい　なの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T02:54:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T02:54:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>からげんき！　からげんき！
どく　まひ　やけどの　ときは▽
なんと！　攻撃力が　２倍なの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
