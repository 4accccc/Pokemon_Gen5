	<TextRow
		Label="msg_r06_mountain_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんきいしのほらあな　は
ふくざつな　めいろの　ようだが▽
じつは　いっぽんみち　なんだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
