	<TextRow
		Label="msg_r06_sign3_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねんじゅう　きせつの　けんきゅう
そのなも　きせつ　けんきゅうじょ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
