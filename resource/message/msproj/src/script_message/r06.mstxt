	<TextRow
		Label="msg_r06_mountain_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんきいしのほらあな　は
ふくざつな　めいろの　ようだが▽
じつは　いっぽんみち　なんだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
