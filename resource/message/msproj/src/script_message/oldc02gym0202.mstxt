			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_oldc02gym0202_old_leader3_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アーティ『あう
ちょっと　わかるかも▼
むしポケモンも
あしの　かたちとか▽
きのうてきな　デザインだし▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-04T08:17:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-04T08:16:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アーティ『あう
ちょっと　わかるかも▼
むしポケモンも
脚の　形状とか　機能的な▽
ムダのない　デザインだし▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-04T08:53:10" />
