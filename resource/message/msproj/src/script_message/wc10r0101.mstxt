	<TextRow
		Label="msg_wc10r0101_oldman1_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　あした
ここに　きておくれ[Ctrl2:PageClear ]
もりも　ウエルカムを
いってくれる　だろうから</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
