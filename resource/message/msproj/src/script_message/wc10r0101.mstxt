				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_wc10r0101_oldman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　この　もりと　ともにいきる
ポケモンを　しらべておるんだが[Ctrl2:PageClear ]
[Name:PokemonName Idx="0"]が　このもりに
すんでいる　はずなんだ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　この森と　共に生きる
ポケモンを　調べておるんだが[Ctrl2:PageClear ]
[Name:PokemonName Idx="0"]が　この森に
住んでいる　はずなんだ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
