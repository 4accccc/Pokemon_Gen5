	<TextRow
		Label="msg_wc10r0101_boy2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でかいビルが　たちすぎると
そらが　ちいさくなって▽
たいようが　みえなくなっちゃう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:09:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>でかいビルが　建ちすぎると
空が　小さくなって▽
太陽が　みえなくなっちゃう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:10:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
