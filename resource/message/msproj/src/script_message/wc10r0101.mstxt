		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_wc10r0101_boy3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっしょに　きのみを
とって　こようぜ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いっしょに　きのみを
取って　こようぜ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
