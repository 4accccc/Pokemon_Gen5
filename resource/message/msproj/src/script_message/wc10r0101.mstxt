	</TextRow>
	<TextRow
		Label="msg_wc10r0101_boy3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　きもちを　しりたくて
しぜんの　なかで　くらしてるんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:06:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンの　気持ちを　知りたくて
自然の　中で　暮らしてるんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:06:29" />
			<Status>Editing</Status>
