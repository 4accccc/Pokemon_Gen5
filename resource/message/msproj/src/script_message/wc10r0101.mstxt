	<TextRow
		Label="msg_wc10r0101_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きのみごはんの　おいしさを　しれば
あれも　これも　たべたいとか▽
なやまなくて　すむのにねー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T07:18:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きのみご飯の　美味しさを　知れば
あれも　これも　食べたいとか▽
悩まなくても　すむのにねー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:08:58" />
			<Status>Editing</Status>
