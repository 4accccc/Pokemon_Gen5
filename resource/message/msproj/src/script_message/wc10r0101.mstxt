	<TextRow
		Label="msg_wc10r0101_boy2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうも　そらが　きれいだなー
あしたも　きっと　はれるよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今日も　空が　きれいだなー
明日も　きっと　晴れるよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
