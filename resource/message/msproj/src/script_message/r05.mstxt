				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r05_badrider_07w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレは……　こいする　おとこ
そのなも　チャールズ▼
そんなオレから　アドバイス……▼
チャレンジこそが　じんせい　なんだぜ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
