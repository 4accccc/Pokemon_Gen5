				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r05_badrider_02w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……まいったぜ！　あいての
きをひくのは　ほんと　むずかしいな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……まいったぜ！　相手の
気をひくのは　ほんと　難しいな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：WHITEver
・いいえ選択時
　再度会話はbadrider_01から</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
