				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r05_swleader1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『……きいたよ▼
Nという　ポケモントレーナーと
であったんだってね▼
だから　というわけでは　ないけど
ぼくと　たたかってくれないか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-16T06:42:23" />
			<Status>Editing</Status>
