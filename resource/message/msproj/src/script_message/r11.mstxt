	<TextRow
		Label="msg_r11_poke6_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ききゅああああーっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ききゅああああーっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・あわせて鳴き声再生
・その後、戦闘へ
</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE6
ポケモン・ビリジオン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:28:37" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r11_poke6_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンは　どうろの　さきへ
はしりさって　しまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンは　道路の　先へ
走り去ってしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・戦闘後
・倒した場合のメッセージ
・復帰処理の仕様は保留</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE6
ポケモン・ビリジオン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T03:28:36" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
