<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r04r0501_waitress_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ね！　ポケモンなきごえモノマネ
ぜひ　きいていってください！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:46:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ね！　ポケモン鳴き声モノマネ
ぜひ　きいていってください！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:29:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・はい/いいえの選択肢表示
　はい　→waitress_02
　いいえ→waitress_03
・手持ちポケモンが1種類のときは
　続けてwaitress_08</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:18:02" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITRESS</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:27:13" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:41:59" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0501_waitress_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>では　あなたが　つれている
ポケモンの　なきごえを……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:46:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:31:47" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>では　あなたが　連れている
ポケモンの　鳴き声を……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:29:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:47:42" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・はい選択時
・続けて鳴き声再生
　手持ちの中から
　タマゴを除いてランダム抽出
・再生後waitress_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:18:06" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITRESS</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:35:51" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:42:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0501_waitress_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんもの　ソックリですよ？
きいて　くれないんですか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:34:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:31:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本物　ソックリですよ？
きいて　くれないんですか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:33:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:33:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・いいえ選択時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:18:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITRESS</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:35:51" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:42:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0501_waitress_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さっきの　なきごえモノマネは
あなたが　つれている▽
どの　ポケモン　だったでしょう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:47:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:31:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さっきの　鳴き声モノマネは
あなたが　連れている▽
どの　ポケモン　だったでしょう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:30:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:47:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・選択肢表示</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:18:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITRESS</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:35:51" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:42:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0501_waitress_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せいかい　でーす！▼
いつも　きいている　ポケモンの
なきごえを　わかりますよね！▼
あそんでくれて　ありがとうなの！
これ　くだらないけど　どうぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:51:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:32:04" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正解でーす！▼
いつも　きいている　ポケモンの
鳴き声なら　わかりますよね！▼
遊んでくれて　ありがとうなの！
これ　くだらないけど　どうぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:51:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:51:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・正解１回目
・正解SE再生後にメッセージ表示
・アイテム入手処理
　No577「ポケじゃらし」</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:18:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITRESS</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:35:51" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:42:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0501_waitress_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せいかい　でーす！▼
ですよね！　パートナ－の　なきごえを
まちがったりなんて　ないですよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:50:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:49:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正解でーす！▼
ですよね！　パートナ－の　鳴き声を
間違ったりなんて　ないですよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:50:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:49:56" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・正解２回目以降
・正解SE再生後にメッセージ表示</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:18:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WAITRESS</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:36:13" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:42:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0501_waitress_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おしい！　くやしい！　かなしいです！
いまのは　[Name:PokemonName ]　でした！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:47:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:32:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>惜しい！　悔しい！　悲しいです！
いまのは　[Name:PokemonName ]　でした！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:18:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:38:38" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・不正解
・不正解SE再生後にメッセージ表示
・タマゴも含む</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T06:18:24" />
		</CommentCell>
		<AttributeCell
