			<Text>WAITRESS</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T11:35:51" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T08:42:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r04r0501_waitress_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>って　ポケモンが　すくなすぎ……！
それじゃあ　クイズが　できませんね</Text>
