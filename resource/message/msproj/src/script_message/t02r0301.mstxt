<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t02r0301_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーが　ポケモンを　そだて
ポケモンが　トレーナーを　きたえる▼
これまでも　これからも……
そうかんがえると　なんか　いいなあ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T08:00:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーが　ポケモンを　育て
ポケモンが　トレーナーを　鍛える▼
これまでも　これからも……
そう考えると　なんか　いいなあ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T08:00:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T07:57:49" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN1
青年１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0301_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うれしいときも　かなしいときも
ポケモンが　そばに　いてくれる……▽
それだけで　じゅうぶん　でしょ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T08:23:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うれしいときも　悲しいときも
ポケモンが　そばに　いてくれる……▽
それだけで　充分でしょ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T08:23:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ変更予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:39:38" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN2
太ったおばさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0301_boy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュの　ひとたちは
くにを　つくった　えいゆうと▽
ポケモンに　あこがれを　いだいている▼
それを　りようしようと　したのが
かの　プラズマだん　さ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T07:37:48" />
			<Status>Editing</Status>
