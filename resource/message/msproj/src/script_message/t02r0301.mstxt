<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t02r0301_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いまは　よわい　ポケモンでも
そだてれば　つよくなる！▽
だいじなのは　あいじょう　だね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いまは　弱い　ポケモンでも
育てれば　強くなる！▽
大事なのは　愛情だね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ変更予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:39:41" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN1
青年１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0301_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たくましくなれば　さきにすすめる
さきにすすめば　また　たくましくなる▼
いいわね！
ぼうけんの　たびって！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たくましくなれば　先に進める
先に進めば　また　たくましくなる▼
いいわね！
冒険の　旅って！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ変更予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:39:38" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN2
太ったおばさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
