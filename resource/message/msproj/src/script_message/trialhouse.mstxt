				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_trialhouse_022"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まってましたよ！▼
ダウンロードした　シングルバトルの
けんていに　チャレンジ　しちゃう？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>待ってましたよ！▼
ダウンロードした　シングルバトルの
検定に　チャレンジしちゃう？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
