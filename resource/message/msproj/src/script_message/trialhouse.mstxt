	<TextRow
		Label="msg_trialhouse_031"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げんざい　はいしんされている
バトルけんていは　すでに▽
チャレンジ　されているようです▼
いかが　いたしましょう？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
