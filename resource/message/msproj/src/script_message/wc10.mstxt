				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_12_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くさポケモンの　こきゅうや
とりポケモンの　さえずり……▼
……ラルトス　いま　あなたの
うしろを　はしっていった……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>くさポケモンの　呼吸や
とりポケモンの　さえずり……▼
……ラルトス　今　あなたの
後ろを　走っていった……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
