				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_05_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しかし　あー！　ヒマ！　ヒマすぎる！
ブラックシティに　もどりたいよー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しかし　あー！　ヒマ！　ヒマすぎる！
ブラックシティに　もどりたいよー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
