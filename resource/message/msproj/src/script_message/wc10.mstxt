				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_02_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……ここで　すごす　じかんは
すごく　だいすき　なんだけど▼
なにかが　たりない……
そんな　きがするの</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……ここで　過ごす　時間は
すごく　大好き　なんだけど▼
なにかが　足りない……
そんな　気がするの</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
