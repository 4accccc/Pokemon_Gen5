				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_05_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ！　あのさー！
エレキッド！　エレキッドが▼
そこを　にげていったよ！
おいかけちゃおうかなー</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あ！　あのさー！
エレキッド！　エレキッドが▼
そこを　逃げていったよ！
追いかけちゃおうかなー</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
