				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_sign_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここは　ホワイトフォレスト
いいかえれば　しろい　もり</Text>
			<TextModifiedBy
