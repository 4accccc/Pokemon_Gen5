				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_12_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……ひとは　ひとが　つくった
ものに　ひかれて　しまうものね▽
ブラックシティが　なつかしい……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……人は　人が　つくった
ものに　ひかれて　しまうものね▽
ブラックシティが　懐かしい……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
