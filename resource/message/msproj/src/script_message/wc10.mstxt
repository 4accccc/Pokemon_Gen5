	<TextRow
		Label="msg_wc10_shop_a_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　どうぞ！
おきゃくさん　いい　かいものしたね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:10:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
