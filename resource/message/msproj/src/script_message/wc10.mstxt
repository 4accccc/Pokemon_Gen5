				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_08_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カレン『ブラックシティから
ぜんりょく　ダッシュで　きちゃった！▼
[Name:TrainerName Idx="0" ]の　たたかいかたに
かんしん　しちゃって▽
わたしも　まだまだって　おもったわ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カレン『ブラックシティから
全力ダッシュで　来ちゃった！▼
[Name:TrainerName Idx="0" ]の　戦い方に
感心しちゃって▽
わたしも　まだまだって　思ったわ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERW
カレン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_08_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カレン『ファイト！　オー！▼
ポケモンと　いっしょに
はしりこんでるの！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カレン『ファイト！　オー！▼
ポケモンと　一緒に
走りこんでるの！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERW
カレン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_08_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふー……　そろそろ
はしりこみにも　あきちゃった！▼
つぎは　じっせんよね
ブラックシティに　いきたいわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふー……　そろそろ
走り込みにも　飽きちゃった！▼
次は　実戦よね
ブラックシティに　行きたいわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERW
カレン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_08_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　
あなたも　いっしょに　はしる？▼
さっき　やせいの　ナマケロが　いてね
はしってたら　あえるかも？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　
あなたも　一緒に　走る？▼
さっき　野生の　ナマケロが　いてね
走ってたら　会えるかも？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERW
カレン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_09_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トモタカ『どうも　どうも！　トモタカです
ブラックシティから　まいりました▽
[Name:TrainerName Idx="0" ]さんの　しりあい　です▼
あのかたは　じつに　じょうねつてきな
ポケモンしょうぶを　されますね！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トモタカ『どうも　どうも！　トモタカです
ブラックシティから　まいりました▽
[Name:TrainerName Idx="0" ]さんの　知り合いです▼
あの方は　実に　情熱的な
ポケモン勝負を　されますね！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN
トモタカ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_09_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トモタカ『しぜんに　かこまれて
わたしが　やることは　しごと　です！▽
けっこう　はかどる　ものですね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トモタカ『自然に　囲まれて
わたしが　やることは　仕事です！▽
けっこう　はかどる　ものですね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN
トモタカ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_09_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いやー　おいしい　くうきを　すえて
じゅうぶん　リフレッシュ　しました！▼
べつの　しごとも　あるので
ブラックシティに　いきたいです</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いやー　おいしい　空気を　吸えて
じゅうぶん　リフレッシュ　しました！▼
別の　仕事も　あるので
ブラックシティに　いきたいです</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN
トモタカ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_09_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さっき　ここで
コリンクを　みましたよ！▼
いやー　ここは　いるだけで
きぶんは　リフレッシュ！　ですよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さっき　ここで
コリンクを　みましたよ！▼
いやー　ここは　いるだけで
気分は　リフレッシュ！　ですよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN
トモタカ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_10_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュンイチ『やあ　ごきげんよう▼
ブラックシティでは　[Name:TrainerName Idx="0" ]の
れんしゅう　あいてを　してあげたけど▼
まあまあ　つよかったかな
ぼく　ほどでは　ないけどね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュンイチ『やあ　ごきげんよう▼
ブラックシティでは　[Name:TrainerName Idx="0" ]の
練習相手を　してあげたけど▼
まあまあ　強かったかな
ぼく　ほどでは　ないけどね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERM
ジュンイチ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_10_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジュンイチ『しぜんの　そうだいさは
ぼくを　ひきたてる　スパイスだね▽
うん　きにいったよ　ここ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジュンイチ『自然の　壮大さは
ぼくを　ひきたてる　スパイスだね▽
うん　気にいったよ　ここ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>TRAINERM
ジュンイチ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_10_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しかしさ　ぼくは
シティうまれ　シティそだち　だからさ▽
そろそろ　かえりたいんだよね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しかしさ　ぼくは
シティ生まれ　シティ育ち　だからさ▽
そろそろ　帰りたいんだよね？</Text>
