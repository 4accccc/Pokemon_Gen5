				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_26_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さまざまな　ポケモン
さまざまな　こたえ▽
その　いずれも　ただしいんだよ▼
さっき　そこで　ニドラン♀を
みたとき　そうおもったね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>様々な　ポケモン
様々な　答え▽
その　いずれも　正しいんだよ▼
さっき　そこで　ニドラン♀を
みたとき　そう思ったね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
