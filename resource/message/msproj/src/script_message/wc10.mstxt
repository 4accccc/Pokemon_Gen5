	<TextRow
		Label="wc10_16_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……でも　ちょっと
イナカには　あきちゃったわ▼
もっと　いろいろな　モノがある
とかいで　すごしたいわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……でも　ちょっと
イナカには　飽きちゃったわ▼
もっと　いろいろな　モノがある
都会で　すごしたいわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
