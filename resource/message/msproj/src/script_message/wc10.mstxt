				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_wc10_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おいしい　くうき！
きもちいい　かぜ！[Ctrl2:LineFeed ]
うーん　じゅうじつ　してるなぁ～</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おいしい　空気！
気持ちいい　風！[Ctrl2:LineFeed ]
うーん　充実してるなぁ～</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
