				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="wc10_21_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さっき　そこで
サイホーンを　みかけたけど▽
しぜんたいで　いいよね　アイツは</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さっき　そこで
サイホーンを　みかけたけど▽
自然体で　いいよね　アイツは</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
