<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c02r0201_musician_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいにち　ギターを　ひくのも
ポケモンしょうぶを　するのも▽
だいすきだから　つづけるのさ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>毎日　ギターを　弾くのも
ポケモン勝負を　するのも▽
大好きだから　続けるのさ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂

※SWANでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUSICAN
ミュージシャン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c02r0201_babyboy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おなじ　ポケモンでも
いろんな　せいかくが　あるんだね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おなじ　ポケモンでも
いろんな　せいかくが　あるんだね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂

※SWANでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BABYBOY1
男の子</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c02r0201_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　しじん……
ポエムを　よんでいる▼
まいにち　そうぞうを　ふくらませて
そうさくかつどうに　はげんでいる▼
にんげんは　ねむると　ゆめをみるが
ポケモンが　もしも　ゆめを　みたら…▼
どんなふう　なんだろうと　かんがえる
そうぞうも　つかないね……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　詩人……
ポエムを　詠んでいる▼
毎日　想像を　ふくらませて
創作活動に　はげんでいる▼
人間は　眠ると　夢をみるが
ポケモンが　もしも　夢を　みたら…▼
どんな風なんだろうと　考える
想像も　つかないね……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・PDWのアカウントなし</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
