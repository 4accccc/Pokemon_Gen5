	<TextRow
		Label="msg_n01r0502_boss_15"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｎ『[Ctrl2:CtrlSpeed mode="1" ]わかったような　ことを▼
いままで　おたがい
しんじるもののため　あらそっていた▼
だのに！　なぜ！[Ctrl2:CtrlSpeed mode="0" ]▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
