	<TextRow
		Label="msg_c02gym0202_leader_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アロエ『おっ　アンタかい！▼
あいかわらず　ポケモンに
あいじょう　こめて　そだててるねえ▼
ところでさ　ヤーコンの　ダンナから
れんらくが　あったんだけどさ▼
ネジやまで　ポケモンの
カセキが　みつかるんだって！▽
アンタ　よければ　いってごらんよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アロエ『おっ　アンタかい！▼
あいかわらず　ポケモンに
愛情こめて　育ててるねえ▼
ところでさ　ヤーコンの　ダンナから
連絡が　あったんだけどさ▼
ネジ山で　ポケモンの
カセキが　みつかるんだって！▽
アンタ　よければ　行ってごらんよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・クリア後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>LEADER2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02gym0202_bookrack1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アロエの　けんきゅうしりょうが
きそくただしく　つめこまれている！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アロエの　研究資料が
規則正しく　詰め込まれている！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ</Comment>
