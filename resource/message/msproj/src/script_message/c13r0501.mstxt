	<TextRow
		Label="msg_c13r0501_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ！　ゲートを　ぬければ
そこは　ポケウッド　です！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:12:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ！　ゲートを　抜ければ
そこは　ポケウッド　です！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:12:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:12:56" />
		</CommentCell>
