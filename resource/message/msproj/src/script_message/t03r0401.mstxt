				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t03r0401_businessman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あしたも　ふつうに　しごと！
オレって　スーパービジネスマンだな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-31T10:13:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>明日も　普通に　仕事！
オレって　スーパービジネスマンだな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-31T10:13:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
