	<TextRow
		Label="msg_t03_poke_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>グッグン！　グッグン！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
