	<TextRow
		Label="msg_c13r0401_pilot_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わかりました！　のりたくなったときは
えんりょ　なさらずに　どうぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わかりました！　乗りたくなったときは
遠慮なさらずに　どうぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・いいえ選択
・再度会話時はmsg_c03p15_01_02</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>PILOT
船長</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
