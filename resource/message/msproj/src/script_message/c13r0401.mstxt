	</TextRow>
	<TextRow
		Label="msg_c13r0401_veteranw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんの　じんせい　だもの▼
ひとつのことを　つきつめるのも
いろんなことを　やるのも　じゆうだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T02:54:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分の　人生だもの▼
ひとつのことを　突き詰めるのも
いろんなことを　やるのも　自由だよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T02:54:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・船長登場後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>VETERANW</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
