	<TextRow
		Label="msg_d25r0201_book1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とおく　シンオウちほう　に
クレセリアと　いう　ポケモンあり▼
みかづきの　ように　かがやく
はねは　わるい　ゆめを　けすなり</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T07:00:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>遠く　シンオウ地方に
クレセリアと　いう　ポケモンあり▼
みかづきの　ように　輝く
はねは　悪い　夢を　消すなり</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T11:26:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ
・GRIDX＝7～10、GRIDZ＝9</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T12:12:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>本棚</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-17T06:39:21" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
