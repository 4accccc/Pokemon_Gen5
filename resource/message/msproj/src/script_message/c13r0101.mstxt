	<TextRow
		Label="msg_c13r0101_woman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしの　タブンネちゃんも
ポケウッドで　スクリーンデビュー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-02T02:45:18" />
			<Status>Editing</Status>
