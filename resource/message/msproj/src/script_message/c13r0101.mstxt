	<TextRow
		Label="msg_c13r0101_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あーあ！　ポケウッドだけど
さいかい　してくれないかしら？▼
あたしの　タブンネちゃんを
スクリーンに　とうじょう　させたいの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-02T02:45:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あーあ　ポケウッドだけど
再開してくれないかしら？▼
あたしの　タブンネちゃんを
スクリーンに　登場させたいの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-02T02:45:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ポケウッド解放前</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
