			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p17_stop_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい？
げすいどうに　はいるんですか？▼
はあ……　それなら　やせいポケモンに
ちゅうい　してくださいよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T10:24:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はい？
下水道に　入るんですか？▼
はあ……　それなら　野生ポケモンに
注意して　くださいよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T10:24:22" />
