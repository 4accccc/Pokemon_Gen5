	<TextRow
		Label="msg_c03p17_swchampion_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アイリス『あちら　からね
げすいどうに　はいれるんだよ！▽
あやしい　かんじが　するでしょ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T12:28:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アイリス『あちら　からね
下水道に　入れるんだよ！▽
怪しい　感じが　するでしょ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T12:28:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・c03p07→c03でのイベント後
・続けてswrival_01</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T09:47:49" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWCHAMPION
アイリス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T03:07:41" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p17_swrival_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『[Name:TrainerName Idx="0" ]！
プラズマだん　いたかよ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T12:28:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『[Name:TrainerName Idx="0" ]！
プラズマ団は　いたかよ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T12:28:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・条件未定
・はい/いいえ選択肢表示
　はい　→swrival_02
　いいえ→swrival_03
・0＝主人公名
・1＝ライバル名</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T12:28:48" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T03:07:55" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p17_swrival_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そんな　ウソじゃ
よろこばないんだぜ？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そんな　ウソじゃ
喜ばないんだぜ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T12:23:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・はい選択時
・続けてswrival_04</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T03:07:57" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p17_swrival_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうか……
ポケモンどろぼう　め！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そうか……
ポケモンどろぼう　め！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・いいえ選択時
・続けてswrival_04</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
