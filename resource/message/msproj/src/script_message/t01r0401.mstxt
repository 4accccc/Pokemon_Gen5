<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t01r0401_hakase2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アララギ『おや！
わざわざ　ありがとうね！▼
ヒオウギシティから
カノコタウンって　いがいと▽
きょりが　あるでしょ？▼
で　スカイアローブリッジを　わたって
いろんな　ポケモンに　あえたの？▼
という　わけで……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T05:42:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アララギ『おや！
わざわざ　ありがとうね！▼
ヒオウギシティから
カノコタウンって　意外と▽
距離が　あるでしょ？▼
で　スカイアローブリッジを　渡って
いろんな　ポケモンに　会えたの？▼
という　わけで……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T05:42:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・初回イベント
・続けて図鑑評価
　hyouka_scr.mstxtの
　msg_hyouka_hakase2_01</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:54:49" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士・娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T08:27:44" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t01r0401_hakase2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アララギ『ハーイ！　
さいきんの　ちょうしは　どう？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T08:49:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アララギ『ハーイ！　
最近の　調子は　どう？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:52:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・２回目以降
・続けて図鑑評価
　hyouka_scr.mstxtの
　msg_hyouka_hakase2_01</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:55:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士・娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T08:27:44" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t01r0401_hakase2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょかしょうが　あれば
フキヨセシティから　ひこうきで▽
しぜんほごくに　いけるわよ！▼
どんな　ばしょかは
ついてからの　おたのしみね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:53:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きょかしょうが　あれば
フキヨセシティから　飛行機で▽
自然保護区に　行けるわよ！▼
どんな　場所かは
着いてからの　お楽しみね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:52:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・図鑑評価後
　No630「きょかしょう」を持っているとき
・１回のみ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:47:58" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士・娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T08:27:44" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t01r0401_hakase2_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まるいおまもりを　もっていると
どうしてだか　そだてやさんで▽
ポケモンの　タマゴが　いつもより▽
はっけん　されやすくなるのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:50:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まるいおまもりを　持っていると
どうしてだか　育て屋さんで▽
ポケモンの　タマゴが　いつもより▽
発見されやすくなるのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:53:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・図鑑評価後
　No631「まるいおまもり」を持っているとき
・１回のみ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:49:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士・娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T08:27:44" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t01r0401_hakase2_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひかるおまもりを　もっていると
どうしてだか　くさむらなどから▽
ひかる　ポケモンが　いつもより▽
おおく　とびだしてくるのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:51:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ひかるおまもりを　持っていると
どうしてだか　蔵むらなどから▽
ひかる　ポケモンが　いつもより▽
多く　飛びだしてくるのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:53:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・図鑑評価後
　No632「ひかるおまもり」を持っているとき
・１回のみ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T10:49:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士・娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T08:27:44" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t01r0401_hakase2_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュずかんに　とうろくされる
すべての　ポケモンと　であえたら▽
プレゼントしたい　ものが　あるの▼
イッシュちほうの　すみずみまで
ポケモンを　さがしてね！　ヨロシク！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T08:28:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッシュ図鑑に　登録される
すべての　ポケモンと　であえたら▽
プレゼントしたい　ものが　あるの▼
イッシュ地方の　すみずみまで
ポケモンを　探してね！　ヨロシク！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T08:27:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・図鑑評価後
　No630「きょかしょう」を持っていないとき
・１回のみ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-19T08:17:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士・娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T08:27:44" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
