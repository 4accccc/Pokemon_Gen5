		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぎりぎりぎりぃ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
