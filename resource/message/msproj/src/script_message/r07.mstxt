	<TextRow
		Label="msg_r07_tvt_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ライブキャスターが　なっている！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T09:16:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ライブキャスターが　鳴っている！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T09:16:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・GIRDX＝136、GRIDZ＝243～245で発生
・ママからの連絡
・コール音再生と同時に表示
・コール音終了後にmsg_r04_tvt_02を表示</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T03:04:57" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>システム
ライブキャスター</Text>
