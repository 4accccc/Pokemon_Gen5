				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r07_oldwoman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんな　あめかぜの　なかで
たちばなしも　なんじゃろなー[Ctrl2:PageClear ]
なーんも　ない　いえじゃが
ちと　よっていきなさいなー[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんな　雨風の　中で
立ち話も　なんじゃろなー[Ctrl2:PageClear ]
なーんも　ない　家じゃが
ちと　寄っていきなさいなー[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・フキダシを出し直して、このセリフを喋る。
・セリフ後、主人公を連れて家に入る。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おばあさん</Text>
			<TextModifiedBy
