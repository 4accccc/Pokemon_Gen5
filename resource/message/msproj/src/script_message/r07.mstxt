	<TextRow
		Label="msg_r07_fighterw1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっぽんばしの　うえで
たちどまると　おちちゃうわよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T05:37:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一本橋の　上で
たちどまると　落ちちゃうわよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T05:38:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T05:37:53" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTREW
格闘家♀</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
