<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c07pc0101_oldwoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たびの　りゆうは　ひとそれぞれ
プレゼントする　りゆうも　おなじ[Ctrl2:PageClear ]
あたしゃあ　あんたとの　であいを
きねんして　これを　あげようかね[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>旅の理由は　人それぞれ
プレゼントする理由も　同じ[Ctrl2:PageClear ]
あたしゃあ　あんたとの　出会いを
記念して　これを　あげようかね[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手処理
　No358「かわらわり」
※swanでイベント修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T07:03:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDWOMAN1
おばあさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
