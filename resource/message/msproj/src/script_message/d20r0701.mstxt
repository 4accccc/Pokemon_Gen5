	<TextRow
		Label="msg_d20r0701_sys_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここから　のぼれそうだ！▼
うえの　かいに　すすみますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここから　昇れそうだ！▼
上の階に　進みますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
