	<TextRow
		Label="msg_bc10r0401_gentleman_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つぎは　[Digit:5digits Idx="4"]にんまで
たおしてみな[Ctrl2:PageClear ]
そして　おまえの　よくぶかい
はらのそこ　みせてくれよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
