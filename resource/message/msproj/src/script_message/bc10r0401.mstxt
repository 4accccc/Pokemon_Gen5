				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN3</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_oldman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぶんめいの　ちからとは
すごいものだな……▼
ひとが　ほしいもの　すべて
つくって　しまうのだからな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-24T10:05:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>文明の　力とは
すごいものだな……▼
人が欲しいもの　すべて
つくって　しまうのだからな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-24T10:06:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
