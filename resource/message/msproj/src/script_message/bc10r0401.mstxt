	</TextRow>
	<TextRow
		Label="msg_bc10r0401_middleman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うーん　もっと　かねになる
いい　しごとは　ないか！？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うーん　もっと　金になる
良い仕事は　ないか！？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
