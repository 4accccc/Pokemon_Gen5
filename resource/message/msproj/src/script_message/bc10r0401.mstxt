	</TextRow>
	<TextRow
		Label="msg_bc10r0401_gentleman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いま　おまえが　たおしたにんずうは
[Digit:5digits Idx="1"]にん[Ctrl2:PageClear ]
ハンッ
まあ　がんばりな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
