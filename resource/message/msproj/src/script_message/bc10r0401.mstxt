				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほしいものが　すべてある
おかねさえ　あれば！　あれば！！▽
そうよ！　ほんきで　かせぐわよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:01:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>欲しいものが　全てある
お金さえ　あれば！　あれば！！▽
そうよ！　本気で　稼ぐわよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:01:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
