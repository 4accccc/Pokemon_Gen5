<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_bc10r0401_gentleman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ……
ブラックシティへ！▼
ここは　ゆめと　よくぼう　そして
……よくぼうの　まちさ▼
そして　おれは
そんな　よくぼう　うずまく▽
ブラックシティの　ボスなのさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:34:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ……
ブラックシティへ！▼
ここは　夢と　欲望　そして
……欲望の　街さ▼
そして　おれは
そんな　欲望　うずまく▽
ブラックシティの　ボスなのさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:34:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・初期状態
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:26:45" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GENTLEMAN(BCのボス）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_gentleman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえの
よくぼうも　たいしたもんだ▼
しってるんぜ▼
ちょうしよく
くろのまてんろうを　のぼってるんだろ▼
いいんだぜ……▼
おれは　よくぼう　あふれる　ヤツは
しょうじきだから　すき　なんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:41:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえの
欲望も　たいしたもんだ▼
知ってるんだぜ▼
調子よく
黒の摩天楼を　昇ってるんだろ▼
いいんだぜ……▼
おれは　欲望　あふれる　ヤツは
正直だから　好き　なんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:41:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・エリア５クリアから
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:26:45" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GENTLEMAN(BCのボス）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_gentleman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうの　バンジロウに
おまえ……▼
ブラックシティで　おまえらのように
すごい　やつが　いると▽
オレの　そんざいが　かすんでしまう▼
いいや！▼
おれの　よくぼうは
とどまることを　しらねえ……▼
そうよ！　おれさまこそが
ブラックシティの　ボスだぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:07:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:26:35" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼の　バンジロウに
おまえ……▼
ブラックシティで　おまえらのように
すごい　やつが　いると▽
オレの　存在が　かすんでしまう▼
いいや！▼
おれの　欲望は
とどまることを　知らねえ……▼
そうよ！　おれさまこそが
ブラックシティの　ボスだぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:07:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:26:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・エリア10クリアから
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:15:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GENTLEMAN(BCのボス）</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:26:41" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_boy4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねだんが　たかいから
かちが　ある……▼
そんな　おもいこみだと　そんをする！
だまされないため　かしこくなる！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:45:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>値段が　高いから
価値が　ある……▼
そんな　思い込みだと　損をする！
だまされないため　賢くなる！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:46:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:26:54" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY4</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もっと　かせぐために
もっともっと　えらくなるぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:44:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もっと　稼ぐために
もっともっと　偉くなるぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:44:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:26:57" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おかねで　なんでも
てにはいるとは　かぎらない▼
だが　たいていの　ものは
おかねで　てにはいるんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:47:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お金で　なんでも
手に入るとは　限らない▼
だが　大抵の　ものは
お金で　手に入るんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:48:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:26:58" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN3</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_middlewoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みんなと　おなじなら
まんぞく！　って　ダメよ▼
そんなの　わるい　おとなに　だまされ
なんにも　かんがえてないだけ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:56:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みんなと　同じなら
満足！　って　ダメよ▼
そんなの　悪い　大人に　だまされ
なんにも　考えてないだけ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T12:12:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:27:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_middleman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うーん　もっと　かねになる
いい　しごとは　ないか！？▼
だって　そうだろ？▼
おなじ　しごとを　するなら
たくさん　おかねを　もらいたいよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:49:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うーん　もっと　金になる
いい　仕事は　ないか！？▼
だって　そうだろ？▼
同じ　仕事を　するなら
たくさん　お金を　もらいたいよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:50:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:26:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_badman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　ポケモン
うったら　いくらに　なるのか？▼
ん？　ねだん　だって
こいつの　かちを　あらわしてるぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:53:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　ポケモン
売ったら　いくらに　なるのか？▼
ん？　値段だって
こいつの　価値を　表してるぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:53:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:27:00" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほしいものが　すべてある
おかねさえ　あれば！　あれば！！▽
そうよ！　ほんきで　かせぐわよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:01:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>欲しいものが　全てある
お金さえ　あれば！　あれば！！▽
そうよ！　本気で　稼ぐわよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T08:01:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:27:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN3</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_bc10r0401_oldman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとは　のぞむものを　てにいれるため
ぶんめいを　はったつ　させてきたのか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:51:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人は　望むものを　入手するため
文明を　発達させてきたのか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:51:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T07:27:01" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
	</TextRow>
