	<TextRow
		Label="msg_c03p19_badman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よそものの　くせに……
つよい　ヤツは　きらいじゃないぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:12:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T10:59:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>余所者の　くせに……
強い　ヤツは　きらいじゃないぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:27:40" />
