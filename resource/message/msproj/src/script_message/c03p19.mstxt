	<TextRow
		Label="msg_c03p19_dancer_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここで　かたよせあって　いきてきた
いまさら　だれかを　しんじないぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:14:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T11:00:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここで　肩寄せあって　生きてきた
いまさら　だれかを　信じないぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:28:49" />
			<Status>Editing</Status>
