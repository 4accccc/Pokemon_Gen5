	<TextRow
		Label="msg_c03p19_badman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おれたち　３にんに　かてたら
なかまに　いれてやっても　いいぞ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:14:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T11:00:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おれたち　３人に　勝てたら
仲間に　いれてやっても　いいぞ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:27:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T11:00:08" />
		</LanguageCell>
		<CommentCell
