	<TextRow
		Label="msg_c03p19_badman_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレは　つよい　やつを　みとめる
つまり　あんたは　なかまだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T13:03:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T05:58:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレは　強い　やつを　認める
つまり　あんたは　仲間だ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:28:03" />
			<Status>Editing</Status>
