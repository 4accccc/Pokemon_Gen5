	<TextRow
		Label="msg_d08r0101_hakase1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アララギ『おお！
おまえさんも　きたのかい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-05T12:27:31" />
