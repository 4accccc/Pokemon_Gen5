<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c01r0302_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ボクは　ほのおタイプの
ポケモンばかり　そだてているのさ▼
みずや　いわ　じめんタイプの
ポケモンや　わざが　にがてだけど▼
たいさくを　かんがえるのも
トレーナーの　だいごみ　だからね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T07:56:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボクは　ほのおタイプの
ポケモンばかり　育てているのさ▼
みずや　いわ　じめんタイプの
ポケモンや　技が　苦手だけど▼
対策を　考えるのも
トレーナーの　だいごみ　だからね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T07:56:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T03:52:31" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN1
青年</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T08:46:03" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01r0302_breederw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ときどきは　ボックスを　みて
きになる　ポケモンを　そだてるの！▼
そだててみないと
わからないこと　いっぱい　あるし！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T03:55:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>時々は　ボックスを　みて
気になる　ポケモンを　育てるの！▼
育ててみないと
わからないこと　いっぱい　あるし！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T03:55:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T03:55:00" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BREEDERW
ブリーダー♀</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
