	<TextRow
		Label="msg_c03r1002_musicianw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あんた　ねてる？▼
ねないと　かいふく　しないよ▼
とゆーわけで　これ　あげる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-22T03:04:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あんた　ねてる？▼
ねないと　回復しないよ▼
とゆーわけで　これ　あげる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-22T03:04:42" />
