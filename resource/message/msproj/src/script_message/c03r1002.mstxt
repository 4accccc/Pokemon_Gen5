<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c03r1002_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしはね　きにしぃ　なんですよ
わかります？　きにしぃ？▼
なんでもかんでも　きになって
なにもない　ばしょを　しらべたり▽
いろんな　ひとと　はなしちゃうんです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T04:43:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしはね　きにしぃ　なんですよ
わかります？　きにしぃ？▼
なんでもかんでも　気になって
なにもない　場所を　調べたり▽
いろんな　人と　話しちゃうんです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T04:44:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T04:44:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN3</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c03r1002_musicianw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あんた　ねむれてる？▼
ねむらないと　かいふく　しないよ▼
とゆーわけで　これ　あげる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T08:17:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あんた　眠れてる？▼
眠らないと　回復しないよ▼
とゆーわけで　これ　あげる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T08:17:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手処理
　No371「ねむる」</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T06:57:06" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUSICIANW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T06:56:47" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r1002_musicianw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　きのみの
カゴのみを　もたせておくの！▼
そうすりゃ　ねむって　げんきになって
すぐに　めざめて……ってわけ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T06:58:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　きのみの
カゴのみを　持たせておくの！▼
そうすりゃ　眠って　元気になって
すぐに　めざめて……ってわけ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T08:17:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T06:57:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUSICIANW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T06:56:49" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
