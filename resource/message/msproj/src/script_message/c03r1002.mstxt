<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c03r1002_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしはね　きにしぃ　なんですよ
わかります？　きにしぃ？▼
なんでもかんでも　きになって
なにもない　ばしょを　しらべたり▽
いろんな　ひとと　はなしちゃうんです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T04:43:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしはね　きにしぃ　なんですよ
わかります？　きにしぃ？▼
なんでもかんでも　気になって
なにもない　場所を　調べたり▽
いろんな　人と　話しちゃうんです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T04:44:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T04:44:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN3</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c03r1002_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むかしのひとは　いいことを　いった
「ねるこは　そだつ！」▼
そう！　ねむるの　わざを　つかうと
ポケモンが　ねむって　かいふくする！▼
すでに　わたしの　ポケモンには
おぼえさせたので　きみに　ゆずろう！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昔の人は　いいことを　いった
「寝る子は　育つ！」▼
そう！　ねむるの　技を　使うと
ポケモンが　眠って　回復する！▼
すでに　わたしの　ポケモンには
覚えさせたので　きみに　譲ろう！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No371「ねむる」</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r1002_mountain_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねても　すぐ　めざめる
きのみ　ってのが　あるらしい▼
それを　もたせておけば
ねむって　かいふくして▽
すぐに　おきて……　というわけだ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>寝ても　すぐ　目覚める
木の実ってのが　あるらしい▼
それを　持たせておけば
眠って　回復して▽
すぐに　起きて……　というわけだ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
