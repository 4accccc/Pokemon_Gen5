				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c04r0305_soccerm5_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンと　サッカーをするから
ポケモンサッカー！▼
ちぢめて　ポッカー　か！？
いや　ポッサー　か！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T06:29:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンと　サッカーをするから
ポケモンサッカー！▼
縮めて　ポッカー　か！？
いや　ポッサー　か！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T06:29:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T06:30:01" />
		</CommentCell>
