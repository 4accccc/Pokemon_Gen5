	</TextRow>
	<TextRow
		Label="msg_c04r0305_soccerm7_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はしれ！　はしれ！
とにかく　かんがえて　はしれ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
