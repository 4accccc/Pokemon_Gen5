<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_n01r0302_assistantm1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まよいびとよ　おどろいたか▼
この　しろ　こそが　プラズマだんの！▼
いや　ゲーチスさまの　かがくりょく！
ちしきの　けっしょう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:08:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>迷い人よ　驚いたか▼
この　城こそが　プラズマ団の！▼
いや　ゲーチスさまの　科学力！
知識の　結晶！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:08:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
