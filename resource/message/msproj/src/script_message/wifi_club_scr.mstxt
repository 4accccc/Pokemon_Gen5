	<TextRow
		Label="msg_wifi_club_10_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おきゃくさま
こちらへ　どうぞ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
