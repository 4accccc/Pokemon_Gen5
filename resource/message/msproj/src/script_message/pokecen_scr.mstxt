	</TextRow>
	<TextRow
		Label="msg_pc_heal_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまちどおさま！[Ctrl2:PageClear ]
おあずかり　した　ポケモンは
みんな　げんきに　なりましたよ！[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまちどおさま！[Ctrl2:PageClear ]
お預かりした　ポケモンは
みんな　元気に　なりましたよ！[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
