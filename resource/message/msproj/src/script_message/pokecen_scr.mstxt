	<TextRow
		Label="msg_pc_heal_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さん　おつかれさまです！
いつもので　よろしい　ですね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
