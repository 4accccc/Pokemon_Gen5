	<TextRow
		Label="msg_pc_union_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てもちに　つれていけない
ポケモンが　います▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
