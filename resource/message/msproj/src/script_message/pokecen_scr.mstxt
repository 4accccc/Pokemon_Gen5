	<TextRow
		Label="msg_pc_union_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もうしわけ　ございませんが
おきゃくさまは　まだ▽
ユニオンルームに　はいれません▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
