	<TextRow
		Label="msg_t04r0301_swleader2_summer_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ホミカ『まんぞくしたら　ダメ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
