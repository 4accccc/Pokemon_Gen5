				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04r0301_shirona_spring_02_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シロナ『……ちょっと　がっかり▼
きみとなら　これまでよりも
たかい　ステージでの▽
たたかいが　できそうなのに！▼
そう　もっともっと
いのちを　かがやかせられるはず……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シロナ『……ちょっと　がっかり▼
きみとなら　これまでよりも
高い　ステージでの▽
戦いが　できそうなのに！▼
そう　もっともっと
命を　輝かせられるはず……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
		</LanguageCell>
