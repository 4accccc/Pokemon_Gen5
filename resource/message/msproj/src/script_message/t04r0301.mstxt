	<TextRow
		Label="msg_t04r0301_shirona_spring_01_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シロナ『ありがとう！
ぜんりょくで　きみと　むきあいます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シロナ『ありがとう！
全力で　きみと　向き合います！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・春イベント：パターン1
・はい選択時
　メッセージ後、トレーナー戦闘に
　dpchampion_01</Comment>
