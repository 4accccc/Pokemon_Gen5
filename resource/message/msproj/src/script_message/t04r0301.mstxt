				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04r0301_shirona_spring_02_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シロナ『おたがいの　いとおしい
ポケモンを　つうじて▽
きみのこと　もっと　しるつもりよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シロナ『お互いの　愛おしい
ポケモンを　通じて▽
きみのこと　もっと　知るつもりよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・春イベント：パターン2
・はい選択時
　メッセージ後、トレーナー戦闘に
　dpchampion_01</Comment>
