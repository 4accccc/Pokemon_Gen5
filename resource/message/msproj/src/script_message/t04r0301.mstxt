				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04r0301_bigfour4_spring_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カトレア『むかしは
バトルキャッスルの　オーナー▼
イッシュの　してんのう▼
つぎは　どこかの　チャンピオン？▼
なんて　いってみたりして</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T06:05:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カトレア『むかしは
バトルキャッスルの　オーナー▼
イッシュの　四天王▼
次は　どこかの　チャンピオン？▼
なんて　いってみたりして</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T06:05:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T11:31:43" />
		</LanguageCell>
