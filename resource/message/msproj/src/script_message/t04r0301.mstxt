			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04r0301_leader6_summer_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フウロ『ふう……
うみで　およぐのって　きもちいいね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
