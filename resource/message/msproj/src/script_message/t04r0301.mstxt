				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t04r0301_bigfour1_spring_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シキミ『にじいろのはね……
ぎんいろのはね……▽
そうぞうりょくを　かきたてられます！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
