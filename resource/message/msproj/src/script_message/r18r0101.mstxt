	</TextRow>
	<TextRow
		Label="msg_r18r0101_00_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……ふむ
それも　きみの　じゆうだ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
