		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>