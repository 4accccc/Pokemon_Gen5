	<TextRow
		Label="msg_r13r0101_girl1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　キャモメ　むかしは　みんなに
メールを　はいたつ　してたの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T08:16:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:12:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　キャモメ　昔は　みんなに
メールを　配達してたの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T08:16:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:12:30" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T08:17:04" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL1</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:12:18" />
		</AttributeCell>
	</TextRow>
