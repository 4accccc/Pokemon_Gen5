				Time="2012-01-11T05:59:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d24r1001_poke485_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒードランは　かざんの　おくに
すがたを　けしていった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:58:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:58:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒードランは　火山の　奥に
姿を　消していった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:59:24" />
			<Status>Editing</Status>
