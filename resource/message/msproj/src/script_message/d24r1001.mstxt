<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d24r1001_swbell_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここって……　なんだろ
なんだか　ふしぎな　かんじ▼
もしかして　ここが
リバースマウンテンの　みなもと……▽
ポケモン　ヒードランの　すみか？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-27T06:40:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここって……　なんだろ
なんだか　不思議な　感じ▼
もしかして　ここが
リバースマウンテンの　源と……▽
ポケモン　ヒードランの　すみか？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-27T06:40:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:40:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・posまで誘導しメッセージ表示</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:40:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:40:17" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T05:59:09" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d24r1001_swbell_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒードランってのは　ぜんしんを
マグマの　ような　けつえきが▽
ながれている　ポケモンなんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T02:04:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:40:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒードランってのは　全身を
マグマの　ような　血液が▽
流れている　ポケモンなんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T02:04:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:40:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・振り向き</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:40:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:40:17" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T05:59:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d24r1001_poke485_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かざんのおきいしが
はんのう　している……▽
ここに　おいてみますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:53:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-05-31T12:51:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>かざんのおきいしが
反応している……▽
ここに　置いてみますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:53:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="tamada:W00253"
				Time="2011-05-31T12:51:37" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・ver
・No「かざんのおきいし」所有時で
　pos（GRIDX＝9～11、GRIDZ＝16）
・はい/いいえの選択肢表示
　はい　→poke485_02
　いいえ→終了</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T12:07:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>TPOKE
ポケモン・ヒードラン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:59:40" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T05:59:12" />
		</AttributeCell>
		<AttributeCell
			Name="キャラ指定">
			<Text>？？？</Text>
			<TextModifiedBy
				User="tamada:W00253"
				Time="2011-05-31T12:51:37" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d24r1001_poke485_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ごごぼっ　ごぼぼぼ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-27T03:58:50" />
			<Status>Editing</Status>
