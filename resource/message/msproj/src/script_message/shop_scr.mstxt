	<TextRow
		Label="msg_shop_01_waza"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わざマシン　うりばへ　ようこそ！
おかいもの　ですね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わざマシン売り場へ　ようこそ！
お買い物ですね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
