	<TextRow
		Label="msg_bp_shop_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ！
ポイント　ひきかえ　コーナーへ！[Ctrl2:PageClear ]
ＢＰと　けいひんを
こうかん　しますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ！
ポイント　引き換え　コーナーへ！[Ctrl2:PageClear ]
ＢＰと　景品を
交換しますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
