<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t02r0101_middlewoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いい？　トレーナーは
いつでも　えがおで　なきゃ！▼
そうでないと　ポケモンも
あんしん　できないでしょ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T09:04:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いい？　トレーナーは
いつでも　笑顔で　なきゃ！▼
そうでないと　ポケモンも
安心できないでしょ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T09:04:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T09:14:51" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN1
おばさん１</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:55:19" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0101_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　ポケモンに
どの　どうぐを　もたせるか……？▼
せいかいが　ないから　なやむけど
その　じかんも　すきなの　アタシ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T09:24:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの　ポケモンに
どの　道具を　持たせるか……？▼
正解が　ないから　悩むけど
その時間も　好きなの　アタシ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T09:24:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-16T09:24:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1
女性１</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:55:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0101_boy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ！　ポケモン！
いいなぁ　うらやましいなぁ▼
なんてね！　ぼく　２ねんまえに　みた
カノコの　あの　ひと　みたいにさ▽
ポケモントレーナーに　なったんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:57:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ！　ポケモン！
いいなぁ　うらやましいなぁ▼
なんてね！　ぼく　２年前に　みた
カノコの　あの人みたいにさ▽
ポケモントレーナーに　なったんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:57:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:39:24" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY1
少年１</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:55:07" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
