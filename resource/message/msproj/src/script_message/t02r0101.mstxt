			<Comment>♂
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:39:24" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY1
少年１</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:55:07" />
		</AttributeCell>
		<AttributeCell
