<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t02r0101_middlewoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あんた！　ポケモンを　そだてるため
たたかわせるのも　だいじだけど▼
たいりょくが　へったときは
ポケモンセンターに　つれていきなよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あんた！　ポケモンを　育てるため
戦わせるのも　大事だけど▼
体力が　減ったときは
ポケモンセンターに　連れていきなよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:39:27" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN1
おばさん１</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:55:19" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0101_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーさん　モンスターボールは
いくつ　もってるのかしら？▼
すくないと　おもったら
ポケモンセンターの　なかにある▽
ショップで　かうのが　ベストね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーさん　モンスターボールは
いくつ　持ってるのかしら？▼
少ないと　思ったら
ポケモンセンターの　中にある▽
ショップで　買うのが　ベストね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:39:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1
女性１</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:55:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0101_boy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ！　ポケモン！
いいなぁ　うらやましいなぁ▼
なんてね！　ぼく　２ねんまえに　みた
カノコの　あの　ひと　みたいにさ▽
ポケモントレーナーに　なったんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:57:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ！　ポケモン！
いいなぁ　うらやましいなぁ▼
なんてね！　ぼく　２年前に　みた
カノコの　あの人みたいにさ▽
ポケモントレーナーに　なったんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:57:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
