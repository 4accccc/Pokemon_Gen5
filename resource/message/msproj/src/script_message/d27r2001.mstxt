<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d27r2001_swplazmaw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あー　よくねた！▼
あんた　へんな　かっこうだけど
しんいり？　ここの　ベッド▽
あいてるから　じゆうに　つかえば？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-11T05:59:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T05:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あー　よく寝た！▼
あんた　変な　格好だけど
新入り？　ここの　ベッド▽
空いてるから　自由に　使えば？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-11T05:59:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T05:45:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アジト船：クリア前
・GRIDX＝21、GRIDZ＝8</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-11T05:55:56" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWPLAZMAM
プラズマ団♀・したっぱ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T05:46:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d27r2001_bed_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベッドが　ある……！
すこし　やすんで　いきますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T05:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T05:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベッドが　ある……！
すこし　休んで　いきますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T05:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T05:45:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ＢＧメッセージ
・はい/いいえの選択肢表示
　はい　→bed_02
　いいえ→終了</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T05:48:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ベッド</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T05:45:44" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
