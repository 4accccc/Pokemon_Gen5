			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d23r0101_workman2c_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コンビナートの　しごとは
まいにち　おんなじでも　いいんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T09:23:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コンビナートの　仕事は
毎日　おんなじでも　いいんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T09:23:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・トレーナー戦闘後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:51:04" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2
鉱山作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:06" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
