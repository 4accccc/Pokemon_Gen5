<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="sg_d23r0101_workman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おう！　ポケモントレーナー
げんきそうな　ポケモンを　つれてるな！▼
そうだ！
ちょいと　たのまれてくれ！▼
この　コンビナートで　はたらく
れんちゅうに　かつを　いれるだけだ！▽
どうだろう？　ひきうけてくれるかい？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T02:39:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おう！　ポケモントレーナー
元気そうな　ポケモンを　つれてるな！▼
そうだ！
ちょいと　頼まれてくれ！▼
この　コンビナートで　働く
連中に　活を　いれるだけだ！▽
どうだろう？　引き受けてくれるかい？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T02:39:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
GRIDX=15、GRIDZ=26
・はい/いいえの選択肢表示
・はい　→middleman2_02
　いいえ→middleman2_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:50:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN
氷の作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:42:23" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="sg_d23r0101_workman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おう！
たのもしい　へんじだな！▼
この　コンビナートで　はたらく
しんじんの　さぎょういんが　いる▼
そいつら　３にんに
かつを　いれてきてくれ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T02:09:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おう！
頼もしい　返事だな！▼
この　コンビナートで　働く
新人の　作業員が　いる▼
そいつら　３人に
活を　いれてきてくれ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T02:39:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:44:29" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN
氷の作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:03" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="sg_d23r0101_workman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんとまあ……！　みんな
ハングリーせいしんが　たりないぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T09:18:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんとまあ……！　みんな
ハングリー精神が　たりないぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T09:18:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・いいえ選択時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:44:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN
氷の作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:03" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="sg_d23r0101_workman_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おう！　たのんだぜ！▼
しんじん　さぎょういん　３にんは
コンビナートの　あちこちに　いるぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T02:13:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おう！　頼んだぜ！▼
新人作業員　３人は
コンビナートの　あちこちに　いるぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T02:39:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択後
　すべての新人作業員と会話していない</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:45:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN
氷の作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:03" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="sg_d23r0101_workman_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おお！　やってくれたな！
こいつは　ほんの　きもちだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T02:44:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おお！　やってくれたな！
こいつは　ほんの　気持ちだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T02:44:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択後
　すべての新人作業員と会話した
・アイテム入手処理
　No619「わざマシン９４」（いわくだき）</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T12:19:05" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN
氷の作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:03" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d23r0101_workman_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みんなの　やるきで　コンビナートが
かっきで　あふれているよな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T05:20:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T02:43:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みんなの　やる気で　コンビナートが
活気で　あふれているよな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T05:20:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T02:43:38" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T02:44:00" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN
氷の作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T02:43:38" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d23r0101_workman2a_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コンビナートで　はたらくのが
ぼくの　ゆめ　だった……▼
それが　かなったから
もう　まんぞく　なんだよお……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T02:45:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コンビナートで　働くのが
ぼくの　夢だった……▼
それが　かなったから
もう　満足なんだよお……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T03:07:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=30、GRIDZ=51
・workman_02表示前</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:50:06" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2
鉱山作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:01" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d23r0101_workman2a_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コンビナートで　はたらくのが
ぼくの　ゆめ　だった……▼
それが　かなったから
もう　まんぞく　なんだよお……▼
え？　げんばかんとく　が？
しょうぶすれば　いいんでしょ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T12:20:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コンビナートで　働くのが
ぼくの　夢だった……▼
それが　かなったから
もう　満足なんだよお……▼
え？　現場監督が？
勝負すれば　いいんでしょ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T12:20:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・workman_02表示後
・続けてトレーナー戦闘に</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:49:43" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2
鉱山作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:06" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d23r0101_workman2a_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　かつやく　してもらうため
コンビナートへ　きてるんだった！▼
ということは　トレーナーの　おれが
がむしゃらに　しごと　しないとな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T09:19:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンに　活躍してもらうため
コンビナートへ　来てるんだった！▼
ということは　トレーナーの　おれが
がむしゃらに　仕事しないとな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T09:19:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・トレーナー戦闘後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:49:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2
鉱山作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:06" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d23r0101_workman2b_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だいすきな　ポケモンと　いっしょなら
それだけで　ハッピー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T03:08:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大好きな　ポケモンと　一緒なら
それだけで　ハッピー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T03:08:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=26、GRIDZ=31
・workman_02表示前</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:50:02" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2
鉱山作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:06" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d23r0101_workman2b_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だいすきな　ポケモンと　いっしょなら
それだけで　ハッピー！▼
うん？　しょうぶ　なの？
そうだね……　ちょっと　あそぶかな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T03:08:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大好きな　ポケモンと　一緒なら
それだけで　ハッピー！▼
うん？　勝負なの？
そうだね……　ちょっと　遊ぶかな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T03:08:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・workman_02表示後
・続けてトレーナー戦闘に</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:49:51" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2
鉱山作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:06" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d23r0101_workman2b_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おれが　がんがん　はたらかないと
ポケモンも　でばんが　ないこと▽
すっかり　わすれていたぞ！　うおー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T02:57:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おれが　がんがん　働かないと
ポケモンも　出番が　ないこと▽
すっかり　忘れていたぞ！　うおー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T03:08:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・トレーナー戦闘後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:49:51" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN2
鉱山作業員</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:43:06" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d23r0101_workman2c_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きのうも　おんなじ……
あしたも　おんなじ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T02:48:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昨日も　おんなじ……
明日も　おんなじ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-28T03:08:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-30T06:54:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=5、GRIDZ=32
・workman_02表示前</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
