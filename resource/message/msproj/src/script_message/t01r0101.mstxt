				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>前作主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T03:37:16" />
		</AttributeCell>
		<AttributeCell
