	<TextRow
		Label="msg_t01r0101_mama_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうだ！　しょうぶをした　ポケモンを
やすませて　あげないと！[Ctrl2:PageClear ]</Text>
