	<TextRow
		Label="msg_t01r0101_mama_09b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　ために　ポケモンは
がんばって　くれるんだもん！▼
あなたも　ポケモンに
やさしくしてあげてね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T03:11:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
