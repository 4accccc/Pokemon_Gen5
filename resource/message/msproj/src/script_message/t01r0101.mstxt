	<TextRow
		Label="msg_t01r0101_mama_09a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うん　ばっちり！▼
あなたも　ポケモンも
げんき　ハツラツって　かんじ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T03:13:00" />
