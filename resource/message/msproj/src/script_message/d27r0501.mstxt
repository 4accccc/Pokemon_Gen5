	</TextRow>
	<TextRow
		Label="msg_d27r0101_sage7_02_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヴィオ『そうだとも</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T05:32:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
