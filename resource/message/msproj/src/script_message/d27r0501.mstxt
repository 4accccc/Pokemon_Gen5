	</TextRow>
	<TextRow
		Label="msg_d27r0501_swrival_02_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『……しんだ　じいちゃんが
いもうとの　ために▼
つかまえてくれた　チョロネコは
せかいに　そいつだけ　だからだよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T09:06:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T05:08:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『……死んだ　じいちゃんが
妹の　ために▼
捕まえてくれた　チョロネコは
世界に　そいつだけ　だからだよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T09:06:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T05:08:00" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アジト船：２回目
・続けてsage7_02_08
・1＝ライバル名</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-18T09:47:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T05:07:50" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-06T05:56:19" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
