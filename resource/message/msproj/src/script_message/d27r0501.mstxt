	<TextRow
		Label="msg_d27r0501_swrival_02_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あの　ポケモンは……▼
こおりついて　いる……▼
まさか……　ソウリュウの……！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T05:29:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T03:52:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あの　ポケモンは……▼
凍りついて　いる……▼
まさか……　ソウリュウの……！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T05:29:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T03:52:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アジト船：２回目
・！マーク表示後、メッセージ
・続けてsage7_02_01</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-18T06:06:21" />
		</CommentCell>
		<AttributeCell
			Name="Character">
