	<TextRow
		Label="msg_hide_ship_hint2_start"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふねの　なかって　たいくつなんだ
ちょいと　あそんでやるよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-10T08:36:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T10:02:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>船の　中って　退屈なんだ
ちょいと　遊んでやるよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-10T08:37:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T10:02:14" />
		</LanguageCell>
