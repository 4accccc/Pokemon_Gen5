	<TextRow
		Label="msg_hide_ship_hint2_start"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふねの　なかって　たいくつなんだ
ちょいと　あそんでやるよ！▼</Text>
			<TextModifiedBy
