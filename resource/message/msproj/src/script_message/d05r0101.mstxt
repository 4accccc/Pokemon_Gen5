				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d05r0101_swleader1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『なぜ　ぼくまで……
しらべることが　あるのに▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-23T07:56:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-22T06:47:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレン『なぜ　ぼくまで……
調べることが　あるのに▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-23T07:56:58" />
