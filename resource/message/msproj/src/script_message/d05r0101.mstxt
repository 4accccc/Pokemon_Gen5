	<TextRow
		Label="msg_d05r0101_backpackerw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたし　かんせんに　きただけだけど
ちょうせんのため　とおくから　くる▽
トレーナーも　たくさん　いそうね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたし　観戦に　来ただけだけど
挑戦のため　遠くから　来る▽
トレーナーも　たくさん　いそうね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
