		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BACKPACKERW
バックパッカー♀</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
