	<TextRow
		Label="msg_d05r0101_policeman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとっこ　ひとり　はいれないとは
まさに　このこと！　だいにんきだな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人っ子　一人　入れないとは
まさに　このこと！　大人気だな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
