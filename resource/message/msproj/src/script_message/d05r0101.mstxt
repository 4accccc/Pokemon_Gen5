		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:35:40" />
		</AttributeCell>
		<AttributeCell
