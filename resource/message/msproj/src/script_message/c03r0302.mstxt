	<TextRow
		Label="msg_c03r0302_assistantm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　かいはつ　たんとう！▼
けんがくに　きてくれた
きみに　これを　あげよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T09:31:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>私は　開発担当！▼
見学に　来てくれた
君に　これを　あげよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T09:31:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No232「ピントレンズ」</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T09:59:48" />
		</AttributeCell>
		<AttributeCell
