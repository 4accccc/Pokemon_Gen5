	</TextRow>
	<TextRow
		Label="msg_c03r0302_businessman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ものすごく　うれしいから
さらに　プレゼントだよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
