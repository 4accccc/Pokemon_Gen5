	<TextRow
		Label="msg_c03r0302_assistantm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　かいはつ　たんとう！[Ctrl2:PageClear ]
けんがくに　きてくれた
きみに　これを　あげよう！[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>私は　開発担当！[Ctrl2:PageClear ]
見学に　来てくれた
君に　これを　あげよう！[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No232「ピントレンズ」</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM</Text>
			<TextModifiedBy
