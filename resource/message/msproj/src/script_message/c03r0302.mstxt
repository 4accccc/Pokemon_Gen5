	<TextRow
		Label="msg_c03r0302_businessman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おっ！？　かいしゃけんがく？
とにかく　しょうぶ　しようよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おっ！？　会社見学？
とにかく　勝負しようよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・トレーナー戦闘へ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T09:59:50" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0302_businessman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんという　じつりょく！
かんどう　したから　プレゼントだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんという　実力！
感動したから　プレゼントだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No015「クイックボール」×２</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-08T03:58:54" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T09:59:50" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0302_businessman1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>クイックボールは　ポケモンと
であって　すぐに　なげたほうが▽
つかまえやすさが　アップするよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>クイックボールは　ポケモンと
であって　すぐに　投げたほうが▽
捕まえやすさが　アップするよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T09:59:45" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0302_businessman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もしかして　ポケモンしゅぎょう？
だったら　よろこんで　つきあうよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もしかして　ポケモン修行？
だったら　喜んで　つきあうよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・トレーナー戦闘へ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BUSINESSMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T09:59:50" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0302_businessman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そんな　すごい　うでまえ　なら
これも　つかいこなせるよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T11:56:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そんな　すごい　腕前なら
これも　使いこなせるよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T11:56:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-19T11:30:08" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No010「タイマーボール」×５</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-08T03:59:00" />
		</CommentCell>
