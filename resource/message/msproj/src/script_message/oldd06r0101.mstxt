		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLD_HAKAIM
元プラズマ団</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-15T06:23:49" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
