	<TextRow
		Label="msg_mdloyj_prizegoal_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……その　きねんとして
メダル[System:Color name="2" ]「[Name:Medal ]」[/System:Color]を
ぞうてい　いたします！</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-20T07:39:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……その　記念として
メダル[System:Color name="2" ]「[Name:Medal ]」[/System:Color]を
贈呈いたします！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T12:04:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>メダル事務局・ゴールイン表彰イベント
・0=メダル名</Comment>
			<CommentModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-20T07:39:27" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
