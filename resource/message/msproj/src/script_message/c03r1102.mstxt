			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_mdlbg_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たくさんの　しゅるいの
