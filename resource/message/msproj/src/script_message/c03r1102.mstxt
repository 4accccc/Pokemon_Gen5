	<TextRow
		Label="msg_mdloyj_prizegoal_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆうしゅうな　せいせきを
おさめ……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T09:25:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
