	<TextRow
		Label="msg_mdloyj_prizegoal_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName ]さん　あなたは
メダルラリーに　おいて▼
ゆうしゅうな
せいせきを　おさめ……</Text>
			<TextModifiedBy
				User="ito_hiroto:W00178"
				Time="2011-10-20T07:38:39" />
