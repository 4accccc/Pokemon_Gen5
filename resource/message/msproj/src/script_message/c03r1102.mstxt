				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_mdloyj_prizegoal_end"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メダルラリーは　まだまだ
おわりでは　ありません！▼
この　ちょうしで　これからも
メダルを　じゃんじゃん▽
かくとくして　いってください！▼
では！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T12:04:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メダルラリーは　まだまだ
終わりでは　ありません！▼
この調子で　これからも
メダルを　じゃんじゃん▽
獲得していってください！▼
では！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T12:04:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
