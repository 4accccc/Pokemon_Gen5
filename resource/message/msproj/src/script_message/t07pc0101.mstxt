	<TextRow
		Label="msg_t07pc0101_oldwoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひひひ　おまえさん　トレーナーだろ？
だまって　これを　うけとりな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-26T05:09:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ひひひ　おまえさん　トレーナーだろ？
だまって　これを　受け取りな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-26T05:09:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手処理
・No247[のろいのおふだ」</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-26T05:07:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>老婆</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-24T11:34:49" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
