	<TextRow
		Label="msg_t07pc0101_fighterw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんとう　めっきゃく　すれば
ひもまた　すずし！　です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-26T05:13:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>心頭滅却すれば
火もまた　涼し！　です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-26T05:13:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・仮メッセージ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-26T05:13:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>バトルガール</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-24T11:34:29" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
