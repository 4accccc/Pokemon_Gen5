				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_appraisal_r_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>って　それは
こだいのおうかん！▼
かいていいせきの　いちばん　おくに
ねむるという　めずらしい　おたから！▼
きみが　たいせつに　しておくのも
あり　だとおもうが▼
それを　[Digit:8digits Idx="1" ]円で
ゆずってくれないかね？　かね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>って　それは
こだいのおうかん！▼
海底遺跡の　一番　奥に
眠るという　珍しい　お宝！▼
きみが　大切に　しておくのも
あり　だと思うが▼
それを　[Digit:8digits Idx="1" ]円で
ゆずってくれないかね？　かね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●鑑定アイテム：大富豪
・No634「こだいのおうかん」を持っているとき
　1回のみ発生
・はい/いいえ表示
・はい→msg_appraisal_r_04
　いいえ→msg_appraisalr_07</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T12:21:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>格闘家♂
FIGHTERM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_appraisal_r_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だいふごうの　オレが
たいきんを　はらってでも　ほしくなる……▼
そんな　めずらしい　どうぐ
もってないかね？　かね？▼
ムムム……！　めずらしい
どうぐは　もってないね！　ね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大富豪の　オレが
大金を　積んででも　欲しくなる……▼
そんな　珍しい　道具
持ってないかね？　かね？▼
ムムム……！　珍しい
道具は　持ってないね！　ね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●鑑定アイテム：大富豪
・買い取れる道具が一つもない</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>格闘家♂
FIGHTERM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_appraisal_m2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やあ　とつぜんだが　きみに
ウマい　はなしを　もちかけるよ！▼
このあたりに　いしころや　いわに
かくれてる　ポケモンが　いるだろ？▼
あいつら　からだを　いわに
かくしてるだけ　じゃなく▽
いかしたブツも　いっしょに▽
かくしもってるんだなー　これが！▼
そこでだ……▼
もし　きみが　その　いかしたブツを
てにいれたら　わたしの　ところへ▽
もって　きてくれないか？▼
どこよりも　だれよりも　たかーく
かいとって　あげるからさ……▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やあ　突然だが　君に
ウマい　話を　持ちかけるよ！▼
この辺りに　石ころや　岩に
隠れている　ポケモンが　いるだろ？▼
あいつら　体を　岩に
隠してるだけ　じゃなく▽
いかしたブツも　一緒に▽
隠し持ってるんだなー　これが！▼
そこでだ……▼
もし　君が　その　いかしたブツを
手に入れたら　私の　ところへ▽
持ってきて　くれないか？▼
どこよりも　だれよりも　高ーく
買い取って　あげるからさ……▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>※進行フローは共通

●鑑定アイテム：鉱物２
・話しかけメッセージ１　初回のみ
・話しかけ後→msg_appraisal_m2_02
・話しかけ後、買い取れるものがない
　→msg_appraisal_m2_08</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>サングラス
SUNGLASSES</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
