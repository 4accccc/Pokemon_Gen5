	<TextRow
		Label="msg_appraisal_r_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いいものが　てにはいったよ！
すごいと　おもわんかね？　かね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
