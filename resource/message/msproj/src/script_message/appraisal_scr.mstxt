	<TextRow
		Label="msg_appraisal_r_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これは　ちょっと　ちがうなー
きみも　そうおもわんかね？　かね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これは　ちょっと　違うなー
きみも　そう思わんかね？　かね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
