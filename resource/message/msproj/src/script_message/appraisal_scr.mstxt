	<TextRow
		Label="msg_appraisal_r_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きがかわったら　めずらしい　どうぐ
ゆずって　くれないかね？　かね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気が変わったら　珍しい道具　
ゆずってくれないかね？　かね？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>●鑑定アイテム：大富豪
・イベント終了</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>格闘家♂
FIGHTERM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<ExtraCell
