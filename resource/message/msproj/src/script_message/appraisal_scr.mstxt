			<CellData>#ffffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_appraisal_m2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうだい？
いかしたブツが　あるなら▽
みせて　くれないかな？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
