				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_appraisal_g_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ワーオ！　ナイス　スメル！[Ctrl2:PageClear ]
しかもそいつは　まぼろしのしょくざい
[Name:Item Idx="0" ]　じゃーん！！▼
[Digit:8digits Idx="1" ]円で
アタイに　ゆずってくんないかな！？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ワーオ！　ナイス　スメル！[Ctrl2:PageClear ]
しかもそいつは　幻の食材
[Name:Item Idx="0" ]　じゃーん！！▼
[Digit:8digits Idx="1" ]円で
アタイに　譲ってくんないかな！？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
