			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_appraisal_k_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こやしを　もっているんだろ？
よかったら　みせてくれないかな？▼</Text>
