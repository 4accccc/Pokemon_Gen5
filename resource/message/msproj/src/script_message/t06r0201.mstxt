	<TextRow
		Label="msg_t06r0201_oldman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しまう　どうぐの　しゅるいによって
じどうてきに　ふりわけてくれる▽
バッグとは　すごいもんじゃのう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T05:01:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しまう　道具の　種類によって
自動的に　ふりわけてくれる▽
バッグとは　すごいもんじゃのう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T05:00:54" />
			<Status>Editing</Status>
