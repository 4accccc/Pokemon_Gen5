	<TextRow
		Label="msg_t06r0201_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はれているとね　ミネズミのね
たいもうが　わりと　フカフカしてね▽
なんとなく　さわりたくなるのね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T02:42:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T02:35:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>晴れているとね　ミネズミのね
体毛が　わりと　フカフカしてね▽
なんとなく　触りたくなるのね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T03:58:02" />
			<Status>Editing</Status>
