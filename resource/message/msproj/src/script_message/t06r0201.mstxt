	<TextRow
		Label="msg_t06r0201_oldman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よう！　どうぐは　いくつあっても
ジャマには　ならんだろ？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よう！　道具は　いくつあっても
ジャマには　ならんだろ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T02:06:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手前
・No017「キズぐすり」入手処理</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
