	<TextRow
		Label="msg_c03p07_swchampion_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうだ！　さいきん　できた
あそこ　かも……！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そうだ！　最近　できた
あそこ　かも……！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
