	<TextRow
		Label="msg_c03p07_cgear_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｃギアの　きのうが
せいげんされますが　よろしいですか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T11:18:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T11:18:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｃ－ＧＥＡＲの　機能が
制限されますが　よろしいですか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T11:18:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T11:18:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>システムメッセージ
・いいえを選択したときの再確認</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T11:18:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>システム</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T11:18:09" />
		</AttributeCell>
