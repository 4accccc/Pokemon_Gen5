	<TextRow
		Label="msg_c03p07_glasses_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ガイドー『お！　アイリスさん▼
じつは　かくかくしかじか　でね
アーティさん　いないんっすよね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ガイドー『お！　アイリスさん▼
実は　かくかくしかじか　でね
アーティさん　いないんっすよね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T02:58:03" />
			<Status>Editing</Status>
