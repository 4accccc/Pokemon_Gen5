				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWCHAMPION
アイリス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:38:30" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
