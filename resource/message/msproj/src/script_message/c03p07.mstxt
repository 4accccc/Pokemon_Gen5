			<Text>SWCHAMPION
アイリス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:38:30" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
