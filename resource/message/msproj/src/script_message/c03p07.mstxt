	<TextRow
		Label="msg_c03p07_glasses_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ガイドー『お！　アイリスさん▼
じつは　かくかくしかじか　でね
アーティさん　いないんっすよね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
