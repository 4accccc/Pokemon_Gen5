	<TextRow
		Label="msg_d32r0101_poke50_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおきな　いわに　たいして
アクロママシーンを　つかいますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:55:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-08T05:26:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大きな　岩に　対して
