				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d32r0101_fighterm_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ムムッ！▼
オレと　オレの　ダンゴロは
バッジを　７ついじょう　もつ▽
きみのような　つわものを▽
まっていた！▼
ここを　とおりたければ
がんじょうな　オレと▽
オレの　ダンゴロを　たおすのだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:05:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:05:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ムムッ！▼
オレと　オレの　ダンゴロは
バッジを　７つ以上　持つ▼
きみのような
ツワモノを　待っていた！▼
ここを　通りたければ
がんじょうな　オレと▽
オレの　ダンゴロを　倒すのだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:19:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:06:40" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・バッジが７個のとき
・はい/いいえの選択肢表示
　はい　→fighterm_03
　いいえ→fighterm_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:18:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERM
トレーナーID：karate_22</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-05T02:57:47" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d32r0101_fighterm_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっておくが　オレの　ダンゴロは
がんじょう＆がんじょう　だぜ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:17:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:14:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いっておくが　オレの　ダンゴロは
がんじょう＆がんじょう　だぜ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:17:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
