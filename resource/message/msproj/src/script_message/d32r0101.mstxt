	</TextRow>
	<TextRow
		Label="msg_d32r0101_fighterm_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんと　まあ……
ふがいない　へんじ　だな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:17:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:05:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんと　まあ……
ふがいない　返事だな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:19:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:06:40" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・いいえ選択時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T12:14:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERM
トレーナーID：karate_22</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-05T02:57:47" />
		</AttributeCell>
