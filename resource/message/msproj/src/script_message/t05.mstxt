	<TextRow
		Label="msg_t05_railfan_railtalk1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　スーパーシングルトレインは
あたらしい　りょうさんがたの▽
しゃりょうなんだ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　スーパーシングルトレインは
