				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t05_recept_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しずかな　まち　ですからね！
しばらく　ゆっくり▽
してくと　いいですよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>静かで　よい町ですからね！
しばらく　ゆっくり▽
してくと　いいですよ</Text>
