	<TextRow
		Label="msg_t05_railfan_railtalk1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　しゃりょうは　シングルトレイン！
バトルサブウェイで　もっとも▽
ふるい　しゃりょうです</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　車両は　シングルトレイン！
バトルサブウェイで　もっとも▽
歴史のある　車両です</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
