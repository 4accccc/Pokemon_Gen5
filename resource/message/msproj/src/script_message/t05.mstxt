		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　かくど　からの
しゃしんが　ほしかったの！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
