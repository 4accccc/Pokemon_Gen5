	<TextRow
		Label="msg_t05_railman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんじつは　すべての
しゃりょうが　おやすみちゅうです！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
