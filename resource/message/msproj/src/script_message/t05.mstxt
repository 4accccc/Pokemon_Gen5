	<TextRow
		Label="msg_t05_railfan_railtalk1_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうの　しゃりょうは
モーソートレイン！▽
ロケットよりも　はやく！▽
エアコンよりも　しずかに　うごく！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きょうの　車両は
モーソートレイン！▽
ロケットよりも　速く！▽
エアコンよりも　しずかに　動く！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
カメラ切り替え１（左→右）
車両無しのとき</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>作業員</Text>
			<TextModifiedBy
