	</TextRow>
	<TextRow
		Label="msg_t05_railfan_02_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よしきた！
しゅっぱつ　しんこうだ！！▼</Text>
			<TextModifiedBy
