	<TextRow
		Label="msg_c05gym0101_swleader5_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さてと　おてなみ
はいけんさせて　いただくか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-23T04:05:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さてと　お手並み
拝見させて　いただくか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-23T04:05:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・戦闘前メッセージ
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-23T04:06:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ジムリーダー
ヤーコン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T03:07:27" />
		</AttributeCell>
		<AttributeCell
