	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d04r0801_hakaim_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだん『ちくしょー！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマ団『ちくしょー！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・d04r0701から来ると
　！マーク表示後、隣接してメッセージ表示
・表示後、トレーナー戦闘に</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKAIM
プラズマ団♂</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d04r0801_hakaim_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだん『この　こだいのしろで
しちけんじんの　リョクシさまが▽
ポケモンを　さがしている▼
それを　ジャマさせないよう
みはっていたのに……▽
よわい　オレの　バカバカバカバカ！▼
もうひとつ　おまけに　バカ！▼
かわいく　いって　アンポンタン！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマ団『この　古代の城で
七賢人の　リョクシさまが▽
ポケモンを　探している▼
それを　ジャマさせないよう
見張っていたのに……▽
弱い　オレの　バカバカバカバカ！▼
もうひとつ　おまけに　バカ！▼
かわいく　いって　アンポンタン！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・戦闘後自動で表示
　以降、繰り返し
・d04r2201の七賢人退場とあわせて削除</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKAIM
プラズマ団♂</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
