	<TextRow
		Label="msg_d04r0101_backpackerw_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やっぱり　カセキが　きになる？[Ctrl2:PageClear ]
いいよ！　どちらか
えらんだ　カセキを　あげるから！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
