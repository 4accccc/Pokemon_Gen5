	<TextRow
		Label="msg_d04r0101_stop_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すなが　どんどん　おちていって
したまで　すすめるように　なったぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂が　どんどん　落ちていって
下まで　進めるように　なったぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
