<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r01r0101_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたし　さいきん　ここの
たんとうに　なったのですけれど▼
あの　でんこうけいじばん　って
いつから　まっくろ　なんでしょう？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたし　最近　ここの
担当に　なったのですけれど▼
あの　電光掲示板って
いつから　真っ黒　なんでしょう？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanではメッセージ変更予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:29:04" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFOMATIONW</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r01r0101_backpackerw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おかねの　むだづかいは
ダメなこと　だけど▼
じかんの　むだづかいは
もっともっと　ダメだよね！▼
いましか　できないことって
ぜったいに　あるはずだもん！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お金の　無駄遣いは
ダメなこと　だけど▼
時間の　無駄遣いは
もっともっと　ダメだよね！▼
いましか　できないことって
絶対に　あるはずだもん！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanではメッセージ変更予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T06:29:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BACKPACKERW</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>