	<TextRow
		Label="msg_c08r0601_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ　トレーナーさん▼
ポケモンリーグには　あたらしい
ルートを　りよう　してくださいね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-17T02:46:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ　トレーナーさん▼
ポケモンリーグには　新しい
ルートを　利用してくださいね！</Text>
