	<TextRow
		Label="msg_c08r0601_infomationw_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さきほど　ライブキャスターで
きいた　はなし　なんですけど▽
７ばんどうろで　あらし　ですって！▼
しかも　しぜんげんしょう　とは
ちがうみたいなんです！　ふしぎ！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さきほど　ライブキャスターで
きいた　話なんですけど▽
７番道路で　暴風雨　ですって！▼
しかも　どうやら　自然現象とは
違うみたいなんです！　不思議！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>※swanでマップ削除</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T02:24:48" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW
受付嬢</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c08r0601_infomationw_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>７ばんどうろの　あらし　って
ポケモンが　おこしたそうですね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>７番道路の　暴風雨って
ポケモンが　起こしたそうですね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
