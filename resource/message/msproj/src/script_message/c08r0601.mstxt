	<TextRow
		Label="msg_c08r0601_infomationw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ！　トレーナーさん！
ちょっと　いいですか？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ！　トレーナーさん！
ちょっと　いいですか？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
