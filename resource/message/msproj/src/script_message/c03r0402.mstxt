	</TextRow>
	<TextRow
		Label="msg_c03r0402_05_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>びっくり　した？▼
まあ　きみくらい
つよい　トレーナーさん　なら▽
ロケットだんも　ひとひねり　やね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>びっくり　した？▼
まあ　きみくらい
強い　トレーナーさん　なら▽
ロケット団も　ひとひねり　やね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
