	<TextRow
		Label="msg_c03r0402_03_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おっ　つよくなったね！　わかるよ
ぼくと　ポケモンしょうぶ　してみる？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
