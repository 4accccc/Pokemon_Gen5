	<TextRow
		Label="msg_c04r0402_middleman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ううむ！　これは！
めいしょうぶが　うまれる　よかん！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ううむ！　これは！
名勝負が　うまれる　予感！▽
歴史の　生き証人に　なるかも！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
