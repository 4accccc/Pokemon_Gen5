	<TextRow
		Label="msg_c04r0402_fighterw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みた？
いま　かつやくした　きんにく！▽
まさに　ハッスル　マッスル！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みた？　いま　活躍した　筋肉！
まさに　ハッスル　マッスル！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
