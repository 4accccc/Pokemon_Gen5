	<TextRow
		Label="msg_c01r0201_bigman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おっ！　トレーナー！▼
こんなものしか　ないけれど
えんりょせずに　もっていきなよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T04:07:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おっ！　トレーナー！▼
こんなものしか　ないけれど
遠慮せずに　持っていきなよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T04:07:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手処理
　No003「スーパーボール」
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-08T03:25:01" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BIGMAN
太った青年</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
