<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c05pc0101_middlewoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ホドモエに　ならびたった
ホテルの　かずかず……▼
こいする　おとこ　チャールズも
もう　ホドモエめいぶつ　ではないねえ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T09:54:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ホドモエに　並びたった
ホテルの　数々……▼
恋する　男　チャールズも
もう　ホドモエ名物　ではないねえ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T09:54:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-29T09:54:34" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN1
おばさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05pc0101_girl1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなた　こんな　しゅるいの
モンスターボール　つかってる？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなた　こんな　種類の
モンスターボール　使ってる？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・メッセージ表示後
　アイテム入手処理
・No011「ゴージャスボール」×３
※swanで内容修正予定</Comment>
