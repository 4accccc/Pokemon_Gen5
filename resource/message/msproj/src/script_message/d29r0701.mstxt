	<TextRow
		Label="msg_d29r0701_poke55_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いわの　ちからを　かんじさせる
ポケモンの　ぞうが　うごきだした！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:53:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:04:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>岩の　力を　感じさせる
ポケモンの　像が　動きだした！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:53:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:04:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・続けて</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:04:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・レジロック</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:04:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0701_poke55_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ざざ　ざり　ざ……</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:04:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
