		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0701_poke55_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レジロックは　いせきの
おくふかくへ　きえてしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:52:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:04:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レジロックは　遺跡の
奥深くへ　消えてしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:52:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:04:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・捕獲以外で戦闘終了した場合
・マップ再読み込み時に復帰</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・レジロック</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:04:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
