	<TextRow
		Label="msg_c02r0701_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さて　イッシュちほう　には
ゲートが　いくつ　あるでしょう？</Text>
			<TextModifiedBy
