<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c02r0701_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さて　イッシュちほう　には
ゲートが　いくつ　あるでしょう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T10:14:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さて　イッシュ地方　には
ゲートが　いくつ　あるでしょう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T10:14:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T10:10:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW
受付嬢</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
