	<TextRow
		Label="msg_c02r0701_breederw_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ　はい！▼
では　この　タマゴを
よろしく　おねがい　します！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T06:05:18" />
			<Status>Editing</Status>
