			<Comment>♂</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T10:40:33" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T10:38:03" />
