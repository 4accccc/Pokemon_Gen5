	</TextRow>
	<TextRow
		Label="msg_t07r0201_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここで　うまれて　ここで　しぬ▼
ヤマジは　いなかまち　だが
よそを　しらんから　きにならんよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T10:46:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T11:19:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここで　生まれて　ここで　死ぬ▼
ヤマジは　田舎町だが
他所を　知らんから　気にならんよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T10:47:13" />
			<Status>Editing</Status>
