<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c08r0302_man2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……ここだけの　はなし▼
オレ　むかし
プラズマだんに　いたんだ▼
だけどな　めいれい　されたことを
なにも　かんがえずに　やるだけなら▼
オレが　やらなくても　いいよなって
プラズマだんを　ぬけたのさ▼
この　はなしは　はんたいがわに　いる
アイツには　ないしょ　だぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T02:26:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……ここだけの　話▼
オレ　昔
プラズマ団に　いたんだ▼
だけどな　命令されたことを
なにも　考えずに　やるだけなら▼
オレが　やらなくても　いいよなって
プラズマ団を　抜けたのさ▼
この話は　反対側に　いる
アイツには　内緒だぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T02:26:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T08:28:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN2
青年２</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T11:47:36" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c08r0302_man2a_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……ここだけの　はなし▼
オレは　トレーナーとして
よわっちいからさ▼
トレーナーから　ポケモンを
うばっていた　プラズマだんに▽
けっこう　さんせい　なんだ▼
……とられた　ひとには
ちょっと　わるいけどさ▼
この　はなしは　はんたいがわに　いる
アイツには　ないしょ　だぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T08:26:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……ここだけの　話▼
オレは　トレーナーとして
弱っちいからさ▼
トレーナーから　ポケモンを
奪っていた　プラズマ団に▽
けっこう　賛成なんだ▼
……とられた　人には
ちょっと　悪いけどさ▼
この話は　反対側に　いる
アイツには　内緒だぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T02:26:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-11T08:28:06" />
		</CommentCell>
