	<TextRow
		Label="msg_r23_boss_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　２３ばんどうろ　から
つらなる　チャンピオンロード▽
そのさきに　ポケモンリーグが　ある</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T05:48:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-13T11:14:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>no data</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-13T11:14:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-13T11:14:31" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-02T05:48:33" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>Ｎ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-13T11:14:18" />
		</AttributeCell>
		<ExtraCell
