				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c04r0601_rally_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ライモンラリーの
ルールは　かんたん！▼
きめられた　ポイントを　めぐり
ピエロに　はなしかけるだけ！▽
やるも　やらぬも　じゆう　なのです！▼
ラリーの　ポイントは
ギアステーション▽
ミュージカルホールに▽
ビッグスタジアムに　リトルコート▽
それに　かんらんしゃ　です！▼
では　プレゼントした
じてんしゃに　のって　レッツゴー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ライモンラリーの
ルールは　簡単！▼
決められた　ポイントを　巡り
ピエロに　話しかけるだけ！▽
やるも　やらぬも　自由なのです！▼
ラリーの　ポイントは
ギアステーション▽
ミュージカルホールに▽
ビッグスタジアムに　リトルコート▽
それに　観覧車　です！▼
では　プレゼントした
じてんしゃに　乗って　レッツゴー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T07:27:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CLOWN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c04r0601_rally_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やるも　やらぬも　じゆうの
ライモンラリー！　あなたが▽
まだ　おとずれて　いないのは……▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
