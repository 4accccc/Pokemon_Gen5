	<TextRow
		Label="msg_c04r0601_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ライモンシティに　くわしいのは
でんこうけいじばんの　おかげ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-25T08:10:35" />
			<Status>Editing</Status>
