<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c04r0601_rally_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ！　ライモンシティ！！
レッツ　トライ　ライモンラリー！！▼
あなた　ライモンに　いらしたのは
はじめて　ですよね？▼
よろしい！　では　この
じてんしゃを　どうぞ！！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ！　ライモンシティ！！
レッツ　トライ　ライモンラリー！！▼
あなた　ライモンに　いらしたのは
初めて　ですよね？▼
よろしい！　では　この
じてんしゃを　どうぞ！！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・初回
・アイテム入手前
・posで必須イベントに
・アイテム入手処理
　No450「じてんしゃ」
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T07:27:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CLOWN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
