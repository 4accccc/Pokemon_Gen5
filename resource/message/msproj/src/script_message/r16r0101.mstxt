<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r16r0101_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ええ……？　ちょっとおー
エレベータ　こしょう　かしら！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:32:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ええ……？　ちょっとおー
エレベータ　故障かしら！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T03:42:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・クリアまで
　エレベータ前で繰り返し
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:32:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r16r0101_woman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あの　エレベータ
こわれて　いたんじゃなくて▼
ロトムって　ポケモンが
いたずら　してたんですって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:39:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:39:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あの　エレベータ
壊れて　いたんじゃなくて▼
ロトムって　ポケモンが
いたずら　してたんですって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:39:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:39:33" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・クリア後
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T03:03:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:31:51" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r16r0101_ambrella_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつでも　どこでも　パラソル！
そなえあれば　うれいなし　ってこと！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T03:05:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつでも　どこでも　パラソル！
備えあれば　憂いなし　ってこと！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T03:05:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T03:03:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>AMBRELLA</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r16r0101_badman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すっ　すげえよ！▼
まじ　かんどう　したよ▼
いま　じどうはんばいき　で
もういっぽん　あたったんだ！！▼
ばくはつ　しそうな　きぶん　だから
おまえに　わけてやるよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-30T02:26:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すっ　すげえよ！▼
まじ　感動したよ▼
いま　自動販売機で
もう一本　当たったんだ！！▼
爆発しそうな　気分だから
おまえに　わけてやるよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-30T02:26:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手処理
　No030「おいしいみず」
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-23T03:03:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r16r0101_badman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ずっと　あたりつづけたら
おれ　おかねもちに　なれるな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:37:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:36:47" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ずっと　当たり続けたら
おれ　お金持ちに　なれるな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:37:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:37:06" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:36:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:32:57" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r16r0101_badman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すっ　すげえよ！▼
まじ　かんどう　したよ▼
バッグが　いっぱい　なのかよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:37:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:37:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すっ　すげえよ！▼
まじ　感動したよ▼
バッグが　一杯なのかよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:37:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:37:33" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・バッグが一杯
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T08:36:40" />
		</CommentCell>
