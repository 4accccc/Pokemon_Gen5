<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r16r0101_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ワタシは　ワタシ
アナタは　アナタ……▼
こういうこと　とつぜん　いわれると
こまっちゃうわよねえ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ワタシは　ワタシ
アナタは　アナタ……▼
こういうこと　突然　いわれると
困っちゃうわよねえ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ調整予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-30T08:19:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r16r0101_ambrella_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゲートの　なかで　パラソル！
だって　ぬれて　よごしたくないし</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゲートの　中で　パラソル！
だって　ぬれて　汚したくないし</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ調整予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-30T08:19:38" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>AMBRELLA</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
