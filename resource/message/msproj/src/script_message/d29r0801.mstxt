<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d29r0801_poke56_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こおりの　ちからを　かんじさせる
ポケモンの　ぞうが　うごきだした！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:52:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>氷の　力を　感じさせる
ポケモンの　像が　動きだした！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:52:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・続けて</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・レジアイス</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0801_poke56_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃきー！！</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じゃきー！！</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・あわせて鳴き声再生
・続けて戦闘に</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・レジアイス</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0801_poke56_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レジアイスは　いせきの
おくふかくへ　きえてしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:52:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レジアイスは　遺跡の
奥深くへ　消えてしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T10:52:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・捕獲以外で戦闘終了した場合
・マップ再読み込み時に復帰</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:08:54" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・レジアイス</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00289"
				Time="2011-11-16T11:07:59" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d29r0801_monument_01"
		Style="Large">
