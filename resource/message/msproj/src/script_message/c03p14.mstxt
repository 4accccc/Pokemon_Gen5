				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p14_infomationw_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハロー！　この　ふねは
ユナイテッドタワー　いきです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T07:10:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T07:22:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハロー！　この船は
ユナイテッドタワー　行きです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T07:10:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T07:22:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・いけない状態</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-08T09:37:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-08T09:37:38" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p14_infomationw_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おひとりさま　ごあんない　でーす！
どうぞ　ふねに　おのりください！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お一人様　ご案内でーす！
どうぞ　ご乗船ください！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・はい選択時
・メッセージの後に道をあけて
　主人公が船に乗り込む</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p14_infomationw_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ユナイテッドタワーは
せかいじゅうから　トレーナーが▽
あつまってくる　ばしょ　です！▼
もし　おきゃくさまに
とおく　はなれた　ばしょで　くらす▽
おともだちが　いらっしゃれば▼
かんどうの　さいかいなど
はたせるのでは　ないでしょうか！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ユナイテッドタワーは
世界中から　トレーナーが▽
集まってくる　施設です！▼
もし　お客様に
遠く離れた　場所で　暮らす▽
お友達が　いらっしゃれば▼
感動の　再会など
果たせるのでは　ないでしょうか！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・なにそれ？選択時
・この後0001に戻る</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p14_infomationw_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>またの　おこしを　おまちしてますね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>またの　お越しを　お待ちしてますね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
