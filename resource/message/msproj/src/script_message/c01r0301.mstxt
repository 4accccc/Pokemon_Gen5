<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c01r0301_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーの　つよさは　もっている
ジムバッジの　かずで　わかるんだよ！▼
あなたも　トレーナーなら
ジムリーダーに　ちょうせんして▽
どんどん　バッジを　あつめなさいな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーの　強さは　持っている
ジムバッジの　数で　わかるんだよ！▼
あなたも　トレーナーなら
ジムリーダーに　挑戦して▽
どんどん　バッジを　集めなさいな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ変更予定</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:45:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN2
太ったおばさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01r0301_boy2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ずっとずっと　おきにいりの
モデルが　いるんだ▼
カミツレさん　っていうんだけど
ポケモンも　つよいんだぜ！▼
へっ？　たたかったこと　あるんだ？
きみって　すごい　やつなんだな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ずっとずっと　お気に入りの
モデルが　いるんだ▼
カミツレさん　っていうんだけど
ポケモンも　強いんだぜ！▼
へっ？　戦ったこと　あるんだ？
きみって　すごい　やつなんだな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ変更</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T11:45:23" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY2
少年（活発）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
