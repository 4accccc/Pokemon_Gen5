<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c01r0301_middlewoman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まあ　ジムバッジを　８こも！
あなた　おつよいんですわね！▼
ただ　ジムバッジ　８こどうしの
トレーナーが　たたかったとき▼
なにが　しょうぶの　わかれめと
なるのかしらね？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T03:41:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まあ　ジムバッジを　８個も！
あなた　お強いんですわね！▼
ただ　ジムバッジ　８個同士の
ポケモントレーナーが　戦ったとき▼
なにが　勝負の　分かれ目と
なるのかしらね？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T03:42:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T03:42:02" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN2
太ったおばさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01r0301_boy2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ずっとずっと　おきにいりの
モデルが　いるんだ▼
カミツレさん　っていうんだけど
ポケモンも　つよいんだぜ！▼
へっ？　たたかったこと　あるんだ？
きみって　すごい　やつなんだな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ずっとずっと　お気に入りの
モデルが　いるんだ▼
カミツレさん　っていうんだけど
ポケモンも　強いんだぜ！▼
へっ？　戦ったこと　あるんだ？
きみって　すごい　やつなんだな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T03:38:38" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY2
少年（活発）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
