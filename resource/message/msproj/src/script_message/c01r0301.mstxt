				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c01r0301_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンセンターの　２かい　から
せかいに　つながる　ＧＴＳ！！▼
ＧＴＳの　せいしきな　なまえは
グローバル　トレード　ステーション！▼
ホドモエに　できた
ポケモン　ワールド　トーナメント！▽
ちぢめて　いうと　ＰＷＴ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T07:54:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンセンターの　２階から
世界に　つながる　ＧＴＳ！！▼
ＧＴＳの　正式名称は
グローバル　トレード　ステーション！▼
ホドモエに　できた
ポケモン　ワールド　トーナメント！▽
縮めて　いうと　ＰＷＴ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T07:54:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T03:44:15" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN1
青年</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01r0301_mission_add_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねえねえ
あたしと　じゃんけん　しよ！▼
あたしね　じゃんけん　つよいの！
おともだち　ぜんいんに　かったのー▽
じゅんびは　いいよね？▼
じゃーんけーん……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T03:57:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T03:57:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねえねえ
あたしと　じゃんけん　しよ！▼
あたしね　じゃんけん　つよいの！
おともだち　ぜんいんに　かったのー▽
じゅんびは　いいよね？▼
じゃーんけーん……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T03:57:49" />
