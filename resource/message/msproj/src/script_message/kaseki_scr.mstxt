				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_kaseki_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わかりました！▼
その　[Name:Item Idx="0" ]を
ポケモンに　もどしますね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:29:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わかりました！▼
その　[Name:Item Idx="0" ]を
ポケモンに　戻しますね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-05T06:29:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：化石の復元
・化石２個以上ではい選択したとき
　アイテムリストから選んだ化石を削除</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>助手♀＝化石の復元</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
