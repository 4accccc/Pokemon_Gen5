				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_kaseki_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いま　カセキを
ポケモンに　ふくげん　しています！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
