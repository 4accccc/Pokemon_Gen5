			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c12_white_22"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おんがえしを　おぼえた　ポケモンは
トレーナーに　なつくほどに▽
わざの　いりょくが　アップするんだよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
