			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c12_white_32"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベル『ねえねえ▼
ふたりとも　ポケモンが　いるんでしょ
