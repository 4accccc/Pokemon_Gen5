			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12_middleman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとは　たびをして　おとなになる……
わたしも　このまちを　でようかなあ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T04:32:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-20T08:41:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人は　旅をして　大人になる……
わたしも　この街を　でようかなあ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T04:32:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-20T08:41:48" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX＝59、GRIDZ＝736辺り</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-20T08:31:33" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-20T08:39:13" />
		</AttributeCell>
