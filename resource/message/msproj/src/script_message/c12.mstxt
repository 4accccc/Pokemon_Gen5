	<TextRow
		Label="msg_c12_white_16"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さて！　しょうぶを　して
きずついた　ポケモンのため▼
ポケモンセンターに　いって
げんきに　してあげようよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-20T07:51:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
