	<TextRow
		Label="msg_c12_white_16"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さて！　しょうぶを　して
きずついた　ポケモンのため▽
ポケモンセンターに　いって▽
げんきに　してあげようよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さて！　勝負を　して
きずついた　ポケモンのため▽
ポケモンセンターに　行って▽
元気に　してあげようよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
