	<TextRow
		Label="msg_c12_bigman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かがくの　ちからって　すげー！▼
いまなら　せきがいせんで
あんなことや　こんなことが▽
あっ！　というまに　できるってよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>科学の　力って　すげー！▼
今なら　赤外線で
あんなことや　こんなことが▽
あっ！　というまに　できるってよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
