			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12_middleman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼうけんの　たび……　それは
おとなに　なるための　みちだね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T03:23:15" />
