	<TextRow
		Label="msg_c12_boy2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレ　ポケモンのこと　くわしいよ！▼
だって　トレーナーズスクールで
いろいろ　おしえてもらったもん！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレ　ポケモンのこと　詳しいよ！▼
だって　トレーナーズスクールで
いろいろ　教えてもらったもん！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
