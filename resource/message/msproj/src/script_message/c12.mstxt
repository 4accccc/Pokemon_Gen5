				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c12_white_31"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そ　そんなあ……▼
