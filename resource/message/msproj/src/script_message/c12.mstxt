		<AttributeCell
			Name="Character">
			<Text>OLDMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
