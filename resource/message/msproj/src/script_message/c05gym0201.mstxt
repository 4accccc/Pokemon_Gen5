	<TextRow
		Label="msg_c03r0501_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ　いらっしゃいませ！
ホドモエ　ポケモンジムへ！▼
こちらの　ジムは　リフトで
いどう　してくださいませ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ　いらっしゃいませ！
ホドモエ　ポケモンジムへ！▼
こちらの　ジムは　リフトで
移動してくださいませ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・GRIDX=4、GRIDZ=13、右向き</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFOMATIONW
受付</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
