	<TextRow
		Label="msg_c05gym0201_swleader5_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヤーコン「いい　ステージには
いい　ダンサーが　たいせつ　なんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:05:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T05:59:52" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヤーコン「いい　ステージには
いい　ダンサーが　肝要なんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:05:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T05:59:52" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ジムバッジ取得後
・リフトから降りるとメッセージ表示
　表示後、ジムの外に出る</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:00:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER5
ジムリーダー・ヤーコン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T05:48:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03r0501_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ　いらっしゃいませ！
ホドモエ　ポケモンジムへ！▼
こちらの　ジムは　リフトで
いどう　してくださいませ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ　いらっしゃいませ！
ホドモエ　ポケモンジムへ！▼
こちらの　ジムは　リフトで
移動してくださいませ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・GRIDX=4、GRIDZ=13、右向き</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFOMATIONW
受付</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
