				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d24r0901_swbell_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ！　あんしん　して▼
ポケモンの　かいふくは
あたしが　するからね！▼
ということで　しゅっぱつ　しんこう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T12:56:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T08:38:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あ！　安心して▼
ポケモンの　回復は
あたしが　するからね！▼
ということで　出発進行！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T12:56:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T08:38:33" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：White2ver
・！マーク表示後、このメッセージ表示
・連れ歩き開始</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T08:18:40" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T08:38:33" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
