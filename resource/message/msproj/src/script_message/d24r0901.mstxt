	<TextRow
		Label="msg_d24r0901_swbell_14"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ！　あたしは　もうちょっと
しらべたいんだけど　どうする？▽
いちど　ここで　わかれちゃう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T10:20:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-19T08:38:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ！　あたしは　もうちょっと
調査したいんだけど　どうする？▽
一度　ここで　別れちゃう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T14:05:51" />
			<Status>Editing</Status>
