	<TextRow
		Label="msg_c03r1201_olidman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ううむ！　いい！　いいよ！
アーティの　えは　いい！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
