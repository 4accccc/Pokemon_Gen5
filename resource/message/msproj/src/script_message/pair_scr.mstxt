				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d24r0901_swbell_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたし……
トレーナーとしては　よわいんだけど▼
それでも　たびを　つづけられたのは
ポケモンが　がんばってくれたからなの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたし……
トレーナーとしては　弱いんだけど▼
それでも　旅を　続けられたのは
ポケモンが　がんばってくれたからなの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・White2ver
・振り向き会話その２</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d24r0901_swbell_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だれもが　かちつづけられる　とか
そんなのは　むずかしいよ……▼
でもね　ポケモンを　すき！　なのは
いつでも　いつまでも　できるよねえ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>だれもが　勝ち続けられる　とか
そんなのは　難しいよ……▼
でもね　ポケモンを　好き！　なのは
いつでも　いつまでも　できるよねえ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・White2ver
・振り向き会話その３</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d24r0901_swbell_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すきな　ポケモンたちの　ことを
もっともっと　しりたい……！▼
それが　アララギはかせの　もとで
おてつだいを　はじめた　りゆうかな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>好きな　ポケモンたちの　ことを
もっともっと　知りたい……！▼
それが　アララギ博士の　もとで
お手伝いを　始めた　理由かな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・White2ver
・振り向き会話その４</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d24r0901_swbell_11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はかせの　おてつだいが
ほんとうに　やりたいことなのか……▼
じつは　まだ　わからないけど
やっていて　すごく　たのしいの！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>博士の　お手伝いが
本当に　やりたいことなのか……▼
じつは　まだ　わからないけど
やっていて　すごく　楽しいの！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-19T04:43:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
