	<TextRow
		Label="msg_c05_badrider_02w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……まいったぜ！　あいての
きをひくのは　ほんと　むずかしいな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
