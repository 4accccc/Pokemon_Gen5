	</TextRow>
	<TextRow
		Label="msg_c05_rangerw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うみの　むこうにも
いろんな　ひとや▽
いろんな　ポケモンが　いるのよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海の　向こうにも
いろんな　人や▽
いろんな　ポケモンが　いるのよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
