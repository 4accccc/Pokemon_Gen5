				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c05_badrider_02w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……まいったぜ！　あいての
きをひくのは　ほんと　むずかしいな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……まいったぜ！　相手の
気をひくのは　ほんと　難しいな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・WHITEver
・いいえ選択時
　再度会話はbadrider_01から</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADRIDER</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c05_badrider_03w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トリプルバトルとは
ポケモンを　３びきずつ　だして▽
たたかう　ポケモンしょうぶ　さ！▼
ルールは　かんたん！▼
あいての　ポケモンを
すべて　ひんしに　するだけ……▼
ざっと　いじょうが
トリプルバトルの　あらましさ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トリプルバトルとは
ポケモンを　３匹ずつ　だして▽
戦う　ポケモン勝負　さ！▼
ルールは　簡単！▼
相手の　ポケモンを
すべて　ひんしに　するだけ……▼
ざっと　以上が
トリプルバトルの　あらましさ▼</Text>
			<TextModifiedBy
