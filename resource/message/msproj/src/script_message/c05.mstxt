				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここに　いるのは
もとプラズマだんの　れんちゅう▼
また　わるさを　しないか
しんぱい　なんでな……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T11:18:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここに　いるのは
元プラズマ団の　連中▼
また　悪さを　しないか
心配なんでな……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T11:18:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=198、GRIDZ=399辺り
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T08:07:01" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTAIN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05_man2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はなれた　とちを　つなぐ　はし▼
べつべつの　ひとを　つなぐ
ポケモンしょうぶに　ポケモンこうかん▼
ということは　ポケモンは　はし　か！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T09:19:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>離れた　土地を　つなぐ　橋▼
別々の　人を　つなぐ
ポケモン勝負に　ポケモン交換▼
ということは　ポケモンは　橋か！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T11:35:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T09:34:48" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05_badrider_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレは……　こいする　おとこ
そのなも　チャールズ▼
ほれた　おんなの　きをひきたくて
あたらしい　スタイルの▽
ポケモンしょうぶを　まなんだのさ▼
そのなも　ローテーションバトル！
どんな　しょうぶか　しりたいか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T09:34:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレは……　恋する男
その名も　チャールズ▼
ほれた　女の　気をひきたくて
新しい　スタイルの▽
ポケモン勝負を　学んだのさ▼
その名も　ローテーションバトル！
どんな　勝負か　知りたいか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T09:34:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：White2ver
・ローテーションバトルチュートリアル
・はい/いいえ選択時
　はい→badrider_02
　いいえ→badrider_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T09:34:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADRIDER</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
