	<TextRow
		Label="msg_c05_businessman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジムリーダーの　ヤーコンさまですが
ただいま　とりこみちゅう　でして▽
また　のちほど　いらしてください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジムリーダーの　ヤーコン様ですが
ただいま　取り込み中　でして▽
また　のちほど　いらしてください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
