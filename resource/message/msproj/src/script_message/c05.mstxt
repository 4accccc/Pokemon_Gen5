				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c05_badrider_04w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレは……　こいする　おとこ
そのなも　チャールズ▼
どうだ！　おまえも　トレーナーなら
やらないか　ローテーションバトルを？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T09:34:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレは……　恋する男
その名も　チャールズ▼
どうだ！　おまえも　トレーナーなら
やらないか　ローテーションバトルを？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T09:34:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：White2ver
・はい/いいえ選択肢表示
・はい→badrider_05
　はい、だけど戦闘可能ポケモン2匹以下→badrider_06
　いいえ→badrider_07</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T09:33:47" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADRIDER</Text>
