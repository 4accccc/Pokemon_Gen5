				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05_boy2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かみなりの　ポケモン
