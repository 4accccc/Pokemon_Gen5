	<TextRow
		Label="msg_c05_rangerw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うみのむこう……　せかいじゅうに
いろんな　ポケモンが　いるのよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T09:13:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海の向こう……　世界中に
いろんな　ポケモンが　いるのよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T09:13:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・GRIDX=171、GRIDZ=430辺り
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-10T09:34:45" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2
←RANGERW</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T09:39:32" />
		</AttributeCell>
