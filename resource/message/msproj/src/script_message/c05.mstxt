	<TextRow
		Label="msg_c05_mountain_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>６ばんどうろに　いる　ジイさんが
でんせつの　ポケモンを　さがしている▼
きになるなら　あうと　いい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
