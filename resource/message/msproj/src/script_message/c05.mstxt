	<TextRow
		Label="msg_c05_badrider_09w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレは……　こいする　おとこ
そのなも　チャールズ▼
バイクにのって　かぜになるのが
にあう　ツミな　おとこさ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
