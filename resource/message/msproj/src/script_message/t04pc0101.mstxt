	<TextRow
		Label="msg_t04pc0101_middleman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きれいなウロコ　きれいでしょ！
ポケモンに　もたせると　いいかもね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
