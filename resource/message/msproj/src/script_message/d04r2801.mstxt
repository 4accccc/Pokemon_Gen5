		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンは　しずかに　とびさり
すがたを　けした……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-11T12:29:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
