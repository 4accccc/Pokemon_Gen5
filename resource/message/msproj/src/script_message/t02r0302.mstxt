				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t02r0302_middleman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>モンスターボールが　ないと
ポケモンは　つかまえられない！▼
いろんな　モンスターボールがあるから
うまく　つかいわけなさいよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:32:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>モンスターボールが　ないと
ポケモンは　捕まえられない！▼
いろんな　モンスターボールがあるから
うまく　使い分けなさいよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-14T08:32:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アイテム入手後</Comment>
