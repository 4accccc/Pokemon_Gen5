	<TextRow
		Label="msg_symbolmap_poke_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PokemonName Idx="0"]は
いきいきと　うごきまわっている！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
