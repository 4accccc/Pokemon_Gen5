	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r20_girl1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おたがいの　めと　めが　あったら
はじまる　ポケモンしょうぶ！▽
それが　トレーナーの　きまりなの</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お互いの　視線が　あったら
始まる　ポケモン勝負！▽
それが　トレーナーの　決まりなの</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・t06近く</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r20_mountman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おいおい！　ジムバッジの
ひとつも　もっていない　こどもが▽
このさきに　すすむのか！？▼
あたりの　トレーナーや　ポケモンと
たたかいまくって　きたえろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:20:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おいおい！　ジムバッジの
ひとつも　持っていない　こどもが▽
この先に　進むのか！？▼
辺りの　トレーナーや　ポケモンと
戦いまくって　鍛えろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:20:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX＝159、GRIDZ＝645、左向き
・c12ジムバッジ入手までストッパー処理
・話しかけ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T12:56:22" />
		</CommentCell>
		<AttributeCell
