	<TextRow
		Label="msg_r20_swleader1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『ふたりとも　みて！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-13T12:42:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
