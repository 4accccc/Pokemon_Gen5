				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r20_swleader1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみたちが　つぎに　いどむなら
タチワキジム　だね▽
じゃあ　これを！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T12:43:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-13T12:42:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみたちが　次に　挑むなら
タチワキジム　だね▽
じゃあ　これを！▼</Text>
