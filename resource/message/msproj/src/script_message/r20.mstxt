	<TextRow
		Label="msg_r20_white_15"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃあ　いっぱい　いっぱい
ポケモンと　であってねえ！▼
あたしは　あなたのママと
おはなしを　してまーす！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T09:38:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じゃあ　いっぱい　いっぱい
ポケモンと　出会ってねえ！▼
あたしは　あなたのママと
お話を　してまーす！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-28T09:39:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
