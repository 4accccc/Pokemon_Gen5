	<TextRow
		Label="msg_r20_mountman_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえたちには　まいった！▼
たのもしい　ポケモンが　いてくれれば
こどもでも　おとなに▽
みおとり　しないんだな！　うむ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:21:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえたちには　参った！▼
頼もしい　ポケモンが　いてくれれば
こどもでも　大人に▽
見劣り　しないんだな！　うむ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T07:27:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
