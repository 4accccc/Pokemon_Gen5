	<TextRow
		Label="msg_r20_mountman_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえたちには　まいった！▼
ポケモンが　いてくれれば　こどもでも
おとなに　みおとり　しないんだな！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえたちには　参った！▼
ポケモンが　いてくれれば　子供でも
大人に　見劣り　しないんだな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T11:21:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・戦闘後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
