	<TextRow
		Label="msg_r20_white_15"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃあ　いっぱい　いっぱい
ポケモンと　であってねえ！▼　
あたしは　あなたのママと
おはなしを　してまーす！！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
