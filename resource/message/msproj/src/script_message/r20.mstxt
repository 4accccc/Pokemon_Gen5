		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレン『二人とも
ぼくに　ついてきてよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T12:43:12" />
			<Status>Editing</Status>
