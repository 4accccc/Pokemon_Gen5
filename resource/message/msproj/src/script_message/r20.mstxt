<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r20_girl1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おたがいの　めと　めが　あったら
はじまる　ポケモンしょうぶ！▽
それが　トレーナーの　きまりなの</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お互いの　視線が　あったら
始まる　ポケモン勝負！▽
それが　トレーナーの　決まりなの</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・t06近く</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r20_mountman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おいおい！　ジムバッジの
ひとつも　もっていない　くせに▽
このさきに　すすむのか！？▼
おいおい！　あたりの　トレーナーや
ポケモンと　たたかって　きたえろよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T05:49:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おいおい！　ジムバッジの
ひとつも　持っていない　くせに▽
この先に　進むのか！？▼
辺りの　トレーナーや　ポケモンと
戦いまくって　鍛えてみろ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・（local　31.5）に左向きで配置
・c12ジムバッジ入手までストッパー処理
・話しかけ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTMAN
山男
ID：mount_14</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T11:18:56" />
		</AttributeCell>
		<AttributeCell
