				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d10r0201_sage6_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ロット『ええい！　わからずやどもめ
わかるまで　なんどでも　いう！▼
ゲーチスが　もくろんで　いたのは
イッシュちほうの　しはい　なのだ！▼
ポケモンを　かいほう　するのは
たてまえ　でしか　なかった！▼
むしろ　ポケモンを
くるしめることに　なったのだぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T12:54:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T12:15:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ロット『ええい！　わからずやどもめ
わかるまで　何度でも　いう！▼
ゲーチスが　目論んでいたのは
イッシュ地方の　支配なのだ！▼
ポケモンを　解放するのは
建前　でしか　なかった！▼
むしろ　ポケモンを
苦しめることに　なったのだぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T12:54:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T12:15:57" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてswplazmam1_01</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T12:43:05" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SAGE6
元プラズマ団・七賢人ロット</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T12:15:57" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
