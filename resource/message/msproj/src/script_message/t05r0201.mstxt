	<TextRow
		Label="msg_t05r0201_middleman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゅうまつの　カナワタウンは
ひとで　あふれかえる！▽
みんな　でんしゃが　だいすきだね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-25T06:39:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>週末の　カナワタウンは
人で　あふれかえる！▽
みんな　電車が　大好きだね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-25T06:39:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T07:39:47" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
