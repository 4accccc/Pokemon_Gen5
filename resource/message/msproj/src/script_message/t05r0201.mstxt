<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t05r0201_middleman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゅうまつの　カノコタウンは
ひとで　あふれかえる！▽
みんな　でんしゃが　だいすきだね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T07:40:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>週末の　カノコタウンは
人で　あふれかえる！▽
みんな　電車が　大好きだね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T07:40:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T07:39:47" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t05r0201_oldwoman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どにちに　なるとな
[Name:Item Idx="0" ]を　あつめている▽
ひとが　やってきてな▽
べつの　どうぐと　とりかえてくれるぞ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T07:45:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>土日に　なるとな
[Name:Item Idx="0" ]を　集めている▽
人が　やってきてな▽
別の　道具と　取替えてくれるぞ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T07:46:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・0＝道具名
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T07:41:36" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDWOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_t05r0201_babyboy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくは　いつか　サブウェイマスターの
ノボリ　クダリを　ぶっとばすんだ！</Text>
