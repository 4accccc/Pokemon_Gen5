				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c14r0201_01_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だめなら　しかたないな……▼
でも　きが　かわったら
ポケモン　こうかん　しようね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T05:29:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T05:29:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>だめなら　しかたないな……▼
でも　気が　変わったら
ポケモン交換　しようね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T05:29:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T05:29:59" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・いいえ選択
　もしくはポケモン選択画面で「やめる」を選択</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T05:29:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>？？？</Text>
			<TextModifiedBy
