	<TextRow
		Label="msg_c14r0201_badman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やるじゃん！
じゃ　レッツ　ポケモントレード！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T05:54:42" />
