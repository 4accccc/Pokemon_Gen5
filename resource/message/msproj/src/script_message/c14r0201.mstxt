				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c14r0201_01_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　おかげで
あたしと　あなた▽
おともだちに　なれたよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-06T05:29:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
