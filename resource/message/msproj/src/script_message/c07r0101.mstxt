				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c07r0101_girl1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あのねあのね！　ハチクさん
また　かつての　ように▽
スクリーンで　だいかつやく　だよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:26:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あのねあのね！　ハチクさん
また　かつての　ように▽
スクリーンで　大活躍だよ！</Text>
