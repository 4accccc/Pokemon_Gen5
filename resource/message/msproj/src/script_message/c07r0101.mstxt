<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c07r0101_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>りそうと　しんじつが　まじりあい
できたとされる　リュウラセンのとう……▼
すうせんねんも　むかしより　あそこに
そびえ　わしらを　みまもっておる……▼
ふむ　ドラゴンポケモンが　めざめたから
ほんとうの　はなし　なんだろうな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T07:07:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>理想と　真実が　交じり合い
できたとされる　リュウラセンの塔……▼
数千年も　昔より　あそこに
そびえ　わしらを　見守っておる……▼
ふむ　ドラゴンポケモンが　めざめたから
本当の　話なんだろうな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T07:07:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T07:06:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c07r0101_girl1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あのねあのね！　ハチクさん
また　かつての　ように▽
スクリーンで　だいかつやく　だよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:26:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あのねあのね！　ハチクさん
また　かつての　ように▽
スクリーンで　大活躍だよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-24T03:26:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T07:04:35" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL1</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T07:04:25" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
