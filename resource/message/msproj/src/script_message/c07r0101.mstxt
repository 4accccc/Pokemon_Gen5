<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c07r0101_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レシラムも　ゼクロムも……
すうせんねんも　いきて▼
なんにんもの　えいゆうに　であって
ちえを　さずけたはず……▼
なのに　しんじつは　なぞのまま……
りそうの　せかいも　できていない▼
それでも　えいゆうを……
ひとを　しんじているのは　かなしいな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T07:51:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レシラムも　ゼクロムも……
数千年も　いきて▼
何人もの　英雄に　出会って
英知を　授けたはず……▼
なのに　真実は　なぞのまま……
理想の　世界も　できていない▼
それでも　英雄を……
人を　信じているのは　愚かだな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T07:51:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T07:06:09" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>OLDMAN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T02:55:06" />
