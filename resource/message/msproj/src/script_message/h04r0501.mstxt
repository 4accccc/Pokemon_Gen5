	<TextRow
		Label="msg_h04r0501_man2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここに　いた　ミネズミたちと
おねえさん　どこに　いったのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T06:06:57" />
			<Status>Editing</Status>
