	<TextRow
		Label="msg_h04r0501_man2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねえねえ　この　いえ
ふんいき　よくない？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねえねえ　この家
雰囲気　良くない？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ミネズミイベント後から発生
・パターンその1</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_h04r0501_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんだか　へやじゅう　から
ミネズミの　におい　しない？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんだか　部屋中から
ミネズミの　臭い　しない？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・パターンその1(セットで登場）</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_h04r0501_man2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はしの　うえって　すごくない？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>橋の　上って　すごくない？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・パターンその２</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_h04r0501_woman3_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ううん……▼
そとで　うたってる　おやじが
きに　なっちゃうけど……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ううん……▼
外で　歌ってる　おやじが
気に　なっちゃうけど……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・パターンその２(セットで登場）</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_h04r0501_man2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここだったら　いますぐにでも
ひっこし　できるよ！？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここだったら　今すぐにでも
引越し　できるよ！？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・パターンその３</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN2</Text>
			<TextModifiedBy
