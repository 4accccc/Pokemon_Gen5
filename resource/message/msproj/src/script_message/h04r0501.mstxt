	<TextRow
		Label="msg_h04r0501_woman3_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みんなの　なまえ　おぼえちゃった！▼
タンボさん　ソンさんに
ガッチーさん　れいぞうさん</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T05:51:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みんなの　名前　覚えちゃった！▼
タンボさん　ソンさんに
ガッチーさん　れいぞうさん</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T05:51:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・パターンその２(セットで登場）
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T05:45:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2</Text>
			<TextModifiedBy
