	<TextRow
		Label="msg_h04r0501_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テレビの　ミルホッくんを　みると
あの　ミネズミたちを　おもいだすわね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T06:11:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テレビの　ミルホッくんを　みると
あの　ミネズミたちを　思い出すわね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T06:11:43" />
			<Status>Editing</Status>
