				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_h04r0501_woman3_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうね……　サザナミの　べっそうも
いつ　できるか　わからないもんね……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T06:04:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そうね……　サザナミの　別荘も
いつ　できるか　わからないもんね……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T06:05:00" />
