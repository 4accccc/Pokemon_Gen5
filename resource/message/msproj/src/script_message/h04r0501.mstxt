<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_h04r0501_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……しんてんちを　めざすのです！
あたしと　ミネズミなら　できます！▼
あたしたちを　そだててくれた
ビレッジブリッジ……▽
ありがとう……　そして　サヨウナラ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……新天地を　目指すのです！
あたしと　ミネズミなら　できます！▼
あたしたちを　育ててくれた
ビレッジブリッジ……▽
ありがとう……　そして　サヨウナラ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・メッセージ後、退場</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_h04r0501_poke17_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミチャルー！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミチャルー！！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・鳴き声SE</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
