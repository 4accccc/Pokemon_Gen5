			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_h04r0501_man2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうする？　２ねんかん　ずっと
まよっているけど　ここに　きめない？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T06:04:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どうする？　２年間　ずっと
迷っているけど　ここに　決めない？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T06:04:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・パターンその３
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-19T06:11:24" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
