	<TextRow
		Label="msg_w21_swrival_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ライバル『アンタ　プラズマだんと
たたかう　つもりは　ないんじゃ……？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:12:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ライバル『アンタ　プラズマだんと
たたかう　つもりは　ないんじゃ……？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:12:47" />
