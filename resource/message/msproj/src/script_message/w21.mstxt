<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_w21_swleader1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『あの　ふねで
いけそうな　ばしょを　さがしている▼
だけど　いまの　ところ
みつかっていないし　てがかり　なしさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-07T03:21:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:32:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレン『あの　船で
行けそうな　場所を　探している▼
だけど　いまの　ところ
みつかっていないし　手掛かりなしさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-07T03:22:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:32:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・c14ジムバッジ取得前
・GRIDX＝、GRIDZ＝
・1＝ライバル名</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-07T03:21:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:31:58" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swrival_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『チェレンさん
ようすは　どうですか？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:31:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『チェレンさん
様子は　どうですか？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:39:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・c14ジムバッジ取得後
・posイベント
　GRIDX＝、GRIDZ＝
・続けてswleader1_02
・1＝ライバル名</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:40:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:04" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『なにも　うごきは　ないね▼
もっとも　こちらにも
かんぱんに　あがったり　なかに▽
しのびこむ　すべが　ないけどね▼
だからこそ　かれらも
わざと　ここに　いるんだろうけど……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:41:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレン『なにも　動きは　ないね▼
もっとも　こちらにも
甲板に　あがったり▽
船内に　忍びこむ　術が　ないけどね▼
だからこそ　かれらも
わざと　ここに　いるんだろうけど……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:41:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてswleader8_01</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:40:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader8_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『ちょっと　まっとき！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T08:54:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>？？？『ちょっと　待っとき！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T08:54:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・アジト船のほうからメッセージ表示
・表示後、アジト船のタラップが降りる
・続けてシズイがタラップを降りてくる</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:41:39" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER8
ジムリーダー・シズイ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:33:15" />
		</AttributeCell>
		<ExtraCell
