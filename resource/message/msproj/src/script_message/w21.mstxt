	<TextRow
		Label="msg_w21_swleader1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『たすかりました！
ありがとう　ございます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:26:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:21:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレン『たすかりました！
ありがとう　ございます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:26:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
