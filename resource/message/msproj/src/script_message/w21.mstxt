			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader8_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さわいで　しまったから
なんにんか　でてきたけどな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T09:58:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:11:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>騒いで　しまったから
何人か　でてきたけどな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-04T09:58:54" />
			<Status>Editing</Status>
