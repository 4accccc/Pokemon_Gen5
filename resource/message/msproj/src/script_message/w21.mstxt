			<CellData>#0080c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader8_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シズイ『これで　だいじょうぶ　たい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T08:55:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T08:54:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シズイ『これで　大丈夫たい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:41:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T08:54:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・降りて所定の位置（未定）に
　到達するとメッセージ表示
・続けてswrival_02</Comment>
			<CommentModifiedBy
