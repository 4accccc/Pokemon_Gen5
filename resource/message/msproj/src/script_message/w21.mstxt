				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swrival_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="1" ]『アンタ　プラズマだんと
たたかう　つもりは　ないんじゃ……？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:48:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="1" ]『アンタ　プラズマ団と
戦う　つもりは　ないんじゃ……？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:48:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてswleader8_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:42:24" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWRIVAL
ライバル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T08:55:26" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader8_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シズイ『おうともよ！
おいは　プラズマだんに　うらみはない▼
ほんまに　わるいことを
しているのかも　しらん▼
みんなが　あいつらは　わるい……！
そう　いってるからって▽
なんにも　かんがえず▼
プラズマだんは　わるいと　きめるのは
おいの　りゅうぎ　ではない！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:13:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シズイ『おうともよ！
おいは　プラズマ団に　うらみはない▼
ほんまに　悪いことを
しているのかも　知らん▼
みんなが　あいつらは　悪い……！
そう　いってるからって▽
なんにも　考えず▼
プラズマだんは　悪いと　決めるのは
おいの　流儀ではない！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:53:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:19:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・画面下を向いてメッセージ表示
・続けてswleader8_04</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:42:45" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER8
ジムリーダー・シズイ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T08:56:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#0080c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader8_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でも　おまはんらが　こまっとる
それなら　たすけてやらねば　ならん▽
これが　おいの　やりたいことじゃ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:11:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:07:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>でも　おまはんらが　困っとる
それなら　助けてやらねば　ならん▽
これが　おいの　やりたいことじゃ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:53:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:08:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・主人公たちの方を向いてメッセージ表示
・続けてswleader1_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:43:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER8
ジムリーダー・シズイ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:08:46" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#0080c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレン『たすかりました！
ありがとう　ございます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:26:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:21:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレン『助かりました！
ありがとう　ございます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:53:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:21:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてswleader8_05</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:43:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:21:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader8_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シズイ『ええか
おはんら　しんねんを　もてよ！▼
うばわれた　ポケモンを
さがすのでも　いい！▼
イッシュを　こおりづけ　から
まもる　ためでも　いい！▼
りゆうは　なんでも　いい
じぶんは　なぜ　そうするのか？▼
しんねんの　つよさが　ポケモンと
じぶんに　ちからを　くれるたい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:24:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:08:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シズイ『ええか
おはんら　信念を　持てよ！▼
奪われた　ポケモンを
探すのでも　いい！▼
イッシュを　氷漬け　から
守る　ためでも　いい！▼
理由は　なんでも　いい
自分は　なぜ　そうするのか？▼
信念の　強さが　ポケモンと
自分に　力を　くれるたい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:54:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:08:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・続けてswleader8_06</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:43:20" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER8
ジムリーダー・シズイ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:08:46" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#0080c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader8_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うえで　さわいで　しまったから
みんな　まちかまえて　いるたい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:47:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:11:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>上で　騒いでしまったから
みんな　待ち構えて　いるたい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:47:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:11:40" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・再度、アジト船を向いてメッセージ表示
・続けてswleader8_07</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:50:42" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER8
ジムリーダー・シズイ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:11:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#0080c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w21_swleader8_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほな　きをつけて　いけよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:47:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T09:47:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほな　気をつけて　いけよ！▼</Text>
