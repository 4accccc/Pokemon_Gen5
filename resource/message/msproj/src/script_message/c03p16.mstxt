	<TextRow
		Label="msg_c03p16_cabinguide_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんじつの　しゅっこうは
しゅうりょう　いたしました[Ctrl2:LineFeed ]
また　あす　おこしくださいませ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
