				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c03p16_cabinguide_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まもなく　しゅっこうに　なります
いってらっしゃいませ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
