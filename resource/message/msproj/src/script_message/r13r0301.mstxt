			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T04:56:43" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r13r0301_pokemon_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うきゃーきゃきゃきゃきゃあ！！</Text>
