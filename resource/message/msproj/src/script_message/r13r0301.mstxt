<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r13r0301_badman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むかし　プラズマだんに
いわれたことが　むかつくからさ▼
モンスターボールなしで
ポケモンと　くらしてるのよ！▼
ヒヤップ……　ちっとも
おれの　いうこと　きかないけどさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T03:09:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T04:21:35" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昔　プラズマ団に
いわれたことが　むかつくからさ▼
モンスターボールなしで
ポケモンと　暮らしてるのよ！▼
ヒヤップ……　ちっとも
おれの　いうこと　きかないけどさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T03:09:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T04:16:37" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-05T07:51:28" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T04:22:25" />
		</AttributeCell>
