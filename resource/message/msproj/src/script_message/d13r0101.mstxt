	<TextRow
		Label="msg_d13r0101_assistm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんだ　こどもか……▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんだ　子供か……▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX=4、GRIDZ=3
・！マーク表示後、振り向いてからセリフ
・表示後、GRIDX=6、GRIDZ=3に移動
・同時に主人公も、GRIDX=6、GRIDZ=6に移動</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-21T11:59:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
