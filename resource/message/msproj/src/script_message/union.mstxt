	<TextRow
		Label="msg_union_info_01_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ユニオンルームへ　ようこそ▼
なにか　わからないことが　ありましたら
おもうしつけ　くださいませ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T09:06:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ユニオンルームへ　ようこそ▼
なにか　わからないことが　ありましたら
お申しつけ　くださいませ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T09:06:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>説明お姉さん：はじめのメッセージ（初回のみ）
・せつめい
・もどる</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:34:48" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_union_info_01_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにか　ごようけんは
ありますでしょうか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なにか　ごようけんは
ありますでしょうか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>説明お姉さん：はじめのメッセージ（２回目）
・せつめい
・もどる</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
