	<TextRow
		Label="msg_t04r0101_gentleman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ホッホッホ
ポケモン　しょうぶとは　なつかしい！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
