	<TextRow
		Label="msg_t04r0101_boy3_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オマエ　すごいじゃないか！
すこしだけ　みとめてやっても　いいぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
