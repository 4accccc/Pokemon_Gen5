	<TextRow
		Label="msg_t04r0101_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このさき　マリンチューブ　です
こうけいを　たのしんでくださいね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:40:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T02:52:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この先　マリンチューブ　です
光景を　楽しんでくださいね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:41:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T02:52:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-18T07:42:00" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW
受付嬢</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-04T02:52:39" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
