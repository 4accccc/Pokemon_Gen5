	</TextRow>
	<TextRow
		Label="msg_c02gym0101_man1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいかっこくの　めずらしいモノ……
はくぶつかんは　ロマンが　つまってる</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界各国の　珍しいモノ……
博物館は　ロマンの　集合体だね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
