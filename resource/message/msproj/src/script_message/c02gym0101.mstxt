			<Comment>♀</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T07:11:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>受付嬢その１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
