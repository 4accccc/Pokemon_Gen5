	<TextRow
		Label="msg_c02gym0101_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もしかすると　いんせきと　いっしょに
うちゅうから　やってきた▽
ポケモンも　いるかもしれんのう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
