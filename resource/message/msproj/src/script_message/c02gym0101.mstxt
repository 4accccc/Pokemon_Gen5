	</TextRow>
	<TextRow
		Label="msg_c02gym0101_counter2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンジムへは
はくぶつかんの　おくから　いけます！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンジムへは
博物館の　奥から　行けます！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・通常時
※swanでメッセージ調整</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T06:58:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>受付嬢その２</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
