				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02gym0101_ad_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こちらの　こっかく……
ドラゴンタイプの　ポケモンですね▼
おそらく　せかいかくちを
とびまわっている　うちに▽
なんらかの　じこにあって▽
そのまま　カセキに　なったようです▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こちらの　骨格……
ドラゴンタイプの　ポケモンですね▼
おそらく　世界各地を
飛び回っている　うちに▽
なんらかの　事故にあって▽
そのまま　カセキに　なったようです▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・骨格標本</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM
副館長（Assistant Director）</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T08:20:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
