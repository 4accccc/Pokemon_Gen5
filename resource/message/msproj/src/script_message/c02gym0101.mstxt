	<TextRow
		Label="msg_c02gym0101_plate_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まだ　かいどく　されていない
もじが　きざまれた　せきばん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
