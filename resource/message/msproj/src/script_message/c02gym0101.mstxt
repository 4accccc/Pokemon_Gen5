			<Comment>♂</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ASSISTANTM
副館長（Assistant Director）</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T08:20:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
