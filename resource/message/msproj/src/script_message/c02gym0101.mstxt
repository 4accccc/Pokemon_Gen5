				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02gym0101_ad_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>デオキシスという　ポケモンは
いんせきの　パワーを　あびて▽
すがたを　かえることが　わかりました▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T07:42:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>デオキシスという　ポケモンは
いん石の　パワーを　浴びて▽
姿を　変えることが　わかりました▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T05:41:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
