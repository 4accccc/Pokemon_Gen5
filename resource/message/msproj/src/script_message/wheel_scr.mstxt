	</TextRow>
	<TextRow
		Label="msg_wheel_summer_m_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうか　それも　いいだろう……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
