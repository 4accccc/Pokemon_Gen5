	<TextRow
		Label="msg_wheel_spring_f_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へへ　なんか　すごく　うれしいな！
ありがと！　[Name:TrainerName Idx="0" ]くん！▼
じゃあ　さっそく　だけど
ポケモンしょうぶ　しよっか！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
