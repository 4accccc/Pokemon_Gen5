	<TextRow
		Label="msg_wheel_spring_f_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フーン……
いい　どきょう　してんじゃん▼
こうかい　させてやるよ！！
ポケモンセンターでね！！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-14T08:40:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フーン……
いい　度胸してんじゃん▼
後悔　させてやるよ！！
ポケモンセンターでね！！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-14T08:16:43" />
