	<TextRow
		Label="msg_wheel_spring_f_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ダッセー！　アンタ　にげるんだ？
おとこのくせに　マジなさけないー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-07T09:50:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ダッセー！　アンタ　逃げるんだ？
男のくせに　マジ情けないー</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-07T09:50:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
