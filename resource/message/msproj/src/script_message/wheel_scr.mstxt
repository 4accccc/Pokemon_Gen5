<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_wheel_spring_f_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポカポカ　あったかい　ひが
つづいて　きもちいいなあ……▼
あ！　ねえねえ！　キミ！
ちょっと　じかん　あるかな？▼
よかったら　ちょっとの　あいだだけ
わたしに　じかん　もらえない？▼
あのね　わたしと　しょうぶして
ほしいんだけど！　イイかな？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポカポカ　あったかい　日が
続いて　きもちいいなあ……▼
あ！　ねえねえ！　キミ！
ちょっと　時間　あるかな？▼
よかったら　ちょっとの　あいだだけ
わたしに　時間　もらえない？▼
あのね　わたしと　勝負して
欲しいんだけど！　イイかな？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>春：主人公性別が♂
・はい/いいえ
　はい→spring_m_02
　いいえ→spring_m_03</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL2
ミニスカート</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</AttributeCell>
