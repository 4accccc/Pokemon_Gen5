	<TextRow
		Label="msg_wheel_summer_m_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ　そう……　じゃあ　またね
なつバテには　きを　つけなよ</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
