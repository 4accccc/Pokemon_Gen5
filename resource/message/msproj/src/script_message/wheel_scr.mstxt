	<TextRow
		Label="msg_wheel_spring_f_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そっか……
なんか　すごく　ざんねん……▼
でも　[Name:TrainerName Idx="0" ]くん　って
いそがしそう　だもんね……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
