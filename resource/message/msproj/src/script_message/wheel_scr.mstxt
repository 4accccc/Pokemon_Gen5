	<TextRow
		Label="msg_wheel_spring_f_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんどは　ぜってー　まけねーし！
ツブす！　マジで　ツブすっ！！▼</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
