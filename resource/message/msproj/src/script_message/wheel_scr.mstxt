	<TextRow
		Label="msg_wheel_spring_f_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハ？　なにソレ？　にげる　って？
かんがえられないわ　アンタ！
</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-01T09:20:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
