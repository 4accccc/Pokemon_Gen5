<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_wheel_spring_f_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッ……　イッ……　イックションッ！！▼
くしゃみが　とまんない　って　ことは
もう　はるか……　めんどくさいわあ▼
つーかさ！　そこの　アンタ！！
いま　アタシのこと　みてたよね！？▼
おとめの　はずかしい　しゅんかんを
みて　タダで　かえれると　おもう？▽
とうぜん　かくごは　いいわよね？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-05T10:33:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッ……　イッ……　イックションッ！！▼
くしゃみが　止まんない　って　ことは
もう　春か……　面倒くさいわあ▼
つーかさ！　そこの　アンタ！！
今　アタシのこと　みてたよね！？▼
乙女の　恥ずかしい　瞬間を
みて　タダで　帰れると　思う？▽
当然　覚悟は　いいわよね？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-05T10:33:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>春：主人公性別が♂　ミニスカート
・はい/いいえ
　はい→spring_m_02
　いいえ→spring_m_03</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-05T10:57:39" />
		</CommentCell>
		<AttributeCell
