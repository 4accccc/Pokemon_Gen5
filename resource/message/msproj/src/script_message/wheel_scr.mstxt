<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_wheel_spring_f_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッ……　イッ……　イックションッ！！▼
くしゃみが　とまんない　って　ことは
もう　はるか……　めんどくせ……▼
つーかさ！　そこの　テメー！！
いま　アタシのこと　みてたろ！？▽
めと　めが　あったら　ケンカだろ！？▼
……つまり　アンタは
ライモンの　あばレパルダスこと▽
このアタシに　ケンカ　うったのよ！▼
とうぜん　かくごは　いいよな？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T02:24:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッ……　イッ……　イックションッ！！▼
くしゃみが　止まんない　って　ことは
もう　春か……　面倒くせ……▼
つーかさ！　そこの　テメー！！
いま　アタシのこと　みてたろ！？▽
目と　目が　あったら　ケンカだろ？▼
……つまり　アンタは
ライモンの　あばレパルダスこと▽
このアタシに　ケンカ　売ったのよ！▼
当然　覚悟は　いいよな？</Text>
			<TextModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-15T05:56:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>春：主人公性別が♂　ミニスカート
・はい/いいえ
　はい→spring_m_02
　いいえ→spring_m_03</Comment>
			<CommentModifiedBy
				User="nakatsui:DB5YGPBX"
				Time="2011-12-05T10:57:39" />
		</CommentCell>
		<AttributeCell
