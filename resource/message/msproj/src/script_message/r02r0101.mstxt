	<TextRow
		Label="msg_r02r0101_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんにちは　トレーナーさん▼
ここは　たびびとの　ための　ゲート！
でんこうけいじばんを　よろしくね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんにちは　トレーナーさん▼
ここは　旅人の　ための　ゲート！
電光掲示板を　よろしくね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
