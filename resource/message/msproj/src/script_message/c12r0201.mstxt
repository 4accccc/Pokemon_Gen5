<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c12r0201_fighterm_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミも　ポケモンと　いっしょなら
[Name:TrainerName Idx="1" ]と　トレーナーとしての▽
うでまえを　きそいあえるのにな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T03:58:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:07:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミも　ポケモンと　一緒なら
[Name:TrainerName Idx="1" ]と　トレーナーとしての▽
腕前を　競いあえるのにな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T03:59:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:11:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ポケモン入手前
※連れ歩き時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:05:02" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERM
ライバル父</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:04:40" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12r0201_fighterm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんねでは　むすこに
たびを　してほしくなくてね……▽
だって　アイツの　もくてきは……▼
だが　こどもの　せいちょうを
ねがわない　おやなんて　いないだろ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:59:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本音では　息子に
旅を　してほしくなくてね……▽
だって　アイツの　目的は……▼
だが　こどもの　成長を
願わない　親なんて　いないだろ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:59:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ポケモン入手後からクリアまで</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERM
ライバル父</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12r0201_fighterm_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むすこは　だいじな　ものを
みつけたようだね▼
ポケモンが……　そして
キミが　いてくれた　おかげだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T04:00:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>息子は　大事な　ものを
みつけたようだね▼
ポケモンが……　そして
キミが　いてくれた　おかげだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T04:00:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・クリア後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T05:43:53" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERM
ライバル父</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12r0201_woman3_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたたちも　いつかは
ポケモンと　たびを　するのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:21:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:21:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたたちも　いつかは
ポケモンと　旅を　するのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:21:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:21:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ポケモン入手前
※連れ歩き時</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:05:06" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN3
ライバル母</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-09T11:05:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c12r0201_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]くん▼
もし　[Name:TrainerName Idx="1" ]が　たびさきで
みちに……　いえ　じんせいに▽
まよったりしたら　たすけてあげてね▼
あのコ……
わりと　ぼうそう　しやすいから</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T04:21:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]くん▼
もし　[Name:TrainerName Idx="1" ]が　旅先で
道に……　いえ　人生に▽
迷ったりしたら　助けてあげてね▼
あのコ……
わりと　暴走しやすいから</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T04:21:50" />
