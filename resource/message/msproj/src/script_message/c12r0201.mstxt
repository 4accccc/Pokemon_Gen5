<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c12r0201_fighterm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むすこはね
たびだつ　きっかけが　ほしかったんだ▼
ほんとうは　いつでも
この　まちを　とびだせたのにね▼
つよがっていても
まだ　こども　なんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T06:01:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>息子はね
旅立つ　きっかけが　ほしかったんだ▼
本当は　いつでも
この街を　飛びだせたのにね▼
強がっていても
まだ　子供　なんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T06:01:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ポケモン入手後からクリアまで</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERM
ライバル父</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12r0201_fighterm_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むすこは　だいじな　ものを
とりもどせたようだね▼
ポケモンが　そして
きみが　いてくれた　おかげかな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T05:59:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>息子は　大事な　ものを
取り戻せたようだね▼
ポケモンが　そして
きみが　いてくれた　おかげかな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T05:59:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・クリア後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T05:43:53" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERM
ライバル父</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12r0201_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]くん▼
もし　[Name:TrainerName Idx="1" ]が　たびさきで
みちに……　いえ　じんせいに▽
まよったりしたら　たすけてあげてね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
