	<TextRow
		Label="msg_c02r0401_shopm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２ねんまえに　はじめた　みせも
みんなの　おかげで　じゅんちょうさ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
