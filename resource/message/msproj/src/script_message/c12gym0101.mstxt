				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c12gym0101_board_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やけどに　なると
こうげきりょくが　さがるだけでなく▽
たいりょくも　どんどん　へります▼
せんとうが　おわっても
やけどの　ままです▼
やけどなおしで　なおしましょう▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やけどに　なると
攻撃力が　さがるだけでなく▽
体力も　どんどん　減ります▼
戦闘が　終わっても
やけどの　ままです▼
やけどなおしで　治しましょう▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ＢＧメッセージ
・やけど選択
・続けてboard_02表示</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>黒板</Text>
