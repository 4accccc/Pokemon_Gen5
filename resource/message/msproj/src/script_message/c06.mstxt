	<TextRow
		Label="msg_c06_hakase2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はーい！
[Name:TrainerName ]▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T11:31:43" />
			<Status>Editing</Status>
