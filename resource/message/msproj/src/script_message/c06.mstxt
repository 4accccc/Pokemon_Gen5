				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c06_hakase2_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしの　おねがいを　きいてくれて
ポケモンずかん～▼
じゃあ　さっそく　だけど
ひょうかを　するわね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T11:56:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T11:31:17" />
		</LanguageCell>
