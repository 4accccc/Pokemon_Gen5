				Time="2011-05-25T12:45:27" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T12:44:59" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
