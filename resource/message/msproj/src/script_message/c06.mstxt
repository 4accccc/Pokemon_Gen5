			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c06_hakase2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつもだと　ライブキャスターごしに
おはなし　していたから▽
なんだか　しんせん！▼
あらためまして
わたしが　アララギ　です！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T11:52:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T04:08:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仮メッセージ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T04:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T04:08:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・続けて</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T12:10:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T03:58:41" />
