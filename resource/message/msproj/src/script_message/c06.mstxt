	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c06_hakase2_01">
		<LanguageCell
			Language="JPN">
			<Text>はーい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-24T08:19:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-24T08:16:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>no data</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-24T10:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-24T08:16:31" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・pos（GRIDX=100~104、GRIDZ=301）で発動
・画面左上方向から博士（娘）登場
・博士（娘）、GRIDX=86、GRIDZ=294に到達すると
　！マークを表示後、主人公に隣接して
　メッセージ表示
・0＝主人公名前</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-24T08:16:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-24T08:16:39" />
		</AttributeCell>
	</TextRow>
