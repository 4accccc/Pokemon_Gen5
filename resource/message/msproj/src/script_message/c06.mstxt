				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c06_hakase2_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みねうちは　てかげん　して
あいての　たいりょくを　のこしつつ▽
こうげきする　わざ　なの！▼
やせいの　ポケモンを　つかまえるのに
やくだちそうな　わざ　でしょ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T12:26:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T11:31:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みねうちは　手加減して
相手の　体力を　残しつつ▽
攻撃する　技なの！▼
野生の　ポケモンを　捕まえるのに
役立ちそうな　技でしょ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T12:26:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T11:31:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・続けてhakase2_06</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T12:28:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>HAKASE2
アララギ博士娘</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T11:31:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c06_hakase2_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しかし　ポケモンの　ぶんぷって
２ねんで　おおきく　かわるのよね▼
だからこそ　けんきゅうは　おわらないし
おもしろいと　いえるのだけど……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T12:31:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T11:31:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しかし　ポケモンの　ぶんぷって
２ねんで　おおきく　かわるのよね▼
だからこそ　けんきゅうは　おわらないし
おもしろいと　いえるのだけど……▼</Text>
