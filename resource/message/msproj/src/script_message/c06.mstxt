				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c06_stop_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フウロさん▼
かもつきの　そうじゅうを　おえて
どこに　いっちゃったんですかね▼
ひょっとして　７ばんどうろの
タワーオブヘブン　っすか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フウロさん▼
貨物機の　操縦を　終えて
どこに　行っちゃったんですかね▼
ひょっとして　７番道路の
タワーオブヘブン　っすか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
