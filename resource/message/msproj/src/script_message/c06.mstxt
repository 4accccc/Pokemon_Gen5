	<TextRow
		Label="msg_c06_hakase1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おお！　おまえさん！
[Name:TrainerName Idx="0"]だろ！！[Ctrl2:PageClear ]</Text>
