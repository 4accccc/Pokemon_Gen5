	<TextRow
		Label="msg_c02gym0101_girl3_02_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このジムで　はじめて　であった
ポケモンは　わかったかしら？▼
ヒントは　ここから
ひだりの　ほんだなよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
