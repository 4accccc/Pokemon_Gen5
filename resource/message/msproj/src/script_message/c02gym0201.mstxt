	<TextRow
		Label="msg_c02gym0101_girl3_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>としょかんの　めいきゅうを　ぬけ
ジムリーダーに　しょうりする！▼
あなた……　きっと
けんきゅうねっしんな　トレーナーね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
