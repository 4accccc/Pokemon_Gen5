	<TextRow
		Label="msg_c02gym0101_statue_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シッポウ　ポケモンジム　あとち
いまは　そのまま　としょしつ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T08:35:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シッポウ　ポケモンジム跡地
今は　そのまま　図書室！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-28T08:35:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-20T05:45:54" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ポケモン像</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
