				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02gym0101_girl3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？
ほんを　さがしてるの？▼
……えーと　たしか
「はじめまして　ポケモンちゃん」は▽
いりぐちに　ちかい　ほんだなよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T09:25:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？
本を　探してるの？▼
……えーと　確か
「はじめまして　ポケモンちゃん」は▽
入り口に　近い　本棚よ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T09:25:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：トレーナー「じゅくがえり」
・フラグ成立前（本棚を向いている）</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>本棚ストッパー１
問題１</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff00</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02gym0101_assitantw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……ふむふむ
なるほど▼
おっと！　いま　よんでいるのは
「きかんしゃの　こうぞう」よ▼
このほんを　よみたくなったら
わたしに　いってね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T09:25:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……ふむふむ
なるほど▼
おっと！　今　読んでいるのは
「機関車の　構造」よ▼
この本を　読みたくなったら
私に　いってね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-20T09:25:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：トレーナー「けんきゅういん♀」
・フラグ成立前（本棚を向いている）</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>本棚ストッパー２</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
