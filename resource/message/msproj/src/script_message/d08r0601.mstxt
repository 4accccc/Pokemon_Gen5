	<TextRow
		Label="msg_d08r0601_leader7_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハチク『[Name:TrainerName Idx="0"]か！▼
こいつらを　くいとめる▼
だから　きみが　ゆけ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
