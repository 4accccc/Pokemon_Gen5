	<TextRow
		Label="CROWD_MSG26"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オメーも　おおきくなったら
バイクのりに　ならねえか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
