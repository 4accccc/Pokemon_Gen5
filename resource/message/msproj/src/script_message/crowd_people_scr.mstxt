				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG18"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいじゅうの　ひとが
ヒウンに　あつまっている▼
まるで　ちいさな　せかいちず　だよ
この　まちは！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:12:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界　各国の　人が
ヒウンに　集まっている▼
まるで　小さな　世界地図だよ
この　街は！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:12:58" />
			<Status>Editing</Status>
