	</TextRow>
	<TextRow
		Label="CROWD_MSG09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はやく　キミに　あいたい……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
