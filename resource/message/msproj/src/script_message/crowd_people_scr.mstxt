		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG21"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおどおり　いつもどおりの　ひとどおり</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
