	<TextRow
		Label="CROWD_MSG11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シャカリキに　やるのも
ダラダラ　するのも　じゆう</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:21:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シャカリキに　やるのも
ダラダラ　するのも　自由</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:21:36" />
			<Status>Editing</Status>
