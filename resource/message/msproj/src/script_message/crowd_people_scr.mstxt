				Time="2012-01-10T05:26:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG23"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつも　ここを　あるいているからね
めを　つぶっても　だいじょうぶ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:11:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつも　ここを　歩いているからね
目を　つぶっても　大丈夫！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:11:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>c03群集用
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:11:49" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:26:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG24"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふるい　ちかてつを　うみに　いれて
さかなポケモンの　すみかに　するよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:06:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古い　地下鉄を　海に　いれて
さかなポケモンの　住処に　するよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:06:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
