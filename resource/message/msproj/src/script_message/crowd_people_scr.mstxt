				Time="2012-01-10T05:26:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG25"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おいおい　チビ！
あぶねーだろうがっ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おいおい　チビ！
危ねーだろうがっ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
