		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG17"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんど　しゅっちょうで
ホウエンちほうに　いくんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:08:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今度　出張で
ホウエン地方に　行くんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:08:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
