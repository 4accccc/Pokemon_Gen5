			Language="JPN">
			<Comment>c03群集用</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:58:17" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
