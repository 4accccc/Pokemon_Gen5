				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あるけば　エネルギーが　たまる
シューズが　あれば　いいのに！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:43:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>歩けば　エネルギーが　たまる
シューズが　あれば　いいのに！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:44:04" />
			<Status>Editing</Status>
