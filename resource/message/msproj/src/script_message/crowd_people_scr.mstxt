	<TextRow
		Label="CROWD_MSG02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いもうとたちと　ポケモンしょうぶ！
たたかうほどに　あいが　ふかまる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:38:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>妹たちと　ポケモン勝負！
戦うほどに　愛が　深まる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:39:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>c03群集用
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:39:15" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:26:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんにちは！　こんにちは！
あいさつは　だいじ　だよな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:05:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんにちは！　こんにちは！
あいさつは　大事だよな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:05:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>c03群集用
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T12:05:12" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:26:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タイム　イズ　マネー
じかんは　とりもどせない▼
そして　わたしは
こうかい　したくないんだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:23:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タイム　イズ　マネー
時間は　取り戻せない▼
そして　わたしは
後悔したくないんだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:23:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>c03群集用
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:23:36" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:26:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいにち　ひとが　ふえる……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:21:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>毎日　人が　増える……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>c03群集用
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:21:25" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:26:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しごとも　フルパワー！
さぼるのも　フルパワー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:36:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仕事も　フルパワー！
さぼるのも　フルパワー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:36:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>c03群集用
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:36:33" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:26:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CROWD_MSG07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　まちは
ねむらない　まち……▼
わたしは　ねむる……
ゆめ　みる　ために</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:22:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　街は
眠らない　街……▼
わたしは　眠る……
夢みる　ために</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:22:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>c03群集用
・swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T03:22:50" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T05:26:01" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
