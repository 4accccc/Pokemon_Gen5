	<TextRow
		Label="CROWD_MSG01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はやい　ウォーキングは
ニンジャの　しゅぎょう　なのデス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T02:43:09" />
			<Status>Editing</Status>
