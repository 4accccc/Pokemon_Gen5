	<TextRow
		Label="msg_c05r0401_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんにちは
ゴージャス　ホドモエ　です▼
よやくで　いっぱい　ですが
のんびりと　なさって　くださいませ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
