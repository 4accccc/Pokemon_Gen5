<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c05r0101_woman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テレビの　ばんぐみで　ときどき
ポケモンの　わざや　とくせいのこと▽
おしえてくれたり　するのよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テレビの　番組で　ときどき
ポケモンの　技や　特性のこと▽
教えてくれたり　するのよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0101_boy1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとと　こうかんすることで
しんかする　ポケモンが　いるんだ！▼
すっげーよな！
なんで　しんかするんだろ！？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人と　交換することで
進化する　ポケモンが　いるんだ！▼
すっげーよな！
なんで　進化するんだろ！？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
