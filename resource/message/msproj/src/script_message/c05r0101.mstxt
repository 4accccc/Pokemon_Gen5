	<TextRow
		Label="msg_c05r0101_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんにちは
ゴージャス　ホドモエ　です▼
よやくで　いっぱい　ですが
のんびりと　なさって　くださいませ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:52:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T03:17:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんにちは
ゴージャス　ホドモエ　です▼
予約で　一杯ですが
のんびりと　なさって　くださいませ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T05:52:17" />
