	<TextRow
		Label="msg_d03r0201_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リゾートデザートの　こだいのしろ▼
ごらんになれば　わかりますが
じかんというのは　ざんこくですね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T08:34:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リゾートデザートの　古代の城▼
ご覧になれば　わかりますが
時間というのは　残酷ですね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T08:35:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T08:34:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFOMATIONW
汎用受付</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
