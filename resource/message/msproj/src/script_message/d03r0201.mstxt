<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d03r0201_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リゾートデザートの　めいしょは
こだいのしろと　なっております</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リゾートデザートの　名所は
古代の城と　なっております</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFOMATIONW
汎用受付</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d03r0201_boy3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅくがえりの　ボクは　しってます▼
さばくは　どうくつと　おなじで
あちこちから　ポケモンが　でてきます▼
つけくわえるとですね
すなの　いろが　うすい　ところは▽
あるいても　だいじょうぶ　です</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じゅくがえりの　ボクは　知ってます▼
砂漠は　洞くつと　同じで
あちこちから　ポケモンが　でてきます▼
つけくわえるとですね
砂の　色が　薄いところは▽
歩いても　大丈夫です</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・r04のmouontainnと同じ情報
・念のため</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY3
少年（聡明）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>