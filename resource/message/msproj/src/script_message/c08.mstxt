	</TextRow>
	<TextRow
		Label="msg_c08_swleader7_18"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シャガ『うばわれたら
うばいかえすだけだ　いくぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-10T10:30:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-09T06:24:52" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シャガ『奪われたら
奪い返すだけだ　行くぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T03:12:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-09T06:24:52" />
		</LanguageCell>
