	<TextRow
		Label="msg_c08_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうか　わしらは……▼
ポケモンを
くるしめていた　のか……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
