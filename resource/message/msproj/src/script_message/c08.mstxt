	<TextRow
		Label="msg_c08_gymstop_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょうせんしゃ？[Ctrl2:PageClear ]
もうしわけないね
いま　ジムリーダーは[Ctrl2:LineFeed ]
いえに　いらっしゃるよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
