	<TextRow
		Label="msg_c08_fighterm_01b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんなに　あいちゃくが　あっても
かえなくては　いけないもの　って▽
あると　おもうんだよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T10:09:44" />
			<Status>Editing</Status>
