				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c08_fighterm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おれ　ひとりでは
とうたつ　できなかった　たかみにも▽
ポケモンが　いてくれたから　とどいた▼
そして　ポケモンも　おれが　いたから
タフになったと　しんじている！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T04:28:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレ一人では　決して
到達できなかった　高みにも▽
ポケモンが　いてくれたから　届いた▼
そして　ポケモンも　オレが　いたから
タフになったと　信じている！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T04:28:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・クリア前
※swanでメッセージ変更</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T04:26:00" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>FIGHTERM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c08_fighterm_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たとえ　ふべん　でも
かえては　いけないもの　って▽
あると　おもうんだよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T10:09:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たとえ　不便でも
変えては　いけないもの　って▽
あると　思うんだよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-07T10:09:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
