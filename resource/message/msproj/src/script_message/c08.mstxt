	<TextRow
		Label="msg_c08_swchampion_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アイリス『やっほー！
ヒウンシティ　いらい　だね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T13:39:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-09T03:18:55" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アイリス『やっほー！
ヒウンシティ　以来　だね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T13:40:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-09T03:21:15" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・posイベント
　GIRDX＝、GRIDZ＝
・続けてswchampion_02</Comment>
