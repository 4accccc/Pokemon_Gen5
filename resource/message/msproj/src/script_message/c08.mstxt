	<TextRow
		Label="msg_c08_boy2_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたらしいより　むかしのものが　すき
だって　なんだか　おちつくんだもん！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
