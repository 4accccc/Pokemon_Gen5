	<TextRow
		Label="msg_c08_boy2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｎって　ひとが　でんせつの
ポケモンを　つれていたんだけど▽
えいゆう　だったのかな……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T03:50:52" />
			<Status>Editing</Status>
