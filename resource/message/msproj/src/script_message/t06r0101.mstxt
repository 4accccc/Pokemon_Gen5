	<TextRow
		Label="msg_t06r0101_girl3_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でもね　でもね！▼
ポケモンの　タイプと
わざの　タイプが　おなじだと▽
わざの　いりょくが　つよまるんだよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T11:53:16" />
			<Status>Editing</Status>
