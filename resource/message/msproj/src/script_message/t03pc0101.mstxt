	<TextRow
		Label="msg_t03pc0101_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　シェイミ！▼
シェイミと　いえば
グラシデアのはな　よね！▼
あたし　たくさん　もっているから
あなたにも　わけてあげるね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　シェイミ！▼
シェイミと　いえば
グラシデアのはな　よね！▼
あたし　たくさん　持っているから
あなたにも　わけてあげるね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>※swanでc01pc0101に移植</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-31T06:51:43" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
