	<TextRow
		Label="msg_d26_sppoke3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふしぎな　けはいが　する……！
あたりを　しらべますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T07:53:45" />
