	<TextRow
		Label="msg_doctor_msg_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わっかた　かいふく　したくなったら
ここに　くるといい</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:42:51" />
			<Status>Editing</Status>
