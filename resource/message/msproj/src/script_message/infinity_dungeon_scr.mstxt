	<TextRow
		Label="msg_b_boss_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえの　ちからは　しっている
そのちからが　おとろえていないか
たしかめてやろう！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
