		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:Item ]</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T04:00:39" />
			<Status>Editing</Status>
