	<TextRow
		Label="msg_hint_up_02">
		<LanguageCell
			Language="JPN">
			<Text>ボストレーナーなら
うえのかいで　みたわ</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T08:01:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-05T09:32:54" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボストレーナーなら
上の階で　見たわよ</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T08:01:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-05T09:33:01" />
		</LanguageCell>
