	<TextRow
		Label="msg_elevator_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんかいに　いどうしますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:27:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>何階に　移動しますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:27:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
