	<TextRow
		Label="msg_hint_unknown_06">
		<LanguageCell
			Language="JPN">
			<Text>つよいわね　アナタ
わたしも　もっと　がんばらないと</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:18:03" />
			<Status>Editing</Status>
