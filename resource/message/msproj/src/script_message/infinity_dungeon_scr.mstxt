	<TextRow
		Label="msg_info_w_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅんびが　できたようだな
やれるだけ　やってこい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:50:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>準備が　できたようだな
やれるだけ　やってこい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:52:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
