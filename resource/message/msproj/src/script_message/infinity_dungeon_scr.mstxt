	</TextRow>
	<TextRow
		Label="msg_info_w_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よう！　よくきたな
ここは　しろのじゅどうだ
きょうは　なにを　するんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:42:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よう！　よく来たな
ここは　白の樹洞だ
今日は　何を　するんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:45:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
