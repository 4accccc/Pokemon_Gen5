	<TextRow
		Label="msg_info_attention_w_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリア5　いこうは
「シングル　たんさく」　のみの▽
ちょうせんと　なっております▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
