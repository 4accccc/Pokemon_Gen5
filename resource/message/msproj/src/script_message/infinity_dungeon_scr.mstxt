			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_nurse_msg_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さきは　まだまだ　ながいわ
がんばってね！</Text>
