	<TextRow
		Label="msg_b_boss_first_end_10">
		<LanguageCell
			Language="JPN">
			<Text>しょかい　せんとう　おわり（ブラック）▼</Text>
			<TextModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:03:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:03:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しょかい　せんとう　おわり（ブラック）▼</Text>
			<TextModifiedBy
