				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア1
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:41:04" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アドバイス……
は　もう　いらないわね▼
キミが　どれだけ　
つよくなったか　ためしてあげるわ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:00:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アドバイス……
は　もう　いらないわね▼
キミが　どれだけ
強くなったか　試してあげるわ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:00:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア2
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:41:17" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんかいは　やられたけど
こんかいは　ひとあじ　ちがうぞ！▼
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>前回は　やられたけど
今回は　一味　違うぞ！▼
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア3
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:41:30" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうは　どうかしら？▼
あれから　キミが　どこまで
いけたのか　しりたいわね▼
さあ　せいちょうした
キミの　ちからを　みせて　もらうわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:26:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼は　どうかしら？▼
あれから　キミが　どこまで
行けたのか　知りたいわね▼
さあ　成長した　キミの　力を
みせて　もらうわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:26:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア4
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:41:55" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あれから　どれだけ　ちからを
つけることが　できたかな？▼
キミと　こうして　たたかえるのが
うれしいよ▼
こんどは　こっちが
ちょうせん　させてもらうよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:38:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あれから　どれだけ　力を
つけることが　できたかな？▼
キミと　こうして　戦えるのが
うれしいよ▼
今度は　こっちが
挑戦　させてもらうよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:42:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア5
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　あのときの　おこさまね▼
どうしたの？　こんな　ばしょには
もう　ようじは　ないでしょう？▼
え？　ちょうせんに　きたの？
まあ　いいわ　あいてを　してあげる▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:46:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　あの時の　お子様ね▼
どうしたの？　こんな　場所には
もう　用事は　ないでしょう？▼
え？　挑戦に　来たの？
まあ　いいわ　相手を　してあげる▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:47:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア6
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:25" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>お　きたな！
ずっと　まっていたんだ▼
それじゃ　おれと　たたかうぞ！▼
たたかって　たたかって　おれは
もっと　つよくなるんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:52:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お　来たな！
ずっと　待っていたんだ▼
それじゃ　おれと　戦うぞ！▼
戦って　戦って　おれは
もっと　強くなるんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:53:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア7
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:36" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　あら　また　いらしたのね
ここまで　ごくろうさま▼
せっかく　いらしたのだから
たたかいましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:38:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　あら　また　いらしたのね
ここまで　ごくろうさま▼
せっかく　いらしたのだから
戦いましょうか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:42:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア8
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:47" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミも　たたかいつづけて　いるんだな▼
わたしも　まだ　つよさの　いみは
みつけられないで　いるよ▼
さあ　キミの　めざす　つよさを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:58:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミも　戦い続けて　いるんだな▼
わたしも　まだ　強さの　意味は
みつけられないで　いるよ▼
さあ　キミの　目指す　強さを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:59:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア9
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:59" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえと　おいら！▼
おたがいの　ポケモンたち！▼
もてる　ちから！▼
のこすところなく　ぶつけるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:01:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえと　おいら！▼
お互いの　ポケモンたち！▼
持てる　力！▼
残すところなく　ぶつけるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:01:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:43:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:05" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうとは　なにか？
その　こたえは　みつけられたかしら？▼
その　こたえを　みつけるまで
たたかいつづけましょう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:04:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強とは　何か？
その　答えは　みつけられたかしら？▼
その答えを　みつけるまで
戦い続けましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:39:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:43:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろのじゅどうに　ようこそ
しょしんしゃさん▼
ぶじに　ゲートトレーナーから
じつりょくを　みとめられたようね▼
その　じつりょく
こんどは　わたしに　みせてみなさい！▼
えんりょは　むようよ
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-11-22T03:05:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白の樹洞に　ようこそ
初心者さん▼
無事に　ゲートトレーナーから
実力を　認められたようね▼
その　実力
今度は　わたしに　見せてみなさい！▼
遠慮は　無用よ
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-11-22T03:05:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア1
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:43:40" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リタイアせずに　ここまで
たどりつけたようだね▼
ここまでの　がんばりを
むだに　しないように　ぜんりょくで▽
かかって　おいで！▼
エリア２を　クリアして　しょしんしゃ
そつぎょうを　めざすんだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-11-22T03:09:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:10:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リタイアせずに　ここまで
たどり着けたようだね▼
ここまでの　がんばりを
無駄に　しないように　全力で▽
かかって　おいで！▼
さあ　エリア2を　クリアして
初心者　卒業を　目指すんだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-11-22T03:09:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア2
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:43:50" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた……▼
けたちがいの　つよさを　もつ
トレーナーって　いるものね▼
あれだけの　そしつを
もっているなんて　ジェラシーだわ▼
さあ　つぎは　キミの　ばんよ
ぜんりょくで　ぶつかって　きなさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:21:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた……▼
ケタ違いの　強さを　持つ
トレーナーって　いるものね▼
あれだけの　素質を
持っているなんて　ジェラシーだわ▼
さあ　次は　キミの　番よ
全力で　ぶつかって　来なさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:20:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア3
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:01" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろのじゅどうは　どうだい？
ふしぎな　ばしょ　だろう？▼
おれたちも　ここが　
どこまで　つづいているのか▽
はあくして　いないぐらいだからな▼
キミも　きになるだろう？
さいかそうに　なにが　あるのか▼
それじゃ　キミが　どこまで　いけるか
その　じつりょくを　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T01:38:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白の樹洞は　どうだい？
不思議な　場所だろう？▼
おれたちも　ここが
どこまで　続いているのか▽
把握して　いないぐらいだからな▼
キミも　気になるだろう？
最下層に　何が　あるのか▼
それじゃ　キミが　どこまで　いけるのか
その　実力を　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:23:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア4
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つぎの　ちょうせんしゃね▼
キミは　わたしを
たのしませて　くれるかしら？▼
わたしは　つよい　トレーナーと
たたかうために　ここに　いるの▼
さあ　キミの　じつりょくを
ためさせて　もらうわよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:24:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>次の　挑戦者ね▼
キミは　わたしを
楽しませて　くれるかしら？▼
わたしは　強い　トレーナーと
戦うために　ここに　いるの▼
さあ　キミの　実力を
試させて　もらうわよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:24:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア5
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:32" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　こんなところに
こどもが　なんの　ようだ？▼
ここから　さきは　かるいきもちで
ちょうせんする　ばしょじゃ　ないぞ▼
こどもは　エリア5で　あそんでな▼
……ほんきで　つぎの　エリアを
めざしているのか？▼
いいだろう　あいてを　してやる
さあ　かかってきな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:43:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　こんなところに
子供が　何の用だ？▼
ここから　先は　軽い気持ちで
挑戦する　場所じゃ　ないぞ▼
子供は　エリア5で　遊んでな▼
……本気で　次の　エリアを
目指しているのか？▼
いいだろう　相手を　してやる
さあ　かかってきな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:43:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア6
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:42" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ　きた　きた！
あなた　ちょうせんしゃね！▼
それじゃ　わたしと　たたかいましょう！▼
たたかって　たたかって　わたしは
もっと　つよくなるの！▼
ここは　わたしのように　たたかいを
もとめる　トレーナーには　てんごく！▼
さあ　あなたは
どんな　ポケモンを　つかうのかしら？▼
わたしを　たのしませて！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:45:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あ　来た　来た！　
あなた　挑戦者ね？▼
それじゃ　わたしと　戦いましょう！▼
戦って　戦って　わたしは
もっと　強くなるの！▼
ここは　わたしのように　戦いを
求める　トレーナーには　天国！▼
さあ　あなたは
どんな　ポケモンを　使うのかしら？▼
わたしを　楽しませて！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:45:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア7
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:54" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　ああ　ちょうせんしゃのひと？
ここまで　ごくろうさま▼
ここまで　これたんだから
もう　いいんじゃない？▼
え？　つぎの　エリアも　めざすの？
がんばるんだね　キミ▼
まあ　いいさ
めんどうだけど　たたかおうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:16:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　ああ　挑戦者の人？
ここまで　ごくろうさま▼
ここまで　これたんだから
もう　いいんじゃない？▼
え？　次の　エリアも　目指すの？
がんばるんだね　キミ▼
まあ　いいさ
面倒だけど　戦おうか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:45:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア8
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:04" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたは　たたかうのは　すきかしら？▼
くるひも　くるひも　たたかったけど
つよさって　なんなのかしら？▼
……ごめんなさい▼
トレーナーが　こんなことを　
かんがえてしまったら　おしまいね▼
さあ　あなたの　つよさを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:04:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたは　戦うのは　好きかしら？▼
来る日も　来る日も　戦ったけど
強さって　何なのかしら？▼
……ごめんなさい▼
トレーナーが　こんなことを
考えてしまったら　おしまいね▼
さあ　あなたの　強さを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:04:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア9
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:15" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アデクじーちゃんの　いえで▼
やくそく　したよな！▼
どっちが　つよいか！▼
おもうぞんぶん　きそおーぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T03:43:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アデクじーちゃんの　家で▼
約束したよな！▼
どっちが　強いか！▼
思う存分　競おーぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T03:43:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:32" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　さいきょうの　トレーナーを
めざして　たたかいつづけてきた▼
キミも　そうだろう？
さいきょうとは　なにか？▼
その　こたえを　もとめて
ここまで　きたの　だろう？▼
わたしと　たたかうことで
イッシュさいきょうが　だれか▽
その　こたえに　ちかづけるだろう▼
かんきゃくが　いないのが　さびしいが
さいこうの　たたかいを　しよう▼
さあ　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:14:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:52" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　最強の　トレーナーを
目指して　戦い　続けてきた▼
キミも　そうだろう？
最強とは　何か？▼
その　答えを　求めて
ここまで　来たの　だろう？▼
わたしと　戦うことで
イッシュ最強が　だれか▽
その　答えに　近づけるだろう▼
観客が　いないのが　寂しいが
最高の　戦いを　しよう▼
さあ　勝負だ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:05:02" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:46:44" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうに　ようこそ
しょしんしゃさん▼
ぶじに　ゲートトレーナーから
じつりょくを　みとめられたようだね▼
その　じつりょく
こんどは　ボクに　みせてもらおう！▼
えんりょは　むようだ
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-11-22T03:07:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼に　ようこそ
初心者さん▼
無事に　ゲートトレーナーから
実力を　認められたようだね▼
その　実力
今度は　ボクに　見せてもらおう！▼
遠慮は　無用だ
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-11-22T03:07:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア1
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:08" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゲートトレーナーを　みつけだし
リタイアせずに　ここまで▽
たどりつけたようね▼
ここまでの　がんばりを
むだに　しないように▽
ぜんりょくで　かかって　きなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-11-25T08:39:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:10:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゲートトレーナーを　みつけだし
リタイアせずに　ここまで▽
たどり着けたようね▼
ここまでの　がんばりを
無駄に　しないように▽
全力で　かかって　きなさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア2
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:17" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた……▼
けたちがいの　つよさを　もつ
トレーナーって　いるものだね▼
あれだけの　そしつの　もちぬし
はじめて　みたよ▼
さあ　つぎは　キミの　ばんだ
ぜんりょくで　ぶつかって　来い！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:22:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた……▼
ケタ違いの　強さを　持つ
トレーナーって　いるものだね▼
あれだけの　素質の　持ち主
はじめて　みたよ▼
さあ　次は　キミの　番だ
全力で　ぶつかって　来い！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア3
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:29" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうは　どうかしら？▼
イッシュには　これいじょうの
こうそうビルは　ないとおもうわ▼
わたしたちも　このビルが
なんかいだてか　しらないもの▼
キミも　このビルの　さいじょうかいが
きになるでしょう？▼
それじゃ　キミが　どこまで　いけるか
その　じつりょくを　みせてもらうね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T07:55:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼は　どうかしら？▼
イッシュには　これい以上の
高層ビルは　ないと思うわ▼
わたしたちも　このビルが
何階建てか　知らないもの▼
キミも　このビルの　最上階が
気になるでしょう？▼
それじゃ　キミが　どこまで　行けるか
その　実力を　みせてもらうね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T07:55:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア4
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:42" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つぎの　ちょうせんしゃか▼
キミは　わたしを
たのしませて　くれるかな？▼
つよい　トレーナーと　たたかうのが
わたしの　よろこびだ▼
さあ　キミの　じつりょくを
ためさせて　もらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:25:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>次の　挑戦者か▼
キミは　わたしを
楽しませて　くれるかな？▼
強い　トレーナーと　戦うのが
わたしの　喜びだ▼
さあ　キミの　実力を
試させて　もらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:25:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア5
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:54" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　こんなところに　おこさまが
なんの　ようじ？▼
ここから　さきは　かるいきもちで
ちょうせんする　ばしょじゃ　ないわよ▼
こどもは　エリア5で　あそんでなさい▼
え？　ほんきで　つぎの　エリアを
めざしているの？▼
わかったわ　あいてを　してあげる
さあ　かかってきなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:10:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　こんなところに　お子様が
何の　用事？▼
ここから　先は　軽い気持ちで
挑戦する　場所じゃ　ないわよ▼
子供は　エリア5で　遊んでなさい▼
え？　本気で　次の　エリアを
目指しているの？▼
わかったわ　相手を　してあげる
さあ　かかってきなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:10:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア6
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:05" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>お　きたな！
つぎの　ちょうせんしゃが！▼
それじゃ　おれと　たたかうぞ！▼
たたかって　たたかって　おれは
もっと　つよくなるんだ▼
ここは　おれのように　たたかいを
もとめる　トレーナーには　てんごく！▼
さあ　おまえは
どんな　ポケモンを　つかうんだ？▼
おれを　たのしませてくれよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:46:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お　来たな！
次の　挑戦者が！▼
それじゃ　おれと　戦うぞ！▼
戦って　戦って　おれは
もっと　強くなるんだ▼
ここは　おれのように　戦いを
求める　トレーナーには　天国！▼
さあ　おまえは
どんな　ポケモンを　使うんだ？▼
おれを　楽しませてくれよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:46:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア7
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:16" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　あら　ちょうせんしゃのかた？
ここまで　ごくろうさま▼
ここまで　これたんだから
もう　よろしいんじゃなくて？▼
まあ　つぎの　エリアも
めざして　いらっしゃるの？▼
それなら　わたしと　たたかう
ひつようが　ありますわね▼
あら　あら　しょうがないですわ
たたかいましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:19:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　あら　挑戦者の方？
ここまで　ごくろうさま▼
ここまで　これたんだから
もう　よろしいんじゃなくて？▼
まあ　次の　エリアも
目指して　いらっしゃるの？▼
それなら　わたしと　戦う
必要が　ありますわね▼
あら　あら　しょうがないですわ
戦いましょうか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:46:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア8
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:27" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミは　たたかいは　すきかい？▼
わたしは　くるひも　くるひも
たたかって　きたが　つよさの　こたえが▽
いまだに　みつからなくてね……▼
おっと　すまない▼
トレーナーが　こんなことを　
かんがえてしまったら　おしまいだな▼
さあ　キミの　めざす　つよさを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:48:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミは　戦いは　好きかい？▼
わたしは　来る日も　来る日も
戦って　来たが　強さの　答えが▽
いまだに　みつからなくてね……▼
おっと　すまない▼
トレーナーが　こんなことを　
考えてしまったら　おしまいだな▼
さあ　キミの　目指す　強さを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:48:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア9
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:38" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アデクじーちゃんの　いえで▼
やくそく　したよな！▼
どっちが　つよいか！▼
おもうぞんぶん　きそおーぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T03:43:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アデクじーちゃんの　家で▼
約束したよな！▼
どっちが　強いか！▼
思う存分　競おーぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T03:43:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:40" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　さいきょうの　トレーナーを
めざして　たたかいつづけてきたわ▼
あなたも　そうでしょう？
さいきょうとは　なにか？▼
その　こたえを　もとめて
ここまで　きたの　でしょう？▼
わたしと　たたかうことで
イッシュさいきょうが　だれか▽
その　こたえに　ちかづけるわ▼
かんきゃくは　いないけど
さいこうの　たたかいを　しましょう▼
さあ　しょうぶよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:14:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:02:35" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　最強の　トレーナーを
目指して　戦い続けてきたわ▼
あなたも　そうでしょう？
最強とは　何か？▼
その　答えを　求めて
ここまで　来たの　でしょう？▼
わたしと　戦うことで
イッシュ最強が　だれか▽
その　答えに　近づけるわ▼
観客は　いないけど
最高の　戦いを　しましょう▼
さあ　勝負よ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:02:51" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:51" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いぜんより　つよくなったわね
もう　しょしんしゃとは　いえないわ▼
キミが　どこまで
つよくなるのか　たのしみよ▼
また　ちょうせんしてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:42:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>以前より　強くなったわね
もう　初心者とは　言えないわ▼
キミが　どこまで
強くなるのか　楽しみよ▼
また　挑戦してね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:43:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア1
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:03" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよくなったね
しょしんしゃの　ころが　なつかしいよ▼
それとも　ボクが　よわくなったのかな▼
ボクも　まけずに　ここで　しゅぎょうが
ひつようかもね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:57:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強くなったね
初心者の　ころが　懐かしいよ▼
それとも　ボクが　弱くなったのかな▼
ボクも　負けずに　ここで　修行が
必要かもね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:59:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア2
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいも　かてなかったか
つよいわね　ほんとうに▼
わたしも　もっと　がんばらないと
つぎは　まけないわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:15:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今回も　勝てなかったか
強いわね　本当に▼
わたしも　もっと　がんばらないと
次は　負けないわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:16:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア3
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:22" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　つよくなったね
ぜんかいとは　おおちがいだ▼
キミは　どこまで　いけるように
なったんだい？▼
いつか　さいかそうに
とうたつしたら　おしえてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　強くなったね
前回とは　大違いだ▼
キミは　どこまで　行けるように
なったんだい？▼
いつか　最下層に
到達したら　教えてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア4
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:35" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やっぱり　かてなかったわね▼
キミが　どこまで　つよくなるのか
たのしみに　なってきたわ▼
つぎは　まけないように
わたしも　がんばるわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:57:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やっぱり　勝てなかったわね▼
キミが　どこまで　強くなるのか
楽しみに　なってきたわ▼
次は　負けないように
わたしも　がんばるわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:58:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア5
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:48" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さらに　うでを　あげたな
みとめよう　おまえは　つよい▼
もっと　つよさを　もとめるなら
さきの　エリアを　めざすんだな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:59:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さらに　腕を　上げたな
認めよう　おまえは　強い▼
もっと　強さを　求めるなら
先の　エリアを　目指すんだな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア6
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:02" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たりないわ
あなたと　もっと　たたかいたいのに▼
ぜったい　また　ここに　きてよ！
ぜったい　また　たたかいましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:35:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>足りないわ
あなたと　もっと　戦いたいのに▼
絶対　また　ここに　来てよ！
絶対　また　戦いましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:35:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア7
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　ごくろうさま▼
あれ？
まだ　たたかいたりないの？▼
キミは　よくばりだな▼
それぐらいじゃないと　このさきは
つらいのかも　しれないけど▼
まあ　きがむいたら　またおいで
あいてを　するからさ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はい　ご苦労様▼
あれ？
まだ　戦い足りないの？▼
キミは　欲張りだな▼
それぐらいじゃないと　この先は
つらいのかも　知れないけど▼
まあ　気が向いたら　またおいで
相手を　するからさ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア8
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　たたかいで
あなたの　めざす　ものに▽
すこしは　ちかづけたかしら？▼
こたえが　みつかるまで
なんどでも　あいてを　するわ▼
また　たたかいましょう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:06:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　戦いで
あなたの　目指す　ものに▽
少しは　近づけたかしら？▼
答えが　みつかるまで
何度でも　相手を　するわ▼
また　戦いましょう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:06:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア9
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:35" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゾクゾクする！▼
チャンピオンだった　じーちゃんより▼
つよい　トレーナーが　わんさかいる！▼
みんなで　きそいあえば▼
ポケモントレーナーとして▼
そして　ひと　として▼
たかみを　めざせる！▼
これも　ポケモンの　おかげだな！▼
また　こい！▼
もっと　たかみに　いきたいからな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:33:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゾクゾクする！▼
チャンピオンだった　じーちゃんより▼
強い　トレーナーが　わんさかいる！▼
みんなで　競いあえば▼
ポケモントレーナーとして▼
そして　人として▼
高みを　目指せる！▼
これも　ポケモンの　おかげだな！▼
また　来い！▼
もっと　高みに　行きたいからな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:33:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:47" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:22" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいな▼
キミは　まちがいなく　しろのじゅどう
さいきょうの　トレーナーだ▼
だが　イッシュさいきょうか
どうかは　わからない……▼
まだみぬ　きょうしゃは
いくらでも　いるからな▼
さいきょうを　めざし
しょうじん　するんだな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:48:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:01:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いな▼
キミは　間違いなく
白の樹洞　最強の　トレーナーだ▼
だが　イッシュ最強か
どうかは　わからない……▼
まだみぬ　強者は
いくらでも　いるからな▼
最強を　目指し
精進するんだな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:48:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:45" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>最上階、色違い用</Comment>
			<CommentModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:02:09" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いぜんより　てごわくなったね
もう　しょしんしゃとは　いえないな▼
キミが　どこまで
つよくなるのか　たのしみだよ▼
また　ちょうせんして　くれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:40:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>以前より　手強くなったね
もう　初心者とは　言えないな▼
キミが　どこまで
強くなるのか　楽しみだよ▼
また　挑戦して　くれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:41:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア1
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:55" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよくなったわね
しょしんしゃの　ころが　なつかしいわ▼
それとも　わたし　よわくなったのかな▼
わたしも　まけずに
ここでの　しゅぎょうが　ひつようね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:07:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強くなったね
初心者の　ころが　懐かしいわ▼
それとも　わたし　弱くなったのかな▼
わたしも　負けずに
ここでの　修行が　必要ね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:07:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア2
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:04" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいも　かてなかったか
つよいね　ほんとうに▼
ボクも　もっと　がんばらないと
つぎは　まけないぞ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:17:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今回も　勝てなかったか
強いね　本当に▼
ボクも　もっと　がんばらないと
次は　負けないぞ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:17:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア3
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　つよくなったわね
ぜんかいとは　おおちがいよ▼
キミは　どこまで　いけるように
なったのかしら？▼
いつか　さいじょうかいに
とうたつしたら　おしえてね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:07:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　強くなったわね
前回とは　大違いよ▼
キミは　どこまで　行けるように
なったのかしら？▼
いつか　最上階に
到達したら　教えてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア4
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やっぱり　かてなかったか▼
キミが　どこまで　つよくなるのか
たのしみに　なってきたよ▼
つぎは　まけないように
こっちも　がんばるよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:32:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やっぱり　勝てなかったか▼
キミが　どこまで　強くなるのか
楽しみに　なってきたよ▼
次は　負けないように
こっちも　がんばるよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:32:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア5
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さらに　うでを　あげたわね
あなたの　つよさを　みとめるわ▼
もっと　つよさを　もとめるなら
さきの　エリアを　めざしなさい▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:33:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さらに　腕を　上げたわね
あなたの　強さを　認めるわ▼
もっと　強さを　求めるなら
先の　エリアを　目指しなさい▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:34:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア6
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:42" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これじゃ　たりない！▼
おれは　もっと　もっと
たたかいたい！▼
ぜったい　また　ここに　こいよ！
ぜったい　また　たたかうぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:36:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これじゃ　足りない！▼
おれは　もっと　もっと
戦いたい！▼
絶対　また　ここに　来いよ！
絶対　また　戦うぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:36:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア7
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:53" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　ごくろうさま▼
あら？
まだ　たたかいたりないかしら？▼
ごうよく　ですこと……▼
それぐらいの　きもちが　ないと
このさきは　つらいのかもね▼
まあ　きがむいたら　おいでなさい
おあいて　しますわ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:34:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はい　ご苦労様▼
あら？
まだ　戦い足りないのかしら？▼
強欲　ですこと……▼
それぐらいの　気持ちが　ないと
この先は　つらいのかもね▼
まあ　気が向いたら　おいでなさい
お相手しますわ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:08:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア8
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:53:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　たたかいで
キミの　めざす　ものに▽
すこしは　ちかづけたかい？▼
こたえが　みつかるまで
なんどでも　あいてを　するよ▼
また　たたかおう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:31:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　戦いで
キミの　目指す　ものに▽
少しは　近づけたかい？▼
答えが　みつかるまで
何度でも　相手を　するよ▼
また　戦おう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:31:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア9
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:53:20" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゾクゾクする！▼
チャンピオンだった　じーちゃんより▼
つよい　トレーナーが　わんさかいる！▼
みんなで　きそいあえば▼
ポケモントレーナーとして▼
そして　ひと　として▼
たかみを　めざせる！▼
これも　ポケモンの　おかげだな！▼
また　こい！▼
もっと　たかみに　いきたいからな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:31:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゾクゾクする！▼
チャンピオンだった　じーちゃんより▼
強い　トレーナーが　わんさかいる！▼
みんなで　競いあえば▼
ポケモントレーナーとして▼
そして　人として▼
高みを　目指せる！▼
これも　ポケモンの　おかげだな！▼
また　来い！▼
もっと　高みに　行きたいからな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:31:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:27" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいわね▼
あたなは　まちがいなく
くろのまてんろう　さいきょうの▽
トレーナーだわ▼
だけど　イッシュさいきょうか
どうかは　わからない……▼
まだみぬ　きょうしゃは
いくらでも　いるわ▼
さいきょうを　めざし
しょうじん　しなさい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:08:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いわね▼
あたなは　間違いなく
黒の摩天楼　最強の　トレーナーだわ▼
だけど　イッシュ最強か
どうかは　わからない……▼
まだみぬ　強者は
いくらでも　いるわ▼
最強を　目指し　精進しなさい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:08:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:53:32" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おどろいたよ　そうぞういじょうだ▼
それじゃ　さいごに　ボクから
やくだつヒントを　あげるよ▼
ここに　くるまで　いろいろな
トレーナーが　いただろう？▼
それぞれ　しっている　じょうほうが
ちがうことに　きがついたかい？▼
ゲートトレーナーが　どこにいるかとか
ドクターの　いるばしょを▽
しっているひとも　いるみたいだよ▼
いろいろな　トレーナーと　たたかって
こうりゃくほうほうを　さがしてごらん▼
それじゃ　キミの　かつやくを
たのしみに　しているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-11-19T05:46:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>驚いたよ　想像以上だ▼
それじゃ　最後に　ボクから
役立つヒントを　あげるよ▼
ここに　来るまで　いろいろな
トレーナーが　いただろう？▼
それぞれ　知っている　情報が
違うことに　気がついたかい？▼
ゲートトレーナーが　どこにいるかとか
ドクターの　いる場所を▽
知っている人も　いるみたいだよ▼
いろいろな　トレーナーと　戦って
攻略方法を　探してごらん▼
それじゃ　キミの　活躍を
楽しみに　しているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-11-19T05:46:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア1
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:54:02" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おめでとう
これで　しょしんしゃ　そつぎょうね▼
だけど　さきは　ながいわよ
つぎの　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-12-21T07:16:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:11:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おめでとう
これで　初心者　卒業ね▼
だけど　先は　長いわよ
次の　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-12-21T07:16:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア2
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:54:15" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さすがだね！
キミの　つよさも　よくわかったよ▼
エリア３　クリアの　きねんに
エリア４の　ヒントを　すこしおしえよう▼
つぎの　エリア４からは
エリアが　ひろくなるぞ▼
ゲートトレーナーを　さがすのが
いまより　むずかしくなるから▼
トレーナーから　ヒントを　よくきいて
ゲートトレーナーを　さがすんだ▼
キミが　どこまで　いけるのか
たのしみに　しているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-12-21T07:22:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さすがだね！
キミの　強さも　よくわかったよ▼
エリア３　クリアの　記念に
エリア４の　ヒントを　少し教えよう▼
次の　エリア４からは
エリアが　広くなるぞ▼
ゲートトレーナーを　探すのが
今より　難しくなるから▼
トレーナーから　ヒントを　よく聞いて
ゲートトレーナーを　探すんだ▼
キミが　どこまで　行けるのか
楽しみに　しているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-12-21T07:22:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア3
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:55:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいったわ
キミ　つよいわね▼
キミなら　さいじょうかいまで
たどりつけるかも　しれないわね▼
つぎの　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:42:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まいったわ
キミ　強いね▼
キミなら　最上階まで
たどり着けるかも　しれないわね▼
次の　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:43:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア4
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:00" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいな　キミは▼
だけど　キミと　おなじぐらい……▼
いや　キミより　つよい
トレーナーが　いるはず！▼
そんな　トレーナーと　であったとき
どんな　たたかいに　なるのか▽
みてみたいものだ▼
では　また　たたかおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:31:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いな　キミは▼
だけど　キミと　同じぐらい……▼
いえ　キミより　強い
トレーナーが　いるはず！▼
そんな　トレーナーと　遭遇したとき
どんな　戦いに　なるのか▽
みてみたいものだ▼
では　また　戦おう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:32:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア5
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:12" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうさん　こうさんよ
まけたわ▼
ポケモンの　つよさに
ねんれいは　かんけい　ないわね▼
でも　ここから　さきは
たたかうことを　いきがいに▽
しているような　ひとばかりよ▼
あなたの　ほんきが　どこまで
つうようするのか　たのしみだわ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:47:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>降参　降参よ
負けたわ▼
ポケモンの　強さに
年齢は　関係ないわね▼
でも　ここから　先は
戦うことを　生きがいに▽
しているような　人ばかりよ▼
あなたの　本気が　どこまで
通用するのか　楽しみだわ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:47:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア6
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけた　まけた！
ここまで　まけたのは　ひさしぶりだ▼
ほら　つぎの　エリアに　いきな▼
おれは　つぎの　ちょうせんしゃを
まつからさ▼
つぎは　だれだ？
はやく　たたかわせろ！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:56:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けた　負けた！
ここまで　負けたのは　久しぶりだ▼
ほら　次の　エリアに　行きな▼
おれは　次の　挑戦者を
待つからさ▼
次は　だれだ？
はやく　戦わせろ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:35:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア7
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:32" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　あら　まけてしまいました
おつよいのね▼
それだけ　つよいのに
まだ　さきを　めざすのね▼
あなたは　どこまで　いくのかしら
おわりは　あるのかしら？▼
あなたが　めざす　ゴールに
たどりつけることを　いのっているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:02:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　あら　負けてしまいました
お強いのね▼
それだけ　強いのに
まだ　先を　目指すのね▼
あなたは　どこまで　行くのかしら
終わりは　あるのかしら？▼
あなたが　目指す　ゴールに
たどり着けることを　祈っているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:03:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア8
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:42" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしい　つよさだ▼
キミは　わたしの　さがす　つよさを
もっているのかも　しれないな▼
いぜん　たたかった　しょうねんも
おなじ　つよさを　かんじたよ▼
いつか　おしえてくれ
キミたちが　みつけた　つよさを▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:35:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>素晴らしい　強さだ▼
キミは　わたしの　探す　強さを
持っているのかも　知れないな▼
以前　戦った　少年も
同じ　強さを　感じたよ▼
いつか　教えてくれ
キミたちが　みつけた　強さを▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:35:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア9
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:53" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゾクゾクする！▼
おまえと！▼
ポケモンたちの　コンビネーション！▼
さいこうの　チームワークだった▼
ひとだけでは　いけない　ばしょ▼
ポケモンが　いこうとしない　ばしょ▼
おまえみたいに！　おいらのように！▼
トレーナーと　ポケモンの▼
チームワークなら　どこでも　いける▼
それが　わかって　うれしいぜ！▼
おい！▼
おい！▼
おいッ！▼
じーちゃんの　いえに　こいよ！▼
わかるだろ　サンギタウンの！▼
すごいもの　わたすからな！▼
おいらとの　やくそく　だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:36:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゾクゾクする！▼
おまえと！▼
ポケモンたちの　コンビネーション！▼
最高の　チームワークだった▼
人だけでは　行けない　場所▼
ポケモンが　行こうとしない　場所▼
おまえみたいに！　おいらのように！▼
トレーナーと　ポケモンの▼
チームワークなら　どこでも　行ける▼
それが　わかって　うれしいぜ！▼
おい！▼
おい！▼
おいッ！▼
じーちゃんの　家に　来いよ！▼
わかるだろ　サンギタウンの！▼
すごいもの　渡すからな！▼
おいらとの　約束だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:36:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:46:06" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいわね▼
これほどの　つよさを　もった
トレーナーは　はじめてよ▼
わたしの　しょうがい　さいこうの
たたかいだったわ▼
さいきょうへの
こたえは　みえたかしら？▼
あなたなら　いつか　さいきょうへの
みちが　ひらけるかも　しれないわね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:47:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:03:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いわね▼
これほどの　強さを　持った
トレーナーは　はじめてよ▼
わたしの　生涯
最高の　戦いだったわ▼
最強への　答えは　みえたかしら？▼
あなたなら　いつか　最強への
道が　開けるかも　知れないわね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:17:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:05" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おどろいたわ　よそういじょうよ▼
それじゃ　さいごに　わたしから
やくだつヒントを　あげるわ▼
ここに　くるまで　いろいろな
トレーナーが　いたでしょう？▼
それぞれ　しっている　じょうほうが
ちがうことに　きがついたかしら？▼
ゲートトレーナーが　どこにいるかとか
ナースの　いる　ばしょを▽
しっているひとも　いるみたいよ▼
いろいろな　トレーナーと　たたかって
こうりゃくほうほうを　さがしてみて▼
それじゃ　キミの　かつやくを
たのしみに　しているわよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:48:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>驚いたわ　予想以上よ▼
それじゃ　最後に　わたしから
役立つヒントを　あげるわ▼
ここに　来るまで　いろいろな
トレーナーが　いたでしょう？▼
それぞれ　知っている　情報が
違うことに　気がついたかしら？▼
ゲートトレーナーが　どこにいるかとか
ナースが　いる場所を▽
知っている人も　いるみたいよ▼
いろいろな　トレーナーと　戦って
攻略方法を　探してみて▼
それじゃ　キミの　活躍を
楽しみに　しているわよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:48:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア1
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:15" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おめでとう
これで　しょしんしゃ　そつぎょうだな▼
だが　さきは　ながいぞ
つぎの　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-12-21T07:18:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:11:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おめでとう
これで　初心者　卒業だな▼
だが　先は　長いぞ
次の　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-12-21T07:18:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア2
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:28" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おみごと　ね！
キミの　つよさも　よくわかったわ▼
エリア３　クリアの　きねんに
エリア４の　ヒントを　すこしあげるわ▼
つぎの　エリア４からは
エリアが　ひろくなるわ▼
ゲートトレーナーを　さがすのが
いまより　むずかしくなるから▼
トレーナーから　ヒントを　よくきいて
ゲートトレーナーを　さがしなさい▼
キミが　どこまで　いけるのか
たのしみに　しているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-12-21T07:21:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:11:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おみごと　ね！
キミの　強さも　よくわかったわ▼
エリア３　クリアの　記念に
エリア４の　ヒントを　少しあげるわ▼
次の　エリア４からは
エリアが　広くなるわ▼
ゲートトレーナーを　探すのが
今より　難しくなるから▼
トレーナーから　ヒントを　よく聞いて
ゲートトレーナーを　探しなさい▼
キミが　どこまで　行けるのか
楽しみに　しているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-12-21T07:20:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア3
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:41" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいったよ
キミ　つよいな▼
キミなら　さいかそうまで
たどりつけるかも　しれないな▼
つぎの　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:22:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まいったよ
キミ　強いな▼
キミなら　最下層まで
たどり着けるかも　知れないな▼
次の　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:23:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア4
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:52" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいわね　キミ▼
だけど　キミと　おなじぐらい……▼
いえ　キミより　つよい
トレーナーが　いるはず！▼
そんな　トレーナーと　であったとき
どんな　たたかいに　なるのか▽
きょうみぶかいわ▼
それじゃ　また　たたかいましょうね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:27:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>つよいわね　キミ▼
だけど　キミと　同じぐらい……▼
いえ　キミより　強い
トレーナーが　いるはず！▼
そんな　トレーナーと　遭遇したとき
どんな　戦いに　なるのか▽
興味深いわ▼
それじゃ　また　戦いましょうね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T06:28:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア5
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:08" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうさん　こうさんだ
まけたよ▼
ポケモンの　つよさに　ねんれいは
かんけいないな▼
だが　ここから　さきは
たたかうことを　いきがいに▽
しているような　やつばかりだぞ▼
おまえの　ほんきが　どこまで
つうようするのか　たのしみだよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:27:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>降参　降参だ
負けたよ▼
ポケモンの　強さに　年齢は
関係ないな▼
だが　ここから　先は
戦うことを　生きがいに▽
しているような　やつばかりだぞ▼
おまえの　本気が　どこまで
通用するのか　楽しみだよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T12:26:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア6
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:18" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんぱいよ！
ここまで　まけたのは　ひさしぶりね▼
ほら　つぎの　エリアに　いきなさい▼
わたしは　つぎの　ちょうせんしゃを
まつことに　するわ▼
つぎは　だれ？
はやく　たたかわせなさい！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:37:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>完敗よ！
ここまで　負けたのは　久しぶりね▼
ほら　次の　エリアに　いきなさい▼
わたしは　次の　挑戦者を
待つことに　するわ▼
次は　だれ？
早く　戦わせなさい！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア7
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:28" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　ああ　まけちゃったね
つよいんだね▼
それだけ　つよいのに
まだ　さきを　めざすんだね▼
キミは　どこまで　いくの？
おわりは　あるのかな？▼
キミが　めざす　ゴールに
たどりつけることを　いのっているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:41:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　ああ　負けちゃったね
強いんだね▼
それだけ　強いのに
まだ　先を　目指すんだね▼
キミは　どこまで　行くの？
終わりは　あるのかな？▼
キミが　目指す　ゴールに
たどり着けることを　祈っているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:42:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア8
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:39" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしいつよさね▼
あなたは　わたしの　さがす　つよさを
もっているのかも　しれないわ▼
いぜん　たたかった　しょうねんも
おなじ　つよさを　かんじたわ▼
いつか　おしえて　ほしいわね
キミたちが　みつけた　つよさを▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:42:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>素晴らしい強さね▼
あなたは　わたしの　探す　強さを
持っているのかも　知れないわ▼
以前　戦った　少年も
同じ　強さを　感じたわ▼
いつか　教えて　欲しいわね
キミたちが　みつけた　強さを▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:42:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア9
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:50" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゾクゾクする！▼
おまえと！▼
ポケモンたちの　コンビネーション！▼
さいこうの　チームワークだった▼
ひとだけでは　いけない　ばしょ▼
ポケモンが　いこうとしない　ばしょ▼
おまえみたいに！　おいらのように！▼
トレーナーと　ポケモンの▼
チームワークなら　どこでも　いける▼
それが　わかって　うれしいぜ！▼
おい！▼
おい！▼
おいッ！▼
じーちゃんの　いえに　こいよ！▼
わかるだろ　サンギタウンの！▼
すごいもの　わたすからな！▼
おいらとの　やくそく　だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:37:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゾクゾクする！▼
おまえと！▼
ポケモンたちの　コンビネーション！▼
最高の　チームワークだった▼
人だけでは　行けない　場所▼
ポケモンが　行こうとしない　場所▼
おまえみたいに！　おいらのように！▼
トレーナーと　ポケモンの▼
チームワークなら　どこでも　行ける▼
それが　わかって　うれしいぜ！▼
おい！▼
おい！▼
おいッ！▼
じーちゃんの　家に　来いよ！▼
わかるだろ　サンギタウンの！▼
すごいもの　渡すからな！▼
おいらとの　約束だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-12T03:37:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:46:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:35:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいな▼
これほどの　つよさを　もった
トレーナーは　はじめてだ▼
わたしの　しょうがい
さいこうの　たたかい　だったよ▼
さいきょうへの
こたえは　みえたかい？▼
キミなら　いつか　さいきょうへの
みちが　ひらけるかも　しれないな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:49:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:05:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いな▼
これほどの　強さを　持った
トレーナーは　はじめてだ▼
わたしの　生涯
最高の　戦いだったよ▼
最強への　答えは　みえたかい？▼
キミなら　いつか　最強への
道が　開けるかも　知れないな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:49:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:59:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_doctor_msg_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンが　つかれているようだ
かいふくして　あげようか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンが　つかれているようだ
回復して　あげようか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
