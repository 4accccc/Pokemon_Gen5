	<TextRow
		Label="msg_b_boss_first_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おどろいたよ　よそういじょうだ▼
キミの　ポケモンの　ちから
みせてもらったよ▼
キミなら　つぎの　エリアも
クリアできるだろう▼
キミの　かつやくを　たのしみに
しているよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>驚いたよ　想像以上だ▼
キミの　ポケモンの　力
見せてもらったよ▼
キミなら　次の　エリアも
クリアできるだろう▼
キミの　活躍を　楽しみに
しているよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
