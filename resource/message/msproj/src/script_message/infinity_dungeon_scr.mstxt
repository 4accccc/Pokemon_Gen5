			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-05T09:58:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>少し　ヒントを　あげましょう▼
ボストレーナーは
[Name:PokemonName Idx="1" ]を　使ってくるわよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:27:04" />
