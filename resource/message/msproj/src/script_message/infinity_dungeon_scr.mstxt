	<TextRow
		Label="msg_info_b_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅんびは　よろしいですか？
それでは　がんばってくださいね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T04:56:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:27:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>準備は　よろしいですか？
それでは　がんばってくださいね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:51:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:23:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
