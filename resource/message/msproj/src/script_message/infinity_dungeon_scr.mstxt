<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_w_boss_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　ちょうせん　してくれて
うれしいわ▼
さあ　あれから　どれだけ
せいちょうしたか　みせてもらうわよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　挑戦してくれて
うれしいわ▼
さあ　あれから　どれだけ
成長したか　みせてもらうわよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:02:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア1
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:37:17" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アドバイス……
は　もう　いらないね▼
キミが　どれだけ　
つよくなったか　ためしてあげよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アドバイス……
は　もう　いらないね▼
キミが　どれだけ
強くなったか　試してあげよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア2
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:37:39" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんかいは　やられたけど
こんかいは　ひとあじ　ちがうわ！▼
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>前回は　やられたけど
今回は　一味　違うわ！▼
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:03:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア3
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:37:52" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろのじゅどうを
たのしんで　いるかい？▼
あれから　キミが　どこまで
いけたのか　きょうみが　あるね▼
さあ　せいちょうした
キミの　ちからを　みせて　もらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白の樹洞を　楽しんで　いるかい？▼
あれから　キミが　どこまで
行けたのか　興味が　あるね▼
さあ　成長した　キミの　ちからを
みせて　もらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:03:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア4
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:38:10" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あれから　さらに　つよくなったようね▼
キミと　こうして　たたかえるのが
うれしいわ▼
こんどは　わたしが
キミに　ちょうせん　するわね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あれから　さらに　強くなったようね▼
キミと　こうして　戦えるのが
うれしいわ▼
今度は　わたしが
キミに　挑戦するわね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:36:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア5
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:38:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　あのときの　こどもか▼
どうした？　こんな　ばしょには
もう　ようは　ないだろう？▼
また　ちょうせんに　きたのか？
まあ　いい　あいてを　しよう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:43:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　あのときの　子供か▼
どうした？　こんな　場所には
もう　用は　ないだろう？▼
また　挑戦に　来たのか？
まあ　いい　相手を　しよう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:44:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア6
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:38:35" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ　きた　きた！
また　きてくれたのね！▼
それじゃ　わたしと　たたかいましょう！▼
たたかって　たたかって　わたしは
もっと　つよくなるの！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:48:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あ　来た　来た！
また　来てくれたのね！▼
それじゃ　わたしと　戦いましょう！▼
戦って　戦って　わたしは
もっと　強くなるの！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:49:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア7
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:38:47" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　ああ　また　きたんだ
ここまで　ごくろうさま▼
せっかく　きてくれたんだ
めんどうだけど　たたかおうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:35:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　ああ　また　来たんだ
ここまで　ご苦労様▼
せっかく　来てくれたんだ
面倒だけど　戦おうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:36:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア8
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:39:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたも　たたかいつづけて　いるのね▼
わたしも　まだ　つよさの　いみは
みつけられないわ▼
さあ　あなたの　めざす　つよさを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:55:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたも　戦い続けて　いるのね▼
わたしも　まだ　強さの　意味は
みつけられないわ▼
さあ　あなたの　目指す　強さを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア9
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:39:22" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえと　おいら！▼
おたがいの　ポケモンたち！▼
もてる　ちから！▼
のこすところなく　ぶつけるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:01:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえと　おいら！▼
お互いの　ポケモンたち！▼
持てる　力！▼
残すところなく　ぶつけるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:01:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:40:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:35:59" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうとは　なにか？
その　こたえは　みつかったかい？▼
そのこたえを　みつけるまで
たたかいつづけると　しよう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:35:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:00:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強とは　何か？
その　答えは　みつかったかい？▼
その答えを　みつけるまで
戦い続けると　しよう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:37:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:40:36" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　ちょうせんしてくれて
うれしいよ▼
さあ　あれから　どれだけ
せいちょうしたか　みせてもらうよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:43:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　挑戦してくれて
うれしいよ▼
さあ　あれから　どれだけ
成長したか　みせてもらうよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:43:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア1
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:41:04" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アドバイス……
は　もう　いらないわね▼
キミが　どれだけ　
つよくなったか　ためしてあげるわ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:00:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アドバイス……
は　もう　いらないわね▼
キミが　どれだけ
強くなったか　試してあげるわ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:00:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア2
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:41:17" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんかいは　やられたけど
こんかいは　ひとあじ　ちがうぞ！▼
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>前回は　やられたけど
今回は　一味　違うぞ！▼
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア3
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:41:30" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうは　どうかしら？▼
あれから　キミが　どこまで
いけたのか　しりたいわね▼
さあ　せいちょうした
キミの　ちからを　みせて　もらうわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:26:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼は　どうかしら？▼
あれから　キミが　どこまで
行けたのか　知りたいわね▼
さあ　成長した　キミの　力を
みせて　もらうわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:26:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア4
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:41:55" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あれから　どれだけ　ちからを
つけることが　できたかな？▼
キミと　こうして　たたかえるのが
うれしいよ▼
こんどは　こっちが
ちょうせん　させてもらうよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:38:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あれから　どれだけ　力を
付けることが　できたかな？▼
キミと　こうして　戦えるのが
うれしいよ▼
今度は　こっちが
挑戦　させてもらうよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:38:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア5
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　あのときの　おこさまね▼
どうしたの？　こんな　ばしょには
もう　ようじは　ないでしょう？▼
え？　ちょうせんに　きたの？
まあ　いいわ　あいてを　してあげる▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:46:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　あの時の　お子様ね▼
どうしたの？　こんな　場所には
もう　用事は　ないでしょう？▼
え？　挑戦に　来たの？
まあ　いいわ　相手を　してあげる▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:47:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア6
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:25" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>お　きたな！
ずっと　まっていたんだ▼
それじゃ　おれと　たたかうぞ！▼
たたかって　たたかって　おれは
もっと　つよくなるんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:52:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お　来たな！
ずっと　待っていたんだ▼
それじゃ　おれと　戦うぞ！▼
戦って　戦って　おれは
もっと　強くなるんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:53:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア7
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:36" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　あら　また　いらしたのね
ここまで　ごくろうさま▼
せっかく　いらしたのだから
たたかいましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:38:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　あら　また　いらしたのね
ここまで　ご苦労様▼
せっかく　いらしたのだから
戦いましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:39:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア8
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:47" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミも　たたかいつづけて　いるんだな▼
わたしも　まだ　つよさの　いみは
みつけられないで　いるよ▼
さあ　キミの　めざす　つよさを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:58:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミも　戦い続けて　いるんだな▼
わたしも　まだ　強さの　意味は
みつけられないで　いるよ▼
さあ　キミの　目指す　強さを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:59:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア9
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:42:59" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえと　おいら！▼
おたがいの　ポケモンたち！▼
もてる　ちから！▼
のこすところなく　ぶつけるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:01:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえと　おいら！▼
お互いの　ポケモンたち！▼
持てる　力！▼
残すところなく　ぶつけるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:01:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:43:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:05" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうとは　なにか？
その　こたえは　みつけられたかしら？▼
その　こたえを　みつけるまで
たたかいつづけましょう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:04:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強とは　何か？
その　答えは　みつけられたかしら？▼
その答えを　みつけるまで
戦い続けましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:39:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:43:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろのじゅどうに　ようこそ
しょしんしゃさん▼
わたしからの　さいごの　アドバイスよ▼
この　エリアを　クリアするには
わたしを　たおす　ひつようが　あるわ▼
えんりょは　むようよ！
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T04:53:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白の樹洞に　ようこそ
初心者さん▼
わたしからの　最後の　アドバイスよ▼
この　エリアを　クリアするには
わたしを　倒す　必要が　あるわ▼
遠慮は　無用よ！
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:31:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア1
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:43:40" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リタイアせずに　ここまで
たどりつけたようだね▼
アドバイスは　やくに
たったなかったかな？▼
さあ　エリア２を　クリアして
しょしんしゃ　そつぎょうを　めざせ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:01:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:10:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リタイアせずに　ここまで
たどり着けたようだね▼
アドバイスは　役に
立たなかったかな？▼
さあ　エリア2を　クリアして
初心者　卒業を　目指せ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:01:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア2
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:43:50" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた……
さいきんの　こどもは　ようしゃないわね▼
それにしても　あれだけの　そしつを
もっているこは　はじめて　みたわ▼
あのこは　すえ　おそろしいわね……▼
さあ　つぎは　キミの　ばんよ
ぜんりょくで　ぶつかって　きなさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:02:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた……
最近の　子供は　容赦ないわね▼
それにしても　あれだけの　素質を
持っている子は　はじめて　みたわ▼
あの子は　末恐ろしいわね……▼
さあ　次は　キミの　番よ
全力で　ぶつかって　来なさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:02:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア3
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:01" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろのじゅどうは　どうだい？
ふしぎな　ばしょだろう？▼
おれたちも　ここが　
どこまで　つづいているのか▽
はあくして　いないぐらいだからな▼
キミも　きになるだろう？
さいかそうに　なにが　あるのか▼
それじゃ　キミが　どこまで　いけるか
その　じつりょくを　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:23:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白の樹洞は　どうだい？
不思議な　場所だろう？▼
おれたちも　ここが
どこまで　続いているのか▽
把握して　いないぐらいだからな▼
キミも　気になるだろう？
最下層に　何が　あるのか▼
それじゃ　キミが　どこまで　いけるのか
その　実力を　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:23:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア4
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　ちょうせんしゃが
たくさん　くるわね▼
さっきの　しょうねんも　
つよかったけど▽
キミは　どうかしら？▼
わたしは　つよい　トレーナーと
たたかうために　ここにいるの▼
さあ　キミの　じつりょくを
ためさせて　もらうわよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T08:15:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今日は　挑戦者が
たくさん　来るわね▼
さっきの　少年も　強かったけど
キミは　どうかしら？▼
わたしは　強い　トレーナーと
戦うために　ここにいるの▼
さあ　キミの　実力を
試させて　もらうわよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:04:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア5
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:32" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　こんなところに　こどもが
なんのようだ？▼
ここから　さきは　かるいきもちで
ちょうせんする　ばしょじゃ　ないぞ▼
こどもは　エリア5で　あそんでな▼
……ほんきで　つぎの　エリアを
めざしているのか？▼
いいだろう　あいてを　してやる
さあ　かかってきな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:04:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　こんなところに　子供が
何の用だ？▼
ここから　先は　軽い気持ちで
挑戦する　場所じゃ　ないぞ▼
子供は　エリア5で　遊んでな▼
……本気で　次の　エリアを
目指しているのか？▼
いいだろう　相手を　してやる
さあ　かかってきな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:04:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア6
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:42" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ　きた　きた！
あなた　ちょうせんしゃね！▼
それじゃ　わたしと　たたかいましょう！▼
たたかって　たたかって　わたしは
もっと　つよくなるの！▼
ここは　わたしのように　たたかいを
もとめる　トレーナーには▽
てんごくよ！▼
さあ　あなたは　どんな　ポケモンを
つかうのかしら？▼
わたしを　たのしませて！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:05:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あ　来た　来た！　
あなた　挑戦者ね？▼
それじゃ　わたしと　戦いましょう！▼
戦って　戦って　わたしは
もっと　強くなるの！▼
ここは　わたしのように　戦いを
求める　トレーナーには　天国よ！▼
さあ　あなたは　どんな　ポケモンを
使うのかしら？▼
わたしを　楽しませて！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:07:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア7
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:44:54" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　ああ　ちょうせんしゃのひと？
ここまで　ごくろうさま▼
ここまで　これたんだから
もう　いいんじゃない？▼
え？　つぎの　エリアも　めざすの？
がんばるんだね　キミ▼
まあ　いいさ
めんどうだけど　たたかおうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:16:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　ああ　挑戦者の人？
ここまで　ご苦労様▼
ここまで　これたんだから
もう　いいんじゃない？▼
え？　次の　エリアも　目指すの？
がんばるんだね　キミ▼
まあ　いいさ
面倒だけど　戦おうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:16:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア8
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:04" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたは　たたかうのは　すきかしら？▼
くるひも　くるひも　たたかったけど
つよさって　なんなのかしら？▼
……ごめんなさい▼
トレーナーが　こんなことを　
かんがえてしまったら　おしまいね▼
さあ　あなたの　つよさを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:04:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたは　戦うのは　好きかしら？▼
来る日も　来る日も　戦ったけど
強さって　何なのかしら？▼
……ごめんなさい▼
トレーナーが　こんなことを
考えてしまったら　おしまいね▼
さあ　あなたの　強さを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:04:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア9
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:15" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アデクじーちゃんの　いえで▼
やくそく　したよな！▼
どっちが　つよいか！▼
おもうぞんぶん　きそおーぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T03:43:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アデクじーちゃんの　家で▼
約束したよな！▼
どっちが　強いか！▼
思う存分　競おーぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T03:43:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:32" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　さいきょうの　トレーナーを
めざして　たたかいつづけてきた▼
キミも　そうだろう？
さいきょうとは　なにか？▼
その　こたえを　もとめて
ここまで　きたの　だろう？▼
わたしと　たたかうことで
イッシュさいきょうが　だれか▽
その　こたえに　ちかづけるだろう▼
かんきゃくが　いないのが　さびしいが
さいこうの　たたかいを　しよう▼
さあ　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:14:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:52" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　最強の　トレーナーを
目指して　戦い　続けてきた▼
キミも　そうだろう？
最強とは　何か？▼
その　答えを　求めて
ここまで　来たの　だろう？▼
わたしと　戦うことで
イッシュ最強が　だれか▽
その　答えに　近づけるだろう▼
観客が　いないのが　寂しいが
最高の　戦いを　しよう▼
さあ　勝負だ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:05:02" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:46:44" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうに　ようこそ
しょしんしゃさん▼
キミへの　さいごの　アドバイスだ▼
この　エリアを　クリアするには
ボクを　たおす　ひつようが　ある▼
えんりょは　むようだ！
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T04:53:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼に　ようこそ
初心者さん▼
キミへの　最後の　アドバイスだ▼
この　エリアを　クリアするには
ボクを　倒す　必要が　ある▼
遠慮は　無用だ！
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:56:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア1
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:08" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リタイアせずに　ここまで
たどりつけたようね▼
アドバイスは　やくに
たったなかったかしら？▼
さあ　エリア２を　クリアして
しょしんしゃ　そつぎょうを▽
めざしなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T11:11:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:10:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リタイアせずに　ここまで
たどり着けたようね▼
アドバイスは　役に
立たなかったかしら？▼
さあ　エリア2を　クリアして
初心者　卒業を　目指しなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T11:12:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア2
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:17" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた……
さいきんの　こどもは　ようしゃないな▼
それにしても　あれだけの　そしつを
もっているこは　はじめて　みたよ▼
あのこは　すえ　おそろしいな……▼
さあ　つぎは　キミの　ばんだ
ぜんりょくで　ぶつかって　来い！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:05:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた……
最近の　子供は　容赦ないな▼
それにしても　あれだけの　素質を
持っている子は　はじめて　みたよ▼
あの子は　末恐ろしいな……▼
さあ　次は　キミの　番だ
全力で　ぶつかって　来い！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:05:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア3
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:29" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうは　どうかしら？▼
イッシュには　これいじょうの
こうそうビルは　ないとおもうわ▼
わたしたちも　このビルが
なんかいだてか　しらないもの▼
キミも　このビルの　さいじょうかいが
きになるでしょう？▼
それじゃ　キミが　どこまで　いけるか
その　じつりょくを　みせてもらうね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T07:55:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼は　どうかしら？▼
イッシュには　これい以上の
高層ビルは　ないと思うわ▼
わたしたちも　このビルが
何階建てか　知らないもの▼
キミも　このビルの　最上階が
気になるでしょう？▼
それじゃ　キミが　どこまで　行けるか
その　実力を　みせてもらうね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T07:55:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア4
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:42" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　ちょうせんしゃが
たくさん　くるひだな▼
さっきの　しょうねんも　つよかったが
キミは　どうかな？▼
つよい　トレーナーと　たたかうのが
わたしの　よろこびだ▼
さあ　キミの　じつりょくを
ためさせて　もらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T08:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今日は　挑戦者が
たくさん　来る日だな▼
さっきの　少年も　強かったが
キミは　どうかな？▼
強い　トレーナーと　戦うのが
わたしの　喜びだ▼
さあ　キミの　実力を
試させて　もらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:05:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア5
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:47:54" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　こんなところに　おこさまが
なんの　ようじ？▼
ここから　さきは　かるいきもちで
ちょうせんする　ばしょじゃ　ないわよ▼
こどもは　エリア5で　あそんでなさい▼
え？　ほんきで　つぎの　エリアを
めざしているの？▼
わかったわ　あいてを　してあげる
さあ　かかってきなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:10:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　こんなところに　お子様が
何の　用事？▼
ここから　先は　軽い気持ちで
挑戦する　場所じゃ　ないわよ▼
子供は　エリア5で　遊んでなさい▼
え？　本気で　次の　エリアを
目指しているの？▼
わかったわ　相手を　してあげる
さあ　かかってきなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:10:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア6
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:05" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>お　きたな！
つぎの　ちょうせんしゃが！▼
それじゃ　おれと　たたかうぞ！▼
たたかって　たたかって　おれは
もっと　つよくなるんだ▼
ここは　おれのように　たたかいを
もとめる　トレーナーには▽
てんごくさ！▼
さあ　おまえは
どんな　ポケモンを　つかうんだ？▼
おれを　たのしませてくれよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:05:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お　来たな！
次の　挑戦者が！▼
それじゃ　おれと　戦うぞ！▼
戦って　戦って　おれは
もっと　強くなるんだ▼
ここは　おれのように　戦いを
求める　トレーナーには　天国さ！▼
さあ　おまえは
どんな　ポケモンを　使うんだ？▼
おれを　楽しませてくれよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:05:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア7
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:16" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　あら　ちょうせんしゃのかた？
ここまで　ごくろうさま▼
ここまで　これたんだから
もう　よろしいんじゃなくて？▼
まあ　つぎの　エリアも
めざして　いらっしゃるの？▼
それなら　わたしと　たたかう
ひつようが　ありますわね▼
あら　あら　しょうがないですわ
たたかいましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:19:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　あら　挑戦者の方？
ここまで　ご苦労様▼
ここまで　これたんだから
もう　よろしいんじゃなくて？▼
まあ　次の　エリアも
目指して　いらっしゃるの？▼
それなら　わたしと　戦う
必要が　ありますわね▼
あら　あら　しょうがないですわ
戦いましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T07:55:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア8
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:27" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミは　たたかいは　すきかい？▼
わたしは　くるひも　くるひも
たたかって　きたが　つよさの　こたえが▽
いまだに　みつからなくてね……▼
おっと　すまない▼
トレーナーが　こんなことを　
かんがえてしまったら　おしまいだな▼
さあ　キミの　めざす　つよさを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:48:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミは　戦いは　好きかい？▼
わたしは　来る日も　来る日も
戦って　来たが　強さの　答えが▽
いまだに　みつからなくてね……▼
おっと　すまない▼
トレーナーが　こんなことを　
考えてしまったら　おしまいだな▼
さあ　キミの　目指す　強さを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:48:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア9
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:38" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アデクじーちゃんの　いえで▼
やくそく　したよな！▼
どっちが　つよいか！▼
おもうぞんぶん　きそおーぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T03:43:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アデクじーちゃんの　家で▼
約束したよな！▼
どっちが　強いか！▼
思う存分　競おーぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T03:43:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:40" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　さいきょうの　トレーナーを
めざして　たたかいつづけてきたわ▼
あなたも　そうでしょう？
さいきょうとは　なにか？▼
その　こたえを　もとめて
ここまで　きたの　でしょう？▼
わたしと　たたかうことで
イッシュさいきょうが　だれか▽
その　こたえに　ちかづけるわ▼
かんきゃくは　いないけど
さいこうの　たたかいを　しましょう▼
さあ　しょうぶよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:14:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:02:35" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　最強の　トレーナーを
目指して　戦い続けてきたわ▼
あなたも　そうでしょう？
最強とは　何か？▼
その　答えを　求めて
ここまで　来たの　でしょう？▼
わたしと　戦うことで
イッシュ最強が　だれか▽
その　答えに　近づけるわ▼
観客は　いないけど
最高の　戦いを　しましょう▼
さあ　勝負よ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:02:51" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:49:51" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いぜんより　つよくなったわね
もう　しょしんしゃとは　いえないわ▼
キミが　どこまで
つよくなるのか　たのしみよ▼
また　ちょうせんしてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:42:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>以前より　強くなったわね
もう　初心者とは　言えないわ▼
キミが　どこまで
強くなるのか　楽しみよ▼
また　挑戦してね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:43:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア1
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:03" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよくなったね
しょしんしゃの　ころが　なつかしいよ▼
それとも　ボクが　よわくなったのかな▼
ボクも　まけずに　ここで　しゅぎょうが
ひつようかもね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:57:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強くなったね
初心者の　ころが　懐かしいよ▼
それとも　ボクが　弱くなったのかな▼
ボクも　負けずに　ここで　修行が
必要かもね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:59:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア2
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいも　かてなかったか
つよいわね　ほんとうに▼
わたしも　もっと　がんばらないと
つぎは　まけないわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:15:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今回も　勝てなかったか
強いわね　本当に▼
わたしも　もっと　がんばらないと
次は　負けないわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:16:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア3
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:22" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　つよくなったね
ぜんかいとは　おおちがいだ▼
キミは　どこまで　いけるように
なったんだい？▼
いつか　さいかそうに
とうたつしたら　おしえてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　強くなったね
前回とは　大違いだ▼
キミは　どこまで　行けるように
なったんだい？▼
いつか　最下層に
到達したら　教えてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア4
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:35" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やっぱり　かてなかったわね▼
キミが　どこまで　つよくなるのか
たのしみに　なってきたわ▼
つぎは　まけないように
わたしも　がんばるわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:57:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やっぱり　勝てなかったわね▼
キミが　どこまで　強くなるのか
楽しみに　なってきたわ▼
次は　負けないように
わたしも　がんばるわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:58:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア5
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:50:48" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さらに　うでを　あげたな
みとめよう　おまえは　つよい▼
もっと　つよさを　もとめるなら
さきの　エリアを　めざすんだな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:59:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さらに　腕を　上げたな
認めよう　おまえは　強い▼
もっと　強さを　求めるなら
先の　エリアを　目指すんだな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア6
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:02" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たりないわ
あなたと　もっと　たたかいたいのに▼
ぜったい　また　ここに　きてよ！
ぜったい　また　たたかいましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:35:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>足りないわ
あなたと　もっと　戦いたいのに▼
絶対　また　ここに　来てよ！
絶対　また　戦いましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:35:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア7
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　ごくろうさま▼
あれ？
まだ　たたかいたりないの？▼
キミは　よくばりだな▼
それぐらいじゃないと　このさきは
つらいのかも　しれないけど▼
まあ　きがむいたら　またおいで
あいてを　するからさ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はい　ご苦労様▼
あれ？
まだ　戦い足りないの？▼
キミは　欲張りだな▼
それぐらいじゃないと　この先は
つらいのかも　知れないけど▼
まあ　気が向いたら　またおいで
相手を　するからさ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア8
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　たたかいで
あなたの　めざす　ものに▽
すこしは　ちかづけたかしら？▼
こたえが　みつかるまで
なんどでも　あいてを　するわ▼
また　たたかいましょう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:06:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　戦いで
あなたの　目指す　ものに▽
少しは　近づけたかしら？▼
答えが　みつかるまで
何度でも　相手を　するわ▼
また　戦いましょう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:06:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア9
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:35" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゾクゾクする！▼
チャンピオンだった　じーちゃんより▼
つよい　トレーナーが　わんさかいる！▼
みんなで　きそいあえば▼
ポケモントレーナーとして▼
そして　ひと　として▼
たかみを　めざせるよな！▼
これも　ポケモンの　おかげだな！▼
また　こい！▼
もっと　たかみに　いきたいからな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:05:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゾクゾクする！▼
チャンピオンだった　じーちゃんより▼
強い　トレーナーが　わんさかいる！▼
みんなで　競いあえば▼
ポケモントレーナーとして▼
そして　人として▼
高みを　目指せるよな！▼
これも　ポケモンの　おかげだな！▼
また　来い！▼
もっと　高みに　行きたいからな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:05:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:47" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:22" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいな▼
キミは　まちがいなく　しろのじゅどう
さいきょうの　トレーナーだ▼
だが　イッシュさいきょうか
どうかは　わからない……▼
まだみぬ　きょうしゃは
いくらでも　いるからな▼
さいきょうを　めざし
しょうじん　するんだな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:48:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:01:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いな▼
キミは　間違いなく
白の樹洞　最強の　トレーナーだ▼
だが　イッシュ最強か
どうかは　わからない……▼
まだみぬ　強者は
いくらでも　いるからな▼
最強を　目指し
精進するんだな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:48:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:45" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>最上階、色違い用</Comment>
			<CommentModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:02:09" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いぜんより　てごわくなったね
もう　しょしんしゃとは　いえないな▼
キミが　どこまで
つよくなるのか　たのしみだよ▼
また　ちょうせんして　くれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:40:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>以前より　手強くなったね
もう　初心者とは　言えないな▼
キミが　どこまで
強くなるのか　楽しみだよ▼
また　挑戦して　くれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:41:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア1
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:51:55" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよくなったわね
しょしんしゃの　ころが　なつかしいわ▼
それとも　わたし　よわくなったのかな▼
わたしも　まけずに
ここでの　しゅぎょうが　ひつようね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:07:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強くなったね
初心者の　ころが　懐かしいわ▼
それとも　わたし　弱くなったのかな▼
わたしも　負けずに
ここでの　修行が　必要ね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:07:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア2
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:04" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいも　かてなかったか
つよいね　ほんとうに▼
ボクも　もっと　がんばらないと
つぎは　まけないぞ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:17:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今回も　勝てなかったか
強いね　本当に▼
ボクも　もっと　がんばらないと
次は　負けないぞ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:17:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア3
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　つよくなったわね
ぜんかいとは　おおちがいよ▼
キミは　どこまで　いけるように
なったのかしら？▼
いつか　さいじょうかいに
とうたつしたら　おしえてね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:07:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　強くなったわね
前回とは　大違いよ▼
キミは　どこまで　行けるように
なったのかしら？▼
いつか　最上階に
到達したら　教えてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア4
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やっぱり　かてなかったか▼
キミが　どこまで　つよくなるのか
たのしみに　なってきたよ▼
つぎは　まけないように
こっちも　がんばるよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:32:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やっぱり　勝てなかったか▼
キミが　どこまで　強くなるのか
楽しみに　なってきたよ▼
次は　負けないように
こっちも　がんばるよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:32:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア5
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さらに　うでを　あげたわね
あなたの　つよさを　みとめるわ▼
もっと　つよさを　もとめるなら
さきの　エリアを　めざしなさい▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:33:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さらに　腕を　上げたわね
あなたの　強さを　認めるわ▼
もっと　強さを　求めるなら
先の　エリアを　目指しなさい▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:34:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア6
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:42" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これじゃ　たりない！▼
おれは　もっと　もっと
たたかいたい！▼
ぜったい　また　ここに　こいよ！
ぜったい　また　たたかうぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:36:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これじゃ　足りない！▼
おれは　もっと　もっと
戦いたい！▼
絶対　また　ここに　来いよ！
絶対　また　戦うぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:36:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア7
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:52:53" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　ごくろうさま▼
あら？
まだ　たたかいたりないかしら？▼
ごうよく　ですこと……▼
それぐらいの　きもちが　ないと
このさきは　つらいのかもね▼
まあ　きがむいたら　おいでなさい
おあいてしますわ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:08:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はい　ご苦労様▼
あら？
まだ　戦い足りないのかしら？▼
強欲　ですこと……▼
それぐらいの　気持ちが　ないと
この先は　つらいのかもね▼
まあ　気が向いたら　おいでなさい
お相手しますわ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:08:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア8
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:53:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　たたかいで　キミの
めざすものに　すこしは
ちかづけたかい？▼
こたえが　みつかるまで
なんどでも　あいてを　するよ▼
また　たたかおう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:40:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　戦いで　キミの
目指すものに　少しは
近づけたかい？▼
答えが　みつかるまで
何度でも　相手を　するよ▼
また　戦おう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:41:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア9
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:53:20" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゾクゾクする！▼
チャンピオンだった　じーちゃんより▼
つよい　トレーナーが　わんさかいる！▼
みんなで　きそいあえば▼
ポケモントレーナーとして▼
そして　ひと　として▼
たかみを　めざせるよな！▼
これも　ポケモンの　おかげだな！▼
また　こい！▼
もっと　たかみに　いきたいからな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:04:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゾクゾクする！▼
チャンピオンだった　じーちゃんより▼
強い　トレーナーが　わんさかいる！▼
みんなで　競いあえば▼
ポケモントレーナーとして▼
そして　人として▼
高みを　目指せるよな！▼
これも　ポケモンの　おかげだな！▼
また　来い！▼
もっと　高みに　行きたいからな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:05:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:45:59" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:36:27" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいわね▼
あたなは　まちがいなく
くろのまてんろう　さいきょうの▽
トレーナーだわ▼
だけど　イッシュさいきょうか
どうかは　わからない……▼
まだみぬ　きょうしゃは
いくらでも　いるわ▼
さいきょうを　めざし
しょうじん　しなさい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:08:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いわね▼
あたなは　間違いなく
黒の摩天楼　最強の　トレーナーだわ▼
だけど　イッシュ最強か
どうかは　わからない……▼
まだみぬ　強者は
いくらでも　いるわ▼
最強を　目指し　精進しなさい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:08:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:53:32" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おどろいたよ　そうぞういじょうだ▼
それじゃ　さいごに　ボクから
やくだつヒントを　あげるよ▼
ここに　くるまで　いろいろな
トレーナーが　いただろう？▼
それぞれ　しっている　じょうほうが
ちがうことに　きがついたかい？▼
ボストレーナーが　どこにいるかとか
ドクターの　いるばしょを▽
しっているひとも　いるみたいだよ▼
いろいろな　トレーナーと　たたかって
こうりゃくほうほうを　さがしてごらん▼
それじゃ　キミの　かつやくを
たのしみに　しているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-10-29T06:58:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>驚いたよ　想像以上だ▼
それじゃ　最後に　ボクから
役立つヒントを　あげるよ▼
ここに　来るまで　いろいろな
トレーナーが　いただろう？▼
それぞれ　知っている　情報が
違うことに　気がついたかい？▼
ボストレーナーが　どこにいるかとか
ドクターの　いる場所を▽
知っている人も　いるみたいだよ▼
いろいろな　トレーナーと　戦って
攻略方法を　探してごらん▼
それじゃ　キミの　活躍を
楽しみに　しているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-10-29T06:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア1
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:54:02" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おめでとう
これで　しょしんしゃ　そつぎょうね▼
エリア２　クリアの　きねんに
エリア３の　ヒントを　すこしあげるわ▼
エリア３からは　エリアないの
かいそうが　ふえるの▼
いまいる　かいで　ボストレーナーを
みつけられないときは▽
べつの　かいそうを　さがしなさい▼
べつの　かいそうには　
エレベーターで　いどうしてね▼
さきは　ながいわよ
つぎの　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:38:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:11:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おめでとう
これで　初心者　卒業ね▼
エリア2　クリアの　きねんに
エリア3の　ヒントを　少しあげるわ▼
エリア3からは　エリア内の
階層が　増えるの▼
今いる　階で　ボストレーナーを
みつけられないときは▽
別の　階層を　探しなさい▼
別の　階層には　
エレベーターで　移動してね▼
先は　長いわよ
次の　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:39:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア2
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:54:15" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた……▼
ほんとうに　さいきんの　こどもは
ようしゃないんだな▼
キミの　つよさも　よくわかったよ
これで　エリア３も　クリアだ▼
キミが　どこまで　いけるのか
たのしみに　しているよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:09:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた……▼
本当に　最近の　子供は
容赦ないんだな▼
キミの　強さも　よくわかったよ
これで　エリア３も　クリアだ▼
キミが　どこまで　行けるのか
楽しみに　しているよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:09:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア3
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:55:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいったわ
キミ　つよいわね▼
キミなら　さいじょうかいまで
たどりつけるかも　しれないわね▼
つぎの　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:42:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まいったわ
キミ　強いね▼
キミなら　最上階まで
たどり着けるかも　しれないわね▼
次の　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:43:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア4
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:00" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さっきの　しょうねんと　どうとう
いや　それいじょうの　つよさだな▼
キミが　ここで　たたかいつづければ
あのしょうねんと　たたかう　ひが▽
くるかもしれないな▼
キミたちの　たたかい……
みてみたいものだ▼
では　また　たたかおう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:09:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さっきの　少年と　同等
いや　それ以上の　強さだな▼
キミが　ここで　戦い続ければ
あの少年と　戦う日が▽
来るかもしれないな▼
キミたちの　戦い……
みてみたいものだ▼
では　また　戦おう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:09:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア5
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:12" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうさん　こうさんよ
まけたわ▼
ポケモンの　つよさに　ねんれいは
かんけいないわね▼
でも　ここから　さきは
たたかうことを　いきがいに▽
しているような　ひとばかりよ▼
あなたの　ほんきが　どこまで
つうようするのか　たのしみだわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:53:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>降参　降参よ
負けたわ▼
ポケモンの　強さに　年齢は
関係ないわね▼
でも　ここから　先は
戦うことを　生きがいに▽
しているような　人ばかりよ▼
あなたの　本気が　どこまで
通用するのか　楽しみだわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:24:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア6
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけた　まけた！
ここまで　まけたのは　ひさしぶりだ▼
ほら　つぎの　エリアに　いきな▼
おれは　つぎの　ちょうせんしゃを
まつからさ▼
つぎは　だれだ？
はやく　たたかわせろ！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:56:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けた　負けた！
ここまで　負けたのは　久しぶりだ▼
ほら　次の　エリアに　行きな▼
おれは　次の　挑戦者を
待つからさ▼
次は　だれだ？
早く　戦わせろ！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア7
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:32" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　あら　まけてしまいました
おつよいのね▼
それだけ　つよいのに
まだ　さきを　めざすのね▼
あなたは　どこまで　いくのかしら
おわりは　あるのかしら？▼
あなたが　めざす　ゴールに
たどりつけることを　いのっているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:02:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　あら　負けてしまいました
お強いのね▼
それだけ　強いのに
まだ　先を　目指すのね▼
あなたは　どこまで　行くのかしら
終わりは　あるのかしら？▼
あなたが　目指す　ゴールに
たどり着けることを　祈っているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:03:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア8
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:42" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしい　つよさだ▼
キミは　わたしの　さがす　つよさを
もっているのかも　しれないな▼
いぜん　たたかった　しょうねんも
おなじ　つよさを　かんじたよ▼
いつかおしえてくれ
キミたちが　みつけた　つよさを▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:09:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>素晴らしい　強さだ▼
キミは　わたしの　探す　強さを
持っているのかも　知れないな▼
以前　戦った　少年も
同じ　強さを　感じたよ▼
いつか教えてくれ
キミたちが　みつけた　強さを▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:09:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア9
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:56:53" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゾクゾクする！▼
おまえと！▼
ポケモンたちの　コンビネーション！▼
さいこうの　チームワークだった▼
ひとだけでは　いけない　ばしょ▼
ポケモンが　いこうとしない　ばしょ▼
おまえみたいに！　おいらのように！▼
トレーナーと　ポケモンの▼
チームワークなら　どこでも　いける▼
それが　わかって　うれしいぜ！▼
おい！▼
じーちゃんの　いえに　こいよ！▼
わかるだろ　サンギタウンの！▼
すごいもの　わたすからな！▼
おいらとの　やくそく　だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:35:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゾクゾクする！▼
おまえと！▼
ポケモンたちの　コンビネーション！▼
最高の　チームワークだった▼
人だけでは　行けない　場所▼
ポケモンが　行こうとしない　場所▼
おまえみたいに！　おいらのように！▼
トレーナーと　ポケモンの▼
チームワークなら　どこでも　行ける▼
それが　わかって　うれしいぜ！▼
おい！▼
じーちゃんの　家に　来いよ！▼
わかるだろ　サンギタウンの！▼
すごいもの　渡すからな！▼
おいらとの　約束だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:35:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:46:06" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいわね▼
これほどの　つよさを　もった
トレーナーは　はじめてよ▼
わたしの　しょうがい　さいこうの
たたかいだったわ▼
さいきょうへの　こたえは
みえたかしら？▼
あなたなら　いつか　さいきょうへの
みちが　ひらけるかも　しれないわね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:16:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:03:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いわね▼
これほどの　強さを　持った
トレーナーは　はじめてよ▼
わたしの　生涯
最高の　戦いだったわ▼
最強への　答えは　みえたかしら？▼
あなたなら　いつか　最強への
道が　開けるかも　知れないわね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:17:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:05" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おどろいたわ　よそういじょうよ▼
それじゃ　さいごに　わたしから
やくだつヒントを　あげるわ▼
ここに　くるまで　いろいろな
トレーナーが　いたでしょう？▼
それぞれ　しっている　じょうほうが
ちがうことに　きがついたかしら？▼
ボストレーナーが　どこにいるかとか
ナースの　いるばしょを▽
しっているひとも　いるみたよ▼
いろいろな　トレーナーと　たたかって
こうりゃくほうほうを　さがしてみて▼
それじゃ　キミの　かつやくを
たのしみに　しているわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-10-29T06:58:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>驚いたわ　予想以上よ▼
それじゃ　最後に　わたしから
役立つヒントを　あげるわ▼
ここに　来るまで　いろいろな
トレーナーが　いたでしょう？▼
それぞれ　知っている　情報が
違うことに　気がついたかしら？▼
ボストレーナーが　どこにいるかとか
ナースが　いる場所を▽
知っている人も　いるみたよ▼
いろいろな　トレーナーと　戦って
攻略方法を　探してみて▼
それじゃ　キミの　活躍を
楽しみに　しているわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-10-29T06:58:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア1
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:15" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おめでとう
これで　しょしんしゃ　そつぎょうだな▼
エリア２　クリアの　きねんに
エリア３の　ヒントを　すこしおしえよう▼
エリア３からは　エリアないの
かいそうが　ふえるぞ▼
いまいる　かいで　ボストレーナーを
みつけられないときは▽
べつの　かいそうを　さがすんだ▼
べつの　かいそうには　
エレベーターで　いどうするんだぞ▼
さきは　ながいぞ
つぎの　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:40:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:11:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おめでとう
これで　初心者　卒業だな▼
エリア2　クリアの　記念に
エリア3の　ヒントを　少し教えよう▼
エリア3からは　エリア内の
階層が　増えるぞ▼
今いる　階で　ボストレーナーを
みつけられないときは▽
別の　階層を　探すんだ▼
別の　階層には　
エレベーターで　移動するんだぞ▼
先は　長いぞ
次の　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:42:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア2
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:28" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた　……▼
ほんとうに　さいきんの　こどもは
ようしゃないわね▼
キミの　つよさも　よくわかったわ
これで　エリア３も　クリアよ▼
キミが　どこまで　いけるのか
たのしみに　しているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:27:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:11:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた　……▼
本当に　最近の　子供は
容赦ないわね▼
キミの　強さも　よくわかったわ
これで　エリア3も　クリアよ▼
キミが　どこまで　行けるのか
楽しみに　しているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:27:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア3
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:41" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいったよ
キミ　つよいな▼
キミなら　さいかそうまで
たどりつけるかも　しれないな▼
つぎの　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:22:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まいったよ
キミ　強いな▼
キミなら　最下層まで
たどり着けるかも　知れないな▼
次の　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:23:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア4
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:57:52" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さっきの　しょうねんと　どうとう
いや　それいじょうの　つよさね▼
キミが　ここで　たたかいつづければ
あのしょうねんと　たたかうひが▽
くるかもしれないわね▼
キミたちの　たたかい　……
きょうみぶかいわ▼
それじゃ　また　たたかいましょうね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:26:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さっきの　少年と　同等
いや　それ以上の　強さね▼
キミが　ここで　戦い続ければ
あの少年と　戦う日が▽
来るかもしれないわね▼
キミたちの　戦い　……
興味深いわ▼
それじゃ　また　戦いましょうね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:24:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア5
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:08" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうさん　こうさんだ
まけたよ▼
ポケモンの　つよさに　ねんれいは
かんけいないな▼
だが　ここから　さきは
たたかうことを　いきがいに▽
しているような　やつばかりだぞ▼
おまえの　ほんきが　どこまで
つうようするのか　たのしみだよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:27:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>降参　降参だ
負けたよ▼
ポケモンの　強さに　年齢は
関係ないな▼
だが　ここから　先は
戦うことを　生きがいに▽
しているような　やつばかりだぞ▼
おまえの　本気が　どこまで
通用するのか　楽しみだよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T12:26:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア6
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:18" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんぱいよ！
ここまで　まけたのは　ひさしぶりね▼
ほら　つぎの　エリアに　いきなさい▼
わたしは　つぎの　ちょうせんしゃを
まつことに　するわ▼
つぎは　だれ？
はやく　たたかわせなさい！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:37:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>完敗よ！
ここまで　負けたのは　久しぶりね▼
ほら　次の　エリアに　いきなさい▼
わたしは　次の　挑戦者を
待つことに　するわ▼
次は　だれ？
早く　戦わせなさい！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-28T02:25:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア7
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:28" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　ああ　まけちゃったね
つよいんだね▼
それだけ　つよいのに
まだ　さきを　めざすんだね▼
キミは　どこまで　いくの？
おわりは　あるのかな？▼
キミが　めざす　ゴールに
たどりつけることを　いのっているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:41:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　ああ　負けちゃったね
強いんだね▼
それだけ　強いのに
まだ　先を　目指すんだね▼
キミは　どこまで　行くの？
終わりは　あるのかな？▼
キミが　目指す　ゴールに
たどり着けることを　祈っているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:42:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア8
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:39" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしいつよさね▼
あなたは　わたしの　さがす　つよさを
もっているのかも　しれないわ▼
いぜん　たたかった　しょうねんも
おなじ　つよさを　かんじたわ▼
いつか　おしえて　ほしいわね
キミたちが　みつけた　つよさを▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:42:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>素晴らしい強さね▼
あなたは　わたしの　探す　強さを
持っているのかも　知れないわ▼
以前　戦った　少年も
同じ　強さを　感じたわ▼
いつか　教えて　欲しいわね
キミたちが　みつけた　強さを▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:42:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア9
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:58:50" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゾクゾクする！▼
おまえと！▼
ポケモンたちの　コンビネーション！▼
さいこうの　チームワークだった▼
ひとだけでは　いけない　ばしょ▼
ポケモンが　いこうとしない　ばしょ▼
おまえみたいに！　おいらのように！▼
トレーナーと　ポケモンの▼
チームワークなら　どこでも　いける▼
それが　わかって　うれしいぜ！▼
おい！▼
じーちゃんの　いえに　こいよ！▼
わかるだろ　サンギタウンの！▼
すごいもの　わたすからな！▼
おいらとの　やくそく　だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:35:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゾクゾクする！▼
おまえと！▼
ポケモンたちの　コンビネーション！▼
最高の　チームワークだった▼
人だけでは　行けない　場所▼
ポケモンが　行こうとしない　場所▼
おまえみたいに！　おいらのように！▼
トレーナーと　ポケモンの▼
チームワークなら　どこでも　行ける▼
それが　わかって　うれしいぜ！▼
おい！▼
じーちゃんの　家に　来いよ！▼
わかるだろ　サンギタウンの！▼
すごいもの　渡すからな！▼
おいらとの　約束だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:35:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:46:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:35:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいな▼
これほどの　つよさを　もった
トレーナーは　はじめてだ▼
わたしの　しょうがい　さいこうの
たたかいだったよ▼
さいきょうへの　こたえは
みえたかい？▼
キミなら　いつか　さいきょうへの
みちが　ひらけるかも　しれないな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:47:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:05:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いな▼
これほどの　強さを　持った
トレーナーは　はじめてだ▼
わたしの　生涯
最高の　戦いだったよ▼
最強への　答えは　みえたかい？▼
キミなら　いつか　最強への
道が　開けるかも　知れないな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:49:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:59:01" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_doctor_msg_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンが　つかれているようだ
かいふくして　あげようか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンが　つかれているようだ
回復して　あげようか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:12:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ドクター共通回復確認</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:59:18" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_doctor_msg_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わっかた　かいふくしたくなったら
ここに　くるといい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わかった　回復したくなったら
ここに　来るといい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ドクター共通回復拒否</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:59:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_doctor_msg_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たんれんも　いいが　ポケモンに
あまり　むり　させないようにな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鍛錬も　いいが　ポケモンに
あまり　無理　させないようにな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ドクター共通回復後</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:59:27" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_nurse_msg_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　ポケモンが　おつかれね
かいふくして　あげましょうか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　ポケモンが　おつかれね
回復して　あげましょうか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:12:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ナース共通回復確認</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:59:31" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_nurse_msg_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わかったわ
でも　むりは　きんもつよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わかったわ
でも　無理は　禁物よ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ナース共通回復拒否</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:59:35" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
