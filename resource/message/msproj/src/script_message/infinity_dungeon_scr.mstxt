	<TextRow
		Label="msg_info_b_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いらっしゃいませ
くろのまてんろうに　ようこそ！▼
それでは　ごようけんを
おつたえください</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:43:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:26:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いらっしゃいませ
黒の摩天楼に　ようこそ！▼
それでは　ご用件を　お伝えください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:41:29" />
			<Status>Editing</Status>
