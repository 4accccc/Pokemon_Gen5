				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いらっしゃいませ
くろのまてんろうに　ようこそ！▼
それでは　ごようけんを
おつたえください</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:43:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:26:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いらっしゃいませ
黒の摩天楼に　ようこそ！▼
それでは　ご用件を　お伝えください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:41:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:22:33" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　エリアに
ちょうせんなさいますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:26:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:26:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの　エリアに
挑戦なさいますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:23:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:22:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_03_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　エリアに
ちょうせんなさいますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:42:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:27:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　エリアに
挑戦なさいますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:42:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:23:07" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅんびは　よろしいですか？
それでは　がんばてくださいね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:51:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:27:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>準備は　よろしいですか？
それでは　がんばってくださいね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:51:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:23:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_help_b_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　しせつは　トレーナーの
みなさまに　たんれんの　ばしょとして▽
ていきょうされている　しせつです▼
しせつないには　[Name:TrainerName Idx="0" ]さまと
おなじく　しせつ　ちょうせんちゅうの▽
トレーナーのかたが　いらっしゃいます▼
ほかの　トレーナーのかたは
[Name:TrainerName Idx="0" ]さまを　みかけましたら▽
たいせんを　いどんできます▼
たちふさがる　トレーナーを　たおし
エリアクリアを　めざして　ください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:06:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:27:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　施設は　トレーナーの
皆様に　鍛錬の　場所として▽
提供されている　施設です▼
施設内には　[Name:TrainerName Idx="0" ]様と
同じく　施設　挑戦中の▽
トレーナーの方が　いらっしゃいます▼
ほかの　トレーナーの方は
[Name:TrainerName Idx="0" ]様を　見かけましたら▽
対戦を　挑んできます▼
立ちふさがる　トレーナーを　倒し
エリアクリアを　目指して　ください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:25:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:23:38" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:19:33" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_help_b_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリアクリアには　エリアの
どこかにいる　ボストレーナーを▽
たおすことで▼
つぎのエリアに　ちょうせんすることが
できます▼
エリアにいる　トレーナーと
たいせんして　うでを　みがくもよし▼
ボストレーナーを　さがしだし
エリアクリアを　めざすもよし▼
じぶんの　つよさの　げんかいに　
ちょうせんしてみては▽
いかがでしょうか？▼
なお　しせつないでは　
バッグにある　どうぐの　しようを▽
きんししております▼
あらかじめ　ごりょうしょうください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:13:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:28:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エリアクリアには　エリアの
どこかにいる　ボストレーナーを▽
倒すことで▼
次のエリアに　挑戦することが
できます▼
エリアにいる　トレーナーと
対戦して　腕を　磨くもよし▼
ボストレーナーを　探し出し
エリアクリアを　目指すもよし▼
自分の　強さの　限界に　
挑戦してみては▽
いかがでしょうか？▼
なお　施設内では　
バッグにある　どうぐの　使用を▽
禁止しております▼
あらかじめ　ご了承ください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:26:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:25:15" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_attention_b_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま！▼
しつれいですが　おつれの
[Name:PokemonNickname Idx="1" ]では▼
エリア[Digit:2digits Idx="2" ]に　ちょうせんするには
しょうしょう　じつりょくが　たりません▼
エリア[Digit:2digits Idx="2" ]には
レベル[Digit:2digits Idx="3" ]いじょうの　ポケモンで▽
ちょうせんしてください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:01:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T09:59:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様！▼
失礼ですが　お連れの
[Name:PokemonNickname Idx="1" ]では▼
エリア[Digit:2digits Idx="2" ]に　挑戦するには
少々　実力が　足りません▼
エリア[Digit:2digits Idx="2" ]には
レベル[Digit:2digits Idx="3" ]以上の　ポケモンで▽
挑戦してください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:00:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:26:32" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・ニックネーム＝ポケモン名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:19:47" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_attention_b_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま！▼
タマゴを　おもちの　ばあい
エリア[Digit:2digits Idx="1" ]に▽
ちょうせんすることは　できません▼
もうしわけありませんが
タマゴを　おあずけに　なってから▽
ちょうせんしてください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T04:49:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T09:59:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様！▼
タマゴを　お持ちの　場合
エリア[Digit:2digits Idx="1" ]に▽
挑戦することは　できません▼
申し訳ありませんが
タマゴを　お預けに　なってから▽
挑戦してください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T04:49:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:26:32" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T04:49:03" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_cancel_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それでは　またの　ごりようを
おまして　おります</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:01:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それでは　またの　ご利用を
お待ちして　おります</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:27:32" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま！▼
エリア[Digit:2digits Idx="1" ]の　クリア
おめでとうございます！▼
きねんに　こちらの　しょうひんを
どうぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:58:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:01:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様！▼
エリア[Digit:2digits Idx="1" ]の　クリア
おめでとうございます！▼
記念に　こちらの　商品を
どうぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:27:53" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:20:22" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あわせて　エリア[Digit:2digits ]への
ちょうせんが　かのうと　なりました▼
ひきつづき　ちょうせんを
おまちして　おります▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:02:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>合せて　エリア[Digit:2digits ]への
挑戦が　可能と　なりました▼
引き続き　挑戦を
お待ちして　おります▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:31:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:20:29" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_03_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま▼
じつは　このしせつには
いっぱんには　こうかいされていない▽
とくべつな　エリアが　ございます▼
それが　エリア６いこうの　エリアです▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:18:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:18:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様▼
じつは　この施設には
一般には　公開されていない▽
特別な　エリアが　ございます▼
それが　エリア６以降の　エリアです▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:32:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:32:20" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:20:00" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こちらの　エレベーターには
おきづきでしたか？▼
この　エレベーターに　のることで
エリア６いこうの　ちょうせんが▽
かのうとなります▼
ただし！　エリア6いこうは
われわれの　かんりがいの　エリアのため▼
どんな　トレーナーが　いるのか
はあくしていない　じょうたいです▼
きけんは　ないと　おもうのですが　……▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:54:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:19:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こちらの　エレベーターには
お気づきでしたか？▼
この　エレベーターに　乗ることで
エリア6以降の　挑戦が▽
可能となります▼
ただし！　エリア6以降は
我々の　管理外の　エリアのため▼
どんな　トレーナーが　いるのか
把握していない　状態です▼
危険は　ないと　思うのですが　……▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:54:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:32:31" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_05_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とにかく　エリア６いこうの　
ちょうせんを　おかんがえなら▼
ポケモンを　じゅうぶんに　
そだててからの▽
ちょうせんを　おすすめします▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:36:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:36:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とにかく　エリア6いこうの　
挑戦を　お考えなら▼
ポケモンを　十分に　
育ててからの▽
挑戦を　お勧めします▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:36:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:34:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_06_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま！▼
……　まさか　すべての　エリアを？▼
おどろきました
おめでとうございます！▼
エリアせいはを　たたえ
こちらの　きねんひんを　さしあげます▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:58:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:04:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様！▼
……　まさか　全ての　エリアを？▼
驚きました
おめでとうございます！▼
エリア制覇を　称え
こちらの　記念品を　差し上げます▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:58:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:38:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:20:03" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_07_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これからも　さいきょうの
トレーナーを　めざして▽
がんばってくださいね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:04:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これからも　最強の
トレーナーを　目指し▽
がんばってくださいね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:39:08" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よう！　よくきたな
ここは　しろのじゅどうだ
きょうは　なにを　するんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:42:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よう！　よく来たな
ここは　白の樹洞だ
今日は　何を　するんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:45:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　エリアに
ちょうせんするんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:49:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの　エリアに
挑戦するんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:50:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_03_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　エリアに
ちょうせんするか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:42:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　エリアに
挑戦するか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:42:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅんびが　できたようだな
やれるだけ　やってこい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:50:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>準備が　できたようだな
やれるだけ　やってこい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:52:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_help_w_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　しせつは　おまえら
トレーナーの　たんれんの　ばしょとして▽
ていきょうされている　しせつだ▼
しせつないには　おまえと　おなじように
しせつを　ちょうせんちゅうの▽
トレーナーが　いる▼
ほかの　トレーナーは　おまえを
みかけたら　たいせんを▽
いどんでくるぞ▼
たちふさがる　トレーナーを　たおし
エリアとっぱを　めざすんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:53:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　施設は　お前ら
トレーナーの　鍛錬の　場所として▽　
提供されている　施設だ▼
施設内には　お前と　同じように
施設を　挑戦中の▽
トレーナーが　いる▼
他の　トレーナーは　お前を
見かけたら　対戦を　挑んでくるぞ▼
立ちふさがる　トレーナーを　倒し
エリア突破を　目指すんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:54:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_help_w_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリアクリアには　エリアの　
どこかにいる　ボストレーナーを▽
たおすことで▼
つぎのエリアに　ちょうせんすることが
できるぜ▼
エリアにいる　トレーナーと　
たいせんして　うでを　みがくもよし▼
ボストレーナーを　さがしだし
エリアクリアを　めざすもよし▼
じぶんの　つよさの　げんかいに　
ちょうせんしてみな▼
よのなかには　つよいやつは
たくさんいるからな▼
そうそう　しせつないでは
バッグの　どうぐは▽
つかえないからな▼
おぼえておけよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:55:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エリアクリアには　エリアの
どこかにいる　ボストレーナーを▽
倒すことで▼
次のエリアに　挑戦することが
できるぜ▼
エリアにいる　トレーナーと　
対戦して　腕を　磨くもよし▼
ボストレーナーを　探しだし
エリアクリアを　目指すもよし▼
自分の　強さの　限界に　　
挑戦してみな▼
世の中には　強いやつは　
沢山いるからな▼
そうそう　施設内では
バッグの　どうぐは▽
使えないからな▼
覚えておけよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:56:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_attention_w_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！▼
ちょっとまて！　つれている
[Name:PokemonNickname Idx="1" ]じゃ▼
エリア[Digit:2digits Idx="2" ]に　ちょうせんするには
じつりょくぶそくだな▼
エリア[Digit:2digits Idx="2" ]には
レベル[Digit:2digits Idx="3" ]いじょうの　ポケモンで▽
ちょうせんしてくれ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:43:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]！▼
ちょっと待て！　連れている
[Name:PokemonNickname Idx="1" ]じゃ▼
エリア[Digit:2digits Idx="2" ]に　挑戦するには
実力不足だな▼
エリア[Digit:2digits Idx="2" ]には
レベル[Digit:2digits Idx="3" ]以上の　ポケモンで▽
挑戦してくれ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:15:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・ニックネーム＝ポケモン名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:04" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_attention_w_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！▼
タマゴを　もっているときは
エリア[Digit:2digits Idx="1" ]に　ちょうせんすることは▽
できないぞ▼
わるいが　タマゴを　あずけてから
ちょうせんしてくれ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:17:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]！▼
タマゴを　持っているときは
エリア[Digit:2digits Idx="1" ]に　挑戦することは▽
できないぞ▼
悪いが　タマゴを　預けてから
挑戦してくれ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:17:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:17:48" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_cancel_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それじゃ　またきてくれよ</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:12:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それじゃ　また来てくれよ</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！▼
エリア[Digit:2digits Idx="1" ]を　クリアしたようだな▼
クリアの　きねんだ
もっていきな！</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:21:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]！▼
エリア[Digit:2digits Idx="1" ]を　クリアしたようだな▼
クリアの　記念だ
持っていきな！</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:04" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それと　エリア[Digit:2digits ]への
ちょうせんが　できるように　なったぞ▼
つぎの　エリアも　ちょうせんして
くれよな</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:22:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それと　エリア[Digit:2digits ]への
挑戦が　できるように　なったぞ▼
次の　エリアも　挑戦して　くれよな</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:22:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:11" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_03_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]▼
じつは　このしせつには
いっぱんには　こうかいしていない▽
とくべつな　エリアが　あるんだ▼
それが　エリア６いこうの　エリアだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:03:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]▼
じつは　この施設には
一般には　公開されていない▽
特別な　エリアが　あるんだ▼
それが　エリア６以降の　エリアだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:03:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:19" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こっちの　エレベーターが
おまえも　きになっていたんじゃないか？▼
この　エレベーターに　のることで
エリア６いこうの　ちょうせんが　できるぜ▼
ただし！　エリア６いこうは
おれたちの　かんりがいの　エリアだ▼
すまんが　どんな　トレーナーが　いるのか
よくわからないんだ▼
きけんは　ないと　おもうがな　……▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:03:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こっちの　エレベーターが
お前も　気になっていたんじゃないか？▼
この　エレベーターに　乗ることで
エリア６以降の　挑戦が　できるぜ▼
ただし！　エリア６以降は
おれたちの　管理外の　エリアだ▼
すまんが　どんな　トレーナーが　いるのか
よくわからないんだ▼
危険は　ないと　思うがな　…▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:04:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_05_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とにかく　エリア6いこうの　
ちょうせんを　かんがえているなら▼
ポケモンを　じゅうぶんに　
そだててから　ちょうせんするんだな▼
いままでと　おなじだと　おもっていると
いたいめを　みるぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:05:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とにかく　エリア6以降の　
挑戦を　考えているなら▼
ポケモンを　十分に　育ててから
挑戦するんだな▼
今までと　同じだと　思っていると
痛い目を　みるぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:05:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_06_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！▼
……　まさか　すべての　エリアを？▼
こいつは　おどろいだぜ
たいしたやつだ　おまえは！▼
エリアせいはの　きねんだ
こいつを　もっていきな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]！▼
……　まさか　全ての　エリアを？▼
こいつは　驚いたぜ
大した奴だ　お前は▼
エリア制覇の　記念だ
こいつを　持っていきな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:23" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_07_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これで　まんぞくするなよ？▼
さいきょうの　トレーナーを　めざし
しょうじんしろよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これで　満足するなよ？▼
最強の　トレーナーを　目指し
精進しろよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
