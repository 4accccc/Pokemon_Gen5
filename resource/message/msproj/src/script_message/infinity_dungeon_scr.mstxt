	<TextRow
		Label="msg_doctor_msg_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たんれんも　いいが　ポケモンに
あまり　むり　させないようにな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鍛錬も　いいが　ポケモンに
あまり　無理させないようにな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:49:56" />
