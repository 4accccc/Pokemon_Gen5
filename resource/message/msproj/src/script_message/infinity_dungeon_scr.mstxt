				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリア6からは　さらに　てごわい
トレーナーが　おまちしております▼
また　エリア6からは　パートナーとの
ちょうせんが　できません▼
ごりょうしょうください▼
さらなる　エリアを　めざし▽
ひきつづき　ちょうせんを
おまちして　おります▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エリア６からは　さらに　手ごわい
トレーナーが　お待ちしております▼
また　エリア6からは　パートナーとの
挑戦が　できません▼
ご了承ください▼
さらなる　エリアを　目指し▽
引き続き　挑戦を　
お待ちして　おります▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0"]さま！▼
……　まさか　すべての　エリアを？▼
おどろきました　この　しせつで
はじめての　かいきょですよ！▼
おめでとうございます▼
これからも　さいきょうの　
トレーナーを　めざして▽
がんばってくださいね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0"]様！▼
……　まさか　全ての　エリアを？▼
驚きました　この　施設で
はじめての　快挙ですよ！▼
おめでとうございます▼
これからも　最強の　
トレーナーを　目指して▽
がんばってくださいね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_event_b_01_a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やぁ！　キミも　くろのまてんろうに
ちょうせんしに　きたのかい？▼
もくてきは　なに？▼
おかね？
さいかそうへの　ちょうせん？▼
それとも　ポケモンの　いくせい？
まあ　どれでもいいけど　……▼
ボクは　つよい　トレーナーを
さがしているんだ▼
キミが　このばしょで
もっと　つよくなったら▽
たたかうことも　あるかもね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やぁ！　キミも　黒の摩天楼に
挑戦しに　来たのかい？▼
目的は　なに？▼
お金？
最下層への　挑戦？▼
それとも　ポケモンの　育成？
まあ　どれでもいいけど　……▼
ボクは　強い　トレーナーを
探しているんだ▼
キミが　この場所で
もっと　強くなったら▽
戦うことも　あるかもね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
