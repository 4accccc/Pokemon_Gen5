	<TextRow
		Label="msg_hint_unknown_03">
		<LanguageCell
			Language="JPN">
			<Text>なかなか　やるな！
ほかの　トレーナーに　まけるなよ！</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T08:27:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
