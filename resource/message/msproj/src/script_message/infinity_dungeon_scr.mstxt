	<TextRow
		Label="msg_w_boss_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せんとう　かいし　ほわいと　最上階　別ばーじょん▼</Text>
			<TextModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:00:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:00:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>せんとう　かいし　ほわいと　最上階　別ばーじょん▼</Text>
			<TextModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:00:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:00:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>最上階でかつ、バージョン違いに登場するトレーナー用</Comment>
			<CommentModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:00:02" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　ちょうせんしてくれて
うれしいよ▼
さあ　キミの　ポケモンの　ちからを
みせてもらうよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　挑戦してくれて
うれしいよ▼
さあ　キミの　ポケモンの　力を
見せてもらうよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
