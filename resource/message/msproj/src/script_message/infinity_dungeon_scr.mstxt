	<TextRow
		Label="msg_hint_unknown_05">
		<LanguageCell
			Language="JPN">
			<Text>まいった　まいった
かんぱいだよ</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:17:13" />
			<Status>Editing</Status>
