<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_w_boss_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　ちょうせんしてくれて
うれしいわ▼
さあ　あれから　どれだけ
せいちょうしたか　みせてもらうわよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:44:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　挑戦してくれて
うれしいわ▼
さあ　あれから　どれだけ
成長したか　見せてもらうわよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:44:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア1</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:10" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アドバイス　……
は　もう　いらないね▼
キミが　どれだけ　
つよくなったか　ためしてあげよう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:53:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アドバイス　……
は　もう　いらないね▼
キミが　どれだけ
強くなったか　試してあげよう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:53:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア2</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんかいは　やられたけど
こんかいは　ひとあじ　ちがうわ！▼
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>前回は　やられたけど
今回は　一味　違うわ！▼
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:13:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア3</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:17" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろのじゅどうを　たのしんで
いるかい？▼
あれから　キミが　どこまで
いけたのか　きょうみが　あるね▼
さあ　せいちょうした
キミの　ちからを　みせて　もらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:24:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白の樹洞を　楽しんで　いるかい？▼
あれから　キミが　どこまで
行けたのか　興味が　あるね▼
さあ　成長した　キミの　ちからを
見せて　もらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:23:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア4</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あれから　さらに　つよくなったようね▼
キミと　こうして　たたかえるのが
うれしいわ▼
こんどは　わたしが
キミに　ちょうせんするわね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:36:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あれから　さらに　強くなったようね▼
キミと　こうして　戦えるのが
うれしいわ▼
今度は　わたしが
キミに　挑戦するわね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:36:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア5</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:26" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　あのときの　こどもか▼
どうした？　こんな　ばしょには
もう　ようは　ないだろう？▼
また　ちょうせんに　きたのか？
まあ　いい　あいてを　しよう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:43:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　あのときの　子供か▼
どうした？　こんな　場所には
もう　用は　ないだろう？▼
また　挑戦に　来たのか？
まあ　いい　相手を　しよう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:44:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア6</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:32" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ　きた　きた！
また　きてくれたのね！▼
それじゃ　わたしと　たたかいましょう！▼
たたかって　たたかって　わたしは
もっと　つよくなるの！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:48:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あ　来た　来た！
また　来てくれたのね！▼
それじゃ　わたしと　戦いましょう！▼
戦って　戦って　わたしは
もっと　強くなるの！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:49:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア7</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:18:00" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　ああ　また　きたんだ
ここまで　ごくろうさま▼
せっかく　きてくれたんだ
めんどうだけど　たたかおうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:35:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　ああ　また　来たんだ
ここまで　ご苦労様▼
せっかく　来てくれたんだ
面倒だけど　戦おうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:36:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア8</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:18:16" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたも　たたかいつづけて　いるのね▼
わたしも　まだ　つよさの　いみは
みつけられないわ▼
さあ　あなたの　めざす　つよさを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:55:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたも　戦い続けて　いるのね▼
わたしも　まだ　強さの　意味は
見つけられないわ▼
さあ　あなたの　目指す　強さを
わたしに　見せてみなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:56:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア9</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:18:28" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みてわかるぞ！
おまえ　もっと　つよくなったな▼
たたかいを　たのしみに　おもうのは
ひさしぶりだぜ！▼
こんどは　まけないぜ
リベンジマッチだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:26:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>見てわかるぞ！
おまえ　もっと　強くなったな▼
戦いを　楽しみに　思うのは
ひさしぶりだぜ！▼
今度は　負けないぜ
リベンジマッチだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:27:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア10（バンジロウ））</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:18:54" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうとは　なにか？
その　こたえは　みつかったかい？▼
そのこたえを　みつけるまで
たたかいつづけると　しよう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:35:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:00:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強とは　何か？
その　答えは　見つかったかい？▼
その答えを　見つけるまで
戦い続けると　しよう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:37:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:00:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア10
（バージョン違いに登場するトレーナー用）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:19:17" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　ちょうせんしてくれて
うれしいよ▼
さあ　あれから　どれだけ
せいちょうしたか　みせてもらうよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:43:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　挑戦してくれて
うれしいよ▼
さあ　あれから　どれだけ
成長したか　見せてもらうよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:43:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア1</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アドバイス　……
は　もう　いらないわね▼
キミが　どれだけ　
つよくなったか　ためしてあげるわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:53:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アドバイス　……
は　もう　いらないわね▼
キミが　どれだけ
強くなったか　試してあげるわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:54:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア2</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんかいは　やられたけど
こんかいは　ひとあじ　ちがうぞ！▼
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>前回は　やられたけど
今回は　一味　違うぞ！▼
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア3</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうは　どうかしら？▼
あれから　キミが　どこまで
いけたのか　しりたいわね▼
さあ　せいちょうした
キミの　ちからを　みせて　もらうわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:26:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼は　どうかしら？▼
あれから　キミが　どこまで
行けたのか　知りたいわね▼
さあ　成長した　キミの　力を
見せて　もらうわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:26:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア4</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あれから　どれだけ　ちからを
つけることが　できたかな？▼
キミと　こうして　たたかえるのが
うれしいよ▼
こんどは　こっちが
ちょうせん　させてもらうよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:38:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あれから　どれだけ　力を
付けることが　できたかな？▼
キミと　こうして　戦えるのが
うれしいよ▼
今度は　こっちが
挑戦　させてもらうよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:38:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア5</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　あのときの　おこさまね▼
どうしたの？　こんな　ばしょには
もう　ようじは　ないでしょう？▼
え？　ちょうせんに　きたの？
まあ　いいわ　あいてを　してあげる▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:46:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　あの時の　お子様ね▼
どうしたの？　こんな　場所には
もう　用事は　ないでしょう？▼
え？　挑戦に　来たの？
まあ　いいわ　相手を　してあげる▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:47:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア6</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>お　きたな！
ずっと　まっていたんだ▼
それじゃ　おれと　たたかうぞ！▼
たたかって　たたかって　おれは
もっと　つよくなるんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:52:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お　来たな！
ずっと　待っていたんだ▼
それじゃ　おれと　戦うぞ！▼
戦って　戦って　おれは
もっと　強くなるんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:53:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア7</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　あら　また　いらしたのね
ここまで　ごくろうさま▼
せっかく　いらしたのだから
たたかいましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:38:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　あら　また　いらしたのね
ここまで　ご苦労様▼
せっかく　いらしたのだから
戦いましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:39:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア8</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミも　たたかいつづけて　いるんだな▼
わたしも　まだ　つよさの　いみは
みつけられないで　いるよ▼
さあ　キミの　めざす　つよさを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:58:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミも　戦い続けて　いるんだな▼
わたしも　まだ　強さの　意味は
見つけられないで　いるよ▼
さあ　キミの　目指す　強さを
わたしに　見せてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:59:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア9</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みてわかるぞ！
おまえ　もっと　つよくなったな▼
たたかいを　たのしみに　おもうのは
ひさしぶりだぜ！▼
こんどは　まけないぜ
リベンジマッチだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:31:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>見てわかるぞ！
おまえ　もっと　強くなったな▼
戦いを　楽しみに　思うのは
ひさしぶりだぜ！▼
今度は　負けないぜ
リベンジマッチだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:32:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア10（バンジロウ））</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_10">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうとは　なにか？
その　こたえは　みつけられたかしら？▼
そのこたえを　みつけるまで
たたかいつづけましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:38:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強とは　何か？
その　答えは　見つけられたかしら？▼
その答えを　見つけるまで
戦い続けましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:39:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ブラックエリア10
（バージョン違いに登場するトレーナー用）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:20:49" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろのじゅどうに　ようこそ
しょしんしゃさん▼
わたしからの　さいごの　アドバイスよ▼
この　エリアを　クリアするには
わたしを　たおす　ひつようが　あるわ▼
えんりょは　むようよ！
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T04:53:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白の樹洞に　ようこそ
初心者さん▼
わたしからの　最後の　アドバイスよ▼
この　エリアを　クリアするには
わたしを　倒す　必要が　あるわ▼
遠慮は　無用よ！
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:31:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア1</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リタイアせずに　ここまで
たどりつけたようだね▼
アドバイスは　やくに
たったなかったかな？▼
さあ　エリア2を　クリアして
しょしんしゃ　そつぎょうを▽
めざすんだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T11:02:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リタイアせずに　ここまで
たどり着けたようだね▼
アドバイスは　役に
立たなかったかな？▼
さあ　エリア2を　クリアして
初心者　卒業を　目指すんだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T11:03:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア2</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた　……
さいきんの　こどもは　ようしゃないわね▼
それにしても　あれだけの　そしつを
もっているこは　はじめて　みたわ▼
あのこは　すえ　おそろしいわね　……▼
さあ　つぎは　キミの　ばんよ
ぜんりょくで　ぶつかって　きなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T10:52:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた　……
最近の　子供は　容赦ないわね▼
それにしても　あれだけの　素質を
持っている子は　はじめて　見たわ▼
あの子は　末恐ろしいわね　……▼
さあ　次は　キミの　番よ
全力で　ぶつかって　来なさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T10:52:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア3</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろのじゅどうは　どうだい？
ふしぎな　ばしょだろう？▼
おれたちも　このどうくつが　
どこまで　つづいているのか▽
はあくして　いないぐらいだからな▼
キミも　きになるだろう？
さいかそうに　なにがあるのか▼
それじゃ　キミが　どこまで　いけるか
その　じつりょくを　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T07:14:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白の樹洞は　どうだい？
不思議な　場所だろう？▼
おれたちも　この洞窟が
どこまで　続いているのか▽
把握して　いないぐらいだからな▼
キミも　気になるだろう？
最下層に　何があるのか　……▼
それじゃ　キミが　どこまで　いけるのか
その　実力を　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T07:15:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア4</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　ちょうせんしゃが
たくさん　くるわね▼
さっきの　しょうねんも　
つよかったけど▽
キミは　どうかしら？▼
わたしは　つよい　トレーナーと
たたかうために　ここにいるの▼
さあ　キミの　じつりょくを
ためさせて　もらうわよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T08:15:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今日は　挑戦者が
沢山　来るわね▼
さっきの　少年も　強かったけど
キミは　どうかしら？▼
わたしは　強い　トレーナーと
戦うために　ここにいるの▼
さあ　キミの　実力を
試させて　もらうわよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T08:18:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア5</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　こんなところに　こどもが
なんのようだ？▼
ここから　さきは　かるいきもちで
ちょうせんする　ばしょじゃ　ないぞ▼
こどもは　エリア5で　あそんでな▼
……　ほんきで　つぎの　エリアを
めざしているのか？▼
いいだろう　あいてを　してやる
さあ　かかってきな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T08:54:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　こんなところに　子供が
何の用だ？▼
ここから　先は　軽い気持ちで
挑戦する　場所じゃ　ないぞ▼
子供は　エリア5で　遊んでな▼
……　本気で　次の　エリアを
目指しているのか？▼
いいだろう　相手を　してやる
さあ　かかってきな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T08:54:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア6</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ　きた　きた！
あなた　ちょうせんしゃね！▼
それじゃ　わたしと　たたかいましょう！▼
たたかって　たたかって　わたしは
もっと　つよくなるの！▼
ここは　わたしのように　たたかいを
もとめる　トレーナーには▽
てんごくよ！▼
さあ　あなたは　どんな　ポケモンを
つかうのかしら？▼
わたしを　たのしませて！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:05:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あ　来た　来た！　
あなた　挑戦者ね？▼
それじゃ　わたしと　戦いましょう！▼
戦って　戦って　わたしは
もっと　強くなるの！▼
ここは　わたしのように　戦いを
求める　トレーナーには　天国よ！▼
さあ　あなたは　どんな　ポケモンを
使うのかしら？▼
わたしを　楽しませて！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:07:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア7</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　ああ　ちょうせんしゃのひと？
ここまで　ごくろうさま▼
ここまで　これたんだから
もう　いいんじゃない？▼
え？　つぎの　エリアも　めざすの？
がんばるんだね　キミ▼
まあ　いいさ
めんどうだけど　たたかおうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:16:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　ああ　挑戦者の人？
ここまで　ご苦労様▼
ここまで　これたんだから
もう　いいんじゃない？▼
え？　次の　エリアも　目指すの？
がんばるんだね　キミ▼
まあ　いいさ
面倒だけど　戦おうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:16:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア8</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたは　たたかうのは　すきかしら？▼
くるひも　くるひも　たたかったけど
つよさって　なんなのかしら？▼
……　ごめんなさい▼
トレーナーが　こんなことを　
かんがえてしまったら　おしまいね▼
さあ　あなたの　つよさを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:39:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたは　戦うのは　好きかしら？▼
来る日も　来る日も　戦ったけど
強さって　何なのかしら？▼
……　ごめんなさい▼
トレーナーが　こんなことを
考えてしまったら　おしまいね▼
さあ　あなたの　強さを
わたしに　見せてみなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:39:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア9</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようやくきたな　まちくたびれたぜ▼
いままで　なんにんも　あいてを
してきたけど　みんな　よわくてな▼
おまえを　まっていたんだ▼
あのとき　おまえに　あったときに
おまえの　めを　みて　おもったんだ▼
こいつは　……　つよい　ってな▼
さあ　あのときの　やくそくだ
しんけんしょうぶを　してもらうぞ！▼
ここで　いちばんつよいのは
おれか　おまえか　……▼
しろくろ　つけようぜ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:46:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようやく来たな　待ちくたびれたぜ▼
今まで　何人も　相手を
してきたけど　みんな　弱くてな▼
おまえを　待っていたんだ▼
あのとき　おまえに　会ったときに
おまえの　目を　見て　思ったんだ▼
こいつは　……　強い　ってな▼
さあ　あのときの　約束だ
真剣勝負を　してもらうぞ！▼
ここで　一番強いのは
おれか　おまえか　……▼
白黒　つけようぜ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:46:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア10（バンジロウ））</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:39:29" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_start_10">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　さいきょうの　トレーナーを
めざして　たたかいつづけてきた▼
キミも　そうだろう？
さいきょうとは　なにか？▼
その　こたえを　もとめて
ここまで　きたの　だろう？▼
わたしと　たたかうことで
イッシュさいきょうが　だれか▽
その　こたえに　ちかづけるだろう▼
かんきゃくが　いないのが　さびしいが
さいこうの　たたかいを　しよう▼
さあ　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:14:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:52" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　最強の　トレーナーを
目指して　戦い　続けてきた▼
キミも　そうだろう？
最強とは　何か？▼
その　答えを　求めて
ここまで　来たの　だろう？▼
わたしと　戦うことで
イッシュ最強が　誰か▽
その　答えに　近づけるだろう▼
観客が　いないのが　寂しいが
最高の　戦いを　しよう▼
さあ　勝負だ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:14:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:05:02" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ホワイトエリア10
（バージョン違いに登場するトレーナー用）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうに　ようこそ
しょしんしゃさん▼
キミへの　さいごの　アドバイスだ▼
この　エリアを　クリアするには
ボクを　たおす　ひつようが　ある▼
えんりょは　むようだ！
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T04:53:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼に　ようこそ
初心者さん▼
キミへの　最後の　アドバイスだ▼
この　エリアを　クリアするには
ボクを　倒す　必要が　ある▼
遠慮は　無用だ！
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:56:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア1</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リタイアせずに　ここまで
たどりつけたようね▼
アドバイスは　やくに
たったなかったかしら？▼
さあ　エリア2を　クリアして
しょしんしゃ　そつぎょうを▽
めざしなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T11:11:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>リタイアせずに　ここまで
たどり着けたようね▼
アドバイスは　役に
立たなかったかしら？▼
さあ　エリア2を　クリアして
初心者　卒業を　目指しなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T11:12:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア2</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた　……
さいきんの　こどもは　ようしゃないな▼
それにしても　あれだけの　そしつを
もっているこは　はじめて　みたよ▼
あのこは　すえ　おそろしいな　……▼
さあ　つぎは　キミの　ばんだ
ぜんりょくで　ぶつかって　来い！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T10:52:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた　……
最近の　子供は　容赦ないな▼
それにしても　あれだけの　素質を
持っている子は　はじめて　見たよ▼
あの子は　末恐ろしいな　……▼
さあ　次は　キミの　番だ
全力で　ぶつかって　来い！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T10:52:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア3</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろのまてんろうは　どうかしら？▼
イッシュには　これいじょうの
こうそうビルは　ないとおもうわ▼
わたしたちも　このビルが
なんかいだてか　しらないもの▼
キミも　このビルの　さいじょうかいが
きになるでしょう？▼
それじゃ　キミが　どこまで　いけるか
その　じつりょくを　みせてもらうね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T07:55:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒の摩天楼は　どうかしら？▼
イッシュには　これい以上の
高層ビルは　ないと思うわ▼
わたしたちも　このビルが
何階建てか　知らないもの▼
キミも　このビルの　最上階が
気になるでしょう？▼
それじゃ　キミが　どこまで　行けるか
その　実力を　見せてもらうね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T07:55:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア4</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうは　ちょうせんしゃが
たくさん　くるひだな▼
さっきの　しょうねんも　つよかったが
キミは　どうかな？▼
つよい　トレーナーと　たたかうのが
わたしの　よろこびだ▼
さあ　キミの　じつりょくを
ためさせて　もらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T08:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今日は　挑戦者が
沢山　来る日だな▼
さっきの　少年も　強かったが
キミは　どうかな？▼
強い　トレーナーと　戦うのが
わたしの　喜びだ▼
さあ　キミの　実力を
試させて　もらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T08:10:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア5</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　こんなところに　おこさまが
なんの　ようじ？▼
ここから　さきは　かるいきもちで
ちょうせんする　ばしょじゃ　ないわよ▼
こどもは　エリア5で　あそんでなさい▼
え？　ほんきで　つぎの　エリアを
めざしているの？▼
わかったわ　あいてを　してあげる
さあ　かかってきなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:10:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　こんなところに　お子様が
何の　用事？▼
ここから　先は　軽い気持ちで
挑戦する　場所じゃ　ないわよ▼
子供は　エリア5で　遊んでなさい▼
え？　本気で　次の　エリアを
目指しているの？▼
わかったわ　相手を　してあげる
さあ　かかってきなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:10:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア6</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>お　きたな！
つぎの　ちょうせんしゃが！▼
それじゃ　おれと　たたかうぞ！▼
たたかって　たたかって　おれは
もっと　つよくなるんだ▼
ここは　おれのように　たたかいを
もとめる　トレーナーには▽
てんごくさ！▼
さあ　おまえは　どんな　ポケモンを
つかうんだ？▼
おれを　たのしませてくれよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:09:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お　来たな！
次の　挑戦者が！▼
それじゃ　おれと　戦うぞ！▼
戦って　戦って　おれは
もっと　強くなるんだ▼
ここは　おれのように　戦いを
求める　トレーナーには　天国さ！▼
さあ　おまえは　どんな　ポケモンを
使うんだ？▼
おれを　楽しませてくれよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:10:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア7</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　あら　ちょうせんしゃのかた？
ここまで　ごくろうさま▼
ここまで　これたんだから
もう　よろしいんじゃなくて？▼
まあ　つぎの　エリアも
めざして　いらっしゃるの？▼
それなら　わたしと　たたかう
ひつようが　ありますわね▼
あら　あら　しょうがないですわ
たたかいましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:19:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　あら　挑戦者の方？
ここまで　ご苦労様▼
ここまで　これたんだから
もう　よろしいんじゃなくて？▼
まあ　次の　エリアも
目指して　いらっしゃるの？▼
それなら　わたしと　戦う
必要がが　ありますわね▼
あら　あら　しょうがないですわ
戦いましょうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T09:20:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア8</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミは　たたかいは　すきかい？▼
わたしは　くるひも　くるひも
たたかって　きたが　つよさの　こたえが▽
いまだに　みつからなくてね　……▼
おっと　すまない▼
トレーナーが　こんなことを　
かんがえてしまったら　おしまいだな▼
さあ　キミの　めざす　つよさを
わたしに　みせてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T10:19:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミは　戦いは　好きかい？▼
わたしは　来る日も　来る日も
戦って　来たが　強さの　答えが▽
いまだに　見つからなくてね　……▼
おっと　すまない▼
トレーナーが　こんなことを　
考えてしまったら　おしまいだな▼
さあ　キミの　目指す　強さを
わたしに　見せてもらおう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T10:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア9</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようやくきたな　まちくたびれたぜ▼
いままで　なんにんも　あいてを
してきたけど　みんな　よわくてな▼
おまえを　まっていたんだ▼
あのとき　おまえに　あったときに
おまえの　めを　みて　おもったんだ▼
こいつは　……　つよい！　ってな▼
さあ　あのときの　やくそくだ
しんけんしょうぶを　してもらうぞ！▼
ここで　いちばんつよいのは
おれか　おまえか　……▼
しろくろ　つけようぜ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:46:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようやく来たな　待ちくたびれたぜ▼
今まで　何人も　相手を
してきたけど　みんな　弱くてな▼
おまえを　待っていたんだ▼
あのとき　おまえに　会ったときに
おまえの　目を　見て　思ったんだ▼
こいつは　……　強い！　ってな▼
さあ　あのときの　約束だ
真剣勝負を　してもらうぞ！▼
ここで　一番強いのは
おれか　おまえか　……▼
白黒　つけようぜ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T11:20:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア10（バンジロウ））</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　さいきょうの　トレーナーを
めざして　たたかいつづけてきたわ▼
あなたも　そうでしょう？
さいきょうとは　なにか？▼
その　こたえを　もとめて
ここまで　きたの　でしょう？▼
わたしと　たたかうことで
イッシュさいきょうが　だれか▽
その　こたえに　ちかづけるわ▼
かんきゃくは　いないけど
さいこうの　たたかいを　しましょう▼
さあ　しょうぶよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:14:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:02:35" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　最強の　トレーナーを
目指して　戦い続けてきたわ▼
あなたも　そうでしょう？
最強とは　何か？▼
その　答えを　求めて
ここまで　来たの　でしょう？▼
わたしと　戦うことで
イッシュ最強が　誰か▽
その　答えに　近づけるわ▼
観客は　いないけど
最高の　戦いを　しましょう▼
さあ　勝負よ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:14:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:02:51" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘開始　ブラックエリア10
（バージョン違いに登場するトレーナー用）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:21:33" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いぜんより　つよくなったわね
もう　しょしんしゃとは　いえないわ▼
キミが　どこまで
つよくなるのか　たのしみよ▼
また　ちょうせんしてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:42:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>以前より　強くなったわね
もう　初心者とは　言えないわ▼
キミが　どこまで
強くなるのか　楽しみよ▼
また　挑戦してね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:43:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア1</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよくなったね
しょしんしゃの　ころが　なつかしいよ▼
それとも　ボクが　よわくなったのかな▼
ボクも　まけずに　ここで　しゅぎょうが
ひつようかもね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:57:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強くなったね
初心者の　ころが　懐かしいよ▼
それとも　ボクが　弱くなったのかな▼
ボクも　負けずに　ここで　修行が
必要かもね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:59:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア2</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいも　かてなかったか
つよいわね　ほんとうに▼
わたしも　もっと　がんばらないと
つぎは　まけないわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:15:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今回も　勝てなかったか
強いわね　本当に▼
わたしも　もっと　がんばらないと
次は　負けないわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:16:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア3</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　つよくなったね
ぜんかいとは　おおちがいだ▼
キミは　どこまで　いけるように
なったんだい？▼
いつか　さいかそうに
とうたつしたら　おしえてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　強くなったね
前回とは　大違いだ▼
キミは　どこまで　行けるように
なったんだい？▼
いつか　最下層に
到達したら　教えてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア4</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やっぱり　かてなかったわね▼
キミが　どこまで　つよくなるのか
たのしみに　なってきたわ▼
つぎは　まけないように
わたしも　がんばるわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:57:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やっぱり　勝てなかったわね▼
キミが　どこまで　強くなるのか
楽しみに　なってきたわ▼
次は　負けないように
わたしも　がんばるわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:58:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア5</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さらに　うでを　あげたな
みとめよう　おまえは　つよい▼
もっと　つよさを　もとめるなら
さきの　エリアを　めざすんだな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:59:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さらに　腕を　上げたな
認めよう　おまえは　強い▼
もっと　強さを　求めるなら
先の　エリアを　目指すんだな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア6</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たりないわ
あなたと　もっと　たたかいたいのに▼
ぜったい　また　ここに　きてよ！
ぜったい　また　たたかいましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:35:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>足りないわ
あなたと　もっと　戦いたいのに▼
絶対　また　ここに　来てよ！
絶対　また　戦いましょう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:35:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア7</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　ごくろうさま▼
あれ？
まだ　たたかいたりないの？▼
キミは　どんよくだな▼
それぐらいじゃないと　このさきは
つらいのかも　しれないけど▼
まあ　きがむいたら　またおいで
あいてを　するからさ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:06:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はい　ご苦労様▼
あれ？
まだ　戦い足りないの？▼
キミは　貪欲だな▼
それぐらいじゃないと　この先は
つらいのかも　知れないけど▼
まあ　気が向いたら　またおいで
相手を　するからさ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:05:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア8</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　たたかいで　あなたの
めざすものに▽
すこしは　ちかづけたかしら？▼
こたえが　みつかるまで
なんどでも　あいてを　するわ▼
また　たたかいましょう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:18:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　戦いで　あなたの
目指すものに▽
少しは　近づけたかしら？▼
答えが　見つかるまで
何度でも　相手を　するわ▼
また　戦いましょう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:19:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア9</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　かてなかたか▼
ひさしぶりに　じいちゃんに
しゅぎょうを　つけてもらうか　……▼
ぜったい　また　しょうぶしろよ！
かちにげは　ゆるさないからな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:43:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　勝てなかったか▼
久しぶりに　じいちゃんに
修行を　つけてもらうか　……▼
絶対　また　勝負しろよ！
勝ち逃げは　許さないからな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:43:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア10（バンジロウ））</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_end_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいな▼
キミは　まちがいなく　しろのじゅどう
さいきょうの　トレーナーだ▼
だが　イッシュさいきょうか
どうかは　わからない　……▼
まだみぬ　きょうしゃは　いくらでも
いるからな▼
さいきょうを　めざし
しょうじんするんだな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:46:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:01:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いな▼
キミは　間違いなく
白の樹洞　最強の　トレーナーだ▼
だが　イッシュ最強か
どうかは　わからない　……▼
まだ見ぬ　強者は　いくらでも
いるからな▼
最強を　目指し
精進するんだな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:46:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:01:28" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ホワイトエリア10
（バージョン違いに登場するトレーナー用）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>最上階、色違い用</Comment>
			<CommentModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:02:09" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いぜんより　てごわくなったね
もう　しょしんしゃとは　いえないな▼
キミが　どこまで
つよくなるのか　たのしみだよ▼
また　ちょうせんして　くれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:40:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>以前より　手強くなったね
もう　初心者とは　言えないな▼
キミが　どこまで
強くなるのか　楽しみだよ▼
また　挑戦して　くれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:41:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア1</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよくなったわね
しょしんしゃの　ころが　なつかしいわ▼
それとも　わたしが　よわくなったのかな▼
わたしも　まけずに　ここで　しゅぎょうが
ひつようね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T09:59:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強くなったね
初心者の　ころが　懐かしいわ▼
それとも　わたしが　弱くなったのかな▼
わたしも　負けずに　ここで　修行が
必要ね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T10:02:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア2</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんかいも　かてなかったか
つよいね　ほんとうに▼
ボクも　もっと　がんばらないと
つぎは　まけないぞ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:17:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今回も　勝てなかったか
強いね　本当に▼
ボクも　もっと　がんばらないと
次は　負けないぞ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:17:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア3</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　つよくなったわね
ぜんかいとは　おおちがいよ▼
キミは　どこまで　いけるように
なったのかしら？▼
いつか　さいじょうかいに
とうたつしたら　おしえてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　強くなったわね
前回とは　大違いよ▼
キミは　どこまで　行けるように
なったのかしら？▼
いつか　最上階に
到達したら　教えてね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:31:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア4</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やっぱり　かてなかったか▼
キミが　どこまで　つよくなるのか
たのしみに　なってきたよ▼
つぎは　まけないように
こっちも　がんばるよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:32:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やっぱり　勝てなかったか▼
キミが　どこまで　強くなるのか
楽しみに　なってきたよ▼
次は　負けないように
こっちも　がんばるよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:32:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア5</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さらに　うでを　あげたわね
あなたの　つよさを　みとめるわ▼
もっと　つよさを　もとめるなら
さきの　エリアを　めざしなさい▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:33:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さらに　腕を　上げたわね
あなたの　強さを　認めるわ▼
もっと　強さを　求めるなら
先の　エリアを　目指しなさい▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:34:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア6</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これじゃ　たりない！▼
おれは　もっと　もっと
たたかいたい！▼
ぜったい　また　ここに　こいよ！
ぜったい　また　たたかうぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:36:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これじゃ　足りない！▼
おれは　もっと　もっと
戦いたい！▼
絶対　また　ここに　来いよ！
絶対　また　戦うぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:36:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア7</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　ごくろうさま▼
あら？
まだ　たたかいたりないかしら？▼
どんよくですこと　……▼
それぐらいの　きもちが　ないと
このさきは　つらいのかも▽
しれないわね▼
まあ　きがむいたら　おいでなさい
おあいてしますわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:38:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はい　ご苦労様▼
あら？
まだ　戦い足りないのかしら？▼
貪欲ですこと　……▼
それぐらいの　気持ちが　ないと
この先は　つらいのかも▽
知れないわね▼
まあ　気が向いたら　おいでなさい
お相手しますわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:38:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア8</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　たたかいで　キミの
めざすものに　すこしは
ちかづけたかい？▼
こたえが　みつかるまで
なんどでも　あいてを　するよ▼
また　たたかおう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:40:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　戦いで　キミの
目指すものに　少しは
近づけたかい？▼
答えが　見つかるまで
何度でも　相手を　するよ▼
また　戦おう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:41:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア9</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　かてなかたか▼
ひさしぶりに　じいちゃんに
しゅぎょうを　つけてもらうか　……▼
ぜったい　また　しょうぶしろよ！
かちにげは　ゆるさないからな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:42:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　勝てなかったか▼
久しぶりに　じいちゃんに
修行を　つけてもらうか　……▼
絶対　また　勝負しろよ！
勝ち逃げは　許さないからな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:43:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア10（バンジロウ））</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_end_10">
		<LanguageCell
			Language="JPN">
			<Text>つよいわね▼
あたなは　まちがいなく
くろのまてんろう　さいきょうの▽
トレーナーだわ▼
だけど　イッシュさいきょうか
どうかは　わからない　……▼
まだみぬ　きょうしゃは　いくらでも
いるわ▼
さいきょうを　めざし
しょうじんしなさい▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:46:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いわね▼
あたなは　間違いなく
黒の摩天楼　最強の　トレーナーだわ▼
だけど　イッシュ最強か
どうかは　わからない　……▼
まだ見ぬ　強者は　いくらでも
いるわ▼
最強を　目指し　精進しなさい▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T09:46:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:04:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘終了　ブラックエリア10
（バージョン違いに登場するトレーナー用）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T02:22:21" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おどろいたよ　よそういじょうだ▼
キミの　ポケモンの　ちから
みせてもらったよ▼
キミなら　つぎの　エリアも
クリアできるだろう▼
キミの　かつやくを　たのしみに
しているよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>驚いたよ　想像以上だ▼
キミの　ポケモンの　力
見せてもらったよ▼
キミなら　次の　エリアも
クリアできるだろう▼
キミの　活躍を　楽しみに
しているよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア1</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:39:56" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おめでとう
これで　しょしんしゃ　そつぎょうね▼
エリア2　クリアの　きねんに
エリア3の　ヒントを　すこしあげるわ▼
エリア3からは　エリアないの
かいそうが　ふえるの▼
いまいる　かいで　ボストレーナーを
みつけられないときは▽
べつの　かいそうを　さがしなさい▼
べつの　かいそうには　
エレベーターで　いどうしてね▼
さきは　ながいわよ
つぎの　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:38:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おめでとう
これで　初心者　卒業ね▼
エリア2　クリアの　きねんに
エリア3の　ヒントを　少しあげるわ▼
エリア3からは　エリア内の
階層が　増えるの▼
今いる　階で　ボストレーナーを
見つけられないときは▽
別の　階層を　探しなさい▼
別の　階層には　
エレベーターで　移動してね▼
先は　長いわよ
次の　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:39:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア2</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:02" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた　……▼
ほんとうに　さいきんの　こどもは
ようしゃないんだな▼
キミの　つよさも　よくわかったよ
これで　エリア3も　クリアだ▼
キミが　どこまで　いけるのか
たのしみに　しているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:26:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた　……▼
本当に　最近の　子供は
容赦ないんだな▼
キミの　強さも　よくわかったよ
これで　エリア3も　クリアだ▼
キミが　どこまで　行けるのか
楽しみに　しているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:26:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア3</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:08" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいったわ
キミ　つよいわね▼
キミなら　さいじょうかいまで
たどりつけるかも　しれないわね▼
つぎの　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:42:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まいったわ
キミ　強いね▼
キミなら　最上階まで
たどり着けるかも　しれないわね▼
次の　エリアも　がんばってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:43:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア4</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:14" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さっきの　しょうねんと　どうとう
いや　それいじょうの　つよさだな▼
キミが　ここで　たたかいつづければ
あのしょうねんと　たたかうひが▽
くるかもしれないな▼
キミたちの　たたかい　……
みてみたいものだ▼
では　また　たたかおう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:48:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さっきの　少年と　同等
いや　それ以上の　強さだな▼
キミが　ここで　戦い続ければ
あの少年と　戦う日が▽
来るかもしれないな▼
キミたちの　戦い　……
見てみたいものだ▼
では　また　戦おう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:48:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア5</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうさん　こうさんよ
まけたわ▼
ポケモンの　つよさに　ねんれいは
かんけいないわね▼
でも　ここから　さきは
たたかうことを　いきがいに▽
しているような　ひとばかりよ▼
あなたの　ほんきが　どこまで
つうようするのか　たのしみだわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:53:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>降参　降参よ
負けたわ▼
ポケモンの　強さに　年齢は
関係ないわね▼
でも　ここから　先は
戦うことを　生き甲斐に▽
しているような　人ばかりよ▼
あなたの　本気が　どこまで
通用するのか　楽しみだわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:53:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア6</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:25" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけた　まけた！
ここまで　まけたのは　ひさしぶりだ▼
ほら　つぎの　エリアに　いきな▼
おれは　つぎの　ちょうせんしゃを
まつからさ▼
つぎは　だれだ？
はやく　たたかわせろ！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:56:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けた　負けた！
ここまで　負けたのは　久しぶりだ▼
ほら　次の　エリアに　行きな▼
おれは　次の　挑戦者を
待つからさ▼
次は　誰だ？
早く　戦わせろ！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:57:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア7</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:31" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　あら　まけてしまいました
おつよいのね▼
それだけ　つよいのに
まだ　さきを　めざすのね▼
あなたは　どこまで　いくのかしら
おわりは　あるのかしら？▼
あなたが　めざす　ゴールに
たどりつけることを　いのっているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:02:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　あら　負けてしまいました
お強いのね▼
それだけ　強いのに
まだ　先を　目指すのね▼
あなたは　どこまで　行くのかしら
終わりは　あるのかしら？▼
あなたが　目指す　ゴールに
たどり着けることを　祈っているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:03:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア8</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:37" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしいつよさだ▼
キミは　わたしの　さがす　つよさを
もっているのかも　しれないな▼
いぜん　たたかった　しょうねんも
おなじ　つよさを　かんじたよ▼
いつかおしえてくれ
キミたちが　みつけた　つよさを▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:41:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>素晴らしい強さだ▼
キミは　わたしの　探す　強さを
持っているのかも　知れないな▼
以前　戦った　少年も
同じ　強さを　感じたよ▼
いつか教えてくれ
キミたちが　見つけた　強さを▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:41:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア9</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:42" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけた　ここで　はじめてまけた！▼
やっぱり　おまえ　つよいな！
おれの　めに　くるいはなかった▼
まけたのに　ふしぎと　きもちが　いいぜ▼
ここでの　もくひょうが　なくて
こまっていたけど▽
あたらしい　もくひょうが　できたぞ▼
……　おまえを　たおす！▼
つぎは　かならず　おれが　かつ！▼
おれも　もっと　しゅぎょうするから
また　しょうぶしてくれよな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T11:23:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けた　ここで　はじめて負けた！▼
やっぱり　おまえ　強いな！
おれの　目に　くるいはなかった▼
負けたのに　不思議と　気持ちが　いいぜ▼
ここでの　目標が　なくて困っていたけど
新しい　目標が　できたぞ▼
……　おまえを　倒す！
次は　必ず　おれが　勝つ！▼
おれも　もっと　修行するから
また　勝負してくれよな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:38:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア10（バンジロウ））</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:38:38" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#000000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_first_end_10">
		<LanguageCell
			Language="JPN">
			<Text>つよいわね▼
これほどの　つよさを　もった
トレーナーは　はじめてよ▼
わたしの　しょうがい　さいこうの
たたかいだったわ▼
さいきょうへの　こたえは
みえたかしら？▼
あなたなら　いつか　さいきょうへの
みちが　ひらけるかも　しれないわね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:16:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:03:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いわね▼
これほどの　強さを　持った
トレーナーは　はじめてよ▼
わたしの　生涯
最高の　戦いだったわ▼
最強への　答えは　見えたかしら？▼
あなたなら　いつか　最強への
道が　開けるかも　知れないわね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:17:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:03:42" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ブラックエリア10
（バージョン違いに登場するトレーナー用）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:50" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おどろいたわ　よそういじょうよ▼
キミの　ポケモンの　ちから
みせてもらったわ▼
キミなら　つぎの　エリアも
クリアできるわ▼
キミの　かつやくを　たのしみに
しているわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:38:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>驚いたわ　予想以上よ▼
キミの　ポケモンの　力
見せてもらったわ▼
キミなら　次の　エリアも
クリアできるわ▼
キミの　活躍を　楽しみに
しているわよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:39:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア1</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:40:57" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おめでとう
これで　しょしんしゃ　そつぎょうだな▼
エリア2　クリアの　きねんに
エリア3の　ヒントを　すこしおしえよう▼
エリア3からは　エリアないの
かいそうが　ふえるぞ▼
いまいる　かいで　ボストレーナーを
みつけられないときは▽
べつの　かいそうを　さがすんだ▼
べつの　かいそうには　
エレベーターで　いどうするんだぞ▼
さきは　ながいぞ
つぎの　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:40:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おめでとう
これで　初心者　卒業だな▼
エリア2　クリアの　記念に
エリア3の　ヒントを　少し教えよう▼
エリア3からは　エリア内の
階層が　増えるぞ▼
今いる　階で　ボストレーナーを
見つけられないときは▽
別の　階層を　探すんだ▼
別の　階層には　
エレベーターで　移動するんだぞ▼
先は　長いぞ
次の　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:42:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア2</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:04" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いたたた　……▼
ほんとうに　さいきんの　こどもは
ようしゃないわね▼
キミの　つよさも　よくわかったわ
これで　エリア3も　クリアよ▼
キミが　どこまで　いけるのか
たのしみに　しているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:27:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>痛たたた　……▼
本当に　最近の　子供は
容赦ないわね▼
キミの　強さも　よくわかったわ
これで　エリア3も　クリアよ▼
キミが　どこまで　行けるのか
楽しみに　しているわ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:27:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア3</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:10" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まいったよ
キミ　つよいな▼
キミなら　さいかそうまで
たどりつけるかも　しれないな▼
つぎの　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:22:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まいったよ
キミ　強いな▼
キミなら　最下層まで
たどり着けるかも　知れないな▼
次の　エリアも　がんばれよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:23:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア4</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:15" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さっきの　しょうねんと　どうとう
いや　それいじょうの　つよさね▼
キミが　ここで　たたかいつづければ
あのしょうねんと　たたかうひが▽
くるかもしれないわね▼
キミたちの　たたかい　……
きょうみぶかいわ▼
それじゃ　また　たたかいましょうね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:26:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さっきの　少年んと　同等
いや　それ以上の　強さね▼
キミが　ここで　戦い続ければ
あの少年と　戦う日が▽
来るかもしれないわね▼
キミたちの　戦い　……
興味深いわ▼
それじゃ　また　戦いましょうね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:26:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア5</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:22" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうさん　こうさんだ
まけたよ▼
ポケモンの　つよさに　ねんれいは
かんけいないな▼
だが　ここから　さきは
たたかうことを　いきがいに▽
しているような　やつばかりだぞ▼
おまえの　ほんきが　どこまで
つうようするのか　たのしみだよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:27:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>降参　降参だ
負けたよ▼
ポケモンの　強さに　年齢は
関係ないな▼
だが　ここから　先は
戦うことを　生き甲斐に▽
しているような　やつばかりだぞ▼
おまえの　本気が　どこまで
通用するのか　楽しみだよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:34:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア6</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:28" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんぱいよ！
ここまで　まけたのは　ひさしぶりね▼
ほら　つぎの　エリアに　いきなさい▼
わたしは　つぎの　ちょうせんしゃを
まつことに　するわ▼
つぎは　だれ？
はやく　たたかわせなさい！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:37:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>完敗よ！
ここまで　負けたのは　久しぶりね▼
ほら　次の　エリアに　いきなさい▼
わたしは　次の　挑戦者を
待つことに　するわ▼
次は　誰？
早く　戦わせなさい！！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:39:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア7</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:34" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　ああ　まけちゃったね
つよいんだね▼
それだけ　つよいのに
まだ　さきを　めざすんだね▼
キミは　どこまで　いくの？
おわりは　あるのかな？▼
キミが　めざす　ゴールに
たどりつけることを　いのっているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:41:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　ああ　負けちゃったね
強いんだね▼
それだけ　強いのに
まだ　先を　目指すんだね▼
キミは　どこまで　行くの？
終わりは　あるのかな？▼
キミが　目指す　ゴールに
たどり着けることを　祈っているよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:42:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア8</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:39" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしいつよさね▼
あなたは　わたしの　さがす　つよさを
もっているのかも　しれないわ▼
いぜん　たたかった　しょうねんも
おなじ　つよさを　かんじたわ▼
いつか　おしえて　ほしいわね
キミたちが　みつけた　つよさを▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:42:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>素晴らしい強さね▼
あなたは　わたしの　探す　強さを
持っているのかも　知れないわ▼
以前　戦った　少年も
同じ　強さを　感じたわ▼
いつか　教えて　欲しいわね
キミたちが　見つけた　強さを▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T10:42:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア9</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:44" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけた　ここで　はじめてまけた！▼
やっぱり　おまえ　つよいな！
おれの　めに　くるいはなかった▼
まけたのに　ふしぎと　きもちが　いいぜ▼
ここでの　もくひょうが　なくて
こまっていたけど▽
あたらしい　もくひょうが　できたぞ▼
……　おまえを　たおす！▼
つぎは　かならず　おれが　かつ！▼
おれも　もっとしゅぎょうするから
また　しょうぶしてくれよな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T03:22:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けた　ここで　はじめて負けた！▼
やっぱり　おまえ　強いな！
おれの　目に　くるいはなかった▼
負けたのに　不思議と　気持ちが　いいぜ▼
ここでの　目標が　なくて困っていたけど
新しい　目標が　できたぞ▼
……　おまえを　倒す！
次は　必ず　おれが　勝つ！▼
おれも　もっと　修行するから
また　勝負してくれよな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T03:22:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア10（バンジロウ））</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:50" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#c0c0c0</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_first_end_10">
		<LanguageCell
			Language="JPN">
			<Text>つよいな▼
これほどの　つよさを　もった
トレーナーは　はじめてだ▼
わたしの　しょうがい　さいこうの
たたかいだったよ▼
さいきょうへの　こたえは
みえたかい？▼
キミなら　いつか　さいきょうへの
みちが　ひらけるかも　しれないな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:47:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:05:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いな▼
これほどの　強さを　持った
トレーナーは　はじめてだ▼
わたしの　生涯
最高の　戦いだったよ▼
最強への　答えは　見えたかい？▼
キミなら　いつか　最強への
道が　開けるかも　知れないな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T08:49:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:05:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初回　戦闘終了　ホワイトエリア10
（バージョン違いに登場するトレーナー用）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T07:41:56" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_doctor_msg_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンが　つかれているようだ
かいふくして　あげようか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンが　疲れているようだ
回復して　あげようか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ドクター回復確認</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T08:28:33" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_doctor_msg_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わっかた　かいふくしたくなったら
ここに　くるといい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わかった　回復したくなったら
ここに　来るといい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ドクター回復拒否</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T08:28:41" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_doctor_msg_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たんれんも　いいが　ポケモンに
あまり　むり　させないようにな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鍛錬も　いいが　ポケモンに
あまり　無理　させないようにな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ドクター回復後</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T08:28:46" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_nurse_msg_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　ポケモンが　おつかれね
かいふくして　あげましょうか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　ポケモンが　お疲れね
回復して　あげましょうか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ナース回復確認</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T08:28:57" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_nurse_msg_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わかったわ
でも　むりは　きんもつよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わかったわ
でも　無理は　禁物よ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ナース回復拒否</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T08:29:00" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_nurse_msg_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さきは　まだまだ　ながいわ
がんばってね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>先は　まだまだ　長いわ
がんばってね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ナース回復後</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T08:29:04" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff78ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いらっしゃいませ
くろのまてんろうに　ようこそ！▼
それでは　ごようけんを
おつたえください</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:43:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:26:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いらっしゃいませ
黒の摩天楼に　ようこそ！▼
それでは　ご用件を　お伝えください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:41:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:22:33" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　エリアに
ちょうせんなさいますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:26:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:26:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの　エリアに
挑戦なさいますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:23:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:22:48" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_03_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　エリアに
ちょうせんなさいますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:42:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:27:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　エリアに
挑戦なさいますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:42:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:23:07" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅんびは　よろしいですか？
それでは　がんばってくださいね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-24T04:56:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:27:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>準備は　よろしいですか？
それでは　がんばってくださいね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:51:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:23:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_help_b_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　しせつは　トレーナーの
みなさまに　たんれんの　ばしょとして▽
ていきょうされている　しせつです▼
しせつないには　[Name:TrainerName Idx="0" ]さまと
おなじく　しせつ　ちょうせんちゅうの▽
トレーナーのかたが　いらっしゃいます▼
ほかの　トレーナーのかたは
[Name:TrainerName Idx="0" ]さまを　みかけましたら▽
たいせんを　いどんできます▼
たちふさがる　トレーナーを　たおし
エリアクリアを　めざして　ください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:06:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:27:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　施設は　トレーナーの
皆様に　鍛錬の　場所として▽
提供されている　施設です▼
施設内には　[Name:TrainerName Idx="0" ]様と
同じく　施設　挑戦中の▽
トレーナーの方が　いらっしゃいます▼
ほかの　トレーナーの方は
[Name:TrainerName Idx="0" ]様を　見かけましたら▽
対戦を　挑んできます▼
立ちふさがる　トレーナーを　倒し
エリアクリアを　目指して　ください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:25:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:23:38" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:19:33" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_help_b_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリアクリアには　エリアの
どこかにいる　ボストレーナーを▽
たおすことで▼
つぎのエリアに　ちょうせんすることが
できます▼
エリアにいる　トレーナーと
たいせんして　うでを　みがくもよし▼
ボストレーナーを　さがしだし
エリアクリアを　めざすもよし▼
じぶんの　つよさの　げんかいに　
ちょうせんしてみては▽
いかがでしょうか？▼
なお　しせつないでは　
バッグにある　どうぐの　しようを▽
きんししております▼
あらかじめ　ごりょうしょうください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:13:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T06:28:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エリアクリアには　エリアの
どこかにいる　ボストレーナーを▽
倒すことで▼
次のエリアに　挑戦することが
できます▼
エリアにいる　トレーナーと
対戦して　腕を　磨くもよし▼
ボストレーナーを　探し出し
エリアクリアを　目指すもよし▼
自分の　強さの　限界に　
挑戦してみては▽
いかがでしょうか？▼
なお　施設内では　
バッグにある　どうぐの　使用を▽
禁止しております▼
あらかじめ　ご了承ください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:26:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:25:15" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_attention_b_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま！▼
しつれいですが　おつれの
[Name:PokemonNickname Idx="1" ]では▼
エリア[Digit:2digits Idx="2" ]に　ちょうせんするには
しょうしょう　じつりょくが　たりません▼
エリア[Digit:2digits Idx="2" ]には
レベル[Digit:2digits Idx="3" ]いじょうの　ポケモンで▽
ちょうせんしてください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:01:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T09:59:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様！▼
失礼ですが　お連れの
[Name:PokemonNickname Idx="1" ]では▼
エリア[Digit:2digits Idx="2" ]に　挑戦するには
少々　実力が　足りません▼
エリア[Digit:2digits Idx="2" ]には
レベル[Digit:2digits Idx="3" ]以上の　ポケモンで▽
挑戦してください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:00:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:26:32" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・ニックネーム＝ポケモン名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:19:47" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_attention_b_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま！▼
タマゴを　おもちの　ばあい
エリア[Digit:2digits Idx="1" ]に▽
ちょうせんすることは　できません▼
もうしわけありませんが
タマゴを　おあずけに　なってから▽
ちょうせんしてください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T04:49:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T09:59:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様！▼
タマゴを　お持ちの　場合
エリア[Digit:2digits Idx="1" ]に▽
挑戦することは　できません▼
申し訳ありませんが
タマゴを　お預けに　なってから▽
挑戦してください▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T04:49:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:26:32" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T04:49:03" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_b_cancel_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それでは　またの　ごりようを
おまして　おります</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:01:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それでは　またの　ご利用を
お待ちして　おります</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:27:32" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま！▼
エリア[Digit:2digits Idx="1" ]の　クリア
おめでとうございます！▼
きねんに　こちらの　しょうひんを
どうぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:58:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:01:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様！▼
エリア[Digit:2digits Idx="1" ]の　クリア
おめでとうございます！▼
記念に　こちらの　商品を
どうぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:27:53" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:20:22" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あわせて　エリア[Digit:2digits ]への
ちょうせんが　かのうと　なりました▼
ひきつづき　ちょうせんを
おまちして　おります▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:02:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>合せて　エリア[Digit:2digits ]への
挑戦が　可能と　なりました▼
引き続き　挑戦を
お待ちして　おります▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-10T07:59:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:31:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:20:29" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_03_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま▼
じつは　このしせつには
いっぱんには　こうかいされていない▽
とくべつな　エリアが　ございます▼
それが　エリア６いこうの　エリアです▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:18:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:18:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様▼
じつは　この施設には
一般には　公開されていない▽
特別な　エリアが　ございます▼
それが　エリア６以降の　エリアです▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:32:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:32:20" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:20:00" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こちらの　エレベーターには
おきづきでしたか？▼
この　エレベーターに　のることで
エリア６いこうの　ちょうせんが▽
かのうとなります▼
ただし！　エリア6いこうは
われわれの　かんりがいの　エリアのため▼
どんな　トレーナーが　いるのか
はあくしていない　じょうたいです▼
きけんは　ないと　おもうのですが　……▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:54:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:19:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こちらの　エレベーターには
お気づきでしたか？▼
この　エレベーターに　乗ることで
エリア6以降の　挑戦が▽
可能となります▼
ただし！　エリア6以降は
我々の　管理外の　エリアのため▼
どんな　トレーナーが　いるのか
把握していない　状態です▼
危険は　ないと　思うのですが　……▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:54:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:32:31" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_05_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とにかく　エリア６いこうの　
ちょうせんを　おかんがえなら▼
ポケモンを　じゅうぶんに　
そだててからの▽
ちょうせんを　おすすめします▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:36:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:36:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とにかく　エリア6いこうの　
挑戦を　お考えなら▼
ポケモンを　十分に　
育ててからの▽
挑戦を　お勧めします▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:36:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:34:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_06_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]さま！▼
……　まさか　すべての　エリアを？▼
おどろきました
おめでとうございます！▼
エリアせいはを　たたえ
こちらの　きねんひんを　さしあげます▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:58:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:04:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]様！▼
……　まさか　全ての　エリアを？▼
驚きました
おめでとうございます！▼
エリア制覇を　称え
こちらの　記念品を　差し上げます▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:58:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:38:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:20:03" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_b_07_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これからも　さいきょうの
トレーナーを　めざして▽
がんばってくださいね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:04:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これからも　最強の
トレーナーを　目指し▽
がんばってくださいね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:39:08" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よう！　よくきたな
ここは　しろのじゅどうだ
きょうは　なにを　するんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:42:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よう！　よく来たな
ここは　白の樹洞だ
今日は　何を　するんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:45:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　エリアに
ちょうせんするんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:49:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの　エリアに
挑戦するんだ？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:50:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_03_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　エリアに
ちょうせんするか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:42:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　エリアに
挑戦するか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:42:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅんびが　できたようだな
やれるだけ　やってこい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:50:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>準備が　できたようだな
やれるだけ　やってこい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:52:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_help_w_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　しせつは　おまえら
トレーナーの　たんれんの　ばしょとして▽
ていきょうされている　しせつだ▼
しせつないには　おまえと　おなじように
しせつを　ちょうせんちゅうの▽
トレーナーが　いる▼
ほかの　トレーナーは　おまえを
みかけたら　たいせんを▽
いどんでくるぞ▼
たちふさがる　トレーナーを　たおし
エリアとっぱを　めざすんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:53:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　施設は　お前ら
トレーナーの　鍛錬の　場所として▽　
提供されている　施設だ▼
施設内には　お前と　同じように
施設を　挑戦中の▽
トレーナーが　いる▼
他の　トレーナーは　お前を
見かけたら　対戦を　挑んでくるぞ▼
立ちふさがる　トレーナーを　倒し
エリア突破を　目指すんだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:54:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_help_w_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリアクリアには　エリアの　
どこかにいる　ボストレーナーを▽
たおすことで▼
つぎのエリアに　ちょうせんすることが
できるぜ▼
エリアにいる　トレーナーと　
たいせんして　うでを　みがくもよし▼
ボストレーナーを　さがしだし
エリアクリアを　めざすもよし▼
じぶんの　つよさの　げんかいに　
ちょうせんしてみな▼
よのなかには　つよいやつは
たくさんいるからな▼
そうそう　しせつないでは
バッグの　どうぐは▽
つかえないからな▼
おぼえておけよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:55:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エリアクリアには　エリアの
どこかにいる　ボストレーナーを▽
倒すことで▼
次のエリアに　挑戦することが
できるぜ▼
エリアにいる　トレーナーと　
対戦して　腕を　磨くもよし▼
ボストレーナーを　探しだし
エリアクリアを　目指すもよし▼
自分の　強さの　限界に　　
挑戦してみな▼
世の中には　強いやつは　
沢山いるからな▼
そうそう　施設内では
バッグの　どうぐは▽
使えないからな▼
覚えておけよ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:56:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_attention_w_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！▼
ちょっとまて！　つれている
[Name:PokemonNickname Idx="1" ]じゃ▼
エリア[Digit:2digits Idx="2" ]に　ちょうせんするには
じつりょくぶそくだな▼
エリア[Digit:2digits Idx="2" ]には
レベル[Digit:2digits Idx="3" ]いじょうの　ポケモンで▽
ちょうせんしてくれ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-22T12:43:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]！▼
ちょっと待て！　連れている
[Name:PokemonNickname Idx="1" ]じゃ▼
エリア[Digit:2digits Idx="2" ]に　挑戦するには
実力不足だな▼
エリア[Digit:2digits Idx="2" ]には
レベル[Digit:2digits Idx="3" ]以上の　ポケモンで▽
挑戦してくれ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:15:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・ニックネーム＝ポケモン名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:04" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_attention_w_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！▼
タマゴを　もっているときは
エリア[Digit:2digits Idx="1" ]に　ちょうせんすることは▽
できないぞ▼
わるいが　タマゴを　あずけてから
ちょうせんしてくれ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:17:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]！▼
タマゴを　持っているときは
エリア[Digit:2digits Idx="1" ]に　挑戦することは▽
できないぞ▼
悪いが　タマゴを　預けてから
挑戦してくれ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:17:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:17:48" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_w_cancel_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それじゃ　またきてくれよ</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:12:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それじゃ　また来てくれよ</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！▼
エリア[Digit:2digits Idx="1" ]を　クリアしたようだな▼
クリアの　きねんだ
もっていきな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T11:45:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]！▼
エリア[Digit:2digits Idx="1" ]を　クリアしたようだな▼
クリアの　記念だ
持っていきな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T11:46:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名
・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:04" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_02_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それと　エリア[Digit:2digits ]への
ちょうせんが　できるように　なったぞ▼
つぎの　エリアも　ちょうせんして
くれよな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T11:46:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それと　エリア[Digit:2digits ]への
挑戦が　できるように　なったぞ▼
次の　エリアも　挑戦して　くれよな▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-23T11:46:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・2桁＝エリアの数字</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:11" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_03_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]▼
じつは　このしせつには
いっぱんには　こうかいしていない▽
とくべつな　エリアが　あるんだ▼
それが　エリア６いこうの　エリアだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:03:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]▼
じつは　この施設には
一般には　公開されていない▽
特別な　エリアが　あるんだ▼
それが　エリア６以降の　エリアだ▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:03:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:19" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_04_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こっちの　エレベーターが
おまえも　きになっていたんじゃないか？▼
この　エレベーターに　のることで
エリア６いこうの　ちょうせんが　できるぜ▼
ただし！　エリア６いこうは
おれたちの　かんりがいの　エリアだ▼
すまんが　どんな　トレーナーが　いるのか
よくわからないんだ▼
きけんは　ないと　おもうがな　……▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:03:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こっちの　エレベーターが
お前も　気になっていたんじゃないか？▼
この　エレベーターに　乗ることで
エリア６以降の　挑戦が　できるぜ▼
ただし！　エリア６以降は
おれたちの　管理外の　エリアだ▼
すまんが　どんな　トレーナーが　いるのか
よくわからないんだ▼
危険は　ないと　思うがな　…▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:04:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_05_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とにかく　エリア6いこうの　
ちょうせんを　かんがえているなら▼
ポケモンを　じゅうぶんに　
そだててから　ちょうせんするんだな▼
いままでと　おなじだと　おもっていると
いたいめを　みるぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:05:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とにかく　エリア6以降の　
挑戦を　考えているなら▼
ポケモンを　十分に　育ててから
挑戦するんだな▼
今までと　同じだと　思っていると
痛い目を　みるぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:05:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_06_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！▼
……　まさか　すべての　エリアを？▼
こいつは　おどろいだぜ
たいしたやつだ　おまえは！▼
エリアせいはの　きねんだ
こいつを　もっていきな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]！▼
……　まさか　全ての　エリアを？▼
こいつは　驚いたぜ
大した奴だ　お前は▼
エリア制覇の　記念だ
こいつを　持っていきな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>・トレーナー名＝プレイヤー名</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-03T09:21:23" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_info_clear_w_07_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これで　まんぞくするなよ？▼
さいきょうの　トレーナーを　めざし
しょうじんしろよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これで　満足するなよ？▼
最強の　トレーナーを　目指し
精進しろよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-14T07:59:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T10:45:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="msg_info_menu_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せつめい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
