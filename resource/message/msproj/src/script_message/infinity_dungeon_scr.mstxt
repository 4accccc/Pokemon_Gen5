	<TextRow
		Label="msg_elevator_01_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんかいに　いどうしますか？</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-01T11:27:29" />
