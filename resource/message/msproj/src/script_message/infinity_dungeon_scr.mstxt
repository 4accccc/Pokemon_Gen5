		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょかい　せんとう　かいし（ブラック）▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
