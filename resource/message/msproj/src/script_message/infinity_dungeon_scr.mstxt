	<TextRow
		Label="msg_b_boss_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんかいは　やられたけど
こんかいは　ひとあじ　ちがうぞ！▼
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>前回は　やられたけど
今回は　一味　違うぞ！▼
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:46" />
			<Status>Editing</Status>
