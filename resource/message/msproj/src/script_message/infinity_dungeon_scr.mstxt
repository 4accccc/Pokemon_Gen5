<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_w_boss_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　ちょうせん　してくれて
うれしいわ▼
さあ　あれから　どれだけ
せいちょうしたか　みせてもらうわよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　挑戦してくれて
うれしいわ▼
さあ　あれから　どれだけ
成長したか　みせてもらうわよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:02:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア1
ボス：BREEDERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:37:17" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アドバイス……
は　もう　いらないね▼
キミが　どれだけ　
つよくなったか　ためしてあげよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アドバイス……
は　もう　いらないね▼
キミが　どれだけ
強くなったか　試してあげよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア2
ボス：BREEDERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:37:39" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんかいは　やられたけど
こんかいは　ひとあじ　ちがうわ！▼
さあ　しょうぶ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T12:12:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>前回は　やられたけど
今回は　一味　違うわ！▼
さあ　勝負！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:03:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア3
ボス：RANGERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:37:52" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろのじゅどうを
たのしんで　いるかい？▼
あれから　キミが　どこまで
いけたのか　きょうみが　あるね▼
さあ　せいちょうした
キミの　ちからを　みせて　もらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>白の樹洞を　楽しんで　いるかい？▼
あれから　キミが　どこまで
行けたのか　興味が　あるね▼
さあ　成長した　キミの　ちからを
みせて　もらおう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T04:03:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア4
ボス：RANGERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:38:10" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あれから　さらに　つよくなったようね
キミと　たたかえるのが　うれしいわ▼
こんどは　わたしが
キミに　ちょうせん　するわね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:41:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あれから　さらに　強くなったようね
キミと　戦えるのが　うれしいわ▼
今度は　わたしが
キミに　挑戦するわね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:41:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア5
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:38:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　あのときの　こどもか▼
どうした？　こんな　ばしょには
もう　ようは　ないだろう？▼
また　ちょうせんに　きたのか？
まあ　いい　あいてを　しよう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:43:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　あのときの　子供か▼
どうした？　こんな　場所には
もう　用は　ないだろう？▼
また　挑戦に　来たのか？
まあ　いい　相手を　しよう▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:44:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア6
ボス：TRAINERM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:38:35" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ　きた　きた！
また　きてくれたのね！▼
それじゃ　わたしと　たたかいましょう！▼
たたかって　たたかって　わたしは
もっと　つよくなるの！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:48:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あ　来た　来た！
また　来てくれたのね！▼
それじゃ　わたしと　戦いましょう！▼
戦って　戦って　わたしは
もっと　強くなるの！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T04:49:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア7
ボス：TRAINERW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:38:47" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ん？　ああ　また　きたんだ
ここまで　ごくろうさま▼
せっかく　きてくれたんだ
めんどうだけど　たたかおうか▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:35:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ん？　ああ　また　来たんだ
ここまで　ごくろうさま▼
せっかく　来てくれたんだ
面倒だけど　戦おうか▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T02:42:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア8
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:39:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたも　たたかいつづけて　いるのね▼
わたしも　まだ　つよさの　いみは
みつけられないわ▼
さあ　あなたの　めざす　つよさを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T06:55:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたも　戦い続けて　いるのね▼
わたしも　まだ　強さの　意味は
みつけられないわ▼
さあ　あなたの　目指す　強さを
わたしに　みせてみなさい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:59:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア9
ボス：VETERANW</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:39:22" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえと　おいら！▼
おたがいの　ポケモンたち！▼
もてる　ちから！▼
のこすところなく　ぶつけるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:01:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえと　おいら！▼
お互いの　ポケモンたち！▼
持てる　力！▼
残すところなく　ぶつけるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-29T04:01:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア10
ボス：MUGENBOSS（バンジロウ）</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:40:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MUGENBOSS
バンジロウ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-17T05:35:59" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_w_boss_start_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうとは　なにか？
その　こたえは　みつかったかい？▼
そのこたえを　みつけるまで
たたかいつづけると　しよう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:35:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="onoue_masayuki:W00272"
				Time="2011-08-07T07:00:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強とは　何か？
その　答えは　みつかったかい？▼
その答えを　みつけるまで
戦い続けると　しよう！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-25T07:37:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:01:34" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>再戦　戦闘開始　ホワイトエリア10
（バージョン違いに登場するトレーナー用）
ボス：VETERANM</Comment>
			<CommentModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-09-07T03:40:36" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="msg_b_boss_start_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　ちょうせんしてくれて
うれしいよ▼
さあ　あれから　どれだけ
せいちょうしたか　みせてもらうよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:43:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　挑戦してくれて
うれしいよ▼
さあ　あれから　どれだけ
成長したか　みせてもらうよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-09T05:43:52" />
