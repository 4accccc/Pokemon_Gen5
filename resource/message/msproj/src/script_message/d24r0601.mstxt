<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d26r0601_swbell_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ！　ここを　ぬけると
サザナミタウンだね！▼
あたしは　もうちょっと
しらべたいんだけど　どうする？▽
いちど　ここで　わかれちゃう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T05:14:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ！　ここを　ぬけると
サザナミタウンだね！▼
あたしは　もうちょっと
調査したいんだけど　どうする？▽
一度　ここで　別れちゃう？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-17T05:14:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀：Black2ver
・連れ歩き終了の確認
・swbell_05かswbell_06表示済み
・はい/いいえの選択肢表示
　はい　→swbell_15orswbell_16
　いいえ→swbell_17</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T10:51:43" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T07:44:09" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T05:58:47" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ffff</CellData>
