	<TextRow
		Label="msg_r09r0202_mission_add_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フフフ……
だいじなのは　じぶんが▽
なっとく　したか　どうかさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T03:48:31" />
			<Status>Editing</Status>
