	<TextRow
		Label="msg_r04r0401_gentleman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やあ！
ようこそ　いらっしゃいました！▼
……あのう
ここには　なんにも　ないのです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T09:18:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やあ！
ようこそ　いらっしゃいました！▼
……あのう
ここには　なんにも　ないのです</Text>
