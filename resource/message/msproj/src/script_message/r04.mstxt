	<TextRow
		Label="msg_r04_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さばくに　うもれた　いせき……
そこはかとなく　ロマンティックね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂漠に　埋もれた　遺跡……
そこはかとなく　ロマンティックね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・砂漠に行く手前に配置
※swanでメッセージ内容変更</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
