	<TextRow
		Label="msg_r04_man2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フリーウェイを　みていると
なんというか　みたされるんだ……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フリーウェイを　みていると
なんというか　満たされるんだ……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
