	<TextRow
		Label="msg_d06r0301_hakaiw1_end_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだん『……もとプラズマだんが
ふつうの　ポケモントレーナーになる▽
いまが　その　しゅんかん　だったのね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
