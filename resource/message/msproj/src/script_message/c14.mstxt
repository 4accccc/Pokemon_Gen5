	<TextRow
		Label="msg_c14_sign_01">
		<LanguageCell
			Language="JPN">
			<Text>ここは　セイガイハシティ
あらわすは　おだやかな　うみ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-01T06:06:18" />
