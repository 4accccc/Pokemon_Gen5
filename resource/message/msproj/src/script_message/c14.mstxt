	<TextRow
		Label="msg_c14_swleader8_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シズイ『よう！　おはんら！▼
きこえたけど　プラズマだん　って
なにしておる　れんちゅう　よ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T09:23:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T09:59:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シズイ『よう！　おはんら！▼
きこえたけど　プラズマ団　って
なにしておる　連中よ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T09:23:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T09:59:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・画面したから登場
・続けてswrival_05</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-07T12:41:58" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER8
ジムリーダー・シズイ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:32:52" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
