			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あははは！　おーい！
待てよー！　捕まえちゃうぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T03:56:53" />
