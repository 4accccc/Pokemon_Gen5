	<TextRow
		Label="msg_c14_boy4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あははは！　おーい！
まてよー！　つかまえちゃうぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-20T03:56:37" />
