			Language="JPN">
			<Comment>♂
・GRIDX＝795、GRIDZ＝171辺り</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T09:49:42" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN2</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-11T09:39:17" />
		</AttributeCell>
		<AttributeCell
