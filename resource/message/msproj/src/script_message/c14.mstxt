			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c14_middleman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おっ　あんた
ジムリーダーに　ちょうせん？▼
だけど　シーちゃんに　あえっかな？
なんたって　じゆうじん　だもんな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-17T04:55:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おっ　あんた
ジムリーダーに　挑戦？▼
だけど　シーちゃんに　会えっかな？
なんたって　自由人だもんな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-17T04:55:58" />
			<Status>Editing</Status>
