	<TextRow
		Label="msg_c14_swleader8_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>で　おまはん
プラズマだんは　わるいと　おもうか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-13T07:05:40" />
