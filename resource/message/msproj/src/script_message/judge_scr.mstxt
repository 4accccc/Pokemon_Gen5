<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_judge_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ボクの　なまえは　ジャッジ！▼
ほんとうの　なまえは　ちがうけれど
みんな　ジャッジって　よんでくれるよ▼
なぜかというと　ボクには
ポケモンの　のうりょくを　みきわめる▼
つまり　ジャッジする
ふしぎな　ちからが　あるからなんだ▼
きみも　よかったら
のうりょくが　きになる　ポケモンを▽
ボクに　ジャッジさせてくださいよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボクの　名前は　ジャッジ！▼
ほんとうの　名前は　ちがうけれど
みんな　ジャッジって　よんでくれるよ▼
なぜかというと　ボクには
ポケモンの　能力を　見極める……▼
つまり　ジャッジする
不思議な　力が　あるからなんだ▼
きみも　よかったら
能力が　気になる　ポケモンを▽
ボクに　ジャッジさせてくださいよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・初回
・表示後、ポケモンリスト画面に</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>個体値判定</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
