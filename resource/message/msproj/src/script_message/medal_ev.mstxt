	<TextRow
		Label="msg_mdloyj_end_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:Place Idx="0"]に　ある
メダルラリーじむきょくで▼
ひょうしょうしきを　おこないますので
ぜひとも　おこしください！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
