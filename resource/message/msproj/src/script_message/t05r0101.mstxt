	</TextRow>
	<TextRow
		Label="msg_t05r0101_girl2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんしゃって　のるだけで　いろんな
けしきが　みれて　すごくない？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T09:48:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>電車って　乗るだけで　いろんな
景色が　みれて　すごくない？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T09:48:07" />
			<Status>Editing</Status>
