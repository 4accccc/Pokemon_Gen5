	<TextRow
		Label="msg_t05r0101_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゃりょうの　ほうこうを
かえるための　てんしゃだい▽
ターンテーブルとも　いうのよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T08:07:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>車両の　方向を
変えるための　転車台▽
ターンテーブルとも　いうのよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T08:07:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
