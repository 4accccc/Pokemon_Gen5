	<TextRow
		Label="bc10_25_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まだまだ　ポケモンしょうぶの
けんきゅうが　たりないようだな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まだまだ　ポケモン勝負の
研究が　足りないようだな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
