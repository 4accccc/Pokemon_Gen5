				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="bc10_30_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとがつくった　このまちの
けいさん　された　うつくしさ……▽
こころが　おどりますわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人がつくった　この街の
計算された　美しさ……▽
心が　おどりますわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
