	<TextRow
		Label="bc10_04_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんなん！？▼
あなた　すっごい　つよいねー！
わたしじゃ　かなわんわー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんなん！？▼
あなた　すっごい　強いねー！
わたしじゃ　敵わんわー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
