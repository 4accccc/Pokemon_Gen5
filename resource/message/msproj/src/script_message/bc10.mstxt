				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="bc10_18_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ガクト『いままでに　であった
ポケモンは　かずしれず……▼
そんな　わしの　ちからだめしに
つきあって　もらおうか！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ガクト『今までに　出会った
ポケモンは　数知れず……▼
そんな　わしの　力試しに
つきあって　もらおうか！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<AttributeCell
			Name="Character">
			<Text>MOUNTMAN
ガクト</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
