				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="bc10_13_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カルロス『おー！　こんにちは！▼
ここで　あったのも　なにかの　えん！
ポケモンしょうぶを　しようよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カルロス『おー！　こんにちは！▼
ここで　会ったのも　なにかの　縁！
ポケモン勝負を　しようよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
