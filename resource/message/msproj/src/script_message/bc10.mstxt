	</TextRow>
	<TextRow
		Label="bc10_03_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サイコーに　キマってんな　おまえ！
オトコみちの　むこうに　イけるぜ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サイコーに　キマってんな　おまえ！
オトコ道の　向こうに　イけるぜ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
