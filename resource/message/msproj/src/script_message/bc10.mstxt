				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="bc10_04_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちゃわちゃわした　せいかつが
くるしくなったしー▼
ひろいところで
いんぎらぁっと　したいねん！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちゃわちゃわした　生活が
苦しくなったしー▼
広いところで
いんぎらぁっと　したいねん！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
