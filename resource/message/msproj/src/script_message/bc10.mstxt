				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="bc10_21_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トシノブ『つよいか　そうじゃないか
キミとしょうぶして　かくにんする！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
