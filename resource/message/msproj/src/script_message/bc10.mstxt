	<TextRow
		Label="bc10_28_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとつのとちで　ずっとすごす……
そんな　くらしも　してみたいな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一つの土地で　ずっとすごす……
そんな　暮らしも　してみたいな</Text>
