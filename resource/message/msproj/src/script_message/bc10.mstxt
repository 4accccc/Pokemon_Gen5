	<TextRow
		Label="bc10_23_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリザ『あれも　ほしい！
これも　ほしい！▼
あなたとの　ポケモンしょうぶでの
しょうりも　ほしい！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
