	<TextRow
		Label="bc10_03_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツッパリすぎて　くたびれたぜ▼
ホワイトフォレストに
ちょっぴり　あこがれちゃうぜ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
