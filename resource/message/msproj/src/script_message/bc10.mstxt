	<TextRow
		Label="bc10_19_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんだか　こうりつばかり
おいもとめる　せいかつにも▽
つかれてきちゃった……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんだか　効率ばかり
追い求める　生活にも▽
つかれてきちゃった……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
