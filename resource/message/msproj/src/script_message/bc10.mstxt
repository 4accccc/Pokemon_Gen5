		</ExtraCell>
	</TextRow>
	<TextRow
		Label="bc10_21_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そっか……
オレって　よわいのか……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
