	<TextRow
		Label="bc10_28_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたりあるいて　ポケモンしょうぶ！
この　せいかつ　きにいってるんだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>渡り歩いて　ポケモン勝負！
この　生活　気に入ってるんだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
