	<TextRow
		Label="bc10_20_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきん　もっと　ワタシ
しぜんたいで　いても▽
いいような　きがしてるの！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最近　もっと　ワタシ
自然体で　いても▽
いいような　気がしてるの！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
