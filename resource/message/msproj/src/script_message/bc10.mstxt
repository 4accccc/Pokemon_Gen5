	<TextRow
		Label="bc10_20_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんなに　かわいくても
まけちゃうのねー！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
