				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="bc10_27_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ローザ『じんせい　なんて
ヒマつぶし……　そう　おもわない？▽
わたしと　あそびましょう！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ローザ『人生なんて
ヒマつぶし……　そう　思わない？▽
わたしと　遊びましょう！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
			<Status>Editing</Status>
