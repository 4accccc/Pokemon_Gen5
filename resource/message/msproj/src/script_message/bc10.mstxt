			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="bc10_03_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タクロウ『お！　キマってんな　おまえ！
オレと　どっちが　キマってるか▽
ポケモンしょうぶで　キめようぜ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
