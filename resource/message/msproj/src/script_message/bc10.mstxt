				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="bc10_25_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ケン『ポケモンしょうぶ　だけに
うちこんだ　じんせい……▽
スペシャリストとして　かつ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
