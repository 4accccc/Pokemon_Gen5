				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_t01r0201_middlewoman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベルのママ『へえ！　あなたも
アララギはかせから　ずかんを……！▼
うちの　むすめったら　ことあるたびに
ポケモンずかんを　みなおしているわ！▼
たくさんの　ポケモン……
たくさんの　おもいでが▽
つまった　たいせつな　ものですって</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T09:42:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベルのママ『へえ！　あなたも
アララギ博士から　図鑑を……！▼
うちの　娘ったら　ことあるたびに
ポケモン図鑑を　みなおしているわ！▼
たくさんの　ポケモン……
たくさんの　思い出が▽
詰まった　大切な　ものですって</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T08:35:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T09:42:49" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEWOMAN1
・ベルの母</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T09:26:40" />
		</AttributeCell>
