<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_t01r0201_middleman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベルのパパ『そうか
きみも　ポケモンと　たびを！▼
きみも　えらいが
きみの　おやは　えらい！▼
だってだよ
いつも　いっしょ　だったのに▽
いなくなるんだよ？▼
きっと　しんぱい　してただろう……
いや　まちがいなく　しんぱいだった！▼
だから……　きみの　たびでの
できごとを　はなしてあげると　いい</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T08:35:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベルのパパ『そうか
きみも　ポケモンと　旅を！▼
きみも　偉いが
きみの　親は　偉い！▼
だってだよ
いつも　一緒だったのに▽
いなくなるんだよ？▼
きっと　心配してただろう……
いや　間違いなく　心配だった！▼
だから……　きみの　旅での
できごとを　話してあげると　いい</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-22T08:35:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T10:11:03" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN1
・ベルの父</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-16T09:26:19" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:18" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
