	<TextRow
		Label="msg_c03p12_sunglasses_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どりゃー！！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
