	<TextRow
		Label="msg_c03p12_sunglasses_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ははは！　おどろいたか！▼
おどろかせて　もうしわけないので
おまえには　これを　やろう▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
