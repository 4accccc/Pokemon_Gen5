<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r14r0202_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　とちは　ランドロスさまに
まもられて　おるからのう▼
ゆたかな　つちと　おおくの　みのりを
やくそくされて　おるのじゃ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T05:26:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　土地は　ランドロス様に
守られて　おるからのう▼
豊かな　土と　多くの　実りを
約束されて　おるのじゃ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T05:26:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・うつしかがみ入手前</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T05:23:29" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>老人
CLEANINGM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r14r0202_oldman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みのり　ゆたかな　とちは
ひとと　ポケモンが　いっしょに▽
まもっていかにゃあ　いかんのう</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T05:23:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>実り　豊かな　土地は
人と　ポケモンが　いっしょに▽
守っていかにゃあ　いかんのう</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T05:23:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・うつしかがみ入手後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T05:23:29" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>老人
CLEANINGM</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
