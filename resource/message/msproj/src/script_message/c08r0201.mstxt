	<TextRow
		Label="msg_c08r0201_veteranm_04w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうみ　ないのか？▼
たのしいから　まず
かいせつを　きいてみてくれ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
