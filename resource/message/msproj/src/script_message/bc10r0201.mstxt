<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_bc10r0201_middleman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハッハッハ
もっと　おもちゃが　ほしいか！▼
よーし　あきるほど　かってやる！
へや　いっぱいに　かってやる！▼
そして　なんでも　ほしがることが
どういうことか　きづかせてやるぞお！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:34:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハッハッハ
もっと　おもちゃが　欲しいか！▼
よーし　飽きるほど　買ってやる！
部屋一杯に　買ってやる！▼
そして　なんでも　欲しがることが
どういうことか　気づかせてやるぞお！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:35:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正
※swanでマップ削除</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-16T06:54:42" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MIDDLEMAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</AttributeCell>
		<ExtraCell
