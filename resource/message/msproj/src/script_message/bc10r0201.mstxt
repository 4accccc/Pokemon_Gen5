	</TextRow>
	<TextRow
		Label="msg_bc10r0201_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あらあら
このコったら！▼
きちんと　あそぶまえに
あきたとか　いっちゃって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:34:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:09" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あらあら
このコったら！▼
きちんと　遊ぶ前に
飽きたとか　いっちゃって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-25T06:35:14" />
			<Status>Editing</Status>
