	<TextRow
		Label="msg_r04r0301_girl2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　ウソハチと
あたしの　マネネを▽
こうかん　してほしいな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T06:58:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T06:55:40" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　ウソハチと
あたしの　マネネを▽
交換してほしいな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-20T09:54:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T06:55:40" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ポケモン交換前
・はい/いいえの選択肢表示
　はい→ポケモン選択画面
　いいえ→girl2_02</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-07T06:58:41" />
		</CommentCell>
		<AttributeCell
			Name="Character">
