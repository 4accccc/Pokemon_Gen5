			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_fmission_check"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フェスミッションの　ないようを
かくにん　します▼</Text>
			<TextModifiedBy
				User="iwasawa:W00270"
				Time="2011-09-23T11:03:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フェスミッションの　内容を
確認します▼</Text>
			<TextModifiedBy
