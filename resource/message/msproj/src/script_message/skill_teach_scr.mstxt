	<TextRow
		Label="msg_skillteach_coalescence_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほな　どの　ポケモンに
わざを　おぼえさせるん？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
