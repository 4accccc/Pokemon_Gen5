<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r11r0101_infomationw_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビレッジブリッジは
そのなの　とおり▽
はしの　ような　むら……▼
いえ　むらのような　はし……▼
いえ　やっぱり　はしのような　はし▼
じゃなくて　むらのような　むら……▼
ああん　もう！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビレッジブリッジは
その名の通り▽
橋のような　村……▼
いえ　村のような　橋……▼
いえ　やっぱり　橋のような　橋▼
じゃなくて　村のような　村……▼
ああん　もう！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW
受付嬢</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_r11r0101_man3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンも　だいすき　ビレッジサンド
あじの　きめては　きのみのトッピング</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
