<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d12r0102_poke14_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ボールの　なかの
ビクティニが　でたがっている……▽
そとに　だしてあげますか？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:25:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:24:40" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボールの　中の
ビクティニが　でたがっている……▽
外に　だしてあげますか？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:25:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:25:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・pos起動
・GRIDX＝3～5、GRIDZ＝9
・はい/いいえの選択肢表示
　はい　→poke14_02
　いいえ→poke14_04
・この部屋を出るまで再度posを踏んでも
　メッセージは表示させない</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:29:27" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE14
ポケモン・ビクティニ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:22:29" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d12r0102_poke14_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きゅきゅわわーんっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:26:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:26:47" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きゅきゅわわーんっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:26:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:26:47" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・はい選択時
・ビクティニ出現後、メッセージ表示
　あわせて鳴き声再生
・そのあと室内を嬉しそうに飛び回るアニメ
　（現状おまかせ）
・主人公の前でもう一度メッセージ表示
　あわせて鳴き声再生後、続けてpoke14_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:29:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE14
ポケモン・ビクティニ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:22:41" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d12r0102_poke14_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビクティニは　まんぞく　したのか
ボールの　なかに　もどった！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:40:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:27:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビクティニは　満足したのか
ボールの　中に　戻った！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-23T10:41:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
