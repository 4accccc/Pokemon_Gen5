	<TextRow
		Label="msg_d06r0101_ninja_01a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……　……　……▼
Ｎさま　つれてきました▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
