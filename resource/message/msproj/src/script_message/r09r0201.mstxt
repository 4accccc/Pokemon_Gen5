	<TextRow
		Label="msg_r09r0201_workman_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃあ　おしえてやろう！▼
かみなりのいしを　つかうと
ある　ポケモンが　しんかするのさ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
