	<TextRow
		Label="msg_d24r0301_list_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ああ……　まだ
しらべている　とちゅう　なんだ▼
リバースマウンテンの　そとにも
ポケモンが　いるもんね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-19T09:11:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-08T05:13:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ああ……　まだ
調べている　途中　なんだ▼
リバースマウンテンの　外側にも
ポケモンが　いるもんね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-19T09:12:10" />
