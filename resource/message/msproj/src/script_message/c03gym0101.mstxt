		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かくれていると
しょうぶの　カンが　にぶるんだよ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
