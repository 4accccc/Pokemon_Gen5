		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぷひぃぃぃぃぃぃぃっぷ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
