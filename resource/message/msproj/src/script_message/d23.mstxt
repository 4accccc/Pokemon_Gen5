<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d23_sign_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タチワキ　コンビナート
まざる　ほのおと　はがね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タチワキ　コンビナート
融合する　ほのおと　はがね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>BGメッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>看板</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d23_badman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よぉ！　いい　はなし　だぜ▼
あんたの　モンスターボールと
おれの　スーパーボールを▽
こうかん　しよーじゃねーか！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:44:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よぉ！　いい　話だぜ▼
あんたの　モンスターボールと
おれの　スーパーボールを▽
交換しよーじゃねーか！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:44:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・道具交換前
・はい/いいえの選択肢表示
　はい　→badman1_02
　はい選択、だけど
　モンスターボールを持っていない→badman1_03
　いいえ→badman1_04
※不便なところに配置で</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d23_badman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へっへっへ！　とにかく
スーパーボール　つかってみなよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:44:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>へっへっへ！　とにかく
スーパーボール　使ってみなよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:44:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d23_badman1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あーっ！　まじかよ！　うそだろ？
モンスターボール　もってないのかよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あーっ！　まじかよ！　うそだろ？
モンスターボール　持ってないのかよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい選択だけど
　モンスターボールを持っていない</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d23_badman1_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あーっ！　まじかよ！　うそだろ？
ふつー　とりかえっこ　するだろ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あーっ！　まじかよ！　うそだろ？
ふつー　取り換えっこ　するだろ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・いいえ選択</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d23_badman1_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なっ！　いい　はなし　だったろ？
よければ　また　あしたなっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-08T02:12:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なっ！　いい　話だったろ？
よければ　また明日なっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-08T02:12:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・道具交換後
・日付が変わればbadman1_01から</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-04T06:42:44" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d23_badman1_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あーっ！　まじかよ！　うそだろ？
スーパーボール　もちすぎだろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:45:17" />
