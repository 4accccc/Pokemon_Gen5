	<TextRow
		Label="msg_c03r0301_cleaningm_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　おそうじおじさん♪
こころも　きれいに　したいのよ♪▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
