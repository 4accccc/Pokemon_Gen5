			Name="Character">
			<Text>WOMAN2</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
