	<TextRow
		Label="msg_h02_boy2_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　はねばしを　つくった　ひとは
リザードンと　いっしょに　いたのかな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:14" />
			<Status>Editing</Status>
