	</TextRow>
	<TextRow
		Label="msg_c04r0111_veteranw_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>５０れんしょうまで　あといっぽ！
がぜん　きあいが　はいりますわ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
