			Language="JPN">
			<Comment>スーパー42連勝
♂</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>trainerm
エリートトレーナー♂</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c04r0111_trainerm_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリートの　ワシと　いえども
そろそろ　つらくなってきたぜよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
