	<TextRow
		Label="msg_c04r0111_girl2_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>７れんしょう　するごとにね
しょうぶを　いどんでくる▽
トレーナーも　ポケモンも▽
つよく　てごわくなっていくの</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>７連勝　するごとにね
勝負を　挑んでくる▽
トレーナーも　ポケモンも▽
強く　手ごわくなっていくの</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
