	<TextRow
		Label="msg_c04r0111_cleaningm_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうじ　してたら　ひろったのよー
おめーさん　よかったら　もってきな▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
