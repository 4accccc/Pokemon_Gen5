	<TextRow
		Label="msg_c04r0111_gentleman_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここが　しゅうてんなのか……▼
ポケモンしょうぶの　たびも
ひとまず　おしまいと　いうことか</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
