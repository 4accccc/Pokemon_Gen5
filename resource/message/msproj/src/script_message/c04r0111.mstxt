	<TextRow
		Label="msg_c04r0111_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　きねんに
トロフィーを　さしあげます▽
ごじたくに　おかざり　ください！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　記念に
トロフィーを　さしあげます▽
ご自宅に　お飾りください！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
