	<TextRow
		Label="msg_c04r0111_trainerw_1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　つよい　あいてにしか
きょうみが　ないの……▼
アナタも　つよくなったら
しょうぶして　あげてもいいわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　強い　相手にしか
興味が　ないの……▼
アナタも　強くなったら
勝負して　あげてもいいわ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
