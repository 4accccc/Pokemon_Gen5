	<TextRow
		Label="msg_c04r0111_oldman1_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナー　つよくなってきましたね
わたし　なんだか　ふあんですよ……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナー　強くなってきましたね
私　なんだか　不安ですよ……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
