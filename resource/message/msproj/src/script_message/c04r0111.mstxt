	<TextRow
		Label="msg_c04r0111_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せいせきを　レポートに　かいています
でんげんを　きらないでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>成績を　レポートに　書いています
電源を　切らないでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
