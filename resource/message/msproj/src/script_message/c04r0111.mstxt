	<TextRow
		Label="msg_c04r0111_gentleman_4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アナタモ　サブウェイマスターニ
カッタノデスネ！▼
イツカ　イッショニ
ショウブ　シタイモノデス</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
