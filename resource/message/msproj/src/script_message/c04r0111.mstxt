	<TextRow
		Label="msg_c04r0111_trainerw_5_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたも　たたかい　つづけるでしょ？
だって　わたしたちは▽
そういう　にんげん　だものね……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
