		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せいそういんでも　じつりょくには
おおいに　じしん　ありじゃ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
