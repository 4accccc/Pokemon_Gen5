	<TextRow
		Label="msg_c04r0111_badman_3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たかが　ポケモン　されど　ポケモン
ポケモンしょうぶの　せかいは▽
マジで　とことん　ディープだよな</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
