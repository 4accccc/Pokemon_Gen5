	<TextRow
		Label="msg_c04r0111_trainerm_5"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３００にん　いじょう　トレーナーを
たおしたんだな　オレたちは……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３００人　以上　トレーナーを
倒したんだな　オレたちは……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
