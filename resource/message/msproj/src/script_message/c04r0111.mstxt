	<TextRow
		Label="msg_c04r0111_policeman_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんかんは　ここまでかな……▼
ホームを　よぎる　でんしゃの
ライトが　やけに　まぶしいですなァ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
