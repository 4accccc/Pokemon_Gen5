	<TextRow
		Label="msg_r19_boy2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そっか……▼
こんな　だんさなら　ジャンプして
とびおりられるって　しってるよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そっか……▼
こんな　段差なら　ジャンプして
飛び降りられるって　知ってるよね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
