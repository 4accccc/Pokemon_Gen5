	</TextRow>
	<TextRow
		Label="msg_r19_champion_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『そこの　トレーナー！！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
