	<TextRow
		Label="msg_r19_boy2_02a"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうなんだ……
じゃあ　ぼくが　みほんをみせるよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
