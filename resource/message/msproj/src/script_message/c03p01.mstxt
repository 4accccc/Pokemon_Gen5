	<TextRow
		Label="msg_c03p01_sign2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このさき　モードストリート
ヒウンアイス　＆　アトリエ　ヒウン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
