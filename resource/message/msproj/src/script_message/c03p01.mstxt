	<TextRow
		Label="msg_c03p01_swboss_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さしつかえなければ　あなたの
ポケモンを　みせてもらいたいのです▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
