	<TextRow
		Label="msg_c03p01_swboss_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『なるほど！
ですが　けんきゅう　ですから！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-11T03:29:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>？？？『なるほど！
ですが　研究ですから！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-11T03:29:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
