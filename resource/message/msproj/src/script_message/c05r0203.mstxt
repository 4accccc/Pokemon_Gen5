<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c05r0203_girl4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かわり　つづけるからこそ
かわらずに　いきてられるのよ▼
ポケモンだって　しんか　するけれど
ほんしつは　おなじ　ままよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T11:12:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>変わり続けるからこそ
変わらずに　生きてられるのよ▼
ポケモンだって　進化するけれど
本質は　同じ　ままよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T11:13:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・GRIDX＝3、GRIDZ＝8</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:53:48" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL4</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:55:45" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0203_boy4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくの　きおくに　のこる
ホドモエは　どこか　やぼったい▽
ふんいき　だったのになあ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:50:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:48:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくの　記憶に　残る
ホドモエは　どこか　野暮ったい▽
雰囲気だったのになあ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:50:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:48:51" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・GRIDX＝1、GRIDZ＝9</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:48:47" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY4</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-04T10:55:37" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c05r0203_poke42_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おや？　ポケモンは
なにかを　くわえている▼</Text>
