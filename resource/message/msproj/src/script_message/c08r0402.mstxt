	<TextRow
		Label="msg_c08_babyboy1_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タイム『ぼくね　ぼくね
おおきくなったら　なにになろうかな？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
