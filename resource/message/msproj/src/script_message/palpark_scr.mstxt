	<TextRow
		Label="msg_palpark_first_18"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はやく　はやく！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
