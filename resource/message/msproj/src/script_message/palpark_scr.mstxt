	<TextRow
		Label="msg_palpark_first_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きたわね！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
