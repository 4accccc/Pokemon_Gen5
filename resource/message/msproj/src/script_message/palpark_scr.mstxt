	</TextRow>
	<TextRow
		Label="msg_palpark_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レポートへ　かきこんでいます
でんげんを　きらないで　ください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レポートへ　書きこんでいます
電源を　切らないで　ください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:15" />
			<Status>Editing</Status>
