	<TextRow
		Label="msg_c02r0301_woman2_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だめなら　しかたないな……▼
でも　きが　かわったら
ポケモン　こうかん　しようね！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
