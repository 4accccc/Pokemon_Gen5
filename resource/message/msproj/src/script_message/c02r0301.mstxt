				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_c02r0301_woman2_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うふふ！　あたしの
[Name:PokemonName Idx="1" ]　だいじにしてね！▼
あたしも　もらった
[Name:PokemonName Idx="0" ]　だいじに　するから！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うふふ！　あたしの
[Name:PokemonName Idx="1" ]　大事にしてね！▼
あたしも　もらった
[Name:PokemonName Idx="0" ]　大事にするから！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・交換デモ終了後、以下のメッセージを自動表示
・0＝渡すポケモン
・1＝もらうポケモン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GIRL2</Text>
