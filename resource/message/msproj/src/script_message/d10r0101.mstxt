	<TextRow
		Label="msg_d10r0101_swplazmam_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……うう！　だって
Ｎさま　ポケモンに　やさしかったし▼
オレも　わるい　にんげんから
ポケモンを　まもりたいって……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T07:27:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T07:04:47" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……うう！　だって
Ｎさま　ポケモンに　優しかったし▼
オレも　悪い　人間から
ポケモンを　守りたいって……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-16T07:27:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-09T07:04:47" />
		</LanguageCell>
