	<TextRow
		Label="msg_d27r1001_pass_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうちが　ある……▼
パスワードを　いれるみたいだが
カードキーが　ひつよう　そうだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-24T09:10:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
