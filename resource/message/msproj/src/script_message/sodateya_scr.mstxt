				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_sodateya_oldman_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てもちが　いっぱいの　ようじゃな……▼
てもちの　ポケモンを
せいりしてから　またきなさい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>手持ちが　一杯の　ようじゃな……▼
手持ちの　ポケモンを
整理してから　また来なさい</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：育て屋じいさん
・タマゴあり
・はい＋手持ち空きなし</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おじいさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_sodateya_oldman_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わしが　もらってしまうぞ
ほんとうは　ほしいんじゃろ？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わしが　もらってしまうぞ
本当は　ほしいんじゃろ？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：育て屋じいさん
・タマゴあり
・いいえ選択時
・再確認
　はい＋手持ち空きあり→oldman_08
　はい＋手持ち空きなし→oldman_09
　いいえ→oldman_11</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おじいさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_sodateya_oldman_11"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それじゃ　わしが　もらおう
ありがとよ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
