<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_sodateya_oldman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わしは　そだてや　じいさんじゃ▼
ここで　みんなの　だいじな
ポケモンの　せわを　しておるよ▼
なにか　そだてて　ほしければ
ばあさんに　たのんで　おくれ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わしは　育て屋じいさんじゃ▼
ここで　みんなの　大事な
ポケモンの　世話を　しておるよ▼
なにか　育てて　ほしければ
ばあさんに　頼んで　おくれ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：育て屋じいさん
・タマゴなし
・預けているポケモン＝0匹</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>おじいさん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_sodateya_oldman_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よくきたな！
[Name:PokemonNickname Idx="0" ]は　げんきじゃぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
