	<TextRow
		Label="msg_c04pc0101_girl4_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>５ばんどうろで　であった
あたくしの　うるわしい　チラーミィ！▼
ぜったい　ミュージカルで
にんきものに　なれるはずよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>５番道路で　運命の　出会いをした
あたくしの　麗しい　チラーミィ！▼
絶対　ミュージカルで
人気者に　なれるはずよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:11" />
		</CommentCell>
		<AttributeCell
