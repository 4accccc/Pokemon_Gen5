<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_h05_poke1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みかづきのはねが　かがやきだした！
かざして　みますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:25:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:25:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みかづきのはねが　輝きだした！
かざして　みますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:30:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・No000「みかづきのはね」を持っている状態で
　pos（GRIDX＝、GRIDZ＝）を踏んだとき
・はい/いいえの選択肢表示
　はい　→poke1_02
　いいえ→終了</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:30:20" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・クレセリア</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:22:58" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_h05_poke1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>るなーん</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:29:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:25:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>るなーん</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:29:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:29:26" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・はい選択時、クレセリア登場して待機
・会話すると
　表示にあわせて鳴き声再生
・続けて戦闘に</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:30:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・クレセリア</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:23:00" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_h05_poke1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンは
どこかに　さっていった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:29:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:28:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンは
どこかに　去っていった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:29:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:28:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>イベント
・捕獲以外で戦闘終了した場合
・殿堂入りで復帰</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:29:28" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・クレセリア</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-12T05:23:00" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_h05_woman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ワンダーブリッジ　めいぶつ
