	<TextRow
		Label="msg_h05_bridge_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シャキーン！！▼
うるおい１００パーセント！
げんき　でてきたー！　ありがとう▼
ぼくは　ダッシュして
つぎの　はしに　むかうのです！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-26T12:13:58" />
			<Status>Editing</Status>
