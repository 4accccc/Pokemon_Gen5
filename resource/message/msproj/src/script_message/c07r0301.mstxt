<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c07r0301_badman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オー！　ワタシ
メンバー・オブ・ロケットだん　ね！[Ctrl2:PageClear ]
ロング　アゴー
ロケットだん　きえてなくなったよ[Ctrl2:PageClear ]
なので　ワタシ
リターン　マイ　カントリー[Ctrl2:LineFeed ]
アンド　メイク　ロケットだん！[Ctrl2:LineFeed ]
そう　ちかいましたー！[Ctrl2:PageClear ]
でも　ゴー　ホームして
けっこん　したら▽
それどころじゃ　ないでーす[Ctrl2:PageClear ]
オー！
しあわせ　ファミリー　ばんざーい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オー！　ワタシ
メンバー・オブ・ロケットだん　ね！[Ctrl2:PageClear ]
ロング　アゴー
ロケットだん　きえてなくなったよ[Ctrl2:PageClear ]
なので　ワタシ
リターン　マイ　カントリー[Ctrl2:LineFeed ]
アンド　メイク　ロケットだん！[Ctrl2:LineFeed ]
そう　ちかいましたー！[Ctrl2:PageClear ]
でも　ゴー　ホームして
けっこん　したら▽
それどころじゃ　ないでーす[Ctrl2:PageClear ]
オー！
しあわせ　ファミリー　ばんざーい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・HGSS（金銀）のハナダなどにいた
　外国人のロケット団
・冬しか入れない</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BADMAN</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c07r0301_boy3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とうちゃん　むかし　がいこくで
かっこいい　しごとを　してたんだ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>父ちゃんは　昔　外国で
かっこいい　仕事を　してたんだ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※SWANではここから引越し予定</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>BOY3</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c07r0301_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いらっしゃい！[Ctrl2:PageClear ]
そうだ！　ハニーの　むかしの
しごとなかまが　くれた　おみやげが[Ctrl2:LineFeed ]
たくさん　あるから　わけてあげる▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いらっしゃい！[Ctrl2:PageClear ]
そうだ！　ハニーの　昔の
仕事仲間が　くれた　お土産が[Ctrl2:LineFeed ]
たくさん　あるから　わけてあげる▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・アイテム入手処理
　No504「いかりまんじゅう」入手</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
