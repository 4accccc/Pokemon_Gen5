<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c01r0202_gentleman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　ポケモンは
どんな　ニックネームだい？▼
わがはいは　すべての　ポケモンも
たろう　とつけちゃうんだよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:03:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　ポケモンは
どんな　ニックネームだい？▼
我輩は　すべての　ポケモンも
たろう　とつけちゃうんだよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:03:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:04:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GENTLEMAN
紳士</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01r0202_dancer_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレさ　また　がいこくに　いってさ
ポケモンしょうぶ　してくるつもり▼
だって　がいこくに　いくと
じぶんの　あたりまえが　つうじなくて▽
いろいろ　はっけんが　あるんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:02:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレさ　また　外国に　行ってさ
ポケモン勝負　してくるつもり▼
だって　外国に　いくと
自分の　当たり前が　通じなくて▽
いろいろ　発見が　あるんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:04:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:02:30" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN1</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c01r0202_woman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たびの　トレーナーさん▼
あなたの　かぞくは
ライブキャスターを▼
かけてくる　ひと？
それとも　まっている　ひと？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:00:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たびの　トレーナーさん▼
あなたの　家族は　ライブキャスターを
かけてくる　人？▽
それとも　待っている　人？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:01:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:02:32" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WOMAN3
エプロン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
