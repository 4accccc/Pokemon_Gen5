<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_c01r0202_gentleman_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　ポケモンは
どんな　ニックネームだい？▼
わがはいは　すべての　ポケモンに
「たろう」と　つけちゃうんだよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T06:00:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　ポケモンは
どんな　ニックネームだい？▼
我輩は　すべての　ポケモンに
「たろう」と　つけちゃうんだよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T06:00:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-24T05:04:18" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>GENTLEMAN
紳士</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
