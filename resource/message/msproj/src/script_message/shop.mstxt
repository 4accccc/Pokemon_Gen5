	<TextRow
		Label="mes_shop_02_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はい　どうぞ
まいど　ありがとう　ございます[Ctrl2:CallBackOne arg="1" ]▼
[Name:Item Idx="0" ]を
[Name:Pocket Idx="1" ]ポケットに　しまった▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はい　どうぞ
まいど　ありがとう　ございます[Ctrl2:CallBackOne arg="1" ]▼
[Name:Item Idx="0" ]を
[Name:Pocket Idx="1" ]ポケットに　しまった▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>買い物をしたときのお礼のメッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="mes_shop_02_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それ　いじょう
もちきれないですよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
