	<TextRow
		Label="msg_d27r0701_swplazmam1_02_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……うう▼
ポケモンを　すくいたかった
きもちは　ほんもの　だったのに</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-11T04:45:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-11T04:37:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……うう▼
ポケモンを　救いたかった
気持ちは　本物だったのに</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-11T05:03:44" />
			<Status>Editing</Status>
