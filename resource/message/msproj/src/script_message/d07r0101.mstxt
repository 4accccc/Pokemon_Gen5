	<TextRow
		Label="msg_d07r0101_workman2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねじって　ねじって　ねじれやま♪
うたえば　げんきが　わいてくる♪</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T03:10:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねじって　ねじって　ねじれやま♪
うたえば　げんきが　わいてくる♪</Text>
