<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d07r0101_workman1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふゆに　なると
ネジやま　ぜんたいに▼
ゆきが　つもって
そりゃもう　まっしろ　さ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T03:07:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>冬に　なると
ネジ山　全体に▼
雪が　積もって
そりゃもう　まっしろ　さ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T03:08:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・春/夏/秋
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T02:41:30" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN
作業員</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-10T04:10:32" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d07r0101_workman1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆきの　しろさは
けがれを　かくし▼
よるの　くろさは
なやみを　つつみこむ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T03:09:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雪の　白さは
けがれを　隠し▼
夜の　黒さは
悩みを　包みこむ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T03:09:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・冬
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T02:41:31" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>WORKMAN
作業員</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
