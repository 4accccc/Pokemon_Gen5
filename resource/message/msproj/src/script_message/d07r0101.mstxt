	<TextRow
		Label="msg_d07r0101_workman3_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ななめの　ばしょで　ふんばる！
なんだか　いきてるって　かんじだよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>斜面で　踏ん張る！
なんだか　生きてるって　感じだよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:13" />
			<Status>Editing</Status>
