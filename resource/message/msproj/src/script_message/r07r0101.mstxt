			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:03:03" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・c06ジムバッジ取得前
・アイテム入手処理
　No381「わざマシン５４」（みねうち）</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-05-25T09:38:27" />
		</CommentCell>
