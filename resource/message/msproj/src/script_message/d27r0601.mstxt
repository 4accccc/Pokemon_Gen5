	<TextRow
		Label="msg_d27r0601_swsage01_03_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『……きましたか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-22T11:17:00" />
