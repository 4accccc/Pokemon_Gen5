	<TextRow
		Label="msg_c12gym0201_swleader1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>？？？『チャレンジャーだね！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>？？？『チャレンジャーだね！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・初期配置
　leader（local 19、18）下向き
　boy2（local 21、19）左向き
　girl2（local 17、19）右向き
・glasses_02表示後、
　チェレンだけ主人公に近づきメッセージ表示</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:24:02" />
