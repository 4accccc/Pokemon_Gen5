				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12gym0201_swleader1_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あの　ふたりに　かてたなら
ぼくが　おあいて　しますから</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あの　二人に　勝てたなら
ぼくが　お相手しますから</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:56:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・トレーナーが移動後
　主人公と向き合ってメッセージ表示
・メッセージ表示後、チェレン移動
・画面外に消えると、主人公操作可能に
※チェレンの位置をカメラで見せるか？</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:24:04" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T12:07:36" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12gym0201_swleader1_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくと　しょうぶ　したいなら
あの　ふたりに　かってくださいね</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくと　勝負したいなら
あの　二人に　勝ってくださいね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:57:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・二人を倒す前</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:24:05" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T12:07:36" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12gym0201_swleader1_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみにとって　はじめての
ジムちょうせん　であるように▼
ぼくにとっても　ジムリーダーとして
はじめての　ポケモンしょうぶ！▼
おたがい　くいを　のこさないよう
ベストを　つくそう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T12:07:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみにとって　初めての
ジム挑戦　であるように▼
ぼくにとっても　ジムリーダーとして
初めての　ポケモン勝負！▼
おたがい　悔いを　残さないよう
ベストを　つくそう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T12:08:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・二人を倒したとき
・戦闘前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:24:05" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T12:07:36" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_c12gym0201_swleader1_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジムリーダーとして
さいしょの　チャレンジャーが▽
きみで　よかった……▼
すなおに　そう　おもえる
すばらしい　たたかい　でした▼
そんな　ポケモンと　きみの
つよさを　たたえるために　これを！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-20T00:32:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジムリーダーとして
最初の　チャレンジャーが▽
きみで　よかった……▼
素直に　そう　思える
すばらしい　戦い　でした▼
そんな　ポケモンと　きみの
強さを　称えるために　これを！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-20T00:32:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・戦闘後</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:24:05" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
