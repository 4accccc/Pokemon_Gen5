	<TextRow
		Label="msg_c12gym0201_swleader1_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チャレンジャーを　むかえるよ
ふたりとも　もちばに　いどうして▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チャレンジャーを　迎えるよ
二人とも　持ち場に　移動して▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・上を向いてメッセージ表示
・続けてswleader1_04</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:12" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER1
ジムリーダー・チェレン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-17T02:24:04" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>A</Text>
