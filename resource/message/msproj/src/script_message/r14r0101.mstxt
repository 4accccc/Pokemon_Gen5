	<TextRow
		Label="msg_r14r0101_man1_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ホワイトフォレストは
しぜんで　いっぱい！▼
ひとと　ポケモンが
いっしょに　くらしているのだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ホワイトフォレストは
自然で　いっぱい！▼
人と　ポケモンが
一緒に　暮らしているのだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
