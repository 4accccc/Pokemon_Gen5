<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_r14r0101_man3_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２ねんまえの　きおく……
まちの　ようすは　どうだったかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:28:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T09:13:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２年前の　記憶……
街の　様子は　どうだったかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:28:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T09:11:45" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・White2ver
・クリア前
　ホワイトフォレストへのストッパー
　GRIDX＝2～8、GRIDZ＝5に全部配置
　なんか適当にその場回転していてください
・クリアすると削除
※swanで新規作成</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T09:16:58" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN3</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T09:17:16" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r14r0101_infomationw_01w"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゲートを　ぬければ……
さあ　どこに　つながってるかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:28:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゲートを　抜ければ……
さあ　どこに　つながってるかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:28:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・White2ver
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T03:31:08" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>INFORMATIONW
受付嬢</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_r14r0101_man1_01b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そりゃそうよ！　ちがう　ものを
くらべたら　いいところ　わるいところ▽
りょうほう　みつかるに　きまってる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:29:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そりゃそうよ！　違う　ものを
比べたら　いいところ　わるいところ▽
両方　みつかるに　決まってる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T07:29:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・White2ver
※swanでメッセージ修正</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T03:34:32" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>MAN1</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-01T09:21:55" />
		</AttributeCell>
		<AttributeCell
