		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しぜんのなか　のんびり　くらすなら
ホワイトフォレストへ　どうぞ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自然の中　のんびり　暮らすなら
ホワイトフォレストへ　どうぞ</Text>
