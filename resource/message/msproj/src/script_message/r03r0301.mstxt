	</TextRow>
	<TextRow
		Label="msg_r03r0301_black_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]▼
おさななじみの　コンビネーションで
かれらに　おもいしらせよう▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
