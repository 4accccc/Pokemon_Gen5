	<TextRow
		Label="msg_r03r0301_hakaim2_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かえす　ひつようは　ないぜ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>返す　必要は　ないぜ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・メッセージのみ表示
・ギザギザウインドウで
・続けてhakaim2_02</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>プラズマ団♂その２</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:16" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
