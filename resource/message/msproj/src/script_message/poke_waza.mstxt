			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_waza_omoi_15"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンに　おもいださせたい
わざが　あったら▽
ハートのウロコを　もってきてね！</Text>
