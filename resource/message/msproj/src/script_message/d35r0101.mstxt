			<CellData>#0080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_d35r0101_swleader6_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それでは
レッツ　フライト！▼</Text>
