<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_d35r0101_poke_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>グァオォーウッ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:28:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:28:47" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グァオォーウッ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:28:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:28:50" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・あわせて鳴き声再生
・続けて野生ポケモン戦闘へ</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:23:02" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・黒いオノノクス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:27:10" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T07:43:48" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d35r0101_poke_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろいオノノクスは　ほごくの　おくへ
すがたを　けしさってしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:28:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:28:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>くろいオノノクスは　保護区の　奥へ
姿を　消し去ってしまった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:28:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:28:01" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモン
・戦闘後
・倒した場合のメッセージ
・殿堂入り後に再配置</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>POKE
ポケモン・黒いオノノクス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:27:06" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T07:43:50" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg_d35r0101_swleader6_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アタシの　ひこうきで　ひとっとび！
フキヨセに　もどりますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T07:11:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:21:56" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アタシの　飛行機で　ひとっとび！
フキヨセに　戻りますか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:11:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:21:56" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・はい/いいえ選択肢表示
・はい　→swleader6_02
　いいえ→swleader6_03</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:26:14" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER6
ジムリーダー・フウロ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-12T06:24:41" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
