	</TextRow>
	<TextRow
		Label="mes_ribbon_text_present_010"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とくべつな　おもいでを　きねんする　リボン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
