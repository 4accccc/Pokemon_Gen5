				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_14_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねーねー！　あたしの　ポケモン
かわいいから　みせてあげる！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
