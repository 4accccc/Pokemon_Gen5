		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_WAITER_04_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こういうとこでは　たくさん
みずを　のむと　いいよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こういうとこでは　たくさん
水を　飲むと　いいよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
