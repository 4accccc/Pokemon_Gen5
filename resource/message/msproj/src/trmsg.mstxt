	<TextRow
		Label="TRID_FANM_10_TRMSG_FIGHT_AFTER_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パン　パパン　ヒュー！！　ですと？
おおー　すばらしい　リズムですな！</Text>
