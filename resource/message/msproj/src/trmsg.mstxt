	<TextRow
		Label="TRID_SWCHAMPION_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　いたみ……
あたしも　おなじように　かんじる！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンの　痛み……
あたしも　同じように　感じる！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
