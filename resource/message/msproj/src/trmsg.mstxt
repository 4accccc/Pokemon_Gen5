	<TextRow
		Label="TRID_FOOTBALL_05_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パワーは　たりないが
やさしさは　たりているぞ！▼</Text>
