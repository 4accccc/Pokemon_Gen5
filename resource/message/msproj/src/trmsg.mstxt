				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PARASOL_10_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あらら……
まけちゃった……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
