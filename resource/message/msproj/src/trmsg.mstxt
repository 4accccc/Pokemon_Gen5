				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PRINCE_10_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジェジェジェジェジェジェッ！
ジェット　コースター！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
