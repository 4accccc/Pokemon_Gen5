	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_36_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>オー！　プラーズマー！
プラズマだんに　えいこう　あれ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T09:08:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T09:08:36" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オー！　プラーズマー！
プラズマ団に　栄光あれ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T09:08:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T09:08:36" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_13_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>プラーズマー！
ナマイキな　こどもね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
