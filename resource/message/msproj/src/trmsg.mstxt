	<TextRow
		Label="TRID_FANM_11_TRMSG_FIGHT_START_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいしゅうかい　うら
ツーアウト　まんるい……▽
そのあとは……　きまってるだろ？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最終回　裏　ツーアウト　満塁
その後は……　決まってるだろ？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
