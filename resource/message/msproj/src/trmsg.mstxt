	<TextRow
		Label="TRID_FOOTBALL_05_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ＰＯＷＥＲ！！！▼
うなる　きんにくで
すべてに　うちかってみせる！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
