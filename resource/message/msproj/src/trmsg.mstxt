	<TextRow
		Label="TRID_TENNIS_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あんたと　ワタシは　であったばかり
