	</TextRow>
	<TextRow
		Label="TRID_TENNIS_07_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハア　ハア　ハア
ハア　ハア　ハア……！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
