	</TextRow>
	<TextRow
		Label="TRID_MINI_06_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チッ……
マジかよ </Text>
			<TextModifiedBy
				User="matsumiya:W00224"
