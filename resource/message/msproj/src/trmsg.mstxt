	<TextRow
		Label="TRID_VETERANM_09_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえたちの　いきおい……
まさに　まいあがる　ドラゴンだぜ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
