	</TextRow>
	<TextRow
		Label="TRID_MOUNT_15_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おまえは　つよい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえは　強い！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
