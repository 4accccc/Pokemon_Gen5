	</TextRow>
	<TextRow
		Label="TRID_KINDERGARTENM_12_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>きめたぞ！　チャンピオンになって
おまえを　ぶっとばしてっやる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きめたぞ！　チャンピオンになって
おまえを　ぶっとばしてっやる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_35_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>……あんた　つよそうだな！
いいぜいいぜ！　てごわい　あいてほど
オレの　ポケモン　もえるんだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……あんた　強そうだな！
いいぜいいぜ！　手強い　相手ほど
オレの　ポケモン　燃えるんだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_35_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>くう……
うまく　めいれい　できなかった</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>くう……
うまく　命令できなかった</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_35_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>おたがいの　ポケモンを
めいれい　せずに　たたかわせたら▽
どんな　たたかいに　なるのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お互いの　ポケモンを
命令せずに　戦わせたら▽
どんな　戦いに　なるのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_27_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>じゃーん！
かわいい　ポケモン　じゃーん！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じゃーん！
可愛い　ポケモン　じゃーん！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
