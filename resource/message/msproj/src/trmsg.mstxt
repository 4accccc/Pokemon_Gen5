	<TextRow
		Label="TRID_FUTAGO_06_TRMSG_POKE_ONE_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンさん　１ひき　なの？
いっぱいが　いいのにー！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
