			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_35_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヴィオさまの　おそばで
なんたる　しったい　だ……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-19T11:39:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-19T11:39:37" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヴィオさまの　おそばで
なんたる　失態だ……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-19T11:39:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-19T11:39:37" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_10_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>ジムリーダーを　こえるのが
オレの　もくひょう　なんだぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジムリーダーを　超えるのが
オレの　目標なんだぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_10_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>がんばったよな
オレの　ポケモン！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>がんばったよな
オレの　ポケモン！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_10_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>サンヨウレストランの　みつごが
ジムリーダーに　なったら　オレ▽
まっさきに　しょうぶを　いどむんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サンヨウレストランの　三つ子が
ジムリーダーに　なったら　オレ▽
真っ先に　勝負を　挑むんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLB_16_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>じっせん　こそが
さいこうの　べんきょう　です！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>実戦こそが
最高の　勉強です！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLB_16_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>まけたことも
べんきょうに　するのです！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けたことも
勉強に　するのです！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLB_16_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>もくてきを　もっていれば
どんな　ことだって　べんきょうだよ▼
って　ジムリーダーに　なるまえの
チェレンさんが　いってたの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目的を　持っていれば
どんな　ことだって　勉強だよ▼
って　ジムリーダーに　なる前の
チェレンさんが　いってたの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLG_14_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーズスクールで
まなんだことの　ふくしゅう　させて！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーズスクールで
学んだことの　復習させて！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLG_14_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>いまの　しょうぶ……
あそこを　なおさないと……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いまの　勝負……
あそこを　修正しないと……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLG_14_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ヒオウギの　トレーナーズスクールの
チェレンせんせいって　どんな　ひとかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒオウギの　トレーナーズスクールの
チェレン先生って　どんな人かな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_16_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>パワースポットで　じぶんに　ねむる
パワーを　ビビッと　めざめさせる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パワースポットで　自分に　眠る
パワーを　ビビッと　目覚めさせる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_16_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>パワーが
すぽっと　ぬけた！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パワーが
すぽっと　抜けた！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_16_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>むかし　ここには　ムシャーナって
ひとのゆめを　たべる　ポケモンがいて▽
それを　じったいか　させてたんだって</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>昔　ここには　ムシャーナって
人の夢を　食べる　ポケモンがいて▽
それを　実体化させてたんだって</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPW_15_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>キャッ！　あなたの　うごきを
よそくして　にげていたのに▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キャッ！　あなたの　動きを
予測して　逃げていたのに▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPW_15_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>キャッ！　あなたの　かんがえを
よそくしていたのに　まけちゃった！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キャッ！　あなたの　考えを
予測していたのに　負けちゃった！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T14:08:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPW_15_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>にげるもの　てにはいらないものは
むちゅうで　おいかけたくなるでしょ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>逃げるもの　手に入らないものは
夢中で　追いかけたくなるでしょ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTM_18_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンけんきゅう！　すなわち
おたがいの　ポケモンを　みせあおう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモン研究！　すなわち
お互いの　ポケモンを　みせあおう▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTM_18_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>むむ！　あらたな　はっけん
そして　ふかまる　なぞ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>むむ！　新たな　発見
そして　深まる　なぞ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTM_18_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>けんきゅうを　すれば　するほど
あたらしい　はっけんが　あるね▼
でも　すべてを　りかい　できなくても
ともだちに　なれるのが　ポケモンだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>研究を　すれば　するほど
新しい　発見が　あるね▼
でも　すべてを　理解できなくても
ともだちに　なれるのが　ポケモンだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTW_15_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>サイキッカーの　ふしぎな　ちから！
みえないのに　たしかに　あるのよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サイキッカーの　不思議な　力！
みえないのに　確かに　あるのよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTW_15_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>もう！　いつも　そうなの
だいじなものは　みえないのよぅ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もう！　いつも　そうなの
大事なものは　みえないのよぅ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTW_15_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ドーナツのあな！　なにも　ないのに
あの　そんざいかん！　あこがれるぅ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドーナツの穴！　なにも　ないのに
あの存在感！　あこがれるぅ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BREEDERW_06_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>つよく　そだてるには
しれんが　いちばん　よね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強く　育てるには
試練が　一番　よね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BREEDERW_06_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>あなたは　しれんに　ピッタリ！
だって　たくましいもの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたは　試練に　ピッタリ！
だって　たくましいもの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BREEDERW_06_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンを　きそわせ　そだてるの！▼
だから　あなたが　ここに　くるたび
ポケモンしょうぶを　おねがいするね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンを　競わせ　育てるの！▼
だから　あなたが　ここに　来るたび
ポケモン勝負を　お願いするね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TENNIS_13_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>じそく２００キロの　サーブ！▼
それぐらい　きっつい　アタックを
あなたに　みせてあげます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>時速２００キロの　サーブ！▼
それぐらい　きっつい　アタックを
あなたに　みせてあげます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TENNIS_13_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>あとちょっと　もうちょっと
ラリーを　つづけたかったのに！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T01:59:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T01:59:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あとちょっと　もうちょっと
ラリーを　続けたかったのに！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T01:59:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T01:59:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TENNIS_13_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>いつまでも　つづく　ラリー
くるしいけれど　しあわせ　なの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつまでも　続く　ラリー
苦しいけれど　しあわせ　なの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TENNIS_14_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>テニスの　はげしい　フットワーク！
わかる？　あたしたち　タフなの▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テニスの　激しい　フットワーク！
わかる？　あたしたち　タフなの▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TENNIS_14_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ああ！　まるで　きょうれつな
サーブを　おみまい　されたみたい……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ああ！　まるで　強烈な
サーブを　お見舞い　されたみたい……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TENNIS_14_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>いつか　ひとと　ポケモンで
ダブルスを　くんで　テニスしたいな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつか　人と　ポケモンで
ダブルスを　組んで　テニスしたいな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T03:28:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T03:28:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BASKET_13_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>おっ！　きみは　なかなか
つよそうだぞ！　ぼくと　あそんでよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おっ！　きみは　なかなか
強そうだぞ！　ぼくと　遊んでよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BASKET_13_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ゲームセット！
きみの　あっしょう　だね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T01:59:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T01:59:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゲームセット！
きみの　圧勝だね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T01:59:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T01:59:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BASKET_13_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>いつかは　ライモンシティの
リトルコートで　しあい　したいな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつかは　ライモンシティの
リトルコートで　試合したいな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BASKET_14_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>せいせいどうどうと　だます！
それが　トリックプレイだぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正々堂々と　だます！
それが　トリックプレイだぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BASKET_14_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>なんてこったい！
おれが　だしぬかれるとは</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんてこったい！
おれが　だしぬかれるとは</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BASKET_14_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>あいてを　どうやって　だしぬくか？
バスケにも　しょうぶにも　だいじさ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手を　どうやって　だしぬくか？
バスケにも　勝負にも　大事さ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_18_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とびっきりの　プリティ　ポケモン
ごらんあれ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>とびっきりの　プリティ　ポケモン
ご覧あれ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_18_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ああ！　ほのおが
よわまっちゃってる！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ああ！　ほのおが
弱まっちゃってる！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_18_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　いきづかいを　かんじると
ああ！　いきてるう！　ってなっちゃうの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンの　息づかいを　感じると
ああ！　生きてるう！　ってなっちゃうの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FANW_13_TRMSG_FIGHT_START_1">
		<LanguageCell
			Language="JPN">
			<Text>フレー　フレー！▼
あたしたち　がんばる　トレーナーを
おうえん　してまーす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フレー　フレー！▼
あたしたち　がんばる　トレーナーを
応援してまーす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_FANW_13_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>マナ『フレッフレッ　ポケモン！
サエ『フレッフレッ　トレーナー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マナ『フレッフレッ　ポケモン！
サエ『フレッフレッ　トレーナー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_FANW_13_TRMSG_FIGHT_AFTER_1">
		<LanguageCell
			Language="JPN">
			<Text>ひびく　トレーナーの　めいれい！
くりだされる　ポケモンの　わざ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>響く　トレーナーの　命令！
くりだされる　ポケモンの　技！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_FANW_13_TRMSG_POKE_ONE_1">
		<LanguageCell
			Language="JPN">
			<Text>アタシたち　ふたりでしょ
ポケモンを　２ひき　だしたいんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アタシたち　２人でしょ
ポケモンを　２匹　だしたいんだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_FANW_13_TRMSG_FIGHT_START_2">
		<LanguageCell
			Language="JPN">
			<Text>フレー　フレー！▼
あたしたち　たたかう　ポケモンを
おうえん　してまーす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フレー　フレー！▼
あたしたち　戦う　ポケモンを
応援してまーす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_FANW_13_TRMSG_FIGHT_AFTER_2">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンも　トレーナーも
ベストでないと　かてないもんね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンも　トレーナーも
ベストでないと　勝てないもんね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_FANW_13_TRMSG_POKE_ONE_2">
		<LanguageCell
			Language="JPN">
			<Text>あたしたち　ダブルバトルが
だいすき　なんだよ！　わかる？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしたち　ダブルバトルが
大好き　なんだよ！　わかる？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_NURSE_05_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>わたしが　たたかうのは
ポケモンへの　あいの　ため！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしが　戦うのは
ポケモンへの　愛の　ため！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_NURSE_05_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　ポケモンへの　あい
しかと　うけとったわ……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたの　ポケモンへの　愛
しかと　受け取ったわ……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_NURSE_05_TRMSG_FIGHT_AFTER_RECOVER_BEFORE">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　ポケモンへの　あい
わたしの　ポケモンへの　あい！▼</Text>
