	</TextRow>
	<TextRow
		Label="TRID_FANM_11_TRMSG_FIGHT_AFTER_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ピンチでの　ぎゃくてん　ホームラン……
いつも　きたいしちゃうよな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ピンチでの　逆転ホームラン……
いつも　期待しちゃうよな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
