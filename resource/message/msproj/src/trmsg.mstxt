			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SOCCER_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チックショウ！　まだまだか！
ガッツなら　たりてるのにな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チックショウ！　まだまだか！
ガッツなら　足りてるのにな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SOCCER_01_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレから　ガッツを
おすそわけ　だぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
