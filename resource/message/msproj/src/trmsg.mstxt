	</TextRow>
	<TextRow
		Label="TRID_FUTAGO_06_TRMSG_FIGHT_START_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イセキ！
イセキだよー！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
