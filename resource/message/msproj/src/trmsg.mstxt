				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BASKET_07_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶの　あとには
フロに　はいれよ！▼
メシ　くった　あとには
はを　みがけよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝負の　あとには
フロに　はいれよ！▼
メシ　食った　あとには
歯を　磨けよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TENNIS_07_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいトーナメントが　ちかいのよ！
あんたを　かべに　みたてて▽
スマッシュの　れんしゅうよ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界トーナメントが　近いのよ！
あんたを　壁に　見立てて▽
スマッシュの　練習よ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
