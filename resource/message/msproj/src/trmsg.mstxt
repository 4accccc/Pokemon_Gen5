				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミの　ポケモンは　喜んでいる……
キミといることを　喜んでいるね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BOSS_06_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>もっと！　キミの　ポケモンの
こえを　きかせてくれ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T07:56:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T07:56:35" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もっと！　キミの　ポケモンの
声を　聴かせてくれ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T07:56:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T07:56:35" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BOSS_06_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>ボクを　たすけてくれる
トモダチのため　あきらめない！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボクを　助けてくれる
トモダチのため　あきらめない！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BOSS_06_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>おたがい　わかりあうため
この　じかんを　たいせつに　するよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お互い　わかりあうため
この時間を　大切に　するよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BOSS_06_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>キミの　ポケモンは　よろこんでいる……
キミといることを　よろこんでいるね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミの　ポケモンは　喜んでいる……
キミといることを　喜んでいるね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER1_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>その　わざを　えらぶとは……
なるほど！　てごわい　あいて　だね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その技を　選ぶとは……
なるほど！　手強い　相手だね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER1_02_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>ジムリーダーとして
きみの　かべで　ありたい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジムリーダーとして
きみの　壁で　ありたい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER1_02_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>……！　そう　これが
ポケモンしょうぶ　なんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……！　そう　これが
ポケモン勝負　なんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER2_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>あんたの　かちたいって
エネルギー　めっちゃ　あふれてる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あんたの　勝ちたいって
エネルギー　めっちゃ　あふれてる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER2_02_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>まだまだ！　ここから　もりあげて
あたしが　かつの！　ばくれつッ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まだまだ！　ここから　盛りあげて
あたしが　勝つの！　爆裂ッ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER2_02_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ちょっとーッ！
まだ　サビの　とちゅう　だって！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T09:58:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T09:58:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちょっとーッ！
まだ　サビの　途中だって！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T09:58:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T09:58:31" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER3_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>ビシィッと　スイッチ　オーン！
むしポケモンの　ほんき　みせるね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビシィッと　スイッチ　オーン！
むしポケモンの　本気　みせるね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER3_02_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>むうん　むしのしらせ！
けっこう　ピンチかも　だって！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>むうん　むしのしらせ！
けっこう　ピンチかも　だって！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER3_02_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ぬうん……！？　おわった
きみ　すごいんだねー！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬうん……！？　終わった
きみ　すごいんだねー！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER4_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>その　たちふるまい……
かがやいているわね　あなたたち！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その　立ち振る舞い……
輝いているわね　あなたたち！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER4_02_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>ピンチを　のりこえる！
ファンの　きたいに　こたえないと</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ピンチを　乗り越える！
ファンの　期待に　応えないと</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER4_02_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>しびれた……
ハートが　とろけるほどに</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しびれた……
ハートが　とろけるほどに</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER5_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>……ほほう！
それなりの　うでまえ　だな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……ほほう！
それなりの　腕前だな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER5_02_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>オレさまが　あきらめたら
ポケモンに　もうしわけねえだろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレさまが　あきらめたら
ポケモンに　申し訳ねえだろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER5_02_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>やれやれ……　ほんきで　たたかって
まけると　すがすがしいな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やれやれ……　本気で　戦って
負けると　すがすがしいな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER6_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>アナタが　どう　せめてくるのかって
すごく　ドキドキしちゃうよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アナタが　どう　攻めてくるのかって
すごく　ドキドキしちゃうよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER6_02_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>ネバーギブアップ　です！
たたかう　ポケモンに　しつれいだもの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ネバーギブアップ　です！
戦う　ポケモンに　失礼だもの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER6_02_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>いまの　たたかい　わすれないよ！
アナタと　たたかえて　よかった！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今の　戦い　忘れないよ！
アナタと　戦えて　よかった！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER7_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>どんな　わざを　えらぼうとも
あつい　おもいを　かんじるぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんな技を　選ぼうとも
熱い　思いを　感じるぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER7_02_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>おいてなお　ぜんしんの　ちがたぎる！
まだまだ　たたかおうぞ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>老いてなお　全身の　血がたぎる！
まだまだ　戦おうぞ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER7_02_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>やぶれて　わきあがる　くやしさ……▼
その　おもいに　くっせぬ　こころこそ
いきる　エネルギー　というもの！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>敗れて　わきあがる　悔しさ……▼
その思いに　屈せぬ　心こそ
生きる　エネルギー　というもの！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER8_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>おはん……
やりおるな！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おはん……
やりおるな！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER8_02_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>まいったのう……　あとがないのに
ワクワクして　たまらんわい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>参ったのう……　あとがないのに
ワクワクして　たまらんわい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER8_02_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>たいした　もんじゃ！
ええ　ポケモン　そだてとるな！▽
おはん　やりおる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たいした　もんじゃ！
ええ　ポケモン　育てとるな！▽
おはん　やりおる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_03_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>あいての　きょうみを　ひくには
さいしょが　かんじん　ですよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手の　興味を　ひくには
最初が　重要ですよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_03_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>まだ　けつまつは　きまってません！
アタシの　のぞむ　かたちに　します！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まだ　結末は　決まってません！
アタシの　望む　形に　します！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_03_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>ねがいは　ハッピーエンディング！
あとあじが　わるいのは　にがてです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>願いは　ハッピーエンディング！
後味が　悪いのは　苦手です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_03_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>かんどうすると
ことばって　でないんですよね▽
ほんとは……▼
ものかきなのに　いまの　きもちを
うまく　あらわせないのですが▼
アナタ　とっても　グレートです！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>感動すると
言葉って　でないんですよね▽
ほんとは……▼
物書きなのに　今の　気持ちを
うまく　表せないのですが▼
アナタ　とっても　グレートです！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_03_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>その　わざを　えらんだ　しんり
よみきれば　かてるかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その技を　選んだ　心理
読みきれば　勝てるかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_03_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>うつくしくても　まけは　まけ
ぶざまでも　かちは　かちだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>美しくても　負けは　負け
無様でも　勝ちは　勝ちだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_03_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>こんなに　きびしい　じょうきょうでも
かてる　やりかた……　あるはずだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんなに　厳しい　状況でも
勝てる　やりかた……　あるはずだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_03_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>かつ　やつが　いれば
まける　やつが　いる▼
それを　かくご　せずに
まけて　さわぐのは　ぶざま▼
まけたら　つぎ　かてるために
できることを　する▽
それが　しょうぶし　さ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝つ　やつが　いれば
負ける　やつが　いる▼
それを　覚悟せずに
負けて　騒ぐのは　愚か▼
負けたら　次　勝つために
できることを　する▽
それが　勝負師さ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_03_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>つたわってきた！
おまえたち　つよいな！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伝わってきた！
おまえたち　強いな！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_03_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>ラスト　１ぴき！
しょうねんば　だな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ラスト　１匹！
正念場だな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_03_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>のこりの　ちからを　ふりしぼり！
つぎの　わざに　すべてを　こめる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>残りの　力を　ふりしぼり！
次の技に　すべてを　こめる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_03_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうの　ポケモンなど　いないし
ベストの　くみあわせも　ない……▼
それゆえ　つねに
かちつづけるのは　むずかしい▼
だが　つよさを　もとめる　こころ
さいきょうを　しりたい　きもち……▽
それを　わたしは　とうとい　とおもう▼
そして　それを　もっている
おまえを　そんけいする</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強の　ポケモンなど　いないし
ベストの　組み合わせも　ない……▼
それゆえ　つねに
勝ち続けるのは　むずかしい▼
だが　強さを　求める　心
最強を　知りたい　気持ち……▽
それを　わたしは　尊いと　思う▼
そして　それを　持っている
おまえを　尊敬する</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_03_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンたちが　ぜんりょくを　だせる
すてきな　じかんが　はじまりそうね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンたちが　全力を　だせる
すてきな　時間が　はじまりそうね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_03_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>これほどとは……！　いけません
アタクシに　ゆだんが　ありましたね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これほどとは……！　いけません
アタクシに　油断が　ありましたね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_03_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>しょうりの　ため　あえて
かんじょうを　ばくはつ　させます！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝利の　ため　あえて
感情を　爆発させます！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_03_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>エレガントで　エクセレントな
トレーナーと　ポケモンね　アナタたち▼
そんな　きらびやかな　かたと
きそいあうことで▼
アタクシも　ポケモンも　みがかれます
かんしゃ　いたしますわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エレガントで　エクセレントな
トレーナーと　ポケモンね　アナタたち▼
そんな　きらびやかな　かたと
競いあうことで▼
アタクシも　ポケモンも　磨かれます
感謝いたしますわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_04_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>さいしょで　あいての　こころを
キャッチするのって　だいじ　ですよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最初で　相手の　心を
キャッチするのって　大事ですよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_04_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>さいしゅうしょう！
さいごの　ポケモン　です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最終章！
最後の　ポケモン　です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_04_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>こんどこそ　ハッピーエンディング！
あとあじが　わるいのは　にがてです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今度こそ　ハッピーエンディング！
後味が　悪いのは　苦手です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_04_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>……うわあ▼
アタシ　またも
しちゃってます　あぜんぼーぜん▼
いろいろ　ことばは　しっていますが
うまく　いいあらわせないんですよね▼
きっと　ことばに　すると
いまの　きもちとか　それに▽
とじこめられちゃうから　かなあ▼
でも　これだけは　いわせてください
アナタ　さらに　グレートです！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……うわあ▼
アタシ　またも
しちゃってます　あぜんぼーぜん▼
いろいろ　言葉は　知っていますが
うまく　言い表せないんです▼
きっと　言葉に　すると
いまの　気持ちとか　それに▽
閉じこめられちゃうから　かなあ▼
でも　これだけは　いわせてください
アナタ　最高に　グレートです！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:23" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_04_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>ここで　その　わざとはね……
おもわず　みとれてしまうよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここで　その技とはね……
思わず　みとれてしまうよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_04_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>みずから　あきらめる　にんげんに
しょうりは　ひきよせられないぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みずから　あきらめる　人間に
勝利は　ひきよせられないぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_04_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>きょくげんの　じょうきょうでも
かてる　やりかた……　あるはずだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>極限の　状況でも
勝てる　やりかた……　あるはずだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_04_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>どの　ポケモンを　そだてるか▼
どの　わざを　おしえるか▼
どの　どうぐを　もたせるか▼
あらゆることを　おろそかに　しない
それが　かつための　すべてさ▼
きみは　そういう　いみで
すぐれた　しょうぶし　だな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの　ポケモンを　育てるか▼
どの　技を　教えるか▼
どの　道具を　持たせるか▼
あらゆることを　おろそかに　しない
それが　勝つための　すべてさ▼
きみは　そういう　意味で
優れた　勝負師だな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_04_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>……あいかわらず　つよいな
それでこそ　こころおどる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……相変わらず　強いな
それでこそ　心躍る！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_04_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>ラスト　１ぴき！
だが　つよさは　むげん！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ラスト　１匹！
だが　強さは　無限！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_04_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>つぎの　わざ！
たましいを　こめる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>次の　技！
魂を　こめる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_04_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうの　ポケモンなど　いないし
ベストの　くみあわせも　ない……▼
それゆえ　つねに
かちつづけるのは　むずかしい▼
だが　つよさを　もとめる　こころ
さいきょうを　しりたい　きもち……▽
それを　わたしは　とうとい　とおもう▼
そして　それを　もっている
おまえを　そんけいする</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強の　ポケモンなど　いないし
ベストの　組み合わせも　ない……▼
それゆえ　つねに
勝ち続けるのは　むずかしい▼
だが　強さを　求める　心
最強を　知りたい　気持ち……▽
それを　わたしは　尊いと　思う▼
そして　それを　持っている
おまえを　尊敬する</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_04_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>アタクシと　ポケモンの　ハーモニー！
これから　おみせいたします！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アタクシと　ポケモンの　ハーモニー！
これから　おみせいたします！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_04_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>きょくげんの　たたかいが
アタクシを　つよくしてくれます！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>極限の　戦いが
アタクシを　強くしてくれます！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_04_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>かんじょうを　コントロールし
しょうりへの　エネルギーに　します！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>感情を　コントロールし
勝利への　エネルギーに　します！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_04_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>あいかわらず……▼
いえ　いぜんよりも
エレガントで　エクセレントな▽
トレーナーと　ポケモンね　アナタたち▼
そんな　きらびやかな　かたと
きそいあうことで▼
アタクシも　ポケモンも　みがかれます
かんしゃ　いたします▽
また　おあいて　してくださいね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あいかわらず……▼
いえ　以前よりも
エレガントで　エクセレントな
トレーナーと　ポケモンね　アナタたち▼
そんな　きらびやかな　かたと
競いあうことで▼
アタクシも　ポケモンも　磨かれます
感謝いたします▽
また　お相手してくださいね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_KARATE_33_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>ここは　おれの　みち！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここは　おれの　道！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_KARATE_33_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>この　みちは
みんなの　みち！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　道は
みんなの　道！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_KARATE_33_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>きみの　みちを　ゆけ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　道を　往け！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BATTLEG_25_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>エイエイエイ！
ズルズルズルッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エイエイエイ！
ズルズルズルッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BATTLEG_25_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ええい！
つぎは　あたしの　でばん……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ええい！
次は　あたしの　出番……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BATTLEG_25_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンと　スパーリングを　する
ソウリュウシティの　シャガさん！▽
あたしの　あこがれ　なんですよー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンと　スパーリングを　する
ソウリュウシティの　シャガさん！▽
あたしの　あこがれ　なんですよー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:01" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MOUNT_17_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>ヤッホー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヤッホー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MOUNT_17_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ヤッホー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヤッホー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MOUNT_17_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>のぼった　マウンテンは
いつか　くだらなければ　ならない▼
じんせい　やまあり　たにあり</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>登った　マウンテンは
いつか　くだらなければ　ならない▼
人生　山あり　谷あり</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T10:27:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T10:27:46" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MOUNT_18_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>おーっす！
みらいの　チャンピオン！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おーっす！
未来の　チャンピオン！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MOUNT_18_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>がはは！　だれかが　かてば
あいては　まけてる　ってことだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>がはは！　だれかが　勝てば
相手は　負けてる　ってことだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MOUNT_18_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンが　いなければ
つよい　よわいは　きにならないが▼
おまえさんと　であうこと
あいてを　することも　なかったか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンが　いなければ
強い　弱いは　気にならないが▼
おまえさんと　出会うこと
相手を　することも　なかったか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_KARATE_20_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>たのもー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>たのもー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_KARATE_20_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>いっぽん　とられてしまったー！
うおー！　すっげー　くやしーぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一本　取られてしまったー！
うおー！　すっげー　悔しーぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_KARATE_20_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>まけた　くやしさを　バネに
しょうじん　するのだ！▼
そうよ！　かちまけの　ない
せかいは　しんぽ　しないのだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けた　悔しさを　バネに
精進するのだ！▼
そうよ！　勝ち負けの　ない
世界は　進歩しないのだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BATTLEG_18_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>２３ばんどうろに　いると　いうことは
あなたの　ポケモン　すごいんでしょ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２３番道路に　いると　いうことは
あなたの　ポケモン　すごいんでしょ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BATTLEG_18_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>あははー！
ポケモン　たのしーね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あははー！
ポケモン　楽しーね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BATTLEG_18_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ここね　すごい　ポケモンばっかで
たのしいの！　ドキマギしちゃう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここね　すごい　ポケモンばっかで
たのしいの！　ドキマギしちゃう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:25" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_31_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>これまで　つみかさねた
しょうりと　はいぼくの　かず▼
きみと　たたかうことで
ふえるのは　どちらの　すうじかな？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これまで　積み重ねた
勝利と　敗北の　数▼
きみと　戦うことで
増えるのは　どちらの　数字かな？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_31_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>しょうりつが　さがってしまったか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝率が　さがってしまったか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_31_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンにしか　きょうみが　ない！▼
いびつな　いきかた　だが
ぼくは　それで　みたされている</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンにしか　興味が　ない！▼
いびつな　生き方だが
ぼくは　それで　満たされている</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_31_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>さいあいの　ポケモンたちと
かなでる　コンチェルト　よ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T10:27:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T10:27:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最愛の　ポケモンたちと
奏でる　コンチェルト　よ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T10:27:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-05T10:27:46" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_31_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>あなたたちの　ほうが
ひびきあっているわね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたたちの　ほうが
響きあっているわね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T11:21:19" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_31_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>うまれた　ときから
ポケモンと　いっしょ　だった▽
ずっと　しょうぶ　してきた▼
そして　いっしょに
せかいの　おわりを　むかえたいわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>生まれた　ときから
ポケモンと　一緒だった▽
ずっと　勝負してきた▼
そして　一緒に
世界の　終末を　迎えたいわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_26_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>バックパッカーで　ありつつ
トレジャーハンターも　してます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バックパッカーで　ありつつ
トレジャーハンターも　してます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_26_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>しょうり　という
おたからを　とりのがしました！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝利という
お宝を　取り逃しました！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_26_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>かざんのおきいしって　しってる？▼
かざんに　ねむる　といわれる
ポケモンに　かんけい　あるらしいけど▼
おくと　ポケモンが　めざめるのか
どかすと　ポケモンが　めざめるのか▽
よく　わかってないらしいの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>かざんのおきいしって　知ってる？▼
かざんに　眠る　といわれる
ポケモンに　関係あるらしいけど▼
置くと　ポケモンが　めざめるのか
どかすと　ポケモンが　めざめるのか▽
よく　わかってないらしいの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_45_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>レッツ　トレーニング！
ポケモンと　ともに　つよくなり▼
ソウリュウや　セイガイハの
ポケモンジムに　いどむ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レッツ　トレーニング！
ポケモンと　ともに　強くなり▼
ソウリュウや　セイガイハの
ポケモンジムに　挑む！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_45_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>まだ！　まだまだ
じつりょくが　ともなってないか！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まだ！　まだまだ
実力が　伴ってないか！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_45_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ぼくにとって　ポケモンは
たいせつな　たいせつな　そんざい▼
ぼくの　くやしなみだや　えがおを
いつも　そばで　みていたからね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくにとって　ポケモンは
大切な　大切な　存在▼
ぼくの　悔し涙や　笑顔を
いつも　そばで　みていたからね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_31_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>バックパッカーの　ふりをした
トレジャーハンター　なんだぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バックパッカーの　ふりをした
トレジャーハンター　なんだぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_31_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>しょうり　という
おたからを　とりのがしたか！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝利という
お宝を　取り逃したか！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_31_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>かざんのおきいしって　しってる？▼
かざんに　ねむる　といわれる
ポケモンに　かんけい　あるらしいけど▼
おくと　ポケモンが　めざめるのか
