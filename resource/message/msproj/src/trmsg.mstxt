	<TextRow
		Label="TRID_WORKER2_17_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふるきずに　ズキズキ　きやがる……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
