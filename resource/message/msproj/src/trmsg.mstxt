	<TextRow
		Label="TRID_KINDERGARTENW_08_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーさん
ちょっと　つよしゅぎ！</Text>
