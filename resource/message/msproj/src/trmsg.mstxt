			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_08_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごいね！
つよいな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごいね！
つよいな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
