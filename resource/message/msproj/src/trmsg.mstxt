	<TextRow
		Label="TRID_VETERANM_1_08_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>けっきょく　ぼくが　いちばん
つよくて　すごいんだよね……　なんて</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>結局　ぼくが　一番
強くて　すごいんだよね……　なんて</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MAID_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あー　たのしかった！
さあて　おそうじ　しなくっちゃ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T12:34:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T12:34:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あー　楽しかった！
さあて　お掃除　しなくっちゃ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T12:34:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T12:34:05" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_02_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいしょで　あいての　こころを
キャッチするのって　だいじ　ですよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最初で　相手の　心を
キャッチするのって　大事ですよね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_02_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいしゅうしょう！
さいごの　ポケモン　です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最終章！
最後の　ポケモン　です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_02_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんどこそ　ハッピーエンディング！
あとあじが　わるいのは　にがてです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今度こそ　ハッピーエンディング！
後味が　悪いのは　苦手です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……うわあ▼
アタシ　またも
しちゃってます　あぜんぼーぜん▼
いろいろ　ことばは　しっていますが
うまく　いいあらわせないんですよね▼
きっと　ことばに　すると
いまの　きもちとか　それに▽
とじこめられちゃうから　かなあ▼
でも　これだけは　いわせてください
アナタ　さらに　グレートです！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……うわあ▼
アタシ　またも
しちゃってます　あぜんぼーぜん▼
いろいろ　言葉は　知っていますが
うまく　言い表せないんです▼
きっと　言葉に　すると
いまの　気持ちとか　それに▽
閉じこめられちゃうから　かなあ▼
でも　これだけは　いわせてください
アナタ　最高に　グレートです！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_02_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここで　その　わざとはね……
おもわず　みとれてしまうよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここで　その技とはね……
思わず　みとれてしまうよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_02_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みずから　あきらめる　にんげんに
しょうりは　ひきよせられないぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みずから　あきらめる　人間に
勝利は　ひきよせられないぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_02_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょくげんの　じょうきょうでも
かてる　やりかた……　あるはずだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>極限の　状況でも
勝てる　やりかた……　あるはずだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どの　ポケモンを　そだてるか▼
どの　わざを　おしえるか▼
どの　どうぐを　もたせるか▼
あらゆることを　おろそかに　しない
それが　かつための　すべてさ▼
きみは　そういう　いみで
すぐれた　しょうぶし　だな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どの　ポケモンを　育てるか▼
どの　技を　教えるか▼
どの　道具を　持たせるか▼
あらゆることを　おろそかに　しない
それが　勝つための　すべてさ▼
きみは　そういう　意味で
優れた　勝負師だな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_02_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……あいかわらず　つよいな
それでこそ　こころおどる！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……相変わらず　強いな
それでこそ　心躍る！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_02_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ラスト　１ぴき！
だが　つよさは　むげん！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ラスト　１匹！
だが　強さは　無限！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_02_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つぎの　わざ！
たましいを　こめる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>次の　技！
魂を　こめる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうの　ポケモンなど　いないし
ベストの　くみあわせも　ない……▼
それゆえ　つねに
かちつづけるのは　むずかしい▼
だが　つよさを　もとめる　こころ
さいきょうを　しりたい　きもち……▽
それを　わたしは　とうとい　とおもう▼
そして　それを　もっている
おまえを　そんけいする</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強の　ポケモンなど　いないし
ベストの　組み合わせも　ない……▼
それゆえ　つねに
勝ち続けるのは　むずかしい▼
だが　強さを　求める　心
最強を　知りたい　気持ち……▽
それを　わたしは　尊いと　思う▼
そして　それを　持っている
おまえを　尊敬する</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_02_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アタクシと　ポケモンの　ハーモニー！
これから　おみせいたします！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アタクシと　ポケモンの　ハーモニー！
これから　おみせいたします！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_02_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょくげんの　たたかいが
アタクシを　つよくしてくれます！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>極限の　戦いが
アタクシを　強くしてくれます！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_02_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんじょうを　コントロールし
しょうりへの　エネルギーに　します！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>感情を　コントロールし
勝利への　エネルギーに　します！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいかわらず……▼
いえ　いぜんよりも
エレガントで　エクセレントな▽
トレーナーと　ポケモンね　アナタたち▼
そんな　きらびやかな　かたと
きそいあうことで▼
アタクシも　ポケモンも　みがかれます
かんしゃ　いたします▽
また　おあいて　してくださいね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あいかわらず……▼
いえ　以前よりも
エレガントで　エクセレントな
トレーナーと　ポケモンね　アナタたち▼
そんな　きらびやかな　かたと
競いあうことで▼
アタクシも　ポケモンも　磨かれます
感謝いたします▽
また　お相手してくださいね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DPCHAMPION_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここまで　おいつめられたの
いついらい　かしら！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここまで　追い詰められたの
いつ以来　かしら！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DPCHAMPION_01_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まだまだよ！　こんなに　たのしい
しょうぶ　かんたんに　おわらせない！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まだまだよ！　こんなに　楽しい
勝負　簡単に　終わらせない！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DPCHAMPION_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんなに　もえあがる
いっせんを　まじえることが　できて▽
こころが　たかなっちゃう……！▼
あなたって　ほんとうに
すごい　トレーナー　なのね！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんなに　燃えあがる
一戦を　交えることが　できて▽
心が　高鳴っちゃう……！▼
あなたって　本当に
すごい　トレーナー　なのね！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_01_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>どうだい？　この　ポケモンジム▼
なんというか　ちょっと　ありえない
あやしげな　みりょく　たっぷりだろ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どうだい？　この　ポケモンジム▼
なんというか　ちょっと　ありえない
怪しげな　魅力　たっぷりだろ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_01_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンジムに　まけずおとらず
きみも　みりょく　たっぷり　だな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンジムに　負けず劣らず
きみも　魅力たっぷり　だな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_01_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>マユから　いとが　どっちに
のびているのか　よく　みてごらん▼
いとが　つながっている　さき……
それこそが　すすむ　ほうこうなのさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>繭から　糸が　どっちに
のびているのか　よく　みてごらん▼
糸が　つながっている　先……
それこそが　進む　方向なのさ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_02_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>……そうなんだよ
マユに　くるまれ　ねていたんだよ　</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……そうなんだよ
繭に　くるまれ　寝ていたんだよ　</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_03_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>いきどまり……▼
と　みせかけて
とおせんぼ　やー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>行き止まり……▼
と　みせかけて
とおせんぼ　やー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_03_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ありゃりゃりゃ
あんさん　つよすぎやない？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ありゃりゃりゃ
あんさん　強すぎやない？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_03_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ここだけの　ヒミツ……▼
マユに　はいる　むきによって
どこに　すすむのか　ちがうんよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここだけの　ヒミツ……▼
繭に　入る　向きによって
どこに　進むのか　違うんよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_04_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>あと　いっぽで！
アーティさんと　しょうぶ　できる！▼
だーけーどー　そのまえに
ミーが　たちはだかっちゃうのよー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あと　一歩で！
アーティさんと　勝負できる！▼
だーけーどー　その前に
ミーが　立ちはだかっちゃうのよー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_04_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>その　たたかいかた……
アーティさんぐらい　げいじゅつてき！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その　戦い方……
アーティさんぐらい　芸術的！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_JUGGLING_1_04_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>アーティさんは　マユに　くるまる
ポケモンの　きもちを　しるために▽
ポケモンジムを　かいぞう　したのさ▼
……そのせいで　ミーたち
いっつも　まよっちゃうんだけどね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アーティさんは　繭に　くるまる
ポケモンの　気持ちを　理解するために▽
ポケモンジムを　改造したのさ▼
……そのせいで　ミーたち
いっつも　迷っちゃうんだけどね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-18T10:59:41" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_04_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごい　かぜ……　だろ？▼
これは　ジムリーダーを　はじめ
オレたちの　つよさの　しょうちょう！▼
さて　ここは　ポケモンジムだ！
ポケモンしょうぶと　いこう！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごい　風……　だろ？▼
これは　ジムリーダーを　はじめ
オレたちの　強さの　象徴！▼
さて　ここは　ポケモンジムだ！
ポケモン勝負と　行こう！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_04_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミと　キミの　ポケモンから
すさまじい　あつりょくを　かんじたよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミと　キミの　ポケモンから
すさまじい　圧力を　感じたよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T12:34:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T12:34:05" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_04_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレから　アドバイスだよ▼
まわりを　かべに　かこまれて
ゆかのいろが　ちがうところ　なら▽
かぜに　とばされないだろう！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレから　アドバイスだよ▼
周りを　壁に　囲まれ
床の色が　違うところ　なら▽
風に　飛ばされないだろう！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_05_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよい　かぜにも　まけない
じまんの　ポケモンだぜ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強風にも　負けない
自慢の　ポケモンだぜ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_05_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　ポケモンには
まけてしまった……！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　ポケモンには
負けてしまった……！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_05_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そらをとぶ　ポケモンと　おおぞらを
まうため　パイロットに　なったんだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そらをとぶ　ポケモンと　大空を
舞うため　パイロットに　なったんだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_06_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ときには　むぼうなほど　だいたんに
ときには　おびえすぎて　せんさいに▼
そうしないと　ジムの　しかけが
きみの　ゆくてを　はばんじゃうぜ▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>時には　無謀なほど　大胆に
時には　おびえすぎて　繊細に▼
そうしないと　ジムの　仕掛けが
きみの　行く手を　はばんじゃうぜ▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_06_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆくてを　はばめなかった……
きみは　たいした　トレーナーだぜ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>行く手を　はばめなかった……
きみは　たいした　トレーナーだぜ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_06_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まわりにある　ふうりょくけいの
かいてんが　はやくなってきたら▽
むりせず　どこかに　かくれることだね</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>周囲にある　風力計の
回転が　速くなってきたら▽
無理せず　どこかに　隠れることだね</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_07_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしに　かてれば
つぎは　ジムリーダー……▼
そうおもうのは　ゆだんたいてき！
まだまだ　きを　ぬくなよ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしに　勝てれば
次は　ジムリーダー……▼
そう思っているなら　油断大敵
まだまだ　気を抜くなよ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_07_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まさか！？
ゆだんなど　していなかったのに！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まさか！？
油断など　していなかったのに！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_07_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひこうきの　そうじゅうは
ちゃくりくが　いちばん　むずかしい▽
さいごまで　ゆだん　するなよ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>飛行機の　操縦は
着陸が　一番　難しい……▽
最後まで　気を抜くんじゃないぜ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_08_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みぎ　よし！　ひだり　よし！▼
それでは　しょうぶの　フライト
テイク　アウト！▼
じゃなかった　テイク　オフ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T10:53:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T10:53:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>右よし！　左よし！▼
それでは　勝負の　フライト
テイク　アウト！▼
じゃなかった　テイク　オフ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-15T01:21:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-15T01:21:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_08_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ざんねん　ながら
ちゃくりく……　セットダウンです</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>残念ながら
着陸……　セットダウンです</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PILOT_08_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうふうに　むかって
どれだけ　とべるか……？▼
ひこうきなら　せいのうが　だいじだが
ひとと　ポケモンは　きもちかな？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強風に　向かって
どれだけ　飛べるか……？▼
飛行機なら　性能が　大事だが
人と　ポケモンは　気持ちかな？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER1_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>その　わざを　えらぶとは……
なるほど！　てごわい　あいて　だね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その技を　選ぶとは……
なるほど！　手強い　相手だね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER1_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジムリーダーとして
きみの　かべで　ありたい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジムリーダーとして
きみの　壁で　ありたい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER1_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……！　そう　これが
ポケモンしょうぶ　なんだよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……！　そう　これが
ポケモン勝負　なんだよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER2_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あんたの　かちたいって
エネルギー　めっちゃ　あふれてる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あんたの　勝ちたいって
エネルギー　めっちゃ　あふれてる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER2_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まだまだ！　ここから　もりあげて
あたしが　かつの！　ばくれつッ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まだまだ！　ここから　盛りあげて
あたしが　勝つの！　爆裂ッ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER2_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっとーッ！
まだ　サビの　とちゅう　だって！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T09:58:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T09:58:31" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちょっとーッ！
まだ　サビの　途中だって！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T09:58:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-25T09:58:31" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER3_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ビシィッと　スイッチ　オーン！
むしポケモンの　ほんき　みせるね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ビシィッと　スイッチ　オーン！
むしポケモンの　本気　みせるね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER3_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むうん　むしのしらせ！
けっこう　ピンチかも　だって！？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>むうん　むしのしらせ！
けっこう　ピンチかも　だって！？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER3_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぬうん……！？　おわった
きみ　すごいんだねー！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぬうん……！？　終わった
きみ　すごいんだねー！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER4_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>その　たちふるまい……
かがやいているわね　あなたたち！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その　立ち振る舞い……
輝いているわね　あなたたち！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER4_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ピンチを　のりこえる！
ファンの　きたいに　こたえないと</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ピンチを　乗り越える！
ファンの　期待に　応えないと</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER4_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しびれた……
ハートが　とろけるほどに</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しびれた……
ハートが　とろけるほどに</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER5_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……ほほう！
それなりの　うでまえ　だな</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……ほほう！
それなりの　腕前だな</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER5_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレさまが　あきらめたら
ポケモンに　もうしわけねえだろ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレさまが　あきらめたら
ポケモンに　申し訳ねえだろ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER5_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やれやれ……　ほんきで　たたかって
まけると　すがすがしいな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やれやれ……　本気で　戦って
負けると　すがすがしいな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER6_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アナタが　どう　せめてくるのかって
すごく　ドキドキしちゃうよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アナタが　どう　攻めてくるのかって
すごく　ドキドキしちゃうよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T02:09:33" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER6_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ネバーギブアップ　です！
たたかう　ポケモンに　しつれいだもの</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ネバーギブアップ　です！
戦う　ポケモンに　失礼だもの</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER6_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いまの　たたかい　わすれないよ！
アナタと　たたかえて　よかった！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今の　戦い　忘れないよ！
アナタと　戦えて　よかった！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER7_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　わざを　えらぼうとも
あつい　おもいを　かんじるぞ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんな技を　選ぼうとも
熱い　思いを　感じるぞ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER7_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おいてなお　ぜんしんの　ちがたぎる！
まだまだ　たたかおうぞ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>老いてなお　全身の　血がたぎる！
まだまだ　戦おうぞ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER7_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やぶれて　わきあがる　くやしさ……▼
その　おもいに　くっせぬ　こころこそ
いきる　エネルギー　というもの！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>敗れて　わきあがる　悔しさ……▼
その思いに　屈せぬ　心こそ
生きる　エネルギー　というもの！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER8_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おはん……
やりおるな！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おはん……
やりおるな！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
