	<TextRow
		Label="TRID_SWPLAZMAM_32_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こいつめ！　おれの
どうぐを　こわしやがって！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T09:22:03" />
			<Status>Editing</Status>
