	<TextRow
		Label="TRID_VETERANM_11_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　えらんだ　３びき……
あつりょくを　かんじたぜ！</Text>
