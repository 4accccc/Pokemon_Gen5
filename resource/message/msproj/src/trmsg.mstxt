	<TextRow
		Label="TRID_FANM_04_TRMSG_FIGHT_AFTER_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドカンと　つきすすむ　オフェンス！
アメフトの　だいごみ　だよねー！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
