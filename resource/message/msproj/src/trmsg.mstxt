	<TextRow
		Label="TRID_FANM_10_TRMSG_FIGHT_START_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パフパフパフ！　あ　パフパフパフ！
ファンの　さけびを　きいてくれい！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
