			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_23_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わざや　どうぐが　おおいと
かえって　まよっちゃうのよね……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>技や　道具が　多いと
かえって　迷っちゃうのよね……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_23_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まよったら　すてる！
たびをするには　みがるが　いちばん！▽
ポケモンが　いれば　だいじょうぶ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まよったら　すてる！
たびをするには　みがるが　いちばん！▽
ポケモンが　いれば　だいじょうぶ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
