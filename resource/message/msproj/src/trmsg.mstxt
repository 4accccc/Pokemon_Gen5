	<TextRow
		Label="TRID_SOCCER_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レクチャーを　リターン！▼</Text>
