	</TextRow>
	<TextRow
		Label="TRID_PARASOL_10_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かえって　かれし……　ううん
ポケモンに　なぐさめてもらお！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>帰って　彼氏……　ううん
ポケモンに　なぐさめてもらお！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
