	<TextRow
		Label="TRID_FANM_06_TRMSG_FIGHT_START_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよい　せんしゅの
ボールに　なりたい　ボクです！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
