			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MOUNT_14_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おれさまは　なにを　えらそうに
おしえようと　してたのだ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おれさまは　なにを　偉そうに
教えようと　してたのだ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
