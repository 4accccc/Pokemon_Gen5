	</TextRow>
	<TextRow
		Label="TRID_OL_04_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あーあ
まけちゃったか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あーあ
負けちゃったか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:43" />
			<Status>Editing</Status>
