	<TextRow
		Label="TRID_FUTAGO_07_TRMSG_POKE_ONE_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモン　１ひき　だけなの？
しんじられない……　ありえない……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
