	<TextRow
		Label="TRID_HEADS_03_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オメーも　かっこいいな
あこがれるよー！　これ　やるよー！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
