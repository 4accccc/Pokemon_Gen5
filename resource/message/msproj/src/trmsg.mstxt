			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FANM_10_TRMSG_POKE_ONE_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ドンドンドン！　あ　ドンドンドン！
そろそろ　げんかいが　みえてきた？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ドンドンドン！　あ　ドンドンドン！
そろそろ　限界が　みえてきた？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
