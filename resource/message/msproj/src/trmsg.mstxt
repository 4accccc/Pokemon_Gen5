	<TextRow
		Label="TRID_TANPAN_20_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみも　アンラッキー　だな
つよい　ぼくに　であうなんて▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
