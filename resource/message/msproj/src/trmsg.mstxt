	<TextRow
		Label="TRID_TANPAN_18_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいての　めを　みたら
たたかいたい　きもち　わかるよな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
