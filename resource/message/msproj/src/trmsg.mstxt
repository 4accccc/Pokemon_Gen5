			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_43_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミたち……
ベストコンビって　かんじだな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミたち……
ベストコンビって　かんじだな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
