	<TextRow
		Label="TRID_FOOTBALL_06_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ＰＯＷＥＲ！！！！▼
どんな　みちをも　きりひらく
さいきょうの　パワーで　かつ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ＰＯＷＥＲ！！！！▼
どんな　道をも　切り拓く
最強の　パワーで　勝つ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T06:20:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
