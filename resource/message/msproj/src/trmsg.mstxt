		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_WAITER_02_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こちらの　めいぶつは
ポケモンしょうぶと　なっております</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こちらの　名物は
ポケモン勝負と　なっております</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_WAITRESS_02_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いらっしゃいませ　ようこそ！▼
ドリンクと　いっしょに
ポケモンしょうぶは　いかがですか！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いらっしゃいませ　ようこそ！▼
ドリンクと　いっしょに
ポケモン勝負は　いかがですか！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_WAITRESS_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すばらしい　しょうぶ　でした
おきゃくさま！　おみごとです</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すばらしい　勝負でした
おきゃくさま！　おみごとです</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_WAITRESS_02_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶで　ぐったりの　ポケモンに
シュワと　さわやか　サイコソーダ！▽
じどうはんばいきで　かえまーす！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T06:11:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T06:11:04" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝負で　ぐったりの　ポケモンに
シュワと　さわやか　サイコソーダ！▽
自動販売機で　買えまーす！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T06:11:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T06:11:04" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_05_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいの　かべは
そう　かんたんには　こえられないな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界の　壁は
そう　簡単には　越えられないな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_05_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そんな　ポケモンと　やれたら
まったかいが　あったってものよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そんな　ポケモンと　やれたら
待ったかいが　あったってものよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_GENTLE_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みごとな　おてまえ！
……さぁ　おちゃでも　のもうか？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みごとな　お手前！
……さぁ　お茶でも　飲もうか？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MADAM_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みんな　いい　ポケモンたちね！
ありがとう　いいじかんを　すごせたわ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みんな　いい　ポケモンたちね！
ありがとう　いい時間を　過ごせたわ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_05_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すっごーい！
それが　とかいの　ポケモンなのね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すっごーい！
それが　都会の　ポケモンなのね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PRINCE_04_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パパと　ママに　かわりに
あそんでくれて　ありがとう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T06:11:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T06:11:04" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パパと　ママに　代わりに
遊んでくれて　ありがとう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T06:11:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T06:11:04" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PRINCESS_04_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ステキ……
さぁ　わたしを　つれていって！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ステキ……
さぁ　わたしを　連れて行って！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいての　きょうみを　ひくには
さいしょが　かんじん　ですよね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>相手の　興味を　ひくには
最初が　重要ですよね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まだ　けつまつは　きまってません！
アタシの　のぞむ　かたちに　します！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まだ　結末は　決まってません！
アタシの　望む　形に　します！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_01_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねがいは　ハッピーエンディング！
あとあじが　わるいのは　にがてです</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>願いは　ハッピーエンディング！
後味が　悪いのは　苦手です</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR1_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんどうすると
ことばって　でないんですよね▽
ほんとは……▼
ものかきなのに　いまの　きもちを
うまく　あらわせないのですが▼
アナタ　とっても　グレートです！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>感動すると
言葉って　でないんですよね▽
ほんとは……▼
物書きなのに　今の　気持ちを
うまく　表せないのですが▼
アナタ　とっても　グレートです！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>その　わざを　えらんだ　しんり
よみきれば　かてるかな？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その技を　選んだ　心理
読みきれば　勝てるかな？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うつくしくても　まけは　まけ
ぶざまでも　かちは　かちだぜ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>美しくても　負けは　負け
無様でも　勝ちは　勝ちだぜ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_01_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんなに　きびしい　じょうきょうでも
かてる　やりかた……　あるはずだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんなに　厳しい　状況でも
勝てる　やりかた……　あるはずだぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR2_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かつ　やつが　いれば
まける　やつが　いる▼
それを　かくご　せずに
まけて　さわぐのは　ぶざま▼
まけたら　つぎ　かてるために
できることを　する▽
それが　しょうぶし　さ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T07:02:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝つ　やつが　いれば
負ける　やつが　いる▼
それを　覚悟せずに
負けて　騒ぐのは　愚か▼
負けたら　次　勝つために
できることを　する▽
それが　勝負師さ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つたわってきた！
おまえたち　つよいな！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>伝わってきた！
おまえたち　強いな！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ラスト　１ぴき！
しょうねんば　だな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ラスト　１匹！
正念場だな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_01_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>のこりの　ちからを　ふりしぼり！
つぎの　わざに　すべてを　こめる！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>残りの　力を　ふりしぼり！
次の技に　すべてを　こめる！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR3_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきょうの　ポケモンなど　いないし
ベストの　くみあわせも　ない……▼
それゆえ　つねに
かちつづけるのは　むずかしい▼
だが　つよさを　もとめる　こころ
さいきょうを　しりたい　きもち……▽
それを　わたしは　とうとい　とおもう▼
そして　それを　もっている
おまえを　そんけいする</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最強の　ポケモンなど　いないし
ベストの　組み合わせも　ない……▼
それゆえ　つねに
勝ち続けるのは　むずかしい▼
だが　強さを　求める　心
最強を　知りたい　気持ち……▽
それを　わたしは　尊いと　思う▼
そして　それを　持っている
おまえを　尊敬する</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_01_TRMSG_FIGHT_FIRST_DAMAGE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンたちが　ぜんりょくを　だせる
すてきな　じかんが　はじまりそうね</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンたちが　全力を　だせる
すてきな　時間が　はじまりそうね</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これほどとは……！　いけません
アタクシに　ゆだんが　ありましたね</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これほどとは……！　いけません
アタクシに　油断が　ありましたね</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_01_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうりの　ため　あえて
かんじょうを　ばくはつ　させます！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝利の　ため　あえて
感情を　爆発させます！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BIGFOUR4_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エレガントで　エクセレントな
トレーナーと　ポケモンね　アナタたち▼
そんな　きらびやかな　かたと
きそいあうことで▼
アタクシも　ポケモンも　みがかれます
かんしゃ　いたしますわ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エレガントで　エクセレントな
トレーナーと　ポケモンね　アナタたち▼
そんな　きらびやかな　かたと
競いあうことで▼
アタクシも　ポケモンも　磨かれます
感謝いたしますわ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWSAGE1_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>それぐらい
けいさんずみ　ですとも！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それぐらい
計算済み　ですとも！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWSAGE1_01_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>……？　どういうことなのだ？
けいさんが　くるっているぞ！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……？　どういうことなのだ？
計算が　狂っているぞ！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWSAGE1_01_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>またしても　ワタクシの　もくろみが！
せかいの　かんぜん　しはいがっ！！▼
ありえるか！▼
いいや　ありえぬ！！▼
ありえては　ならぬ！！▼
どこの　ダレとも　わからぬ
つまらぬ　トレーナーなんぞに！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>またしても　ワタクシの　目論見が！
世界の　完全支配がっ！！▼
ありえるか！▼
いいや　ありえぬ！！▼
ありえては　ならぬ！！▼
どこの　ダレとも　わからぬ
つまらぬ　トレーナーなんぞに！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_13_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　たびの　１ページに
ぼくたちも　くわえてもらおう！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　旅の　１ページに
ぼくたちも　加えてもらおう！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_13_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくが　かてば　きみの
いんしょうに　のこっただろうに！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくが　勝てば　きみの
印象に　残っただろうに！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_13_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だれかの　きおくに　のこること……
それが　いきている　あかし　なのかも</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>だれかの　記憶に　残ること……
それが　生きている　証なのかも</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_13_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　めが　うったえてるの！
たたかえ！　そして　かて！　と▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンの　めが　訴えてるの！
戦え！　そして　勝て！　と▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_13_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　ポケモンの　め
つよい　ひかりを　やどしているのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたの　ポケモンの　め
強い　光を　宿しているのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_13_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　めが　うったえてるの！
たちあがれ！　オレは　へいきだって！▼
そう！　めを　みれば
はなせなくても　きもちは　わかるの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンの　めが　訴えてるの！
立ちあがれ！　オレは　平気だって！▼
そう！　めを　みれば
話せなくても　気持ちは　わかるの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_CHILDCARE_12_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>キャッ！
すっごーい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:43" />
