			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンと　オマエが
どれだけ　できるか　証明しろ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
