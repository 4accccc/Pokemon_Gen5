	<TextRow
		Label="TRID_ELITEM_37_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンと　オマエが
どれだけ　できるか　しょうめいしろ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
