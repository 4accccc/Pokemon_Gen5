			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_WORKER2_22_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくは　まけても　いいけど
なんだか　ポケモンが　かわいそう……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくは　負けても　いいけど
なんだか　ポケモンが　かわいそう……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_WORKER2_23_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そういえば　ポケモンしょうぶ　とか
すごい　ひさしぶり　だな</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そういえば　ポケモン勝負とか
すごい　久しぶり　だな</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_26_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>もちろん　おあいて　するわ
おきにいりの　コロモリでね！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-29T12:22:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-29T12:22:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もちろん　お相手　するわ
おきにいりの　コロモリでね！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-29T12:22:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-29T12:22:10" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_26_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>わーお！
モーレツ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わーお！
モーレツ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_26_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>あたしの　おきにいりの　ばしょ
それが　ここ　なんだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしの　おきにいりの　場所
それが　ここ　なんだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_33_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>よーし！　ポケモンしょうぶ！
レッツ　スタート！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よーし！　ポケモン勝負！
レッツ　スタート！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_33_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>かあ！
おまえ　つよすぎ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>かあ！
おまえ　強すぎ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_33_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>いろの　こい　くさむらで
ポケモンの　とっくん　だ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>色の　濃い　草むらで
ポケモンの　特訓だ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_34_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>オレ　つよくなって
ホミカちゃんに　いいとこ　みせるんだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-15T03:28:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-15T03:28:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレ　強くなって
ホミカちゃんに　いいとこ　みせるんだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-15T03:28:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-15T03:28:53" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_34_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>あはは……
ウソでしょ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あはは……
ウソでしょ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_34_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>オレ　つよくなって
ホミカちゃんに　いいとこ　みせたいよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレ　強くなって
ホミカちゃんに　いいとこ　みせたいよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_ADULTW_01_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ！　ライモンジムへ
ポケモンと　トレーナーが　おりなす▼
かれいな　ポケモンしょうぶと
ファッションショーの　はじまり！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ！　ライモンジムへ
ポケモンと　トレーナーが　おりなす▼
華麗な　ポケモン勝負と
ファッションショーの　始まり！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ADULTW_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ショーは　これから……▼
……って　あれ？
もう　おわり？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ショーは　これから……▼
……って　あれ？
もう　終わり？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ADULTW_01_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたのポケモンと　あなた
とっても　シャイニングでしたわ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたのポケモンと　あなた
とっても　シャイニングでしたわ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ADULTW_02_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うつくしいでは　ダメ！
トレーナーとして　つよくなければ！▼
わたしたちの　ビューティな
たたかいぶりに　みとれないでよ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>美しいだけでは　ダメ！
トレーナーとして　強くなければ！▼
わたしたちの　ビューティな
戦いぶりに　みとれないでよ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ADULTW_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……つよくて　ビューティ！
わたしが　みとれちゃったわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……強くて　ビューティ！
わたしが　みとれちゃったわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ADULTW_02_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うつくしさ　っていうのは
ルックス　だけじゃないの▼
あなたも　カミツレさまも
つよさが　うつくしさの　いちぶね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>美しさ　っていうのは
ルックスだけじゃ　ないの▼
あなたも　カミツレさまも
強さが　美しさの　一部ね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ADULTW_03_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ショーも　おおづめ　だけど
カミツレさまと　おなじ　ステージに▽
たてるか　チェックしてあげる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ショーも　大詰めだけど
カミツレさまと　同じ　ステージに▽
立てるか　チェックしてあげる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ADULTW_03_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>その　つよさと　うつくしさ……！▼
カミツレさまの　ステージに
たっても　いいんじゃない？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その　強さと　美しさ……！▼
カミツレさまの　ステージに
立っても　いいんじゃない？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ADULTW_03_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたと　カミツレさまで　みせた
きらびやかな　ポケモンしょうぶ▼
おもわず　みとれちゃったじゃない！
とても　ステキな　ショーだったわよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたと　カミツレさまで　みせた
きらびやかな　ポケモン勝負▼
思わず　みとれちゃったじゃない！
とても　ステキな　ショーだったわよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FISHING_13_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしという　みりょくてきな
つりばりに　ひっかかったな！▼
つりたて　ピチピチの　ポケモンで
しょうぶ　してあげよう！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>私という　魅力的な
釣り針に　引っかかったな！▼
釣りたて　ピチピチの　ポケモンで
勝負してあげよう！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FISHING_13_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おもわず　ピチピチ　はねちゃう！
ピチピチ　ピチピチッ　ピチピチッ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>思わず　ピチピチ　跳ねちゃう！
ピチピチ　ピチピチッ　ピチピチッ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FISHING_13_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンは　つられているのでは　なく
わたしに　しょうぶを　いどむため▽
つりバリに　くいついて　いるのかも？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンは　釣られているのでは　なく
私に　勝負を　挑むため▽
釣りバリに　食いついて　いるのかも？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FISHING_14_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おっし！
たいりょう　たいりょう！▼
つぎは　しょうり　という
えものを　つってみるか▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おっし！
大漁　大漁！▼
次は　勝利という
獲物を　釣ってみるか▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FISHING_14_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>のがした　しょうりは
あまりにも　でかかった……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>逃した　勝利は
あまりにも　でかかった……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FISHING_14_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つりは　じんせいと　おなじ▼
ねらわないと　つれないし
ねらっても　つれないんだよ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>釣りは　人生と　同じ▼
ねらわないと　釣れないし
ねらっても　釣れないんだよ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BREEDERW_04_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はやく　つよく　そだてるには
たたかうのが　いちばん　ですよね！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はやく　強く　育てるには
戦うのが　一番ですよね！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BREEDERW_04_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　ポケモンの　そだてかた
わたしの　もくひょう　だわ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　ポケモンの　育て方
わたしの　目標だわ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BREEDERW_04_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみが　ここに　くるたび
あいてを　してもらうんだから！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T11:47:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T11:47:53" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみが　ここに　来るたび
相手を　してもらうんだから！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T11:47:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-10T11:47:53" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_POLICE_03_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>におう！　におうぞ！
ほんかんの　ハーデリアが！▼
キミから　ただならぬ
キケンな　においを　かぎとった！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>におう！　におうぞ！
本官の　ハーデリアが！▼
キミから　ただならぬ
キケンな　においを　かぎとった！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_POLICE_03_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なるほど……　たしかに
キケンな　つよさ　だったな……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なるほど……　確かに
キケンな　強さ　だったな……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_POLICE_03_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよいからって
そうでないヤツを　バカにするなよ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強いからって
そうでないヤツを　バカにするなよ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_17_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハイ！　トレーナー！
ぼくと　しょうぶ！！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハイ！　トレーナー！
ぼくと　勝負！！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_17_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サンキュー！　すてきな　しょうぶ
たびの　メモリアルだよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サンキュー！　すてきな　勝負
旅の　メモリアルだよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_17_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おやゆび　あげて　クルマを　とめて
しせん　あわせて　トレーナー　とめて</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>親指　あげて　クルマを　とめて
視線　あわせて　トレーナー　とめて</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_POLICE_04_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっと　そこの　キミ！
とまりなさーい！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちょっと　そこの　キミ！
とまりなさーい！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_POLICE_04_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>その　いきおい　とまらない！
まさに　アンストッパブル！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その　勢い　とまらない！
まさに　アンストッパブル！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_POLICE_04_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わかいうちは　いきおい　つけて
ムチャしちゃって　いいんだよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>若いうちは　勢い　つけて
ムチャしちゃって　いいんだよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_POLICE_05_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こどもが　こんなところを
ウロウロしてるとは　なにごとだ！？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こどもが　こんな所を
ウロウロしてるとは　なにごとだ！？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_POLICE_05_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんかんを　まかすとは……
なんて　こどもだ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本官を　負かすとは……
なんて　子供だ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_POLICE_05_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なにが　あっても　なくても
パトロール　するのが　ほんかんだ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なにが　あっても　なくても
パトロール　するのが　本官だ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_HEADS_07_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここは　おめーみたいな
ヒヨッコのくる　ところじゃないぜ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここは　おめーみたいな
ヒヨッコの来る　所じゃないぜ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_HEADS_07_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんて　やつだ……
おとなしそうな　かお　なのに！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんて　やつだ……
おとなしそうな　顔なのに！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_HEADS_07_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんにせよ　トレーナーなら
しょうぶを　いどまれるんだけどよお！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんにせよ　トレーナーなら
勝負を　挑まれるんだけどよお！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_HEADS_08_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かがやく　アタマは
きあいの　あかし　なんだぜ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>輝く　アタマは
気合の　証なんだぜ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_HEADS_08_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたまが　フラッシュ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頭が　フラッシュ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_HEADS_08_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきん　おとうとの　ヤローが
ワルに　めざめちまったんだぜ▼
アイツは　まっすぐ
いきて　ほしいんだけどよ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最近　弟の　ヤローが
ワルに　目覚めちまったんだぜ▼
アイツは　まっすぐ
生きて　ほしいんだけどよ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADRIDER_07_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さばくに　バイク！
ワイルドで　えに　なるだろう？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂漠に　バイク！
ワイルドで　絵に　なるだろう？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADRIDER_07_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バイクと　すな　あいしょうが　わるい
オレと　オマエ　あいしょうが　わるい</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バイクと　砂　相性が　悪い
オレと　オマエ　相性が　悪い</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADRIDER_07_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バイクも　じてんしゃも　すなに
タイヤが　うまっちまうんだよ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:02" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バイクも　じてんしゃも　砂地じゃ
タイヤが　埋まっちまうんだよ！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:24" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_22_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おいら　きのうから
ワルに　めざめたんだぜ！▽
だから　つよいんぜ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おいら　昨日から
ワルに　目覚めたんだぜ！▽
だから　強いんぜ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_22_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めざめただけじゃ　ダメなのか
ワルって　あんがい　たいへんだな……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>目覚めただけじゃ　ダメなのか
ワルって　案外　大変だな……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_22_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おいら　にいちゃん　みたいに
かがやく　あたまに　したい！▼
だって　シャンプーのあと
すぐに　かわいて　あそべるだろ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おいら　にいちゃん　みたいに
輝く　頭に　したい！▼
だって　シャンプーのあと
すぐに　乾いて　遊べるだろ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADTEAM_02_TRMSG_FIGHT_START_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オラオラーッ
かわいがってやるぜーッ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オラオラーッ
かわいがってやるぜーッ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADTEAM_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ロブ『お……　おれの
かわいい　ポケモンがーッ！▼
ギン『おれの　ベイビィちゃんが
まけちゃったぜーッ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ロブ『お……　おれの
かわいい　ポケモンがーッ！▼
ギン『おれの　ベイビィちゃんが
負けちゃったぜーッ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADTEAM_02_TRMSG_FIGHT_AFTER_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おめーの　ポケモンも
かわいいじゃねーかッ！▼
そして　トレーナーの
おめーも　なかなか……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おめーの　ポケモンも
かわいいじゃねーかッ！▼
そして　トレーナーの
おめーも　なかなか……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADTEAM_02_TRMSG_POKE_ONE_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フン……！　たたかえる　ポケモンが
１ひきしか　いない　ヤツの▽
あいてなんか　したくないんだぜーッ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フン……！　戦える　ポケモンが
１匹しか　いない　ヤツの▽
相手なんか　したくないんだぜーッ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADTEAM_02_TRMSG_FIGHT_START_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヘイヘイヘイ！　どうしたんだぁ？
まいごにでも　なったのかーッ！？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヘイヘイヘイ！　どうしたんだぁ？
迷子にでも　なったのかーッ！？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADTEAM_02_TRMSG_FIGHT_AFTER_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ワルいヤツどうし　あつまって
ポケモンじまん　してるんだぜ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ワルいヤツ同士　集まって
ポケモン自慢　してるんだぜ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BADTEAM_02_TRMSG_POKE_ONE_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>コラーッ！　てもち　１ぴきだとォ？▼
２ｖｓ１なんて　ふりな　しょうぶじゃ
ワルの　なが　すたるだろうがッ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コラーッ！　手持ち　１匹だとォ？▼
２ｖｓ１なんて　不利な　勝負じゃ
ワルの　名が　すたるだろうがッ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PRINCE_08_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こだいのしろに　たわむれに　きた
ラグジュアリーな　ボクの▽
ゴージャスな　ポケモンを　ごらん！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>古代の城に　たわむれに来た
ラグジュアリーな　ボクの▽
ゴージャスな　ポケモンを　ご覧！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PRINCE_08_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミの　つよさは
ハイクラス　だな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミの　強さは
ハイクラス　だな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PRINCE_08_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フェイバリットな　ポケモンと
かんこうめいしょを　めぐるのって▽
プレミアムな　けいけん　だからさ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フェイバリットな　ポケモンと
観光名所を　巡るのって▽
プレミアムな　経験だからさ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PRINCESS_08_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そこの　あなた……▼
ひまを　もてあました　わたくしと
ゆうがに　からみましょうよ▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そこの　あなた……▼
暇を　持て余した　わたくしと
優雅に　絡みましょうよ▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PRINCESS_08_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みつどの　こい　じかんを　すごせて
こころより　かんしゃ　いたしますわ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>密度の　濃い　時間を　過ごせて
心より　感謝いたしますわ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PRINCESS_08_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みわたすかぎり　すな　ばかり……
なにが　すごいのか　わかりませんわ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>見渡すかぎり　砂　ばかり……
なにが　すごいのか　わかりませんわ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_18_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すなに　うもれた　いせき！
であった　キミと　ボク！▽
ロマンついでに　たたかおう！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>砂に　埋もれた　遺跡！
出会った　キミと　ボク！▽
ロマンついでに　戦おう！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_18_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほろにがい　はいぼく……
ほろにがい　おもいで……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほろ苦い　敗北……
ほろ苦い　思い出……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_18_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおむかしの　ひとが
どうやって　くらしていたのか？▽
そうぞう　するのって　たのしい！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大昔の　人が
どうやって　暮らしていたのか？▽
想像するのって　楽しい！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_14_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　たびの　おともは
どんな　ポケモン？！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T06:20:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T06:20:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたの　旅の　お供は
どんな　ポケモン？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T06:20:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T06:20:10" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_14_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごーい！　とっても　つよくて
ステキな　なかま　だよね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごーい！　とっても　強くて
ステキな　仲間だよね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_14_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たびは　みちづれ　っていうけど
ほんと　そうだよね！▼
ポケモンと　いるおかげで
たのしさ　ばいぞう　だもん！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-27T12:47:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>旅は道連れ　っていうけど
ほんと　そうだよね！▼
ポケモンと　いるおかげで
楽しさ　倍増だもん！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DAISUKIM_04_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いきなり　ですけど
ぼくの　ポケモン　みてください！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いきなり　ですけど
ぼくの　ポケモン　みてください！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
