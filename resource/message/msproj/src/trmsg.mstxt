			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERW_25_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしよ……
かぜに　なれ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしよ……
風に　なれ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERW_25_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ！　いけない！
この　カゴのみを　あげなきゃ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ！　いけない！
この　カゴのみを　あげなきゃ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERW_25_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほらあなって　でいりぐちが　ちかいと
かぜが　ふいてくるのよね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>洞穴って　出入り口が　近いと
風が　吹いてくるのよね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_35_TRMSG_POKE_UNDER_TWO"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>３びき　です！　たたかえる
ポケモンが　３びき　いないとね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>３匹です！　戦える
ポケモンが　３匹　いないとね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_35_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じまんの　３びきで　つくりあげた
はかいりょくを　みてごらんよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自慢の　３匹で　つくりあげた
破壊力を　みてごらんよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_35_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チームとしての　そうごうりょく
きみたちの　ほうが　まさってるのか！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チームとしての　総合力
きみたちの　ほうが　勝ってるのか！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_35_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もっと　ポケモンと　むきあうかな
そうすれば　チームとして　つよくなれる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もっと　ポケモンと　むきあうかな
そうすれば　チームとして　強くなれる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_36_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パソコンで　しらべた　たたかいかたを
みにつけた　ボクに　しかくは　ない！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パソコンで　調べた　戦い方を
みにつけた　ボクに　死角は　ない！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_36_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はあ……
しょんぼり</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はあ……
しょんぼり</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_36_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>パソコンで　しらべて　みつけたのは
たにんの　いけんで　あって
ボクが　だした　こたえ　じゃなかった</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パソコンで　調べて　みつけたのは
他人の　意見で　あって▽
ボクが　だした　答え　じゃなかった</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_34_TRMSG_POKE_UNDER_TWO"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ローテーションバトルを　するには
ポケモンが　３びき　いないとね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ローテーションバトルを　するには
ポケモンが　３匹　いないとね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_34_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いとしの　３びきが　おりなす
トライアングルを　おひろめ　します▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>愛しの　３匹が　おりなす
トライアングルを　おひろめ　します▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_34_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チームとしての　そうごうりょく
あなたたちの　ほうが　うえなんだ！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チームとしての　総合力
あなたたちの　方が　上なんだ！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_34_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ローテーションだと　あえて
わざを　うけてくれる　ポケモンが▽
ひつように　なるのかなあ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ローテーションだと　あえて
技を　受けてくれる　ポケモンが▽
必要に　なるのかなあ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_35_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねえねえ！　あたしの　ポケモン
すごいんだ！　みてみて！！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねえねえ！　あたしの　ポケモン
すごいんだ！　みてみて！！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_35_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぎゃふん！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぎゃふん！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_35_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エリートと　よばれちゃうけど
なんか　しっくり　こないんだよね▼
だって　ただ　ポケモンが　すきで
つよくなりたいだけ　なんだもん！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エリートと　呼ばれちゃうけど
なんか　しっくり　こないんだよね▼
だって　ただ　ポケモンが　好きで
強くなりたいだけ　なんだもん！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DAISUKIM_05_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモントレーナーが
であえば　するのは　もちろん▽
ポケモンしょうぶ　ですよねー▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモントレーナーが
出会えば　するのは　もちろん▽
ポケモン勝負　ですよねー▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DAISUKIM_05_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふぎゃあ
ふがいないなあ　ワシ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふぎゃあ
ふがいないなあ　ワシ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DAISUKIM_05_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここで　だれかと　であうのも
あのこの　みちびき　なのかなあ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここで　だれかと　出会うのも
あの子の　導き　なのかなあ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DAISUKIW_04_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら？　おばさんの　あいて？▼
いいわよ！　あたしには
つよい　ポケモンが　いるんですから▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら？　おばさんの　相手？▼
いいわよ！　あたしには
強い　ポケモンが　いるんですから▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DAISUKIW_04_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……そうでした
あのこは　もう　いないのね</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……そうでした
あの子は　もう　いないのね</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DAISUKIW_04_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……あのコの　いばしょは
わたしの　こころの　なか▽
わたしが　しぬまで　ずっと　いっしょ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……あの子の　居場所は
わたしの　心の　中▽
わたしが　死ぬまで　ずっと　一緒</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_GENTLE_07_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しんしの　たしなみ　として
ポケモンを　きそわせますぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>紳士の　たしなみ　として
ポケモンを　競わせますぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_GENTLE_07_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほう！　ほう！　ほう！
なかなか　やりますな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほう！　ほう！　ほう！
なかなか　やりますな！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_GENTLE_07_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　ポケモンとの　まいにちが
とても　たのしかったのです▼
ポケモンも　そう　おもってくれていたら
おはかの　なかでも　さみしくないかも</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　ポケモンとの　毎日が
とても　楽しかったのです▼
ポケモンも　そう　思ってくれていたら
お墓の　中でも　寂しくないかも</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MADAM_06_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あら　おわかい　トレーナーさん
よければ　おあいて　してくださる？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あら　お若い　トレーナーさん
よければ　お相手　してくださる？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MADAM_06_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいごに　あのこの　なまえを
よびそうに　なったわ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最後に　あのこの　名前を
呼びそうに　なったわ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MADAM_06_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いなくなった　ポケモンを
わすれることが　いいことなの？▽
わすれないことが　いいことなの？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いなくなった　ポケモンを
忘れることが　いいことなの？▽
忘れないことが　いいことなの？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_11_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いのち　かがやく　ようすを
ねむれる　たましいに　ささげよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T06:40:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T06:40:55" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>命　輝く　様子を
眠れる　魂に　捧げよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T06:40:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T06:40:55" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_11_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もえさかるような
たましいの　かがやき　だ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>燃え盛るような
魂の　輝き　だ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_11_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここ……　タワーオブヘブンでは
ふしぎと　たたかいたく　なるんだ▼
それが　いきている　ってことかな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:40" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここ……　タワーオブヘブンでは
不思議と　戦いたく　なるんだ▼
それが　生きている　ってことかな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:40" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_12_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいの　おわりが　しりたくて
ここに　いるけれど　ピンとこないけど▽
しょうぶ　すれば　わかるのかな……？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界の　終わりが　知りたくて
ここに　いるけれど　ピンとこないけど▽
勝負すれば　わかるのかな……？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_12_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジ　エンド……
って　わけかな？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジ　エンド……
って　わけかな？</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_12_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとも　ポケモンも……
たとえば　せかい　すらも▽
なくなって　おわり　じゃないんだ▽
ここにいると　そう　かんじる</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人も　ポケモンも……
たとえば　世界すらも▽
なくなって　終わり　じゃないんだ▽
ここにいると　そう　感じる</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPW_10_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんとも　いいようのない
エネルギーが　ながれこんでくる！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんとも　いいようのない
エネルギーが　流れこんでくる！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPW_10_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エネルギーが　ぬけていく……
ふにゃにゃにゃあ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エネルギーが　抜けていく……
ふにゃにゃにゃあ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPW_10_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここに　ねむる　ポケモンの
いろんな　おもいも　エネルギーよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T06:40:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T06:40:55" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここに　眠る　ポケモンの
いろんな　想いも　エネルギーよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T06:40:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T06:40:55" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPW_11_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……まだ　たたかいたい！▼
あたしの　なかに　はいりこんだ
さまよう　たましいが　そういうの！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……まだ　戦いたい！▼
あたしの　中に　入りこんだ
さまよう　魂が　そういうの！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPW_11_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハァハァ……　だれかの
たましいが　ぬけていったわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ハァハァ……　だれかの
たましいが　ぬけていったわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPW_11_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タワーに　いっぱい　つまってる
つたえられない　おもい……▽
きいてあげられたら　いいんだけど</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タワーに　いっぱい　詰まってる
伝えられない　想い……▽
きいてあげられたら　いいんだけど</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_27_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むしポケモンを　あいし
むしとりを　あいする　オレ▼
もちろん　ポケモンしょうぶも
あいしてまーす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>むしポケモンを　愛し
むし捕りを　愛する　オレ▼
もちろん　ポケモン勝負も
愛してまーす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_27_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むしとりなら
ぜったいに　まけないのに！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>むし捕りなら
絶対に　負けないのに！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_27_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュちほうの　むしポケモンを
ぜんぶ　つかまえて▼
むしコレクターの　メダルを　もらう！
それが　おれの　もくひょう　だぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>イッシュ地方の　むしポケモンを
全部　捕まえて▼
むしコレクターの　メダルを　もらう！
それが　おれの　目標だぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_28_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ボクの　ポケモンには
チクリと　いたい　どくが　あるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボクの　ポケモンには
チクリと　痛い　毒が　あるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_28_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やられたーっ！
チクリ　どころじゃ　なかったぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やられたーっ！
チクリ　どころじゃ　なかったぜ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_TANPAN_28_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チクリと　さして
ジワジワ　けずる！▼
テクニカルに　せめる
どくタイプ　かっこいいんだぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チクリと　刺して
ジワジワ　削る！▼
テクニカルに　攻める
どくタイプ　かっこいいんだぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_21_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チェレンせんせいに　ポケモンを
おそわった　あたし　です！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チェレン先生に　ポケモンを
教わった　あたし　です！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_21_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うそー！
チェレンせんせい　より　つよい？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うそー！
チェレン先生より　強い？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MINI_21_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>べんきょう　すれば　するほど
ポケモンのこと　わかっていくでしょ▽
それが　さいきん　たのしすぎるの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勉強すれば　するほど
ポケモンのこと　わかっていくでしょ▽
それが　最近　楽しすぎるの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FUTAGO_08_TRMSG_FIGHT_START_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちからを　あわせて　たたかうの！
なづけて　ダブルパワーよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちからを　あわせて　たたかうの！
なづけて　ダブルパワーよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FUTAGO_08_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シホ『わたしたちより
いきが　あってるの！▼
チホ『あわわわ
まけちゃったよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シホ『わたしたちより
いきが　あってるの！▼
チホ『あわわわ
まけちゃったよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FUTAGO_08_TRMSG_FIGHT_AFTER_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いもうとの　ポケモンの　ことも
きにして　たたかってたの▽
あのね　わたし　おねえさん　なの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いもうとの　ポケモンの　ことも
きにして　たたかってたの▽
あのね　わたし　おねえさん　なの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T03:39:18" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FUTAGO_08_TRMSG_POKE_ONE_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしたち　まだ　ちいさいから
ふたりで　いちにんまえ　なの▼
だから　ポケモンも
２ひき　どうしで　たたかうの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしたち　まだ　ちいさいから
ふたりで　いちにんまえ　なの▼
だから　ポケモンも
２ひき　どうしで　たたかうの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
