	<TextRow
		Label="TRID_KINDERGARTENW_08_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーさん！　あたしが
あいてを　してあげましゅね▼</Text>
			<TextModifiedBy
