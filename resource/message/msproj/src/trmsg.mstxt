			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_25_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひょっとして　きみ
ローテーションバトルの　てんさい！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ひょっとして　きみ
ローテーションバトルの　天才！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_25_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きがむけば　ともだちとも
ローテーションバトルを　してみなよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>気が向けば　友達とも
ローテーションバトルを　してみなよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
