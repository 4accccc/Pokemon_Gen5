	</TextRow>
	<TextRow
		Label="TRID_CLEANING_03_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おお！　たまげた！
わかいのに　たいしたもんだね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おお！　たまげた！
若いのに　たいしたもんだね！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
