				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SOCCER_11_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サッカーボールと
モンスターボール……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:40" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サッカーボールと
モンスターボール……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
