	</TextRow>
	<TextRow
		Label="TRID_ELITEW_36_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっしょに　きたのは
たよりがいの　ある　ポケモンね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>一緒に　来たのは
頼りがいの　ある　ポケモンね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_36_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたし　おもうの！　ひとだけで
できることなんて　しれているけど▼
ポケモンと　いっしょなら
できることは　たくさん　あるよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたし　思うの！　人だけで
できることなんて　しれているけど▼
ポケモンと　一緒なら
できることは　たくさん　あるよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T07:12:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_14_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゴーストポケモンが　ささやくのさ……
きみは　ただもの　じゃないって▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ゴーストポケモンが　ささやくのさ……
君は　ただ者　じゃないって▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_14_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よかん　てきちゅう！
やはり　ただもの　じゃない</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>予感　的中！
やはり　ただ者　じゃない</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ESPM_14_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もしかして　きみと　ポケモンは
つよい　オーラを　だしているのか！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もしかして　君と　ポケモンは
強い　オーラを　発しているのか！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-26T09:18:46" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_38_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレは　ポケモンと　いるだけでは
まんぞくは　できない！　かちたい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレは　ポケモンと　いるだけでは
満足は　できない！　勝ちたい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_38_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>クッ！　まさかまさかの
だいはいぼく　だ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>クッ！　まさかまさかの
大敗北だ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_38_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレは　ポケモンと　いるだけでは
まんぞくは　できない！　かちたい！▼
だが　ポケモンと　いるだけで
やすらぐ　ひとが　いるのも　しってるよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレは　ポケモンと　いるだけでは
満足は　できない！　勝ちたい！▼
だが　ポケモンと　いるだけで
安らぐ　人が　いるのも　知ってるよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_37_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしたちの　けっそく
だれにも　まけないんだから！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしたちの　結束
だれにも　負けないんだから！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_37_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かてなかった……
でも　いいのよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝てなかった……
でも　いいのよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_37_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしの　ポケモン
プラズマだんに　うばわれていたの……▼
いま　そばに　いてくれること
とても　ありがたいと　おもってる</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしの　ポケモン
プラズマ団に　奪われていたの……▼
今　そばに　いてくれること
とても　ありがたいと　思ってる</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANW_14_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっと！　そこの
ヤングな　トレーナー！▼
アタシの　じまんの
ポケモンを　みておゆき▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちょっと！　そこの
ヤングな　トレーナー！▼
アタシの　自慢の
ポケモンを　みておゆき▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANW_14_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やるじゃん！
アンタたち　きにいったよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やるじゃん！
アンタたち　気に入ったよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANW_14_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おばちゃん
ポケモンの　じまんを　したいけど▽
ながくなるから　がまんするわ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おばちゃん
ポケモンの　自慢を　したいけど▽
長くなるから　我慢するわ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DOCTOR_07_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしは　ドクター！▼
さあ！　きみの　ポケモンが
かいふくすべきか　みせたまえ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしは　ドクター！▼
さあ！　きみの　ポケモンが
回復すべきか　診せたまえ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DOCTOR_07_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　つよさは　そこしれない！
……かなり　かんどう　したよ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　強さは　底知れない！
……かなり　感動したよ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DOCTOR_07_TRMSG_FIGHT_AFTER_RECOVER_BEFORE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　ポケモンが　げんきでも
わたしは　かいふく　させるぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　ポケモンが　元気でも
わたしは　回復させるぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T12:08:17" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_DOCTOR_07_TRMSG_FIGHT_AFTER_RECOVER_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしが　めざすのは
せかいいちの　ドクター！▼
その　ステップとして　まず
イッシュで　いちばんに　なるつもりだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしが　目指すのは
世界一の　ドクター！▼
その　ステップとして　まず
イッシュで　一番に　なるつもりだ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_39_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みたまえ！　ひかりかがやく
ジムバッジの　かずかずを！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>みたまえ！　光り輝く
ジムバッジの　数々を！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_39_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミの　ポケモンは　まぶしい！
まぶしくて　なにも　みえない！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミの　ポケモンは　まぶしい！
まぶしくて　なにも　みえない！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_39_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミが　もっている　バッジ……▼
いや　ポケモンの　ほうが
まぶしく　かがやいているのか……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミが　持っている　バッジ……▼
いや　ポケモンの　ほうが
まぶしく　輝いているのか……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_38_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　ふんいき　２ねんまえの
あの　トレーナー　みたい……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたの　雰囲気　２年前の
あの　トレーナー　みたい……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T13:12:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_38_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やさしく　きびしい　ところが
あの　トレーナーに　そっくり！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>優しく　厳しい　ところが
あの　トレーナーに　そっくり！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_38_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あの　ポケモントレーナー
いまごろ　どうしてるのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あの　ポケモントレーナー
いまごろ　どうしてるのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_17_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここを　とおるものは　じつに
さまざまな　かおを　しているな！▼
それを　ながめるのは　たのしいし
たたかうのは　もっと　たのしい！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここを　通るものは　実に
さまざまな　顔を　しているな！▼
それを　眺めるのは　楽しいし
戦うのは　もっと　楽しい！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_17_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>むはは！
おもしろいぜ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>むはは！
おもしろいぜ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_17_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうりの　しゅんかん
おまえさんの　ポケモン▽
いい　かお　してたぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝利の　瞬間
おまえさんの　ポケモン▽
いい　表情してたぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANW_15_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いいの？　オバサン　つよいよ？
それでも　あいて　しちゃうの？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いいの？　オバサン　強いよ？
それでも　相手しちゃうの？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANW_15_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いいよ……　オバサン　よわいわよ
なんで　あいて　しちゃったのかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いいよ……　オバサン　弱いわよ
なんで　相手しちゃったのかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANW_15_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよさの　げんかいを　みとめたくない
それだけで　たたかいつづけてるの▽
そうよ　オバサン　しつこいのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強さの　限界を　認めたくない
それだけで　戦いつづけてるの▽
そうよ　オバサン　しつこいのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T06:00:20" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_39_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんきで　ポケモンと
ケンカしちゃう　あたしと▽
ほんきで　むかいあってみない？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本気で　ポケモンと
ケンカしちゃう　あたしと▽
本気で　向かい合ってみない？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_39_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんきで　ひとと　むかいあえば
こんなふうに　きずつくよ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本気で　人と　向かい合えば
こんなふうに　きずつくよ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_39_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんきで　ケンカ　しちゃうのは
ほんきで　つよさを　もとめてるから▼
ぬるい　やさしさは　つみ　だよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本気で　ケンカ　しちゃうのは
本気で　強さを　求めてるから▼
ぬるい　優しさは　罪だよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_KARATE_23_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よし！　おまえなら　おれの　よわさを
うきぼりに　してくれそうだな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よし！　おまえなら　おれの　弱さを
浮き彫りに　してくれそうだな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_KARATE_23_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おのれの　けってんが　みえた！
そこを　なおせば　つよくなれる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>己の　欠点が　みえた！
そこを　直せば　強くなれる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_KARATE_23_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おのれの　よわさを　うけいれる
つよくなるには　まず　そこからだな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>己の　弱さを　受け入れる
強くなるには　まず　そこからだな！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_40_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレが　ほしいのは
つよい　ポケモンだけ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレが　ほしいのは
強い　ポケモンだけ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_40_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なっとく　いかない！
オレの　パートナーが　まけるのか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>納得いかない！
オレの　パートナーが　負けるのか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_40_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレが　ほしいのは
つよい　ポケモンだけ！▼
それを　わかった　ポケモンだけが
オレの　パートナーに　なれる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレが　ほしいのは
強い　ポケモンだけ！▼
それを　わかった　ポケモンだけが
オレの　パートナーに　なれる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BATTLEG_21_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じんせいは　やまを　こえるもの
あなたは　やまに　なれるかしら？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人生は　山を　越えるもの
あなたは　山に　なれるかしら？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BATTLEG_21_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたと　いう　やまを
こえられなかった……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたと　いう　山を
越えられなかった……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BATTLEG_21_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やまは　こえなくても
とおまわり　しても　いいの▼
ここの　のぼれば　トレーナーの　たかみ
ポケモンリーグは　もうすぐです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>山は　越えなくても
遠回り　しても　いいの▼
ここの　登れば　トレーナーの　高み
ポケモンリーグは　もうすぐです</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_41_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１＝キミは　ポケモントレーナー
２＝ボクは　エリートトレーナー▼
１と２から　ボクたちが
しょうぶするのは　きまり　だよね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１＝キミは　ポケモントレーナー
２＝ボクは　エリートトレーナー▼
１と２から　ボクたちが
勝負するのは　決まり　だよね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_41_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１＝キミは　かった！
２＝ボクは　まけた……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１＝キミは　勝った！
２＝ボクは　負けた……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEM_41_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１＝ボクは　つよい
２＝キミは　もっと　つよい▼
１と２から　キミは　ボクよりも
つよい　ポケモントレーナー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>１＝ボクは　強い
２＝キミは　もっと　強い▼
１と２から　キミは　ボクよりも
強い　ポケモントレーナー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T09:36:43" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_40_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしは　しょうりすることで
ポケモンへの　あいを　しめしたいの！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしは　勝利することで
ポケモンへの　愛を　示したいの！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_40_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけちゃったら　ポケモンへの
あいじょうを　しめせない！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けちゃったら　ポケモンへの
愛情を　示ない！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_ELITEW_40_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたし……　かつこと　いがいに
ポケモンへの　かんしゃを　いえないの▼
どうしたら　いいのかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたし……　勝つこと　以外に
ポケモンへの　感謝を　いえないの▼
どうしたら　いいのかしら？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_18_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かった　まけたの　くりかえし……
これからも　そうなのか？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝った　負けたの　繰り返し……
これからも　そうなのか？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_18_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　しょうりも　はいぼくも
だいじな　おもいでに　なるんだな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんな　勝利も　敗北も
大事な　思い出に　なるんだな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_18_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わかい　きみたちと　たたかい
なんだか　わかがえったようだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>若い　君たちと　戦い
なんだか　若返ったようだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERM_29_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミも　キミの　ポケモンも
シビれさせて　やるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミも　キミの　ポケモンも
シビれさせて　やるぜ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERM_29_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まさか……！
シビれさせられる　とはな……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まさか……！
シビれさせられる　とはな……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERM_29_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<LanguageCell
			Language="JPN">
			<Text>シビれたときは
こいつに　かぎるぜ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シビれたときは
こいつに　かぎるぜ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERM_29_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>パワーあふれる　たたかいかたも
テクニカルな　せんりゃくも▽
ポケモン　ありき　なんだよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>パワーあふれる　戦いかたも
テクニカルな　戦略も▽
ポケモン　ありき　なんだよね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERW_29_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あつい　しょうぶも　いいけれど
ヒートアップ　しすぎると　やけどよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>熱い　勝負も　いいけれど
ヒートアップ　しすぎると　やけどよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERW_29_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごい……
アタシが　やけどしそう</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-07T07:04:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-07T07:04:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごい……
アタシが　やけどしそう</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-07T07:04:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-07T07:04:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERW_29_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<LanguageCell
			Language="JPN">
			<Text>やけどに　なった　ときは
これを　つかいな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やけどに　なった　ときは
これを　使いな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-14T09:51:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERW_29_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>あつい　とうそうしんと
れいせいな　はんだんりょく▼
ポケモンリーグに　いどむためには
どっちも　かかせないね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>熱い　闘争心と
冷静な　判断力▼
ポケモンリーグに　挑むためには
どっちも　欠かせないね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_21_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いま　かんじたのは　つよき　かぜ……
それを　はこんできたのは　きみ……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いま　感じたのは　強き　風……
それを　運んできたのは　きみ……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_21_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　はいぼくも
とおくへ　とんでゆけ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この敗北も
遠くへ　飛んでゆけ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_21_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみは　かぜ　だな▼
チャンピオンロードを　ふきぬける
しなやかで　ここちよい　かぜだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみは　風だな▼
チャンピオンロードを　吹き抜ける
しなやかで　心地よい　風だ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_22_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたし……▼
もとプラズマだん！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたし……▼
元プラズマ団！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_22_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひゃー！　２ねんまえの
あの　トレーナー　みたいね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ひゃー！　２年前の
あの　トレーナー　みたいね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_22_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよくても　ポケモンを
あいしていない　ひとも　いる▼
よわい　ポケモンでも
いとおしく　おもう　ひとも　いるよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強くても　ポケモンを
愛していない　人も　いる▼
弱い　ポケモンでも
愛おしく　思う　人も　いるよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T05:59:41" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_19_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わざわざ　ここまで　くるとは……▼
よろしい！　そなたの　くろうに
ぜんりょくで　こたえると　しよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わざわざ　ここまで　来るとは……▼
よろしい！　そなたの　苦労に
全力で　応えると　しよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_19_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いい　トレーナーとの　たたかいは
こころを　あたたかく　みたしてくれる</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いい　トレーナーとの　戦いは
心を　暖かく　満たしてくれる</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANM_19_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そなたが　ここに　これたのは……▼
そう！　ひでんわざを　つかい
はこんでくれた　ポケモンの　おかげだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そなたが　ここに　これたのは……▼
そう！　秘伝技を　使い
運んでくれた　ポケモンの　おかげだ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANW_16_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねっ！　せっかく　きたんだ
おばちゃんの　あいてを　してよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねっ！　せっかく　来たんだ
おばちゃんの　相手を　してよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANW_16_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あんがとね
たのしかったよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あんがとね
楽しかったよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T04:02:59" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_VETERANW_16_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンが　あたしを　のせて
なみのり　たきのぼり……▽
せなかから　あいじょう　つたわるよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンが　あたしを　乗せて
なみのり　たきのぼり……▽
背中から　愛情　伝わるよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T13:25:51" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
