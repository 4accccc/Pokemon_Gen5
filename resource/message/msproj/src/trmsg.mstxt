				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_CHILDCARE_11_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>こどもも　ポケモンも　すきだけど
あたし　やさしく　ないんだからね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こどもも　ポケモンも　好きだけど
あたし　優しく　ないんだからね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-01T03:41:59" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_KINDERGARTENM_12_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>おまえ！
おれに　まけて　なけ！▼</Text>
