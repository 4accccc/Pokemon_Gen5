			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWCHAMPION_03_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　いたみ……
あたしも　おなじように　かんじる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンの　痛み……
あたしも　同じように　感じる！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWCHAMPION_03_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>こころ　とぎすまし
ポケモンと　ひとつに！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>心　研ぎ澄まし
ポケモンと　ひとつに！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWCHAMPION_03_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>マダよ！　マダマダッ！！
マダ　あたしたち　たたかえる！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マダよ！　マダマダッ！！
マダ　あたしたち　戦える！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWCHAMPION_03_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ふわあああ……
ちからを　だしきったのに……▽
まけちゃったんだ　あたしたち！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふわあああ……
全力を　だしきったのに……▽
負けちゃったんだ　あたしたち！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
		</LanguageCell>
	</TextRow>
