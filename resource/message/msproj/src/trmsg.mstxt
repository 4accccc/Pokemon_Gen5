				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERM_24_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うけとれ！
だいちの　エネルギー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>受け取れ！
大地の　エネルギー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-21T06:57:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
