	<TextRow
		Label="TRID_FUTAGO_07_TRMSG_FIGHT_AFTER_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんなに　そっくり　なのに
おとうさん　おかあさんは▽
サヤと　サヨを　まちがえないんだよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
