		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_MOUNT_15_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……！</Text>
			<TextModifiedBy
