			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_WAITRESS_03_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しあい　おうえんしてると
のどが　かわくわよね！▼
おねえさんに　かったら
ドリンク　サービスしちゃう！▼</Text>
			<TextModifiedBy
