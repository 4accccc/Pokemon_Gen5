	</TextRow>
	<TextRow
		Label="TRID_SWCHAMPION_04_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ふわあああ……
ちからを　だしきったのに……▽
かてなかった……▼
ありがと！　あたしたち
もっともっと　うえを　めざすから！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふわあああ……
全力を　だしきったのに……▽
勝てなかった……▼
ありがと！　あたしたち
もっともっと　上を　めざすから！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T03:57:14" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_40_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>くせもの　め！
まちぶせで　ござる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>曲者め！
待ち伏せで　ござる！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_40_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>む　むねん……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>む　無念……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_40_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>しからば　ごめん！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>然らば御免！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_17_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>オホホッ！
まちぶせ　しちゃった！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オホホッ！
待ち伏せ　しちゃった！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_17_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>まけちゃった！
ちがう！　プラーズマー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けちゃった！
ちがう！　プラーズマー！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_17_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>まけろ！　まけちゃいなよ！
あんたなんか　まけてしまいなさいよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けろ！　負けちゃいなよ！
あんたなんか　負けてしまいなさいよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_41_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>しんにゅうしゃ　め！
おほしさまに　なっちまいな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>侵入者め！
お星さまに　なっちまいな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_41_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>オレは……　プラズマの
ほしにも　なれないのか……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレは……　プラズマの
星にも　なれないのか……？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_41_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ギンガだんが　かいさんし……▼
わざわざ　イッシュまで　やってきて
プラズマだんに　はいったのに……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ギンガ団が　解散し……▼
わざわざ　イッシュまで　やってきて
プラズマ団に　はいったのに……！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_18_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>なんだい……？　プラズマだんの
クイーン　とよばれる　アタシに▽
かてると　おもってんの？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんだい……？　プラズマ団の
クイーン　と呼ばれる　アタシに▽
勝てると　思ってんの？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_18_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>アンタの　その　かお……
ほんと　ムカつくわね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アンタの　その顔……
ほんと　ムカつくわね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_18_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>アタシはね　せかいせいふくを　して
Ｎって　やろうを　いためるのさ！▼
あの　うらぎりもの……
すかした　かおが　ムカつくんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アタシはね　世界征服を　して
Ｎって　野郎を　痛めるのさ！▼
あの　裏切り者……
すかした　顔が　ムカつくんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_DOCTOR_11_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだんが　せかいせいふく　すれば
きずつく　ポケモンは　へるだろう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマ団が　世界征服すれば
傷つく　ポケモンは　減るだろう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_DOCTOR_11_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>ぐぬぬ……　おしえてくれ！
ポケモンしょうぶ　とは　なんだ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぐぬぬ……　教えてくれ！
ポケモン勝負とは　なんだ？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_DOCTOR_11_TRMSG_FIGHT_AFTER_RECOVER_BEFORE">
		<LanguageCell
			Language="JPN">
			<Text>きずついた　ポケモンに
てきも　みかたも　あるもんか！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>傷ついた　ポケモンに
敵も　味方も　あるもんか！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_DOCTOR_11_TRMSG_FIGHT_AFTER_RECOVER_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだんが　せかいせいふく　すれば
あらそいは　なくなると　おもわないか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマ団が　世界征服すれば
争いは　なくなると　思わないか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T05:40:39" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_42_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>なあなあ！
しんにゅうしゃって　しらない？▼
って　おまえ！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なあなあ！
侵入者って　知らない？▼
って　おまえ！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_42_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>プラズマフリゲートに　しのびこむとは
なんと　だいたんな　トレーナーめ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマフリゲートに　忍び込むとは
なんと　大胆な　トレーナーめ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_42_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>プラズマフリゲートを　つくった
かがくりょくに　びびって　かえれよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマフリゲートを　造った
科学力に　びびって　帰れよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-14T09:40:00" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_37_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>おまえら！　ポケモンが　いるからって
ずに　のるなよ！▼
おれたちにも　ポケモンが　いるんだ！
あちこちから　うばった　ポケモンが！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえら！　ポケモンが　いるからって
図に　乗るなよ！▼
おれたちにも　ポケモンが　いるんだ！
あちこちから　奪った　ポケモンが！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_37_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>おまえと　おれの　ポケモン！
なにが　ちがうってんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえと　おれの　ポケモン！
なにが　違うってんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_37_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>なんなんだよ！　たった　ふたりで
はむかうとか　おかしいだろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんなんだよ！　たった　二人で
刃向かうとか　おかしいだろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_38_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>プラズマフリゲートの
ギミックに　いらついてるんだろ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマフリゲートの
ギミックに　いらついてるんだろ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_38_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>むきー！
めちゃくちゃ　いらつくぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>むきー！
めちゃくちゃ　いらつくぜ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_38_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>プラズマフリゲートの　ギミックに
おかねを　かけすぎたせいで▽
まいにち　パンしか　くえないんだぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマフリゲートの　ギミックに
お金を　かけすぎたせいで▽
毎日　パンしか　食えないんだぞ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-16T05:55:45" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_39_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>ファイティング　スイーパー！
おまえという　ゴミを　そうじ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ファイティング　スイーパー！
おまえという　ゴミを　掃除！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-21T06:23:20" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_39_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>しくじったか……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しくじったか……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAM_39_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>しんにゅうを　ゆるしたことで
ポケモンを　とりあげられるだろう……▼
２ねんまえの　さくせんで　なかまも
うばった　ポケモンも　へったからな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>侵入を　許したことで
ポケモンを　取りあげられるだろう……▼
２年前の　作戦で　同士も
奪った　ポケモンも　減ったからな</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_14_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>プラズマだんの　レパルダス！　と
よばれる　この　アタシ！▽
きづかれずに　アンタを　たおす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プラズマ団の　レパルダス！　と
呼ばれる　この　アタシ！▽
気づかれずに　アンタを　倒す！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_14_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>あなたたちは　１００パーセント
パーフェクトに　しんにゅうしゃ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたたちは　１００パーセント
パーフェクトに　侵入者！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_14_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>アタシはね　せかいせいふくを　して
Ｎって　やろうを　いためるのさ！▼
あの　うらぎりもの……
すかした　かおが　ムカつくんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アタシはね　世界征服を　して
Ｎって　野郎を　痛めるのさ！▼
あの　裏切り者……
すかした　顔が　ムカつくんだよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_15_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>さきに　いっておくわ！
プラーズマー！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>先に　いっておくわ！
プラーズマー！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_15_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>やりなおし！
やりなおし　させてよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やりなおし！
やりなおし　させてよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_15_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンなんか
あたしたちの　マリオネット！▼
モンスターボールで　しばられ
あやつられるだけ　なのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンなんか
あたしたちの　マリオネット▼
モンスターボールで　縛られ
操られるだけ　なのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_16_TRMSG_FIGHT_START">
		<LanguageCell
			Language="JPN">
			<Text>ここは　あたしたちの　ばしょ！
だれにも　あらさせないよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここは　あたしたちの　場所！
だれにも　荒らさせないよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_16_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>あー！　いまの　ドタバタで
ゆかが　ドロドロじゃない！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あー！　今の　ドタバタで
床が　ドロドロじゃない！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T09:45:44" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWPLAZMAW_16_TRMSG_FIGHT_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>なによ！　ここでしか　いきられない
にんげん　だって　いるのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なによ！　ここでしか　生きられない
人間だって　いるのよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T08:34:43" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWBOSS_2_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<LanguageCell
			Language="JPN">
			<Text>さあ！　わたくしを
まんぞく　させるのです！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さあ！　わたくしを
満足させるのです！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWBOSS_2_01_TRMSG_FIGHT_POKE_LAST">
		<LanguageCell
			Language="JPN">
			<Text>よろしい！　では　わたくしも
ポケモンを　しんじましょう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よろしい！　では　わたくしも
ポケモンを　信じましょう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWBOSS_2_01_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>もっと！　もっと　しんじれば
ポケモンの　ちからを　ひきだせるか！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もっと！　もっと　信じれば
ポケモンの　力を　ひきだせるか！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_SWBOSS_2_01_TRMSG_FIGHT_LOSE">
		<LanguageCell
			Language="JPN">
			<Text>きずな……
みえないものこそ　しんじつか？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きずな……
みえないものこそ　真実か？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-17T07:38:34" />
		</LanguageCell>
	</TextRow>
</MessageStudioText>