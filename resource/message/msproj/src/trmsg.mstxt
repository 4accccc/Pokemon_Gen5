	</TextRow>
	<TextRow
		Label="TRID_FANM_04_TRMSG_FIGHT_START_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みよ！　おれの
かれいなる　オフェンスッ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
