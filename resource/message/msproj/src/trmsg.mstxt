			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しびれる　強さね！
ビリッと　きたわ……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERW_13_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　きのみ
ポケモンに　もたせてあげな！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　きのみ
ポケモンに　持たせてあげな！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RANGERW_13_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<LanguageCell
			Language="JPN">
			<Text>クラボのみを　もってる　ポケモンは
まひに　なっちゃったとき▽
じぶんで　たべて　なおすんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>クラボのみを　持ってる　ポケモンは
まひに　なっちゃったとき▽
自分で　食べて　治すんだよ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-26T05:14:28" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_FANM_12_TRMSG_FIGHT_START_1">
		<LanguageCell
			Language="JPN">
			<Text>よーし！
あしたは　ホームランだね！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よーし！
明日は　ホームランだね！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-24T04:09:06" />
		</LanguageCell>
	</TextRow>
	<TextRow
		Label="TRID_FANM_12_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シゲ『サヨナラ　まけッス……▼
ヒデ『きみの　かちッス……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シゲ『サヨナラ　負けッス……▼
ヒデ『きみの　勝ちッス……</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FANM_12_TRMSG_FIGHT_AFTER_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>キミの　ポケモン
さんびょうし　そろっているッス！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>キミの　ポケモン
三拍子　そろっているッス！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FANM_12_TRMSG_POKE_ONE_1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たたかえる　ポケモンが　１ひき？
なかまと　いると　たのしいッスよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>戦える　ポケモンが　１匹？
仲間と　いると　楽しいッスよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FANM_12_TRMSG_FIGHT_START_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やきゅうと　ポケモンは
すじがきの　ない　ドラマ　ッス！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>野球と　ポケモンは
筋書きの　ない　ドラマ　ッス！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FANM_12_TRMSG_FIGHT_AFTER_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やきゅうせんしゅの　さんびょうしは
うって　まもって　はしって　ッス！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>野球選手の　三拍子は
打って　守って　走って　ッス！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_FANM_12_TRMSG_POKE_ONE_2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>スポーツマンシップから　みて
２ｖｓ１じゃあ　キミが　ふりだよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>スポーツマンシップから　みて
２ｖｓ１じゃあ　キミが　不利だよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_19_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>だいとかいの　そばに　ひっそりと
ひろがる　みどりの　くうかん▼
まさに　オアシス！　いやされた
ぼくが　ねがうのは　しょうぶかな？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大都会の　そばに　ひっそりと
広がる　緑の　空間▼
まさに　オアシス！　癒された
ぼくが　願うのは　勝負かな？▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_19_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんな　けっか　じゃ！
オアシスって　かんじ　しない！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんな　結果じゃ！
オアシスって　感じ　しない！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERM_19_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　オアシスで　おおきな　いわは
かいりきって　ひでんの　わざで▽
おせるなー　って　おもってたんだ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　オアシスで　大きな　岩は
かいりきって　秘伝の　技で▽
押せるなー　って　思ってたんだ</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_15_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とかいの　ポケモン
もりで　くらす　ポケモン……▽
どっちの　ポケモンが　すき？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>都会の　ポケモン
森で　暮らす　ポケモン……▽
どっちの　ポケモンが　好き？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T12:15:27" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_15_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どっちの　ポケモンも　すきだけど
まけるのは　すきじゃないわ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どっちの　ポケモンも　好きだけど
負けるのは　好きじゃないわ！！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_BACKPACKERW_15_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとも　ポケモンも　それぞれ
すみやすい　ばしょは　ちがうでしょ▼
わたしの　すみやすい　ばしょは
もちろん　ふとんの　なかよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人も　ポケモンも　それぞれ
すみやすい　場所は　違うでしょ▼
わたしの　すみやすい　場所は
もちろん　布団の　中よ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-28T04:00:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RAIL_02_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>でんしゃの　なまえは　しょうぶ！
これより　はっしゃ　いたします！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>電車の　名前は　勝負！
これより　発車いたします！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RAIL_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみは　ノンストップとっきゅう！
わたしは　かくえきていしゃ……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみは　ノンストップ特急！
わたしは　各駅停車……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_RAIL_02_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バトルサブウェイには　のりましたか？
ライモンシティに　あるんですけど▼
ユニークな　トレーナーたちと
たたかえて　エキサイティング　です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バトルサブウェイには　乗りましたか？
ライモンシティに　あるんですけど▼
ユニークな　トレーナーたちと
戦えて　エキサイティング　です</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_CYCLINGM_02_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じてんしゃに　のってるほうが
なんとなく　てごわそうだろ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じてんしゃに　乗ってる方が
なんとなく　手強そうだろ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_CYCLINGM_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここちよい　かぜが　とまった……！
じてんしゃも　とまった……！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>心地よい風が　負けを運ぶ
……いま　とまっているけれど</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_CYCLINGM_02_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サイクリングも　スポーツ！
マナーを　まもって　あんぜんうんてん！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サイクリングも　スポーツ！
マナーを　守って　安全運転！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_CYCLINGW_02_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チャリンチャリン♪
スピードに　のった　アタックよ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チャリンチャリン♪
スピードに　乗った　アタックよ！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_CYCLINGW_02_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>チャリンチャリン♪
チャリン♪　チャリンチャリン♪　</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>チャリンチャリン♪
チャリン♪　チャリンチャリン♪　</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_CYCLINGW_02_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じてんしゃに　のると
はやく　ながれていく　けしき▽
いつもと　ちがって　ワクワクする！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じてんしゃに　乗ると
速く　流れていく　景色▽
いつもと　違って　ワクワクする！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-22T12:01:49" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTM_14_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんがえていることが　つうようするか
ためすのも　サイエンス！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>考えていることが　通用するか
試すのも　サイエンス！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTM_14_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　じょうきょうを
ぶんせき　するのが　サイエンス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この状況を
分析するのが　サイエンス</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTM_14_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このまえの　やりかたが
また　つうようするとは　かぎらない▼
いつも　トライ　アンド　エラー
それが　サイエンスかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>以前の　やりかたが
また　通用するとは　限らない▼
いつも　トライ　アンド　エラー
それが　サイエンスかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-24T08:01:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTW_10_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーと　ポケモンの　かんけい！
その　メカニズムを　ときあかすわ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T06:20:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T06:20:10" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーと　ポケモンの　関係！
その　メカニズムを　解明するわ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T06:20:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-09T06:20:10" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTW_10_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なぜ　ポケモンは　トレーナーの
めいれいを　りかい　できるの？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なぜ　ポケモンは　トレーナーの
命令を　理解できるの？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T03:54:03" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCIENTISTW_10_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンが　しんかする　メカニズム▼
シンオウちほうの　ナナカマドはかせは
その　ひみつを　ときあかせたのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンが　進化する　メカニズム▼
シンオウ地方の　ナナカマド博士は
その　秘密を　解き明かせたのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLB_12_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくにとって　たたかいは
まなびの　ばしょ　なんです！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくにとって　戦いは
学びの　場所なんです！▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLB_12_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まっ　まってください！
いまの　まけを　ぶんせき　しないと！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>待っ　待ってください！
今の　負けを　分析しないと！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLB_12_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけることで　じぶんの　いまの
つよさが　みえてくるんです！　フフン！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けることで　自分の　今の
強さが　みえてくるんです！　フフン！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLG_10_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンの　けいけんちを　しらべる
しゅくだいを　しているの！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンの　経験値を　調べる
宿題を　しているの！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLG_10_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしが　よそう　していない
わざを　つかわないで　ください！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしが　予想していない
技を　使わないで　ください！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SCHOOLG_10_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へえ！　レベルの　たかい　ポケモンが
レベルの　ひくい　ポケモンを▽
たおしても　えられる▽
けいけんちは　すくないのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>へえ！　レベルの　高い　ポケモンが
レベルの　低い　ポケモンを▽
たおしても　得られる▽
経験値は　少ないのね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-25T12:59:00" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_PARASOL_09_TRMSG_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ザーザー　ふる　あめ♪
ポツポツ　たたかう　ポケモン♪▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ザーザー　降る　雨♪
ポツポツ　戦う　ポケモン♪▼</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
