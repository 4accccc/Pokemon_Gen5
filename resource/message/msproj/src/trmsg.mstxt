	<TextRow
		Label="TRID_SWCHAMPION_04_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<LanguageCell
			Language="JPN">
			<Text>マダよ！　マダマダッ！！
マダ　あたしたち　たたかえる！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
