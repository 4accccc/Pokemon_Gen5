		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWCHAMPION_01_TRMSG_FIGHT_POKE_LAST"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こころ　とぎすまし
ポケモンと　ひとつに！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>心　研ぎ澄まし
ポケモンと　ひとつに！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWCHAMPION_01_TRMSG_FIGHT_POKE_LAST_HP_HALF"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マダよ！　マダマダッ！！
マダ　あたしたち　たたかえる！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マダよ！　マダマダッ！！
マダ　あたしたち　戦える！！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T01:58:50" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:30" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TRID_SWCHAMPION_01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふわあああ……
ちからを　だしきったのに……▽
まけちゃったんだ　あたしたち！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふわあああ……
全力を　だしきったのに……▽
負けちゃったんだ　あたしたち！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
		</LanguageCell>
