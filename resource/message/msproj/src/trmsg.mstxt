	<TextRow
		Label="TRID_CLEANING_03_TRMSG_FIGHT_AFTER"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくじょうや　どうろの　あちこちに
みえないけれど　どうぐが　おちとるよ！</Text>
			<TextModifiedBy
				User="ichiraku_katsuhiko:W00271"
				Time="2011-10-14T02:39:29" />
			<Status>Editing</Status>
