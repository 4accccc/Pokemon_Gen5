	<TextRow
		Label="gtsnego_info_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいての　せんたくを　まっています
しばらく　おまちください……</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
