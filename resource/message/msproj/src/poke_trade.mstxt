				Time="2011-05-20T09:30:23" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="POKETRADE_STR_26"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここまでの　かつやくを
ポケモンレポートに　かきこみますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
