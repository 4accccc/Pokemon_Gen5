	<TextRow
		Label="POKETRADE_STR_97"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こうかんは
キャンセル　されました</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>交換は
キャンセル　されました</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="POKETRADE_STR_98"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そのポケモンを　こうかんすると
ぼうけん　できなくなっちゃうよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
