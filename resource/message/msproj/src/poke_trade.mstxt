		</AttributeCell>
	</TextRow>
	<TextRow
		Label="POKETRADE_STR_24"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しばらく　おまちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しばらく　お待ちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
