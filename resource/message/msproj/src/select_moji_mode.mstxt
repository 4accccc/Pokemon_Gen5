<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="QUESTION_STR1"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もじモードを　えらんでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>文字モードを　選んでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>文字モードで文が変わらないように意図的にひらがな・漢字で同じものにしています</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="QUESTION_STR2"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おとこのこ？　おんなのこ？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>男の子？　女の子？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="QUESTION_STR3"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしんきのう　を　オンにしますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>通信機能をＯＮにしますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="QUESTION_STR4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちゅうい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>注意！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="QUESTION_STR5"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このゲームを　さいだいげんに　たのしむ
ためには　むせんつうしんきのうを
オンに　してください
ひこうきや　びょういんなど
むせんつうしんきのうを　きんしに　している
ばしょでは　オフに　してください
ゲームちゅうの　せっていがめんでも
へんこう　することが　できます　</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>このゲームを　最大限に　楽しむためには
無線通信機能を　ＯＮにしてください
飛行機や　病院など
無線通信を　禁止にしている場所では
ＯＦＦにしてください
ゲーム中の　設定画面でも
変更することが　できます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:23" />
		</AttributeCell>
	</TextRow>
