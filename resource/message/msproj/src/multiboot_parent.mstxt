			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_PAERNT_MOVIE_22"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんそうマシンを　ちゅうししますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
