				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_PAERNT_MOVIE_18"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>セーブに　しっぱいしました
てんそうマシンを　しゅうりょうします▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>セーブに　失敗しました
転送マシンを　終了します▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
