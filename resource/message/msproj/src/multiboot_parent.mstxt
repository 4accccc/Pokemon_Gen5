	</TextRow>
	<TextRow
		Label="MSG_MB_PAERNT_MOVIE_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ボックスに　あきが　ありません！
ボックスを　せいりしてください！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボックスに　空きが　ありません！
ボックスを　整理してください！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
