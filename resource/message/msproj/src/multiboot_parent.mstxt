				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_PAERNT_MOVIE_19"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レポートに　かきこみました▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
