	<TextRow
		Label="MSG_MB_PAERNT_MOVIE_20"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てんそうできる　ものが　
ありませんでした▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>転送できる　ものが　
ありませんでした▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ポケモンもカプセルも無い！</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</CommentCell>
