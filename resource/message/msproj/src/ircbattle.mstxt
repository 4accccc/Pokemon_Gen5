	<TextRow
		Label="IRCBTL_STR_25"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あそぶないようが　ちがったので
さいしょに　もどります</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
