	<TextRow
		Label="IRCBTL_STR_24"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しばらく　おまちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
