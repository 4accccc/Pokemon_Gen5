		Label="IRCBTL_STR_39"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えんもくを　きめた　リーダーと
せきがいせんつうしんを　してください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>演目を　決めた　リーダーと
赤外線通信を　してください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
