	<TextRow
		Label="TM_GUIDE_C02_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１００ねんほどまえの　そうこが
さいりようされ　かっきづく　まち</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
