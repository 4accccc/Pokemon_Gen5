	</TextRow>
	<TextRow
		Label="TM_GUIDE_T05_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てつどうしゃりょうが　せいびされたり
ていはくする　しゃりょうきちの　まち</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鉄道車両が　整備されたり
停泊する　車両基地の　町</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-07-15T02:37:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カナワタウン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TM_GUIDE_BC10_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとがつどい　はってんを　つづける
きんだいてきな　ふんいきの　まち</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人が集い　発展を　続ける
近代的な　雰囲気の　街</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ブラックシティ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TM_PLACE_BC10_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンセンター</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
