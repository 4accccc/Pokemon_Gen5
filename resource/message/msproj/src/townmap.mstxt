				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TM_GUIDE_H06_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいせんたんの　ぎじゅつりょくが
そそぎこまれている　かいていトンネル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T06:59:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
