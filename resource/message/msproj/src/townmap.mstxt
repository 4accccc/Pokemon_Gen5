	<TextRow
		Label="TM_GUIDE_T06_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まちの　はじまりを　つげる
とけいだいが　シンボル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T08:07:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
