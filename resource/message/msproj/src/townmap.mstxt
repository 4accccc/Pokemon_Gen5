	<TextRow
		Label="TM_GUIDE_D20R0501_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こだいの　おうが　ねむると
つたえられる　おおむかしの　はか</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-27T12:35:36" />
