	<TextRow
		Label="TM_GUIDE_T04_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なつは　バカンスの　ひとが　つどい
にぎわう　すなはまの　ひしょち</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夏は　バカンスの人が　集い
にぎわう　砂浜の　避暑地</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
