	<TextRow
		Label="TM_GUIDE_C05_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>イッシュの　げんかんと　よばれ
しなものが　いきかう　みなとまち</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
