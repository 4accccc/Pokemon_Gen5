	<TextRow
		Label="TM_GUIDE_C13_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くもと　けむりに　おおわれがち　だが
まちにくらす　ひとびとは　かっぱつ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T07:59:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>雲と　煙に　覆われがち　だが
街に暮らす　人々は　活発</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T07:59:51" />
			<Status>Editing</Status>
