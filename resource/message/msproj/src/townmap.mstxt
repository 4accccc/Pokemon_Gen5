	<TextRow
		Label="TM_GUIDE_C06_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かっそうろの　そばで　さいばいし
とれた　やさいを　かもつきで　はこぶ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
