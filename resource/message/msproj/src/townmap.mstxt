	</TextRow>
	<TextRow
		Label="TM_GUIDE_C16_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとと　こうりゅうする　ほどに
はってん　していく　おおどおり</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T08:08:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>人と　交流する　ほどに
発展していく　大通り</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T08:08:18" />
