	<TextRow
		Label="TM_GUIDE_T05_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てつどうしゃりょうが　せいびされたり
ていはくする　しゃりょうきちの　まち</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鉄道車両が　整備されたり
停泊する　車両基地の　町</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カナワタウン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
