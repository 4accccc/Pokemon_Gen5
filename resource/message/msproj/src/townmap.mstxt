	<TextRow
		Label="TM_GUIDE_C07_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふゆは　ふりつもる　ゆきにおおわれ
いちめん　ぎんせかいとなる　まち</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
