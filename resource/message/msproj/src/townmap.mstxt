	<TextRow
		Label="TM_GUIDE_C14_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なみまに　うかぶ　たてものが
しまのように　みえる　リゾートシティ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T07:52:56" />
			<Status>Editing</Status>
