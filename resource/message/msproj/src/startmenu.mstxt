	<TextRow
		Label="START_MENU_STR_ATTENTION_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちゅうい！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
