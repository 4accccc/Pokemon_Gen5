	</TextRow>
	<TextRow
		Label="START_MENU_STR_CONTINUE_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｃギアの　きのうが
せいげんされますが　よろしいですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ｃ－ＧＥＡＲの　機能が
制限されますが　よろしいですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>通信機能許可で「いいえ」を
選択したときの再確認メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="START_MENU_LOAD_WARNING_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レポートの　ないようが
きえてしまった！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レポートの　内容が
消えてしまった！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>セーブデータが破損していた場合、
タイトル画面から暗転し、
ブルーバックでメッセージ表示</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="START_MENU_LOAD_WARNING_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きえて　しまった　バトルビデオの
きろくが　あります！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>消えてしまった　バトルビデオの
記録が　あります！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
