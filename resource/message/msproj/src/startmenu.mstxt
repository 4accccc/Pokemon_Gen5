	<TextRow
		Label="START_MENU_STR_CONTINUE_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしんを　はじめますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
