<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="MSG_MB_DC_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ロードちゅう……
しばらく　おまちください</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ロード中……
しばらく　お待ちください</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_DC_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ただしい　ソフトが　ささっていません
でんげんをきり　ただしい　ソフトを
さしてから　データコンバートを
きどうしなおして　ください</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:37:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正しい　ソフトが　ささっていません
電源を切り　正しい　ソフトを
さしてから　データコンバートを
起動し直してください</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:37:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_DC_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>データコンバートを　しゅうりょうします
でんげんを　きって
しゅうりょうしてください</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:37:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>データコンバートを　終了します
電源を切って
終了してください</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:37:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_DC_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>データの　よみこみに
しっぱい　しました
データコンバートを　しゅうりょうします</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:37:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>データの読み込みに　失敗しました
データコンバートを　終了します</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:37:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初期ロード失敗</Comment>
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_DC_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もう１つの　ＤＳの
せつぞくに　しっぱい　しました
データコンバートを　しゅうりょうします</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:40:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もう１つの　ＤＳの
接続に　失敗しました
データコンバートを　終了します</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:40:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>初期接続タイムアウト</Comment>
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_DC_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>データコンバート　きどうちゅう！
セーブデータをコンバートしています
このまま　しばらく　おまちください</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:38:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>データコンバート　起動中！
セーブデータをコンバートしています
このまま　しばらく　お待ちください</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T05:38:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_DC_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レポートを　よみこむことが
できませんでした
レポートが　かかれていないか
こわれている　かのうせいがあります</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レポートを　読み込むことが
できませんでした
レポートが　書かれていないか
壊れている　可能性があります</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment />
			<CommentModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T06:28:46" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="nagihashi_toru:W00268"
				Time="2011-07-19T03:44:30" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
