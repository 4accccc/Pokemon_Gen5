	<TextRow
		Label="MSG_MB_MOVIE_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ロードちゅう……
しばらく　おまちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ロード中……
しばらく　お待ちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_MOVIE_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ただしい　ソフトが　ささっていません
でんげんをきり　ただしい　ソフトを
さしてから　てんそうマシンを
きどうしなおして　ください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>正しい　ソフトが　ささっていません
電源を切り　正しい　ソフトを
さしてから　転送マシンを
起動し直してください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffffff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_MOVIE_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レポートに　かきこんでいます
でんげんを　きらないでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レポートに　書き込んでいます
電源を　切らないでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MSG_MB_MOVIE_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レポートに　かきこみました[Ctrl2:WaitOne frame="60"]</Text>
			<TextModifiedBy
