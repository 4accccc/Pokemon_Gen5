				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>Hozumi追加0612
Ariizumi0612修正</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>208</Text>
			<TextModifiedBy
