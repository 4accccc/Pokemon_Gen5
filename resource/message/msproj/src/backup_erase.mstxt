<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すべての　セーブデータエリアを
しょうきょ　しますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>全ての　セーブデータエリアを
消去しますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうきょした　データは
もとに　もどせません▼
それでも　セーブデータエリアを
しょうきょ　しますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>消去した　データは
元に　もどせません▼
それでも　セーブデータエリアを
消去しますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="msg03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうきょ　しています
しばらく　おまちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>消去しています
しばらく　お待ちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>