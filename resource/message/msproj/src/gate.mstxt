	<TextRow
		Label="msg_gate_st_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇はまべのすなは とてもこまかく あしあとがハッキリと のこります</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
