	<TextRow
		Label="msg_gate_common_cm_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇「あいじょういっぱい！　すくすくそだつ！」３ばんどうろ　そだてや</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>◇「愛情いっぱい！　すくすく育つ！」3番道路　育て屋</Text>
