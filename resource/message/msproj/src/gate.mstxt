	<TextRow
		Label="msg_gate_c1_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇トレーナーズスクールでは　ポケモンのきそから　まなべます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
