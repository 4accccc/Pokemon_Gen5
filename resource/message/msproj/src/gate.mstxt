	<TextRow
		Label="msg_gate_c5_09"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇ホドモエシティは　みずべにりんせつする　みなとまちです</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
