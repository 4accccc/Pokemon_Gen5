			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_gate_c3_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇せかいじゅうの げいじゅつかが ヒウンシティで ギャラリーを ひらいています</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>◇世界中の　芸術家が　ヒウンシティで　ギャラリーを　開いています</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
