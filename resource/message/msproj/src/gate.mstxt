				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_gate_wf_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇しぜんにひかれた　ブリーダーが　おおくあつまっています</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>◇自然にひかれた　ブリーダーが　多く集まっています</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
