	<TextRow
		Label="msg_gate_c4_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇ねつれつなバトルずきが　てつどうずきだったため　バトルサブウェイが　できたといわれています</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
