	<TextRow
		Label="msg_gate_c1_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇みどりゆたかなていえんが　こころを　あたたかく　させてくれます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
