	<TextRow
		Label="msg_gate_st_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇サザナミタウンの うみでは　たびたび きちょうな いせきが みつかるそうです</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
