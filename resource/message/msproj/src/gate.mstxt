	<TextRow
		Label="msg_gate_wf_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇ゆたかなしぜんのおかげで　めずらしいポケモンが　みられます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>◇豊かな自然のおかげで　珍しいポケモンが　見られます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
