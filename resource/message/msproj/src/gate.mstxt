	<TextRow
		Label="msg_gate_c8w_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇ビルのそうしょくは １００ねんかけて しょくにんたちのてで　つくられています</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
