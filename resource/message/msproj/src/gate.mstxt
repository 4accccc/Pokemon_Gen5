			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_gate_wf_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇しろのじゅどうに　おおくの　トレーナーが　いどんでいます</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T02:40:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>◇白の樹洞に　多くの　トレーナーが　挑んでいます</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T02:40:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
