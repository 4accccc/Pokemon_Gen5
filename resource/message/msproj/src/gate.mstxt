				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_gate_c1_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇げんかんさきにあるかいだんは　ゆきをさけるためにあります</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
