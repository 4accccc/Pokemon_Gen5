			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_gate_wf_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇まちのひとは　しぜんをあいし　しぜんとともにせいかつしています</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>◇街の人は　自然を愛し　自然と共に生活しています</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
