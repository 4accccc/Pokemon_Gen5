	<TextRow
		Label="msg_gate_c2_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇はくぶつかんのテーマは　ぶんかとしぜんの　たいひです</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
