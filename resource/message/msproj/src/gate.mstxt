			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_gate_c3_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇ヒウンシティの　まちなみは　ひるとよるとで　まるでちがってみえます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>◇ヒウンシティの　街並みは　昼と夜とで　まるで違って見えます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
