		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_gate_c8w_04"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇まちからは まいとし こうこがくしゃが おおく　たんじょうします</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>◇街からは 毎年 考古学者が 多く　誕生します</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
