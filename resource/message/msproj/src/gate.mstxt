				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_gate_d3_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>◇さばくぜんたいに　ふきわたる　すなあらしに　ごちゅういください</Text>
