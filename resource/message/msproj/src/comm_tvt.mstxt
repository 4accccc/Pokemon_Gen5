	<TextRow
		Label="COMM_TVT_GAME_15"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:PMS Idx="0" ]いろの　ふうせんを　タッチして
たくさん　ふうせんを　わろう！
ほかのいろを　わると　げんてんだぞ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
