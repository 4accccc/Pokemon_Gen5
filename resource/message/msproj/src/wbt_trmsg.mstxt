	<TextRow
		Label="TRID_RENT_GSLEADER6_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じつりょくが　あれば　ルールなど
かんけいなし！　いけ　ミカンッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T13:29:27" />
