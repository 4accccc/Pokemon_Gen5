	<TextRow
		Label="TRID_GSCHAMPION_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながれる　いちぞくの　ちが　さけぶ！
ドラゴンつかい　ワタル　けんざんッ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
