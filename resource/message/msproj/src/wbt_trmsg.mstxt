	<TextRow
		Label="TRID_RSLEADER4_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かっ　かてた……！
みがいた　わざが　つうじたのね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-13T13:12:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝っ　勝てた……！
磨いた　技が　通じたのね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-13T13:13:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
