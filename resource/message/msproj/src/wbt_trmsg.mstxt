				Time="2012-01-08T07:05:45" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_BWCHAMPION_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンと　ともにあゆむ……　その
すばらしさを　みなに　つたえておる▼
それには　こうして　まじえるのが
いちばん　いい　やりかた　だろうな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T05:39:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンと　共に歩む……　その
すばらしさを　みなに　伝えておる▼
それには　こうして　交えるのが
一番　いい　やりかた　だろうな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T05:39:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・チャンピオン：アデク
・１回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CHAMPION
アデク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:18:14" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:05:45" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_BWCHAMPION_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　トーナメントで　どちらが
つよい　ポケモントレーナーで　あるか▽
きめるのが　たのしみで　たまらんよ！▼
ポケモントレーナーの
アデク　まいるぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T05:19:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　トーナメントで　どちらが
強い　ポケモントレーナーで　あるか▽
決めるのが　楽しみで　たまらんよ！▼
ポケモントレーナーの
アデク　参るぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T05:19:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・チャンピオン：アデク
・２回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CHAMPION
アデク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:18:16" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:05:45" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_BWCHAMPION_TRMSG_3RD_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーと　あいまみえるとき
どちらが　つよいのか　そうぞうすると▽
むねが　あつくなる▼
そして　じっさいに　たちあうと　その
あつさは　さいこうに　なるよな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T05:37:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナーと　相見えるとき
どちらが　強いのか　想像すると▽
胸が　熱くなる▼
そして　実際に　立ち会うと　その
熱さは　最高に　なるよな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T07:24:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・チャンピオン：アデク
・決勝戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>CHAMPION
アデク</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:18:16" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:05:45" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_BWCHAMPION_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっぱれ！
まさに　てんかむそう　よな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T05:40:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>天晴れ！
まさに　天下無双　よな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T05:40:16" />
