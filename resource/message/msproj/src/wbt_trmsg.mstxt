				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_RENT_SWLEADER5_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どれだけ　つよくなるかは
どれだけ　かちたいと　ねがうか　だ▼
その　よくぼうに　たいしては
どこまでも　ちゅうじつで　いろよな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T13:11:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どれだけ　強くなるかは
どれだけ　勝ちたいと　願うか　だ▼
その欲望に　対しては
どこまでも　忠実で　いろよな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T13:13:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ジムリーダー：ヤーコン
・２回戦用対戦前メッセージ
レンタル用</Comment>
			<CommentModifiedBy
				User="tamada:W00253"
				Time="2011-09-24T06:00:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER5
スワンジムリーダー・ヤーコン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:14:00" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:09:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
