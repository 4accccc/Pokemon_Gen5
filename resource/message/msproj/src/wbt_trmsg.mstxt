	<TextRow
		Label="TRID_RENT_RSLEADER4_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くう……　また
かたに　ちから　はいっちゃって……▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
