	<TextRow
		Label="TRID_SWLEADER2_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いくよ！　あんたの　りせい
ぶっとばして　あ・げ・る！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T03:51:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いくよ！　あんたの　理性
ぶっとばして　あ・げ・る！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T03:51:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ジムリーダー：ホミカ
・１回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
