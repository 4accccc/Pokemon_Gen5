	<TextRow
		Label="TRID_SWLEADER4_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いとしの　ポケモンたちで
あなたを　クラクラ　させちゃうけど▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T03:20:27" />
			<Status>Editing</Status>
