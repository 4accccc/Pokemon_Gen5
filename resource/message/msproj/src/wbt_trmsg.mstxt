				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SWBELL_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふえええ！▼
やっぱり　あなたは
すごく　つよい　トレーナーだよね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-25T10:46:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふえええ！▼
やっぱり　あなたは
すごく　強い　トレーナーだよね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:22:16" />
			<Status>Editing</Status>
