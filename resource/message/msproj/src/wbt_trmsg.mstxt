	</TextRow>
	<TextRow
		Label="TRID_RENT_SWLEADER5_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんたんな　はなしだ！　ワシの
かちたい　きもちが　うわまわったのよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T13:06:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>簡単な　話だ！　ワシの
勝ちたい　気持ちが　上回ったのよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T13:06:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ジムリーダー：ヤーコン
・対戦後　プレイヤー負けメッセージ
レンタル用</Comment>
			<CommentModifiedBy
				User="tamada:W00253"
				Time="2011-09-24T06:00:31" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER5
スワンジムリーダー・ヤーコン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:14:00" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:09:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
