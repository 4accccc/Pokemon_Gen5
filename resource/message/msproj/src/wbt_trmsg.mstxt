	<TextRow
		Label="TRID_RENT_RSLEADER8_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつもと　ちがう　なかまとでも
しょうりを　めざす　ランだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
