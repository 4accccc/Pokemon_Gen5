	<TextRow
		Label="TRID_ESPM01_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うらめしやぁ……ってね！
おばけの　こわさ　あじあわせてやる！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-02T02:17:56" />
			<Status>Editing</Status>
