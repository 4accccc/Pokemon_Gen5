	<TextRow
		Label="TRID_RSCHAMPION_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>デボンコーポレーション　おんぞうし
さすらいの　いしあつめ！　ダイゴッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T07:14:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>デボンコーポレーション　御曹司
さすらいの　石集め　ダイゴッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T07:14:48" />
			<Status>Editing</Status>
