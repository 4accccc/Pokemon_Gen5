				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_RGCHAMPION_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>グリーン『たしかに　おまえは　つよい▼
だがな　うえには　うえが　いるのさ
もっと　しょうじん　すること　だぜ！▼
バイビー！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グリーン『たしかに　おまえは　強い▼
だがな　上には　上が　いるのさ
もっと　精進すること　だぜ！▼
バイビー！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-24T05:22:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
