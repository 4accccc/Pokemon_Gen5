	<TextRow
		Label="TRID_RENT_DPLEADER8_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちっとも　しびれなかった……
オレが　のぞんだ　ものと　ちがう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T06:44:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちっとも　しびれなかった……
オレが　望んだ　ものと　違う！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-18T06:44:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
