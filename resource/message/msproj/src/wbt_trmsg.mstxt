				Time="2011-06-14T12:34:01" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:06:06" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
