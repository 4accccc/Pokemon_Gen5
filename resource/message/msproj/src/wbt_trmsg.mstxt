	<TextRow
		Label="TRID_RENT_GSLEADER9_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつもと　ちがう　なかまとでも
しょうりを　めざす　アンズだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
