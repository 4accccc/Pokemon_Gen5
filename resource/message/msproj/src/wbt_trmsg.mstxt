	<TextRow
		Label="TRID_ESPM01_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ！　きみの　うしろに　おばけが！▼
……なんてね！　きみが　きょうふを
あじわうのは　これからだよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-02T02:21:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あっ！　きみの　後ろに　おばけが！▼
……なんてね！　きみが　恐怖を
味わうのは　これからだよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-02T02:45:25" />
			<Status>Editing</Status>
