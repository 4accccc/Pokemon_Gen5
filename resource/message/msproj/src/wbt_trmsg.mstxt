	<TextRow
		Label="TRID_ASSISTANTM01_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ずいぶん　くるしそうだったね……
ふふっ　いいものが　みられたよ……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T11:24:12" />
