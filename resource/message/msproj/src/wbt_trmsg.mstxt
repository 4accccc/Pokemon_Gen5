	<TextRow
		Label="TRID_RENT_SWBELL_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたと　ポケモンしょうぶ！
なんだか　すっごく　ワクワクする！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:23:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたと　ポケモン勝負！
なんだか　すっごく　ワクワクする！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:23:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ポケモントレーナー：ベル
・１回戦用対戦前メッセージ
レンタル用</Comment>
			<CommentModifiedBy
				User="tamada:W00253"
				Time="2011-09-24T06:01:24" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWBELL
ベル</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:14:54" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:09:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
