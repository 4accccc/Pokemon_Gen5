	<TextRow
		Label="TRID_ELEADER1_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たははは！　アイ　アム　ウィナー！
すなわち　わたしの　かちですな▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
