	<TextRow
		Label="TRID_GSCHAMPION_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　ときも　あきらめない
それは　きみだって　おなじだろ？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
