	<TextRow
		Label="TRID_RENT_SWLEADER2_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じつりょくが　あれば　ルールなど
かんけいなし！　いけ　ホミカッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T13:21:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
