			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_RSCHAMPION_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ダイゴ『じゃあ　ボクは　これで
また　どこかで　あうかもしれないね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
