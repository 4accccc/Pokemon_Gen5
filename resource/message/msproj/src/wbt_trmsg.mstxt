				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_ECHAMPION_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>みずの　イリュージョニスト　ミクリ！
いま　ひのきぶたいに　あらわれるッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-13T12:39:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>水の　イリュージョニスト　ミクリ！
いま　ひのき舞台に　現れるッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-13T12:44:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：アナウンス
・チャンピオン：ミクリ
・前口上メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ECHAMPION
ミクリ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:17:18" />
		</AttributeCell>
