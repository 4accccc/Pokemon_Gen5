	<TextRow
		Label="TRID_VETERANM02_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちゅうとはんぱは　やめろ！
あくに　そまるなら　てっていてきに▽
そまりきってみせるんだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-02T04:32:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>中途半端は　やめろ！
あくに　染まるなら　徹底的に▽
染まりきってみせるんだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-02T06:21:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
