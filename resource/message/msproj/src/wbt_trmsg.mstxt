	<TextRow
		Label="TRID_RENT_SWLEADER8_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おはん　つよそーやね！
ほな　はじめよーかい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:25:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おはん　強そーやね！
ほな　はじめよーかい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:25:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
