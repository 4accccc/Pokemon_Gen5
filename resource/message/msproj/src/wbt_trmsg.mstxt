	<TextRow
		Label="TRID_RENT_SWLEADER4_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おかりした　ポケモンたちで
あなたを　クラクラ　させちゃうけど▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T12:18:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お借りした　ポケモンたちで
あなたを　クラクラ　させちゃうけど▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T12:18:15" />
			<Status>Editing</Status>
