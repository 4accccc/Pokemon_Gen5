	<TextRow
		Label="TRID_FIGHTERW01_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶあり！　うん！
やっぱり　わたしは　つよいね！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
