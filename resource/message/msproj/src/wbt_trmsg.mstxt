	<TextRow
		Label="TRID_FIGHTERM01_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぶどうの　たつじんッ！　アラシヤマ！
きょうてき　もとめて　さんせんだァ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
