		<AttributeCell
			Name="Character">
			<Text>RSLEADER5
センリ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:24:23" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
