	<TextRow
		Label="TRID_BWCHAMPION_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひぼんな　たたかいぶり　だったぞ
きみも！　きみの　ポケモンも！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T05:42:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>非凡な　戦いぶり　だったぞ
きみも！　きみの　ポケモンも！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T05:42:09" />
			<Status>Editing</Status>
