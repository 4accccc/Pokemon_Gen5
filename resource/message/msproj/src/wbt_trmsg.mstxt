				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ffff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER6_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アナタと　たたかえて　アタシ
つよくなれたから……　ありがとうね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T03:12:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アナタと　戦えて　アタシ
強くなれたから……　ありがとうね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T03:12:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
