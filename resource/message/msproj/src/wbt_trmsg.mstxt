				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_RENT_GSLEADER7_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよさが　とわれる　このトーナメント
さあ　どうたたかう　ヤナギよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T13:29:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強さが　問われる　このトーナメント
さあ　どう戦う　ヤナギよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
