	<TextRow
		Label="TRID_SHIRONA_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あーあ！▼
あんなに　たのしい　しょうぶも
かならず　おわってしまうのね……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T04:35:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あーあ！▼
あんなに　楽しい　勝負も
必ず　終わって　しまうのね……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T04:34:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
