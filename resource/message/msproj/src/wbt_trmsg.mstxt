				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_RENT_SWBELL_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベル『あたし　あなたが　する
ポケモンしょうぶ　だいすきだよ▼
なんだか　ポケモンも
とても　うれしそうなんだもん！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:23:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベル『あたし　あなたが　する
ポケモン勝負　大好きだよ▼
なんだか　ポケモンも
とても　うれしそうなんだもん！▼</Text>
