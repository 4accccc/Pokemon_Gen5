	<TextRow
		Label="TRID_SWLEADER8_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シズイ『おはん　つよそーじゃなく
わっせ　つよいんじゃな！▼
おいも　たまげたよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:34:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シズイ『おはん　強そーじゃなく
わっせ　強いんじゃな！▼
おいも　たまげたよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:36:39" />
