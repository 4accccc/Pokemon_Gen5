	<TextRow
		Label="TRID_RENT_DPLEADER6_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　わたし　トウガンが
あいてを　してくれようぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T12:48:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>この　わたし　トウガンが
相手を　してくれようぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T12:52:57" />
