	<TextRow
		Label="TRID_RENT_DPLEADER5_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かったけれど　もっともっと
たたかいたかった　そんな　きぶんだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T07:57:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝ったけれど　もっともっと
戦いたかった　そんな　気分だ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T08:02:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ジムリーダー：マキシ
・対戦後　プレイヤー負けメッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>DPLEADER5
マキシ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T12:33:39" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
