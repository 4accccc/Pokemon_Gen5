	<TextRow
		Label="TRID_RENT_GSLEADER4_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　いっぽ……
みちを　すすむことが　できた▼</Text>
