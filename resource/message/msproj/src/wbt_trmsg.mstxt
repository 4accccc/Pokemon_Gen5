			Name="Character">
			<Text>SWLEADER8
スワンジムリーダー・シズイ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:14:34" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
