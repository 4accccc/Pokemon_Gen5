	<TextRow
		Label="TRID_GSLEADER9_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたいが　アンズ！▼
どくポケモンの　おそろしさ
うけてみると　いいわ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
