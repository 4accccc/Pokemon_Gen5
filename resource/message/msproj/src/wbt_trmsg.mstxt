				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_RSLEADER5_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよさを　おいもとめる　おとこ！
センリ！　その　つよさ　みせつけろ！▼</Text>
			<TextModifiedBy
