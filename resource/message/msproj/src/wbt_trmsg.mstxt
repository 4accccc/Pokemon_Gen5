	<TextRow
		Label="TRID_RENT_RSLEADER6_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ナギ『あなたには　まけました　けど
