	</TextRow>
	<TextRow
		Label="TRID_SWBELL_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どっちの　ポケモンも
すごく　がんばったよね！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T02:33:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どっちの　ポケモンも
すごく　がんばったよね！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T12:14:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
