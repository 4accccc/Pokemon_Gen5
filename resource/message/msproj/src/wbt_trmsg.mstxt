				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_RSLEADER2_TRMSG_3RD_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はげしい　なみに　もまれ……▼
くらい　どうくつで
しゅぎょう　している　ボクの▼
あいてを　しよう　という
キミの　じつりょく……▽
どれほどの　ものか　みせてもらうよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>激しい　波に　もまれ……▼
暗い　洞穴で
修行している　ボクの▼
相手を　しよう　という
キミの　実力……▽
どれほどの　ものか　みせてもらうよ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ジムリーダー：トウキ
・決勝戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RSLEADER2
トウキ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:23:43" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
