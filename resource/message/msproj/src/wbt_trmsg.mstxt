	<TextRow
		Label="TRID_FIGHTERM01_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アラシヤマ『あー！　たのしかった！
ぜひ　また　しあいを　してくれよな！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-05T02:31:12" />
