	<TextRow
		Label="TRID_FIGHTERM01_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アラシヤマ『もっと　つよくなれ！
おれは　いつでも　あいてになるぞ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-02T10:50:55" />
