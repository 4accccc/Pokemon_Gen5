				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER7_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やぶれて　わきあがる
この　あつき　おもい……▽
なんと　いえば　よいのか……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T03:12:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>敗れて　わきあがる
この　熱き　思い……▽
なんと　いえば　よいのか……</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T03:12:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ジムリーダー：シャガ
・対戦後メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER7
スワンジムリーダー・シャガ</Text>
			<TextModifiedBy
