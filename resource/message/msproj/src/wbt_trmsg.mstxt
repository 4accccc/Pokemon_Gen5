	<TextRow
		Label="TRID_RENT_SWLEADER3_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>レンタルした　ポケモンが
たたかいたいって　さわいでさ▼
ではでは
さっそくだけど　しょうぶ　だね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T12:19:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>レンタルした　ポケモンが
戦いたいって　騒いでさ▼
ではでは
さっそくだけど　勝負だね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T12:19:24" />
			<Status>Editing</Status>
