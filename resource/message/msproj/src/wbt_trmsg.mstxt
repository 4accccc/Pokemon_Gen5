	<TextRow
		Label="TRID_TRAINERM02_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょせんから　ぼくと　あたるなんて
うんが　わるい　トレーナーだね！▼</Text>
