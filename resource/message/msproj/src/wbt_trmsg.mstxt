			Language="JPN">
			<Comment>１回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>地面モブトレーナー
山男</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T06:46:23" />
		</AttributeCell>
		<AttributeCell
