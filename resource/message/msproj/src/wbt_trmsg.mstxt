				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER6_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フウロ『ホウエンちほうの
ジムリーダー　ナギさん！▼
あのひとと　おおぞらで　たたかえたら
きっと　たのしいと　おもうの！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:22:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フウロ『ホウエン地方の
ジムリーダー　ナギさん！▼
あの人と　大空で　戦えたら
きっと　楽しいと　思うの！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:20:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ジムリーダー：フウロ
・プレイヤーが負けた場合のメッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER6
スワンジムリーダー・フウロ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:14:11" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:05:45" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
