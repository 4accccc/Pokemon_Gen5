	<TextRow
		Label="TRID_ESPM01_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これが　ほんとうの　きょうふさ！
ひやあせ　たっぷり　かいてくれた？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-02T02:32:47" />
