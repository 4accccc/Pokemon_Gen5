	<TextRow
		Label="TRID_GSLEADER7_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これが　ふゆの　きびしさ　よ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
