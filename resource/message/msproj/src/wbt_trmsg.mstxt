	</TextRow>
	<TextRow
		Label="TRID_RENT_SWLEADER3_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよさが　とわれる　このトーナメント
さあ　どうたたかう　アーティよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T13:21:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>強さが　問われる　このトーナメント
さあ　どう戦う　アーティよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T13:21:53" />
			<Status>Editing</Status>
