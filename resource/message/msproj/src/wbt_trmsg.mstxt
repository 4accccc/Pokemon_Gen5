	<TextRow
		Label="TRID_SWLEADER2_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ダメ　ダメ　ダメ　ダメー！
もっと　じぶんを　さらけださないと▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:16:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ダメ　ダメ　ダメ　ダメー！
もっと　自分を　さらけださないと▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:16:03" />
			<Status>Editing</Status>
