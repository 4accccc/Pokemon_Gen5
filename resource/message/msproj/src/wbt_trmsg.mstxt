				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SHIRONA_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あたしも　すきかも
ここの　ふんいき……▼
たたかおうと　する　ひとが 
どんな　ひとか　つたわってくる……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T04:55:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あたしも　好きかも
ここの　雰囲気……▼
戦おうと　する　人が 
どんな　人か　伝わってくる……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T04:55:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・チャンピオン：シロナ
・１回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SHIRONA
シロナ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:17:50" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SHIRONA_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　かおを　みれば
すぐに　わかるわ▼
どんな　こんなんに　ぶつかっても
ポケモンと　のりこえてきたのね▼
この　シロナ
ぜんりょくで　きみと　たたかいます！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T04:55:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみの　顔を　みれば
すぐに　わかるわ▼
どんな　困難に　ぶつかっても
ポケモンと　乗り越えてきたのね▼
この　シロナ
全力で　きみと　戦います！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T07:19:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・チャンピオン：シロナ
・２回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SHIRONA
シロナ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:17:53" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SHIRONA_TRMSG_3RD_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてが　トレーナーなら
しょうぶすれば　どんなひとか　わかる▼
どんな　ポケモンに
どんな　わざを　おぼえさせているのか▽
どうぐは　なにを　もたせているのか▼
そう！　これからの　じかんに
ことばは　いらないの……！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T03:53:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あいてが　トレーナーなら
勝負すれば　どんな人か　わかる▼
どんな　ポケモンに
どんな　技を　覚えさせているのか▽
道具は　なにを　持たせているのか▼
そう！　これからの　時間に
言葉は　いらないの……！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T03:54:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・チャンピオン：シロナ
・決勝戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SHIRONA
シロナ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:17:53" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SHIRONA_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あーあ！▼
あんなに　たのしい　しょうぶも
かならず　おわってしまうのね……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T04:35:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あーあ！▼
あんなに　楽しい　勝負も
必ず　終わって　しまうのね……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T04:34:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・チャンピオン：シロナ
・対戦後メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SHIRONA
シロナ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:17:53" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SHIRONA_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いまよりも
つよくなるために　ひつようなこと？▼
それは　ずっとずっと
ポケモンを　すきで　いることかな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T04:46:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いまよりも
強くなるために　必要なこと？▼
それは　ずっとずっと
ポケモンを　好きで　いることかな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T04:46:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・チャンピオン：シロナ
・対戦後　プレイヤー負けメッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SHIRONA
シロナ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:17:53" />
		</AttributeCell>
