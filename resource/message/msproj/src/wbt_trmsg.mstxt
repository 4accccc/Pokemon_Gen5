	<TextRow
		Label="TRID_ASSISTANTM01_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしの　どくで　たおれない！？
なんて　じょうぶな　からだなんだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-01T08:19:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしの　毒で　倒れない！？
なんて　じょうぶな　身体なんだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-01T08:36:36" />
			<Status>Editing</Status>
