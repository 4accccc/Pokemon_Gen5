	<TextRow
		Label="TRID_RENT_SWLEADER6_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かっても　まけても
たたかうことで　えること　あるよね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:02:35" />
			<Status>Editing</Status>
