	<TextRow
		Label="TRID_SWLEADER8_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おはんも　つよいが　それでは
うみは　びくとも　せんたい！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:36:07" />
			<Status>Editing</Status>
