	<TextRow
		Label="TRID_FIGHTERW01_TRMSG_3RD_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いままで　つみかさねてきた
きびしい　とっくんが▼
まちがってなかったって
いまここで　しょうめいするわ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-05T03:17:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-22T09:55:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いままで　積み重ねてきた
厳しい　特訓が▼
間違ってなかったって
いまここで　証明するわ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-05T03:31:18" />
			<Status>Editing</Status>
