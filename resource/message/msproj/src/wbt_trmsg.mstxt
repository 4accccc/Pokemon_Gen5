	<TextRow
		Label="TRID_DPLEADER6_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>この　わたし　トウガンが
あいてを　してくれようぞ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T12:48:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
