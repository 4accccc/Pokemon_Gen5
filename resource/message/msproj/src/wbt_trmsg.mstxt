	</TextRow>
	<TextRow
		Label="TRID_MOUNTMAN01_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じめんタイプの　ポケモンのように
この　めぐみの　だいちと　ともに▽
いきていきたいよな！　なっ！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-01T09:12:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>じめんタイプの　ポケモンのように
この　恵みの　大地と　ともに▽
生きていきたいよな！　なっ！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-01T09:51:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>２回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>地面モブトレーナー
山男</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T06:46:28" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:06:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
