			Name="Character">
			<Text>SWLEADER6
スワンジムリーダー・フウロ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:14:11" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
