				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_RSLEADER4_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アスナ『じぶんらしく　することで
ポケモンも　ちからを　だしきれた▼
あたし……　すこしは
せいちょう　できたのかも？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アスナ『自分らしく　することで
ポケモンも　力を　だしきれた▼
あたし……　少しは
成長できたのかも？▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♀
・ジムリーダー：アスナ
・プレイヤーが負けた場合のメッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>RSLEADER4
アスナ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:24:09" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
