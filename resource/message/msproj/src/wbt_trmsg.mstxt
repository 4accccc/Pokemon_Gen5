	<TextRow
		Label="TRID_RENT_SWLEADER7_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ええい！　きみの　じつりょく
そんなものでは　ないだろう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:10:53" />
			<Status>Editing</Status>
