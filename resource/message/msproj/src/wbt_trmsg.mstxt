	<TextRow
		Label="TRID_SWLEADER8_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おはん　つよそーやね！
ほな　はじめよーかい▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:25:10" />
