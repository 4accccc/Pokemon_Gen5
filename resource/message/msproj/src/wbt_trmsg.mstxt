	<TextRow
		Label="TRID_RENT_SWLEADER6_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これから　アタシと
もっと　たのしいこと　しましょう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T11:03:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
