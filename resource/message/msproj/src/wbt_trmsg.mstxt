	<TextRow
		Label="TRID_GSLEADER2_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ツクシ『うわ　すごい！
きみ　ポケモンに　くわしいんだね！▼
あーあ
ぼくの　けんきゅうも　まだまだだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ツクシ『うわ　すごい！
きみ　ポケモンに　詳しいんだね！▼
あーあ
ぼくの　研究も　まだまだだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
