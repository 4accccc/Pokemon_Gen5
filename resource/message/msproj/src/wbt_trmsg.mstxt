	<TextRow
		Label="TRID_GSLEADER1_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ハヤト『……とうさん！▼
とうさんが　たいせつに　していた
ポケモンで　みごと　かったよ！！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
