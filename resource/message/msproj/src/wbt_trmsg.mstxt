			Name="Character">
			<Text>GSLEADER9
アンズ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:22:53" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
