	<TextRow
		Label="TRID_FIGHTERW01_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジェーン『すごいね　あなた！
もっと　しゅぎょうして　いつか▽
おいこして　やるんだから！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-05T09:28:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-09-16T12:32:29" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ジェーン『すごいね　あなた！
もっと　修行して　いつか▽
追い越して　やるんだから！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-05T09:28:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-09-16T12:32:29" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>プレイヤーが勝った場合のメッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-22T09:55:13" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>モブ６
バトルガール</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-01T06:51:15" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>C</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-08T07:06:33" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-22T09:55:13" />
		</AttributeCell>
		<ExtraCell
