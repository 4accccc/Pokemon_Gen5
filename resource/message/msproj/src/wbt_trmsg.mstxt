	<TextRow
		Label="TRID_FIGHTERW01_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ジェーン『ふふっ！
まだまだ　しゅぎょうが　たりないね！▽
でなおしてきなさい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-05T03:29:48" />
