	<TextRow
		Label="TRID_RENT_DPLEADER6_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>グハハハハ！　どうだ！
わたしの　たたかいかたは！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:57:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グハハハハ！　どうだ！
わたしの　戦い方は！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:57:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ジムリーダー：トウガン
