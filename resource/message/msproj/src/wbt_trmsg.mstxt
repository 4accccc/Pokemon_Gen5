				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DPLEADER6_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うーむッ！
きたえた　ポケモンたちが！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T09:21:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
