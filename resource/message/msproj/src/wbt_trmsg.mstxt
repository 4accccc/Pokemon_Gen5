				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_RENT_SWLEADER5_TRMSG_3RD_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いいか？　しょうりを　もとめるなら
いいわけは　するんじゃねえぞ！▼
いいわけを　するなら
さいしょっから　たたかうのも　やめろ！▼
って　おまえさんには
おおきな　おせわ　おせっかい　だな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T13:09:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いいか？　勝利を　求めるなら
言い訳は　するんじゃねえぞ！▼
言い訳を　するなら
最初っから　戦うのも　やめろ！▼
って　おまえさんには
大きな　お世話　おせっかい　だな▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-15T13:14:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ジムリーダー：ヤーコン
・決勝戦用対戦前メッセージ
レンタル用</Comment>
			<CommentModifiedBy
				User="tamada:W00253"
				Time="2011-09-24T06:00:28" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER5
スワンジムリーダー・ヤーコン</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:14:00" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
