	<TextRow
		Label="TRID_RSCHAMPION_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やあ
ボクは　ダイゴ▼
きみの　ポケモン
なかなか　いい　かんじだね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
