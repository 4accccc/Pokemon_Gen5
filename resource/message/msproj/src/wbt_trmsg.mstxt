	<TextRow
		Label="TRID_DPLEADER8_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレに　ポケモンしょうぶの
たのしさを　おもいださせてくれる▽
トレーナーで　あってくれ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:00:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレに　ポケモン勝負の
楽しさを　思い出させてくれる▽
トレーナーで　あってくれ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:06:07" />
			<Status>Editing</Status>
