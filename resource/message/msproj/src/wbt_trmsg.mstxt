	</TextRow>
	<TextRow
		Label="TRID_RENT_GSLEADER7_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふうむ
さくが　つきた……　か▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
