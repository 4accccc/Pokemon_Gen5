				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER6_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおぞらの　ぶっとびガール　フウロ！
じまんの　わざで　ぶっとばせーッ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T06:56:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>大空の　ぶっとびガール　フウロ！
自慢の　技で　ぶっとばせーッ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T06:56:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
