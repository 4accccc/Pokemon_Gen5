	<TextRow
		Label="TRID_ASSISTANTM02_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わが　けんきゅうの　ただしさを
しょうりによって　せけんに　しめす！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-05T03:50:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-22T10:13:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>我が　研究の　正しさを
勝利によって　世間に　示す！▼</Text>
