			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これが　本当の　恐怖さ！
冷や汗　たっぷり　かいてくれた？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-15T11:25:51" />
