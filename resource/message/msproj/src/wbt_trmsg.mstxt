	<TextRow
		Label="TRID_RENT_SWLEADER6_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつもと　ちがう　なかまとでも
しょうりを　めざす　フウロだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T13:23:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつもと　違う　仲間とでも
勝利を　目指す　フウロだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-26T13:23:18" />
			<Status>Editing</Status>
