	<TextRow
		Label="TRID_MOUNTMAN01_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しっかり　ちに　あしが　ついてるから
じめんタイプの　ポケモンは　いいな！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-01T09:12:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しっかり　地に　足が　ついてるから
じめんタイプの　ポケモンは　いいな！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-01T09:51:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
