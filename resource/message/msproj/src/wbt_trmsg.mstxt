				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_SWLEADER2_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どくだらけの　ライフ　＆　ライブ！
その　するどさ　はっきしろ　ホミカ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T06:51:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>毒だらけの　ライフ　＆　ライブ！
その鋭さ　発揮しろ　ホミカ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T06:51:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：アナウンス
・ジムリーダー：ホミカ
・前口上メッセージ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>SWLEADER2
スワンジムリーダー・ホミカ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T10:13:08" />
		</AttributeCell>
