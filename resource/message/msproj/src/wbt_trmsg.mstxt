	<TextRow
		Label="TRID_GSCHAMPION_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみには　ポケモンへの
あいと　しんらいが　あふれている▼
すばらしい　しょうぶを
くりひろげることが　できそうだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみには　ポケモンへの
愛と　信頼が　あふれている▼
すばらしい　勝負を
繰り広げることが　できそうだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
			<Status>Editing</Status>
