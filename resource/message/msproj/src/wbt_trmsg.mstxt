	<TextRow
		Label="TRID_GSCHAMPION_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　ときでも　あきらめない
それは　きみだって　おなじだろ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:29:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんな　ときでも　あきらめない
それは　きみだって　同じだろ？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-12T11:29:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
