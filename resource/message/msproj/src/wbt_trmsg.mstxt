	<TextRow
		Label="TRID_LEADER7_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみと　ポケモンと！
すばらしき　コンビネーション！▽
うるわしき　ゆうじょう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T07:09:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
