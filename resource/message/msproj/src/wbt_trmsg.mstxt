				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DPLEADER7_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>スズナ『どう？　スズナの　きあい！
ポケモンも　きあい　たっぷり　でしょ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T12:43:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>スズナ『どう？　スズナの　気合！
ポケモンも　気合　たっぷり　でしょ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T12:44:56" />
			<Status>Editing</Status>
