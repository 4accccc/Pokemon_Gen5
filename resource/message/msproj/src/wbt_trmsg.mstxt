	<TextRow
		Label="TRID_DPLEADER6_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>グハハハハ！　どうだ！
きたえた　わたしの　ポケモンたちは！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T12:52:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:25" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>グハハハハ！　どうだ！
鍛えた　わたしの　ポケモンたちは！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-06-14T12:54:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
