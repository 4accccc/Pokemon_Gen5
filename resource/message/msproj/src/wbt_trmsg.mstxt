	<TextRow
		Label="TRID_ESPM01_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おばけやしきで　おどろきつくる！
びっくりクリエイター　レンスケ！</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-02T02:13:08" />
