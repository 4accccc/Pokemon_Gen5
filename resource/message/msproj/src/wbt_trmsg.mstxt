	<TextRow
		Label="TRID_RSCHAMPION_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみは　ほんとうに　すばらしい
ポケモン　トレーナー　だよ！▼</Text>
			<TextModifiedBy
