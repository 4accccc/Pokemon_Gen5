	<TextRow
		Label="GSYNC_013"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いまは　ゆめを　みているようだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
