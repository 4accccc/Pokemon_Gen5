				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="plc_connect_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミッション　しっぱい！
さきを　こされてしまった……▼
あいてのせかいが　きえさり
じぶんのハイリンクに　もどってきた</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミッション　失敗！
先を　こされてしまった……▼
相手の世界が　消え去り
