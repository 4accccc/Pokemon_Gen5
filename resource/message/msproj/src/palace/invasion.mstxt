	<TextRow
		Label="plc_target_warp"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんを　たすけるための
ミッションが　かいししたので▽
もとのせかいに　もどります▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
