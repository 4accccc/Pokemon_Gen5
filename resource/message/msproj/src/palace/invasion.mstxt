	<TextRow
		Label="plc_connect_06_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてが　みつかるまで　しばらく
はしのうえで　おまちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
