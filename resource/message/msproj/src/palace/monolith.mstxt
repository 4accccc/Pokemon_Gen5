	<TextRow
		Label="msg_mono_mis_006"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいが３つ　つながっているときは
このミッションを　うけられません</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
