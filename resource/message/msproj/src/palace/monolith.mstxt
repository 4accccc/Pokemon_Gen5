				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_mono_mis_008"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミッションを　えらぶことで
あいてを　たすけることが　できます▼
まず　はじめに　このなかから
『サポート　ミッション』を　えらび▽
ミッションを　かいしして　ください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミッションを　選ぶことで
相手を　助けることが　できます▼
まず　はじめに　この中から
『サポート　ミッション』を　選び▽
ミッションを　開始して　ください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
		</LanguageCell>
