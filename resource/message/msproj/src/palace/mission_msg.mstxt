		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_intrude_005"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてに　さきを　こされました</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
