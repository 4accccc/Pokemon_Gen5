	<TextRow
		Label="mis_m04_02_m4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……　……　……
……　……　……！！▼
[Name:TrainerName Idx="0" ]の　ポケモンは
たいりょくが　かいふくした！▼
[Name:TrainerName Idx="0" ]『おお！
ありがとうな　たすかったぜ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……　……　……
……　……　……！！▼
[Name:TrainerName Idx="0" ]の　ポケモンは
体力が　回復した！▼
[Name:TrainerName Idx="0" ]『おお！
ありがとうな　助かったぜ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
		</LanguageCell>
