	<TextRow
		Label="mis_m06_04_m4"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あ！　ごめん……
いま　かおうと　おもったんだけど▽
おかねが　たりなかった……▼
こんど　かうから
また　きてくれよ！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:08" />
			<Status>Editing</Status>
