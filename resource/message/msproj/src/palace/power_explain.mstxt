	<TextRow
		Label="plc_power_s_50"
		Style="">
		<LanguageCell
			Language="JPN">
			<Text>ゆれる　くさむらや　つちけむりが
すこしだけ　みつけやすく　なります
こうかは　３ふん　です</Text>
			<TextModifiedBy
				User="iwasawa:W00270"
				Time="2011-10-26T03:10:53" />
			<Status>Editing</Status>
