	<TextRow
		Label="perap_msg_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いま　おぼえている　ことばを
わすれますが　よいですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今　覚えている　言葉を
忘れますが　よいですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="perap_msg_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ａボタンを　おしてから
マイクに　しゃべって　ください！▼</Text>
