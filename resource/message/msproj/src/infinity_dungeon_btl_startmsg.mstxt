<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おねがいだ！　たのむよ！
おじさんと　あそんでくれ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T05:08:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お願いだ！　頼むよ！
おじさんと　遊んでくれ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:52:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うひゃひゃひゃひゃ！
あははははははははっ！▼
えがおが　たえない　このわたしと
わらいながら　たたかおう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T05:21:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うひゃひゃひゃひゃ！
あははははははははっ！▼
笑顔が　たえない　このわたしと
笑いながら　戦おう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T07:59:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしに　めを　つけられたのが
うんのつきだ！　しょうぶ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>私に　目を　つけられたのが
運の　尽きだ　勝負！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_004"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっちにっ　さんしっ！
ふぅ　ふぅ！▼
……なにを　しているのかって？
ダイエットよ　ダイエット！▽
ポケモンしょうぶで　やせてやるっ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:50:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いっちにっ　さんしっ！
ふぅ　ふぅ！▼
……なにを　しているのかって？
ダイエットよ　ダイエット！▽
ポケモン勝負で　やせてやるっ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:51:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_005"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わがこのように　そだてた　いとしの
ポケモンちゃんと　しょうぶよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-30T10:48:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>我が子のように　育てた　愛しの
ポケモンちゃんと　勝負よ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-30T10:49:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_006"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここから　さきは　おばちゃんを
たおしてから　すすみなさい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T05:54:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここから　先は　おばちゃんを
倒してから　進みなさい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:41:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_007"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おやかたに　しかられて
パンやから　にげてきました▼
こんな　みじゅくな　わたしですが
しょうぶしませんか？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T06:03:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>親方に　しかられて
パン屋から　逃げてきました▼
こんな　未熟な　わたしですが
勝負しませんか？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:41:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ベーカリー 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_008"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カレーパンに　クリームパン！
グルメなしょうぶを　しましょうよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-21T02:30:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カレーパンに　クリームパン！
グルメな勝負を　しましょうよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-21T02:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ベーカリー 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_009"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あらあら　まいごに　なっちゃった？
おねえさんが　あそんであげる！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-08T06:28:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あらあら　迷子に　なっちゃった？
お姉さんが　遊んであげる！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-08T06:28:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ほいくし 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_010"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんど　ようちえんで　いく
えんそくの　コースを　しらべてます▼
ためしに　しょうぶを
させてもらいますよ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:52:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今度　幼稚園で行く
遠足の　コースを　調べています▼
試しに　勝負を
させてもらいますよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-20T03:46:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ほいくし 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_011"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおっ！　つわものはっけん！
いざしょうぶ　アチョ～！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T06:26:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おおっ！　つわもの発見！
いざ勝負っ！　アチョ～！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:44:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>からておう 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_012"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フンッ！　ことばなど　いらん！
こぶしと　こぶしで　かたりあおう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T06:30:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フンッ！　言葉など　いらん！
こぶしと　こぶしで　語り合おう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:44:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>からておう 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_013"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いてて……！▼
３かい　スクワットしたら
ひどい　きんにくつうになった！▼
こんな　ひよわな
からておうと　たたかってみないかッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:53:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いてて……！▼
３回　スクワットしたら
ひどい　筋肉痛になった！▼
こんな　ひよわな
からておうと　戦ってみないかッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:53:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>からておう 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_014"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よわっちい　やつは　きらいだよ！
にげずに　アタシと　しょうぶしな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:53:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>弱っちい　奴は　嫌いだよ！
逃げずに　アタシと　勝負しな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:53:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バトルガール 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_015"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしね　しゅぎょうしてるんだ！
たたかいましょう！　つよくなりたい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしね　修行してるんだ！
戦いましょう！　強くなりたい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バトルガール 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_016"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼうりょくはんたい！　だけど
ポケモンしょうぶは　べつだよね！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:14:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暴力反対！　だけど
ポケモン勝負は　別だよね！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:45:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バトルガール 女 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_017"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ああん？　なにを　みてんだオイッ！
ボールをだしな　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T10:24:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ああん？　なにを　みてんだオイッ！
ボールをだしな　勝負だ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T02:49:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>スキンヘッズ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_018"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かがやく　あたまが　せかいをてらす！
あかるいファイトを　しようぜメーン！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-19T10:48:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>輝く頭が　世界を照らす！
明るいファイトを　しようぜメーン！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-19T10:48:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>スキンヘッズ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_019"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すっごい　ヒマなので
はんにんの　フリを　してください▼
……くそぉ　よくもやりやがったな！
はんにんめ　にげるな！　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:55:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すっごい　ヒマなので
犯人の　フリを　してください▼
……くそぉ　よくもやりやがったな！
犯人め　逃げるな！　勝負だ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:55:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>おまわりさん 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_020"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>したの　エリアへ　いくほど
てごわい　トレーナーが　ふえるぞ！▼
このへんなんて
まだまだ　じょのくちさ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:56:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>下の　エリアへ　行くほど
手強い　トレーナーが　増えるぞ！▼
この辺なんて
まだまだ　序の口さ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T03:56:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>おまわりさん 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_021"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そこに　やまがあるから　のぼる！
ポケモンがいるから　たたかう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T08:32:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そこに　山があるから　登る！
ポケモンがいるから　戦う！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:48:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>やまおとこ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_022"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これが　うわさに　なだかい
しろのじゅどう　か！▼
とおくから　きたかいが　あったな
さいかそうまで　たんけんし▽
すべての　トレーナーを　たおす！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T02:49:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これが　うわさに　名高い
白の樹洞か！▼
遠くから　来たかいが　あったな
最下層まで　探検し▽
すべての　トレーナーを　倒す！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T02:49:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-08T06:06:27" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>やまおとこ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_023"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たかみを　めざして　ポケモンファイト
てっぺんまで　かけあがってみろ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T08:37:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高みを　目指して　ポケモンファイト
てっぺんまで　駆けあがってみろ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T02:50:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>やまおとこ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_024"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきん　ムスメが　いっしょに
おふろに　はいってくれません……▼
でやぁ！　やつあたりしてやる！
おとうさんに　あいのてを！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:36:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>最近　ムスメが　一緒に
おフロに　入ってくれません……▼
でやぁ！　八つ当たりしてやる！
お父さんに　愛の手を！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T02:50:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>さぎょういん２ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_025"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ　しろのじゅどう　へ！
あいさつがわりに　たいせんしよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T02:50:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ　白の樹洞へ！
あいさつがわりに　対戦しよう！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T02:50:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>さぎょういん２ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_026"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このエリアを　いちばんに
クリアするのは　わたしだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:13:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>このエリアを　一番に
クリアするのは　わたしだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:14:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>さぎょういん２ 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_027"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そうじ　ひとすじ　５０ねん！
わかいもんには　まけんわい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:53:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おそうじ一筋　５０年！
若いもんには　負けんわい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:51:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>せいそういん 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_028"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わひの　いれひゃを　ひゃえせ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T02:50:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わひの　いれひゃを　ひゃえせ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-10T02:50:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>せいそういん 男 w 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
