	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_273"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かねもちに　たたかいを　かんし
されていて　じぶんたちが▼
ピエロだという　ような　はなし
かり▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-11T05:19:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝負だ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>サイキッカー 男 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
