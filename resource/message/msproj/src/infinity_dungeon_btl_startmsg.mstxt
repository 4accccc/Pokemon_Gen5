	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_271"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うちゅうに　かぎりなくちかい
このばしょ　てきな▼
たかいばしょにきて　うちゅうを
かんじてるせいふがはいる　かり▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-07T05:35:57" />
			<Status>Editing</Status>
