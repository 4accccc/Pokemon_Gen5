			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_037"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フフッ！　データを　とらせてもらうよ
ポケモンを　だしたまえ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:19:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フフッ！　データを　取らせてもらうよ
ポケモンを　出したまえ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:19:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>けんきゅういん 男 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_038"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>けいさんだと　ボクが　しょうりする
かのうせいは　１２０パーセント！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-20T05:53:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>計算によれば　ボクの勝率は
１２０パーセント！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-20T05:54:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>けんきゅういん 男 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_039"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつもは　マジメな　わたしだけど
たまには　どかんと　はっちゃけたい！▽
そーれ！　いきますよぉ！！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-31T01:58:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつもは　マジメな　わたしだけど
たまには　どかんと　はっちゃけたい！▽
そーれ！　いきますよぉ！！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-31T01:58:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
