				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_023"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たかみを　めざして　ポケモンファイト
てっぺんまで　かけあがってみろ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T08:37:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>高みを目指して　ポケモンファイト
てっぺんまで　駆け上がってみろ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:49:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>やまおとこ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_024"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいきん　ムスメが　いっしょに
おふろに　はいってくれません……▼
でやぁ！　やつあたりしてやる！
おとうさんに　あいのてを！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:36:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さいきん　ムスメが　一緒に
お風呂に　入ってくれません……▼
でやぁ！　八つ当たりしてやる！
お父さんに　愛の手を！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T03:20:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>さぎょういん２ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_025"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようこそ　しろのたいじゅへ！
あいさつ　がわりに　たいせんしよう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようこそ　白の大樹へ！
あいさつ代わりに　対戦しよう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>さぎょういん２ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
