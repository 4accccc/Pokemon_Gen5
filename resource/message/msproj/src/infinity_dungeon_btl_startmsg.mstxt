				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_036"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケモンたちが　あなたと
たたかえと　よびかけるの……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T03:48:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポケモンたちが　あなたと
戦えと　呼びかけるの……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T03:49:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
