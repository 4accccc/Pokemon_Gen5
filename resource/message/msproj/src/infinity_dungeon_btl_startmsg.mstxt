<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おねがいだ！　たのむよ！
おじさんと　あそんでくれ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T05:08:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お願いだ！　頼むよ！
おじさんと　遊んでくれ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:38:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うひゃひゃひゃひゃ！
あははははははははっ！▼
えがおが　たえない　このわたしと
わらいながら　たたかおう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T05:21:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うひゃひゃひゃひゃ！
あははははははははっ！▼
笑顔が　たえない　このわたしと
笑いながら　戦おう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:39:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_003"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしに　めを　つけられたのが
うんのつきだ！　しょうぶ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>私に　目を　つけられたのが
運の　尽きだ　勝負！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_004"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いっちにっさんしっ！　ふぅ　ふぅ！▽
……なにを　しているのかって？▼
ダイエットよ　ダイエット！
ポケモンしょうぶで　やせてやるっ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T05:36:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いっちにっさんしっ！　ふぅ　ふぅ！▽
……なにを　しているのかって？▼
ダイエットよ　ダイエット！
ポケモン勝負で　やせてやるっ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:39:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_005"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わがこのように　そだてた　いとしい
わたしのポケモンと　しょうぶよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T05:48:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わが子のように　育てた
愛しいわたしの　ポケモンと　勝負よ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:40:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_006"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここから　さきは　おばちゃんを
たおしてから　すすみなさい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T05:54:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ここから　先は　おばちゃんを
倒してから　進みなさい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:41:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_007"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おやかたに　しかられて
パンやから　にげてきました▼
こんな　みじゅくな　わたしですが
しょうぶしませんか？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T06:03:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>親方に　しかられて
パン屋から　逃げてきました▼
こんな　未熟な　わたしですが
勝負しませんか？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:41:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ベーカリー 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_008"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>やきそばパンに　クリームパン！
グルメなしょうぶを　しましょうよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T06:12:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>やきそばパンに　クリームパン！
グルメな勝負を　しましょうよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:41:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ベーカリー 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_009"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あらあら　まいごに　なっちゃった？
おねえさんが　あそんであげる！▼
</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T07:29:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あらあら　迷子に　なっちゃった？
お姉さんが　遊んであげる！▼
</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:42:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ほいくし 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_010"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようちえんの　こどもたちと
どうくつたんけんに　きたんだけど……▼
せんせい　おいていかれちゃいました
さびしいから　しょうぶしてください！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T02:24:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ようちえんの　子供たちと
洞くつ探検に　来たんだけど……▼
先生　置いていかれちゃいました
寂しいから　勝負してください！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T02:24:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ほいくし 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_011"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おおっ！　つわものはっけん！
いざしょうぶ　アチョ～！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T06:26:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おおっ！　つわもの発見！
いざ勝負っ！　アチョ～！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:44:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>からておう 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_012"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>フンッ！　ことばなど　いらん！
こぶしと　こぶしで　かたりあおう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T06:30:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>フンッ！　言葉など　いらん！
こぶしと　こぶしで　語り合おう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:44:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>からておう 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_013"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いてて……３かい　スクワットしたら
ひどい　きんにくつうになった！▼
こんな　ひよわな　カラテカと
たたかってみないかッ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:34:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いてて……３回　スクワットしたら
ひどい　筋肉痛になった！▼
こんな　ひよわな　カラテカと
戦ってみないかッ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:45:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>からておう 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_014"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっと　アンタ！
にげずにアタシと　しょうぶしな！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T07:17:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちょっと　アンタ！
逃げずにアタシと　勝負しな！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:45:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バトルガール 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_015"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしね　しゅぎょうしてるんだ！
たたかいましょう！　つよくなりたい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしね　修行してるんだ！
戦いましょう！　強くなりたい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バトルガール 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_016"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼうりょくはんたい！　だけど
ポケモンしょうぶは　べつだよね！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:14:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>暴力反対！　だけど
ポケモン勝負は　別だよね！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:45:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バトルガール 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_017"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ああん？　なにを　みてんだオイッ！
ポケモンをだしな　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T07:54:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ああん？　なにを　見てんだオイッ！
ポケモンをだしな　勝負だ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:46:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>スキンヘッズ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_018"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かがやく　あたまが　せかいをてらす！
あかるいファイトを　しようぜボーイ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T07:49:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>輝く頭が　世界を照らす！
明るいファイトを　しようぜボーイ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:46:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>スキンヘッズ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_019"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あくにんが　いないので　ヒマなので
はんにんのフリを　してください▼
……くそぉ　よくもやりやがったな！
はんにんめ　にげるな！　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:35:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>悪人が　いないので　ヒマなので
犯人のフリを　してください▼
……くそぉ　よくもやりやがったな！
犯人め　逃げるな！　勝負だ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:47:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>おまわりさん 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_020"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ボスの　いばしょを　しりたいのか？
それならホンカンと　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:35:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボスの　居場所を　知りたいのか？
それならホンカンと　勝負だ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:48:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>おまわりさん 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_021"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そこに　やまがあるから　のぼる！
ポケモンがいるから　たたかう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T08:32:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そこに　山があるから　登る！
ポケモンがいるから　戦う！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:48:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>やまおとこ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
