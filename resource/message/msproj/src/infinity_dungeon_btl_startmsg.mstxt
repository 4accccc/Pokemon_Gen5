			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_039"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつもはマジメな　わたしだけど
たまには　どかんと　はっちゃけたい！▼</Text>
