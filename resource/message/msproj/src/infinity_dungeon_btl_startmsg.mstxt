	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_306"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おつかれのようね　わたしに
かてたら　かいふくしてあげる▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
