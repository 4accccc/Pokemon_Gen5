				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_105"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーどうしの　めが　あったら
……しょうぶの　あいずよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T10:15:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナー同士の　目が　あったら
……勝負の　合図よ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T10:15:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
