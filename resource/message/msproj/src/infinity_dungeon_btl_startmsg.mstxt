	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_113"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おうりゃー！　まきゅうっ！
とるねーどボールを　くらえーっ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T05:37:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おうりゃー！　魔球っ！
とるねーどボールを　くらえーっ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T05:37:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>たんパンこぞう 男 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_114"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょどうふしんな　おとこのこに
おいかけられてるの▼
わたしが　いったい
なにを　したっていうのよ！　もうっ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T10:00:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>挙動不審な　男の子に
追いかけられているの▼
わたしが　いったい
何を　したっていうのよ！　もうっ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T10:00:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミニスカート 女 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_115"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>また　おなじとこに　きちゃった……
もー！　どこに　いけばいいのよー！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T05:47:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>また　同じ所に　戻って来ちゃった……
もー！　どこに　行けばいいのよー！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T05:49:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミニスカート 女 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_116"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねぇ　おねがいっ！　わたしの
ポケモンと　あそんでちょうだい▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:01:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねぇ　お願いっ！　わたしの
ポケモンと　遊んでちょうだい▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:01:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミニスカート 女 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_117"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こっちじゃないか……▽
おっ　あんたも　まよったのかい？▼
まよえる　こひつじどうし
ポケモンしょうぶでも　やろうか▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:19:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こっちじゃないか……▽
おっ　あんたも　迷ったのかい？▼
迷える　子羊同士
ポケモン勝負でも　やろうか▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:19:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バックパッカー 男 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_118"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じぶんさがしの　たびに　きたんだが
そもそも　じぶん　って　なんなんだ？▼
いま　こう　かんがえている　じぶんも
じぶんな　わけだし……▼
わからん……
とりあえず　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:23:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>自分探しの　旅に　来たんだが
そもそも　自分　って　なんなんだ？▼
いま　こう　考えている
自分も　自分な訳だし……▼
分からん……
とりあえず　勝負だ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:38:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バックパッカー 男 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_119"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このビルに　はいると　コンパスが
クルクルまわって　つかえなくなるの▼
たたかいの　なかで　とぎすまされた
かんだけが　たよりね……▼
いくわよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:40:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>このビルに　入ると　コンパスが
クルクル回って　使えなくなるの▼
戦いの　中で　研ぎ澄まされた
勘だけが　頼りね……▼
行くわよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:40:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バックパッカー 女 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_120"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おっ　はじめてみる　かおだ！
あいさつがわりに　ポケモンしょうぶ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:43:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おっ　はじめて見る　顔だ！
あいさつ代わりに　ポケモン勝負！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:44:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バックパッカー 女 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_121"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんなに　ふかい　ダンジョンでも
ポケモンが　いれば　さびしくない▼
そ～れ　みんな　でておいで～！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:58:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こんなに深い　ダンジョンでも
ポケモンが　いれば　寂しくない▼
そ～れ　みんな　出ておいで～！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T07:02:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_122"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ようつうに　しじゅうかた……
すこし　あるけば　いきぎれ　するんだ▼
かずかずの　こんなんを　のりこえて
おじさんは　ここに　たっている！▼
くろうしらずの　こどもが
おじさんに　かつことが　できるかな？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T07:51:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>腰痛に　四十肩……
少し歩けば　息切れするんだ▼
かずかずの　困難を　乗り越えて
おじさんは　ここに　立っている！▼
苦労知らずの　子供が
おじさんに　勝つ事が　できるかな？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T07:59:13" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_123"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝負だ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_124"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゅんちょうに
ポケモンは　そだってる？▼
おばちゃんが　トレーニングの
おてつだいをしてあげる！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T07:23:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>順調に　ポケモンは育ってる？▼
おばちゃんが　トレーニングの
お手伝いをしてあげる！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T07:23:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 女 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_125"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶだ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝負だ！▼</Text>
