				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_033"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ボクには　みらいが　みえている！
……さぁ　たたかおう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-19T01:59:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ボクには　未来が　みえている！
……さぁ　戦おう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-08T05:52:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>サイキッカー 男 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
