			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_032"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こころが　ふるえる……
キミは　かなりの　つよさだな？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:37:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>心が　震える……
キミは　かなりの　強さだな？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:37:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>サイキッカー 男 b 1～10階</Comment>
			<CommentModifiedBy
