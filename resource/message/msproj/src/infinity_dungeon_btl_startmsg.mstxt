				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_274"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あああああっ！
ダメッ　とめられないっ！▼
ちからが　ぼうそうする！
たすけて　わたしの　ポケモンたち！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-11T03:35:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あああああっ！
ダメッ　止められないっ！▼
力が　暴走する！
助けて　わたしの　ポケモンたち！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-11T03:35:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>サイキッカー 女 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_275"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おさえてきた　ちからを
かいほう　するはなし！▼
しゅじんこうを　みとめてる
かんじ　かり▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-11T06:04:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
