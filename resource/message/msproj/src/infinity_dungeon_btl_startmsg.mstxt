			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_040"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>これより　うえにいく　しかくがあるか
テストしてあげるわ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T05:31:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>これより　上に行く　資格があるか
テストしてあげるわ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T05:32:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>けんきゅういん 女 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_041"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>べんきょうで　くたびれた　ときには
ポケモンしょうぶに　かぎるよね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:50:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勉強で　くたびれた　ときには
ポケモン勝負に　かぎるよね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:50:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>じゅくがえり 男 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_042"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ウウーッ！　まよったー！
どこへ　すすめばいいんだ！▼
……なんだい　キミは　このボクより
さきに　いこう　っていうの！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-21T02:46:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ウウーッ！　迷ったー！
どこへ　進めばいいんだー！▼
……なんだい　キミは　このボクより
先に　行こうって　いうの！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-08T05:47:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>じゅくがえり 男 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_043"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にがてかもくは　さんすう！
とくいかもくは　ポケモンしょうぶ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T06:02:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>苦手科目は　算数！
得意科目は　ポケモン勝負！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T06:03:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>じゅくがえり 男 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_044"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もうっ！
わたしは　りっぱな　レディーなの！▼
こどもあつかい　したら
しょうち　しないから！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:52:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もうっ！
わたしは　立派な　レディーなの！▼
こども扱いしたら
承知しないから！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-21T02:47:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>じゅくがえり 女 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_045"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>トレーナーどうしの　めが　あったら
……しょうぶの　あいずよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T08:51:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>トレーナー同士の　目が　あったら
……勝負の　合図よ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T08:51:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>じゅくがえり 女 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_046"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いえに　かえると　ママは　いっつも
べんきょう　しろって　うるさいの▼
だからね　ここに　いきぬきに
きてるんだ！　あそぼうよっ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T06:32:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>家に帰ると　ママは　いっつも
勉強しろって　うるさいの▼
だからね　ここに　息抜きに
来てるんだ！　遊ぼうよっ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T06:33:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>じゅくがえり 女 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_047"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いらっしゃいませ！
こちらで　たいせんを　どうぞ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いらっしゃいませ！
こちらで　対戦を　どうぞ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ウエーター 男 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
