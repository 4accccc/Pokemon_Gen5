			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_048"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょうの　メインディッシュは
キミに　きめた！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>今日の　メインディッシュは
キミに　決めた！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ウエーター 男 b 1～10階</Comment>
			<CommentModifiedBy
