	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_034"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　ちから　あなたの　こころ
つよく　つよく　かんじさせて！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたの力　あなたの心
強く　強く　感じさせて！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
