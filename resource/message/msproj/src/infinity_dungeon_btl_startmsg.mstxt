				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_107"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほんじつは　すこしばかり
かわったメニューを　よういしました▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:00:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>本日は　少しばかり
変わったメニューを　用意しました▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:00:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ウエーター 男 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
