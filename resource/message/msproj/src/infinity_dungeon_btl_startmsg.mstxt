	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_131"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もっと　したのエリアに
いってきたんだが▼
しょうじき　まったく
はが　たたなかったぜ！▼
みのたけに　あったエリアで
やりなおしだ！　しょうぶ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T07:37:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もっと　下のエリアに
行ってきたんだが▼
正直　まったく
歯が　たたなかったぜ！▼
みのたけに　あったエリアで
やりなおしだ！　勝負！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T07:36:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>からておう 男 w</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:19" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
