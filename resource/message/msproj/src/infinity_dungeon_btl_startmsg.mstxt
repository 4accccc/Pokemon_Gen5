				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_034"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あなたの　ちから　あなたの　こころ
つよく　つよく　かんじさせて！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あなたの力　あなたの心
強く　強く　感じさせて！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-05T07:20:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>サイキッカー 女 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_035"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ライバル　みっけ！
どっちが　さきに　うえにいけるか▼
きょうそう　しましょ！
まずは　しょうぶよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-11T03:41:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ライバル　みっけ！
どっちが　先に　上に行けるか▼
競争しましょ！
まずは　勝負よ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-11T03:41:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>サイキッカー 女 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_036"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まって……　ポケモンたちが　あなたと
たたかえと　よびかけるの……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:50:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>待って……　ポケモンたちが　あなたと
戦えと　呼びかけるの……▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-10-17T05:50:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>サイキッカー 女 b 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:48:13" />
