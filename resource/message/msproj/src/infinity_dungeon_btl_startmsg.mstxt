		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_109"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうぞ　こちらに！　とびっきりの
ポケモンを　おもちいたします！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:00:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どうぞ　こちらに！　とびっきりの
ポケモンを　お持ちいたします！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-06T06:00:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ウエートレス 女 b 11～20階</Comment>
			<CommentModifiedBy
