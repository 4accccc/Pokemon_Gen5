				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_029"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒュー！　クールな　たたかいを
くりひろげようぜぇ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T10:09:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒュー！　クールな　戦いを
繰り広げようぜぇ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T02:52:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
