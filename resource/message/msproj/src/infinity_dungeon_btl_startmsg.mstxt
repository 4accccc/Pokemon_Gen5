	<TextRow
		Label="INF_BATTLE_START_MSG_TRID_101"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いつでも　どこでも
ポケモンしょうぶさ！▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いつでも　どこでも
ポケモン勝負さ！▼</Text>
