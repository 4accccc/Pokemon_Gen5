			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_017"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めんえき　ね……▼
この　とくせいの　ポケモンは
せんとうで　どくに　ならないんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T08:10:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>めんえき　ね……▼
この特性の　ポケモンは
戦闘で　どくに　ならないんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T10:12:39" />
			<Status>Editing</Status>
