				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_146"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すなかき　か…▼
この　とくせいの　ポケモンは
てんきが　すなあらしの　ばあい▽
すばやさが　ばいに　なるんだ▼
それに　タイプに　かんけいなく
すなあらしの　こうかで▽
ダメージを　うけなく　なるんだよ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T05:28:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すなかき</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>すなかき</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_147"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミラクルスキン　か…▼
この　とくせいの　ポケモンは
へんかわざに　たいして　のみ▽
かいひりつが　ばいに　なるんだ▼
じぶんで　じぶんに　つかう
へんかわざには　こうかが　ないから▽
おぼえておくｊと　いいよ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T10:30:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミラクルスキン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ミラクルスキン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
