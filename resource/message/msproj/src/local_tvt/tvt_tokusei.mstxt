				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_152"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ミイラ　か…▼
この　とくせいの　ポケモンは
ちょくせつこうげきを　された　ときに▽
あいての　とくせいを▽
ミイラに　かえて　しまうんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T06:02:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミイラ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
