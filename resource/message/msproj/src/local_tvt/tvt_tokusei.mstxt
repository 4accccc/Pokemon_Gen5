				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_101"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テクニシャン　か…▼
この　とくせいの　ポケモンは
よわい　わざの　いりょくを▽
あげる　ことが　できるんだ▼
ほかの　こうかで
わざの　いりょくが　あがっていると▽
こうかが　はつどう　しなくなるから▽
ちゅうい　すること▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-26T08:35:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テクニシャン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
