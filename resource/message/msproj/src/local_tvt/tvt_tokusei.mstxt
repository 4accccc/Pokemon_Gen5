				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_160"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>てつのトゲ　か…▼
この　とくせいの　ポケモンは
ちょくせつこうげき　された　ときに▽
こうげき　してきた　あいてにも▽
ダメージを　あたえるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T08:17:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>てつのトゲ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>てつのトゲ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_161"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ダルマモード　か…▼
この　とくせいの　ヒヒダルマは
たいりょくが　はんぶんいかに　なると▽
ダルマモードに　へんか　するんだ▼
ダルマモードに　なると
もとの　ほのおタイプに　くわえ▽
エスパータイプが　ついか　されるんだ▼
さらに！▼
こうげきと　すばやさの
のうりょくが　へる　かわりに▽
ぼうぎょ　とくこう　とくぼうの▽
のうりょくが　あがるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T11:18:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ダルマモード</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
