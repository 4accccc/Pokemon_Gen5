				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_045"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すなおこし　か…▼
この　とくせいの　ポケモンは
バトルに　でるだけで　てんきを▽
すなあらしに　してしまえるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:17:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すなおこし</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T07:46:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>すなおこし</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_046"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>プレッシャー　か…▼
この　とくせいの　ポケモンは
あいてが　つかった　わざの▽
パワーポイントを▽
おおく　へらすことが　できるんだ▼
あと…▼
てもちの　せんとうに　いると
レベルの　たかい　ポケモンと▽
であいやすくなる　こうかもあるね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:18:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>プレッシャー</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>プレッシャー</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_047"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あついしぼう　か…▼
この　とくせいの　ポケモンは
ほのおと　こおりタイプの▽
わざの　いりょくを▽
はんぶんに　してしまえるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:18:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あついしぼう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あついしぼう</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_048"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はやおき　か…▼
この　とくせいの　ポケモンは
ねむってしまった　ときに▽
ふつうよりも　はやく▽
おきる　ことが　できるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:19:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はやおき</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>はやおき</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_049"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ほのおのからだ　か…▼
この　とくせいの　ポケモンは
ちょくせつこうげき　された　ときに▽
こうげき　してきた　あいてを▽
やけど　させることが　あるんだ▼
あと…▼
てもちに　いると　タマゴが
かえりやすくなる　こうかもあるね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:20:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ほのおのからだ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ほのおのからだ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_050"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>にげあし　か…▼
この　とくせいの　ポケモンは
やせいの　ポケモンとの　バトルから▽
かならず　にげられるんだ▼
あいてを　にげられないようにする
わざや　とくせいの　こうかも▽
むしして　にげる　ことが　できるよ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:23:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>にげあし</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T07:46:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>にげあし</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_051"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>するどいめ　か…▼
この　とくせいの　ポケモンは
バトルで　めいちゅうりつを▽
さげられる　ことが　ないんだ▼
あと…▼
てもちの　せんとうに　いると
レベルの　ひくい　ポケモンと▽
であいにくくなる　こうかもあるね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:24:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>するどいめ</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T07:46:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>するどいめ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_052"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいりきバサミ　か…▼
この　とくせいの　ポケモンは
バトルで　こうげきを▽
さげられる　ことが　ないんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:24:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>かいりきバサミ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>かいりきバサミ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_053"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ものひろい　か…▼
この　とくせいの　ポケモンは
あいてが　つかった　きのみを▽
そのターンの　おわりに　ひろってきて▽
じぶんの　もちものに　できるんだ▼
あと…▼
バトルに　さんか　していなくても
どこからか　どうぐを▽
ひろってくる　ことも　あるんだよ▼
ちなみに…▼
ポケモンの　レベルが　たかいほど
いいものを　ひろってくるから▽
おぼえておくと　いいよ▼
まぁ…▼
どちらの　ばあいも
もちものを　もっていない　ことが▽
じょうけん　なんだけどね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T10:38:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ものひろい</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T07:47:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ものひろい</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_054"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なまけ　か…▼
この　とくせいの　ポケモンは
２ターンに　１かいしか▽
こうどう　することが　できないんだ▼
いちげきに　かけろ！▼
それが　この　とくせいで
しょうりする　ポイント　だろうね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T10:42:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なまけ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>なまけ</Comment>
			<CommentModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T10:43:02" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_055"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はりきり　か…▼
この　とくせいの　ポケモンは
こうげきが　あがる　かわりに▽
めいちゅうりつが　さがるんだ▼
かならず　めいちゅうする　わざには
めいちゅうりつが　かんけい　ないから▽
いりょくだけが　あがったり　するんだ▽
おぼえておくと　いいよ▼
あと…▼
てもちの　せんとうに　いると
レベルのたかい　ポケモンと▽
であいやすくなる　こうかもあるね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T10:52:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はりきり</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>はりきり</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_056"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メロメロボディ　か…▼
この　とくせいの　ポケモンは
ちょくせつこうげき　された　ときに▽
こうげき　してきた　あいてを▽
メロメロに　してしまうことがあるんだ▼
あと…▼
てもちの　せんとうに　いると
べつの　せいべつの　ポケモンと▽
であいやすくなる　こうかもあるね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:29:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>メロメロボディ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
