			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_126"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あまのじゃく　ね……▼
この　とくせいの　ポケモンは
のうりょくへんかが　さかさま　なんだ▼
あがったら　さがって
さがったら　あがるんだよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:46:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あまのじゃく　ね……▼
この特性の　ポケモンは
能力変化が　さかさま　なんだ▼
あがったら　さがって
さがったら　あがるんだよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:46:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あまのじゃく</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
