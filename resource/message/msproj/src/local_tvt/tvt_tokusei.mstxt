		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_077"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちどりあし　か…▼
この　とくせいの　ポケモンは
こんらん　すると▽
かいひりつが　あがるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T10:03:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちどりあし</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
