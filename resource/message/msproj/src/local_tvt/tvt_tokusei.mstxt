				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_028"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シンクロ　か…▼
この　とくせいの　ポケモンは
どく　マヒ　やけどに　されると▽
あいても　おなじに　してしまうんだ▼
あと…▼
てもちの　せんとうに　いると
おなじ　せいかくの　ポケモンと▽
であいやすくなる　こうかもあるね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T08:29:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シンクロ</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T07:46:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>シンクロ</Comment>
			<CommentModifiedBy
