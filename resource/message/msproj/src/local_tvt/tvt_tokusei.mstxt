				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_073"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しろいけむり　か…▼
この　とくせいの　ポケモンは
あいての　わざや　とくせいでは▽
のうりょくが　さがらないんだ▼
ただし！▼
やけどの　こうげき　はんげんや
マヒの　すばやさ　はんげんは▽
こうかの　たいしょうでは　ないので▽
ちゅうい　すること▼
あと…▼
てもちの　せんとうに　いると
やせいの　ポケモンと▽
であいにくくなる　こうかもあるね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:53:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しろいけむり</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
