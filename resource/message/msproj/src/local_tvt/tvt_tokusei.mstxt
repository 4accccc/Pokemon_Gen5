				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_104"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かたやぶり　ね……▼
この　とくせいの　ポケモンは
あいての　とくせいを　むこうにして▽
こうげき　することが　できるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-26T08:37:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>かたやぶり　ね……▼
この特性の　ポケモンは
相手の　特性を　無効にして▽
攻撃することが　できるんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T10:57:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>かたやぶり</Comment>
			<CommentModifiedBy
				User="nishino:W00221"
				Time="2011-07-26T08:37:54" />
