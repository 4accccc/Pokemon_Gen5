				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_020"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マイペース　か…▼
この　とくせいの　ポケモンは
バトルで　こんらん　しないんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T08:11:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
