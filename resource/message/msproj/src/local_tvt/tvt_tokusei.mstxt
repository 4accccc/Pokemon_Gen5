				User="nishino:W00221"
				Time="2011-07-27T07:47:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>やるき</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
