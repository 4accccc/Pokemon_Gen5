				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_101"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テクニシャン　ね……▼
この　とくせいの　ポケモンは
よわい　わざの　いりょくを▽
あげることが　できるんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-31T12:34:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テクニシャン　ね……▼
この特性の　ポケモンは
弱い　技の　威力を▽
あげることが　できるんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-31T12:34:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>テクニシャン</Comment>
