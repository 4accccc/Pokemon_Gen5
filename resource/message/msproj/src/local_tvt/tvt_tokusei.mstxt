				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_103"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぶきよう　ね……▼
この　とくせいの　ポケモンが
もっている　どうぐは▽
こうかを　はつどう　しなくなるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-26T08:37:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぶきよう　ね……▼
この特性の　ポケモンが
持っている　道具は▽
効果を　発動しなくなるんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T10:57:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
