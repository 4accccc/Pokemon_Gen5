				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_105"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きょううん　か…▼
この　とくせいの　ポケモンは
わざが　きゅうしょに▽
あたりやすく　なるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-26T08:40:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きょううん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
