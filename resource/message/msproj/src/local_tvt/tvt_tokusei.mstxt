				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_138"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねつぼうそう　か…▼
この　とくせいの　ポケモンは
やけどに　なると▽
とくこうが　あがるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T03:22:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねつぼうそう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ねつぼうそう</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_139"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゅうかく　か…▼
この　とくせいの　ポケモンは
じぶんが　つかった　きのみを▽
ふっかつ　させることが　あるんだ▼
てんきが　ひざしがつよいの　ばあいは
かならず　ふっかつ　するから▽
おぼえておくと　いいよ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T03:28:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しゅうかく</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>しゅうかく</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_140"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テレパシー　か…▼
この　とくせいの　ポケモンは
みかたの　こうどうを　よみとって▽
どうしうちを　おこらなく　させるんだ▼
シングルバトルでは　いみがないけど
ダブルや　トリプルの　バトルでは▽
じゅうような　とくせいだね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-05-31T07:08:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テレパシー</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T07:48:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>テレパシー</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_141"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ムラっけ　か…▼
この　とくせいの　ポケモンは
ターンの　おわりに▽
のうりょくの　１つが　ぐーんとあがり▽
のうりょくの　１つが　さがるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T03:33:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
