				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_075"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シェルアーマー　か…▼
この　とくせいの　ポケモンは
あいての　こうげきが▽
きゅうしょに　あたらなく　なるんだ▼
かならず　きゅうしょに　あたる
わざ　なんかも　あったりするけど▽
この　とくせいには　こうかがないよ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T10:03:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シェルアーマー</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T07:47:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>シェルアーマー</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_076"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>エアロック　か…▼
この　とくせいの　ポケモンが
バトル　している　さいちゅうは▽
てんきの　こうかが　なくなるんだ▼
かんちがい　されやすいけど…▼
こうかが　なくなるだけで
てんきを　けしさる　わけではないので▽
ちゅうい　すること▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T08:06:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>エアロック</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
