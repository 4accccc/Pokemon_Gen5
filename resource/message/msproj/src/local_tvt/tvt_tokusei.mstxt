			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_125"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちからずく　ね……▼
この　とくせいの　ポケモンは
わざの　いりょくが　あがる　かわりに▽
ついかこうかが　でなくなるんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:45:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ちからずく　ね……▼
この特性の　ポケモンは
技の　威力が　あがる　かわりに▽
追加効果が　でなくなるんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:45:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ちからずく</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
