				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_020"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>マイペース　ね……▼
この　とくせいの　ポケモンは
せんとうで　こんらん　しないんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T08:11:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>マイペース　ね……▼
この特性の　ポケモンは
戦闘で　こんらん　しないんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T10:12:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
