				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_030"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しぜんかいふく　か…▼
この　とくせいの　ポケモンは
バトルから　ひっこむと▽
じょうたいいじょうが　なおるんだ▼
バトルが　おわった　ときも
じょうたいいじょうが　なおるから▽
おぼえておくと　いいよ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-22T12:11:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しぜんかいふく</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>しぜんかいふく</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_031"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひらいしん　か…▼
この　とくせいの　ポケモンは
でんきタイプの　わざを　うけても▽
むこうに　できるんだ▼
しかも！▼
でんきタイプの　わざを　うけると
じぶんの　とくこうの　のうりょくを▽
あげる　こうかも　あるんだよ▼
さらに　もうひとつ！▼
この　とくせいは
でんきタイプの　わざを▽
ひきつける　こうかも　もっているんだ▼
シングルバトルでは　いみがないけど
ダブルや　トリプルの　バトルでは▽
やくに　たつと　おもうよ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T08:55:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ひらいしん</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
