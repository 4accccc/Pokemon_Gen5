				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_100"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あとだし　ね……▼
この　とくせいの　ポケモンは
すばやさに　かんけいなく▽
かならず　こうこうに　なるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-26T08:15:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あとだし　ね……▼
この特性の　ポケモンは
すばやさに　関係なく▽
かならず　後攻に　なるんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T10:56:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>あとだし</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
