				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_139"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゅうかく　ね……▼
この　とくせいの　ポケモンは
じぶんが　つかった　きのみを▽
ふっかつ　させることが　あるんだ▼
ひざしがつよい　てんきの　ばあいは
かならず　ふっかつ　するから▽
おぼえておくと　いいよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-31T12:30:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>しゅうかく　ね……▼
この特性の　ポケモンは
自分が　使った　きのみを▽
復活させることが　あるんだ▼
ひざしがつよい　天候の　場合は
必ず　復活するから▽
おぼえておくと　いいよ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-31T12:30:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>しゅうかく</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T08:46:58" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_140"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>テレパシー　ね……▼
この　とくせいの　ポケモンは
みかたの　こうどうを　よみとって▽
どうしうちを　ふせぐんだ▼
シングルバトルでは　いみがないけど
ダブルバトルや　トリプルバトルでは▽
じゅうような　とくせいだね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-01T06:30:17" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>テレパシー　ね……▼
この特性の　ポケモンは
味方の　行動を　読み取って▽
同士討ちを　ふせぐんだ▼
シングルバトルでは　意味がないけど
ダブルバトルや　トリプルバトルでは▽
重要な　特性だね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-01T06:30:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>テレパシー</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T08:46:58" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_141"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ムラっけ　ね……▼
この　とくせいの　ポケモンは
ターンの　おわりに▽
のうりょくの　１つが　ぐーんとあがり▽
のうりょくの　１つが　さがるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T03:33:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ムラっけ　ね……▼
この特性の　ポケモンは
ターンの　終わりに▽
能力の　１つが　ぐーんとあがり▽
能力の　１つが　さがるんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T11:10:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ムラっけ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T08:46:58" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_142"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼうじん　ね……▼
この　とくせいの　ポケモンは
てんきの　ダメージを　うけないんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T03:49:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼうじん　ね……▼
この特性の　ポケモンは
天候の　ダメージを　受けないんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T11:10:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ぼうじん</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T08:46:58" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_143"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どくしゅ　ね……▼
この　とくせいの　ポケモンは
ちょくせつこうげき　した　ときに▽
あいてを　どくにすることが　あるんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T03:55:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どくしゅ　ね……▼
この特性の　ポケモンは
直接攻撃した　ときに▽
相手を　どくにすることが　あるんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T11:10:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>どくしゅ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T08:46:58" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_144"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さいせいりょく　ね……▼
この　とくせいの　ポケモンは
せんとうから　ひっこむと▽
すこし　だけど　たいりょくが▽
かいふく　するんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T03:59:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さいせいりょく　ね……▼
この特性の　ポケモンは
戦闘から　ひっこむと▽
すこし　だけど　体力が▽
回復するんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T11:10:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>さいせいりょく</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-09T08:46:58" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_145"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はとむね　ね……▼
この　とくせいの　ポケモンは
あいてから　ぼうぎょの　のうりょくを▽
さげられる　ことが　ないんだ▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T04:06:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はとむね　ね……▼
この特性の　ポケモンは
相手から　防御の　能力を▽
さげられる　ことが　ないんだ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T11:33:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-31T06:31:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>はとむね</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
