				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="TOKUSEI_STR_035"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はっこう　か…▼
この　とくせいの　ポケモンは
てもちの　せんとうに　いると▽
やせいの　ポケモンと▽
であいやすくなる　なるんだ▼
えっ？▼
バトルでの　こうかは　なにかって？▼
……　……　……▼
ざんねんながら
まだ　はんめいして　ないんだよね▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-07-27T09:03:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はっこう</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>はっこう</Comment>
