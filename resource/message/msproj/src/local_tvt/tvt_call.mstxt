				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_DOCTOR_TALK_10"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なかよくなるためには　しること
そして　あいてを　うけいれること▼
だって　ポケモンと　ひとは
ちがう　ルールで　いきてるもの！▼
わたしたちの　きぼうを　おしつけても
うまく　いかないでしょ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-14T10:07:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:04:45" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>仲良くなるためには　知ること
そして　相手を　受け入れること▼
だって　ポケモンと　人は
違う　ルールで　生きてるもの！▼
わたしたちの　希望を　押しつけても
うまく　いかないでしょ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-14T10:07:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:04:45" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>はなす/話す選択時
・ランダム</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-14T03:16:56" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>アララギ博士</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:04:45" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_DOCTOR_BYE_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それでは　げんきでね
バイバーイ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T13:16:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それでは　元気でね
バイバーイ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T13:16:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
