		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おっ　おそくなって　ゴメ……
あっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T10:37:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>５０回目　　　素顔でライブキャスター。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
