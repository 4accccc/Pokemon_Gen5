		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_BELL_BYE_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>またねえ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
