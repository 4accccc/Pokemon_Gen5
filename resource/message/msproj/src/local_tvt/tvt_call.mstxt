			<Text>ライバル
</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T02:40:41" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CALL_RIVAL_SP_18"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サザナミタウン　だよ
ヒマなら　くれば？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T12:59:30" />
			<Status>Editing</Status>
