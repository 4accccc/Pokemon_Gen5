	<TextRow
		Label="CALL_RIVAL_BYE_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じゃあなッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T09:56:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
