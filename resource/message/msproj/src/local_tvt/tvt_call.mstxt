				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_RIVAL_SP_20"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいかわらず
？？？に　いるよ▼
オマエは　オマエの
すきに　すれば　いいんじゃない？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-14T05:40:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T02:40:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あいかわらず
ホドモエに　いるよ▼
オマエは　オマエの
好きに　すれば　いいんじゃない？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-14T10:14:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T02:40:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>目的地メッセージ
・クリア後、c05r0501でのライバル戦闘後</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-14T10:14:33" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ライバル
</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T02:40:41" />
		</AttributeCell>
