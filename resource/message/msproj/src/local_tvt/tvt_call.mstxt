	<TextRow
		Label="CALL_STR_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あいてを　えらんでください</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T11:31:03" />
