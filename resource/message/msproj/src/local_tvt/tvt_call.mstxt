				Time="2011-08-29T02:40:41" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="CALL_RIVAL_SP_17"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オレは　どこでも　いいだろ▼
オマエ
ポケモンリーグ　なんだろ？▼
だったら
しょうり　あるのみ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T12:59:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T02:40:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オレは　どこでも　いいだろ▼
オマエ
ポケモンリーグ　なんだろ？▼
だったら
勝利あるのみ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-14T10:13:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T02:40:41" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>目的地メッセージ
・ポケモンリーグ内、クリア前</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T12:54:56" />
		</CommentCell>
		<AttributeCell
