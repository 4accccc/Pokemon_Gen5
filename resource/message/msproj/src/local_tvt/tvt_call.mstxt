				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_RIVAL_SP_24"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>アララギはかせに　よばれたよ▼
だけど　オレ　そんなに
ポケモンずかんを　うめてないし……▼
オマエは　だいじょうぶ　だろ？▼
オレの　かわりに　すごい
ポケモンずかんを　みせておけよッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:48:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:42:48" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>アララギ博士に　呼ばれたよ▼
だけど　オレ　そんなに
ポケモン図鑑を　埋めてないし……▼
オマエは　大丈夫だろ？▼
オレの　代わりに　すごい
ポケモン図鑑を　みせておけよッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:48:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:44:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>未使用</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-24T13:24:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ライバル
</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:27:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_RIVAL_SP_25"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オマエ　しってるか？
２０ばんどうろの　ふしぎなほらあな▼
めずらしい　ポケモンが　いたら
ラッキーだから　いってみろよッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:47:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:43:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オマエ　知ってるか？
２０番道路の　不思議な洞穴▼
珍しい　ポケモンが　いたら
ラッキーだから　いってみろよッ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:47:43" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:44:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>未使用</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-24T13:24:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ライバル
</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:27:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_RIVAL_SP_26"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>シッポウはくぶつかんは　イッシュで
いちばん　ちしきが　あつまる▽
ばしょという　ひとも　いるよな▼
そういえば　さいきん　ふしぎな
ポケモンを　みるって　うわさがある▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:41:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:39:58" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>シッポウ博物館は　イッシュで
一番　知識が　集まる▽
場所という　ひとも　いるよな▼
そういえば　最近　不思議な
ポケモンを　みるって　うわさがある▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:47:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:44:44" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>未使用</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-24T13:24:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ライバル
</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:27:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_RIVAL_SP_27"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タワーオブヘブンの　かね……
かんじょうを　ゆらす　かね　だよな▼
そういえば　さいきん　ふしぎな
ポケモンを　みるって　うわさがある▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:40:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:39:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タワーオブヘブンの　鐘……
感情を　揺らす　鐘だよな▼
そういえば　最近　不思議な
ポケモンを　みるって　うわさがある▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:47:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:44:44" />
		</LanguageCell>
