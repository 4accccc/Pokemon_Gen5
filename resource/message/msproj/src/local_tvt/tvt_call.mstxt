			Name="Character">
			<Text>ライバル
</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:27:03" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#404040</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_RIVAL_SP_29"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ゆめのあとちに　ひきよせられた
まぼろしの　ポケモン……▼
いや　なんでもないから▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:46:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:35:03" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>夢の跡地に　引き寄せられた
幻の　ポケモン……▼
いや　なんでもないから▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:46:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-12-18T09:44:44" />
		</LanguageCell>
