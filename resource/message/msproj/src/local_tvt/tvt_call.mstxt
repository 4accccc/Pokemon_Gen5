				Time="2012-01-07T10:01:01" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData />
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_RIVAL_SP_53"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>オマエ　ゆうえんち　って
すき　だったっけ……？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T10:25:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T10:25:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>オマエ　遊園地って
好き　だったっけ……？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T10:25:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T10:25:39" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>目的地メッセージ
・ライバルが遊園地イベント中
　（クリア後：曜日限定）</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T10:23:45" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ライバル
</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-07T10:01:01" />
