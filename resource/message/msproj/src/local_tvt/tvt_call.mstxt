	<TextRow
		Label="CALL_SECRET_TALK_F_39"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あっ！▼
ごめんなさい　[Name:TrainerName ]くん▼
いまから　しごとが
はじまっちゃう　みたいなの……▼
もう　きらないと……▼
ほんとうに　ごめんなさい……▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-09-06T14:51:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きょうは　いいてんきですね　３９[Ctrl2:PageClear ]</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
