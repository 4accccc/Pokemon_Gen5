			Language="JPN">
			<Comment>２８回目　　　悩み相談８（似合ってる？）。</Comment>
			<CommentModifiedBy
				User="nishino:W00221"
				Time="2011-08-10T06:48:16" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
