	<TextRow
		Label="CALL_SECRET_TALK_20"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName ]さんと
はなしを　していると▽
あっ　と　いうまに▽
じかんが　たっているんだよね▼
サイコーに　たのしいからかな？▼
アハハ！▼
だから　これからも　たくさん
れんらくを　くれると　うれしいな▼
そろそろ　しごとに　もどります！
またね　[Name:TrainerName ]さん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-02T11:17:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName ]さんと
はなしを　していると▽
あっ　と　いうまに▽
時間が　たっているんだよね▼
サイコーに　楽しいからかな？▼
アハハ！▼
だから　これからも　たくさん
連絡を　くれると　うれしいな▼
そろそろ　仕事に　もどります！
またね　[Name:TrainerName ]さん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-02T11:17:32" />
			<Status>Editing</Status>
