	<TextRow
		Label="CALL_SECRET_TALK_50"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おっ　おそくなって　ゴメ……
あっ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-23T10:37:52" />
