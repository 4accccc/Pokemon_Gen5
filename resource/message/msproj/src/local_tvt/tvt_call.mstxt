	<TextRow
		Label="CALL_SECRET_TALK_F_50"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おっ　おそくなって　ごめ……　あっ！</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-09-04T09:26:51" />
