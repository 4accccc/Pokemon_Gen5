				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_SECRET_TALK_F_15"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName ]くんは
ポケモンミュージカルに▽
さんかしたこと　ある？▼
わたしも　いちどで　いいから
かわいい　ポケモンを▽
キュートに　ドレスアップさせて▼
ポケモンミュージカルに
さんか　させて　みたいの▼
おわったら　そのコも
ファンレターとか　もらっちゃって▼
きっと　つぎの　ぶたいへの
はげみに　なったり　するんだよ▼
……　……　……
……　……　……▼
そろそろ　しごとに　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-09-03T12:27:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName ]くんは
ポケモンミュージカルに▽
参加したこと　ある？▼
わたしも　一度で　いいから
可愛い　ポケモンを▽
キュートに　ドレスアップさせて▼
ポケモンミュージカルに
参加させて　みたいの▼
終わったら　そのコも
ファンレターとか　もらっちゃって▼
きっと　次の　舞台への
励みに　なったり　するんだよ▼
……　……　……
……　……　……▼
そろそろ　仕事に　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-09-03T12:27:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>１５回目　　　好きなポケモンについて話してきます。　</Comment>
			<CommentModifiedBy
				User="nishino:W00221"
				Time="2011-08-10T09:33:32" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_SECRET_TALK_F_16"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたし　おやすみの　ひは
よく　さんぽに　でかけるの▼
まわりの　けしきを
のんびり　みてまわる　だけでも▽
いい　きぶんてんかんに　なるんだよ▼
ライブキャスターを　おとしたのも
ライモンシティを▽
さんぽしている　とき　だったから▼
[Name:TrainerName ]くんに　であえたのは
さんぽの　おかげ　かもね▼
……　……　……
……　……　……▼
そろそろ　しごとに　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:15:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたし　お休みの　日は
よく　散歩に　でかけるの▼
周りの　景色を
のんびり　みてまわる　だけでも▽
いい　気分転換に　なるんだよ▼
ライブキャスターを　落としたのも
ライモンシティを▽
散歩している　とき　だったから▼
[Name:TrainerName ]くんに　出会えたのは
散歩の　おかげ　かもね▼
……　……　……
……　……　……▼
そろそろ　仕事に　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:45:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>１６回目　　　休日の過ごし方について話してきます。　</Comment>
			<CommentModifiedBy
				User="nishino:W00221"
				Time="2011-08-10T09:32:50" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_SECRET_TALK_F_17"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたし　よく　ひとと
ポケモンの　こうかんを　するの▼
しごとで　いろんな　ちほうに
いく　ことが　おおいから▽
そのばしょで　であった　ひとたちと▽
きねんに　こうかんしたり　するんだよ▼
いつか　[Name:TrainerName ]くんとも
ポケモンを　こうかん　したい……　かな▼
……　……　……
……　……　……▼
そろそろ　しごとに　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:15:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたし　よく　人と
ポケモンの　交換を　するの▼
仕事で　いろんな　地方に
行く　ことが　多いから▽
その場所で　出会った　人たちと▽
記念に　交換したり　するんだよ▼
いつか　[Name:TrainerName ]くんとも
ポケモンを　交換したい……　かな▼
……　……　……
……　……　……▼
そろそろ　仕事に　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:46:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>１７回目　　　交換と対戦のどちらが好きかについて話してきます。　</Comment>
			<CommentModifiedBy
				User="nishino:W00221"
				Time="2011-08-10T09:32:34" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_SECRET_TALK_F_18"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたし　かっこいいひとに　なるのが
もくひょう　なの▼
みかけ　とかじゃ　なくて
なかみが　かっこいいひと　だよ▼
まだまだ　かっこわるいけど……▼
いまの　しごとを　がんばっていれば
いつか　なれると　おもっているんだ▼
だから　おうえん　してくれると
うれしい……　かな▼
……　……　……
……　……　……▼
そろそろ　しごとに　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:15:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたし　かっこいい人に　なるのが
目標なの▼
みかけ　とかじゃ　なくて
内面が　かっこいい人　だよ▼
まだまだ　かっこわるいけど……▼
今の　仕事を　がんばっていれば
いつか　なれると　思っているんだ▼
だから　応援してくれると
うれしい……　かな▼
……　……　……
……　……　……▼
そろそろ　仕事に　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:46:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>１８回目　　　どんなひとになりたいのかについて話してきます。</Comment>
			<CommentModifiedBy
				User="nishino:W00221"
				Time="2011-08-10T09:31:45" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_SECRET_TALK_F_19"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このあいだ
おとうとが　おとうさんと▽
ポケモンしょうぶを　していたの▼
すごく　たのしそうに
しょうぶを　していたんだよ▼
いっしょに　みていた　いもうとも
うらやましく　なったのか▽
じぶんも　ポケモンが　ほしいって▽
なきだして　たいへん　だったんだから▼
……　……　……
……　……　……▼
そろそろ　しごとに　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:47:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>このあいだ
弟が　お父さんと▽
ポケモン勝負を　していたの▼
すごく　楽しそうに
勝負を　していたんだよ▼
一緒に　みていた　妹も
うらやましく　なったのか▽
自分も　ポケモンが　ほしいって▽
泣きだして　大変だったんだから▼
……　……　……
……　……　……▼
そろそろ　仕事に　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:47:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>１９回目　　　家族構成について話してきます。　</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_SECRET_TALK_F_20"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName ]くんと
おはなしを　していると▽
あっ　と　いうまに▽
じかんが　たっているんだよね▼
たのしすぎるからかな？▼
あはは……▼
だからね　こらからも
たくさん　れんらくを　くれると▽
うれしい……　かな▼
……　……　……
……　……　……▼
そろそろ　しごとに　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:48:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName ]くんと
お話を　していると▽
あっ　と　いうまに▽
時間が　経っているんだよね▼
楽しすぎるからかな？▼
あはは……▼
だからね　こらからも
たくさん　連絡を　くれると▽
うれしい……　かな▼
……　……　……
……　……　……▼
そろそろ　仕事に　もどらなきゃ▼
またね　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:51:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>２０回目　　　主人公との会話（が楽しい事）について話してきます。</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_SECRET_TALK_F_21"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あの……▼
そうだんが　あるんだけど……
きいて　もらえるかな？▼
こい　いろの　くさむらって
みたこと　ある？▼
……　……　……
……　……　……▼
そっか……▼
レベルの　たかい　ポケモンが
とびだして　くるなんて▽
やっぱり　あぶないんだね▼
おとうとや　いもうとに
ちゅういして　おかなきゃ▼
ありがとう　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:52:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あの……▼
相談が　あるんだけど……
きいて　もらえるかな？▼
濃い　色の　草むらって
みたこと　ある？▼
……　……　……
……　……　……▼
そっか……▼
レベルの　高い　ポケモンが
飛びだして　くるなんて▽
やっぱり　危ないんだね▼
弟や　妹に
注意して　おかなきゃ▼
ありがとう　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-29T04:51:58" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>２１回目　　　悩み相談１（強草って危険なの？）。　</Comment>
			<CommentModifiedBy
				User="nishino:W00221"
				Time="2011-08-10T06:46:31" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8080</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="CALL_SECRET_TALK_F_22"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あの……▼
そうだんが　あるんだけど…
きいて　もらえるかな？▼
こんど　いもうとに
ポケモンを　プレゼント　しようと▽
かんがえて　いるんだけど…▼
……　……　……
……　……　……▼
そうだね……▼
やっぱり　はじめての　ポケモンは
[Name:Type Idx="1" ]タイプが　いいのかな？▽
こんど　いもうとと　いっしょに▽
つかまえに　いって　みるね▼
ありがとう　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-09-05T10:54:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>あの……▼
相談が　あるんだけど……
きいて　もらえるかな？▼
今度　妹に
ポケモンを　プレゼント　しようと▽
考えて　いるんだけど…▼
……　……　……
……　……　……▼
そうだね……▼
やっぱり　初めての　ポケモンは
[Name:Type Idx="1" ]タイプが　いいのかな？▽
今度　妹と　一緒に▽
捕まえに　いって　みるね▼
ありがとう　[Name:TrainerName ]くん▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-09-15T14:11:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>２２回目　　　悩み相談２（はじめてのポケモンは何がいい？）。　</Comment>
			<CommentModifiedBy
				User="nishino:W00221"
				Time="2011-08-10T06:46:24" />
		</CommentCell>
		<AttributeCell
