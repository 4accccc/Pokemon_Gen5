	</TextRow>
	<TextRow
		Label="CALL_RIVAL_GREET_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なに？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
