<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_transceiver_r02_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0" ]！▼
ママです
そっちは　どう？▼
ポケモンと　なかよくなって
たびの　たのしさを▽
かみしめている　ころかしら？▼
ちょっと　ようが　あって
れんらく　したんだけど　いちど▽
ライブキャスターを　きるわね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName Idx="0" ]！▼
ママです
そっちは　どう？▼
ポケモンと　仲良くなって
旅の　楽しさを▽
かみしめている　ころかしら？▼
ちょっと　用が　あって
連絡したんだけど　一度▽
ライブキャスターを　きるわね▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>■　r02：２番道路イベント用メッセージ
・ママの口ぱくアニメーション再生
・続けて
・0＝主人公名前</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
