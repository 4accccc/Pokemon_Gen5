<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_transceiver_c04p01_swidolw1_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>あの……　もしもし▼
……　……　……
……　……　……▼
あっ　はい　そうです▼
わたし　その　ライブキャスターの
もちぬし　です……▼
いまは　ふるい　ライブキャスターから
れんらく　して　いるので▽
おんせいのみで　ごめんなさい▼
ひろって　いただいて
ありがとう　ございました▼
じつは……　すぐにでも
うけとりに　いきたいんですけど……▼
わたし　しごとを　していまして
いま　うけとりに　いく　ことが▽
できない　じょうたい　なんです▼
よろしければ　しばらくの　あいだ
その　ライブキャスターを▽
あずかって　もらえないでしょうか？▼
……　……　……
……　……　……▼
えっ　いいんですか？
ありがとう　ございます▼
わたしは　○○……▼
いえ……　◎◎◎◎◎って　いいます▼
あなたは？▼
はい　[Name:TrainerName ]さん　ですね▼
しごとが　おちついたら
うけとりに　いきますので▽
しばらくの　あいだ▽
よろしく　おねがいします▼</Text>
			<TextModifiedBy
				User="nishino:W00221"
				Time="2011-10-22T09:31:22" />
