<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_transceiver_r07_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ママだけど
いま　どこ？▼
……　……　……
……　……　……▼
へえ！　７ばんどうろ！
すごいじゃない！▼
どう？
ポケモンとは　なかよし？▼
いろんな　ところに　いけるのは
ポケモンと　いっしょ　だからよ▼
だから　いつも　かんしゃして
きずついたら　すぐに▽
ポケモンセンターに　いくのよ！▼
いじょう　ポケモンセンターで
うけつけを　していた▽
ママ　からでした！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T07:50:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ママだけど
いま　どこ？▼
……　……　……
……　……　……▼
へえ！　７番道路！
すごいじゃない！▼
どう？
ポケモンとは　仲良し？▼
いろんな　ところに　行けるのは
ポケモンと　いっしょ　だからよ▼
だから　いつも　感謝して
きずついたら　すぐに▽
ポケモンセンターに　行くのよ！▼
以上　ポケモンセンターで
受付を　していた▽
ママ　からでした！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T07:51:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>■　r07：７番道路用メッセージ
・TVトランシーバー終了処理
・フィールドに復帰する</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T07:52:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T07:41:51" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
