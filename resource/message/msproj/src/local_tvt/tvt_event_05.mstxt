	<TextRow
		Label="msg_transceiver_c08_swrival_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName ]！
いま　どこだッ？▼
エッ　ソウリュウ！？▼
そっちに　こおりの　かたまり
とんでいったろ！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T14:12:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T08:09:01" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Name:TrainerName ]！
いま　どこだッ？▼
エッ　ソウリュウ！？▼
そっちに　氷の　塊
飛んでいったろ！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-11T14:12:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T08:13:55" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>■　d03r0101：リゾートデザートイベント用メッセージ
・ライバルの口ぱくアニメーション再生
・続けて</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-07T10:29:25" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ライバル</Text>
