				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ストレンジャーハウス</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:29:36" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
