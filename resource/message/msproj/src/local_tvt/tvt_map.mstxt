				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_077"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ライモンシティは　ごらくの　まち！▼
あそこの　ポケモンセンターでの
おしごとも　たのしかったわね▼
えーとね▼
ビッグスタジアム　リトルコートで
きたえる　トレーナーが　おおいわよ！▼
ほかにも　みどころが　たくさんね
あなたの　すきに　してみなさい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:47:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ライモンシティ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ライモンシティ
※重複</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:47:37" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_078"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ホドモエシティ！▼
ちかごろは　ホテルが
いっぱい　たちならぶんでしょ？▼
それいがいは
あまり　しらないなあ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:47:30" />
			<Status>Editing</Status>
