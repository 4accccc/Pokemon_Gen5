			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_018"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へえ！　４ばんどうろ！
あそこも　たいへん　なのよ▼
かいはつこうじを　すすめたり
いせきが　みつかったり▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:03:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>４番道路</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
