				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_016"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>２ばんどうろ　ね……▼
なんとなくだけど
だんさが　あったわ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T02:27:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>２番道路　ね……▼
なんとなくだけど
段差が　あったわ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-13T05:32:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
