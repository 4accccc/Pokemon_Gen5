	<TextRow
		Label="MAP_STR_025"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１１ばんどうろも
１４ばんどうろと　おなじで▽
たきのぼり　よね！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
