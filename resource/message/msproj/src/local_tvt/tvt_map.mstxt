	</TextRow>
	<TextRow
		Label="MAP_STR_037"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>れいとうコンテナ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
