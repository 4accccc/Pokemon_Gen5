	<TextRow
		Label="MAP_STR_119"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タチワキシティ！▼
ライブハウスに　いった！？▼
さいきん　ホミカちゃんの
バンドが　おきにいり　なのよ！▼
だって　きいていると
げんきいっぱいに　なれるでしょ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-13T09:22:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タチワキシティ！▼
ライブハウスに　行った！？▼
最近　ホミカちゃんの
バンドが　お気に入り　なのよ！▼
だって　聴いていると
元気いっぱいに　なれるでしょ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-14T02:55:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>タテワキシティ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
