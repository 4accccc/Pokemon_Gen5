			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_087"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょっと　こえが　とおいけど……▼
ネジやま？▼
なっとく！　ヤーコンさんの
やま　なのよねー▼
カセキが　みつかる　ばしょって
ママは　きいてるわ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:23:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ネジ山</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
