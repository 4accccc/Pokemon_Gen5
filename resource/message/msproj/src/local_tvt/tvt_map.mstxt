				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_131"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくじょう　ね！▼
ちいさいころの　ママったら
そこで　ポケモンを　のりまわして▽
すっごく　おこられたらしいわ！▼
うん　こどもの　ときだから
ぜんぜん　おぼえていないの！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T02:33:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>牧場　ね！▼
小さいころの　ママったら
そこで　ポケモンを　乗り回して▽
すっごく　怒られたらしいわ！▼
うん　子供の　ときだから
全然　覚えていないの！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-13T07:08:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>サンギぼくじょう</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:28:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-20T06:13:07" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_132"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タチワキコンビナート？
なあに　おしごとの　おてつだい？▼
それにしても　おもいだすわね
やけいが　きれいなの　そこ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T02:33:28" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タチワキコンビナート？
なあに　お仕事の　お手伝い？▼
それにしても　思い出すわね
夜景が　きれいなの　そこ▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-13T07:09:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
