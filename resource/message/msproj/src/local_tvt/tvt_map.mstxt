	<TextRow
		Label="MAP_STR_046"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……えっ　どこにいるの？▼
Ｎのしろ？▼
ゴメンね……
ママ　よく　わからない</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:09:04" />
