				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_009"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒウンシティ！
もう　みどころが　ありすぎて▼
かんこうあんないの　ひとに
きいてみるのが　いいかもね▼
あとは……
じぶんで　たんけんよ！▼
しらない　まちに　ついたときの
たのしみの　いちばんは　たんけん！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T11:55:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒウンシティ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ヒウンシティ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_010"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ライモンシティは　ごらくの　まち！▼
あそこの　ポケモンセンターでの
おしごとも　たのしかったわね▼
えーとね▼
ビッグスタジアム　リトルコートで
きたえる　トレーナーが　おおいわよ！▼
ほかにも　みどころが　たくさんね
あなたの　すきに　してみなさい！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:57:24" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ライモンシティ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ライモンシティ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_011"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ホドモエシティ！▼
ちかごろは　ホテルが
いっぱい　たちならぶんでしょ？▼
それいがいは
あまり　しらないなあ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:58:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
