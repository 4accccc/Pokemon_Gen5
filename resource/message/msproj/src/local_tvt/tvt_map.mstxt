				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_014"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ソウリュウシティ！
いい　まちよ▼
あたしが　きいた　はなしだと
しちょうの　シャガさんが▼
ドラゴンタイプの　すごい
わざを　おしえてくださるって！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-13T06:14:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ソウリュウシティ！
良い　街よ▼
あたしが　きいた　話だと
市長の　シャガさんが▼
ドラゴンタイプの　すごい
技を　教えてくださるって！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T13:34:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ソウリュウシティ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
