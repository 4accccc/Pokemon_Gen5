	<TextRow
		Label="MAP_STR_086"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なあに？　なんだか
キーン　っておとも　するけど……▼
えっ　でんきいしのほらあな？▼
へー　ライブキャスターが
つうじるんだ！　はじめてしったわ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:23:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>電気石の洞穴</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>電気石の洞穴
※重複</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:23:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
