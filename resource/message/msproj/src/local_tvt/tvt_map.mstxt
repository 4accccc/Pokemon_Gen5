			<Comment>白の樹洞</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:34:36" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
