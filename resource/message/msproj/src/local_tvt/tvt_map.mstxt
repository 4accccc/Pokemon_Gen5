	<TextRow
		Label="MAP_STR_130"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ヒウンげすいどう▼
いいかえれば
ヒウンシティの　げすいどう　ね▼
ごめんなさい
あることは　しっているけれど▽
いったことは　ないのよ▼
だけど　きいて！▼
げすいどうの　さきに
ひみつのばしょが　あるって　ウワサよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:48:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ヒウン下水道（仮）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ヒウンげすいどう</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:28:44" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_131"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくじょう　ね！▼
ちいさいころの　ママったら
そこで　ポケモンを　のりまわして▽
すっごく　おこられたらしいわ！▼
うん　こどもの　ときだから
ぜんぜん　おぼえていないの！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:50:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>牧場（仮）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>サンギぼくじょう</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:28:52" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_132"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タチワキコンビナート？
なあに　おしごとの　おてつだい？▼
それにしても　おもいだすわね
やけいが　きれいなの　そこ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>コンビナート（仮）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>タチワキコンビナート</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:29:00" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_133"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>リバースマウンテン！▼
そこで　ちからつきて
ポケモンセンターに　くる▽
トレーナーも　おおかったわ！▼
あなたも　きをつけてね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:33:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>火山（仮）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>リバースマウンテン</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:29:33" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_134"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ストレンジャーハウス！？▼
しってる　しってる！▼
リバースマウンテンちかく　の
ミステリースポット　でしょ！▼
……もしかしたら
ゆうれいに　あえるかも！？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:30:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ミステリーハウス（仮）</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ストレンジャーハウス</Comment>
			<CommentModifiedBy
