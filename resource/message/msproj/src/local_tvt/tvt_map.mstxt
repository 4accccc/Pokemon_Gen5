				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_143"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こころのくうどう　ね……▼
なにかが　いるだろう……
そういわれても　なにもいない▽
ふしぎな　ばしょ　らしいわね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:41:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>鏡の洞くつ（仮）</Text>
