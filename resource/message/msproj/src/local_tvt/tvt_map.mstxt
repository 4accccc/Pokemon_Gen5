	</TextRow>
	<TextRow
		Label="MAP_STR_117"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいていいせき！▼
なぞの　こだいもじ！▼
ひみつを　ときあかしたら
ママにも　おしえてね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:25:47" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>海底遺跡</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>海底遺跡</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_118"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ええ？
ヒオウギに　いるの！▼
だったら　かえってくれば
いいじゃない！　じぶんの　いえよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:26:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ええ？
ヒオウギに　いるの！▼
だったら　かえってくれば
いいじゃない！　じぶんの　いえよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:26:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ヒオウギシティ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_119"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>タテワキシティ！▼
ライブハウスに　いった！？▼
さいきん　ホミカちゃんの
バンドが　おきにいり　なのよ！▼
だって　きいていると
げんきいっぱいに　なれるでしょ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:55:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タテワキシティ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>タテワキシティ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_120"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まっ！セイガイハシティ　なの？▼
イッシュちほうでも
とびっきりの　リゾートね！▼
ママ　あそこの　ポケモンセンターには
ちょっとの　あいだしか　いなかったの</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:52:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>セイガイハシティ</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>セイガイハシティ</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_121"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポケウッド　ですって！▼
なあに　あなた
えいがに　でるの！？▽
じゃあ　ＤＶＤを　かわないとね！▼
あっ　アドバイスよ！
えんぎは　しぜんたい　でね！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:53:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
