				Time="2012-01-20T06:13:07" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_136"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なあに？
プラズマフリゲート？▼
しらないわねえ▼
ママも　いって　どんな　ばしょか
みておいたほうが　いいかな？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T02:33:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なあに？
プラズマフリゲート？▼
知らないわねえ▼
ママも　行って　どんな　場所か
みておいたほうが　いいかな？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-13T07:12:30" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
