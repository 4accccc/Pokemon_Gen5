				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_032"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>１８ばんどうろ！▼
あそこの　とくちょうって……▼
なにが　あったかしら？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-13T02:28:33" />
			<Status>Editing</Status>
