	<TextRow
		Label="MAP_STR_005"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へー　カノコタウン？
じゃあ　ポケモンけんきゅうじょ　ね？▼
それとも　ママの　おともだちの
いえに　あそびに　いくのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:26:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>へー　カノコタウン？
じゃあ　ポケモンけんきゅうじょ　ね？▼
それとも　ママの　おともだちの
いえに　あそびに　いくのかな？</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:26:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カノコタウン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_006"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カラクサタウン！▼
だれかが　かなでていた
がっきの　ねいろを　おもいだすわ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T12:28:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カラクサタウン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カラクサタウン</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
