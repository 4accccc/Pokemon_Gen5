				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Importance">
			<Text>B</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-01-20T06:12:47" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_018"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へえ！　４ばんどうろ！
あそこも　たいへん　なのよ▼
かいはつこうじを　すすめたり
いせきが　みつかったり▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:03:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>へえ！　４番道路！
あそこも　大変　なのよ▼
開発工事を　進めたり
遺跡が　みつかったり▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-13T05:36:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
