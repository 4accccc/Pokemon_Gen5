	<TextRow
		Label="MAP_STR_105"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>カゴメタウン　かあ▼
いったときの　いんしょうだと
ひると　よるとで▽
ぜんぜん　ちがう　まち　だったわ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:50:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>カゴメタウン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>カゴメタウン
※重複</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:49:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-09T10:26:51" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="MAP_STR_106"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サザナミタウンね▼
むかしは　すっごい
おかねもちが　いたんだけど▽
ひっこし　なさったらしいわね▼
それから　べっそうも　へって
ちょっと　さみしい　はなしね</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-12T13:50:04" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>サザナミタウン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
