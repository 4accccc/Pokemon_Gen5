<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_transceiver_c03p07_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ねえねえ　いま　どこお？▼
おねがいが　あるんだけど
ポケモンしょうぶ　しようよ！▼
アイリスちゃんに
きたえて　もらって▽
ちょっとは　つよくなったんだよ▼
もう　ポケモンを
まもれる　はずだから……▼
じゃあ　４ばんどうろに　つながる
ゲートで　まちあわせ　しようね▼
それだけ　なんだけど
じゃあ　またねえ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ねえねえ　今　どこお？▼
お願いが　あるんだけど
ポケモン勝負　しようよ！▼
アイリスちゃんに
鍛えて　もらって▽
ちょっとは　強くなったんだよ▼
もう　自分の　ポケモンを
守れる　はず　だから……▼
じゃあ　４番道路に　つながる
ゲートで　待ち合わせ　しようね▼
それだけ　なんだけど
じゃあ　またねえ▼</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>■　c03p07：ヒウンシティイベント用メッセージ
・サポートの口ぱくアニメーション再生
・続けて</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>友達♀
ベル</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</AttributeCell>
	</TextRow>
</MessageStudioText>