	<TextRow
		Label="SHINKA_STR_001"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>このコが　しんかする　ほうほうは
まだ　はっけんされて　いないわね▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-22T11:42:53" />
