<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="msg_transceiver_c13_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ママだけど
いま　どこ？▼
タチワキ　なんだ！▼
じゃあ　きいた？▼
ポケウッドって　あるんだけど
おきゃくさんの　うけいれを▽
さいかい　したんだって！▼
タチワキシティなら
ちかくだから　いってみたら？▼
きっと　いまよりも
ポケモンと　なかよく　なれるわ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T07:58:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ママだけど
いま　どこ？▼
タチワキ　なんだ！▼
じゃあ　きいた？▼
ポケウッドって　あるんだけど
お客さんの　受け入れを▽
再開したんだって！▼
タチワキシティなら
近くだから　いってみたら？▼
きっと　今よりも
ポケモンと　仲良く　なれるわ！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T07:58:34" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:07" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>■　c13：タチワキ用メッセージ
・TVトランシーバー終了処理
・フィールドに復帰する</Comment>
			<CommentModifiedBy
				User="matsumiya:W00224"
				Time="2011-09-21T07:55:32" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>主人公ママ</Text>
