	<TextRow
		Label="mes_earth_03_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ポイントのうえで　Ｘボタンを　おすと
ちめいを　ひょうじ　します</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ポイントのうえで　Ｘボタンを　押すと
地名を　表示　します</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
