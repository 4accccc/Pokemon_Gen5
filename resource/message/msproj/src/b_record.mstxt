	<TextRow
		Label="msg_record_04_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>バトルビデオに　きろくちゅう　です！
でんげんを　きらないでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>バトルビデオに　記録中です！
電源を　切らないでください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
