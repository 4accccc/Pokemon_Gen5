				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_record_05_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>たたかいが　きろく　されました！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>戦いが　記録されました！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
