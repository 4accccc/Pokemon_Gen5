	<TextRow
		Label="msg_record_03_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんかいの　バトルビデオを　けして
うわがき　しても　よろしいですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
