		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>不具合により
記録できませんでした</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
