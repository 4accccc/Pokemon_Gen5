	<TextRow
		Label="DM_MSG_MATCH002"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こになる　Xボタン</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:06" />
			<Status>Editing</Status>
