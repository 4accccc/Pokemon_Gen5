	<TextRow
		Label="DEB_COMM_MENU_STR_30"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まえに　かかれた　レポートに
うえから　かいても　いいですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:06" />
