	<TextRow
		Label="DEB_COMM_MENU_STR_20"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ここまでの　かつやくを
ポケモンレポートに　かきこみます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:06" />
