	<TextRow
		Label="DEBUG_BEACON_STR_00"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ともだちコードを　むせんで　おくります
どうしますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>友達コードを　無線で　送ります
どうしますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:05" />
		</LanguageCell>
		<AttributeCell
			Name="Width">
			<Text>256</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:05" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="DEBUG_BEACON_STR_01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Name:TrainerName Idx="0"]を　はっけん！
ともだちコードに　ついかしました！</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
