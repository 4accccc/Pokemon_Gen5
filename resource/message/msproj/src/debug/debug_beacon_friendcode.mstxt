	</TextRow>
	<TextRow
		Label="DEBUG_BEACON_STR_02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すでに　つうしんしています
せつだんしてから　おこなってください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:05" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すでに　通信しています
切断してから　行ってください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:05" />
			<Status>Editing</Status>
