	<TextRow
		Label="LIVE_STR_07"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さんか　ポケモンの
とうろくを　やめますか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
