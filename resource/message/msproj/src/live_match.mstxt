	<TextRow
		Label="LIVE_STR_28"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つうしん　たいきちゅう　です……
しばらく　おまちください</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:22" />
