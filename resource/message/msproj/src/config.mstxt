				Time="2011-05-20T09:30:20" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="mes_config_comment02"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せんとうのとき　ポケモンの　わざの
アニメを　みるかどうか　えらべます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>戦闘のとき　ポケモンの　技の
アニメを　みるかどうか　選べます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>「戦闘アニメ」の解説文</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="mes_config_comment03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶの　ルールを
えらぶことが　できます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
