	<TextRow
		Label="mes_config_comment01"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>メッセージの　はやさを
３しゅるいから　えらべます</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:20" />
