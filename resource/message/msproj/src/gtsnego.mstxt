	<TextRow
		Label="GTSNEGO_047"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ｗｉ－Ｆｉコネクション　から
せつだん　しても　よろしいですか？</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
			<Status>Editing</Status>
			<StatusModifiedBy
