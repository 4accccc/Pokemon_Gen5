	<TextRow
		Label="INF_LOSE_MSG_TRID_651"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すっごい　つよいね！
うーん　すきに　なっちゃいそう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-30T08:59:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すっごい　強いね！
うーん　好きに　なっちゃいそう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-30T09:00:14" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ナース 女 ― 1～10階
　あら？　ポケモンが　おつかれね
　かいふくして　あげましょうか</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-30T09:28:26" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_652"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>おみごと！　それじゃ　さっそく
ポケモンを　みせてちょうだい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-30T09:03:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>お見事！　それじゃ　さっそく
ポケモンを　みせてちょうだい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-30T09:03:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
