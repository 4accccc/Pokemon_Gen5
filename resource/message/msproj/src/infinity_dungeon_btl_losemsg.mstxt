				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_303"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それじゃ　いつでも　はなしかけてね
いっかいだけ　かいふくしてあげる！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T02:14:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それじゃ　いつでも　話しかけてね
一回だけ　回復してあげる！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T02:14:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
