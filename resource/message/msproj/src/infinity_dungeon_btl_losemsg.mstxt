	<TextRow
		Label="INF_LOSE_MSG_TRID_252"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つよくなる！　そのおもいが　あれば
いつか　おまえにだって　かてるはずだ▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-10T10:50:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
