	<TextRow
		Label="INF_LOSE_MSG_TRID_326"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まったく！　おさいふが　おもたくて
たいへんなのです！　いやになるわ！▼</Text>
