	<TextRow
		Label="INF_LOSE_MSG_TRID_411"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はっくしょん！
……ちょっと　れいぼう　ききすぎだぜ▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T03:23:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>はっくしょん！
……ちょっと　冷房が　効きすぎだぜ▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T03:23:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>たんパンこぞう 男 b 61～70階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_412"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>す　すこしは　てかげんしてくれよ！
せんぱいは　たてるものだぞ！▼</Text>
			<TextModifiedBy
