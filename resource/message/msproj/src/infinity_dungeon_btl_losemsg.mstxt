	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_558"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>へっ！　あんたの　そいつらを
しんらいする　きもちに　まけたぜ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
