	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_302"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うーん　すきに　なっちゃいそう！
いってくれれば　かいふく　するよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T01:59:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うーん　好きに　なっちゃいそう！
言ってくれれば　回復するよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T02:00:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
