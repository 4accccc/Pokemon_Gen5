				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_657"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>さ～って！　わたしに　はなしかけて
ひとときの　いやしを　あじわってね▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>さ～って！　わたしに　話しかけて
一時の癒しを　味わってね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
