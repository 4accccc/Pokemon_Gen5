				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_307"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げんえきトレーナーには　かなわないか
どれ　ちりょうしてやる　みせてみな！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T02:33:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>現役トレーナーには　かなわないか
どれ　治療してやる　見せてみな！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T02:34:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ドクター 男 </Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
