	<TextRow
		Label="INF_LOSE_MSG_TRID_539"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけちった……
うちゅう……いってみたいなぁ▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T05:24:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けちった……
宇宙……行ってみたいなぁ▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T05:24:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バックパッカー 女 b 81～90階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_540"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もっと　じつりょくつけてから
うえを　めざすことにするわ……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T05:24:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もっと　実力つけてから
上を　目指すことにするわ……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T05:24:39" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バックパッカー 女 b 81～90階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_541"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ながかった　たんけんも　もうおわり！
そうおもうと　ちょっと　さびしいね▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>長かった　探検も　もう終わりだ！
そう思うと　ちょっと　寂しいね▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w 91～100階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_542"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうしたら　そこまで
つよくなれると　いうのだ……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どうしたら　そこまで
強くなれると　いうのだ……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w 91～100階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_543"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いてて……かむなって！
ほらっ　みんな　かえるぞ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いてて……かむなって！
ほらっ　みんな　帰るぞ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>だいすきクラブ 男 w 91～100階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_544"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そんなポケモン　みたことない……
まだまだ　せかいは　ひろいのね</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そんなポケモン　みたことない……
まだまだ　世界は　広いのね</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
