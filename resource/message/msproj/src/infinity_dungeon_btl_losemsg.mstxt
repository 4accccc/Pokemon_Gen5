				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_312"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それじゃ　わたしに　こえを　かけてね
たっぷり　かいふく　してあげるから！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-19T10:09:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それじゃ　わたしに　声をかけてね
たっぷり　回復してあげるから！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-19T10:09:02" />
			<Status>Editing</Status>
