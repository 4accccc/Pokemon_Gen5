	<TextRow
		Label="INF_LOSE_MSG_TRID_370"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きたいどおりの　しびれる　たたかい！
うふふっ！　また　やろうね！▼</Text>
