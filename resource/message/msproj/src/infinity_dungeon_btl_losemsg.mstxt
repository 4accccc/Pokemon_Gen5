				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_060"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごい！　あなたみたいな　タイプは
はじめて　みたかも！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T09:13:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごい！　あなたみたいな　タイプは
初めて　見たかも！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-04T10:16:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
