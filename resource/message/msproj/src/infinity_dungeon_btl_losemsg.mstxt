	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_556"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>とめてくれてありがとう！
たまに　われを　わすれちゃうのよね！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>止めてくれてありがとう！
たまに　我を　忘れちゃうのよね！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
