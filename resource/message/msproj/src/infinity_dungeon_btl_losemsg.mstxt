	<TextRow
		Label="INF_LOSE_MSG_TRID_034"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ああっ！　あなたの　やさしいこころが
わたしの　なかに　ながれこんでくる！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T08:33:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ああっ！　あなたの　優しい心が
わたしの中に　流れ込んでくる！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T08:34:17" />
			<Status>Editing</Status>
