				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_057"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>もう　２ねんも　このエリアにいるぞ
さいのう　ないのかな　おれ……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T09:02:10" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>もう２年も　このエリアにいるぞ
才能ないのかな　おれ……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T09:02:15" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
