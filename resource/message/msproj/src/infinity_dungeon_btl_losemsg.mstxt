	<TextRow
		Label="INF_LOSE_MSG_TRID_595"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そっか　きみも　ひとりじゃないんだ！
いいこ　たちを　つれてるね！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そっか　きみも　一人じゃないんだ！
いい子たちを　連れてるね！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
