				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_308"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>その　かがやかしい　いのちを
ちりょうさせて　もらおうかな！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T02:42:37" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その　輝かしい命を
治療させて　もらおうかな！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-19T10:08:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
