				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_310"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>けんさ　しゅうりょう！
どれ　ポケモンたちを　みせてみなさい▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-15T02:24:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>検診終了！
どれ　ポケモンたちを　見せてみなさい▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-15T02:24:44" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ドクター 男 </Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-01T09:20:25" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_311"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よし！　おつかれの　ポケモンを
みせてくれ　かいふくさせてもらうよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T03:36:38" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>よし！　お疲れの　ポケモンを
見せてくれ　回復させてもらうよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T03:36:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
