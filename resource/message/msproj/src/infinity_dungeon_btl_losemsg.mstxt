				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_644"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>その　かがやかしい　いのちを
ちりょうさせて　もらおうかな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:45:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>その　輝かしい命を
治療させて　もらおうかな！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:45:46" />
			<Status>Editing</Status>
			<StatusModifiedBy
