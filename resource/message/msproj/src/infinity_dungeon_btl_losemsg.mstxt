				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>うーん　好きに　なっちゃいそう！
いってくれれば　回復するよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-08T06:10:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ナース 女 ― 1～10階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_652"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それじゃ　いつでも　はなしかけてね
いっかいだけ　かいふくしてあげる！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それじゃ　いつでも　話しかけてね
一回だけ　回復してあげる！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ナース 女 ― 11～20階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_653"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わたしが　ちりょうするのに
ふさわしいトレーナーの　ようね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わたしが　治療するのに
ふさわしいトレーナーの　ようね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ナース 女 ― 21～30階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_654"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけたわ　やくそくどおり　
かいふくしたいなら　こえを　かけて▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けたわ　約束どおり
回復したいなら　声を　かけて▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ナース 女 ― 31～40階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_655"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶの　あとは　かいふくコーナー
おたのしみにね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>勝負の後は　回復コーナー！
お楽しみにね！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ナース 女 ― 41～50階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_656"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>それじゃ　わたしに　こえを　かけてね
たっぷり　かいふく　してあげるから！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>それじゃ　わたしに　声をかけてね
たっぷり　回復してあげるから！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:46:54" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ナース 女 ― 51～60階</Comment>
