	<TextRow
		Label="INF_LOSE_MSG_TRID_377"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんてこった　まけちまった！
オレの　やぼうも　ここまでか……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T06:17:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんてこった　歯が立たねぇ！
オレの　野望も　ここまでか……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T06:17:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>スキンヘッズ 男 w 61～70階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_378"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しつれいしました……
かんべん　してください……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-11T02:45:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>失礼しました……
勘弁　してください……▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-11T02:45:22" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>スキンヘッズ 男 w 61～70階</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:47:24" />
		</CommentCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_379"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>サンキュー！　かなり　なごめたぜ！
さーて　みまわり　がんばるか！▼</Text>
			<TextModifiedBy
