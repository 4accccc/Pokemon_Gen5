				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_059"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いい　きぶんてんかんに　なったわ！
また　たんさくに　もどりましょっと！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T09:05:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いい気分転換に　なったわ！
また　探索に　戻りましょっと！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-19T09:06:59" />
			<Status>Editing</Status>
