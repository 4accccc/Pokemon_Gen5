				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_058"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふぅ！　いちど　そとにでて
にっこうよくでも　してくるかな？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T09:03:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ふぅ！　一度　外に出て
日光浴でも　してくるかな？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-14T09:03:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>バックパッカー 男 b</Comment>
			<CommentModifiedBy
				User="swan_scenario:W00293"
