	<TextRow
		Label="INF_LOSE_MSG_TRID_311"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>はくりょくある　こうげきだったな！
うぉー！　もえてきたぜっ！▼</Text>
