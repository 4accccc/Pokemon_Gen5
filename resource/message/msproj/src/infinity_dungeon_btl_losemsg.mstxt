	<TextRow
		Label="INF_LOSE_MSG_TRID_205"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どうも　どうくつに　はいっていると
じかんの　かんかくが　なくなるね</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-10T03:42:19" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T05:30:04" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どうも　洞穴に　入っていると
