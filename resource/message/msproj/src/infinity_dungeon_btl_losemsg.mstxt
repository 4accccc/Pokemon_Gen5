	<TextRow
		Label="INF_LOSE_MSG_TRID_598"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くぅ！　ちょうじょう　まぎわで
こんな　やつに　でくわすなんて！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-08-09T02:29:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
