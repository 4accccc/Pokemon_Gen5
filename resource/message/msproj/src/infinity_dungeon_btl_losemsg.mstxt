	<TextRow
		Label="INF_LOSE_MSG_TRID_638"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まったく！　おさいふが　おもたくて
たいへんなのです！　いやになるわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:44:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まったく！　お財布が　重たくて
大変なのです！　いやになるわ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:44:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
