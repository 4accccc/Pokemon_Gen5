				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_632"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まだまだ　のびるな　きみは！
しばらく　しゅぎょうを　するといい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:44:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>まだまだ　伸びるな　きみは！
しばらく　修行を　するといい！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:44:03" />
			<Status>Editing</Status>
			<StatusModifiedBy
