	<TextRow
		Label="INF_LOSE_MSG_TRID_613"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うん！　いいかんじに　そだってるわ！
しゅぎょう　がんばってるみたいね！▼</Text>
