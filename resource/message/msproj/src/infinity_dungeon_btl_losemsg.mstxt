	<TextRow
		Label="INF_LOSE_MSG_TRID_642"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみの　かちだ！
はやく　ポケモンを　みせたまえ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:45:35" />
