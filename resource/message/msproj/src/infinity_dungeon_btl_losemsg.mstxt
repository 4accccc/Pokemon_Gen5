	<TextRow
		Label="INF_LOSE_MSG_TRID_299"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>けっこんよりも　ぼうけん！
それに　ポケモンしょうぶよね！▼</Text>
