				Time="2011-05-20T09:30:21" />
		</AttributeCell>
	</TextRow>
	<TextRow
		Label="INF_LOSE_MSG_TRID_653"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>なんて　ゆうかんな　ポケモンたち！
わたしの　まけね！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-01T02:49:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>なんて　勇敢な　ポケモンたち！
わたしの　負けね！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-01T02:49:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
