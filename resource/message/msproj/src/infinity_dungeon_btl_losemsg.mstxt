	<TextRow
		Label="INF_LOSE_MSG_TRID_631"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かいしゃを　つくってみたら　どうだ？
きみなら　せいこう　まちがいなしだ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:43:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>会社を　作ってみたら　どうだ？
きみなら　成功　間違いなしだぞ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:43:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
