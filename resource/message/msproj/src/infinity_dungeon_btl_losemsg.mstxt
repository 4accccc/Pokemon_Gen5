	<TextRow
		Label="INF_LOSE_MSG_TRID_622"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゃこうかいじゃ　こんなに　うまく
たたかえるひとは　いないよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:41:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>社交界じゃ　こんなに　うまく
戦える人は　いないよ！▼</Text>
			<TextModifiedBy
				User="nakamura_akira:W00280"
				Time="2011-08-04T05:41:49" />
			<Status>Editing</Status>
