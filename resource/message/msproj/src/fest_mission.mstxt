				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_fm_explain_evt_02">
		<LanguageCell
			Language="JPN">
			<Text>くさむらに　かくれている
タマゲタケを　さがせ！
モンスターボールのような
みためを　しているぞ！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:32:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:30:52" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>くさむらに　かくれている
タマゲタケを　さがせ！
モンスターボールのような
みためを　しているぞ！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:42:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
