	</TextRow>
	<TextRow
		Label="msg_fm_explain_npc_05"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Digit:4digits Idx="1" ]にんいじょうと
どうぐを　こうかんしよう！
まちや　みちにいる
おじょうさまに　はなしかけよう！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-28T08:22:56" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T10:51:19" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Digit:4digits Idx="1" ]人以上と
道具を　交換しよう！
街や　道にいる
お嬢様に　話しかけよう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-29T03:47:12" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:42:00" />
		</LanguageCell>
		<CommentCell
