	<TextRow
		Label="msg_fm_explain_evt_01">
		<LanguageCell
			Language="JPN">
			<Text>タワーオブヘブンの　てっぺんにある
かねを　ならせ！
いりぐちから　やりなおせば
なんどでも　カウント！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-09-21T14:18:23" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:23:21" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>タワーオブヘブンの　てっぺんにある
かねを　ならせ！
いりぐちから　やりなおせば
なんどでも　カウント！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-09-21T14:18:26" />
