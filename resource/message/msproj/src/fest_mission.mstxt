	<TextRow
		Label="msg_fm_explain_npc_13">
		<LanguageCell
			Language="JPN">
			<Text>くろふくの　おとこ　ふたたび！
とっても　きちょうな　どうぐを
かって　かって　かいまくれ！
ただし　ねだんには　ちゅうい！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T11:45:48" />
			<Status>Editing</Status>
