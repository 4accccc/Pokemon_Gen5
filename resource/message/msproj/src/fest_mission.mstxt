	<TextRow
		Label="msg_fm_explain_npc_12">
		<LanguageCell
			Language="JPN">
			<Text>まちや　みちにいる
けんきゅういんに　はなしかけて
ポケモンクイズに　こたえよう！
トレーナーの　ちしきが　ためされる！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T11:38:01" />
			<Status>Editing</Status>
