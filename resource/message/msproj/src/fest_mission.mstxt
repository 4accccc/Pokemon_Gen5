			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T11:22:26" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミッション説明文（配信）</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T11:22:28" />
		</CommentCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_fm_explain_item_12">
		<LanguageCell
			Language="JPN">
			<Text>きのみを　さがしに
いろんな　ばしょへ　でかけよう！
もりや　ほらあなの　キラキラひかる
ばしょを　さがしてみよう！</Text>
