		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミッション説明文
※通常隠し穴</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2012-01-28T13:05:07" />
		</CommentCell>
		<ExtraCell
