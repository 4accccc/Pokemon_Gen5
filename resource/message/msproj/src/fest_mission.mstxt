				Time="2011-08-26T12:42:00" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ミッション説明文（配信）</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:08:53" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミッション説明文（配信）</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:42:00" />
		</CommentCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_fm_explain_npc_13"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろふくの　おとこ　ふたたび！
とっても　きちょうな　どうぐを
かって　かって　かいまくれ！
ただし　ねだんには　ちゅうい！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T11:45:48" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T11:00:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>黒い服の男　再び！
とっても　貴重な　道具を
買って　買って　買いまくれ！
ただし　値段には　注意！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-28T00:41:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:42:00" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ミッション説明文（配信）</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T12:18:08" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミッション説明文（配信）</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T12:18:10" />
		</CommentCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_fm_explain_npc_14"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ベテラントレーナーとの
おわりなき　しゅぎょうに　いどめ！
せいげんじかんないに
[Digit:4digits Idx="1" ]にんいじょう　たおせ！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-28T00:43:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T11:34:57" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ベテラントレーナーとの
終わりなき　修行に　挑め！
制限時間内に
[Digit:4digits Idx="1" ]人以上　倒せ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-29T03:46:27" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T11:34:57" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ミッション説明文（配信）</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T12:18:08" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミッション説明文（配信）</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T12:18:10" />
		</CommentCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#8080ff</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
