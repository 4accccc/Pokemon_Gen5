			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_fm_explain_npc_06b"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Digit:4digits Idx="1" ]にんいじょうと
どうぐを　こうかんしよう！
せかいの　かくちを　たびする
バックパッカーに　はなしかけよう！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-28T08:22:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T11:00:07" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>[Digit:4digits Idx="1" ]人以上と
道具を　交換しよう！
世界の　各地を　旅する
バックパッカーに　話しかけよう！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-29T03:47:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:42:00" />
		</LanguageCell>
