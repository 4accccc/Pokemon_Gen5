	<TextRow
		Label="msg_fm_explain_evt_08"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>めずらしい　ポケモンの
はっけん　ほうこくが　あった！
かくちの　かくしあなを　めぐって
ポケモンを　みつけよう！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2012-01-28T14:11:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-20T12:18:17" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>珍しい　ポケモンの
発見　報告があった！
各地の　隠し穴を　巡って
ポケモンを　みつけよう！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2012-01-28T14:11:41" />
			<Status>Editing</Status>
