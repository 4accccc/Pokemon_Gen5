				Time="2011-08-26T12:42:00" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>ミッション説明文</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:40:57" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミッション説明文</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:42:00" />
		</CommentCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#ff8000</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="msg_fm_explain_evt_06"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごいつりざおを　つかって
ポケモンを　つりあげろ！</Text>
			<TextModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-11-28T00:52:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:39:51" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごいつりざおを　使って
ポケモンを　つりあげろ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-29T03:45:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:42:00" />
