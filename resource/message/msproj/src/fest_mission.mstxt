			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T10:51:19" />
		</CommentCell>
		<CommentCell
			Language="JPN_KANJI">
			<Comment>ミッション説明文</Comment>
			<CommentModifiedBy
				User="masafumi_saitou:W00225"
				Time="2011-08-26T12:42:00" />
		</CommentCell>
