	<TextRow
		Label="msg_fmission_e_pokebtl"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>[Digit:5digits Idx="0" ]びょう　いないに　[Digit:2digits Idx="1" ]ひきの
