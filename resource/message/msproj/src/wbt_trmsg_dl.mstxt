	<TextRow
		Label="TRID_WCS03M_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まっしょうめんから　きたな！
わるくない　たたかいだった！▼</Text>
