	<TextRow
		Label="TRID_DL07W_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ふふっ！　もっと　きたえないと
あたしには　かてないわよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T02:22:07" />
			<Status>Editing</Status>
			<StatusModifiedBy
