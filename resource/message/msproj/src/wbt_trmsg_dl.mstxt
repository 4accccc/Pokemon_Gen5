	<TextRow
		Label="TRID_DL08W_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんがえぬいた　せんじゅつが
わたしの　さいだいの　ぶきよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
