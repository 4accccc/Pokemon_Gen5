	<TextRow
		Label="TRID_DL08W_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ううん　かしこいだけじゃない！▼
せんじゅつを　うちやぶる　あなたの
じょうねつ！　みごとだったわ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-26T03:25:18" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:18:27" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ううん　賢いだけじゃない！▼
戦術を　打ち破る　あなたの
情熱！　見事だったわ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-26T03:41:55" />
