	<TextRow
		Label="TRID_DL01W_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うわー！　すごい　おきゃくさんいるね
てれちゃうけど　しょうぶよ！▼</Text>
