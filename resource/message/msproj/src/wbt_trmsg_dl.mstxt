	<TextRow
		Label="TRID_DL01M_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よりすぐりの　ポケモンを　たずさえて
わくわくトレーナー　カモーンッ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:00:50" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>選りすぐりの　ポケモンを　携えて
わくわくトレーナー　カモーンッ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-18T13:00:52" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：アナウンス
・ダウンロードキャラ用テンプレ１
・前口上メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</CommentCell>
		<AttributeCell
