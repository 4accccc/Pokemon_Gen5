	<TextRow
		Label="TRID_DL03M_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくの　ともだちも　がんばったけど
こりゃ　かなわないや！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:57:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:02:08" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ぼくの　友達も　がんばったけど
こりゃ　かなわないや！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:58:06" />
			<Status>Editing</Status>
			<StatusModifiedBy
