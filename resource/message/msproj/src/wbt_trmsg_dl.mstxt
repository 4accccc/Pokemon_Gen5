<MessageStudioText
	Format="1.2" xmlns="nintendo:msgstudio">
	<TextRow
		Label="TRID_DL01M_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　ポケモンを　つかうの？
ねぇ！　はやく　みせてよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T05:50:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:04" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんな　ポケモンで　戦うの？
ねぇ！　早く　見せてよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T05:50:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:04" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ１
・１回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:55:50" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ１
♂
小人１</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:23:46" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:04" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL01M_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きみは　めずらしいポケモンを
もっていそうだね！▽
この　しょうぶ　たのしみだよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T05:41:45" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>きみは　珍しいポケモンを
持っていそうだね！▽
この　勝負　楽しみだよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T05:50:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ１
・２回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ１
♂
小人１</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:05" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL01M_TRMSG_3RD_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どんな　ポケモンで
ここまで　かちぬいてきたの？▼
だしおしみなしで
きみの　すべてを　みせてくれ！！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T05:49:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どんな　ポケモンで
ここまで　勝ち抜いてきたの？▼
出し惜しみなしで
きみの　全てを　見せてくれ！！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T05:51:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ１
・決勝戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ１
♂
小人１</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:05" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL01M_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごいや！　どこで
そのポケモン　つかまえたの！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:32:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごいや！
どこで　そのポケモン　捕まえたの！？▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T05:56:08" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ１
・対戦後メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ１
♂
小人１</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:05" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL01M_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そのポケモンなら　しってるよ
めずらしいのが　みたかったなぁ▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:00:42" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>そのポケモンなら　知ってるよ
珍しいのが　見たかったなぁ▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:00:35" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ１
・対戦後　プレイヤー負けメッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ１
♂
小人１</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:05" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL01M_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まけたけど　こんな　すごいポケモンと
たたかえて　まんぞくだよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:02:01" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>負けたけど　こんな　すごいポケモンと
戦えて　満足だよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:02:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ１
・プレイヤーが勝った場合のメッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ１
♂
小人１</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:05" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
