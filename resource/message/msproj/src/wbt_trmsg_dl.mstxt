	<TextRow
		Label="TRID_WCS03M_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しょうぶとは　こういうものさ！
どりょくして　もっと　つよくなれ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T09:26:38" />
			<Status>Editing</Status>
