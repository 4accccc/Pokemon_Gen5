	<TextRow
		Label="TRID_WCS03M_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>まっしょうめんから　きたな！
わるくない　たたかいだった！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T09:21:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:34:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>真正面から　来たな！
悪くない　戦いだった！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T09:22:09" />
			<Status>Editing</Status>
