			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL04M_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こういう　たたかいが　したかったんだ
たのしかったよ　ありがとう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:10:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>こういう　戦いが　したかったんだ
楽しかったよ　ありがとう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:10:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ４
・プレイヤーが勝った場合のメッセージ</Comment>
