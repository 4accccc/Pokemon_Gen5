	<TextRow
		Label="TRID_WCS05W_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>せかいじゅうを　たびして　おぼえた
わざの　かずかずを　うけてみなさい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-28T07:36:51" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:40:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>世界中を　旅して　覚えた
技の数々を　受けてみなさい！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-28T07:40:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:40:38" />
		</LanguageCell>
