			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:40:38" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どこまでも　彼女は　強くなる！
ヘイッ！　限界を　超えろ！！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-09-26T10:39:34" />
