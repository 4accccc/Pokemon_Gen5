	<TextRow
		Label="TRID_DL03M_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぼくの　ともだちも　がんばったけど
こりゃ　かなわないや！▼</Text>
