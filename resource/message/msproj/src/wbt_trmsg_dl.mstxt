	<TextRow
		Label="TRID_WCS03M_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんがえずに　つきすすめ！
おまえなら　どこまでも　いける！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T09:23:41" />
			<Status>Editing</Status>
			<StatusModifiedBy
