	<TextRow
		Label="TRID_WCS04M_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ひとつのミスで　すべてが　くずれる！
しゅうちゅうして　やらなきゃ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T09:51:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:38:43" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ひとつのミスで　全てが崩れる…！
集中して　やらなきゃ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T09:50:29" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
