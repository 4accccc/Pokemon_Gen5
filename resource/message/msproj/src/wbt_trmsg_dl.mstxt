	<TextRow
		Label="TRID_DL08W_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>えっ？　うらを　かかれた！？
なんて　かしこい　トレーナーなの！▼</Text>
