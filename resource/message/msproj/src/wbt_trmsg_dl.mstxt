	</TextRow>
	<TextRow
		Label="TRID_DL01M_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つぎは　もっと　めずらしいポケモンを
もってきてちょうだいよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:03:53" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>次は　もっと　珍しいポケモンを
持ってきてちょうだいよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:04:40" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
