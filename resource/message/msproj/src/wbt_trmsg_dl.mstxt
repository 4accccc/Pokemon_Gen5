	<TextRow
		Label="TRID_DL05M_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よしっ！　きまった！
いつもの　さくせんで　しょうぶだ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T09:13:53" />
