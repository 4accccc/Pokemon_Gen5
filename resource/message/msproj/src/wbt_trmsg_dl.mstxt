				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL02M_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>わわっ！　いきなり　おまえみたいな
つよそうなやつと　あたるなんて！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:46:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:58:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>わわっ！　いきなり　おまえみたいな
強そうな奴と　当たるなんて！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:45:57" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:58:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ２
・１回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:06:26" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ２
♂
小人２</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:10" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>226</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:58:49" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL02M_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ただものじゃ　なさそうだな！
だけど　おれだって　かんたんに▽
まけたりしないぞ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:46:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:58:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>ただものじゃ　なさそうだな！
だけど　おれだって　簡単に▽
負けたりしないぞ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:46:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:58:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ２
・２回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:58:49" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ２
♂
小人２</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:17" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>226</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:58:49" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
			<CellModifiedBy
				User=":"
				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL02M_TRMSG_3RD_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>げげっ！　めちゃくちゃ　つよそうな
トレーナーだな！▼
これが　けっしょうせんか……
まっ……まけないぞ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:52:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:58:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>げげっ！　めちゃくちゃ　強そうな
トレーナーだな！▼
これが　決勝戦か……
