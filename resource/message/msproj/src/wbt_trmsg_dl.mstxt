	<TextRow
		Label="TRID_WCS02M_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ちょうてんを　めざし　ひたはしるゥ
じしょう　せかいいちの　オトコｫ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-29T04:58:09" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:29:05" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>頂点を　目指し　ひた走るゥ
自称　世界一の　オトコォ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-29T04:58:11" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:29:05" />
