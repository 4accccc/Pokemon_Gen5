	<TextRow
		Label="TRID_WCS04W_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>うおおおっ！　もえてきた！
もえつきるまで　やろう！！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T08:36:31" />
			<Status>Editing</Status>
			<StatusModifiedBy
