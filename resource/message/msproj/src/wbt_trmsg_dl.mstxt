	<TextRow
		Label="TRID_WCS03M_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>かんがえずに　つきすすめ！
おまえなら　どこまでも　いける！▼</Text>
