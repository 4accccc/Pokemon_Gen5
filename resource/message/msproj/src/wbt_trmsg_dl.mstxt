	</TextRow>
	<TextRow
		Label="TRID_DL01M_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごいや！　どこで
その　ポケモン　つかまえたの！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-13T07:05:00" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごいや！　どこで
その　ポケモン　捕まえたの！？▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-13T07:04:55" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ１
・対戦後メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ１
♂
小人１</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:05" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
