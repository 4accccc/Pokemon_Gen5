	<TextRow
		Label="TRID_DL03M_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>そんな　バラバラな　れんけいじゃ
ぼくたちは　たおせないよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:58:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
