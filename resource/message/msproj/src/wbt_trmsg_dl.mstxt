				Time="2011-07-20T07:24:59" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>226</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</AttributeCell>
		<ExtraCell
