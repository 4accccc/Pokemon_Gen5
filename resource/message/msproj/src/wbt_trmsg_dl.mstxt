	<TextRow
		Label="TRID_DL07W_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>きたれ　パワフルトレーナー！！
その　いちげきは　いわをも　くだく！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
