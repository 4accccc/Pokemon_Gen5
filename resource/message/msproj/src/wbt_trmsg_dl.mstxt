	<TextRow
		Label="TRID_DL04M_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>すごい　かずの　かんきゃくだね！
もえてきた！　いくよ！！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-13T07:06:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>すごい数の　観客だね！
燃えてきた！　行くよっ！！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:10:25" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ４
・１回戦用対戦前メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
