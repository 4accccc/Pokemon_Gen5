	<TextRow
		Label="TRID_DL01W_TRMSG_2ND_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こんな　たくさんの　ひとの　まえで
たたかえるなんて　すごい！▽
ポケモン　みてもらおうよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-26T06:27:12" />
