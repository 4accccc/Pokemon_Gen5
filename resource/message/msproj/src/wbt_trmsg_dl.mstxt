			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:11:13" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>おまえも　なかなか　やりそうだな！▼
思いっきり　楽しい　勝負を
しようじゃないか！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
