				Time="0001-01-01T00:00:00" />
		</ExtraCell>
	</TextRow>
	<TextRow
		Label="TRID_DL04M_TRMSG_FIGHT_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>いい　しょうぶだったね！
かんきゃくも　もりあがってるよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:10:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>いい　勝負だったね！
観客も　盛り上がってるよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:10:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂
・ダウンロードキャラ用テンプレ４
・対戦後メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ４
♂
中人１</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:59" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>226</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
