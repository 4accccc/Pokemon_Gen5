	<TextRow
		Label="TRID_WCS04M_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>しゅうちゅうして　ミスせず　やれば
ぜったいに　かてる……！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
