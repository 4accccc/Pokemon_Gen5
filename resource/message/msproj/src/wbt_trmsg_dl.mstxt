	<TextRow
		Label="TRID_DL04W_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>くろうして　てにいれた　ポケモンで
トーナメントを　かちぬくよ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
