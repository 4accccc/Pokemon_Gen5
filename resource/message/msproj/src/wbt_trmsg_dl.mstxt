	<TextRow
		Label="TRID_DL04M_TRMSG_FIGHT_AFTER_PLAYER_WIN"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>こういう　たたかいが　したかったんだ
たのしかったよ　ありがとう！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:10:02" />
