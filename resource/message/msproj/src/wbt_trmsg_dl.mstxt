	<TextRow
		Label="TRID_DL01M_TRMSG_FIGHT_AFTER_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>つぎは　もっと　めずらしいポケモンを
もってきて　ほしいな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T08:39:32" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>次は　もっと　珍しいポケモンを
持ってきて　ほしいな！▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-11-12T08:39:36" />
			<Status>Editing</Status>
			<StatusModifiedBy
