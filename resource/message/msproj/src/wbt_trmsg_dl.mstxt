	<TextRow
		Label="TRID_DL01M_TRMSG_OPENING_ANNOUNCE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>よりすぐりの　ポケモンを　たずさえて
わくわくトレーナー　カモーンッ！！▼　</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:31:16" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>選りすぐりの　ポケモンを　携えて
わくわくトレーナー　カモーンッ！！▼　</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T06:30:59" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</LanguageCell>
		<CommentCell
			Language="JPN">
			<Comment>♂：アナウンス
・ダウンロードキャラ用テンプレ１
・前口上メッセージ</Comment>
			<CommentModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</CommentCell>
		<AttributeCell
			Name="Character">
			<Text>ダウンロードキャラ１
♂
小人１</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:24:05" />
		</AttributeCell>
		<AttributeCell
			Name="Width">
			<Text>216</Text>
			<TextModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T05:41:11" />
		</AttributeCell>
		<ExtraCell
			DataHolder="f803f354-0c78-4e1d-a1a9-1525faa0efba">
			<CellData>#80ff80</CellData>
