	<TextRow
		Label="TRID_WCS03M_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>どちらか　つよいほうが　かつ……
ただ　それだけの　こと！　いくぞ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T09:32:20" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:34:41" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>どちらか　強い方が　勝つ……
ただ　それだけの事だ！　行くぞ！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-27T09:32:38" />
			<Status>Editing</Status>
