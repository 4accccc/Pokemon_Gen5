	<TextRow
		Label="TRID_DL10M_TRMSG_1ST_FIGHT_START"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>ぜんりょくを　だしあって
せいせいどうどう　たたかおう！！▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-26T05:34:33" />
