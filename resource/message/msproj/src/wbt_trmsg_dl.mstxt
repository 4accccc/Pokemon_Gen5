	</TextRow>
	<TextRow
		Label="TRID_DL04M_TRMSG_FIGHT_PLAYER_LOSE"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>……もっと　はくねつした
しょうぶが　したかったなぁ▼</Text>
			<TextModifiedBy
				User="swan_scenario:W00293"
				Time="2011-07-25T08:10:02" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>……もっと　白熱した
勝負が　したかったなぁ▼</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2012-02-13T07:06:49" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="suginaka_katsunori:W00227"
				Time="2011-07-20T07:05:49" />
		</LanguageCell>
