	<TextRow
		Label="ZKN_COMMENT_GER_00_052"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ein nachtaktives Pokémon. Sieht es
etwas Schimmerndes, fangen
seine Augen an zu glänzen.</Text>
