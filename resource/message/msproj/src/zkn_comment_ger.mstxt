	<TextRow
		Label="ZKN_COMMENT_GER_00_053"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ein sehr stolzes Pokémon. Für Fans
ist die Größe des Juwels auf seiner
Stirn Anlass für Diskussionen.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
