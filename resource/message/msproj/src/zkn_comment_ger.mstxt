	<TextRow
		Label="ZKN_COMMENT_GER_00_493"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Man sagt, es sei im Nichts aus
einem Ei geschlüpft und habe
dann die Welt geformt.</Text>
