			Language="JPN">
			<Comment>フリーザー</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_GER_00_145"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Ein Legendäres Vogel-Pokémon,
das in Gewitterwolken leben soll.
Es kontrolliert Blitze. </Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Ein Legendäres Vogel-Pokémon,
das in Gewitterwolken leben soll.
Es kontrolliert Blitze. </Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
