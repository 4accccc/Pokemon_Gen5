			<Comment>カブトプス</Comment>
			<CommentModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</CommentCell>
	</TextRow>
	<TextRow
		Label="ZKN_COMMENT_GER_00_142"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>Dieses PKMN flog zu Zeiten der
Dinosaurier am Himmel. Seine
Zähne sind wie Sägeblätter.</Text>
			<TextModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
			<Status>Editing</Status>
			<StatusModifiedBy
				User="ariizumi_nobuhiko:W00248"
				Time="2011-05-20T09:30:26" />
		</LanguageCell>
		<LanguageCell
			Language="JPN_KANJI">
			<Text>Dieses PKMN flog zu Zeiten der
Dinosaurier am Himmel. Seine
Zähne sind wie Sägeblätter.</Text>
