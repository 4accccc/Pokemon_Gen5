	<TextRow
		Label="MSG_BADGE_LEADER8B_03"
		Style="Large">
		<LanguageCell
			Language="JPN">
			<Text>じんせいを　あらなみに　たとえるのも
ちんぷだが　おはん　ながされるなよ！</Text>
			<TextModifiedBy
				User="matsumiya:W00224"
				Time="2011-08-30T09:47:33" />
			<Status>Editing</Status>
			<StatusModifiedBy
