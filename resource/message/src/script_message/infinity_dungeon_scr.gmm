	<row id="msg_info_clear_b_06" text-color="#ffffff,,,#ffffff,,#ffffff,#ffffff,#ffffff,,,#ffffff,,#ffffff,#ffffff,,,#ffffff,," back-color="#000000,,,#000000,,#000000,#000000,#000000,,,#000000,,#000000,#000000,,,#000000,,">
		<comment>・トレーナー名＝プレイヤー名</comment>
		<language name="JPN" width="256">[1:00:トレーナー名:0]さま！▼
