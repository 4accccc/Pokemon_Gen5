//-------------------------------------
///	MMDL用パラメータ
//=====================================
typedef struct {
  u16 move_code;
  u16 ev_type;
  u16 direction;
  u16 param0;
  u16 param1;
  s32 lim_x;
  s32 lim_z;
}INF_MMDL_PARAM;

