	<row id="TRID_SWPLAZMAM_25_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">オレは　ポケモンを　うばいつづける！
すこしでも　ちからを　たくわえないとな</language>
		<language name="JPN_KANJI" width="216">オレは　ポケモンを　奪い続ける！
すこしでも　力を　蓄えないとな</language>
	</row>

	<row id="TRID_SWPLAZMAM_26_TRMSG_FIGHT_START">
		<language name="JPN" width="216">……プラズマだんの　せいぎのため
２ねんかん　ずっと　きたえていた▼
もう　だれにも　まけない！▼</language>
		<language name="JPN_KANJI" width="216">……プラズマ団の　正義のため
２年間　ずっと　鍛えていた
もう　だれにも　負けない！▼</language>
	</row>

	<row id="TRID_SWPLAZMAM_26_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……まけちまったら
せいぎを　つらぬけない！</language>
		<language name="JPN_KANJI" width="216">……負けちまったら
正義を　貫けない！</language>
	</row>

	<row id="TRID_SWPLAZMAM_26_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">おれの　せいぎ！▼
だれかに　なにを　いわれようと
つらぬきとおす！　ぜったい　ぜったい！▼
おまえらなんか　しったことか！</language>
		<language name="JPN_KANJI" width="216">おれの　正義！▼
だれかに　なにを　いわれようと
貫き通す！　絶対　絶対！▼
おまえらなんか　知ったことか！</language>
	</row>

	<row id="TRID_SWPLAZMAM_27_TRMSG_FIGHT_START">
		<language name="JPN" width="216">たたかう　しゅうだん
それが　プラズマだん！▼</language>
		<language name="JPN_KANJI" width="216">戦う　集団
それが　プラズマ団！▼</language>
	</row>

	<row id="TRID_SWPLAZMAM_27_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">つよい　トレーナーって　なんだ！？</language>
		<language name="JPN_KANJI" width="216">強い　トレーナーって　なんだ！？</language>
	</row>

	<row id="TRID_SWPLAZMAM_27_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">つよい　トレーナーとは
ポケモンのことを　きにせず▼
むりを　させてでも　つよくする
ひどい　ヤツの　ことだろ！？</language>
		<language name="JPN_KANJI" width="216">強い　トレーナーとは
ポケモンのことを　気にせず▼
無理を　させてでも　強くする
外道の　ことだろ！？</language>
	</row>

	<row id="TRID_SWPLAZMAM_28_TRMSG_FIGHT_START">
		<language name="JPN" width="216">プラズマだんの　かがくりょくで！▼
ポケモンの　ちからを
さいだいげんに　はっきしてやる！▼</language>
		<language name="JPN_KANJI" width="216">プラズマ団の　科学力で！▼
ポケモンの　力を
最大限に　発揮してやる！▼</language>
	</row>

	<row id="TRID_SWPLAZMAM_28_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ふつうの……　しかも　こどもの
オマエなんかが　なぜ　つよい！？</language>
		<language name="JPN_KANJI" width="216">普通の……　しかも　こどもの
オマエなんかが　なぜ　強い！？</language>
	</row>

	<row id="TRID_SWPLAZMAM_28_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">われわれ　プラズマだんは
むりやり　ポケモンの　ちからを▽
さいだいげんに　はっきさせる！▼
ポケモンかいほう？
そんな　めんどうなこと　するか！</language>
		<language name="JPN_KANJI" width="216">我々　プラズマ団は
むりやり　ポケモンの　力を▽
最大限に　発揮させる！▼
ポケモン解放？
そんな　面倒なこと　するか！</language>
	</row>

	<row id="TRID_SWPLAZMAM_29_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ポケモントレーナーは
ポケモンの　あしかせと　なっている！▼</language>
		<language name="JPN_KANJI" width="216">ポケモントレーナーは
ポケモンの　足かせと　なっている！▼</language>
	</row>

	<row id="TRID_SWPLAZMAM_29_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">なぬ！？　おまえは　ポケモンの
ちからを　ひきだしている！？</language>
		<language name="JPN_KANJI" width="216">なぬ！？　おまえは　ポケモンの
力を　ひきだしている！？</language>
	</row>

	<row id="TRID_SWPLAZMAM_29_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">……ポケモンは　トレーナーの
そばに　いると　あまえて▽
しんの　ちからを　はっきできない▼
……おまえ　ほんとうだと　おもうか？</language>
		<language name="JPN_KANJI" width="216">……ポケモンは　トレーナーの
そばに　いると　甘えて▽
真の　力を　発揮できない▼
……おまえ　本当だと　思うか？</language>
	</row>

	<row id="TRID_SWPLAZMAM_30_TRMSG_FIGHT_START">
		<language name="JPN" width="216">プラズマだん　いがいは
ぜんいん　てき　だぜ！▼</language>
		<language name="JPN_KANJI" width="216">プラズマ団　以外は
全員　敵だぜ！▼</language>
	</row>

	<row id="TRID_SWPLAZMAM_30_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……おまえを　にくむ！</language>
		<language name="JPN_KANJI" width="216">……おまえを　憎む！</language>
	</row>

	<row id="TRID_SWPLAZMAM_30_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">おれはな　せかいが　にくい！▼
だから　プラズマだんの　メンバーとして
みんなを　めちゃくちゃに　する！</language>
		<language name="JPN_KANJI" width="216">おれはな　世界が　憎い！▼
だから　プラズマ団の　メンバーとして
みんなを　めちゃくちゃに　する！</language>
	</row>

	<row id="TRID_SWPLAZMAW_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">しんにゅうしゃ　はっけん！▼
これから　だすのは
こどもから　とりあげた　ポケモンよ！▼</language>
		<language name="JPN_KANJI" width="216">侵入者　発見！▼
これから　だすのは
こどもから　取り上げた　ポケモンよ！▼</language>
	</row>

	<row id="TRID_SWPLAZMAW_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……よわい　ポケモン
べつの　ポケモンを　うばわなきゃ！</language>
		<language name="JPN_KANJI" width="216">……弱い　ポケモン
別の　ポケモンを　奪わなきゃ！</language>
	</row>

	<row id="TRID_SWPLAZMAW_06_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">あたしたちが　ポケモンを　うばえば
せかいから　トレーナーが　へる！▽
それって　てきが　いなくなることよ</language>
		<language name="JPN_KANJI" width="216">あたしたちが　ポケモンを　奪えば
世界から　トレーナーが　減る！▽
それって　敵が　いなくなることよ</language>
	</row>

	<row id="TRID_SWPLAZMAW_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">アタイ　このなかで
かーなーり　つよい　プラズマだん！▼</language>
		<language name="JPN_KANJI" width="216">アタイ　このなかで
かーなーり　強い　プラズマ団！▼</language>
	</row>

	<row id="TRID_SWPLAZMAW_07_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">すばらしい　けいかくに
ジャマは　つきもの　ね！</language>
		<language name="JPN_KANJI" width="216">すばらしい　計画に
ジャマは　つきもの　ね！</language>
	</row>

	<row id="TRID_SWPLAZMAW_07_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ジャマがある　ってことは
あいてに　されているということ▼
……むし　されるって　かなしいもの▼
じゃなくて　ジャマされても
こんどこそ　せかいせいふく　よ！！</language>
		<language name="JPN_KANJI" width="216">ジャマがある　ってことは
相手に　されているということ▼
……無視されるって　悲しいもの▼
じゃなくて　ジャマされても
今度こそ　世界征服　よ！！</language>
	</row>

	<row id="TRID_SWPLAZMAW_08_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あたしたちと　ちがう
かんがえの　もちぬしは　ゆるさない！▼</language>
		<language name="JPN_KANJI" width="216">あたしたちと　違う
考えの　持ち主は　許さない！▼</language>
	</row>

	<row id="TRID_SWPLAZMAW_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">くう……
あんたのこと　ゆるさない！</language>
		<language name="JPN_KANJI" width="216">くう……
あんたのこと　許さない！</language>
	</row>

	<row id="TRID_SWPLAZMAW_08_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">くりかえす！　あたしたちと　ちがう
かんがえの　もちぬしは　ゆるさない！▼
あたしたち　プラズマだんが
せかいを　しはいすれば　みんな▽
おんなじ　かんがえに　なるの！</language>
		<language name="JPN_KANJI" width="216">繰り返す！　あたしたちと　違う
考えの　持ち主は　許さない！▼
あたしたち　プラズマ団が
世界を　支配すれば　みんな▽
おんなじ　考えに　なるの！</language>
	</row>

	<row id="TRID_SWPLAZMAW_09_TRMSG_FIGHT_START">
		<language name="JPN" width="216">えいゆうが　いなくても！
でんせつの　ポケモンが　いなくても▽
あたしたちは　まけないのよ！▼</language>
		<language name="JPN_KANJI" width="216">英雄が　いなくても！
伝説の　ポケモンが　いなくても▽
あたしたちは　負けないのよ！▼</language>
	</row>

	<row id="TRID_SWPLAZMAW_09_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">プラーズマー！
プラズマだんに　えいこうあれ！</language>
		<language name="JPN_KANJI" width="216">プラーズマー！
プラズマ団に　栄光あれ！</language>
	</row>

	<row id="TRID_SWPLAZMAW_09_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">あたしたち　プラズマだんが
イッシュちほうを　しはいすれば▽
おうさまが　もどってくるかも……</language>
		<language name="JPN_KANJI" width="216">あたしたち　プラズマ団が
イッシュ地方を　支配すれば▽
王様が　戻ってくるかも……</language>
	</row>

	<row id="TRID_SWPLAZMAW_10_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あたしたち　かわったのは
コスチュームだけじゃ　ないわ！▼
ポケモンの　ためではなく
じぶんのために　いきるの！▼</language>
		<language name="JPN_KANJI" width="216">あたしたち　変わったのは
コスチュームだけじゃ　ないわ！▼
ポケモンの　ためではなく
自分のために　生きるの！▼</language>
	</row>

	<row id="TRID_SWPLAZMAW_10_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">どうして……
どうしてなのよ！</language>
		<language name="JPN_KANJI" width="216">どうして……
どうしてなのよ！</language>
	</row>

	<row id="TRID_SWPLAZMAW_10_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">おうさまに　うらぎられたんだもの……▼
かんがえかたを　かえなきゃ
じぶんを　たもてないもの……</language>
		<language name="JPN_KANJI" width="216">王様に　裏切られたんだもの……▼
考え方を　変えなきゃ
自分を　保てないもの……</language>
	</row>

	<row id="TRID_WAITRESS_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">とどかなかった　おもいは
どこへ　きえてゆくのでしょう……</language>
		<language name="JPN_KANJI" width="216">届かなかった　想いは
どこへ　消えてゆくのでしょう……</language>
	</row>

	<row id="TRID_CHILDCARE_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">そう……　にくしみで　ポケモンを
たたかわせては　いけないのね……</language>
		<language name="JPN_KANJI" width="216">そう……　憎しみで　ポケモンを
戦わせては　いけないのね……</language>
	</row>

	<row id="TRID_OL_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">え……　にくしみより
あいの　ほうが　つよいの！？</language>
		<language name="JPN_KANJI" width="216">え……　憎しみより
愛の　ほうが　強いの！？</language>
	</row>

	<row id="TRID_MAID_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">なぜ！　どうして？
ひとの　ために　がんばれるの！？</language>
		<language name="JPN_KANJI" width="216">なぜ！　どうして？
他人の　ために　がんばれるの！？</language>
	</row>

	<row id="TRID_CLEANING_04_TRMSG_FIGHT_START">
		<language name="JPN" width="216">そうじってのは　いがいと
たいりょくを　つかう……▼
つまり　おじさんは　そうじをして
ポケモンを　きたえてるんだよ！▼</language>
		<language name="JPN_KANJI" width="216">掃除ってのは　以外と
体力を　使う……▼
つまり　おじさんは　掃除をして
ポケモンを　鍛えてるんだよ！▼</language>
	</row>

	<row id="TRID_CLEANING_04_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">おっと！　かちまけ　よりも
そこの　よごれが　きになる！</language>
		<language name="JPN_KANJI" width="216">おっと！　勝ち負け　よりも
そこの　汚れが　気になる！</language>
	</row>

	<row id="TRID_CLEANING_04_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">おわりがない！　ってことは
いつまでも　そうじ　できるってことだ▼
いいねえ！　おじさん
そうじが　だいすき　だからね</language>
		<language name="JPN_KANJI" width="216">終わりがない！　ってことは
いつまでも　掃除できるってことだ▼
いいねえ！　おじさん
掃除が　大好き　だからね</language>
	</row>

	<row id="TRID_CLEANING_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">おっ！　トレーナーさんよ
そうじするから　どいておくれ！▼</language>
		<language name="JPN_KANJI" width="216">おっ！　トレーナーさんよ
掃除するから　どいておくれ！▼</language>
	</row>

	<row id="TRID_CLEANING_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あら？　まあ
たまげたねえ！</language>
		<language name="JPN_KANJI" width="216">あら？　まあ
たまげたねえ！</language>
	</row>

	<row id="TRID_CLEANING_05_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ひとが　いきてりゃ　よごれる
よごれたら　きれいに　すればええ！</language>
		<language name="JPN_KANJI" width="216">人が　生きてりゃ　汚れる
汚れたら　きれいに　すればええ！</language>
	</row>

	<row id="TRID_SCIENTISTM_15_TRMSG_FIGHT_START">
		<language name="JPN" width="216">サイン　コサイン　ダンジェント！▼</language>
		<language name="JPN_KANJI" width="216">サイン　コサイン　ダンジェント！▼</language>
	</row>

	<row id="TRID_SCIENTISTM_15_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">うーん　トートロジー</language>
		<language name="JPN_KANJI" width="216">うーん　トートロジー</language>
	</row>

	<row id="TRID_SCIENTISTM_15_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">カタストロフィーりろん　だ！</language>
		<language name="JPN_KANJI" width="216">カタストロフィー理論　だ！</language>
	</row>

	<row id="TRID_SCIENTISTW_11_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あたしは　ここの　においについて
しらべている　けんきゅうしゃ　です！▼</language>
		<language name="JPN_KANJI" width="216">あたしは　ここの　においについて
調べている　研究者です！▼</language>
	</row>

	<row id="TRID_SCIENTISTW_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">においで　たとえると　ポケモンの
クサイハナなみの　がっかりさね</language>
		<language name="JPN_KANJI" width="216">においで　例えると　ポケモンの
クサイハナなみの　がっかりさね</language>
	</row>

	<row id="TRID_SCIENTISTW_11_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ひとから　すれば　くさい　においでも
ある　ポケモンにとっては　いいかおり</language>
		<language name="JPN_KANJI" width="216">人から　すれば　くさい　においでも
ある　ポケモンにとっては　いい香り</language>
	</row>

	<row id="TRID_WORKER2_31_TRMSG_FIGHT_START">
		<language name="JPN" width="216">うおぉぉぉぉぉー！！▼</language>
		<language name="JPN_KANJI" width="216">うおぉぉぉぉぉー！！▼</language>
	</row>

	<row id="TRID_WORKER2_31_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">まけたぁぁぁぁー！！</language>
		<language name="JPN_KANJI" width="216">負けたぁぁぁぁー！！</language>
	</row>

	<row id="TRID_WORKER2_31_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">げすいどうとか　トンネルで
おおごえを　だすと　ひびいたり▽
くぐもって　おもしろいよな！</language>
		<language name="JPN_KANJI" width="216">下水道とか　トンネルで
大声を　だすと　響いたり▽
くぐもって　おもしろいよな！</language>
	</row>

	<row id="TRID_WORKER2_32_TRMSG_FIGHT_START">
		<language name="JPN" width="216">げすいどうは　にんげんに
ひつよう　だけど　ポケモンには▽
どうなんだろうね？　とききつつ▽
しょうぶを　いどんじゃうぞ！！▼</language>
		<language name="JPN_KANJI" width="216">下水道は　人間に
必要だけど　ポケモンには▽
どうなんだろうね？　とききつつ▽
勝負を　挑んじゃうぞ！！▼</language>
	</row>

	<row id="TRID_WORKER2_32_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">きみと　きみのポケモンの　あいだに
かきねは　ないようだね！</language>
		<language name="JPN_KANJI" width="216">きみと　きみのポケモンの　あいだに
垣根は　ないようだね！</language>
	</row>

	<row id="TRID_WORKER2_32_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">げすいどうが　できたら　できたで
いろんな　ポケモンが　あつまってきた▼
ひとと　ポケモンの　きょうかいせん
なんて　ないのかもな？</language>
		<language name="JPN_KANJI" width="216">下水道が　できたら　できたで
いろんな　ポケモンが　集まってきた▼
人と　ポケモンの　境界線
なんて　ないのかもな？</language>
	</row>

	<row id="TRID_CYCLINGM_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ひゃっほーい！　とばすぜ！
よこぎるやつは　ふっとばすぜ！▼</language>
		<language name="JPN_KANJI" width="216">ひゃっほーい！　飛ばすぜ！
横切るやつは　吹っ飛ばすぜ！▼</language>
	</row>

	<row id="TRID_CYCLINGM_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">くっそぅ！　こっちが
ふっとばされちまった！</language>
		<language name="JPN_KANJI" width="216">くっそぅ！　こっちが
吹っ飛ばされちまった！</language>
	</row>

	<row id="TRID_CYCLINGM_03_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">そうだ！　ポケモンの　わざで
ふきとばしてもらったら▽
もっともっと　スピードが　でるかも！</language>
		<language name="JPN_KANJI" width="216">そうだ！　ポケモンの　技で
ふきとばしてもらったら▽
もっともっと　スピードが　でるかも！</language>
	</row>

	<row id="TRID_CYCLINGW_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">よっと！　ギアチェンジ　っと！
フルスピードで　いくわよっ！▼</language>
		<language name="JPN_KANJI" width="216">よっと！　ギアチェンジ　っと！
フルスピードで　行くわよっ！▼</language>
	</row>

	<row id="TRID_CYCLINGW_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">どれだけギアを　あげても
あなたには　おいつけないみたいね！</language>
		<language name="JPN_KANJI" width="216">どれだけギアを　上げても
あなたには　追いつけないみたいね！</language>
	</row>

	<row id="TRID_CYCLINGW_03_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">よっと！　やまみちを　はしるのって
たいへんだから　おもしろいのよ！</language>
		<language name="JPN_KANJI" width="216">よっと！　山道を　走るのって
たいへんだから　おもしろいのよ！</language>
	</row>

	<row id="TRID_KARATE_17_TRMSG_FIGHT_START">
		<language name="JPN" width="216">からての　みちは　ひとの　みち
そして　ポケモンの　みち！▼</language>
		<language name="JPN_KANJI" width="216">空手の道は　人の道
そして　ポケモンの道！▼</language>
	</row>

	<row id="TRID_KARATE_17_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">うぬ！　かつことは
ぐうぜん　ではない！</language>
		<language name="JPN_KANJI" width="216">うぬ！　勝つことは
偶然では　ない！</language>
	</row>

	<row id="TRID_KARATE_17_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">かつものは　かつべくして
かっているのだ！！</language>
		<language name="JPN_KANJI" width="216">勝つものは　勝つべくして
勝っているのだ！！</language>
	</row>

	<row id="TRID_KARATE_18_TRMSG_FIGHT_START">
		<language name="JPN" width="216">この　カラテおう　リイチ！
いかなるときも　うしろを　みせん！▼</language>
		<language name="JPN_KANJI" width="216">この　カラテおう　リイチ！
いかなるときも　後ろを　みせん！▼</language>
	</row>

	<row id="TRID_KARATE_18_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……ぐっ！
ひくときは　ひく！！</language>
		<language name="JPN_KANJI" width="216">……ぐっ！
ひくときは　ひく！！</language>
	</row>

	<row id="TRID_KARATE_18_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">じぶんの　よわさを　みつめなおす▼
ときおり　じぶんが　いやになるが
じぶんからは　にげられんのだ！</language>
		<language name="JPN_KANJI" width="216">自分の　弱さを　みつめなおす▼
時折　自分が　いやになるが
自分からは　逃げられんのだ！</language>
	</row>

	<row id="TRID_BATTLEG_16_TRMSG_FIGHT_START">
		<language name="JPN" width="216">やっほー！
んじゃ　やろか！▼</language>
		<language name="JPN_KANJI" width="216">やっほー！
んじゃ　やろか！▼</language>
	</row>

	<row id="TRID_BATTLEG_16_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">びっくり！</language>
		<language name="JPN_KANJI" width="216">びっくり！</language>
	</row>

	<row id="TRID_BATTLEG_16_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">んー　かちに　こだわると
へんな　ちから　はいっちゃうもん</language>
		<language name="JPN_KANJI" width="216">んー　勝ちに　こだわると
変な　力　はいっちゃうもん</language>
	</row>

	<row id="TRID_BATTLEG_17_TRMSG_FIGHT_START">
		<language name="JPN" width="216">しゅぎょうは　うらぎらない！
あれだけ　きたえたのよ▽
ぜったいに　かつんだから！！▼</language>
		<language name="JPN_KANJI" width="216">修行は　裏切らない！
あれだけ　鍛えたのよ▽
絶対に　勝つんだから！！▼</language>
	</row>

	<row id="TRID_BATTLEG_17_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……そんなあ！
あんなに　しゅぎょう　したのに！？</language>
		<language name="JPN_KANJI" width="216">……そんなあ！
あんなに　修行したのに！？</language>
	</row>

	<row id="TRID_BATTLEG_17_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">まけて　さとる
じぶんの　みじゅくさ……▼
だけど　いいわけに　せず
あすへの　かてに　するんだから！</language>
		<language name="JPN_KANJI" width="216">負けて　悟る
自分の　未熟さ……▼
だけど　言い訳に　せず
明日への　糧に　するんだから！</language>
	</row>

	<row id="TRID_RANGERM_20_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ヘイヘイヘイ！
ポケモンを　あいしているからこそ！▼
わかるよな？
そう！　たたかわせようぜ！▼</language>
		<language name="JPN_KANJI" width="216">ヘイヘイヘイ！
ポケモンを　愛しているからこそ！▼
わかるよな？
そう！　戦わせようぜ！▼</language>
	</row>

	<row id="TRID_RANGERM_20_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あんたの　ポケモンへの　あい
なんとなく　わかったぜ！</language>
		<language name="JPN_KANJI" width="216">あんたの　ポケモンへの　愛
なんとなく　わかったぜ！</language>
	</row>

	<row id="TRID_RANGERM_20_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ポケモンに　これを
あげると　いいんじゃないか？▼</language>
		<language name="JPN_KANJI" width="216">ポケモンに　これを
あげると　いいんじゃないか？▼</language>
	</row>

	<row id="TRID_RANGERM_20_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ポケモンは　どんなときでも
トレーナーの　みかたを　してくれる▽
それが　どれだけ　ありがたいか！</language>
		<language name="JPN_KANJI" width="216">ポケモンは　どんなときでも
トレーナーの　味方を　してくれる▽
それが　どれだけ　ありがたいか！</language>
	</row>

	<row id="TRID_RANGERW_20_TRMSG_FIGHT_START">
		<language name="JPN" width="216">かっても　まけても
うらみっこ　なし！▼
もくてきは　ポケモンを
きたえ　そだてることよ！▼</language>
		<language name="JPN_KANJI" width="216">勝っても　負けても
うらみっこ　なし！▼
目的は　ポケモンを
鍛え　育てることよ！▼</language>
	</row>

	<row id="TRID_RANGERW_20_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……あーん！
かちたかったよ！</language>
		<language name="JPN_KANJI" width="216">……あーん！
勝ちたかったよ！</language>
	</row>

	<row id="TRID_RANGERW_20_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">これは　キーのみ▼</language>
		<language name="JPN_KANJI" width="216">これは　キーのみ▼</language>
	</row>

	<row id="TRID_RANGERW_20_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">かてないと　あたしの　ポケモン
すごく　きげんを　そこねちゃうの！</language>
		<language name="JPN_KANJI" width="216">勝てないと　あたしの　ポケモン
すごく　機嫌を　損ねちゃうの！</language>
	</row>

	<row id="TRID_BATTLEG_19_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あっ！　ひと！
ひさしぶりに　ひとに　あいました！▼
トレーナーですね！？
じゃあ　しょうぶです！▼</language>
		<language name="JPN_KANJI" width="216">あっ！　人！
久しぶりに　人に　会いました！▼
トレーナーですね！？
じゃあ　勝負です！▼</language>
	</row>

	<row id="TRID_BATTLEG_19_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あれれれ……　ひさしぶりすぎて
カンが　にぶったかのなあ？</language>
		<language name="JPN_KANJI" width="216">あれれれ……　久しぶりすぎて
カンが　鈍ったかのなあ？</language>
	</row>

	<row id="TRID_BATTLEG_19_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">このあたりの　みち……
すごく　いりくんで　いるので▽
めったに　ひとが　こないんですよ</language>
		<language name="JPN_KANJI" width="216">この辺りの　道……
すごく　入り組んで　いるので▽
めったに　人が　来ないんですよ</language>
	</row>

	<row id="TRID_RANGERM_21_TRMSG_FIGHT_START">
		<language name="JPN" width="216">まっていた！
まっていたよ　このときを！▼</language>
		<language name="JPN_KANJI" width="216">待っていた！
待っていたよ　この時を！▼</language>
	</row>

	<row id="TRID_RANGERM_21_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">きみのように　つよい
トレーナーを　まっていた！</language>
		<language name="JPN_KANJI" width="216">君のように　強い
トレーナーを　待っていた！</language>
	</row>

	<row id="TRID_RANGERM_21_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">まっていた！
まっていたよ　これを　わたすのを！▼</language>
		<language name="JPN_KANJI" width="216">待っていた！
待っていたよ　これを　渡すのを！▼</language>
	</row>

	<row id="TRID_RANGERM_21_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">あちている　どうぐの　ちかくで
まちぶせ　していたのさ▼
モロバレルの　ぎたい　よりは
うまく　かくれていた……　よね</language>
		<language name="JPN_KANJI" width="216">落ちている　道具の　近くで
待ち伏せ　していたのさ▼
モロバレルの　擬態よりは
うまく　隠れていた……　よね</language>
	</row>

	<row id="TRID_RANGERW_21_TRMSG_FIGHT_START">
		<language name="JPN" width="216">チャンピオンロードへ　いどむ
トレーナーさん！▼
あなたの　じつりょく
みせて　もらおうかしら！▼</language>
