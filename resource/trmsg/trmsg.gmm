	</row>

	<row id="TRID_TENNIS_06_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">そんな　アタクシが
ゆうがに　おくりもの！▼</language>
		<language name="JPN_KANJI" width="216">そんな　アタクシが
優雅に　贈り物！▼</language>
	</row>

	<row id="TRID_TENNIS_06_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
