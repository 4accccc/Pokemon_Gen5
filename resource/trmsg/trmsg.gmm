	</row>

	<row id="TRID_KINDERGARTENW_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ぐわーお！▼
あたち　ポケモンなのよー！▼</language>
		<language name="JPN_KANJI" width="216">ぐわーお！▼
あたち　ポケモンなのよー！▼</language>
	</row>

	<row id="TRID_KINDERGARTENW_07_TRMSG_FIGHT_LOSE">
