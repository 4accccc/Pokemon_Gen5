	</row>

	<row id="TRID_BACKPACKERW_26_TRMSG_FIGHT_START">
		<language name="JPN" width="216">バックパッカーで　ありつつ
トレジャーハンターも　してます！▼</language>
		<language name="JPN_KANJI" width="216">バックパッカーで　ありつつ
トレジャーハンターも　してます！▼</language>
	</row>

	<row id="TRID_BACKPACKERW_26_TRMSG_FIGHT_LOSE">
