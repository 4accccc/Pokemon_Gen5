	</row>

	<row id="TRID_RANGERM_24_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ポケモンの　エネルギー
むちゃくちゃ　かんじたぜ！</language>
		<language name="JPN_KANJI" width="216">ポケモンの　エネルギー
むちゃくちゃ　感じたぜ！</language>
	</row>

	<row id="TRID_RANGERM_24_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
