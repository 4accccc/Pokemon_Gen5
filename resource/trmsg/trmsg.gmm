	<row id="TRID_SOCCER_12_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">いきおいを　つけて　くりだしても
ポケモンは　つよく　ならない！？</language>
		<language name="JPN_KANJI" width="216">勢いを　つけて　繰りだしても
ポケモンは　強く　ならない！？</language>
	</row>

	<row id="TRID_SOCCER_12_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ポケモンも　スポーツも
どうぐは　じゅうよう！▼</language>
		<language name="JPN_KANJI" width="216">ポケモンも　スポーツも
道具は　重要！▼</language>
	</row>

	<row id="TRID_SOCCER_12_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">サッカーとは　べつメニューで
ポケモンしょうぶの　れんしゅうを▽
はじめると　するよ</language>
		<language name="JPN_KANJI" width="216">サッカーとは　別メニューで
ポケモン勝負の　練習を▽
はじめると　するよ</language>
	</row>

	<row id="TRID_BASKET_08_TRMSG_FIGHT_START">
		<language name="JPN" width="216">とびちる　あせが
せいしゅんの　バロメーターだッ！▼</language>
		<language name="JPN_KANJI" width="216">飛び散る　汗が
青春の　バロメーターだッ！▼</language>
	</row>

	<row id="TRID_BASKET_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">まけても　せいしゅん！
いい　あせ　かいたぜ！</language>
		<language name="JPN_KANJI" width="216">負けても　青春！
いい汗　かいたぜ！</language>
	</row>

	<row id="TRID_BASKET_08_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">あせを　かいた　ときは
この　どうぐ　だぜ！▼</language>
		<language name="JPN_KANJI" width="216">汗を　かいた　ときは
この　道具だぜ！▼</language>
	</row>

	<row id="TRID_BASKET_08_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">オレの　ウリは
ほうふな　うんどうりょう！▼
すべては　あせをかく　ためだぜ</language>
		<language name="JPN_KANJI" width="216">オレの　ウリは
豊富な　運動量！▼
すべては　汗をかく　ためだぜ</language>
	</row>

	<row id="TRID_BASKET_09_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ヨー！　ブラザー！▼
オレさまの　トリッキーな　ドリブルを
みぬくことが　できるかな！？▼</language>
		<language name="JPN_KANJI" width="216">ヨー！　ブラザー！▼
オレさまの　トリッキーな　ドリブルを
見抜くことが　できるかな！？▼</language>
	</row>

	<row id="TRID_BASKET_09_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ちょっと！　ちゃんと　みろよ！
ずっと　ドリブル　してたのに！</language>
		<language name="JPN_KANJI" width="216">ちょっと！　ちゃんと　みろよ！
ずっと　ドリブル　してたのに！</language>
	</row>

	<row id="TRID_BASKET_09_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ドリブル　しながら
どうぐを　パスだぜ！▼</language>
		<language name="JPN_KANJI" width="216">ドリブル　しながら
道具を　パスだぜ！▼</language>
	</row>

	<row id="TRID_BASKET_09_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">だいすきな　ポケモンと
だいすきな　バスケが　できる！▼
オレは　しあわせもの　だぜ！</language>
		<language name="JPN_KANJI" width="216">大好きな　ポケモンと
大好きな　バスケが　できる！▼
オレは　しあわせもの　だぜ！</language>
	</row>

	<row id="TRID_BASKET_10_TRMSG_FIGHT_START">
		<language name="JPN" width="216">わかものよ！
いい　あせ　かいてるか？▼</language>
		<language name="JPN_KANJI" width="216">若者よ！
いい汗　かいてるか？▼</language>
	</row>

	<row id="TRID_BASKET_10_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あせを　かいた　あとは
すいぶん　ほきゅうを　わすれずに！</language>
		<language name="JPN_KANJI" width="216">汗を　かいた　あとは
水分補給を　忘れずに！</language>
	</row>

	<row id="TRID_BASKET_10_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">この　どうぐを　あげるから
きみも　あせを　かこうな！▼</language>
		<language name="JPN_KANJI" width="216">この　どうぐを　あげるから
きみも　あせを　かこうな！▼</language>
	</row>

	<row id="TRID_BASKET_10_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ひとは　こきゅうを　するだけで
すいぶんを　うしなう！▼
つまり　いきることは
あせを　かくことだ！</language>
		<language name="JPN_KANJI" width="216">人は　呼吸を　するだけで
水分を　失う！▼
つまり　生きることは
汗を　かくことだ！</language>
	</row>

	<row id="TRID_BASKET_11_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ヘイ！　トレーナー！▼
オレさまの　ロングシュートの
ひきょりに　おどろきな！▼</language>
		<language name="JPN_KANJI" width="216">ヘイ！　トレーナー！▼
オレさまの　ロングシュートの
飛距離に　驚きな！▼</language>
	</row>

	<row id="TRID_BASKET_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ロングシュートじゃ　まけないが
ポケモンしょうぶは　まだまだだぜ</language>
		<language name="JPN_KANJI" width="216">ロングシュートじゃ　負けないが
ポケモン勝負は　まだまだだぜ</language>
	</row>

	<row id="TRID_BASKET_11_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">きみに　どうぐを　ショートパス！▼</language>
		<language name="JPN_KANJI" width="216">きみに　道具を　ショートパス！▼</language>
	</row>

	<row id="TRID_BASKET_11_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">バスケの　テクニックと
ポケモンしょうぶの　テクニック！▼
どっちも　おくが　ふかいぜ</language>
		<language name="JPN_KANJI" width="216">バスケの　テクニックと
ポケモン勝負の　テクニック！▼
どっちも　奥が　深いぜ</language>
	</row>

	<row id="TRID_BASKET_12_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ヨー！　ブラザー！▼
どうだい　このボール！
ピッカピカに　みがいたんだぜ！▼</language>
		<language name="JPN_KANJI" width="216">ヨー！　ブラザー！▼
どうだい　このボール！
ピッカピカに　磨いたんだぜ！▼</language>
	</row>

	<row id="TRID_BASKET_12_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">しょうぶには　まけたが　ボールの
かがやきでは　まけてないぜ！</language>
		<language name="JPN_KANJI" width="216">勝負には　負けたが　ボールの
輝きでは　負けてないぜ！</language>
	</row>

	<row id="TRID_BASKET_12_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">この　どうぐも
ピカピカに　みがいたんだぜ！▼</language>
		<language name="JPN_KANJI" width="216">この道具も
ピカピカに　磨いたんだぜ！▼</language>
	</row>

	<row id="TRID_BASKET_12_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">つかう　ボールを
だいじに　あつかうってのは▽
スポーツも　ポケモンも　おなじだろ？</language>
		<language name="JPN_KANJI" width="216">使う　ボールを
大事に　扱うってのは▽
スポーツも　ポケモンも　同じだろ？</language>
	</row>

	<row id="TRID_TENNIS_08_TRMSG_FIGHT_START">
		<language name="JPN" width="216">れんしゅうじあいが　ちかいのよ！▼
あんたを　かべに　みたてて
スマッシュの　れんしゅうさ！▼</language>
		<language name="JPN_KANJI" width="216">練習試合が　近いのよ！▼
あんたを　壁に　みたてて
スマッシュの　練習さ！▼</language>
	</row>

	<row id="TRID_TENNIS_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ハアッ！　ハア　ハア　ハア……
いい　トレーニングに　なったわ……</language>
		<language name="JPN_KANJI" width="216">ハアッ！　ハア　ハア　ハア……
いい　トレーニングになったわ……</language>
	</row>

	<row id="TRID_TENNIS_08_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ハア　ハア　ハア
ハア　ハア　ハア……！▼</language>
		<language name="JPN_KANJI" width="216">ハア　ハア　ハア
ハア　ハア　ハア……！▼</language>
	</row>

	<row id="TRID_TENNIS_08_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">あんたと　ワタシは　であったばかり
ラブゲームからの　スタートね！</language>
		<language name="JPN_KANJI" width="216">あんたと　ワタシは　であったばかり
ラブゲームからの　スタートね！</language>
	</row>

	<row id="TRID_TENNIS_09_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ラリーで　きたえた
この　きゃくりょく！▽
みて　おどろきなさい！▼</language>
		<language name="JPN_KANJI" width="216">ラリーで　鍛えた　この脚力！
みて　驚きなさい！▼</language>
	</row>

	<row id="TRID_TENNIS_09_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ポケモンしょうぶは
また　べつの　はなしね……</language>
		<language name="JPN_KANJI" width="216">ポケモン勝負は
また　別の　話ね……</language>
	</row>

	<row id="TRID_TENNIS_09_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">どうぐの　プレゼントよ！
みて　おどろきなさい！▼</language>
		<language name="JPN_KANJI" width="216">道具の　プレゼントよ！
みて　驚きなさい！▼</language>
	</row>

	<row id="TRID_TENNIS_09_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">すばやい　ポケモンと
トレーニング　すると▽
しぜんと　きゃくりょくが　つくの</language>
		<language name="JPN_KANJI" width="216">すばやい　ポケモンと
トレーニング　すると▽
自然と　脚力が　つくの</language>
	</row>

	<row id="TRID_TENNIS_10_TRMSG_FIGHT_START">
		<language name="JPN" width="216">たりゅうじあいが　ちかいのよ！▼
あんたを　かべに　みたてて
スマッシュの　れんしゅうよ！▼</language>
		<language name="JPN_KANJI" width="216">他流試合が　近いのよ！▼
あんたを　壁に　みたてて
スマッシュの　練習よ！▼</language>
	</row>

	<row id="TRID_TENNIS_10_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ハアッ！　ハア　ハア　ハア……
いい　トレーニングになったわ……</language>
		<language name="JPN_KANJI" width="216">ハアッ！　ハア　ハア　ハア……
いい　トレーニングに　なったわ……</language>
	</row>

	<row id="TRID_TENNIS_10_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ハア　ハア　ハア
ハア　ハア　ハア……！▼</language>
		<language name="JPN_KANJI" width="216">ハア　ハア　ハア
ハア　ハア　ハア……！▼</language>
	</row>

	<row id="TRID_TENNIS_10_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">あんたと　ワタシは　であったばかり
ラブゲームからの　スタートね！</language>
		<language name="JPN_KANJI" width="216">あんたと　ワタシは　出会ったばかり
ラブゲームからの　スタートね！</language>
	</row>

	<row id="TRID_TENNIS_11_TRMSG_FIGHT_START">
		<language name="JPN" width="216">どんな　ラフボールも　みぬく
この　どうたいしりょく！▽
なにごとも　みのがさないわよ！▼</language>
		<language name="JPN_KANJI" width="216">どんな　ラフボールも　見抜く
この　動体視力！▽
なにごとも　見逃さないわよ！▼</language>
	</row>

	<row id="TRID_TENNIS_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あなたの　つよさ
めに　やきつけたわ！</language>
		<language name="JPN_KANJI" width="216">あなたの　強さ
目に　焼きつけたわ！</language>
	</row>

	<row id="TRID_TENNIS_11_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">この　プレゼントも
めに　やきつけてね！▼</language>
		<language name="JPN_KANJI" width="216">この　プレゼントも
目に　焼きつけてね！▼</language>
	</row>

	<row id="TRID_TENNIS_11_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">うちかえさずに　スルーしたほうが
いいときも　あるの▼
とっさの　はんだんりょくも
テニスには　ひつよう　なのよ</language>
		<language name="JPN_KANJI" width="216">打ち返さずに　スルーしたほうが
いいときも　あるの▼
とっさの　判断力も
テニスには　必要なのよ</language>
	</row>

	<row id="TRID_TENNIS_12_TRMSG_FIGHT_START">
		<language name="JPN" width="216">いとを　はりに　とおすような
ピンポイント　スマッシュ▽
うけてみなさい！▼</language>
		<language name="JPN_KANJI" width="216">糸を　針に　通すような
ピンポイント　スマッシュ▽
受けてみなさい！▼</language>
	</row>

	<row id="TRID_TENNIS_12_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">どんな　こうげきにも　たいおうする
なんという　ふところの　ふかさ！</language>
		<language name="JPN_KANJI" width="216">どんな　攻撃にも　対応する
なんという　懐の　深さ！</language>
	</row>

	<row id="TRID_TENNIS_12_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">わたしも　どうぐの　プレゼントで
ふところの　ふかさ　みせちゃうわ▼</language>
		<language name="JPN_KANJI" width="216">わたしも　道具の　プレゼントで
懐の　深さ　みせちゃうわ▼</language>
	</row>

	<row id="TRID_TENNIS_12_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">いっきゅう　いっきゅうに
ぜんしん　ぜんれいを　こめる！▼
じんせいは　いつも　マッチポイント！</language>
		<language name="JPN_KANJI" width="216">一球　一球に
全身全霊を　こめる！▼
人生は　いつも　マッチポイント！</language>
	</row>

	<row id="TRID_BREEDERM_04_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ポケモンブリーダーとしての
しゅぎょうのため　あいてを！▼</language>
		<language name="JPN_KANJI" width="216">ポケモンブリーダーとしての
修行のため　相手を！▼</language>
	</row>

	<row id="TRID_BREEDERM_04_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……まだまだ　でした
もっと　そだてます！</language>
		<language name="JPN_KANJI" width="216">……まだまだ　でした
もっと　育てます！</language>
	</row>

	<row id="TRID_BREEDERM_04_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ありがとう　ございます！▼
すごく　べんきょうに　なりました
また　おあいて　してください！</language>
		<language name="JPN_KANJI" width="216">ありがとう　ございます！▼
すごく　勉強に　なりました
また　お相手　してください！</language>
	</row>

	<row id="TRID_RANGERM_15_TRMSG_FIGHT_START">
		<language name="JPN" width="216">いつも　このあたりを
パトロールしている　この　オレ！▼
ちけいを　いかした
ポケモンしょうぶを　おみせする！▼</language>
		<language name="JPN_KANJI" width="216">いつも　この辺りを
パトロールしている　この　オレ！▼
地形を　生かした
ポケモン勝負を　おみせする！▼</language>
	</row>

	<row id="TRID_RANGERM_15_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ちけいを　いかしきれなかった……
なんたることだ！！</language>
		<language name="JPN_KANJI" width="216">地形を　生かしきれなかった……
なんたることだ！！</language>
	</row>

	<row id="TRID_RANGERM_15_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">レンジャーが　つねに　もっている
これを　きみに……！▼</language>
		<language name="JPN_KANJI" width="216">レンジャーが　常に　持っている
これを　きみに……！▼</language>
	</row>

	<row id="TRID_RANGERM_15_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">もりも　そこに　くらす
ポケモンも　いきている……▼
まいにち　なにかしら　へんかして
パトロールも　たのしいんだ！</language>
		<language name="JPN_KANJI" width="216">森も　そこに　暮らす
ポケモンも　生きている……▼
毎日　なにかしら　変化して
パトロールも　楽しいんだ！</language>
	</row>

	<row id="TRID_RANGERW_15_TRMSG_FIGHT_START">
		<language name="JPN" width="216">いきは　ピッタリ！▼
おどろきの　コンビネーションで
レンジャーのこと　おしえてあげる！▼</language>
		<language name="JPN_KANJI" width="216">息は　ピッタリ！▼
驚きの　コンビネーションで
レンジャーのこと　教えてあげる！▼</language>
	</row>

	<row id="TRID_RANGERW_15_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あなたたちの　こと
おそわっちゃったわね！</language>
		<language name="JPN_KANJI" width="216">あなたたちの　こと
教わっちゃったわね！</language>
	</row>

	<row id="TRID_RANGERW_15_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">この　きのみは
しっている？▼</language>
		<language name="JPN_KANJI" width="216">この　きのみは
知っている？▼</language>
	</row>

	<row id="TRID_RANGERW_15_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">あなたも　みみを　すませて……！▼
ポケモンや　くさきの
こきゅうする　おとが　きこえるかも</language>
		<language name="JPN_KANJI" width="216">あなたも　耳を　澄ませて……！▼
ポケモンや　草木の
息吹が　きこえるかも</language>
	</row>

	<row id="TRID_FISHING_16_TRMSG_FIGHT_START">
		<language name="JPN" width="216">おれは　すべてを　あいする
すばらしい　つりびと！</language>
		<language name="JPN_KANJI" width="216">おれは　すべてを　愛する
すばらしい　つりびと！</language>
	</row>

	<row id="TRID_FISHING_16_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ざんねんな　けっか　すらも
おれは　あいしてやる！</language>
		<language name="JPN_KANJI" width="216">残念な　結果すらも
おれは　愛してやる！</language>
	</row>

	<row id="TRID_FISHING_16_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ヒウンシティから　でる
ロイヤルイッシュごう　で▽
うみづりを　してみたいぞ！</language>
		<language name="JPN_KANJI" width="216">ヒウンシティから　出航する
ロイヤルイッシュ号で▽
海釣りを　してみたいぞ！</language>
	</row>

	<row id="TRID_FISHING_17_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あーっ！　ばらしてしまった！
あと　ちょっとで　つれたのに！▽
こういうときは　ポケモンしょうぶ！▼</language>
		<language name="JPN_KANJI" width="216">あーっ！　ばらしてしまった！
あと　ちょっとで　釣れたのに！▽
こういうときは　ポケモン勝負！▼</language>
	</row>

	<row id="TRID_FISHING_17_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">くーっ！　まけたが
いい　きぶん　てんかんに　なった！</language>
		<language name="JPN_KANJI" width="216">くーっ！　負けたが
いい　気分転換に　なった！</language>
	</row>

	<row id="TRID_FISHING_17_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">えものを　にがした　くらいで
さわいでいる　ようじゃあ▽
いい　つりびとには　なれないよ▽
つねに　まえむき　でないとね！</language>
		<language name="JPN_KANJI" width="216">獲物を　逃がした　くらいで
騒いでいる　ようじゃあ▽
いい　つりびとには　なれないよ▽
常に　前向きで　ないとね！</language>
	</row>

	<row id="TRID_FISHING_18_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ムム！　できる　かんじの
ポケモントレーナー！▼
おあいて　すれば　なにか
ごくいが　つかめるかも　だ！▼</language>
		<language name="JPN_KANJI" width="216">ムム！　できる　感じの
ポケモントレーナー！▼
お相手すれば　なにか
極意が　つかめるかも　だ！▼</language>
	</row>

	<row id="TRID_FISHING_18_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">うむ！　つよいやつは　つよい
アンド　よわいやつは　よわい</language>
		<language name="JPN_KANJI" width="216">うむ！　強いやつは　強い
アンド　弱いやつは　弱い</language>
	</row>

	<row id="TRID_FISHING_18_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">つりの　ごくい　ね……
「つれるまで　ねばる」だね</language>
		<language name="JPN_KANJI" width="216">釣りの　極意　ね……
「釣れるまで　粘る」だね</language>
	</row>

	<row id="TRID_FISHING_19_TRMSG_FIGHT_START">
		<language name="JPN" width="216">おまえさん！　どんな　すごい
ポケモンを　つれているんだい！？▼</language>
		<language name="JPN_KANJI" width="216">おまえさん！　どんな　すごい
ポケモンを　連れているんだい！？▼</language>
	</row>

	<row id="TRID_FISHING_19_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ほほー！
こりゃ　たいした　ポケモンだ！</language>
		<language name="JPN_KANJI" width="216">ほほー！
こりゃ　たいした　ポケモンだ！</language>
	</row>

	<row id="TRID_FISHING_19_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">じぶんの　ポケモンが
じぶんにとって　いちばん　ですからね▽
たにんと　くらべたり　しないですよ</language>
		<language name="JPN_KANJI" width="216">自分の　ポケモンが
自分にとって　一番　ですからね！▽
他人と　比べたり　しないですよ</language>
	</row>

	<row id="TRID_PARASOL_11_TRMSG_FIGHT_START">
		<language name="JPN" width="216">パラソル　かたてに　ビーチで
ひとり　たたずむ　おんな……▽
ねえ　あなた　あいてしてよ？▼</language>
		<language name="JPN_KANJI" width="216">パラソル片手に　ビーチで
１人　たたずむ　女……▽
ねえ　あなた　相手してよ？▼</language>
	</row>

	<row id="TRID_PARASOL_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">しがいせんを　カットできても
わざは　カットできないのね……</language>
		<language name="JPN_KANJI" width="216">紫外線を　カットできても
技は　カットできないのね……</language>
	</row>

	<row id="TRID_PARASOL_11_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ビーチに　パラソルは
ひつようって　きいたんだけど……▽
もってるのは　アタシだけ？</language>
		<language name="JPN_KANJI" width="216">ビーチに　パラソルは
必要って　きいたんだけど……▽
持ってるのは　アタシだけ？</language>
	</row>

	<row id="TRID_RANGERM_14_TRMSG_POKE_UNDER_TWO">
		<language name="JPN" width="216">たたかえる　ポケモンを
３ひきいじょう　つれていたら▽
レッツ　ローテーションだ！</language>
		<language name="JPN_KANJI" width="216">戦える　ポケモンを
３匹以上　連れていたら▽
レッツ　ローテーションだ！</language>
	</row>

	<row id="TRID_RANGERM_14_TRMSG_FIGHT_START">
		<language name="JPN" width="216">いきの　あった　３ひきの
れんけいが　かなめ！▽
レッツ　ローテーションっ！！▼</language>
		<language name="JPN_KANJI" width="216">息の　あった
３匹の　連携が　要！▽
レッツ　ローテーションっ！！▼</language>
	</row>

	<row id="TRID_RANGERM_14_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ベストな　ポケモン
ベストな　ポジションを　あやまった！</language>
		<language name="JPN_KANJI" width="216">ベストな　ポケモン
ベストな　ポジションを　誤った！</language>
	</row>

	<row id="TRID_RANGERM_14_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ナイスな　チームワークに
けいいを　ひょうして▽
この　きのみを　あげよう！▼</language>
		<language name="JPN_KANJI" width="216">ナイスな　チームワークに
敬意を　表して▽
この　きのみを　あげよう！▼</language>
	</row>

	<row id="TRID_RANGERM_14_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ローテーションバトルなら
いつも　いじょうの　よみが　いる！▽
