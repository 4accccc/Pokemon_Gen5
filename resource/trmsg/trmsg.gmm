	</row>

	<row id="TRID_TANPAN_29_TRMSG_FIGHT_START">
		<language name="JPN" width="216">オレの　ポケモン
ジットリ　しめって　いくぜ！▼</language>
		<language name="JPN_KANJI" width="216">オレの　ポケモン
ジットリ　湿っていくぜ！▼</language>
	</row>

	<row id="TRID_TANPAN_29_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">うるおいでは　まけてない……
そう　しんじることに　するぜ</language>
		<language name="JPN_KANJI" width="216">うるおいでは　負けてない……
そう　信じることに　するぜ</language>
	</row>

	<row id="TRID_TANPAN_29_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ジメジメしてるのが　いいんだ
みんな　あかるく　とか　おかしいだろ</language>
		<language name="JPN_KANJI" width="216">ジメジメしてるのが　いいんだ
みんな　明るく　とか　おかしいだろ</language>
	</row>

	<row id="TRID_MINI_22_TRMSG_FIGHT_START">
		<language name="JPN" width="216">それ　ポケモンずかん！？▼
じゃあ　いろんな　ポケモンを
みせてくれると　うれしいよ！▼</language>
		<language name="JPN_KANJI" width="216">それ　ポケモン図鑑！？▼
じゃあ　いろんな　ポケモンを
みせてくれると　うれしいよ！▼</language>
	</row>

	<row id="TRID_MINI_22_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……！
そんな　ポケモン　しらない</language>
		<language name="JPN_KANJI" width="216">……！
そんな　ポケモン　知らない</language>
	</row>

	<row id="TRID_MINI_22_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">むう……　しつげんに　いけば
あたらしい　ポケモンと　であえるかな？</language>
		<language name="JPN_KANJI" width="216">むう……　湿原に　行けば
新しい　ポケモンと　出会えるかな？</language>
	</row>

	<row id="TRID_PARASOL_12_TRMSG_POKE_UNDER_TWO">
		<language name="JPN" width="216">トリプルバトルは　ポケモン
３びきでの　あたらしい　しょうぶよ！</language>
		<language name="JPN_KANJI" width="216">トリプルバトルは　ポケモン
３匹での　新しい　勝負よ！</language>
	</row>

	<row id="TRID_PARASOL_12_TRMSG_FIGHT_START">
		<language name="JPN" width="216">チャップ　チャップって　おと！
あなたの　あしおと　だったのね▽
もう　あいくるしいわね！▼</language>
		<language name="JPN_KANJI" width="216">チャップ　チャップって　音！
あなたの　足音だったのね▽
もう　愛くるしいわね！▼</language>
	</row>

	<row id="TRID_PARASOL_12_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">そんなに　つよすぎると
かわいくないわよ！</language>
		<language name="JPN_KANJI" width="216">そんなに　強すぎると
かわいくないわよ！</language>
	</row>

	<row id="TRID_PARASOL_12_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">あしおと　うらないに　よると……▼
チャップ　チャップな　あなたは
ポケモンに　すかれる　トレーナーさん</language>
		<language name="JPN_KANJI" width="216">足音占いに　よると……▼
チャップ　チャップな　あなたは
ポケモンに　好かれる　トレーナーさん</language>
	</row>

	<row id="TRID_PARASOL_13_TRMSG_POKE_UNDER_TWO">
		<language name="JPN" width="216">ローテーションバトルは　ポケモン
３びきでの　ポケモンしょうぶ　よ！</language>
		<language name="JPN_KANJI" width="216">ローテーションバトルは　ポケモン
３匹での　ポケモン勝負よ！</language>
	</row>

	<row id="TRID_PARASOL_13_TRMSG_FIGHT_START">
		<language name="JPN" width="216">パラソルを　くるりと　まわせば
あめの　なか　さいた　はなのよう！▼</language>
		<language name="JPN_KANJI" width="216">パラソルを　くるりと　回せば
雨の中　咲いた　花のよう！▼</language>
	</row>

	<row id="TRID_PARASOL_13_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">えい！　パラソルを　まわして
すいてき　とばしてあげる！</language>
		<language name="JPN_KANJI" width="216">えい！　パラソルを　まわして
水滴　飛ばしてあげる！</language>
	</row>

	<row id="TRID_PARASOL_13_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">あめのひに　かさをさすのも
コートをきるのも　ぬれちゃうのも▽
すきなように　すれば　いいの！</language>
		<language name="JPN_KANJI" width="216">雨の日に　傘をさすのも
コートを着るのも　ぬれちゃうのも▽
好きなように　すれば　いいの！</language>
	</row>

	<row id="TRID_FISHING_26_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ほんものの　つりびとは
きが　みじかい！　しょうぶ！！▼</language>
		<language name="JPN_KANJI" width="216">本物の　つりびとは
気が　短い！　勝負！！▼</language>
	</row>

	<row id="TRID_FISHING_26_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">まけた！
おわり！！</language>
		<language name="JPN_KANJI" width="216">負けた！
終わり！！</language>
	</row>

	<row id="TRID_FISHING_26_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">なぜ　ほんものの　つりびとは
きが　みじかいか？▼
それは　ポケモンが　つれないと
ムキになって　ばしょを　かえるからだ！</language>
		<language name="JPN_KANJI" width="216">なぜ　本物の　つりびとは
気が　短いか？▼
それは　ポケモンが　釣れないと
ムキになって　場所を　変えるからだ！</language>
	</row>

	<row id="TRID_RANGERM_26_TRMSG_FIGHT_START">
		<language name="JPN" width="216">じぶんをしり　あいてをしり
まわりを　しるのが　レンジャーさ！▼</language>
		<language name="JPN_KANJI" width="216">自分を知り　相手を知り
周りを　知るのが　レンジャーさ！▼</language>
	</row>

	<row id="TRID_RANGERM_26_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あいてを　しるって
むずかしいな！</language>
		<language name="JPN_KANJI" width="216">相手を　知るって
難しいな！</language>
	</row>

	<row id="TRID_RANGERM_26_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">こいつの　ことは
知ってるかい？▼</language>
		<language name="JPN_KANJI" width="216">こいつの　ことは
しってるかい？▼</language>
	</row>

	<row id="TRID_RANGERM_26_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">どんな　やせいポケモンが
せいそく　しているのか　わかれば▼
あいしょうの　いい
ポケモンを　つれて　あるけるだろ</language>
		<language name="JPN_KANJI" width="216">どんな　野生ポケモンが
生息しているのか　わかれば▼
相性の　いい
ポケモンを　連れて　歩けるだろ</language>
	</row>

	<row id="TRID_RANGERW_26_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ポケモントレーナーは　しょうぶで
ゆうじょうを　はぐくむもの！▼</language>
		<language name="JPN_KANJI" width="216">ポケモントレーナーは　勝負で
友情を　育むもの！▼</language>
	</row>

	<row id="TRID_RANGERW_26_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">この　まけた　きもち……
まるで　そこなしぬま……</language>
		<language name="JPN_KANJI" width="216">この　負けた　気持ち……
まるで　底なし沼……</language>
	</row>

	<row id="TRID_RANGERW_26_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">この　ラムのみは　あなたとの
ゆうじょうの　あかし　よ！▼</language>
		<language name="JPN_KANJI" width="216">この　ラムのみは
あなたとの　友情の　証よ！▼</language>
	</row>

	<row id="TRID_RANGERW_26_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">じっと　みみを　すませて
ポケモンの　なきごえや　あしおと……
きぎや　ぬまの　こきゅうを　きくのよ</language>
		<language name="JPN_KANJI" width="216">じっと　耳を　すませて
ポケモンの　鳴き声や　足音……▽
木々や　沼の　呼吸を　きくのよ</language>
	</row>

	<row id="TRID_FISHING_27_TRMSG_FIGHT_START">
		<language name="JPN" width="216">トレーナーが　いれば
とにかく　しょうぶを　する！▼</language>
		<language name="JPN_KANJI" width="216">トレーナーが　いれば
とにかく　勝負を　する！▼</language>
	</row>

	<row id="TRID_FISHING_27_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">そんな　つよい　トレーナー
みたことがない！</language>
		<language name="JPN_KANJI" width="216">そんな　つよい　トレーナー
みたことがない！</language>
	</row>

	<row id="TRID_FISHING_27_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">だれとでも　しょうぶ　するよ▼
だって　ぼくが　みたことのない
みずタイプの　ポケモンを▽
みせてくれるかも　しれないからね</language>
		<language name="JPN_KANJI" width="216">だれとでも　勝負するよ▼
だって　ぼくが　みたことのない
みずタイプの　ポケモンを▽
みせてくれるかも　しれないからね</language>
	</row>

	<row id="TRID_FISHING_28_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あとすこし……
きっかけが　ほしい！！▼</language>
		<language name="JPN_KANJI" width="216">あと少し……
きっかけが　ほしい！！▼</language>
	</row>

	<row id="TRID_FISHING_28_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……できた！
にゅうこんの　はいく！</language>
		<language name="JPN_KANJI" width="216">……できた！
入魂の　俳句！</language>
	</row>

	<row id="TRID_FISHING_28_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">みずうみに　うつるわたしに
かった　きみ……</language>
		<language name="JPN_KANJI" width="216">湖に　うつるわたしに
勝った　きみ……</language>
	</row>

	<row id="TRID_KARATE_22_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">がんじょうを　うわまわる　つよさ……
きみ！　がんじょうブレイカー　だな！</language>
		<language name="JPN_KANJI" width="216">がんじょうを　上回る　強さ……
きみ！　がんじょうブレイカー　だな！</language>
	</row>

	<row id="TRID_BOSS_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">もっと！　キミの　ポケモンの
こえを　きかせてくれ！</language>
		<language name="JPN_KANJI" width="216">もっと！　キミの　ポケモンの
声を　聴かせてくれ！</language>
	</row>

	<row id="TRID_BOSS_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">まだ　さいごの　トモダチが　いる！
ボクたちは　あきらめないよ！</language>
		<language name="JPN_KANJI" width="216">まだ　最後の　トモダチが　いる！
ボクたちは　あきらめないよ！</language>
	</row>

	<row id="TRID_BOSS_01_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<language name="JPN" width="216">トモダチの　いたみを　うけ
ボクが　えらぶのは……！</language>
		<language name="JPN_KANJI" width="216">トモダチの　痛みを　受け
ボクが　えらぶのは……！</language>
	</row>

	<row id="TRID_BOSS_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">キミの　ぜんしんから　あふれる
ポケモンへの　ラブ！　かんじたよ！</language>
		<language name="JPN_KANJI" width="216">キミの　全身から　あふれる
ポケモンへの　ラブ！　感じたよ！</language>
	</row>

	<row id="TRID_BOSS_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">もっと！　キミの　ポケモンの
こえを　きかせてくれ！</language>
		<language name="JPN_KANJI" width="216">もっと！　キミの　ポケモンの
声を　聴かせてくれ！</language>
	</row>

	<row id="TRID_BOSS_02_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">まだ　さいごの　トモダチが　いる！
ボクたちは　あきらめないよ！</language>
		<language name="JPN_KANJI" width="216">まだ　最後の　トモダチが　いる！
ボクたちは　あきらめないよ！</language>
	</row>

	<row id="TRID_BOSS_02_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<language name="JPN" width="216">トモダチの　いたみを　うけ
ボクが　えらぶ　わざは……！</language>
		<language name="JPN_KANJI" width="216">トモダチの　痛みを　受け
ボクが　選ぶ　技は……！</language>
	</row>

	<row id="TRID_BOSS_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">キミの　ぜんしんから　あふれる
ポケモンへの　ラブ！　うけとった！</language>
		<language name="JPN_KANJI" width="216">キミの　全身から　あふれる
ポケモンへの　ラブ！　受け取った！</language>
	</row>

	<row id="TRID_ELITEM_37_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ポケモンと　オマエが
どれだけ　できるか　しょうめいしろ！▼</language>
		<language name="JPN_KANJI" width="216">ポケモンと　オマエが
どれだけ　できるか　証明しろ！▼</language>
	</row>

	<row id="TRID_ELITEM_37_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">オレたちよりは　できる！
それは　しょうめい　されたな！</language>
		<language name="JPN_KANJI" width="216">オレたちよりは　できる！
それは　証明されたな！</language>
	</row>

	<row id="TRID_ELITEM_37_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">つよさの　しょうめい　なんて
じつは　どうでも　いいんだよ▼
オレと！　ポケモンが！
どれだけ　できるか　しってるからな！</language>
		<language name="JPN_KANJI" width="216">強さの　証明なんて
じつは　どうでも　いいんだよ▼
オレと！　ポケモンが！
どれだけ　できるか　知ってるからな！</language>
	</row>

	<row id="TRID_ESPW_13_TRMSG_FIGHT_START">
		<language name="JPN" width="216">わたしの　サイキックパワーで
ボールから　ポケモンを　だす！▼</language>
		<language name="JPN_KANJI" width="216">わたしの　サイキックパワーで
ボールから　ポケモンを　だす！▼</language>
	</row>

	<row id="TRID_ESPW_13_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ままならないものね！</language>
		<language name="JPN_KANJI" width="216">ままならないものね！</language>
	</row>

	<row id="TRID_ESPW_13_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">してんのうの　ひとり　カトレアさん▼
すっごい　エスパーらしいから
ぜひ　ちょうせん　してみたいんだあ</language>
		<language name="JPN_KANJI" width="216">四天王の　一人　カトレアさん▼
すっごい　エスパーらしいから
ぜひ　挑戦してみたいんだあ</language>
	</row>

	<row id="TRID_ELITEW_36_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ポケモンリーグに　いくまえの
うでだめし　させてもらうわね！▼</language>
		<language name="JPN_KANJI" width="216">ポケモンリーグに　行く前の
腕試し　させてもらうわね！▼</language>
	</row>

	<row id="TRID_ELITEW_36_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あたりまえ　だけど
うえには　うえが　いるのね……</language>
		<language name="JPN_KANJI" width="216">当たり前　だけど
上には　上が　いるのね……</language>
	</row>

	<row id="TRID_ELITEW_36_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ポケモンリーグにて　ちょうせんを
まつと　いう　してんのう……▽
どんな　ひとたち　かしら？</language>
		<language name="JPN_KANJI" width="216">ポケモンリーグにて
挑戦を待つ　という　四天王……▽
どんな　人たちかしら？</language>
	</row>

	<row id="TRID_ESPM_14_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ゴーストポケモンが　ささやくのさ……
きみは　ただもの　じゃないって▼</language>
		<language name="JPN_KANJI" width="216">ゴーストポケモンが　ささやくのさ……
君は　ただ者　じゃないって▼</language>
	</row>

	<row id="TRID_ESPM_14_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">よかん　てきちゅう！
やはり　ただもの　じゃない</language>
		<language name="JPN_KANJI" width="216">予感　的中！
やはり　ただ者　じゃない</language>
	</row>

	<row id="TRID_ESPM_14_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">もしかして　きみと　ポケモンは
つよい　オーラを　だしているのか！？</language>
		<language name="JPN_KANJI" width="216">もしかして　君と　ポケモンは
強い　オーラを　発しているのか！？</language>
	</row>

	<row id="TRID_ELITEM_38_TRMSG_FIGHT_START">
		<language name="JPN" width="216">オレは　ポケモンと　いるだけでは
まんぞくは　できない！　かちたい！▼</language>
		<language name="JPN_KANJI" width="216">オレは　ポケモンと　いるだけでは
満足は　できない！　勝ちたい！▼</language>
	</row>

	<row id="TRID_ELITEM_38_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">クッ！　まさかまさかの
だいはいぼく　だ！</language>
		<language name="JPN_KANJI" width="216">クッ！　まさかまさかの
大敗北だ！</language>
	</row>

	<row id="TRID_ELITEM_38_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">オレは　ポケモンと　いるだけでは
まんぞくは　できない！　かちたい！▼
だが　ポケモンと　いるだけで
やすらぐ　ひとが　いるのも　しってるよ</language>
		<language name="JPN_KANJI" width="216">オレは　ポケモンと　いるだけでは
満足は　できない！　勝ちたい！▼
だが　ポケモンと　いるだけで
安らぐ　人が　いるのも　知ってるよ</language>
	</row>

	<row id="TRID_ELITEW_37_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あたしたちの　けっそく
だれにも　まけないんだから！▼</language>
		<language name="JPN_KANJI" width="216">あたしたちの　結束
だれにも　負けないんだから！▼</language>
	</row>

	<row id="TRID_ELITEW_37_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">かてなかった……
でも　いいのよ</language>
		<language name="JPN_KANJI" width="216">勝てなかった……
でも　いいのよ</language>
	</row>

	<row id="TRID_ELITEW_37_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">あたしの　ポケモン
プラズマだんに　うばわれていたの……▼
いま　そばに　いてくれること
とても　ありがたいと　おもってる</language>
		<language name="JPN_KANJI" width="216">あたしの　ポケモン
プラズマ団に　奪われていたの……▼
今　そばに　いてくれること
とても　ありがたいと　思ってる</language>
	</row>

	<row id="TRID_VETERANW_14_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ちょっと！　そこの
ヤングな　トレーナー！▼
アタシの　じまんの
ポケモンを　みておゆき▼</language>
		<language name="JPN_KANJI" width="216">ちょっと！　そこの
ヤングな　トレーナー！▼
アタシの　自慢の
ポケモンを　みておゆき▼</language>
	</row>

	<row id="TRID_VETERANW_14_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">やるじゃん！
アンタたち　きにいったよ</language>
		<language name="JPN_KANJI" width="216">やるじゃん！
アンタたち　気に入ったよ</language>
	</row>

	<row id="TRID_VETERANW_14_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">おばちゃん
ポケモンの　じまんを　したいけど▽
ながくなるから　がまんするわ！</language>
		<language name="JPN_KANJI" width="216">おばちゃん
ポケモンの　自慢を　したいけど▽
長くなるから　我慢するわ！</language>
	</row>

	<row id="TRID_DOCTOR_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">わたしは　ドクター！▼
さあ！　きみの　ポケモンが
かいふくすべきか　みせたまえ！▼</language>
		<language name="JPN_KANJI" width="216">わたしは　ドクター！▼
さあ！　きみの　ポケモンが
回復すべきか　診せたまえ！▼</language>
	</row>

	<row id="TRID_DOCTOR_07_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">きみの　つよさは　そこしれない！
……かなり　かんどう　したよ</language>
		<language name="JPN_KANJI" width="216">きみの　強さは　底知れない！
……かなり　感動したよ</language>
	</row>

	<row id="TRID_DOCTOR_07_TRMSG_FIGHT_AFTER_RECOVER_BEFORE">
		<language name="JPN" width="216">きみの　ポケモンが　げんきでも
わたしは　かいふく　させるぞ！▼</language>
		<language name="JPN_KANJI" width="216">きみの　ポケモンが　元気でも
わたしは　回復させるぞ！▼</language>
	</row>

	<row id="TRID_DOCTOR_07_TRMSG_FIGHT_AFTER_RECOVER_AFTER">
		<language name="JPN" width="216">わたしが　めざすのは
せかいいちの　ドクター！▼
