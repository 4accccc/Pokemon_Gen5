	</row>

	<row id="TRID_MINI_26_TRMSG_FIGHT_START">
		<language name="JPN" width="216">もちろん　おあいて　するわ
おきにいりの　コロモリでね！！▼</language>
		<language name="JPN_KANJI" width="216">もちろん　お相手　するわ
おきにいりの　コロモリでね！！▼</language>
	</row>

	<row id="TRID_MINI_26_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">わーお！
モーレツ！</language>
		<language name="JPN_KANJI" width="216">わーお！
モーレツ！</language>
	</row>

	<row id="TRID_MINI_26_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">あたしの　おきにいりの　ばしょ
それが　ここ　なんだ</language>
		<language name="JPN_KANJI" width="216">あたしの　おきにいりの　場所
それが　ここ　なんだ</language>
	</row>

	<row id="TRID_TANPAN_33_TRMSG_FIGHT_START">
		<language name="JPN" width="216">よーし！　ポケモンしょうぶ！
レッツ　スタート！▼</language>
		<language name="JPN_KANJI" width="216">よーし！　ポケモン勝負！
レッツ　スタート！▼</language>
	</row>

	<row id="TRID_TANPAN_33_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">かあ！
おまえ　つよすぎ！</language>
		<language name="JPN_KANJI" width="216">かあ！
おまえ　強すぎ！</language>
	</row>

	<row id="TRID_TANPAN_33_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">いろの　こい　くさむらで
ポケモンの　とっくん　だ！</language>
		<language name="JPN_KANJI" width="216">色の　濃い　草むらで
ポケモンの　特訓だ！</language>
	</row>

	<row id="TRID_TANPAN_34_TRMSG_FIGHT_START">
		<language name="JPN" width="216">オレ　つよくなって
ホミカちゃんに　いいとこ　みせるんだ！</language>
		<language name="JPN_KANJI" width="216">オレ　強くなって
ホミカちゃんに　いいとこ　みせるんだ！</language>
	</row>

	<row id="TRID_TANPAN_34_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あはは……
ウソでしょ……</language>
		<language name="JPN_KANJI" width="216">あはは……
ウソでしょ……</language>
	</row>

	<row id="TRID_TANPAN_34_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">オレ　つよくなって
ホミカちゃんに　いいとこ　みせたいよ</language>
		<language name="JPN_KANJI" width="216">オレ　強くなって
ホミカちゃんに　いいとこ　みせたいよ</language>
	</row>

	<row id="TRID_ADULTW_01_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ようこそ！　ライモンジムへ
ポケモンと　トレーナーが　おりなす▼
かれいな　ポケモンしょうぶと
ファッションショーの　はじまり！▼</language>
		<language name="JPN_KANJI" width="216">ようこそ！　ライモンジムへ
ポケモンと　トレーナーが　おりなす▼
華麗な　ポケモン勝負と
ファッションショーの　始まり！▼</language>
	</row>

	<row id="TRID_ADULTW_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ショーは　これから……▼
……って　あれ？
もう　おわり？</language>
		<language name="JPN_KANJI" width="216">ショーは　これから……▼
……って　あれ？
もう　終わり？</language>
	</row>

	<row id="TRID_ADULTW_01_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">あなたのポケモンと　あなた
とっても　シャイニングでしたわ！</language>
		<language name="JPN_KANJI" width="216">あなたのポケモンと　あなた
とっても　シャイニングでしたわ！</language>
	</row>

	<row id="TRID_ADULTW_02_TRMSG_FIGHT_START">
		<language name="JPN" width="216">うつくしいでは　ダメ！
トレーナーとして　つよくなければ！▼
わたしたちの　ビューティな
たたかいぶりに　みとれないでよ！▼</language>
		<language name="JPN_KANJI" width="216">美しいだけでは　ダメ！
トレーナーとして　強くなければ！▼
わたしたちの　ビューティな
戦いぶりに　みとれないでよ！▼</language>
	</row>

	<row id="TRID_ADULTW_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……つよくて　ビューティ！
わたしが　みとれちゃったわ</language>
		<language name="JPN_KANJI" width="216">……強くて　ビューティ！
わたしが　みとれちゃったわ</language>
	</row>

	<row id="TRID_ADULTW_02_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">うつくしさ　っていうのは
ルックス　だけじゃないの▼
あなたも　カミツレさまも
つよさが　うつくしさの　いちぶね</language>
		<language name="JPN_KANJI" width="216">美しさ　っていうのは
ルックスだけじゃ　ないの▼
あなたも　カミツレさまも
強さが　美しさの　一部ね</language>
	</row>

	<row id="TRID_ADULTW_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ショーも　おおづめ　だけど
カミツレさまと　おなじ　ステージに▽
たてるか　チェックしてあげる！▼</language>
		<language name="JPN_KANJI" width="216">ショーも　大詰めだけど
カミツレさまと　同じ　ステージに▽
立てるか　チェックしてあげる！▼</language>
	</row>

	<row id="TRID_ADULTW_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">その　つよさと　うつくしさ……！▼
カミツレさまの　ステージに
たっても　いいんじゃない？</language>
		<language name="JPN_KANJI" width="216">その　強さと　美しさ……！▼
カミツレさまの　ステージに
立っても　いいんじゃない？</language>
	</row>

	<row id="TRID_ADULTW_03_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">あなたと　カミツレさまで　みせた
きらびやかな　ポケモンしょうぶ▼
おもわず　みとれちゃったじゃない！
とても　ステキな　ショーだったわよ！</language>
		<language name="JPN_KANJI" width="216">あなたと　カミツレさまで　みせた
きらびやかな　ポケモン勝負▼
思わず　みとれちゃったじゃない！
とても　ステキな　ショーだったわよ！</language>
	</row>

	<row id="TRID_FISHING_13_TRMSG_FIGHT_START">
		<language name="JPN" width="216">わたしという　みりょくてきな
つりばりに　ひっかかったな！▼
つりたて　ピチピチの　ポケモンで
しょうぶ　してあげよう！▼</language>
		<language name="JPN_KANJI" width="216">私という　魅力的な
釣り針に　引っかかったな！▼
釣りたて　ピチピチの　ポケモンで
勝負してあげよう！▼</language>
	</row>

	<row id="TRID_FISHING_13_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">おもわず　ピチピチ　はねちゃう！
ピチピチ　ピチピチッ　ピチピチッ！</language>
		<language name="JPN_KANJI" width="216">思わず　ピチピチ　跳ねちゃう！
ピチピチ　ピチピチッ　ピチピチッ！</language>
	</row>

	<row id="TRID_FISHING_13_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ポケモンは　つられているのでは　なく
わたしに　しょうぶを　いどむため▽
つりバリに　くいついて　いるのかも？</language>
		<language name="JPN_KANJI" width="216">ポケモンは　釣られているのでは　なく
私に　勝負を　挑むため▽
釣りバリに　食いついて　いるのかも？</language>
	</row>

	<row id="TRID_FISHING_14_TRMSG_FIGHT_START">
		<language name="JPN" width="216">おっし！
たいりょう　たいりょう！▼
つぎは　しょうり　という
えものを　つってみるか▼</language>
		<language name="JPN_KANJI" width="216">おっし！
大漁　大漁！▼
次は　勝利という
獲物を　釣ってみるか▼</language>
	</row>

	<row id="TRID_FISHING_14_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">のがした　しょうりは
あまりにも　でかかった……</language>
		<language name="JPN_KANJI" width="216">逃した　勝利は
あまりにも　でかかった……</language>
	</row>

	<row id="TRID_FISHING_14_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">つりは　じんせいと　おなじ▼
ねらわないと　つれないし
ねらっても　つれないんだよ……</language>
		<language name="JPN_KANJI" width="216">釣りは　人生と　同じ▼
ねらわないと　釣れないし
ねらっても　釣れないんだよ……</language>
	</row>

	<row id="TRID_BREEDERW_04_TRMSG_FIGHT_START">
		<language name="JPN" width="216">はやく　つよく　そだてるには
たたかうのが　いちばん　ですよね！▼</language>
		<language name="JPN_KANJI" width="216">はやく　強く　育てるには
戦うのが　一番ですよね！▼</language>
	</row>

	<row id="TRID_BREEDERW_04_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">きみの　ポケモンの　そだてかた
わたしの　もくひょう　だわ！</language>
		<language name="JPN_KANJI" width="216">きみの　ポケモンの　育て方
わたしの　目標だわ！</language>
	</row>

	<row id="TRID_BREEDERW_04_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">きみが　ここに　くるたび
あいてを　してもらうんだから！</language>
		<language name="JPN_KANJI" width="216">きみが　ここに　来るたび
相手を　してもらうんだから！</language>
	</row>

	<row id="TRID_POLICE_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">におう！　におうぞ！
ほんかんの　ハーデリアが！▼
キミから　ただならぬ
キケンな　においを　かぎとった！▼</language>
		<language name="JPN_KANJI" width="216">におう！　におうぞ！
本官の　ハーデリアが！▼
キミから　ただならぬ
キケンな　においを　かぎとった！▼</language>
	</row>

	<row id="TRID_POLICE_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">なるほど……　たしかに
キケンな　つよさ　だったな……</language>
		<language name="JPN_KANJI" width="216">なるほど……　確かに
キケンな　強さ　だったな……</language>
	</row>

	<row id="TRID_POLICE_03_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">つよいからって
そうでないヤツを　バカにするなよ？</language>
		<language name="JPN_KANJI" width="216">強いからって
そうでないヤツを　バカにするなよ？</language>
	</row>

	<row id="TRID_BACKPACKERM_17_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ハイ！　トレーナー！
ぼくと　しょうぶ！！▼</language>
		<language name="JPN_KANJI" width="216">ハイ！　トレーナー！
ぼくと　勝負！！▼</language>
	</row>

	<row id="TRID_BACKPACKERM_17_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">サンキュー！　すてきな　しょうぶ
たびの　メモリアルだよ！</language>
		<language name="JPN_KANJI" width="216">サンキュー！　すてきな　勝負
旅の　メモリアルだよ！</language>
	</row>

	<row id="TRID_BACKPACKERM_17_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">おやゆび　あげて　クルマを　とめて
しせん　あわせて　トレーナー　とめて</language>
		<language name="JPN_KANJI" width="216">親指　あげて　クルマを　とめて
視線　あわせて　トレーナー　とめて</language>
	</row>

	<row id="TRID_POLICE_04_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ちょっと　そこの　キミ！
とまりなさーい！▼</language>
		<language name="JPN_KANJI" width="216">ちょっと　そこの　キミ！
とまりなさーい！▼</language>
	</row>

	<row id="TRID_POLICE_04_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">その　いきおい　とまらない！
まさに　アンストッパブル！</language>
		<language name="JPN_KANJI" width="216">その　勢い　とまらない！
まさに　アンストッパブル！</language>
	</row>

	<row id="TRID_POLICE_04_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">わかいうちは　いきおい　つけて
ムチャしちゃって　いいんだよ！</language>
		<language name="JPN_KANJI" width="216">若いうちは　勢い　つけて
ムチャしちゃって　いいんだよ！</language>
	</row>

	<row id="TRID_POLICE_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">こどもが　こんなところを
ウロウロしてるとは　なにごとだ！？▼</language>
		<language name="JPN_KANJI" width="216">こどもが　こんな所を
ウロウロしてるとは　なにごとだ！？▼</language>
	</row>

	<row id="TRID_POLICE_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ほんかんを　まかすとは……
なんて　こどもだ！</language>
		<language name="JPN_KANJI" width="216">本官を　負かすとは……
なんて　子供だ！</language>
	</row>

	<row id="TRID_POLICE_05_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">なにが　あっても　なくても
パトロール　するのが　ほんかんだ！</language>
		<language name="JPN_KANJI" width="216">なにが　あっても　なくても
パトロール　するのが　本官だ！</language>
	</row>

	<row id="TRID_HEADS_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ここは　おめーみたいな
ヒヨッコのくる　ところじゃないぜ！▼</language>
		<language name="JPN_KANJI" width="216">ここは　おめーみたいな
ヒヨッコの来る　所じゃないぜ！▼</language>
	</row>

	<row id="TRID_HEADS_07_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">なんて　やつだ……
おとなしそうな　かお　なのに！</language>
		<language name="JPN_KANJI" width="216">なんて　やつだ……
おとなしそうな　顔なのに！</language>
	</row>

	<row id="TRID_HEADS_07_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">なんにせよ　トレーナーなら
しょうぶを　いどまれるんだけどよお！</language>
		<language name="JPN_KANJI" width="216">なんにせよ　トレーナーなら
勝負を　挑まれるんだけどよお！</language>
	</row>

	<row id="TRID_HEADS_08_TRMSG_FIGHT_START">
		<language name="JPN" width="216">かがやく　アタマは
きあいの　あかし　なんだぜ！▼</language>
		<language name="JPN_KANJI" width="216">輝く　アタマは
気合の　証なんだぜ！▼</language>
	</row>

	<row id="TRID_HEADS_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あたまが　フラッシュ！！</language>
		<language name="JPN_KANJI" width="216">頭が　フラッシュ！！</language>
	</row>

	<row id="TRID_HEADS_08_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">さいきん　おとうとの　ヤローが
ワルに　めざめちまったんだぜ▼
アイツは　まっすぐ
いきて　ほしいんだけどよ……</language>
		<language name="JPN_KANJI" width="216">最近　弟の　ヤローが
ワルに　目覚めちまったんだぜ▼
アイツは　まっすぐ
生きて　ほしいんだけどよ……</language>
	</row>

	<row id="TRID_BADRIDER_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">さばくに　バイク！
ワイルドで　えに　なるだろう？▼</language>
		<language name="JPN_KANJI" width="216">砂漠に　バイク！
ワイルドで　絵に　なるだろう？▼</language>
	</row>

	<row id="TRID_BADRIDER_07_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">バイクと　すな　あいしょうが　わるい
オレと　オマエ　あいしょうが　わるい</language>
		<language name="JPN_KANJI" width="216">バイクと　砂　相性が　悪い
オレと　オマエ　相性が　悪い</language>
	</row>

	<row id="TRID_BADRIDER_07_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">バイクも　じてんしゃも　すなに
タイヤが　うまっちまうんだよ！！</language>
		<language name="JPN_KANJI" width="216">バイクも　じてんしゃも　砂地じゃ
タイヤが　埋まっちまうんだよ！！</language>
	</row>

	<row id="TRID_TANPAN_22_TRMSG_FIGHT_START">
		<language name="JPN" width="216">おいら　きのうから
ワルに　めざめたんだぜ！▽
だから　つよいんぜ！▼</language>
		<language name="JPN_KANJI" width="216">おいら　昨日から
ワルに　目覚めたんだぜ！▽
だから　強いんぜ！▼</language>
	</row>

	<row id="TRID_TANPAN_22_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">めざめただけじゃ　ダメなのか
ワルって　あんがい　たいへんだな……</language>
		<language name="JPN_KANJI" width="216">目覚めただけじゃ　ダメなのか
ワルって　案外　大変だな……</language>
	</row>

	<row id="TRID_TANPAN_22_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">おいら　にいちゃん　みたいに
かがやく　あたまに　したい！▼
だって　シャンプーのあと
すぐに　かわいて　あそべるだろ！！</language>
		<language name="JPN_KANJI" width="216">おいら　にいちゃん　みたいに
輝く　頭に　したい！▼
だって　シャンプーのあと
すぐに　乾いて　遊べるだろ！！</language>
	</row>

	<row id="TRID_BADTEAM_02_TRMSG_FIGHT_START_1">
		<language name="JPN" width="216">オラオラーッ
かわいがってやるぜーッ！▼</language>
		<language name="JPN_KANJI" width="216">オラオラーッ
かわいがってやるぜーッ！▼</language>
	</row>

	<row id="TRID_BADTEAM_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ロブ『お……　おれの
かわいい　ポケモンがーッ！▼
ギン『おれの　ベイビィちゃんが
まけちゃったぜーッ！</language>
		<language name="JPN_KANJI" width="216">ロブ『お……　おれの
かわいい　ポケモンがーッ！▼
ギン『おれの　ベイビィちゃんが
負けちゃったぜーッ！</language>
	</row>

	<row id="TRID_BADTEAM_02_TRMSG_FIGHT_AFTER_1">
		<language name="JPN" width="216">おめーの　ポケモンも
かわいいじゃねーかッ！▼
そして　トレーナーの
おめーも　なかなか……</language>
		<language name="JPN_KANJI" width="216">おめーの　ポケモンも
かわいいじゃねーかッ！▼
そして　トレーナーの
おめーも　なかなか……</language>
	</row>

	<row id="TRID_BADTEAM_02_TRMSG_POKE_ONE_1">
		<language name="JPN" width="216">フン……！　たたかえる　ポケモンが
１ひきしか　いない　ヤツの▽
あいてなんか　したくないんだぜーッ！</language>
		<language name="JPN_KANJI" width="216">フン……！　戦える　ポケモンが
１匹しか　いない　ヤツの▽
相手なんか　したくないんだぜーッ！</language>
	</row>

	<row id="TRID_BADTEAM_02_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">ヘイヘイヘイ！　どうしたんだぁ？
まいごにでも　なったのかーッ！？▼</language>
		<language name="JPN_KANJI" width="216">ヘイヘイヘイ！　どうしたんだぁ？
迷子にでも　なったのかーッ！？▼</language>
	</row>

	<row id="TRID_BADTEAM_02_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">ワルいヤツどうし　あつまって
ポケモンじまん　してるんだぜ！</language>
		<language name="JPN_KANJI" width="216">ワルいヤツ同士　集まって
ポケモン自慢　してるんだぜ！</language>
	</row>

	<row id="TRID_BADTEAM_02_TRMSG_POKE_ONE_2">
		<language name="JPN" width="216">コラーッ！　てもち　１ぴきだとォ？▼
２ｖｓ１なんて　ふりな　しょうぶじゃ
ワルの　なが　すたるだろうがッ！</language>
		<language name="JPN_KANJI" width="216">コラーッ！　手持ち　１匹だとォ？▼
２ｖｓ１なんて　不利な　勝負じゃ
ワルの　名が　すたるだろうがッ！</language>
	</row>

	<row id="TRID_PRINCE_08_TRMSG_FIGHT_START">
		<language name="JPN" width="216">こだいのしろに　たわむれに　きた
ラグジュアリーな　ボクの▽
ゴージャスな　ポケモンを　ごらん！▼</language>
		<language name="JPN_KANJI" width="216">古代の城に　たわむれに来た
ラグジュアリーな　ボクの▽
ゴージャスな　ポケモンを　ご覧！▼</language>
	</row>

	<row id="TRID_PRINCE_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">キミの　つよさは
ハイクラス　だな！</language>
		<language name="JPN_KANJI" width="216">キミの　強さは
ハイクラス　だな！</language>
	</row>

	<row id="TRID_PRINCE_08_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">フェイバリットな　ポケモンと
かんこうめいしょを　めぐるのって▽
プレミアムな　けいけん　だからさ</language>
		<language name="JPN_KANJI" width="216">フェイバリットな　ポケモンと
観光名所を　巡るのって▽
プレミアムな　経験だからさ</language>
	</row>

	<row id="TRID_PRINCESS_08_TRMSG_FIGHT_START">
		<language name="JPN" width="216">そこの　あなた……▼
ひまを　もてあました　わたくしと
ゆうがに　からみましょうよ▼</language>
		<language name="JPN_KANJI" width="216">そこの　あなた……▼
暇を　持て余した　わたくしと
優雅に　絡みましょうよ▼</language>
	</row>

	<row id="TRID_PRINCESS_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">みつどの　こい　じかんを　すごせて
こころより　かんしゃ　いたしますわ</language>
		<language name="JPN_KANJI" width="216">密度の　濃い　時間を　過ごせて
心より　感謝いたしますわ</language>
	</row>

	<row id="TRID_PRINCESS_08_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">みわたすかぎり　すな　ばかり……
なにが　すごいのか　わかりませんわ！</language>
		<language name="JPN_KANJI" width="216">見渡すかぎり　砂　ばかり……
なにが　すごいのか　わかりませんわ！</language>
	</row>

	<row id="TRID_BACKPACKERM_18_TRMSG_FIGHT_START">
		<language name="JPN" width="216">すなに　うもれた　いせき！
であった　キミと　ボク！▽
ロマンついでに　たたかおう！▼</language>
		<language name="JPN_KANJI" width="216">砂に　埋もれた　遺跡！
出会った　キミと　ボク！▽
ロマンついでに　戦おう！▼</language>
	</row>

	<row id="TRID_BACKPACKERM_18_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ほろにがい　はいぼく……
ほろにがい　おもいで……</language>
		<language name="JPN_KANJI" width="216">ほろ苦い　敗北……
ほろ苦い　思い出……</language>
	</row>

	<row id="TRID_BACKPACKERM_18_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">おおむかしの　ひとが
どうやって　くらしていたのか？▽
そうぞう　するのって　たのしい！</language>
		<language name="JPN_KANJI" width="216">大昔の　人が
どうやって　暮らしていたのか？▽
想像するのって　楽しい！</language>
	</row>

	<row id="TRID_BACKPACKERW_14_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あなたの　たびの　おともは
どんな　ポケモン？！▼</language>
		<language name="JPN_KANJI" width="216">あなたの　旅の　お供は
どんな　ポケモン？▼</language>
	</row>

	<row id="TRID_BACKPACKERW_14_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">すごーい！　とっても　つよくて
ステキな　なかま　だよね！</language>
		<language name="JPN_KANJI" width="216">すごーい！　とっても　強くて
ステキな　仲間だよね！</language>
	</row>

	<row id="TRID_BACKPACKERW_14_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">たびは　みちづれ　っていうけど
ほんと　そうだよね！▼
ポケモンと　いるおかげで
たのしさ　ばいぞう　だもん！</language>
		<language name="JPN_KANJI" width="216">旅は道連れ　っていうけど
ほんと　そうだよね！▼
ポケモンと　いるおかげで
楽しさ　倍増だもん！</language>
	</row>

	<row id="TRID_DAISUKIM_04_TRMSG_FIGHT_START">
		<language name="JPN" width="216">いきなり　ですけど
ぼくの　ポケモン　みてください！▼</language>
		<language name="JPN_KANJI" width="216">いきなり　ですけど
ぼくの　ポケモン　みてください！▼</language>
	</row>

	<row id="TRID_DAISUKIM_04_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ぼくの　ポケモン！
まけても　やっぱり　かわいい！</language>
		<language name="JPN_KANJI" width="216">ぼくの　ポケモン！
負けても　やっぱり　可愛い！</language>
	</row>

	<row id="TRID_DAISUKIM_04_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">いつでも　どこでも　どんなときでも
じぶんの　ポケモンが　いちばんです！</language>
		<language name="JPN_KANJI" width="216">いつでも　どこでも　どんなときでも
自分の　ポケモンが　一番です！</language>
	</row>

	<row id="TRID_DAISUKIW_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">むふふ！　あなた！　わたしの
ポケモンちゃんを　みていきなさい▼</language>
		<language name="JPN_KANJI" width="216">むふふ！　あなた！　わたしの
ポケモンちゃんを　みていきなさい▼</language>
	</row>

	<row id="TRID_DAISUKIW_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ポケモンちゃん　かがやいてたわ！
おあいて　してくれて　ありがとうね</language>
		<language name="JPN_KANJI" width="216">ポケモンちゃん　輝いてたわ！
お相手してくれて　ありがとうね</language>
	</row>

	<row id="TRID_DAISUKIW_03_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">まけると　しょんぼり　しちゃうけど
しょうぶは　ポケモンちゃんとの▽
きずなを　つよく　かんじられるわね！</language>
		<language name="JPN_KANJI" width="216">負けると　しょんぼり　しちゃうけど
勝負は　ポケモンちゃんとの▽
きずなを　強く　感じられるわね！</language>
	</row>

	<row id="TRID_FUTAGO_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">コダイ！
コダイなのー！▼</language>
		<language name="JPN_KANJI" width="216">コダイ！
コダイなのー！▼</language>
	</row>

	<row id="TRID_FUTAGO_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ユキ『うわーん！コダイなのにー！▼
サキ『もーっ！イセキだってばー！</language>
		<language name="JPN_KANJI" width="216">ユキ『うわーん！コダイなのにー！▼
サキ『もーっ！イセキだってばー！</language>
	</row>

	<row id="TRID_FUTAGO_06_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">コダイって　むかしの　ことでしょ！
じゃあ　きのうって　コダイなのかな？</language>
		<language name="JPN_KANJI" width="216">コダイって　むかしの　ことでしょ！
じゃあ　きのうって　コダイなのかな？</language>
	</row>

	<row id="TRID_FUTAGO_06_TRMSG_POKE_ONE_1">
		<language name="JPN" width="216">ポケモンさん　１ひき　なの？
いっぱいが　いいのにー！</language>
		<language name="JPN_KANJI" width="216">ポケモンさん　１ひき　なの？
いっぱいが　いいのにー！</language>
	</row>

	<row id="TRID_FUTAGO_06_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">イセキ！
イセキだよー！▼</language>
		<language name="JPN_KANJI" width="216">イセキ！
イセキだよー！▼</language>
	</row>

	<row id="TRID_FUTAGO_06_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">イセキって　おうち　でしょ！
だれが　すんでるのかなー？</language>
		<language name="JPN_KANJI" width="216">イセキって　おうち　でしょ！
だれが　すんでるのかなー？</language>
	</row>

	<row id="TRID_FUTAGO_06_TRMSG_POKE_ONE_2">
		<language name="JPN" width="216">ポケモンさん　１ひき　なの？
さみしく　ないのー？</language>
		<language name="JPN_KANJI" width="216">ポケモンさん　１ひき　なの？
さみしく　ないのー？</language>
	</row>

	<row id="TRID_FANW_11_TRMSG_FIGHT_START">
		<language name="JPN" width="216">フットボールを　みたあとは
じぶんたちも　あばれたーい！▼</language>
		<language name="JPN_KANJI" width="216">フットボール観戦後は
自分たちも　暴れたーい！▼</language>
	</row>

	<row id="TRID_FANW_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ナナ『すがすがしい　までに
かんぱい　だわ……▼
アヤ『いっしょうけんめい
おうえん　したんだけどなあ……</language>
		<language name="JPN_KANJI" width="216">ナナ『清清しい　までに
完敗だわ……▼
アヤ『一生懸命
応援したんだけどなあ……</language>
	</row>

	<row id="TRID_FANW_11_TRMSG_FIGHT_AFTER_1">
		<language name="JPN" width="216">かった　まけたも　だいじだけど
それしか　みえなくなるは　ダメ！</language>
		<language name="JPN_KANJI" width="216">勝った　負けたも　大事だけど
それしか　みえなくなるのは　ダメ！</language>
	</row>

	<row id="TRID_FANW_11_TRMSG_POKE_ONE_1">
		<language name="JPN" width="216">たたかえる　ポケモンが　１ひきじゃ
チームプレイが　できないね！</language>
		<language name="JPN_KANJI" width="216">戦える　ポケモンが　１匹じゃ
チームプレイが　できないね！</language>
	</row>

	<row id="TRID_FANW_11_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">あつい　しょうぶを　しってこそ
あつい　おうえんが　できるんです！▼</language>
		<language name="JPN_KANJI" width="216">熱い　勝負を　知ってこそ
熱い　応援が　できるんです！▼</language>
	</row>

	<row id="TRID_FANW_11_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">おうえんも　しょうぶも
いつだって　ほんき　１００％！▽
それが　ファンの　こころいき！</language>
		<language name="JPN_KANJI" width="216">応援も　勝負も
いつだって　本気１００％！▽
それが　ファンの　心意気！</language>
	</row>

	<row id="TRID_FANW_11_TRMSG_POKE_ONE_2">
		<language name="JPN" width="216">たたかえる　ポケモンが　１ひきじゃ
チームワークが　みせられないよ！</language>
		<language name="JPN_KANJI" width="216">戦える　ポケモンが　１匹じゃ
チームワークが　みせられないよ！</language>
	</row>

	<row id="TRID_BAKER_04_TRMSG_FIGHT_START">
		<language name="JPN" width="216">さあて！　いつもは　パンづくりを
てつだってくれる　ポケモンたちだよ！▼</language>
		<language name="JPN_KANJI" width="216">さあて！　いつもは　パンづくりを
