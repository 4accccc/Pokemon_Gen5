	<row id="TRID_RANGERW_24_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">カザンノ　コト
ボルケーノ　イウーノ</language>
		<language name="JPN_KANJI" width="216">火山ノ　コト
ボルケーノ　イウーノ</language>
	</row>

	<row id="TRID_ELITEM_34_TRMSG_FIGHT_START">
		<language name="JPN" width="216">マグマは　なぜ　あついか！
キミに　こたえられるかな！？▼</language>
		<language name="JPN_KANJI" width="216">マグマは　なぜ　熱いか！
キミに　答えられるかな！？▼</language>
	</row>

	<row id="TRID_ELITEM_34_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">その　きはく！　あつりょく！
それこそが　こたえ！</language>
		<language name="JPN_KANJI" width="216">その　気迫！　圧力！
それこそが　答え！</language>
	</row>

	<row id="TRID_ELITEM_34_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ちかふかくの　つよい　あつりょくが
いわを　とかし　マグマに　かえるんだ</language>
		<language name="JPN_KANJI" width="216">地下深くの　強い　圧力が
岩を　溶かし　マグマに　変えるんだ</language>
	</row>

	<row id="TRID_MOUNT_23_TRMSG_FIGHT_START">
		<language name="JPN" width="216">いわに　かこまれていると
テンション　あがっちゃう！！▼</language>
		<language name="JPN_KANJI" width="216">岩に　囲まれていると
テンション　あがっちゃう！！▼</language>
	</row>

	<row id="TRID_MOUNT_23_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">まけると
テンション　さがっちゃう……</language>
		<language name="JPN_KANJI" width="216">負けると
テンション　さがっちゃう……</language>
	</row>

	<row id="TRID_MOUNT_23_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">テンション　あがったり　さがったり
にぎやかなのが　オレの　いいところ！</language>
		<language name="JPN_KANJI" width="216">テンション　あがったり　さがったり
にぎやかなのが　オレの　いいところ！</language>
	</row>

	<row id="TRID_MOUNT_24_TRMSG_FIGHT_START">
		<language name="JPN" width="216">わがはいは　なぜ　あなをほるのか？
おぬしは　なぜ　たたかうのか？▼</language>
		<language name="JPN_KANJI" width="216">我輩は　なぜ　穴を掘るのか？
おぬしは　なぜ　戦うのか？▼</language>
	</row>

	<row id="TRID_MOUNT_24_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">おぬしの　いままでの　けいけん……
それが　つよさの　みなもとか！</language>
		<language name="JPN_KANJI" width="216">おぬしの　今までの　経験……
それが　強さの　源か！</language>
	</row>

	<row id="TRID_MOUNT_24_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">たたかっただけ　つよくなる
ほっただけ　あなが　ひろがる……▽
もくてきがあれば　ムダなんて　ない！</language>
		<language name="JPN_KANJI" width="216">戦っただけ　強くなる
掘っただけ　穴が　広がる……▽
目的があれば　無駄なんて　ない！</language>
	</row>

	<row id="TRID_WORKER2_36_TRMSG_FIGHT_START">
		<language name="JPN" width="216">パトロールを　していたら
つよそうな　トレーナー　はっけん！▽
いくぞ！　シンボラー！！▼</language>
		<language name="JPN_KANJI" width="216">パトロールを　していたら
強そうな　トレーナー　発見！▽
いくぞ！　シンボラー！！▼</language>
	</row>

	<row id="TRID_WORKER2_36_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">オラが　かんじたとおり
オニつよい　トレーナーだった！</language>
		<language name="JPN_KANJI" width="216">オラが　感じたとおり
オニ強い　トレーナーだった！</language>
	</row>

	<row id="TRID_WORKER2_36_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">オラの　シンボラー　だけどよ▼
いつも　おんなじ　ルートを
とおりたがるんだけど　なんでだ？</language>
		<language name="JPN_KANJI" width="216">オラの　シンボラー　だけどよ▼
いつも　おんなじ　ルートを
通りたがるんだけど　なんでだ？</language>
	</row>

	<row id="TRID_WORKER2_39_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ちからしごとで　きたえた　おれたち！
パワフルこうげき　うけてみろ！▼</language>
		<language name="JPN_KANJI" width="216">力仕事で　鍛えた　おれたち！
パワフル攻撃　受けてみろ！▼</language>
	</row>

	<row id="TRID_WORKER2_39_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ちからしごとで　きたえた　おれたち
まけるときも　パワフル　だぜ！</language>
		<language name="JPN_KANJI" width="216">力仕事で　鍛えた　おれたち！
負けるときも　パワフル　だぜ！</language>
	</row>

	<row id="TRID_WORKER2_39_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">この　イワオ！　すきな　ポケモンと
ともに　はたらけて　しあわせなんだ！</language>
		<language name="JPN_KANJI" width="216">この　イワオ！　すきな　ポケモンと
ともに　働けて　シアワセなんだ！</language>
	</row>

	<row id="TRID_WORKER2_40_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ネジやまは　きせつで　かわり
おっさんは　しょうぶで　かわる！▼</language>
		<language name="JPN_KANJI" width="216">ネジ山は　季節で　変わり
おっさんは　勝負で　変わる！▼</language>
	</row>

	<row id="TRID_WORKER2_40_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……おとな　あいてに
てかげん　してくれよな！？</language>
		<language name="JPN_KANJI" width="216">……大人相手に
手加減して　くれよな！？</language>
	</row>

	<row id="TRID_WORKER2_40_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">おっさん　ふゆが　すきなんだ▼
ネジやまに　つもる　ゆき……
なんとも　いえない　けしき　なんだな</language>
		<language name="JPN_KANJI" width="216">おっさん　冬が　好きなんだ▼
ネジ山に　積もる　雪……
なんとも　いえない　景色なんだな</language>
	</row>

	<row id="TRID_WORKER1_09_TRMSG_FIGHT_START">
		<language name="JPN" width="216">クールな　こおりポケモンと
あつい　オレの　コンビネーション！▼</language>
		<language name="JPN_KANJI" width="216">クールな　こおりポケモンと
熱い　オレの　コンビネーション！▼</language>
	</row>

	<row id="TRID_WORKER1_09_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あんたらも　クール＆ホットな
コンビの　ようだな……！</language>
		<language name="JPN_KANJI" width="216">あんたらも　クール＆ホットな
コンビの　ようだな……！</language>
	</row>

	<row id="TRID_WORKER1_09_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ネジやまは　いちねんじゅう　さむい！▼
まふゆでも　げんきな
こおりポケモンが　だいかつやく　よ！</language>
		<language name="JPN_KANJI" width="216">ネジ山は　一年中　寒い！▼
真冬でも　元気な
こおりポケモンが　大活躍よ！</language>
	</row>

	<row id="TRID_WORKER1_10_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ヘイ　わかもの！
おじさんが　あたためて　あげよう！▼</language>
		<language name="JPN_KANJI" width="216">ヘイ　若者！
おじさんが　暖めて　あげよう！▼</language>
	</row>

	<row id="TRID_WORKER1_10_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ハァッ……！　しょうぶを　すると
アセを　かくほど　あたたまるね</language>
		<language name="JPN_KANJI" width="216">ハァッ……！　勝負を　すると
アセを　かくほど　あたたまるね</language>
	</row>

	<row id="TRID_WORKER1_10_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">さわって　たしかめても　いいよ？
ほら　アセで　ぐっしょり……</language>
		<language name="JPN_KANJI" width="216">触って　確かめても　いいよ？
ほら　アセで　ぐっしょり……</language>
	</row>

	<row id="TRID_WORKER1_11_TRMSG_FIGHT_START">
		<language name="JPN" width="216">エスパーポケモンに
しごとを　おまかせ　すれば▼
ちからしごとも　ラクチン！
アタクシ　サボれるって　きづいたの！▼</language>
		<language name="JPN_KANJI" width="216">エスパーポケモンに
仕事を　お任せ　すれば▼
力仕事も　ラクチン！
アタクシ　サボれるって　気づいたの！▼</language>
	</row>

	<row id="TRID_WORKER1_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">そっか！　トレーナーが　サボったら
ポケモン　こまっちゃうよな</language>
		<language name="JPN_KANJI" width="216">そっか！　トレーナーが　サボったら
ポケモン　困っちゃうよな</language>
	</row>

	<row id="TRID_WORKER1_11_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ポケモンと　いっしょに
しごとを　するのが　さぎょういん▼
ポケモンに　まかせきりで
サボっていては　ダメなのです！</language>
		<language name="JPN_KANJI" width="216">ポケモンと　一緒に
仕事を　するのが　さぎょういん▼
ポケモンに　任せきりで
サボっていては　ダメなのです！</language>
	</row>

	<row id="TRID_VETERANM_15_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ネジやまに　こもって
はや　２ねん……▼
しゅぎょうの　せいかを
いま　ためさせて　いただこう！▼</language>
		<language name="JPN_KANJI" width="216">ネジ山に　こもって
早　２年……▼
修行の　成果を
今　試させて　いただこう！▼</language>
	</row>

	<row id="TRID_VETERANM_15_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">じゅくれん　したものが
かならず　かつとも　かぎらない……</language>
		<language name="JPN_KANJI" width="216">熟練したものが
必ず　勝つとも　限らない……</language>
	</row>

	<row id="TRID_VETERANM_15_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ひたすら　しゅぎょうに　あけくれる
わたしのような　ものも　いれば▼
たびを　つうじて　せいちょうする
きみのような　ものもいる……　か</language>
		<language name="JPN_KANJI" width="216">ひたすら　修行に　明け暮れる
私のような　者も　いれば▼
旅を　通じて　成長する
君のような　者もいる……　か</language>
	</row>

	<row id="TRID_VETERANM_16_TRMSG_POKE_UNDER_TWO">
		<language name="JPN" width="216">トリプルバトルは　ポケモン
３びきでの　あたらしい　しょうぶだ！▼</language>
		<language name="JPN_KANJI" width="216">トリプルバトルは　ポケモン
３匹での　新しい　勝負だ！▼</language>
	</row>

	<row id="TRID_VETERANM_16_TRMSG_FIGHT_START">
		<language name="JPN" width="216">よし！　ひごろの　せいか
すべて　みせてやる！▼</language>
		<language name="JPN_KANJI" width="216">よし！　日ごろの　成果
すべて　みせてやる！▼</language>
	</row>

	<row id="TRID_VETERANM_16_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ひごろの　せいか……
みせられなかった▼</language>
		<language name="JPN_KANJI" width="216">日ごろの　成果……
みせられなかった▼</language>
	</row>

	<row id="TRID_VETERANM_16_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ポケモンの　バランスを　かんがえて
もっと　ちゃんと　そだてるぞ！▼
むはは！　いくつに　なっても
チャレンジこそが　いきがい　よ！</language>
		<language name="JPN_KANJI" width="216">ポケモンの　バランスを　考えて
もっと　ちゃんと　育てるぞ！▼
むはは！　いくつに　なっても
チャレンジこそが　生きがい　よ！</language>
	</row>

	<row id="TRID_VETERANW_12_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ネジやま　ナンバーワンの
せんりゃくか！　それが　あたしさ！▼</language>
		<language name="JPN_KANJI" width="216">ネジ山　ナンバーワンの
戦略家！　それが　あたしさ！▼</language>
	</row>

	<row id="TRID_VETERANW_12_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ネジやま　ナンバーワンで
まんぞく　しちゃってた……？</language>
		<language name="JPN_KANJI" width="216">ネジ山　ナンバーワンで
満足　しちゃってた……？</language>
	</row>

	<row id="TRID_VETERANW_12_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ありがとう……
おかげで　めが　さめたわ▼
ネジやまでの　ナンバーワンは
あたしにとって　つうかてん　だったわ</language>
		<language name="JPN_KANJI" width="216">ありがとう……
おかげで　目が　覚めたわ▼
ネジ山での　ナンバーワンは
あたしにとって　通過点だったわ</language>
	</row>

	<row id="TRID_VETERANW_13_TRMSG_POKE_UNDER_TWO">
		<language name="JPN" width="216">ローテーションバトルは　ポケモン
３びきでの　ポケモンしょうぶ　だよ！</language>
		<language name="JPN_KANJI" width="216">ローテーションバトルは　ポケモン
３匹での　ポケモン勝負だよ！</language>
	</row>

	<row id="TRID_VETERANW_13_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ローテーションバトルでは
まわさない！　ってのも　だいじだね▼</language>
		<language name="JPN_KANJI" width="216">ローテーションバトルでは
まわさない！　ってのも　大事だね▼</language>
	</row>

	<row id="TRID_VETERANW_13_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">２ねんかん　ローテーションバトルの
しゅぎょうを　したけど　まだまだね</language>
		<language name="JPN_KANJI" width="216">２年間　ローテーションバトルの
修行を　したけど　まだまだね</language>
	</row>

	<row id="TRID_VETERANW_13_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ギャンブラーの　ギーマなら
どちらにまわすか　はずさないだろうね</language>
		<language name="JPN_KANJI" width="216">ギャンブラーの　ギーマなら
どちらにまわすか　はずさないだろうね</language>
	</row>

	<row id="TRID_MOUNT_27_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ちていに　ひろがる　みずうみ
ほとりに　たたずむ　やまおとこ！▼</language>
		<language name="JPN_KANJI" width="216">地底に　広がる　湖
