	<row id="TRID_BASKET_07_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">スポーツマンの　あいさつがわり！▼</language>
		<language name="JPN_KANJI" width="216">スポーツマンの　あいさつがわり！▼</language>
