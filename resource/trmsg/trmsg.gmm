	</row>

	<row id="TRID_TENNIS_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">せかいトーナメントが　ちかいのよ！
あんたを　かべに　みたてて▽
スマッシュの　れんしゅうよ！▼</language>
		<language name="JPN_KANJI" width="216">世界トーナメントが　近いのよ！
あんたを　壁に　見立てて▽
スマッシュの　練習よ！▼</language>
	</row>

	<row id="TRID_TENNIS_07_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ハアッ！　ハア　ハア　ハア……
いい　トレーニングになったわ……</language>
		<language name="JPN_KANJI" width="216">ハアッ！　ハア　ハア　ハア……
いい　トレーニングになったわ……</language>
	</row>

	<row id="TRID_TENNIS_07_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ハア　ハア　ハア
ハア　ハア　ハア……！▼</language>
		<language name="JPN_KANJI" width="216">ハア　ハア　ハア
ハア　ハア　ハア……！▼</language>
	</row>

	<row id="TRID_TENNIS_07_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">あんたと　ワタシは　であった　ばかり
ラブゲームからの　スタートね！</language>
		<language name="JPN_KANJI" width="216">あんたと　ワタシは　出会った　ばかり
ラブゲームからの　スタートね！</language>
	</row>

	<row id="TRID_BASKET_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ヘイ！　トレーナー！▼
オレさまの　たかさのある　こうげき
その　からだで　あじわいな！▼</language>
		<language name="JPN_KANJI" width="216">ヘイ！　トレーナー！▼
オレさまの　高さのある　攻撃
その体で　あじわいな！▼</language>
	</row>

	<row id="TRID_BASKET_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">そうだった……
たたかうのは　ポケモンだった……</language>
		<language name="JPN_KANJI" width="216">そうだった……
戦うのは　ポケモンだった……</language>
	</row>

	<row id="TRID_BASKET_03_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">あじわいの　ある
こいつは　どうだ？▼</language>
		<language name="JPN_KANJI" width="216">あじわいの　ある
こいつは　どうだ？▼</language>
	</row>

	<row id="TRID_BASKET_03_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">オレたちは　いつも　ここで
ポケモンたちを　まじえて▽
バスケを　プレイしてるぜ！</language>
		<language name="JPN_KANJI" width="216">オレたちは　いつも　ここで
ポケモンたちを　交えて▽
バスケを　プレイしてるぜ！</language>
	</row>

	<row id="TRID_TENNIS_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">じそく２００キロちかくの
きょうれつな　サーブ▽
おみまい　しちゃうから！▼</language>
		<language name="JPN_KANJI" width="216">時速２００キロ近くの
強烈な　サーブ▽
おみまい　しちゃうから！▼</language>
	</row>

	<row id="TRID_TENNIS_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">いまの　こうげき……
モーレツね！</language>
		<language name="JPN_KANJI" width="216">今の　攻撃……
モーレツね！</language>
	</row>

	<row id="TRID_TENNIS_03_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">じゃ　この
モーレツな　プレゼントで！▼</language>
		<language name="JPN_KANJI" width="216">じゃ　この
モーレツな　プレゼントで！▼</language>
	</row>

	<row id="TRID_TENNIS_03_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ポケモンに　きょうれつな　サーブを
うってもらって　れんしゅう　してるの</language>
		<language name="JPN_KANJI" width="216">ポケモンに　強烈な　サーブを
うってもらって　練習してるの</language>
	</row>

	<row id="TRID_SCIENTISTM_12_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">おお！　わたしの
かっきてきな　けんきゅうよ……</language>
		<language name="JPN_KANJI" width="216">おお！　わたしの
画期的な　研究よ……</language>
	</row>

	<row id="TRID_DANCER_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">いてて……　オマエ　なんで
そんなに　つよいわけ？</language>
		<language name="JPN_KANJI" width="216">痛てて……　オマエ　なんで
そんなに　強いわけ？</language>
	</row>

	<row id="TRID_KINDERGARTENW_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">わー！　わー！　すごー！
おにーちゃん　つよいー！！</language>
		<language name="JPN_KANJI" width="216">わー！　わー！　すごー！
おにーちゃん　つよいー！！</language>
	</row>

	<row id="TRID_MOUNT_13_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">オオウ！　しょうねん！　しょうねん！
キミの　ポケモンは　たくましいなあ！</language>
		<language name="JPN_KANJI" width="216">オオウ！　少年！　少年！
キミの　ポケモンは　たくましいなあ！</language>
	</row>

	<row id="TRID_WAITRESS_04_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">アタタ……　かっこわるいなぁ……</language>
		<language name="JPN_KANJI" width="216">アタタ……　かっこ悪いなぁ……</language>
	</row>

	<row id="TRID_VETERANM_1_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">けっきょく　ぼくが　いちばん
つよくて　すごいんだよね……　なんて</language>
		<language name="JPN_KANJI" width="216">結局　ぼくが　一番
強くて　すごいんだよね……　なんて</language>
	</row>

	<row id="TRID_MAID_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あー　たのしかった！
さ〜て　おそうじ　しなくっちゃ！</language>
		<language name="JPN_KANJI" width="216">あー　楽しかった！
さ〜て　お掃除　しなくっちゃ！</language>
	</row>

	<row id="TRID_BIGFOUR1_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">はじまりかたって　たいせつ　ですよね
しょうぶも　しょうせつも</language>
		<language name="JPN_KANJI" width="216">はじまりかたって　重要ですよね
勝負も　小説も</language>
	</row>

	<row id="TRID_BIGFOUR1_02_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">……アタシの　さいしゅうしょうが
いま　はじまるのですね</language>
		<language name="JPN_KANJI" width="216">……アタシの　最終章が
いま　はじまるのですね</language>
	</row>

	<row id="TRID_BIGFOUR1_02_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<language name="JPN" width="216">そろそろ　この　ものがたりの
エピローグが　はじまりますね</language>
		<language name="JPN_KANJI" width="216">そろそろ　この物語の
エピローグが　はじまりますね</language>
	</row>

	<row id="TRID_BIGFOUR1_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……うわあ　アタシ　またも
しちゃってます　あぜんぼーぜん▼
いろいろ　ことばは　しっていますが
うまく　いいあらわせないんですよね▼
きっと　ことばに　すると
いまの　きもちとか　それに▽
とじこめられちゃうから　かなあ▼
でも　これだけは　いわせてください
アナタ　さらに　グレートです！！</language>
		<language name="JPN_KANJI" width="216">……うわあ　アタシ　またも
しちゃってます　あぜんぼーぜん▼
いろいろ　言葉は　知っていますが
うまく　言い表せないんですよね▼
きっと　言葉に　すると
今　あふれている　感情とか　それに▽
閉じ込められちゃうから　かなあ▼
でも　これだけは　いわせてください
アナタ　さらに　グレートです！！</language>
	</row>

	<row id="TRID_BIGFOUR2_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">ここで　その　わざとはね……
あいかわらず　ホレボレするよ</language>
		<language name="JPN_KANJI" width="216">ここで　その技とはね……
相変わらず　ホレボレするよ</language>
	</row>

	<row id="TRID_BIGFOUR2_02_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">さてと……　あらゆる　しょうぶで
じぶんから　おりたことは　ないぜ</language>
		<language name="JPN_KANJI" width="216">さてと……　あらゆる　勝負で
自分から　降りたことは　ないぜ</language>
	</row>

	<row id="TRID_BIGFOUR2_02_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<language name="JPN" width="216">まだ　こんな　じょうきょうでも
かてる　やりかた……　あるはずだぜ</language>
		<language name="JPN_KANJI" width="216">まだ　こんな　状況でも
勝てる　やりかた……　あるはずだぜ</language>
	</row>

	<row id="TRID_BIGFOUR2_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">だれかが　かてば
あいてした　だれかが　まける▼
それが　しょうぶって　やつだ▼
いい　しょうぶし　ってのは
しょうりをえて　じまんするでもなく▽
やぶれて　とりみだすでもなく▽
ただ　つぎの　しょうりを　もとめるのさ</language>
		<language name="JPN_KANJI" width="216">だれかが　勝てば
相手した　だれかが　負ける▼
それが　勝負って　やつだ▼
いい　勝負師　ってのは
勝利を得て　自慢するでもなく▽
敗れて　取り乱すでもなく▽
ただ　次の勝利を　求めるのさ</language>
	</row>

	<row id="TRID_BIGFOUR3_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">……あいかわらず　つよいな
それでこそ　こころおどる！</language>
		<language name="JPN_KANJI" width="216">……相変わらず　強いな
それでこそ　心躍る！</language>
	</row>

	<row id="TRID_BIGFOUR3_02_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">ラスト　１ぴき！
のこりの　ちからを　ふりしぼる！</language>
		<language name="JPN_KANJI" width="216">ラスト　１匹！
残りの　力を　振り絞る！</language>
	</row>

	<row id="TRID_BIGFOUR3_02_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<language name="JPN" width="216">……さいご　かもしれない
つぎの　わざに　すべてを　こめる！</language>
		<language name="JPN_KANJI" width="216">……最後かもしれない
次の技に　すべてを　こめる！</language>
	</row>

	<row id="TRID_BIGFOUR3_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">さいきょうの　ポケモンなど　いないし
ベストの　くみあわせも　ない……▼
それゆえ　つねに
かちつづけるのは　むずかしい▼
だが　つよさを　もとめる　こころ
さいきょうを　しりたい　きもち……▽
それを　わたしは　とうとい　とおもう▼
そして　それを　もっている
おまえを　そんけいする</language>
		<language name="JPN_KANJI" width="216">最強の　ポケモンなど　いないし
ベストの　組み合わせも　ない……▼
それゆえ　つねに
勝ち続けるのは　むずかしい▼
だが　強さを　求める　心
最強を　知りたい　気持ち……▽
それを　わたしは　尊いと　思う▼
そして　それを　持っている
おまえを　尊敬する</language>
	</row>

	<row id="TRID_BIGFOUR4_02_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">すてきな　じかんが　はじまる
この　しゅんかんが　おきにいり……</language>
		<language name="JPN_KANJI" width="216">すてきな　時間が　始まる
この　瞬間が　お気に入り……</language>
	</row>

	<row id="TRID_BIGFOUR4_02_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">どんなときでも
あわてず　さわがずに……</language>
		<language name="JPN_KANJI" width="216">どんなときでも
慌てず　騒がずに……</language>
	</row>

	<row id="TRID_BIGFOUR4_02_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<language name="JPN" width="216">アタクシを　しんじて　たたかう
ポケモンのためにも　あきらめません！</language>
		<language name="JPN_KANJI" width="216">アタクシを　信じて　戦う
ポケモンのためにも　あきらめません！</language>
	</row>

	<row id="TRID_BIGFOUR4_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">これまでどおり……
いえ　これまで　いじょうに▼
エレガントで　エクセレントな
トレーナーなのね　アナタ▼
アナタの　ポケモンにも
ひんが　そなわっていて▽
おあいてしていて　うれしかったわ</language>
		<language name="JPN_KANJI" width="216">これまでどおり……
いえ　これまで以上に▼
エレガントで　エクセレントな
トレーナーなのね　アナタ▼
アナタの　ポケモンにも
品が　備わっていて▽
お相手していて　うれしかったわ</language>
	</row>

	<row id="TRID_DPCHAMPION_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">ここまで　おいつめられたの
いついらい　かしら！</language>
		<language name="JPN_KANJI" width="216">ここまで　追い詰められたの
いつ以来　かしら！</language>
	</row>

	<row id="TRID_DPCHAMPION_01_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<language name="JPN" width="216">まだまだよ！　こんなに　たのしい
しょうぶ　かんたんに　おわらせない！</language>
		<language name="JPN_KANJI" width="216">まだまだよ！　こんなに　楽しい
勝負　簡単に　終わらせない！</language>
	</row>

	<row id="TRID_DPCHAMPION_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">こんなに　もえあがる
いっせんを　まじえることが　できて▽
こころが　たかなっちゃう……！▼
あなたって　ほんとうに
すごい　トレーナー　なのね！！</language>
		<language name="JPN_KANJI" width="216">こんなに　燃えあがる
一戦を　交えることが　できて▽
心が　高鳴っちゃう……！▼
あなたって　本当に
すごい　トレーナー　なのね！！</language>
	</row>

	<row id="TRID_PRINCESS_09_TRMSG_FIGHT_START">
		<language name="JPN" width="216">おじょうさま　って　つよいわよ？
だって　マネーが　ありますもの！▼</language>
		<language name="JPN_KANJI" width="216">おじょうさま　って　強いわよ？
だって　マネーが　ありますもの！▼</language>
	</row>

	<row id="TRID_PRINCESS_09_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">マネーの　つかいかた……
まだまだ　たりなかったの……？</language>
		<language name="JPN_KANJI" width="216">マネーの　使い方……
まだまだ　足りなかったの……？</language>
	</row>

	<row id="TRID_PRINCESS_09_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">じぶんの　ぶき　ですもの
あたくし　マネーを　つかいますわよ！</language>
		<language name="JPN_KANJI" width="216">自分の　武器ですもの
あたくし　マネーを　使いますわよ！</language>
	</row>

	<row id="TRID_JUGGLING_10_TRMSG_FIGHT_START">
		<language name="JPN" width="216">どうだい？　この　ポケモンジム▼
なんというか　ちょっと　ありえない
あやしげな　みりょく　たっぷりだろ▼</language>
		<language name="JPN_KANJI" width="216">どうだい？　この　ポケモンジム▼
なんというか　ちょっと　ありえない
怪しげな　魅力　たっぷりだろ▼</language>
	</row>

	<row id="TRID_JUGGLING_10_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ポケモンジムに　まけずおとらず
きみも　みりょく　たっぷり　だな！</language>
		<language name="JPN_KANJI" width="216">ポケモンジムに　負けず劣らず
きみも　魅力たっぷり　だな！</language>
	</row>

	<row id="TRID_JUGGLING_10_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">マユから　いとが　どっちに
のびているのか　よく　みてごらん▼
いとが　つながっている　さき……
それこそが　すすむ　ほうこうなのさ！</language>
		<language name="JPN_KANJI" width="216">繭から　糸が　どっちに
のびているのか　よく　みてごらん▼
糸が　つながっている　先……
それこそが　進む　方向なのさ！</language>
	</row>

	<row id="TRID_JUGGLING_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……そうなんだよ
マユに　くるまれ　ねていたんだよ　</language>
		<language name="JPN_KANJI" width="216">……そうなんだよ
繭に　くるまれ　寝ていたんだよ　</language>
	</row>

	<row id="TRID_JUGGLING_12_TRMSG_FIGHT_START">
		<language name="JPN" width="216">いきどまり……▼
と　みせかけて
とおせんぼ　やー！▼</language>
		<language name="JPN_KANJI" width="216">行き止まり……▼
と　みせかけて
とおせんぼ　やー！▼</language>
	</row>

	<row id="TRID_JUGGLING_12_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ありゃりゃりゃ
あんさん　つよすぎやない？</language>
		<language name="JPN_KANJI" width="216">ありゃりゃりゃ
あんさん　強すぎやない？</language>
	</row>

	<row id="TRID_JUGGLING_12_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ここだけの　ヒミツ……▼
マユに　はいる　むきによって
どこに　すすむのか　ちがうんよ</language>
		<language name="JPN_KANJI" width="216">ここだけの　ヒミツ……▼
繭に　入る　向きによって
どこに　進むのか　違うんよ</language>
	</row>

	<row id="TRID_JUGGLING_13_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あと　いっぽで！
アーティさんと　しょうぶ　できる！▼
だーけーどー　そのまえに
ミーが　たちはだかっちゃうのよー！▼</language>
		<language name="JPN_KANJI" width="216">あと　一歩で！
アーティさんと　勝負できる！▼
だーけーどー　その前に
ミーが　立ちはだかっちゃうのよー！▼</language>
	</row>

	<row id="TRID_JUGGLING_13_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">その　たたかいかた……
アーティさんぐらい　げいじゅつてき！</language>
		<language name="JPN_KANJI" width="216">その　戦い方……
アーティさんぐらい　芸術的！</language>
	</row>

	<row id="TRID_JUGGLING_13_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">アーティさんは　マユに　くるまる
ポケモンの　きもちを　しるために▽
ポケモンジムを　かいぞう　したのさ▼
……そのせいで　ミーたち
いっつも　まよっちゃうんだけどね</language>
		<language name="JPN_KANJI" width="216">アーティさんは　繭に　くるまる
ポケモンの　気持ちを　理解するために▽
ポケモンジムを　改造したのさ▼
……そのせいで　ミーたち
いっつも　迷っちゃうんだけどね</language>
	</row>

	<row id="TRID_PILOT_04_TRMSG_FIGHT_START">
		<language name="JPN" width="216">すごい　かぜ……　だろ？▼
これは　ジムリーダーを　はじめ
オレたちの　つよさの　しょうちょう！▼
さて　ここは　ポケモンジムだ！
ポケモンしょうぶと　いこう！▼</language>
		<language name="JPN_KANJI" width="216">すごい　風……　だろ？▼
これは　ジムリーダーを　はじめ
オレたちの　強さの　象徴！▼
さて　ここは　ポケモンジムだ！
ポケモン勝負と　行こう！▼</language>
	</row>

	<row id="TRID_PILOT_04_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">キミと　キミの　ポケモンから
すさまじい　あつりょくを　かんじたよ！</language>
		<language name="JPN_KANJI" width="216">キミと　キミの　ポケモンから
凄まじい　圧力を　感じたよ！</language>
	</row>

	<row id="TRID_PILOT_04_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">オレから　アドバイスだよ▼
まわりを　かべに　かこまれて
ゆかのいろが　ちがうところ　なら▽
かぜに　とばされないだろう！</language>
		<language name="JPN_KANJI" width="216">オレから　アドバイスだよ▼
周りを　壁に　囲まれ
床の色が　違うところ　なら▽
風に　飛ばされないだろう！</language>
	</row>

	<row id="TRID_PILOT_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">つよい　かぜにも　まけない
じまんの　ポケモンだぜ！▼</language>
		<language name="JPN_KANJI" width="216">強風にも　負けない
自慢の　ポケモンだぜ！▼</language>
	</row>

	<row id="TRID_PILOT_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">きみの　ポケモンには
まけてしまった……！</language>
		<language name="JPN_KANJI" width="216">きみの　ポケモンには
負けてしまった……！</language>
	</row>

	<row id="TRID_PILOT_05_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">そらをとぶ　ポケモンと
いっしょに　おおぞらを　まうため▽
パイロットに　なったんだ</language>
		<language name="JPN_KANJI" width="216">そらをとぶ　ポケモンと
一緒に　大空を　舞うため▽
パイロットに　なったんだ</language>
	</row>

	<row id="TRID_PILOT_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ときには　むぼうなほど　だいたんに
ときには　おびえすぎて　せんさいに▼
そうしないと　ジムの　しかけが
きみの　ゆくてを　はばんじゃうぜ▼</language>
		<language name="JPN_KANJI" width="216">時には　無謀なほど　大胆に
時には　おびえすぎて　繊細に▼
そうしないと　ジムの　仕掛けが
きみの　行く手を　はばんじゃうぜ▼</language>
	</row>

	<row id="TRID_PILOT_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ゆくてを　はばめなかった……
きみは　たいした　トレーナーだぜ！</language>
		<language name="JPN_KANJI" width="216">行く手を　はばめなかった……
きみは　たいした　トレーナーだぜ！</language>
	</row>

	<row id="TRID_PILOT_06_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">まわりにある　ふうりょくけいの
かいてんが　はやくなってきたら▽
むりせず　どこかに　かくれることだね</language>
		<language name="JPN_KANJI" width="216">周囲にある　風力計の
回転が　速くなってきたら▽
無理せず　どこかに　隠れることだね</language>
	</row>

	<row id="TRID_PILOT_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">わたしに　かてれば
つぎは　ジムリーダー……▼
そうおもうのは　ゆだんたいてき！
まだまだ　きを　ぬくなよ！▼</language>
		<language name="JPN_KANJI" width="216">わたしに　勝てれば
次は　ジムリーダー……▼
そう思っているなら　油断大敵
まだまだ　気を抜くなよ！▼</language>
	</row>

	<row id="TRID_PILOT_07_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">まさか！？
ゆだんなど　していなかったのに！</language>
		<language name="JPN_KANJI" width="216">まさか！？
油断など　していなかったのに！</language>
	</row>

	<row id="TRID_PILOT_07_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ひこうきの　そうじゅうは
ちゃくりくが　いちばん　むずかしい▽
さいごまで　ゆだん　するなよ</language>
		<language name="JPN_KANJI" width="216">飛行機の　操縦は
着陸が　一番　難しい……▽
最後まで　気を抜くんじゃないぜ</language>
	</row>

	<row id="TRID_PILOT_08_TRMSG_FIGHT_START">
		<language name="JPN" width="216">みぎ　よし！　ひだり　よし！▼
それでは　しょうぶの　フライト
テイク　オフ！▼</language>
		<language name="JPN_KANJI" width="216">右よし！　左よし！▼
それでは　勝負の　フライト
テイク　オフ！▼</language>
	</row>

	<row id="TRID_PILOT_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ざんねん　ながら
ちゃくりく……　セットダウンです</language>
		<language name="JPN_KANJI" width="216">残念ながら
着陸……　セットダウンです</language>
	</row>

	<row id="TRID_PILOT_08_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">きょうふうに　むかって
どれだけ　とべるか……？▼
ひこうきなら　せいのうが　だいじだが
ひとと　ポケモンは　きもちかな？</language>
		<language name="JPN_KANJI" width="216">強風に　向かって
どれだけ　飛べるか……？▼
飛行機なら　性能が　大事だが
人と　ポケモンは　気持ちかな？</language>
	</row>

	<row id="TRID_SWLEADER1_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">なるほど！　その　わざを　えらぶとは
てごわい　あいての　ようだね</language>
		<language name="JPN_KANJI" width="216">なるほど！　その技を　選ぶとは
手強い　相手の　ようだね</language>
	</row>

	<row id="TRID_SWLEADER1_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">まだまだ！　ぼくが　あきらめたら
ポケモンは　たたかえないからね！</language>
		<language name="JPN_KANJI" width="216">まだまだ！　ぼくが　あきらめたら
ポケモンは　戦えないからね！</language>
	</row>

	<row id="TRID_SWLEADER1_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……！　そう　これが
ポケモンしょうぶ　なんだね！</language>
		<language name="JPN_KANJI" width="216">……！　そう　これが
ポケモン勝負　なんだね！</language>
	</row>

	<row id="TRID_SWLEADER2_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">あんたの　かちたいって　きもち！
エネルギー　めっちゃ　あふれてる！</language>
		<language name="JPN_KANJI" width="216">あんたの　勝ちたいって　気持ち！
エネルギー　めっちゃ　あふれてる！</language>
	</row>

	<row id="TRID_SWLEADER2_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">ラスト！　すっごく　もりあげて
それでいて　あたしが　かつのッ！！</language>
		<language name="JPN_KANJI" width="216">ラスト！　すっごく　盛り上げて
それでいて　あたしが　勝つのッ！！</language>
	</row>

	<row id="TRID_SWLEADER2_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ちょっとーッ！
アンコール！　アンコール！！</language>
		<language name="JPN_KANJI" width="216">ちょっとーッ！
アンコール！　アンコール！！</language>
	</row>

	<row id="TRID_SWLEADER3_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">ビシィッと　スイッチ　オーン！
むしポケモンの　ほんき　みせちゃう！</language>
		<language name="JPN_KANJI" width="216">ビシィッと　スイッチ　オーン！
むしポケモンの　本気　みせちゃう！</language>
	</row>

	<row id="TRID_SWLEADER3_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">むうん　むしのしらせ！
けっこう　ピンチかも　だって！？</language>
		<language name="JPN_KANJI" width="216">むうん　むしのしらせ！
けっこう　ピンチかも　だって！？</language>
	</row>

	<row id="TRID_SWLEADER3_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ぬうん……！？　おわった
きみ　すごいんだねー！！</language>
		<language name="JPN_KANJI" width="216">ぬうん……！？　終わった
きみ　すごいんだねー！！</language>
	</row>

	<row id="TRID_SWLEADER4_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">その　たちふるまい……
かがやいているわね　あなたたち！</language>
		<language name="JPN_KANJI" width="216">その　立ち振る舞い……
輝いているわね　あなたたち！</language>
	</row>

	<row id="TRID_SWLEADER4_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">ピンチを　のりこえる！
ファンの　きたいに　こたえないとね</language>
		<language name="JPN_KANJI" width="216">ピンチを　乗り越える！
ファンの　期待に　応えないとね</language>
	</row>

	<row id="TRID_SWLEADER4_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">しびれた……
ハートが　とろけるほどに</language>
		<language name="JPN_KANJI" width="216">しびれた……
ハートが　とろけるほどに</language>
	</row>

	<row id="TRID_SWLEADER5_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">……ほほう！
それなりの　うでまえ　だな</language>
		<language name="JPN_KANJI" width="216">……ほほう！
それなりの　腕前だな</language>
	</row>

	<row id="TRID_SWLEADER5_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">オレさまが　あきらめたら
ポケモンに　もうしわけねえだろ！</language>
		<language name="JPN_KANJI" width="216">オレさまが　あきらめたら
ポケモンに　申し訳ねえだろ！</language>
	</row>

	<row id="TRID_SWLEADER5_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">やれやれ……　ほんきで　たたかって
まけると　すがすがしいな！</language>
		<language name="JPN_KANJI" width="216">やれやれ……　本気で　戦って
負けると　すがすがしいな！</language>
	</row>

	<row id="TRID_SWLEADER6_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">あいてが　どう　せめてくるのかって
すごく　ドキドキしちゃうよね！</language>
		<language name="JPN_KANJI" width="216">あいてが　どう　攻めてくるのかって
すごく　ドキドキしちゃうよね！</language>
	</row>

	<row id="TRID_SWLEADER6_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">ネバーギブアップ　です！
たたかう　ポケモンに　しつれいだもの</language>
		<language name="JPN_KANJI" width="216">ネバーギブアップ　です！
戦う　ポケモンに　失礼だもの</language>
	</row>

	<row id="TRID_SWLEADER6_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">いまの　たたかい　わすれないよ！
アナタと　たたかえて　よかった！</language>
		<language name="JPN_KANJI" width="216">今の　戦い　忘れないよ！
アナタと　戦えて　よかった！</language>
	</row>

	<row id="TRID_SWLEADER7_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">どんな　わざを　えらぼうとも
あつい　おもいを　かんじるぞ！</language>
		<language name="JPN_KANJI" width="216">どんな技を　選ぼうとも
熱い　思いを　感じるぞ！</language>
	</row>

	<row id="TRID_SWLEADER7_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">おいてなお　ぜんしんの　ちがたぎる！
まだまだ　たたかおうぞ！！</language>
		<language name="JPN_KANJI" width="216">置いてなお　全身の　血がたぎる！
まだまだ　戦おうぞ！！</language>
	</row>

	<row id="TRID_SWLEADER7_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">やぶれて　わきあがる　くやしさ……▼
その　おもいに　くっせぬ　こころこそ
いきる　エネルギー　というもの！！</language>
		<language name="JPN_KANJI" width="216">敗れて　わきあがる　悔しさ……▼
その思いに　屈せぬ　心こそ
生きる　エネルギー　というもの！！</language>
	</row>

	<row id="TRID_SWLEADER8_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">おはん……
やりおるな！</language>
		<language name="JPN_KANJI" width="216">おはん……
やりおるな！</language>
	</row>

	<row id="TRID_SWLEADER8_01_TRMSG_FIGHT_POKE_LAST">
		<language name="JPN" width="216">まいったのう……　あとがないのに
ワクワクして　たまらんわい！</language>
		<language name="JPN_KANJI" width="216">参ったのう……　あとがないのに
ワクワクして　たまらんわい！</language>
	</row>

	<row id="TRID_SWLEADER8_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">たいした　もんじゃ！
ええ　ポケモン　そだてとるな！</language>
		<language name="JPN_KANJI" width="216">たいした　もんじゃ！
ええ　ポケモン　育てとるな！</language>
	</row>

	<row id="TRID_SWRIVAL_01_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">いまの　ポケモンの　いたみ！
ぜったいに　わすれないぜ！</language>
		<language name="JPN_KANJI" width="216">今の　ポケモンの　痛み！
絶対に　忘れないぜ！</language>
	</row>

	<row id="TRID_SWRIVAL_01_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<language name="JPN" width="216">ポケモンを　しんじて
わざを　きめるだけさッ！</language>
		<language name="JPN_KANJI" width="216">ポケモンを　信じて
技を　決めるだけさッ！</language>
	</row>

	<row id="TRID_SWRIVAL_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">はいぼくで　はじまる
ポケモントレーナーの　みち　か……</language>
		<language name="JPN_KANJI" width="216">敗北で　はじまる
ポケモントレーナーの　道か……</language>
	</row>

	<row id="TRID_SWRIVAL_02_TRMSG_FIGHT_FIRST_DAMAGE">
