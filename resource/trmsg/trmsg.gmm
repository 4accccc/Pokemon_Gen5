	</row>

	<row id="TRID_SWRIVAL_11_TRMSG_FIGHT_FIRST_DAMAGE">
		<language name="JPN" width="216">いくぜッ！
あいぼうッ！！</language>
		<language name="JPN_KANJI" width="216">行くぜッ！
相棒ッ！！</language>
	</row>

	<row id="TRID_SWRIVAL_11_TRMSG_FIGHT_POKE_LAST_HP_HALF">
		<language name="JPN" width="216">たのむッ！！</language>
		<language name="JPN_KANJI" width="216">頼むッ！！</language>
	</row>

	<row id="TRID_SWRIVAL_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あいぼうたちの　ちからを
