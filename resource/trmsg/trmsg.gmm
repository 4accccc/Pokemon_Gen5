	<row id="TRID_FANM_11_TRMSG_FIGHT_LOSE_2">
		<language name="JPN" width="216">ああっ　ぼくの
モンスターボールっっ！</language>
		<language name="JPN_KANJI" width="216">ああっ　ぼくの
モンスターボールっっ！</language>
	</row>

	<row id="TRID_FANM_11_TRMSG_FIGHT_AFTER_2">
