	<row id="TRID_TANPAN_20_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ぼくも　アンラッキー　だな
つよい　きみに　であうなんて……</language>
		<language name="JPN_KANJI" width="216">ぼくも　アンラッキー　だな
強い　きみに　出会うなんて……</language>
	</row>

	<row id="TRID_TANPAN_20_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">まけて　おちこむ　ヒマが　むだ！
どんどん　たたかって　つよくなるよ</language>
		<language name="JPN_KANJI" width="216">負けて　落ち込む　ヒマが　むだ！
どんどん　戦って　強くなるよ</language>
	</row>

	<row id="TRID_MINI_16_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あなたと　あたし
どちらの　ポケモンが　かわいいか▽
みせあいっこ　しましょ！▼</language>
		<language name="JPN_KANJI" width="216">あなたと　あたし
どちらの　ポケモンが　可愛いか▽
みせあいっこ　しましょ！▼</language>
	</row>

	<row id="TRID_MINI_16_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あなたの　ポケモンは　つよくて
あたしの　ポケモンは　かわいいの……</language>
		<language name="JPN_KANJI" width="216">あなたの　ポケモンは　強くて
あたしの　ポケモンは　可愛いの……</language>
	</row>

	<row id="TRID_MINI_16_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">まよっちゃうなあ……　かわいくて
つよい　ポケモンが　いちばん　かな？</language>
		<language name="JPN_KANJI" width="216">迷っちゃうなあ……　可愛くて
強い　ポケモンが　一番　かな？</language>
	</row>

	<row id="TRID_CLEANING_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">おっ！　みかけない　トレーナーだ！
ちょいと　あいてを　してくれんかね▼</language>
		<language name="JPN_KANJI" width="216">おっ！　みかけない　トレーナーだ！
ちょいと　相手を　してくれんかね▼</language>
	</row>

	<row id="TRID_CLEANING_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">おお！　たまげた！
わかいのに　たいしたもんだね！</language>
		<language name="JPN_KANJI" width="216">おお！　たまげた！
若いのに　たいしたもんだね！</language>
	</row>

	<row id="TRID_CLEANING_03_TRMSG_FIGHT_AFTER">
		<language name="JPN" width="216">ぼくじょうや　どうろの　あちこちに
みえないけれど　どうぐが　おちとるよ！</language>
		<language name="JPN_KANJI" width="216">牧場や　道路の　あちこちに
みえないけれど　道具が　落ちとるよ！</language>
	</row>

	<row id="TRID_SCHOOLB_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">もっと　アデクさんから
いろいろ　おそわらないと……</language>
		<language name="JPN_KANJI" width="216">もっと　アデクさんから
いろいろ　教わらないと……</language>
	</row>

	<row id="TRID_SCHOOLG_09_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">えー！？　オレンのみを
もたせていたのに　まけるなんて！</language>
		<language name="JPN_KANJI" width="216">えー！？　オレンのみを
持たせていたのに　負けるなんて！</language>
	</row>

	<row id="TRID_TANPAN_19_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">きみ　つよいな！　それとも
ポケモンが　つよいの？</language>
		<language name="JPN_KANJI" width="216">きみ　強いな！　それとも
ポケモンが　強いの？</language>
	</row>

	<row id="TRID_MINI_15_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ちしきって　ならうだけでなく
