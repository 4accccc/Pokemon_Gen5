	<row id="TRID_KINDERGARTENW_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あたしの　すっごい　ポケモン
トレーナーさんに　みせてあげるもん▼</language>
		<language name="JPN_KANJI" width="216">あたしの　すっごい　ポケモン
トレーナーさんに　みせてあげるもん▼</language>
	</row>

	<row id="TRID_KINDERGARTENW_06_TRMSG_FIGHT_LOSE">
