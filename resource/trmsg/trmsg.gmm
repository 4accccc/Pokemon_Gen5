	<row id="TRID_BASKET_01_TRMSG_FIGHT_START">
		<language name="JPN" width="216">オレは　まだまだ　ルーキーだが
いつか　すごい　プレイヤーになる！▼
そのためには　ポケモンしょうぶも
どんどん　こなしていくぜ！▼</language>
		<language name="JPN_KANJI" width="216">オレは　まだまだ　ルーキーだが
いつか　すごい　プレイヤーになる！▼
そのためには　ポケモン勝負も
どんどん　こなしていくぜ！▼</language>
	</row>

	<row id="TRID_BASKET_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ぐぎゃあ！
ドリブル　しっぱい！</language>
		<language name="JPN_KANJI" width="216">ぐぎゃあ！
ドリブル失敗！</language>
	</row>

	<row id="TRID_BASKET_01_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">オレの　ファン　かもしれない
キミに　プレゼントだよ！▼</language>
		<language name="JPN_KANJI" width="216">オレの　ファン　かもしれない
キミに　プレゼントだよ！▼</language>
	</row>

	<row id="TRID_BASKET_01_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">まけても　いいわけ　しないぜ！▼
そんなヒマが　あったら
うまくなるために　できることを▽
するほうが　いいに　きまってる！</language>
		<language name="JPN_KANJI" width="216">負けても　言い訳　しないぜ！▼
そんなヒマが　あったら
うまくなるために　できることを▽
するほうが　いいに　決まってる！</language>
	</row>

	<row id="TRID_BASKET_02_TRMSG_FIGHT_START">
		<language name="JPN" width="216">わかものよ！　せいしゅんとは
あせを　ながすことだろ！？▼</language>
		<language name="JPN_KANJI" width="216">若者よ！　青春とは
汗を　流すことだろ！？▼</language>
	</row>

	<row id="TRID_BASKET_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">さわやかな　あせ……
ああ　スポーツマンで　よかった！</language>
		<language name="JPN_KANJI" width="216">さわやかな　汗……
ああ　スポーツマンで　よかった！</language>
	</row>

	<row id="TRID_BASKET_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">スポーツマンは　きまえがいい
どーんと　もらってくれよ！▼</language>
		<language name="JPN_KANJI" width="216">スポーツマンは　気前がいい
どーんと　もらってくれよ！▼</language>
	</row>

	<row id="TRID_BASKET_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">バスケットボール　サイズの
モンスターボールが　ほしいね！▼
だって　でっかいほうが　なかの
ポケモンも　きもちいい　でしょ！？</language>
		<language name="JPN_KANJI" width="216">バスケットボール　サイズの
モンスターボールが　欲しいね！▼
だって　でっかいほうが　中の
ポケモンも　気持ちいい　でしょ！？</language>
	</row>

	<row id="TRID_FOOTBALL_01_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ＰＯＷＥＲ！▼
ポケモンも　アメフトも
パワーが　いのち！！▼</language>
		<language name="JPN_KANJI" width="216">ＰＯＷＥＲ！▼
ポケモンも　アメフトも
パワーが　命！！▼</language>
	</row>

	<row id="TRID_FOOTBALL_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">パワーが　たりなかったのか……</language>
		<language name="JPN_KANJI" width="216">パワーが　たりなかったのか…</language>
	</row>

	<row id="TRID_FOOTBALL_01_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">パワーは　たりないが
やさしさは　たりているぞ！▼</language>
		<language name="JPN_KANJI" width="216">パワーは　たりないが
優しさは　たりているぞ！▼</language>
	</row>

	<row id="TRID_FOOTBALL_01_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">さいきょうを　めざして　まいにち
ポケモンと　トレーニングしているよ！</language>
		<language name="JPN_KANJI" width="216">最強を　目指して　毎日
ポケモンと　トレーニングしているよ！</language>
	</row>

	<row id="TRID_TENNIS_01_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ゆうがな　テニスプレイヤーは
ゆうがに　しょうぶを　いたします！▼</language>
		<language name="JPN_KANJI" width="216">優雅な　テニスプレイヤーは
優雅に　勝負を　いたします！▼</language>
	</row>

	<row id="TRID_TENNIS_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ま　まけても
うろたえませんわ</language>
		<language name="JPN_KANJI" width="216">ま　負けても
うろたえませんわ</language>
	</row>

	<row id="TRID_TENNIS_01_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">うろたえたりして
こんな　モノ　あげちゃうわ！▼</language>
		<language name="JPN_KANJI" width="216">うろたえたりして
こんな　モノ　あげちゃうわ！▼</language>
	</row>

	<row id="TRID_TENNIS_01_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">アタクシ　レディですから
く　くやしがったり　しませんわ！</language>
		<language name="JPN_KANJI" width="216">アタクシ　レディですから
く　くやしがったり　しませんわ！</language>
	</row>

	<row id="TRID_TENNIS_02_TRMSG_FIGHT_START">
		<language name="JPN" width="216">よせんしあいが　ちかいのよ！▼
あんたを　かべに　みたてて
スマッシュの　れんしゅうさ！▼</language>
		<language name="JPN_KANJI" width="216">予選試合が　近いのよ！▼
あんたを　壁に　見立てて
スマッシュの　練習さ！▼</language>
	</row>

	<row id="TRID_TENNIS_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ハアッ！　ハア　ハア　ハア……
いい　トレーニングになったわ……</language>
		<language name="JPN_KANJI" width="216">ハアッ！　ハア　ハア　ハア……
いい　トレーニングになったわ……</language>
	</row>

	<row id="TRID_TENNIS_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ハア　ハア　ハア
ハア　ハア　ハア……▼</language>
		<language name="JPN_KANJI" width="216">ハア　ハア　ハア
ハア　ハア　ハア……▼</language>
	</row>

	<row id="TRID_TENNIS_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">あんたと　ワタシは　であったばかり
ラブゲームからの　スタートね！</language>
		<language name="JPN_KANJI" width="216">あんたと　ワタシは　出会ったばかり
ラブゲームからの　スタートね！</language>
	</row>

	<row id="TRID_BASEBALL_01_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ちょっと　つよい　おれ
ばっちり　しまっていくぜ▼</language>
		<language name="JPN_KANJI" width="216">ちょっと　強い　おれ
ばっちり　しまっていくぜ▼</language>
	</row>

	<row id="TRID_BASEBALL_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">しまった……</language>
		<language name="JPN_KANJI" width="216">しまった……</language>
	</row>

	<row id="TRID_BASEBALL_01_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ビッグスタジアムに
きてくれて　サンキューな！▼</language>
		<language name="JPN_KANJI" width="216">ビッグスタジアムに
来てくれて　サンキューな！▼</language>
	</row>

	<row id="TRID_BASEBALL_01_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">きみ　なかなか　つよいね
リトルリーグよりは　うえだよ！</language>
		<language name="JPN_KANJI" width="216">きみ　なかなか　強いね
リトルリーグよりは　上だよ！</language>
	</row>

	<row id="TRID_BASEBALL_02_TRMSG_FIGHT_START">
		<language name="JPN" width="216">おいおい！
れんしゅうあいてに　なるのかい！？▼
いっておくが　オレは
れんしゅうでも　ほんき　だすぜ！▼</language>
		<language name="JPN_KANJI" width="216">おいおい！
練習相手に　なるのかい！？▼
いっておくが　オレは
練習でも　本気だすぜ！▼</language>
	</row>

	<row id="TRID_BASEBALL_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">かなわなかった……
うえには　うえが　いるものだ</language>
		<language name="JPN_KANJI" width="216">かなわなかった……
上には　上が　いるものだ</language>
	</row>

	<row id="TRID_BASEBALL_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">れんしゅうあいてを
してくれた　おれい　だよ！▼</language>
		<language name="JPN_KANJI" width="216">練習相手を　してくれた
お礼だよ！▼</language>
	</row>

	<row id="TRID_BASEBALL_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">やくそく　しよう！▼
この　はいぼくを　かてに　オレは
もっと　すごい　プレイヤーになる！</language>
		<language name="JPN_KANJI" width="216">約束しよう！▼
この敗北を　糧に　オレは
もっと　すごい　プレイヤーになる！</language>
	</row>

	<row id="TRID_BUSINESS1_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ふしゅー！　やすみくらいは
りんせんたいせいを　かいじょする！</language>
		<language name="JPN_KANJI" width="216">ふしゅー！　休みくらいは
臨戦態勢を　解除する！</language>
	</row>

	<row id="TRID_FANM_01_TRMSG_FIGHT_START_1">
		<language name="JPN" width="216">れんしゅうを　みていたら
なんだか　じぶんも　すごくなった▽
そんな　きぶんに　なるだろ？▽
だから　しょうぶ　しようよ！▼</language>
		<language name="JPN_KANJI" width="216">練習を　見ていたら
なんだか　自分も　すごくなった▽
そんな　気分に　なるだろ？▽
だから　勝負しようよ！▼</language>
	</row>

	<row id="TRID_FANM_01_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">タカ『……ぜんぜん
うまく　できなかったよ▼
シゲ『……さっぱり
うまく　できなかったよ</language>
		<language name="JPN_KANJI" width="216">タカ『……ぜんぜん
うまく　できなかったよ▼
シゲ『……さっぱり
うまく　できなかったよ</language>
	</row>

	<row id="TRID_FANM_01_TRMSG_FIGHT_AFTER_1">
		<language name="JPN" width="216">むずかしいことを　さも
かんたんに　やってみせる……▼
プロフェッショナルの
すごさ　って　やつだね</language>
		<language name="JPN_KANJI" width="216">難しいことを　さも
簡単に　やってみせる……▼
プロフェッショナルの
すごさ　って　やつだね</language>
	</row>

	<row id="TRID_FANM_01_TRMSG_POKE_ONE_1">
		<language name="JPN" width="216">１ｖｓ２では
しょうぶ　できないね</language>
		<language name="JPN_KANJI" width="216">１ｖｓ２では
勝負できないね</language>
	</row>

	<row id="TRID_FANM_01_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">いろんな　スポーツの
チームプレイを　みていたら▼
ぼくたちも　コンビで
たたかって　みたくなったのさ！▼</language>
		<language name="JPN_KANJI" width="216">いろんな　スポーツの
チームプレイを　見ていたら▼
ぼくたちも　コンビで
戦って　みたくなったのさ！▼</language>
	</row>

	<row id="TRID_FANM_01_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">チームプレイって　むずかしいな▼
なかまが　なにを
かんがえているか　わかれば▽
もっと　すごいことが　できるのに！</language>
		<language name="JPN_KANJI" width="216">チームプレイって　難しいな▼
仲間が　何を
考えているか　わかれば▽
もっと　すごいことが　できるのに！</language>
	</row>

	<row id="TRID_FANM_01_TRMSG_POKE_ONE_2">
		<language name="JPN" width="216">ぼくたち　コンビで
ポケモンしょうぶ　してみたいんだ</language>
		<language name="JPN_KANJI" width="216">ぼくたち　コンビで
ポケモン勝負　してみたいんだ</language>
	</row>

	<row id="TRID_FANM_02_TRMSG_FIGHT_START_1">
		<language name="JPN" width="216">ビッグスタジアムに　くるだけで
こうふん　しちゃって！！▼</language>
		<language name="JPN_KANJI" width="216">ビッグスタジアムに　来るだけで
興奮しちゃって！！▼</language>
	</row>

	<row id="TRID_FANM_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ヒロ『こうふん　しすぎた！▼
シン『なんという　こうふん！
まさに　エクスタシー！</language>
		<language name="JPN_KANJI" width="216">ヒロ『興奮しすぎた！▼
シン『なんという　興奮！
まさに　エクスタシー！</language>
	</row>

	<row id="TRID_FANM_02_TRMSG_FIGHT_AFTER_1">
		<language name="JPN" width="216">いるだけで！　みるだけで！
こんなに　こうふん　するんだ！▼
ここで　しあい　するなんて
とんでもない　こうふん　だろうな！</language>
		<language name="JPN_KANJI" width="216">いるだけで！　みるだけで！
こんなに　興奮するんだ！▼
ここで　試合するなんて
とんでもない　興奮だろうな！</language>
	</row>

	<row id="TRID_FANM_02_TRMSG_POKE_ONE_1">
		<language name="JPN" width="216">１ｖｓ２では
しょうぶ　したくないね</language>
		<language name="JPN_KANJI" width="216">１ｖｓ２では
勝負したくないね</language>
	</row>

	<row id="TRID_FANM_02_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">この　スタジアムで　たたかえば
あこがれの　スターせんしゅの▽
きもちが　わかると　おもうよね！▼</language>
		<language name="JPN_KANJI" width="216">この　スタジアムで　戦えば
あこがれの　スター選手の▽
気持ちが　わかると　思うよね！▼</language>
	</row>

	<row id="TRID_FANM_02_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">スタジアムで　ポケモンと
いっしょに　たたかえて……▼
すこしは　スターの　きもちを
あじわえて　なんか　うれしいな！</language>
		<language name="JPN_KANJI" width="216">スタジアムで　ポケモンと
いっしょに　戦えて……▼
少しは　スターの　気持ちを
味わえて　なんか　うれしいな！</language>
	</row>

	<row id="TRID_FANM_02_TRMSG_POKE_ONE_2">
		<language name="JPN" width="216">１ｖｓ２？　それじゃあ
しょうぶ　できないね</language>
		<language name="JPN_KANJI" width="216">１ｖｓ２？　それじゃあ
勝負できないね</language>
	</row>

	<row id="TRID_FANM_03_TRMSG_FIGHT_START_1">
		<language name="JPN" width="216">ひとが　れんしゅう　していると
じぶんも　からだを　うごかしたくなる▼
だーかーら　ぼくたちも
ポケモンの　れんしゅう　しよう！▼</language>
		<language name="JPN_KANJI" width="216">人が　練習していると
自分も　体を　動かしたくなる▼
だーかーら　ぼくたちも
ポケモンの　練習しよう！▼</language>
	</row>

	<row id="TRID_FANM_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">タク『まけても　わらうのは
たのしいからだよ！▼
ヤス『ああ！　ポケモンへの
おうえんが　たりなかった</language>
		<language name="JPN_KANJI" width="216">タク『負けても　笑うのは
楽しいからだよ！▼
ヤス『ああ！　ポケモンへの
応援が　たりなかった</language>
	</row>

	<row id="TRID_FANM_03_TRMSG_FIGHT_AFTER_1">
		<language name="JPN" width="216">ひとの　れんしゅうを　みるより
じぶんで　しょうぶする　ほうが▽
なんばいも　たのしいのな！！</language>
		<language name="JPN_KANJI" width="216">人の　練習を　見るより
自分で　勝負する　ほうが▽
何倍も　楽しいのな！！</language>
	</row>

	<row id="TRID_FANM_03_TRMSG_POKE_ONE_1">
		<language name="JPN" width="216">１ｖｓ２では
しょうぶ　できないね</language>
		<language name="JPN_KANJI" width="216">１ｖｓ２では
勝負できないね</language>
	</row>

	<row id="TRID_FANM_03_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">いつもは　おうえん　ばかりだけど
きょうは　ゆうきを　だして▽
ポケモンしょうぶ　してみたいんだ▼</language>
		<language name="JPN_KANJI" width="216">いつもは　応援ばかりだけど
きょうは　勇気を　だして▽
ポケモン勝負　してみたいんだ▼</language>
	</row>

	<row id="TRID_FANM_03_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">ボクは　スポーツが　へただけど
ひっしに　おうえん　することで▽
ボクなりに　スポーツを　たのしむんだ！</language>
		<language name="JPN_KANJI" width="216">ボクは　スポーツが　下手だけど
