	</row>

	<row id="TRID_WORKER2_33_TRMSG_FIGHT_START">
		<language name="JPN" width="216">クッ！　サクッ！▼</language>
		<language name="JPN_KANJI" width="216">クッ！　サクッ！▼</language>
	</row>

	<row id="TRID_WORKER2_33_TRMSG_FIGHT_LOSE">
