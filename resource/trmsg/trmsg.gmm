	</row>

	<row id="TRID_ELITEW_15_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ふだんは　エリートらしく　してるけど
ここに　いるときくらい　ふつうの▽
おんなのこで　いたいの▼</language>
		<language name="JPN_KANJI" width="216">普段は　エリートらしく　してるけど
ここに　いるときくらい　普通の▽
女の子で　いたいの▼</language>
	</row>

	<row id="TRID_ELITEW_15_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">いまは　あんま　ポケモンの　こと
かんがえたく　ないんだけど！</language>
		<language name="JPN_KANJI" width="216">今は　あんま　ポケモンの　こと
考えたく　ないんだけど！</language>
	</row>

	<row id="TRID_ELITEW_15_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">これ　あげるからさ　わるいけど
そっと　しておいてくれる？▼</language>
		<language name="JPN_KANJI" width="216">これ　あげるからさ　悪いけど
そっと　しておいてくれる？▼</language>
	</row>

	<row id="TRID_ELITEW_15_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">エリートだって　たまにはさ
ふつうの　おんなのこ　してたいの！▼
かっこいい　せんしゅに　キャーって
さわいだりして　たのしみたいの</language>
		<language name="JPN_KANJI" width="216">エリートだって　たまにはさ
普通の　女の子　してたいの！▼
かっこいい　選手に　キャーって
騒いだりして　楽しみたいの</language>
	</row>

	<row id="TRID_ESPM_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">つぎは　どっちの　チームが
ゴールを　きめるか！？▽
オレに　かてば　おしえるよ！▼</language>
		<language name="JPN_KANJI" width="216">次は　どっちの　チームが
ゴールを　決めるか！？▽
オレに　勝てば　教えるよ！▼</language>
	</row>

	<row id="TRID_ESPM_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ピキーン！
つぎの　ゴールは　あっちの　チーム！</language>
		<language name="JPN_KANJI" width="216">ピキーン！
次の　ゴールは　あっちの　チーム！</language>
	</row>

	<row id="TRID_ESPM_06_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ピキーン！
オレは　これを　あげる！▼</language>
		<language name="JPN_KANJI" width="216">ピキーン！
オレは　これを　あげる！▼</language>
	</row>

	<row id="TRID_ESPM_06_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">オレの　ちょうのうりょく
ボールが　ゴールが　きまる▽
すんぜんにしか　はたらかないよ</language>
		<language name="JPN_KANJI" width="216">オレの　超能力
ボールが　ゴールが　決まる▽
寸前にしか　働かないよ</language>
	</row>

	<row id="TRID_ESPW_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">うふふ……▼
わたしが　ねんじた　チームが
かならず　かつのよ！▼</language>
		<language name="JPN_KANJI" width="216">うふふ……▼
わたしが　念じた　チームが
必ず　勝つのよ！▼</language>
	</row>

	<row id="TRID_ESPW_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あれっ……？
まさか　いままでのは　ぐうぜん……？</language>
		<language name="JPN_KANJI" width="216">あれっ……？
まさか　今までのは　偶然……？</language>
	</row>

	<row id="TRID_ESPW_06_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">わたしに　かてた　ひとには
かならず　あげるのよ！▼</language>
		<language name="JPN_KANJI" width="216">わたしに　勝てた　人には
必ず　あげるのよ！▼</language>
	</row>

	<row id="TRID_ESPW_06_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">おうえんは　きもちが　だいじよね！
しんじれば　かちそうなきが　するもの！</language>
		<language name="JPN_KANJI" width="216">応援は　気持ちが　大事よね！
信じれば　勝ちそうな気が　するもの！</language>
	</row>

	<row id="TRID_FISHING_04_TRMSG_FIGHT_START">
		<language name="JPN" width="216">つりだって　りっぱな　スポーツ！
なぜ　つりスタジアムが　ないんだ！？▼</language>
		<language name="JPN_KANJI" width="216">釣りだって　立派な　スポーツ！
なぜ　釣りスタジアムが　ないんだ！？▼</language>
	</row>

	<row id="TRID_FISHING_04_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">……まぁ　つりは　しぜんのなかで
やるのが　たのしいよね▼</language>
		<language name="JPN_KANJI" width="216">……まぁ　釣りは　自然の中で
やるのが　楽しいよね▼</language>
	</row>

	<row id="TRID_FISHING_04_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">たのしい　ひとときを　ありがとう
これは　ほんの　きもちだよ▼</language>
		<language name="JPN_KANJI" width="216">楽しい　ひとときを　ありがとう
これは　ほんの　気持ちだよ▼</language>
	</row>

	<row id="TRID_FISHING_04_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">しずかな　しぜんも　すきだが
こういう　にぎやかなとこも　すきだな</language>
		<language name="JPN_KANJI" width="216">静かな　自然も　好きだが
こういう　にぎやかなとこも　好きだな</language>
	</row>

	<row id="TRID_GENTLE_02_TRMSG_FIGHT_START">
		<language name="JPN" width="216">スポーツの　おおくは
ジェントルマンの　あそびから▽
うまれて　いるのだよ！▼</language>
		<language name="JPN_KANJI" width="216">スポーツの　多くは
ジェントルマンの　遊びから▽
うまれて　いるのだよ！▼</language>
	</row>

	<row id="TRID_GENTLE_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">レディース　アンド　ジェントルマン！
しあいは　おわりましたー！</language>
		<language name="JPN_KANJI" width="216">レディース　アンド　ジェントルマン！
試合は　終わりましたー！</language>
	</row>

	<row id="TRID_GENTLE_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ジェントルマンだからね
きまえよく　プレゼントだよ！▼</language>
		<language name="JPN_KANJI" width="216">ジェントルマンだからね
気前良く　プレゼントだよ！▼</language>
	</row>

	<row id="TRID_GENTLE_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ポケモンしょうぶは　ひとと
ポケモンが　なかよくなり▽
しぜんに　うまれた　あそびだね</language>
		<language name="JPN_KANJI" width="216">ポケモン勝負は　人と
ポケモンが　仲良くなり▽
自然に　うまれた　遊びだね</language>
	</row>

	<row id="TRID_HEADS_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">なあなあ　ちょっと
オメー　みた！？▼
スゲーよ！　ここ　いつも　テレビに
でている　ゆうめいな　ひとが▽
たっくさん　いるんだよー！▼</language>
		<language name="JPN_KANJI" width="216">なあなあ　ちょっと
オメー！　見た！？▼
スゲーよ！　ここ　いつも　テレビに
でている　有名な　人が▽
たっくさん　いるんだよー！▼</language>
	</row>

	<row id="TRID_HEADS_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">スポーツせんしゅは　みんな
かっこいいぜ　あこがれるよー</language>
		<language name="JPN_KANJI" width="216">スポーツ選手は　みんな
かっこいいぜ　あこがれるよー</language>
	</row>

	<row id="TRID_HEADS_03_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">オメーも　かっこいいな
あこがれるよー！　これ　やるよー！▼</language>
		<language name="JPN_KANJI" width="216">オメーも　かっこいいな
あこがれるよー！　これ　やるよー！▼</language>
	</row>

	<row id="TRID_HEADS_03_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">もー　オレ　なんで　カメラとか
サインしきし　もってきてないのー</language>
		<language name="JPN_KANJI" width="216">もー　オレ　なんで　カメラとか
サイン色紙　持ってきてないのー</language>
	</row>

	<row id="TRID_JUGGLING_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">おきゃくを　たのしませる　ところは
スポーツも　ジャグリングも　おなじ！▽
れんしゅうの　せいかを　みせるよ▼</language>
		<language name="JPN_KANJI" width="216">お客を　楽しませる　ところは
スポーツも　ジャグリングも　同じ！▽
練習の　成果を　みせるよ▼</language>
	</row>

	<row id="TRID_JUGGLING_07_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ポケモンしょうぶを　しながら
１０この　ボールを　キャッチ！</language>
		<language name="JPN_KANJI" width="216">ポケモン勝負を　しながら
１０個の　ボールを　キャッチ！</language>
	</row>

	<row id="TRID_JUGGLING_07_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">きみも　これを　キャッチ！▼</language>
		<language name="JPN_KANJI" width="216">きみも　これを　キャッチ！▼</language>
	</row>

	<row id="TRID_JUGGLING_07_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">テクニックは　ついたが
その　いかしかたが　わからん！▽
やはり　じっせん　あるのみ！</language>
		<language name="JPN_KANJI" width="216">テクニックは　ついたが
その　有効利用が　わからん！▽
やはり　実戦　あるのみ！</language>
	</row>

	<row id="TRID_KARATE_09_TRMSG_FIGHT_START">
		<language name="JPN" width="216">どハデな　ドームに　あたりから
キャーキャーとびかう　かんせい……▼
うう……
オラ　うらやましいっスっ！▼</language>
		<language name="JPN_KANJI" width="216">どハデな　ドームに　あたりから
キャーキャー飛び交う　歓声……▼
うう……
オラ　うらやましいっスっ！▼</language>
	</row>

	<row id="TRID_KARATE_09_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">スポーツせんしゅの　なにがいいんスか
からてかの　なにが　ダメなんスか</language>
		<language name="JPN_KANJI" width="216">スポーツ選手の　何がいいんスか
空手家の　何が　悪いんスか</language>
	</row>

	<row id="TRID_KARATE_09_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">からてかの　おもいが
こもっている　これを……▼</language>
		<language name="JPN_KANJI" width="216">空手家の　思いが
こもっている　これを……▼</language>
	</row>

	<row id="TRID_KARATE_09_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">オンボロ　どうじょうで　あたりからは
オスや　ウスの　かけごえ　のみ……▽
こんなことなら　スポーツせんしゅに▽
なれば　よかったっス……</language>
		<language name="JPN_KANJI" width="216">オンボロ道場で　あたりからは
オスや　ウスの　かけ声　のみ……▽
こんなことなら　スポーツ選手に▽
なれば　よかったっス……</language>
	</row>

	<row id="TRID_KINDERGARTENM_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ぼく　おおきくなったら
ぷろの　せんしゅに　なるんだぞ！▼</language>
		<language name="JPN_KANJI" width="216">ぼく　おおきくなったら
ぷろの　せんしゅに　なるんだぞ！▼</language>
	</row>

	<row id="TRID_KINDERGARTENM_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">うわーん！
もう　さいん　あげないもん！</language>
		<language name="JPN_KANJI" width="216">うわーん！
もう　さいん　あげないもん！</language>
	</row>

	<row id="TRID_KINDERGARTENM_03_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">さいん　じゃないけど
これ……！▼</language>
		<language name="JPN_KANJI" width="216">さいん　じゃないけど
これ……！▼</language>
	</row>

	<row id="TRID_KINDERGARTENM_03_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ぷろに　なったときの　さいん
れんしゅう　しておこっと！</language>
		<language name="JPN_KANJI" width="216">ぷろに　なったときの　さいん
れんしゅう　しておこっと！</language>
	</row>

	<row id="TRID_KINDERGARTENW_02_TRMSG_FIGHT_START">
		<language name="JPN" width="216">わたしの　パパ
ここの　せんしゅ　なの！▼</language>
		<language name="JPN_KANJI" width="216">わたしの　パパ
ここの　せんしゅ　なの！▼</language>
	</row>

	<row id="TRID_KINDERGARTENW_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">うえーん　パパーっ</language>
		<language name="JPN_KANJI" width="216">うえーん　パパーっ</language>
	</row>

	<row id="TRID_KINDERGARTENW_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">……パパに　もらった
これ　あげるよ▼</language>
		<language name="JPN_KANJI" width="216">……パパに　もらった
これ　あげるよ▼</language>
	</row>

	<row id="TRID_KINDERGARTENW_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">……やっぱり　なかない
パパと　やくそくしたもん</language>
		<language name="JPN_KANJI" width="216">……やっぱり　なかない
パパと　やくそくしたもん</language>
	</row>

	<row id="TRID_MADAM_02_TRMSG_FIGHT_START">
		<language name="JPN" width="216">マダムだって　スポーツを　たのしむわ
それこそ　おじょうひんに　ね！▼
ポケモンしょうぶも
ある　いみでは　スポーツよね！▽
おじょうひんに　たのしみましょう！▼</language>
		<language name="JPN_KANJI" width="216">マダムだって　スポーツを　楽しむわ
それこそ　お上品に　ね！▼
ポケモン勝負も
ある　意味では　スポーツよね！▽
お上品に　楽しみましょう！▼</language>
	</row>

	<row id="TRID_MADAM_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">おーほっほっほ！
おじょうひんに　まけましたわ</language>
		<language name="JPN_KANJI" width="216">おーほっほっほ！
お上品に　負けましたわ</language>
	</row>

	<row id="TRID_MADAM_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">アタクシ　ボールと　まちがえ　これを
とりよせましたけれど　あげますわ▼</language>
		<language name="JPN_KANJI" width="216">アタクシ　ボールと　間違え　これを
取り寄せましたけれど　あげますわ▼</language>
	</row>

	<row id="TRID_MADAM_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">スポーツも　ポケモンしょうぶも
まずは　たのしまなくちゃ！▼
かちまけに　こだわりすぎると
たいせつな　ものを　みうしなうわね</language>
		<language name="JPN_KANJI" width="216">スポーツも　ポケモン勝負も
まずは　楽しまなくちゃ！▼
勝ち負けに　こだわりすぎると
大切な　ものを　見失うわね</language>
	</row>

	<row id="TRID_MINI_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">わたし　ポケモンしょうぶ　つよくなって
プロせんしゅと　けっこん　するの！▼</language>
		<language name="JPN_KANJI" width="216">わたし　ポケモン勝負　強くなって
プロ選手と　結婚するの！▼</language>
	</row>

	<row id="TRID_MINI_07_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ああっ
みちのりは　とおいっ！？</language>
		<language name="JPN_KANJI" width="216">ああっ
道のりは　遠いっ！？</language>
	</row>

	<row id="TRID_MINI_07_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">キミの　ポケモン　つよいのね
つよいひとには　いいもの　あげちゃうっ▼</language>
		<language name="JPN_KANJI" width="216">キミの　ポケモン　強いのね
強い人には　いいもの　あげちゃうっ▼</language>
	</row>

	<row id="TRID_MINI_07_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">つよいひとって　なんだか
むじょうけんで　みりょくてきよねぇ</language>
		<language name="JPN_KANJI" width="216">強い人って　なんだか
無条件で　魅力的よねぇ</language>
	</row>

	<row id="TRID_MOUNT_08_TRMSG_FIGHT_START">
		<language name="JPN" width="216">やまおとこ　スポーツマン
そして　ポケモントレーナー▽
なにが　だいじか　わかるか？▼</language>
		<language name="JPN_KANJI" width="216">やまおとこ　スポーツマン
そして　ポケモントレーナー▽
なにが　大事か　わかるか？▼</language>
	</row>

	<row id="TRID_MOUNT_08_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">むぎゅう！
おまえは　わかっているな！</language>
		<language name="JPN_KANJI" width="216">むぎゅう！
おまえは　わかっているな！</language>
	</row>

	<row id="TRID_MOUNT_08_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">わかっている　おまえには
いいものを　くれてやろう！▼</language>
		<language name="JPN_KANJI" width="216">わかっている　おまえには
いいものを　くれてやろう！▼</language>
	</row>

	<row id="TRID_MOUNT_08_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ばっちり　じゅんびを　することだ
じゅんびぶそくだと　なにも　できんぞ！</language>
		<language name="JPN_KANJI" width="216">ばっちり　準備を　することだ
準備不足だと　なにも　できんぞ！</language>
	</row>

	<row id="TRID_MUSICIAN_02_TRMSG_FIGHT_START">
		<language name="JPN" width="216">スターの　オレに
だれも　きづかない　なんてっ……！▼</language>
		<language name="JPN_KANJI" width="216">スターの　オレに
だれも　気づかない　なんてっ……！▼</language>
	</row>

	<row id="TRID_MUSICIAN_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">まけた　オレを　みるな！</language>
		<language name="JPN_KANJI" width="216">敗北者の　オレを　みるな！</language>
	</row>

	<row id="TRID_MUSICIAN_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">たのむ！　これを　やるから
まけた　オレを　みるな！▼</language>
		<language name="JPN_KANJI" width="216">頼む！　これを　やるから
敗北者の　オレを　みるな！▼</language>
	</row>

	<row id="TRID_MUSICIAN_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">だれの　サイン　もらいにきたの？
オレのは　いらない？</language>
		<language name="JPN_KANJI" width="216">だれの　サイン　もらいにきたの？
オレのは　いらない？</language>
	</row>

	<row id="TRID_NURSE_02_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あなた　げんきー！▼
げんきの　ないコは
あたしが　おしおき　しちゃうわよ！▼</language>
		<language name="JPN_KANJI" width="216">あなた　元気ー！▼
元気の　ない子は
あたしが　お仕置き　しちゃうわよ！▼</language>
	</row>

	<row id="TRID_NURSE_02_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">スタミナ　ありあまっているわね！
もう　げんき　びんびん　じゃない！</language>
		<language name="JPN_KANJI" width="216">スタミナ　ありあまっているわね！
もう　元気　びんびん　じゃない！</language>
	</row>

	<row id="TRID_NURSE_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">よーし！　げんきな　トレーナー！
これも　もらっていきなさい！▼</language>
		<language name="JPN_KANJI" width="216">よーし！　元気な　トレーナー！
これも　もらっていきなさい！▼</language>
	</row>

	<row id="TRID_NURSE_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ナースも　スタミナしょうぶ　なの！
あさも　ひるも　よるもね！</language>
		<language name="JPN_KANJI" width="216">ナースも　スタミナ勝負なの！
朝も　昼も　夜もね！</language>
	</row>

	<row id="TRID_OL_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ダーリンがね　ここで　はたらいてるの
どう？　うらやましいでしょ？▼</language>
		<language name="JPN_KANJI" width="216">ダーリンがね　ここで　働いてるの
どう？　うらやましいでしょ？▼</language>
	</row>

	<row id="TRID_OL_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">アタシの　ダーリンてば　マジさいこう
スポーツせんしゅなんか　めじゃないし</language>
		<language name="JPN_KANJI" width="216">ウチの　ダーリンてば　マジ最高
スポーツ選手なんか　目じゃないし</language>
	</row>

	<row id="TRID_OL_05_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">アンタにも　ダーリンの
みりょく　わけたげる！▼</language>
		<language name="JPN_KANJI" width="216">アンタにも　ダーリンの
魅力　わけたげる！▼</language>
	</row>

	<row id="TRID_OL_05_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">アタシの　ダーリンは　せいそういん！
この　おっきな　マウンド　ぜんぶを▽
まいにちひとりで　そうじしてるんだ▽
イケてるっしょ？　マネできないよ！</language>
		<language name="JPN_KANJI" width="216">ウチの　ダーリンは　清掃員！
この　おっきな　マウンド　全部を▽
毎日一人で　掃除してるんだ▽
イケてるっしょ？　マネできないよ！</language>
	</row>

	<row id="TRID_PARASOL_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あめの　なかでの　スポーツって
たいへんそうよね！▼
あめの　なかでの
ポケモン　しょうぶは　どうかしら？▼</language>
		<language name="JPN_KANJI" width="216">雨の　中での　スポーツって
大変そうよね！▼
雨の　中での
ポケモン勝負は　どうかしら？▼</language>
	</row>

	<row id="TRID_PARASOL_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">まぁ　ここは　インドアだから
あめは　ふらないのよね</language>
		<language name="JPN_KANJI" width="216">まぁ　ここは　屋内だから
雨は　降らないのよね</language>
	</row>

	<row id="TRID_PARASOL_05_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">あめは　ふらないかわりに
いいものが　ふってくるかも……▼</language>
		<language name="JPN_KANJI" width="216">雨は　降らないかわりに
いいものが　降ってくるかも……▼</language>
	</row>

	<row id="TRID_PARASOL_05_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">スタジアムに　やねが　あると
いつでも　しあいが　できちゃうわね！</language>
		<language name="JPN_KANJI" width="216">スタジアムに　屋根が　あると
いつでも　試合が　できちゃうわね！</language>
	</row>

	<row id="TRID_PILOT_03_TRMSG_FIGHT_START">
		<language name="JPN" width="216">まいど！　ワシや　ワシや！
イッシュいちの　パイロットや！▼</language>
		<language name="JPN_KANJI" width="216">毎度！　ワシや　ワシや！
イッシュいちの　パイロットや！▼</language>
	</row>

	<row id="TRID_PILOT_03_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">きさま！　エエこんじょう　しとる！
ワシの　でしに　なれい！</language>
		<language name="JPN_KANJI" width="216">貴様！　エエ根性　しとる！
ワシの　弟子に　なれい！</language>
	</row>

	<row id="TRID_PILOT_03_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ほら！　これを　やるから
ワシの　でしに　なれい！▼</language>
		<language name="JPN_KANJI" width="216">ほら！　これを　やるから
ワシの　弟子に　なれい！▼</language>
	</row>

	<row id="TRID_PILOT_03_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">じんせい　いちどは　とんだらんかい！
とんで　とんで　とびまくって　みい！</language>
		<language name="JPN_KANJI" width="216">人生　一度は　飛んだらんかい！
飛んで　飛んで　飛びまくって　みい！</language>
	</row>

	<row id="TRID_PRINCE_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ＶＩＰせきが　どんなもんか
しりたいかい？▼
ぼくに　かったら
おしえて　あげるよ！▼</language>
		<language name="JPN_KANJI" width="216">ＶＩＰ席が　どんなもんか
知りたいかい？▼
僕に　勝ったら
教えて　あげるよ！▼</language>
	</row>

	<row id="TRID_PRINCE_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ＶＩＰせきからは
せんしゅが　とおいっ！</language>
		<language name="JPN_KANJI" width="216">ＶＩＰ席からは
選手が　遠いっ！</language>
	</row>

	<row id="TRID_PRINCE_06_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ＶＩＰ！　ＶＩＰ！
Ｖ！　Ｉ！　Ｐ！▼</language>
		<language name="JPN_KANJI" width="216">ＶＩＰ！　ＶＩＰ！
Ｖ！　Ｉ！　Ｐ！▼</language>
	</row>

	<row id="TRID_PRINCE_06_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">しあいは　よくみえたけど　せんしゅが
こめつぶ　みたいに　みえたよ</language>
		<language name="JPN_KANJI" width="216">試合は　よく見えたけど　選手が
米粒みたいに　見えたよ</language>
	</row>

	<row id="TRID_PRINCESS_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あなた……！
あの　ひとの　ファンなのね▼
わたしには　わかる！　だけど
あの　ひとは　わたさないわ！▼</language>
		<language name="JPN_KANJI" width="216">あなた……！
あの人の　ファンなのね▼
わたしには　わかる！　だけど
あの人は　渡さないわ！▼</language>
	</row>

	<row id="TRID_PRINCESS_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ヨヨヨ……
ごめんなさい　あの　ひと……</language>
		<language name="JPN_KANJI" width="216">ヨヨヨ……
ごめんなさい　あの人……</language>
	</row>

	<row id="TRID_PRINCESS_06_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">あの　ひとは　むりだけど
これで　ゆるして……▼</language>
		<language name="JPN_KANJI" width="216">あの人は　無理だけど
これで　許して……▼</language>
	</row>

	<row id="TRID_PRINCESS_06_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">よくよく　かんがえたら
おうえん　する　ひとが　おおいほうが▽
あの　ひとも　およろこびに　なるわね▼
あなた！　おうえん　しなさい！
こえが　かれて　うでが　もげるまで！</language>
		<language name="JPN_KANJI" width="216">よくよく　考えたら
応援する　人が　多いほうが▽
あの人も　お喜びに　なるわね▼
あなた！　応援しなさい！
声が枯れて　腕が　もげるまで！</language>
	</row>

	<row id="TRID_RANGERM_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">しあい　みてたら
からだを　うごかしたく　なるな！▼</language>
		<language name="JPN_KANJI" width="216">試合　観てたら
体を　動かしたく　なるな！▼</language>
	</row>

	<row id="TRID_RANGERM_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">いい　あせ　かいたな！</language>
		<language name="JPN_KANJI" width="216">いい汗　かいたな！</language>
	</row>

	<row id="TRID_RANGERM_06_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">おお！　からだが
かってに　うごくぞ！▼</language>
		<language name="JPN_KANJI" width="216">おお！　体が
勝手に　動くぞ！▼</language>
	</row>

	<row id="TRID_RANGERM_06_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ドームも　いいけど▼
やっぱ　だいしぜんの　なかで
スポーツ　したいよな</language>
		<language name="JPN_KANJI" width="216">ドームも　いいけど▼
やっぱ　大自然の　中で
スポーツ　したいよな</language>
	</row>

	<row id="TRID_RANGERW_06_TRMSG_FIGHT_START">
		<language name="JPN" width="216">ここにいる　やつらを　しょっぴいて
レンジャーに　にゅうたい　させたいわ▼</language>
		<language name="JPN_KANJI" width="216">ここにいる　やつらを　しょっぴいて
レンジャーに　入隊させたいわ▼</language>
	</row>

	<row id="TRID_RANGERW_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">あんっ！　しびれるー！
アナタも　グーッドね！</language>
		<language name="JPN_KANJI" width="216">あんっ！　しびれるー！
アナタも　グーッドね！</language>
	</row>

	<row id="TRID_RANGERW_06_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">グーッドな　ア・ナ・タに！▼</language>
		<language name="JPN_KANJI" width="216">グーッドな　ア・ナ・タに！▼</language>
	</row>

	<row id="TRID_RANGERW_06_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">アナタ　レンジャーに　なりなさいよ！
ハードに　しごいて　きたえてあげる！</language>
		<language name="JPN_KANJI" width="216">アナタ　レンジャーに　なりなさいよ！
ハードに　しごいて　鍛えてあげる！</language>
	</row>

	<row id="TRID_SCHOOLB_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">べんきょうの　あいまに　しあいかんせん！
しあいの　あいまに　ポケモンしょうぶ！▼</language>
		<language name="JPN_KANJI" width="216">勉強の　合間に　試合観戦！
試合の　合間に　ポケモン勝負！▼</language>
	</row>

	<row id="TRID_SCHOOLB_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">がーん……！
いきぬきに　ならない……！</language>
		<language name="JPN_KANJI" width="216">がーん……！
息抜きに　ならない……！</language>
	</row>

	<row id="TRID_SCHOOLB_05_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">こんなことを　して
きもちを　きりかえます！▼</language>
		<language name="JPN_KANJI" width="216">こんなことを　して
気持ちを　切り替えます！▼</language>
	</row>

	<row id="TRID_SCHOOLB_05_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">たまに　こうして　あそびにくると
かえって　べんきょうが　はかどるんだ！</language>
		<language name="JPN_KANJI" width="216">たまに　こうして　遊びにくると
かえって　勉強が　はかどるんだ！</language>
	</row>

	<row id="TRID_SCHOOLG_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">よし　きめた！
あなたに　かったら▽
ジムリーダーに　なるわ！▼</language>
		<language name="JPN_KANJI" width="216">よし　決めた！
あなたに　勝ったら▽
ジムリーダーに　なるわ！▼</language>
	</row>

	<row id="TRID_SCHOOLG_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">うーん　ジムリーダーに
なるのは　おぼつかないかな？</language>
		<language name="JPN_KANJI" width="216">うーん　ジムリーダーに
なるのは　おぼつかないかな？</language>
	</row>

	<row id="TRID_SCHOOLG_05_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">いろいろ　おそわったので
かんしゃの　きもち　よ！▼</language>
		<language name="JPN_KANJI" width="216">いろいろ　教わったので
感謝の　気持ちよ！▼</language>
	</row>

	<row id="TRID_SCHOOLG_05_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">しょうらい　なにに　なるか
いろいろ　みて　かんがえないと！</language>
		<language name="JPN_KANJI" width="216">将来　なにに　なるか
いろいろ　みて　考えないと！</language>
	</row>

	<row id="TRID_SCIENTISTM_07_TRMSG_FIGHT_START">
		<language name="JPN" width="216">スポーツが　とくい　ってことと
しょうぶが　つよいか　って▽
かんけい　あるの　かしら？▼</language>
		<language name="JPN_KANJI" width="216">スポーツが　得意　ってことと
勝負が　強いか　って▽
関係あるの　かしら？▼</language>
	</row>

	<row id="TRID_SCIENTISTM_07_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">さんこうに　なりました……！</language>
		<language name="JPN_KANJI" width="216">参考に　なりました……！</language>
	</row>

	<row id="TRID_SCIENTISTM_07_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">うーん　きみは
なかなか　きょうみぶかい！▼
これどーぞ！▼</language>
		<language name="JPN_KANJI" width="216">うーん　きみは
なかなか　興味深い！▼
これどーぞ！▼</language>
	</row>

	<row id="TRID_SCIENTISTM_07_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">スポーツも　ポケモンも
わたしにとって　かがく　なんだよ！</language>
		<language name="JPN_KANJI" width="216">スポーツも　ポケモンも
わたしにとって　科学なんだよ！</language>
	</row>

	<row id="TRID_SCIENTISTW_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">まいにち　まいにち　くすりくさい
けんきゅうしつに　こもってますと▽
ストレスが　たまって　しまいます▼</language>
		<language name="JPN_KANJI" width="216">毎日　毎日　薬臭い
研究室に　こもってますと▽
ストレスが　たまってしまいます▼</language>
	</row>

	<row id="TRID_SCIENTISTW_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">ウォー！　くやしいぞォー！</language>
		<language name="JPN_KANJI" width="216">ウォー！　くやしいぞォー！</language>
	</row>

	<row id="TRID_SCIENTISTW_05_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">ぜっきょうしたら　あらまスッキリ！
おれいに　どうか　こちらを……▼</language>
		<language name="JPN_KANJI" width="216">絶叫したら　あらまスッキリ！
お礼に　どうか　こちらを……▼</language>
	</row>

	<row id="TRID_SCIENTISTW_05_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">ストレスが　たまらないように
ポケモンしょうぶを　しましょうね！</language>
		<language name="JPN_KANJI" width="216">ストレスが　たまらないように
ポケモン勝負を　しましょうね！</language>
	</row>

	<row id="TRID_TANPAN_12_TRMSG_FIGHT_START">
		<language name="JPN" width="216">オレが　はいているのは
たんぱん　じゃない！▽
ハーフパンツ　なんだよ！▼</language>
		<language name="JPN_KANJI" width="216">オレが　履いているのは
たんぱん　じゃない！▽
ハーフパンツ　なんだよ！▼</language>
	</row>

	<row id="TRID_TANPAN_12_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">オマエ　つよすぎるから　たんぱん
ずりおちそうに　なっただろ！</language>
		<language name="JPN_KANJI" width="216">オマエ　強すぎるから　たんぱん
ずりおちそうに　なっただろ！</language>
	</row>

	<row id="TRID_TANPAN_12_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">おまえ　すげーなー！
コレは　プレゼントだ！▼</language>
		<language name="JPN_KANJI" width="216">おまえ　すげーなー！
コレは　プレゼントだ！▼</language>
	</row>

	<row id="TRID_TANPAN_12_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">サッカーせんしゅ　や
バスケットの　せんしゅ　いいよなー▼
だって　たんぱん……　じゃなくて
ハーフパンツ　なんだぜ▼
だけど　やきゅうや　アメフトの
ユニフォームも　かっこいいよなー！　</language>
		<language name="JPN_KANJI" width="216">サッカー選手や
バスケットの選手　いいよなー▼
だって　たんぱん……　じゃなくて
ハーフパンツ　なんだぜ▼
だけど　野球や　アメフトの
ユニフォームも　かっこいいよなー！　</language>
	</row>

	<row id="TRID_VETERANM_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">むむっ……！▼
キミは　スポーツせんしゅと
おなじ　においが　するっ！▼</language>
		<language name="JPN_KANJI" width="216">むむっ……！▼
キミは　スポーツ選手と
同じ　においが　するっ！▼</language>
	</row>

	<row id="TRID_VETERANM_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">そうか　つよいものが　はっする
におい　だったのだな……</language>
		<language name="JPN_KANJI" width="216">そうか　強い者が　発する
におい　だったのだな……</language>
	</row>

	<row id="TRID_VETERANM_05_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">きみは　さらに　つよくなりそうだ……
よし　これを　うけとってくれ▼</language>
		<language name="JPN_KANJI" width="216">きみは　さらに　強くなりそうだ……
よし　これを　受け取ってくれ▼</language>
	</row>

	<row id="TRID_VETERANM_05_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
		<language name="JPN" width="216">それを　つかって　きみが
さらに　つよくなることを　ねがうよ</language>
		<language name="JPN_KANJI" width="216">それを　使って　きみが
さらに　強くなることを　願うよ</language>
	</row>

	<row id="TRID_VETERANW_05_TRMSG_FIGHT_START">
		<language name="JPN" width="216">あら　リーグバッジ
けっこう　もってるじゃない▼
じゃあ　おてなみ　はいけんね▼</language>
		<language name="JPN_KANJI" width="216">あら　リーグバッジ
