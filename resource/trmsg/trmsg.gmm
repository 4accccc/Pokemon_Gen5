	<row id="TRID_DANCER_02_TRMSG_FIGHT_AFTER_GIFTITEM_BEFORE">
		<language name="JPN" width="216">アッサリ　これを　あげるっ！▼</language>
		<language name="JPN_KANJI" width="216">アッサリ　これを　あげるっ！▼</language>
	</row>

	<row id="TRID_DANCER_02_TRMSG_FIGHT_AFTER_GIFTITEM_AFTER">
