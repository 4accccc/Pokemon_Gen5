	</row>

	<row id="TRID_FANW_04_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">ねぇねぇ　オフサイドについて
おしえて　あげようか？▼</language>
		<language name="JPN_KANJI" width="216">ねぇねぇ　オフサイドについて
教えて　あげようか？▼</language>
	</row>

	<row id="TRID_FANW_04_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">オフサイドは　あれよ……
と……となりのこが　せつめいするわ！</language>
		<language name="JPN_KANJI" width="216">オフサイドは　あれよ……
と……となりの子が　説明するわ！</language>
	</row>

	<row id="TRID_FANW_04_TRMSG_POKE_ONE_2">
		<language name="JPN" width="216">サイド！</language>
		<language name="JPN_KANJI" width="216">サイド！</language>
	</row>

	<row id="TRID_FANM_11_TRMSG_FIGHT_START_1">
		<language name="JPN" width="216">さいしゅうかい　うら
ツーアウト　まんるい……▽
そのあとは……　きまってるだろ？▼</language>
		<language name="JPN_KANJI" width="216">最終回　裏　ツーアウト　満塁
その後は……　決まってるだろ？▼</language>
	</row>

	<row id="TRID_FANM_11_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">カツ『ストラーーイク！！
ゲームセット！　はい　おわり！▼
ゴウ『ああっ　ぼくの
モンスターボールっっ！</language>
		<language name="JPN_KANJI" width="216">カツ『ストラーーイク！！
ゲームセット！　はい　終わり！▼
ゴウ『ああっ　ぼくの
モンスターボールっっ！</language>
	</row>

	<row id="TRID_FANM_11_TRMSG_FIGHT_AFTER_1">
		<language name="JPN" width="216">ピンチでの　ぎゃくてん　ホームラン……
いつも　きたいしちゃうよな！</language>
		<language name="JPN_KANJI" width="216">ピンチでの　逆転ホームラン……
いつも　期待しちゃうよな！</language>
	</row>

	<row id="TRID_FANM_11_TRMSG_POKE_ONE_1">
		<language name="JPN" width="216">ライク！！</language>
		<language name="JPN_KANJI" width="216">ライク！！</language>
	</row>

	<row id="TRID_FANM_11_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">ホームランボールは　もってませんが
モンスターボールなら　ありますよ！▼</language>
		<language name="JPN_KANJI" width="216">ホームランボールは　持ってませんが
モンスターボールなら　ありますよ！▼</language>
	</row>

	<row id="TRID_FANM_11_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">いちどで　いいから　ホームランボールを
キャッチしてみたいなぁ……！</language>
		<language name="JPN_KANJI" width="216">一度で　いいから　ホームランボールを
キャッチしてみたいなぁ……！</language>
	</row>

	<row id="TRID_FANM_11_TRMSG_POKE_ONE_2">
		<language name="JPN" width="216">ボール！</language>
		<language name="JPN_KANJI" width="216">ボール！</language>
	</row>

	<row id="TRID_FANW_05_TRMSG_FIGHT_START_1">
		<language name="JPN" width="216">かっとばせえ！▼</language>
		<language name="JPN_KANJI" width="216">かっとばせえ！▼</language>
	</row>

	<row id="TRID_FANW_05_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">アミ『かっとびました！▼
ユキ『かっ！</language>
		<language name="JPN_KANJI" width="216">アミ『かっとびました！▼
ユキ『かっ！</language>
	</row>

	<row id="TRID_FANW_05_TRMSG_FIGHT_AFTER_1">
		<language name="JPN" width="216">カミツレさんも
けっこう　かっとんだ　センスよね</language>
		<language name="JPN_KANJI" width="216">カミツレさんも
けっこう　かっとんだ　センスよね</language>
	</row>

	<row id="TRID_FANW_05_TRMSG_POKE_ONE_1">
		<language name="JPN" width="216">１ｖｓ２　なんて
かっとびすぎぃ！</language>
		<language name="JPN_KANJI" width="216">１ｖｓ２　なんて
かっとびすぎぃ！</language>
	</row>

	<row id="TRID_FANW_05_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">ねえねえ　かっとばせの
「かっ」って　なあに？▼</language>
		<language name="JPN_KANJI" width="216">ねえねえ　かっとばせの
「かっ」って　なあに？▼</language>
	</row>

	<row id="TRID_FANW_05_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">あたしが　きいたのは
とばすって　ことばを▽
きょうちょう　するための▽
「かっ」なんだって！</language>
		<language name="JPN_KANJI" width="216">あたしが　聞いたのは
とばすって　言葉を▽
強調するための▽
「かっ」なんだって！</language>
	</row>

	<row id="TRID_FANW_05_TRMSG_POKE_ONE_2">
		<language name="JPN" width="216">あたしたち　ふたりで　たたかうから
ポケモン　２ひき　いないとね！</language>
		<language name="JPN_KANJI" width="216">あたしたち　２人で　戦うから
ポケモン　２匹　いないとね！</language>
	</row>

	<row id="TRID_FANW_06_TRMSG_FIGHT_START_1">
		<language name="JPN" width="216">ちょっと　アンタさ！▼
アタシの　オキニの　せんしゅに
いろめとか　やめてよねー▼</language>
		<language name="JPN_KANJI" width="216">ちょっと　アンタさ！▼
アタシの　オキニの　選手に
色目とか　止めてよねー▼</language>
	</row>

	<row id="TRID_FANW_06_TRMSG_FIGHT_LOSE">
		<language name="JPN" width="216">アミ『もー　アンタの　せいで
まけちゃった　じゃんー▼
ユキ『あなた　もっと　がんばってよー
わたしの　あし　ひっぱらないでよー</language>
		<language name="JPN_KANJI" width="216">アミ『もー　アンタの　せいで
負けちゃった　じゃんー▼
ユキ『あなた　もっと　頑張ってよー
わたしの　足　引っ張らないでよー</language>
	</row>

	<row id="TRID_FANW_06_TRMSG_FIGHT_AFTER_1">
		<language name="JPN" width="216">おんなじチームが　すきなこと　いがい
アタシたち　まるで　あわないよねー▽
ま　いちばん　たいせつな　ものが▽
おなじだし　それで　いいけどさー</language>
		<language name="JPN_KANJI" width="216">同じチームが　好きなこと以外
アタシたち　まるで　合わないよねー▽
ま　一番　大切な　もの▽
同じだし　それで　いいけどさー</language>
	</row>

	<row id="TRID_FANW_06_TRMSG_POKE_ONE_1">
		<language name="JPN" width="216">あー　もー　アンタの　せいで
だいピンチ　じゃんー</language>
		<language name="JPN_KANJI" width="216">あー　もー　アンタの　せいで
大ピンチ　じゃんー</language>
	</row>

	<row id="TRID_FANW_06_TRMSG_FIGHT_START_2">
		<language name="JPN" width="216">もー　うっさいなー！▼
わたしが　だれを
おうえんしようが　かって　でしょー▼</language>
		<language name="JPN_KANJI" width="216">もー　うっさいなー！▼
わたしが　だれを
応援しようが　勝手でしょー▼</language>
	</row>

	<row id="TRID_FANW_06_TRMSG_FIGHT_AFTER_2">
		<language name="JPN" width="216">しあい　おうえんしてるとき　いがい
チームワーク　ダメダメだよねー▽
べつに　ふだんは　どうでもいいから▽
それで　かまわないんだけどさー</language>
		<language name="JPN_KANJI" width="216">試合　応援してる時　以外
チームワーク　ダメダメだよねー▽
別に　普段は　どうでもいいから▽
それで　構わないんだけどさー</language>
	</row>

	<row id="TRID_FANW_06_TRMSG_POKE_ONE_2">
		<language name="JPN" width="216">やだ　もー　まけちゃうよー
あなたが　がんばらないからー</language>
		<language name="JPN_KANJI" width="216">やだ　もー　負けるじゃーん
あなたが　頑張らないからー</language>
	</row>

	<row id="TRID_BASEBALL_04_TRMSG_FIGHT_START">
